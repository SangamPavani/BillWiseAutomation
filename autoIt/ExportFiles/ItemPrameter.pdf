      html, body, #root {
        height: 100%;
        margin: 0;
      }

      

      #root {
        display: flex;
        min-height: 100%;
      }

      /* Mobile viewport correctness (safe progressive enhancement) */
      @supports (height: 100dvh) {
        #root {
          min-height: 100dvh;
        }
      }

      body {
        color-scheme: light;
      }

      body.shouldHideBody {
          visibility: hidden;
      }

      /* handle error root boundary */
      .root-error-boundary {
        display: contents;
      }

