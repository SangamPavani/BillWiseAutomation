        @font-face {
          font-family: 'Segoe Sans';
          src: url('https://res-1.cdn.office.net/files/fabric-cdn-prod_20250606.001/assets/fonts/segoe-sans/segoe-sans-italic.woff2') format('woff2'),
               url('https://res-1.cdn.office.net/files/fabric-cdn-prod_20250606.001/assets/fonts/segoe-sans/segoe-sans-italic.woff') format('woff'),
               url('https://res-1.cdn.office.net/files/fabric-cdn-prod_20250606.001/assets/fonts/segoe-sans/segoe-sans-italic.ttf') format('truetype');
