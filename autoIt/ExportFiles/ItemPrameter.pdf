  margin-right: 10px;
  border: 0px;
  outline: 1px solid transparent;
  font-family: "wf_SegoeUIRegular", "wf_SegoeUI", "Segoe UI Regular", "Segoe UI", "Segoe", "Segoe WP", "Tahoma", "Verdana", "Arial", "sans-serif";
