               url('https://res-1.cdn.office.net/files/fabric-cdn-prod_20250606.001/assets/fonts/segoe-sans/segoe-sans.woff') format('woff'),
               url('https://res-1.cdn.office.net/files/fabric-cdn-prod_20250606.001/assets/fonts/segoe-sans/segoe-sans.ttf') format('truetype');
          font-weight: 100 900;
