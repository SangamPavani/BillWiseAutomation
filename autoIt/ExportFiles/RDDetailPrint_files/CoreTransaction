                    cellobj.setCellText("");
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    OPTIONCONTROL.setParent(element, cellobj.cell);
                    iValue = 0;
                    if (COMMON.prototype.isInteger(cellobj.CellData.value) == true) {
                        iValue = parseInt(cellobj.getCellData("value"));
                    }
                    if (iValue <= 0) {
                        OPTIONCONTROL.clear(element);
                    }
                    else {
                        OPTIONCONTROL.setControlValue(element, iValue);
                    }
                    $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    REJECTBUDGETS.CellEnableDisable(cellobj, budgettype);
                    if (cellobj.iColumn == 4)//forproduct only
                    {
                        var sFilter = REJECTBUDGETS.getFilter(cellobj.iRow, cellobj.iColumn);
                        if (sFilter.length > 0)
                            OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "iStatus <> 5 AND a.iMasterId Not IN(" + sFilter + ")");
                    }
                    break;
                case MasterDataType.get("NUMBERLIST"):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (cellobj.getCellData("value") == null) {
                        cellobj.setControl(element, "0");
                    }
                    else {
                        cellobj.setControl(element, cellobj.getCellData("value"));
                    }
                    $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    break;
                case MasterDataType.get("FRACTION"):
                    if (cellobj.iColumn == 9 && $(cellobj.cell).css("pointer-events") == "none") {
                        var qtyelement = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        qtyelement.value = "";
                        cellobj.processDefault(event);
                    }
                    else {
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        if (element != null) {
                            cellobj.setControl(element, cellobj.getCellData("value"));
                            $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                            REJECTBUDGETS.CellEnableDisable(cellobj, budgettype);
                            if (planBudgetType == 1 || planBudgetType == 2) {
                                $(cellobj.cell).css("pointer-events", "none");
                            }
                        } else {
                            if (cellobj.iColumn == 5) {
                                cellobj.processDefault(event);
                            }
                        }
                    }
                    break;
                case MasterDataType.get("TEXT"):
                    if (cellobj.iColumn == 5) {
                        cellobj.processDefault(event);
                    } else {
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        if (element != null) {
                            cellobj.setControl(element, cellobj.getCellData("value"));
                            $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                        }
                    }
                    break;
                case MasterDataType.get("BOOLEAN"):
                    cellobj.processDefault(event);
                    //cellobj.setControl(element, cellobj.getCellData("value"));
                    return;
                default:
                    cellobj.processDefault(event);
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("REJECTBUDGETS.onEnter : " + err.message, "Exception");
            return false;
        }
