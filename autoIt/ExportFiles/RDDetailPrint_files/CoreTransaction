            var PriceBookText = OPTIONCONTROL.getControlText(ctrlOptionProPriceBookH);
            if (PriceBookValue > 0) {
                var currCellobj = FGRIDCONTROL.getCellObject("PriceBookWebGrid", iRow, 0);
