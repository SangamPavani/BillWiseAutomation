                            if (Tag3 > 0) {
                                if (BodyRow.Tag3 == 0 || BodyRow.Tag3 == undefined) {
                                    COMMON.prototype.showMessage("Tag3" + " " + REJECTBUDGETS.getResourceValue("MRP_RPO_msgCannotBeEmptyInGridRow ", GetBudgetResourceMessages) + " " + iRowCounter);
