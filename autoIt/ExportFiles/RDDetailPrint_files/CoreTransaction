    FixBase64: function (Base64) {
        //debugger
        try {
            var FirstCommaIndex = Base64.indexOf(',');
            var FixedBase64 = Base64.substring((FirstCommaIndex + 1), Base64.length);
            return FixedBase64;
        }
        catch (err) {
            COMMON.prototype.showMessage("DEFINEBUDGET.FixBase64 : " + err.message, "Exception");
            return null;
        }
