                                    return false;
                                }
                            }
                            else if (BodyRow.BudgetType == 1)///ByProductByValue
                            {
                                if (isNaN(BodyRow.Value) || BodyRow.Value == 0 || BodyRow.Value == undefined) {
                                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("msgEnterBudgetValue", GetBudgetResourceMessages));
                                    return false;
                                }
                                if (BodyRow.ProductID <= 0) {
                                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("lblProduct ", GetBudgetResourceMessages) + " " + REJECTBUDGETS.getResourceValue("MRP_RPO_msgCannotBeEmptyInGridRow ", GetBudgetResourceMessages) + " " + iRowCounter);
                                    return false;
                                }
                            }
