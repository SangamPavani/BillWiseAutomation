    GetQuarterDates: function (date) {
        try {
            var obj = new Date()
            var dateparts = date.split("/");
            var Quarter = Math.ceil(dateparts[1] / 3);
            var dateyear = dateparts[2];
            var idnamepair = {};
            if (Quarter != null && Quarter != undefined) {
                switch (Quarter) {
                    case 1:
                        {
                            idnamepair.ID = DATE.prototype.convertIntoFocusDate(1, 1, dateyear);
                            idnamepair.Name = DATE.prototype.getDayFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getMonthFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getYearFromFocusDate(idnamepair.ID);//       DATE.prototype.convertIntoFocusDateTime(dateyear,1,1);
                            idnamepair.Tag = true;
                        }
                        break;
                    case 2:
                        {
                            idnamepair.ID = DATE.prototype.convertIntoFocusDate(1, 4, dateyear);
                            idnamepair.Name = DATE.prototype.getDayFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getMonthFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getYearFromFocusDate(idnamepair.ID);
                            idnamepair.Tag = true;
                        }
                        break;
                    case 3:
                        {
                            idnamepair.ID = DATE.prototype.convertIntoFocusDate(1, 7, dateyear);
                            idnamepair.Name = DATE.prototype.getDayFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getMonthFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getYearFromFocusDate(idnamepair.ID);
                            idnamepair.Tag = true;
                        }
                        break;
                    case 4:
                        {
                            idnamepair.ID = DATE.prototype.convertIntoFocusDate(1, 10, dateyear);
                            idnamepair.Name = DATE.prototype.getDayFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getMonthFromFocusDate(idnamepair.ID) + "/" + DATE.prototype.getYearFromFocusDate(idnamepair.ID);
                            idnamepair.Tag = true;
                        }
                        break;
                }
                return idnamepair;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("AddEditImportBudget.GetQuarterDates : " + err.message, "Exception");
            return false;
        }
    },
