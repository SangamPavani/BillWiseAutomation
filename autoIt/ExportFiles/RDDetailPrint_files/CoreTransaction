    GetSummationValue: function () {
        try {
            var grdBody = document.getElementById('grdDefineBudget_body');
            var QtyDecimals = document.getElementById('hdnDefQtyDecimals').value;
            var CurrencyDecimals = document.getElementById('hdnDefCurDecimals').value;
            var TotalGridBudgetVal = 0
            var TotalGridBudgetQty = 0
            for (var index = 1; index <= grdBody.rows.length; index++) {
                var objRow = {
                    BudgetType: FGRIDCONTROL.getCellObject("grdDefineBudget", index, 2).getCellData("value"),
                    Quantity: FConvert.formatToDecimalPlaces(FGRIDCONTROL.getCellObject("grdDefineBudget", index, 8).getCellData("value"), parseInt($("#hdnDefQtyDecimals").val()), false),
                    BudgetValue: FConvert.formatToDecimalPlaces(FGRIDCONTROL.getCellObject("grdDefineBudget", index, 9).getCellData("value"), parseInt($("#hdnDefCurDecimals").val()), false)
                }
                if (objRow != undefined && objRow != null) {
                    if (objRow.BudgetType != null) {
                        TotalGridBudgetVal = parseFloat(Number(parseFloat(TotalGridBudgetVal)).toFixed(CurrencyDecimals)) + parseFloat(Number(parseFloat((objRow.BudgetValue.trim() == "" || objRow.BudgetValue == undefined) ? 0 : objRow.BudgetValue).toFixed(CurrencyDecimals)));
                        TotalGridBudgetQty = parseFloat(Number(parseFloat(TotalGridBudgetQty)).toFixed(QtyDecimals)) + parseFloat(Number(parseFloat((objRow.Quantity.trim() == "" || objRow.Quantity == undefined) ? 0 : objRow.Quantity).toFixed(QtyDecimals)));
                    }
                }
            }
            document.getElementById('lblTotalQty').innerHTML = FConvert.formatToDecimalPlaces(Number(TotalGridBudgetQty).toFixed(QtyDecimals), parseInt(QtyDecimals), true);
            document.getElementById('lblTotalValue').innerHTML = FConvert.formatToDecimalPlaces(Number(TotalGridBudgetVal).toFixed(CurrencyDecimals), parseInt(CurrencyDecimals), true);
        }
        catch (err) {
            COMMON.prototype.showMessage("DEFINEBUDGET.GetSummationValue : " + err.message, "Exception");
            return false;
        }
    },

    getFilter: function (iCurrentRow, iColumn) {
        //debugger;
        try {
            var sFilter = "";
            var sGridId = "";
            var cell = null;
            var iCounter = 1;
            var iMasterId = 0;
            sGridId = "grdDefineBudget";
            for (iCounter = 1; iCounter <= FGRIDCONTROL.getTotalRows(sGridId); iCounter++) {
                if (iCounter == iCurrentRow) {
                    continue;
                }
                cell = FGRIDCONTROL.getCellObject(sGridId, iCounter, 6);
                iMasterId = FConvert.toInt(cell.getCellData());
                if (iMasterId > 0) {
                    if (COMMON.prototype.isNullOrEmpty(sFilter) == false) {
                        sFilter += ",";
                    }
                    sFilter += iMasterId;
                }
            }
            return (sFilter);
        }
        catch (err) {
            COMMON.prototype.showMessage("DEFINEBUDGET.getFilter : " + err.message, "Exception");
            return "";
        }
    },

