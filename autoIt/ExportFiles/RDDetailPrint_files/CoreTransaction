            }
            var iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(dtDate));
            if (iMonth < 10) {
                iMonth = '0' + iMonth;
            }
            var iYear = DATE.prototype.getYearFromFocusDate(parseInt(dtDate));
            var lastupdateddate = iDay + "/" + iMonth + "/" + iYear;
            return lastupdateddate;
        }
        catch (err) {
