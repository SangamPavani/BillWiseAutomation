                                        return false;
                                    }
                                }
                                if (BodyRow.ProductID <= 0) {
                                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("lblProduct ", GetBudgetResourceMessages) + " " + REJECTBUDGETS.getResourceValue("MRP_RPO_msgCannotBeEmptyInGridRow ", GetBudgetResourceMessages) + " " + iRowCounter);
                                    return false;
                                }
                            }
                            else if (BodyRow.BudgetType == 4)///ByProductByQty
                            {
                                if (planBudgetType != undefined && planBudgetType != 1 && planBudgetType != 2)//do not check for add/reduce and transfer screen
                                {
                                    if (isNaN(BodyRow.Quantity) || BodyRow.Quantity == 0 || BodyRow.Quantity == undefined) {
