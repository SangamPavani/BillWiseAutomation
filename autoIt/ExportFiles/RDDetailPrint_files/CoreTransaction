                                if (isNaN(BodyRow.Value) || BodyRow.Value == 0 || BodyRow.Value == undefined) {
                                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("msgEnterBudgetValue", GetBudgetResourceMessages));
