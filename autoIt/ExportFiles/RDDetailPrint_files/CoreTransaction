    Validate: function () {
        try {
            var PlanName = OPTIONCONTROL.getControlText("optPlanName");
            var BudgetId = parseInt(OPTIONCONTROL.getControlValue("optPlanName"));
            if (iBudgetGroup == 0) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgBudgetPref", GetBudgetResourceMessages));
                return false;
            }

            if (document.getElementById('txtVersion').value.trim() == '' || document.getElementById('txtVersion').value == undefined) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgVersionIsEmpty", GetBudgetResourceMessages));
                return false;
            }
            if (PlanName.trim().length == 0) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgPlanNamecannotbeempty", GetBudgetResourceMessages));
                return false;
            }
            else if (BudgetId > 0 && document.getElementById("dvSaveSend") != null && document.getElementById("dvSaveSend").getAttribute("data-IsAuthExist") == "true") {

                var msg = document.getElementById("dvSaveSend").getAttribute("data-AuthOrConfirmMsg");
                if (msg != null && msg.length > 0) {
                    COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue(msg, GetBudgetResourceMessages));
                }
                else {
                    DEFINEBUDGET.AuthExistUIMsg();
                }
                return false;
                //var IsConfirmExist = document.getElementById('btnConfirmBudget').style.display;
                //if (IsConfirmExist == 'none') {
                //    COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgModifyAuth", GetBudgetResourceMessages));


                //} else {

                //    COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgModifyConfirm", GetBudgetResourceMessages));
                //}
                //return false;
            }
            else if (BudgetId > 0 && document.getElementById("dvSaveSend") == null && IsAuthExists == true) {
                DEFINEBUDGET.AuthExistUIMsg();
                return false;
            }
            else if (DATEPICKER.getDate("dpBudgetDate") == 0) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgDateempty", GetBudgetResourceMessages));
                return false;
            }
            else if (DATEPICKER.getDate("dpBudgetValidFromDate") == 0) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgValidFromEmpty", GetBudgetResourceMessages));
                //COMMON.prototype.showMessage("Valid From Date Cannot empty");
                return false;
            }
            else if (DATEPICKER.getDate("dpBudgetValidToDate") == 0) {
                COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgValidToEmpty", GetBudgetResourceMessages));
                //COMMON.prototype.showMessage("Valid To Date Cannot empty");
                return false;
            }
            else if (DATEPICKER.getDate("dpBudgetValidFromDate") > 0) {
                if ((DATEPICKER.getDate("dpBudgetValidFromDate") < AccountingDate) && AccountingDate > 0) {
                    COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgFromDateCantbeLessthanAccountingDate", GetBudgetResourceMessages));
                    return false;
                }
            }
            else if ((DATEPICKER.getDate("dpBudgetValidToDate") > 0) && AccountingDate > 0) {
                if (DATEPICKER.getDate("dpBudgetValidToDate") < AccountingDate) {
                    COMMON.prototype.showMessage(DEFINEBUDGET.getResourceValue("msgToDateCantbeLessthanAccountingDate", GetBudgetResourceMessages));
                    return false;
                }
            }
            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("DEFINEBUDGET.Validate : " + err.message, "Exception");
            return false;
        }
    },
