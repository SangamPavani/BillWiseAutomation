    Validate: function () {
        try {
            var BudgetId = parseInt(OPTIONCONTROL.getControlValue("optPlanName"));
            if (BudgetId == 0) {
                COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgCantFindPlan", GetBudgetResourceMessages));
                return false;
            }
            var PlanName = OPTIONCONTROL.getControlText("optPlanName");
            if (PlanName.trim().length == 0) {
                COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgCantFindPlan", GetBudgetResourceMessages));
                return false;
            }
            var grdAddEditBudget = document.getElementById('grdAddEditBudget_body');
            for (var index = 1; index <= grdAddEditBudget.rows.length; index++) {
                var TotalSplitedQty = REVISEBUDGETDETAILS.GetRowWiseSplittedTotalQty(index);
                var TotalSplitedValue = GetRowWiseSplittedTotalValue(index);
                var SplitType = REVISEBUDGETDETAILS.GetRowWiseSplittedType(index);
                var AddQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 10).getCellData("value");
                if (SplitType < 2)//skip checking 0 and 1
                    continue;
                if (AddQty > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedQty) != parseFloat(AddQty)) {
                        COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgSplitQtyShouldbeEqualToAddQty", GetBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var ReduceQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 11).getCellData("value");
                if (ReduceQty > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedQty) != parseFloat(ReduceQty)) {
                        COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgSplitQtyShouldbeEqualToReduceQty", GetBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var AddValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 13).getCellData("value");
                if (AddValue > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedValue) != parseFloat(AddValue)) {
                        COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgSplitValShouldbeEqualToAddValue", GetBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var ReduceValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 14).getCellData("value");
                if (ReduceValue > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedValue) != parseFloat(ReduceValue)) {
                        COMMON.prototype.showMessage(REVISEBUDGETDETAILS.getResourceValue("msgSplitValShouldbeEqualToReduceValue", GetBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
            }
            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("REVISEBUDGETDETAILS.Validate : " + err.message, "Exception");
            return false;
        }
