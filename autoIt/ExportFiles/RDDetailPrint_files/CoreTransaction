    BtnSaveReasonSubmit: function () {
        //// debugger
        try {
            if ($('#txtSaveReason').val() == "") {
                COMMON.prototype.showMessage(PRICEBOOK.getResourceValue("msgEnterReason", GetPBResourceMessages));
                return false;
            }
            else {
                StrSaveReason = $('#txtSaveReason').val();
                PRICEBOOK.SavePBData();
                if ($('#txtSaveReason').val() != "") {
                    $('#txtSaveReason').val("");
                    StrSaveReason = "";
                }
                $('#SaveReasonPopup').modal('hide');
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{PRICEBOOK.BtnSaveReasonSubmit} " + err.message, "Exception");
            return false;
        }
    },
