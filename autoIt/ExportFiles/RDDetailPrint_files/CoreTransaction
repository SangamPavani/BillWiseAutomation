    Validate: function () {
        try {
            var BudgetId = parseInt(OPTIONCONTROL.getControlValue("optPlanName"));
            if (BudgetId == 0) {
                COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgCantFindPlan", AddEditBudgetResourceMessages));
                return false;
            }
            var PlanName = OPTIONCONTROL.getControlText("optPlanName");
            if (PlanName.trim().length == 0) {
                COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgSelectPlan", AddEditBudgetResourceMessages));
                return false;
            }
            var grdAddEditBudget = document.getElementById('grdAddEditBudget_body');
            for (var index = 1; index <= grdAddEditBudget.rows.length; index++) {
                var TotalSplitedQty = ADDEDITBUDGET.GetRowWiseSplittedTotalQty(index);
                var TotalSplitedValue = ADDEDITBUDGET.GetRowWiseSplittedTotalValue(index);
                var SplitType = ADDEDITBUDGET.GetRowWiseSplittedType(index);
                var AddQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 10).getCellData("value");
                if (SplitType < 2)//skip checking 0 and 1
                    continue;
                if (AddQty > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedQty) != parseFloat(AddQty)) {
                        COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgSplitQtyShouldbeEqualToAddQty", AddEditBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var ReduceQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 11).getCellData("value");
                if (ReduceQty > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedQty) != parseFloat(ReduceQty)) {
                        COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgSplitQtyShouldbeEqualToReduceQty", AddEditBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var AddValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 13).getCellData("value");
                if (AddValue > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedValue) != parseFloat(AddValue)) {
                        COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgSplitValShouldbeEqualToAddValue", AddEditBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
                var ReduceValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 14).getCellData("value");
                if (ReduceValue > 0)//means Qty Added
                {
                    if (parseFloat(TotalSplitedValue) != parseFloat(ReduceValue)) {
                        COMMON.prototype.showMessage(ADDEDITBUDGET.getResourceValue("msgSplitValShouldbeEqualToReduceValue", AddEditBudgetResourceMessages) + TotalSplitedQty);
                        return false;
                    }
                }
            }
            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("ADDEDITBUDGET.Validate : " + err.message, "Exception");
            return false;
        }
    },
