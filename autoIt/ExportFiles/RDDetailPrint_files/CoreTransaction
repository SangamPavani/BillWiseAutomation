    GetBudgetBodyData: function () {
        try {
            FGRIDCONTROL.update("grdAddEditBudget");
            var Edit = document.getElementById("hdniScreenType").value == 'Modify' ? 'true' : 'false';
            //debugger
            var lstBudgetData = [];
            var grdAddEditBudget = document.getElementById('grdAddEditBudget_body');
            for (var index = 1; index <= grdAddEditBudget.rows.length; index++) {
                var ActualQty = 0;
                var ActualValue = 0;
                var AddQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 10).getCellData("value").trim();
                var ReduceQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 11).getCellData("value").trim();
                if (AddQty > 0) {
                    ActualQty = AddQty;
                }
                else if (ReduceQty > 0) {
                    ActualQty = (-1) * (ReduceQty);
                }
                else if (Edit == 'false') {
                    ActualQty = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 9).getCellData("value").trim();
                }
                var AddValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 13).getCellData("value").trim();
                var ReduceValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 14).getCellData("value").trim();
                if (AddValue > 0) {
                    ActualValue = AddValue;
                }
                else if (ReduceValue > 0) {
                    ActualValue = (-1) * (ReduceValue);
                }
                else if (Edit == 'false') {
                    ActualValue = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 12).getCellData("value").trim();
                }
                var ReviseDetailId = "";
                if (FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 16).getCellData("value") == "") {
                    ReviseDetailId = 0;
                }
                else {
                    ReviseDetailId = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 16).getCellData("value");
                }
                var objRow = {
                    BudgetDetailId: parseInt(FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 2).getCellData("value").trim()),
                    BudgetType: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 3).getCellData("value"),
                    Tag1: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 4).getCellData("value"),
                    Tag2: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 5).getCellData("value"),
                    Tag3: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 6).getCellData("value"),
                    ProductId: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 7).getCellData("value"),
                    AccountId: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 8).getCellData("value"),
                    Quantity: ActualQty,
                    Value: ActualValue,
                    SplitType: ADDEDITBUDGET.GetRowWiseSplittedType(index),
                    SpillOver: ADDEDITBUDGET.GetRowWiseSpillOverType(index),
                    DBSplit: ADDEDITBUDGET.GetRowWiseSplittedData(index),
                    Narration: FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 15).getCellData("value"),
                    ReviseDetailId: ReviseDetailId
                }
                //   var BudgetConfirmedId = FGRIDCONTROL.getCellObject("grdAddEditBudget", index, 1).getCellText("value");
                var iTag1 = document.getElementById("hdnIsTag1").value;
                var iTag2 = document.getElementById("hdnIsTag2").value;
                var iTag3 = document.getElementById("hdnIsTag3").value;

                var Count = 0
                var ele = objRow
                if (ele.BudgetType != "") {
                    Count += 1
                }
                if (iTag1 > 0 && ele.Tag1 != "" && ele.Tag1 != "NaN" && ele.Tag1 != "0") {
                    Count += 1
                }
                if (iTag2 > 0 && ele.Tag2 != "" && ele.Tag2 != "NaN" && ele.Tag2 != "0") {
                    Count += 1
                }
                if (iTag3 > 0 && ele.Tag3 != "" && ele.Tag3 != "NaN" && ele.Tag3 != "0") {
                    Count += 1
                }
                if (ele.ProductId != "" && ele.ProductId != "NaN" && ele.ProductId != "0") {
                    Count += 1
                }
                if (ele.AccountId != "" && ele.AccountId != "NaN" && ele.AccountId != "0") {
                    Count += 1
                }
                if (ele.Quantity != 0) {
                    Count += 1
                }
                if (ele.Value != 0) {
                    Count += 1
                }
                if (objRow != undefined && objRow != null && (objRow.Value != 0 || objRow.Quantity != 0)) {

                    if ((AddQty != 0 || ReduceQty != 0 || AddValue != 0 || ReduceValue != 0) && Edit == 'true') {
                        lstBudgetData.push(objRow);
                    }
                }
                if (objRow != undefined && objRow != null && Edit == 'false') {
                    if (Count > 0) {
                        lstBudgetData.push(objRow);
                    }
                }
            }
            return lstBudgetData;
        }
        catch (err) {
            COMMON.prototype.showMessage("ADDEDITBUDGET.GetBudgetBodyData : " + err.message, "Exception");
            return null;
        }
