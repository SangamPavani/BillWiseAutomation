                        }
                        else if (SplitType == 1) {
                            COMMON.prototype.showMessage(AddEditImportBudget.getResourceValue("msgCantUpdateToShorterPeriod", GetBudgetResourceMessages));
                            if (!bFromSave) {
                                document.getElementById('cmbSpillOvers').value = SplitType;
                            }
                            return false;
                        }
                    }
                case 2://quartely
                    {
                        if (SplitType == 2)
