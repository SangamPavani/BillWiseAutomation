        //debugger
        try {
            var RejectedRows = [];
            var isRevisionIdSelected = false;
            var ApprovedBudgetMore = FGRIDCONTROL.getTotalRows(REJECTBUDGETS.sGridIdSecond());
            var BudgetId = parseInt(document.getElementById('hdnBudgetId').value);
