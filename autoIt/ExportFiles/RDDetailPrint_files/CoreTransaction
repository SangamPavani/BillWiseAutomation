                                if (BodyRow.ProductID <= 0) {
                                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("lblProduct ", GetBudgetResourceMessages) + " " + REJECTBUDGETS.getResourceValue("MRP_RPO_msgCannotBeEmptyInGridRow ", GetBudgetResourceMessages) + " " + iRowCounter);
                                    return false;
                                }
                            }
                            RejectedRows.push(BodyRow);
                        }
                    }
                }
                if (RejectedRows.length == 0) {
                    COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("MRP_R_msgNoDataFound", GetBudgetResourceMessages));//"Please select Record for Authorize or Reject"
                    return false;
                }
                // return true;
                NETWORK.executeServerMethod(
                    GLOBAL.getContextPath("SaveRejectedBudget", "Budget", "Budgeting"),
                    true,
                    { objRejectedHeadder: BudgetRejectedDetails, RejectedRows: RejectedRows, iTypeId: iTypeId },
                    "JSON",
                    true,
                    "REJECTBUDGETS.SaveRejectedBudgetSucess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", iStatus);
            }
            else {
                COMMON.prototype.showMessage(REJECTBUDGETS.getResourceValue("MRP_PP_msgSelectRecord", GetBudgetResourceMessages));//"Please select Record for Authorize or Reject"
                return false;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("REJECTBUDGETS.SaveRejectedBudget : " + err.message, "Exception");
            return false;
        }
