    preOrderVoucherTransaction: function () {
        try {
            let arrPreOrderVoucherTransaction = [], arrPreOrderVoucherTransactionHeader = [], arrPreOrderVoucherTransactionBody = [];
            let exchangeRate = 1;
            let lstVouchersExtraFieldInfo = VOUCHERPOSTING.SINGLTONVARIABLES.VoucherExtraFieldsInfo.filter((p) => p.VoucherType == PreferenceSetting.PrefPostingTab.PreOrderVoucher);
            if (lstVouchersExtraFieldInfo != null && lstVouchersExtraFieldInfo != undefined && lstVouchersExtraFieldInfo.length > 0)
                lstVouchersExtraFieldInfo = lstVouchersExtraFieldInfo[0];
            let dummyBodyAndFooterCustAndERPFields = VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields.filter((p) => p.VoucherType == PreferenceSetting.PrefPostingTab.PreOrderVoucher);
            if (dummyBodyAndFooterCustAndERPFields != null && dummyBodyAndFooterCustAndERPFields != undefined && dummyBodyAndFooterCustAndERPFields.length > 0)
                dummyBodyAndFooterCustAndERPFields = dummyBodyAndFooterCustAndERPFields[0];

            //Transaction Header
            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType] = PreferenceSetting.PrefPostingTab.PreOrderVoucher;
            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateInv] = false;
            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = true;
            if (ApplicationNew.PreviousTransaction == null || ApplicationNew.PreviousTransaction == undefined || (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                && (ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction == null || ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction == undefined))) {
                VOUCHERPOSTING.TRANSACTION.fillTransactionHeaderDateAndTime(arrPreOrderVoucherTransactionHeader);
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.EnteredBy] = POSCommon.userId;
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DoNotAllowPreOrderACInPreOrderSettlement == false)
                    arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = true;
                else
                    arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = false;

                //assiging default values for new preorder header
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.DocNo] = "";
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderId] = 0;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.CreatedByUser] = POSCommon.userId;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsEditing] = false;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedBy] = POSCommon.userId;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedDate] = POSCommon.transactionDate;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedTime] = FTime.getCurrentTime();
            }
            else {
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.DocNo] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.DocNo;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderId] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.HeaderId;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.CreatedByUser] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.CreatedByUser;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.Date] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.Date;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsEditing] = true;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedBy] = POSCommon.userId;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedDate] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.ModifiedDate;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedTime] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.ModifiedTime;
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.Flags.UpdateFA;;
            }
            // Filling Header Extra Fields
            let headerExtraField = VOUCHERPOSTING.HEADEREXTRAFIELD.addHeaderExtraFieldInPreOrderTransaction([arrPreOrderVoucherTransactionHeader]);
            if (headerExtraField != null && headerExtraField != undefined && headerExtraField.length > 0) {
                if (Boolean(headerExtraField[0]) == true)
                    arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = headerExtraField[1];
                else
                    arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = null;
            }
            else if (headerExtraField == null || headerExtraField == undefined || headerExtraField.length <= 0)
                arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = null;

            arrPreOrderVoucherTransaction[TransactionIndex.HEADER] = arrPreOrderVoucherTransactionHeader;

            // Transaction Body
            let bodyColMap = VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields.filter((f) => f.ID != 0 && f.TemplateID != 0 && f.TypeID == 1);
            if (bodyColMap == null || bodyColMap == undefined || bodyColMap.length <= 0)
                bodyColMap = [];

            let bodyColMapERP = VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields.filter((f) => f.ID == 0 && f.TemplateID == 0 && f.TypeID == 1);
            if (bodyColMapERP != null && bodyColMapERP != undefined && bodyColMapERP.length > 0) {
                for (let i = 0; i < bodyColMapERP.length; i++)
                    bodyColMap.push(bodyColMapERP[i]);
            }
            let loadedPOSSaleBodyIds = [], loadedPOSSaleTransIds = [];
            if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined) {
                loadedPOSSaleBodyIds = ApplicationNew.PreviousTransaction.LoadedPOSSaleBodyIds;
                loadedPOSSaleTransIds = ApplicationNew.PreviousTransaction.LoadedPOSSaleTransIds;
            }
            arrPreOrderVoucherTransactionBody = VOUCHERPOSTING.TRANSACTION.fillTransactionBody([arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType], loadedPOSSaleBodyIds, loadedPOSSaleTransIds, exchangeRate, bodyColMap]);
            arrPreOrderVoucherTransaction[TransactionIndex.BODY] = arrPreOrderVoucherTransactionBody;

            // Transaction Footer
            let rtnValues = VOUCHERPOSTING.TRANSACTION.fillTransactionFooter([arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType], VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields]);
            if (rtnValues != null && rtnValues != undefined && rtnValues.length > 0) {
                if (rtnValues[0] == true && rtnValues[1] != null && rtnValues[1] != undefined && rtnValues[1].length > 0)
                    arrPreOrderVoucherTransaction[TransactionIndex.FOOTER] = rtnValues[1];
                else
                    arrPreOrderVoucherTransaction[TransactionIndex.FOOTER] = null;
            }
            return arrPreOrderVoucherTransaction;
        }
        catch (err) {

            toastr.error(err.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.preOrderVoucherTransaction :: Catch Block :: Exception :: " + JSON.stringify(err));
            return null;
        }
    },
