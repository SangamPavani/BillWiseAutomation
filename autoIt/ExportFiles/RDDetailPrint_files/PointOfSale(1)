        }
    },
    loadTransactionBodyToCustLineWise: function (_Body, _CustLine, _bodyColMap, VoucherType, loadedTransaction = null, isEstimationBill = false, productIds = []) {
        try {
            debugger;
            _CustLine.DefaultValue1 = _Body.Sales.Product;
            _CustLine.DefaultValue4 = FConvert.toDecimal(_Body.Sales.OrigRate, POSCommon.NumberOfDecimals, true);

            if (_Body.Sales.POSData != null && _Body.Sales.POSData != undefined && _Body.Sales.POSData.ModifierId > 0) {
                _CustLine.PosProductMake = PosProductMake.get("MODIFIER");
                _CustLine.ProductMake = PosProductMake.get("MODIFIER");
            }

            LOADTRANSACTION.loadBodyExtraFieldsData(_Body, _CustLine);

            _CustLine.DefaultValue3 = Math.abs(FConvert.toDecimal(_Body.Sales.Quantity, POSCommon.NumberOfDecimals, true));
            let def3 = _CustLine.ProductType == PosProductType.get("NORMAL") || _CustLine.ProductType == PosProductType.get("COMPLIMENTARY") ? 1 : -1;
            _CustLine.DefaultValue3 = FConvert.toDecimal(_CustLine.DefaultValue3, POSCommon.NumberOfDecimals, true) * FConvert.toDecimal(def3, POSCommon.NumberOfDecimals, true);

            ////debugger;
            if (ESTIMATIONBILL.VARIABLES.LoadEstimatedVoucher == true) {
                _CustLine.EstimatedQuantity = _CustLine.DefaultValue3;
                if (loadedTransaction != null && loadedTransaction != undefined && loadedTransaction.Header != null && loadedTransaction.Header != undefined
                    && loadedTransaction.Header.DocNo != null && loadedTransaction.Header.DocNo != undefined && loadedTransaction.Header.DocNo.length > 0)
                    _CustLine.EstimatedVoucher = loadedTransaction.Header.DocNo;
                else
                    _CustLine.EstimatedVoucher = "";
            }

            if (_Body.Sales.SetId > 0)
                _CustLine.DefaultValue5 = _CustLine.ProductType == 0 ? Math.abs(FConvert.toDecimal(_Body.Sales.Gross, POSCommon.NumberOfDecimals, true)) : FConvert.toDecimal(_Body.Sales.Gross, POSCommon.NumberOfDecimals, true);
            else
                _CustLine.DefaultValue5 = FConvert.toDecimal(_CustLine.DefaultValue3, POSCommon.NumberOfDecimals, true) * FConvert.toDecimal(_CustLine.DefaultValue4, POSCommon.NumberOfDecimals, true);

            _CustLine.ProductUnit = _Body.Sales.Unit;
            _CustLine.ProductUnitName = _Body.Sales.UnitName;
            _CustLine.BatchData = _Body.Sales.BatchNo;
            _CustLine.Code = _Body.Code;
            if (_CustLine.BatchData != null && _CustLine.BatchData != undefined) {
                _CustLine.BatchNo = _CustLine.BatchData.BatchNo;
                if (ESTIMATIONBILL.VARIABLES.LoadEstimatedVoucher == true) {
                    let data = PRODUCTMETHODNEW.BATCHPOPUPMETHODS.SERVER.getBatchDetails(_CustLine.DefaultValue1, _CustLine.BatchNo, 0);
                    if (PRODUCTMETHODNEW.VARIABLES.BatchDetails != null && PRODUCTMETHODNEW.VARIABLES.BatchDetails != undefined)
                        data = PRODUCTMETHODNEW.VARIABLES.BatchDetails;

                    if (data != null && data != undefined && data.length > 0) {
                        if (data[0][1] <= 0) {
                            productIds.push(_CustLine.DefaultValue1);

                            _CustLine.BatchData = null;
                            _CustLine.BatchNo = "";
                        }
                    }
                }
            }

            if (_Body.Sales != null && _Body.Sales != undefined) {
                _CustLine.ParentId = _Body.Sales.SetId;
                if (_CustLine.ParentId != null && _CustLine.ParentId != undefined && _CustLine.ParentId > 0) {
                    if (_CustLine.ServiceCharge == 0) {
                        _CustLine.PosProductMake = PosProductMake.get("SET");
                        _CustLine.ProductMake = PosProductMake.get("SET");
                    }
                    else {
                        _CustLine.PosProductMake = PosProductMake.get("DYNAMICSET");
                        _CustLine.ProductMake = PosProductMake.get("DYNAMICSET");
                    }
                }
                _CustLine.RMANos = _Body.Sales.RMANos;

                // Filling Screen Data
                //Screen Data 
                if (_Body.Sales.ScreenData != null && _Body.Sales.ScreenData != undefined && _Body.Sales.ScreenData.length > 0) {
                    if (_bodyColMap != null && _bodyColMap != undefined && _bodyColMap.length > 0) {
                        let multiplyfactor = (_CustLine.ProductType == PosProductType.get("NORMAL") ? 1 : -1);

                        let BodyFieldDtls = null, screenData = null;

                        _CustLine.DynamicLineFields = [];
                        let ColumnIndex = 0;
                        _CustLine.DynamicLineFields = LOADTRANSACTION.getEmptyBodyExtraFieldsDefaultData(false);
                        for (let k = 0; k < _bodyColMap.length; k++) {
                            if (isEstimationBill == false)
                                BodyFieldDtls = POSCommon.BodyPanelExtraFieldsList.filter((p) => p.ID == _bodyColMap[k].ID);
                            else
                                BodyFieldDtls = POSCommon.BodyPanelExtraFieldsList.filter((p) => p.Name.toLowerCase() == _bodyColMap[k].Name.toLowerCase());

                            if (BodyFieldDtls == null || BodyFieldDtls == undefined)
                                continue;
                            if (BodyFieldDtls != null && BodyFieldDtls != undefined && BodyFieldDtls.length > 0)
                                BodyFieldDtls = BodyFieldDtls[0];

                            ColumnIndex = BodyFieldDtls.ColumnIndex;
                            _CustLine.DynamicLineFields[BodyFieldDtls.ColumnIndex] = new Object();

                            _CustLine.DynamicLineFields[BodyFieldDtls.ColumnIndex].FieldId = _bodyColMap[k].ID;
                            _CustLine.DynamicLineFields[BodyFieldDtls.ColumnIndex].FieldName = _bodyColMap[k].Name;
                            _CustLine.DynamicLineFields[BodyFieldDtls.ColumnIndex].FieldInput = _bodyColMap[k].PreloadValue;

                            if (VoucherType == PreferenceSetting.PrefPostingTab.POSVoucher) {
                                _CustLine.DynamicLineFields[ColumnIndex].FieldColMap = _bodyColMap[k].ColMap;
                                screenData = _Body.Sales.ScreenData.filter((s) => s.ColMap == _bodyColMap[k].ColMap);
                                if (screenData != null && screenData != undefined && screenData.length > 0)
                                    screenData = screenData[0];
                            }
                            else if (VoucherType == PreferenceSetting.PrefPostingTab.PreOrderVoucher) {
                                _CustLine.DynamicLineFields[ColumnIndex].FieldColMap = _bodyColMap[k].PreOrderColMap;
                                screenData = _Body.Sales.ScreenData.filter((s) => s.ColMap == _bodyColMap[k].PreOrderColMap);
                                if (screenData != null && screenData != undefined && screenData.length > 0)
                                    screenData = screenData[0];
                            }
                            else if (VoucherType == PreferenceSetting.PrefPostingTab.SalesReturnVoucher) {
                                _CustLine.DynamicLineFields[ColumnIndex].FieldColMap = _bodyColMap[k].SalesReturnColMap;
                                screenData = _Body.Sales.ScreenData.filter((s) => s.ColMap == _bodyColMap[k].SalesReturnColMap);
                                if (screenData != null && screenData != undefined && screenData.length > 0)
                                    screenData = screenData[0];
                            }
                            if (screenData == null || screenData == undefined || screenData.length < 0)
                                continue;
                            multiplyfactor = _bodyColMap[k].OutputCalculationId == 1 ? multiplyfactor : 1;
                            _CustLine.DynamicLineFields[ColumnIndex].FieldColMap = screenData.ColMap;
                            _CustLine.DynamicLineFields[ColumnIndex].FieldInput = multiplyfactor * FConvert.toDecimal(screenData.Input, POSCommon.NumberOfDecimals, true);
                        }
                    }
                }
                else if (POSCommon.BodyPanelExtraFieldsList != null && POSCommon.BodyPanelExtraFieldsList != undefined && POSCommon.BodyPanelExtraFieldsList.length > 0) {
                    _CustLine.DynamicLineFields = LOADTRANSACTION.getEmptyBodyExtraFieldsDefaultData();
                }
            }
            if (_Body.Tags != null && _Body.Tags != undefined && _Body.Tags.length > 0) {
                if (PreferenceSetting.PrefMiscellaneousOtherTab.SalesmanSelectionItemWise == true)
                    _CustLine.SalesmanId = _Body.Tags.find(p => p.ID == 800).Tag;

                if (PreferenceSetting.PrefMiscellaneousOtherTab.MemberSelectionItemWise == true)
                    _CustLine.MemberId = _Body.Tags.find(p => p.ID == 1106).Tag;
            }
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: LOADTRANSACTION.loadTransactionBodyToCustLineWise :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
