    validateKeyPress: function (event, inputControl) {
        try {
            //debugger;
            var charCode = (event.which) ? event.which : event.keyCode;
            if (charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (event.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
