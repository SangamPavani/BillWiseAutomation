        if (CREDITNOTE.VARIABLE.preferenceSetting.PrefMiscellaneousTab.CreditNoteExpInDays > 0) {
            let CurrentValidity = DATEPICKER.getDate("dpCurrentValidTillDate");
            let maxValidDate = FDate.addDays(CurrentValidity, CREDITNOTE.VARIABLE.preferenceSetting.PrefMiscellaneousTab.CreditNoteExpInDays, CREDITNOTE.VARIABLE.posCommon.calType);
            var iDay = DATE.prototype.getDayFromFocusDate(maxValidDate);
            var iMonth = DATE.prototype.getMonthFromFocusDate(maxValidDate);
            var iYear = DATE.prototype.getYearFromFocusDate(maxValidDate);
            var maxExtendValidDate = iDay + "/" + iMonth + "/" + iYear;
            if (DATEPICKER.getDate("dpExtendValidTillDate") > maxValidDate) {
                toastr.error("Extend Valid should be less than " + maxExtendValidDate);
                return false;
            }
        }
