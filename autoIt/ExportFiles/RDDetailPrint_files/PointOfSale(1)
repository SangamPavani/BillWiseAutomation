                            $("#txtPointsRedemptionMobileOTP").val("");
                            $("#txtMemberPointPrepaidMobileOTP").focus();
                            $("#txtPointsRedemptionMobileOTP").focus();
                            $("#divPointsRedemptionVerifyOTP").css('display', 'none');
