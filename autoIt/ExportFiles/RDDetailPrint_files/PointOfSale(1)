    afterChangePriceShortcutPopup: function (priceEntered) {
        try {
            PRODUCTMETHODNEW.requiredActionBeforePosting();

            if (ApplicationNew == null || ApplicationNew == undefined) {
                toastr.error("Error while deserializing Application object", "POS Information");
                return;
            }
            ApplicationNew.ApprovedBy = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.getActionApprovedByIfExists(ApplicationNew.CurrentItem, ApplicationNew.RetailTransFooter, false, PosActionIds.get("CHANGEPRICE"));

            let dPreviousPrice = ApplicationNew.CurrentItem.DefaultValue4;
            ApplicationNew.CurrentItem.DefaultValue4 = priceEntered;
            ApplicationNew.CurrentItem.ManualPrice = priceEntered;
            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;

            // #region Validating Average Purchase Price--1005
            let rtnAvgPrice = PRODUCTSELECTION.validateDiscountWithAveragePurchasePrice(ApplicationNew.CurrentItem, 1005);

            if (rtnAvgPrice != null && rtnAvgPrice != undefined && rtnAvgPrice.length > 0 && rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined) {
                if (FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                    ApplicationNew.CurrentItem.DefaultValue4 = dPreviousPrice;
                    ApplicationNew.CurrentItem.ManualPrice = dPreviousPrice;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                    toastr.info(rtnAvgPrice[1]);
                    return;
                }
            }

            // #region Validating Price Book Rate --1005
            let rtnPriceBookRate = PRODUCTSELECTION.validateDiscountWithPriceBookRate(ApplicationNew.CurrentItem, 1064);

            if (rtnPriceBookRate != null && rtnPriceBookRate != undefined && rtnPriceBookRate.length > 0 && rtnPriceBookRate[0] != null && rtnPriceBookRate[0] != undefined) {
                if (FConvert.toBoolean(rtnPriceBookRate[0]) == false) {
                    ApplicationNew.CurrentItem.DefaultValue4 = dPreviousPrice;
                    ApplicationNew.CurrentItem.ManualPrice = dPreviousPrice;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                    toastr.info(rtnPriceBookRate[1]);
                    return;
                }
                else if (FConvert.toBoolean(rtnPriceBookRate[0]) == true && rtnPriceBookRate.length > 1 && rtnPriceBookRate[1] != null && rtnPriceBookRate[1] != undefined && rtnPriceBookRate[1].trim().length > 0) {
                    ApplicationNew.CurrentItem.DefaultValue4 = dPreviousPrice;
                    ApplicationNew.CurrentItem.ManualPrice = dPreviousPrice;
                    VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1064;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                    MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                    return;
                }
            }
            //#region CutOff Price / Manager Approval

            let rtnCutOffPrice = PRODUCTSELECTION.validateDiscountWithCutOffPrice(ApplicationNew.CurrentItem, 1005);
            if (rtnCutOffPrice != null && rtnCutOffPrice != undefined && rtnCutOffPrice.length > 0 && rtnCutOffPrice[0] != null && rtnCutOffPrice[0] != undefined) {
                if (FConvert.toBoolean(rtnCutOffPrice[0]) == false) {
                    ApplicationNew.CurrentItem.DefaultValue4 = dPreviousPrice;
                    ApplicationNew.CurrentItem.ManualPrice = dPreviousPrice;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                    return;
                }
                else if (rtnCutOffPrice.length > 1 && rtnCutOffPrice[1] != null && rtnCutOffPrice[1] != undefined) {
                    if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && rtnCutOffPrice[1].trim().length > 0) {
                        ApplicationNew.CurrentItem.DefaultValue4 = dPreviousPrice;
                        ApplicationNew.CurrentItem.ManualPrice = dPreviousPrice;
                        VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1006;
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                        MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                        return;
                    }
                }
            }

            // #region Unit && Quantity Wise Rate

            //if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApplyRateBasedOnQty == true)
            //    ApplicationNew.CurrentItem.DefaultValue4 = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.Abs(ApplicationNew.CurrentItem.DefaultValue3), 0);

            PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(ApplicationNew.CurrentItem, ApplicationNew);
            if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction !== undefined) {
                if (ApplicationNew.PresentTransactionMode < TransactionModes.get("VIEWPREORDER") && (ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == null || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == undefined)) {
                    if (PreferenceSetting.PrefGeneralTab.ImplSchAtBillStlmnt == false) {
                        POSSCHEMEIMPLEMENTATIONGENERICS.implementLineWiseSchemes();
                    }
                }
            }
            CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
            ApplicationNew.BatchRelatedList = [];
            //on succes method
            PRODUCTMETHODNEW.updateToGrid();
            return;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.CHANGEPRICEMETHODS.afterChangePriceShortcutPopup :: Catch block :: Exception :: " + Ex.message + " :: Description ::" + Ex.description);
        }
    },
