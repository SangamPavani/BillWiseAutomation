                    if (webResponse.Value != null && webResponse.Value != undefined && webResponse.Value.length > 0)
                        ApplicationNew.MemberData = VOUCHERPOSTING.VARIABLES.MemberData = webResponse.Value[0];
                }
            }

            return true;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.MEMBER.getCalculatedMemberPoint :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return false;
        }
