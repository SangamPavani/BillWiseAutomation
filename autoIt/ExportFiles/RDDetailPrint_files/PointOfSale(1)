                            PRODUCTMETHODNEW.BATCHPOPUPMETHODS.validateBatchSetting(_line.RetailSetsDetails[i], _line.RetailSetsDetails[i].DefaultValue3, applicationException);

                            ////////////debugger;
                            //if (rtnValue == null || rtnValue == undefined || rtnValue.length <= 0) {
                            //    console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: JavaScript Function :: PRODUCTSELECTION.addSetToGrid :: Information :: value is null after calling PRODUCTSELECTION.SERVER.validateBatchSetting");
                            //    return [false, "Exception while calling batch related functionalities"];
                            //}

                            //if (rtnValue[0] != null && rtnValue[0] != undefined && FConvert.toBoolean(rtnValue[0]) == false)
                            //    return [false, rtnValue[1]];
                            if (applicationException.ApplicationExceptionReturnType == (ApplicationExceptionReturnType.Failed)) {
                                if (applicationException.ApplicationExceptionMessageType == (ApplicationExceptionMessageType.Message) || applicationException.ApplicationExceptionMessageType == (ApplicationExceptionMessageType.Exception))
