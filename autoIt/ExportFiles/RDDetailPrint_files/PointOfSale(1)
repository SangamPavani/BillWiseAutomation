                else if (passingArgs.ProportionatedDiscount != _DiscToBeGiven && _DiscToBeGiven - passingArgs.ProportionatedDiscount < dCheckingValue && _DiscToBeGiven - passingArgs.ProportionatedDiscount > - dCheckingValue) {
                    let diff = FConvert.toDecimal(_DiscToBeGiven, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(passingArgs.ProportionatedDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
