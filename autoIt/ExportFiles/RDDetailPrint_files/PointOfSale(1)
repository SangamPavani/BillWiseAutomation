                            optCreditNoteId = FConvert.toInt(optCreditNoteId);
                            BILLSETTLEMENT.VARIABLE.cNDetails = BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.filter((p) => p.Id == optCreditNoteId);
                            if (BILLSETTLEMENT.VARIABLE.cNDetails != null && BILLSETTLEMENT.VARIABLE.cNDetails != undefined && BILLSETTLEMENT.VARIABLE.cNDetails.length > 0)
                                BILLSETTLEMENT.VARIABLE.cNDetails = BILLSETTLEMENT.VARIABLE.cNDetails[0];
                        }
                    }
                    break;
                }
                //newly added code by prathibha 26/04/2022
                //
                let dCreditNoteAmountUnpaid = 0;
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictPartialRedemptionOfCreditNote == true) {
