                        }
                    }
                }
                Application.RetailTransFooter.Savings = FConvert.toDecimal(Application.RetailTransFooter.MRP) - FConvert.toDecimal(Application.RetailTransFooter.UserWiseGross);
                Application.RetailTransFooter.Savings = FConvert.toDecimal((FConvert.toDecimal(Application.RetailTransFooter.MRP) - FConvert.toDecimal(Application.RetailTransFooter.UserWiseGross)) + FConvert.toDecimal(dItemsTotalDiscount), POSCommon.numberOfDecimal);
                Application.FooterCalculation.UserWiseNet = FConvert.toDecimal(Application.FooterCalculation.UserWiseSubTotal, POSCommon.numberOfDecimal);

                Application.RetailTransFooter.UserWiseGross = FConvert.toDecimal(Application.FooterCalculation.UserWiseGross, POSCommon.numberOfDecimal);
