    getActionApprovedByIfExists: function (_line, retailTransFooter, isFooter, actionType) {
        let approvedByExisting = null, approvedBy = null;
        try {
            if (isFooter == false) {
                if (_line != null && _line != undefined && _line.ActionsApprovedBy != null && _line.ActionsApprovedBy != undefined && _line.ActionsApprovedBy.length > 0)
                    approvedByExisting = _line.ActionsApprovedBy.filter((p) => p.ActionType == actionType);
                else
                    approvedByExisting = null;
            }
            else {
                if (retailTransFooter != null && retailTransFooter != undefined && retailTransFooter.ActionsApprovedBy != null && retailTransFooter.ActionsApprovedBy != undefined && retailTransFooter.ActionsApprovedBy.length > 0)
                    approvedByExisting = retailTransFooter.ActionsApprovedBy.filter((p) => p.ActionType == actionType);
                else
                    approvedByExisting = null;
            }

            if (approvedByExisting == null) {
                if (approvedBy == null && approvedBy == undefined)
                    approvedBy = POSDATASTRUCTURE.getEmptyActionsApproved();

                approvedBy.ActionType = actionType;
                approvedBy.LocationId = POSCommon.locationId;
            }
            else
                approvedBy = approvedByExisting;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: PRODUCTMETHODNEW.CHANGEPRICEMETHODS.getActionApprovedByIfExists, Catch block : Error Message : " + Ex.message);
        }

        return approvedBy;
