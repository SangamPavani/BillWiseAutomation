    assignEmployeDiscountToFreeProduct: function (isProportionate) {
        try {
            ApplicationNew.TotalSchemesInfo.LinePrompts = ApplicationNew.TotalSchemesInfo.LinePrompts.filter((p) => p.PromoType == PromoTypes.get("FREEITEM"));
            if (ApplicationNew.TotalSchemesInfo.LinePrompts != null && ApplicationNew.TotalSchemesInfo.LinePrompts != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts.length > 0)
                POSSCHEMEIMPLEMENTATIONGENERICS.updatePromptsList(ApplicationNew.TotalSchemesInfo.LinePrompts);

            /*Maximum Discount Allowed - yes */
            if (isProportionate == true) {
                for (let ic = 0; ic < POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes.length; ic++) {
                    let itemWiseDiscount = 0;

                    for (let mainitemscount = 0; mainitemscount < ApplicationNew.ListOfItems.length; mainitemscount++) {
                        if (ApplicationNew.ListOfItems[mainitemscount].DefaultValue1 == POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DefaultValue1)
                            itemWiseDiscount = itemWiseDiscount + FConvert.toDecimal(ApplicationNew.ListOfItems[mainitemscount].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    }
                    POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DynamicLineFields[0].FieldInput =
                        POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DynamicLineFields[0].FieldValue = FConvert.toDecimal(itemWiseDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
            }
            else if (isProportionate == false) /*Maximum Discount Allowed - No */ {
                for (let ic = 0; ic < POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes.length; ic++) {
                    let itemWiseDiscount = 0;
                    if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].PromoType != PromoTypes.get("FREEITEM")) {
                        for (let mainitemscount = 0; mainitemscount < ApplicationNew.ListOfItems.length; mainitemscount++) {
                            if (ApplicationNew.ListOfItems[mainitemscount].DefaultValue1 == POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DefaultValue1) {
                                if (ApplicationNew.ListOfItems[mainitemscount].PromoType != PromoTypes.get("FREEITEM"))
                                    ApplicationNew.ListOfItems[mainitemscount].DynamicLineFields[0].FieldInput = ApplicationNew.ListOfItems[mainitemscount].DynamicLineFields[0].FieldValue = itemWiseDiscount;

                                itemWiseDiscount = itemWiseDiscount + FConvert.toDecimal(ApplicationNew.ListOfItems[mainitemscount].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                            }
                        }
                        POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DynamicLineFields[0].FieldInput =
                            POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes[ic].DynamicLineFields[0].FieldValue = FConvert.toDecimal(itemWiseDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    }
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: posSchemeImplementationGenerics.js :: JavaScript Function :: CHECKSCHEMEDISCOUNT.assignEmployeDiscountToFreeProduct :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
