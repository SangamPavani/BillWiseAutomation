    getInputControlQuantityEvent: function (evt, parsedCellRecordOfClickedTableCell, inputControl) {
        try {
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined) {
                charCode = evt.which ? evt.which : evt.keyCode;
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.displayedToasterMsg = false;
            }

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (_isKeyPressQuantityEvent == true) {
                _isKeyPressQuantityEvent = false;
                return false;
            }
            if (charCode == 13 || charCode == 9) {
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlEvent = evt;
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControl = inputControl;
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlText = $(inputControl).val();// FConvert.toDecimal($(inputControl).val(), POSCommon.numberOfDecimal);
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlParentTableCell = $(inputControl).closest('td'); // parent td of input(textbox)
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlParentTableRow = $(TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlParentTableCell).closest('tr'); // parent tr of input(textbox)
                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.parsedCellRecordOfClickedTableCell = parsedCellRecordOfClickedTableCell;

                var rowRecordOfClickedTableCell = $(TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.inputControlParentTableRow).attr('data-RowRecord');
                if (rowRecordOfClickedTableCell != null && rowRecordOfClickedTableCell != undefined && rowRecordOfClickedTableCell.trim().length > 0)
                    TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.parsedRowRecordOfClickedTableCell = JSON.parse(rowRecordOfClickedTableCell);

                TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.rowIndex = -1; //iIndex
                for (var i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    if (ApplicationNew.ListOfItems[i].ItemSerialNo == TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.parsedRowRecordOfClickedTableCell.ItemSerialNo) {
                        TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.rowIndex = TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.parsedRowRecordOfClickedTableCell.ItemSerialNo - 1;
                        break;
                    }
                }

                TABLECHANGEMETHODSNEW.validateBeforeDeleteProductUsingQuantity();
                return;
            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: TABLECHANGEMETHODSNEW.getInputControlQuantityEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    getInputControlDiscountFieldEvent: function (evt, parsedCellRecordOfClickedTableCell, inputControl) {
        try {
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = evt.which ? evt.which : evt.keyCode;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (charCode == 13 || charCode == 9) {
                if (TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.inputControlLeaveEventExecute == true)
                    return;

                TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.inputControlLeaveEventExecute = true;

                var inputControlText = $(inputControl).val();
                var inputControlParentTableCell = $(inputControl).closest('td'); // parent td of input(textbox)
                var inputControlParentTableRow = $(inputControlParentTableCell).closest('tr'); // parent tr of input(textbox)
                var rowRecordOfClickedTableCell = $(inputControlParentTableRow).attr('data-RowRecord');
                var parsedRowRecordOfClickedTableCell = JSON.parse(rowRecordOfClickedTableCell);

                var iIndex = -1;
                for (var i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    if (ApplicationNew.ListOfItems[i].ItemSerialNo == parsedRowRecordOfClickedTableCell.ItemSerialNo) {
                        iIndex = i;
                        ApplicationNew.CurrentItem = ApplicationNew.ListOfItems[i];
                        break;
                    }
                }

                if (parsedCellRecordOfClickedTableCell.SequenceNumber == 8 && parsedCellRecordOfClickedTableCell.IsDiscountField == true) {
                    var dPrevDiscExtFldVal = parsedRowRecordOfClickedTableCell.DynamicLineFields[parsedCellRecordOfClickedTableCell.ColumnIndex].FieldValue;
                    if (inputControlText == null || inputControlText == undefined || inputControlText.trim() == "" || inputControlText.trim().length <= 0) {
                        toastr.error("Discount field should not be empty");
                        $(inputControl).focus();
                        $(inputControl).val(FConvert.toDecimal(dPrevDiscExtFldVal, POSCommon.numberOfDecimal));
                        return;
                    }

                    ApplicationNew.CurrentItem = parsedRowRecordOfClickedTableCell;
                    if (ApplicationNew.CurrentItem.ItemSerialNo == 1) {
                        ApplicationNew.CellRecordOfClickedTableCellForCopyOrPro = parsedCellRecordOfClickedTableCell;
                        ApplicationNew.ValueToCopyOrProportionate = inputControlText;
                    }
                    addProductToGridObject.inputControlParentTableCell = inputControlParentTableCell;
                    addProductToGridObject.previousValue = dPrevDiscExtFldVal;

                    var calculatingLinewiseFields = POSDATASTRUCTURE.getEmptyCalculatingLinewiseFields();
                    calculatingLinewiseFields.ClickedColumn = parsedCellRecordOfClickedTableCell;
                    calculatingLinewiseFields.EnteredQuantity = inputControlText;
                    calculatingLinewiseFields.PreviousValue = dPrevDiscExtFldVal;
                    TABLECHANGEMETHODSNEW.SERVERMETHODS.setOrCalculateLinewiseFields(calculatingLinewiseFields);
                    TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.inputControlLeaveEventExecute = false;
                    return;
                }

            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainAddProduct.js, Method: TABLECHANGEMETHODSNEW.getInputControlDiscountFieldEvent, Catch block : Error Message : " + Ex.message);
        }
    },
