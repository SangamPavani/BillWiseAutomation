                    return;
                }
                ApplicationNew.IsBarCodeSearch = true;// Added by Prathibha IsBarCodeSearch is true if it has sigle or multiple products.
                if (data.bSuccess == true && data.bMultipleProductFound == false) {
                    $("#txtBarcode").val("");

                    let result = await SEARCHPRODUCTBARCODE.doChangesNeedForBarCodeItem(data.barcodeProduct, data.quantity);
                    if (result != null && result != undefined && result.length > 0) {
                        if (result[0] == false) {
                            $("#txtBarcode").val("");
                            $("#txtBarcode").focus();
                            return;
                        }
                        else
                            data.barcodeProduct = result[1];
                    }
                    ////debugger;
                    if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION")) {
                        if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                            let arrSelectedProduct = ApplicationNew.ListOfItems.filter((p) => p.DefaultValue1 == data.barcodeProduct.ProductID);
                            if (arrSelectedProduct != null && arrSelectedProduct != undefined && arrSelectedProduct.length > 0) {
                                if (POSCommon.changeQuantityInPreOrder == false && POSCommon.addProductInPreOrder == false) {
                                    // Can not 'Add Product' & Can not 'Increase/decrease' the product quantity
                                    PREORDER.DUSMINUTESAPPINTEGRATION.displayInformationChangeQuantityInPreOrder(["PREORDER.DUSMINUTESAPPINTEGRATION.closeModalPopup()"]);
