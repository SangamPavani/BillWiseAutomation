    onSuccessVerifyOTP: function (bSuccess, data) {
        try {
            //debugger;
            let msgErrorInExecutionPleaseTryAgain = $("#msgErrorInExecutionPleaseTryAgain").val();
            let msgInvalidOTP = $("#msgInvalidOTP").val();
            let msgPOSInformation = $("#msgPOSInformation").val();
            let msgPOSException = $("#msgPOSException").val();
            let msgOTPExpired = $("#msgOTPExpired").val();
            let msgOTPverifiedSuccessfully = $("#msgOTPverifiedSuccessfully").val();
            let msgVerificationProcessFailedPleaseTryAgainReason = $("#msgVerificationProcessFailedPleaseTryAgainReason").val();
            let msgVerificationProcessFailedPleaseTryAgain = $("#msgVerificationProcessFailedPleaseTryAgain").val();
            let msgOTPExpiredPleaseResendOTPandTryAgain = $("#msgOTPExpiredPleaseResendOTPandTryAgain").val();

            GLOBAL.LoadingEnd();

            if (bSuccess == false)
                return;

            if (data.bSuccess == false) {
                if (data.sMessage != null && data.sMessage != undefined && data.sMessage.trim().length > 0)
                    toastr.error(msgVerificationProcessFailedPleaseTryAgainReason + data.sMessage);
                else
                    toastr.error(msgVerificationProcessFailedPleaseTryAgain, msgPOSException);
                return;
            }
            else if (data.bSuccess == true) {
                if (data.verificationIdNamePair == null || data.verificationIdNamePair == undefined) {
                    toastr.error(msgErrorInExecutionPleaseTryAgain, msgPOSException);
                    return;
                }
                else if (data.verificationIdNamePair != null && data.verificationIdNamePair != undefined) {
                    if (FConvert.toBoolean(data.verificationIdNamePair.Tag) == true) {
                        toastr.info(msgOTPverifiedSuccessfully, msgPOSInformation);
                    }
                    else if (FConvert.toBoolean(data.verificationIdNamePair.Tag) == false) {
                        toastr.error(msgInvalidOTP, msgPOSException);
                        $("#divVerifyOtpModal").css('display', 'block');
                        return;
                    }
                }
                SEARCHMEMBER.afterSuccessVerifyOTP();
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: SEARCHMEMBER.onSuccessVerifyOTP :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },

