                $('#ddlUnit').append("<option id='" + lstUnitList[0].ID + "' value='" + lstUnitList[0].ID + "' data-UnitDetails='" + JSON.stringify(lstUnitList[0]) + "' >" + lstUnitList[0].Name + "</option>");
            }
            else if (lstUnitIds != null && lstUnitIds != undefined && lstUnitIds.length == 1) {
                if (lstUnitIds[0] != null && lstUnitIds[0] != undefined && FConvert.toInt(lstUnitIds[0]) > 0) {
                    lstUnitIds = FConvert.toInt(lstUnitIds[0]);
                    //debugger;
                    let lstUnit = SCHEMES.SEVERMETHOD.GetUnitListOfBaseUnit(lstUnitIds, sProUnitId);
                    //debugger;
                    if (lstUnit != null && lstUnit != undefined && lstUnit.length > 0)
                        lstUnitList = lstUnit[0];
                }
                else {
                    IdNamePair = new Object();
                    IdNamePair.ID = 0;
                    IdNamePair.Name = "Base Unit";
                    lstUnitList.push(IdNamePair)
                }

                $('#ddlUnit').html('');
                for (let i = 0; i < lstUnitList.length; i++)
                    $('#ddlUnit').append("<option id='" + lstUnitList[i].ID + "' value='" + lstUnitList[i].ID + "' data-UnitDetails='" + JSON.stringify(lstUnitList[i]) + "' >" + lstUnitList[i].Name + "</option>");
