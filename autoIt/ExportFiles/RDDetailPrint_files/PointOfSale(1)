    getInputControlEvent: function (evt, inputControl, iPaymentCardType) {
        //isCreditCard
        try {
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = evt.which ? evt.which : evt.keyCode;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }
            if (charCode != 13 && charCode != 9)
                return false;

            ////debugger;
            var dCurrentCellEnteredValue = 0;
            var strCurrentValue = $(inputControl).val();
            var inputControlTableCell = $(inputControl).closest('td')[0];
            if (strCurrentValue == null || strCurrentValue == undefined || strCurrentValue == "" || strCurrentValue.trim().length <= 0) {
                $(inputControl).find('input').remove();
                $(inputControlTableCell).html(FConvert.toDecimal(0));
            }
            var inputControlTableRow = $(inputControlTableCell).closest('tr')[0];
            dCurrentCellEnteredValue = FConvert.toDecimal(strCurrentValue);

            if (iPaymentCardType == 0) //Credit Card
            {
                ////debugger;
                var parsedDetails = JSON.parse($(inputControlTableRow).attr("data-CreditCard"));
                var dPreVal = parsedDetails.AmtReturning;
                if (dCurrentCellEnteredValue <= 0 || dCurrentCellEnteredValue > (parsedDetails.DebitAmount - parsedDetails.AmtReturned) || dCurrentCellEnteredValue > FConvert.toDecimal(RefundSettlement.NetAmount)) {
                    $(inputControl).find('input').remove();
                    $(inputControlTableCell).html(FConvert.toDecimal(dPreVal, POSCommon.numberOfDecimal));
                    REFUNDSETTLEMENT.updatePaidAmt();
                    return false;
                }

                parsedDetails.AmtReturning = dCurrentCellEnteredValue;
                for (let i = 0; i < RefundSettlement.CreditCardPaymentDetails.length; i++) {
                    if (parsedDetails.CardTypeId == RefundSettlement.CreditCardPaymentDetails[i].CardTypeId) {
                        if (PreferenceSetting.PrefPaymentIntegrationTab.IsPaymentIntegrationEnable == true) {
                            if (PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.Valor) {
                                const counterRelatedSettings = null;
                                if (PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration != null && PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration != undefined &&
                                    PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords != null && PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords != undefined) {
                                    counterRelatedSettings = PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords.filter(p => p.CounterId == POSCommon.counterId);
                                }

                                if (counterRelatedSettings == null || counterRelatedSettings == undefined || counterRelatedSettings.length <= 0) {
                                    toastr.info("Please define counter wise setting for loggedin counter in preferences.", "POS Information");
                                    return false;
                                }

                                if (counterRelatedSettings[0].AppKey == null || counterRelatedSettings[0].AppKey == undefined || counterRelatedSettings[0].AppKey.length <= 0) {
                                    toastr.info("Please define AppKey for loggedin counter in preferences.", "POS Information");
                                    return false;
                                }

                                var valorPayRefundTransactionRequest = new Object();
                                valorPayRefundTransactionRequest.appkey = counterRelatedSettings[0].AppKey;
                                valorPayRefundTransactionRequest.appid = PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.AppId;
                                valorPayRefundTransactionRequest.epi = counterRelatedSettings[0].EPI;

                                valorPayRefundTransactionRequest.txn_type = "refund";
                                valorPayRefundTransactionRequest.amount = parsedDetails.AmtReturning;
                                valorPayRefundTransactionRequest.surchargeIndicator = 1;
                                valorPayRefundTransactionRequest.ref_txn_id = parsedDetails.PaymentIntegrationTransactionId;
                                valorPayRefundTransactionRequest.sale_refund = 1;
                                valorPayRefundTransactionRequest.auth_code = parsedDetails.PaymentIntegrationApprovalCode; //Approval code from Sale Response
                                valorPayRefundTransactionRequest.rrn = parsedDetails.PaymentIntegrationRRNNumber;
                                valorPayRefundTransactionRequest.token = "";

                                const valorPayRefundTransactionResponse = REFUNDSETTLEMENT.SERVERMETHODS.valorPayRefundTransaction(valorPayRefundTransactionRequest);
                                ////debugger;
                                if (valorPayRefundTransactionResponse == null || valorPayRefundTransactionResponse == undefined) {
                                    toastr.info("Exception while calling ValorPay integration API.", "POS Information");
                                    return false;
                                }

                                if (valorPayRefundTransactionResponse.msg != null && valorPayRefundTransactionResponse.msg != undefined && valorPayRefundTransactionResponse.msg?.trim().length > 0) {
                                    if (valorPayRefundTransactionResponse.msg?.trim() == "APPROVED")
                                        toastr.info("Refund transaction approved successfully.", "POS Information");
                                    else if (valorPayRefundTransactionResponse.msg?.trim() != "APPROVED") {
                                        toastr.error("Exception while refund transaction. Reason is '" + valorPayRefundTransactionResponse.msg?.trim() + "'", "POS Exception");
                                        parsedDetails.AmtReturning = dPreVal;
                                        RefundSettlement.CreditCardPaymentDetails[i].AmtReturning = dPreVal;
                                        $(inputControlTableRow).attr("data-CreditCard", JSON.stringify(parsedDetails));
                                        $(inputControl).find('input').remove();
                                        $(inputControlTableCell).html(FConvert.toDecimal(dPreVal, POSCommon.numberOfDecimal));
                                        return false;
                                    }
                                }
                            }
                        }

                        RefundSettlement.CreditCardPaymentDetails[i].AmtReturning = parsedDetails.AmtReturning;
                        var totalAmountReturning = 0;
                        for (let j = 0; j < RefundSettlement.CreditCardPaymentDetails.length; j++)
                            totalAmountReturning = totalAmountReturning + RefundSettlement.CreditCardPaymentDetails[j].AmtReturning;

                        var aa = FConvert.toDecimal($("#lblBillCreditCard").html());
                        if (totalAmountReturning > (FConvert.toDecimal(RefundSettlement.BalanceAmount) + FConvert.toDecimal(aa))) {
                            parsedDetails.AmtReturning = dPreVal;
                            RefundSettlement.CreditCardPaymentDetails[i].AmtReturning = dPreVal;
                            $(inputControlTableRow).attr("data-CreditCard", JSON.stringify(parsedDetails));
                            $(inputControl).find('input').remove();
                            $(inputControlTableCell).html(FConvert.toDecimal(dPreVal, POSCommon.numberOfDecimal));
                            break;
                        }
                        else {
                            RefundSettlement.CreditCardPaymentDetails[i].AmtReturning = parsedDetails.AmtReturning;

                            if (RefundSettlement.CreditCardPaymentDetails[i].AmtReturning > 0 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == false) {
                                RefundSettlement.CreditCardPaymentDetails[i].ReturningCardCharges = (RefundSettlement.CreditCardPaymentDetails[i].AmtReturning * RefundSettlement.CreditCardPaymentDetails[i].CardCharges) / RefundSettlement.CreditCardPaymentDetails[i].DebitAmount;
                                parsedDetails.ReturningCardCharges = (parsedDetails.AmtReturning * parsedDetails.CardCharges) / parsedDetails.DebitAmount;
                            }
                            $(inputControlTableRow).attr("data-CreditCard", JSON.stringify(parsedDetails));
                            $(inputControl).find('input').remove();
                            $(inputControlTableCell).html(FConvert.toDecimal(parsedDetails.AmtReturning, POSCommon.numberOfDecimal));
                            break;
                        }
                    }
                }
            }
            else if (iPaymentCardType == 1) //Debit Card
            {
                var parsedDetails = JSON.parse($(inputControlTableRow).attr("data-DebitCard"));
                var dPreVal = parsedDetails.AmtReturning;
                if (dCurrentCellEnteredValue <= 0 || dCurrentCellEnteredValue > (parsedDetails.DebitAmount - parsedDetails.AmtReturned) || dCurrentCellEnteredValue > FConvert.toDecimal(RefundSettlement.NetAmount)) {
                    $(inputControl).find('input').remove();
                    $(inputControlTableCell).html(FConvert.toDecimal(dPreVal, POSCommon.numberOfDecimal));
                    REFUNDSETTLEMENT.updatePaidAmt();
                    return;
                }
                parsedDetails.AmtReturning = dCurrentCellEnteredValue;
                for (let i = 0; i < RefundSettlement.DebitCardPaymentDetails.length; i++) {
                    if (parsedDetails.CardTypeId == RefundSettlement.DebitCardPaymentDetails[i].CardTypeId) {
                        RefundSettlement.DebitCardPaymentDetails[i].AmtReturning = parsedDetails.AmtReturning;
                        var totalAmountReturning = 0;
                        for (let j = 0; j < RefundSettlement.DebitCardPaymentDetails.length; j++)
                            totalAmountReturning = totalAmountReturning + RefundSettlement.DebitCardPaymentDetails[j].AmtReturning;

                        var b = FConvert.toDecimal($("#lblBillDebitCard").html());
                        if (totalAmountReturning > (FConvert.toDecimal(RefundSettlement.BalanceAmount) + b)) {
                            parsedDetails.AmtReturning = dPreVal;
                            RefundSettlement.DebitCardPaymentDetails[i].AmtReturning = dPreVal;
                            $(inputControlTableRow).attr("data-DebitCard", JSON.stringify(parsedDetails));
                            $(inputControl).find('input').remove();
                            $(inputControlTableCell).html(FConvert.toDecimal(dPreVal, POSCommon.numberOfDecimal));
                            break;
                        }
                        else {
                            RefundSettlement.DebitCardPaymentDetails[i].AmtReturning = parsedDetails.AmtReturning;

                            if (RefundSettlement.DebitCardPaymentDetails[i].AmtReturning > 0 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == false) {
                                RefundSettlement.DebitCardPaymentDetails[i].ReturningCardCharges = (RefundSettlement.DebitCardPaymentDetails[i].AmtReturning * RefundSettlement.DebitCardPaymentDetails[i].CardCharges) / RefundSettlement.DebitCardPaymentDetails[i].DebitAmount;
                                parsedDetails.ReturningCardCharges = (parsedDetails.AmtReturning * parsedDetails.CardCharges) / parsedDetails.DebitAmount;
                            }

                            $(inputControlTableRow).attr("data-DebitCard", JSON.stringify(parsedDetails));
                            $(inputControl).find('input').remove();
                            $(inputControlTableCell).html(FConvert.toDecimal(parsedDetails.AmtReturning, POSCommon.numberOfDecimal));
                            break;
                        }
                    }
                }
            }
            else if (iPaymentCardType == 2) //EPayment
            {
                //////debugger;
                var parsedDetails = $(inputControlTableRow).attr("data-EPayment");
                if (parsedDetails == null || parsedDetails == undefined || parsedDetails.trim().length <= 0)
                    return;

