            if (controlValueOTP == null || controlValueOTP == undefined || controlValueOTP.trim().length <= 0) {
                toastr.error(msgProblemWhileReadingOTP);
                return;
            }

            var passingParameter = new Object();
            passingParameter.MobileNumber = controlValueMobile;
            passingParameter.OneTimePassword = controlValueOTP;

            BILLSETTLEMENT.SERVERMETHOD.verifyOTP(passingParameter, isPrePaidWallet);
