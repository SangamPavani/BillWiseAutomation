    validateKeyPressDecimal: function (evt, txtChangePrice) {

        try {
            $("#txtChangePrice").focus();
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (evt == null)
                charCode = 13;
            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(txtChangePrice).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (charCode == 13 || charCode == 9) {
                var priceEntered = $(txtChangePrice).val();
                if (priceEntered == null || priceEntered == undefined || FConvert.toDecimal(priceEntered, POSCommon.numberOfDecimal) == 0) {
                    toastr.error("Please enter rate");
                    return;
                }

                PRODUCTMETHODNEW.CHANGEPRICEMETHODS.closeChangePricePopup();
                return false;
            }
            else if (charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57))
                return true;
            return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.validateKeyPressDecimal :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
