            var RoundOff = 0;
            BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) - RoundOff;
            BillSettlement.RoundOff = 0;
            BILLSETTLEMENT.updatePaidAmt();

            if ($("#divCrDrIntegration").is(":visible") == true && $("#divCrDrCreditCardIntegration").is(":visible") == false) {
                if (BillSettlement.BalanceAmount > 0)
                    $("#txtCrDrCardAmount").val(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal));
                else
                    $("#txtCrDrCardAmount").val("0.00");

                $("#txtCrDrCardAmount").focus();
