    isValidRedemption: function () {
        //////debugger;
        try {
            var optMemberName = OPTIONCONTROL.getControlDataObject("optMemberNameId");
            var totalPoints = FConvert.toDecimal($("#txtPointsRedemptionTotalPoints").val());
            var msgMemPointsEmpty = $("#msgMemPointsEmpty").val();
            var msgEnterPoints = $("#msgEnterPoints").val();
            var msgMemberSelected = $("#msgMemberSelected").val();
            var msgMemPointsExceedValid = $("#msgMemPointsExceedValid").val();
            var msgCannotRedeemMoreThan10MembersPointsTrans = $("#msgCannotRedeemMoreThan10MembersPointsTrans").val();
            var msgBSRedemptionNotDefined = $("#msgBSRedemptionNotDefined").val();

            if (totalPoints == 0) {
                toastr.error(msgMemPointsEmpty);
                return false;
            }

            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != null
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length > 0) {
                if (BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length > 10) {
                    toastr.error(msgCannotRedeemMoreThan10MembersPointsTrans);
                    return false;
                }
            }
            var strPointsToRedeem = "";
            if (FConvert.toDecimal($.trim($("#txtPointsRedemptionPointsToRedeem").val())) >= 0)
                strPointsToRedeem = $.trim($("#txtPointsRedemptionPointsToRedeem").val());
            else if (FConvert.toDecimal($.trim($("#txtPointsRedemptionPointsToRedeemValue").val())) >= 0)
                strPointsToRedeem = $.trim($("#txtPointsRedemptionPointsToRedeemValue").val());

            if (strPointsToRedeem.length > 0 && FConvert.toDecimal(strPointsToRedeem) == 0) {
                toastr.error(msgEnterPoints);
                //$("#txtPointsRedemptionPointsToRedeem").focus();
                return false;
            }
            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != null
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length; i++) {
                    if (BillSettlement.BillSettlementPaymentDetails.MemberPointsDet[i].MemberId == optMemberName.iMasterId) {
                        toastr.error(BillSettlement.BillSettlementPaymentDetails.MemberPointsDet[i].MemberName + msgMemberSelected);
                        return false;
                    }
                }
            }
            let strPointsRedemptionValue = $("#txtPointsRedemptionPointsRedemptionVal").val();
            let totalRedemptionValue = strPointsToRedeem * strPointsRedemptionValue;
            if (totalRedemptionValue > BillSettlement.BalanceAmount) {
                toastr.info(msgMemPointsExceedValid);
                return false;
            }

            var strTotalPointsVal = totalRedemptionValue;
            ////debugger
            if (strTotalPointsVal == 0) {
                toastr.error(msgBSRedemptionNotDefined);
                return false;
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.isValidRedemption, Catch block : Error Message : " + Ex.message);
            return false;
        }
