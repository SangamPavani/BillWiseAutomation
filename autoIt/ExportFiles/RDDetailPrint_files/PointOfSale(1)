    getFieldNameLostFocusEvent: function () {
        try {
            var cbFieldName = OPTIONCONTROL.getControlText("optLineWiseFieldList");
            var lineWiseData = RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.bodyPanelLineWiseModelData;
            if (lineWiseData != null && lineWiseData != undefined && lineWiseData != "") {
                if (lineWiseData.lstFieldName != null && lineWiseData.lstFieldName != undefined && lineWiseData.lstFieldName.length > 0) {
                    var selItem = lineWiseData.lstFieldName.filter((p) => p.Name == cbFieldName);
                    if (selItem != null && selItem != undefined && selItem.length > 0) {
                        selItem = selItem[0];
                        RETAILMAINBODYPANELCUSTOMIZATION.makeLineControlsReadOnly(true);
                        RETAILMAINBODYPANELCUSTOMIZATION.commonLineWiseFieldNameLoading(selItem);
                        RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.lineWiseData = selItem;
                    }
                    else {
                        RETAILMAINBODYPANELCUSTOMIZATION.makeLineControlsReadOnly(false);
                        RETAILMAINBODYPANELCUSTOMIZATION.clearAllControlsWithoutName();
                    }
                }
            }
            debugger;
            let templateId = 0;
            if (RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.lineWiseData != null && RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.lineWiseData != undefined)
                templateId = FConvert.toDecimal(RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.lineWiseData.TemplateID);
            else {
                let optionControlData = OPTIONCONTROL.getControlDataObject(optTemplate);
                templateId = FConvert.toDecimal(optionControlData.iId);
            }
            let fieldId = RETAILMAINBODYPANELCUSTOMIZATION.SERVERMETHODS.getFieldIdFromPOS(cbFieldName, templateId);
            if (fieldId != null && fieldId != undefined)
                RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.lineWiseFieldId = fieldId;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
