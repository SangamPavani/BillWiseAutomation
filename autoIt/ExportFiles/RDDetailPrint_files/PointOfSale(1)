                                $(rowCheckBox[0]).prop("checked", true);

                                if (ApplicationNew.ArrayOfSearchProduct == null || ApplicationNew.ArrayOfSearchProduct == undefined || ApplicationNew.ArrayOfSearchProduct.length <= 0)
                                    ApplicationNew.ArrayOfSearchProduct = [];

