    searchMember: function (navigationButtonClick) {
        try {
            //debugger;
            var SearchTextMember = $("#txtSearchMember").val();
            var iMinchar = $("#divSearchMemberMain").attr('data-MinChar');
            var msgtxtInfoPlzMin = $("#msgtxtInfoPlzMin").val();
            var msgtxtInfoToSearch = $("#msgtxtInfoToSearch").val();
            var msgtxtNoResultsFound = $("#msgtxtNoResultsFound").val();
            var msgtxtRecNotFound = $("#msgtxtRecNotFound").val();
            var msgtxtErrWhileRetrvingMembDtlsPlzContYourSystmAdminstr = $("#msgtxtErrWhileRetrvingMembDtlsPlzContYourSystmAdminstr").val();
            let msgPhonenumbershouldnotbemorethan = $("#msgPhonenumbershouldnotbemorethan").val();

            if ($.trim(SearchTextMember).length < iMinchar) {
                toastr.error(msgtxtInfoPlzMin + " " + iMinchar + " " + msgtxtInfoToSearch);
                return;
            }

            var SearchBy = $("#divSearchMemberMain").attr('data-SearchBy');
            var SearchByPhone = $("#divSearchMemberMain").attr('data-SearchByPhone');
            var iCount = 0, iMaxCount = 0;
            var iCount = parseInt($("#divSearchMemberMain").attr('data-Count'));
            var iMaxCount = parseInt($("#divSearchMemberMain").attr('data-MaxCount'));
            var iRecordsPerPage = parseInt($("#divSearchMemberMain").attr('data-RecordPerPage'));
            // Implementing AllowPhoneNumberSearchTextMaxLength preference 10/11/2023
            if (FConvert.toInt(SearchBy) == 3 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowPhoneNumberSearchTextMaxLength == true) {
                if ($.trim(SearchTextMember).length > PreferenceSetting.PrefOutletTab.OutletGeneralTab.PhoneNumberSearchTextMaxLength) {
                    toastr.error(msgPhonenumbershouldnotbemorethan + PreferenceSetting.PrefOutletTab.OutletGeneralTab.PhoneNumberSearchTextMaxLength + " digit");
                    return;
                }
            }


            $("#divPrevDefFooterLeft").hide();
            var iRecordsPerPage = 25;
            if (navigationButtonClick == 1)
                iCount = 0;
            else if (navigationButtonClick == 2)
                iCount -= iRecordsPerPage;
            else if (navigationButtonClick == 3)
                iCount += iRecordsPerPage;
            else if (navigationButtonClick == 4) {
                iCount = iRecordsPerPage * (parseInt(iMaxCount / iRecordsPerPage));
                if (iCount == iMaxCount)
                    iCount -= iRecordsPerPage;

                $("#btnSearchMemberFirst").removeClass("nextPrevious");
                $("#btnSearchMemberFirst").addClass("nextPreviousActive");
                $("#btnSearchMemberPrevious").removeClass("nextPrevious");
                $("#btnSearchMemberPrevious").addClass("nextPreviousActive");
                $("#btnSearchMemberNext").removeClass("nextPreviousActive");
                $("#btnSearchMemberNext").addClass("nextPrevious");
                $("#btnSearchMemberLast").removeClass("nextPreviousActive");
                $("#btnSearchMemberLast").addClass("nextPrevious");
            }
            $("#btnSearchMemberFirst").removeClass("nextPrevious");
            $("#btnSearchMemberFirst").addClass("nextPreviousActive");
            $("#btnSearchMemberPrevious").removeClass("nextPrevious");
            $("#btnSearchMemberPrevious").addClass("nextPreviousActive");
            $("#btnSearchMemberNext").removeClass("nextPreviousActive");
            $("#btnSearchMemberNext").addClass("nextPrevious");
            $("#btnSearchMemberLast").removeClass("nextPreviousActive");
            $("#btnSearchMemberLast").addClass("nextPrevious");

            var defaultParameter = new Object();

            defaultParameter.SearchTextMember = SearchTextMember;
            defaultParameter.SearchBy = SearchBy;
            defaultParameter.SearchByPhone = SearchByPhone;
            defaultParameter.iCount = iCount;
            defaultParameter.iMaxCount = iMaxCount;
            defaultParameter.navigationButtonClick = navigationButtonClick;
            defaultParameter.iRecordsPerPage = iRecordsPerPage;

            SEARCHMEMBER.SERVER.searchMember(defaultParameter);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: SEARCHMEMBER.searchMember :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
    },
