    },
    getVariableValue: function (objVar, arrParams) {
        try {
            if (objVar.Var == null || objVar.Var == undefined)
                return 0;

            //if (FConvert.isNumeric(objVar.Var))
            //    return FConvert.toDecimal(objVar.Var, POSCommon.numberOfDecimal, true);

            let sErrorMessage = "";
            let customData = JSON.parse(arrParams.CustomData);
            let currentItem = customData.custLineWise;
            if (currentItem.DefaultValue1 == 0)
                return 0;

            let memberData = customData.MemberData;
            let selectedSearchOrCounterDefaultEmployee = customData.EmployeeData;
            let custLineWiseList = customData.ListOfItems;
            let arrVal = [];

            objVar.Var = objVar.Var.toLowerCase();

            let iFactor = objVar.Var.indexOf('-') == 0 ? -1 : 1;

            if (iFactor == -1)
                objVar.Var = objVar.Var.substring(1);

            //#region Master Variable

            let iMasterType = FConvert.getMasterTypeIdFromVariable(objVar.Var);

            if (iMasterType > 0) {
                try {
                    let iRowId = 0;
                    let iTagValue = 0;
                    switch (iMasterType) {
                        case MasterTypeId.Product:
                            iTagValue = currentItem.DefaultValue1; // currentItem.DefaultValue1;
                            break;
                        case MasterTypeId.Outlet:
                            iTagValue = POSCommon.outletId;
                            break;
                        case MasterTypeId.Counter:
                            iTagValue = POSCommon.counterId;
                            break;
                        case MasterTypeId.Member:
                            iTagValue = FConvert.toInt(memberData.ID);
                            break;
                        case MasterTypeId.Employee:
                            iTagValue = FConvert.toInt(selectedSearchOrCounterDefaultEmployee.MasterId);
                            break;
                    }

                    if (iTagValue == null || iTagValue == undefined || iTagValue <= 0)
                        return 0;

                    let arrMast = POSFORMULA.VARIABLES.MasterVarsList.filter((p) => p.MasterTypeId == iMasterType && p.Var == objVar.Var && p.MasterId == iTagValue && p.RowId == iRowId);

                    if (arrMast != null && arrMast != undefined && arrMast.length > 0) {
                        if (iFactor != null && iFactor != undefined && iFactor >= 0)
                            return arrMast[0].Value;
                        else
                            return FConvert.toDecimal((arrMast[0].Value * iFactor), POSCommon.numberOfDecimal, true);
                    }
                    else {
                        let objVal = POSFORMULA.SERVER.getMasterVariableValueForTransaction(objVar.Var, iTagValue, iRowId);
                        const objMasterVar = new Object();
                        objMasterVar.MasterTypeId = iMasterType;
                        objMasterVar.MasterId = iTagValue;
                        objMasterVar.Var = objVar.Var;
                        objMasterVar.RowId = iRowId;
                        objMasterVar.Value = objVal;

                        if (POSFORMULA.VARIABLES.MasterVarsList == null || POSFORMULA.VARIABLES.MasterVarsList == undefined || POSFORMULA.VARIABLES.MasterVarsList.length <= 0)
                            POSFORMULA.VARIABLES.MasterVarsList = [];

                        POSFORMULA.VARIABLES.MasterVarsList.push(objMasterVar);
                        if (iFactor >= 0)
                            return objVal;
                        else
                            return FConvert.toDecimal((objVal * iFactor), POSCommon.numberOfDecimal, true);
                    }
                }
                catch (Ex) {

                    GLOBAL.LoadingEnd();
                    toastr.error(Ex.message, "POS Exception");
                    console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Master Variables) :: Catch block :: Error Message :: " + Ex.message);
                    return 0;
                }
            }
            //#endregion

            let pattern = /^sb[0-9]+$/g;
            if (pattern.test(objVar.Var)) // Screen Body field - Input
            {
                let rtnValue = null;
                let iFieldOrder = FConvert.toInt(objVar.Var.substring(2));
                for (let i = 0; i < ApplicationNew.BodyPanelExtraFieldsList.length; i++) {
                    if (ApplicationNew.BodyPanelExtraFieldsList[i].SerialNumber == iFieldOrder) {
                        if (currentItem.DynamicLineFields != null && currentItem.DynamicLineFields.length > ApplicationNew.BodyPanelExtraFieldsList[i].ColumnIndex) {
                            rtnValue = FConvert.toDecimal((currentItem.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[i].ColumnIndex].FieldInput) * iFactor, POSCommon.numberOfDecimal, true);
                            return rtnValue;
                        }
                    }
                }
                return 0;
            }

            //#region POS Variables
            switch (objVar.Var) {
                case "dt":
                    return POSCommon.TransactionDate == 0 ? POSCommon.GetTodayValue() : POSCommon.TransactionDate;
                case "td":  // Today
                    return new DATE.prototype.today();  //Date().GetToday(POSCommon.CalType).Value;
                case "qty": // Quantity
                    try {
                        return FConvert.toDecimal(currentItem.DefaultValue3 * iFactor, POSCommon.numberOfDecimal, true);
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables - Quantity(qty)) :: Catch block :: Error Message :: " + Ex.message);
                    }
                case "tqty": // Total Quantity
                    try {
                        let dTotalQty = 0, dQty = 0;
                        if (custLineWiseList != null && custLineWiseList != undefined && custLineWiseList.length > 0) {
                            for (let i = 0; i < custLineWiseList.length; i++) {
                                dQty = FConvert.toDecimal(custLineWiseList[i].DefaultValue3 * iFactor, POSCommon.numberOfDecimal, true);
                                if (POSCommon.InputUnitInTransactions) {
                                    if (custLineWiseList[i].UnitIdNamePair != null && custLineWiseList[i].UnitIdNamePair != undefined &&
                                        FConvert.toInt(custLineWiseList[i].UnitIdNamePair.length) > 0 && custLineWiseList[i].UnitIdNamePair[0].Xfactor > 0)
                                        dQty = dQty * FConvert.toDecimal(custLineWiseList[i].UnitIdNamePair[0].Xfactor, POSCommon.numberOfDecimal, true);
                                }
                                dTotalQty = dTotalQty + dQty;
                            }
                            return dTotalQty;
                        }
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables - TotalQuantity(tqty)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "ttqty": // Total Quantity
                    try {
                        let dTotalQty = 0, dQty = 0;
                        if (custLineWiseList != null && custLineWiseList != undefined && custLineWiseList.length > 0) {
                            for (let i = 0; i < custLineWiseList.length; i++) {
                                dQty = FConvert.toDecimal(custLineWiseList[i].DefaultValue3 * iFactor, POSCommon.numberOfDecimal, true);
                                dTotalQty = dTotalQty + dQty;
                            }
                            return dTotalQty;
                        }
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables - TotalQuantity(ttqty)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "rt": // Rate
                    try {
                        return currentItem.DefaultValue4 * iFactor;
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables - Rate(rt)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "gr":  // Gross
                    try {
                        return FConvert.toDecimal((currentItem.DefaultValue5) * iFactor, POSCommon.numberOfDecimal, true);
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables - Gross(gr)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "grad":  // Gross after discount
                    try {
                        return FConvert.toDecimal((currentItem.DefaultValue5 - currentItem.DiscountTotal_UptoCurrentField) * iFactor, POSCommon.numberOfDecimal, true);
                    }
                    catch (ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables -  Gross after discount(grad)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "tgr":  // Total Gross
                    try {
                        let iLastRow = custLineWiseList.length, dTotalGross = 0;
                        for (let i = 0; i < iLastRow; i++)
                            dTotalGross = FConvert.toDecimal(dTotalGross + custLineWiseList[i].DefaultValue5, POSCommon.numberOfDecimal, true);

                        return Convert.ToDouble(dTotalGross);
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables -  Total Gross(tgr)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "tgrad":  // Total Gross After Discount
                    try {
                        let dTotalGrossafterdiscount = 0;
                        if (custLineWiseList != null && custLineWiseList != undefined && custLineWiseList.length > 0) {
                            for (let i = 0; i < custLineWiseList.length; i++)
                                dTotalGrossafterdiscount = FConvert.toDecimal(dTotalGrossafterdiscount + custLineWiseList[i].DefaultValue5 - custLineWiseList[i].DiscountTotal_UptoCurrentField, POSCommon.numberOfDecimal, true);

                            return FConvert.toDecimal(dTotalGrossafterdiscount, POSCommon.numberOfDecimal, true);
                        }
                    }
                    catch (Ex) {
                        GLOBAL.LoadingEnd();
                        toastr.error(Ex.message, "POS Exception");
                        console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables -  Total Gross After Discount(tgrad)) :: Catch block :: Error Message :: " + Ex.message);
                        return 0;
                    }
                case "prod": // Product
                    return currentItem.DefaultValue1;
                case "net":  // Net
                    return currentItem.DefaultValue15;
                case "tnet": // Total Net
                    let dTotalNet = 0;
                    if (custLineWiseList != null && custLineWiseList != undefined && custLineWiseList.length > 0) {
                        for (let i = 0; i < custLineWiseList.length; i++)
                            dTotalNet += Convert.ToDecimal(custLineWiseList[i].DefaultValue15);

                        return FConvert.toDecimal(dTotalNet, POSCommon.numberOfDecimal, true);
                    }

                case "salrt":  // Selling rate (Price book)
                case "purrt":  // Buying rate (Price book)
                case "salrtgrp": // Selling Rate Group
                case "purrtgrp": // Purchase Rate Group
                    if (objVar.arrParams.length == 5 || objVar.arrParams.length == 1) {
                        try {
                            let dQty = FConvert.toDecimal(currentItem.DefaultValue3, POSCommon.numberOfDecimal, true);

                            var iProd = 0, iDate = 0, iCust = 0, iTag = 0;

                            let iCurrencyId = 0;
                            let bPurchase = objVar.Var.startsWith("p");

                            if (objVar.arrParams.length == 5) {
                                iProd = FConvert.toInt(objVar.arrParams[0]);
                                iDate = FConvert.toInt(objVar.arrParams[1]);
                                iCust = FConvert.toInt(objVar.arrParams[2]);
                                iTag = FConvert.toInt(objVar.arrParams[3]);

                                arrVal.push(FConvert.toInt(objVar.arrParams[4]));
                            }
                            else {
                                iProd = currentItem.DefaultValue1;
                                iDate = POSCommon.transactionDate == 0 ? DATE.prototype.today() : POSCommon.transactionDate;
                                iTag = POSCommon.sellingTagValue;

                                arrVal.push(FConvert.toInt(objVar.arrParams[0]));
                            }
                            let iUnit = currentItem.ProductUnit;
                            iCurrencyId = POSCommon.localCurrency.CurrencyId;
                            let bChkGroup = objVar.Var.length > 5 ? true : false;

                            let arr = POSFORMULA.VARIABLES.RatesParamsList.filter((p) => p.iCust == iCust && p.iProd == iProd && p.iTag == iTag && p.iDate == iDate && p.iCurrencyId == iCurrencyId && p.iUnit == iUnit && p.dQty == dQty && p.Val == arrVal[0] && p.bPurchase == bPurchase && p.bChkInGroup == bChkGroup);

                            if (arr != null && arr != undefined && arr.length > 0)
                                return FConvert.toDecimal(arr[0].Rate * iFactor, POSCommon.numberOfDecimal, true);
                            else {
                                let rates = POSFORMULA.SERVER.getPriceBookRates(iCust, iProd, iTag, iDate, iCurrencyId, iUnit, dQty, arrVal, bPurchase, 0);
                                const objRateParam = new Object();
                                objRateParam.iCust = iCust;
                                objRateParam.iProd = iProd;
                                objRateParam.iTag = iTag;
                                objRateParam.iDate = iDate;
                                objRateParam.iCurrencyId = iCurrencyId;
                                objRateParam.iUnit = iUnit;
                                objRateParam.dQty = dQty;
                                objRateParam.Val = arrVal[0];
                                objRateParam.bPurchase = bPurchase;
                                objRateParam.bChkInGroup = bChkGroup;
                                objRateParam.Rate = rates;
                                objRateParam.Abbr = "";//strAbbr

                                if (POSFORMULA.VARIABLES.RatesParamsList == null || POSFORMULA.VARIABLES.RatesParamsList == undefined || POSFORMULA.VARIABLES.RatesParamsList.length <= 0)
                                    POSFORMULA.VARIABLES.RatesParamsList = [];

                                POSFORMULA.VARIABLES.RatesParamsList.push(objRateParam);
                                return (rates * iFactor);
                            }
                        }
                        catch (Ex) {
                            GLOBAL.LoadingEnd();
                            toastr.error(Ex.message, "POS Exception");
                            console.log("DateTime: " + new Date() + ", File :: retailMainCalculation.js :: Method:: POSFORMULA.getVariableValue (Getting Variables -  Purchase Rate Group (purrtgrp)) :: Catch block :: Error Message :: " + Ex.message);
                        }
                    }
                    return "0";
                case "itemmake":
                    let rtnValue = currentItem.ProductMake;
                    return rtnValue;
            }
            //#endregion
            return "0";
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method:POSFORMULA.getVariableValue, Catch block : Error Message : " + Ex.message);
        }
    }
};

