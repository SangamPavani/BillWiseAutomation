            _NewLineList[ProductCounter + i].PosProductMake = PosProductMake.get("DYNAMICSET");
            _NewLineList[ProductCounter + i].OriginalQuantity = _NewLineList[ProductCounter + i].DefaultValue3 / _loadingProduct.DefaultValue3;

