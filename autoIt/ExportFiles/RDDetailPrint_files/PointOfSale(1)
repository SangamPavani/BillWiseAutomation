    getInputControlEvent: function (inputControl, evt) {
        try {
            let msgQuantityToReturnShouldNotBeEmpty = $("input#msgQuantityToReturnShouldNotBeEmpty").val();
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined) {
                charCode = evt.which ? evt.which : evt.keyCode;
                SALESRETURN.VARIABLES.displayedToasterMsg = false;
            }

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (charCode != 13 && charCode != 9)
                return false;

            var inputControlClosestTableCell = $(inputControl).closest('td');
            var qtyToReturn = $(inputControl).val();
            if (qtyToReturn == null || qtyToReturn == undefined || qtyToReturn.trim().length <= 0) {
                toastr.error(msgQuantityToReturnShouldNotBeEmpty);
                $(inputControl).find('input').remove();
                $(inputControlClosestTableCell).html(FConvert.toDecimal(0, SALESRETURN.VARIABLES.preferenceSetting.PrefInventoryTab.DecmlsInQty));
                $("#txtReturnAmount").html(FConvert.toDecimal(0, SALESRETURN.VARIABLES.posCommon.numberOfDecimal));
                return;
            }

            var inputControlClosestTableRow = $(inputControl).closest('tr');
            var selectedIndex = $(inputControlClosestTableRow).attr('data-SelectedIndex');
            var salesReturnDetails = null;
            if (SALESRETURN.VARIABLES.moduleType == 1)
                salesReturnDetails = RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb;
            else
                salesReturnDetails = ApplicationNew.SalesReturn.SalesReturnWeb;

            salesReturnDetails.SelectedIndex = selectedIndex;
            $(inputControl).find('input').remove();
            SALESRETURN.SERVERMETHODS.salesReturnQuantityToReturnEdit(qtyToReturn, salesReturnDetails, inputControl);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: SALESRETURN.getInputControlEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
