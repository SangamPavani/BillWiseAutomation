        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleBillSettlement.js :: JavaScript Function :: BILLSETTLEMENT.confirmDeleteValorPaymentVoid :: Catch Block :: Exception :: " + Ex.message);
