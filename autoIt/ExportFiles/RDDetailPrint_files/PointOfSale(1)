                    || BillSettlement.BillSettlementPaymentDetails.length <= 0)
                    BillSettlement.BillSettlementPaymentDetails = BILLSETTLEMENTDATASTRUCTURE.getEmptyPaymentDetails();

                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length; i++) {

                    if ($("#txtCreditNoteNumber").is(":visible")) {
                        var creditNoteId = $("#txtCreditNoteNumber").attr("data-Tag");
                        if (creditNoteId != null && creditNoteId != undefined && creditNoteId.length > 0) {
                            creditNoteId = FConvert.toInt(creditNoteId);
                            BILLSETTLEMENT.VARIABLE.cNDetails = BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.filter((p) => p.Id == creditNoteId);
                            if (BILLSETTLEMENT.VARIABLE.cNDetails != null && BILLSETTLEMENT.VARIABLE.cNDetails != undefined && BILLSETTLEMENT.VARIABLE.cNDetails.length > 0)
                                BILLSETTLEMENT.VARIABLE.cNDetails = BILLSETTLEMENT.VARIABLE.cNDetails[0];
