                    arrValue.push("divForModalMain");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return;
                    //NETWORK.executeServerMethod(GLOBAL.getContextPath("OpenMessageInfo", "RetailMainScreen", "PointOfSale"),
                    //    true, { sMessageInfo: JSON.stringify(arrValue[0]) }, "HTML", false, "PRODUCTSETS.onSuccessMessagePopup",
                    //    "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", arrValue);
                }
                if (rtnValue.bRevertFixedRateDelete == true) {
