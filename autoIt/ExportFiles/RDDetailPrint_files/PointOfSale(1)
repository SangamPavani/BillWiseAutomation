                        if (bSuccess == false)
                            return;
                        if (data.bSuccess == false) {
                            toastr.error(data.sMessage);
                            return;
                        }

                        let iPrintCount = PreferenceSetting.PrefOutletTab.OutletPrintFormatsTab.EODCopiesToPrint;
