                        else
                            dAmt = (gross * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 3) {
                        if (objSalesReturnWeb.FooterFieldsList[k].ExempFieldIds.length > 0) {
                            ///Percentage on Net with some fields exemption
                            let dNetAmt = CALCULATION.getNetAmountAfterExempt(k, objSalesReturnWeb.RetailTransFooterUI);
                            if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                                dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(dNetAmt), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
