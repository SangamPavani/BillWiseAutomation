    onSuccessAssignSellingRateAfterMemberSelection: function (bSuccess, data) {
        try {
            if (bSuccess == false) {
                toastr.error("Exception while calling Server action.");
                return;
            }

            if (data != null && data != undefined) {
                if (data.bSuccess == true) {
                    if (data.memberDetails != null && data.memberDetails != undefined) {
                        if (data.memberDetails.MemberExpiry != null && data.memberDetails.MemberExpiry != undefined)
                            ApplicationNew.MemberData.MemberExpiry = data.memberDetails.MemberExpiry;

                    }
                    ApplicationNew.MemberData.AvaliablePoints = FConvert.toDecimal(ApplicationNew.MemberData.AvaliablePoints, POSCommon.numberOfDecimal);
