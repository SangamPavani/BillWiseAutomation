        try {
            let moduletype = $("#divApplication").attr("data-moduletype");
            if (moduletype != null || moduletype != undefined || moduletype.trim().length > 0) {
                moduletype = JSON.parse(moduletype);
            }
            if (moduletype == 0)//Retail
            {
                var SearchTextItem = $("#txtSearchItem").val();
                var iMinchar = $("#divSearchItemMain").attr('data-MinChar');
