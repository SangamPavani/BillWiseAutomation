            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENTNEW.maximumDiscountRestriction, Catch block : Error Message : " + Ex.message);
