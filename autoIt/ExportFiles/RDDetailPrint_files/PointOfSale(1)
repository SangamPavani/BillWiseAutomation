                            for (let LC = 0; LC < ApplicationNew.ListOfItems.length; LC++) {
                                CALCULATION.assignFooterProportionateValueToBodyScreenField(ApplicationNew.ListOfItems[LC], (ApplicationNew.ListOfItems[LC].ProductType == PosProductType.get("NORMAL") || ApplicationNew.ListOfItems[LC].ProductType == 4 || ApplicationNew.ListOfItems[LC].ProductType == 5) ? 1 : -1, ApplicationNew.ListOfItems[LC].TaxableValueToProportionateFooterData);
