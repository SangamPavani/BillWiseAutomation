    addSelectedProductToParentTreeViewControl(isClear) {
        try {
            //debugger;

            TREEVIEWCONTROL.SEARCH.updateParentTreeViewControlAttribute(isClear);

            let elementList = null, parentElementControl = null;
            if (isClear == false) // Append Selected Product In Parent Tree
            {
                // REAMRKS : Do not add group after searching, only leaf product we have to add as per Desktop
                // STEP 1 :: Add HTML Of Selected Normal Product
                for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.length; i++) {
                    elementList = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #elementList_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i]);
                    if (elementList != null && elementList != undefined && elementList.length > 0) {
                        let rtnValue = TREEVIEWCONTROL.SEARCH.findProductInParentTreeViewControl(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i]);
                        if (rtnValue != null && rtnValue != undefined && rtnValue.length > 0) {
                            if (rtnValue[0] == false) //Not Found In Parent Tree View Control
                            {
                                //Add In Parent Tree View Control
                                $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divProductTree").append(elementList[0]);
                            }
                            else if (rtnValue[0] == true) //Found In Tree View Control
                            {
                                if (rtnValue[1] == false) //Not Checked 
                                {
                                    parentElementControl = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divProductTree input[type=checkbox][id=" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i] + "]");
                                    if (parentElementControl != null && parentElementControl != undefined && parentElementControl.length > 0) {
                                        $(parentElementControl).prop("checked", true);
                                        $(parentElementControl).attr("checked", "checked");
                                    }
                                }
                            }
                        }
                    }
                }
            }
            else if (isClear == true) //Clear Parent Tree & Add Selected Product
            {
                // REAMRKS : Do not add group after searching, only leaf product we have to add as per Desktop
                //debugger;
                $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divProductTree").html('');

                // STEP 2 :: Add HTML Of Selected Normal Product && Add ProductInfo in ProductList Property
                for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.length; i++) {
                    elementList = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #elementList_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i]);
                    if (elementList != null && elementList != undefined && elementList.length > 0)
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divProductTree").append(elementList[0]);
                }
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Method :: TREEVIEWCONTROL.SEARCH.addSelectedProductToParentTreeViewControl :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
