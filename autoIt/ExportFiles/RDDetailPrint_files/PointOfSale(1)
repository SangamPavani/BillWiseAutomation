    openBillsettlementScreenAfterEmployeeDiscountAuthorization: function () {
        try {
            ////debugger;
            var lblNettAmount = FConvert.toDecimal($("#lblNett").html());
            if (lblNettAmount < 0) {

                var exchangeSpoilageResult = HEADEREXTRAFIELDS.callExchangeSpoilage();
                if (exchangeSpoilageResult == null || exchangeSpoilageResult == undefined) //Means Voucher posted OR Refund settlement screen is opening
                    return;
            }

            if (ApplicationNew != null && ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined) {
                if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0) {
                    //////debugger;
                    BILLSETTLEMENT.SCHEMESMETHODS.openSchemeFreeItemSelectionScreen();
                }
                else if (ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != null && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != undefined && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts.length > 0) {
                    BILLSETTLEMENT.SCHEMESMETHODS.openSchemeDiscountVoucherScreen();
                    return;
                }
                else {
                    //If No Schemes Applies Then Open Bill Settlement

                    //1. Check Here For Exchange/Spoilage Transaction
                    var exchangeSpoilageResult = HEADEREXTRAFIELDS.callExchangeSpoilage();
                    if (exchangeSpoilageResult == null || exchangeSpoilageResult == undefined) //Means Voucher posted OR Refund settlement screen is opening
                        return;

                    //2. Normal Transaction
                    if (FConvert.toDecimal(lblNettAmount, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter) == FConvert.toDecimal(0, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter)) {
                        TRANSACTION.postSalesInvoice();
                        return;
                    }
                    //code changed by prathibha 26/11/2021
                    if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") && (ApplicationNew.PreOrderInfo == null
                        || ApplicationNew.PreOrderInfo == undefined || ApplicationNew.PreOrderInfo.LocalPreOrderDetails == null
                        || ApplicationNew.PreOrderInfo.LocalPreOrderDetails == undefined)) {
                        SHORTCUTMETHODS.loadShortcutFunction(1024, false, null, null);
                        return;
                    }

                    //end
                    if (arrHeaderExtraField != null && arrHeaderExtraField != undefined && arrHeaderExtraField.length > 0) {
                        var arrBillSettlementField = arrHeaderExtraField[0];
                        arrBillSettlementField[1].NetAmount = lblNettAmount;
                        BILLSETTLEMENT.openBillSettlementScreen(arrBillSettlementField);
                        return;
                    }
                }
            }
            else {

                //If No Schemes Applies Then Open Bill Settlement
                //1. Check Here For Exchange/Spoilage Transaction
                var exchangeSpoilageResult = HEADEREXTRAFIELDS.callExchangeSpoilage();
                if (exchangeSpoilageResult == null || exchangeSpoilageResult == undefined) //Means Voucher posted OR Refund settlement screen is opening
                    return;

                //2. Normal Transaction
                if (FConvert.toDecimal(lblNettAmount, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter) == FConvert.toDecimal(0, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter)) {
                    TRANSACTION.postSalesInvoice();
                    return;
                }

                if (arrHeaderExtraField != null && arrHeaderExtraField != undefined && arrHeaderExtraField.length > 0) {
                    if (arrHeaderExtraField[0] != null && arrHeaderExtraField[0] != undefined) {
                        var arrBillSettlementField = arrHeaderExtraField[0];
                        BILLSETTLEMENT.openBillSettlementScreen(arrBillSettlementField);
                        return;
                    }
                }
            }
        }
