    loadMemberPointsDefItemsJsTree: function () {
        try {
            let productList = $("#divProductList").attr('data-ProductList');
            if (productList != null && productList != undefined && productList.length > 0)
                var parsedProductDetails = JSON.parse(productList);

            $("#divProductList")
                .on("loaded.jstree", MEMBERPOINTSDEFINITION.loadedItemsTreeEvent)
                .on("changed.jstree", MEMBERPOINTSDEFINITION.changedItemTreeEvent)
                .jstree(
                    {
                        "plugins": ["checkbox"], //"tie_selection": false - Loaded/Changed Event will not fire
                        "checkbox": {
                            "whole_node": false, "keep_selected_style": false
                        },
                        "core":
                        {
                            "data": parsedProductDetails,
                            'check_callback': function (operation, node, node_parent, node_position, more) {
                                // operation can be 'create_node', 'rename_node', 'delete_node', 'move_node', 'copy_node' or 'edit'
                                // in case of 'rename_node' node_position is filled with the new node name
                                return (operation === 'create_node' || operation === 'delete_node' || operation === 'rename_node' || operation == 'move_node' || operation == 'copy_node') ? true : false;
                            }
                        },
                    });
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: MEMBERPOINTSDEFINITION.loadMemberPointsDefItemsJsTree, Catch block : Error Message : " + Ex.message);
            return false;
        }
