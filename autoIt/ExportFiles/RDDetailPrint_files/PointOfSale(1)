                arrNewItemId = sIds.split(',');

            var arrOldItemId = ITEMRESTRICTIONSINBILL.VARIABLE.oldItemIs.split(','); //1,2,3,4

            if (arrNewItemId != null && arrNewItemId != undefined && arrNewItemId.length > 0 && arrOldItemId != null && arrOldItemId != undefined) {
