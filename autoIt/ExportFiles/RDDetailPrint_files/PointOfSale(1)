                        let prompts = POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_PromptsToShowList.filter((f) => (f.ProductId == FreeItem.ProductID) && (f.SchemeId == SchemeId) && f.FromScreen == FromScreen);
                        for (let i = 0; i < prompts.length; i++) //foreach(SchemesPrompt prompt in prompts)
                        {
                            prompts[i].FreeQtyToAdd = FConvert.toDecimal(prompts[i].FreeQtyToAdd, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(qtyToDeduct, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                            if (prompts[i].FreeQtyToAdd <= 0) {
                                let index = POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_PromptsToShowList.indexOf(prompts[i]);
                                POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_PromptsToShowList.splice(index, 1); //Remove
                            }
                        }
                    }
                    POSSCHEMEIMPLEMENTATIONGENERICS.addToFreeItemsList_New(FreeItem, qtyToDeduct, LineList, DoChanges, BaseItems, SchemeId, BodyId, FromScreen);
                }
                POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts_New(FromScreen, FreeItem.ProductID, FreeItem.ProductName, SchemeId, SchemeName, (_freeItemCount * FreeItem.Price), PromoTypes.get("FREEITEM"), _freeItemCount, _promptCount, Prompts, DoChanges, BodyId, BaseItems, FreeItem, null, FreeItemType);
