            var msgAtleastoneCriteriamustbedefined = $("#msgAtleastoneCriteriamustbedefined").val();
            var msgPleaseEnterPointsAccumulationValue = $("#msgPleaseEnterPointsAccumulationValue").val();
            var msgPointsAccumulationValShouldBeGreaterThanZero = $("#msgPointsAccumulationValShouldBeGreaterThanZero").val();

