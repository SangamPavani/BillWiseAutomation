            let roundOff = userWiseNet - userWiseNetAfterRoundOff + itemRoundOffSum;
            if (roundOff != null && roundOff != undefined && roundOff != 0) {
                if (ApplicationNew.RetailTransFooter != null && ApplicationNew.RetailTransFooter != undefined
