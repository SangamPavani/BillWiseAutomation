                        if (ApplicationNew.UserVerification != null && ApplicationNew.UserVerification != undefined) {
                            let objApprovalRecord = ApplicationNew.UserVerification.filter((p) => p.ShortcutId == 28);
                            if (objApprovalRecord == null && objApprovalRecord == undefined || objApprovalRecord.length <= 0) {
                                responseDiscountCellValue[0] = true;
                                responseDiscountCellValue[1] = msgUserApprovalRequired;
                                responseDiscountCellValue[2] = "USERAPPROVAL";
                                return responseDiscountCellValue;
                            }
