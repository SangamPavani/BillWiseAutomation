    setComplimentaryProduct: function () {
        try {
            let msgCannotgiveallitemsComplimentary = $("#msgCannotgiveallitemsComplimentary").val();
            let msgPOSException = $("#msgPOSException").val();
            let individualItemslist = [];
            individualItemslist.push(ApplicationNew.ComplimentaryOrVoidRelatedInfo.SelectedProduct);

            let iCompItemIndex = ApplicationNew.ComplimentaryOrVoidRelatedInfo.SelectedProduct.ItemSerialNo - 1; //objApplication.ListOfItems.IndexOf(SelectedLineProduct);
            //if (iCompItemIndex < 0)
            //    break;
            let dNewQty = parseFloat(ApplicationNew.ComplimentaryOrVoidRelatedInfo.ActualQuantity) - parseFloat(ApplicationNew.ComplimentaryOrVoidRelatedInfo.ReturnedQuantity);// ItemQty - VoidQty, 
            let indProdActQty = 0;
            if (iCompItemIndex > 0 || (iCompItemIndex == 0 && dNewQty > 0)) {
                let newOrExistingItem = null;
                if (dNewQty > 0) {
                    if (individualItemslist != null && individualItemslist != undefined && individualItemslist.length > 0) {
                        for (let i = 0; i < individualItemslist.length; i++) {
                            indProdActQty = individualItemslist[i].DefaultValue3 / ApplicationNew.ComplimentaryOrVoidRelatedInfo.ActualQuantity;
                            newOrExistingItem = ApplicationNew.ListOfItems.find((p) => p.DefaultValue1 == individualItemslist[i].DefaultValue1
                                && p.ParentId == individualItemslist[i].ParentId && p.ProductType == PosProductType.get("COMPLIMENTARY"));
                            if (newOrExistingItem == null || newOrExistingItem == undefined) {
                                newOrExistingItem = Object.assign({}, individualItemslist[i]);
                                individualItemslist[i].DefaultValue3 = indProdActQty * parseFloat(dNewQty);

                                newOrExistingItem.DefaultValue3 = indProdActQty * ApplicationNew.ComplimentaryOrVoidRelatedInfo.ReturnedQuantity;
                                newOrExistingItem.ProductType = 3;
                                newOrExistingItem.ComplimentaryRemarks = ApplicationNew.ComplimentaryOrVoidRelatedInfo.ComplimentaryRemarks;
                                let arrMax = [];
                                for (let j = 0; j < ApplicationNew.ListOfItems.length; j++)
                                    arrMax.push(ApplicationNew.ListOfItems[j].ItemSerialNo);

                                newOrExistingItem.ItemSerialNo = Math.max(...arrMax) + 1; //ApplicationNew.ListOfItems.Max(p => p.ItemSerialNo) + 1;

                                newOrExistingItem.DynamicLineFields = [];
                                for (let k = 0; k < individualItemslist[i].DynamicLineFields.length; k++) {
                                    newOrExistingItem.DynamicLineFields.push(Object.assign({}, individualItemslist[i].DynamicLineFields[k]));
                                    newOrExistingItem.DynamicLineFields[newOrExistingItem.DynamicLineFields.length - 1].FieldValue = newOrExistingItem.DynamicLineFields[newOrExistingItem.DynamicLineFields.length - 1].FieldInput = 0;
                                }
                                COMPLIMENTARYORVOID.assignZeroValueToDiscountAndDynamicLineFields(newOrExistingItem, ApplicationNew);

                                ApplicationNew.ListOfItems[individualItemslist[i].ItemSerialNo - 1] = individualItemslist[i];
                                PRODUCTSELECTION.updateSetsProperties(ApplicationNew.ListOfItems[individualItemslist[i].ItemSerialNo - 1]);

                                ApplicationNew.ListOfItems.push(newOrExistingItem);
                                PRODUCTSELECTION.updateSetsProperties(ApplicationNew.ListOfItems[ApplicationNew.ListOfItems.length - 1]);

                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[newOrExistingItem.ItemSerialNo - 1], ApplicationNew);
                            }
                            else {
                                individualItemslist[i].DefaultValue3 = indProdActQty * parseFloat(dNewQty);
                                individualItemslist[i].ComplimentaryRemarks = ApplicationNew.ComplimentaryOrVoidRelatedInfo.ComplimentaryRemarks;
                                newOrExistingItem.DefaultValue3 = newOrExistingItem.DefaultValue3 + (indProdActQty * parseFloat(ApplicationNew.ComplimentaryOrVoidRelatedInfo.ReturnedQuantity));//

                                ApplicationNew.ListOfItems[individualItemslist[i].ItemSerialNo - 1] = individualItemslist[i];
                                PRODUCTSELECTION.updateSetsProperties(ApplicationNew.ListOfItems[individualItemslist[i].ItemSerialNo - 1]);

                                ApplicationNew.ListOfItems[newOrExistingItem.ItemSerialNo - 1] = newOrExistingItem;
                                PRODUCTSELECTION.updateSetsProperties(ApplicationNew.ListOfItems[newOrExistingItem.ItemSerialNo - 1]);
                            }
                        }
                    }
                }
                else {
                    if (individualItemslist != null && individualItemslist != undefined && individualItemslist.length > 0) {
                        for (let i = 0; i < individualItemslist.length; i++) {
                            newOrExistingItem = ApplicationNew.ListOfItems.find(p => p.DefaultValue1 == individualItemslist[i].DefaultValue1
                                && p.ParentId == individualItemslist[i].ParentId && p.ProductType == PosProductType.get("COMPLIMENTARY"));
                            if (newOrExistingItem == null || newOrExistingItem == undefined) {
                                individualItemslist[i].ProductType = 3;
                                individualItemslist[i].ComplimentaryRemarks = ApplicationNew.ComplimentaryOrVoidRelatedInfo.ComplimentaryRemarks;
                                COMPLIMENTARYORVOID.assignZeroValueToDiscountAndDynamicLineFields(individualItemslist[i], ApplicationNew);
                                ApplicationNew.ListOfItems[individualItemslist[i].ItemSerialNo - 1] = individualItemslist[i];
                            }
                            else {
                                individualItemslist[i].ProductType = 3;
                                individualItemslist[i].ComplimentaryRemarks = ApplicationNew.ComplimentaryOrVoidRelatedInfo.ComplimentaryRemarks;
                                COMPLIMENTARYORVOID.assignZeroValueToDiscountAndDynamicLineFields(individualItemslist[i], ApplicationNew);
                                individualItemslist[i].DefaultValue3 = individualItemslist[i].DefaultValue3 + newOrExistingItem.DefaultValue3;
                                let index = ApplicationNew.ListOfItems.indexOf(newOrExistingItem);
                                ApplicationNew.ListOfItems.splice(index, 1);

                                for (let j = 0; j < ApplicationNew.ListOfItems.length; j++)
                                    ApplicationNew.ListOfItems[j].ItemSerialNo = j + 1;
                            }
                        }
                    }

                }
                ApplicationNew.ListOfItems[iCompItemIndex] = ApplicationNew.SelectedProduct;
            }
            else {
                let firstNonComplimentaryItem = ApplicationNew.ListOfItems.find(p => p.DefaultValue1 != ApplicationNew.ComplimentaryOrVoidRelatedInfo.SelectedProduct.DefaultValue1 && p.ProductType != PosProductType.get("COMPLIMENTARY"));
