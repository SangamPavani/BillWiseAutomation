    getInputControlCountEvent: function (inputControl, evt) {
        try {
            var charCode = null;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 8 || (charCode >= 48 && charCode <= 57))
                return true;

            if (charCode == 13 || charCode == 9) {
                var inputControlText = $(inputControl).val();
                var inputControlClosestTableCell = $(inputControl).closest('td');
                var inputControlClosestTableRow = $(inputControl).closest('tr');
                var totalValueCell = $(inputControlClosestTableRow).find(':last-child');
                var parsedDenominationDetails = JSON.parse($(inputControlClosestTableRow).attr('data-DenominationDetails'));

                parsedDenominationDetails.Denomination = FConvert.toDecimal($(inputControl).val(), POSCommon.numberOfDecimal);

                if (inputControlText > 0) {
                    parsedDenominationDetails.Denomination = inputControlText;
                    parsedDenominationDetails.TotalValue = FConvert.toDecimal(parsedDenominationDetails.Denomination, POSCommon.numberOfDecimal) * FConvert.toDecimal(parsedDenominationDetails.DenominationValue, POSCommon.numberOfDecimal);
                    $(inputControl).find('input').remove();
                    $(inputControlClosestTableCell).html(parsedDenominationDetails.Denomination);
                    $(totalValueCell).html(FConvert.toDecimal(parsedDenominationDetails.TotalValue, POSCommon.numberOfDecimal));
                    $(inputControlClosestTableRow).attr("data-DenominationDetails", JSON.stringify(parsedDenominationDetails));
                }
                else {
                    parsedDenominationDetails.Denomination = 0;
                    parsedDenominationDetails.TotalValue = FConvert.toDecimal(parsedDenominationDetails.Denomination, POSCommon.numberOfDecimal) * FConvert.toDecimal(parsedDenominationDetails.DenominationValue, POSCommon.numberOfDecimal);
                    $(inputControl).find('input').remove();
                    $(inputControlClosestTableCell).html(0);
                    $(totalValueCell).html(FConvert.toDecimal(parsedDenominationDetails.TotalValue, POSCommon.numberOfDecimal));
                    $(inputControlClosestTableRow).attr("data-DenominationDetails", JSON.stringify(parsedDenominationDetails));
                }
                var totalValue = 0;
                var denominationTableRow = $("#tBodyCashDenomination > tr");
                for (let i = 0; i < denominationTableRow.length; i++) {
                    var parsedDenomination = JSON.parse($(denominationTableRow[i]).attr("data-DenominationDetails"));
                    totalValue += parsedDenomination.TotalValue;
                }
                if (totalValue != 0)
                    $("#txtCashAmount").val(FConvert.toDecimal(totalValue, POSCommon.numberOfDecimal));
                else
                    BILLSETTLEMENT.displayCashAfterUpdatePaidAmt(false);
            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getInputControlCountEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
