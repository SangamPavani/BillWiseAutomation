                            $("#tbodyCreditNoteExtendValidity").append("<tr class='pos-table-row'><td class='pos-table-cell-center'> " + data.CreditNoteExtendValidityWeb.CreditNoteExtendValidityInfo[i].SerialNo + "</td><td class='pos-table-cell-center'> " + data.CreditNoteExtendValidityWeb.CreditNoteExtendValidityInfo[i].PreviousValidTill + "</td><td class='pos-table-cell-center'> " + data.CreditNoteExtendValidityWeb.CreditNoteExtendValidityInfo[i].ExtendValidTill + "</td></tr>")
                    }
                    $("#divRequiredInformation").attr("data-SearchedCreditNoteInformation", JSON.stringify(data.CreditNoteExtendValidityWeb));
                }
            }
            else {
                if (data.bSuccess == false && data.sMessage != undefined && data.sMessage != null && data.sMessage != "" && data.sMessage.length > 0) {
                    toastr.error(data.sMessage);
                    return false;
                }
