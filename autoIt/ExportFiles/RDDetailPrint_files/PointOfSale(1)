var LISTCHECKBOXCONTROL =
{
    VARIABLES:
    {
        selectedId: null,
    },
    //id=string type and it should be unique mandatory
    //arrOptions=IdNamePair type and it mandatory
    //addEvent=string type and it is not mandatory
    //arrValue=string[] type and it is not mandatory
    updateOptions: function (id, arrOptions, addEvent, arrValue) {
        if (id != undefined && id != null) {
            $("div#" + id).attr("data-AllBindingOption", JSON.stringify(arrOptions));

            var controlElement = document.getElementById("ul_" + id);
            if (controlElement != null) {
                controlElement.innerHTML = "";
                if (arrOptions != undefined && arrOptions != null && arrOptions.length > 0) {
                    for (var count = 0; count < arrOptions.length; count++) {
                        if (GlobalPref.Version == eVersion.Version9) {
                            if (arrOptions[count].ID >= 0) {
                                var li = document.createElement("li");
                                li.className = "treeview";
                                var div = document.createElement("div");
                                div.className = "Fcheckbox";
                                var label = document.createElement("label");
                                var input = document.createElement("input");
                                input.type = "checkbox";
                                input.className = "Fchkbox";
                                input.dataset.id = arrOptions[count].ID;
                                input.dataset.name = arrOptions[count].Name;
                                input.value = arrOptions[count].Name + "_" + arrOptions[count].ID;
                                if (arrOptions[count].ID == 0) //&& arrOptions[count].Name == "Select All"
                                    input.setAttribute("onchange", "LISTCHECKBOXCONTROL.setControlTextAll('" + id + "')");
                                else
                                    input.setAttribute("onchange", "LISTCHECKBOXCONTROL.setControlText('" + id + "')");
                                var span = document.createElement("span");
                                span.textContent = arrOptions[count].Name
                                label.appendChild(input);
                                label.appendChild(span);
                                div.appendChild(label);
                                li.appendChild(div);
                                controlElement.appendChild(li);
                            }
                        }
                        else if (GlobalPref.Version == eVersion.Version10) {
                            if (arrOptions[count].ID >= 0) {
                                var li = document.createElement("li");
                                li.className = "treeview";
                                var div = document.createElement("div");
                                var label = document.createElement("label");
                                label.className = "Newcontainerr";
                                var input = document.createElement("input");
                                input.type = "checkbox";
                                input.className = "Fchkbox";
                                input.dataset.id = arrOptions[count].ID;
                                input.dataset.name = arrOptions[count].Name;
                                input.value = arrOptions[count].Name + "_" + arrOptions[count].ID;

                                if (arrOptions[count].ID == 0 && arrOptions[count].Name == "Select All")
                                    input.setAttribute("onchange", "LISTCHECKBOXCONTROL.setControlTextAll('" + id + "')");
                                else
                                    input.setAttribute("onchange", "LISTCHECKBOXCONTROL.setControlText('" + id + "')");

                                var spanText = document.createElement("span");
                                spanText.textContent = arrOptions[count].Name;

                                var span = document.createElement("span");
                                span.className = "Newcheckmark pos-preference-inventory-span";
                                label.appendChild(input);
                                label.appendChild(spanText);
                                label.appendChild(span);
                                div.appendChild(label);
                                li.appendChild(div);
                                controlElement.appendChild(li);
                            }
                        }
                    }
                }
            }
        }
        if (addEvent == 'true') {
            LISTCHECKBOXCONTROL.setControlData(id, arrValue);
            $('#txtbox_' + id).on('click focusin keypress', function (event) {
                $('#' + id).addClass('open');
            });
            $(document).on('click', function (e) {
                if (!$('#ul_' + id).is(e.target)
                    && $('.open').has(e.target).length === 0
                ) {
                    $('#' + id).removeClass('open');
                }
            });
        }
    },

    //id=string type and it should be unique mandatory
    //arrValue=string[] type and it mandatory
    setControlData: function (id, arrValue) {
        var arrSelectedValues = [];
        if (id != undefined && id != null) {
            var controlEle = document.getElementById("ul_" + id);
            if (controlEle != null) {
                var lstCheckbox = controlEle.children;
                if (arrValue != undefined && arrValue != null && arrValue.length > 0) {
                    for (var count = 0; count < arrValue.length; count++) {
                        for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                            var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                            if ((arrValue[count].Name + "_" + arrValue[count].ID) == checkbox.value) {
                                checkbox.checked = true;
                                if (GlobalPref.Version == eVersion.Version9)
                                    arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                                else if (GlobalPref.Version == eVersion.Version10)
                                    arrSelectedValues.push(checkbox.dataset.name);
                                break;
                            }
                        }
                    }
                }
                else {
                    let checkBox = null;
                    for (let i = 0; i < lstCheckbox.length; i++) {
                        checkBox = lstCheckbox[i].children[0].children[0].children[0];
                        if (checkBox != null && checkBox != undefined)
                            checkBox.checked = false;
                    }
                }
            }
        }
        if (arrSelectedValues != null && arrSelectedValues != undefined && arrSelectedValues.length > 0) {
            document.getElementById("txtbox_" + id).value = arrSelectedValues.join(',');
            $("#txtbox_" + id).attr("title", arrSelectedValues.join(','));
            LISTCHECKBOXCONTROL.VARIABLES.selectedId = arrSelectedValues.join(",");
        }
        else {
            document.getElementById("txtbox_" + id).value = null;
            $("#txtbox_" + id).attr("title", null);
            LISTCHECKBOXCONTROL.VARIABLES.selectedId = null;
        }
    },
    clearControlData: function (id) {
        if (id != undefined && id != null) {
            var controlEle = document.getElementById("ul_" + id);
            if (controlEle != null) {
                var lstCheckbox = controlEle.children;
                for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                    var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                    checkbox.checked = false;
                }
            }
            document.getElementById("txtbox_" + id).value = "Please select...";
            $("#txtbox_" + id).attr("title", "");
        }
    },
    disableControl: function (id) {
        $("#" + id).css('pointer-events', 'none');
        $("#" + id).css('opacity', 0.5);
    },
    enableControl: function (id) {
        $("#" + id).css('pointer-events', 'auto');
        $("#" + id).css('opacity', 1);
