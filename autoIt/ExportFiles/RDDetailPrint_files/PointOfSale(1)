                        $("#rdbtnPartialUsed").prop("checked", true);

                    DATEPICKER.setDate("dpCurrentValidTillDate", data.CreditNoteExtendValidityWeb.CurrentValidity);

                    $("#tbodyCreditNoteExtendValidity").html('');
                    if (data.CreditNoteExtendValidityWeb.CreditNoteExtendValidityInfo != null && data.CreditNoteExtendValidityWeb.CreditNoteExtendValidityInfo != undefined) {
