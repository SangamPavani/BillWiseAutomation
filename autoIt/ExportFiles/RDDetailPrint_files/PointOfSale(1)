                else {
                    let msgBSVoucherProductsValidation = $("#msgBSVoucherProductsValidation").val();
                    applicationException[0] = false;
                    applicationException[3] = msgBSVoucherProductsValidation;
                    return applicationException;
                }
            }
            applicationException[0] = true;
            applicationException[1] = objDiscountVoucherReg;
            applicationException[2] = gross;
            return applicationException;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENT.getDiscountVoucherValidity, Catch block : Error Message : " + Ex.message);
            return applicationException;
        }
