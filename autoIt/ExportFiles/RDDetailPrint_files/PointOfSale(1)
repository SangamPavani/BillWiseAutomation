                if (ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined
                    || ApplicationNew.MemberData.ID == 0 || ApplicationNew.MemberData.ID == PreferenceSetting.PrefMiscellaneousTab.DefaultMember) //Non Member
                {
