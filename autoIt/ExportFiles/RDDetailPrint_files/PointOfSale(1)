                arrBillPrintingFooter[BillPrintFooter.FCurrencyAmt] = FConvert.toDecimal(billSettlementPaymentDetails.TotalPaidAmt);
            else 
                arrBillPrintingFooter[BillPrintFooter.FCurrencyAmt] = 0;

            arrBillPrintingFooter[BillPrintFooter.FTotalSaving] = fTotalSavingTotTransDisc;
            arrBillPrintingFooter[BillPrintFooter.FVat] = arrBillPrintingFooter[BillPrintFooter.FTax] = FConvert.toDecimal(totalTransTaxFVatFTax);
            arrBillPrintingFooter[BillPrintFooter.CGST] = FConvert.toDecimal((totalTransTaxFVatFTax / 2));
            arrBillPrintingFooter[BillPrintFooter.SGST] = arrBillPrintingFooter[BillPrintFooter.FVat] - arrBillPrintingFooter[BillPrintFooter.CGST];
            arrBillPrintingFooter[BillPrintFooter.CGSTInclusive] = FConvert.toDecimal((gSTAssumeIncl / 2));
            arrBillPrintingFooter[BillPrintFooter.SGSTInclusive] = gSTAssumeIncl - arrBillPrintingFooter[BillPrintFooter.CGSTInclusive];
            arrBillPrintingFooter[BillPrintFooter.CGSTExclusive] = FConvert.toDecimal((gSTAdd / 2));
            arrBillPrintingFooter[BillPrintFooter.SGSTExclusive] = gSTAdd - arrBillPrintingFooter[BillPrintFooter.CGSTExclusive];
