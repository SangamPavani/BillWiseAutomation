                        if (dLineListQty - dCalPromptsQty <= 0) {
                            itemsMatchedInBill = itemsMatchedInBill.filter((p) => p.DefaultValue1 != CalculatedPrompts[i].ProductId);
                            MatchedBody = MatchedBody.filter((p) => p.ProductID != CalculatedPrompts[i].ProductId);
                        }
                        else {
                            LowestPriceItemId = CalculatedPrompts[i].ProductId;
