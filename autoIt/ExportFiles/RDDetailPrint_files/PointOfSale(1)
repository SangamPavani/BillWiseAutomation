        confirmWarnIfRateIsZero: function () {
            try {
                var NegativeRateProds = [];
                var sProductIds = "";
                for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    if (ApplicationNew.ListOfItems[i].ProductType == 0 && ApplicationNew.ListOfItems[i].DefaultValue15 < 0) {
                        NegativeRateProds.push(ApplicationNew.ListOfItems[i]);
                        sProductIds += ApplicationNew.ListOfItems[i].DefaultValue2 + ",";
                    }
                }
                sProductIds = sProductIds.substring(0, sProductIds.length - 1);
                if (NegativeRateProds.length > 0 && sProductIds != null && sProductIds != undefined && sProductIds.length > 0) {
                    toastr.errore("Net amount cannot be negative for the Products : \n" + sProductIds);
                    return false;
                }

                if (POSCommon.isEnableBatchNumbers == true && BILLSETTLEMENT.isValidBatchAssignment() == false)
                    return false;

                //if (PreferenceSettings.PrefMiscellaneousOther.CheckDiscountAllowedBySalemanAndWaiter == true) {
                //    if (CheckDiscountAuthorization() == false)
                //        return false;
                //}

                //Checking Footer fields if any mandatory
                if (ExtraFields.retailTransFooter.FooterFieldsList.length > 0) {
                    for (let k = 0; k < ExtraFields.retailTransFooter.FooterFieldsList.length; k++) {
                        if (ExtraFields.retailTransFooter.FooterFieldsList[k].FieldTypeID == 4) {
                            if (ExtraFields.retailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("HOMEDELIVERYCHARGES") &&
                                ((ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ||
                                    ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERYFEEDBACK") ||
                                    (FConvert.toInt(ApplicationNew.SelectedPreOrderDetails.DeliveryType) == 1))) == false) {
                                continue;
                            }
                            if (ExtraFields.retailTransFooter.DynamicFooterFields[k].FieldInput == 0) {
                                toastr.error(ExtraFields.retailTransFooter.FooterFieldsList[k].Name + " data is mandatory");
                                return false;
                            }
                        }
                    }
                }
                var netvalue = FConvert.toDecimal($("#lblNett").val(), POSCommon.numberOfDecimal);
                sProductIds = "";
                var nonNormalProduct = ApplicationNew.ListOfItems.filter((p) => p.ProductType != 0);
                if (netvalue > 0 || (netvalue == 0 && nonNormalProduct != null && nonNormalProduct != undefined && nonNormalProduct.length <= 0)) {
                    if (POSCommon.isRMASupport == true) {
                        if (this.checkIsValidRMAForAllItems() == false) {
                            return false;
                        }
                    }
                }
                var bResult = BILLSETTLEMENT.validateTransactionBeforeBillSettlement();
                if (bResult == false)
                    return false;
            }
            catch (Ex) {
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: MESSAGEPOPUP.BILLSETTLEMENT.confirmWarnIfRateIsZero :: Catch block :: Error Message ::: " + Ex.message);
                return false;
            }
        },
        checkIsValidRMAForAllItems: function () {
            try {
                let msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts = $("#msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts").val();
                let msgPOSInformation = $("#msgPOSInformation").val();
                let msgYouAreNotAllowedToDoTransaction = $("#msgYouAreNotAllowedToDoTransaction").val();
                if (POSCommon.isRMASupport == true) {
                    var BatchRMACustLineWise = [];
                    var sProductIds = "";
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        if (ApplicationNew.ListOfItems[i].PosProductMake == PosProductMake.get("PRODUCT") && ApplicationNew.ListOfItems[i].DonotMaintainStockbyRMA == false && (ApplicationNew.ListOfItems[i].RMANos == null || (ApplicationNew.ListOfItems[i].RMANos != null && ApplicationNew.ListOfItems[i].RMANos.length != FConvert.toInt(ApplicationNew.ListOfItems[i].DefaultValue3)))) {
                            BatchRMACustLineWise.push(ApplicationNew.ListOfItems[i]);
                            sProductIds += ApplicationNew.ListOfItems[i].DefaultValue2 + ",";
                        }
                        else if (ApplicationNew.ListOfItems[i].PosProductMake == PosProductMake.get("SET")) {
                            for (let j = 0; j < ApplicationNew.ListOfItems[i].RetailSetsDetails.length; j++) {
                                if (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DonotMaintainStockbyRMA == false && (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos == null || (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos != null && ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos.length != FConvert.toInt(ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue3)))) {
                                    BatchRMACustLineWise.push(ApplicationNew.ListOfItems[i].RetailSetsDetails[j]);
                                    sProductIds += ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue2 + ",";
                                }
                            }
                        }
                        if (sProductIds != null && sProductIds != undefined && sProductIds.length > 0)
                            sProductIds = sProductIds.substring(0, sProductIds.length - 1);

                        if (BatchRMACustLineWise.length > 0 && sProductIds != null && sProductIds != undefined && sProductIds.length > 0) {
                            toastr.info(msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts + sProductIds, msgPOSInformation);
                            return false;
                        }
                    }

                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        if (ApplicationNew.ListOfItems[i].ProductType == 1 || ApplicationNew.ListOfItems[i].ProductType == 2) {
                            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DoNotAlowBillAmtToBePostveForExchngeOrSpoilageTran == true) {
                                toastr.info(msgYouAreNotAllowedToDoTransaction, msgPOSInformation);
                                return false;
                            }
                        }
                    }
                }
                return true;
            }
            catch (Ex) {
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: MESSAGEPOPUP.BILLSETTLEMENT.checkIsValidRMAForAllItems :: Catch block :: Error Message ::: " + Ex.message);
                return false;
            }
        },
