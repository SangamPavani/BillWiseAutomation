    updateCashInOutCollection: function (forPrint) {
        try {
            var totalValueCell = 0;
            var totalAmount = 0;

            var parsedCashInOutColl = JSON.parse($('#divCashInOutMain').attr('data-CashInOutColl'));

            var cashInOutCollRecords = CASHINOUTCOLLDATASTRUCT.getEmptyCashInOutCollWeb();

            cashInOutCollRecords.ScreenId = parsedCashInOutColl.ScreenId;
            cashInOutCollRecords.IsEditable = true;
            cashInOutCollRecords.EditedRecord = JSON.parse($("#divCashInOutMain").attr("data-EditedRecord"));
            cashInOutCollRecords.EditedRecord.Date = new Date();
            cashInOutCollRecords.EditedTransactionRecord = JSON.parse($("#divCashInOutMain").attr("data-EditedTransactionRecord"));
            if (CASHINOUTCOLLECTION.VARIABLE.moduleType == 0) {
                if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync == null || RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync == undefined || RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayInRequired == true)
                    cashInOutCollRecords.IsFromDayIn = true;
            }
            else if (CASHINOUTCOLLECTION.VARIABLE.moduleType == 1) {
                if ($("#POSMainScreen").attr('data-dayinrequired') == "True") {
                    cashInOutCollRecords.IsFromDayIn = true;
                }
            }
            if ($("#txtRemarks").val().length > 0)
                cashInOutCollRecords.Remarks = $("#txtRemarks").val().trim();
            else
                cashInOutCollRecords.Remarks = "";
            if ($('input[name=rbtType]:checked').attr('id') == "rbtAccount") {
                cashInOutCollRecords.IsAccount = true;
                cashInOutCollRecords.AccountId = $('#divCashInOutAccount').val();
            }
            else if ($('input[name=rbtType]:checked').attr('id') == "rbtCounter") {
                cashInOutCollRecords.IsAccount = false;
                cashInOutCollRecords.CounterId = $('#ddlCounter').val();
            }
            if (cashInOutCollRecords.EditedRecord.AllowDenomination == true && cashInOutCollRecords.EditedRecord.AllowMultiCurrency == true) {

                var currencyRecords = [];
                var currencyTableRow = $('#divMultiCurrency  #tblMultiCurrency  #tBodyMultiCurrency tr');
                for (var i = 0; i < currencyTableRow.length; i++) {
                    var parsedTableRowCurrency = JSON.parse($(currencyTableRow[i]).attr("data-CurrencyDetails"));
                    if (parsedTableRowCurrency.Amount > 0) {
                        currencyRecords.push(parsedTableRowCurrency);
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal(parsedTableRowCurrency.Amount);
                    }
                }
                cashInOutCollRecords.CurrencyDetails = currencyRecords;
                cashInOutCollRecords.Amount = totalAmount;
            }
            if (cashInOutCollRecords.EditedRecord.AllowDenomination == true && cashInOutCollRecords.EditedRecord.AllowMultiCurrency == false) {

                var denominationRecords = [];
                var denominationTableRow = $('#tBodyDenomination  tr');
                if (denominationTableRow != null && denominationTableRow != undefined && denominationTableRow.length > 0) {
                    for (var i = 0; i < denominationTableRow.length; i++) {
                        var parsedTableRowDenomination = JSON.parse($(denominationTableRow[i]).attr("data-DenominationDetails"));
                        totalAmount = totalAmount + parsedTableRowDenomination.TotalValue;
                        denominationRecords.push(parsedTableRowDenomination);
                    }
                }
                cashInOutCollRecords.CurrencyDetails.push({ CashDenomination: denominationRecords });
                cashInOutCollRecords.Amount = totalAmount;

                if (denominationRecords == null || denominationRecords.length <= 0)
                    cashInOutCollRecords.Amount = $("#txtAmount").val();
            }
            if (cashInOutCollRecords.EditedRecord.AllowDenomination == false && cashInOutCollRecords.EditedRecord.AllowMultiCurrency == true) {

                var currencyRecords = [];
                var currencyTableRow = $('#divMultiCurrency  #tblMultiCurrency  #tBodyMultiCurrency  tr');
                for (var i = 0; i < currencyTableRow.length; i++) {
                    var parsedTableRowCurrency = JSON.parse($(currencyTableRow[i]).attr("data-CurrencyDetails"));
                    if (parsedTableRowCurrency.Amount > 0) {
                        currencyRecords.push(parsedTableRowCurrency);
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal(parsedTableRowCurrency.Amount);
                    }
                }
                cashInOutCollRecords.CurrencyDetails = currencyRecords;
                cashInOutCollRecords.Amount = totalAmount;
            }
            if (cashInOutCollRecords.EditedRecord.AllowDenomination == false && cashInOutCollRecords.EditedRecord.AllowMultiCurrency == false) {
                cashInOutCollRecords.CurrencyDetails = null;
                cashInOutCollRecords.Amount = $("#txtAmount").val();
            }

            ////debugger;
            let resultUpdate = CASHINOUTCOLLECTION.SERVERMETHODS.saveCashInOutCollectionWeb(parsedCashInOutColl.ScreenId, cashInOutCollRecords, forPrint);
            if (resultUpdate != null && resultUpdate != undefined && resultUpdate == false)
                return false;

            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: CASHINOUTCOLLECTION.updateCashInOutCollection :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
    },
