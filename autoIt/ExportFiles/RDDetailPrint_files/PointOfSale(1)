                    for (let k = 0; k < Products.length; k++) //Products.Sum(p => p.DefaultValue3)
                        sum = FConvert.toDecimal(sum, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(Products[k].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    if (sum != SchemesImplementedProds[i].DefaultValue3) {
                        let diff = FConvert.toDecimal(sum, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - (FConvert.toDecimal(multiplicationfactor, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(SchemesImplementedProds[i].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true));
                        if (Products != null && Products != undefined && Products.length > 0) //lastOrDefault()
                            Products[0].DefaultValue3 -= diff;
                    }
                }
            }
            //if (Revert == true) {
            //    let iCount = ProductDetails.length;
            //    for (let i = 0; i < iCount.length; i++) {
            //        if (ProductDetails[i].PromoType == PromoTypes.get("FREEITEM")) {
            //            let MatchedProduct = ProductDetails.filter((p) => p.DefaultValue1 == ProductDetails[i].DefaultValue1 && p.ProductType == posProductType && p.PromoType == PromoTypes.get("NORMAL")); //LastOrDefault
