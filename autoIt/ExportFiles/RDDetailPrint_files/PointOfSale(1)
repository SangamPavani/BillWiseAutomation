                                        for (let j = 0; j < Products[k].RetailSetsDetails.length; j++) {
                                            let SetProportionateValue = FConvert.toDecimal(Products[k].DynamicLineFields[0].FieldInput * Products[k].RetailSetsDetails[j].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(Products[k].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                                            Products[k].RetailSetsDetails[j].DynamicLineFields[0].FieldInput = Products[k].RetailSetsDetails[j].DynamicLineFields[0].FieldValue = SetProportionateValue;
                                        }
                                    }
                                }
                            }
                        }
                        else {
                            Products[0].DefaultValue3 = FConvert.toDecimal(multiplicationfactor, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(SchemesImplementedProds[i].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
