    isValidGiftVoucher: function (bIsDisplayMessage) {

        try {
            var giftVoucherValue = FConvert.toDecimal($.trim($("#txtGiftVoucherValue").val()), POSCommon.numberOfDecimal);
            var giftVoucherSchemeDisc = $("#txtGiftVoucherSchemeDiscount").val();
            var giftVoucherNumber = FConvert.toDecimal($("#txtGiftVoucherNumber").val(), POSCommon.numberOfDecimal);
            var dtCouponExpiryDate = DATEPICKER.getDate("dtpGiftVoucherExpiryDate");
            var optGiftVoucher = OPTIONCONTROL.getControlDataObject("optGiftVoucherRegistration");
            var msgInfoBalAmtZero = $("#msgInfoBalAmtZero").val();
            var msgEnterGVName = $("#msgEnterGVName").val();
            var msgEnterGVVal = $("#msgEnterGVVal").val();
            var msgGVValValidation = $("#msgGVValValidation").val();
            var msgEnterGVNo = $("#msgEnterGVNo").val();
            var msgBSGVAndNetComparison = $("#msgBSGVAndNetComparison").val();
            var msgInvalidGV = $("#msgInvalidGV").val();
            if (BillSettlement.BalanceAmount <= 0) {
                toastr.error(msgInfoBalAmtZero);
                BILLSETTLEMENT.clearCouponFields(true);
                return false;
            }
            else if (optGiftVoucher == null || optGiftVoucher == undefined || optGiftVoucher.iId == null || optGiftVoucher.iId == undefined || optGiftVoucher.iId == 0) {
                toastr.error(msgEnterGVName);
                //  ("#optGiftVoucherRegistration").focus();
                $("#optGiftVoucherRegistration").focus();
                return false;
            }
            if (optGiftVoucher.bInternal != null && optGiftVoucher.iAccount != null && optGiftVoucher.fDenomination != null
                && optGiftVoucher.iCurrency != null && optGiftVoucher.CurrencyCode != null
                && BILLSETTLEMENT.getIsInternalGiftVoucher(optGiftVoucher.bInternal)) {
                if ($.trim($("#txtGiftVoucherValue").val()) == 0) {
                    toastr.error(msgEnterGVVal);
                    $("#txtGiftVoucherValue").focus();
                    return false;
                }
                else if (giftVoucherValue == 0) {
                    toastr.error(msgGVValValidation);
                    $("#txtGiftVoucherValue").focus();
                    return false;
                }
                return true;
            }
            if ($.trim($("#txtGiftVoucherNumber").val()) == "") {
                toastr.error(msgEnterGVNo);
                $("#txtGiftVoucherNumber").focus();
