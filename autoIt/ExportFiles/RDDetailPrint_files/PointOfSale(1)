    clickKeyboard: function (element) {
        //debugger;
        try {
            var txtValue = VirtualKeyboard.VARIABLE.txtValue;
            var character = $(element).html(); // If it's a lowercase letter, nothing happens to this variable
           
            // Shift keys
            if ($(element).hasClass('left-shift') || $(element).hasClass('right-shift')) {
                $('.letter').toggleClass('uppercase');
                $('.symbol span').toggle();

                VirtualKeyboard.VARIABLE.shift = (VirtualKeyboard.VARIABLE.shift === true) ? false : true;
                VirtualKeyboard.VARIABLE.capslock = false;
                return false;
            }
            // Caps lock
            if ($(element).hasClass('capslock')) {
                $('.letter').toggleClass('uppercase');
                VirtualKeyboard.VARIABLE.capslock = true;
                return false;
            }

            // Backspace
            if ($(element).hasClass('backspace')) {
                var html = $(txtValue).val();

                $(txtValue).val(html.substr(0, html.length - 1));
                return false;
            }
            if ($(element).hasClass('noBackspace')) {
                var html = $(txtValue).val();

                $(txtValue).val(html.substr(0, html.length - 1));
                return false;
            }
            if ($(element).hasClass('noClear')) {
                $(txtValue).val("");
                return false;
            }
            // Special characters
            if ($(element).hasClass('symbol')) character = $('span:visible', $(element)).html();
            if ($(element).hasClass('space')) character = ' ';
            if ($(element).hasClass('tab')) character = "\t";

            if ($(element).hasClass('enter')) {
                //debugger;
                $("#" + ParentName + " > #divVirtualKeyboard").html("");
                return;
            }

            // Uppercase letter
            if ($(element).hasClass('uppercase')) character = character.toUpperCase();

            // Remove shift once a key is clicked.
            if (VirtualKeyboard.VARIABLE.shift === true) {
                $('.symbol span').toggle();
                if (VirtualKeyboard.VARIABLE.capslock === false) $('.letter').toggleClass('uppercase');

                VirtualKeyboard.VARIABLE.shift = false;
            }

            // Add the character
            // first == true - > clear, false
            if (VirtualKeyboard.VARIABLE.isFirstKeyPressed == true) {
                $(txtValue).val("");
                $(txtValue).val(character);
                VirtualKeyboard.VARIABLE.isFirstKeyPressed = false;
            }
            else
                $(txtValue).val($(txtValue).val() + character);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + ", File: virtualKeyboard.js, Method:VirtualKeyboard.clickKeyboard, Catch block : Error Message : " + Ex.message);
