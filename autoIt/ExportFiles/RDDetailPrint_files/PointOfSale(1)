                    Application.FooterCalculation = POSDATASTRUCTURE.getEmptyFooterCalculationFields();// new Object();

                Application.FooterCalculation.TotalNumberOfItem = Application.ListOfItems.length;

                $.each(Application.ListOfItems, function (index, record) {
                    Application.FooterCalculation.TableFooterQuantity = parseFloat(parseFloat(Application.FooterCalculation.TableFooterQuantity) + parseFloat(record.DefaultValue3)).toFixed(PreferenceSetting.PrefInventoryTab.DecmlsInQty);
                    Application.FooterCalculation.TableFooterRate = parseFloat(parseFloat(Application.FooterCalculation.TableFooterRate) + parseFloat(record.DefaultValue4)).toFixed(POSCommon.numberOfDecimal);
                    Application.FooterCalculation.TableFooterGross = parseFloat(parseFloat(Application.FooterCalculation.TableFooterGross) + parseFloat(record.DefaultValue5)).toFixed(POSCommon.numberOfDecimal);
                    Application.FooterCalculation.TableFooterNett = parseFloat(parseFloat(Application.FooterCalculation.TableFooterNett) + parseFloat(record.DefaultValue15)).toFixed(POSCommon.numberOfDecimal);
                });

                //Calculating Net

                var userWiseGross = 0.0, userWiseSubTotal = 0.0;

                for (let j = 0; j < Application.ListOfItems.length; j++) {
                    if (Application.ListOfItems[j].ProductType == PosProductType.get("COMPLIMENTARY")) {
