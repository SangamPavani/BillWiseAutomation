                    }
                }
                if (ApplicationNew.TotalSchemesInfo.LinePrompts != null && ApplicationNew.TotalSchemesInfo.LinePrompts != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts.length > 0) {
                    ////debugger;
                    POSSCHEMEIMPLEMENTATIONGENERICS.updateUnitsAndPromoTypes();
                    POSSCHEMEIMPLEMENTATIONGENERICS.assignSchemeImplementationClass(null);

                    if (PreferenceSetting.PrefGeneralTab.DoNotAllowNewSchmsWleEdTran == true) {
