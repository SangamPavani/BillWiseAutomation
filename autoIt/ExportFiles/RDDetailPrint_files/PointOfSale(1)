            let _freeItemsCountInBill = POSSCHEMEIMPLEMENTATIONGENERICS.getFreeItemsCountInBill(SchemeId, BodyId, FreeItem.ProductID, FromScreen, FreeItem.Unit);
            if (_freeItemCount > _freeItemsCountInBill) {

