                if (PreferenceSetting.PrefInventoryTab.DecmlsInQty > 0 || isSchemes == false)
                    return FConvert.toDecimal(number, PreferenceSetting.PrefInventoryTab.DecmlsInQty);
                else
                    return FConvert.toDecimal(number, noOfDecimals);
