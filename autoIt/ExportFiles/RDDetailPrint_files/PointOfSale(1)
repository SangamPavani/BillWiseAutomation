                    toastr.error(txtPlzSelEmployeeType, msgPOSException);
                    $("#ddlDiscountEmployeeDesignation").focus();
                    return false;
                }

                if ($("#txtEmployeeDiscountValue").val().trim() == "") {
                    toastr.error(txtPlzEnterDiscount, msgPOSException);
                    $("#txtEmployeeDiscountValue").focus();
                    return false;
                }
                SCHEMESDISCOUNT.EMPLOYEEDISCOUNT.validateDiscountAmount();
                SCHEMESDISCOUNT.VARIABLE.selectedItems = [];
                SCHEMESDISCOUNT.VARIABLE.ItemId = "";
                SCHEMESDISCOUNT.VARIABLE.ItemName = "";

                //debugger;
                let selectedProductId = $("#divTreeViewControlStoreInformation").attr("data-SelectedProductId");
                if (selectedProductId != null && selectedProductId != undefined && selectedProductId.trim().length > 0)
                    SCHEMESDISCOUNT.VARIABLE.ItemId = selectedProductId;

                /*SCHEMESDISCOUNT.VARIABLE.ItemId = FPRODUCTCONTROL.METHODS.getProductLeafId("divProductTreeControl");*/

                if ($("#ddlSchemeTypeEmp").val() == 2) {
                    if (SCHEMESDISCOUNT.VARIABLE.ItemId == null || SCHEMESDISCOUNT.VARIABLE.ItemId == "" || SCHEMESDISCOUNT.VARIABLE.ItemId == undefined) {
                        toastr.error(msgPlsIncludeAtleastOneItemAsMandatoryInCriteria, msgPOSException);
                        return false;
                    }
                }
                //If collection count is greater than 0 then check wheather employeetype already present in the list.
                let tbodyRowData = $("#tbodyEmployeeDiscount tr");
                if (tbodyRowData != null && tbodyRowData != undefined && tbodyRowData.length > 0) {
                    var _blnItemExists = false; //This variable will be true if duplicate product found.

                    //validation to check wheather item is getting added twice.
                    let employeeSchemesDiscountDetail = null, parsedRowData = null;
                    let checkAddOrModifyTxt = document.getElementById('btnAddEmpDiscount')
                    let sTitle = "";
                    if (GlobalPref.Version == eVersion.Version10) {
                        sTitle = checkAddOrModifyTxt.title;
                    }
                    else if (GlobalPref.Version == eVersion.Version9) {
                        sTitle = $("#sbtnAddEmpDiscount").html();
                    }

                    for (let i = 0; i < tbodyRowData.length; i++) {
                        employeeSchemesDiscountDetail = $(tbodyRowData[i]).attr('data-employeeSchemeDiscountDetails');
                        if (employeeSchemesDiscountDetail != null && employeeSchemesDiscountDetail != undefined && employeeSchemesDiscountDetail.length > 0) {
                            parsedRowData = JSON.parse(employeeSchemesDiscountDetail);
                            if (sTitle == txtModify) {
                                if ($("#ddlDiscountEmployeeDesignation").val() == parsedRowData.EmployeeType && parsedRowData.IsSelected == false) {
                                    toastr.error(employeeType + parsedRowData.EmployeeTypeName + alreadyAddedToList, msgPOSException);
                                    _blnItemExists = true;
                                    break;
                                }
                            }

                            if (sTitle == txtAdd) {
                                if ($("#ddlDiscountEmployeeDesignation").val() == parsedRowData.EmployeeType) {
                                    toastr.error(employeeType + parsedRowData.EmployeeTypeName + alreadyAddedToList, msgPOSException);
                                    _blnItemExists = true;
                                    break;
                                }
                            }
                        }
                    }
                    if (_blnItemExists == true)
                        return false;
                }
                return true;
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESDISCOUNT.EMPLOYEEDISCOUNT.IsValidationFree_Add :: Catch block :: Exception :: " + Ex.message);
            }
        },

