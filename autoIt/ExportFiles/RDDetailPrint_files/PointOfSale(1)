                $("#txtDiscountVoucherNoofCoupon").focus();
                //     txtGiftVoucherNumber.Text = "";
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENT.SERVERMETHOD.getDiscVoucherExchangeRateDetails, Catch block : Error Message : " + Ex.message);
