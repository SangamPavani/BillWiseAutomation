                    tHeadProduct[0].style.width = tHeadProduct[0].style.minWidth = tHeadProduct[0].style.maxWidth = tHeadProductColumnWidth + "px";
                }
            }

            RETAILMAIN.VARIABLE.TableHeaderRMA = null;
