                arrBillPrintingFooter[BillPrintFooter.FDrCardAmount] = 0;
                arrBillPrintingFooter[BillPrintFooter.FChequeAmount] = 0;
                arrBillPrintingFooter[BillPrintFooter.FCouponsAmt] =0;
                arrBillPrintingFooter[BillPrintFooter.RedeemedAmount] = 0;
                arrBillPrintingFooter[BillPrintFooter.FChange] =0;
