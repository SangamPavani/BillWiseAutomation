    calculateLineWise: function (retailBodyField, cProduct, IsNewTransaction = false) {
        //MemberData = ApplicatioNew.MemberData
        try {
            if (retailBodyField != null && retailBodyField != undefined) {
                if (cProduct.DynamicLineFields[retailBodyField.ColumnIndex] == null || cProduct.DynamicLineFields[retailBodyField.ColumnIndex] == undefined)
                    return;
                cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldColMap = retailBodyField.ColMap;

                if (IsNewTransaction == true) {
                    if (MemberData != null && MemberData.MemberTypeExemptFields != null && MemberData.MemberTypeExemptFields.filter((p) => p == retailBodyField.ID) != 0) {
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput = 0;
                    }
                    else {
                        if (retailBodyField.FieldTypeID == 2 || retailBodyField.FieldTypeID == 5)
                            cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput = retailBodyField.PreloadValue;
                    }
                }
                if (retailBodyField.OutputCalculationId == 1) {
                    cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput;
                }
                else if (retailBodyField.OutputCalculationId == 2) {
                    if (retailBodyField.EffectOnNetId == 3)
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = POSSCHEMEIMPLEMENTATIONGENERICS.CALCULATION.convertPercentageToFooterValue(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, cProduct.DefaultValue5, retailBodyField.FieldBehaviour, false);
                    else
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = (FConvert.toDecimal(cProduct.DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(100, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
                else if (retailBodyField.OutputCalculationId == 3) {
                    if (retailBodyField.EffectOnNetId == 3)
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = POSSCHEMEIMPLEMENTATIONGENERICS.CALCULATION.convertPercentageToFooterValue(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, cProduct.DefaultValue15, retailBodyField.FieldBehaviour, false);
                    else
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = (FConvert.toDecimal(cProduct.DefaultValue15, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(100, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
                else if (retailBodyField.OutputCalculationId == 6) {
                    let dValue = FConvert.toDecimal(cProduct.DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(cProduct.DiscountTotal_UptoCurrentField, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    if (retailBodyField.EffectOnNetId == 3)
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = POSSCHEMEIMPLEMENTATIONGENERICS.CALCULATION.convertPercentageToFooterValue(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, dValue, retailBodyField.FieldBehaviour, false);
                    else
                        cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = (FConvert.toDecimal(dValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(100, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
                if (retailBodyField.IsDiscountField == true)
                    cProduct.DiscountTotal_UptoCurrentField = FConvert.toDecimal(cProduct.DiscountTotal_UptoCurrentField, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                if (retailBodyField.EffectOnNetId == 1) {
                    cProduct.DefaultValue15 = FConvert.toDecimal(cProduct.DefaultValue15, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
