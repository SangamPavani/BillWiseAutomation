    byteToBase64: function (data) {
        try {
            data = new Uint8Array(data.map(Number));
            var str = String.fromCharCode.apply(null, data);
            return btoa(str).replace(/.{76}(?=.)/g, '$&\n');
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainFocus8W.js, Method: PRODUCTSETS.byteToBase64, Catch block : Error Message : " + Ex.message);
        }
    },

    convertBase64toByteArray: function (base64String) {
        try {
            var BASE64_MARKER = 'data:image/jpeg;base64,';
            var base64Index = base64String.indexOf(BASE64_MARKER) + BASE64_MARKER.length;
            var base64 = base64String.substring(base64Index);
            var raw = window.atob(base64);
            var rawLength = raw.length;
            var array = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
            return array;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainFocus8W.js, Method:PRODUCTSETS.convertBase64toByteArray, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },

