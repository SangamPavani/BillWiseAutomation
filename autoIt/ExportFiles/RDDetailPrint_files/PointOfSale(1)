                                                responseQuantityCellValue[1] = applicationException.ApplicationExceptionMessage;
                                                responseQuantityCellValue[2] = null;
                                                return responseQuantityCellValue;
                                            }
                                        }

                                        if (applicationException.BatchResult == 2 || applicationException.BatchResult == 3) {
                                            responseQuantityCellValue[0] = true;
                                            responseQuantityCellValue[1] = applicationException.ApplicationExceptionMessage;
                                            responseQuantityCellValue[2] = "BATCHPOPUP";
                                            return responseQuantityCellValue;
                                        }
                                    }
                                }
                            }

                            dQty = _line.DefaultValue3;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = _line;
                            ApplicationNew.CurrentItem = _line;
                        }

                        if (POSCommon.isRMASupport == true) {
                            let rtnValues = [];
                            rtnValues = PRODUCTMETHODNEW.RMAPOPUPMETHODS.assignRMAToLine(_line, ApplicationNew.PresentTransactionMode);
                            if (rtnValues != null && rtnValues != undefined) {
                                if (FConvert.toBoolean(rtnValues[0]) == false) {
                                    ApplicationNew.IsUpdateQuantity = true;
                                    ApplicationNew.ListOfItems.splice(iIndex, 1);
                                    ApplicationNew.CurrentItem = _line;
                                    ApplicationNew.BatchRelatedList = [];
                                    let newObject = new Object();
                                    newObject.CurrentItem = ApplicationNew.CurrentItem;
                                    newObject.IsNew = false;
                                    ApplicationNew.BatchRelatedList.push(newObject);
                                    responseQuantityCellValue[0] = true;
                                    responseQuantityCellValue[1] = null;
                                    responseQuantityCellValue[2] = rtnValues[1];
                                    return responseQuantityCellValue;
                                }
                            }
                        }

                    }
                    else {
                        _line.DefaultValue3 = dQty;
                        let productTypeMultiplier = (pProductTypeMultiplier == -1 ? (dQty < 0 ? 1 : -1) : 1);
                        _line.DefaultValue3 = _line.DefaultValue3 * productTypeMultiplier;

                        _line.BatchData.Qty = FConvert.toDecimal(_line.DefaultValue3, POSCommon.numberOfDecimal);
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = _line;

                        //#region RMA Popup
                        if (POSCommon.isRMASupport == true) {
                            let rtnValues = [];
                            rtnValues = PRODUCTMETHODNEW.RMAPOPUPMETHODS.assignRMAToLine(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew.PresentTransactionMode);
                            if (rtnValues != null && rtnValues != undefined) {
                                if (FConvert.toBoolean(rtnValues[0]) == false) {
                                    ApplicationNew.IsUpdateQuantity = true;
                                    ApplicationNew.ListOfItems.splice(iIndex, 1);
                                    ApplicationNew.CurrentItem = _line;
                                    ApplicationNew.BatchRelatedList = [];
                                    let newObject = new Object();
                                    newObject.CurrentItem = ApplicationNew.CurrentItem;
                                    newObject.IsNew = false;
                                    ApplicationNew.BatchRelatedList.push(newObject);
                                    responseQuantityCellValue[0] = true;
                                    responseQuantityCellValue[1] = null;
                                    responseQuantityCellValue[2] = "RMAPOPUP";
                                    return responseQuantityCellValue;
                                }
                            }
                        }
                    }
                }
                else {
                    ////debugger;
                    dQty = Math.abs(dQty);
                    _line.DefaultValue3 = pProductTypeMultiplier * dQty;

                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApplyRateBasedOnQty == true && PreferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == false) {
                        let dRate = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(_line.DefaultValue1, _line.ProductUnit, Math.abs(_line.DefaultValue3), 0);
                        if (dRate > 0)
                            _line.DefaultValue4 = dRate;
                    }
                    _line.DefaultValue5 = _line.DefaultValue3 * _line.DefaultValue4;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = _line;
                    ApplicationNew.CurrentItem = _line;

                    // RMA Popup
                    if (POSCommon.isRMASupport == true) {
                        let rtnValues = [];
                        rtnValues = PRODUCTMETHODNEW.RMAPOPUPMETHODS.assignRMAToLine(_line, ApplicationNew.PresentTransactionMode);
                        if (rtnValues != null && rtnValues != undefined) {
                            if (FConvert.toBoolean(rtnValues[0]) == false) {
                                ApplicationNew.IsUpdateQuantity = true;
                                ApplicationNew.ListOfItems.splice(iIndex, 1);
                                ApplicationNew.CurrentItem = _line;
                                ApplicationNew.BatchRelatedList = [];
