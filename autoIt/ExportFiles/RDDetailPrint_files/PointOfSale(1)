var RETAILMAINFOOTER = {
    setFooterPanelHeightWidth: function () {
        try {
            ////debugger;
            var width = window.innerWidth;
            if (width <= 576)
                VISIBLE_BUTTONS = 3;
            else if (width >= 577 && width <= 768)
                VISIBLE_BUTTONS = 4;
            else if (width >= 769 && width <= 991)
                VISIBLE_BUTTONS = 6;
            else if (width >= 992 && width <= 1200)
                VISIBLE_BUTTONS = 8;
            else if (width >= 1201)
                VISIBLE_BUTTONS = 10;

            currentIndex = 0;

            var panel = document.getElementById('divFooterPanelColumn');
            if (!panel)
                return;

            var buttons = Array.from(panel.children);
            var totalButtons = buttons.length;

            // Hide all buttons
            buttons.forEach(function (btn) {
                btn.style.display = 'none';
            });

            // Show only the current set
            for (var i = currentIndex; i < Math.min(currentIndex + VISIBLE_BUTTONS, totalButtons); i++)
                buttons[i].style.display = '';

            // Enable/disable arrows
            let divLeftArrow = document.getElementById('divFooterLeftButtonArrow');
            if (divLeftArrow != null && divLeftArrow != undefined && divLeftArrow.length > 0)
                document.getElementById('divFooterLeftButtonArrow').disabled = currentIndex === 0;

            let divRightArrow = document.getElementById('divFooterRightButtonArrow');
            if (divRightArrow != null && divRightArrow != undefined && divRightArrow.length > 0)
                document.getElementById('divFooterRightButtonArrow').disabled = (currentIndex + VISIBLE_BUTTONS) >= totalButtons;

            var isFromCustomization = $("#divPosCommon").attr('data-isPointOfSaleCustomization');
            if (isFromCustomization == null || isFromCustomization == undefined || isFromCustomization == "true" || isFromCustomization == true) {
                var maxHeight = 0;
                $('.footer-btn').each(function () {
                    var h = $(this).outerHeight();
                    if (h > maxHeight)
                        maxHeight = h;
                });

                // 2. Set all buttons to the highest height
                /*$('.footer-btn').css('height', maxHeight + 'px');*/
                $('.footer-btn').css({ height: maxHeight + 'px', 'min-height': 'inherit', 'max-height': 'inherit' });
            }
            else {
                var maxHeight = 0;
                $('.footer-btn-stylish').each(function () {
                    var h = $(this).outerHeight();
                    if (h > maxHeight) maxHeight = h;
                });

                // 2. Set all buttons to the highest height
                $('.footer-btn-stylish').css('height', maxHeight + 'px');
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
