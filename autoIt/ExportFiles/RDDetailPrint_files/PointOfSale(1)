    calculateDepositInPercentage: function (deposit) {
        try {
            ////debugger;
            var msgDepositIsMandatory = $("#msgDepositIsMandatory").val();
            var msgMinimumDepositShouldBe = $("#msgMinimumDepositShouldBe").val();
            var totalNetAmount = $("#txtPreOrderNetAmount").val();
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatoryPercentage > 0) {
                var mandatoryDeposit = (FConvert.toDecimal(totalNetAmount) * FConvert.toDecimal(PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatoryPercentage)) / 100;
                if (mandatoryDeposit > deposit) {
                    var messageInfoPopup = COMMONMETHODS.UTILITYMETHODS.getDefaultMessageBox(msgMinimumDepositShouldBe + mandatoryDeposit);
                    var arrValues = [];
                    arrValues.push(messageInfoPopup);
                    arrValues.push("divForModalMain");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValues);
                    return false;
                }
            }
            else {
                if (FConvert.toDecimal(deposit, POSCommon.numberOfDecimal) == 0) {
                    var messageInfoPopup = COMMONMETHODS.UTILITYMETHODS.getDefaultMessageBox(msgDepositIsMandatory);//"Deposit is mandatory");
                    var arrValues = [];
                    arrValues.push(messageInfoPopup);
                    arrValues.push("divForModalMain");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValues);
                    return false;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainPreOrder.js :: Method :: PREORDERDETAILS.calculateDepositInPercentage :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
