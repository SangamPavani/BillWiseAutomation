    cancelPreOrder: function () {
        try {
            let msgPOSInformation = $("input#msgPOSInformation").val();
            var msgSelectPreOrderDetails = $("#msgSelectPreOrderDetails").val();
            let msgPlsSelectPreOrderRecordToCancel = $("input#msgPlsSelectPreOrderRecordToCancel").val();
            let msgCollected = $("input#msgCollected").val();
            let lblCancelled = $("input#lblCancelled").val();
            let msgPreOrderAdvanceAccountSelection = $("input#msgPreOrderAdvanceAccountSelection").val();

            var msgYouAreNotAllowedToCancel = $("#msgYouAreNotAllowedToCancel").val();
            var msgCannotCancelTheOrderAsTheOrderIsAlready = $("#msgCannotCancelTheOrderAsTheOrderIsAlready").val();
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowCancelPreOrder == false) {
                toastr.error(msgYouAreNotAllowedToCancel);//"You are not allowed to Cancel Pre Order");
                return;
            }

            var parsedPreOrderInfo = PREORDERSEARCH.getSelectedPreOrderRecord();
            if (parsedPreOrderInfo == null || parsedPreOrderInfo == undefined) {
                toastr.info(msgSelectPreOrderDetails, msgPOSInformation);
                return;
            }
            PREORDERSEARCH.VARIABLE.selectedTr = parsedPreOrderInfo;
            if (parsedPreOrderInfo.Status == 4) {
                toastr.info(msgCannotCancelTheOrderAsTheOrderIsAlready + msgCollected);
                return;
            }

            if (parsedPreOrderInfo.Status == 5) {
                toastr.info(msgCannotCancelTheOrderAsTheOrderIsAlready + " " + lblCancelled, "");
                return;
            }

            if (parsedPreOrderInfo.Status == 10 || parsedPreOrderInfo.Status == 11) {
                toastr.info("Can not cancel the order as order is already 'Merge Completed' OR 'Merge Cancel.'", "POS Information");
                return;
            }

            //Call Method
            var rtnValue = PREORDERSEARCH.SERVERMETHODS.getPreOrderDetailCancelOrder(parsedPreOrderInfo);
            if (rtnValue != null && rtnValue != undefined && rtnValue.bSuccess == false) {
                if (rtnValue.sMessage != null && rtnValue.sMessage != undefined && rtnValue.sMessage.trim().length > 0) {
                    toastr.success(rtnValue.sMessage);
                    return;
                }
            }

            if (rtnValue.bSuccess == true && rtnValue.sMessage != null && rtnValue.sMessage != undefined && rtnValue.sMessage.trim().length > 0)
                toastr.success(rtnValue.sMessage);

            if (ApplicationNew.PreOrderInfo == null || ApplicationNew.PreOrderInfo == undefined)
                ApplicationNew.PreOrderInfo = new Object();

            ApplicationNew.PreOrderInfo.SelectedPreOrderDetails = parsedPreOrderInfo;
            var totalCardCharges = 0;
            if (rtnValue.cardPaymentDetails != null && rtnValue.cardPaymentDetails != undefined && rtnValue.cardPaymentDetails.length > 0) {
                for (var i = 0; i < rtnValue.cardPaymentDetails.length; i++) {
                    totalCardCharges = totalCardCharges + rtnValue.cardPaymentDetails[i].CardCharges;
                }
            }
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                ApplicationNew.PreOrderInfo.RefundedAmount = FConvert.toDecimal(rtnValue.deposit - (totalCardCharges), POSCommon.numberOfDecimal);
            else
                ApplicationNew.PreOrderInfo.RefundedAmount = rtnValue.deposit;

            ApplicationNew.PreOrderInfo.NetAmount = rtnValue.netAmount;
            ApplicationNew.PreOrderInfo.IsCreditSalePaid = rtnValue.isCreditSalePaid;
            ApplicationNew.PreOrderInfo.CreditSaleTransactionIds = rtnValue.creditSaleTransactionIds;
            ApplicationNew.PreOrderInfo.CardPaymentDetails = rtnValue.cardPaymentDetails;
            ApplicationNew.MemberData = {
            };
            if (ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.MemberId == 0 || ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.MemberId == PreferenceSetting.PrefMiscellaneousTab.DefaultMember) {
                ApplicationNew.MemberData.MemberName = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.NonMemberName;
                ApplicationNew.MemberData.Mobile = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PhoneNumber;
            }
            else {
                ApplicationNew.MemberData.ID = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.MemberId;
                ApplicationNew.MemberData.MemberName = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.MemberName;
                ApplicationNew.MemberData.Mobile = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PhoneNumber;
            }

            PREORDERSEARCH.VARIABLE.isCancelClick = true;
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ReturnRemaksForPreOrderCancellation == true) {
                PREORDERSEARCH.openReturnRemarkCancelPreOrder();
                return;
            }

            //Call Header Extra Field
            if (ApplicationNew.PreOrderInfo.RefundedAmount > 0) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PostAdvancePaymentToRevenueAccount == false)
                    PREORDERSEARCH.openHeaderExtraFieldCancelPreOrder();
                else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PostAdvancePaymentToRevenueAccount == true) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceRevenueAccount <= 0) {
                        toastr.error(msgPreOrderAdvanceAccountSelection);
                        return;
                    }
                    TRANSACTION.cancelPreOrder();
                }
            }
            else
                TRANSACTION.cancelPreOrder();
            return;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailMainPreOrder.js, Method:PREORDERSEARCH.cancelPreOrder, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
