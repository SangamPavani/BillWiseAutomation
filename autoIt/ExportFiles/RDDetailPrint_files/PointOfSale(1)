        getMiscTableManagementTabPreferences: function () {
            try {
                //miscTableMntTab.PrefValue = this.getMiscTableManagementTabSetting();
                let controlValue = null;
                let miscTableMntTab = new Object();

                miscTableMntTab.PrefKey = "TBLMT";
                miscTableMntTab.PrefMiscTableManagementTab = new Object();

                controlValue = $("#txtIntForBooking").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.TimeSlotIntervalForBooking = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.TimeSlotIntervalForBooking = FConvert.toInt(controlValue);

                controlValue = $("#txtIntForOccupancy").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.TimeSlotIntervalForOccupancy = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.TimeSlotIntervalForOccupancy = FConvert.toInt(controlValue);

                controlValue = $("#txtBuffTimeFreeAfterBillSett").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.BufferTimeTableFreeAfterBillSettlement = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.BufferTimeTableFreeAfterBillSettlement = FConvert.toInt(controlValue);

                if ($("#rbManualStart").is(":checked") == true)
                    miscTableMntTab.PrefMiscTableManagementTab.OrderPriority = 0;
                else if ($("#rbTopFirstStart").is(":checked") == true)
                    miscTableMntTab.PrefMiscTableManagementTab.OrderPriority = 1;
                else if ($("#rbStartNoRequired").is(":checked") == true)
                    miscTableMntTab.PrefMiscTableManagementTab.OrderPriority = 2;

                controlValue = $('#ddlFirstWarningColor option:selected').attr('value');
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.FirstWarningColorCode = -1;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.FirstWarningColorCode = FConvert.toInt(controlValue);

                controlValue = $('#ddlSecondWarningColor option:selected').attr('value');
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.SecondWarningColorCode = -1;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.SecondWarningColorCode = FConvert.toInt(controlValue);

                controlValue = $('#ddlThirdWarningColor option:selected').attr('value');
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.ThirdWarningColorCode = -1;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.ThirdWarningColorCode = FConvert.toInt(controlValue);

                controlValue = $("#nudFirstColorTime").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.FirstWarningColorTime = 0
                else
                    miscTableMntTab.PrefMiscTableManagementTab.FirstWarningColorTime = FConvert.toInt(controlValue);

                controlValue = $("#nudSecondColorTime").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.SecondWarningColorTime = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.SecondWarningColorTime = FConvert.toInt(controlValue);

                controlValue = $("#nudThirdColorTime").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.ThirdWarningColorTime = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.ThirdWarningColorTime = FConvert.toInt(controlValue);

                miscTableMntTab.PrefMiscTableManagementTab.UseFlashWarning = $("#chkUseFlashWarning").is(":checked");

                controlValue = $("#nudFlashWarningColorTime").val();
                if (controlValue == null || controlValue == undefined)
                    miscTableMntTab.PrefMiscTableManagementTab.FlashWarningColorTime = 0;
                else
                    miscTableMntTab.PrefMiscTableManagementTab.FlashWarningColorTime = FConvert.toInt(controlValue);

                let sOrderTypeCaption = "", sOrderTypeColorCode = "";
                if (PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeCaption != null && PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeCaption != undefined && PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeCaption.length > 0) {
                    let strOrderTypeCaption = PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeCaption.split(',');
                    let strSplitIntoCaption = [];
                    for (let i = 0; i < strOrderTypeCaption.length; i++) {
                        strSplitIntoCaption = strOrderTypeCaption[i].split(':');
                        if (strSplitIntoCaption != null && strSplitIntoCaption != undefined && strSplitIntoCaption.length > 0) {
                            var iLbl = "lbl" + strSplitIntoCaption[0];
                            var iLblOrderTypeCaption = $("#" + iLbl);
                            var iTxt = "txt" + strSplitIntoCaption[0];
                            var iTxtOrderTypeCaption = $("#" + iTxt);
                            sOrderTypeCaption += $(iLblOrderTypeCaption).text() + ":" + $(iTxtOrderTypeCaption).val() + ",";
                        }
                    }
                }

                if (PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeColorCode != null && PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeColorCode != undefined && PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeColorCode.length > 0) {
                    let strOrderTypeColorValue = PREFERENCE.VARIABLE.PrefMiscTableManagementTab.OrderTypeColorCode.split(',');
                    let strSplitIntoColorValue = [];
                    for (let i = 0; i < strOrderTypeColorValue.length; i++) {
                        strSplitIntoColorValue = strOrderTypeColorValue[i].split(':');
                        if (strSplitIntoColorValue != null && strSplitIntoColorValue != undefined && strSplitIntoColorValue.length > 0) {
                            var id = "ddl" + strSplitIntoColorValue[0];
                            var iOrderTypeColor = $("#" + id);
                            var selectedOption = $(iOrderTypeColor).find("option:selected");
                            var colorOrderTypeName = strSplitIntoColorValue[0];
                            var colorOrderTypeValue = $(selectedOption).prop("value");

                            sOrderTypeColorCode += colorOrderTypeName + ":" + colorOrderTypeValue + ",";
                        }
                    }
                }
                if (sOrderTypeCaption.length > 0)
                    sOrderTypeCaption = sOrderTypeCaption.substring(0, sOrderTypeCaption.length - 1);

                if (sOrderTypeColorCode.length > 0)
                    sOrderTypeColorCode = sOrderTypeColorCode.substring(0, sOrderTypeColorCode.length - 1);

                miscTableMntTab.PrefMiscTableManagementTab.OrderTypeCaption = sOrderTypeCaption;// sOrderTypeCaption NVARCHAR(MAX),
                miscTableMntTab.PrefMiscTableManagementTab.OrderTypeColorCode = sOrderTypeColorCode;// sOrderTypeColorCode NVARCHAR(MAX),

                return miscTableMntTab;
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainPreference.js :: Method :: PREFERENCE.GETPREFERENCESETTING.getMiscTableManagementTabPreferences :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
                return null;
            }
        },

