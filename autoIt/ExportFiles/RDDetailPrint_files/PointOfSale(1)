                }
                else {
                    let dValue = COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(objDiscountVoucherReg.DefinitionDenomination, billSettlementDataFromClient.NetAmount);
                    if (bIsDVCurDifferFrmLocalCur == false)
                        $("#txtDiscountVoucherValue").val(dValue);
                    else {
                        $("#tbDVCurrencyDets").val(data.objDiscountVoucherReg.CurrencyCode, dValue, ProxyLayer.localCurrency.CurrencyCode, dExcRate);
                        $("#tbDVCurrencyDets").show();
                        consideringDVDefValue = dValue * dExcRate;
                        $("#txtDiscountVoucherValue").val(consideringDVDefValue);
                    }
                }
            }

            BillSettlement.SelectedDiscountVoucher = objDiscountVoucherReg;

            // Setting selected discount voucher values
            if (BillSettlement.SelectedDiscountVoucher.DefinitionSeriesNoRequired == true) {
                $("#divBillSettlementDiscVoucherNumberCol").show();
                $("#divBillSettlementDiscVoucherCouponCol").hide();
