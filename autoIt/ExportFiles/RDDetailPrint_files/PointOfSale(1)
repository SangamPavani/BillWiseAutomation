    optSchemeNameSelectedChanged: function (optSchemeName) {
        try {
            let schemeName = optSchemeName.value;
            var schemeNameDetails = OPTIONCONTROL.getControlDataObject(optSchemeName.id);
            var iSchemeId = FConvert.toInt(OPTIONCONTROL.getControlValue(optSchemeName.id));
            SCHEMES.VARIABLE.optSchemeId = iSchemeId;
            SCHEMES.ClearDiscountDefinitionFields(true);

            if (iSchemeId == null || iSchemeId <= 0) {
                SCHEMES.BindWeekdaysCombo();
                $("#txtOutlets").val("");
                SCHEMESOUTLETS.VARIABLE.selectedOutlet = [];
                SCHEMESOUTLETS.VARIABLE.OutletId = "";
                SCHEMESOUTLETS.VARIABLE.OutletName = "";
                SCHEMES.BindEmptyObject();
                FCommon.UI.enableButton(false, "divBtnClone");
                OPTIONCONTROL.setControlText("optSchemeName", schemeName);
            }
            else {
                let rtnSchemeDetails = SCHEMES.SEVERMETHOD.GetAndBindSelectedSchemeDetails(iSchemeId)
                if (rtnSchemeDetails != null && rtnSchemeDetails != undefined) {
                    SCHEMES.AssignValues_New(rtnSchemeDetails)
                    SCHEMES.VARIABLE.ocSchemes = [];
                    SCHEMES.VARIABLE.ocSchemes.push(rtnSchemeDetails);
                    let rtnValue = SCHEMESCOMMONMETHODS.isSchemeExistsInTransaction(iSchemeId, 1);
                    SCHEMES.VARIABLE.SchemeExistsInTran = rtnValue[0];
                    SCHEMES.VARIABLE.SchemeExistsInMappingToCustomer = rtnValue[1];

                    if (SCHEMES.VARIABLE.SchemeExistsInTran == true) {
                        FCommon.UI.enableButton(false, "divBtnAdd");
                        FCommon.UI.enableButton(false, "divBtnDelete");

                        var controlEle = document.getElementById("ul_ddlSchemeFor");
                        if (controlEle != null && controlEle != undefined) {
                            var checkbox = controlEle.children[0].children[0];
                            checkbox.style.pointerEvents = 'none';
                            checkbox.style.opacity = '0.5';
                        }
                    }
                    else {
                        FCommon.UI.enableButton(true, "divBtnAdd");
                        FCommon.UI.enableButton(true, "divBtnDelete");
                        FCommon.UI.enableButton(true, "divCriteriaDefinitionLeft");
                        FCommon.UI.enableButton(true, "divCriteriaDefinitionRight");
                        var controlEle = document.getElementById("ul_ddlSchemeFor");
                        if (controlEle != null && controlEle != undefined) {
                            var checkbox = controlEle.children[0].children[0];
                            checkbox.style.pointerEvents = 'auto';
                            checkbox.style.opacity = '1';
                        }
                    }

                    if (SCHEMES.VARIABLE.SchemeExistsInMappingToCustomer == true)
                        FCommon.UI.enableButton(false, "divBtnDelete");
                }

                SCHEMES.VARIABLE.IsUnitComboRefreshed = false;
                FCommon.UI.enableButton(true, "divSchemeFor");
                FCommon.UI.enableButton(true, "divBtnClone");
                FCommon.UI.enableButton(true, "divSchemeFooter");
            }
            var PerfectScrollSchemesMappingToCustomer = new PerfectScrollbar("#divCriteriaDefinitionLeft");
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMES.optSchemeNameSelectedChanged :: Catch block :: Exception :: " + Ex.message);
        }
    },
