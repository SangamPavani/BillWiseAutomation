        searchProduct: function (evt, inputControl, spanSearchButton) {
            try {
                //
                if ((inputControl != null && inputControl != undefined) && (spanSearchButton == null || spanSearchButton == undefined)) {
                    let charCode = (evt.which) ? evt.which : evt.keyCode;
                    if (charCode == 13) //Enter Key Press
                    {
                        //
                        let inputControlText = $(inputControl).val();
                        if (FPRODUCTCONTROL.METHODS.validateBeforeProductSearch(inputControlText) == false)
                            return;

                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName = $(inputControl).attr("data-ControlName");
                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName = $(inputControl).attr("data-ControlName");
                        if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName != null && FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName != undefined)
                            FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName = FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + "_Search";

                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.inputControlText = inputControlText;
                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchByField = $("#ddlSearchByField option:selected").attr('id');
                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn = $("#ddlSearchBy option:selected").attr('id');

                        FPRODUCTCONTROL.METHODS.removeUncheckedProduct();
                        FPRODUCTCONTROL.METHODS.setObjectAndCallMethod();

                        $(inputControl).val('');
                    }
                }
                else if ((inputControl == null || inputControl == undefined) && (spanSearchButton != null && spanSearchButton != undefined)) {
                    //
                    FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName = $(spanSearchButton).attr("data-ControlName");
                    FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName = $(spanSearchButton).attr("data-ControlName");
                    if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName != null && FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName != undefined)
                        FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName = FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + "_Search";

                    let inputControl = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " input#txtSearch");
                    let inputControlText = $(inputControl).val();
                    if (FPRODUCTCONTROL.METHODS.validateBeforeProductSearch(inputControlText) == false)
