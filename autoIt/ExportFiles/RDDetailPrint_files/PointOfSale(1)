                    return false;
                }
                if ($.trim($("#txtHomeDeliveryPhone").val()) == null ||
                    $.trim($("#txtHomeDeliveryPhone").val()) == undefined ||
                    $.trim($("#txtHomeDeliveryPhone").val()) == "") {
                    toastr.error(msgPleaseEnterMobileMumber);
                    $("#txtHomeDeliveryPhone").focus();
                    return false;
                }

                var a = $("#txtHomeDeliveryName").val();
                var b = $("#txtHomeDeliveryAddress").val();
            }
            //Member Validation
            else if ($("#chkHomeDeliveryDiffAddress").prop("checked") == true && (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID != null && ApplicationNew.MemberData.ID != undefined && ApplicationNew.MemberData.ID != 0)) {
                var differencceAddr = $("#txtHomeDeliveryDiffAddress").val();

                var textDiffAdd = differencceAddr.replace("\r\n", "");
                if ((textDiffAdd == null && textDiffAdd == "") || textDiffAdd.length == 0) {
                    toastr.error(msgPleaseEnterUseDifferentAddress);
                    $("#chkHomeDeliveryDiffAddress").prop("checked", true);
                    return false;
                }
                if ($.trim($("#txtHomeDeliveryMobileNum").val()) == null ||
                    $.trim($("#txtHomeDeliveryMobileNum").val()) == undefined ||
                    $.trim($("#txtHomeDeliveryMobileNum").val()) == "") {
                    toastr.error(msgPleaseEnterMobileMumber);
                    $("#txtHomeDeliveryMobileNum").focus();
                    return false;
                }
            }
            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID != null && ApplicationNew.MemberData.ID != undefined && ApplicationNew.MemberData.ID != 0) {
                if ($.trim($("#txtHomeDeliveryMobileNum").val()) == null ||
                    $.trim($("#txtHomeDeliveryMobileNum").val()) == undefined ||
                    $.trim($("#txtHomeDeliveryMobileNum").val()) == "") {
                    toastr.error(msgPleaseEnterMobileMumber);
                    $("#txtHomeDeliveryMobileNum").focus();
                    return false;
                }
            }

            //Common Validation
            var deliveryDate = DATEPICKER.getDate("dtpDeliveryDate");
            if (deliveryDate <= 0) {
                toastr.error(msgSelDelDt);
                return false;
            }

            if (deliveryDate < DATE.prototype.today(POSCommon.CalType)) {
                toastr.error(msgValidationDtHomeDel);
                return false;
            }
            var optDeliverySlot = OPTIONCONTROL.getControlValue("optDeliveryTimeInterval");
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DeliveryTimeMandatory == true) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DeliveryTimeInterval == true) {
                    if (optDeliverySlot <= 0) {
                        toastr.error(msgDeliveryTimeIntervalIsMandatory);
                        return false;
                    }
                }
                else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DeliveryTimeInterval == false) {
                    if (tpDeliveryTime == null || tpDeliveryTime == undefined || tpDeliveryTime == "") {
                        toastr.error(msgSelDelTime);
                        return false;
                    }
                }
            }
            var lblNetAmount = FConvert.toDecimal($("#lblNett").html(), POSCommon.numberOfDecimal);
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.MinValOfBil != 0 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.MinValOfBil > lblNetAmount) {
                toastr.info(msgMinimumValueOfBillForHomeDeliveryIs + " " + PreferenceSetting.PrefOutletTab.OutletGeneralTab.MinValOfBil, "POS Information");
                return false;
            }
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.MaxValOfBil != 0 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.MaxValOfBil < lblNetAmount) {
                toastr.info(msgMaximumValueOfBillForHomeDeliveryIs + " " + PreferenceSetting.PrefOutletTab.OutletGeneralTab.MaxValOfBil, "POS Information");
                return false;
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: HOMEDELIVERY.isValidationFree_Save :: Catch block :: Exception :: " + Ex.message);
            return false;
        }
