    validateCriteriaControls: function () {
        try {
            let msgMinValuecannotbegreaterthanMaxValue = $("input#msgMinValuecannotbegreaterthanMaxValue").val();
            let msgEnterAccumulationPoints = $("input#msgEnterAccumulationPoints").val();
            let msgEnterMaxValue = $("input#msgEnterMaxValue").val();
            let msgEnterRedeemptionValue = $("input#msgEnterRedeemptionValue").val();
            let msgMinValueOrMaxValuerangealreadyaddedincriteria = $("input#msgMinValueOrMaxValuerangealreadyaddedincriteria").val();
            let msgEnterMinValue = $("input#msgEnterMinValue").val();
            var minAmount = $("#txtCriteriaMinAmount").val();
            var maxAmount = $("#txtCriteriaMaxAmount").val();
            var accumulationVal = $("#txtCriteriaAccumulationPoints").val();
            var redemptValue = $("#txtRedemptValue").val();
            if (minAmount == null || minAmount == undefined || minAmount == "" || minAmount == 0) {
                toastr.error(msgEnterMinValue);
                $("#txtCriteriaMinAmount").focus();
                return false;
            }
            if (maxAmount == null || maxAmount == undefined || maxAmount == "" || maxAmount == 0) {
                toastr.error(msgEnterMaxValue);
                $("#txtCriteriaMaxAmount").focus();
                return false;
            }

            if ($("#txtCriteriaMinAmount").val() > $("#txtCriteriaMaxAmount.Text").val()) {
                toastr.error(msgMinValuecannotbegreaterthanMaxValue);
                $("#txtCriteriaMinAmount").focus();
                return false;
            }

            if (accumulationVal == null || accumulationVal == undefined || accumulationVal == "" || accumulationVal == 0) {
                toastr.error(msgEnterAccumulationPoints);
                $("#txtCriteriaAccumulationPoints").focus();
                return false;
            }

            if (redemptValue == null || redemptValue == undefined || redemptValue == "" || redemptValue == 0) {
                toastr.error(msgEnterRedeemptionValue);
                $("#txtRedemptValue").focus();
                return false;
            }
            var tableCriteriaDefinition = [];
            var trCriteriaDef = $("#tbodyMemberPointsDefCriteria > tr");
            if (trCriteriaDef != null && trCriteriaDef != undefined && trCriteriaDef != "" && trCriteriaDef.length > 0) {
                for (let i = 0; i < trCriteriaDef.length; i++) {
                    var trCriteriaDefInfo = $(trCriteriaDef[i]).attr("data-CriteriaDefinition");
                    if (trCriteriaDefInfo != null && trCriteriaDefInfo != undefined && trCriteriaDefInfo != "") {
                        var parsedCriteriaDefInfo = JSON.parse(trCriteriaDefInfo);
                        tableCriteriaDefinition.push(parsedCriteriaDefInfo);
                    }
                }
            }
            if (tableCriteriaDefinition != null && tableCriteriaDefinition != undefined && tableCriteriaDefinition.length > 0) {
                var bMinValueFound = false, bMaxValueFound = false;
                for (let i = 0; i < tableCriteriaDefinition.length; i++) {
                    if (minAmount >= tableCriteriaDefinition[i].MinValue && maxAmount <= tableCriteriaDefinition[i].MaxValue)
                        bMinValueFound = true;

                    if (maxAmount >= tableCriteriaDefinition[i].MinValue && maxAmount <= tableCriteriaDefinition[i].MaxValue)
                        bMaxValueFound = true;
                }

                if (bMinValueFound == true || bMaxValueFound == true) {
                    toastr.error(msgMinValueOrMaxValuerangealreadyaddedincriteria);
                    $("#txtCriteriaMinAmount").focus();
                    return false;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: MEMBERPOINTSDEFINITION.validateCriteriaControls, Catch block : Error Message : " + Ex.message);
            return false;
        }
