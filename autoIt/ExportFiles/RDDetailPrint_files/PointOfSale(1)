    loadCreditCardHeaderData: function () {
        //BillSettlementExtraFieldsData = LoadedHeaderExtraFieldsData;
        try {
            var iCount = 0;
            var strCounter = "";
            var _Data = null;
            //m_CreditCardTypes = BillSettlement.BillSettlementScreenFieldsData.CreditCardDets;
            if (BillSettlement.BillSettlementPaymentDetails == null || BillSettlement.BillSettlementPaymentDetails == undefined)
                BillSettlement.BillSettlementPaymentDetails = BILLSETTLEMENTDATASTRUCTURE.getEmptyPaymentDetails();
            //   var rtnvalues = BILLSETTLEMENT.getPreviousLoadedData();
            //rtnvalues.CreditCardDets;
            _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "iCreditCardCount");
            if (_Data != null && _Data != undefined && _Data.length > 0)
                _Data = _Data[0];

            if (FConvert.toString(_Data.Tag) == null || FConvert.toString(_Data.Tag) == undefined || FConvert.toString(_Data.Tag) == "")
                return;

            iCount = FConvert.toInt(_Data.Tag);
            if (iCount <= 0)
                return;

            BillSettlement.BillSettlementPaymentDetails.CreditCardDet = [];
            for (let j = 0; j < iCount; j++) {
                var _cardDet = BILLSETTLEMENTDATASTRUCTURE.getEmptyCardDetails();
                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "iCrCardType" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0) {
                    _Data = _Data[0];
                    //var CardTypeId = 0;
                    if (_Data.Tag != null && _Data.Tag != undefined && FConvert.toInt(_Data.Tag) > 0) {
                        _cardDet.CardTypeId = FConvert.toInt(_Data.Tag); // CardTypeId;
                        let matchCredCardDets = [];
                        if (BillSettlement.BillSettlementScreenFieldsData.CreditCardDets != undefined && BillSettlement.BillSettlementScreenFieldsData.CreditCardDets != null &&
                            BillSettlement.BillSettlementScreenFieldsData.CreditCardDets.length > 0)
                            matchCredCardDets = BillSettlement.BillSettlementScreenFieldsData.CreditCardDets.filter((p) => p.ID == _cardDet.CardTypeId);
                        var cardName = null;
                        if (matchCredCardDets != null && matchCredCardDets != undefined && matchCredCardDets.length > 0)
                            cardName = matchCredCardDets[0].Name;

                        if (cardName != null && cardName != undefined && cardName != "" && cardName.length > 0)
                            _cardDet.CardTypeName = cardName;
                        //  _cardDet.CardTypeName = BillSettlement.BillSettlementScreenFieldsData.CreditCardDets.filter((p) => p.ID == _cardDet.CardTypeId)[0].Name; //m_CreditCardTypes.Single(p => p.ID == _cardDet.CardTypeId).Name;
                    }
                }
                else {
                    strCounter = "";
                    strCounter = (j + 1);
                    continue;
                }

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "sCrCardName" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.CardName = FConvert.toString(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "sCrCardNumber" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.CardNumber = FConvert.toString(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "fCrCardAmount" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.DebitAmount = FConvert.toDecimal(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "fCrCardCharges" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.CardCharges = FConvert.toDecimal(_Data[0].Tag);

                if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                    && BillSettlement.CardChargesColMap.EffectOnNetId == 3)
                    _cardDet.DebitAmount = _cardDet.DebitAmount + _cardDet.CardCharges;

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter(p => p.Name == "fCrSchemeDiscount" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.SchemeDiscount = FConvert.toDecimal(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "iCrBankAccountId" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.BankAccountId = FConvert.toInt(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "sCrApprovalCode" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.ApprovalCode = FConvert.toString(_Data[0].Tag);

                _Data = BillSettlement.LoadedHeaderExtraFieldsData.filter((p) => p.Name == "sCrExpDate" + strCounter);
                if (_Data != null && _Data != undefined && _Data.length > 0)
                    _cardDet.ExpDate = FConvert.toString(_Data[0].Tag);

                _cardDet.IsLoaded = (BillSettlement.IsPreOrderScreen == true ? false : true);
                //if (SchemesAppliedPrompts != null)
                //    _cardDet.Prompts = SchemesAppliedPrompts.Where(p => p.SchemeImplType == SchemeImplementedType.AtBillSettlement && p.PaymentType == PaymentTypes.CreditCard && p.PaymentTypeId == _cardDet.CardTypeId).ToList();
                BillSettlement.BillSettlementPaymentDetails.CreditCardDet.push(_cardDet);
                strCounter = "";
                strCounter = (j + 1);
            }

            for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++) {
                BillSettlement.CreditCardSchemeDisc = FConvert.toDecimal(BillSettlement.CreditCardSchemeDisc) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].SchemeDiscount);

                ///Modified on July 24, 2012
                ///While loading Bill amount is loaded with Credit card charges. So here we are deducting that one
                //Added this condition on 26/08/2013 : Card charges has to be loaded according to Customization
                if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                    && BillSettlement.CardChargesColMap.EffectOnNetId == 1)
                    BillSettlement.BillAmount = BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) - FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardCharges);
                else if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                    && BillSettlement.CardChargesColMap.EffectOnNetId == 2)
                    BillSettlement.BillAmount = BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardCharges);
            }

            /*SANA Remarks : SHowimng Bill AMount & Net Amount was calculating wronge*/
            //BILLSETTLEMENT.updatePaidAmt();
            //Create Grid To Show Credit Card Details

            if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length > 0)
                BILLSETTLEMENT.loadCreditCardIntoGrid(BillSettlement.BillSettlementPaymentDetails.CreditCardDet);

        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.loadCreditCardHeaderData, Catch block : Error Message : " + Ex.message);
            return false;
        }
