                    passingArgs.discountAmt = FConvert.toDecimal(passingArgs.discountAmt, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(diff, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
