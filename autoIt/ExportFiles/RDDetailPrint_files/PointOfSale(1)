                var iCount = parseInt($("#divSearchItemMain").attr('data-Count'));
                var iMaxCount = parseInt($("#divSearchItemMain").attr('data-MaxRecordCount'));
                var iRecordsPerPage = parseInt($("#divSearchItemMain").attr('data-RecordPerPage'));
                if (navigationButtonClick == 1)
                    iCount = 0;
                else if (navigationButtonClick == 2)
                    iCount -= iRecordsPerPage;
                else if (navigationButtonClick == 3)
                    iCount += iRecordsPerPage;
                else if (navigationButtonClick == 4) {
                    iCount = iRecordsPerPage * (parseInt(iMaxCount / iRecordsPerPage));
                    if (iCount == iMaxCount)
                        iCount -= iRecordsPerPage;

                    $("#btnSearchItemFirst").removeClass("nextPrevious");
                    $("#btnSearchItemFirst").addClass("nextPreviousActive");
                    $("#btnSearchItemPrevious").removeClass("nextPrevious");
                    $("#btnSearchItemPrevious").addClass("nextPreviousActive");
                    $("#btnSearchItemNext").removeClass("nextPreviousActive");
                    $("#btnSearchItemNext").addClass("nextPrevious");
                    $("#btnSearchItemLast").removeClass("nextPreviousActive");
                    $("#btnSearchItemLast").addClass("nextPrevious");
                }
                $("#btnSearchItemFirst").removeClass("nextPrevious");
                $("#btnSearchItemFirst").addClass("nextPreviousActive");
                $("#btnSearchItemPrevious").removeClass("nextPrevious");
