    checkProductRestrictionData: function (currentProduct, objProductRestrictionList) {
        try {
            let msgNotAllowedAsThereIsMaxItemRestrictionInTheBill = $("#NotAllowedAsThereIsMaxItemRestrictionInTheBill").val();
            ////debugger;
            let mainProducts = POSSCHEMEIMPLEMENTATIONGENERICS.getProductToImplementSchemes(false, false, true, false);
            if (mainProducts != null && mainProducts != undefined && mainProducts.length > 0) {

                if (objProductRestrictionList != null && objProductRestrictionList != undefined && objProductRestrictionList.length > 0) {
                    let prdRest = objProductRestrictionList.find((p) => p.ProductList.find((q) => q.ProductId == currentProduct.DefaultValue1));
                    if (prdRest != null && prdRest != undefined) {
                        let dTotalProductsMatchedQty = 0;
                        let dComparisionQty = 0;
                        let applyingRestrictionMainProds = [];
                        for (let restCounter = 0; restCounter < prdRest.ProductList.length; restCounter++) {
                            let mainProd = mainProducts.filter((p) => p.DefaultValue1 == prdRest.ProductList[restCounter].ProductId);
                            if (mainProd != null && mainProd != undefined && mainProd.length > 0) {
                                for (let j = 0; j < mainProd.length; j++)
                                    applyingRestrictionMainProds.push(mainProd[j]);
                            }
                        }

                        if (prdRest.UnitId == 0)
                            dComparisionQty = FConvert.toDecimal(prdRest.Quantity);
                        else
                            dComparisionQty = FConvert.toDecimal(prdRest.BaseQuantity);

                        let sum = 0;
                        for (let j = 0; j < applyingRestrictionMainProds.length; j++)
                            sum = sum + applyingRestrictionMainProds[j].DefaultValue3;

