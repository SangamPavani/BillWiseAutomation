                $("#txtHeaderExtraFieldCaption").focus()
                return false;
            }

            if (txtFieldName.trim() == "" || txtFieldName.trim() == undefined || txtFieldName.trim() == null) {
                toastr.error(msgNameCantbeEmpty);
                $("#txtHeaderExtraFieldName").focus();
                return false;
            }

            if ($("#ddlHeaderExtraFieldDataType option:selected").val() == null ||
                $("#ddlHeaderExtraFieldDataType option:selected").val() == "" ||
                FConvert.toInt($("#ddlHeaderExtraFieldDataType option:selected").val()) < 0) {
                toastr.error(msgPlzSelectDataTypeForField);
                $("#ddlHeaderExtraFieldDataType").focus();
                return false;
            }
            if (FConvert.toInt($("#ddlHeaderExtraFieldDataType option:selected").val()) == 0 &&
                (($("#txtHeaderExtraFieldMaxLength").val() == null || $("#txtHeaderExtraFieldMaxLength").val() == undefined) ||
                    $("#txtHeaderExtraFieldMaxLength").val() == "" || $("#txtHeaderExtraFieldMaxLength").val() <= 0)) {
                toastr.error(msgMaxLengthMandWhenDataTypeIsText);
                $("#txtHeaderExtraFieldMaxLength").val("0");
                $("#txtHeaderExtraFieldMaxLength").focus();
