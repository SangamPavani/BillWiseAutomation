            let msgOk = $("#msgOk").val();
            let msgOTPverifiedSuccessfully = $("#msgOTPverifiedSuccessfully").val();
            let msgPointOfSaleInformation = $("#msgPointOfSaleInformation").val();
            let msgOTPSendSuccessfullyToMobileNum = $("#msgOTPSendSuccessfullyToMobileNum").val();
            let msgExceptionWhileSendingOTPToMobile = $("#msgExceptionWhileSendingOTPToMobile").val();
            let msgPleaseUseResendOTP = $("#msgPleaseUseResendOTP").val();

            if (bSuccess == false) {
                toastr.error(data.sMessage);
                return;
            }
            else {
                let verifyOtpArgs = null;
                var billSettlementDiv = $("#divForBillSettlementModalOne");
                if (billSettlementDiv != null && billSettlementDiv != undefined && billSettlementDiv.length > 0)
                    $('#divForBillSettlementModalOne').html(data);
                else {
                    $("#divForModalMain").html('');
                    $('#divForModalMain').html(data);
                }

                $("#txtMobileNumber").val(SEARCHMEMBER.VARIABLE.selectedMemberDetails.Mobile);
                const dataVerifyOtpArgs = $("#divVerifyOtpModal").attr("data-VerifyOtpArgs")
                if (dataVerifyOtpArgs != null && dataVerifyOtpArgs != undefined) {
                    verifyOtpArgs = JSON.parse(dataVerifyOtpArgs)
                }
                if (verifyOtpArgs == null || verifyOtpArgs == undefined)
                    return;

                if (verifyOtpArgs.oTPRequiredTo == OTPRequiredTo.eWard) {
                    if (verifyOtpArgs.eWardRedeemPointsAPIResponse != null && verifyOtpArgs.eWardRedeemPointsAPIResponse != undefined) {
                        if (verifyOtpArgs.eWardRedeemPointsAPIResponse.status_code == 200 && verifyOtpArgs.eWardRedeemPointsAPIResponse.response.authentication == true) {
                            $('#divForBillSettlementModalOne').html(data);
                            $('#divVerifyOtpModal').modal('show');
                            return;
                        }
                        else if (verifyOtpArgs.eWardRedeemPointsAPIResponse.status_code == 200 && verifyOtpArgs.eWardRedeemPointsAPIResponse.response.authentication == false) {
                            $("#divVerifyOtpModalResendButton").css('display', 'block');
                            //RETAILMAIN.closePopup('#divVerifyOtpModal');
                            $('#divForBillSettlementModalOne').html("");
                            BILLSETTLEMENT.setControlVisibility("divtbHeaderPtRedemptValBS", true);
                            BILLSETTLEMENT.setControlVisibility("divRequestOtpMemberBtn", false);
                            BILLSETTLEMENT.setControlVisibility("divBillSettlementrequestOtpMemberPointsIntegration", false);
                            $("#divPointsRedemptionSendOTP").css('display', 'none');
                            $("#divBillSettlementPointsRedemptionPay").css('display', 'none');
                            $("#divPointsRedemptionVerifyOTP").css('display', 'block');
                            if (GlobalPref.Version == eVersion.Version10) {
                                $("#divHeaderTotPointsVal").css('display', 'none');
                            }
                            else if (GlobalPref.Version == eVersion.Version9) {
                                BILLSETTLEMENT.setControlVisibility("divHeaderTotPointsVal", false);
                            }

                            return;
                        }
                        else if (verifyOtpArgs.eWardRedeemPointsAPIResponse.status_code == 400) {
                            var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                            messageInfoPopup.Caption = msgPointOfSaleInformation;
                            messageInfoPopup.Message = [];
                            messageInfoPopup.Message[0] = verifyOtpArgs.eWardRedeemPointsAPIResponse.response.message;
                            messageInfoPopup.ButtonType = msgOk;
                            messageInfoPopup.OkMethod = "SEARCHMEMBER.afterMemberPointIntegration()";
                            var arrValue = [];
                            arrValue.push(messageInfoPopup);
                            arrValue.push("divMessageInfo");
                            COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                            return;
                        }
                    }
                    else {
                        toastr.info(msgOTPverifiedSuccessfully);
                        RETAILMAIN.closePopup('#divVerifyOtpModal');
                        $('#divForBillSettlementModalOne').html("");
                        BILLSETTLEMENT.setControlVisibility("divtbHeaderPtRedemptValBS", true);
                        BILLSETTLEMENT.setControlVisibility("divRequestOtpMemberBtn", false);
                        BILLSETTLEMENT.setControlVisibility("divBillSettlementrequestOtpMemberPointsIntegration", false);
                        $("#divPointsRedemptionSendOTP").css('display', 'none');
                        $("#divBillSettlementPointsRedemptionPay").css('display', 'inline-block');
                        $("#divPointsRedemptionVerifyOTP").css('display', 'none');
                        if (GlobalPref.Version == eVersion.Version10) {
                            $("#divHeaderTotPointsVal").css('display', 'flex');
                        }
                        else if (GlobalPref.Version == eVersion.Version9) {
                            BILLSETTLEMENT.setControlVisibility("divHeaderTotPointsVal", true);
                        }
                        return;
                    }
                }
                else if (verifyOtpArgs.oTPRequiredTo == OTPRequiredTo.Zithara) {
                    if (verifyOtpArgs.zitharaMemberPointResponse != null && verifyOtpArgs.zitharaMemberPointResponse != undefined) {
                        SEARCHMEMBER.VARIABLE.zitharaMemberPointResponse = verifyOtpArgs.zitharaMemberPointResponse;
                        if (verifyOtpArgs.zitharaMemberPointResponse.status == 200) {
                            $('#divVerifyOtpModal').modal('show');
