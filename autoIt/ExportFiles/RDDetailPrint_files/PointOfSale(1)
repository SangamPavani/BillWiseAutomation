    getDiscountValuesforDiscVoucher: function (IsReedemable) //ref decimal TotalLineDiscountWithDV, ref decimal TotalBillDiscountWithDV
    {
        try {
            var rtnValues = [];
            var TotalLineDiscountWithDV = 0, TotalBillDiscountWithDV = 0;
            if (BillSettlement.DiscountVoucherPrompts != null && BillSettlement.DiscountVoucherPrompts != undefined && BillSettlement.DiscountVoucherPrompts.length > 0) {
                var _linePrompts = [], _billPrompts = [];
                for (let i = 0; i < BillSettlement.DiscountVoucherPrompts.length; i++) {
                    if (BillSettlement.DiscountVoucherPrompts[i].ProductId > 0 && BillSettlement.DiscountVoucherPrompts[i].DiscVoucherRedeemable == IsReedemable)
                        _linePrompts.push(BillSettlement.DiscountVoucherPrompts[i]);

                    if (BillSettlement.DiscountVoucherPrompts[i].ProductId == 0 && BillSettlement.DiscountVoucherPrompts[i].DiscVoucherRedeemable == IsReedemable)
                        _billPrompts.push(BillSettlement.DiscountVoucherPrompts[i]);
                }

                if (_linePrompts != null && _linePrompts != undefined && _linePrompts.length > 0) {
                    for (let i = 0; i < _linePrompts.length; i++)
                        TotalLineDiscountWithDV = TotalLineDiscountWithDV + _linePrompts[i].Amount;
                }

                if (_billPrompts != null && _billPrompts != undefined && _billPrompts.length > 0) {
                    for (let i = 0; i < _billPrompts.length; i++)
                        TotalBillDiscountWithDV = TotalBillDiscountWithDV + _billPrompts[i].Amount;
                }
            }

            rtnValues.push(TotalLineDiscountWithDV);
            rtnValues.push(TotalBillDiscountWithDV);
            return rtnValues;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getDiscountValuesforDiscVoucher, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
    updateTextBlocks_RightSide: function () {
        try {
            let _prompts = [];
            var _schemeDiscOnBill = 0.0, _schemeDiscOnItem = 0.0;

            if (BillSettlement.SchemesAppliedPrompts != null && BillSettlement.SchemesAppliedPrompts != undefined && BillSettlement.SchemesAppliedPrompts.length > 0) {
                var _BillPrompts = [], _LinePrompts = [];
                for (let i = 0; i < BillSettlement.SchemesAppliedPrompts.length; i++) {
                    if (BillSettlement.SchemesAppliedPrompts[i].ProductId == 0
                        && BillSettlement.SchemesAppliedPrompts[i].PromoType == PromoTypes.get("DISCOUNT")
                        && BillSettlement.SchemesAppliedPrompts[i].SchemeImplType == SchemeImplementedType.get("ATBILLSETTLEMENT")
                        && BillSettlement.SchemesAppliedPrompts[i].PODepositNo == BillSettlement.PODepositNo) {
                        _BillPrompts.push(BillSettlement.SchemesAppliedPrompts[i]);
                    }

                    if (BillSettlement.SchemesAppliedPrompts[i].ProductId > 0
                        && BillSettlement.SchemesAppliedPrompts[i].PromoType == PromoTypes.get("DISCOUNT")
                        && BillSettlement.SchemesAppliedPrompts[i].SchemeImplType == SchemeImplementedType.get("ATBILLSETTLEMENT")
                        && BillSettlement.SchemesAppliedPrompts[i].PODepositNo == BillSettlement.PODepositNo) {
                        _LinePrompts.push(BillSettlement.SchemesAppliedPrompts[i]);
                    }
                }

                if (_BillPrompts != null && _BillPrompts != undefined && _BillPrompts.length > 0) {
                    for (let i = 0; i < _BillPrompts.length; i++)
                        _schemeDiscOnBill = FConvert.toDecimal(_schemeDiscOnBill, POSCommon.numberofDecimal) + FConvert.toDecimal(_BillPrompts[i].Amount, POSCommon.numberofDecimal);
                }

                if (_LinePrompts != null && _LinePrompts != undefined && _LinePrompts.length > 0) {
                    for (let i = 0; i < _LinePrompts.length; i++)
                        _schemeDiscOnItem = FConvert.toDecimal(_schemeDiscOnItem, POSCommon.numberofDecimal) + FConvert.toDecimal(_LinePrompts[i].Amount, POSCommon.numberofDecimal);
                }
            }

            BillSettlement.NetAmount = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.BillAmount) + FConvert.toDecimal(BillSettlement.TotalRoundOff), POSCommon.numberOfDecimal);
            BillSettlement.TotalRoundOff = BillSettlement.RoundOff; //RoundOffCash + RoundOffCard
            if (FConvert.toDecimal(BillSettlement.TotalRoundOff, POSCommon.numberOfDecimal) != 0)
                $("#lblBillRoundoff").text(FConvert.addNumericSeparator(FConvert.toDecimal((FConvert.toDecimal(BillSettlement.TotalRoundOff) + FConvert.toDecimal(BillSettlement.NetRoundOffAccPref)), POSCommon.numberOfDecimal)));
            else
                $("#lblBillRoundoff").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.NetRoundOffAccPref, POSCommon.numberOfDecimal)));

            $("#lblBillAmount").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BillAmount, POSCommon.numberOfDecimal)));

            /*False parameter will act like scheme discount and hence effect Net Value and the discount got 
            from line wise and bill wise is updated on Scheme and Discount Footer Columns present right side.*/

            var rtnValue = BILLSETTLEMENT.getDiscountValuesforDiscVoucher(false);

            BillSettlement.TotalLineDiscountWithDV = FConvert.toDecimal(rtnValue[0], POSCommon.numberofDecimal); // _TotalLineDiscountWithDV;
            BillSettlement.TotalBillDiscountWithDV = FConvert.toDecimal(rtnValue[1], POSCommon.numberofDecimal);// _TotalBillDiscountWithDV;
            var totalPaymentSchemesDiscount = BillSettlement.SchemeDiscountCash + BillSettlement.CreditCardSchemeDisc +
                BillSettlement.DebitCardSchemeDisc + BillSettlement.SchemeDiscountCheque +
                BillSettlement.GiftVoucherSchemeDisc;

            var discount = FConvert.toDecimal(BillSettlement.OriginalDisc, POSCommon.numberofDecimal) + BillSettlement.TotalLineDiscountWithDV + (_schemeDiscOnItem) - BillSettlement.LoadedPreOrderDiscOnItem;
            BillSettlement.Discount = FConvert.toDecimal(discount, POSCommon.numberOfDecimal);

            $("#lblBillDiscount").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.Discount, POSCommon.numberOfDecimal))); //ProxyLayer.ConvertToCompanyNumericSeparator(Discount, POSCommon.numberOfDecimal);
            var totalSchemeDiscount = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.TotalBillDiscountWithDV) + FConvert.toDecimal(_schemeDiscOnBill) - FConvert.toDecimal(BillSettlement.LoadedPreOrderDiscOnBill), POSCommon.numberOfDecimal);
            //Balance amount
            BillSettlement.FooterSchemesDiscount = FConvert.toDecimal(BillSettlement.Scheme, POSCommon.numberofDecimal) + FConvert.toDecimal(totalSchemeDiscount, POSCommon.numberofDecimal) + FConvert.toDecimal(BillSettlement.LoadedPreOrderDiscOnBill, POSCommon.numberofDecimal);
            $("#lblBillScheme").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.FooterSchemesDiscount, POSCommon.numberOfDecimal)));
            $("#lblBillPaid").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt, POSCommon.numberOfDecimal)));// ProxyLayer.ConvertToCompanyNumericSeparator(PaidAmt, POSCommon.numberOfDecimal);
            $("#lblAmountPaid").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt, POSCommon.numberOfDecimal)));
            if (ApplicationNew.RetailTransFooter != null && ApplicationNew.RetailTransFooter != undefined) {
                const field = ApplicationNew.RetailTransFooter.FooterFieldsList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("SCHEMEDISCOUNT"));
                if (field != null && field != undefined && field.length > 0) {
                    var getSchemeDiscountId = field[0].ID;
                    BillSettlement.BillSettlementPaymentDetails.TotalSchemeAmount = BillSettlement.TotalSchemeAmount = BillSettlement.FooterSchemesDiscount;
                    $("#txtFooterExtraFieldId_" + getSchemeDiscountId).text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TotalSchemeAmount, POSCommon.numberOfDecimal, true)));
                }
            }

            BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.BillAmount, POSCommon.numberofDecimal) - FConvert.toDecimal(totalSchemeDiscount, POSCommon.numberofDecimal) - FConvert.toDecimal(BillSettlement.TotalLineDiscountWithDV, POSCommon.numberofDecimal) - FConvert.toDecimal(_schemeDiscOnItem, POSCommon.numberofDecimal) + FConvert.toDecimal(BillSettlement.LoadedPreOrderDiscOnItem, POSCommon.numberofDecimal);//BillAmt - Discount - totalSchemeDiscount;
            BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount, POSCommon.numberofDecimal) + FConvert.toDecimal(BillSettlement.TotalRoundOff, POSCommon.numberofDecimal);
            BILLSETTLEMENT.updateNetAmtWithCardCharges();

            if (FConvert.toDecimal(BillSettlement.NetAmount) < 0)
                $("#lblNett").text(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
            else {
                $("#lblNett").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.NetAmount, POSCommon.numberOfDecimal)));
                $("#lblAmountPayable").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.NetAmount, POSCommon.numberOfDecimal)));
            }

            var billSettlementBalance = FConvert.toDecimal(BillSettlement.NetAmount) - FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt);
            BillSettlement.BalanceAmount = FConvert.toDecimal(billSettlementBalance, POSCommon.numberOfDecimal);
            if (FConvert.toDecimal(BillSettlement.BalanceAmount) <= 0) {
                FCommon.UI.enableButton(true, "btnFooter"); // $("#btnFooter").prop('disabled', false);

                if ($("#btnCustomPrint").is(":visible"))
                    FCommon.UI.enableButton(true, "btnCustomPrint"); //$("#btnCustomPrint").prop('disabled', false);

                $("#lblBillBalance").text(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                $("#lblAmountBalance").text(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                $("#lblBillChange").text(FConvert.addNumericSeparator(FConvert.toDecimal(Math.abs(BillSettlement.BalanceAmount), POSCommon.numberOfDecimal)));
                BillSettlement.BalanceAmount = 0.00;
            }
            else {
                $("#lblBillBalance").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal)));
                $("#lblAmountBalance").text(FConvert.addNumericSeparator(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal)));
                if ($("#btnCustomPrint").is(":visible"))
                    FCommon.UI.enableButton(false, "btnCustomPrint"); // $("#btnCustomPrint").prop('disabled', true);

                FCommon.UI.enableButton(false, "btnFooter"); // $("#btnFooter").prop('disabled', true);
                $("#lblBillChange").text(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.updateTextBlocks_RightSide, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
    updateNetAmtWithCardCharges: function () {
        try {
            ///EffectOnNet : Add & Assume Inclusive only allowed for Credit card charges
            if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                && BillSettlement.CardChargesColMap.EffectOnNetId == 1) {
                //Amount paid with credit card
                var cCardCharges = 0;
                if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet != null && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != undefined && BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length > 0) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
                        cCardCharges += FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardCharges);

                    BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) + FConvert.toDecimal(cCardCharges);
                }

                //Amount paid with debit card
                var dCardCharges = 0;
                if (BillSettlement.BillSettlementPaymentDetails.DebitCardDet != null && BillSettlement.BillSettlementPaymentDetails.DebitCardDet != undefined && BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length > 0) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length; i++)
                        dCardCharges += FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardDet[i].CardCharges);

                    BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) + FConvert.toDecimal(dCardCharges);
                }
            }

            if (BillSettlement.EPaymentChargesColMap != null && BillSettlement.EPaymentChargesColMap != undefined && BillSettlement.EPaymentChargesColMap.EffectOnNetId == 1) {
                //Amount paid with EPayment
                var dEPaymentCharges = 0;
                if (BillSettlement.BillSettlementPaymentDetails.EPaymentDet != null && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != undefined && BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length > 0) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length; i++)
                        dEPaymentCharges += FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].CardCharges);

                    BillSettlement.NetAmount = FConvert.toDecimal(BillSettlement.NetAmount) + FConvert.toDecimal(dEPaymentCharges);
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.updateNetAmtWithCardCharges, Catch block : Error Message : " + Ex.message);
