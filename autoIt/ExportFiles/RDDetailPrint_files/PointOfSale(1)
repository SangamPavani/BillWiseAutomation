    getInputControlWastageEvent: function (inputControl, evt) {
        try {

            var msgtxtWastageCantBeEpt = $("#msgtxtWastageCantBeEpt").val();
            var msgtxtInfoWastageNot100 = $("#msgtxtInfoWastageNot100").val();
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = evt.which ? evt.which : evt.keyCode;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            else if (charCode == 13 || charCode == 9) {
                var inputControlText = $(inputControl).val();
                var inputControlClosestTableCell = $(inputControl).closest('td');
                var inputControlClosestTableRow = $(inputControl).closest('tr');
                var ItemsMappingDetails = $(inputControlClosestTableRow).attr('data-ItemsMappingInfo');
                if (ItemsMappingDetails == null || ItemsMappingDetails == undefined || ItemsMappingDetails == "")
                    var parsedItemsMappingDetails = ITEMSMAPPINGDATASTRUCT.getProductMapping();
                else
                    parsedItemsMappingDetails = JSON.parse(ItemsMappingDetails);

                parsedItemsMappingDetails.Wastage = FConvert.toDecimal($(inputControl).val(), POSCommon.numberOfDecimal);
                if (inputControlText == "" || inputControlText == null || inputControlText == undefined) {
                    toastr.error(msgtxtWastageCantBeEpt);
                    $(inputControl).find('input').focus();
                    return;
                }
                else if (inputControlText > 0) {
                    if (inputControlText > 100) {
                        toastr.error(msgtxtInfoWastageNot100);
                        $(inputControl).find('input').focus();
                        return;
                    }
                    parsedItemsMappingDetails.Wastage = FConvert.toDecimal(inputControlText, POSCommon.numberOfDecimal);
                    $(inputControl).find('input').remove();
                    $(inputControlClosestTableCell).html(FConvert.toDecimal(parsedItemsMappingDetails.Wastage, POSCommon.numberOfDecimal));
                    $(inputControlClosestTableRow).attr("data-ItemsMappingInfo", JSON.stringify(parsedItemsMappingDetails));

                }
                else {
