    BindCriteriaDetails: function (freescheme) {
        try {
            // Binding criteria data
            SCHEMESFREEITEMS.VARIABLE.FreeSchemesCritriaDtls = [];
            var _Criteria = freescheme.Criteria

            if (_Criteria.CombineWithOtherSchemes == true)
                $("#chkFreeItemCombineWithOtherSchemes").prop("checked", "checked");
            else
                $("#chkFreeItemCombineWithOtherSchemes").prop("checked", false);

            if (_Criteria.ApplyToNewlyCreatedProducts == true)
                $("#chkFreeItemApplyToCreatedGroup").prop("checked", "checked");
            else
                $("#chkFreeItemApplyToCreatedGroup").prop("checked", false);

            if (_Criteria.CriteriaId == 1) {
                $("#chkFreeItemQuantity").prop("checked", "checked");
                $("#txtFreeItemMinQty").prop("disabled", false);
                $("#txtFreeItemMaxQty").prop("disabled", false);

                $("#txtFreeItemMinQty").val(FConvert.toDecimal(_Criteria.MinQty, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtFreeItemMaxQty").val(FConvert.toDecimal(_Criteria.MaxQty, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));

                FCommon.UI.enableButton(true, "divCriteriaUnit");
                SCHEMESFREEITEMS.VARIABLE.CriteriaUnitIsEnabled = true;

                $("#chkFreeItemValue").prop("checked", false);
                $("#txtFreeItemMinValue").prop("disabled", true);
                $("#txtFreeItemMaxValue").prop("disabled", true);
            }
            else if (_Criteria.CriteriaId == 2) {
                $("#chkFreeItemValue").prop("checked", "checked");
                $("#txtFreeItemMinValue").prop("disabled", false);
                $("#txtFreeItemMaxValue").prop("disabled", false);
                $("#txtFreeItemMinValue").val(FConvert.toDecimal(_Criteria.MinValue, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtFreeItemMaxValue").val(FConvert.toDecimal(_Criteria.MaxValue, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));

                $("#chkFreeItemQuantity").prop("checked", false);
                $("#txtFreeItemMinQty").prop("disabled", true);
                $("#txtFreeItemMaxQty").prop("disabled", true);
                FCommon.UI.enableButton(false, "divCriteriaUnit");
                SCHEMES.VARIABLE.unitIsEnabled = false;

            }
            else {
                $("#chkFreeItemQuantity").prop("checked", "checked");
                $("#txtFreeItemMinQty").prop("disabled", false);
                $("#txtFreeItemMaxQty").prop("disabled", false);
                $("#txtFreeItemMinQty").val(FConvert.toDecimal(_Criteria.MinQty, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtFreeItemMaxQty").val(FConvert.toDecimal(_Criteria.MaxQty, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));

                FCommon.UI.enableButton(true, "divCriteriaUnit");
                SCHEMESFREEITEMS.VARIABLE.CriteriaUnitIsEnabled = true;

                $("#chkFreeItemValue").prop("checked", "checked");
                $("#txtFreeItemMinValue").prop("disabled", false);
                $("#txtFreeItemMaxValue").prop("disabled", false);
                $("#txtFreeItemMinValue").val(FConvert.toDecimal(_Criteria.MinValue, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtFreeItemMaxValue").val(FConvert.toDecimal(_Criteria.MaxValue, SCHEMESFREEITEMS.VARIABLE.POSCommon.numberOfDecimal));
            }

            let unitIdStringValue = "";
            if (SCHEMESFREEITEMS.VARIABLE.CriteriaUnitsVisible == true) {
                for (let i = 0; i < _Criteria.UnitPair.length; i++) {
                    $('#ddlCriteriaUnit').append("<option id='" + _Criteria.UnitPair[i].ID + "' value='" + _Criteria.UnitPair[i].ID + "' data-FreeItemUnitDetails='" + JSON.stringify(_Criteria.UnitPair[i]) + "' >" + _Criteria.UnitPair[i].Name + "</option>");
                    $("#ddlCriteriaUnit").val(_Criteria.UnitId);
                    unitIdStringValue = unitIdStringValue + _Criteria.UnitPair[i].ID + ",";
                }

                if (unitIdStringValue != null && unitIdStringValue != undefined && unitIdStringValue.trim().length > 0)
                    unitIdStringValue = unitIdStringValue.substring(0, unitIdStringValue.length - 1);
            }

            debugger;
            if (_Criteria.ProdSelCriteriaId == 1) {
                var ProductIds_CriteriaTab = _Criteria.CriteriaItemIds;
                SCHEMESFREEITEMS.VARIABLE.oldCriteriaItemId = ProductIds_CriteriaTab;
                $("#divFreeItemCriteriaDefinitionRight > #divTreeViewControlStoreInformation").attr("data-SelectedProductId", _Criteria.CriteriaItemIds);
                $("#divFreeItemCriteriaDefinitionRight > #divTreeViewControlStoreInformation").attr("data-SelectedProductGroupId", _Criteria.Groupidspresent);

                if (unitIdStringValue != null && unitIdStringValue != undefined && unitIdStringValue.trim().length > 0)
                    $("#divFreeItemCriteriaDefinitionRight > #divTreeViewControlStoreInformation").attr("data-SelectedProductUnitId", unitIdStringValue);
                else
                    $("#divFreeItemCriteriaDefinitionRight > #divTreeViewControlStoreInformation").attr("data-SelectedProductUnitId", null);
            }
            SCHEMESFREEITEMS.VARIABLE.FreeSchemesCritriaDtls.push(_Criteria);

            //Binding freeitems data
            SCHEMESFREEITEMS.VARIABLE.FreeSchemesGrpDtls = [];
            if (_Criteria.FreeSchemesGrpDtlsList != null && _Criteria.FreeSchemesGrpDtlsList.length > 0) {

                var FreeSchemesBodyList = [];
                for (let i = 0; i < _Criteria.FreeSchemesGrpDtlsList.length; i++) {

                    if (_Criteria.FreeSchemesGrpDtlsList[i].DisctypeId == 1) {
                        _Criteria.FreeSchemesGrpDtlsList[i].DisctypeName = "Discount Amt";
                        _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "";
                    }
                    else if (_Criteria.FreeSchemesGrpDtlsList[i].DisctypeId == 2) {
                        _Criteria.FreeSchemesGrpDtlsList[i].DisctypeName = "Discount %";
                        if (_Criteria.FreeSchemesGrpDtlsList[i].DiscountOn == 1) {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "Any Item";
                        }
                        else {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "All Items";
                        }
                    }
                    else if (_Criteria.FreeSchemesGrpDtlsList[i].DisctypeId == 3) {
                        _Criteria.FreeSchemesGrpDtlsList[i].DisctypeName = "Free";
                        if (_Criteria.FreeSchemesGrpDtlsList[i].DiscountOn == 1) {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "Any Item";
                        }
                        else {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "All Items";
                        }
                    }
                    else if (_Criteria.FreeSchemesGrpDtlsList[i].DisctypeId == 4) {
                        _Criteria.FreeSchemesGrpDtlsList[i].DisctypeName = "Fixed Rate";
                        if (_Criteria.FreeSchemesGrpDtlsList[i].DiscountOn == 1) {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "Group";
                        }
                        else {
                            _Criteria.FreeSchemesGrpDtlsList[i].DiscountOnName = "Individually";
                        }
                    }

                    if (_Criteria.FreeSchemesGrpDtlsList[i] == 1)
                        _Criteria.FreeSchemesGrpDtlsList[i].ProdSelCriteria = "Show Items";

                    FreeSchemesBodyList.push(_Criteria.FreeSchemesGrpDtlsList[i]);
                    SCHEMESFREEITEMS.VARIABLE.FreeSchemesGrpDtls = FreeSchemesBodyList;
                }
                if (_Criteria.FreeSchemesGrpDtlsList[0].SchemeOn == 1)
                    $("#rbAnyItem").prop("checked", "checked");
                else
                    $("#rbAllItem").prop("checked", "checked");
            }

            $("#tbodyFreeItemGrpDtls").html('');
            if (SCHEMESFREEITEMS.VARIABLE.FreeSchemesGrpDtls != null && SCHEMESFREEITEMS.VARIABLE.FreeSchemesGrpDtls != undefined && SCHEMESFREEITEMS.VARIABLE.FreeSchemesGrpDtls.length > 0) {
