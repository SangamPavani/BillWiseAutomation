                            return;
                        }
                    }
                }
                BILLSETTLEMENT.afterCreditNoteRedeemption();
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getCreditNotePayClickEvent, Catch block : Error Message : " + Ex.message);
