    afterBatchSelected: function () {
        try {
            PRODUCTMETHODNEW.requiredActionBeforePosting();
            let msgPOSInformation = $("input#msgPOSInformation").val();
            let lblYouarenotallowedtogivethisdiscount = $("input#lblYouarenotallowedtogivethisdiscount").val();
            let msgNotAllowedAsThereIsMaxItemRestrictionInTheBill = $("#NotAllowedAsThereIsMaxItemRestrictionInTheBill").val();
            let rtnValues = [];
            let isNew = false;
            let lstTemp = [];
            //debugger;
            if (ApplicationNew.BatchRelatedList != null && ApplicationNew.BatchRelatedList != undefined && ApplicationNew.BatchRelatedList.length > 0) {
                isNew = FConvert.toBoolean(ApplicationNew.BatchRelatedList[0].isNew);

                for (let i = 0; i < ApplicationNew.BatchRelatedList.length; i++) {
                    if (ApplicationNew.BatchRelatedList[i].Result == false && (ApplicationNew.BatchRelatedList[i].BatchData == null || ApplicationNew.BatchRelatedList[i].BatchData == undefined || ApplicationNew.BatchRelatedList[i].BatchData.length <= 0))
                        rtnValues = PRODUCTMETHODNEW.BATCHPOPUPMETHODS.emptyBatchSelected(ApplicationNew.BatchRelatedList[i]);
                    else
                        rtnValues = PRODUCTMETHODNEW.BATCHPOPUPMETHODS.setBatchRelatedData(ApplicationNew.BatchRelatedList[i], lstTemp);

                    if (rtnValues != null && rtnValues != undefined && rtnValues.length > 0) {
                        if (rtnValues[0] != null && rtnValues[0] != undefined && FConvert.toBoolean(rtnValues[0]) == false) {
                            //13-11-2024 : Sana Remarks : Setting Previous quantity if stock is negative for the selected product(Product is batch enabled)
                            if (TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.PreviousProduct != null && TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.PreviousProduct != undefined)
                                ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue3 = TABLECHANGEMETHODSNEW.VARIABLES.QUANTITY.PreviousProduct.DefaultValue3;

                            toastr.info(rtnValues[1], msgPOSInformation);
                            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[i], ApplicationNew);

                            PRODUCTVIEW.updateLeftPanel();
                            return;
                        }
                    }
                }

                if (ApplicationNew.CurrentItem == null || ApplicationNew.CurrentItem == undefined)
                    ApplicationNew.CurrentItem = lstTemp[0];

                let objApprovalRecord = null;
                if (POSCommon.requiredManagerApproval == true) {
                    if (ApplicationNew.ManagerApproval == null || ApplicationNew.ManagerApproval == undefined || ApplicationNew.ManagerApproval.length <= 0)
                        ApplicationNew.ManagerApproval = [];

                    objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == 1065);
                }
                if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord.length <= 0 || objApprovalRecord.ApprovalId <= 0) {
                    if (POSCommon.averagePurchasePrice == true) {
                        // Validate With Average Purchase Price
                        let rtnAvgPrice = PRODUCTSELECTION.validateDiscountWithAveragePurchasePrice(ApplicationNew.CurrentItem, 1065);
                        if (rtnAvgPrice != null && rtnAvgPrice != undefined && rtnAvgPrice.length > 0) {
                            if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                                if (ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] != null && ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] != undefined) {
                                    if (ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].ProductType == 0 && rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined) {
                                        if (FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                                            toastr.info(rtnAvgPrice[1], msgPOSInformation);
                                            return;
                                        }
                                        else if (FConvert.toBoolean(rtnAvgPrice[0]) == true && rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined) {
                                            VERIFICATIONPROCESS.clearVerificationProcessVariables();
                                            VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1065;
                                            MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                                            return;
                                        }
                                    }
                                }
                            }
                            else if (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length <= 0) //First Product Adding.
                            {
                                if (rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined && FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                                    if (rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined && rtnAvgPrice[1].trim().length > 0) {
                                        toastr.info(rtnAvgPrice[1], msgPOSInformation);
                                        return;
                                    }
                                }
                            }
                        }
                    }
                }

                // Validate With Price Book Rate
                let rtnPriceBookRate = [];
                rtnPriceBookRate = PRODUCTSELECTION.validateDiscountWithPriceBookRate(ApplicationNew.CurrentItem, 1065);
                if (rtnPriceBookRate != null && rtnPriceBookRate != undefined && rtnPriceBookRate.length > 0) {
                    if (rtnPriceBookRate[0] != null && rtnPriceBookRate[0] != undefined) {
                        if (FConvert.toBoolean(rtnPriceBookRate[0]) == false) {
                            toastr.info(rtnPriceBookRate[1], msgPOSInformation);
                            return;
                        }
                        else if (FConvert.toBoolean(rtnPriceBookRate[0]) == true) {
                            if (rtnPriceBookRate[1] != null && rtnPriceBookRate[1] != undefined && rtnPriceBookRate[1].length > 0) {
                                VERIFICATIONPROCESS.clearVerificationProcessVariables();
                                VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1065;
                                MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                                return; //Open Popup
                            }
                        }
                    }
                }

                // Validate With CutOff Price / Manager Approval
                let rtnCutOffPrice = PRODUCTSELECTION.validateDiscountWithCutOffPrice(ApplicationNew.CurrentItem, 1065);
                if (rtnCutOffPrice != null && rtnCutOffPrice != undefined && rtnCutOffPrice.length > 0) {
                    if (rtnCutOffPrice[0] != null && rtnCutOffPrice[0] != undefined) {
                        if (FConvert.toBoolean(rtnCutOffPrice[0]) == false) {
                            toastr.info(rtnCutOffPrice[1], msgPOSInformation);
                            return;
                        }
                        else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && (FConvert.toString(rtnCutOffPrice[1]) != null && FConvert.toString(rtnCutOffPrice[1]) != undefined && rtnCutOffPrice[1].length > 0)) {
                            VERIFICATIONPROCESS.clearVerificationProcessVariables();
                            VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1065;
                            MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                            return;
                        }
                        else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && rtnCutOffPrice[1] == "") {
                            if (rtnCutOffPrice[2] != null && rtnCutOffPrice[2] != undefined && rtnCutOffPrice.length > 2) {
                                let mgrPreferencesCutOffPriceIndex = 0, dCutOffPriceForMgr = 0;
                                dCutOffPriceForMgr = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.abs(ApplicationNew.CurrentItem.DefaultValue3), mgrPreferencesCutOffPriceIndex);
                                ApplicationNew.CurrentItem.DefaultValue4 = dPrevPrice;
                                if ((Math.abs(ApplicationNew.CurrentItem.DefaultValue3) * dCutOffPriceForMgr) > (Math.abs(ApplicationNew.CurrentItem.DefaultValue3 * ApplicationNew.CurrentItem.DefaultValue4) - dCurrentCellEnteredValue)) {
                                    toastr.info(lblYouarenotallowedtogivethisdiscount, msgPOSInformation);
                                    return;
                                }
                            }
                            PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(ApplicationNew.CurrentItem, ApplicationNew);
                        }
                    }
                }
                //debugger;//RMA/BATCH Popup
                if (TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.ColumnSelected == LineWiseColumn.None) {
                    if (POSCommon.isRMASupport == true) {
                        if ((ApplicationNew.CurrentItem.RMANos == null || ApplicationNew.CurrentItem.RMANos == undefined || ApplicationNew.CurrentItem.RMANos.length <= 0)
                            || (ApplicationNew.CurrentItem.RMANos != null && ApplicationNew.CurrentItem.RMANos != undefined && ApplicationNew.CurrentItem.RMANos.length != ApplicationNew.CurrentItem.DefaultValue3)) {
                            let rtnRMSSupport = PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopupAddToProduct(ApplicationNew.CurrentItem, isNew, [RMALogic.AfterBatchSelection]);
                            if (rtnRMSSupport != null && rtnRMSSupport != undefined && rtnRMSSupport.length > 0) {
                                if (FConvert.toBoolean(rtnRMSSupport[0]) == false)
                                    return [false, rtnRMSSupport[1]];
                                else if (rtnRMSSupport[0] == true && rtnRMSSupport[1] != null && rtnRMSSupport[1] != undefined && rtnRMSSupport[1].trim().length > 0) {
                                    PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopup();
                                    return [false, ""];
                                }
                            }
                        }
                    }
                }
                else if (PreferenceSetting.PrefInventoryTab.AddProductToNewLine == true && ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts != null &&
                    ApplicationNew.TotalSchemesInfo.LinePrompts != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts.length > 0
                    && lstTemp[0].PromoType == 2
                    && TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.ColumnSelected == LineWiseColumn.Batch) {
                    ApplicationNew.ListOfItems[ApplicationNew.BatchRelatedList[0].CurrentItem.ItemSerialNo - 1] = lstTemp[0];
                }

                //3. Change Price Popup
                if (ApplicationNew.CurrentItem != null && ApplicationNew.CurrentItem != undefined) {
                    if (ApplicationNew.CurrentItem.DefaultValue4 == 0 && ApplicationNew.CurrentItem.PromoType != PromoTypes.get("FREEITEM")) {
                        let rtnChangePricePopup = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopupAddToProduct([ChangePriceLogic.AfterBatchSelection, lstTemp, isNew]);
                        if (rtnChangePricePopup != null && rtnChangePricePopup != undefined && rtnChangePricePopup.length > 0) {
                            if (FConvert.toBoolean(rtnChangePricePopup[0]) == false) {
                                if (rtnChangePricePopup[1] != null && rtnChangePricePopup[1] != undefined && rtnChangePricePopup[1].length > 0)
                                    toastr.info(rtnChangePricePopup[1], msgPOSInformation);

                                return [false, rtnChangePricePopup[1]];
                            }
                            else if (FConvert.toBoolean(rtnChangePricePopup[0]) == true && FConvert.toString(rtnChangePricePopup[1]) != null && FConvert.toString(rtnChangePricePopup[1]) != undefined
                                && FConvert.toString(rtnChangePricePopup[1]).trim().length > 0) {
                                PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopup(0);
                                return [false, ""];
                            }
                        }
                    }
                }

                // Add Product/Product Set, If RMA Popup is not required
                if (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length <= 0)
                    ApplicationNew.ListOfItems = [];

                let totalQuantity = 0, totalGross = 0;
                if (ApplicationNew.CurrentItem != null && ApplicationNew.CurrentItem != undefined && ApplicationNew.CurrentItem.PosProductMake != null && ApplicationNew.CurrentItem.PosProductMake != undefined) {
                    if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET")) {
                        if (lstTemp != null && lstTemp != undefined && lstTemp.length > 0) {
                            // DUSMinutes App Integration Enabled
                            if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != undefined) {
                                if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != undefined) {
                                    if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.IsProductReplacementEnabled == true) {
                                        for (let i = 0; i < lstTemp.length; i++)
                                            lstTemp[i].IsReplacedProduct = true;

                                        let lstCustLineWise = ApplicationNew.ListOfItems;
                                        PRODUCTSELECTION.dusMinutesAppIntegrationReplaceProduct(lstCustLineWise, RETAILMAIN.VARIABLE.ApplicationIntegrationArgs);
                                        ApplicationNew.ListOfItems = lstCustLineWise;
                                    }
                                }
                            }
                            if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                                for (let i = 0; i < lstTemp.length; i++) {
                                    for (let j = 0; j < ApplicationNew.ListOfItems.length; j++) {
                                        if (TABLECHANGEMETHODSNEW.VARIABLES.UNIT.IsUpdateUnit == true) {
                                            if (ApplicationNew.ListOfItems[j].DefaultValue1 == lstTemp[i].DefaultValue1 && ApplicationNew.ListOfItems[j].ProductType == lstTemp[i].ProductType
                                                && ApplicationNew.ListOfItems[j].ItemSerialNo == lstTemp[i].ItemSerialNo && ApplicationNew.ListOfItems[j].ProductUnit == lstTemp[i].ProductUnit) {
                                                let iIndex = ApplicationNew.ListOfItems.indexOf(TABLECHANGEMETHODSNEW.VARIABLES.UNIT.PreviousProduct);
                                                ApplicationNew.ListOfItems.splice(iIndex, 1);
                                                continue;
                                            }
                                        }

                                        if (lstTemp[i].PromoType != 2) {
                                            if (ApplicationNew.ListOfItems[j].DefaultValue1 == lstTemp[i].DefaultValue1 && ApplicationNew.ListOfItems[j].ProductType == lstTemp[i].ProductType
                                                && ApplicationNew.ListOfItems[j].ItemSerialNo == lstTemp[i].ItemSerialNo) {
                                                ApplicationNew.ListOfItems.splice(ApplicationNew.ListOfItems[j].ItemSerialNo - 1, 1);
                                            }
                                            else if (ApplicationNew.ListOfItems[j].DefaultValue1 == lstTemp[i].DefaultValue1 && ApplicationNew.ListOfItems[j].ProductType == lstTemp[i].ProductType
                                                && ApplicationNew.ListOfItems[j].ItemSerialNo != lstTemp[i].ItemSerialNo
                                                && (PreferenceSetting.PrefInventoryTab.AddProductToNewLine == false)
                                                && ApplicationNew.ListOfItems[j].ProductUnit == lstTemp[i].ProductUnit && ApplicationNew.ListOfItems[j].BatchData.BatchId == lstTemp[i].BatchData.BatchId) {
                                                ApplicationNew.ListOfItems.splice(ApplicationNew.ListOfItems[j].ItemSerialNo - 1, 1); //splice(lstTemp[i].ItemSerialNo - 1,1);
