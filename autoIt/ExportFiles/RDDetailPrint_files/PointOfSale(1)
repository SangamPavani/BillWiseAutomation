            var exchangeSpoilageTransaction = HEADEREXTRAFIELDS.isExchangeSpoilageTransaction();
            if (exchangeSpoilageTransaction != null && exchangeSpoilageTransaction != undefined && exchangeSpoilageTransaction.length > 0
                && exchangeSpoilageTransaction[0] != null && exchangeSpoilageTransaction[0] != undefined) {
                if (exchangeSpoilageTransaction[0] == false)
                    return false;

                var lblNettAmount = FConvert.toDecimal($("#lblNett").html());
                var exchangeSpoliageProduct = FConvert.toInt(exchangeSpoilageTransaction[1]);

                //Normal transaction :: No Exchange OR Spoilage product added
                if (exchangeSpoliageProduct <= 0 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("WARNANDCONTINUE")
                    && FConvert.toDecimal(lblNettAmount, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter) == FConvert.toDecimal(0, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter)) {
                    TRANSACTION.postSalesInvoice();
                    return;
                }
                else if (exchangeSpoliageProduct > 0) //Normal transaction :: Exchange/Spoilage product added
                {
                    if (lblNettAmount < 0) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictRefundForGoodsExchge == true)
                            TRANSACTION.postExchangeSpoilage();
                        else
                            EXCHANGESPOILAGE.setRefundSettlementObject();
                        return;
                    }
                    else if (lblNettAmount > 0)
                        return true;
                    else if (lblNettAmount == 0) {
                        TRANSACTION.postExchangeSpoilage();
                        return;
                    }
                }
            }
            else {
                return null;
            }

            return false;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: HEADEREXTRAFIELDS.callExchangeSpoilage :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return null;
