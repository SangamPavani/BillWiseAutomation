        createNestedNode: function (jsonobject, arrParentId) {
            try {
                //
                var parentJson = null, childJson = null;
                for (let i = 0; i < arrParentId.length; i++) {

                    //1. Getting product group json
                    parentJson = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_json(arrParentId[i]);
                    if (parentJson != null && parentJson != undefined) {
                        //2. Checking that product group have children or not
                        if (parentJson.children != null && parentJson.children != undefined && parentJson.children.length > 0) {

                            //3. If children found, then add product group into main product group and call recursive method
                            var parentNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(arrParentId[i]);
                            var parentJsonString = new Object();
                            parentJsonString.id = parentJson.id;
                            parentJsonString.text = parentJson.text;
                            parentJsonString.icon = parentJson.icon;
                            parentJsonString.state = parentJson.state;
                            parentJsonString.Tag = parentNode.original.Tag;
                            parentJsonString.children = [];
                            jsonobject.children.push(parentJsonString);
                            FPRODUCTCONTROL.PRODUCTSEARCH.callRecursive(jsonobject, parentJsonString, parentJson.children);
                        }
                        else if (parentJson.children == null || parentJson.children == undefined || parentJson.children.length <= 0) {

                            //4. If children not found then add to product group
                            var childNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(arrParentId[i]);
                            var childJsonString = new Object();
                            childJsonString.id = parentJson.id;
                            childJsonString.text = parentJson.text;
                            childJsonString.icon = parentJson.icon;
                            childJsonString.state = parentJson.state;
                            childJsonString.Tag = childNode.original.Tag;
                            jsonobject.children.push(childJsonString);
                        }
                    }
                }
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainControl.js :: Method :: FPRODUCTCONTROL.PRODUCTSEARCH.createNestedNode :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            }
        },
        callRecursive: function (jsonobject, parent, children) {
            //
            try {
                var jsonString = null;
                for (let i = 0; i < children.length; i++) {
                    jsonString = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_json(children[i].id);
                    if (jsonString != null && jsonString != undefined) {

                        if (jsonString.children != null && jsonString.children != undefined && jsonString.children.length > 0) {

                            var parentNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(children[i].id);
                            var parentJsonString = new Object();
                            parentJsonString.id = jsonString.id;
                            parentJsonString.text = jsonString.text;
                            parentJsonString.icon = jsonString.icon;
                            parentJsonString.state = jsonString.state;
                            parentJsonString.Tag = parentNode.original.Tag;
                            parentJsonString.children = [];
                            jsonobject.children.push(parentJsonString);

                            FPRODUCTCONTROL.PRODUCTSEARCH.callRecursive(jsonobject, parentJsonString, jsonString.children);
                        }
                        else {
                            var childNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(children[i].id);

                            var childJsonString = new Object();
                            childJsonString.id = jsonString.id;
                            childJsonString.text = jsonString.text;
                            childJsonString.icon = jsonString.icon;
                            childJsonString.state = jsonString.state;
                            childJsonString.Tag = childNode.original.Tag;
                            parent.children.push(childJsonString);
                        }
                    }
                }
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainControl.js :: Method :: FPRODUCTCONTROL.PRODUCTSEARCH.callRecursive :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            }
        },
        loadedTreeEvent: function (e, data) {
            //
            try {
                var controlName = $(data.instance.element).attr('data-ControlName');
                if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 1)//Search On - Item
                    $("#" + controlName + " div#divProductSearchTree ul li a i.false").css("display", "none");
                else if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 2) //Search On - Group
                    $("#" + controlName + " #divProductSearchTree ul li a i.jstree-themeicon").attr('onclick', 'FPRODUCTCONTROL.PRODUCTSEARCH.getChildren(this)');

                //Set Previouslly Selected Product
                //
                if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 1) //Search On Item
                {
