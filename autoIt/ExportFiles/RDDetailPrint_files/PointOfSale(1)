                    if (footerField != null && footerField != undefined && footerField.length > 0) {
                        footerField = footerField[0];
                        let footerFieldData = null;
                        footerFieldData = Application.RetailTransFooter.DynamicFooterFields.filter((p) => p.FieldId == footerField.ID);
                        if (footerFieldData != null && footerFieldData != undefined && footerFieldData.length > 0) {
