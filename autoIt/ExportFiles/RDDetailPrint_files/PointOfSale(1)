            applicationException.ApplicationExceptionReturnType = (ApplicationExceptionReturnType.Success);
            applicationException.ApplicationExceptionMessageType = (ApplicationExceptionMessageType.None);
            applicationException.ApplicationExceptionReturnDataType = (ApplicationExceptionReturnDataType.BatchData);
            applicationException.ApplicationExceptionBatchData = batchData;
            //return rtnValues = [true, "", batchData];
        }
        catch (Ex) {
