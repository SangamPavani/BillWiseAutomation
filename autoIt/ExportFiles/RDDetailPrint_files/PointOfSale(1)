                        ApplicationNew.HeaderExtraFieldsData.push(
                            {
                                ID: ApplicationNew.HeaderExtraFieldsDefinition[i].FieldId,
                                Name: ApplicationNew.HeaderExtraFieldsDefinition[i].FieldName,
                                Tag: value,
                                ExtraInfo: text
                            });
                    }
                }
            }

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION") && ApplicationNew.POSVoucherHeaderExtraFieldsDefinition != null
                && ApplicationNew.POSVoucherHeaderExtraFieldsDefinition != undefined && ApplicationNew.POSVoucherHeaderExtraFieldsDefinition.length > 0) {
                ApplicationNew.POSHeaderExtraFieldData = [];
                for (let i = 0; i < ApplicationNew.POSVoucherHeaderExtraFieldsDefinition.length; i++) {
                    var value = HEADEREXTRAFIELDS.getValue(ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i].DataTypeName, ("POS" + ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i].FieldName), ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i].bMandatory, ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i]);
                    if (value != null && value != undefined) {
                        ApplicationNew.POSHeaderExtraFieldData.push(
                            {
                                ID: ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i].FieldId,
                                Name: ApplicationNew.POSVoucherHeaderExtraFieldsDefinition[i].FieldName,
                                Tag: value
                            });
                    }
                }
            }

            if (ApplicationNew.IsAllMandatoryHeaderExtraFieldsFilled == false) {
                toastr.info(msgMandatoryFieldsDataIsMissing, msgPOSInformation);
