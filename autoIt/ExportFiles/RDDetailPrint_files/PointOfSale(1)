                    let batchList = [];

                    if (_line.RetailSetsDetails != null && _line.RetailSetsDetails != undefined && _line.RetailSetsDetails.length > 0) {
                        for (let i = 0; i < _line.RetailSetsDetails.length; i++) {
                            //need to change in  validateBatchSetting controller method
                            batchValidationArgs.CurrentItem = _line.RetailSetsDetails[i];
                            batchValidationArgs.BodyPanelExtraFieldsList = ApplicationNew.BodyPanelExtraFieldsList;
                            batchValidationArgs.PresentTransactionMode = ApplicationNew.PresentTransactionMode;
                            batchValidationArgs.ListOfItems = ApplicationNew.ListOfItems;
                            batchValidationArgs.IsUpdateQuantity = ApplicationNew.IsUpdateQuantity;
