    updateRateCell: function (calculatingLinewiseFields) {
        try {
            var responseRateCellValue = [];
            responseRateCellValue[0] = false;
            responseRateCellValue[1] = null;//REQUIRED MESSAGE
            responseRateCellValue[2] = null;//MANAGERAPPROVAL
            responseRateCellValue[3] = false;//Stock Warn and allow condition

            let sEnteredCellValue = calculatingLinewiseFields.EnteredCellValue;
            let dPrevPrice = ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4;
            if (sEnteredCellValue == 0) {
                responseRateCellValue[0] = true;
                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = dPrevPrice;
                return responseRateCellValue;
            }
            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = FConvert.toDecimal(sEnteredCellValue, POSCommon.numberOfDecimal);
            let dCurrentCellEnteredValue = FConvert.toDecimal(sEnteredCellValue, POSCommon.numberOfDecimal);
            // Validating Average Purchase Rate & Price Book Rate
            let objApprovalRecord = null;
            if (POSCommon.requiredManagerApproval == true) {
                if (ApplicationNew.ManagerApproval == null || ApplicationNew.ManagerApproval == undefined || ApplicationNew.ManagerApproval.length <= 0)
                    ApplicationNew.ManagerApproval = [];

                objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == 1050);
            }
            if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord.length <= 0 || objApprovalRecord.ApprovalId <= 0) {
                if (POSCommon.averagePurchasePrice == true) {
                    // Validate With Average Purchase Price
                    let rtnAvgPrice = PRODUCTSELECTION.validateDiscountWithAveragePurchasePrice(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], 1050);
                    if (rtnAvgPrice != null && rtnAvgPrice != undefined && rtnAvgPrice.length > 0) {
                        if (ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].ProductType == 0 && rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined) {
                            if (FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = dPrevPrice;
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                CALCULATION.calculateFooter(ApplicationNew);
                                responseRateCellValue[0] = true;
                                responseRateCellValue[1] = rtnAvgPrice[1];
                                return responseRateCellValue;
                            }
                            else if (FConvert.toBoolean(rtnAvgPrice[0]) == true && rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined) {
                                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = dPrevPrice;
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                CALCULATION.calculateFooter(ApplicationNew);
                                responseRateCellValue[0] = true;
                                responseRateCellValue[2] = rtnAvgPrice[1];
                                return responseRateCellValue;
                            }
                        }
                    }
                }
            }


            // Validate With Price Book Rate
            let rtnPriceBookRate = [];
            rtnPriceBookRate = PRODUCTSELECTION.validateDiscountWithPriceBookRate(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], 1050);
            if (rtnPriceBookRate != null && rtnPriceBookRate != undefined && rtnPriceBookRate.length > 0) {
                if (rtnPriceBookRate[0] != null && rtnPriceBookRate[0] != undefined) {
                    if (FConvert.toBoolean(rtnPriceBookRate[0]) == false) {
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = dPrevPrice;
                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                        CALCULATION.calculateFooter(ApplicationNew);
                        responseRateCellValue[0] = true;
                        responseRateCellValue[1] = rtnPriceBookRate[1];
                        return responseRateCellValue;
                    }
                    else if (FConvert.toBoolean(rtnPriceBookRate[0]) == true) {
                        if (rtnPriceBookRate[1] != null && rtnPriceBookRate[1] != undefined && rtnPriceBookRate[1].length > 0) {
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1].DefaultValue4 = dPrevPrice;
                            CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                            CALCULATION.calculateFooter(ApplicationNew);
                            responseRateCellValue[0] = true;
                            responseRateCellValue[2] = rtnPriceBookRate[1];
                            return responseRateCellValue;
                        }
                    }
                }
            }

            // Validate With CutOff Price / Manager Approval
            let rtnCutOffPrice = PRODUCTSELECTION.validateDiscountWithCutOffPrice(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], 1005);
            if (rtnCutOffPrice != null && rtnCutOffPrice != undefined && rtnCutOffPrice.length > 0) {
                if (rtnCutOffPrice[0] != null && rtnCutOffPrice[0] != undefined) {
                    if (FConvert.toBoolean(rtnCutOffPrice[0]) == false) {
                        ApplicationNew.CurrentItem.DefaultValue4 = dPrevPrice;
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                        responseRateCellValue[0] = true;
                        responseRateCellValue[1] = rtnCutOffPrice[1];
                        return responseRateCellValue;
                    }
                    else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && (FConvert.toString(rtnCutOffPrice[1]) != null && FConvert.toString(rtnCutOffPrice[1]) != undefined && rtnCutOffPrice[1].length > 0)) {
                        ApplicationNew.CurrentItem.DefaultValue4 = dPrevPrice;
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                        responseRateCellValue[0] = true;
                        responseRateCellValue[2] = rtnCutOffPrice[1];
                        return responseRateCellValue;
                    }
                    else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && rtnCutOffPrice[1] == "") {
                        if (rtnCutOffPrice[2] != null && rtnCutOffPrice[2] != undefined && rtnCutOffPrice.length > 2) {
                            let mgrPreferencesCutOffPriceIndex = 0, dCutOffPriceForMgr = 0;
                            dCutOffPriceForMgr = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.abs(ApplicationNew.CurrentItem.DefaultValue3), mgrPreferencesCutOffPriceIndex);
                            ApplicationNew.CurrentItem.DefaultValue4 = dPrevPrice;
                            if ((Math.abs(ApplicationNew.CurrentItem.DefaultValue3) * dCutOffPriceForMgr) > (Math.abs(ApplicationNew.CurrentItem.DefaultValue3 * ApplicationNew.CurrentItem.DefaultValue4) - dCurrentCellEnteredValue)) {
                                ApplicationNew.CurrentItem.DefaultValue4 = dPrevPrice;
                                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                responseRateCellValue[0] = true;
                                responseRateCellValue[1] = "You are not allowed to give this discount.";
                                return responseRateCellValue;
                            }
                        }
                        PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(ApplicationNew.CurrentItem, ApplicationNew);
                    }
                }
            }
            CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
            CALCULATION.calculateFooter(ApplicationNew);
            responseRateCellValue[0] = true;
            return responseRateCellValue;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.updateRateCell :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    updateBatchCell: function (calculatingLinewiseFields) {
        try {
            ////debugger;
            var responseBatchCellValue = [];
            responseBatchCellValue[0] = false;
            responseBatchCellValue[1] = null;//REQUIRED MESSAGE
            responseBatchCellValue[2] = null;//MANAGERAPPROVAL
            responseBatchCellValue[3] = false;//Stock Warn and allow condition
            let sEnteredCellValue = calculatingLinewiseFields.EnteredCellValue;
            let applicationException = new Object();

            let _line = ApplicationNew.CurrentItem;
            if (PreferenceSetting.PrefInventoryTab.DonotCheckValidBatch == true && POSCommon.allowNegativeBatchQuantity == true) {
                if (_line.BatchData == null)
                    _line.BatchData = POSDATASTRUCTURE.getEmptyBatchData();

                _line.BatchData.BatchNo = sEnteredCellValue;
                _line.BatchData.Qty = FConvert.toDecimal(_line.DefaultValue3);
            }
            else {
                _line.BatchNo = sEnteredCellValue;
                applicationException.BatchResult = 0;
                applicationException.ApplicationExceptionBatchFlowType = (ApplicationExceptionBatchFlowType.UpdateBatch, Name = "UpdateBatch");//get("UpdateBatch");
                PRODUCTMETHODNEW.BATCHPOPUPMETHODS.getBatchDetails(_line, applicationException); //GetBatchDetails(_line, sEnteredCellValue, false, ref BatchResult, objApplication);

                if (applicationException.ApplicationExceptionReturnType == (ApplicationExceptionReturnType.Failed)) {
                    if (applicationException.ApplicationExceptionMessageType == (ApplicationExceptionMessageType.Exception) || applicationException.ApplicationExceptionMessageType == (ApplicationExceptionMessageType.Message)) {
                        responseBatchCellValue[0] = true;
                        responseBatchCellValue[1] = applicationException.ApplicationExceptionMessage;
                        responseBatchCellValue[2] = null;
                        return responseBatchCellValue;
                    }
                }
                let batchData = applicationException.ApplicationExceptionBatchData;

                if (applicationException.BatchResult == 1 && batchData != null && batchData != undefined && batchData.BatchId > 0) {
                    batchData.BatchNo = sEnteredCellValue;
                    _line.BatchData = batchData;
                    _line.BatchData.Qty = FConvert.toDecimal(_line.DefaultValue3);
                    if (_line.BatchError == 1)
                        _line.BatchError = 2;
                    PRODUCTMETHODNEW.BATCHPOPUPMETHODS.assignBatchValIfExists(_line);
                    if (PreferenceSetting.PrefInventoryTab.PickBatchRate == true ||
                        PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApplyRateBasedOnQty == true) {
                        let IsBaseUnit = true;
                        if (PreferenceSetting.PrefInventoryTab.InputUnitsInTran == true) {
                            if (_line.ProductUnit != 0 && _line.BaseUnit != _line.ProductUnit)
                                IsBaseUnit = false;
                        }
                        let dPrevRate = 0;
                        dPrevRate = FConvert.toDecimal(_line.DefaultValue4);
                        UPDATEPRODUCT.assignBatchRateAccordingToPreference(_line, batchData, IsBaseUnit);
                        if (POSCommon.manualPriceEntry == true && _line.DefaultValue4 == 0) {
                            if (UPDATEPRODUCT.checkForManualPriceEntry(_line) == false) {
                                _line.DefaultValue4 = dPrevRate;
                                responseBatchCellValue[0] = true;
                                responseBatchCellValue[1] = null;
                                responseBatchCellValue[2] = null;
                                return responseBatchCellValue;
                            }
                        }
                        CALCULATION.calculateLineWiseNet(_line, ApplicationNew);
                    }
                }
                else {
                    if (_line.BatchData == null && _line.BatchData == undefined)
                        _line.BatchData = POSDATASTRUCTURE.getEmptyBatchData();
                    _line.BatchNo = _line.BatchData.BatchNo = "";
                }


            }
            ApplicationNew.ListOfItems[_line.ItemSerialNo - 1] = _line;
            CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[_line.ItemSerialNo - 1], ApplicationNew);
            ApplicationNew.CurrentItem = _line;
            responseBatchCellValue[0] = true;
            return responseBatchCellValue;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.updateBatchCell :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
