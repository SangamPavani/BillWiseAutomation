        }
    },
    getAddToBillDiscountVoucher: function () {
        try {
            var iMandatoryCount = 0, iMandatoryEnteredCount = 0;
            //var objSchemes = BILLSETTLEMENTDATASTRUCTURE.getEmptySchemesFreeItemSelection();

            var discountVoucherBody = $('#tBodySchemeDiscountVoucher').attr('data-SchemesDiscountVoucherDetails');
            if (discountVoucherBody != null && discountVoucherBody != undefined && discountVoucherBody.trim().length > 0)
                var parsedDiscountVoucherMain = JSON.parse(discountVoucherBody);

            var tbodylength = $("#tBodySchemeDiscountVoucher > tr");
            if (tbodylength != null && tbodylength != undefined && tbodylength.length > 0) {
                for (let i = 0; i < tbodylength.length; i++) {
                    var chkProductClick = $(tbodylength[i]).find("input[type=checkbox]");
                    if (chkProductClick != null && chkProductClick != undefined && chkProductClick.length > 0) {
                        if ($(chkProductClick).is(":checked") == true)
                            parsedDiscountVoucherMain[i].IsSelected = true; //isSelected = true;
                        else
                            parsedDiscountVoucherMain[i].IsSelected = false; //isSelected = false;
                    }
                }
            }
            for (let j = 0; j < parsedDiscountVoucherMain.length; j++) {
                if (parsedDiscountVoucherMain[j].DVSeriesNoReq == true && parsedDiscountVoucherMain[j].IsSelected == true)
                    iMandatoryCount++;

                if (parsedDiscountVoucherMain[j].DVSeriesNoIsValid == true && parsedDiscountVoucherMain[j].IsSelected == true)
                    iMandatoryEnteredCount++;
            }
            POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.DISCOUNTVOUCHER.VARIABLES.DiscountVoucherPrompts = parsedDiscountVoucherMain;
            POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.DISCOUNTVOUCHER.VARIABLES.DiscountVoucherPromptsCopy = parsedDiscountVoucherMain;

            if (iMandatoryCount != iMandatoryEnteredCount) {
                POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.DISCOUNTVOUCHER.VARIABLES.AddToBill = true;
                var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                messageInfoPopup.Caption = "Point Of Sale Information";
                messageInfoPopup.Message = [];
