            if (ITEMRESTRICTIONSINBILL.VARIABLE.oldItemIs == null || ITEMRESTRICTIONSINBILL.VARIABLE.oldItemIs == undefined || ITEMRESTRICTIONSINBILL.VARIABLE.oldItemIs.trim() == "" || ITEMRESTRICTIONSINBILL.VARIABLE.oldItemIs.length == 0) {
