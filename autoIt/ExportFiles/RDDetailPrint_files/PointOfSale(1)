                            iPrintCount = 1;

                        let isMainScreen = false;
                        if (FConvert.toBoolean(IsOpenFromMainScreen) == true)
                            isMainScreen = false;
                        else if (FConvert.toBoolean(IsOpenFromMainScreen) == false)
                            isMainScreen = true;

                        if (PreferenceSetting.PrefMiscellaneousTab.POSPrintType == 0) //Direct Printing
                            PRINTTOPRINTER.directPrinting([data.printFileName, iPrintCount, isMainScreen]);
                        else if (PreferenceSetting.PrefMiscellaneousTab.POSPrintType == 1)  //Popup Printing
