    ToggleTree: function (element, e) {

        e.preventDefault();
        //if (element.className == "icon-expand icon-font7 pull-right")
        if ($(element).hasClass("icon-expand"))
            element.className = "icon-collepse icon-font7 pull-right";
        else
            element.className = "icon-expand icon-font7 pull-right";
        $(element.nextElementSibling).slideToggle("slow");
    },

    expandCollapseMenu: function (element) {

        if (element.nextElementSibling.nextElementSibling.style.display == "none") {
            $(element.nextElementSibling.nextElementSibling).slideDown("slow");
            $(element.parentNode).className = "treeview";
            $(element).removeClass("icon-expand")
            $(element).addClass("icon-collepse");
        }
        else {
            $(element.nextElementSibling.nextElementSibling).slideUp("slow");
            $(element.parentNode).className = "treeview";
            $(element).removeClass("icon-collepse")
            $(element).addClass("icon-expand");
        }
    },

    validateKeyPress: function (event, inputControl) {
        try {

            var charCode = (event.which) ? event.which : event.keyCode;
            if (charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (event.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }
            return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainPreference.js :: Method :: PREFERENCE.MISCELLANEOUSTAB.validateKeyPress :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            return;
        }
    },

