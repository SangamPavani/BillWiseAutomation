            }
            SCHEMESFREEITEMS.VARIABLE.iEditIndex = null;
            /* $("#divFreeItemAdd").html("Add");*/
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESFREEITEMS.BindCriteriaDetails :: Catch block :: Exception :: " + Ex.message);
        }
    },
