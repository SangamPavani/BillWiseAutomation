        getInputControlEvent: function (evt, inputControl, row) {
            try {
                //debugger;
                var inputControlText = $(inputControl).val();
                var inputControlClosestTableCell = $(inputControl).closest('td');
                var inputControlClosestTableRow = $(inputControl).closest('tr');
                var lasttr = $('#tBodyEMailDayEnd tr:last').attr("data-RowId");
                var charCode = null;
                if (evt == null)
                    charCode = 13;
                else if (evt != null && evt != undefined)
                    charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode == 8 || (charCode >= 48 && charCode <= 57))
                    return true;
                else if (charCode === 13 || charCode === 9) {
                    $(inputControl).find('input').remove();
                    $(inputControlClosestTableCell).html(inputControlText);
                    if (inputControlText != null && inputControlText != undefined && inputControlText.trim().length > 0) {
                        if (row == lasttr)
                            $("#tBodyEMailDayEnd").append("<tr class='pos-table-row' data-RowId='newrow'><td style='width:30px' class='pos-table-body-cell'><i class='fa fa-trash fa-lg' aria-hidden='true' onclick= PREFERENCE.OutletDayEndTab.getEmailDeleteClickEvent(this)></i></td><td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-left' onclick='PREFERENCE.OutletDayEndTab.setInputControlEvent(this)'></td></tr>");
                    }
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainPreference.js :: Method :: PREFERENCE.OutletDayEndTab.getInputControlEvent, Catch block : Error Message : " + Ex.message);
                return false;
            }
        },
