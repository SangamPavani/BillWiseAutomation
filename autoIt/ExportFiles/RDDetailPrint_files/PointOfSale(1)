                        for (let k = 0; k < ApplicationNew.RetailTransFooter.FooterFieldsList.length; k++) {
                            if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].IsDiscountField == true && ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldValue > 0)
                                return false;
                        }
                    }

                    // Body discount
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        for (let j = 0; j < VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList.length; j++) {
                            if (VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[j].IsDiscountField == true) //&& objBillSettlementPostingInfoWeb.BodyPanelExtraFieldsList[j].OutputCalculationId != 1
                            {
                                if (ApplicationNew.ListOfItems[i].DynamicLineFields[VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[j].ColumnIndex].FieldValue > 0) {
                                    amountNotToBeConsidered = FConvert.toDecimal(amountNotToBeConsidered, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(ApplicationNew.ListOfItems[i].DefaultValue15, POSCommon.numberOfDecimal, true);
                                    continue;
                                }
                            }
                        }

                        let line = new Object();
                        line.ID = ApplicationNew.ListOfItems[i].DefaultValue1;
                        line.Quantity = ApplicationNew.ListOfItems[i].DefaultValue3;
                        idQtyList.push(line);
                    }
                }
            }
            else {
                for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    let line = new Object();
                    line.ID = ApplicationNew.ListOfItems[i].DefaultValue1;
                    line.Quantity = ApplicationNew.ListOfItems[i].DefaultValue3;
                    line.Value = ApplicationNew.ListOfItems[i].DefaultValue15;
                    idQtyList.push(line);
                }
            }

            let memberRecord = null;// ApplicationNew.MemberData.PrimaryMemberRecord != null ? ApplicationNew.MemberData.PrimaryMemberRecord : ApplicationNew.MemberData;

            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID > 0) {
                if (ApplicationNew.MemberData.PrimaryMemberRecord == null || ApplicationNew.MemberData.PrimaryMemberRecord == undefined || ApplicationNew.MemberData.PrimaryMemberRecord.ID <= 0)
                    memberRecord = ApplicationNew.MemberData;
                else if (ApplicationNew.MemberData.PrimaryMemberRecord != null && ApplicationNew.MemberData.PrimaryMemberRecord != undefined && ApplicationNew.MemberData.PrimaryMemberRecord.ID > 0)
                    memberRecord = ApplicationNew.MemberData.PrimaryMemberRecord;
            }

            if (memberRecord == null || memberRecord == undefined || memberRecord.ID == 0 || memberRecord.PointsDefinitionExist == false)
                return true;

            let allowPaymentWisePoints = VOUCHERPOSTING.MEMBER.getAllowedMethodForMemberPointCalculation();
            let billAmount = 0;

            if (PreferenceSetting.PrefMiscellaneousTab.PointsProductWise == false || (PreferenceSetting.PrefMiscellaneousTab.PointsProductWise == true && PreferenceSetting.PrefMiscellaneousTab.PointsProductWiseType == false)) {
                if (allowPaymentWisePoints != null) {
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.Cash == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CashPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.CreditCard == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditCardPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.DebitCard == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.DebitCardPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.Cheque == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.ChequePaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.GiftVoucher == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.GVAmt_MemberPoints, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.DiscountVoucher == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.DiscountVoucherPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.CreditNote == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditNotePaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.PointsRedemption == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.PointsRedemptionPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.CreditSale == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSalePaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.EPayment == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.EPaymentPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) + (allowPaymentWisePoints.TopupPaid == true ? FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TopupPaid, POSCommon.numberOfDecimal, true) : 0);
                    billAmount = FConvert.toDecimal(billAmount, POSCommon.numberOfDecimal, true) - FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalChangeAmount, POSCommon.numberOfDecimal, true);
                }

                billAmount = billAmount - amountNotToBeConsidered;
                if (billAmount <= 0)
                    return true;
            }
            else if (idQtyList == null || idQtyList == undefined || idQtyList.length == 0) {
                if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID > 0) {
                    ApplicationNew.MemberData.PointsAccumulateOnBill = 0;
                    return true;
                }
            }

            let loadCalculatedMemberPointArgs = new Object();
            loadCalculatedMemberPointArgs.MemberRecord = ApplicationNew.MemberData;
            loadCalculatedMemberPointArgs.BillAmount = billAmount;
            loadCalculatedMemberPointArgs.ProductList = idQtyList;
            //debugger;
            let webResponse = VOUCHERPOSTING.SERVER.getCalculatedMemberPoint(loadCalculatedMemberPointArgs);
