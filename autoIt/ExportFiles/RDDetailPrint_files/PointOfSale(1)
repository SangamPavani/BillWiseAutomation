            if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0)
                _line = ApplicationNew.ListOfItems.filter(p => p.DefaultValue1 == objCustDefLeftPanelDisplay.ProductID
                    && p.ProductMake == 0 && p.ProductType == 0);
            if (isFromExternalModule == false) {
                if (objCustDefLeftPanelDisplay.ProductProperties != null && objCustDefLeftPanelDisplay.ProductProperties != undefined)
                    if (objCustDefLeftPanelDisplay.ProductProperties.QuantityTag <= 0 ||
                        (_line != null && _line != undefined && _line.length > 0 &&
                            (_line[0].LoadedQuantity <= 0 ? _line[0].DefaultValue3 >= FConvert.toDecimal(objCustDefLeftPanelDisplay.ProductProperties.QuantityTag) :
                                _line[0].DefaultValue3 - _line[0].LoadedQuantity >= FConvert.toDecimal(objCustDefLeftPanelDisplay.ProductProperties.QuantityTag)))) {
                        return PRODUCTSELECTION.doCheckForNegativeStockActivity();
                    }
            }
            else {
                let totalLineQty = 0;
                if (_line != null && _line != undefined && _line.length > 0) {

                    for (let i = 0; i < _line.length; i++) {
                        totalLineQty = totalLineQty + FConvert.toDecimal(_line[i].DefaultValue3, POSCommon.numberOfDecimal, true);
                    }
                    totalLineQty = totalLineQty + FConvert.toDecimal(objCustDefLeftPanelDisplay.ProductProperties.QuantityTag, POSCommon.numberOfDecimal, true);
                }
                else
                    totalLineQty = totalLineQty + FConvert.toDecimal(objCustDefLeftPanelDisplay.ProductProperties.QuantityTag, POSCommon.numberOfDecimal, true);

                if (totalLineQty > objCustDefLeftPanelDisplay.Stock)
                    return PRODUCTSELECTION.doCheckForNegativeStockActivity();
            }
        }
        return [true, "", ""];
