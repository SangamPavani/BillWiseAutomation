                    }
                    else {
                        _HomeDelivery.DeliverTimeInterval = 0;
                        _HomeDelivery.DeliverTimeIntervalName = "";
                    }
                }
                else {
                    var deliveryTime = FTIMECONTROL.getTime("tpPreOrderHomeDeliveryTime");
                }

                var deliveryBy = OPTIONCONTROL.getControlValue("optPreOrderDeliveryBy");
                var deliveryByName = OPTIONCONTROL.getControlText("optPreOrderDeliveryBy");
                if (deliveryBy != null && deliveryBy != undefined && deliveryBy.trim().length > 0 && FConvert.toInt(deliveryBy.trim()) > 0) {
                    _HomeDelivery.DeliveryBy = deliveryBy;
                    _HomeDelivery.DeliveryByName = deliveryByName;
                }
                else {
                    _HomeDelivery.DeliveryBy = 0;
                    _HomeDelivery.DeliveryByName = "";
                }

                _HomeDelivery.Remarks = remarks;
                _HomeDelivery.DeliveryOutletId = (FConvert.toInt(localPreOrderDetails.ProductionOutlet) <= 0 ? 0 : FConvert.toInt(localPreOrderDetails.ProductionOutlet));

                localPreOrderDetails.PreOrderHomeDelivery = _HomeDelivery;
