    openChangePricePopupAddToProduct: function (arrParameters, objCustDefLeftPanelDisplay) {
        try {
            let iChangePriceLogic = FConvert.toInt(arrParameters[0]);
            let lstTemp = arrParameters[1];
            let isNew = FConvert.toBoolean(arrParameters[2]);

            switch (iChangePriceLogic) {
                case 0:
                case "0":
                    //Open Change Price Popup While Adding Product
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                            return [false, "Not Allowed to add Item as Rate is Zero"];
                    }
                    if (POSCommon.manualPriceEntry == true) {
                        ApplicationNew.BatchRelatedList = [];

                        if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET")) {
                            let batchRelatedData = new Object();
                            PRODUCTMETHODNEW.CHANGEPRICEMETHODS.VARIABLES.currentIndex = -1;
                            batchRelatedData.CurrentItem = ApplicationNew.CurrentItem;
                            ApplicationNew.BatchRelatedList.push(batchRelatedData);

                            return [true, "OPENCHANGEPRICEPOPUP"];
                        }
                    }
                    break;
                case 1:
                case "1":
                    // Open Change Price Popup After Batch Selection
                    //////
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                            return [false, "Not Allowed to add Item as Rate is Zero"];
                    }

                    if (POSCommon.manualPriceEntry == true) {
                        ApplicationNew.BatchRelatedList = [];

                        if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET")) {
                            for (let i = 0; i < lstTemp.length; i++) {
                                if (lstTemp[i].DefaultValue4 == 0)
                                    ApplicationNew.BatchRelatedList.push({ CurrentItem: lstTemp[i], IsNew: isNew });
                            }
                        }
                        else
                            ApplicationNew.BatchRelatedList.push({ CurrentItem: ApplicationNew.CurrentItem, IsNew: isNew });

                        if (ApplicationNew.BatchRelatedList != null && ApplicationNew.BatchRelatedList != undefined && ApplicationNew.BatchRelatedList.length > 0) {
                            ApplicationNew.CurrentItem = null;
                            return [true, "OPENCHANGEPRICEPOPUP"];
                        }
                    }
                    break;
                case 2:
                case "2":
                    // Open Change Price Popup After RMA Selection
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                            return [false, "Not Allowed to add Item as Rate is Zero"];
                    }
                    if (POSCommon.manualPriceEntry == true) {
                        if (ApplicationNew.CurrentItem.PosProductMake == PosProductMake.get("SET")) {
                            ApplicationNew.BatchRelatedList = [];
                            let batchRelatedData = new Object();
                            batchRelatedData.CurrentItem = ApplicationNew.CurrentItem;
                            ApplicationNew.BatchRelatedList.push(batchRelatedData);
                        }
                        return [true, "OPENCHANGEPRICEPOPUP"];
                    }
                    break;
                case 3:
                case "3":
                    //Open Change Price Popup from updateOldProductToGrid
                    if (POSCommon.manualPriceEntry == true && lstTemp.DefaultValue4 == 0) {
                        ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                        ApplicationNew.BatchRelatedList = [];
                        ApplicationNew.BatchRelatedList.push({ CurrentItem: lstTemp, IsNew: false });
                        ApplicationNew.CurrentItem = null;
                        return [true, "OPENCHANGEPRICEPOPUP"];
                    }
                    break;
                case 4:
                case "4"://Open Change Price Popup while updating set to grid
                    ApplicationNew.CurrentItem = null;
                    ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                    ApplicationNew.BatchRelatedList = [];
                    ApplicationNew.BatchRelatedList.push({ CurrentItem: lstTemp, IsNew: true });
                    return [true, "OPENCHANGEPRICEPOPUP"];
                    break;
                case 5:
                case "5"://Open Change Price Popup while Adding set to grid
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                            return [false, "Not Allowed to add Item as Rate is Zero"];
                    }
                    if (POSCommon.manualPriceEntry == true) {
                        ApplicationNew.CurrentItem = null;
                        ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                        ApplicationNew.BatchRelatedList = [];
                        ApplicationNew.BatchRelatedList.push({ CurrentItem: lstTemp, IsNew: true });
                        return [true, "CHANGEPRICE"];
                    }
                    break;
                case 6:
                case "6"://Open Change Price Popup while Adding product to grid when apply rate is defined in seller price book
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                            return [false, "Not Allowed to add Item as Rate is Zero"];
                    }
                    if (POSCommon.manualPriceEntry == true) {
                        ApplicationNew.CurrentItem = null;
                        ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                        ApplicationNew.BatchRelatedList = [];
                        ApplicationNew.BatchRelatedList.push({ CurrentItem: lstTemp, IsNew: false });
                        return [true, "CHANGEPRICE"];
                    }
                    break;

            }
            return [true, ""];
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopupAddToProduct :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return [false, "Exception while opening Change Price popup"];
        }
    },
    afterChangePriceEntered: function (index = null) {
        try {
            let msgNotAllowedAsThereIsMaxItemRestrictionInTheBill = $("#NotAllowedAsThereIsMaxItemRestrictionInTheBill").val();
            let msgPOSInformation = $("input#msgPOSInformation").val();

            // Check Product Restriction
            if (index == -1) {
                rtnValue = PRODUCTSELECTION.UIMETHODS.callingCommonMethods(ApplicationNew.CurrentItem, true);
                if (rtnValue != null && rtnValue != undefined && rtnValue.length > 0) {
                    if (FConvert.toBoolean(rtnValue[0]) == false && rtnValue[1].trim().length >= 0) {
                        toastr.info(msgNotAllowedAsThereIsMaxItemRestrictionInTheBill, msgPOSInformation);
                        if (ApplicationNew.CurrentItem.DefaultValue3 == 0)
                            ApplicationNew.ListOfItems.splice(ApplicationNew.ListOfItems.length - 1, 1);
                        return;
                    }
                    //ApplicationNew.ListOfItems.splice(ApplicationNew.ListOfItems.length - 1, 1);
                }
            }
            if (ApplicationNew.BatchRelatedList != null && ApplicationNew.BatchRelatedList != undefined && ApplicationNew.BatchRelatedList.length > 0) {
                for (let i = 0; i < ApplicationNew.BatchRelatedList.length; i++) {
                    //Step 1 : Checking product With "Price + Batch No"
                    let existingItem = ApplicationNew.ListOfItems.filter((p) =>
                        p.DefaultValue1 == ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue1
                        && p.ProductMake == ApplicationNew.BatchRelatedList[i].CurrentItem.ProductMake
                        && p.PromoType != PromoTypes.get("FREEITEM")
                        && p.ProductType == ApplicationNew.ButtonExchangeMode
                        && p.ProductUnit == ApplicationNew.BatchRelatedList[i].CurrentItem.ProductUnit
                        && p.BatchNo == ApplicationNew.BatchRelatedList[i].CurrentItem.BatchNo
                        && p.DefaultValue4 == ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue4);

                    if (PreferenceSetting.PrefInventoryTab.AddProductToNewLine == true)
                        existingItem = null;

                    if (existingItem == null || existingItem == undefined || existingItem.length <= 0) {
                        // Adding Product 
                        if (ApplicationNew.BatchRelatedList[i].CurrentItem != null && ApplicationNew.BatchRelatedList[i].CurrentItem != undefined) {
                            if (ApplicationNew.BatchRelatedList[i].CurrentItem.ProductMake != PosProductMake.get("SET")) {
                                let objApprovalRecord = null;
                                if (POSCommon.requiredManagerApproval == true) {
                                    if (ApplicationNew.ManagerApproval == null || ApplicationNew.ManagerApproval == undefined || ApplicationNew.ManagerApproval.length <= 0)
                                        ApplicationNew.ManagerApproval = [];

                                    objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == 1066);
                                }
                                if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord.length <= 0 || objApprovalRecord.ApprovalId <= 0) {
                                    if (POSCommon.averagePurchasePrice == true) {
                                        // Validating Average Purchase Price
                                        let rtnAvgPrice = PRODUCTSELECTION.validateDiscountWithAveragePurchasePrice(ApplicationNew.BatchRelatedList[i].CurrentItem);
                                        if (ApplicationNew.BatchRelatedList[i].CurrentItem.ProductType == 0 && rtnAvgPrice != null && rtnAvgPrice != undefined
                                            && rtnAvgPrice.length > 0 && rtnAvgPrice[0] != null && FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                                            var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                                            messageInfoPopup.Caption = msgPOSInformation;
                                            messageInfoPopup.Message = [];
                                            messageInfoPopup.Message[0] = rtnAvgPrice[1];
                                            messageInfoPopup.ButtonType = "Ok";
                                            messageInfoPopup.OkMethod = "PRODUCTMETHODNEW.CHANGEPRICEMETHODS.closeItemRateLessThanPopup()";
                                            var arrValue = [];
                                            arrValue.push(messageInfoPopup);
                                            arrValue.push("divMessageInfo");
                                            COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                                            return;
                                        }
                                        else if (rtnAvgPrice != null && rtnAvgPrice != undefined && rtnAvgPrice.length > 0
                                            && rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined && FConvert.toBoolean(rtnAvgPrice[0]) == true
                                            && rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined) {
                                            VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1066;
                                            MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                                            CALCULATION.calculateLineWiseNet(ApplicationNew.BatchRelatedList[i].CurrentItem, ApplicationNew);
                                            return;
                                        }
                                        else
                                            CALCULATION.calculateLineWiseNet(ApplicationNew.BatchRelatedList[i].CurrentItem, ApplicationNew);
                                    }
                                }
                            }
                            // Adding Product Set
                            else
                                CALCULATION.calculateLineWiseNet(ApplicationNew.BatchRelatedList[i].CurrentItem, ApplicationNew);
                        }

                        if (ApplicationNew.ListOfItems == null)
                            ApplicationNew.ListOfItems = [];

                        if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != undefined) {
                            if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != undefined) {
                                if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.IsProductReplacementEnabled == true) {
                                    RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.AddedLineProduct = ApplicationNew.BatchRelatedList[i].CurrentItem;
                                    let lstCustLineWise = ApplicationNew.ListOfItems;
                                    PRODUCTSELECTION.dusMinutesAppIntegrationReplaceProduct(lstCustLineWise, RETAILMAIN.VARIABLE.ApplicationIntegrationArgs);
                                    ApplicationNew.ListOfItems = lstCustLineWise;
                                    ApplicationNew.BatchRelatedList[i].CurrentItem = RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.AddedLineProduct;
                                }
                            }
                        }

                        ApplicationNew.ListOfItems.push(ApplicationNew.BatchRelatedList[i].CurrentItem);
                        POSCOMMUNICATIONSERVICE.showPoleDisplayExtraParameter(ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue2, ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue3, ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue5);
                        CALCULATION.calculateLineWiseNet(ApplicationNew.BatchRelatedList[i].CurrentItem, ApplicationNew);
                        PRODUCTVIEW.updateLeftPanel();
                        PRODUCTMETHODNEW.SERVERMETHODS.afterAddedProduct();
                        return;
                    }
                    else // Updating Product OR Product Set
                    {
                        existingItem = existingItem[0];
                        if (ApplicationNew.BatchRelatedList[i].CurrentItem != null && ApplicationNew.BatchRelatedList[i].CurrentItem != undefined) {
                            if (ApplicationNew.BatchRelatedList[i].CurrentItem.ProductMake != PosProductMake.get("SET")) {
                                if (TABLECHANGEMETHODSNEW.VARIABLES.RATE.ApplyRate == ApplyRateType.None) {
                                    PRODUCTSELECTION.increaseProductQuantity(existingItem, PRODUCTSELECTION.CustDefLeftPanelDisplay);
                                    if (existingItem.DefaultValue4 == 0 && ApplicationNew.BatchRelatedList[i].CurrentItem.ManualPrice > 0)
                                        existingItem.DefaultValue4 = ApplicationNew.BatchRelatedList[i].CurrentItem.ManualPrice;
                                }

                                // Adding RMA Into Existing Item
                                if (ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos != null && ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos != undefined && ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos.length > 0) {

                                    if (existingItem.RMANos == null)
                                        existingItem.RMANos = [];

                                    for (let l = 0; l < ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos.length; l++) {
                                        let filterCondition = existingItem.RMANos.filter((p) => p == ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos[l]);
                                        if (filterCondition == null || filterCondition == undefined || filterCondition.length <= 0)
                                            existingItem.RMANos.push(ApplicationNew.BatchRelatedList[i].CurrentItem.RMANos[l]);
                                    }
                                    let RMANo = "";
                                    for (let j = 0; j < existingItem.RMANo.length; j++)
                                        RMANo = RMANo + existingItem.RMANo[j] + ",";

                                    if (RMANo != null && RMANo != undefined && RMANo.length > 0)
                                        RMANo = RMANo.substr(0, RMANo.length - 1);

                                    existingItem.RMANo = RMANo;
                                }
                                CALCULATION.calculateLineWiseNet(existingItem, ApplicationNew);
                                POSCOMMUNICATIONSERVICE.showPoleDisplayExtraParameter(existingItem.DefaultValue2, existingItem.DefaultValue3, existingItem.DefaultValue5);
                                PRODUCTVIEW.updateLeftPanel();
                                PRODUCTMETHODNEW.SERVERMETHODS.afterAddedProduct();
                                return;
                            }
                            else {
                                let lstProductSet = ApplicationNew.ListOfItems.filter((p) =>
                                    p.DefaultValue1 == ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue1
                                    && p.ProductMake == ApplicationNew.BatchRelatedList[i].CurrentItem.ProductMake
                                    && p.PromoType != PromoTypes.get("FRRITEM") && p.ProductType == ApplicationNew.ButtonExchangeMode
                                    && p.ProductUnit == ApplicationNew.BatchRelatedList[i].CurrentItem.ProductUnit
                                    && p.BatchNo == ApplicationNew.BatchRelatedList[i].CurrentItem.BatchNo
                                    && p.DefaultValue4 == ApplicationNew.BatchRelatedList[i].CurrentItem.DefaultValue4);

                                let isSameChild = true;
                                existingItem = null;

                                if (lstProductSet != null && lstProductSet != undefined && lstProductSet.length > 0) {
                                    for (let l = 0; l < lstProductSet.length; l++) {
                                        isSameChild = true;
                                        // Child Have Same Batch Number Or Not
                                        if (ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails != null && ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails != undefined && ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails.length > 0) {
                                            if (ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails.length == lstProductSet[l].RetailSetsDetails.length) {
                                                for (let k = 0; k < ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails.length; k++) {
                                                    if (lstProductSet[l].RetailSetsDetails[k].BatchNo != ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].BatchNo) {
                                                        isSameChild = false;
                                                        break;
                                                    }
                                                }
                                            }
                                            else
                                                continue;
                                        }
                                        if (isSameChild == true)
                                            existingItem = lstProductSet[l];
                                    }

                                    if (isSameChild == true && existingItem != null && existingItem != undefined) {
                                        // If Child Have Same Batch Number Then Adding The Quantity/Batch/RMA
                                        PRODUCTSELECTION.increaseProductQuantity(existingItem, ApplicationNew.CustDefLeftPanelDisplay);

                                        // Adding Batch Into ExistingItem
                                        for (let k = 0; k < ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails.length; k++) {
                                            if (existingItem.RetailSetsDetails[k].BatchNo == ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].BatchNo)
                                                existingItem.RetailSetsDetails[k].DefaultValue3 += ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].DefaultValue3;
                                        }

                                        // Adding RMA Into Existing Item
                                        for (let k = 0; k < ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails.length; k++) {
                                            if (ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].RMANos != null && ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].RMANos != undefined && ApplicationNew.BatchRelatedList[i].CurrentItem.RetailSetsDetails[k].RMANos.length > 0) {
