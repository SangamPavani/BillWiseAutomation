    validateTransactionAfterEmployeeDiscountAuthorization: function () {
        try {
            var netvalue = FConvert.toDecimal($("#lblNett").val(), POSCommon.numberOfDecimal);
            let msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts = $("#msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts").val();
            let msgPOSInformation = $("#msgPOSInformation").val();
            let msgYouAreNotAllowedToDoTransaction = $("#msgYouAreNotAllowedToDoTransaction").val();
            var BatchRMACustLineWise = [];
            sProductIds = "";
            var nonNormalProduct = ApplicationNew.ListOfItems.filter((p) => p.ProductType != 0);
            if (netvalue > 0 || (netvalue == 0 && nonNormalProduct != null && nonNormalProduct != undefined && nonNormalProduct.length <= 0)) {
                if (POSCommon.isRMASupport == true && ApplicationNew.PresentTransactionMode != TransactionModes.get("NEWPREORDER") && ApplicationNew.PresentTransactionMode != TransactionModes.get("EDITPREORDER")) {
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        if (ApplicationNew.ListOfItems[i].DonotMaintainStockbyRMA == false && ApplicationNew.ListOfItems[i].RetailSetsDetails != null && ApplicationNew.ListOfItems[i].RetailSetsDetails != undefined && ApplicationNew.ListOfItems[i].RetailSetsDetails.length > 0) {
                            for (let j = 0; j < ApplicationNew.ListOfItems[i].RetailSetsDetails.length; j++) {
                                if (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DonotMaintainStockbyRMA == false && (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos == null || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos == undefined || (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos != null && ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos != undefined && ApplicationNew.ListOfItems[i].RetailSetsDetails[j].RMANos.length != FConvert.toInt(ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue3)))) {
                                    BatchRMACustLineWise.push(ApplicationNew.ListOfItems[i].RetailSetsDetails[j]);
                                    sProductIds += ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue2 + ",";
                                }
                                sProductIds = sProductIds.substring(0, sProductIds.length - 1);
                                if (BatchRMACustLineWise.length > 0 && sProductIds != null && sProductIds != undefined && sProductIds.length > 0) {
                                    toastr.info(msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts + sProductIds, msgPOSInformation);
                                    return false;
                                }
                            }
                        }
                        else {
                            if (ApplicationNew.ListOfItems[i].DonotMaintainStockbyRMA == false && (ApplicationNew.ListOfItems[i].RMANos == null || (ApplicationNew.ListOfItems[i].RMANos != null && ApplicationNew.ListOfItems[i].RMANos.length != FConvert.toInt(ApplicationNew.ListOfItems[i].DefaultValue3))) && (ApplicationNew.ListOfItems[i].RetailSetsDetails == null || ApplicationNew.ListOfItems[i].RetailSetsDetails == undefined || ApplicationNew.ListOfItems[i].RetailSetsDetails.length <= 0)) {
                                BatchRMACustLineWise.push(ApplicationNew.ListOfItems[i]);
                                sProductIds += ApplicationNew.ListOfItems[i].DefaultValue2 + ",";
                            }
                            sProductIds = sProductIds.substring(0, sProductIds.length - 1);

                            if (BatchRMACustLineWise.length > 0 && sProductIds != null && sProductIds != undefined && sProductIds.length > 0) {
                                toastr.info(msgRMAnotavailablequantitynotmatchwithRMANosfortheseproducts + sProductIds, msgPOSInformation);
                                return false;
                            }
                        }
                    }
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        if (ApplicationNew.ListOfItems[i].ProductType == 1 || ApplicationNew.ListOfItems[i].ProductType == 2) {
                            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DoNotAlowBillAmtToBePostveForExchngeOrSpoilageTran == true) {
                                toastr.info(msgYouAreNotAllowedToDoTransaction, msgPOSInformation);
                                return false;
                            }
                        }
                    }
                }
            }

            var bResult = BILLSETTLEMENT.validateTransactionBeforeBillSettlement();
            if (bResult == false)
                return false;

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPOSSALES")) {
                bResult = BILLSETTLEMENT.validateEditedTransaction();
                if (bResult == null || bResult == undefined || bResult == false)
                    return false;
            }

            billSettlementDataFromClient = BILLSETTLEMENT.getBillSettlementObject();
            if (BILLSETTLEMENT.VARIABLE.BillSettlementObject == null || BILLSETTLEMENT.VARIABLE.BillSettlementObject == undefined)
                BILLSETTLEMENT.VARIABLE.BillSettlementObject = new Object();

            BILLSETTLEMENT.VARIABLE.BillSettlementObject.BillSettlementClient = billSettlementDataFromClient;

            var rtnBillSettlementValue = BILLSETTLEMENT.executeBillSettlementFlow();
            if (rtnBillSettlementValue == null || rtnBillSettlementValue == undefined || rtnBillSettlementValue == false)
                return false;

            return true;
        }
        catch (Ex) {
