                        linelist.splice(i, 1);
                        i--;
                        iNonComplimentaryItemIndex--;
                    }

                    ApplicationNew.ListOfItems = [];
                    for (let i = 0; i < linelist.length; i++) {
                        linelist[i].ItemSerialNo = i + 1;
                        ApplicationNew.ListOfItems.push(linelist[i]);
                    }
                }
            }
            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
