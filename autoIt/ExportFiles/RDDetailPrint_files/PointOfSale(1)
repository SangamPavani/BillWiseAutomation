    onKeyDown: function (event, table) {
        //////debugger;
        try {
            let iRow = $(table).attr("data-Row");
            let iColumn = $(table).attr("data-Column");

            if (event.keyCode != eKeyCode.CR && event.keyCode != eKeyCode.Tab)
                return true;
            else if (event.keyCode == eKeyCode.CR || event.keyCode == eKeyCode.Tab) {
                SCHEMESMAPPING.onLeaveTableCell(table, iRow, iColumn);
                let diamention = [];
                if (event.shiftKey == true)
                    diamention = SCHEMESMAPPING.setPreviousColumn(table, iRow, iColumn);
                else
                    diamention = SCHEMESMAPPING.setNextColumn(table, iRow, iColumn);

                //////debugger;
                iRow = diamention[0];
                iColumn = diamention[1];
                SCHEMESMAPPING.onEnterTableCell(table, iRow, iColumn);
            }

            return true;
        }
        catch (err) {
            alert("Exception: {FGRIDCONTROL.PRIVATE.onKeyDown} " + err.message);
        }
    },
