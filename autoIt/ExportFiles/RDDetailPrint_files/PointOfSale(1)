                footerDataField[0].FieldInput = loadedFooterDataField[0].FieldInput = FConvert.toDecimal(_LoadedTrans.Footer[k].Input, POSCommon.NumberOfDecimals, true);
            }
        }
        return ApplicationNew.RetailTransFooter;
