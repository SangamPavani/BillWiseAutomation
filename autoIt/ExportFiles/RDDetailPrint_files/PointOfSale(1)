        IsValidationFree_Save: function () {
            try {
                let enterSchemeName = $("#msgSchema").val();
                let toDateCannotBLessThanFromDate = $("#msgToDateCannotLessThanFromDate").val();
                let duplicateSchemeName = $("#msgDuplicateSchemeName").val();
                let selectOutlet = $("#txtPlzSelOutlets").val();
                let selectDays = $("#msgPlsseledays").val();
                let pleaseIncludeAtleastOneItemAsMandatory = $("#msgPlsIncludeAtleastOneItemAsMandatoryInCriteria").val();
                let pleaseAddAtleastOneItemUnderScheme = $("#msgPleaseAddAtleastOnePaymentTypeUnderScheme").val();
                if (optPaymentSchemeName.value == null || optPaymentSchemeName.value == "" || optPaymentSchemeName.value == undefined) {
                    toastr.error(enterSchemeName);
                    $("input#optPaymentSchemeName").focus();
                    return false;
                }

                var dtpFromDate = DATEPICKER.getDate(dtpFromDatePymnt);
                var dtpToDate = DATEPICKER.getDate(dtpToDatePymnt);

                if (dtpToDate < dtpFromDate) {
                    toastr.error(toDateCannotBLessThanFromDate);
                    return false;
                }
                var selectedItemId = FConvert.toInt(OPTIONCONTROL.getControlValue(optPaymentSchemeName));

                if (selectedItemId == 0) {

                    var SchemesDiscountDef = new Object();
                    SchemesDiscountDef.Name = optPaymentSchemeName.value;
                    SchemesDiscountDef.DiscTypeID = 4;

                    var result = SCHEMESCOMMONMETHODS.checkForSchemeNameDuplicate(SchemesDiscountDef)
                    if (result == true) {
                        toastr.error(duplicateSchemeName);
                        OPTIONCONTROL.clear("optPaymentSchemeName")
                        $("input#optPaymentSchemeName").focus();
                        return false;
                    }
                }

                if ($("#tbodyPaymentDiscount tr").length <= 0) {
                    toastr.error(pleaseAddAtleastOneItemUnderScheme);
                    return false;
                }

                //If outlets are not selected display a message to select else load into property which will decrease one loop at the time of retriving outlet ids for saving.                
                if (SCHEMESOUTLETS.VARIABLE.OutletId == null) {
                    toastr.error(selectOutlet);
                    return false;
                }
                if (SCHEMESDISCOUNT.PAYMENTDISCOUNT.PromptToSelectSchemeType() == false)
                    return false;

                SCHEMESDISCOUNT.PAYMENTDISCOUNT.VARIABLE.lstPaymentWeekDays = LISTCHECKBOXCONTROL.getControlData("ddlWeekdaysPymnt");
                if (SCHEMESDISCOUNT.PAYMENTDISCOUNT.VARIABLE.lstPaymentWeekDays.length == 0) {
                    toastr.error(selectDays);
                    $("ddlWeekdaysPymnt").focus();
                    return false;
                }

                if ($("#ddlSchemeTypePymnt").val() == 2) {
                    if (SCHEMESDISCOUNT.PAYMENTDISCOUNT.VARIABLE.PaymentSchemeInfo != null && SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.PaymentSchemeInfo != undefined && SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.PaymentSchemeInfo.length > 0) {
                        for (let i = 0; i < SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.PaymentSchemeInfo.length; i++) {
