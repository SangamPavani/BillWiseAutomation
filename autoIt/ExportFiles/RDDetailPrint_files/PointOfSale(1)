    adjustChangeAmount: function () {
        try {
            var ChangeAmount = FConvert.toDecimal($("#lblBillChange").text());
            var msgPleaseDeleteCashDetailsAndAdjustTheChange = $("#msgPleaseDeleteCashDetailsAndAdjustTheChange").val();
            if (BillSettlement.SelectedCurrency == null || BillSettlement.SelectedCurrency == undefined || BillSettlement.SelectedCurrency.CurrencyId <= 0)
                BillSettlement.SelectedCurrency = POSCommon.localCurrency;

            if (ChangeAmount >= 0 && BillSettlement.BillSettlementPaymentDetails.CashPaidDet != null
                && BillSettlement.BillSettlementPaymentDetails.CashPaidDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length > 0) {
                var CashChangeAdjusted = null;
                if (ChangeAmount > 0) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length; i++) {
                        if (BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].SelectedCurrencyId == POSCommon.localCurrency.CurrencyId) {
                            CashChangeAdjusted = BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i];
                            break;
                        }
                    }
                }
                if (CashChangeAdjusted == null || CashChangeAdjusted == undefined) {
                    if (ChangeAmount > 0) {
                        for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length; i++) {
                            if ((BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].PaidCurrency - BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].ActualAmountToPay) >= (ChangeAmount / BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].LocalCurExchRate)) {
                                CashChangeAdjusted = BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i];
                                break;
                            }
                        }
                    }
                    else {
                        for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length; i++) {
                            if ((BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].PaidCurrency != BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].ActualAmountToPay)) {
                                CashChangeAdjusted = BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i];
                                break;
                            }
                        }
                    }
                }
                if (CashChangeAdjusted != null && CashChangeAdjusted != undefined && CashChangeAdjusted.PaidCurrency > 0) {
                    CashChangeAdjusted.ActualAmountToPay = FConvert.toDecimal(CashChangeAdjusted.PaidCurrency - (ChangeAmount / CashChangeAdjusted.LocalCurExchRate), BillSettlement.SelectedCurrency.NoOfDecimals);
                    return true;
                }
                else {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length; i++) {
                        if (BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].PaidCurrency >= (ChangeAmount / BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].LocalCurExchRate)) {
                            CashChangeAdjusted = BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i];
                            break;
                        }
                    }
                    if (CashChangeAdjusted != null && CashChangeAdjusted != undefined && CashChangeAdjusted.PaidCurrency > 0) {
                        CashChangeAdjusted.ActualAmountToPay = FConvert.toDecimal(CashChangeAdjusted.PaidCurrency - (ChangeAmount / CashChangeAdjusted.LocalCurExchRate), BillSettlement.SelectedCurrency.NoOfDecimals);
                        return true;
                    }
                    else {
                        toastr.error(msgPleaseDeleteCashDetailsAndAdjustTheChange);
                        //MessageBox.Show("Please delete cash details and adjust the Change", Properties.Resources.txtCaptionError, MessageBoxButton.OK, MessageBoxImage.Error);
                        return false;
                    }
                }
            }
            else
                return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.adjustChangeAmount, Catch block : Error Message : " + Ex.message);
            return false;
        }
