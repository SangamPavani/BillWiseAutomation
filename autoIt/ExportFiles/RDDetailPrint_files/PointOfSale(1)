            let KFCBodyExtraFieldDtls = bodyExtraFieldDtls.filter((p) => p.FieldBehaviour == FieldBehaviour.get("KFC"));
            if (KFCBodyExtraFieldDtls == null || KFCBodyExtraFieldDtls == undefined || KFCBodyExtraFieldDtls.length <= 0)
                return;

            KFCBodyExtraFieldDtls = KFCBodyExtraFieldDtls[0];
            let GSTBodyExtraFieldDtls = bodyExtraFieldDtls.filter((p) => p.FieldBehaviour == FieldBehaviour.get("GST"));
            if (GSTBodyExtraFieldDtls != null && GSTBodyExtraFieldDtls != undefined && GSTBodyExtraFieldDtls.length > 0)
                GSTBodyExtraFieldDtls = GSTBodyExtraFieldDtls[0];

            if (retailBodyField.FieldBehaviour == FieldBehaviour.get("GST") || retailBodyField.FieldBehaviour == FieldBehaviour.get("CGST")
                || retailBodyField.FieldBehaviour == FieldBehaviour.get("SGST") || retailBodyField.FieldBehaviour == FieldBehaviour.get("KFC")) {
                if (retailBodyField.FieldBehaviour == FieldBehaviour.get("GST"))
                    dKFC += cProduct.DynamicLineFields[KFCBodyExtraFieldDtls.ColumnIndex].FieldInput;
                else if (retailBodyField.FieldBehaviour == FieldBehaviour.get("KFC")) {
                    if (GSTBodyExtraFieldDtls != null && GSTBodyExtraFieldDtls != undefined)
                        dKFC += cProduct.DynamicLineFields[GSTBodyExtraFieldDtls.ColumnIndex].FieldInput;
                }
                else
                    dKFC += cProduct.DynamicLineFields[KFCBodyExtraFieldDtls.ColumnIndex].FieldInput / 2;
            }
            return dKFC;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainCalculation.js :: Method :: CALCULATION.getKeralaFloodCessValue :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
