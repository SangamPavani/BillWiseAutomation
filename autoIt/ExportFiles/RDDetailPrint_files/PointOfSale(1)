    isNumberKeyWithDecimal: function (element, evt) {
        try {

            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = evt.which ? evt.which : evt.keyCode;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(element).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }
            if (evt.keyCode == 13 || evt.keyCode == 9) {

                return true;
            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
