                            else
                                dAmt = (dNetAmt * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        }
                        else {
                            ///Percentage on Net
                            if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                                dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(_net), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
                            //  dAmt = CustCommon.ConvertPercentageToValue(objSalesReturnWeb.DynamicFooterFields[k].FieldInput, _net, objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true);
                            else
                                dAmt = (_net * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        }
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 4) {
                        ///Percentage on Line Net
                        if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                            dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(subtotal), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
