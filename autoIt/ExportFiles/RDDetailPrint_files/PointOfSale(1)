COMMONMETHODS.TABLERESIZE =
{
    onMouseDown: function (eleTh, sGridId, evt) {
        var sId = "";
        try {
            sId = COMMONMETHODS.TABLERESIZE.getCurrentColumnVariableName(sGridId);
            window[sId] = eleTh;

            sId = COMMONMETHODS.TABLERESIZE.getStartOffsetVariableName(sGridId);
            window[sId] = evt.clientX;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.onMouseDown :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    onMouseMove: function (sGridId, evt) {
        var sId = "";
        var arrWidth = null;
        var iOldWidth = 0;
        var iNewWidth = 0;
        var iResizeColumn = 0;
        let eleTh = null;
        try {
            sId = COMMONMETHODS.TABLERESIZE.getCurrentColumnVariableName(sGridId);
            eleTh = window[sId];
            if (FCommon.UI.isValidObject(eleTh) == true) {
                FCommon.UI.stopKeyProcess(evt);

                iResizeColumn = COMMONMETHODS.TABLERESIZE.getElementPosition(eleTh.parentElement) - 1; //Ordinal : You have to create.
                arrWidth = eleTh.parentElement.style.minWidth.split("px");
                iOldWidth = FConvert.toInt(arrWidth[0]);

                sId = COMMONMETHODS.TABLERESIZE.getStartOffsetVariableName(sGridId);
                iNewWidth = iOldWidth + (evt.clientX - FConvert.toInt(window[sId]));

                if (iNewWidth <= 30)
                    return;

                eleTh.parentElement.style.width = iNewWidth + "px";
                eleTh.parentElement.style.minWidth = iNewWidth + "px";
                eleTh.parentElement.style.maxWidth = iNewWidth + "px"; //eleTh.style.minWidth;
                window[sId] = evt.clientX;

                COMMONMETHODS.TABLERESIZE.changeColumnWidth(sGridId, iResizeColumn);
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.onMouseMove :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    changeColumnWidth: function (sGridId, iColumn) {
        try {
            let tableHeader = $("#" + sGridId).find('thead > tr > th');
            let eleColumn = tableHeader[iColumn];
            let iMinWidth = $(eleColumn).css("min-width");

            $(eleColumn).css("width", iMinWidth);
            $(eleColumn).css("min-width", iMinWidth);
            $(eleColumn).css("max-width", iMinWidth);

            let tableBodyRow = $("#" + sGridId).find('tbody > tr');
            for (let i = 0; i < tableBodyRow.length; i++) {
                let col = $(tableBodyRow[i]).find("td:eq(" + iColumn + ")")
                $(col).css("width", iMinWidth);
                $(col).css("min-width", iMinWidth);
                $(col).css("max-width", eleColumn.style.minWidth);
            }

            let tableFootRow = $("#" + sGridId).find('tfoot > tr');
            if (tableFootRow != null && tableFootRow != undefined && tableFootRow.length > 0) {
                for (let i = 0; i < tableFootRow.length; i++) {
                    let col = $(tableFootRow[i]).find("td:eq(" + iColumn + ")")
                    $(col).css("width", iMinWidth);
                    $(col).css("min-width", iMinWidth);
                    $(col).css("max-width", eleColumn.style.minWidth);
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.changeColumnWidth :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    onMouseUp: function (sGridId, evt) {
        let sId = "";
        try {
            sId = COMMONMETHODS.TABLERESIZE.getCurrentColumnVariableName(sGridId);
            window[sId] = null;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.onMouseUp :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    getCurrentColumnVariableName: function (sGridId) {
        let sId = sGridId + "_thElm";
        return (sId);
    },
    getStartOffsetVariableName: function (sGridId) {
        let sId = sGridId + "_startOffset";
        return (sId);
    },
    getTotalColumns: function (gridElement) {
        var eleHead = null;
        var iValue = 0;
        try {
            eleHead = FGRIDCONTROL.PRIVATE.getHeadElement(gridElement);
            if (FCommon.UI.isValidObject(eleHead) == false)
                return (0);

            iValue = eleHead.children[0].children.length - 1;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.getTotalColumns :: Catch Block :: Exception :: " + Ex.message);
        }

        return (iValue);
    },
    getElementPosition: function (element) {
        var iIndex = 0;
        try {
            if (FCommon.UI.isValidObject(element) == false)
                return (0);

            iIndex = 0;
            while (element) {
                iIndex++;
                element = element.previousElementSibling;
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainCommon.js :: JavaScript Function :: COMMONMETHODS.TABLERESIZE.getElementPosition :: Catch Block :: Exception :: " + Ex.message);
        }

        return (iIndex);
    },
};

