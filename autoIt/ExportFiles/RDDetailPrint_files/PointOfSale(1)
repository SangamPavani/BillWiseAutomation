    openTabs: function (evt, tabsName, buttonName) {
        //debugger;
        try {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                document.getElementById(tablinks[i].id).style.backgroundColor = "#707070";
                document.getElementById(tablinks[i].id).style.color = "#FFFFFF";
            }
            document.getElementById(tabsName).style.display = "block";
            document.getElementById(tabsName).className += " active";
