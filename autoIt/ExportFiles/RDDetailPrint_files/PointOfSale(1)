            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + ", File: retailMainCustomization.js, Method: RETAILMAINBODYPANELCUSTOMIZATION.getBodyPanelCustomizationLineWiseAddClickEvent, Catch block : Error Message : " + ex.message);
