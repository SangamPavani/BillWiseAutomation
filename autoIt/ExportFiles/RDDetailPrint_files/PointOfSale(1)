                        let dExchangeRate = (POSCommon.isCompanyCurrencyDifferFromLocalCurrency == false ? 1 : POSCommon.localCurrency.CompDefCurExceRate);
                        let arrCreditNotesExchangeRefundCreditNoteHeader = [], arrCreditNotesExchangeRefundCreditNoteBody = [];
