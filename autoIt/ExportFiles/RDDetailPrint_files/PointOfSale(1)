                if (multiplyValue <= 0)
                    multiplyValue = 1;

                let maxQtyToConsider = FConvert.toDecimal(SDD.MaxQtyI, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(multiplyValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
