                        RefundSettlement.EPaymentDetails = epayment;
                    else
                        RefundSettlement.EPaymentDetails = null;
                }
                else {
                    RefundSettlement.CreditCardPaymentDetails = null;
                    RefundSettlement.DebitCardPaymentDetails = null;
                    RefundSettlement.EPaymentDetails = null;
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File :: retailMainPreOrder.js :: Method :: PREORDERSEARCH.setRefundSettlementObject :: Catch block :: Exception :: " + Ex.message);
            return false;
        }
    },
