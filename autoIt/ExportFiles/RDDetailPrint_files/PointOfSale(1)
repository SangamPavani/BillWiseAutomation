    disableButtonsAccordingToPreference: function () {
        try {
            ////debugger;
            var msgSelectPaymentTypesInPreferences = $("#msgSelectPaymentTypesInPreferences").val();
            var msgOutletRefundPolicy = $("#msgOutletRefundPolicy").val();
            var msgDisabledAllThePaymentTypesPreferences = $("#msgDisabledAllThePaymentTypesPreferences").val();
            var msgOutletRefundPolicyNotAllowedPaymentMethods = $("#msgOutletRefundPolicyNotAllowedPaymentMethods").val();
            var allowdPaymntMethd = null, differenceInDay = null;
            ////debugger;
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DoNotReturnVoucherANDPoint == true) {
                if (ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined) {
                    let displayDoNotReturnVoucherANDPoint = "block";

                    if (GlobalPref.Version == eVersion.Version10)
                        displayDoNotReturnVoucherANDPoint = "flex";

                    if (ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined) {
                        if (ApplicationNew.SalesReturn.SalesReturnWeb.ReturnGiftVoucherPaid > 0) {
                            $("#divRefundSettlementModalBodySecondRightColumnSecondRow").css("display", displayDoNotReturnVoucherANDPoint);
                            $("#divGVBillReturn").css("display", displayDoNotReturnVoucherANDPoint);
                        }
                        if (ApplicationNew.SalesReturn.SalesReturnWeb.ReturnDiscountVoucherPaid > 0) {
                            $("#divRefundSettlementModalBodySecondRightColumnSecondRow").css("display", displayDoNotReturnVoucherANDPoint);
                            $("#divDVBillReturn").css("display", displayDoNotReturnVoucherANDPoint);
                        }
                        if (ApplicationNew.SalesReturn.SalesReturnWeb.ReturnPointRedemptionPaid > 0) {
                            $("#divRefundSettlementModalBodySecondRightColumnSecondRow").css("display", displayDoNotReturnVoucherANDPoint);
                            $("#divPVBillReturn").css("display", displayDoNotReturnVoucherANDPoint);
                        }
                    }
                }
            }
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab != undefined) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList != undefined &&
                    PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList.length > 0) {
                    if (ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined) {
                        if (ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined) {
                            differenceInDay = DATE.prototype.today(POSCommon.CalType) - ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction.Header.CreatedDate;
                            differenceInDay = differenceInDay <= 0 ? 1 : differenceInDay;
                        }
                    }

                    ////////debugger;
                    for (let iDayCount = 0; iDayCount < PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList.length; iDayCount++) {
                        if (differenceInDay >= PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList[iDayCount].FromDays
                            && differenceInDay <= PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList[iDayCount].ToDays) {
                            allowdPaymntMethd = PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList[iDayCount].AllowedPaymentTypeId;
                            break;
                        }
                    }
                }
                if (ApplicationNew != null && ApplicationNew != undefined && ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined &&
                    ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined) {
                    if ((ApplicationNew.SalesReturn.SalesReturnWeb.SelectedReturnType) == 1)//Deliverytype Selected value
                    {
                        let AlwdWithInDys = PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedWithInDays;
                        let AllowedCriteriaList = PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList;

                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList != undefined &&
                            PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList.length > 0) {
                            if (ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined) {
                                if (ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined) {
                                    differenceInDay = DATE.prototype.today(POSCommon.CalType) - ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction.Header.CreatedDate;
                                    differenceInDay = differenceInDay <= 0 ? 1 : differenceInDay;
                                }
                            }

                            ////////debugger;
                            for (let iDayCount = 0; iDayCount < PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList.length; iDayCount++) {
                                if (differenceInDay >= PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList[iDayCount].FromDays
                                    && differenceInDay <= PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList[iDayCount].ToDays) {
                                    allowdPaymntMethd = PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList[iDayCount].AllowedPaymentTypeId;
                                    break;
                                }
                            }
                        }
                    }
                }
            }

            //333-Cash
            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(333)) {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCash").css("display", "block");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divCash").css("display", "block");
                $("#divBill").show();
            }
            else {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCash").css("display", "none");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divCash").css("display", "none");
                $("#divBill").hide();
            }
            //336-Gift Voucher
            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(336)) {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementGiftVoucher").css("display", "block");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divGiftVoucher").css("display", "block");
                $("#divBill1").show();
            }
            else {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementGiftVoucher").css("display", "none");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divGiftVoucher").css("display", "none");
                $("#divBill1").hide();
            }
            //337-Credit note
            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(337)) {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditNote").css("display", "block");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditNote").css("display", "block");
                $("#divBill2").show();
            }
            else {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditNote").css("display", "none");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditNote").css("display", "none");
                $("#divBill2").hide();
            }
            //334-Credit card
            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(334) == false) {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditCard").css("display", "none");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditCard").css("display", "none");
                $("#divBill").hide();
            }
            //335-Debit card
            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(335) == false) {
                $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementDebitCard").css("display", "none");
                $("#divRefundSettlementModalBodySecondLeftColumn > #divDebitCard").css("display", "none");
                $("#divBill").hide();
            }

            if (COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(333) == false && COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(336) == false &&
                COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(337) == false && COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(334) == false &&
                COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(335) == false)
                return false;

            //////debugger;
            if (allowdPaymntMethd != null && allowdPaymntMethd != undefined && allowdPaymntMethd.trim().length > 0) {
                allowdPaymntMethd = allowdPaymntMethd.replace(" ", "");
                if (allowdPaymntMethd.includes("1") == true && $("#btnRefundSettlementCash").is(":visible") == true) {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCash").css("display", "block");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCash").css("display", "block");
                    $("#divBill").show();
                }
                else {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCash").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCash").css("display", "none");
                    $("#divBill").hide();
                }
                if (allowdPaymntMethd.includes("5") == true && $("#btnRefundSettlementGiftVoucher").is(":visible") == true) {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementGiftVoucher").css("display", "block");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divGiftVoucher").css("display", "block");
                    $("#divBill1").show();
                }
                else {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementGiftVoucher").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divGiftVoucher").css("display", "none");
                    $("#divBill1").hide();
                }
                if (allowdPaymntMethd.includes("6") == true && $("#btnRefundSettlementCreditNote").is(":visible") == true) {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditNote").css("display", "block");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditNote").css("display", "block");
                    $("#divBill2").show();
                }
                else {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditNote").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditNote").css("display", "none");
                    $("#divBill2").hide();
                }

                if (($("#btnRefundSettlementCash").is(":visible") == true) || ($("#btnRefundSettlementGiftVoucher").is(":visible") == true) ||
                    ($("#btnRefundSettlementCreditNote").is(":visible") == true) || (RefundSettlement.DebitCardPaymentDetails == null &&
                        RefundSettlement.DebitCardPaymentDetails == undefined) || (RefundSettlement.CreditCardPaymentDetails == null &&
                            RefundSettlement.CreditCardPaymentDetails == undefined))
                    return true;

                toastr.error(msgSelectPaymentTypesInPreferences + " : " + msgOutletRefundPolicy);
                RETAILMAIN.closePopup('#divRefundSettlementModal');
                return false;
            }
            else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.NotAllowedPaymentMethod != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab.NotAllowedPaymentMethod != undefined) {
                let notAllowdPaymntMethd = PreferenceSetting.PrefOutletTab.OutletGeneralTab.NotAllowedPaymentMethod.split(",");

                if (notAllowdPaymntMethd.includes("1") == true) //Cash
                {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCash").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCash").css("display", "none");
                    $("#divBill").hide();
                }

                if (notAllowdPaymntMethd.includes("5") == true) // Gift Voucher
                {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementGiftVoucher").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divGiftVoucher").css("display", "none");
                    $("#divBill1").hide();
                }

                if (notAllowdPaymntMethd.includes("6") == true) //Credit Note
                {
                    $("#divRefundSettlementPaymentTabInner > #btnRefundSettlementCreditNote").css("display", "none");
                    $("#divRefundSettlementModalBodySecondLeftColumn > #divCreditNote").css("display", "none");
                    $("#divBill2").hide();
                }

                var refundSettlementCashVisible = $("#btnRefundSettlementCash").is(":visible");
                var refundSettlementGiftVoucherVisible = $("#btnRefundSettlementGiftVoucher").is(":visible");
                var refundSettlementCreditNoteVisible = $("#btnRefundSettlementCreditNote").is(":visible");

                if (refundSettlementCashVisible == false && refundSettlementGiftVoucherVisible == false && refundSettlementCreditNoteVisible == false
                    && RefundSettlement.DebitCardPaymentDetails == null && RefundSettlement.DebitCardPaymentDetails == undefined
                    && RefundSettlement.CreditCardPaymentDetails == null && RefundSettlement.CreditCardPaymentDetails == undefined) {
                    toastr.error(msgDisabledAllThePaymentTypesPreferences + " : " + msgOutletRefundPolicyNotAllowedPaymentMethods);
                    RETAILMAIN.closePopup('#divRefundSettlementModal');
                    return;
                }
            }

            return true;
