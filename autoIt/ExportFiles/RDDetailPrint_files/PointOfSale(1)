                    }
                    let objDayEndTransactionArgs = objResponse[5];
                    let EODData = objDayEndTransactionArgs.DayEnd;

                    // Batch Printing (Controller Method)
                    let batchPrintingRelatedInformation = null;
                    if (objResponse.length > 5) {
