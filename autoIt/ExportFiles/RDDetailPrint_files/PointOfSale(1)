    loadTreeViewControl: function (isOpenToFreeItems) {
        try {
            debugger;
            let selectedProductId = null, selectProductGroupId = null;
            let treeViewControlStoreInformation = null;
            let gridIdValues = [];
            SCHEMESFREEITEMS.VARIABLE.isOpenToFreeItems = isOpenToFreeItems;
            if (isOpenToFreeItems == false)
                treeViewControlStoreInformation = $("#divFreeItemCriteriaDefinitionRight > div#divTreeViewControlStoreInformation");
            else
                treeViewControlStoreInformation = $("#divFreeDiscountRight > div#divTreeViewControlStoreInformation");

            if (treeViewControlStoreInformation != null && treeViewControlStoreInformation != undefined && treeViewControlStoreInformation.length > 0) {
                selectedProductId = $(treeViewControlStoreInformation).attr("data-SelectedProductId");
                selectProductGroupId = $(treeViewControlStoreInformation).attr("data-SelectedProductGroupId");
                //if (selectProductGroupId != null && selectProductGroupId != undefined && selectProductGroupId.trim().length > 0) 
                //      selectedProductId = selectedProductId + "," + selectProductGroupId;
                if (selectProductGroupId != null && selectProductGroupId != undefined && selectProductGroupId.trim().length > 0) {
                    selectProductGroupId = selectProductGroupId.split(',');
                    for (let i = 0; i < selectProductGroupId.length; i++) {
                        let obj = new Object();
                        obj.Id = selectProductGroupId[i];
                        obj.IsGroup = true;
                        gridIdValues.push(obj);
                    }
                }
                if (selectedProductId != null && selectedProductId != undefined && selectedProductId.trim().length > 0) {
                    selectedProductId = selectedProductId.split(',');
                    for (let i = 0; i < selectedProductId.length; i++) {
                        let obj = new Object();
                        obj.Id = selectedProductId[i];
                        obj.IsGroup = false;
                        gridIdValues.push(obj);
                    }
                }
                SCHEMESFREEITEMS.VARIABLE.gridIdValues = gridIdValues;
            }

            let loadTreeViewControlArgs = new Object();
            loadTreeViewControlArgs.ParentScreen = 1;
            loadTreeViewControlArgs.ScreenName = "divSchemesFreeItemsMain";

            if (isOpenToFreeItems == false) {
                if (SCHEMESFREEITEMS.VARIABLE.optSchemeFreeItemId != null && SCHEMESFREEITEMS.VARIABLE.optSchemeFreeItemId != undefined && SCHEMESFREEITEMS.VARIABLE.optSchemeFreeItemId > 0) {
                    if (selectedProductId == null || selectedProductId == undefined || selectedProductId.length <= 0) {
                        toastr.error("Product Id is not available to load Product Tree.");
                        return;
                    }
                }

                loadTreeViewControlArgs.ControlName = "divProductTreeControl";
                loadTreeViewControlArgs.StoreInformationUnderElement = "divFreeItemCriteriaDefinitionRight";
            }
            else {
                if (SCHEMESFREEITEMS.VARIABLE.FreeItemInfo != null && SCHEMESFREEITEMS.VARIABLE.FreeItemInfo != undefined && SCHEMESFREEITEMS.VARIABLE.FreeItemInfo.Id > 0) {
                    if (selectedProductId == null || selectedProductId == undefined || selectedProductId.length <= 0) {
                        toastr.error("Product Id is not available to load Product Tree.");
                        return;
                    }
                }

                loadTreeViewControlArgs.ControlName = "divFreeItemProductTreeControl";
                loadTreeViewControlArgs.StoreInformationUnderElement = "divFreeDiscountRight";
            }
            SCHEMESFREEITEMS.SEVERMETHOD.loadMasterTree();
            //SCHEMESFREEITEMS.SEVERMETHOD.loadTreeViewControl(loadTreeViewControlArgs, selectedProductId, isOpenToFreeItems);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESFREEITEMS.loadTreeViewControl :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    optSchemeFreeItemSelectedChanged: function (optSchemeFreeItemName) {
        try {

            var SchemeFreeItemIdDetails = OPTIONCONTROL.getControlDataObject(optSchemeFreeItemName.id);
            var iSchemeFreeItemId = FConvert.toInt(OPTIONCONTROL.getControlValue(optSchemeFreeItemName.id));
            SCHEMESFREEITEMS.VARIABLE.optSchemeFreeItemId = iSchemeFreeItemId;

            if (iSchemeFreeItemId == null || iSchemeFreeItemId <= 0) {
                if (SCHEMESOUTLETS.VARIABLE.selectedOutlet.length != 0) {
                    $("#txtOutlets").val("");
                    SCHEMESOUTLETS.VARIABLE.selectedOutlet = [];
                    SCHEMESOUTLETS.VARIABLE.OutletId = "";
                    SCHEMESOUTLETS.VARIABLE.OutletName = "";
                }
                SCHEMESFREEITEMS.BindWeekdaysCombo();
                SCHEMESFREEITEMS.BindEmptyObject()
                SCHEMESFREEITEMS.ClearCriteriaFields(true);
                SCHEMESFREEITEMS.BindDefaultValues();
                SCHEMESFREEITEMS.ActivateUIControlsIfSchemeDoesNotExistsInTran();
                FCommon.UI.enableButton(false, "divFreeItemClone");
            }
            else {
                SCHEMESFREEITEMS.ClearCriteriaTabFields(true);
                SCHEMESFREEITEMS.ClearFreeItemsTabFields(true);

                var rtnFreeSchemes = SCHEMESFREEITEMS.SEVERMETHOD.GetAndBindSelectedFreeSchemeDetails(iSchemeFreeItemId)
                if (rtnFreeSchemes != null && rtnFreeSchemes != undefined) {
                    SCHEMESFREEITEMS.AssignValues_New(rtnFreeSchemes);
                    SCHEMESFREEITEMS.VARIABLE.FreeSchemes.push(rtnFreeSchemes);

                    let rtnValue = SCHEMESCOMMONMETHODS.isSchemeExistsInTransaction(iSchemeFreeItemId, 2);
                    SCHEMESFREEITEMS.VARIABLE.FreeSchemeExistsInTran = rtnValue[0];
                    SCHEMESFREEITEMS.VARIABLE.FreeSchemeExistsInMappingToCustomer = rtnValue[1];

                    if (SCHEMESFREEITEMS.VARIABLE.FreeSchemeExistsInTran == true)
                        SCHEMESFREEITEMS.DeActivateUIControlsIfSchemeExistsInTran();
                    else
                        SCHEMESFREEITEMS.ActivateUIControlsIfSchemeDoesNotExistsInTran();
                }
                SCHEMESFREEITEMS.VARIABLE.IsFreeItemUnitComboRefreshed = false;
                FCommon.UI.enableButton(true, "divFreeItemClone");
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESFREEITEMS.optSchemeFreeItemSelectedChanged :: Catch block :: Exception :: " + Ex.message);
        }
    },
