    /*ValorIntegration - CreditCard/DebitCard Mode*/
    getCrDrCardAmountChangedEvent: function () {
        try {
            let creditCardAmount = 0, cCardAmt = 0, controlValue = 0;
            if (BillSettlement.SelectedCreditCard == null || BillSettlement.SelectedCreditCard == undefined)
                return;

            if (BillSettlement.SelectedCreditCard.CardType == 11) {
                if (BillSettlement.ValorPermissibleAmount != null && BillSettlement.ValorPermissibleAmount != undefined && BillSettlement.ValorPermissibleAmount <= 0)
                    return;
            }
            if ($("#divCrDrIntegration").is(":visible") == true && $("#divCrDrCreditCardIntegration").is(":visible") == false) {
                creditCardAmount = $("#txtCrDrCardAmount").val();
                if (BillSettlement.SelectedCreditCard.CardType == 11) //EBT Card Type
                {
                    if (BillSettlement.ValorPermissibleAmount != null && BillSettlement.ValorPermissibleAmount != undefined
                        && FConvert.toDecimal(BillSettlement.ValorPermissibleAmount, POSCommon.numberofDecimal, true) < FConvert.toDecimal(creditCardAmount, POSCommon.numberofDecimal, true)) {
                        toastr.error("Permissible Amount is - " + BillSettlement.ValorPermissibleAmount + ". You can not pay more than " + BillSettlement.ValorPermissibleAmount + " amount.");
                        $("#txtCrDrCardAmount").val(FConvert.toDecimal(BillSettlement.ValorPermissibleAmount, POSCommon.numberofDecimal, true));
                        return;
                    }
                }

                if (creditCardAmount != null && creditCardAmount != undefined && FConvert.toDecimal(creditCardAmount, POSCommon.numberOfDecimal, true) > 0)
                    creditCardAmount = FConvert.toDecimal(creditCardAmount, POSCommon.numberOfDecimal, true);
                else
                    creditCardAmount = FConvert.toDecimal(0, POSCommon.numberOfDecimal, true);

                if (BillSettlement.BalanceAmount > 0 && creditCardAmount > 0) {
                    if (creditCardAmount.length == 1 && creditCardAmount == ".") {
                        $("#txtCrDrCardAmount").val("0.00");
                        return;
                    }

                    if (FConvert.toDecimal(creditCardAmount) > FConvert.toDecimal(BillSettlement.BalanceAmount)) {
                        $("#txtCrDrCardAmount").val(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal));
                        creditCardAmount = BillSettlement.BalanceAmount;
                    }

                    controlValue = $("#txtCrDrCardAmount").val();
                    if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue.trim(), POSCommon.numberofDecimal, true) > 0)
                        cCardAmt = FConvert.toDecimal(controlValue.trim(), POSCommon.numberofDecimal, true);

                    if (cCardAmt > FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal, true))
                        cCardAmt = FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal, true);

                    //Pyament Schemes is not applicable for Valor.
                    cCardAmt = FConvert.toDecimal(cCardAmt, POSCommon.numberofDecimal, true) - FConvert.toDecimal(0, POSCommon.numberofDecimal, true);
                    $("#txtCrDrCardAmount").val(FConvert.toDecimal(cCardAmt, POSCommon.numberOfDecimal));
                    $("#txtCrDrCardSchemeDiscount").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                    $("#txtCrDrCardSchemeDiscount").attr("data-Tag", null);
                    BILLSETTLEMENT.calculateCrDrCardCharges(BillSettlement.SelectedCreditCard);
                }
            }
            else {
                controlValue = $("#txtCrDrCreditCardAmount").val();
                if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue, POSCommon.numberOfDecimal, true) > 0)
                    creditCardAmount = FConvert.toDecimal(controlValue, POSCommon.numberOfDecimal, true);
                else
                    creditCardAmount = FConvert.toDecimal(0, POSCommon.numberOfDecimal, true);

                if (BillSettlement.BalanceAmount > 0 && creditCardAmount > 0) {
                    if (creditCardAmount.length == 1 && creditCardAmount == ".") {
                        $("#txtCrDrCreditCardAmount").val("0.00");
                        return;
                    }

                    if (FConvert.toDecimal(creditCardAmount) > FConvert.toDecimal(BillSettlement.BalanceAmount)) {
                        $("#txtCrDrCreditCardAmount").val(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal));
                        creditCardAmount = BillSettlement.BalanceAmount;
                    }

                    controlValue = $("#txtCrDrCreditCardAmount").val();
                    if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue.trim(), POSCommon.numberofDecimal, true) > 0)
                        cCardAmt = FConvert.toDecimal(controlValue.trim(), POSCommon.numberofDecimal, true);

                    if (cCardAmt > FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal, true))
                        cCardAmt = FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal, true);

                    var _schemeDisc = 0;
                    var _prompts = BILLSETTLEMENT.SCHEMESMETHODS.applyPaymentTypeSchemes(PaymentTypes.get("CREDITCARD"), 0, BillSettlement.SelectedCreditCard.ID, 0, cCardAmt, false, 0, false);
                    _schemeDisc = ApplicationNew.TotalSchemesInfo.PaymentDiscount;

                    var amount = FConvert.toDecimal(cCardAmt, POSCommon.numberofDecimal, true) - FConvert.toDecimal(_schemeDisc, POSCommon.numberofDecimal, true);
                    $("#txtCrDrCreditCardAmount").val(FConvert.toDecimal(amount, POSCommon.numberOfDecimal));
                    $("#txtCrDrCardSchemeDiscount").val(FConvert.toDecimal(_schemeDisc, POSCommon.numberOfDecimal));

                    if (_prompts != null && _prompts != undefined && _prompts.length > 0)
                        $("#txtCrDrCardSchemeDiscount").attr("data-Tag", JSON.stringify(_prompts));
                    else
                        $("#txtCrDrCardSchemeDiscount").attr("data-Tag", null);

                    BILLSETTLEMENT.calculateCrDrCardCharges(BillSettlement.SelectedCreditCard);
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getCreditCardAmountChangedEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
    calculateCrDrCardCharges: function (selectedCardType) {
        try {
            var screen = "NewRetailMainScreen", controlValue = $("#txtCrDrCardAmount").val();
            var msgBSCardChargesFldValidation = $("#msgBSCardChargesFldValidation").val();

            if (controlValue == null || controlValue == undefined)
                controlValue = 0;

            if (selectedCardType.CardCharges == null || selectedCardType.CardCharges == undefined)
                selectedCardType.CardCharges = 0;

            if (screen != FromScreen.get("GIFTVOUCHERSALE") && screen != FromScreen.get("WNDCREDITSALE") && selectedCardType != null && selectedCardType != undefined && selectedCardType.CardCharges > 0) {
                var colMapFound = 0;
                if (BillSettlement.FooterColMap != null && BillSettlement.FooterColMap != undefined && BillSettlement.FooterColMap.length > 0)
                    colMapFound = BillSettlement.FooterColMap.filter(p => p.FieldBehaviour == 2);

                if (BillSettlement.FooterColMap == null || BillSettlement.FooterColMap == undefined || BillSettlement.FooterColMap.length <= 0 || colMapFound <= 0) {
                    toastr.error(msgBSCardChargesFldValidation);
                    return;
                }
                else {
                    var cardCharges = FConvert.toDecimal((FConvert.toDecimal(controlValue, POSCommon.numberOfDecimal, true) * FConvert.toDecimal(selectedCardType.CardCharges, POSCommon.numberOfDecimal, true)) / 100, POSCommon.numberOfDecimal, true);
                    if (cardCharges != null && cardCharges != undefined && FConvert.toDecimal(controlValue, POSCommon.numberOfDecimal, true) > 0)
                        $("#txtCrDrCardCharges").val(FConvert.toDecimal(cardCharges, POSCommon.numberOfDecimal));
                    else
                        $("#txtCrDrCardCharges").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleBillSettlement.js :: JavaScript Function :: BILLSETTLEMENT.calculateCrDrCardCharges :: Catch Block :: Exception :: " + Ex.message);
            return false;
        }
    },
