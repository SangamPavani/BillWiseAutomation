        reloadedProductSearchTree: function (productlist, bDestroyFirst) {
            //
            try {
                if (bDestroyFirst == true) {
                    var aa = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree");
                    var tree = $(aa).jstree();
                    if (tree != null && tree != undefined)
                        $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().destroy(true);
                }

                $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " #divProductSearchTree")
                    .on("loaded.jstree", FPRODUCTCONTROL.PRODUCTSEARCH.loadedTreeEvent)
                    .jstree(
                        {
                            "plugins": ["checkbox"], //"tie_selection": false - Loaded/Changed Event will not fire
                            "checkbox": { "whole_node": true, "keep_selected_style": false },
                            "core":
                            {
                                "data": productlist,
                                'check_callback': function (operation, node, node_parent, node_position, more) {
                                    // operation can be 'create_node', 'rename_node', 'delete_node', 'move_node', 'copy_node' or 'edit'
                                    // in case of 'rename_node' node_position is filled with the new node name
                                    return (operation === 'create_node' || operation === 'delete_node' || operation === 'rename_node' || operation == 'move_node' || operation == 'copy_node') ? true : false;
                                }
                            },
                        });
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainControl.js :: Method :: FPRODUCTCONTROL.PRODUCTSEARCH.reloadedProductSearchTree :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
                return false;
            }
        },
