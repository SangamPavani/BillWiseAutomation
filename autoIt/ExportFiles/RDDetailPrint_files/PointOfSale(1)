            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: CREDITNOTE.SUCCESSSERVERMETHOD.onSuccessGetCreditNoteDetails :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
