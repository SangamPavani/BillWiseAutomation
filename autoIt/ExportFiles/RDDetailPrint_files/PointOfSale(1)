            let msgPhoneRes = $("input#msgPhoneRes").val();
            let msgPhoneOff = $("input#msgPhoneOff").val();
            var sAddress = ""; //sbAddress
            sAddress = "Name : " + memberData.MemberName;
            var strAddress = memberData.Address1;

            if (memberData.Address1 != null && memberData.Address1 != undefined && memberData.Address1.trim() != ""
                && memberData.Address1.trim().length > 0 && memberData.Address1.trim() != "0") {
                sAddress = sAddress + msgAddress + memberData.Address1;
