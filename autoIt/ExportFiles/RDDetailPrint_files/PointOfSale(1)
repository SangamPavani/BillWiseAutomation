                        _HomeDelivery.Address = differentAddress;
                    else
                        _HomeDelivery.Address = existingAddress;

                    _HomeDelivery.MemberDet = ApplicationNew.MemberData;
                    _HomeDelivery.MemberDet.Mobile = $("#txtPreOrderMobileNumber").val();
                }

                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DeliveryTimeInterval == true) {
                    //Delivery Time Interval Option Control Is Enable
                    var optDeliverySlot = OPTIONCONTROL.getControlValue("optPreOrderDeliveryTimeInterval");
