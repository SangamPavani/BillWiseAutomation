    validateLineControls: function () {
        try {
            //debugger;
            var optFieldName = OPTIONCONTROL.getControlDataObject("optLineWiseFieldList");
            var cbFieldName = OPTIONCONTROL.getControlText("optLineWiseFieldList");
            var msgSelectFieldName = $("#msgSelectFieldName").val();
            var msgPlzUseDifferentFieldName = $("#msgPlzUseDifferentFieldName").val();
            var msgSelectFieldBehaviour = $("#msgSelectFieldBehaviour").val();
            var msgSelectOutputCacl = $("#msgSelectOutputCacl").val();
            var msgSelectEffectOnNet = $("#msgSelectEffectOnNet").val();
            var msgSelectPriceBookVal = $("#msgSelectPriceBookVal").val();
            var msgPOSInformation = $("#msgPOSInformation").val();
            var msgMRPMRPSavingsfieldsbehaviourshouldbeReadonlyorHidden = $("#msgMRPMRPSavingsfieldsbehaviourshouldbeReadonlyorHidden").val();
            var msgMRPfieldshouldexistswhileaddingMRPSaving = $("#msgMRPfieldshouldexistswhileaddingMRPSaving").val();
            var msgPleaseenterSerialNumbergreaterthanorequaltoZero = $("#msgPleaseenterSerialNumbergreaterthanorequaltoZero").val();
            var msgEnteredSerialNumberisalreadyexistPleaseenteranotherSerialNumber = $("#msgEnteredSerialNumberisalreadyexistPleaseenteranotherSerialNumber").val();
            var cbFieldNameindex = FConvert.toInt(optFieldName.iFieldId);
            if (cbFieldNameindex == 0)
                cbFieldNameindex = -1;

            //debugger;
            var lineWiseFieldTypeexist = $("#ddlLineWiseFieldType");
            if (lineWiseFieldTypeexist != null && lineWiseFieldTypeexist != undefined)
                var fieldBehaviour = FConvert.toInt($("#ddlLineWiseFieldType option:selected").val());
            var lineWiseFieldBehaviourexist = $("#ddlLineWiseFieldBehaviour");
            if (lineWiseFieldBehaviourexist != null && lineWiseFieldBehaviourexist != undefined)
                var fieldType = FConvert.toInt($("#ddlLineWiseFieldBehaviour option:selected").val());

            var lineWiseOutputexist = $("#ddlLineWiseFieldOutputCalculation");
            if (lineWiseOutputexist != null && lineWiseOutputexist != undefined)
                var outputCalc = FConvert.toInt($("#ddlLineWiseFieldOutputCalculation option:selected").val());
            var lineWiseEffectOnNetexist = $("#ddlLineWiseFieldEffectonNet");
            if (lineWiseEffectOnNetexist != null && lineWiseEffectOnNetexist != undefined)
                var fieldEffectonNet = FConvert.toInt($("#ddlLineWiseFieldEffectonNet option:selected").val());

            var lineWisePriceBookexist = $("#ddlLineWiseFieldPriceBookValue");
            if (lineWisePriceBookexist != null && lineWisePriceBookexist != undefined)
                var priceBook = $("#ddlLineWiseFieldPriceBookValue option:selected").val();

            if ((cbFieldName.trim() == "" || cbFieldName.trim() == null) && cbFieldNameindex <= 0) {
                toastr.error(msgSelectFieldName);
                $("input#optLineWiseFieldList").focus();
                return false;
            }
            else if (cbFieldName.trim() == "Tax Name") {
                toastr.error(msgPlzUseDifferentFieldName);
                $("#input#optLineWiseFieldList").focus();
                return false;
            }
            else if ((fieldBehaviour + 1) <= 0) {
                toastr.error(msgSelectFieldBehaviour);
                $("#ddlLineWiseFieldType").focus();
                return false;
            }
            else if (outputCalc <= 0) {
                toastr.error(msgSelectOutputCacl);
                $("#ddlLineWiseFieldOutputCalculation").focus();
                return false;
            }
            else if (fieldEffectonNet <= 0) {
                toastr.error(msgSelectEffectOnNet);
                $("#ddlLineWiseFieldEffectonNet").focus();
                return false;
            }
            else if ($("#chkLineWiseFieldPriceBookValue").is(":checked") == true && priceBook <= 0) {
                toastr.error(msgSelectPriceBookVal);
                $("#ddlLineWiseFieldPriceBookValue").focus();
                return false;
            }
            debugger;
            if (FConvert.toInt(fieldBehaviour) == FieldBehaviour.get("MRP") || FConvert.toInt(fieldBehaviour) == FieldBehaviour.get("MRPSAVING")) {
                if (!(FConvert.toInt(fieldType) == 2 || FConvert.toInt(fieldType) == 3)) {
                    toastr.error(msgMRPMRPSavingsfieldsbehaviourshouldbeReadonlyorHidden);
                    $("#ddlLineWiseFieldBehaviour").focus();
                    $("#ddlLineWiseFieldBehaviour").val(2);
                    return false;
                }
            }
            if (FConvert.toInt(fieldBehaviour) == FieldBehaviour.get("MRPSAVING")) {
                //Checking if Field FieldBehaviour already exists
                var linewiseList = RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.bodyPanelLineWiseModelData.LinewiseList;
                linewiseList = linewiseList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("MRP"));
                if (linewiseList == null || linewiseList == undefined || linewiseList.length <= 0) {
                    toastr.error(msgMRPfieldshouldexistswhileaddingMRPSaving);
                    $("#ddlLineWiseFieldBehaviour").focus();
                    return false;
                }
            }
            let serialNumber = $("#txtLineWiseFieldSerialNumber").val();
            if (serialNumber != null && serialNumber != undefined && serialNumber != "") {
                if (serialNumber < 0) {
                    toastr.info(msgPleaseenterSerialNumbergreaterthanorequaltoZero, msgPOSInformation);
                    $("#txtLineWiseFieldSerialNumber").focus();
                    return false;
                }
                var lineWiseData = JSON.parse($("#divLineWiseFields").attr("data-LineWiseFieldsData"));
                if (lineWiseData != null && lineWiseData != undefined) {
                    if (lineWiseData.LinewiseList != null && lineWiseData.LinewiseList != undefined && lineWiseData.LinewiseList.length > 0) {
                        if (serialNumber >= 0) {
                            let record = lineWiseData.LinewiseList.filter((p) => p.SerialNumber == serialNumber && p.Name != cbFieldName);
                            if (record != null && record != undefined && record.length > 0) {
                                toastr.info(msgEnteredSerialNumberisalreadyexistPleaseenteranotherSerialNumber, msgPOSInformation);
                                $("#txtLineWiseFieldSerialNumber").focus();
                                return false;
                            }
                        }
                    }
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + ", File: retailMainCustomization.js, Method: RETAILMAINBODYPANELCUSTOMIZATION.validateLineControls, Catch block : Error Message : " + ex.message);
            return false;
        }
    },
