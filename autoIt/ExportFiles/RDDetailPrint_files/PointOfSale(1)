                $(table).attr("data-Column", iColumn);
                iRow = FConvert.toInt(iRow);
                --iRow;
                if (iRow < 0)
                    iRow = 0;
                $(table).attr("data-Row", iRow);
            }
            else {
                $(table).attr("data-Column", iColumn);
            }
            return [iRow, iColumn];
        }
        catch (Ex) {
            alert("Exception: {FGRIDCONTROL.PRIVATE.onKeyDown} " + Ex.message);
