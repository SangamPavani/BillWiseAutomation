    calculateFooterExtraFields_Return: function (objSalesReturnWeb) {
        try {
            var pointOfSaleInfo = $("#msgPointOfSaleConfirmation").val();
            var itSeemsThatSalesReturnAndSalesInvoiceFieldsOrderDoNotMatchSoSalesReturnIsNotPossible = $("input#ItSeemsThatSalesReturnAndSalesInvoiceFieldsOrderDoNotMatchSoSalesReturnIsNotPossible").val();
            var rectifyTheFieldOrderToProceedFurther = $("input#RectifyTheFieldOrderToProceedFurther").val();
            if (objSalesReturnWeb.FooterFieldsList == null || objSalesReturnWeb.FooterFieldsList == undefined || objSalesReturnWeb.FooterFieldsList.length == 0)
                return;
            let linewiseTotalNet = 0, returnedNet = 0, returnedGross = 0, returnedNet1 = 0, actualReturnedNet = 0;
            if (objSalesReturnWeb.FooterFieldsList != null && objSalesReturnWeb.FooterFieldsList != undefined && objSalesReturnWeb.FooterFieldsList.length > 0) {
                $.each(objSalesReturnWeb.ProductDetails, function (index, record) {
                    if (record.ProductType == PosProductType.get("COMPLIMENTARY")) {
                        linewiseTotalNet = linewiseTotalNet + 0;
                        returnedNet = returnedNet + 0;
                        returnedGross = returnedGross + 0;
                        returnedNet1 = returnedNet1 + 0;
                        actualReturnedNet = actualReturnedNet + 0;
                    }
                    else {
                        linewiseTotalNet = linewiseTotalNet + record.DefaultValue15;
                        returnedNet = returnedNet + record.ReturnedNetAmt;
                        returnedGross = returnedGross + record.ReturnedGross;
                        returnedNet1 = returnedNet1 + record.ReturnedNetAmt;
                        actualReturnedNet = actualReturnedNet + record.ReturnedNetAmt;
                    }
                });

                //let linewiseTotalNet = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.DefaultValue15),
                //    returnedNet = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.ReturnedNetAmt),
                //    returnedGross = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.ReturnedGross),
                //    returnedNet1 = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.ReturnedNetAmt),
                //    actualReturnedNet = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.ReturnedNetAmt);
                if (returnedNet == 0) {
                    for (let i = 0; i < objSalesReturnWeb.FooterFieldsList.length; i++)
                        objSalesReturnWeb.ReturnDynamicFooterFields[i].FieldInput = objSalesReturnWeb.FooterFieldsList[i].PreloadValue;
                    objSalesReturnWeb.ReturnedNetAmount = FConvert.addNumericSeparator(FConvert.toDecimal(returnedNet, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
                    return;
                }
                for (let k = 0; k < objSalesReturnWeb.FooterFieldsList.length; k++) {
                    let dAmt = 0;
                    // RestFieldDetails
                    let bodyData = objSalesReturnWeb.SalesReturnBodyPanel.FieldDetails.filter((p) => p.FieldType == 2 && p.FieldName == objSalesReturnWeb.FooterFieldsList[k].FieldName);
                    if (bodyData == null || bodyData == undefined || bodyData.length <= 0) {
                        toastr.error(itSeemsThatSalesReturnAndSalesInvoiceFieldsOrderDoNotMatchSoSalesReturnIsNotPossible + "\n" + rectifyTheFieldOrderToProceedFurther, pointOfSaleInfo);
                        return;
                    }
                    objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldColMap = bodyData[0].ColMap;
                    if (objSalesReturnWeb.FooterFieldsList[k].DonotConsider > 0) {
                        if ((objSalesReturnWeb.FooterFieldsList[k].DonotConsider & (1 << 3)) != 0)
                            continue;
                    }
                    if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("ServiceCharge")) {
                        objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldValue = (objSalesReturnWeb.DynamicFooterFields[k].FieldInput / linewiseTotalNet) * actualReturnedNet;
                        continue;
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("PreOrderAdvance"))
                        continue;
                    else if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("CardCharges") && PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                        continue;
                    else if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("EPaymentCharges") && PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                        continue;

                    if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 1) {
                        if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet != 3) {
                            if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour != FieldBehaviour.get("ROUNDOFF") ||
                                (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("ROUNDOFF") && PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOffRefundPolicy == false)) {
                                if (linewiseTotalNet != 0) {
                                    objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldValue = (objSalesReturnWeb.DynamicFooterFields[k].FieldInput / linewiseTotalNet) * actualReturnedNet;
                                    dAmt = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput;
                                }
                            }
                            else {
                                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.NetRoundOffValueRefundPolicy != 0) {
                                    SALESRETURNCALCULATION.calculateNetRoundOffWithPreferences(objSalesReturnWeb.FooterFieldsList[k], FConvert.toDecimal(returnedNet), objSalesReturnWeb.ReturnDynamicFooterFields[k]);
                                    dAmt = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput;
                                }
                            }
                        }
                        else {
                            objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = dAmt = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                        }
                        //if (linewiseTotalNet != 0)
                        //{
                        //    objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldValue = (objSalesReturnWeb.DynamicFooterFields[k].FieldInput / linewiseTotalNet) * actualReturnedNet;
                        //    dAmt = objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput;
                        //}
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 2) {
                        ///Percentage on Gross
                        if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                            dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(returnedGross), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
                        else
                            dAmt = (returnedGross * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 3) {
                        if (objSalesReturnWeb.FooterFieldsList[k].ExempFieldIds.length > 0) {
                            ///Percentage on Net with some fields exemption
                            let dNetAmt = GetNetAmountAfterExempt_Return(k, objSalesReturnWeb);
                            if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                                dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(dNetAmt), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
                            else
                                dAmt = (dNetAmt * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        }
                        else {
                            ///Percentage on Net
                            if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                                dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(returnedNet), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
                            else
                                dAmt = (returnedNet * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        }
                        objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                        //if (objSalesReturnWeb.FooterFieldsList[k].ExempFieldIds?.Count > 0)
                        //{
                        //    ///Percentage on Net with some fields exemption
                        //    double dNetAmt = GetNetAmountAfterExempt_Return(k, objSalesReturnWeb);
                        //    if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                        //        dAmt = CustCommon.ConvertPercentageToValue(objSalesReturnWeb.DynamicFooterFields[k].FieldInput, dNetAmt, objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true);
                        //    else
                        //        dAmt = (dNetAmt * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        //}
                        //else
                        //{
                        //    ///Percentage on Net
                        //    if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                        //        dAmt = CustCommon.ConvertPercentageToValue(objSalesReturnWeb.DynamicFooterFields[k].FieldInput, returnedNet, objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true);
                        //    else
                        //        dAmt = (returnedNet * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        //}
                        //objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 4) {
                        ///Percentage on Line Net
                        if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                            dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(returnedNet1), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
                        else
                            dAmt = (returnedNet1 * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                        objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldInput = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                    }

                    if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour != FieldBehaviour.get("ROUNDOFF")) {
                        let dValueInDecimal = COMMONMETHODS.UTILITYMETHODS.roundOff(dAmt, POSCommon.localCurrency.GeneralRoundOff, POSCommon.localCurrency.RoundOffType, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);
                        dAmt = FConvert.toDecimal(dValueInDecimal);
                    }

                    objSalesReturnWeb.ReturnDynamicFooterFields[k].FieldValue = dAmt;
                    if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 1)
                        returnedNet = FConvert.toDecimal(returnedNet) + FConvert.toDecimal(dAmt)
                    else if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 2)
                        returnedNet = FConvert.toDecimal(returnedNet) - FConvert.toDecimal(dAmt)
                }
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DoNotReturnVoucherANDPoint == true) {
                    if (linewiseTotalNet != 0) {
                        objSalesReturnWeb.ReturnGiftVoucherPaid = FConvert.toDecimal(FConvert.addNumericSeparator(FConvert.toDecimal(objSalesReturnWeb.GiftVoucherPaid / linewiseTotalNet * actualReturnedNet), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
                        objSalesReturnWeb.ReturnDiscountVoucherPaid = FConvert.toDecimal(FConvert.addNumericSeparator(FConvert.toDecimal(objSalesReturnWeb.DiscountVoucherPaid / linewiseTotalNet * actualReturnedNet), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
                        objSalesReturnWeb.ReturnPointRedemptionPaid = FConvert.toDecimal(FConvert.addNumericSeparator(FConvert.toDecimal(objSalesReturnWeb.PointRedemptionPaid / linewiseTotalNet * actualReturnedNet), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
                    }
                    returnedNet = returnedNet - objSalesReturnWeb.ReturnGiftVoucherPaid - objSalesReturnWeb.ReturnDiscountVoucherPaid - objSalesReturnWeb.ReturnPointRedemptionPaid;
                }
                objSalesReturnWeb.ReturnedNetAmount = FConvert.addNumericSeparator(FConvert.toDecimal(returnedNet, POSCommon.numberOfDecimal,true));
            }
            else {
                for (let i = 0; i < objSalesReturnWeb.ProductDetails.length; i++) {
                    if (objSalesReturnWeb.ProductDetails[k].ProductType == PosProductType.get("COMPLIMENTARY"))
                        objSalesReturnWeb.ReturnedNetAmount = objSalesReturnWeb.ReturnedNetAmount + 0;
                    else
                        objSalesReturnWeb.ReturnedNetAmount = objSalesReturnWeb.ReturnedNetAmount + FConvert.addNumericSeparator(FConvert.toDecimal(objSalesReturnWeb.ProductDetails[i].ReturnedNetAmt, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
                }
            }
            $("#txtReturnAmount").html(FConvert.toDecimal(objSalesReturnWeb.ReturnedNetAmount, SALESRETURN.VARIABLES.posCommon.numberOfDecimal));
            // objSalesReturnWeb.ReturnedNetAmount = FConvert.toDecimal(PosCommon.ConvertToCompanyNumericSeparator(objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.ReturnedNetAmt), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter));
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method:SALESRETURNCALCULATION.calculateFooterExtraFields_Return, Catch block : Error Message : " + Ex.message);
        }
    },
    getNetAmountAfterExempt_Return: function (uptoIndex, objSalesReturnWeb) {
        let dNet = 0.0;
        try {
            $.each(objSalesReturnWeb.ProductDetails, function (index, record) {
                if (record.ProductType == PosProductType.get("COMPLIMENTARY"))
                    dNet = parseFloat(parseFloat(dNet) + 0).toFixed(POSCommon.numberOfDecimal);
                else
                    dNet = parseFloat(parseFloat(dNet) + parseFloat(record.ReturnedNetAmt)).toFixed(POSCommon.numberOfDecimal);
            });
            for (let k = 0; k < uptoIndex; k++) {
                if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 1)
                    dNet = dNet + objSalesReturnWeb.DynamicFooterFields[k].FieldValue;
                else if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 2)
                    dNet = dNet - objSalesReturnWeb.DynamicFooterFields[k].FieldValue;
            }
            return dNet;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method:SALESRETURNCALCULATION.getNetAmountAfterExempt_Return, Catch block : Error Message : " + Ex.message);
        }
    },
    calculateLineWise_Return: function (restBodyField, cProduct) {
        try {

            if (cProduct.ReturnedNetAmt <= 0)
                return;
            if (restBodyField != null && restBodyField != undefined) {
                let bodyPanelExtraFieldsList = [];
                bodyPanelExtraFieldsList = ApplicationNew.BodyPanelExtraFieldsList;
                if (cProduct.DefaultValue5 != 0) {
                    if (restBodyField.OutputCalculation == 1) {
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldInput =
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = ((cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput * cProduct.DefaultValue4) / cProduct.DefaultValue5) * cProduct.QtyToReturn;
                    }
                    else if (restBodyField.OutputCalculation == 2) {
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldInput = cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput;
                        if (restBodyField.EffectOnNet == 3) {
                            let dKFC = CALCULATION.getKeralaFloodCessValue(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            let dAssumeInclusiveDivisor = CALCULATION.getAssumeInclusiveDivisor(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            let dValue = cProduct.ReturnedGross;
                            dValue = CALCULATION.getExcludeCalculatedValue(restBodyField, dValue, cProduct, bodyPanelExtraFieldsList);
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertAssumeInclusivePercentageToValue(parseFloat(cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput), parseFloat(dValue), restBodyField.FieldTypeBehaviour, false, dKFC, dAssumeInclusiveDivisor)).toFixed(POSCommon.numberOfDecimal);
                        }
                        else
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = (cProduct.ReturnedGross * cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput) / 100;
                    }
                    else if (restBodyField.OutputCalculation == 3) {
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldInput = cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput;
                        if (restBodyField.EffectOnNet == 3) {
                            let dKFC = CALCULATION.getKeralaFloodCessValue(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            let dAssumeInclusiveDivisor = CALCULATION.getAssumeInclusiveDivisor(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            let dValue = cProduct.ReturnedNetAmt;
                            if (POSCommon.ProportionateFooterValueToBodyScreenField != null && POSCommon.ProportionateFooterValueToBodyScreenField != undefined)
                                dValue = FConvert.toDecimal(dValue) + FConvert.toDecimal(((cProduct.DynamicLineFields[POSCommon.ProportionateFooterValueToBodyScreenField.ColumnIndex].FieldInput * cProduct.DefaultValue4) / cProduct.DefaultValue5) * cProduct.QtyToReturn, true);

                            dValue = CALCULATION.getExcludeCalculatedValue(restBodyField, dValue, cProduct, bodyPanelExtraFieldsList);
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertAssumeInclusivePercentageToValue(parseFloat(cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput), parseFloat(dValue), restBodyField.FieldTypeBehaviour, false, dKFC, dAssumeInclusiveDivisor)).toFixed(POSCommon.numberOfDecimal);
                        }
                        else
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = (cProduct.ReturnedNetAmt * cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput) / 100;
                    }
                    else if (restBodyField.OutputCalculation == 6) {
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldInput = cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput;
                        let dValue = cProduct.ReturnedGross - cProduct.DiscountTotal_UptoCurrentField;
                        if (POSCommon.AdditionalCess != null && POSCommon.AdditionalCess != undefined && POSCommon.AdditionalCess.ColumnIndex > 0) {
                            dValue = dValue - cProduct.DynamicLineFields[POSCommon.AdditionalCess.ColumnIndex].FieldValue;
                        }
                        if (restBodyField.EffectOnNet == 3) {
                            if (POSCommon.ProportionateFooterValueToBodyScreenField != null && POSCommon.ProportionateFooterValueToBodyScreenField != undefined)
                                dValue = FConvert.toDecimal(dValue) + FConvert.toDecimal(((cProduct.DynamicLineFields[POSCommon.ProportionateFooterValueToBodyScreenField.ColumnIndex].FieldInput * cProduct.DefaultValue4) / cProduct.DefaultValue5) * cProduct.QtyToReturn, POSCommon.numberOfDecimal, true);

                            let dKFC = CALCULATION.getKeralaFloodCessValue(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            let dAssumeInclusiveDivisor = CALCULATION.getAssumeInclusiveDivisor(restBodyField, cProduct, bodyPanelExtraFieldsList);
                            dValue = CALCULATION.getExcludeCalculatedValue(restBodyField, dValue, cProduct, bodyPanelExtraFieldsList);
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertAssumeInclusivePercentageToValue(parseFloat(cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput), parseFloat(dValue), restBodyField.FieldTypeBehaviour, false, dKFC, dAssumeInclusiveDivisor)).toFixed(POSCommon.numberOfDecimal);
                        }
                        else
                            cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = (dValue * cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput) / 100;
                    }
                }

                if (restBodyField.IsDiscountField == true)
                    cProduct.DiscountTotal_UptoCurrentField += cProduct.DynamicLineFields[restBodyField.ColumnIndex].FieldInput;

                if (restBodyField.RoundoffType > 0 && restBodyField.RoundoffValue > 0) {
                    let ColumnRoundOff = FConvert.toDecimal(cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue);
                    if (ColumnRoundOff > 0)
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = FConvert.roundOff(ColumnRoundOff, FConvert.toDecimal(restBodyField.RoundoffValue), restBodyField.RoundoffType);// COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(restBodyField.RoundoffValue), restBodyField.RoundoffType, POSCommon.numberOfDecimal);
                    else if (ColumnRoundOff < 0 && cProduct.ProductType > 0) {
                        ColumnRoundOff = Math.abs(ColumnRoundOff);
                        let RoundOffResult = FConvert.roundOff(ColumnRoundOff, FConvert.toDecimal(restBodyField.RoundoffValue), restBodyField.RoundoffType); //COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(restBodyField.RoundoffValue), restBodyField.RoundoffType, POSCommon.numberOfDecimal);// Convert.ToDouble(ColumnRoundOff.RoundOff(Convert.ToDecimal(retailBodyField.RoundoffValue.ToString("F" + PosCommon.NumberOfDecimals)), Convert.ToInt32(retailBodyField.RoundoffType)));
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = -RoundOffResult;
                    }
                }
                else if (POSCommon.localCurrency != null && POSCommon.localCurrency != undefined && POSCommon.localCurrency.RoundOffType > 0 && POSCommon.localCurrency.GeneralRoundOff > 0) {
                    let ColumnRoundOff = FConvert.toDecimal(cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue);
                    if (ColumnRoundOff > 0) {
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = FConvert.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff), POSCommon.localCurrency.RoundOffType);
                        // COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff), POSCommon.localCurrency.RoundOffType, POSCommon.numberOfDecimal);
                    }
                    else if (ColumnRoundOff < 0 && cProduct.ProductType > 0) {
                        ColumnRoundOff = Math.abs(ColumnRoundOff);
                        let RoundOffResult = FConvert.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff), POSCommon.localCurrency.RoundOffType);
                        //COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff), POSCommon.localCurrency.RoundOffType, POSCommon.numberOfDecimal);// Convert.ToDouble(ColumnRoundOff.RoundOff(Convert.ToDecimal(PosCommon.LocalCurrency.GeneralRoundOff), Convert.ToInt32(PosCommon.LocalCurrency.RoundOffType)));
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = -RoundOffResult;
                    }
                }
                if (cProduct.ProductMake == PosProductMake.get("Set") && (restBodyField.FieldTypeBehaviour == FieldBehaviour.get("GST")
                    || restBodyField.FieldTypeBehaviour == FieldBehaviour.get("CGST") || restBodyField.FieldTypeBehaviour == FieldBehaviour.get("SGST"))
                    && cProduct.RetailSetsDetails != null && cProduct.RetailSetsDetails != undefined && cProduct.RetailSetsDetails.length > 0) {
                    for (let i = 0; i < cProduct.SetsDetails.length; i++)
                        cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue = cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue + cProduct.SetsDetails[i].ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue;
                }

                if (restBodyField.EffectOnNet == 1)
                    cProduct.ReturnedNetAmt = cProduct.ReturnedNetAmt + FConvert.toDecimal(cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue, POSCommon.numberOfDecimal,true);
                else if (restBodyField.EffectOnNet == 2)
                    cProduct.ReturnedNetAmt = cProduct.ReturnedNetAmt - FConvert.toDecimal(cProduct.ReturnedDynamicLineFields[restBodyField.ColumnIndex].FieldValue, POSCommon.numberOfDecimal, true);
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method:SALESRETURNCALCULATION.calculateLineWise_Return, Catch block : Error Message : " + Ex.message);
        }
    },
