                if (SCHEMES.SCHEMESBUTTONCLICK.PromptToSelectSchemeType() == false)
                    return false;

                let checkboxQuantity = $("#chkQuantity").is(":checked");
                let checkboxValue = $("#chkValue").is(":checked");
                if (checkboxQuantity == false && checkboxValue == false) {
                    COMMON.prototype.showMessage(pleaseDefineSchemeToBEvaluatedBasedOnQtyOrValOrBoth);

                    $("#chkQuantity").prop("checked", "checked");
                    $("#txtMinQty").val("1.00");
                    $("#txtMaxQty").val("1.00");

                    $("#txtMinQty").prop("disabled", false);
                    $("#txtMaxQty").prop("disabled", false);

                    $("#txtMinQty").on('click', function () { $("#txtMinQty").select(); });
                    $("#txtMaxQty").on('click', function () { $("#txtMaxQty").select(); });
                    return false;
                }

                if (checkboxQuantity == true) {
                    let minQty = $("#txtMinQty").val();
                    let maxQty = $("#txtMaxQty").val();
                    if (minQty == null || minQty == undefined || minQty.trim().length <= 0 || FConvert.toInt(minQty.trim()) <= 0) {
                        COMMON.prototype.showMessage(msgPleaseEnterMinQty, "");
                        $("#txtMinQty").focus();
                        return false;
                    }

                    if (maxQty == null || maxQty == undefined || maxQty.trim().length <= 0 || FConvert.toInt(maxQty.trim()) <= 0) {
                        COMMON.prototype.showMessage(msgPleaseEnterMaxQty, "");
                        $("#txtMaxQty").focus();
                        return false;
                    }

                    if (FConvert.toDecimal(minQty.trim()) > FConvert.toDecimal(maxQty.trim())) {
                        COMMON.prototype.showMessage(msgMinQtyCannotGreaterThanMaxQty, "");
                        $("#txtMinQty").focus();
                        return false;
                    }
                }

                if (checkboxValue == true) {
                    let minValue = $("#txtMinValue").val();
                    let maxValue = $("#txtMaxValue").val();


                    if (minValue == null || minValue == undefined || minValue.trim().length <= 0 || FConvert.toInt(minValue.trim()) <= 0) {
                        COMMON.prototype.showMessage(msgPleaseEnterMinVal, "");
                        $("#txtMinValue").focus();
                        return false;
                    }

                    if (maxValue == null || maxValue == undefined || maxValue.trim().length <= 0 || FConvert.toInt(maxValue.trim()) <= 0) {
                        COMMON.prototype.showMessage(msgPleaseEnterMaxVal, "");
                        $("#txtMaxVal").focus();
                        return false;
                    }

                    if (FConvert.toDecimal(minValue.trim()) > FConvert.toDecimal(maxValue.trim())) {
                        COMMON.prototype.showMessage(msgMinValCannotGreaterThanMaxVal, "");
                        $("#txtMinValue").focus();
                        return false;
                    }
