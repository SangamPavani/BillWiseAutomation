        openDayEnd: function () {
            try {
                MESSAGEPOPUP.closePopup();
                // ////debugger;
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictEODPendingHomeDelivery == true) {
                    var hCount = PENDINGHOMEDELIVERY.SERVERMETHODS.getPendingHomeDeliveryCount();
                    if (hCount > 0) {
                        var arrValue = [];
                        arrValue.push(true);
                        // SHORTCUTMETHODS.loadShortcutFunction(1030, false, null, null);
                        SHORTCUTMETHODS.loadShortcutFunction(54, false, arrValue, null);
                        return;
                    }
                }
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictEODOpenBills == true) {
                    var iCount = PENDINGVOUCHER.SERVERMETHODS.getPendingVoucherCount();
                    if (iCount > 0) {
                        SHORTCUTMETHODS.loadShortcutFunction(1017, false, null, null);
                        return;
                    }
                }

                var mCount = MISSINGVOUCHER.SERVERMETHODS.getMissingVoucherCount();
                if (mCount > 0) {
                    SHORTCUTMETHODS.loadShortcutFunction(1018, false, null, null);
                    return;
                }
                var arrPreferenceSetting = COMMONMETHODS.checkPreferences("DAYEND");
                if (arrPreferenceSetting != null && arrPreferenceSetting != undefined && arrPreferenceSetting.length > 0) {
                    var preferenceSetting = {
                        PreferenceMessage: arrPreferenceSetting
                    };
                    SHORTCUTMETHODS.loadShortcutFunction(1022, false, preferenceSetting, null);
                    return;
                }

                ////debugger;
                //Manager Approval OR User Verification Required Or Not
                var isUserVerificationRequired = COMMONMETHODS.userVerificationRequired(47);
                var isManagerApprovalRequired = COMMONMETHODS.managerApprovalRequired(47);

                if (isUserVerificationRequired == true && isManagerApprovalRequired == true) {
                    VERIFICATIONPROCESS.clearVerificationProcessVariables();
                    VERIFICATIONPROCESS.VARIABLES.IsManagerApprovalRequired = true;
                    USERVERIFICATION.openUserVerification(47);
                    return;
                }
                else if (isUserVerificationRequired == true && isManagerApprovalRequired == false) {
                    VERIFICATIONPROCESS.clearVerificationProcessVariables();
                    USERVERIFICATION.openUserVerification(47);
                    return;
                }
                else if (isUserVerificationRequired == false && isManagerApprovalRequired == true) {
                    VERIFICATIONPROCESS.clearVerificationProcessVariables();
                    MANAGERAPPROVAL.openManagerApproval(47);
                    return;
                }
                SHORTCUTMETHODS.loadShortcutFunction(47);
