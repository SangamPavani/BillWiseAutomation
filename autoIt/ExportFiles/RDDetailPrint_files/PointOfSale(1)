                voucherField.sGroupName = groupName;
            else
                voucherField.sGroupName = "";

            if (masterDataType == MasterDataType.get("TEXT")) {
                voucherField.iMaxSize = textLength;
                voucherField.sColumnToType = "varchar(" + textLength + ")";
