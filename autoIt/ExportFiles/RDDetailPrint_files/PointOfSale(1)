        onChangeOutlet: function () {
            try {
                //debugger;
                let iOutletid = $("#ddlOutlets").val();
                if (iOutletid == null || iOutletid == undefined || iOutletid <= 0) {
                    PREFERENCE.OutletTab.clearAllOutletPreference();
                    return;
                }

                let selectedOutletTab = $("a.pref_Selected_Tab").attr("id");
                if (selectedOutletTab == null || selectedOutletTab == undefined)
                    return;

                switch (selectedOutletTab) {
                    case "OUTLET":
                        PREFERENCE.OUTLETPREFERENCE.loadOutletGeneralTab(5);
                        break;
                    case "PREORDER":
                        PREFERENCE.OUTLETPREFERENCE.loadOutletGeneralTab(6);
                        break;
                    case "PAYMENT":
