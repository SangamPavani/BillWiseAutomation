            // Filling JobNumber, Job status related tags
            if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != undefined && PreferenceSetting.PrefOutletTab.OutletGeneralTab.SearchByJobNumber == true) {
