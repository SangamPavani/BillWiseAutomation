    fillTransactionFooter: function (arrParams) {
        try {
            //int VoucherType, List < FooterData > FooterFieldsData, List < CustBodyPanel > _footerColMap
            let voucherType = arrParams[0];
            let footerColMap = arrParams[1];

            let footerFieldsData = [], footerFieldData = null, footerPosData = null;
            let multiplyfactor = ApplicationNew.RetailTransFooter.UserWiseNet >= 0 ? 1 : -1;

            let posFooterColMap = footerColMap.filter((f) => f.ID != 0 && f.TemplateID != 0 && f.TypeID == 2);
            if (posFooterColMap != null && posFooterColMap != undefined && posFooterColMap.length > 0) {
                let footerCounter = 1;
                //debugger;
                for (let k = 0; k < posFooterColMap.length; k++) {
                    footerFieldData = new Object();
                    if (voucherType == PreferenceSetting.PrefPostingTab.POSVoucher)
                        footerFieldData.ColMap = FConvert.toInt(posFooterColMap[k].ColMap);
                    else
                        footerFieldData.ColMap = FConvert.toInt(posFooterColMap[k].PreOrderColMap);

                    footerPosData = ApplicationNew.RetailTransFooter.DynamicFooterFields.filter((p) => p.FieldColMap == posFooterColMap[k].ColMap);
                    if (footerPosData == null || footerPosData == undefined || footerPosData.length <= 0)
                        continue;

                    footerPosData = footerPosData[0];
                    if (posFooterColMap[k].FieldBehaviour == FieldBehaviour.get("ROUNDOFF")) //Round Off
                    {
                        footerFieldData.Input = multiplyfactor * footerPosData.FieldInput;// FConvert.toDecimal(footerPosData.FieldInput, POSCommon.numberOfDecimal);
                        footerFieldData.Account1 = posFooterColMap[k].AccountID;
                        footerFieldData.Account2 = 0;
                    }
                    else if (ApplicationNew.SelectedPreOrderDetails != null && ApplicationNew.SelectedPreOrderDetails != undefined
                        && FConvert.toDecimal(ApplicationNew.SelectedPreOrderDetails.Deposit, POSCommon.numberOfDecimal) > 0 && posFooterColMap[k].FieldBehaviour == FieldBehaviour.get("PREORDERADVANCE"))
                        footerFieldData.Input = multiplyfactor * FConvert.toDecimal(ApplicationNew.SelectedPreOrderDetails.Deposit, POSCommon.numberOfDecimal);
                    else {
                        if (posFooterColMap[k].OutputCalculationId == 2 || posFooterColMap[k].OutputCalculationId == 3)
                            footerFieldData.Input = footerPosData.FieldInput;// FConvert.toDecimal(footerPosData.FieldInput, POSCommon.numberOfDecimal);
                        else
                            footerFieldData.Input = multiplyfactor * FConvert.toDecimal(footerPosData.FieldInput, POSCommon.numberOfDecimal);

                        footerFieldData.Account1 = posFooterColMap[k].AccountID;
                        footerFieldData.Account2 = 0;
                    }
                    footerFieldsData.push(footerFieldData);
                    footerCounter++;
                }
            }

            let erpFooterExtraColMap = footerColMap.filter((f) => f.ID == 0 && f.TemplateID == 0 && f.TypeID == 2 && f.VoucherType == voucherType);
            if (erpFooterExtraColMap != null && erpFooterExtraColMap != undefined && erpFooterExtraColMap.length > 0) {
                for (let ErpCounter = 0; ErpCounter < erpFooterExtraColMap.length; ErpCounter++) {
                    footerFieldData = new Object();
                    // POSCommon.CreditNoteVATEnabled //CHECK
                    if (erpFooterExtraColMap[ErpCounter].Name == "VAT advance" && POSCommon.creditNoteVATEnabled == true && ApplicationNew.SelectedPreOrderDetails != null && ApplicationNew.SelectedPreOrderDetails != undefined
                        && FConvert.toDecimal(ApplicationNew.SelectedPreOrderDetails.Deposit) > 0 && voucherType == PreferenceSetting.PrefPostingTab.POSVoucher) {
                        let BodyVATExtraField = ApplicationNew.BodyPanelExtraFieldsList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("VAT"));
                        if (BodyVATExtraField != null && BodyVATExtraField != undefined && BodyVATExtraField.length > 0) {
                            BodyVATExtraField = BodyVATExtraField[0];

                            footerFieldData.ColMap = FConvert.toInt(erpFooterExtraColMap[ErpCounter].ColMap);
                            let TotalVAT = 0, VATNetAmt = 0;

                            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                                if (ApplicationNew.ListOfItems[i].ProductType == 3)
                                    TotalVAT = TotalVAT + 0;
                                else
                                    ApplicationNew.ListOfItems[i].DynamicLineFields[BodyVATExtraField.ColumnIndex].FieldValue;

                                if (ApplicationNew.ListOfItems[i].ProductType == 3 || ApplicationNew.ListOfItems[i].DynamicLineFields[BodyVATExtraField.ColumnIndex].FieldValue == 0)
                                    VATNetAmt = VATNetAmt + 0;
                                else
                                    VATNetAmt = VATNetAmt + ApplicationNew.ListOfItems[i].DefaultValue15;
                            }
                            if (VATNetAmt > 0)
                                footerFieldData.Input = multiplyfactor * FConvert.toDecimal((ApplicationNew.SelectedPreOrderDetails.Deposit * TotalVAT) / VATNetAmt);
                        }
                        footerFieldsData.push(footerFieldData);
                    }
                }
            }

            return [true, footerFieldsData];
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.fillTransactionFooter :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return [false, null];
        }
    },
    setTransactionBody: function (arrParams) {
        try {
            let arrTransBody = [];

            let custLineWise = arrParams[0];
            let voucherType = arrParams[1];
            let exchangeRate = arrParams[2];
            let bodyColMap = arrParams[3];
            let isPreOrder = arrParams[4];
            let bodyCounter = arrParams[5];
            let arrBodyExtraParams = arrParams[6]; //CHECK
            let voucherExtraFields = VOUCHERPOSTING.SINGLTONVARIABLES.VoucherExtraFieldsInfo.filter((p) => p.VoucherType == voucherType);
            if (voucherExtraFields != null && voucherExtraFields != undefined && voucherExtraFields.length > 0)
                voucherExtraFields = voucherExtraFields[0];

            arrTransBody[SalesInvoiceTransactionBodyIndex.CurrencyId] = POSCommon.localCurrency.CurrencyId;

            exchangeRate = FConvert.toDecimal((VOUCHERPOSTING.SINGLTONVARIABLES.IsCompanyCurrencyDifferentLocalCurrency == false ? exchangeRate : POSCommon.localCurrency.CompDefCurExceRate), POSCommon.numberOfDecimal);
            arrTransBody[SalesInvoiceTransactionBodyIndex.ExchangeRate] = exchangeRate;

            let productRate = FConvert.toDecimal(custLineWise.DefaultValue4, POSCommon.numberOfDecimal);
            arrTransBody[SalesInvoiceTransactionBodyIndex.Product] = custLineWise.DefaultValue1;
            if (custLineWise.ParentId <= 0) {
                arrTransBody[SalesInvoiceTransactionBodyIndex.OrigAmount] = productRate;
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigRate] = productRate;
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesRate] = productRate * exchangeRate;

                /*objTansBody.OriginalAmounts[0] = productRate;*/ //CHECK
            }
            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesQuantity] = custLineWise.DefaultValue3;
            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesBaseQuantity] = custLineWise.ProductUnit != 0 ? 0 : arrTransBody[SalesInvoiceTransactionBodyIndex.SalesQuantity];

            if (custLineWise.ProductType == PosProductType.get("COMPLIMENTARY"))
                arrTransBody[SalesInvoiceTransactionBodyIndex.FlagsSuspendFA] = true;
            else
                arrTransBody[SalesInvoiceTransactionBodyIndex.FlagsSuspendFA] = false;

            if (ApplicationNew.PreviousTransaction == null || ApplicationNew.PreviousTransaction == undefined ||
                (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == null || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == undefined)
                && (ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction == null || ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction == undefined))
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross] = arrTransBody[SalesInvoiceTransactionBodyIndex.SalesQuantity] * productRate;
            else
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross] = FConvert.toDecimal(custLineWise.DefaultValue5, POSCommon.numberOfDecimal);

            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesGross] = arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross] * exchangeRate;
            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesStockValue] = arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross];
            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesSetId] = custLineWise.ParentId;
            arrTransBody[SalesInvoiceTransactionBodyIndex.SalesUnit] = custLineWise.ProductUnit;

            if (custLineWise.BatchData != null && custLineWise.BatchData != undefined) {
                custLineWise.BatchData.Qty = FConvert.toDecimal(arrTransBody[SalesInvoiceTransactionBodyIndex.SalesQuantity], POSCommon.numberOfDecimal);
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesBatchData] = custLineWise.BatchData;
            }
            else
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesBatchData] = null;

            if (custLineWise.RMANos == null || custLineWise.RMANos == undefined || custLineWise.RMANos.length <= 0) {
                custLineWise.RMANos = null;
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesRMANos] = null;
            }
            else {
                //if (voucherType == PreferenceSetting.PrefPostingTab.POSVoucher)
                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesRMANos] = custLineWise.RMANos;
            }

            //// Body Extra Fields
            arrTransBody[SalesInvoiceTransactionBodyIndex.BodyExtra] = VOUCHERPOSTING.BODYEXTRAFIELD.addBodyExtraFieldInSalesInvoiceTransaction(custLineWise, voucherType, arrBodyExtraParams)
            // Filling Screen Data
            if (bodyColMap != null && bodyColMap != undefined && bodyColMap.length > 0) {
                let colMap = 0, multiplyFactor = 1, arrScreenData = [], screenData = null;
                let templateBodyColMap = bodyColMap.filter((p) => p.TemplateID > 0)
                if (templateBodyColMap != null && templateBodyColMap != undefined && templateBodyColMap.length > 0) {
                    multiplyFactor = ((custLineWise.ProductType == PosProductType.get("NORMAL") || custLineWise.ProductType == PosProductType.get("COMPLIMENTARY")) ? 1 : -1);
                    screenData = new Object();
                    let bodyFieldDetails = null;

                    if (custLineWise.DynamicLineFields != null && custLineWise.DynamicLineFields != undefined && custLineWise.DynamicLineFields.length > 0) {
                        for (let k = 0; k < custLineWise.DynamicLineFields.length; k++) {
                            screenData = new Object();
                            bodyFieldDetails = bodyColMap.filter((p) => p.ID == custLineWise.DynamicLineFields[k].FieldId);
                            colMap = 0;
                            if (bodyFieldDetails != null && bodyFieldDetails != undefined && bodyFieldDetails.length > 0) {
                                bodyFieldDetails = bodyFieldDetails[0];
                                if (voucherType == PreferenceSetting.PrefPostingTab.POSVoucher)
                                    colMap = FConvert.toInt(bodyFieldDetails.ColMap);
                                else
                                    colMap = FConvert.toInt(bodyFieldDetails.PreOrderColMap);
                            }
                            screenData.ColMap = colMap;
                            if (bodyFieldDetails.OutputCalculationId == 2 || bodyFieldDetails.OutputCalculationId == 3)
                                screenData.Input = FConvert.toDecimal(custLineWise.DynamicLineFields[k].FieldInput, POSCommon.numberOfDecimal);
                            else
                                screenData.Input = multiplyFactor * FConvert.toDecimal(custLineWise.DynamicLineFields[k].FieldInput, POSCommon.numberOfDecimal);

                            arrScreenData.push(screenData);
                        }
                    }
                }

                let erpBodyExtraFields = bodyColMap.filter((p) => p.TemplateID == 0 && p.VoucherType == voucherType);
                if (erpBodyExtraFields != null && erpBodyExtraFields != undefined && erpBodyExtraFields.length > 0) {
                    for (let l = 0; l < erpBodyExtraFields.length; l++) {
                        screenData = new Object();
                        screenData.ColMap = FConvert.toInt(erpBodyExtraFields[l].ColMap);
                        arrScreenData.push(screenData);
                    }
                }

                arrTransBody[SalesInvoiceTransactionBodyIndex.SalesScreenData] = arrScreenData;
            }
            // //debugger;
            //Other fields
            let originalAmount = [FConvert.toDecimal(arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross], POSCommon.numberOfDecimal), FConvert.toDecimal(arrTransBody[SalesInvoiceTransactionBodyIndex.SalesOrigGross], POSCommon.numberOfDecimal) * -1];
            let amount = [originalAmount[0] * exchangeRate, originalAmount[1] * exchangeRate];

            arrTransBody[SalesInvoiceTransactionBodyIndex.OriginalAmount] = originalAmount;
            arrTransBody[SalesInvoiceTransactionBodyIndex.Amount] = amount;

            // Filling Accounts
            if (isPreOrder == false) {
                ///POS Sales :	1. Sales – Credit, 2. Customer – Debit, Discount- debit, Round off- Debit,GST -Debit
                // Setting Credit Account
                switch (custLineWise.ProductType) {
                    case 0:
                    case 3:
                        if (custLineWise.Code == 0)
                            arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.SalesAccnt;    //Credit
                        else
                            arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = custLineWise.Code;    //Credit
                        break;
                    case 1:
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.GoodsExchangeAccnt;    //Credit
                        break;
                    case 2:
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.SpoilageAccnt; //Credit
                        break;
                }

                // Setting Debit Account
                arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.CustomerAccnt;
                if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSalePaid > 0)
                    arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccount; //Debit 
                else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PostCustomerAccountAttachedToMember == true && ApplicationNew.MemberData != null
                    && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.CreditSaleAccountId != null && ApplicationNew.MemberData.CreditSaleAccountId != undefined && ApplicationNew.MemberData.CreditSaleAccountId != 0)
                    arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = ApplicationNew.MemberData.CreditSaleAccountId; //Debit 
                else if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TopupPaid > 0)
                    arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TopupAccountDets.CreditSaleAccountId;
            }
            else {
                if (voucherType == 5632) {
                    ///Pre Order Sales Voucher :: Sales order : PreOrder A/c - Credit, Customer - Debit

                    // Setting Credit Account
                    arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.PreOrderAccount;  //Credit

                    // Setting Debit Account

                    if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined
                        && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets != undefined && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets.ID > 0)
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = FConvert.toInt(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets.ID);  //Debit
                    else if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSalePaid > 0)
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccount; //Debit 
                    else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PostCustomerAccountAttachedToMember == true && ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined
                        && ApplicationNew.MemberData.CreditSaleAccountId != 0)
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = ApplicationNew.MemberData.CreditSaleAccountId; //Debit 
                    else
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.PreOrderCustomerAccnt;  //Debit
                }
                else {
                    ///Pos Sales(PreOrder collection mode) : Sales A/C  – Credit, Pre Order A/C – Debit

                    // Setting Credit Account
                    arrTransBody[SalesInvoiceTransactionBodyIndex.Code] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.SalesAccnt;    //Credit

                    // Setting Debit Account

                    if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined
                        && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets != undefined &&
                        VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets.ID > 0)
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = FConvert.toInt(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.CreditSaleAccountDets.ID);  //Debit
                    else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PostCustomerAccountAttachedToMember == true && ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined
                        && ApplicationNew.MemberData.CreditSaleAccountId != 0)
                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = ApplicationNew.MemberData.CreditSaleAccountId; //Debit 
