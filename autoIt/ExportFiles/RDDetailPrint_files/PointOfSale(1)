    getQtyInSalesOrRateInBase_Units: function (ProductId, salesUnit, baseUnit, passingArgs, UnitIdNamePair, isQty = false) {
        //ref double ItemQtyOrRate
        try {
            /* 1. Load ItemQtyOrRate and Line Sales Unit into variables.
             * 2. Retrieve BaseUnitId based on bool variable
             * 3. Compare BaseUnit and Sales Unit, if same xFactor will be 1
             * 4. Else, retrieve xFactor from SalesUnit and multiply if xFactor is -ve else divide if its +ve
             */

            /*          ***Important note***
             * While calling this function make sure to assign the passingArgs Object accordingly with the required 
             * properties like below (it's not necessary to pass both Quantity/Rate at a time), according to the calling function below variables can be used to pass required information
             * passingArgs.dQuantity
             * passingArgs.dRate 
             * passingArgs.QtyOrPrice  -  else can pass directly as well
             * and after returning from those functions make sure to reassign them by using returning value i.e
             * passingArgs.QtyOrPrice */

            let xFactor = 0;
            if (passingArgs.dQuantity != null && passingArgs.dQuantity != undefined && isQty == true)
                passingArgs.QtyOrPrice = passingArgs.dQuantity;
            else if (passingArgs.dRate != null && passingArgs.dRate != undefined && isQty == false)
                passingArgs.QtyOrPrice = passingArgs.dRate;
            else if (passingArgs.outletStock1 != null && passingArgs.outletStock1 != undefined)
                passingArgs.QtyOrPrice = passingArgs.outletStock1;

            if (baseUnit == salesUnit || salesUnit == 0) {
                xFactor = 1;
                passingArgs.QtyOrPrice = FConvert.toDecimal(passingArgs.QtyOrPrice) * FConvert.toDecimal(xFactor);
            }
            else {
                if (UnitIdNamePair == null || UnitIdNamePair == undefined || UnitIdNamePair.length < 0) {
                    let productsGroupData = new Object();
                    productsGroupData.IncludeEmptyRow = true;
                    productsGroupData.Products = [];
                    let product = new Object();
                    product.Id = ProductId;
                    product.UnitId = salesUnit;
                    productsGroupData.Products.push(product);

                    UnitIdNamePair = POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.SERVER.getUnitsByProductId(productsGroupData);
                }
                if (UnitIdNamePair != null && UnitIdNamePair != undefined && UnitIdNamePair.length > 0) {
                    let salesUnitData = UnitIdNamePair.filter((f) => f.Id == salesUnit);
                    if (salesUnitData != null && salesUnitData != undefined && salesUnitData.length > 0) {
                        //Here idNamePair.Xfactor is item sales unit qty interms of base unit
                        salesUnitData = salesUnitData[0];
                        if (salesUnitData.Xfactor < 0)
                            passingArgs.QtyOrPrice = FConvert.toDecimal((passingArgs.QtyOrPrice) * (salesUnitData.Xfactor * - 1), POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                        else
                            passingArgs.QtyOrPrice = FConvert.toDecimal((passingArgs.QtyOrPrice / salesUnitData.Xfactor), POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    }
                    else
                        passingArgs.QtyOrPrice = 0;
                }
                return UnitIdNamePair;
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : posSchemeImplementationGenerics.js :: JavaScript Function :: POSSCHEMEIMPLEMENTATIONGENERICS.getQtyInSalesOrRateInBase_Units :: Catch  Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
