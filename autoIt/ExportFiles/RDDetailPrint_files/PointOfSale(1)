    CalcQtyGrossSetValue: function (BodyHeader) {
        var QtyGrossSetValue = {
            _Qty: 0,
            _Gross: 0.00,
            _SetValue: 0.00
        }
        try {
            for (var i = 0; i < BodyHeader.BodyList.length; i++) {
                QtyGrossSetValue._Gross += BodyHeader.BodyList[i].Price * BodyHeader.BodyList[i].Quantity;
                QtyGrossSetValue._Qty += BodyHeader.BodyList[i].Quantity;

            }

            if (BodyHeader.RateType == 1) {
                if (BodyHeader.DiscType == 1) //Percentage
                {
                    disc = (QtyGrossSetValue._Gross * BodyHeader.Discount) / 100;
                }
                else if (BodyHeader.DiscType == 2) // Value
                {
                    if (BodyHeader.ApplyType == 1)// To Set
                    {
                        disc = BodyHeader.Discount;
                    }
                    else if (BodyHeader.ApplyType == 2)// To Individually
                    {
                        disc = BodyHeader.Discount * BodyHeader.BodyList.length;
                    }
                }
                QtyGrossSetValue._SetValue = (QtyGrossSetValue._Gross - disc);
            }
            else {
                QtyGrossSetValue._SetValue = BodyHeader.FixedAmt;
            }

            return QtyGrossSetValue;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ":: File: retailMainFocus8W.js:: Method: PRODUCTSETS.CalcQtyGrossSetValue :: Catch block : Error Message : " + Ex.message);
            return;
        }
