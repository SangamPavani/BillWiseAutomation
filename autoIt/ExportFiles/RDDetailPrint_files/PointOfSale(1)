                    valorCardPaymentIntegration.appkey = counterRelatedSettings[0].AppKey;
                    valorCardPaymentIntegration.appid = PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.AppId;
                    valorCardPaymentIntegration.epi = counterRelatedSettings[0].EPI;
                    valorCardPaymentIntegration.txn_type = "void";
                    valorCardPaymentIntegration.amount = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].DebitAmount;
                    valorCardPaymentIntegration.surchargeindicator = 1; //Int32
                    valorCardPaymentIntegration.auth_code = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].ApprovalCode;
                    valorCardPaymentIntegration.rrn = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].RRNNumber;
                    valorCardPaymentIntegration.tran_no = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].TransactionNumber; //Int32
                    valorCardPaymentIntegration.stan = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].Stan; //Int32
                    valorCardPaymentIntegration.ref_txn_id = BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].TransactionId;
                    valorCardPaymentIntegration.phone = 0;
                    valorCardPaymentIntegration.email = "";

                    const valorCardIntegrationVoidResponseArgs = BILLSETTLEMENT.SERVERMETHOD.callPaymentIntegrationValorVoidAPI(valorCardPaymentIntegration);
                    if (valorCardIntegrationVoidResponseArgs == null || valorCardIntegrationVoidResponseArgs == undefined) {
                        toastr.error("Exception while calling Void API. Please check the log for more details.", "POS Exception");
                        return;
                    }
                    if (valorCardIntegrationVoidResponseArgs.msg != "APPROVED") {
                        toastr.error("Exception while Void the Transaction. Please check the log for more details.", "POS Exception");
                        return;
                    }

                    toastr.info("Transaction void successfullly.", "POS Information");

                    if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet != null && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != undefined
                        && BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length <= 1) {
                        BillSettlement.BillSettlementPaymentDetails.CreditCardDet.splice(i, 1);
                        $("#tblCrDrCard > #tBodyCrDrCard").find("tr").remove();
                        $("#tblCrDrCard").hide();
                    }
                    else {
                        BillSettlement.BillSettlementPaymentDetails.CreditCardDet.splice(i, 1);
                        document.getElementById("tblCrDrCard").deleteRow(BILLSETTLEMENT.VARIABLE.selectedPaymentTypeIndex);
                        break;
                    }
                }
            }

            if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet != null && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != undefined && BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
