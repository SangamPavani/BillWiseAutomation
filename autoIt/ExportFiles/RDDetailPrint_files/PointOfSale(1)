    ValidateControls: function (bAllowDenomination, bAllowMultiCurrency) {
        //debugger;
        try {
            let MsgPleaseEnteratleastoneCurrencyAmount = $("input#MsgPleaseEnteratleastoneCurrencyAmount").val();
            let MsgPleaseEnteratleastoneDenominationCount = $("input#MsgPleaseEnteratleastoneDenominationCount").val();
            let MsgPleaseEntertheAmount = $("input#MsgPleaseEntertheAmount").val();
            var msgtxtInfoSelCounter = $("#msgtxtInfoSelCounter").val();
            var msgtxtInfoSelAccount = $("#msgtxtInfoSelAccount").val();
            var msgtxtInfoOneCurrencyRequired = $("#msgtxtInfoOneCurrencyRequired").val();
            if ($('input[name=rbtType]:checked').attr('id') == "rbtAccount") {
                var iAccountId = OPTIONCONTROL.getControlValue("optCashInOutControl");
                if (iAccountId <= 0) {
                    toastr.error(msgtxtInfoSelAccount);
                    return false;
                }
            }
            else if ($('input[name=rbtType]:checked').attr('id') == "rbtCounter") {
                var iCounterId = $('#ddlCounter').val();
                if (iCounterId <= 0) {
                    toastr.error(msgtxtInfoSelCounter);
                    return false;
                }
            }
            if (bAllowDenomination == true && bAllowMultiCurrency == true) {

                var currencyRecords = [];
                var currencyTableRow = $('#divMultiCurrency #tblMultiCurrency #tBodyMultiCurrency tr');
                for (var i = 0; i < currencyTableRow.length; i++) {
                    var parsedTableRowCurrency = JSON.parse($(currencyTableRow[i]).attr("data-CurrencyDetails"));
                    currencyRecords.push(parsedTableRowCurrency);
                }
                if (currencyRecords == null || currencyRecords.length <= 0) {
                    toastr.error(msgtxtInfoOneCurrencyRequired);//"Cannot save Transaction, Atleast One Currency detail is required.");
                    return false;
                }
                var totalAmount = 0;
                var tableCellAmount = $("#divMultiCurrency #tblMultiCurrency #tBodyMultiCurrency tr").find('td:eq(2)');
                if (tableCellAmount != null && tableCellAmount != undefined && tableCellAmount.length > 0) {
                    for (let i = 0; i < tableCellAmount.length; i++) {
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal($(tableCellAmount[i]).html());
                    }
                    if (totalAmount <= 0) {
                        toastr.error(MsgPleaseEnteratleastoneCurrencyAmount);
                        return false;
                    }
                }
            }
            else if (bAllowDenomination == true && bAllowMultiCurrency == false) {
                var totalAmount = 0;
                var tableCellAmount = $("#divDenomination  #tblDenomination  #tBodyDenomination  tr").find('td:eq(3)');
                if (tableCellAmount != null && tableCellAmount != undefined && tableCellAmount.length > 0) {
                    for (let i = 0; i < tableCellAmount.length; i++)
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal($(tableCellAmount[i]).html());

                    if (totalAmount <= 0) {
                        toastr.error(MsgPleaseEnteratleastoneDenominationCount);
                        return false;
                    }
                }
            }
            else if (bAllowDenomination == false && bAllowMultiCurrency == true) {
                var currencyRecords = [];
                var currencyTableRow = $('#divMultiCurrency  #tblMultiCurrency  #tBodyMultiCurrency  tr');
                for (var i = 0; i < currencyTableRow.length; i++) {
                    var parsedTableRowCurrency = JSON.parse($(currencyTableRow[i]).attr("data-CurrencyDetails"));
                    if (parsedTableRowCurrency.Amount > 0) {
                        currencyRecords.push(parsedTableRowCurrency);
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal(parsedTableRowCurrency.Amount);
                    }
                }
                if (currencyRecords == null || currencyRecords.length <= 0) {
                    toastr.error(msgtxtInfoOneCurrencyRequired);
                    return false;
                }

                var totalAmount = 0;
                var tableCellAmount = $("#divMultiCurrency #tblMultiCurrency  #tBodyMultiCurrency  tr").find('td:eq(2)');
                if (tableCellAmount != null && tableCellAmount != undefined && tableCellAmount.length > 0) {
                    for (let i = 0; i < tableCellAmount.length; i++) {
                        totalAmount = FConvert.toDecimal(totalAmount) + FConvert.toDecimal($(tableCellAmount[i]).html());
                    }
                    if (totalAmount <= 0) {
                        toastr.error(MsgPleaseEnteratleastoneCurrencyAmount);
                        return false;
                    }
                }
            }
            else if (bAllowDenomination == false && bAllowMultiCurrency == false) {
                if ($("#txtAmount").val() == "") {
                    toastr.error(MsgPleaseEntertheAmount);
                    return false;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: CASHINOUTCOLLECTION.ValidateControls :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
