            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.TRANSACTION.setTransactionBody :: Catch Block :: Exception :: " + JSON.stringify(Ex));
