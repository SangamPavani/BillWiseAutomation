    closeBatchPopupFreeItem: function (bFlag, arrBatchList, sCustomData, evt) {
        try {
            var customData = JSON.parse(sCustomData);
            var iIndex = customData.iIndex;

            RETAILMAIN.closePopup('#MBatch_Modal_dialog');
            //$("body > div.modal-backdrop").css('display', 'none');

            if (arrBatchList != null && arrBatchList != undefined && arrBatchList.length > 0) {
                ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].BatchNo = arrBatchList[0].BatchNo;
                ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].BatchData = arrBatchList[0];
            }
            if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined
                && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0 && (iIndex + 1) < ApplicationNew.TotalSchemesInfo.PromptsToShow.length) {
                if (ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1].DonotMaintainStockbyBatch == false)
                    PRODUCTMETHODNEW.BATCHPOPUPMETHODS.openBatchPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1], (iIndex + 1)]);
                else if (ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1].DonotMaintainStockbyRMA == false) {
                    PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1], (iIndex + 1)]);
                    return;
                }
                else
                    POSSCHEMEIMPLEMENTATIONGENERICS.addToBill([true, false]);
            }
            else
                POSSCHEMEIMPLEMENTATIONGENERICS.addToBill([true, false]);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.BATCHPOPUPMETHODS.closeBatchPopupFreeItem :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },

