            if (data != null && data != undefined) {
                if (data.bSuccess == false) {
                    if (data.sErrorMessage != undefined && data.sErrorMessage != null && data.sErrorMessage != "" && data.sErrorMessage.length > 0)
                        toastr.error(data.sErrorMessage);
                    $("#txtBarcode").val("");
