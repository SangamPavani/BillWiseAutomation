    calculateCardCharges: function (selectedCardType, isCreditCard) {

        try {
            var dCardAmt = 0, screen = "NewRetailMainScreen", charges = 0;
            var msgBSCardChargesFldValidation = $("#msgBSCardChargesFldValidation").val();
            if (isCreditCard == true)
                dCardAmt = $("#txtCreditCardAmount").val();
            else
                dCardAmt = $("#txtDebitCardAmount").val();

            if (dCardAmt <= 0)
                return;

            if (screen != FromScreen.get("GIFTVOUCHERSALE") && screen != FromScreen.get("WNDCREDITSALE") && selectedCardType != null && selectedCardType != undefined && selectedCardType.CardCharges > 0) {
                if (BillSettlement.ModuleType == ModuleType.get("RETAIL")) {
                    var colMapFound = 0;
                    //Count of FooterColMap  
                    if (BillSettlement.FooterColMap != null && BillSettlement.FooterColMap != undefined &&
                        BillSettlement.FooterColMap.length > 0)
                        colMapFound = BillSettlement.FooterColMap.filter(p => p.FieldBehaviour == 2);//FieldBehaviour.get("CARDCHARGES")=2

                    if (BillSettlement.FooterColMap == null || BillSettlement.FooterColMap == undefined ||
                        BillSettlement.FooterColMap.length <= 0 || colMapFound <= 0) {
                        toastr.error(msgBSCardChargesFldValidation);
                        return;
                    }
                    else {
                        var cardCharges = (dCardAmt * selectedCardType.CardCharges) / 100;
                        if (isCreditCard == true)
                            $("#txtCreditCardCharges").val(FConvert.toDecimal(cardCharges, POSCommon.numberOfDecimal));//((dCardAmt * selectedCardType.CardCharges) / 100);
                        else
                            $("#txtDebitCardCharges").val(FConvert.toDecimal(cardCharges, POSCommon.numberOfDecimal)); //((dCardAmt * selectedCardType.CardCharges) / 100);
                    }
                }
                else {
                    if (BillSettlement.RestFooterColMap != null || BillSettlement.RestFooterColMap != undefined)
                        var restFooterMapFound = BillSettlement.RestFooterColMap.filter(p => p.FieldBehaviour == 2);

                    if (BillSettlement.RestFooterColMap == null || BillSettlement.RestFooterColMap == undefined || restFooterMapFound <= 0) {
                        toastr.error(msgBSCardChargesFldValidation);
                    }
                    else {
                        charges = (dCardAmt * SelectedCardType.CardCharges) / 100;
                        if (isCreditCard == true)
                            $("#txtCreditCardCharges").val(FConvert.toDecimal(charges, POSCommon.numberOfDecimal));//(dCardAmt * SelectedCardType.CardCharges) / 100);
                        else
                            $("#txtDebitCardCharges").val(FConvert.toDecimal(charges, POSCommon.numberOfDecimal));
                    }
                }
            }
            else {
                if (isCreditCard == true)
                    $("#txtCreditCardCharges").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                else
                    $("#txtDebitCardCharges").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.calculateCardCharges, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
