    navigationButtonClickEvent: function (navigationClick) {
        try {

            var rowNumber = 0, totalRowCount = 0, rowCount = 0;

            var selectedItem = new Object();
            selectedItem.ID = $("#ddlItems option:selected").val();
            selectedItem.Name = $("#ddlItems option:selected").text();
            rowCount = $("#divMemberPointsDefMain").attr("data-RecordPerPage");
            if (navigationClick == 0) {
                FCommon.UI.enableButton(false, "btnItemPrevious");
                FCommon.UI.enableButton(false, "btnItemFirst");

                if ($("#rbGroupwise").prop("checked") == true)
                    var data = MEMBERPOINTSDEFINITION.SERVERMETHODS.populateTreeGroupWise(selectedItem);
                //    await GetNextProductsGroup();

                //When user clicks on first button next button should be enabled if the toal row count is less than or equal to current count
                if (data.TotalRow <= data.RowCount) {
                    FCommon.UI.enableButton(false, "btnItemNext");
                    FCommon.UI.enableButton(false, "btnItemLast");
                }
                else {
                    FCommon.UI.enableButton(true, "btnItemNext");
                    FCommon.UI.enableButton(true, "btnItemLast");
                }
            }
            else if (navigationClick == 1) {
                data.RowNumber = data.RowNumber + data.RowCount;

                FCommon.UI.enableButton(true, "btnItemPrevious");
                FCommon.UI.enableButton(true, "btnItemFirst");

                if ($("#rbGroupwise").prop("checked") == true)
                    var data = MEMBERPOINTSDEFINITION.SERVERMETHODS.populateTreeGroupWise(selectedItem);

                if (data.TotalRow <= (data.RowNumber + 50))
                    FCommon.UI.enableButton(false, "btnItemNext");
            }
            else if (navigationClick == 2) {
                FCommon.UI.enableButton(true, "btnItemNext");
                FCommon.UI.enableButton(true, "btnItemLast");

                data.RowNumber = data.RowNumber - data.RowCount;

                if (data.RowNumber == 0)
                    FCommon.UI.enableButton(false, "btnItemPrevious");

                if ($("#rbGroupwise").prop("checked") == true)
                    var data = MEMBERPOINTSDEFINITION.SERVERMETHODS.populateTreeGroupWise(selectedItem);
                //  await GetNextProductsGroup();
            }
            else if (navigationClick == 3) {
                var pages = 0;

                if (data.TotalRow % data.RowCount == 0)
                    pages = data.TotalRow / data.RowCount;
                else
                    pages = (data.TotalRow / rowCount) + 1;

                data.RowNumber = (pages - 1) * rowCount + 1;

                FCommon.UI.enableButton(false, "btnItemLast");
                FCommon.UI.enableButton(false, "btnItemNext");
                FCommon.UI.enableButton(true, "btnItemPrevious");
                FCommon.UI.enableButton(true, "btnItemFirst");
                if ($("#rbGroupwise").prop("checked") == true)
                    var data = MEMBERPOINTSDEFINITION.SERVERMETHODS.populateTreeGroupWise(selectedItem);
                //    await GetNextProductsGroup();}
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: MEMBERPOINTSDEFINITION.navigationButtonClickEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
