            if (memberData.ZipCode != null && memberData.ZipCode != undefined && memberData.ZipCode.trim() != ""
                && memberData.ZipCode.trim().length > 0 && memberData.ZipCode.trim() != "0") {
                sAddress = sAddress + msgZip + memberData.ZipCode;
            }

            if (memberData.Mobile != null && memberData.Mobile != undefined && memberData.Mobile.trim() != ""
                && memberData.Mobile.trim().length > 0 && memberData.Mobile.trim() != "0") {
                sAddress = sAddress + msgMobile + memberData.Mobile;
