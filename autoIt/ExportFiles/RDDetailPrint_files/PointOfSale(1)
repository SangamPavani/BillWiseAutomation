    updateSchemesToProductsExchangeSpoilage: function (ProductDetails, SchemesImplementedProds, posProductType) {
        try {
            let multiplicationfactor = (posProductType == PosProductType.get("NORMAL") ? 1 : -1);

            for (let i = 0; i < SchemesImplementedProds.length; i++) {
                if (SchemesImplementedProds[i].PromoType == PromoTypes.get("DISCOUNT")) {
                    let Products = ProductDetails.filter((p) => p.DefaultValue1 == SchemesImplementedProds[i].DefaultValue1 && p.ProductType == posProductType);
                    if (Products != null && Products != undefined && Products.length > 0) {
                        let gross = 0;
                        for (let j = 0; j < Products.length; j++)
                            gross = FConvert.toDecimal(gross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(Products[j].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                        if (Products.length > 1) {
                            for (let k = 0; k < Products.length; k++) //foreach(CustLineWise Product in Products)
                            {
                                if (gross != 0) {
                                    let ProportionateValue = (SchemesImplementedProds[i].DynamicLineFields[0].FieldInput * Products[k].DefaultValue5) / gross;
                                    if (ProportionateValue >= 0) {
                                        Products[k].DynamicLineFields[0].FieldInput = Products[k].DynamicLineFields[0].FieldValue = ProportionateValue;
                                    }
                                    else {
                                        Products[k].DefaultValue4 = Products[k].DefaultValue4 - ProportionateValue;
                                    }
                                    Products[k].IsManualDiscount = false;
                                    Products[k].PromoType = PromoTypes.get("DISCOUNT");

