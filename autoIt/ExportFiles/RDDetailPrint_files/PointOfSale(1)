                        else
                            dAmt = (subtotal * objSalesReturnWeb.DynamicFooterFields[k].FieldInput) / 100;
                    }

                    if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour != FieldBehaviour.get("RoundOff")) {
                        let dValueInDecimal = FConvert.toDecimal(dAmt).RoundOff(POSCommon.localCurrency.GeneralRoundOff, POSCommon.localCurrency.RoundOffType, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);
                        dAmt = FConvert.toDecimal(dValueInDecimal);
                    }

                    if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 1)
                        _net = _net + dAmt;
                    else if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 2)
                        _net = _net - dAmt;

                    if (objSalesReturnWeb.FooterCalculation == null || objSalesReturnWeb.FooterCalculation == undefined)
                        objSalesReturnWeb.FooterCalculation = new Object(); //new FooterCalculation();
                    if (objSalesReturnWeb.FooterCalculation.FooterExtraFields == null || objSalesReturnWeb.FooterCalculation.FooterExtraFields == undefined)
                        objSalesReturnWeb.FooterCalculation.FooterExtraFields = new Object(); //new List<IdValueCalculation>();

                    objSalesReturnWeb.FooterCalculation.FooterExtraFields.Id = objSalesReturnWeb.FooterFieldsList[k].FieldId;
                    objSalesReturnWeb.FooterCalculation.FooterExtraFields.Value = dAmt;
                }

                objSalesReturnWeb.FooterCalculation.UserWiseNet = FConvert.toDecimal(_net);
            }
            else
                objSalesReturnWeb.FooterCalculation.UserWiseNet = Convert.ToDouble(0);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
