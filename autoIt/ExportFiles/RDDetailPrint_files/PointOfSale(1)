    getRoundOffSign: function (_NetRoundOffPref, RoundOff) {
        try {

            var iSign = 1;
            switch (_NetRoundOffPref.RoundOffType) {
                case 1:
                    //Nearest
                    if (RoundOff != 0)
                        iSign = -1;
                    break;
                case 2:
                    //Up
                    if (RoundOff < 0)
                        iSign = -1;
                    break;
                case 3:
                    //Down
                    if (RoundOff > 0)
                        iSign = -1;
                    break;
            }
            return iSign;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: COMMONMETHODS.UTILITYMETHODS.getRoundOffSign, Catch block : Error Message : " + Ex.message);
        }
