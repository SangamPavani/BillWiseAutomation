                if (VOUCHERPOSTING.VARIABLES.PreOrderInfo != null && VOUCHERPOSTING.VARIABLES.PreOrderInfo != undefined && VOUCHERPOSTING.VARIABLES.PreOrderInfo.LocalPreOrderDetails != null && VOUCHERPOSTING.VARIABLES.PreOrderInfo.LocalPreOrderDetails != undefined) {
