                    ApplicationNew.TotalSchemesInfo.LinePrompts = LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts;
                    ApplicationNew.TotalSchemesInfo.SchemesAppliedMessage = strSchemesText;
                }
                else if (ESTIMATIONBILL.VARIABLES.LoadEstimatedVoucher == true) {
                    if (LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TransactionId != null && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TransactionId != undefined && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TransactionId > 0) {
                        if (ApplicationNew.TotalSchemesInfo == null || ApplicationNew.TotalSchemesInfo == undefined)
                            ApplicationNew.TotalSchemesInfo = new Object();
                        if (ApplicationNew.TotalSchemesInfo.LinePrompts == null || ApplicationNew.TotalSchemesInfo.LinePrompts == undefined || ApplicationNew.TotalSchemesInfo.LinePrompts.length <= 0)
                            ApplicationNew.TotalSchemesInfo.LinePrompts = [];

                        if (LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts != null && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts != undefined
                            && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts.length > 0) {
                            for (let i = 0; i < LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts.length; i++)
                                ApplicationNew.TotalSchemesInfo.LinePrompts.push(LOADTRANSACTION.VARIABLES.LoadPOSTransaction.CustTransSchemesApplied.TranSchemesPrompts[i]);
                        }
