                    r = $('<button id="' + i + '"class="btn btn-sm pagination-btn" style="width:40px;" data-StartNo="' + (iStartNumber + 1) + '" data-EndNo="' + (iRecordPerPage + iStartNumber) + '"data-functionId="' + iParentOrFunctionId + '" data-ParentId="' + iParentOrFunctionId + '" onclick=' + onClickString + '>' + i + '</button>');
                else
                    r = $('<button id="' + i + '"class="btn btn-sm pagination-btn" style="width:40px;" data-StartNo="' + (iStartNumber + 1) + '" data-EndNo="' + (iRecordPerPage + iStartNumber) + '"data-functionId="' + iParentOrFunctionId + '" data-ParentId="' + iParentOrFunctionId + '" onclick=' + onClickString + '>' + i + '</button>');

                //margin-left:3px; margin-right:3px; height:25px;
                if (isProductButtonCreating == 1) {
                    // Commentted By Ojha 
