            localPreOrderDetails.OrderOutletName = OPTIONCONTROL.getControlText("optPreOrderOutlet");
            localPreOrderDetails.ProductionOutlet = OPTIONCONTROL.getControlValue("optPreOrderProductionOutlet");
            var totalDeposit = FConvert.toDecimal(PREORDERDETAILS.COMMONMETHOD.getDeposit(), POSCommon.numberofDecimal);
            var enteredDeposit = FConvert.toDecimal($("#txtPreOrderDeposit").val(), POSCommon.numberOfDecimal);
            var orderStatus = 0;
            var nettAmount = $("#txtPreOrderNetAmount").val();
            if (nettAmount != null && nettAmount != undefined && nettAmount.trim().length > 0)
                nettAmount = FConvert.toDecimal(nettAmount, POSCommon.numberOfDecimal);

            ////debugger;
            if (preOrderStatus == 3 || preOrderStatus == 4 || preOrderStatus == 5) //if PreOrderStatus is FinalPayment/Collected/Cancelled 
                localPreOrderDetails.Status = preOrderStatus;
            else {
                if (totalDeposit != null && totalDeposit != undefined) {
                    if (totalDeposit == 0)
                        orderStatus = 1;
                    else if (totalDeposit < FConvert.toDecimal(nettAmount))
                        orderStatus = 2;
                    else if (totalDeposit == FConvert.toDecimal(nettAmount))
                        orderStatus = 3;
                }

                localPreOrderDetails.Status = orderStatus;
            }

            //Non Member Details
            localPreOrderDetails.NonMemberName = $("#txtPreOrderNonMemberName").val();
            localPreOrderDetails.PhoneNumber = $("#txtPreOrderNonMemberPhoneNumber").val();

            //Collection Details
            localPreOrderDetails.CollectionDateDT = DATEPICKER.getDate("dpPreOrderCollectionDate");
            localPreOrderDetails.CollectionTimeInt = FTIMECONTROL.getTime("tpPreOrderCollectionTime");
            localPreOrderDetails.CollectionOutletId = OPTIONCONTROL.getControlValue("optPreOrderCollectionOutlet");
