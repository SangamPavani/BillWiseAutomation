    getUpdatedCardDetails: function (bFromReview, DayEndGlobalObject) {
        try {
            let msgExceptionWhileReadingModelObject = $("input#msgExceptionWhileReadingModelObject").val();
            let msgExchangeRateIsNotDefinedForCurrency = $("input#msgExchangeRateIsNotDefinedForCurrency").val();

            // Get Currency Details For CashIn Drawer
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == true) {
                DayEndGlobalObject.DayInPos.CurrencyDetails = DAYEND.getCurrencyDetails();
                //var DayEndGlobalObject = $("#divDayEndMain").attr("data-ModelRecord");
                //if (DayEndGlobalObject == null || DayEndGlobalObject == undefined || DayEndGlobalObject.trim().length <= 0) {
                //    toastr.error(msgExceptionWhileReadingModelObject);
                //    return;
                //}

                //DayEndGlobalObject = JSON.parse(DayEndGlobalObject);

                let dActualAmountInBaseCurrency = 0;
                if (DayEndGlobalObject.DayInPos.CurrencyDetails != null && DayEndGlobalObject.DayInPos.CurrencyDetails != undefined &&
                    DayEndGlobalObject.DayInPos.CurrencyDetails.length > 0) {
                    for (let i = 0; i < DayEndGlobalObject.DayInPos.CurrencyDetails.length; i++) {
                        let objExchangeRateBody = DayEndGlobalObject.ExchangeRate.filter((p) => p.CurrencyId == DayEndGlobalObject.DayInPos.CurrencyDetails[i].CurrencyId);
                        if (objExchangeRateBody.length == 0) {
                            if (DayEndGlobalObject.DayInPos.CurrencyDetails[i].IsBaseCurrency == true)
                                dActualAmountInBaseCurrency = dActualAmountInBaseCurrency + (DayEndGlobalObject.DayInPos.CurrencyDetails[i].ReportedAmount * 1);

                            if (DayEndGlobalObject.DayInPos.CurrencyDetails[i].ReportedAmount > 0 && DayEndGlobalObject.DayInPos.CurrencyDetails[i].IsBaseCurrency == false) {
                                toastr.success(msgExchangeRateIsNotDefinedForCurrency + " " + DayEndGlobalObject.DayInPos.CurrencyDetails[i].CurrencyName);
                                return;
                            }
                            continue;
                        }
                        dActualAmountInBaseCurrency = FConvert.toDecimal(dActualAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal((DayEndGlobalObject.DayInPos.CurrencyDetails[i].ReportedAmount * objExchangeRateBody[0].Rate), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                    }
                }

                if (bFromReview)
                    $("#txtCashInDrawer").val(FConvert.toDecimal(dActualAmountInBaseCurrency, POSCommon.numberOfDecimal));
                else
                    $("#txtCashInDrawer").val(FConvert.toDecimal(dActualAmountInBaseCurrency, POSCommon.numberOfDecimal));
            }

            //Get Cardwise Details
            DayEndGlobalObject.DayInPos.CardWiseAmountSummary = [];
            DayEndGlobalObject.DayInPos.CardWiseAmount = [];

            var tBodyCardWiseAmount = $("#tBodyCardWiseAmount > tr"), lstCardWiseAmount = [];
            if (tBodyCardWiseAmount != null && tBodyCardWiseAmount != undefined && tBodyCardWiseAmount.length > 0) {
                for (let i = 0; i < tBodyCardWiseAmount.length; i++) {
                    var cardWiseAmountRecord = $(tBodyCardWiseAmount[i]).attr('data-CardWiseAmount');
                    if (cardWiseAmountRecord != null && cardWiseAmountRecord != undefined && cardWiseAmountRecord.length > 0)
                        DayEndGlobalObject.DayInPos.CardWiseAmount.push(JSON.parse(cardWiseAmountRecord));
                }

                if (DayEndGlobalObject.DayInPos.CardWiseAmount != null && DayEndGlobalObject.DayInPos.CardWiseAmount != undefined && DayEndGlobalObject.DayInPos.CardWiseAmount.length > 0) {
                    for (let i = 0; i < DayEndGlobalObject.DayInPos.CardWiseAmount.length; i++) {
                        var cardSummary = new Object();
                        cardSummary.MasterId = FConvert.toInt(DayEndGlobalObject.DayInPos.CardWiseAmount[i].MasterId, POSCommon.numberOfDecimal);
                        cardSummary.ActualAmount = FConvert.toDecimal(DayEndGlobalObject.DayInPos.CardWiseAmount[i].CardAmount, POSCommon.numberOfDecimal);
                        cardSummary.ReportedAmount = FConvert.toDecimal(DayEndGlobalObject.DayInPos.CardWiseAmount[i].Amount, POSCommon.numberOfDecimal);
                        cardSummary.DiffAmount = FConvert.toDecimal(DayEndGlobalObject.DayInPos.CardWiseAmount[i].DiffAmount, POSCommon.numberOfDecimal);
                        cardSummary.CardCharges = FConvert.toDecimal(DayEndGlobalObject.DayInPos.CardWiseAmount[i].CardCharges, POSCommon.numberOfDecimal);
                        cardSummary.Type = DayEndGlobalObject.DayInPos.CardWiseAmount[i].CardName;
                        cardSummary.EodDiffAcc = FConvert.toInt(DayEndGlobalObject.DayInPos.CardWiseAmount[i].EodDiffAccId);
                        cardSummary.BankAccId = FConvert.toInt(DayEndGlobalObject.DayInPos.CardWiseAmount[i].BankAccId);
                        cardSummary.CardType = DayEndGlobalObject.DayInPos.CardWiseAmount[i].CardType;

                        DayEndGlobalObject.DayInPos.CardWiseAmountSummary.push(cardSummary);
                    }
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: DAYEND.getUpdatedCardDetails :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
