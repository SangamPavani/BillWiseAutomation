                                SchemesImplementedProds[i].DefaultValue3 = COMMONMETHODS.UTILITYMETHODS.toCompanyDecimal(passingArgs.QtyOrPrice, true, true);
                                POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.getQtyInBaseOrRateInSales_Units_CustlineWiseScheme(SchemesImplementedProds[i], passingArgs, false); //ref dRate
                                SchemesImplementedProds[i].DefaultValue4 = COMMONMETHODS.UTILITYMETHODS.toCompanyDecimal(passingArgs.QtyOrPrice, true, true);
                            }
                        }
                    }
                }
            }

            if (SchemesImplementedProds != null && SchemesImplementedProds != undefined && SchemesImplementedProds.length > 0) {
                for (let ic = 0; ic < SchemesImplementedProds.length; ic++) {
                    if (SchemesImplementedProds[ic].DefaultValue3 <= 0) {
                        let deletedItems = ApplicationNew.ListOfItems.filter((p) => p.DefaultValue1 == SchemesImplementedProds[ic].DefaultValue1 && p.DefaultValue4 == SchemesImplementedProds[ic].DefaultValue4 && p.ProductUnit == SchemesImplementedProds[ic].SalesUnit);
