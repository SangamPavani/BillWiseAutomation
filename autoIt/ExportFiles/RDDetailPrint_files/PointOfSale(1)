    checkCreditSalePendingAmount: function () {
        try {
            var dRefundCanGive = SALESRETURN.VARIABLES.moduleType == 1 ? Math.abs(RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.ReturnedNetAmount) : Math.abs(ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount);
            var dCreditSaleToAdjSameSI = 0, dCreditSalePendingAdjustment = 0;
            var saleReturnWeb = SALESRETURN.VARIABLES.moduleType == 1 ? RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb : ApplicationNew.SalesReturn.SalesReturnWeb;
            let arrCount = null, creditSalePaymentNotExists = saleReturnWeb.CreditNotePaymentTypes.filter((p) => p == PaymentTypes.get("CREDITSALE"));

            if (creditSalePaymentNotExists != null && creditSalePaymentNotExists != undefined && creditSalePaymentNotExists.length > 0)
                creditSalePaymentNotExists = true;

            if (saleReturnWeb.CreditSaleDetail != null && saleReturnWeb.CreditSaleDetail != undefined) {
                if (saleReturnWeb.CreditSaleDetail.AdjustedAmount == 0 || (saleReturnWeb.CreditSaleDetail.CrSaleAmount - saleReturnWeb.CreditSaleDetail.AdjustedAmount > 0) || saleReturnWeb.CreditSaleDetail.CreditPending > 0) {
                    if (saleReturnWeb.CreditSaleDetail.CrSaleAmount - saleReturnWeb.CreditSaleDetail.AdjustedAmount > 0) {
                        if ((saleReturnWeb.CreditSaleDetail.CrSaleAmount - saleReturnWeb.CreditSaleDetail.AdjustedAmount) <= dRefundCanGive) {
                            dCreditSaleToAdjSameSI = (saleReturnWeb.CreditSaleDetail.CrSaleAmount - saleReturnWeb.CreditSaleDetail.AdjustedAmount);
                            dRefundCanGive -= dCreditSaleToAdjSameSI;
                        }
                        else {
                            dCreditSaleToAdjSameSI = dRefundCanGive;
                            dRefundCanGive = 0;
                        }
                    }
                    if (dRefundCanGive > 0 && (saleReturnWeb.CreditSaleDetail.CreditPending - dCreditSaleToAdjSameSI) > 0) {
                        dCreditSalePendingAdjustment = (saleReturnWeb.CreditSaleDetail.CreditPending - dCreditSaleToAdjSameSI);
                        if (dCreditSalePendingAdjustment >= dRefundCanGive) {
                            dCreditSalePendingAdjustment = dRefundCanGive;
                            dRefundCanGive = 0;
                        }
                        else
                            dRefundCanGive -= (saleReturnWeb.CreditSaleDetail.CreditPending - dCreditSaleToAdjSameSI);
                    }

                    if (SALESRETURN.VARIABLES.moduleType == 1) {
                        RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSaleToAdjustSaleInvoice = dCreditSaleToAdjSameSI;
                        RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSalePendingAdjustment = dCreditSalePendingAdjustment;
                        RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.ReturnedNetAmount = dRefundCanGive;
                        RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn = false;
                    }
                    else {
                        ApplicationNew.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSaleToAdjustSaleInvoice = dCreditSaleToAdjSameSI;
                        ApplicationNew.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSalePendingAdjustment = dCreditSalePendingAdjustment;
                        ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount = dRefundCanGive;
                        ApplicationNew.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn = false;
                    }
                }
            }
            else if ((saleReturnWeb.CreditSaleDetail === null || saleReturnWeb.CreditSaleDetail == undefined)
                && saleReturnWeb.CreditNotePaymentTypes != null && saleReturnWeb.CreditNotePaymentTypes != undefined
                && saleReturnWeb.CreditNotePaymentTypes.length > 0) {
                var msgSRPrepaidTopupReturn = $("#msgSRPrepaidTopupReturn").val();
                arrCount = saleReturnWeb.CreditNotePaymentTypes.filter((p) => p == PaymentTypes.get("PREPAIDTOPUP"));
                if (arrCount != null && arrCount != undefined && arrCount.length > 0) {
                    toastr.success(msgSRPrepaidTopupReturn);
                    if (SALESRETURN.VARIABLES.moduleType == 1)
                        RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn = true;
                    else
                        ApplicationNew.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn = true;
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: SALESRETURN.checkCreditSalePendingAmount :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            if (SALESRETURN.VARIABLES.moduleType == 1) {
                RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSaleToAdjustSaleInvoice = -1;
                RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSalePendingAdjustment = -1;
                RESTAURANTMAINSCREEN.VARIABLES.ApplicationRestaurant.SalesReturn.SalesReturnWeb.ReturnedNetAmount = -1;
            }
            else {
                ApplicationNew.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSaleToAdjustSaleInvoice = -1;
                ApplicationNew.SalesReturn.SalesReturnWeb.CreditSaleDetail.CreditSalePendingAdjustment = -1;
                ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount = -1;
            }
        }
    },
