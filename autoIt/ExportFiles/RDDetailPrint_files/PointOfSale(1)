    implementSchemesDefinedInMemberDiscScreenByScheme: function (MemberDiscountScheme, BillValue, FromScreen, Prompts, LineList, DoChanges) {
        try {
            //There will be only one Payment type each in Payments collection
            let _Data = MemberDiscountScheme.Members.filter((f) => f.MemberType == POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MemberTypeId);
            if (_Data != null && _Data != undefined && _Data.length > 0) {
                _Data = _Data[0];
                let _IsCriteriaSatisfied = false;
                let _baseItems = [];
                if (_Data.MandatoryItemsList != null && _Data.MandatoryItemsList != undefined && _Data.MandatoryItemsList.length > 0)
                    _IsCriteriaSatisfied = POSSCHEMEIMPLEMENTATIONGENERICS.sD_IsCriteriaSatisfied(_Data.MndtryItemsFlag, _Data.MandatoryItemsList, LineList, _baseItems);

                else
                    _IsCriteriaSatisfied = true;

                if (_IsCriteriaSatisfied == true) {
                    let _Value = 0;
                    if (_Data.DiscType == 1)//Percentage
                    {
                        _Value = POSSCHEMEIMPLEMENTATIONGENERICS.CALCULATION.convertPercentageToValue(_Data.Discount, BillValue);
                    }
                    else if (_Data.DiscType == 2)//Amount
                    {
                        _Value = _Data.Discount;
                    }
                    if (MemberDiscountScheme.DiscountApplyType == 4 && _Data.RecurrenceType != 0) {
                        if (_Data.MaxAmount > 0) {
                            let arrayMemberPrompt = POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MemberPrompts.filter((p) => p.SchemeId == MemberDiscountScheme.ID && p.BodyId == _Data.Id)
                            if (_Data.DiscountGiven > 0 && arrayMemberPrompt != null && arrayMemberPrompt != undefined && arrayMemberPrompt.length > 0) {
                                //for loop of arrayMemberPrompt : Add .Amount
                                let Discount = 0;
                                for (let i = 0; i < arrayMemberPrompt.length; i++)
                                    Discount = FConvert.toDecimal(Discount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(arrayMemberPrompt[i].Amount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)

                                _Data.DiscountGiven -= FConvert.toDecimal(Discount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                            }
                            let AllowedDiscount = (FConvert.toDecimal(_Data.MaxAmount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(_Data.Discount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / 100;

                            let discountLeft = FConvert.toDecimal(AllowedDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(_Data.DiscountGiven, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                            if (discountLeft <= 0)
                                return;
                            if (discountLeft < _Value) {
                                _Value = FConvert.toDecimal(discountLeft, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                            }
                        }
                    }
                    let unit = 0; //Hardcoded as MemberType Discount will not have Units
                    POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts(FromScreen, "", 0, "", MemberDiscountScheme.ID, MemberDiscountScheme.Name, _Value, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, _Data.Id, 0, _baseItems, PaymentTypes.get("DUMMY"), 0, unit, false, null);
                    POSSCHEMEIMPLEMENTATIONGENERICS.doChangesInBilling(LineList, DoChanges);
