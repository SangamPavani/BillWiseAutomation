            //Screen Data 
            if (_NewLineList[ProductCounter].DynamicLineFields != null && _NewLineList[ProductCounter].DynamicLineFields != undefined && _NewLineList[ProductCounter].DynamicLineFields.length > 0) {
                for (let k = 0; k < _NewLineList[ProductCounter].DynamicLineFields.length; k++) {
                    if (i == 0) {
                        _loadingProduct.DynamicLineFields[k] = new object();
                        _loadingProduct.DynamicLineFields[k].FieldId = _NewLineList[ProductCounter].DynamicLineFields[k].FieldId;
                        _loadingProduct.DynamicLineFields[k].FieldColMap = _NewLineList[ProductCounter].DynamicLineFields[k].FieldColMap;
                    }
                    let retailBodyField = BodyPanelExtraFieldsList.filter((p) => p.ColMap == _NewLineList[ProductCounter].DynamicLineFields[k].FieldColMap);
