    applyDiscountAmt_Scheme_OnItem: function (Scheme, SDD, FromScreen, MultiplyValue, Prompts, LineList, DoChanges) {
        try {
            let _MandatoryItemsMatchedInBill = POSSCHEMEIMPLEMENTATIONGENERICS.getItemsMatchedInBill(SDD.MandatoryItemsList, false, SDD);

            /**Logic to Calculate Discount Amount**/
            /*
                 * Suppose say there are there products matched say P1 - 400(Gross) , P2 - 200 , P3 - 200
                 * And the discount to be given is Rs 10
                 * Then calculate the each share value
                 * 
                 * Formula :  (Each Product Gross * Discount Value) / (Sum of Gross of all the three products)
                 * 
                 * 
                 */

            let _DiscToBeGiven = FConvert.toDecimal(SDD.DiscountD, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(MultiplyValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            if (SDD.MaxDiscountAllowed > 0 && _DiscToBeGiven > FConvert.toDecimal(SDD.MaxDiscountAllowed, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) {
                _DiscToBeGiven = FConvert.toDecimal(SDD.MaxDiscountAllowed, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            }

            let _MatchedItemsGross = 0;

            for (let i = 0; i < _MandatoryItemsMatchedInBill.length; i++)
                _MatchedItemsGross = FConvert.toDecimal(_MatchedItemsGross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(_MandatoryItemsMatchedInBill[i].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);

            let passingArgs = new Object();
            passingArgs.ProportionatedDiscount = 0;
            for (let j = 0; j < _MandatoryItemsMatchedInBill.length; j++) {
                let _ProportionateValue = (FConvert.toDecimal(_MandatoryItemsMatchedInBill[j].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(_DiscToBeGiven, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(_MatchedItemsGross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);

                passingArgs.discountAmt = _ProportionateValue;
                let iProductId = _MandatoryItemsMatchedInBill[j].DefaultValue1;
                if (_MandatoryItemsMatchedInBill[j].ProductMake == 1)
                    iProductId = _MandatoryItemsMatchedInBill[j].ParentId;
                POSSCHEMEIMPLEMENTATIONGENERICS.checkProportionateValueAndAdjustIfAnyDecimalIssue(SDD.DiscountD * MultiplyValue, passingArgs);// ref ProportionatedDiscount, ref discountAmt
                POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts(FromScreen, "", iProductId, _MandatoryItemsMatchedInBill[j].DefaultValue2, Scheme.ID, Scheme.Name, passingArgs.discountAmt, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, SDD.Id, _MandatoryItemsMatchedInBill[j].ProductMake, _MandatoryItemsMatchedInBill, PaymentTypes.get("DUMMY"), 0, _MandatoryItemsMatchedInBill[j].ProductUnit, _MandatoryItemsMatchedInBill[j].DonotMaintainStockbyBatch, _MandatoryItemsMatchedInBill[j]);
                POSSCHEMEIMPLEMENTATIONGENERICS.doChangesInBilling(LineList, DoChanges);
            }
        }
