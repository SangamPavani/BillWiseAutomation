    isValidCreditNote: function (bIsDisplayMessage) {
        try {
            var optCreditNoteNum = OPTIONCONTROL.getControlDataObject("optCreditNoteNumberId");
            var creditNoteValue = $.trim($("#txtCreditNoteValue").val());
            var strCreditNoteNum;
            var cNDetails = null;
            var msgCNAdded = $("#msgCNAdded").val();
            var msgEnterCreditNote = $("#msgEnterCreditNote").val();
            var msgCNExpired = $("#msgCNExpired").val();
            var msgEnterCRVal = $("#msgEnterCRVal").val();
            var msgCNValGrtThnZero = $("#msgCNValGrtThnZero").val();
            var msgBSCNAndBalComparison = $("#msgBSCNAndBalComparison").val();
            var msgBSCNAndBalComparison1 = $("#msgBSCNAndBalComparison1").val();
            var msgBSBalAmtExceeds = $("#msgBSBalAmtExceeds").val();
            var msgBalAmtZero = $("#msgBalAmtZero").val();

            if ($("#txtCreditNoteNumber").is(":visible")) {
                strCreditNoteNum = $.trim($("#txtCreditNoteNumber").val());
                if (strCreditNoteNum == null || strCreditNoteNum == undefined) {

                    toastr.error(msgEnterCreditNote);
                    BILLSETTLEMENT.clearCreditNoteFields();
                    return;
                }
            }
            else {
                var optCreditNoterNum = OPTIONCONTROL.getControlDataObject("optCreditNoteNumberId");
                strCreditNoteNum = optCreditNoterNum.CreditNoteNo;
                if (optCreditNoterNum == null || optCreditNoterNum == undefined || optCreditNoterNum.Id == null || optCreditNoterNum.Id == undefined || optCreditNoterNum.Id == 0) {

                    toastr.error(msgEnterCreditNote);
                    BILLSETTLEMENT.clearCreditNoteFields();
                    return;
                }
            }
            if (BillSettlement.BalanceAmount <= 0) {
                toastr.error(msgBalAmtZero);
                BILLSETTLEMENT.clearCreditNoteFields();
                return false;
            }
            else if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != null
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length > 0) {

                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length; i++) {
                    if ($("#txtCreditNoteNumber").is(":visible")) {
                        var creditNoteId = $("#txtCreditNoteNumber").attr("data-Tag");
                        if (creditNoteId != null && creditNoteId != undefined && creditNoteId.length > 0) {
                            creditNoteId = FConvert.toInt(creditNoteId);
                            cNDetails = BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.filter((p) => p.Id == creditNoteId);
                            if (cNDetails != null && cNDetails != undefined && cNDetails.length > 0) {
                                cNDetails = cNDetails[0];
                                toastr.error(msgCNAdded);
                                return false;
                            }
                        }
                    }
                    else {
                        var optCreditNoteId = $("input#optCreditNoteNumberId").attr('data-Tag');
                        if (optCreditNoteId != null && optCreditNoteId != undefined && optCreditNoteId.length > 0) {
                            optCreditNoteId = FConvert.toInt(optCreditNoteId);
                            cNDetails = BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.filter((p) => p.Id == optCreditNoteId);
                            if (cNDetails != null && cNDetails != undefined && cNDetails.length > 0) {
                                cNDetails = cNDetails[0];
                                toastr.error(msgCNAdded);
                                return false;
                            }
                        }
                    }
                }
            }

            else if (DATEPICKER.getDate(dtpCreditNoteExpiryDate) < DATE.prototype.today(POSCommon.CalType)) {
                toastr.error(msgCNExpired);
                return false;
            }
            else if (FConvert.toDecimal(creditNoteValue) == 0) {
                toastr.error(msgEnterCRVal);
                return false;
            }
            else if (FConvert.toDecimal(creditNoteValue) == 0) {
                toastr.error(msgCNValGrtThnZero);
                return false;
            }
            if (FConvert.toDecimal($("#txtCreditNoteValue").val()) > BillSettlement.BalanceAmount) {
                toastr.error(msgBSCNAndBalComparison);
                $("#txtCreditNoteValue").focus();
                return false;
            }
            if (FConvert.toDecimal($("#txtCreditNoteValue").val()) > ($("#txtCreditNoteValue").attr("data-Tag"))) {
                toastr.error(msgBSCNAndBalComparison1);
                return false;
            }
            else if (BillSettlement.BalanceAmount <= 0) {
                toastr.error(msgBSBalAmtExceeds);
                return false;
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.isValidCreditNote, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
