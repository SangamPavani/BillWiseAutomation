    assignDefaultValueInExtraField: function () {
        try {
            if (VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields == null || VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields == undefined || VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields.length <= 0) {
                VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields = [];

                const arrJournalVoucherDateField = VOUCHERPOSTING.SINGLTONVARIABLES.JournalVoucherExtraFields.filter((p) => p.iDataTypeId == MasterDataType.get("DATE"))

                if (arrJournalVoucherDateField != null && arrJournalVoucherDateField != undefined && arrJournalVoucherDateField.length > 0) {
                    for (let i = 0; i < arrJournalVoucherDateField.length; i++) {
                        if ((arrJournalVoucherDateField[i].iFieldId & eVTFIELDFLAG.LAY_HDR) == eVTFIELDFLAG.LAY_HDR) {
                            const arrField = VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields.filter((p) => p.Name == arrJournalVoucherDateField[i].sFieldName);
                            if (arrField == null || arrField == undefined || arrField.length <= 0) {
                                const idNamePair = new Object();
                                idNamePair.ID = arrJournalVoucherDateField[i].iFieldId;
                                idNamePair.Name = arrJournalVoucherDateField[i].sFieldName;
                                idNamePair.Tag = DATE.prototype.today(POSCommon.CalType);
                                VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields.push(idNamePair);
                            }
                        }
                    }
                }
            }
            else {
                for (let i = 0; i < VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields.length; i++) {

                    const arrField = VOUCHERPOSTING.SINGLTONVARIABLES.JournalVoucherExtraFields.filter((p) => p.sFieldName == VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields[i].Name);
                    if (arrField != null && arrField != undefined && arrField.length > 0) {
                        switch (arrField[0].iDataTypeId) {
                            case MasterDataType.Text:
                                arrField[0].Tag = "";
                                break;
                            case MasterDataType.Master:
                            case MasterDataType.Number:
                            case MasterDataType.Time:
                            case MasterDataType.Fraction:
                            case MasterDataType.NumberList:
                                arrField[0].Tag = 0;
                                break;
                            case MasterDataType.Date:
                                arrField[0].Tag = DATE.prototype.today(POSCommon.CalType);
                                break;
                            case MasterDataType.Boolean:
                                arrField[0].Tag = 0;
                                break;
                        }
                    }
                    else
                        arrField[0].Tag = "";
                }
            }
            VOUCHEREXTRAFIELD.fillJournalVoucherExtraFields();

            return true;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHEREXTRAFIELD.assignDefaultValueInExtraField :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return false;
        }
    },
    fillBillSettlementExtraFieldValue: function (arrVoucherFldInfo, voucherField, value, billSettlementExtraFields) {
        try {
            const iFieldUniqueId = VOUCHERHEADEREXTRAFIELD.getVoucherHeaderExtraFieldId(arrVoucherFldInfo, voucherField);
            if (iFieldUniqueId == 0)
                return false;
            else {
                let data = [];
                if (billSettlementExtraFields != null && billSettlementExtraFields != undefined && billSettlementExtraFields.length > 0) {
                    data = billSettlementExtraFields.filter((p) => p.Name == voucherField.sFieldName);
                    if (data == null || data == undefined || data.length <= 0) {
                        data = new Object();
                        data.ID = iFieldUniqueId;
                        data.Tag = value;
                        data.Name = voucherField.sFieldName;
                        billSettlementExtraFields.push(data);
                    }
                    else
                        data[0].Tag = value;
                }
                else {
                    billSettlementExtraFields = [];
                    data = new Object();
                    data.ID = iFieldUniqueId;
                    data.Tag = value;
                    data.Name = voucherField.sFieldName;
                    billSettlementExtraFields.push(data);
