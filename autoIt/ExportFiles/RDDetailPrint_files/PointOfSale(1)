                        }

                        if (ApplicationNew.CopyToAllRows == true || ApplicationNew.ProportionateToAllRows == true) {
                            ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dCurrentCellEnteredValue;
                            ApplicationNew.CurrentItem.IsManualDiscount = true;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            PRODUCTSELECTION.callCopyOrProportionateToAllRows(ApplicationNew.CurrentItem.ItemSerialNo - 1, dCurrentCellEnteredValue, true, ApplicationNew, objColumnRecord);

                            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[i], ApplicationNew);
                        }
                        else {
                            ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dCurrentCellEnteredValue;
                            ApplicationNew.CurrentItem.IsManualDiscount = true;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            PRODUCTSELECTION.callCopyOrProportionateToAllRows(ApplicationNew.CurrentItem.ItemSerialNo - 1, dCurrentCellEnteredValue, true, ApplicationNew, objColumnRecord);
                            CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                        }
                    }

                    // Check Discount Authorization
                    let rtnValue = [];
                    ////debugger;//21
                    rtnValue = CHECKDISCOUNTAUTHORIZATION.checkDiscountAuthorization(1006);
                    if (rtnValue != null && rtnValue != undefined && rtnValue.length > 0) {
                        if (rtnValue.length > 4 && rtnValue[3] == true && FConvert.toString(rtnValue[4]) != null && FConvert.toString(rtnValue[4]) != undefined && rtnValue[5] > 0) {
                            //TABLECHANGEMETHODSNEW.VARIABLES.dDiscAllowedPerTrans = rtnValue[5];
                            responseDiscountCellValue[0] = true;
                            responseDiscountCellValue[2] = "MESSAGEBOX";
                            responseDiscountCellValue[3] = false;
                            responseDiscountCellValue[4] = rtnValue[4];
                            responseDiscountCellValue[5] = rtnValue[5];
                            return responseDiscountCellValue;
                        }
                        else if (rtnValue.length > 4 && rtnValue[3] == true && rtnValue[4] != null && rtnValue[4] != undefined && rtnValue[4].trim().length > 0 && rtnValue[5] == 0) {
                            responseDiscountCellValue[0] = true;
                            responseDiscountCellValue[2] = "OK";
                            responseDiscountCellValue[3] = false;
                            responseDiscountCellValue[4] = rtnValue[4];
                            responseDiscountCellValue[5] = rtnValue[5];
                            return responseDiscountCellValue;
                        }

                        if (FConvert.toBoolean(rtnValue[0]) == true) {
                            if (FConvert.toBoolean(rtnValue[1]) == true) {
                                responseDiscountCellValue[0] = true;
                                responseDiscountCellValue[2] = "MANAGERAPPROVALDISCOUNTAUTHORIZATION";
                                return responseDiscountCellValue;
                            }
                        }
                        else if (FConvert.toBoolean(rtnValue[1]) == false) {
                            ApplicationNew.MaxDiscAllowedPerTrans = true;
                            ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            if (IsFromCopyOrProp == true) {
                                ApplicationNew.CopyToAllRows = true;
                                PRODUCTSELECTION.callCopyOrProportionateToAllRows(ApplicationNew.CurrentItem.ItemSerialNo - 1, 0, false, ApplicationNew, objColumnRecord);
                            }
                            CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                            responseDiscountCellValue[0] = true;
                            responseDiscountCellValue[1] = rtnValue[2];
                        }
                    }

                    responseDiscountCellValue[0] = true;
                    return responseDiscountCellValue;
                }
                //Discount according to Column behavior(percentage, etc)
                if (dCurrentCellEnteredValue > 100) {
                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    responseDiscountCellValue[0] = true;
                    responseDiscountCellValue[1] = msgDiscountCannotBeGreaterThanGross;
                    return responseDiscountCellValue;
                }

                // Asking for User verification, Manager approval if it is set for 'Discount Line Item' shortcut button
                if (dCurrentCellEnteredValue > 0) {
                    // User Verification(if it is set for 'Discount Line Item' shortcut button)
                    let isUserVerificationRequired = COMMONMETHODS.userVerificationRequired(28);
                    if (isUserVerificationRequired == true) {
                        let objApprovalRecord = null;
                        if (ApplicationNew.UserVerification != null && ApplicationNew.UserVerification != undefined) {
                            objApprovalRecord = ApplicationNew.UserVerification.filter((p) => p.ShortcutId == 1057);
                        }
                        if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord <= 0) {
                            responseDiscountCellValue[0] = true;
                            responseDiscountCellValue[1] = msgUserApprovalRequired;
                            responseDiscountCellValue[2] = "USERAPPROVALDISCOUNTFIELD";
                            return responseDiscountCellValue;
                        }
                        else if (objApprovalRecord != null && objApprovalRecord != undefined && objApprovalRecord[0].Approved == false) {
                            ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            responseDiscountCellValue[0] = true;
                            return responseDiscountCellValue;
                        }
                    }

                    // Manager Approval(if it is set for 'Discount Line Item' shortcut button)
                    let isManagerApprovalRequired = COMMONMETHODS.managerApprovalRequired(28);
                    if (isManagerApprovalRequired == true) {
                        ApplicationNew.ApprovedBy = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.getActionApprovedByIfExists(ApplicationNew.CurrentItem, ApplicationNew.RetailTransFooter, false, PosActionIds.get("DISCOUNTLINEITEM"));
                        let objApprovalRecord = null;
                        if (ApplicationNew.ManagerApproval != null && ApplicationNew.ManagerApproval != undefined) {
                            objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == 1058);
                        }
                        if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord <= 0) {
                            responseDiscountCellValue[0] = true;
                            responseDiscountCellValue[1] = msgManagerApprovalRequired;
                            responseDiscountCellValue[2] = "MANAGERAPPROVALDISCOUNTFIELD";
                            return responseDiscountCellValue;
                        }
                        else if (objApprovalRecord != null && objApprovalRecord != undefined && objApprovalRecord[0].Approved == false) {
                            ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            responseDiscountCellValue[0] = true;
                            return responseDiscountCellValue;
                        }
                        PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(ApplicationNew.CurrentItem, ApplicationNew);
                    }
                }

                if (dCurrentCellEnteredValue <= 0) {
                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = 0;
                    ApplicationNew.CurrentItem.IsManualDiscount = false;
                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                    responseDiscountCellValue[0] = true;
                    return responseDiscountCellValue;
                }

                ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dCurrentCellEnteredValue;
                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;

                //Validating Average Purchase Rate & Price Book Rate
                let objApprovalRecord = null;
                if (POSCommon.requiredManagerApproval == true) {
                    if (ApplicationNew.ManagerApproval == null || ApplicationNew.ManagerApproval == undefined || ApplicationNew.ManagerApproval.length <= 0)
                        ApplicationNew.ManagerApproval = [];

                    objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == 1050);
                }

                if (objApprovalRecord == null || objApprovalRecord.length <= 0 || objApprovalRecord.ApprovalId <= 0) {
                    if (POSCommon.averagePurchasePrice == true) {
                        let rtnAvgPrice = [];
                        rtnAvgPrice = PRODUCTSELECTION.validateDiscountWithAveragePurchasePrice(ApplicationNew.CurrentItem, 1050);
                        if (rtnAvgPrice != null && rtnAvgPrice != undefined && rtnAvgPrice.length > 0) {
                            if (rtnAvgPrice[0] != null && rtnAvgPrice[0] != undefined) {
                                if (FConvert.toBoolean(rtnAvgPrice[0]) == false) {
                                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                                    responseDiscountCellValue[1] = rtnAvgPrice[1];
                                    return responseDiscountCellValue;
                                }
                                else if (FConvert.toBoolean(rtnAvgPrice[0]) == true && rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined) {
                                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                                    CALCULATION.calculateFooter(ApplicationNew);
                                    responseDiscountCellValue[0] = rtnAvgPrice[0];
                                    responseDiscountCellValue[2] = rtnAvgPrice[1];
                                    return responseDiscountCellValue;
                                }
                            }
                        }
                    }
                    else {
                        let rtnPriceBookRate = [];
                        rtnPriceBookRate = PRODUCTSELECTION.validateDiscountWithPriceBookRate(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], 1050);
                        if (rtnPriceBookRate != null && rtnPriceBookRate != undefined && rtnPriceBookRate.length > 0) {
                            if (rtnPriceBookRate[0] != null && rtnPriceBookRate[0] != undefined) {
                                if (FConvert.toBoolean(rtnPriceBookRate[0]) == false) {
                                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                                    responseDiscountCellValue[0] = rtnPriceBookRate[0];
                                    responseDiscountCellValue[1] = rtnPriceBookRate[1];
                                    return responseDiscountCellValue;
                                }
                                else if (FConvert.toBoolean(rtnPriceBookRate[0]) == true && FConvert.toString(rtnPriceBookRate[1]) != null && FConvert.toString(rtnPriceBookRate[1]) != undefined && rtnPriceBookRate[1].length > 0) {
                                    ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal; // dPrevDiscExtFldVal - check scenario
                                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                    CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                                    CALCULATION.calculateFooter(ApplicationNew);
                                    responseDiscountCellValue[0] = rtnPriceBookRate[0];
                                    responseDiscountCellValue[2] = rtnPriceBookRate[1];
                                    return responseDiscountCellValue;
                                }
                            }
                        }
                    }
                }

                ApplicationNew.CurrentItem.IsManualDiscount = true;
                /* Purna - 04-09-2024
                 * at the time of giving manual discount for the item, after posting the transaction and adding same product again, preload value is adding as discount*/
                /*ApplicationNew.BodyPanelExtraFieldsList[objColumnRecord.ColumnIndex].PreloadValue = dCurrentCellEnteredValue;*/
                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;

                PRODUCTSELECTION.callCopyOrProportionateToAllRows(ApplicationNew.CurrentItem.ItemSerialNo - 1, dCurrentCellEnteredValue, true, ApplicationNew, objColumnRecord);
                CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                let rtnValueDiscount = CHECKDISCOUNTAUTHORIZATION.checkDiscountAuthorization(1006);
                if (rtnValueDiscount != null && rtnValueDiscount != undefined && rtnValueDiscount.length > 0) {
                    if (rtnValueDiscount.length > 4 && FConvert.toBoolean(rtnValueDiscount[3]) == true && FConvert.toString(rtnValueDiscount[4]) != null && FConvert.toString(rtnValueDiscount[4]) != undefined && FConvert.toInt(rtnValueDiscount[5]) > 0) {
                        responseDiscountCellValue[0] = true;
                        responseDiscountCellValue[2] = "MESSAGEBOX";
                        responseDiscountCellValue[3] = false;
                        responseDiscountCellValue[4] = rtnValueDiscount[4];
                        responseDiscountCellValue[5] = rtnValueDiscount[5];
                        return responseDiscountCellValue;
                    }
                    else if (rtnValueDiscount.length > 4 && FConvert.toBoolean(rtnValueDiscount[3]) == true && FConvert.toString(rtnValueDiscount[4]) != null && FConvert.toString(rtnValueDiscount[4]) != undefined && FConvert.toInt(rtnValueDiscount[5]) == 0) {
                        responseDiscountCellValue[0] = true;
                        responseDiscountCellValue[2] = "OK";
                        responseDiscountCellValue[3] = false;
                        responseDiscountCellValue[4] = rtnValueDiscount[4];
                        responseDiscountCellValue[5] = rtnValueDiscount[5];
                        return responseDiscountCellValue;
                    }
                    if (FConvert.toBoolean(rtnValueDiscount[0]) == true) {
                        if (FConvert.toBoolean(rtnValueDiscount[1]) == true) {
                            responseDiscountCellValue[0] = true;
                            /*responseDiscountCellValue[1] = "Manager Approval Required";*/
                            responseDiscountCellValue[2] = "MANAGERAPPROVALDISCOUNTAUTHORIZATION";
                            return responseDiscountCellValue;
                        }
                    }
                    else if (FConvert.toBoolean(rtnValueDiscount[1]) == false) {
                        ApplicationNew.MaxDiscAllowedPerTrans = true;
                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                        if (IsFromCopyOrProp == true) {
                            ApplicationNew.CopyToAllRows = true;
                            PRODUCTSELECTION.CallCopyOrProportionateToAllRows(ApplicationNew.CurrentItem.ItemSerialNo - 1, 0, false, ApplicationNew, objColumnRecord);
                        }
                        CALCULATION.calculateLineWiseNet(ApplicationNew.CurrentItem, ApplicationNew);
                        return responseDiscountCellValue;
                    }
                }
                // Implemented Logic for "Remove Other Discounts if Manual Discount is Given" -Anjaneyulu 
                if (dCurrentCellEnteredValue > 0) {
                    if (objColumnRecord.ClearDiscounts && ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput > 0) {
                        /*ApplicationNew.CurrentItem.DefaultValue6 = 0;*/
                        ApplicationNew.CurrentItem.DynamicLineFields[0].FieldInput = ApplicationNew.CurrentItem.DynamicLineFields[0].FieldValue = 0;
                        ApplicationNew.CurrentItem.DonotConsiderWhileApplyingSchemes = true;
                        if (ApplicationNew.CurrentItem.DynamicLineFields.length > 0) {
                            if (ApplicationNew.BodyPanelExtraFieldsList != null && ApplicationNew.BodyPanelExtraFieldsList != undefined && ApplicationNew.BodyPanelExtraFieldsList.length > 0) {
                                for (let bc = 0; bc < ApplicationNew.BodyPanelExtraFieldsList.length; bc++) {
                                    if (ApplicationNew.BodyPanelExtraFieldsList[bc].ID == objColumnRecord.ID)
                                        continue;
                                    if (ApplicationNew.BodyPanelExtraFieldsList[bc] != null && ApplicationNew.BodyPanelExtraFieldsList[bc].IsDiscountField) {
                                        ApplicationNew.CurrentItem.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[bc].ColumnIndex].FieldInput = 0;
                                    }
                                }
                            }
                        }
                        ////debugger;
                        let index = 0;
                        if (ApplicationNew != null && ApplicationNew != undefined && ApplicationNew.TotalSchemesInfo != undefined && ApplicationNew.TotalSchemesInfo != undefined) {
                            let promts = ApplicationNew.TotalSchemesInfo.LinePrompts.filter((p) => p.PromoType == PromoTypes.get("DISCOUNT") && p.ProductId == celledititem.DefaultValue1)
                            if (promts != null && promts != undefined && promts > 0)
                                index = UPDATEPRODUCT.callImplementSchemesOnItemGridEdit(ApplicationNew.CurrentItem.ItemSerialNo - 1)
                        }
                    }
                }
                responseDiscountCellValue[0] = true;
                return responseDiscountCellValue;
            }
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.updateDiscountCell :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
