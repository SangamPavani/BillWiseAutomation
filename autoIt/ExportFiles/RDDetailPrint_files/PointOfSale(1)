                        }
                    }
                }
                else if (selDiscountType == "FreeItem") {
                    var tr = $("#tbodyFreeItem").find('tr');
                    var arrFreeItemRecord = [];
                    var freeItemsList = [];
                    for (var i = 0; i < tr.length; i++) {
                        var trFreeItemRecord = $(tr[i]).attr("data-FreeItemRecord");
                        if (trFreeItemRecord != null && trFreeItemRecord != "" && trFreeItemRecord != undefined && trFreeItemRecord.length > 0) {
                            trFreeItemRecord = JSON.parse(trFreeItemRecord);
                            arrFreeItemRecord.push(trFreeItemRecord);
