                        await PRODUCTSELECTIONEXTERNALMODULE.SHORTCUTMETHODS.loadExternalModuleShortcutFunction(VERIFICATIONPROCESS.VARIABLES.ShortcutId, approvalValues);
                    else
                        SHORTCUTMETHODS.loadShortcutFunction(VERIFICATIONPROCESS.VARIABLES.ShortcutId, false, VERIFICATIONPROCESS.VARIABLES.ShortcutIdData, approvalValues);
                }
                return;
            }
            else if (data.ManagerId == 0) //Manager Verification Failed
            {
                $("#txtManagerUserName").val('');
                $("#txtManagerPassword").val('');
                var failedAttemptCount = $("#managermodalhidden").val();
                if (failedAttemptCount == null || failedAttemptCount == undefined || failedAttemptCount.trim() == "")
                    return;
                failedAttemptCount = FConvert.toInt(failedAttemptCount) + 1;
                $("#managermodalhidden").val(failedAttemptCount);
                if (FConvert.toInt(failedAttemptCount) == 3) //If Verification Failed 3 Times, Then Close The Modal, Do not need to call SHORTCUTMETHODS.loadShortcutFunction
                {
                    RETAILMAIN.closePopup('#divManagerApprovalModal');
                    if (VERIFICATIONPROCESS.VARIABLES.ShortcutId == null || VERIFICATIONPROCESS.VARIABLES.ShortcutId == undefined
                        || FConvert.toInt(VERIFICATIONPROCESS.VARIABLES.ShortcutId) == 0)
                        return;
                    else if (VERIFICATIONPROCESS.VARIABLES.ShortcutId != null && VERIFICATIONPROCESS.VARIABLES.ShortcutId != undefined
                        && FConvert.toInt(VERIFICATIONPROCESS.VARIABLES.ShortcutId) > 0) {
                        var approvalValues = [false, false, 0];
                        SHORTCUTMETHODS.loadShortcutFunction(VERIFICATIONPROCESS.VARIABLES.ShortcutId, false, VERIFICATIONPROCESS.VARIABLES.ShortcutIdData, approvalValues);
                    }
                }
                else //Showing The Error Message
