                    lstUnitIds = FConvert.toInt(lstUnitIds[0]);

                    var lstUnit = ITEMRESTRICTIONSINBILL.SEVERMETHOD.GetUnitListOfBaseUnit(lstUnitIds, sProUnitId);
                    if (lstUnit != null && lstUnit != undefined && lstUnit.length > 0) {
                        lstUnitList = lstUnit[0];
                    }
                }
                else {
                    var IdNamePair = new Object();
                    IdNamePair.ID = 0;
                    IdNamePair.Name = "Base Unit";
                    lstUnitList.push(IdNamePair)
                }
                $('#ddlUnit').html('');
                for (let i = 0; i < lstUnitList.length; i++) {
                    $('#ddlUnit').append("<option id='" + lstUnitList[i].ID + "' value='" + lstUnitList[i].ID + "' data-UnitDetails='" + JSON.stringify(lstUnitList[i]) + "' >" + lstUnitList[i].Name + "</option>");
