        try {
            debugger;
            let loadProductToTree = new Object();
            loadProductToTree.LeafId = arrParameters[1];
            loadProductToTree.TreeTypeId = arrParameters[2];
            loadProductToTree.SchemesInTransaction = arrParameters[3];
            loadProductToTree.SchemesHeaderId = arrParameters[4];
            loadProductToTree.SchemesBody1Id = arrParameters[5];
            loadProductToTree.FromScreen = arrParameters[6];
            loadProductToTree.MandatorySchemesProductType = arrParameters[8];

            let treeViewProductControl = new Object();
            treeViewProductControl.ControlName = arrParameters[0];
            treeViewProductControl.IsLoading = true;
            treeViewProductControl.ChangeStatusEvent = "TREEVIEWCONTROL.TREEEVENT.changeStatus(this);";
            treeViewProductControl.LoadChildrenEvent = "TREEVIEWCONTROL.loadChildren(this);";

            loadProductToTree.IsShowOnlyProduct = false;
            TREEVIEWCONTROL.SERVER.getProductsListBasedOnLeafId([loadProductToTree, treeViewProductControl]);
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.loadTreeViewControl :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
