    inputControlLeave: function (evt, parsedCellRecordOfClickedTableCell, inputControl) {
        try {
            var msgDiscountCannotBeGreaterThanGross = $("#msgDiscountCannotBeGreaterThanGross").val();
            var msgDiscountFieldShouldNotBeEmpty = $("#msgDiscountFieldShouldNotBeEmpty").val();
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = (evt.which) ? evt.which : evt.keyCode;
            if (parsedCellRecordOfClickedTableCell.Name != "Batch") {
                if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                    if (evt.key == '.') {
                        var value = $(inputControl).val();
                        if (value.indexOf(".") >= 0)
                            return false;
                    }
                    return true;
                }
            }

            //"Esc" charCode is 27 //&& charCode != 27
            if (charCode != 13 && charCode != 9) {
                if (parsedCellRecordOfClickedTableCell.Name != "Rate")
                    return
                else
                    return false
            }

            TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.inputControlLeaveEventExecute = true;

            TABLECHANGEMETHODSNEW.inputControlLeave.prototype.inputControl = inputControl;
            var inputControlText = $(inputControl).val();
            var inputControlParentTableCell = $(inputControl).closest('td'); // parent td of input(textbox)
            var inputControlParentTableRow = $(inputControlParentTableCell).closest('tr'); // parent tr of input(textbox)
            var rowRecordOfClickedTableCell = $(inputControlParentTableRow).attr('data-RowRecord');
            var parsedRowRecordOfClickedTableCell = JSON.parse(rowRecordOfClickedTableCell);

            var iIndex = -1;
            for (var i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                if (ApplicationNew.ListOfItems[i].ItemSerialNo == parsedRowRecordOfClickedTableCell.ItemSerialNo) {
                    iIndex = i;
                    break;
                }
            }

            if (iIndex >= 0) {
                if (parsedCellRecordOfClickedTableCell.Name == "Rate") {
                    $(inputControl).find("input").remove();
                    var calculatingLinewiseFields = POSDATASTRUCTURE.getEmptyCalculatingLinewiseFields();
                    calculatingLinewiseFields.ClickedColumn = parsedCellRecordOfClickedTableCell;
                    calculatingLinewiseFields.EnteredCellValue = inputControlText;
                    calculatingLinewiseFields.EnteredQuantity = FConvert.toDecimal(inputControlText);
                    calculatingLinewiseFields.PreviousEnteredCellValue = addProductToGridObject.previousInputControlText;
                    calculatingLinewiseFields.previousValue = addProductToGridObject.previousInputControlText;
                    ApplicationNew.CurrentItem = parsedRowRecordOfClickedTableCell;
                    addProductToGridObject.inputControlParentTableCell = inputControlParentTableCell;
                    addProductToGridObject.inputControlText = inputControlText;
                    TABLECHANGEMETHODSNEW.SERVERMETHODS.setOrCalculateLinewiseFields(calculatingLinewiseFields);
                    return;
                }
                else if (parsedCellRecordOfClickedTableCell.Name == "Narration") {
                    parsedRowRecordOfClickedTableCell.Narration = inputControlText;
                    ApplicationNew.ListOfItems[iIndex] = parsedRowRecordOfClickedTableCell;
                    $(inputControlParentTableRow).attr('data-RowRecord', JSON.stringify(parsedRowRecordOfClickedTableCell));
                    $(inputControl).find('input').remove(); //Remove textbox from td
                    $(inputControlParentTableCell).html(parsedRowRecordOfClickedTableCell.Narration);
                    TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.inputControlLeaveEventExecute = false;
                    return;
                }
                else if (parsedCellRecordOfClickedTableCell.Name == "Batch" && PreferenceSetting.PrefInventoryTab.BatchSelectionMode != BatchSelectionMode.get("DROPDOWN")) {
                    if (TABLECHANGEMETHODSNEW.VARIABLES.BATCH.doNotExecuteBatchBlur == true) {
                        TABLECHANGEMETHODSNEW.VARIABLES.BATCH.doNotExecuteBatchBlur = false;
                        return;
                    }
                    TABLECHANGEMETHODSNEW.VARIABLES.BATCH.doNotExecuteBatchBlur = true;
                    if (inputControlText == null || inputControlText == undefined || inputControlText.trim() == "" || inputControlText.trim().length <= 0) {
                        TABLECHANGEMETHODSNEW.confirmationCancel(inputControlParentTableCell, "", true);
                        ApplicationNew.ListOfItems[iIndex].BatchData = null;
                        ApplicationNew.ListOfItems[iIndex].BatchNo = "";
                    }
                    else {
                        TABLECHANGEMETHODSNEW.confirmationCancel(inputControlParentTableCell, inputControlText, true);
                        var calculatingLinewiseFields = POSDATASTRUCTURE.getEmptyCalculatingLinewiseFields();
                        calculatingLinewiseFields.ClickedColumn = parsedCellRecordOfClickedTableCell;
                        calculatingLinewiseFields.EnteredQuantity = 0;
                        calculatingLinewiseFields.EnteredCellValue = inputControlText;
                        calculatingLinewiseFields.PreviousEnteredCellValue = addProductToGridObject.previousInputControlText;

                        ApplicationNew.CurrentItem = parsedRowRecordOfClickedTableCell;
                        ApplicationNew.ListOfItems[iIndex] = parsedRowRecordOfClickedTableCell;
                        ApplicationNew.IsNewProdCodeExecuted = false;
                        TABLECHANGEMETHODSNEW.SERVERMETHODS.setOrCalculateLinewiseFields(calculatingLinewiseFields);
                    }
                    return;
                }
                //*********** Linewise Extra Fields Calculation Start ***********************

                if (parsedCellRecordOfClickedTableCell.SequenceNumber == 8 && parsedCellRecordOfClickedTableCell.IsDiscountField == true) {
                    var dPrevDiscExtFldVal = parsedRowRecordOfClickedTableCell.DynamicLineFields[parsedCellRecordOfClickedTableCell.ColumnIndex].FieldInput;
                    if (inputControlText == null || inputControlText == undefined || inputControlText.trim() == "" || inputControlText.trim().length <= 0) {
                        toastr.info(msgDiscountFieldShouldNotBeEmpty);
                        $(inputControl).focus();
                        $(inputControl).val(FConvert.toDecimal(dPrevDiscExtFldVal, POSCommon.numberOfDecimal));
                        return;
                    }

                    ApplicationNew.CurrentItem = parsedRowRecordOfClickedTableCell;
                    if (ApplicationNew.CurrentItem.ItemSerialNo == 1) {
                        ApplicationNew.CellRecordOfClickedTableCellForCopyOrPro = parsedCellRecordOfClickedTableCell;
                        ApplicationNew.ValueToCopyOrProportionate = inputControlText;
                    }

                    addProductToGridObject.inputControlParentTableCell = inputControlParentTableCell;
                    addProductToGridObject.previousValue = dPrevDiscExtFldVal;

                    var calculatingLinewiseFields = POSDATASTRUCTURE.getEmptyCalculatingLinewiseFields();
                    calculatingLinewiseFields.ClickedColumn = parsedCellRecordOfClickedTableCell;
                    calculatingLinewiseFields.EnteredQuantity = inputControlText;
                    calculatingLinewiseFields.PreviousValue = dPrevDiscExtFldVal;
                    var totalDiscount = FConvert.toDecimal(inputControlText, POSCommon.numberOfDecimal, true);
                    for (var i = 0; i < ApplicationNew.BodyPanelExtraFieldsList.length; i++) {
                        if (ApplicationNew.BodyPanelExtraFieldsList[i].EffectOnNetId == 2 && ApplicationNew.BodyPanelExtraFieldsList[i].IsDiscountField == true) {
                            if (parsedCellRecordOfClickedTableCell.ColumnIndex == i)
                                continue;
                            totalDiscount = FConvert.toDecimal(ApplicationNew.CurrentItem.DynamicLineFields[i].FieldValue, POSCommon.numberOfDecimal, true) + totalDiscount;
                        }
