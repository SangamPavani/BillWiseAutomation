                }
            }

            /* Loading Schemes */
            if (ApplicationNew.PresentTransactionMode < TransactionModes.get("VIEWPREORDER") && LOADTRANSACTION.VARIABLES.LoadPOSTransaction != null && LOADTRANSACTION.VARIABLES.LoadPOSTransaction != undefined && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.LoadedPosSalesTransaction != null
                && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.LoadedPosSalesTransaction != undefined && LOADTRANSACTION.VARIABLES.LoadPOSTransaction.LoadedPosSalesTransaction.Header.Flags.Suspended == true) {
