    evaluateBodyFormula: function (strFormula, arrParams) {
        if (strFormula == null || strFormula == undefined || strFormula.length <= 0)
            return 0;

        try {
            let objFormula = new FFormula();
            objFormula.m_CalType = POSCommon.calType;
            objFormula.Tag = arrParams;
            objFormula.setCustomData(arrParams);
            objFormula.fnValueNeeded = "POSFORMULA.getFormulaFieldValue";

            if (strFormula.startsWith("&"))
                strFormula = strFormula.substring(1);

            if (strFormula.startsWith("#"))
                strFormula = strFormula.substring(1);

            var rawValue = JSON.stringify(objFormula.Result(strFormula, true));
            if (rawValue == null || rawValue == undefined || rawValue == "NaN" || rawValue.includes("Infinity") || rawValue.includes("E+") || rawValue.includes("E-"))
                return 0;

            return FConvert.toDecimal(rawValue, POSCommon.numberOfDecimal, true);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method:POSFORMULA.evaluateBodyFormula, Catch block : Error Message : " + Ex.message);
