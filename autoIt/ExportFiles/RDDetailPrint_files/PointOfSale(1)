                let iProductId = _MatchedItems[i].DefaultValue1;
                if (_MatchedItems[i].ProductMake != 0)
                    iProductId = _MatchedItems[i].ParentId;

                discount = FConvert.toDecimal(discount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(baseQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(_MatchedItems[i].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                _MatchedItems[i].DefaultValue3 = baseQty;
                POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts(FromScreen, "", iProductId, _MatchedItems[i].DefaultValue2, Scheme.ID, Scheme.Name, discount, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, SDD.Id, _MatchedItems[i].ProductMake, _MatchedItems, PaymentTypes.get("DUMMY"), 0, _MatchedItems[i].ProductUnit, _MatchedItems[i].DonotMaintainStockbyBatch, _MatchedItems[i]);
