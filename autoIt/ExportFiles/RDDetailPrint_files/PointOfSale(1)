                //objSchemesDiscountDef.PreOrderScheme = $("#chkMemberSchemePreOrderScheme").is(":checked");
                //objSchemesDiscountDef.Inactive = $("#chkMemberSchemeInactive").is(":checked");

                var tbodyMembersList = [];
                if ($("#tbodyMemberDiscount tr").length > 0) {
                    var memberRows = $("#tbodyMemberDiscount tr");

                    for (let i = 0; i < memberRows.length; i++) {
                        if ($(memberRows[i]).attr('data-memberSchemeDiscountDetails') != null && $(memberRows[i]).attr('data-memberSchemeDiscountDetails') != undefined) {
                            var parsedMemberRow = JSON.parse($(memberRows[i]).attr('data-memberSchemeDiscountDetails'));
                            if (parsedMemberRow.ProductIds != null && parsedMemberRow.ProductIds != undefined && parsedMemberRow.ProductIds != "" && parsedMemberRow.ProductIds.length > 0)
                                parsedMemberRow.ProductIds = parsedMemberRow.ProductIds;
                            else
                                parsedMemberRow.ProductIds = "";
                            tbodyMembersList.push(parsedMemberRow);
                        }
                    }
                }
                objSchemesDiscountDef.Members = tbodyMembersList;

                if (MemberSchemeId != null && MemberSchemeId != undefined && MemberSchemeId > 0)//if (optPymntSchemeName.Tag == null)
                {
                    objSchemesDiscountDef.ID = MemberSchemeId;

                    if ($("#ddlSchemeTypeMem").val() == 1) {

                        NETWORK.executeServerMethod(GLOBAL.getContextPath("CheckMemDiscExists", "RetailMainScreen", "PointOfSale"),
                            true, { schemesDiscountDef: objSchemesDiscountDef, id: objSchemesDiscountDef.ID }, "JSON", false,
                            function (bSuccess, data) {

                                if (bSuccess == false)
                                    return;

                                if (data.bSuccess == true) {
                                    if (data.sMessage.length > 0) {
                                        if (data.sMessage == "Failure") {
                                            return;
                                        }
                                    }
                                }
                                else {
                                    //if (data.sError.length > 0) {
                                    //    COMMON.prototype.showMessage(data.sError, "");
                                    //    return;
                                    //}
                                }
                            });
                    }
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("UpdateMemberSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", true, "SCHEMESDISCOUNT.MEMBERONSUCCESSSERVERMETHODS.onSuccessUpdateMemberData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
                else {
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("SaveMemberSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", true, "SCHEMESDISCOUNT.MEMBERONSUCCESSSERVERMETHODS.onSuccessSaveMemberData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
            }
            catch (Ex) {
