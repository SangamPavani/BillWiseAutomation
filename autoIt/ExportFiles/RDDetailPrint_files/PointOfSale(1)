    getBillSettlementObject: function (iModuleFunctionId) {
        try {
            var billSettlementObject = BILLSETTLEMENTDATASTRUCTURE.getEmptyBillSettlementObjectToOpen();
            let msgYouDontHaveAccessRights = $("#msgYouDontHaveAccessRights").val();
            let msgExceedsMaxDiscount = $("#msgExceedsMaxDiscount").val();

            //Check Profile Rights For BillSettlement Screen
            if (POSCommon.actionIds != null && POSCommon.actionIds != undefined && POSCommon.actionIds.length > 0) {
                var foundRights = POSCommon.actionIds.filter((p) => p == (iModuleFunctionId + 85));
                if (foundRights != null && foundRights != undefined && foundRights.length > 0) {
                    toastr.error(msgYouDontHaveAccessRights);
                    return false;
                }
            }

            var footerField;
            if (ApplicationNew.RetailTransFooter != null && ApplicationNew.RetailTransFooter != undefined) {
                if (ApplicationNew.RetailTransFooter.FooterFieldsList != null && ApplicationNew.RetailTransFooter.FooterFieldsList != undefined && ApplicationNew.RetailTransFooter.FooterFieldsList.length > 0) {
                    footerField = ApplicationNew.RetailTransFooter.FooterFieldsList.filter(p => p.FieldBehaviour == FieldBehaviour.get("ROUNDOFF"));
                    if (footerField != null && footerField != undefined && footerField.length > 0) {
                        var footerFieldData = ApplicationNew.RetailTransFooter.DynamicFooterFields.filter(p => p.FieldId == footerField[0].ID);
                        if (footerFieldData != null && footerFieldData != undefined && footerFieldData.length > 0) {
                            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOff == false)
                                billSettlementObject.RoundOff = FConvert.toDecimal(footerFieldData[0].FieldInput);
                            else {
                                billSettlementObject.RoundOff = 0;
                                billSettlementObject.NetRoundOffAccPref = FConvert.toDecimal(footerFieldData[0].FieldInput);
                            }
                        }
                    }
                }
            }

            //Checking Maximum discount authorization
            var dNett = 0;
            if (ApplicationNew.PreOrderInfo == null || ApplicationNew.PreOrderInfo == undefined) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOff == true && PreferenceSetting.PrefOutletTab.OutletGeneralTab.NetRoundOffValue != 0)
                    dNett = FConvert.toDecimal($("#lblNett").html(), POSCommon.numberOfDecimal);
                else
                    dNett = FConvert.toDecimal($("#lblNett").attr("data-Nett"), POSCommon.numberOfDecimal);

                billSettlementObject.NetAmount = dNett;
            }
            else if (ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined && ApplicationNew.PreOrderInfo.IsFromPreOrderCollection == false) {
                if (ApplicationNew.MaxDiscAllowedPerTrans == false) {
                    toastr.error(msgExceedsMaxDiscount);
                    CALCULATION.setFooterScreenFieldData(FieldBehaviour.get("SCHEMEDISCOUNT"), 0, false);
                    CALCULATION.calculateFooter(ApplicationNew);
                    return false;
                }
                billSettlementObject.NetAmount = $("#lblNett").html();
            }
            else if (ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined && ApplicationNew.PreOrderInfo.IsFromPreOrderCollection == true) {
                billSettlementObject.NetAmount = FConvert.toDecimal($("#txtPreOrderCollectionAmountToPay").val(), POSCommon.numberOfDecimal);
                billSettlementObject.IsPreOrderScreen = true;
            }

            billSettlementObject.Discount = BILLSETTLEMENT.getBodyDiscount(); //LineDiscount + DiscountPercentage;
            billSettlementObject.Scheme = BILLSETTLEMENT.getSchemeDiscount();
            if (billSettlementObject.Scheme > 0)
                billSettlementObject.IsSchemesApplied = true;

            if (FConvert.toDecimal(billSettlementObject.NetAmount) == 0) {
                billSettlementObject.IsTotalDiscount = true;
                billSettlementObject.PostNetZeroTrans = true;
            }

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPOSSALES"))
                billSettlementObject.PresentTransactionMode = TransactionModes.get("NEWPOSSALES");
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPOSSALES")) {
                billSettlementObject.PresentTransactionMode = TransactionModes.get("EDITPOSSALES");
                billSettlementObject.TotalRoundOff = CALCULATION.getFooterFieldInput(FieldBehaviour.get("ROUNDOFF"));
            }
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION"))
                billSettlementObject.NetAmount = $("#txtPreOrderCollectionAmountToPay").val();

            return billSettlementObject;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getBillSettlementObject, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
