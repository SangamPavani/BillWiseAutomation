    maximumDiscountRestriction: function () {
        try {
            //debugger;
            if (ApplicationNew.RetailTransFooter != null && ApplicationNew.RetailTransFooter != undefined) {
                if (RETAILMAIN.VARIABLE.NetBeforeSchemeImplementation != ApplicationNew.RetailTransFooter.UserWiseNet)
                    ApplicationNew.MaxDiscAllowedPerTrans = false;
