                totalDiscount = (FConvert.toDecimal(nonBillableQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(itemPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) - FConvert.toDecimal(discountGiven, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            }
            else {
                totalDiscount = discountGiven;
            }

            itemGrossAfterApplyingFixedPrice = (FConvert.toDecimal(BillableQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(itemPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) + FConvert.toDecimal(discountGiven, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);

            let iProductId = Item.DefaultValue1;
            if (Item.ProductMake == 1) {
                iProductId = Item.ParentId;
            }
            POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts(FromScreen, "", iProductId, Item.DefaultValue2, FreeScheme.ID, FreeScheme.Name, totalDiscount, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, FSGHeaderData.Id, Item.ProductMake, BaseItems, PaymentTypes.get("DUMMY"), 0, Item.ProductUnit, Item.DonotMaintainStockbyBatch, Item);
