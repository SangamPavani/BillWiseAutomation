            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailMainPreOrder.js, Method: PREORDERDETAILS.deliveryTypeClickEvent:, Catch block : Error Message : " + Ex.message);
