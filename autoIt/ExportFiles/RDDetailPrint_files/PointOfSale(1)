            if (memberData.PhoneRes != null && memberData.PhoneRes != undefined && memberData.PhoneRes.trim() != ""
                && memberData.PhoneRes.trim().length > 0 && memberData.PhoneRes.trim() != "0") {
                sAddress = sAddress + msgPhoneRes + memberData.PhoneRes;
