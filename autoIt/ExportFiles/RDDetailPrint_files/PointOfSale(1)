    getHomeDeliveryPickListFirstClick: function (navigationButtonType) {
        //////debugger;
        try {
            var msgResponseMemberIsNullOrResponseMemberLengthIsZero = $("#msgResponseMemberIsNullOrResponseMemberLengthIsZero").val();
            var m_iCount = 0;
            var Delivered;
            var isOpenFromEOD = $("#divHomeDeliveryPickListModal").attr('data-isFromDayEnd');
            var m_iCount = parseInt($("#divHomeDeliveryPickListModal").attr('data-Count'));
            var iMaxRecordCount = parseInt($("#divHomeDeliveryPickListModal").attr('data-MaxCount'));
            var iRecordsPerPage = parseInt($("#divHomeDeliveryPickListModal").attr('data-RecordPerPage'));

            if (navigationButtonType == 1)
                m_iCount = 0;
            else if (navigationButtonType == 2)
                m_iCount -= iRecordsPerPage;
            else if (navigationButtonType == 3)
                m_iCount += iRecordsPerPage;
            else if (navigationButtonType == 4) {
                m_iCount = iRecordsPerPage * (parseInt(iMaxRecordCount / iRecordsPerPage));
                if (m_iCount == iMaxRecordCount)
                    m_iCount -= iRecordsPerPage;
                $("#btnHomeDeliveryPickListFirst").removeClass("nextPrevious");
                $("#btnHomeDeliveryPickListFirst").addClass("nextPreviousActive");
                $("#btnHomeDeliveryPickListPrevious").removeClass("nextPrevious");
                $("#btnHomeDeliveryPickListPrevious").addClass("nextPreviousActive");
                $("#btnHomeDeliveryPickListNext").removeClass("nextPreviousActive");
                $("#btnHomeDeliveryPickListNext").addClass("nextPrevious");
                $("#btnHomeDeliveryPickListLast").removeClass("nextPreviousActive");
                $("#btnHomeDeliveryPickListLast").addClass("nextPrevious");
            }
            var defaultParameter = new Object();
            defaultParameter.m_iCount = m_iCount;
            defaultParameter.iMaxRecordCount = iMaxRecordCount;
            defaultParameter.navigationButtonType = navigationButtonType;
            defaultParameter.iRecordsPerPage = iRecordsPerPage;
            document.getElementById("btnHomeDeliveryPickListFirst").style.borderColor = "#B6B6B6";
            document.getElementById("btnHomeDeliveryPickListPrevious").style.borderColor = "#B6B6B6";
            document.getElementById("btnHomeDeliveryPickListNext").style.borderColor = "#B6B6B6";
            document.getElementById("btnHomeDeliveryPickListLast").style.borderColor = "#B6B6B6";

            if (isOpenFromEOD == false || isOpenFromEOD == "False") {
                if ($("#rbtHomeDeliveryPickListDelivered").prop("checked") == true) {
                    Delivered = true;
                }
                else {
                    Delivered = false;
                }
                let selectedOutletDetails = OPTIONCONTROL.getControlDataObject("optDeliveryOutlet");
                let selectedOutletId = 0;
                if (selectedOutletDetails != null && selectedOutletDetails != undefined)
                    selectedOutletId = selectedOutletDetails.iMasterId;

                var HomeDeliveryPickList1 =
                {
                    VoucherNo: $("#txtHomeDeliveryPickListBillNo").val(),
                    DeliveryDateTimeInt: DATEPICKER.getDate(dtpDeliveryDate),
                    DeliveryOutletId: selectedOutletId,
                    Remarks: $("#txtHomeDeliveryPickListRemarks").val(),
                    IsDelivered: Delivered,
                    MemberDet: ApplicationNew.MemberData
                };

                HOMEDELIVERYPICKLIST.SERVERMETHODS.getHomeDeliveryDetails(HomeDeliveryPickList1, defaultParameter);
            }
            else if (isOpenFromEOD == true || isOpenFromEOD == "True") {
                HOMEDELIVERYPICKLIST.SERVERMETHODS.getHomeDeliveryDetailsForEOD(defaultParameter);
            }
        }
        catch (Ex) {
