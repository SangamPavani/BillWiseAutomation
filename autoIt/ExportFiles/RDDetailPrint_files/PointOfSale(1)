var EMPLOYEEDISCOUNTDEFINATION = {
    VARIABLE: {
        currentTableRow: null,
        selectedEmployeeInfo: null
    },
    getRowColumnIndex: function (table, tableCell) {
        try {
            //////debugger;
            let tableRow = $(tableCell).parent(), iRow = -1, iColumn = -1;
            if (tableRow != null && tableRow != undefined && tableRow.length > 0)
                tableRow = tableRow[0];

            let childrenId = null, tableCellId = $(tableCell).attr("id");
            for (let i = 0; i < tableRow.children.length; i++) {
                childrenId = $(tableRow.children[i]).attr("id");
                if (childrenId != null && childrenId != undefined && childrenId.trim().length > 0 && childrenId == tableCellId) {
                    iColumn = i;
                    break;
                }
            }
            //////debugger;
            iRow = FConvert.toInt($(tableRow).attr("data-RowIndex"));
            return [iRow, iColumn];
        }
        catch (Ex) {
            return [-1, -1];
        }
    },
    cellChangeEvent: function (tableCell, event) {
        //////debugger;
        try {
            let table = $("table#tblEmployeeDiscountDefination");
            let iRow = $("table#tblEmployeeDiscountDefination").attr("data-Row");
            let iColumn = $("table#tblEmployeeDiscountDefination").attr("data-Column");
            let iClickedRow = -1, iClickedColumn = -1;

            if (table != null && table != undefined && table.length > 0)
                table = table[0];

            let rowColumnIndex = EMPLOYEEDISCOUNTDEFINATION.getRowColumnIndex(table, tableCell);
            if (rowColumnIndex != null && rowColumnIndex != undefined && rowColumnIndex.length > 0) {
                iClickedRow = rowColumnIndex[0];
                iClickedColumn = rowColumnIndex[1];
            }

            if (iClickedRow == iRow && iClickedColumn == iColumn)
                return false;

            if (FConvert.toInt(iRow) >= 0 && FConvert.toInt(iColumn) >= 0)
                EMPLOYEEDISCOUNTDEFINATION.onLeaveTableCellEmployee(table, iRow, iColumn);

            $(table).attr("data-Row", iClickedRow);
            $(table).attr("data-Column", iClickedColumn);
            EMPLOYEEDISCOUNTDEFINATION.onEnterTableCellEmployee(table, iClickedRow, iClickedColumn);
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:EMPLOYEEDISCOUNTDEFINATION.cellChangeEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
    onEnterTableCellEmployee: function (table, iRow, iColumn) {
        try {
            //////debugger;
            switch (FConvert.toInt(iColumn)) {
                case 1:
                    EMPLOYEEDISCOUNTDEFINATION.setOptionControlSelectedRecord(table, iRow, iColumn);
