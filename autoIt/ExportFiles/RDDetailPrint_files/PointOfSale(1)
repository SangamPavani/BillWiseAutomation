    afterCreditNoteRedeemption: function () {
        try {
            var objCreditNote = BILLSETTLEMENTDATASTRUCTURE.getEmptyCreditNoteDetails();
            if (BILLSETTLEMENT.VARIABLE.cNDetails == null || BILLSETTLEMENT.VARIABLE.cNDetails == undefined || BILLSETTLEMENT.VARIABLE.cNDetails.length <= 0) {
                if ($("#txtCreditNoteNumber").is(":visible")) {
                    objCreditNote.Id = $("#txtCreditNoteNumber").attr("data-Tag");
                    objCreditNote.VoucherNumber = $.trim($("#txtCreditNoteNumber").val());
                }
                else {
                    objCreditNote.Id = ($("input#optCreditNoteNumberId").attr("data-Tag"));
                    var optCreditNote = OPTIONCONTROL.getControlDataObject("optCreditNoteNumberId");
                    objCreditNote.VoucherNumber = optCreditNote.CreditNoteNo;
                }

                objCreditNote.IssueDate = DATEPICKER.getDate("dtpCreditNoteIssueDate");
                objCreditNote.ExpiryDate = DATEPICKER.getDate("dtpCreditNoteExpiryDate");
                objCreditNote.Value = BILLSETTLEMENT.VARIABLE.dCNValue;
                objCreditNote.RedeemedAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt, POSCommon.numberOfDecimal);

                if (FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) == FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt, POSCommon.numberOfDecimal))
                    objCreditNote.Status = CreditNoteStatus.get("Used");
                else
                    objCreditNote.Status = CreditNoteStatus.get("PartialUsed");

                objCreditNote.CreditNoteRefundAmount = 0;
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictPartialRedemptionOfCreditNote == true) {
                    objCreditNote.UnusedAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) - FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt, POSCommon.numberOfDecimal);
                    objCreditNote.Status = CreditNoteStatus.get("Used");
                    objCreditNote.IsPartialRedemptionRestricted = true;
                }
                else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictPartialRedemptionOfCreditNote == false) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowCashRefundCreditNoteBalance == true) {
                        if (BILLSETTLEMENT.VARIABLE.CreditNoteRedeemption == true) {
                            objCreditNote.CreditNoteRefundAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) - FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt, POSCommon.numberOfDecimal);
                            objCreditNote.Status = CreditNoteStatus.get("Used");
                            objCreditNote.IsPartialRedemptionRestricted = true;
                        }
                        else if (BILLSETTLEMENT.VARIABLE.CreditNoteRedeemption == false) {
                            objCreditNote.UnusedAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) - FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt, POSCommon.numberOfDecimal);
                            objCreditNote.Status = CreditNoteStatus.get("PartialUsed");
                            objCreditNote.IsPartialRedemptionRestricted = false;
                        }
                    }
                }
            }
            else {
                BILLSETTLEMENT.VARIABLE.cNDetails.RedeemedAmount = BILLSETTLEMENT.VARIABLE.cNDetails.RedeemedAmount + BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt;
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictPartialRedemptionOfCreditNote == true) {
                    BILLSETTLEMENT.VARIABLE.cNDetails.UnusedAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) - FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.cNDetails.RedeemedAmount, POSCommon.numberOfDecimal);
                    BILLSETTLEMENT.VARIABLE.cNDetails.Status = CreditNoteStatus.get("Used");
                    objCreditNote.IsPartialRedemptionRestricted = true;
                }
                else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictPartialRedemptionOfCreditNote == false) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowCashRefundCreditNoteBalance == true) {
                        if (BILLSETTLEMENT.VARIABLE.CreditNoteRedeemption == true) {
                            BILLSETTLEMENT.VARIABLE.cNDetails.CreditNoteRefundAmount = FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.dCNValue, POSCommon.numberOfDecimal) - FConvert.toDecimal(BILLSETTLEMENT.VARIABLE.cNDetails.RedeemedAmount, POSCommon.numberOfDecimal);
                            BILLSETTLEMENT.VARIABLE.cNDetails.Status = CreditNoteStatus.Used;
                            BILLSETTLEMENT.VARIABLE.cNDetails.IsPartialRedemptionRestricted = true;
