    getPointsRedemptionValueChangeEvent: function () {
        try {
            //
            var totalPoints = $("#txtPointsRedemptionTotalPoints").val();
            var strPointsToRedeem = "";
            totalPoints = (totalPoints.toString().split(".")[0]).length;
            strPointsToRedeem = $.trim($("#txtPointsRedemptionPointsToRedeem").val());
            if (strPointsToRedeem.trim().length == 1 && strPointsToRedeem == ".")
                return;

            if (FConvert.toDecimal(strPointsToRedeem) != 0) {
                var _PointsToRedeem = FConvert.toDecimal(strPointsToRedeem);
                if (_PointsToRedeem <= FConvert.toDecimal($("#txtPointsRedemptionTotalPoints").val())) {
                    var balancePoints = (FConvert.toDecimal($("#txtPointsRedemptionTotalPoints").val()) - _PointsToRedeem);
                    $("#txtPointsRedemptionBalancePoints").val(FConvert.toDecimal(balancePoints, POSCommon.numberofDecimal));
                    var totalRedeptValue = (FConvert.toDecimal($("#txtPointsRedemptionPointsRedemptionVal").val()) * _PointsToRedeem);
