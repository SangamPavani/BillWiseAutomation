        assignEmployeeRestrictionDataAsPerPreference: function (employee, bCustomer) {
            try {
                if (!(employee == null || employee == undefined || employee.MaximumDiscountRestriction == null || employee.MaximumDiscountRestriction == undefined || employee.MaximumDiscountRestriction.MaximumDiscountAllowed == 0)) {
                    if (ApplicationNew.RetailTransFooter != null) {
                        ApplicationNew.RetailTransFooter.EmployeeGrossSaleForDiscountRestriction = 0;
                        ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction = 0;
                    }
                    if (employee.MaximumDiscountRestriction.StartDate != null && employee.MaximumDiscountRestriction.StartDate != undefined && employee.MaximumDiscountRestriction.EndDate != null && employee.MaximumDiscountRestriction.EndDate != undefined) {
                        if (employee.MaximumDiscountRestriction.StartDate > 0 || employee.MaximumDiscountRestriction.EndDate > 0) {
                            let transactionDate;
                            if (POSCommon.transactionDate == 0)
                                transactionDate = DATE.prototype.today(POSCommon.CalType);
                            else
                                transactionDate = POSCommon.transactionDate;

                            if (transactionDate != null && transactionDate != undefined) {
                                if (transactionDate >= employee.MaximumDiscountRestriction.StartDate && transactionDate <= employee.MaximumDiscountRestriction.EndDate) {
                                    if (employee.MaximumDiscountRestriction.RestrictionType != 0) {
                                        ///Need to get Body and footer discounts and if include scheme discount exists then get that scheme discounts
                                        ///as well for the Employee as per the restriction type(Per day/for the period).
                                        ///Need Total Gross amount of all the bills as per the restriction type(Per day/for the period) for the employee.
                                        ///Parameters:: EmployeeId, RestrictionType, Body discount colmaps, Footer discount colmaps
                                        ///Returns:: Total Gross, Total Discount
                                        let BodyDiscountColMaps = [], FooterDiscountColMaps = [];
                                        let iDynamicFieldsCount = 0;
                                        iDynamicFieldsCount = POSCommon.lineWiseList.length;
                                        if (iDynamicFieldsCount > 0) {
                                            if (ApplicationNew.BodyPanelExtraFieldsList != null && ApplicationNew.BodyPanelExtraFieldsList != undefined && ApplicationNew.BodyPanelExtraFieldsList.length > 0) {
                                                for (let Counter = 0; Counter < ApplicationNew.BodyPanelExtraFieldsList.length; Counter++) {
                                                    if (ApplicationNew.BodyPanelExtraFieldsList[Counter].IsDiscountField) {
                                                        BodyDiscountColMaps.push(ApplicationNew.BodyPanelExtraFieldsList[Counter].ColMap);
                                                    }
                                                }
                                            }
                                        }
                                        if (ApplicationNew.RetailTransFooter.FooterFieldsList != null && ApplicationNew.RetailTransFooter.FooterFieldsList != undefined && ApplicationNew.RetailTransFooter.FooterFieldsList.length > 0) {
                                            for (let k = 0; k < ApplicationNew.RetailTransFooter.FooterFieldsList.length; k++) {
                                                if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("SCHEMEDISCOUNT")) {
                                                    if (PreferenceSetting.PrefMiscellaneousOtherTab.ConsiderSchemeDiscountAllowedBySalemanORWaiter) {
                                                        FooterDiscountColMaps.push(ApplicationNew.RetailTransFooter.FooterFieldsList[k].ColMap);
                                                        continue;
                                                    }
                                                }
                                                if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].IsDiscountField) {
                                                    FooterDiscountColMaps.push(ApplicationNew.RetailTransFooter.FooterFieldsList[k].ColMap);
                                                }
                                            }
                                        }
                                        let sEmployeeDiscountRestrictionArgs = POSDATASTRUCTURE.getEmptyEmployeeDiscountRestrictionArgs();
                                        sEmployeeDiscountRestrictionArgs.EmployeeData = employee;
                                        sEmployeeDiscountRestrictionArgs.FooterDiscountColMaps = FooterDiscountColMaps;
                                        sEmployeeDiscountRestrictionArgs.BodyDiscountColMaps = BodyDiscountColMaps;
                                        sEmployeeDiscountRestrictionArgs.TransactionDate = transactionDate;
                                        NETWORK.executeServerMethod(GLOBAL.getContextPath("GetEmployeeSalesByRestrictionType", "RetailMainScreen", "PointOfSale"),
                                            true, { sEmployeeDiscountRestrictionArgs: JSON.stringify(sEmployeeDiscountRestrictionArgs), bCustomer: bCustomer }, "JSON", false,
                                            function (bSuccess, data) {
                                                if (bSuccess == false) {
                                                    toastr.error(msgErrorwhilecallingmethod);
                                                    return;
                                                }

                                                if (data.bSuccess == false) {
                                                    if (data.sMessage != null && data.sMessage != undefined)
                                                        toastr.error(data.sMessage);
                                                    return;
                                                }
                                                ApplicationNew.RetailTransFooter.EmployeeGrossSaleForDiscountRestriction = FConvert.toDecimal(data.employeeDiscountRestrictionAmount[0]);
                                                ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction = FConvert.toDecimal(data.employeeDiscountRestrictionAmount[1]);
                                            }, "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                                    }
                                }
                            }
                        }
                    }
                }
                else if (ApplicationNew.RetailTransFooter != null) {
                    ApplicationNew.RetailTransFooter.EmployeeGrossSaleForDiscountRestriction = 0;
                    ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction = 0;
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message);
                console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: SEARCHCLAUSE.SEARCHEMPLOYEE.assignEmployeeRestrictionDataAsPerPreference, Catch block : Error Message : " + Ex.message);
                return false;
            }
        },
