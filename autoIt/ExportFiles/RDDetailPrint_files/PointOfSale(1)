        }
    },
};

TREEVIEWCONTROL.SEARCH.TREEEVENT =
{
    changeStatus: function (element) {
        try {
            //debugger;
            let isChecked = $(element).is(":checked");
            let iProductGroupId = $(element).attr("data-ProductGroupId");

            if (iProductGroupId == null || iProductGroupId == undefined) // Product Group CheckBox Checked
            {
                if (isChecked == true) {
                    $(element).prop("checked", true);
                    $(element).attr("checked", true);
                    TREEVIEWCONTROL.SEARCH.TREEEVENT.addRemoveProduct(element, true, false);
                }
                else {
                    $(element).prop("checked", false);
                    $(element).attr("checked", false);
                    TREEVIEWCONTROL.SEARCH.TREEEVENT.addRemoveProduct(element, false, false);
                }
            }
            else if (iProductGroupId != null & iProductGroupId != undefined) //Leaf Product Checked
            {
                if (isChecked == true) {
                    $(element).prop("checked", true);
                    $(element).attr("checked", true);
                    $("#ulChildren_" + iProductGroupId + " input[type=checkbox]").prop("checked", true);
                    $("#ulChildren_" + iProductGroupId + " input[type=checkbox]").attr("checked", true);
                    TREEVIEWCONTROL.SEARCH.TREEEVENT.addRemoveProduct(element, true, true);
                }
                else {
                    $(element).prop("checked", false);
                    $(element).attr("checked", false);
                    $("#ulChildren_" + iProductGroupId + " input[type=checkbox]").prop("checked", false);
                    $("#ulChildren_" + iProductGroupId + " input[type=checkbox]").attr("checked", false);
                    TREEVIEWCONTROL.SEARCH.TREEEVENT.addRemoveProduct(element, false, true);
                }
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.SEARCH.TREEEVENT.TREEEVENT.changeStatus :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    addRemoveProduct: function (element, isAddToList, isGroup) {
        //debugger;
        try {
            let iId = $(element).attr("id");
            let controlName = $(element).attr('data-ControlName');
            let navigationProperties = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #divProductSearchTree").attr("data-NavigationProperties");

            if (navigationProperties == null || navigationProperties == undefined || navigationProperties.length <= 0) {
                toastr.error("Can not read navgation attribute");
                return;
            }

            navigationProperties = JSON.parse(navigationProperties);

            var pageRecord = $("#" + navigationProperties.ControlName + " > div#divPageRecord_" + navigationProperties.ControlName).find("input[type=hidden][id=" + navigationProperties.PageNumber + "]");
            if (pageRecord != null && pageRecord != undefined && pageRecord.length > 0) {
                let treeViewControlPageWise = $(pageRecord).attr("data-TreeViewControlPageWiseRecord");
                if (treeViewControlPageWise != null && treeViewControlPageWise != undefined && treeViewControlPageWise.length > 0) {
                    treeViewControlPageWise = JSON.parse(treeViewControlPageWise);

                    if (treeViewControlPageWise.SelectedProductId == null || treeViewControlPageWise.SelectedProductId == undefined || treeViewControlPageWise.SelectedProductId.length <= 0)
                        treeViewControlPageWise.SelectedProductId = [];

                    if (treeViewControlPageWise.SelectedProductUnitId == null || treeViewControlPageWise.SelectedProductUnitId == undefined || treeViewControlPageWise.SelectedProductUnitId.length <= 0)
                        treeViewControlPageWise.SelectedProductUnitId = [];

                    if (treeViewControlPageWise.SelectedProductGroupId == null || treeViewControlPageWise.SelectedProductGroupId == undefined || treeViewControlPageWise.SelectedProductGroupId.length <= 0)
                        treeViewControlPageWise.SelectedProductGroupId = [];

                    if (isGroup == false)// Adding single product
                    {
                        //Adding 'Unit Id' Of Selected 'Product Id' In Saperate List
                        let elementProductInfo = $("#" + controlName + " li#elementList_" + iId).attr("data-ProductInfo");
                        if (elementProductInfo != null && elementProductInfo != undefined && elementProductInfo.length > 0) {
                            elementProductInfo = JSON.parse(elementProductInfo);

                            if (elementProductInfo.UnitId > 0) {
                                let unitIdFound = treeViewControlPageWise.SelectedProductUnitId.filter((p) => FConvert.toInt(p) == FConvert.toInt(elementProductInfo.UnitId));
                                if (unitIdFound == null || unitIdFound == undefined || unitIdFound.length <= 0)
                                    treeViewControlPageWise.SelectedProductUnitId.push(elementProductInfo.UnitId);
                            }
                        }

                        //Adding Product Id In Saperate List
                        if (isAddToList == true)
                            treeViewControlPageWise.SelectedProductId.push(iId);
                        else
                            treeViewControlPageWise.SelectedProductId = treeViewControlPageWise.SelectedProductId.filter((p) => p != iId);
                    }
                    else if (isGroup == true) {
                        //debugger;

                        //Adding Only Product Group Id In Saperate List
                        if (isAddToList == true)
                            treeViewControlPageWise.SelectedProductGroupId.push(iId);
                        else
                            treeViewControlPageWise.SelectedProductGroupId = treeViewControlPageWise.SelectedProductGroupId.filter((p) => p != iId);

                        //Adding Only Child Id In Saperate List
                        let childrenProductId = $("#" + navigationProperties.ControlName + " #ulChildren_" + iId + " input[type=checkbox]");
                        if (childrenProductId != null && childrenProductId != undefined && childrenProductId.length > 0) {
                            if (isAddToList == true) {
                                let productGroupChildId = 0;
                                for (let i = 0; i < childrenProductId.length; i++) {
                                    productGroupChildId = $(childrenProductId[i]).attr('id');
                                    treeViewControlPageWise.SelectedProductId.push(productGroupChildId);

                                    //Add 'Product Unit Id'
                                    let elementProductInfo = $("#" + navigationProperties.ControlName + " li#elementList_" + productGroupChildId).attr("data-ProductInfo");
                                    if (elementProductInfo != null && elementProductInfo != undefined && elementProductInfo.length > 0) {
                                        elementProductInfo = JSON.parse(elementProductInfo);

                                        if (elementProductInfo.UnitId > 0) {
                                            let unitIdFound = treeViewControlPageWise.SelectedProductUnitId.filter((p) => FConvert.toInt(p) == FConvert.toInt(elementProductInfo.UnitId));
                                            if (unitIdFound == null || unitIdFound == undefined || unitIdFound.length <= 0)
                                                treeViewControlPageWise.SelectedProductUnitId.push(elementProductInfo.UnitId);
                                        }
                                    }
                                }
                            }
                            else {
                                let productGroupChildId = 0;
                                for (let i = 0; i < childrenProductId.length; i++) {
                                    productGroupChildId = $(childrenProductId[i]).attr('id');
                                    treeViewControlPageWise.SelectedProductId = treeViewControlPageWise.SelectedProductId.filter((p) => p != productGroupChildId);

                                    //Add 'Product Unit Id'
                                    let elementProductInfo = $("#" + navigationProperties.ControlName + " li#elementList_" + productGroupChildId).attr("data-ProductInfo");
                                    if (elementProductInfo != null && elementProductInfo != undefined && elementProductInfo.length > 0) {
                                        elementProductInfo = JSON.parse(elementProductInfo);

                                        if (elementProductInfo.UnitId > 0) {
                                            let unitIdFound = treeViewControlPageWise.SelectedProductUnitId.filter((p) => FConvert.toInt(p) == FConvert.toInt(elementProductInfo.UnitId));
                                            if (unitIdFound == null || unitIdFound == undefined || unitIdFound.length <= 0)
                                                treeViewControlPageWise.SelectedProductUnitId.push(elementProductInfo.UnitId);
                                            else if (unitIdFound != null && unitIdFound != undefined && unitIdFound.length > 0) {
                                                treeViewControlPageWise.SelectedProductUnitId = treeViewControlPageWise.SelectedProductUnitId.filter((p) => FConvert.toInt(p) == FConvert.toInt(elementProductInfo.UnitId));
                                                treeViewControlPageWise.SelectedProductUnitId.push(elementProductInfo.UnitId);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    $(pageRecord).attr("data-TreeViewControlPageWiseRecord", JSON.stringify(treeViewControlPageWise));
                }
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.SEARCH.TREEEVENT.addRemoveProduct :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
};

