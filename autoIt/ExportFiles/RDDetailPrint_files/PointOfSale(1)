                        arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = PreferenceSetting.PrefOutletTab.OutletAccountsTab.PreOrderAccount; //Debit 
                    else {
                        if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                            && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != undefined &&
                            ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData != null &&
                            ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData != undefined
                            && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData.length > 0)
                            arrTransBody[SalesInvoiceTransactionBodyIndex.Book] = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData[0].Book;  //Debit
                    }
                }
            }
            //debugger;
            //Filling Tags
            let arrTags = [], tagValue = new Object();
            tagValue.ID = 1101;
            tagValue.Tag = POSCommon.counterId;
            arrTags.push(tagValue);

            // Member
            let iMemberId = FConvert.toInt((ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined || ApplicationNew.MemberData.ID <= 0) ? 0 : ApplicationNew.MemberData.ID);
