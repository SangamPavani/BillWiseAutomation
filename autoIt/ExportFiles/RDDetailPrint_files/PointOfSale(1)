                        break;
                    case "MEMBERPOINTINTEGRATION":
                        PREFERENCE.OUTLETPREFERENCE.loadOutletMemberPointIntegrationTab();
                        break;
                }

                let arrValue = [], idNamePair = null;
                if (PREFERENCE.VARIABLE.OutletList != null && PREFERENCE.VARIABLE.OutletList != undefined && PREFERENCE.VARIABLE.OutletList.length > 0) {
                    idNamePair = new Object();
                    idNamePair.ID = 0;
                    idNamePair.Name = "Select All";
                    arrValue.push(idNamePair);
                }
                for (let i = 0; i < PREFERENCE.VARIABLE.OutletList.length; i++) {
                    idNamePair = new Object();
                    idNamePair.ID = PREFERENCE.VARIABLE.OutletList[i].Id;
                    idNamePair.Name = PREFERENCE.VARIABLE.OutletList[i].Name;
                    arrValue.push(idNamePair);
                }

                for (var i = 0; i < arrValue.length; i++) {
                    if (arrValue[i].ID == iOutletid) {
                        arrValue.splice(i, 1);
                        break;
                    }
                }

                LISTCHECKBOXCONTROL.updateOptions("ddlSelectedOutletCopy", arrValue, true, null);
