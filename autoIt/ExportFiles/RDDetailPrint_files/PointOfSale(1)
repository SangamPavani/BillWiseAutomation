                        let Products = ApplicationNew.ListOfItems.filter((p) => p.DefaultValue1 == SchemesImplementedProds[ic].DefaultValue1 && p.PromoType == PromoTypes.get("NORMAL") && p.ProductUnit == SchemesImplementedProds[ic].SalesUnit && p.ProductType == 0
