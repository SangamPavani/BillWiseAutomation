    getProductSetAsKeyValuePair: function (retailsSetDetails) {
        try {
            let arrKeyValuePair = [];
            for (let i = 0; i < retailsSetDetails.length; i++) {
                let alreadyFound = arrKeyValuePair.filter((p) => p.Key == retailsSetDetails[i].DefaultValue1);
                if (alreadyFound == null || alreadyFound == undefined || alreadyFound.length <= 0) {
                    let keyValuePair = new Object();
                    keyValuePair.Key = retailsSetDetails[i].DefaultValue1;
                    keyValuePair.Value = [];
                    keyValuePair.Value.push(retailsSetDetails[i]);

                    arrKeyValuePair.push(keyValuePair);
                }
                else if (alreadyFound != null && alreadyFound != undefined && alreadyFound.length > 0) {
                    alreadyFound = alreadyFound[0];
                    alreadyFound.Value.push(retailsSetDetails[i]);
                }
            }

            return arrKeyValuePair;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.getProductSetAsKeyValuePair :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return null;
        }
    },
    updateDiscountCell: function (calculatingLinewiseFields) {
        try {
            ////debugger;
            var msgDiscountCannotBeGreaterThanGross = $("#msgDiscountCannotBeGreaterThanGross").val();
            var msgUserApprovalRequired = $("#msgUserApprovalRequired ").val();
            var msgManagerApprovalRequired = $("#msgManagerApprovalRequired  ").val();

