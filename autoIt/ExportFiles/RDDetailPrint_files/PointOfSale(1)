                    return;
                var approvalValues = [true, false, data.ManagerId];
                VERIFICATIONPROCESS.VARIABLES.ApprovalValue = approvalValues;
                var result = COMMONMETHODS.validateShortcut(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                if (result != undefined && result != null && result == true) {
                    if (VERIFICATIONPROCESS.VARIABLES.IsBatchReportVerification == true)
