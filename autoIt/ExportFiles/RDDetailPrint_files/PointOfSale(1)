    getLoadDiscountVouhcersData: function (DiscountVoucherDet, arrDiscountVoucherDet) {
        try {
            POSSCHEMEIMPLEMENTATIONGENERICS.assignSchemeImplementationClass(null);
            let completedDiscountVouchers = [];
            if (DiscountVoucherDet.ProductsList != null && DiscountVoucherDet.ProductsList != undefined && DiscountVoucherDet.ProductsList.length > 0) {
                let matchedProducts = POSSCHEMEIMPLEMENTATIONGENERICS.getMatchedItemsWithDVProducts(DiscountVoucherDet.ProductsList);
                if (matchedProducts != null && matchedProducts != undefined && matchedProducts.length > 0) {
                    let matchedItemsGross = 0;
                    let grossOfDiscountVoucher = 0;
                    for (let j = 0; j < matchedProducts.length > 0; j++) {
                        matchedItemsGross = matchedItemsGross + (FConvert.toDecimal(matchedProducts[j].DefaultValue5, POSCommon.numberOfDecimal) - FConvert.toDecimal(matchedProducts[j].DiscountTotal_UptoCurrentField, POSCommon.numberOfDecimal));
                    }
                    let grossDiscountVoucherDetails = arrDiscountVoucherDet.filter((p) => p.DvRegId == DiscountVoucherDet.DvRegId);
                    if (grossDiscountVoucherDetails != null && grossDiscountVoucherDetails != undefined && grossDiscountVoucherDetails.length > 0) {
                        for (let k = 0; k < grossDiscountVoucherDetails.length > 0; k++) {
                            grossOfDiscountVoucher = grossOfDiscountVoucher + grossDiscountVoucherDetails[k].TotalValueOfVoucher;
                        }
                    }
                    if (DiscountVoucherDet.Redeemable == false) {
                        if (matchedItemsGross > grossOfDiscountVoucher) {
                            let neededDictionary = null;
                            if (completedDiscountVouchers != null && completedDiscountVouchers != undefined && completedDiscountVouchers.length > 0) {
                                neededDictionary = completedDiscountVouchers.filter((p) => p.Key == DiscountVoucherDet.DvRegId);
                                if (neededDictionary != null && neededDictionary != undefined) {
                                    return;
                                }
                            }
                            if (neededDictionary == null || neededDictionary == undefined || neededDictionary.length <= 0) {
                                neededDictionary = new Object();
                                neededDictionary.Key = DiscountVoucherDet.DvRegId;
                                neededDictionary.Value = DiscountVoucherDet.DvRegId;
                                completedDiscountVouchers.push(neededDictionary);
                            }
                            let totalProportionateValue = 0;
                            let _line = matchedProducts;
                            for (let q = 0; q < _line.length > 0; q++) {
                                let proportionateValue = 0;
                                if (_line[q].DiscountTotal_UptoCurrentField == null || _line[q].DiscountTotal_UptoCurrentField == undefined)
                                    _line[q].DiscountTotal_UptoCurrentField = 0;

                                proportionateValue = ((_line[q].DefaultValue5 - _line[q].DiscountTotal_UptoCurrentField) * grossOfDiscountVoucher) / matchedItemsGross;
                                totalProportionateValue = totalProportionateValue + proportionateValue;
                                //BILLSETTLEMENT.applyLoadDiscVouchersToBill(_line[q], proportionateValue, DiscountVoucherDet.Id, DiscountVoucherDet.Redeemable);
                            }
                            let difference = FConvert.toDecimal(grossOfDiscountVoucher, POSCommon.numberOfDecimal) - FConvert.toDecimal(totalProportionateValue, POSCommon.numberOfDecimal);
                            let discountVoucherPrompts = BillSettlement.DiscountVoucherPrompts;
                            if (difference != null && difference != undefined && difference != 0) {
                                /*matchedProducts[matchedProducts.length - 1].DefaultValue6 = matchedProducts[matchedProducts.length - 1].DefaultValue6 + difference;*/
                                matchedProducts[matchedProducts.length - 1].DynamicLineFields[0].FieldInput = matchedProducts[matchedProducts.length - 1].DynamicLineFields[0].FieldValue = matchedProducts[matchedProducts.length - 1].DynamicLineFields[0].FieldInput + difference;
                                discountVoucherPrompts[discountVoucherPrompts.length - 1].Amount = discountVoucherPrompts[discountVoucherPrompts.length - 1].Amount + difference;
                            }
                        }
                        else
                            BILLSETTLEMENT.addToDiscVoucherPrompts(0, DiscountVoucherDet.TotalValueOfVoucher, 0, DiscountVoucherDet.Id, DiscountVoucherDet.Redeemable);
                    }
                    else
                        BILLSETTLEMENT.addToDiscVoucherPrompts(0, DiscountVoucherDet.TotalValueOfVoucher, 0, DiscountVoucherDet.Id, DiscountVoucherDet.Redeemable);

                    matchedProducts = null;
                }
            }

            if (BillSettlement.DiscountVoucherPrompts == null || BillSettlement.DiscountVoucherPrompts == undefined || BillSettlement.DiscountVoucherPrompts.length <= 0)
                BillSettlement.DiscountVoucherPrompts = [];

        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENT.getLoadDiscountVouhcersData, Catch block : Error Message : " + Ex.message);
            return returnData;
        }
    },
};

