                if (tableselectOutlet == null || tableselectOutlet == undefined || tableselectOutlet.length <= 0) {
                    toastr.error(msgtxtInfoCantSaveRec);
                    $("#ddlMemberType").focus();
                    return false;
                }
            }

            if ($("#chkPramotionalDef").prop("checked") == true) {
                if (dtValidFrom < DATE.prototype.today(POSCommon.CalType)) {
