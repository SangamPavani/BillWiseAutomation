                        COMMON.prototype.showMessage(msgPleaseEnterFixedAmount, "");
                        $("#txtFixedRate").focus();
                        return false;
                    }
                    var selFixedRateOnItemId = $("#ddlFixedRateOnItem option:selected").attr("id");
                    if (FConvert.toInt(selFixedRateOnItemId) <= 0) {
                        COMMON.prototype.showMessage(msgPlsSelectFixedPrice, "");
                        $("#ddlFixedRateOnItem").focus();
                        return false;
                    }
                    if (FConvert.toInt(selFixedRateOnItemId) == 3 || FConvert.toInt(selFixedRateOnItemId) == 4) {
                        if (SCHEMES.VARIABLE.ItemId == null || SCHEMES.VARIABLE.ItemId == undefined || SCHEMES.VARIABLE.ItemId.trim().length <= 0) {
                            COMMON.prototype.showMessage(txtPleaseIncludeAtleastOneItemAsMandInTheCriteria, "");
                            //FPRODUCTCONTROL.METHODS.clearTree("divProductTreeControl");
                            return false;
                        }
                    }
                }
                else if (selDiscountType == "DiscountVouchers") {
                    var tr = $("#tbodyDVouchers").find('tr');
                    var arrDiscountVouchers = [];
                    var discountVouchersList = [];
                    for (var i = 0; i < tr.length; i++) {
                        var trDiscountVouchers = $(tr[i]).attr("data-DiscountVouchers");
                        if (trDiscountVouchers != null && trDiscountVouchers != undefined && trDiscountVouchers.length > 0) {
                            trDiscountVouchers = JSON.parse(trDiscountVouchers);
                            arrDiscountVouchers.push(trDiscountVouchers);
                            var discountVouchers = arrDiscountVouchers.filter((p) => p.DVouchersId > 0 && p.Quantity > 0);
                            if (discountVouchers != null && discountVouchers != undefined && discountVouchers.length > 0)
                                discountVouchersList.push(discountVouchers[0]);
                        }
                    }
                    if (discountVouchersList == null || discountVouchersList == undefined || discountVouchersList.length == 0) {
                        COMMON.prototype.showMessage(msgPleaseSelectDiscVoucher, "");
                        discountVouchersList = [];
                        return false;
                    }
                }

                return true;
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMES.SCHEMESBUTTONCLICK.IsValidationFree_Add :: Catch block :: Exception :: " + Ex.message);
            }
        },

        IsValidationFree_Save: function () {
            try {
                //debugger;
                let msgEnterscheme = $("#msgEnterscheme").val();
                let msgToDateCannotLessThanFromDate = $("#msgToDateCannotLessThanFromDate").val()
                let msgDuplicateSchemeName = $("#msgDuplicateSchemeName").val();
                let msgPlsSelectDays = $("#msgPlsSelectDays").val();
                let msgThereIsNoDiscountDefinitionCannotSave = $("#msgThereIsNoDiscountDefinitionCannotSave").val();
                let txtPleaseIncludeAtleastOneItemAsMandInTheCriteria = $("#txtPleaseIncludeAtleastOneItemAsMandInTheCriteria").val();
                let txtPlzSelOutlets = $("#msgSelectOutlet").val();
                if (optSchemeName.value == null || optSchemeName.value == "" || optSchemeName.value == undefined) {
                    COMMON.prototype.showMessage(msgEnterscheme, "");
                    $("input#optSchemeName").focus();
                    return false;
                }
                var dtFromDate = DATEPICKER.getDate("dtpFromDate");
                var dtToDate = DATEPICKER.getDate("dtpToDate");
                if (dtToDate < dtFromDate) {
                    COMMON.prototype.showMessage(msgToDateCannotLessThanFromDate, "");
                    $("input#dtpToDate").focus();
                    return false;
                }
                var selectedItemId = FConvert.toInt(OPTIONCONTROL.getControlValue(optSchemeName));

                if (selectedItemId == 0) {

                    var SchemesDiscountDef = new Object();
                    SchemesDiscountDef.Name = optSchemeName.value;
                    SchemesDiscountDef.DiscTypeID = 1;

                    var result = SCHEMESCOMMONMETHODS.checkForSchemeNameDuplicate(SchemesDiscountDef)
                    if (result == true) {
                        COMMON.prototype.showMessage(msgDuplicateSchemeName, "");
                        OPTIONCONTROL.clear("optSchemeName")
                        $("input#optSchemeName").focus();
                        return false;
                    }
                }

                if (SCHEMES.SCHEMESBUTTONCLICK.PromptToSelectSchemeType() == false)
                    return false;

                if (SCHEMESOUTLETS.VARIABLE.OutletId == "") {
                    COMMON.prototype.showMessage(txtPlzSelOutlets);
                    return false;
                }

                SCHEMES.VARIABLE.lstWeeksDay = LISTCHECKBOXCONTROL.getControlData("ddlWeekdays");
                if (SCHEMES.VARIABLE.lstWeeksDay.length == 0) {
                    COMMON.prototype.showMessage(msgPlsSelectDays, "");
                    $("ddlWeekdays").focus();
                    return false;
                }

                if (SCHEMES.VARIABLE.SchemesDiscDtls.length == 0) {
                    COMMON.prototype.showMessage(msgThereIsNoDiscountDefinitionCannotSave, "");
                    return false;
                }

                if (optSchemeName.value != null && optSchemeName.value != "" && optSchemeName.value != undefined) {

                    var hasConflict = false;
                    var selSchemeTypeId = $("#ddlSchemeType option:selected").attr("id");
                    for (var i = 0; i < SCHEMES.VARIABLE.SchemesDiscDtls.length; i++) {
                        if ((SCHEMES.VARIABLE.SchemesDiscDtls[i].Itemstobepresent == "" || SCHEMES.VARIABLE.SchemesDiscDtls[i].Itemstobepresent == null || SCHEMES.VARIABLE.SchemesDiscDtls[i].Itemstobepresent == undefined) && selSchemeTypeId == 2) {
                            hasConflict = true;
                            COMMON.prototype.showMessage(txtPleaseIncludeAtleastOneItemAsMandInTheCriteria, "");
                            /*FPRODUCTCONTROL.METHODS.clearTree("divProductTreeControl");*/
                            var index = i;
                            SCHEMES.VARIABLE.SchemesDiscDtls[index].IsSelected = true;
                            break;
                        }
                    }
                    if (hasConflict == true)
                        return false;
                }
                return true;
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMES.SCHEMESBUTTONCLICK.IsValidationFree_Save :: Catch block :: Exception :: " + Ex.message);
                return false;
            }
        },

