                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainAddProduct.js :: JavaScript Function :: PRODUCTMETHODNEW.validateProductSetBeforeAdd :: Catch Block :: Exception :: " + Ex.message);
