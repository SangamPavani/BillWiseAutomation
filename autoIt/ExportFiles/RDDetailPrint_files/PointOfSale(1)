                if (productListLength == null || productListLength == undefined || productListLength <= 0) {
                    toastr.error(msgtxtInfoAddOneProDataGrid);
                    return false;
                }
            }

            if (PreferenceSetting.PrefMiscellaneousTab.AllowCriteriaDefinitionMemberPoints == false) {
                let controlValue = $("#txtRedemptValue").val();
                if (controlValue == null || controlValue == undefined || controlValue.trim().length <= 0) {
                    toastr.error(msgtxtInfoPlzEnterRedemption);
                    $("#txtRedemptValue").focus();
                    return false;
                }

                controlValue = $("#txtRedemptValue").val();
                if (controlValue == null || controlValue == undefined || controlValue.trim().length <= 0) {
                    toastr.error(msgtxtInfoRedmptionValGrterZero);
                    $("#txtRedemptValue").focus();
                    return false;
                }
            }
            else if (PreferenceSetting.PrefMiscellaneousTab.AllowCriteriaDefinitionMemberPoints == true) {
                let criteriaDefinitionTableRow = $("#tbodyMemberPointsDefCriteria > tr");
                if (criteriaDefinitionTableRow == null || criteriaDefinitionTableRow == undefined || criteriaDefinitionTableRow.length <= 0) {

                    toastr.error(msgAtleastoneCriteriamustbedefined);
                    return false;
                }
            }

            if (PreferenceSetting.PrefMiscellaneousTab.AllowCriteriaDefinitionMemberPoints == false && PreferenceSetting.PrefMiscellaneousTab.PointsProductWise == false) {

                let pointsAccValue = $("#txtOnlyPointsAccValue").val();
                if (pointsAccValue == null || pointsAccValue == undefined || pointsAccValue.trim().length <= 0) {
                    toastr.error(msgPleaseEnterPointsAccumulationValue);
                    $("#txtRedemptValue").focus();
                    return false;
                }

                if (pointsAccValue <= 0) {
                    toastr.error(msgPointsAccumulationValShouldBeGreaterThanZero);
                    $("#txtRedemptValue").focus();
                    return false;
                }
