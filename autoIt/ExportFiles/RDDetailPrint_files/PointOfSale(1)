                if (ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined
                    && ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined
                    && ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount != null && ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount != undefined
                    && FConvert.toDecimal(ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount) >= 0) {
                    //1. Opening 'Sales Return Remarks' Screen
                    if (SALESRETURN.VARIABLES.preferenceSetting.PrefOutletTab.OutletGeneralTab.ReasonForReturnMandatory == true
                        && (ApplicationNew.SalesReturn.SalesReturnWeb.ReturnRemarks == null || ApplicationNew.SalesReturn.SalesReturnWeb.ReturnRemarks == undefined
                            || ApplicationNew.SalesReturn.SalesReturnWeb.ReturnRemarks.trim().length <= 0)) {
                        var arrValues = [];
                        arrValues.push(0);
                        SHORTCUTMETHODS.loadShortcutFunction(1010, false, arrValues, null);
                        return;
                    }

                    if (FConvert.toDecimal(ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount) > 0 && ApplicationNew.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn == false) {
                        //2. Opening 'Refund Settlement' Screen
                        SALESRETURN.setRefundSettlementObject();
                        SHORTCUTMETHODS.loadShortcutFunction(1011);
                        return;
                    }
                    else if ((FConvert.toDecimal(ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount) > 0 && ApplicationNew.SalesReturn.SalesReturnWeb.IsFullPrePaidReturn == true)
                        || FConvert.toDecimal(ApplicationNew.SalesReturn.SalesReturnWeb.ReturnedNetAmount) <= 0) {
                        //2. Posting Sales Return Transaction
                        TRANSACTION.postSalesReturn();
                        return;
                    }
                }
            }

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPOSSALES") && ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined
                && ApplicationNew.PreOrderInfo.RefundedAmount != null && ApplicationNew.PreOrderInfo.RefundedAmount != undefined
                && FConvert.toDecimal(ApplicationNew.PreOrderInfo.RefundedAmount) > 0) {
                PREORDERSEARCH.openRefundSettlement(ApplicationNew.PreOrderInfo.RefundedAmount);
                return;
            }

            if (ApplicationNew.IsHoldTransaction == true) {
                SHORTCUTMETHODS.loadShortcutFunction(30, false, null, null);
                RETAILMAIN.setFocusBarCodeTextBox();
                return;
            }
            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPOSSALES")
                || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPOSSALES")
                || ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY")) {
                if (ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY")) {
                    if (HOMEDELIVERY.VARIABLES.isHomeDeliveryLoaded == true && HOMEDELIVERY.VARIABLES.isSaveClick == true) {
                        HOMEDELIVERY.getHomeDeliveryDetails();
                        HOMEDELIVERY.SERVERMETHODS.raiseOrUpdatePosSalesAndSaveHomeDelivery();
                        return;
                    }
                }
                HEADEREXTRAFIELDS.callImplementBillWiseSchemes();
            }
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERYFEEDBACK"))
                HEADEREXTRAFIELDS.callImplementBillWiseSchemes();
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER")
                || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER")) {
                if (PREORDERSEARCH.VARIABLE.isCancelClick == true) {
                    PREORDERSEARCH.openRefundSettlement(ApplicationNew.PreOrderInfo.RefundedAmount);
                    return;
                }
                if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") && ApplicationNew.PreOrderInfo != null
                    && ApplicationNew.PreOrderInfo != undefined && ApplicationNew.PreOrderInfo.LocalPreOrderDetails != null
                    && ApplicationNew.PreOrderInfo.LocalPreOrderDetails != undefined
                    && ApplicationNew.PreOrderInfo.LocalPreOrderDetails.Deposit <= 0) {
                    TRANSACTION.postPreOrder();
                    return;
                }
                else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") && (ApplicationNew.PreOrderInfo == null
                    || ApplicationNew.PreOrderInfo == undefined || ApplicationNew.PreOrderInfo.LocalPreOrderDetails == null
                    || ApplicationNew.PreOrderInfo.LocalPreOrderDetails == undefined)) {
                    HEADEREXTRAFIELDS.callImplementBillWiseSchemes();

                    if (ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined && POSCommon.posTemplate.IsEstimatedBill == false)
                        return;
                    if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined
                        && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0) {
                        return;
                    }
                }
                if (POSCommon.posTemplate != null && POSCommon.posTemplate != undefined) {
                    if (POSCommon.posTemplate.IsEstimatedBill == true) {
                        ESTIMATIONBILL.validateEstimatedBillVoucher();
                        return;
                    }
                }

                PREORDERDETAILS.openBillSettlement();
                return;
            }
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION")) {
                let controlValue = $("#txtPreOrderCollectionBalancePending").val();
                if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue, POSCommon.numberofDecimal) > 0) {
                    var arrValues = [];
                    arrValues.push(FromScreen.get("PREORDERCOLLECTION"));
                    arrValues.push("TRANSACTION.postPreOrderCollection()");
                    arrValues.push(56);
                    var billSettlementObject = BILLSETTLEMENT.getBillSettlementObject();
                    arrValues.push(billSettlementObject);
                    SHORTCUTMETHODS.loadShortcutFunction(56, false, arrValues, null);
                    return;
                }
                if (ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.Status == 3) {
                    //debugger;
                    let result = POSSCHEMEIMPLEMENTATIONGENERICS.implementBillWiseSchemes();
                    //debugger;
                    if (result != null && result != undefined && result[0] == true && result[1] == "MANAGERAPPROVALDISCOUNTAUTHORIZATIONSCHEMES")
                        return;

                    if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0)
                        BILLSETTLEMENT.SCHEMESMETHODS.openSchemeFreeItemSelectionScreen();
                    else if (ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != null && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != undefined && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts.length > 0)
                        BILLSETTLEMENT.SCHEMESMETHODS.openSchemeDiscountVoucherScreen();
                    else
                        PREORDERCOLLECTION.preOrderCollectionFinalPayment();
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: HEADEREXTRAFIELDS.getControlValue, Catch block : Error Message : " + Ex.message);
