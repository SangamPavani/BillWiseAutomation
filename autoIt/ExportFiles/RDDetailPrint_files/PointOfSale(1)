                                        _loadingProduct.DynamicLineFields[k].FieldColMap = _NewLineList[ProductCounter].DynamicLineFields[k].FieldColMap;
                                    }

                                    _loadingProduct.DynamicLineFields[k].FieldId = _NewLineList[ProductCounter].DynamicLineFields[k].FieldId;
                                    _loadingProduct.DynamicLineFields[k].FieldName = _NewLineList[ProductCounter].DynamicLineFields[k].FieldName;
