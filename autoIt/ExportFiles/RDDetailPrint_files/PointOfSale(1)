    getInputControlQuantityEvent: function (inputControl, evt) {
        try {
            var msgtxtQtyNotBeZeroOrEpt = $("#msgtxtQtyNotBeZeroOrEpt").val();
            var msgBBQConversionWastageMandatory = $("#msgBBQConversionWastageMandatory").val();
            var charCode = null;
            if (evt != null && evt != undefined)
                charCode = (evt.which) ? evt.which : evt.keyCode;
            else
                charCode = 13;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (charCode == 13 || charCode == 9) {
                var inputControlText = $(inputControl).val();
                var inputControlClosestTableCell = $(inputControl).closest('td');
                var inputControlClosestTableRow = $(inputControl).closest('tr');
                var parsedBBQConversionInfo = JSON.parse($(inputControlClosestTableRow).attr('data-BBQConversionInfo'));
                parsedBBQConversionInfo.Quantity = FConvert.toInt($(inputControl).val());

                if (inputControlText.length == 0 || inputControlText == 0) {
                    toastr.error(msgtxtQtyNotBeZeroOrEpt);
                    $(inputControl).find('input').remove();
                    return;
                }
                if (parsedBBQConversionInfo.Wastage <= 0) {
                    toastr.error(msgBBQConversionWastageMandatory);
                    return;
                }
                if (inputControlText > 0) {
                    parsedBBQConversionInfo.ConvertedQuantity = FConvert.toInt(inputControlText) - ((FConvert.toInt(inputControlText) * parsedBBQConversionInfo.Wastage) / 100);
                    parsedBBQConversionInfo.ShortageQty = parsedBBQConversionInfo.Quantity - parsedBBQConversionInfo.ConvertedQuantity;
                    var inputFound = $(inputControl).find('input');
                    if (inputFound != null && inputFound != undefined && inputFound.length > 0)
                        $(inputControl).find('input').remove();
                    $(inputControlClosestTableCell).html(FConvert.toDecimal(parsedBBQConversionInfo.Quantity, POSCommon.numberOfDecimal));
                    $(inputControlClosestTableRow).attr('data-BBQConversionInfo', JSON.stringify(parsedBBQConversionInfo));
                    return true;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: BBQCONVERSION.getInputControlQuantityEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
    },
