    updatePaidAmt: function () {
        try {
            ////debugger;
            if (BillSettlement.BillSettlementPaymentDetails == null || BillSettlement.BillSettlementPaymentDetails == undefined)
                BillSettlement.BillSettlementPaymentDetails = BILLSETTLEMENTDATASTRUCTURE.getEmptyPaymentDetails();

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == true) {
                if (GlobalPref.Version == eVersion.Version9) {
                    var rowCount = $('#tBodyCashWithCurrency tr').length;
                    if (rowCount != null && rowCount != undefined && FConvert.toInt(rowCount) > 0) {
                        var cashWithCurrencyExists = $("#tBodyCashWithCurrency").length;
                        if (cashWithCurrencyExists != null && cashWithCurrencyExists != undefined && cashWithCurrencyExists != "" && FConvert.toInt(cashWithCurrencyExists) > 0)
                            var PerfectScrollForMultiCurrencyTable = new PerfectScrollbar("#tBodyCashWithCurrency");
                    }
                }
            }
            var PrevChangeAmt = FConvert.toDecimal($("#lblBillChange").val());
            //Cash
            if (BillSettlement.BillSettlementPaymentDetails.CashPaidDet != null && BillSettlement.BillSettlementPaymentDetails.CashPaidDet != undefined && BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length > 0) {
                var cashPaidSum = 0, schemeDiscountSum = 0;

                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CashPaidDet.length; i++) {
                    cashPaidSum = FConvert.toDecimal(FConvert.toDecimal(cashPaidSum) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].CashAmount), POSCommon.numberOfDecimal);
                    schemeDiscountSum = FConvert.toDecimal(FConvert.toDecimal(schemeDiscountSum) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CashPaidDet[i].SchemeDiscount), POSCommon.numberOfDecimal);
                }
                BillSettlement.BillSettlementPaymentDetails.CashPaid = cashPaidSum;
                BillSettlement.SchemeDiscountCash = schemeDiscountSum;
            }
            else {
                BillSettlement.BillSettlementPaymentDetails.CashPaid = 0;
                BillSettlement.SchemeDiscountCash = 0;
            }

            //Credit Card
            var cCard = 0, cCardCharges = 0;
            if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet != null && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != undefined && BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
                    cCardCharges = FConvert.toDecimal(FConvert.toDecimal(cCardCharges) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardCharges), POSCommon.numberOfDecimal);

                if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                    && BillSettlement.CardChargesColMap != '' && BillSettlement.CardChargesColMap.EffectOnNetId == 1) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
                        cCard = FConvert.toDecimal(FConvert.toDecimal(cCard) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].DebitAmount), POSCommon.numberOfDecimal);

                    cCard = FConvert.toDecimal(FConvert.toDecimal(cCard) + FConvert.toDecimal(cCardCharges), POSCommon.numberOfDecimal);
                }
                else {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
                        cCard = FConvert.toDecimal(FConvert.toDecimal(cCard) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].DebitAmount), POSCommon.numberOfDecimal);
                }
                BillSettlement.CreditCardCharges = cCardCharges;
                BillSettlement.BillSettlementPaymentDetails.CreditCardPaid = cCard;
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++)
                    BillSettlement.CreditCardSchemeDisc = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.CreditCardSchemeDisc) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].SchemeDiscount), POSCommon.numberOfDecimal);
            }
            else {
                BillSettlement.BillSettlementPaymentDetails.CreditCardPaid = BillSettlement.CreditCardCharges = BillSettlement.CreditCardSchemeDisc = 0;
            }

            //Debit Card
            var dCard = 0, dCardCharges = 0;
            if (BillSettlement.BillSettlementPaymentDetails.DebitCardDet != null && BillSettlement.BillSettlementPaymentDetails.DebitCardDet != undefined && BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length; i++)
                    dCardCharges = FConvert.toDecimal(FConvert.toDecimal(dCardCharges) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardDet[i].CardCharges), POSCommon.numberOfDecimal);

                if (BillSettlement.CardChargesColMap != null && BillSettlement.CardChargesColMap != undefined
                    && BillSettlement.CardChargesColMap != '' && BillSettlement.CardChargesColMap.EffectOnNetId == 1) {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length; i++)
                        dCard = FConvert.toDecimal(FConvert.toDecimal(dCard) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardDet[i].DebitAmount), POSCommon.numberOfDecimal);

                    dCard = FConvert.toDecimal(FConvert.toDecimal(dCard) + FConvert.toDecimal(dCardCharges), POSCommon.numberOfDecimal);
                }
                else {
                    for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length; i++)
                        dCard = FConvert.toDecimal(FConvert.toDecimal(dCard) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardDet[i].DebitAmount), POSCommon.numberOfDecimal);
                }

                BillSettlement.DebitCardCharges = dCardCharges;
                BillSettlement.BillSettlementPaymentDetails.DebitCardPaid = dCard;
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.DebitCardDet.length; i++)
                    BillSettlement.DebitCardSchemeDisc = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.DebitCardSchemeDisc) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardDet[i].SchemeDiscount), POSCommon.numberOfDecimal);
            }
            else {
                BillSettlement.BillSettlementPaymentDetails.DebitCardPaid = BillSettlement.DebitCardCharges = BillSettlement.DebitCardSchemeDisc = 0;
            }

            //Cheque
            var cheque = 0;
            if (BillSettlement.ChequeDet != null && BillSettlement.ChequeDet != undefined && BillSettlement.ChequeDet != '' && BillSettlement.ChequeDet.length > 0) {
                for (let i = 0; i < BillSettlement.ChequeDet.length; i++)
                    cheque = FConvert.toDecimal(FConvert.toDecimal(cheque) + FConvert.toDecimal(BillSettlement.ChequeDet[i].ChequePaid), POSCommon.numberOfDecimal);
                BillSettlement.BillSettlementPaymentDetails.ChequePaid = cheque;
            }
            else {
                BillSettlement.BillSettlementPaymentDetails.ChequePaid = 0;
                BillSettlement.SchemeDiscountCheque = 0;
            }


            //Gift Voucher
            var gvAmt = 0;
            if (BillSettlement.BillSettlementPaymentDetails.GVDet != null && BillSettlement.BillSettlementPaymentDetails.GVDet != undefined && BillSettlement.BillSettlementPaymentDetails.GVDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.GVDet.length; i++) {
                    if (BillSettlement.BillSettlementPaymentDetails.GVDet[i].MemberId == 0)
                        BillSettlement.BillSettlementPaymentDetails.GVAmt_MemberPoints = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.GVAmt_MemberPoints) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.GVDet[i].GiftVoucherValue), POSCommon.numberOfDecimal);

                    gvAmt = FConvert.toDecimal(FConvert.toDecimal(gvAmt) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.GVDet[i].GiftVoucherValue), POSCommon.numberOfDecimal);
                    BillSettlement.GiftVoucherSchemeDisc = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.GiftVoucherSchemeDisc) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.GVDet[i].GVSchemeDisc), POSCommon.numberOfDecimal);
                }
                BillSettlement.BillSettlementPaymentDetails.GiftVoucherPaid = gvAmt;
            }
            else
                BillSettlement.BillSettlementPaymentDetails.GiftVoucherPaid = BillSettlement.GiftVoucherSchemeDisc = 0;

            //Credit Note
            var creditNote = 0;
            if (BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != null
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != ''
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length; i++)
                    creditNote = FConvert.toDecimal(FConvert.toDecimal(creditNote) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails[i].RedeemedAmount), POSCommon.numberOfDecimal);
                BillSettlement.BillSettlementPaymentDetails.CreditNotePaid = creditNote;
            }
            else
                BillSettlement.BillSettlementPaymentDetails.CreditNotePaid = 0;

            //Discount Voucher

            var rtnValue = BILLSETTLEMENT.getDiscountValuesforDiscVoucher(true);
            //////debugger;

            var totalLineDiscountWithDV = FConvert.toDecimal(rtnValue[0], POSCommon.numberofDecimal); // _TotalLineDiscountWithDV;
            var totalBillDiscountWithDV = FConvert.toDecimal(rtnValue[1], POSCommon.numberofDecimal);// _TotalBillDiscountWithDV;
            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined)
                BillSettlement.BillSettlementPaymentDetails.DiscountVoucherPaid = totalLineDiscountWithDV + totalBillDiscountWithDV;

            //Points Redemption
            if (BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != null && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet != undefined && BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length > 0) {
                var PointsRedemptionPaid = 0, PointsRedeemed = 0;
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.MemberPointsDet.length; i++) {
                    PointsRedemptionPaid = FConvert.toDecimal(FConvert.toDecimal(PointsRedemptionPaid) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.MemberPointsDet[i].TotalPointsValue), POSCommon.numberOfDecimal);
                    PointsRedeemed = FConvert.toDecimal(FConvert.toDecimal(PointsRedeemed) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.MemberPointsDet[i].PointToBeRedemp), POSCommon.numberOfDecimal);
                }
                BillSettlement.BillSettlementPaymentDetails.PointsRedemptionPaid = PointsRedemptionPaid;
                BillSettlement.BillSettlementPaymentDetails.PointsRedeemed = PointsRedeemed;
            }
            else
                BillSettlement.BillSettlementPaymentDetails.PointsRedemptionPaid = 0;

            //EPayment
            var eCardCharges = 0, cCard = 0;
            if (BillSettlement.BillSettlementPaymentDetails.EPaymentDet != null
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length > 0) {

                BillSettlement.BillSettlementPaymentDetails.EPaymentPaid = 0;
                var epaycharges = 0;
                BillSettlement.EPaymentCharges = 0;

                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length; i++) {
                    epaycharges = FConvert.toDecimal(FConvert.toDecimal(epaycharges) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].CardCharges));
                    BillSettlement.BillSettlementPaymentDetails.EPaymentPaid = FConvert.toDecimal((FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentPaid) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].DebitAmount)), POSCommon.numberOfDecimal);
                    BillSettlement.SchemeDiscountEPayment = FConvert.toDecimal(BillSettlement.SchemeDiscountEPayment) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].SchemeDiscount);
                }

                BillSettlement.EPaymentCharges = FConvert.toDecimal(epaycharges);
                if (BillSettlement.EPaymentChargesColMap != null && BillSettlement.EPaymentChargesColMap != undefined && BillSettlement.EPaymentChargesColMap.EffectOnNetId == 1)
                    BillSettlement.BillSettlementPaymentDetails.EPaymentPaid = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentPaid) + FConvert.toDecimal(BillSettlement.EPaymentCharges), POSCommon.numberOfDecimal);
            }
            else {
                BillSettlement.BillSettlementPaymentDetails.EPaymentPaid = 0;
                BillSettlement.SchemeDiscountEPayment = 0;
                BillSettlement.EPaymentCharges = 0;
            }
            BillSettlement.EPaymentCharges = FConvert.toDecimal(epaycharges);
            var topup = BillSettlement.BillSettlementPaymentDetails.TopupPaid;

            ////debugger;
            //PrePaidWallet
            if (BillSettlement.BillSettlementPaymentDetails.TopupAccountDets != null && BillSettlement.BillSettlementPaymentDetails.TopupAccountDets != undefined) {
                BillSettlement.BillSettlementPaymentDetails.TopupPaid = 0;
                BillSettlement.BillSettlementPaymentDetails.TopupPaid = FConvert.toDecimal((FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TopupPaid, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TopupAccountDets.Amount, POSCommon.numberOfDecimal, true)), POSCommon.numberOfDecimal, true)
            }
            else
                BillSettlement.BillSettlementPaymentDetails.TopupPaid = 0;

            //Sodexo
            if (BillSettlement.BillSettlementPaymentDetails.SodexoAccountDets == null || BillSettlement.BillSettlementPaymentDetails.SodexoAccountDets == undefined)
                BillSettlement.BillSettlementPaymentDetails.SodexoAmountPaid = 0;

            if (BillSettlement.BillSettlementPaymentDetails.WalletIntegrationDet != null && BillSettlement.BillSettlementPaymentDetails.WalletIntegrationDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.WalletIntegrationDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.WalletIntegrationDet.length; i++)
                    BillSettlement.BillSettlementPaymentDetails.WalletIntegrationPaid = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.PaymentIntegrationPaid) + FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.WalletIntegrationDet[i].DebitAmount), POSCommon.numberOfDecimal);
            }
            else
                BillSettlement.BillSettlementPaymentDetails.WalletIntegrationPaid = 0;

            //--**********************************************************************************

            //var lineDiscountWithDV = 0, billDiscountWithDV = 0;
            ///*True parameter act like a payment type and hence its values are aggreated and updated on left side.*/
            //var rtnValue = BILLSETTLEMENT.getDiscountValuesforDiscVoucher(true);
            //BillSettlement.BillSettlementPaymentDetails.DiscountVoucherPaid = FConvert.toDecimal(FConvert.toDecimal(rtnValue[0]) + FConvert.toDecimal(rtnValue[1]), POSCommon.numberOfDecimal);

            ////Total Paid Amount
            BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt = FConvert.toDecimal(FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CashPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditCardPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DebitCardPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.ChequePaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.GiftVoucherPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditNotePaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.PointsRedemptionPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.DiscountVoucherPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.CreditSalePaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.EPaymentPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.TopupPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.WalletIntegrationPaid) +
                FConvert.toDecimal(BillSettlement.BillSettlementPaymentDetails.SodexoAmountPaid), POSCommon.numberOfDecimal);

            //
            BillSettlement.BillSettlementPaymentDetails.TotalSchemeAmount =
                FConvert.toDecimal(FConvert.toDecimal(BillSettlement.Scheme) +
                    FConvert.toDecimal(BillSettlement.SchemeDiscountCash) +
                    FConvert.toDecimal(BillSettlement.CreditCardSchemeDisc) +
                    FConvert.toDecimal(BillSettlement.DebitCardSchemeDisc) +
                    FConvert.toDecimal(BillSettlement.GiftVoucherSchemeDisc) +
                    FConvert.toDecimal(BillSettlement.SchemeDiscountEPayment), POSCommon.numberOfDecimal);

            //Method called to update footer right side fields
            ////debugger;
            BILLSETTLEMENT.updateTextBlocks_RightSide(BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt, POSCommon.localCurrency);
            //////debugger;
            //Method called to update footer left side fields
            var CurrentChangeAmt = FConvert.toDecimal($("#lblBillChange").text());

            //Pole Display
            if (BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt == 0)
                POSCOMMUNICATIONSERVICE.showPoleDisplay(" ", "Nett " + POSCommon.localCurrency.CurrencySymbol + " " + BillSettlement.BillAmount);//, POSCommon.companyName);
            else if (BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt >= BillSettlement.BillAmount)
                POSCOMMUNICATIONSERVICE.showPoleDisplay(("Paid " + POSCommon.localCurrency.CurrencySymbol + " " + BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt), ("Change " + POSCommon.localCurrency.CurrencySymbol + " " + CurrentChangeAmt));
            else
                POSCOMMUNICATIONSERVICE.showPoleDisplay(("Paid " + POSCommon.localCurrency.CurrencySymbol + " " + BillSettlement.BillSettlementPaymentDetails.TotalPaidAmt), ("Balance " + POSCommon.localCurrency.CurrencySymbol + " " + BillSettlement.BalanceAmount));

            if (PrevChangeAmt != CurrentChangeAmt) {
                if (BILLSETTLEMENT.adjustChangeAmount() == false)
                    return;
            }

            if (BillSettlement.IsSinglePaymentMode == true && FConvert.toDecimal($("#lblBillChange").text()) == 0
                && FConvert.toDecimal($("#lblBillBalance").text()) <= 0) {
                var postingMethod = $("#btnFooter").attr("onclick");
                eval(postingMethod);
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleBillSettlement.js :: Method :: BILLSETTLEMENT.updatePaidAmt :: Catch Block :: Exception :: " + Ex.message);
            return false;
        }
