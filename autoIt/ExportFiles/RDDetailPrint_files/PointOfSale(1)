                    ApplicationNew.IsNewProdCodeExecuted = true;
                    if (ApplicationNew.BatchRelatedList != null && ApplicationNew.BatchRelatedList != undefined && ApplicationNew.BatchRelatedList.length > 0) {
                        if (POSCommon.inputBatchEvenIfStockIsNotUpdated == true) {
                            for (let k = 0; k < ApplicationNew.BatchRelatedList.length; k++)
                                ApplicationNew.BatchRelatedList[k].Index = -1;

                            ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                            PRODUCTMETHODNEW.BATCHPOPUPMETHODS.openBatchPopup();
                            return [false, ""];
                        }
                        else {
                            if (ApplicationNew.PresentTransactionMode != TransactionModes.get("NEWPREORDER") && ApplicationNew.PresentTransactionMode != TransactionModes.get("EDITPREORDER")) {
                                for (let k = 0; k < ApplicationNew.BatchRelatedList.length; k++)
                                    ApplicationNew.BatchRelatedList[k].Index = -1;

                                ApplicationNew.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
                                PRODUCTMETHODNEW.BATCHPOPUPMETHODS.openBatchPopup();
                                return [false, ""];
                            }
                        }
                    }
                }
                //Opening RMA Popup

                let rtnRMSSupport = PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopupAddToProduct(_line, false, [RMALogic.AddSet], objCustDefLeftPanelDisplay);
                if (rtnRMSSupport != null && rtnRMSSupport != undefined && rtnRMSSupport.length > 0) {
                    if (FConvert.toBoolean(rtnRMSSupport[0]) == false)
                        return [false, rtnRMSSupport[1]];
                    else if (rtnRMSSupport[0] == true && rtnRMSSupport[1] != null && rtnRMSSupport[1] != undefined && rtnRMSSupport[1].trim().length > 0) {
                        PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopup();
                        return [false, ""];
                    }
                }

                //Opening Change Price Popup
                if (_line.DefaultValue4 == 0) {
                    let rtnChangePricePopup = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopupAddToProduct([ChangePriceLogic.AddSet, _line], objCustDefLeftPanelDisplay);
                    if (rtnChangePricePopup != null && rtnChangePricePopup != undefined && rtnChangePricePopup.length > 0) {
                        if (FConvert.toBoolean(rtnChangePricePopup[0]) == false)
                            return [false, rtnChangePricePopup[1]];
                        else if (FConvert.toBoolean(rtnChangePricePopup[0]) == true && FConvert.toString(rtnChangePricePopup[1]) != null && FConvert.toString(rtnChangePricePopup[1]) != undefined
                            && FConvert.toString(rtnChangePricePopup[1]).trim().length > 0) {
                            PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopup(0);
                            return [false, ""];
                        }
                    }
                }

                if (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length <= 0)
                    ApplicationNew.ListOfItems = [];

                if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != undefined) {
                    if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != undefined) {
                        if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.IsProductReplacementEnabled == true) {
                            RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.AddedLineProduct = _line;
                            let lstCustLineWise = ApplicationNew.ListOfItems;
                            PRODUCTSELECTION.dusMinutesAppIntegrationReplaceProduct(lstCustLineWise, RETAILMAIN.VARIABLE.ApplicationIntegrationArgs);
                            ApplicationNew.ListOfItems = lstCustLineWise;
                            _line = RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.AddedLineProduct;
                        }
                    }
                }
                ApplicationNew.ListOfItems.push(_line);
                CALCULATION.calculateLineWiseNet(_line, ApplicationNew);
                PRODUCTMETHODNEW.SERVERMETHODS.afterAddedProduct();
            }
            return [true, ""];
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: PRODUCTSELECTION.addSetToGridAsSet :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    updateSetsProperties: function (parentProduct) {
        try {
            let counter = 0, counterSetOrModifier = 0;
            let item = null;
            if (parentProduct.PosProductMake == PosProductMake.get("SET")) {
                //Set Properties
                if (parentProduct.RetailSetsDetails != null && parentProduct.RetailSetsDetails != undefined && parentProduct.RetailSetsDetails.length > 0) {
                    let dAdditionalCessInput = 0;
                    let discountColumn = ApplicationNew.BodyPanelExtraFieldsList.filter((p) => p.SequenceNumber == 8 && p.IsDiscountField == true);
                    if (discountColumn != null && discountColumn != undefined && discountColumn.length > 0)
                        discountColumn = discountColumn[0];
                    else
                        discountColumn = null;
                    let gstColumn = ApplicationNew.BodyPanelExtraFieldsList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("GST"));
                    if (gstColumn != null && gstColumn != undefined && gstColumn.length > 0)
                        gstColumn = gstColumn[0];
                    else
                        gstColumn = null;
                    let additionalcessColumn = ApplicationNew.BodyPanelExtraFieldsList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("AdditionalCess"));
                    if (additionalcessColumn != null && additionalcessColumn != undefined && additionalcessColumn.length > 0)
                        additionalcessColumn = additionalcessColumn[0];
                    else
                        additionalcessColumn = null;

                    for (counterSetOrModifier = 0; counterSetOrModifier < parentProduct.RetailSetsDetails.length; counterSetOrModifier++) {
                        item = parentProduct.RetailSetsDetails[counterSetOrModifier];
                        item.ProductType = parentProduct.RetailSetsDetails[counterSetOrModifier].ProductType;
                        item.PosProductMake = PosProductMake.get("SET");

                        item.DefaultValue3 = item.OriginalQuantity * parentProduct.DefaultValue3;
                        item.DefaultValue5 = item.DefaultValue3 * item.DefaultValue4;
                        item.ComplimentaryRemarks = parentProduct.ComplimentaryRemarks;
                        item.SchemeDiscount = 0;
                        item.DefaultValue15 = item.DefaultValue5;
                        item.ManualDiscountTotal = item.DiscountTotal_UptoCurrentField = 0;
                        item.IsPricebookValsLoaded = false;
                        let arrParams = new Object();
                        for (counter = 0; counter < ApplicationNew.BodyPanelExtraFieldsList.length; counter++) {
                            if (ApplicationNew.BodyPanelExtraFieldsList[counter].PreloadFormulaEnable) {
                                if (ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour == FieldBehaviour.get("GST")
                                    || ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour == FieldBehaviour.get("CGST")
                                    || ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour == FieldBehaviour.get("SGST")) {
                                    continue;
                                }
                                else if (ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour == FieldBehaviour.get("AdditionalCess")) {
                                    arrParams.custLineWise = item;
                                    arrParams.MemberData = ApplicationNew.MemberData;
                                    arrParams.EmployeeData = ApplicationNew.EmployeeData;
                                    arrParams.ListOfItems = ApplicationNew.ListOfItems;

                                    let dcessInput = POSFORMULA.evaluateBodyFormula(ApplicationNew.BodyPanelExtraFieldsList[counter].Preload, arrParams);
                                    item.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput = FConvert.toDecimal(dcessInput, POSCommon.numberOfDecimal, true);
                                    dAdditionalCessInput = dAdditionalCessInput + FConvert.toDecimal(dcessInput, POSCommon.numberOfDecimal, true);
                                }
                            }
                            if (ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour != FieldBehaviour.get("GST")
                                && ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour != FieldBehaviour.get("CGST")
                                && ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour != FieldBehaviour.get("SGST")
                                && ApplicationNew.BodyPanelExtraFieldsList[counter].FieldBehaviour != FieldBehaviour.get("AdditionalCess")) {
                                if (ApplicationNew.BodyPanelExtraFieldsList[counter].OutputCalculationId != 1)
                                    item.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput = FConvert.toDecimal(parentProduct.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput);
                                else {
                                    let proportionateValue = (parentProduct.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput * item.DefaultValue5) / parentProduct.DefaultValue5;
                                    if (proportionateValue == null && proportionateValue == undefined)
                                        item.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput = 0;
                                    else {
                                        item.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput = FConvert.toDecimal(proportionateValue);
                                        if (counter == 0 && discountColumn != null && discountColumn != undefined) {
                                            item.SchemeDiscount = FConvert.toDecimal(proportionateValue, POSCommon.numberOfDecimal, true);
                                        }
                                    }
                                }
                            }
                            CALCULATION.calculateLineWise(ApplicationNew.BodyPanelExtraFieldsList[counter], item);
                        }
                    }
                    if (gstColumn != null && gstColumn != undefined) {
                        let arrParams = new Object();
                        if (gstColumn.PreloadFormulaEnable) {
                            arrParams.custLineWise = parentProduct;
                            arrParams.MemberData = ApplicationNew.MemberData;
                            arrParams.EmployeeData = ApplicationNew.EmployeeData;
                            arrParams.ListOfItems = ApplicationNew.ListOfItems;
                            let dInput = POSFORMULA.evaluateBodyFormula(gstColumn.Preload, arrParams);
                            parentProduct.DynamicLineFields[gstColumn.ColumnIndex].FieldInput = FConvert.toDecimal(dInput, POSCommon.numberOfDecimal, true);
                            for (CounterSetOrModifier = 0; CounterSetOrModifier < parentProduct.RetailSetsDetails.length; CounterSetOrModifier++) {
                                parentProduct.RetailSetsDetails[CounterSetOrModifier].DynamicLineFields[gstColumn.ColumnIndex].FieldInput = parentProduct.DynamicLineFields[gstColumn.ColumnIndex].FieldInput;
                            }
                        }
                        else {
                            for (CounterSetOrModifier = 0; CounterSetOrModifier < parentProduct.RetailSetsDetails.length; CounterSetOrModifier++) {
                                parentProduct.RetailSetsDetails[CounterSetOrModifier].DynamicLineFields[gstColumn.ColumnIndex].FieldInput = parentProduct.DynamicLineFields[gstColumn.ColumnIndex].FieldInput;
                                CALCULATION.calculateLineWise(gstColumn, item);
                            }
                        }
                    }
                    if (additionalcessColumn != null && additionalcessColumn != undefined) {
                        parentProduct.DynamicLineFields[additionalcessColumn.ColumnIndex].FieldInput = dAdditionalCessInput;
                    }
                }
            }
            else {
                //Dynamic Properties
                if (parentProduct.DynamicSetsDetails != null && parentProduct.DynamicSetsDetails != undefined && parentProduct.DynamicSetsDetails.length > 0) {
                    let discountColumn = ApplicationNew.BodyPanelExtraFieldsList.filter((p) => p.SequenceNumber == 8 && p.IsDiscountField == true);
                    if (discountColumn != null && discountColumn != undefined && discountColumn.length > 0)
                        discountColumn = discountColumn[0];

                    for (counterSetOrModifier = 0; counterSetOrModifier < parentProduct.DynamicSetsDetails.length; counterSetOrModifier++) {
                        item = parentProduct.DynamicSetsDetails[counterSetOrModifier];
                        item.ProductType = parentProduct.DynamicSetsDetails[counterSetOrModifier].ProductType;
                        item.PosProductMake = PosProductMake.get("SET");

                        item.DefaultValue3 = item.OriginalQuantity * parentProduct.DefaultValue3;
                        item.DefaultValue5 = item.DefaultValue3 * item.DefaultValue4;
                        item.ComplimentaryRemarks = parentProduct.ComplimentaryRemarks;
                        item.VATTaxCategory = parentProduct.VATTaxCategory;
                        item.VATTaxCode = parentProduct.VATTaxCode;
                        item.DefaultValue15 = item.DefaultValue5;// - item.DefaultValue6;
                        item.ManualDiscountTotal = item.DiscountTotal_UptoCurrentField = 0;
                        for (counter = 0; counter < ApplicationNew.BodyPanelExtraFieldsList.length; counter++) {
                            if (ApplicationNew.BodyPanelExtraFieldsList[counter].OutputCalculationId != 1)
                                item.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput = FConvert.toDecimal(parentProduct.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput);
                            else {
                                let proportionateValue = (parentProduct.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[counter].ColumnIndex].FieldInput * item.DefaultValue5) / parentProduct.DefaultValue5;
                                if (proportionateValue == null && proportionateValue == undefined)
                                    item.DynamicLineFields[discountColumn.ColumnIndex].FieldInput = 0;
                                else
                                    item.DynamicLineFields[discountColumn.ColumnIndex].FieldInput = FConvert.toDecimal(proportionateValue);
                            }
                            CALCULATION.calculateLineWise(ApplicationNew.BodyPanelExtraFieldsList[counter], item);
                        }
                    }
                }
                // #endregion
            }
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: PRODUCTSELECTION.updateSetsProperties:: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
