                                newObject.CurrentItem = ApplicationNew.CurrentItem;
                                newObject.IsNew = false;
                                ApplicationNew.BatchRelatedList.push(newObject);
                                responseQuantityCellValue[0] = true;
                                responseQuantityCellValue[1] = null;
                                responseQuantityCellValue[2] = "RMAPOPUP";
                                return responseQuantityCellValue;
                            }
                        }
                    }
                }

                // Discount Greater Than Gross Validation
                if (_line.productType == 0 && dPrevQty > dQty && _line.DefaultValue15 < 0) {
                    if (ApplicationNew.BodyPanelExtraFieldsList != null && ApplicationNew.BodyPanelExtraFieldsList != undefined && ApplicationNew.BodyPanelExtraFieldsList.length > 0) {
                        for (let Counter = 0; Counter < ApplicationNew.BodyPanelExtraFieldsList.length; Counter++) {
                            if (ApplicationNew.BodyPanelExtraFieldsList[Counter].IsDiscountField == true &&
                                ApplicationNew.BodyPanelExtraFieldsList[Counter].OutputCalculationId == 1 &&
                                ApplicationNew.BodyPanelExtraFieldsList[Counter].EffectOnNetId == 2)
                                _line.DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[Counter].ColumnIndex].FieldInput = 0;
                        }
                    }
                    responseQuantityCellValue[0] = true;
                    responseQuantityCellValue[1] = "Discount can not be greater than Gross";
                    responseQuantityCellValue[2] = null;
                    return responseQuantityCellValue;
                }

                // CutOff Price & Manager Approval
                let rtnCutOffPrice = PRODUCTSELECTION.validateDiscountWithCutOffPrice(ApplicationNew.CurrentItem, 1005);
                if (rtnCutOffPrice != null && rtnCutOffPrice != undefined && rtnCutOffPrice.length > 0) {
                    if (FConvert.toBoolean(rtnCutOffPrice[0]) == false) {
                        _line.DefaultValue3 = dPrevQty;
                        ApplicationNew.CurrentItem = _line;
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                        responseQuantityCellValue[0] = true;
                        responseQuantityCellValue[1] = rtnCutOffPrice[1];
                        responseQuantityCellValue[2] = null;
                        return responseQuantityCellValue;
                    }
                    else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true) {
                        if (rtnCutOffPrice[1] != null && rtnCutOffPrice[1] != undefined && FConvert.toString(rtnCutOffPrice[1]).length > 0) {
                            _line.DefaultValue3 = dPrevQty;
                            ApplicationNew.CurrentItem = _line;
                            ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                            CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                            responseQuantityCellValue[0] = true;
                            responseQuantityCellValue[1] = null;
                            responseQuantityCellValue[2] = rtnCutOffPrice[1];
                            return responseQuantityCellValue;
                        }
                        else if (rtnCutOffPrice[1] == null || rtnCutOffPrice[1] == undefined || rtnCutOffPrice[1] == "" || FConvert.toString(rtnCutOffPrice[1]).length <= 0) {
                            if (rtnCutOffPrice[2] != null && rtnCutOffPrice[2] != undefined && rtnCutOffPrice.length > 2) {
                                // ApprovalRecord objApprovalRecordCutOffPrice = (ApprovalRecord)rtnCutOffPrice[2];
                                //CommonPos mgrPreferences = GetUserPreferences(objApprovalRecordCutOffPrice.ApprovalId);
                                let mgrPreferencesCutOffPriceIndex = 0;
                                let dCutOffPriceForMgr = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.abs(ApplicationNew.CurrentItem.DefaultValue3), mgrPreferencesCutOffPriceIndex);
                                if ((Math.abs(ApplicationNew.CurrentItem.DefaultValue3) * dCutOffPriceForMgr) > (Math.abs(ApplicationNew.CurrentItem.DefaultValue3 * ApplicationNew.CurrentItem.DefaultValue4) - dCurrentCellEnteredValue)) {
                                    _line.DefaultValue3 = dPrevQty;
                                    ApplicationNew.CurrentItem = _line;
                                    ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                    CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                    responseQuantityCellValue[0] = true;
                                    responseQuantityCellValue[1] = "You are not allowed to give this discount";
                                    responseQuantityCellValue[2] = null;
                                    return responseQuantityCellValue;
                                }
                            }
                        }
                        PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(ApplicationNew.CurrentItem);
                    }
                }

                ApplicationNew.CurrentItem = _line;
                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[_line.ItemSerialNo - 1], ApplicationNew);
            }
            responseQuantityCellValue[0] = true;
            responseQuantityCellValue[1] = null;
            responseQuantityCellValue[2] = null;
            return responseQuantityCellValue;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.updateQuantity :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
