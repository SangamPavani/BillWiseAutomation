    ChangeLayout: function (clickedLayout) {
        try {
            RETAILMAIN.VARIABLE.selectedLayout = $(clickedLayout).attr('id');
            if (RETAILMAIN.VARIABLE.previousSelectedLayout == RETAILMAIN.VARIABLE.selectedLayout)
                return;

            RETAILMAIN.showRightPanelOnLayoutClicked();
            var leftColHtml = $('#leftColumn').html();
            var rightColHtml = $('#rightColumn').html();
            if (RETAILMAIN.VARIABLE.selectedLayout == "Layout1") {
                $("#leftColumn").html(rightColHtml);
                $("#rightColumn").html(leftColHtml);
                RETAILMAIN.VARIABLE.previousSelectedLayout = RETAILMAIN.VARIABLE.selectedLayout;
                let middleIcon = $("#iconHideShowRightPanel");
                $(middleIcon).addClass("fa-arrow-circle-o-right");
                $(middleIcon).removeClass("fa-arrow-circle-o-left");
            }
            else if (RETAILMAIN.VARIABLE.selectedLayout == "Layout2") {
                $("#leftColumn").html(rightColHtml);
                $("#rightColumn").html(leftColHtml);
                RETAILMAIN.VARIABLE.previousSelectedLayout = RETAILMAIN.VARIABLE.selectedLayout;
                let middleIcon = $("#iconHideShowRightPanel");
                $(middleIcon).removeClass("fa-arrow-circle-o-right");
                $(middleIcon).addClass("fa-arrow-circle-o-left");
            }
            else if ($(clickedLayout).attr('id') == "EnableLog") {
                NETWORK.executeServerMethod(GLOBAL.getContextPath("EnableLog", "RetailMainScreenCustomization",
                    "PointOfSale"),
                    true, { isEnableLog: true }, "JSON", false,
                    function (bSuccess) {
                        if (bSuccess == false)
                            return;
                        else {
                            $("#EnableLog").css("display", "none");
                            $("#DisableLog").css("display", "block");
                            if (GlobalPref.Version == eVersion.Version10) {
                                $("#divEnable").css("display", "none");
                                $("#divDisable").css("display", "block");
                                RETAILMAIN.VARIABLE.selectedLayout = "Layout1";
                            }
                        }
                    }, "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
            }
            else if ($(clickedLayout).attr('id') == "DisableLog") {
                NETWORK.executeServerMethod(GLOBAL.getContextPath("EnableLog", "RetailMainScreenCustomization",
                    "PointOfSale"),
                    true, { isEnableLog: false }, "JSON", false,
                    function (bSuccess) {
                        if (bSuccess == false)
                            return;
                        else {
                            $("#DisableLog").css("display", "none");
                            $("#EnableLog").css("display", "block");
                            if (GlobalPref.Version == eVersion.Version10) {
