    getVoucherSeriesEvent: function () {
        try {
            let msgErrorOccurred = $("input#msgErrorOccurred").val();
            var msgtxtInfoTotalNoVuchrGrterZero = $("#msgtxtInfoTotalNoVuchrGrterZero").val();
            var msgtxtInfoVuchrMaxLimit = $("#msgtxtInfoVuchrMaxLimit").val();
            var msgtxtSeriesNOtValidAlreadyIssued = $("#msgtxtSeriesNOtValidAlreadyIssued").val();
            var msgtxtInfoSomeGvAlreadyIssuedInRange = $("#msgtxtInfoSomeGvAlreadyIssuedInRange").val();
            var msgtxtInfoSeriesExceedEnd = $("#msgtxtInfoSeriesExceedEnd").val();
            var msgErrorOccurredWhileCallingService = $("#msgErrorOccurredWhileCallingService").val();
            var parsedSelectedGiftVoucher = $('#ddlGiftVoucherName option:selected').attr('data-GiftVoucherData');
            if (parsedSelectedGiftVoucher == null || parsedSelectedGiftVoucher == undefined || parsedSelectedGiftVoucher.trim().length <= 0) {
                console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: GIFTVOUCHERSALE.getVoucherSeriesEvent :: Catch block :: Exception :: Selected Gift Voucher attribute is null/undefined/length less than zero");
                return;
            }

            var totalNumberOfVoucher = $("#txtGiftTotalNoOfVoucher").val();
            var giftVoucherValue = $("#txtGiftVoucherValue").val();
            var giftVoucherStartingSeries = $("#txtGiftVoucherStartingSeries").val();

            if (totalNumberOfVoucher == null || totalNumberOfVoucher == undefined || totalNumberOfVoucher.trim().length <= 0) {
                $("#txtGiftVoucherEndingSeries").val('');
                $("#txtGiftTotalValueOfVoucher").val('');
                return;
            }

            if (FConvert.toInt(totalNumberOfVoucher) == 0) {
                toastr.error(msgtxtInfoTotalNoVuchrGrterZero);
                $("#txtGiftVoucherEndingSeries").val('');
                $("#txtGiftTotalValueOfVoucher").val('');
                $("#txtGiftTotalValueOfVoucher").focus();
                return;
            }

            if (FConvert.toInt(totalNumberOfVoucher) > 0 && FConvert.toInt(totalNumberOfVoucher) > 10000) {
                toastr.error(msgtxtInfoVuchrMaxLimit);
                $("#txtGiftVoucherEndingSeries").val('');
                $("#txtGiftTotalValueOfVoucher").val('');
                $("#txtGiftTotalValueOfVoucher").focus();
                return;
            }

            if (giftVoucherStartingSeries == null || giftVoucherStartingSeries == undefined || giftVoucherStartingSeries.trim().length <= 0) {
                $("#txtGiftTotalNoOfVoucher").val('');
                $("#txtGiftVoucherStartingSeries").focus();
                return;
            }

            if (giftVoucherValue == null || giftVoucherValue == undefined || giftVoucherValue.trim().length <= 0)
                return;

            //Check Voucher Series Is Present in Grid Or Not
            var voucherTableRow = $("#tBodyGiftVoucherSale > tr");
            if (voucherTableRow != null && voucherTableRow != undefined && voucherTableRow.length > 0) {
                var lstGiftVoucherDetails = [];
                var selectedGiftVoucher = $("#ddlGiftVoucherName").val();
                for (let i = 0; i < voucherTableRow.length; i++) {
                    var rowId = $(voucherTableRow[i]).attr('id')
                    if (rowId == selectedGiftVoucher) {
                        var GiftVoucherMain = $(voucherTableRow[i]).attr('data-GiftVoucherInfo');
                        if (GiftVoucherMain != null && GiftVoucherMain != undefined && GiftVoucherMain.trim().length > 0) {
                            GiftVoucherMain = JSON.parse(GiftVoucherMain);
                            lstGiftVoucherDetails.push(GiftVoucherMain);
                        }
                    }
                }
                var outletId = 0;
                if (POSCommon.outletId <= 0) {
                    var optFromOutlet = OPTIONCONTROL.getControlDataObject("optGiftVoucherOutlet");
                    outletId = optFromOutlet.iMasterId;
                }
                else
                    outletId = POSCommon.outletId;
                var tempGvReg = {
                    OutletId: outletId,
                    Id: $("#ddlGiftVoucherName").val(),
                    VoucherStartingSeries: $("#txtGiftVoucherStartingSeries").val(),
                    TotalNoOfVoucher: $("#txtGiftTotalNoOfVoucher").val(),
                };

                var gvSales =
                {
                    GvReg: tempGvReg,
                    GvRegistrationList: lstGiftVoucherDetails
                };

                if (gvSales.GvRegistrationList != null && gvSales.GvRegistrationList != undefined && gvSales.GvRegistrationList.length > 0) {
                    var duplicateFound = GIFTVOUCHERSALE.SERVERMETHODS.CheckDuplicateVoucherEntryInGrid(gvSales);
                    if (duplicateFound == "True") {
                        $("#txtGiftVoucherEndingSeries").val('');
                        $("#txtGiftTotalValueOfVoucher").val('');
                        toastr.error(msgtxtSeriesNOtValidAlreadyIssued);
                        return;
                    }
                }
            }

            //Gift Voucher Sold or Not and Validating if Voucher Is Registered For Other Outlet
            var data = GIFTVOUCHERSALE.SERVERMETHODS.GiftVoucherSoldOrRegisterToOther();
            if (data != null && data != undefined) {
                if (data.isVoucherSold == false) {
                    $("#txtGiftVoucherEndingSeries").val('');
                    $("#txtGiftTotalValueOfVoucher").val('');
                    toastr.error(msgtxtInfoSomeGvAlreadyIssuedInRange);
                    return;
                }
                if (data.bRegisterForOtherOutlet != null) {
                    if (data.bRegisterForOtherOutlet[0] == true) {
                        toastr.error(data.bRegisterForOtherOutlet[1]);
                        $("#txtGiftTotalNoOfVoucher").val(data.bRegisterForOtherOutlet[2]);
                        $("#txtGiftVoucherEndingSeries").val(data.bRegisterForOtherOutlet[3]);
                        $("#txtGiftTotalValueOfVoucher").val(FConvert.toDecimal(data.bRegisterForOtherOutlet[4], POSCommon.numberOfDecimal));
                    }
                }
                else if (data.bRegisterForOtherOutlet == null) {
                    $("#txtGiftTotalNoOfVoucher").val('');
                    $("#txtGiftVoucherEndingSeries").val('');
                    $("#txtGiftTotalValueOfVoucher").val('');
                    toastr.error(msgErrorOccurredWhileCallingService);//'Error occurred while calling service');
                    return;
                }
            }
            else {
                toastr.error(msgErrorOccurred);
                return;
            }

            var tempGvReg1 = {
                Id: $("#ddlGiftVoucherName").val(),
                VoucherStartingSeries: $("#txtGiftVoucherStartingSeries").val(),
                TotalNoOfVoucher: $("#txtGiftTotalNoOfVoucher").val(),
                VoucherEndingSeries: parsedSelectedGiftVoucher.VoucherEndingSeries,
                VoucherValue: $("#txtGiftVoucherValue").val()
            };
            var dataReturned = GIFTVOUCHERSALE.SERVERMETHODS.CreateWorkerForCountingVoucher(tempGvReg1);
            if (dataReturned != null && dataReturned != undefined) {

                if (dataReturned.result.ReachEndingSeries == true && (dataReturned.result.ValueOf + 1) == dataReturned.result.TotalNoOfVoucher) {
                    $("#txtGiftVoucherEndingSeries").val(dataReturned.result.StartingSeries);
                    $("#txtGiftTotalNoOfVoucher").val(dataReturned.result.ValueOf + 1);
                    $("#txtGiftTotalValueOfVoucher").val(FConvert.toDecimal((dataReturned.result.TotalNoOfVoucher) * (dataReturned.result.VoucherValue), POSCommon.numberOfDecimal));
                }
                else if (dataReturned.result.ReachEndingSeries == true && (dataReturned.result.ValueOf + 1) < dataReturned.result.TotalNoOfVoucher) {
                    $("#txtGiftVoucherEndingSeries").val(dataReturned.result.StartingSeries);
                    $("#txtGiftTotalNoOfVoucher").val(dataReturned.result.ValueOf + 1);
                    $("#txtGiftTotalValueOfVoucher").val((dataReturned.result.TotalNoOfVoucher - 1) * (dataReturned.result.VoucherValue));//change -1 after confirming
                    toastr.error(msgtxtInfoSeriesExceedEnd);//'Voucher series has exceeded the Ending Series');
                }
                else {
                    // $("#txtGiftVoucherEndingSeries").val(dataReturned.result.StartingSeries);//Added by me
                    $("#txtGiftVoucherEndingSeries").val(dataReturned.result.StartingSeries);
                    $("#txtGiftTotalValueOfVoucher").val(FConvert.toDecimal(dataReturned.result.TotalNoOfVoucher) * (dataReturned.result.VoucherValue), POSCommon.numberOfDecimal);
                }
                $("#divAddGiftVouchers").removeClass("disableopacitypointerstyle");
                $("#divAddGiftVouchers").addClass("enableopacitypointerstyle");
                $("#divAddGiftVouchers").focus();
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: GIFTVOUCHERSALE.getVoucherSeriesEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
