    getPreviousPage: function (navigationModel) {
        try {
            //debugger;
            navigationModel.RowNumber = FConvert.toInt(navigationModel.RowNumber) - 50;
            navigationModel.PageNumber = navigationModel.PageNumber - 1;
            navigationModel.IsLoading = false;

            let isPreviousPageLoaded = TREEVIEWCONTROL.NAVIGATIONEVENT.setHTMLString(navigationModel);
