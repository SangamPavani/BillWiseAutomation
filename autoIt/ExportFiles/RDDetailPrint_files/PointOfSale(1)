    onClickUnit: function () {
        try {
            //debugger;
            let msgPleaseAddAtleastOneItemBeforeSelectingUnits = $("#msgPleaseAddAtleastOneItemBeforeSelectingUnits").val();
            let sIds = $("#divTreeViewControlStoreInformation").attr("data-SelectedProductUnitId");
            if (sIds == null || sIds == undefined || sIds.trim().length == 0) {
                toastr.info(msgPleaseAddAtleastOneItemBeforeSelectingUnits);
                return;
            }

            var sProUnitId = sIds;
            var sSplitsIds = sIds.split(',');
            var lstUnitIds = [];
            var lstProductIds = [];
            if (sSplitsIds != null && sSplitsIds.length > 0) {
                for (var j = 0; j < sSplitsIds.length; j++) {
                    if (sSplitsIds[j] == null || sSplitsIds[j] == undefined || sSplitsIds[j].length <= 0)
                        continue;

                    lstUnitIds.push(FConvert.toInt(sSplitsIds[j]));
                }
            }

            lstUnitIds = lstUnitIds.filter(function (elem, index, self) {
                return index === self.indexOf(elem);
            });

            //debugger;
            let lstUnitList = [], IdNamePair = new Object();
            if (lstUnitIds != null && lstUnitIds != undefined && lstUnitIds.length > 1) {
                IdNamePair = new Object();
