    implementLineWiseSchemes: function () {
        try {
            if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes != undefined && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes.length > 0) {
                let arrProductType = POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes.filter((f) => f.ProductType == 1 || f.ProductType == 2);
                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DoNotAlowSchemesOnExchngeOrSpoilageTran != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DoNotAlowSchemesOnExchngeOrSpoilageTran != undefined
                    && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DoNotAlowSchemesOnExchngeOrSpoilageTran == 1 && arrProductType != null && arrProductType != undefined && arrProductType.length > 0)
                    return;

                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasCombinedSchemesData != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasCombinedSchemesData != undefined
                    && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasUnCombinedSchemesData != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasUnCombinedSchemesData != undefined) {
                    if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasCombinedSchemesData == true && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_HasUnCombinedSchemesData == true)
                        return;
                }
                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ImplSchAtBillStlmnt != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ImplSchAtBillStlmnt != undefined
                    && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ImplSchAtBillStlmnt == false) {
                    let _hasOnlineSchemesToImplement = POSSCHEMEIMPLEMENTATIONGENERICS.checkOnLineSchemes(POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ValidSchemes);
                    if (_hasOnlineSchemesToImplement == false)
                        return;
                }
                let _Prompts = [];
                POSSCHEMEIMPLEMENTATIONGENERICS.loadPropertiesOfSchemesImplemenationClass(SchemeImplementedType.get("LINEWISE"));
                POSSCHEMEIMPLEMENTATIONGENERICS.implementSchemesLineWise(POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.ProductsToImplementSchemes, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_CombinedSchemes, true, _Prompts);

                POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.LinePrompts = [];
                POSSCHEMEIMPLEMENTATIONGENERICS.updatePromptsList(_Prompts);
                POSSCHEMEIMPLEMENTATIONGENERICS.promptAndAddFreeItemsToBill(POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.PromptForFreeItemsLineWise);
                POSSCHEMEIMPLEMENTATIONGENERICS.showSetDiscountInBill();

                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.QtyRemovedFromBill != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.QtyRemovedFromBill != undefined
                    && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.QtyRemovedFromBill > 0)
