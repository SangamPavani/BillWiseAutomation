    formatDate: function (intDate) {
        if (!intDate) return '';
        var str = intDate.toString();
        if (str.length !== 8) return str;
        var year = str.substring(0, 4);
        var month = str.substring(4, 6);
        var day = str.substring(6, 8);
        return month + '/' + day + '/' + year;
    }

