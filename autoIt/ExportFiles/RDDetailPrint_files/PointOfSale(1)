    setPreviousColumn: function (table, iRow, iColumn) {
        try {
            //////debugger;
            iColumn = FConvert.toInt(iColumn);
            --iColumn;
            if (FConvert.toInt(iColumn) <= 0) {
                if ((FConvert.toInt(iRow) - 1) < 0)
                    iColumn = 1;
                else
