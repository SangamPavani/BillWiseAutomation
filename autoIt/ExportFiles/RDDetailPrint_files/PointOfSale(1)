    checkIsAdvanceMandatory: function (deposit) {
        try {
            ////debugger;
            ///No need to check other conditions as Advance is not mandatory
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatory == false)
                return true;

            var bResult = false;
            ///Checking whether advance is mandatory for all
            var perDeposit = PREORDERDETAILS.COMMONMETHOD.getDeposit();
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatForAll == true) {
                if (FConvert.toDecimal(deposit) == 0) {
                    PREORDERDETAILS.showDepositMessage();
                    return false;
                }
                bResult = PREORDERDETAILS.calculateDepositInPercentage(perDeposit);
                if (bResult == false)
                    return false;
            }
            else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatForAll == false) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatMemTypeArray != null
                    && PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatMemTypeArray != undefined) {
                    if (ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined || ApplicationNew.MemberData.ID <= 0) {
                        var bNonMemberFound = PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatMemTypeArray.filter((p) => FConvert.toInt(p) == 0);
                        if (bNonMemberFound != null && bNonMemberFound != undefined && bNonMemberFound.length > 0) {
                            if (FConvert.toDecimal(deposit) == 0) {
                                PREORDERDETAILS.showDepositMessage();
                                return false;
                            }

                            bResult = PREORDERDETAILS.calculateDepositInPercentage(perDeposit);
                            if (bResult == false)
                                return false;
                        }
                    }
                    else if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID > 0) {
                        var bMemberTypeFound = PreferenceSetting.PrefOutletTab.OutletGeneralTab.AdvanceIsMandatMemTypeArray.filter((p) => FConvert.toInt(p) == FConvert.toInt(ApplicationNew.MemberData.MemberTypeId));
                        if (bMemberTypeFound != null && bMemberTypeFound != undefined && bMemberTypeFound.length > 0) {
                            if (FConvert.toDecimal(deposit) == 0) {
                                PREORDERDETAILS.showDepositMessage();
                                return false;
                            }

                            bResult = PREORDERDETAILS.calculateDepositInPercentage(perDeposit);
                            if (bResult == false)
                                return false;
                        }
                    }
                }
            }

            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainPreOrder.js :: Method :: PREORDERDETAILS.checkIsAdvanceMandatory :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
