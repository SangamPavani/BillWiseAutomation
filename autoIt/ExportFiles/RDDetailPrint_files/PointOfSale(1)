    openSettlementPopup: function () {
        try {
            //1. Call Exchange/Spoilage method
            var exchangeSpoilageResult = HEADEREXTRAFIELDS.callExchangeSpoilage();
            if (exchangeSpoilageResult == null || exchangeSpoilageResult == undefined)
                return;
            if (schemeGlobalObject == null || schemeGlobalObject == undefined) {
                schemeGlobalObject = BILLSETTLEMENTDATASTRUCTURE.getSchemeGlobalObject();//newly added code by prathibha 28/03/2022
                schemeGlobalObject.billSettlementDataFromClient = BILLSETTLEMENT.getBillSettlementObject();
                schemeGlobalObject.billSettlementDataFromClient.NetAmount = FConvert.toDecimal($("#lblNett").html(), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);
            }
            schemeGlobalObject.billSettlementDataFromClient.NetAmount = FConvert.toDecimal($("#lblNett").html(), PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION"))
                schemeGlobalObject.billSettlementDataFromClient.NetAmount = $("#txtPreOrderCollectionAmountToPay").val();

            var tag = [];
            tag.push(schemeGlobalObject.value);
            //tag.push("TRANSACTION.postPreOrderCollection()");
            tag.push(schemeGlobalObject.billSettlementDataFromClient);
            tag.push(schemeGlobalObject.shortcutId);
            if (FConvert.toDecimal($("#lblNett").html()) == 0) {
                TRANSACTION.postSalesInvoice();
                return;
            }

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("VIEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER")) {
                if (POSCommon.posTemplate != null && POSCommon.posTemplate != undefined && POSCommon.posTemplate.IsEstimatedBill == false) {
                    SHORTCUTMETHODS.loadShortcutFunction(1024, false, null, null);
                    return;
                }
            }
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION")) {
                if (ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.Status == 3) {
                    TRANSACTION.postPreOrderCollection();
                    return;
                }
                var tag = [];
                var arrValues = null;
                if (arrValues == null || arrValues == undefined) {
                    arrValues = [];
                    arrValues.push(FromScreen.get("PREORDERCOLLECTION"));
                    arrValues.push("TRANSACTION.postPreOrderCollection()");
                }
                tag.push(arrValues);
                //tag.push("TRANSACTION.postPreOrderCollection()");
                tag.push(schemeGlobalObject.billSettlementDataFromClient);
                tag.push(56);
            }

            if (MESSAGEPOPUP.BILLSETTLEMENT.checkIsValidRMAForAllItems() == false) {
                BILLSETTLEMENT.SCHEMESMETHODS.revertChangesAsBillSettlementCancelled(false);
                return;
            }
            BILLSETTLEMENT.openBillSettlementScreen(tag);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENTSCHEMES.openSettlementPopup, Catch block : Error Message : " + Ex.message);
            return false;
        }
    }
};

