    getInputControlEvent: function (inputControl) {
        try {
            //debugger;
            var msgwndSchemePopupExceed = $("#msgwndSchemePopupExceed").val();
            var dCurrentCellEnteredValue = 0;
            var strCurrentValue = $(inputControl).val();

            var inputControlTableCell = $(inputControl).closest('td');
            if (inputControlTableCell != null && inputControlTableCell != undefined && inputControlTableCell.length > 0)
                inputControlTableCell = inputControlTableCell[0];

            var inputControlTableRow = $(inputControlTableCell).closest('tr');
            if (inputControlTableRow != null && inputControlTableRow != undefined && inputControlTableRow.length > 0)
                inputControlTableRow = inputControlTableRow[0];

            let anyItemData = $("#divSchemeFreeItemSelectionModalBodySecondRowAnyItem").attr('data-Tag');
            if (anyItemData != null && anyItemData != undefined && anyItemData.trim().length > 0)
                var parsedAnyItemInfo = JSON.parse(anyItemData);

            //var ModelData = $("#divSchemeFreeItemSelectionModal").attr("data-SchemesFreeItemInfo");
            //if (ModelData != null && ModelData != undefined && ModelData != "")
            //    var parsedFreeItemWeb = JSON.parse(ModelData);

            var parsedDetails = $(inputControlTableRow).attr("data-SchemeAnyItem");
            if (parsedDetails != null && parsedDetails != undefined && parsedDetails.length > 0)
                parsedDetails = JSON.parse(parsedDetails);

            var dPreVal = parsedDetails.FreeQtyToAdd;
            dCurrentCellEnteredValue = FConvert.toDecimal(strCurrentValue, POSCommon.numberOfDecimal, true);

            if (strCurrentValue == null || strCurrentValue == 0 || strCurrentValue == undefined || strCurrentValue.trim() == "" || strCurrentValue.trim().length <= 0) {
                $(inputControl).find('input').remove();
                $(inputControlTableCell).html(FConvert.toInt(0));
            }
            else {
                $(inputControl).find('input').remove();
                $(inputControlTableCell).html(dCurrentCellEnteredValue);
            }

            //debugger;
            parsedDetails.FreeQtyToAdd = dCurrentCellEnteredValue;

            let promptDetailToAdd = new Object();
            promptDetailToAdd.SchemeId = parsedDetails.SchemeId;
            promptDetailToAdd.PromptDetails = [];

            parsedDetails.FreeQtyToAdd = dCurrentCellEnteredValue;
            promptDetailToAdd.PromptDetails.push(parsedDetails);

            if (POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.POSSchemeSelectedAnyItem == null || POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.POSSchemeSelectedAnyItem == undefined
                && POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.POSSchemeSelectedAnyItem.length <= 0)
                POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.POSSchemeSelectedAnyItem = [];

