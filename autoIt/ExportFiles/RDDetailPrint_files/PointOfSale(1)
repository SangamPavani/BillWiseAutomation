    assignFooterProportionateValueToBodyScreenField: function (cProduct, multiplicationfactor, dValue) {
        try {
            if (POSCommon.ProportionateFooterValueToBodyScreenField != null && POSCommon.ProportionateFooterValueToBodyScreenField != undefined &&
                POSCommon.ProportionateFooterValueToBodyScreenField.ColumnIndex < cProduct.DynamicLineFields.length) {
                let UserWiseSubTotal = 0;
                if (POSCommon.vatBodyExtraField != null) {
                    if (POSCommon.vatBodyExtraField.EffectOnNetId == 1)
                        UserWiseSubTotal = ApplicationNew.RetailTransFooter.TaxableValue;
                    else
                        UserWiseSubTotal = ApplicationNew.RetailTransFooter.UserWiseSubTotal;
                }
                let dFooterProportionateVal = (multiplicationfactor * (ApplicationNew.RetailTransFooter.FooterScreenFieldsTotalValue * dValue) / UserWiseSubTotal);
                dFooterProportionateVal = COMMONMETHODS.UTILITYMETHODS.roundOff(dFooterProportionateVal, POSCommon.localCurrency.GeneralRoundOff, POSCommon.localCurrency.RoundOffType, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);
                dValue = FConvert.toDecimal(dValue, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(dFooterProportionateVal, POSCommon.numberOfDecimal, true);

                cProduct.DynamicLineFields[POSCommon.ProportionateFooterValueToBodyScreenField.ColumnIndex].FieldInput =
                    cProduct.DynamicLineFields[POSCommon.ProportionateFooterValueToBodyScreenField.ColumnIndex].FieldValue = dFooterProportionateVal;
            }

            return dValue;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCalculation.js, Method: CALCULATION.assignFooterProportionateValueToBodyScreenField, Catch block : Error Message : " + Ex.message);
