var SCHEMESCOMMON = {
    PRODUCTSET: {
        updateGrossForSetProduct: function (setData, setPrice, productData, line) {
            try {
                var _productPrice = 0.0;
                if (setData.BodyHeader.RateType == 1) {
                    _productPrice = productData.Price;
                    line.DefaultValue4 = parseFloat(_productPrice).toFixed(POSCommon.numberOfDecimal);
                    if (setData.BodyHeader.Discount > 0)
                        SCHEMESCOMMON.PRODUCTSET.proportionateSetPrice(setData, productData, setPrice, line);
                    else {
                        if (setPrice > 0)
                            line.DefaultValue5 = parseFloat(parseFloat(line.DefaultValue3) * parseFloat(_productPrice)).toFixed(POSCommon.numberOfDecimal);
                        else
                            line.DefaultValue5 = parseFloat(0).toFixed(POSCommon.numberOfDecimal);
                    }
                }
                else {
                    if (setData.BodyHeader.ApplyType == 3)
                        SCHEMESCOMMON.PRODUCTSET.equalSetPrice(setData, productData, setPrice, line);
                    else if (setData.BodyHeader.ApplyType == 4)
                        SCHEMESCOMMON.PRODUCTSET.proportionateSetPrice(setData, productData, setPrice, line);
                }

                if (parseFloat(line.DefaultValue4) > 0)
                    line.DefaultValue4 = FConvert.toDecimal(line.DefaultValue4, POSCommon.numberOfDecimal, true);

                if (parseFloat(line.DefaultValue5) > 0)
                    line.DefaultValue5 = parseFloat(line.DefaultValue5).toFixed(POSCommon.numberOfDecimal);
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: SCHEMESCOMMON.PRODUCTSET.updateGrossForSetProduct, Catch block : Error Message : " + Ex.message);
            }
        },
        proportionateSetPrice: function (setData, productData, setPrice, line) {
            try {
                var _productPrice = 0.0, fixedAmt = setPrice;
                var _MatchedItemsGross = 0.0;
                $.each(setData.BodyHeader.BodyList, function (index, record) {
                    _MatchedItemsGross = _MatchedItemsGross + record.Price;
                });

                if (_MatchedItemsGross == 0)
                    _MatchedItemsGross = 1;
                _productPrice = (productData.Price * fixedAmt) / parseFloat(_MatchedItemsGross);
                line.DefaultValue4 = parseFloat(parseFloat(_productPrice) / parseFloat(productData.Quantity)).toFixed(POSCommon.numberOfDecimal);
                line.DefaultValue5 = parseFloat(parseFloat(line.DefaultValue3) * parseFloat(line.DefaultValue4)).toFixed(POSCommon.numberOfDecimal);
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: SCHEMESCOMMON.PRODUCTSET.proportionateSetPrice, Catch block : Error Message : " + Ex.message);
            }
        },
        equalSetPrice: function (setData, productData, setPrice, line) {
            try {
                var fixedAmt = setPrice, _productPrice = setPrice / setData.BodyHeader.BodyList.length;
                line.DefaultValue4 = parseFloat(parseFloat(_productPrice) / parseFloat(productData.Quantity)).toFixed(POSCommon.numberOfDecimal);
                line.DefaultValue5 = parseFloat(parseFloat(line.DefaultValue3) * parseFloat(line.DefaultValue4));
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: SCHEMESCOMMON.PRODUCTSET.equalSetPrice, Catch block : Error Message : " + Ex.message);
            }
        }
    },
};

