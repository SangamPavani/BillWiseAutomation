    reassignSetDiscountAfterBillSettlement: function () {
        try {
            let ProductsToImplementSchemes = POSSCHEMEIMPLEMENTATIONGENERICS.getProductToImplementSchemes(true, false, false, PreferenceSetting.PrefGeneralTab.SchemesImplementOnDefinedUnit, false, PosProductType.get("NORMAL"), false);
            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                let discFromBS = 0;
                if (ProductsToImplementSchemes != null && ProductsToImplementSchemes != undefined && ProductsToImplementSchemes.length > 0) {
                    if (ApplicationNew.ListOfItems[i].ParentId > 0 && ApplicationNew.ListOfItems[i].DefaultValue4 != 0) {
                        if (ProductsToImplementSchemes.filter((f) => f.DefaultValue1 == ApplicationNew.ListOfItems[i].ParentId && f.ProductType == ApplicationNew.ListOfItems[i].ProductType).length > 0) {
                            discFromBS = ProductsToImplementSchemes.find((f) => f.DefaultValue1 == ApplicationNew.ListOfItems[i].ParentId && f.ProductType == ApplicationNew.ListOfItems[i].ProductType).DynamicLineFields[0].FieldInput;
                        }
                    }
                }

                if (ApplicationNew.ListOfItems[i].ProductMake == ProductMake.get("SET")) {
                    let individualSetProds = ApplicationNew.ListOfItems[i].RetailSetsDetails;
                    let gross = 0;
                    if (individualSetProds != null && individualSetProds != undefined && individualSetProds.length > 0) {
                        for (let k = 0; k < individualSetProds.length; k++) {
                            gross = gross + individualSetProds[k].DefaultValue5; //_IndividualSetProds.Sum(f => f.DefaultValue5);
                        }

                        for (let j = 0; j < individualSetProds.length; j++) {
                            if (ApplicationNew.BodyPanelExtraFieldsList != null && ApplicationNew.BodyPanelExtraFieldsList != undefined && ApplicationNew.BodyPanelExtraFieldsList.length > 0) {
                                if (ApplicationNew.ListOfItems[i].ProductType == 0) {
                                    if (gross != 0) {
                                        let ProportionateValue = (discFromBS * individualSetProds[j].DefaultValue5) / gross;
                                        let DiscountBodyExtraFieldDtls = ApplicationNew.BodyPanelExtraFieldsList.find((p) => p.SequenceNumber == 8 && p.IsDiscountField == true);
                                        if (DiscountBodyExtraFieldDtls != null && DiscountBodyExtraFieldDtls != undefined) {
                                            if (DiscountBodyExtraFieldDtls.RoundoffType > 0 && DiscountBodyExtraFieldDtls.RoundoffValue > 0) {
                                                let ColumnRoundOff = FConvert.toDecimal(ProportionateValue, POSCommon.numberOfDecimal, true)//check
                                                ProportionateValue = FConvert.toDecimal(ColumnRoundOff, POSCommon.numberOfDecimal, true);
                                            }

                                            if (FConvert.toDecimal(individualSetProds[j].DynamicLineFields[0].FieldInput, POSCommon.numberOfDecimal, true)
                                                != FConvert.toDecimal(ProportionateValue, POSCommon.numberOfDecimal, true))
                                                individualSetProds[j].DynamicLineFields[0].FieldInput = FConvert.toDecimal(individualSetProds[j].DynamicLineFields[0].FieldInput, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(ProportionateValue, POSCommon.numberOfDecimal, true);
                                        }
                                    }
                                }
                                else {
                                    individualSetProds[j].DynamicLineFields[0].FieldInput = ApplicationNew.ListOfItems[i].DynamicLineFields[0].FieldInput;
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainTransaction.js :: Method :: TRANSACTION.reassignSetDiscountAfterBillSettlement :: Catch block :: Exception :: " + Ex.message);
        }
    },
