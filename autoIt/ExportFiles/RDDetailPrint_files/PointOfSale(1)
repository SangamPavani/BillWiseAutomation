    getSelectedProductInObject: function () {
        try {
            //debugger;
            let selectedProductId = [], selectedProductGroupId = [], selectedProductUnitId = [];
            var navigationProperties = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " div#divProductSearchTree").attr("data-NavigationProperties");
            if (navigationProperties != null && navigationProperties != undefined && navigationProperties.length > 0) {
                navigationProperties = JSON.parse(navigationProperties);

                //Getting All Page Attribute To Add 'Product Id & Product Group Id' (Not Getting Current Page Number)
                let treeViewControlPageWiseRecord = null;
                let divAllPageRecord = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " div#divPageRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " > input[type=hidden][id!=" + navigationProperties.PageNumber + "]");
                if (divAllPageRecord != null && divAllPageRecord != undefined && divAllPageRecord.length > 0) {
                    for (let i = 0; i < divAllPageRecord.length; i++) {
                        treeViewControlPageWiseRecord = $(divAllPageRecord[i]).attr("data-TreeViewControlPageWiseRecord");
                        if (treeViewControlPageWiseRecord != null && treeViewControlPageWiseRecord != undefined && treeViewControlPageWiseRecord.length > 0) {
                            treeViewControlPageWiseRecord = JSON.parse(treeViewControlPageWiseRecord);

                            if (treeViewControlPageWiseRecord.SelectedProductId != null && treeViewControlPageWiseRecord.SelectedProductId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductId.length; i++)
                                    selectedProductId.push(treeViewControlPageWiseRecord.SelectedProductId[i]);
                            }

                            if (treeViewControlPageWiseRecord.SelectedProductGroupId != null && treeViewControlPageWiseRecord.SelectedProductGroupId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductGroupId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductGroupId.length; i++)
                                    selectedProductGroupId.push(treeViewControlPageWiseRecord.SelectedProductGroupId[i]);
                            }

                            if (treeViewControlPageWiseRecord.SelectedProductUnitId != null && treeViewControlPageWiseRecord.SelectedProductUnitId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductUnitId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductUnitId.length; i++)
                                    selectedProductUnitId.push(treeViewControlPageWiseRecord.SelectedProductUnitId[i]);
                            }
                        }
                    }
                }

                //Finding Only Current Page Record, If Not Exist Then Create New Variables(treeViewControlPageWiseRecord) 
                //In Next Step, We Will Add 'Product Id & Product Group Id'
                let divCurrentPageRecord = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " div#divPageRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " > input[type=hidden][id=" + navigationProperties.PageNumber + "]");
                if (divCurrentPageRecord != null && divCurrentPageRecord != undefined && divCurrentPageRecord.length > 0) {
                    treeViewControlPageWiseRecord = $(divCurrentPageRecord).attr("data-TreeViewControlPageWiseRecord");
                    if (treeViewControlPageWiseRecord != null && treeViewControlPageWiseRecord != undefined && treeViewControlPageWiseRecord.length > 0)
                        treeViewControlPageWiseRecord = JSON.parse(treeViewControlPageWiseRecord);
                    else if (treeViewControlPageWiseRecord == null || treeViewControlPageWiseRecord == undefined || treeViewControlPageWiseRecord.length <= 0) {
                        treeViewControlPageWiseRecord = new Object();
                        treeViewControlPageWiseRecord.PageNumber = navigationProperties.PageNumber;
                        treeViewControlPageWiseRecord.ProductListHTMLString = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #divProductSearchTree").html();
                    }
                }

                //Getting Current Page 'Product Id & Product Group Id'
                let inputControlSelectedProduct = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #divProductSearchTree input[type=checkbox]:checked");
                if (inputControlSelectedProduct != null && inputControlSelectedProduct != undefined && inputControlSelectedProduct.length > 0) {
                    let iProductGroupId = 0;
                    treeViewControlPageWiseRecord.SelectedProductId = [];
                    treeViewControlPageWiseRecord.SelectedProductGroupId = [];
                    treeViewControlPageWiseRecord.SelectedProductUnitId = [];

                    for (let i = 0; i < inputControlSelectedProduct.length; i++) {
                        iProductGroupId = $(inputControlSelectedProduct[i]).attr("data-ProductGroupId");
                        if (iProductGroupId == null || iProductGroupId == undefined) {
                            let selectedProductId = $(inputControlSelectedProduct[i]).attr('id');
                            treeViewControlPageWiseRecord.SelectedProductId.push(selectedProductId);

                            //Adding 'Product Unit Id'
                            elementList = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #elementList_" + selectedProductId);
                            if (elementList != null && elementList != undefined && elementList.length > 0) {
                                let productInfo = $(elementList).attr("data-ProductInfo");
                                if (productInfo != null && productInfo != undefined && productInfo.trim().length > 0) {
                                    productInfo = JSON.parse(productInfo);
                                    if (productInfo.UnitId > 0) {
                                        let unitFound = treeViewControlPageWiseRecord.SelectedProductUnitId.filter((p) => FConvert.toInt(p) == FConvert.toInt(productInfo.UnitId));
                                        if (unitFound == null || unitFound == undefined || unitFound.length <= 0)
                                            treeViewControlPageWiseRecord.SelectedProductUnitId.push(productInfo.UnitId);
                                    }
                                }
                            }

                        }
                        else if (iProductGroupId != null && iProductGroupId != undefined && FConvert.toInt(iProductGroupId) > 0)
                            treeViewControlPageWiseRecord.SelectedProductGroupId.push($(inputControlSelectedProduct[i]).attr('id'));
                    }

                    if (treeViewControlPageWiseRecord.SelectedProductId != null && treeViewControlPageWiseRecord.SelectedProductId != undefined
                        && treeViewControlPageWiseRecord.SelectedProductId.length > 0) {

                        for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductId.length; i++)
                            selectedProductId.push(treeViewControlPageWiseRecord.SelectedProductId[i]);
                    }

                    if (treeViewControlPageWiseRecord.SelectedProductGroupId != null && treeViewControlPageWiseRecord.SelectedProductGroupId != undefined
                        && treeViewControlPageWiseRecord.SelectedProductGroupId.length > 0) {

                        for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductGroupId.length; i++)
                            selectedProductGroupId.push(treeViewControlPageWiseRecord.SelectedProductGroupId[i]);
                    }

                    if (treeViewControlPageWiseRecord.SelectedProductUnitId != null && treeViewControlPageWiseRecord.SelectedProductUnitId != undefined
                        && treeViewControlPageWiseRecord.SelectedProductUnitId.length > 0) {

                        for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductUnitId.length; i++)
                            selectedProductUnitId.push(treeViewControlPageWiseRecord.SelectedProductUnitId[i]);
                    }
                }

                //Store All 'Product Id' In 'SEARCH.SEARCHOPTION' Variables
                if (TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId == null || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId == undefined
                    || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.length <= 0)
                    TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId = [];

                if (selectedProductId != null && selectedProductId != undefined && selectedProductId.length > 0) {
                    for (let i = 0; i < selectedProductId.length; i++)
                        TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.push(selectedProductId[i]);
                }

                //Store All 'Product Group Id' In 'SEARCH.SEARCHOPTION' Variables
                if (TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId == null || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId == undefined
                    || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId.length <= 0)
                    TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId = [];

                if (selectedProductGroupId != null && selectedProductGroupId != undefined && selectedProductGroupId.length > 0) {
                    for (let i = 0; i < selectedProductGroupId.length; i++)
                        TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId.push(selectedProductGroupId[i]);
                }

                //Store All 'Product Unit Id' In 'SEARCH.SEARCHOPTION' Variables
                if (TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId == null || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId == undefined
                    || TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId.length <= 0)
                    TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId = [];

                if (selectedProductUnitId != null && selectedProductUnitId != undefined && selectedProductUnitId.length > 0) {
                    for (let i = 0; i < selectedProductUnitId.length; i++)
                        TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId.push(selectedProductUnitId[i]);
                }

                $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName).modal('hide');
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Method :: TREEVIEWCONTROL.SEARCH.getSelectedProductInObject :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    updateParentTreeViewControlAttribute: function (isClear) {
        try {
            //Storing Selected 'Product Id' & 'Product Group Id' In 'Parent Tree View Control'
            let divSearchProductRecord = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divSearchRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName);
            if (divSearchProductRecord != null && divSearchProductRecord != undefined && divSearchProductRecord.length > 0) {
                $(divSearchProductRecord).attr("data-ProductId", JSON.stringify(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId));
                $(divSearchProductRecord).attr("data-ProductGroupId", JSON.stringify(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId));
            }

            let parentTreeViewControlNavigationProperties = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName).attr("data-NavigationProperties");
            if (parentTreeViewControlNavigationProperties == null || parentTreeViewControlNavigationProperties == undefined || parentTreeViewControlNavigationProperties.length <= 0) {
                toastr.error("Exception while reading attribute.");
                return;
            }

            parentTreeViewControlNavigationProperties = JSON.parse(parentTreeViewControlNavigationProperties);

            if (isClear == false) //Append Select Product & Product Group Id In Parent Tree View Control's Current Page
            {
                let currentPage = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " #divProductTree > input[type=hidden][id=" + parentTreeViewControlNavigationProperties.PageNumber + "]");
                if (currentPage != null && currentPage != undefined && currentPage.length > 0) {
                    let treeViewControlPageWise = $(currentPage).attr("data-TreeViewControlPageWiseRecord");
                    if (treeViewControlPageWise != null && treeViewControlPageWise != undefined && treeViewControlPageWise.length > 0) {
                        treeViewControlPageWise = JSON.parse(treeViewControlPageWise);

                        if (treeViewControlPageWise.SelectedProductId == null || treeViewControlPageWise.SelectedProductId == undefined || treeViewControlPageWise.SelectedProductId.length <= 0)
                            treeViewControlPageWise.SelectedProductId = [];

                        for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.length; i++)
                            treeViewControlPageWise.selectedProductId.push(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i]);

                        if (treeViewControlPageWise.SelectedProductGroupId == null || treeViewControlPageWise.SelectedProductGroupId == undefined || treeViewControlPageWise.SelectedProductGroupId.length <= 0)
                            treeViewControlPageWise.SelectedProductGroupId = [];

                        for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.SelectedProductGroupId.length; i++)
                            treeViewControlPageWise.SelectedProductGroupId.push(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.SelectedProductGroupId[i]);

                        if (treeViewControlPageWise.SelectedProductUnitId == null || treeViewControlPageWise.SelectedProductUnitId == undefined || treeViewControlPageWise.SelectedProductUnitId.length <= 0)
                            treeViewControlPageWise.SelectedProductUnitId = [];

                        for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.SelectedProductUnitId.length; i++)
                            treeViewControlPageWise.SelectedProductUnitId.push(TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.SelectedProductUnitId[i]);
                    }
                }
            }
            else if (isClear == true) {
                //debugger;
                $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " div#divPageRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName).remove("input[type = hidden]");
                // STEP 1 :: Remove all page record and add PageNumber 1
                let treeViewControlPageWiseRecord = new Object();
                treeViewControlPageWiseRecord.PageNumber = 1;
                treeViewControlPageWiseRecord.ProductList = [];
                treeViewControlPageWiseRecord.SelectedProductId = TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId;
                treeViewControlPageWiseRecord.SelectedProductUnitId = TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductUnitId;
                treeViewControlPageWiseRecord.SelectedProductGroupId = TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductGroupId;
                treeViewControlPageWiseRecord.ProductListHTMLString = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " div#divProductTree").html();

                // STEP 2 :: Add ProductInfo in ProductList Property
                for (let i = 0; i < TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId.length; i++) {
                    elementList = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #elementList_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.selectedProductId[i]);
                    if (elementList != null && elementList != undefined && elementList.length > 0) {
                        let productInfo = $(elementList).attr("data-ProductInfo");
                        if (productInfo != null && productInfo != undefined && productInfo.trim().length > 0)
                            treeViewControlPageWiseRecord.ProductList.push(JSON.parse(productInfo));
                    }
                }

                // STEP 3 :: Add(JSON.stringify) Newly Created treeViewControlPageWiseRecord variable 
                $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName + " div#divPageRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.parentControlName).append("<input type=hidden id=" + treeViewControlPageWiseRecord.PageNumber + "/>");
                let inputControlPageRecord = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " > div#divPageRecord_" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName).children();
                if (inputControlPageRecord != null && inputControlPageRecord != undefined && inputControlPageRecord.length > 0) {
                    let lastInputControl = inputControlPageRecord[inputControlPageRecord.length - 1];
                    if (lastInputControl != null && lastInputControl != undefined)
                        $(lastInputControl).attr("data-TreeViewControlPageWiseRecord", JSON.stringify(treeViewControlPageWiseRecord));
                }

                //debugger;
                TREEVIEWCONTROL.NAVIGATIONEVENT.disableButton(parentTreeViewControlNavigationProperties, "HIDE");
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.SEARCH.updateParentTreeViewControlAttribute :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
