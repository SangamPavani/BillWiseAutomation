                        }
                    }
                    parsedRowDetails.IsSelected = true;

                    $(closestTr).attr('data-employeeSchemeDiscountDetails', JSON.stringify(parsedRowDetails));
                    if (parsedRowDetails.DiscType == 1) {
                        $("#rbtEmployeeDiscountPercentage").prop("checked", true);
                        $("#rbtEmployeeDiscountValue").prop("checked", false);
