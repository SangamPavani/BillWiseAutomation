                            }
                        }
                    }, "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMain.js :: Method :: RETAILMAIN.ChangeLayout :: Catch block :: Error Message :: " + Ex.message);
