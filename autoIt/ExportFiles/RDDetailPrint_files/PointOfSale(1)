                //   _net = subtotal = objSalesReturnWeb.ProductDetails.Sum(p => p.ProductType == 3 ? 0 : p.DefaultValue15);
                if (_net == 0) {
                    for (let i = 0; i < objSalesReturnWeb.FooterFieldsList.length; i++)
                        objSalesReturnWeb.DynamicFooterFields[i].FieldInput = objSalesReturnWeb.FooterFieldsList[i].PreloadValue;

                    return;
                }
                objSalesReturnWeb.FooterCalculation.FooterExtraFields = null;
                for (let k = 0; k < objSalesReturnWeb.FooterFieldsList.length; k++) {
                    if (objSalesReturnWeb.FooterFieldsList[k].DonotConsider > 0) {
                        if ((objSalesReturnWeb.FooterFieldsList[k].DonotConsider & (1 << 3)) != 0)
                            continue;
                    }
                    if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("SalesReturnCharges"))
                        continue;
                    if (objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("ServiceCharge") || objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour == FieldBehaviour.get("PreOrderAdvance")) {
                        objSalesReturnWeb.DynamicFooterFields[k].FieldValue = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                        continue;
                    }
                    let dAmt = 0;
                    if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 1) {
                        dAmt = objSalesReturnWeb.DynamicFooterFields[k].FieldInput;
                    }
                    else if (objSalesReturnWeb.FooterFieldsList[k].OutputCalculation == 2) {
                        ///Percentage on Gross
                        if (objSalesReturnWeb.FooterFieldsList[k].EffectOnNet == 3)
                            dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(objSalesReturnWeb.DynamicFooterFields[k].FieldInput), parseFloat(gross), objSalesReturnWeb.FooterFieldsList[k].FieldTypeBehaviour, true)).toFixed(POSCommon.numberOfDecimal);
