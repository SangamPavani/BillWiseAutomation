    //Implementing cell editing Related code
    callCopyOrProportionateToAllRows: function (iIndex, dValue, AskForConfirmation, objApplication, FieldToCopyOrProportionate, DonotIncludeSchemeItems, FromDiscountAuthorization = false, CheckLineCount = true) {
        try {
            if (objApplication.CopyToAllRows == false && objApplication.ProportionateToAllRows == false && objApplication.DividedWithNumberOfItems == false)
                return;

            if (objApplication.CopyToAllRows == true)
                PRODUCTSELECTION.copyValueToAllRows(iIndex, dValue, AskForConfirmation, objApplication, FieldToCopyOrProportionate, DonotIncludeSchemeItems);
            else if (objApplication.ProportionateToAllRows == true)
                PRODUCTSELECTION.proportionateValueToAllRows(iIndex, dValue, AskForConfirmation, objApplication, FieldToCopyOrProportionate, DonotIncludeSchemeItems, CheckLineCount);
            else if (objApplication.DividedWithNumberOfItems == true)
                PRODUCTSELECTION.divideWithNoOfItemsToAllRows(iIndex, dValue, AskForConfirmation, objApplication, FieldToCopyOrProportionate, DonotIncludeSchemeItems);

            if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    let custBodyPanel = ApplicationNew.BodyPanelExtraFieldsList.find((p) => p.ID == FieldToCopyOrProportionate.ID);
                    if (custBodyPanel != null && custBodyPanel != undefined && custBodyPanel.ClearDiscounts && ApplicationNew.ListOfItems[i].DynamicLineFields[FieldToCopyOrProportionate.ColumnIndex].FieldInput > 0) {
                        ApplicationNew.ListOfItems[i].DynamicLineFields[0].FieldInput = ApplicationNew.ListOfItems[i].DynamicLineFields[0].FieldValue = 0;
                        ApplicationNew.ListOfItems[i].DonotConsiderWhileApplyingSchemes = true;
                        if (ApplicationNew.BodyPanelExtraFieldsList != null && ApplicationNew.BodyPanelExtraFieldsList != undefined && ApplicationNew.BodyPanelExtraFieldsList.length > 0) {
                            for (let bc = 0; bc < ApplicationNew.BodyPanelExtraFieldsList.length; bc++) {
                                if (ApplicationNew.BodyPanelExtraFieldsList[bc].ID == FieldToCopyOrProportionate.ID)
                                    continue;
                                if (ApplicationNew.BodyPanelExtraFieldsList[bc] != null && ApplicationNew.BodyPanelExtraFieldsList[bc] != undefined && ApplicationNew.BodyPanelExtraFieldsList[bc].IsDiscountField) {
                                    ApplicationNew.ListOfItems[i].DynamicLineFields[ApplicationNew.BodyPanelExtraFieldsList[bc].ColumnIndex].FieldInput = 0;
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Ex) {
            toastr.error(Ex.message);
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: PRODUCTSELECTION.callCopyOrProportionateToAllRows:: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    copyValueToAllRows: function (iIndex, dValue, AskForConfirmation, objApplication, fieldToCopyOrProportionate = null, DonotIncludeSchemeItems = false) {
        try {
            if (fieldToCopyOrProportionate == null)
                return;

            /* if (objApplication.CopyToAllRows == true && iIndex == 0 && objApplication.ListOfItems.length > 1) {*/
            if (objApplication.CopyToAllRows == true && iIndex == 0) {
                let StartCounter = 0;
                if (DonotIncludeSchemeItems == true)
                    StartCounter = 0;

                for (let i = StartCounter; i < objApplication.ListOfItems.length; i++) {
                    if (DonotIncludeSchemeItems == true && objApplication.TotalSchemesInfo != null && objApplication.TotalSchemesInfo != undefined
                        && objApplication.TotalSchemesInfo.LinePrompts != null && objApplication.TotalSchemesInfo.LinePrompts != undefined && objApplication.TotalSchemesInfo.LinePrompts.length > 0) {
                        if (objApplication.ListOfItems[i].DefaultValue4 == 0 || objApplication.ListOfItems[i].PromoType == PromoTypes.get("DISCOUNT"))
                            continue;
                        if (objApplication.TotalSchemesInfo.LinePrompts.filter((p) => p.BaseItemsSchemes.filter((q) => q.DefaultValue1 == objApplication.ListOfItems[i].DefaultValue1).length > 0).length > 0)
                            continue;
                    }

                    if (fieldToCopyOrProportionate.ColumnIndex == 0) {
                        if (objApplication.ListOfItems[i].ProductType == PosProductType.get("NORMAL")) {
                            objApplication.ListOfItems[i].DynamicLineFields[fieldToCopyOrProportionate.ColumnIndex].FieldInput =
                                objApplication.ListOfItems[i].DynamicLineFields[fieldToCopyOrProportionate.ColumnIndex].FieldValue = FConvert.toDecimal(dValue);
                        }
                        objApplication.ListOfItems[i].IsManualDiscount = true;
                    }
                    else {
                        if (objApplication.ListOfItems[i].ProductType == PosProductType.get("NORMAL"))
                            objApplication.ListOfItems[i].DynamicLineFields[fieldToCopyOrProportionate.ColumnIndex].FieldInput = FConvert.toDecimal(dValue);
                    }

                    CALCULATION.calculateLineWiseNet(objApplication.ListOfItems[i], objApplication);
                }
            }
            objApplication.CopyToAllRows = false;
            objApplication.ProportionateToAllRows = false;
        }
        catch (Ex) {
            toastr.error(Ex.message);
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: PRODUCTSELECTION.copyValueToAllRows:: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    proportionateValueToAllRows: function (iIndex, dValue, AskForConfirmation, objApplication, FieldToCopyOrProportionate = null, DonotIncludeSchemeItems = false, CheckLineCount = true) {
        try {
            ////debugger;
            if (FieldToCopyOrProportionate == null || FieldToCopyOrProportionate.OutputCalculationId != 1)
                return;

            if (objApplication.ProportionateToAllRows == true && iIndex == 0 && (CheckLineCount ? objApplication.ListOfItems.length > 1 : true)) {
                let dTotalGross = 0;
                if (DonotIncludeSchemeItems == false) {
                    let sum = 0;
                    for (let j = 0; j < objApplication.ListOfItems.length; j++) {
                        if (objApplication.ListOfItems[j].ProductType == 0)
                            sum = sum + objApplication.ListOfItems[j].DefaultValue5;
                        else
                            sum = sum + 0;
                    }
                    dTotalGross = sum;
                }
                else {
                    if (objApplication.TotalSchemesInfo.LinePrompts.length > 0) {
                        for (let i = 0; i < objApplication.ListOfItems.length; i++) {
                            if (objApplication.ListOfItems[i].DefaultValue4 == 0 || objApplication.ListOfItems[i].ProductType != 0 || objApplication.ListOfItems[i].PromoType == PromoTypes.get("DISCOUNT"))
                                continue;
                            if (objApplication.TotalSchemesInfo.LinePrompts.filter((p) => p.BaseItemsSchemes.filter((q) => q.DefaultValue1 == objApplication.ListOfItems[i].DefaultValue1).length > 0).length > 0)
                                continue;
                            dTotalGross += objApplication.ListOfItems[i].DefaultValue5;
                        }
                    }
                    else {
                        let sum = 0;
                        for (let j = 0; j < objApplication.ListOfItems.length; j++) {
                            if (objApplication.ListOfItems[j].ProductType == 0)
                                sum = sum + objApplication.ListOfItems[j].DefaultValue5;
                            else
                                sum = sum + 0;
                        }
                        dTotalGross = sum;
                    }
                }

                for (let i = 0; i < objApplication.ListOfItems.length; i++) {
                    if (DonotIncludeSchemeItems == true && objApplication.TotalSchemesInfo.LinePrompts.length > 0) {
                        if (objApplication.ListOfItems[i].PromoType == PromoTypes.get("DISCOUNT"))
                            continue;
                        if (objApplication.TotalSchemesInfo.LinePrompts.filter((p) => p.BaseItemsSchemes.filter((q) => q.DefaultValue1 == objApplication.ListOfItems[i].DefaultValue1).length > 0).length > 0)
                            continue;
                    }
                    if (FieldToCopyOrProportionate.ColumnIndex == 0) {
                        if (objApplication.ListOfItems[i].ProductType == PosProductType.get("NORMAL")) {
                            objApplication.ListOfItems[i].DynamicLineFields[FieldToCopyOrProportionate.ColumnIndex].FieldInput =
                                objApplication.ListOfItems[i].DynamicLineFields[FieldToCopyOrProportionate.ColumnIndex].FieldValue = FConvert.toDecimal((dValue * objApplication.ListOfItems[i].DefaultValue5 / dTotalGross));
                        }
                        objApplication.ListOfItems[i].IsManualDiscount = true;
                    }
                    else {
                        if (objApplication.ListOfItems[i].ProductType == PosProductType.get("NORMAL"))
                            objApplication.ListOfItems[i].DynamicLineFields[FieldToCopyOrProportionate.ColumnIndex].FieldInput = objApplication.ListOfItems[i].DynamicLineFields[FieldToCopyOrProportionate.ColumnIndex].FieldValue = FConvert.toDecimal((dValue * objApplication.ListOfItems[i].DefaultValue5 / dTotalGross));
                    }
                    CALCULATION.calculateLineWiseNet(objApplication.ListOfItems[i], objApplication);
                }
            }

            objApplication.CopyToAllRows = false;
            objApplication.ProportionateToAllRows = false;
        }
