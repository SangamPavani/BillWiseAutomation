    calculateSetValue: function (Gross, lstProductDetails) {
        try {
            var _bodyList = PRODUCTSETS.GetBodyListHavingProducts(lstProductDetails);
            if (GlobalPref.Version == eVersion.Version9) {
                if ($("#rbPickRate").is(":checked") == true) {
                    var discountValue = 0.00;
                    var txtDiscount = $("#txtDiscount").val();
                    if (txtDiscount != null && txtDiscount != "0") {
                        var discount = FConvert.toDecimal(txtDiscount);
                        if ($("#rbPercentage").is(":checked") == true)
                            discountValue = PRODUCTSETS.ConvertPercentageToValue(discount, Gross);
                        else {
                            if (lstProductDetails != null && lstProductDetails != undefined && lstProductDetails.length > 0) {
                                if ($("#rbToSet").is(":checked") == true)
                                    discountValue = discount;
                                else
                                    discountValue = discount * _bodyList.length;
                            }
                        }
                    }
                    $("#txtSetValue").text(FConvert.toDecimal((Gross - discountValue), POSCommon.numberOfDecimal));
                }
                else {
                    var txtFixedAmount = $("#txtFixedAmount").val();
                    if (txtFixedAmount != null) {
                        var fixedAmt = FConvert.toDecimal(txtFixedAmount, POSCommon.numberOfDecimal);
                        $("#txtSetValue").text(fixedAmt);
                    }
                }
            }
            else if (GlobalPref.Version == eVersion.Version10) {
                var rateType = $("#ddlRateType").val();
                var discountType = $("#ddlDiscntType").val();
                var applyTo = $("#ddlApplyTo").val();
                if (rateType == 0) {
                    var discountValue = 0.00;
                    var txtDiscount = $("#txtDiscount").val();
                    if (txtDiscount != null && txtDiscount != "0") {
                        var discount = FConvert.toDecimal(txtDiscount);
                        if (discountType == 0)
                            discountValue = PRODUCTSETS.ConvertPercentageToValue(discount, Gross);
                        else {
                            if (lstProductDetails != null && lstProductDetails != undefined && lstProductDetails.length > 0) {
                                if (applyTo == 0)
                                    discountValue = discount;
                                else
                                    discountValue = discount * _bodyList.length;
                            }
                        }
                    }
                    $("#txtSetValue").text(FConvert.toDecimal((Gross - discountValue), POSCommon.numberOfDecimal));
                }
                else {
                    var txtFixedAmount = $("#txtFixedAmount").val();
                    if (txtFixedAmount != null) {
                        var fixedAmt = FConvert.toDecimal(txtFixedAmount, POSCommon.numberOfDecimal);
                        $("#txtSetValue").text(fixedAmt);
                    }
                }
            }

        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainFocus8W.js :: Method :: PRODUCTSETS.calculateSetValue :: Catch block :: Exception :: " + Ex.message);
        }
