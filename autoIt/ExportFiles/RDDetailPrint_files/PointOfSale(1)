        comparePreviousAndCurrentCriteriaSelection: function (arrOldItemId, arrNewItemId) {
            try {
                const oldSet = new Set(arrOldItemId.map(id => parseInt(id, 10)));
                const newSet = new Set(arrNewItemId.map(id => parseInt(id, 10)));

                let isDifferent = false;
                if (oldSet.size !== newSet.size) {
                    isDifferent = true;
                } else {
                    for (const id of newSet) {
                        if (!oldSet.has(id)) {
                            isDifferent = true;
                            break;
                        }
                    }
                }
                return isDifferent;
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESFREEITEMS.FREEITEMBUTTONCLICK.comparePreviousAndCurrentCriteriaSelection :: Catch block :: Exception :: " + Ex.message);
                return false;
            }
        },
