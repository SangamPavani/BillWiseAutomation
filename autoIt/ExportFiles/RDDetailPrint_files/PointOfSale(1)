            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION"))
                POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.getValidSchemesData();

            POSSCHEMEIMPLEMENTATIONGENERICS.showSchemesApplied();
            // Calculations & Grid Selections
            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
