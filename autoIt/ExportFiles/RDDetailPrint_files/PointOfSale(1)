                                toastr.error(pleaseIncludeAtleastOneItemAsMandatory);
                                return false;
                            }
                        }
                    }
                }
                if ($("#txtMemberDiscountTimes").val() != "") {
                    if ($("#txtMemberDiscountTimes").val() > 255) {
                        toastr.error(maxNoOfDaysShouldBtowfiftyfive);
