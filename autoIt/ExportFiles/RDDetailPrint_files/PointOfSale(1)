    getAmountReturnData: function (e, inputControl) {

        try {
            var charCode = (e.which) ? e.which : e.keyCode;
            var charCode = 0;
            if (e == null)
                charCode = 13;
            else if (e != null && e != undefined)
                charCode = e.which ? e.which : e.keyCode;

            if (charCode == 37 || charCode == 39 || charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (e.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }
            if (e.keyCode == 13 || e.keyCode == 9) {
                CREDITSALE.blurFunction(inputControl);
                return true;
            }
            return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:CREDITSALE.getAmountReturnData, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
