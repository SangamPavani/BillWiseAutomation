                    else
                        _loadingProduct.DynamicLineFields[k].FieldInput = _NewLineList[ProductCounter].DynamicLineFields[k].FieldInput;
                }
            }

            _loadingProduct.DynamicSetsDetails.push(_NewLineList[ProductCounter + i]);
        }
        let sumQty = 0;
        for (let i = 0; i < _loadingProduct.DynamicSetsDetails.length; i++) {
            sumQty = FConvert.toDecimal(_loadingProduct.DynamicSetsDetails[i].OriginalQuantity, POSCommon.NumberOfDecimals, true) + FConvert.toDecimal(_loadingProduct.DynamicSetsDetails[i].DefaultValue4, POSCommon.NumberOfDecimals, true);
