                if (_DiscToBeGiven < 1) dCheckingValue = 0.1;
                if (_DiscToBeGiven < 0.1) dCheckingValue = 0.01;

                if (passingArgs.ProportionatedDiscount > _DiscToBeGiven && passingArgs.ProportionatedDiscount - _DiscToBeGiven < dCheckingValue) {
