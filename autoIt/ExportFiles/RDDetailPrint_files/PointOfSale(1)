                    && ApplicationNew.MemberData.MemberTypeExemptFields.length > 0
                    && ApplicationNew.MemberData.MemberTypeExemptFields.filter((p) => p == retailBodyField.ID).length != 0)
                    || (cProduct.ProductMake == PosProductMake.get("DYNAMICSET")
                        && retailBodyField.FieldBehaviour != FieldBehaviour.get("VAT"))
                    || cProduct.ProductType == 3) {
                    cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldInput = 0;
                }
                else {
                    if ((retailBodyField.FieldTypeID == 2 || retailBodyField.FieldTypeID == 5) && retailBodyField.IsPriceBookValue == false
                        && retailBodyField.FieldBehaviour != FieldBehaviour.get("TAXCODE")
                        && retailBodyField.FieldBehaviour != FieldBehaviour.get("VAT")
