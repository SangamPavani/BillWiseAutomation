    saveGiftVoucherReg: function () {
        try {
            if (GIFTVOUCHERREGISTRATION.isValidToSave() == false)
                return;

            result = GIFTVOUCHERREGISTRATION.CheckDuplicateCode();
            if (result.bSuccess == true && result.isDuplicate != null && result.isDuplicate != undefined
                && result.isDuplicate == true) {
                toastr.error("Registration Code should be unique");
                return;
            }

            var objGVRegDetails = BILLSETTLEMENTDATASTRUCTURE.getEmptyGvReg();

            var optionControlData = OPTIONCONTROL.getControlDataObject("optGVRegGiftVoucherName");
            var outletControlData = OPTIONCONTROL.getControlDataObject("optGVRegOutlet");
            var dtActivationDate = DATEPICKER.getDate("dpGVRegActivationDate");
            var dtValidTill = DATEPICKER.getDate("dpGVRegValidTill");

            if (outletControlData == null || outletControlData == undefined || outletControlData.iMasterId == null
                || outletControlData.iMasterId == undefined
                || outletControlData.iMasterId.trim().length <= 0 || FConvert.toInt(outletControlData.iMasterId) <= 0)
                objGVRegDetails.OutletId = 0;
            else
                objGVRegDetails.OutletId = outletControlData.iMasterId;

            objGVRegDetails.VoucherName = optionControlData.Name;
            objGVRegDetails.DefinationID = optionControlData.iMasterId;
            objGVRegDetails.VoucherCode = $("#txtGVRegCode").val().trim() != "" ? $("#txtGVRegCode").val().trim() : "";
            objGVRegDetails.VoucherStartingSeries = $("#txtGVRegStartingSeries").val().trim() != "" ? $("#txtGVRegStartingSeries").val().trim() : "";
            objGVRegDetails.TotalNoOfVoucher = $("#txtGVRegTotalVouchers").val().trim() != "" ? $("#txtGVRegTotalVouchers").val().trim() : 0;
            objGVRegDetails.VoucherEndingSeriesSimple = $("#txtGVRegEndingSeries").val().trim() != "" ? $("#txtGVRegEndingSeries").val().trim() : "";
            objGVRegDetails.TotalValueOfVoucher = $("#txtGVRegTotalValue").val().trim() ? $("#txtGVRegTotalValue").val().trim() : 0;
            objGVRegDetails.VoucherValue = $("#txtGVRegVoucherValue").val().trim() != "" ? $("#txtGVRegVoucherValue").val().trim() : 0;

            if ($("#chkInternal").prop('checked') == false) {
                objGVRegDetails.ValidFromInt = 0;
                objGVRegDetails.ValidToInt = 0;
            }
            else {
                let dateOfActivation = $("#divGVRegActivationDate");
                var dtActivationDate = 0, dtValidTill = 0;
                if (dateOfActivation != null && dateOfActivation != undefined && dateOfActivation.length > 0)
                    dtActivationDate = DATEPICKER.getDate("dpGVRegActivationDate");

                objGVRegDetails.ValidFromInt = dtActivationDate;

