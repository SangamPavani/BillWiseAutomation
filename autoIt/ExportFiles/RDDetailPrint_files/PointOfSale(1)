    getPrepaidTopupPayClickEvent: function () {
        try {

            var msgInfoBalAmtZero = $("#msgInfoBalAmtZero").val();
            var msgEnterTopupValue = $("#msgEnterTopupValue").val();
            var msgTopupValueShouldBeLessThanEqualToBalAmt = $("#msgTopupValueShouldBeLessThanEqualToBalAmt").val();
            var msgAccountBalShouldBeGreaterThanEqualToBalAmt = $("#msgAccountBalShouldBeGreaterThanEqualToBalAmt").val();
            var TopupAmt = FConvert.toDecimal($("#txtPrePaidAmount").val());
            var optPrePaidTopupMemberName = OPTIONCONTROL.getControlDataObject("optPrePaidTopupMemberNameId");
            if (FConvert.toDecimal(BillSettlement.BalanceAmount) <= 0) {
                toastr.error(msgInfoBalAmtZero);
                return;
            }
            else if (TopupAmt == 0) {
                toastr.error(msgEnterTopupValue);
                return;
            }
            if (FConvert.toDecimal(BillSettlement.NetAmount) < FConvert.toDecimal(TopupAmt)) {
                toastr.error(msgTopupValueShouldBeLessThanEqualToBalAmt);
                return;
            }
            var TopupAccountBalance = 0;
            TopupAccountBalance = FConvert.toDecimal($("#txtAvailableBal").val());
            if (TopupAccountBalance == 0 || TopupAccountBalance < TopupAmt) {
                toastr.error(msgAccountBalShouldBeGreaterThanEqualToBalAmt);
                return;
            }
            $("#txtPrePaidAmount").val(FConvert.toDecimal($("#txtPrePaidAmount").val(), POSCommon.numberOfDecimal, true));

            if (BillSettlement.BillSettlementPaymentDetails == null || BillSettlement.BillSettlementPaymentDetails == undefined)
                BillSettlement.BillSettlementPaymentDetails = BILLSETTLEMENTDATASTRUCTURE.getEmptyPaymentDetails();

            var AccountLedgerBalance = BILLSETTLEMENTDATASTRUCTURE.getEmptyAccountLedgerBalance();
            AccountLedgerBalance.MemberId = optPrePaidTopupMemberName.MemberId;
            AccountLedgerBalance.CreditSaleAccountId = optPrePaidTopupMemberName.CreditSaleAccountId;
            AccountLedgerBalance.Name = optPrePaidTopupMemberName.MemberName;
            AccountLedgerBalance.LedgerBalance = TopupAccountBalance;
            AccountLedgerBalance.Amount = TopupAmt;

            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined) {
                BillSettlement.BillSettlementPaymentDetails.TopupPaid = FConvert.toDecimal(TopupAmt);
                AccountLedgerBalance.AvailableBalance = AccountLedgerBalance.LedgerBalance - BillSettlement.BillSettlementPaymentDetails.TopupPaid;
                BillSettlement.BillSettlementPaymentDetails.TopupAccountDets = AccountLedgerBalance;
            }

            $("#tblPrePaidTopup").show();
            $("#tBodyPrePaidTopup").empty();

            if (GlobalPref.Version == eVersion.Version9)
                $("#tBodyPrePaidTopup").append("<tr class='pos-table-row' onclick=BILLSETTLEMENT.setSelectedPrePaidTopupInfoInfo(this)>" + "<td class='pos-table-body-cell pos-table-body-cell-center' style='width:60px;cursor:pointer'> <i class='fa fa-trash fa-lg' aria-hidden='true' onclick=BILLSETTLEMENT.getPrePaidTopupDeleteClickEvent(this)></i></td>" + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-body-cell-left' style=text-align:left;>" + AccountLedgerBalance.Name + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-right'>" + FConvert.toDecimal(AccountLedgerBalance.Amount, POSCommon.numberOfDecimal) + "</td>" + "</tr>");
            else if (GlobalPref.Version == eVersion.Version10)
                $("#tBodyPrePaidTopup").append("<tr class='pos-table-row' onclick=BILLSETTLEMENT.setSelectedPrePaidTopupInfoInfo(this)>" + "<td class='pos-table-body-cell pos-table-body-cell-center' style='width:60px;cursor:pointer'> <i class='fa fa-trash fa-lg icon-delete' aria-hidden='true' style='margin-right:5px' onclick=BILLSETTLEMENT.getPrePaidTopupDeleteClickEvent(this)></i></td>" + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-body-cell-left' style=text-align:left;>" + AccountLedgerBalance.Name + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-right'>" + FConvert.toDecimal(AccountLedgerBalance.Amount, POSCommon.numberOfDecimal) + "</td>" + "</tr>");

            var d = document.getElementById("tBodyPrePaidTopup");
            if (d != undefined && d != null && d.children.length > 0) {
                var t = d.children[d.children.length - 1]
                t.setAttribute("data-PrePaidTopUp", JSON.stringify(AccountLedgerBalance));
            }
            BILLSETTLEMENT.updatePaidAmt();
            if (BillSettlement.BalanceAmount > 0)
                $("#txtPrePaidAmount").val(FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberOfDecimal));
            else
                $("#txtPrePaidAmount").val("0.00");

        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getPrepaidTopupPayClickEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
