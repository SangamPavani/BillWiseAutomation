    validateMember: function (selectedMember) {
        try {
            SEARCHMEMBER.VARIABLE.refreshRate = false;
            SEARCHMEMBER.VARIABLE.selectedMember = selectedMember;

            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined) {
                if (ApplicationNew.MemberData.ID > 0) {
                    if (SEARCHMEMBER.VARIABLE.preferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == true) {
                        if (selectedMember.MemberTypeId != ApplicationNew.MemberData.MemberTypeId) {
                            let bResultValidMemberTypeProfitPercentage = SEARCHMEMBER.isValidMemberTypeProfitPercentage();
                            if (bResultValidMemberTypeProfitPercentage == null || bResultValidMemberTypeProfitPercentage == undefined || bResultValidMemberTypeProfitPercentage == false)
                                return false;
                        }
                    }
                    else if (SEARCHMEMBER.VARIABLE.posCommon.sellingRateTagCompany == SEARCHMEMBER.VARIABLE.posCommon.memberTypeMasterTypeId
                        || SEARCHMEMBER.VARIABLE.posCommon.sellingRateTagCompany == SEARCHMEMBER.VARIABLE.posCommon.memberCardDefinitionMasterTypeId) {
                        if ((SEARCHMEMBER.VARIABLE.posCommon.sellingRateTagCompany == SEARCHMEMBER.VARIABLE.posCommon.memberTypeMasterTypeId && selectedMember.MemberTypeId != ApplicationNew.MemberData.MemberTypeId)
                            || (SEARCHMEMBER.VARIABLE.posCommon.sellingRateTagCompany == SEARCHMEMBER.VARIABLE.posCommon.memberCardDefinitionMasterTypeId && selectedMember.CardNumberId != ApplicationNew.MemberData.CardNumberId)) {
                            if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                                var msgPointOfSaleInformation = $("#msgPointOfSaleInformation").val();
                                var msgSellingRateISDifferentFromOutlet = $("#msgSellingRateISDifferentFromOutlet").val()
                                var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                                messageInfoPopup.Caption = msgPointOfSaleInformation;
                                messageInfoPopup.Message = [];
                                messageInfoPopup.Message[0] = msgSellingRateISDifferentFromOutlet
                                messageInfoPopup.ButtonType = "YesNo";
                                messageInfoPopup.YesMethod = "SEARCHMEMBER.confirmClearTransaction()";
                                messageInfoPopup.NoMethod = "MESSAGEPOPUP.closePopup()";
                                var arrValue = [];
                                arrValue.push(messageInfoPopup);
                                arrValue.push("divForModalMain");
                                COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                                return false;
                            }
                        }
                    }
                    SEARCHMEMBER.clearMemberRecord();
                }
                if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.MemberTypeExemptFields != null
                    && ApplicationNew.MemberData.MemberTypeExemptFields != undefined && ApplicationNew.MemberData.MemberTypeExemptFields.length > 0) {
                    let exemptFieldLength = ApplicationNew.MemberData.MemberTypeExemptFields.filter((p) => p != 0);
                    if (exemptFieldLength != null && exemptFieldLength != undefined && exemptFieldLength.length > 0) {
                        toastr.info("Cannot change the member as this is an Exempted sale.");
                        return false;
                    }
                }
            }
            else if ((ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined || ApplicationNew.MemberData.ID <= 0) && SEARCHMEMBER.VARIABLE.preferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == true) {
                if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0 && ApplicationNew.ListOfItems[0].DefaultValue1 != 0) {
                    let bResultValidMemberTypeProfitPercentage = SEARCHMEMBER.isValidMemberTypeProfitPercentage();
                    if (bResultValidMemberTypeProfitPercentage == null || bResultValidMemberTypeProfitPercentage == undefined || bResultValidMemberTypeProfitPercentage == false)
                        return false;
                }
            }
            if (selectedMember != null && selectedMember.MemberTypeExemptFields != null && selectedMember.MemberTypeExemptFields != undefined && selectedMember.MemberTypeExemptFields.length > 0) {
                let exemptFieldLength = selectedMember.MemberTypeExemptFields.filter((p) => p != 0);
                if (exemptFieldLength != null && exemptFieldLength != undefined && exemptFieldLength.length > 0) {
                    var msgPointOfSaleInformation = $("#msgPointOfSaleInformation").val();
                    var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                    messageInfoPopup.Caption = msgPointOfSaleInformation;
                    messageInfoPopup.Message = [];
                    messageInfoPopup.Message[0] = "The selected member is eligible for Exempted sale. Are you sure to continue?";
                    messageInfoPopup.ButtonType = "YesNo";
                    messageInfoPopup.YesMethod = "SEARCHMEMBER.confirmExemptedSaleWithSelectedMember()";
                    messageInfoPopup.NoMethod = "MESSAGEPOPUP.closePopup()";
                    var arrValue = [];
                    arrValue.push(messageInfoPopup);
                    arrValue.push("divForModalMain");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return false;
                }
                SEARCHMEMBER.clearMemberRecord();
            }
            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && FConvert.toInt(ApplicationNew.MemberData.ID) != 0)
                POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.GetMemberSchemeDefAgain = true;

            ApplicationNew.MemberData = selectedMember;
            SEARCHMEMBER.assignSelectedMember(selectedMember);
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File :: pointOfSaleCommon.js :: JavaScript Function :: SEARCHMEMBER.validateMember :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
