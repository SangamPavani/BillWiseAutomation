    applyFixedPrice: function (FreeScheme, FSGHeaderData, FromScreen, Item, MultiplyValue, Prompts, LineList, DoChanges, BaseItems) {
        try {
            let itemQtyInBill = Item.DefaultValue3;
            let itemPrice = Item.DefaultValue4;
            let itemGrossBeforeApplyingFixedPrice = FConvert.toDecimal(itemQtyInBill, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(itemPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            let maxQtyToGiveFixedPrice = FConvert.toDecimal(FSGHeaderData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(MultiplyValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            let fixedPriceMultiplier = 1;
            let BillableQty = 0, nonBillableQty = 0;
            let discountGiven = 0, itemGrossAfterApplyingFixedPrice = 0, totalDiscount = 0;
            if (itemQtyInBill >= maxQtyToGiveFixedPrice) {
                fixedPriceMultiplier = FConvert.toInt(Math.floor(FConvert.toDecimal(maxQtyToGiveFixedPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(FSGHeaderData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)));
                if (fixedPriceMultiplier < 1) {
                    fixedPriceMultiplier = 1;
                }

                nonBillableQty = FConvert.toDecimal(FSGHeaderData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(fixedPriceMultiplier, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                BillableQty = FConvert.toDecimal(itemQtyInBill, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(nonBillableQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            }
            else if (itemQtyInBill < maxQtyToGiveFixedPrice) {
                fixedPriceMultiplier = FConvert.toInt(Math.floor(FConvert.toDecimal(itemQtyInBill, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(FSGHeaderData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)));
                if (fixedPriceMultiplier < 1) {
                    fixedPriceMultiplier = 1;
                }

                nonBillableQty = FConvert.toDecimal(FSGHeaderData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(fixedPriceMultiplier, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                BillableQty = FConvert.toDecimal(itemQtyInBill, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(nonBillableQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            }

            discountGiven = FConvert.toDecimal(FSGHeaderData.DiscountD, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(fixedPriceMultiplier, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
