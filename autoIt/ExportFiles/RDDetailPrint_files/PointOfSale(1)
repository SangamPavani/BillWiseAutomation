                    if (SCHEMES.VARIABLE.SchemesDiscDtls != null && SCHEMES.VARIABLE.SchemesDiscDtls != undefined && SCHEMES.VARIABLE.SchemesDiscDtls.length > 0) {

                        var QtyIntervalsList = SCHEMES.VARIABLE.SchemesDiscDtls.filter((p) => p.CriteriaId == 1);
                        var ValueIntervalsList = SCHEMES.VARIABLE.SchemesDiscDtls.filter((p) => p.CriteriaId == 2);
                        var BothIntervalsList = SCHEMES.VARIABLE.SchemesDiscDtls.filter((p) => p.CriteriaId == 3);

                        if (checkboxQuantity == true) {
                            if (QtyIntervalsList != null && QtyIntervalsList != undefined && QtyIntervalsList.length > 0) {

                                if (SCHEMES.VARIABLE.iEditIndex == null) {
                                    if (QtyIntervalsList.length >= 1) {
                                        var bhasSameItems = SCHEMES.SCHEMESBUTTONCLICK.HasSameMandatoryItems_0(QtyIntervalsList, SCHEMES.VARIABLE.ItemId, 1);
                                        if (bhasSameItems == false)
                                            return false;
                                    }
                                }
                                else {
                                    if (QtyIntervalsList.length > 1) {
                                        var index = FConvert.toInt(SCHEMES.VARIABLE.iEditIndex);
                                        if (SCHEMES.SCHEMESBUTTONCLICK.AreEditedRowItemsAndSelectedItemsSame(SCHEMES.VARIABLE.SchemesDiscDtls[index].Itemstobepresent, SCHEMES.VARIABLE.ItemId) == false) {
                                            var bhasSameItems = SCHEMES.SCHEMESBUTTONCLICK.HasSameMandatoryItems_0(QtyIntervalsList, SCHEMES.VARIABLE.ItemId, 1);
                                            if (bhasSameItems == false)
                                                return false;
                                        }
                                    }
                                }
                            }
                        }

                        if (checkboxValue == true) {
                            if (ValueIntervalsList != null && ValueIntervalsList != undefined && ValueIntervalsList.length > 0) {
                                if (SCHEMES.VARIABLE.iEditIndex == null) {
                                    if (ValueIntervalsList.length >= 1) {
                                        var _bhasSameItems = SCHEMES.SCHEMESBUTTONCLICK.HasSameMandatoryItems_0(ValueIntervalsList, SCHEMES.VARIABLE.ItemId, 2);
                                        if (_bhasSameItems == false)
                                            return false;
                                    }
                                }
                                else {
                                    if (ValueIntervalsList.length > 1) {
                                        var index = FConvert.toInt(SCHEMES.VARIABLE.iEditIndex);
                                        if (SCHEMES.SCHEMESBUTTONCLICK.AreEditedRowItemsAndSelectedItemsSame(SCHEMES.VARIABLE.SchemesDiscDtls[index].Itemstobepresent, SCHEMES.VARIABLE.ItemId) == false) {
                                            var bhasSameItems = SCHEMES.SCHEMESBUTTONCLICK.HasSameMandatoryItems_0(ValueIntervalsList, SCHEMES.VARIABLE.ItemId, 2);
                                            if (bhasSameItems == false)
                                                return false;
                                        }
                                    }
                                }
                            }
                        }

                        if (checkboxQuantity == true && checkboxValue == true) {
                            if (BothIntervalsList != null && BothIntervalsList != undefined && BothIntervalsList.length > 0) {
                                if (SCHEMES.VARIABLE.iEditIndex == null) {
                                    if (BothIntervalsList.length >= 1) {
                                        var _bhasSameItems = SCHEMES.SCHEMESBUTTONCLICK.HasSameMandatoryItems_0(BothIntervalsList, SCHEMES.VARIABLE.ItemId, 3);
                                        if (_bhasSameItems == false)
                                            return false;
                                    }
                                }
                                else {
                                    if (BothIntervalsList.length > 1) {
                                        var index = FConvert.toInt(SCHEMES.VARIABLE.iEditIndex);
                                        if (SCHEMES.SCHEMESBUTTONCLICK.AreEditedRowItemsAndSelectedItemsSame(SCHEMES.VARIABLE.SchemesDiscDtls[index].Itemstobepresent, SCHEMES.VARIABLE.ItemId) == false) {
