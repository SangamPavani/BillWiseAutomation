                    objSDD.MinValue = txtMinValue.trim();
                    objSDD.MinValueD = 0;
                    var txtMaxValue = $("#txtMaxValue").val();
                    objSDD.MaxValue = txtMaxValue.trim();
                    objSDD.MaxValueD = 0;

