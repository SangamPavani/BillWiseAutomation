    assingBatchDataToLine: function (line, batchData, isBaseUnit) {
        try {
            let salesQtyOrRate = 0;
            if (line.ProductType == 0 || line.ProductType == 3) {
                if (batchData.Qty < 0)
                    batchData.Qty = -1 * batchData.Qty;
            }
            salesQtyOrRate = FConvert.toDecimal(batchData.Qty);
            if (isBaseUnit == false)
                salesQtyOrRate = PRODUCTSELECTION.UIMETHODS.getQtyInSalesOrRateInBase_Units(line, salesQtyOrRate, true);

            line.DefaultValue3 = COMMONMETHODS.UTILITYMETHODS.toCompanyDecimal(salesQtyOrRate, true, false, PreferenceSetting.PrefInventoryTab.DecmlsInQty);
            if (line.DefaultValue3 == 0) {
                let strMessage = line.DefaultValue2 + " : " + batchData.Qty + " batch quantity is becoming zero as per the POS preference Inventory -&gt; Decimals In Quantity, due to the reason Item is not adding.";
                return [false, strMessage];
            }
            if (line.PromoType != PromoTypes.get("FREEITEM")) {
                let bPickBatchRate = true;

                if (PREORDER.DUSMINUTESAPPINTEGRATION.VARIABLES.DUSMinutesAppIntegrationEnable == true) {
                    if ((ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION"))
                        && (line.TransactionId != null && line.TransactionId != undefined && line.TransactionId > 0)) {
                        bPickBatchRate = false;
                    }
                }
                if (bPickBatchRate) {
                    if (PreferenceSetting.PrefInventoryTab.PickBatchRate == true) {
                        if (isBaseUnit == true)
                            line.DefaultValue4 = FConvert.toDecimal(batchData.BatchRate);
                        else {
                            salesQtyOrRate = FConvert.toDecimal(batchData.BatchRate);
                            let returnSalesQtyOrRate = PRODUCTSELECTION.UIMETHODS.getQtyInBaseOrRateInSales_Units(line, salesQtyOrRate);
                            line.DefaultValue4 = FConvert.toDecimal(returnSalesQtyOrRate); //(PreferenceSetting.PrefInventoryTab.DecmlsInQty);// Convert.ToDouble(SalesQtyOrRate.ToString("f" + PreferenceSettings.PrefInventory.DecmlsInQty)); need to ask
                        }
                    }
                    else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApplyRateBasedOnQty == true) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == false) {
                            UPDATEPRODUCT.assignUnitConversionRateIfPricebookRateisZero(line);
                        }
                    }
                }
            }
            if (ApplicationNew.ButtonExchangeMode != 0)
                line.DefaultValue3 = line.DefaultValue3 * -1;

            line.DefaultValue5 = line.DefaultValue3 * line.DefaultValue4;
            line.BatchData = batchData;
            line.BatchNo = line.BatchData.BatchNo;
            PRODUCTMETHODNEW.BATCHPOPUPMETHODS.assignBatchValIfExists(line);
            return [true, ""];
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.BATCHPOPUPMETHODS.assingBatchDataToLine :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
