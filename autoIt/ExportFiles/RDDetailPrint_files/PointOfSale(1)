        try {
            //debugger;
            let isLoaded = $(element).attr("data-IsLoaded");
            if (isLoaded != null && isLoaded != undefined && FConvert.toBoolean(isLoaded) == true)
                return;

            let iProductGroupId = $(element).attr("data-ProductGroupId");
            if (iProductGroupId == null || iProductGroupId == undefined || iProductGroupId == 0) {
                toastr.error("Can not read Product Group Id from attribute");
                return;
            }

            let controlName = $(element).attr("data-ControlName");
            if (controlName == null || controlName == undefined || controlName == 0) {
                toastr.error("Can not read controlName from attribute");
                return;
            }
            //debugger;
            let childrenLength = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #ulChildren_" + iProductGroupId + " > li").length;
            if (childrenLength == null || childrenLength == undefined || childrenLength <= 0) {
                let treeViewProductControlArgs = new Object();
                treeViewProductControlArgs.ProductGroupId = iProductGroupId;
                treeViewProductControlArgs.TreeTypeId = 0;
                treeViewProductControlArgs.ControlName = controlName;
                treeViewProductControlArgs.IsLoading = false;
                treeViewProductControlArgs.IsSearch = true;
                TREEVIEWCONTROL.SEARCH.SERVER.loadChildren(treeViewProductControlArgs);
            }
            else if (childrenLength != null && childrenLength != undefined && childrenLength > 0) {
                let ulChildren = $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #ulChildren_" + iProductGroupId);
                if (ulChildren != null && ulChildren != undefined) {
                    let ulChildrenDisplay = $(ulChildren).css('display');
                    if (ulChildrenDisplay == 'block') {
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #ulChildren_" + iProductGroupId).slideUp('slow');
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #gpIcon_" + iProductGroupId).addClass("glyphicon-circle-arrow-right");
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #gpIcon_" + iProductGroupId).removeClass("glyphicon-circle-arrow-down");
                    }
                    else if (ulChildrenDisplay == 'none') {
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #ulChildren_" + iProductGroupId).slideDown('slow');
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #gpIcon_" + iProductGroupId).addClass("glyphicon-circle-arrow-down");
                        $("#" + TREEVIEWCONTROL.SEARCH.VARIABLES.SEARCHOPTION.controlName + " #gpIcon_" + iProductGroupId).removeClass("glyphicon-circle-arrow-right");
                    }
                }
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.SEARCH.loadChildren :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    closeMessagePopup: function () {
        try {
            if (GlobalPref.Version == eVersion.Version10)
