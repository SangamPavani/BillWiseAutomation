    calculateItemNetWithRoundOff: function (cProduct) {
        try {
            if (POSCommon.localCurrency.RoundOffType > 0 && POSCommon.localCurrency.GeneralRoundOff > 0) {
                let ColumnRoundOff = FConvert.toDecimal(cProduct.DefaultValue15, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                if (ColumnRoundOff > 0) {
                    cProduct.DefaultValue15 = FConvert.toDecimal(ColumnRoundOff.RoundOff(FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true), FConvert.toInt(POSCommon.localCurrency.RoundOffType, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)), POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    cProduct.LineItemRoundoff = FConvert.toDecimal(ColumnRoundOff, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(cProduct.DefaultValue15, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
                else if (ColumnRoundOff < 0 && cProduct.ProductType > 0) {
                    ColumnRoundOff = Math.abs(ColumnRoundOff);
                    let RoundOffResult = FConvert.toDecimal(ColumnRoundOff.RoundOff(FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true), FConvert.toInt(POSCommon.localCurrency.RoundOffType, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)), POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    cProduct.DefaultValue15 = FConvert.toDecimal(cProduct.DefaultValue15, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(RoundOffResult, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : posSchemeImplementationGenerics.js :: JavaScript Function :: POSSCHEMEIMPLEMENTATIONGENERICS.calculateItemNetWithRoundOff :: Catch  Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
