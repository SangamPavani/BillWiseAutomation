            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function/Event :: VOUCHERPOSTING.PRINTMETHODS.printTokenPrinting :: Catch Block :: Exception :: " + JSON.stringify(Ex));
