    getCashAmountKeyUpEvent: function () {
        // 1. BillSettlement.SelectedCurrency = Assigning
        // 2. BillSettlement.SelectedCurrency = Multicurrency is not enabled/enabled, where its assigning
        try {
            //////debugger;
            var _cashToConsider = 0;
            var cashAmount = FConvert.toDecimal($("#txtCashAmount").val().trim(), POSCommon.numberofDecimal);
            if (cashAmount > 0) {
                if (cashAmount.length == 1 && cashAmount == ".")
                    $("#txtCashAmount").val("0.");

                if (BillSettlement.SelectedCurrency == null || BillSettlement.SelectedCurrency == undefined || BillSettlement.SelectedCurrency.CurrencyId <= 0)
                    BillSettlement.SelectedCurrency = POSCommon.localCurrency;

                var _balance = FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal);
                var _cashInTextBox = FConvert.toDecimal($("#txtCashAmount").val().trim(), POSCommon.numberofDecimal);

                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == true && BillSettlement.SelectedCurrency != null && BillSettlement.SelectedCurrency != undefined && BillSettlement.SelectedCurrency.CurrencyId > 0)
                    _cashInTextBox = FConvert.toDecimal(BillSettlement.SelectedCurrency.LocalCurrencyExchangeRate, POSCommon.numberofDecimal) * FConvert.toDecimal(_cashInTextBox, POSCommon.numberofDecimal);

                if (_cashInTextBox > _balance)
                    _cashToConsider = FConvert.toDecimal(BillSettlement.BalanceAmount, POSCommon.numberofDecimal);
                else
                    _cashToConsider = FConvert.toDecimal(_cashInTextBox, POSCommon.numberofDecimal);

                let _prompts = BILLSETTLEMENT.SCHEMESMETHODS.applyPaymentTypeSchemes(PaymentTypes.get("CASH"), BillSettlement.SelectedCurrency.CurrencyId, 0, 0, _cashToConsider, false, 0, false);
                if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined) {
                    if (ApplicationNew.TotalSchemesInfo.PaymentDiscount > 0)
                        $("#txtSchemesDiscount").val(FConvert.toDecimal(ApplicationNew.TotalSchemesInfo.PaymentDiscount, POSCommon.numberOfDecimal));
                    else
                        $("#txtSchemesDiscount").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
                }

                if (_prompts != null && _prompts != undefined && _prompts.length > 0)
                    $("#txtSchemesDiscount").attr("data-Tag", JSON.stringify(_prompts));
                else
                    $("#txtSchemesDiscount").attr("data-Tag", null);
            }
            else
                $("#txtSchemesDiscount").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + " ::File:pointOfSaleBillSettlement.js ::  BILLSETTLEMENT.getCashAmountOnFocusOutEvent :: Catch block :: Message : " + Ex.message + " Description: " + Ex.description);
            return false;
        }

