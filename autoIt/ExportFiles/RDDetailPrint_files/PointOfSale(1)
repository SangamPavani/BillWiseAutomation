                let footerDataField = ApplicationNew.RetailTransFooter.DynamicFooterFields.filter((p) => p.FieldColMap == loadedFooterField[0].ColMap),
                    loadedFooterDataField = ApplicationNew.RetailTransFooter.DynamicFooterFields.filter((p) => p.FieldColMap == loadedFooterField[0].ColMap);
