    addToGridAfterTaxPlanet: function (objCustDefLeftPanelDisplay) {
        try {
            let msgExceptionWhileCheckingWeighingMachine = $("#msgExceptionWhileCheckingWeighingMachine").val();
            let msgAccessingWeighingMachineForReadQuantity = $("#msgAccessingWeighingMachineForReadQuantity").val();
            let msgPOSException = $("#msgPOSException").val();
            let msgPOSInformation = $("#msgPOSInformation").val();
            var bResultValidation = false;
            if (objCustDefLeftPanelDisplay.ProductMake == 0)
                bResultValidation = PRODUCTMETHODNEW.validateProductBeforeAdd(objCustDefLeftPanelDisplay);
            else if (objCustDefLeftPanelDisplay.ProductMake == 1)
                bResultValidation = PRODUCTMETHODNEW.validateProductSetBeforeAdd(objCustDefLeftPanelDisplay);

            if (bResultValidation == false)
                return false;

            PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay = objCustDefLeftPanelDisplay;
            if (PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay.ProductProperties != null && PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay.ProductProperties != undefined) {
                if (PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay.ProductProperties.ProductUnitTag == null || PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay.ProductProperties.ProductUnitTag == undefined)
                    PRODUCTMETHODNEW.VARIABLES.CustDefLeftPanelDisplay.ProductProperties.ProductUnitTag = objCustDefLeftPanelDisplay.ProductUnit;
            }
            const resultWeighingMachine = this.checkWeighingScale([true]);
            if (resultWeighingMachine == null || resultWeighingMachine == undefined) {
                toastr.error(msgExceptionWhileCheckingWeighingMachine, msgPOSException);
                return;
            }

            if (resultWeighingMachine != null && resultWeighingMachine != undefined && resultWeighingMachine[0] == false) {
                if (resultWeighingMachine[1] == null || resultWeighingMachine[1] == undefined || resultWeighingMachine[1].length <= 0)
                    toastr.error(msgExceptionWhileCheckingWeighingMachine, msgPOSException);
                else
                    toastr.error(resultWeighingMachine[1], msgPOSException);

                return;
            }
            else if (resultWeighingMachine != null && resultWeighingMachine != undefined && resultWeighingMachine[0] == true) {
                if (resultWeighingMachine[1] == true)// Calling SignalR for getting weight
                {
                    toastr.info(msgAccessingWeighingMachineForReadQuantity, msgPOSInformation);
                    return;
                }
            }

            PRODUCTMETHODNEW.addToGridAfterWeighingResult();
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainAddProduct.js, Method: PRODUCTMETHODNEW.addToGridAfterTaxPlanet, Catch block : Error Message : " + Ex.message);
        }
    },
