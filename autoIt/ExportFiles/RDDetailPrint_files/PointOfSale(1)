                        bAutoSelectBatch: parameter.bAutoSelectBatch, iScreenId: parameter.iScreenId, BatchListAdjusted: parameter.AdjustedBatch, sProduct: parameter.sProduct,
                        dConversion: parameter.dConversion, sUnitName: parameter.sUnitName, m_bFromPos: parameter.bfromPOS, m_bFromRelease: parameter.bReleaseReservation,
                        arrPOSBatchList: parameter.POSBatchList
                    }, "JSON", false);

                if (selectMastersResult.data != null && selectMastersResult.data != undefined && selectMastersResult.data.length > 0)
