    fillBillPrintBody: function (arrBillBody, arrBillBodyParams) {
        try {
            let linewise = arrBillBodyParams[0];
            let Spaces = arrBillBodyParams[2];
            let printRate = arrBillBodyParams[3];
            let bodyExtraField = null, selectedUnit = null;

            arrBillBody[BillPrintBody.ProductId] = linewise.DefaultValue1;
            arrBillBody[BillPrintBody.ProductName] = Spaces + linewise.DefaultValue2;
            arrBillBody[BillPrintBody.ProductAlias] = linewise.ProductAlias;
            arrBillBody[BillPrintBody.ProductCode] = linewise.ProductCode;
            arrBillBody[BillPrintBody.Quantity] = linewise.DefaultValue3;
            arrBillBody[BillPrintBody.SNo] = arrBillBodyParams[1];
            arrBillBody[BillPrintBody.UnitName] = linewise.ProductUnitName;
            arrBillBody[BillPrintBody.Narration] = linewise.Narration;
            arrBillBody[BillPrintBody.ProductType] = linewise.ProductType;
            arrBillBody[BillPrintBody.TaxName] = linewise.TaxName;
            arrBillBody[BillPrintBody.KitchenRequest] = linewise.KitchenRequest;
            arrBillBody[BillPrintBody.ERPProductType] = linewise.ERPProductType;

            if (linewise.RMANos != null && linewise.RMANos != undefined && linewise.RMANos.length > 0)
                arrBillBody[BillPrintBody.RMA] = linewise.RMANos.join(",");
            else
                arrBillBody[BillPrintBody.RMA] = "";

            arrBillBody[BillPrintBody.BatchNo] = linewise.BatchNo;
            arrBillBody[BillPrintBody.LineWiseMember] = linewise.MemberName;
            arrBillBody[BillPrintBody.LineWiseSalesman] = linewise.SalesmanName;
            arrBillBody[BillPrintBody.TaxableAmount] = linewise.TaxableAmount;

            if (linewise.UnitIdNamePair != null && linewise.UnitIdNamePair != undefined && linewise.UnitIdNamePair.length > 0 && linewise.ProductUnit > 0) {
                selectedUnit = linewise.UnitIdNamePair.filter((c) => c.Id == linewise.ProductUnit);
                if (selectedUnit != null && selectedUnit != undefined && selectedUnit.length > 0)
                    arrBillBody[BillPrintBody.UnitCode] = selectedUnit[0].Code;
            }

            if (printRate == true) {
                arrBillBody[BillPrintBody.Gross] = linewise.DefaultValue5;
                arrBillBody[BillPrintBody.Net] = linewise.DefaultValue15;
                arrBillBody[BillPrintBody.Rate] = linewise.DefaultValue4;
            }

            if (VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList != null && VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList != undefined
                && VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList.length > 0) {

                arrBillBody[BillPrintBody.Disc] = linewise.DynamicLineFields[0].FieldInput;
                arrBillBody[BillPrintBody.DynamicLineFields] = Object.assign([], linewise.DynamicLineFields);

                if (printRate == false) {
                    let dynamicLineField = arrBillBody[BillPrintBody.DynamicLineFields];
                    if (dynamicLineField != null && dynamicLineField != undefined && dynamicLineField.length > 0) {
                        for (let i = 0; i < dynamicLineField.Length; i++) {
                            if (dynamicLineField[i] != null && dynamicLineField[i] != undefined)
                                dynamicLineField[i].FieldInput = dynamicLineField[i][i].FieldValue = 0;
                        }
                    }
                }

                bodyExtraField = VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList.filter((p) => p.Name.toLowerCase().includes("gst") || p.Name.toLowerCase().includes("vat") || p.FieldBehaviour == FieldBehaviour.get("GST"));
                if (bodyExtraField != null && bodyExtraField != undefined && bodyExtraField.length > 0) {
                    bodyExtraField = bodyExtraField[0];
                    arrBillBody[BillPrintBody.Tax] = linewise.DynamicLineFields[bodyExtraField.ColumnIndex].FieldValue;
                    arrBillBody[BillPrintBody.CGST] = FConvert.toDecimal((arrBillBody[BillPrintBody.Tax] / 2), POSCommon.numberOfDecimal);
                    arrBillBody[BillPrintBody.SGST] = FConvert.toDecimal(arrBillBody[BillPrintBody.Tax], POSCommon.numberOfDecimal, true) - FConvert.toDecimal(arrBillBody[BillPrintBody.CGST], POSCommon.numberOfDecimal, true);
                }

                let discountPercentage = 0, assumeInclusiveOfGross = 0, assumeInclusiveOfNett = 0, mrp = 0;
                for (let Counter = 0; Counter < VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList.length; Counter++) {
                    if (VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].IsDiscountField == true && VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].OutputCalculationId != 1)
                        discountPercentage = discountPercentage + FConvert.toDecimal( linewise.DynamicLineFields[VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].ColumnIndex].FieldValue);

                    if (VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].EffectOnNetId == 3 && printRate == true) {
                        assumeInclusiveOfGross = assumeInclusiveOfGross + FConvert.toDecimal(linewise.DynamicLineFields[VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].ColumnIndex].FieldValue);
                        assumeInclusiveOfNett = assumeInclusiveOfNett + FConvert.toDecimal(linewise.DynamicLineFields[VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].ColumnIndex].FieldValue);
                    }

                    if (VOUCHERPOSTING.SINGLTONVARIABLES.BodyPanelExtraFieldsList[Counter].FieldBehaviour == FieldBehaviour.get("MRP"))
                        mrp = FConvert.toDecimal(linewise.DynamicLineFields[Counter].FieldValue);
                }

                arrBillBody[BillPrintBody.DiscPercent] = discountPercentage;
                arrBillBody[BillPrintBody.AssumeInclusiveOfGross] = assumeInclusiveOfGross;
                arrBillBody[BillPrintBody.AssumeInclusiveOfNett] = assumeInclusiveOfNett;
                arrBillBody[BillPrintBody.Mrp] = mrp;
            }

            if (linewise.ProductType != PosProductType.get("COMPLIMENTARY") && printRate == true) {
                arrBillBody[BillPrintBody.GrossBeforeAssumeInclusive] = FConvert.toDecimal(arrBillBody[BillPrintBody.Gross], POSCommon.numberOfDecimal, true) - FConvert.toDecimal(arrBillBody[BillPrintBody.AssumeInclusiveOfGross], POSCommon.numberOfDecimal, true);
                arrBillBody[BillPrintBody.NettBeforeAssumeInclusive] = FConvert.toDecimal(arrBillBody[BillPrintBody.Net], POSCommon.numberOfDecimal, true) - FConvert.toDecimal(arrBillBody[BillPrintBody.AssumeInclusiveOfNett], POSCommon.numberOfDecimal, true);
            }

            if (linewise.ProductType == PosProductType.get("COMPLIMENTARY")) {
                arrBillBody[BillPrintBody.Rate1] = "Comp";
                arrBillBody[BillPrintBody.Gross] = 0;
                arrBillBody[BillPrintBody.Gross1] = "Comp";
            }
            else {
                if (printRate == true) {
                    arrBillBody[BillPrintBody.Rate1] = FConvert.toDecimal(linewise.DefaultValue4, POSCommon.numberOfDecimal, true);
                    arrBillBody[BillPrintBody.Gross] = FConvert.toDecimal(linewise.DefaultValue3, POSCommon.numberOfDecimal, true) * FConvert.toDecimal(linewise.DefaultValue4, POSCommon.numberOfDecimal, true);
                    arrBillBody[BillPrintBody.Gross1] = FConvert.toDecimal(arrBillBody[BillPrintBody.Gross], POSCommon.numberOfDecimal, true);
                }
            }
            //AssignAliasForQuantityRateGross(billBody); //SERVER CODE Converted
        }
        catch (Ex) {
            console.log("DateTime :: " + new Date() + " :: File :: retailMainBillPrint.js :: JavaScript Function :: PRINTBILL.fillBillPrintBody :: Catch Block :: Exception :: " + Ex.message);
        }
    },
