                let dPrevDiscExtFldVal = calculatingLinewiseFields.PreviousValue;
                let IsFromCopyOrProp = (ApplicationNew.CopyToAllRows == true || ApplicationNew.ProportionateToAllRows == true ? true : false);
                //Discount Amount
                if (objColumnRecord.SerialNumber == 0 || (ApplicationNew.BodyPanelExtraFieldsList[objColumnRecord.ColumnIndex].EffectOnNetId == 2 && ApplicationNew.BodyPanelExtraFieldsList[objColumnRecord.ColumnIndex].OutputCalculationId == 1 && ApplicationNew.BodyPanelExtraFieldsList[objColumnRecord.ColumnIndex].IsDiscountField == true)) {
