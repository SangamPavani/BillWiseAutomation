    updatePaidAmt: function () {
        try {
            //////debugger;
            //Cash
            if (RefundSettlement.RefundSettlementPaymentDetails.CashPaidDet != null && RefundSettlement.RefundSettlementPaymentDetails.CashPaidDet != undefined
                && RefundSettlement.RefundSettlementPaymentDetails.CashPaidDet.length > 0) {
                var cashPaidSum = 0;
                for (let i = 0; i < RefundSettlement.RefundSettlementPaymentDetails.CashPaidDet.length; i++)
                    cashPaidSum = FConvert.toDecimal(FConvert.toDecimal(cashPaidSum) + FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.CashPaidDet[i].CashAmount), POSCommon.numberOfDecimal);

                RefundSettlement.RefundSettlementPaymentDetails.CashPaid = cashPaidSum;
            }
            else
                RefundSettlement.RefundSettlementPaymentDetails.CashPaid = 0;

            //Credit Card
            if (RefundSettlement.CreditCardPaymentDetails != null && RefundSettlement.CreditCardPaymentDetails != undefined
                && RefundSettlement.CreditCardPaymentDetails.length > 0) {
                var creditCardPaidSum = 0;
                for (let i = 0; i < RefundSettlement.CreditCardPaymentDetails.length; i++) {

                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                        creditCardPaidSum = FConvert.toDecimal(FConvert.toDecimal(creditCardPaidSum) + FConvert.toDecimal(RefundSettlement.CreditCardPaymentDetails[i].AmtReturning), POSCommon.numberOfDecimal);
                    else
                        creditCardPaidSum = FConvert.toDecimal(FConvert.toDecimal(creditCardPaidSum) + FConvert.toDecimal(RefundSettlement.CreditCardPaymentDetails[i].AmtReturning) + FConvert.toDecimal(RefundSettlement.CreditCardPaymentDetails[i].ReturningCardCharges), POSCommon.numberOfDecimal);
                }

                RefundSettlement.RefundSettlementPaymentDetails.CreditCardPaid = creditCardPaidSum;
            }
            else
                RefundSettlement.RefundSettlementPaymentDetails.CreditCardPaid = 0;

            //Debit Card
            if (RefundSettlement.DebitCardPaymentDetails != null && RefundSettlement.DebitCardPaymentDetails != undefined
                && RefundSettlement.DebitCardPaymentDetails.length > 0) {
                var debitCardPaidSum = 0;
                for (let i = 0; i < RefundSettlement.DebitCardPaymentDetails.length; i++) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                        debitCardPaidSum = FConvert.toDecimal(FConvert.toDecimal(debitCardPaidSum) + FConvert.toDecimal(RefundSettlement.DebitCardPaymentDetails[i].AmtReturning), POSCommon.numberOfDecimal);
                    else
                        debitCardPaidSum = FConvert.toDecimal(FConvert.toDecimal(debitCardPaidSum) + FConvert.toDecimal(RefundSettlement.DebitCardPaymentDetails[i].AmtReturning) + FConvert.toDecimal(RefundSettlement.DebitCardPaymentDetails[i].ReturningCardCharges), POSCommon.numberOfDecimal);
                }

                RefundSettlement.RefundSettlementPaymentDetails.DebitCardPaid = debitCardPaidSum;
            }
            else
                RefundSettlement.RefundSettlementPaymentDetails.DebitCardPaid = 0;

            //EPayment
            if (RefundSettlement.EPaymentDetails != null && RefundSettlement.EPaymentDetails != undefined && RefundSettlement.EPaymentDetails.length > 0) {
                var epaymentPaidSum = 0;
                for (let i = 0; i < RefundSettlement.EPaymentDetails.length; i++) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DonotconsiderCardCharges == true)
                        epaymentPaidSum = FConvert.toDecimal(FConvert.toDecimal(epaymentPaidSum) + FConvert.toDecimal(RefundSettlement.EPaymentDetails[i].AmtReturning), POSCommon.numberOfDecimal);
                    else
                        epaymentPaidSum = FConvert.toDecimal(FConvert.toDecimal(epaymentPaidSum) + FConvert.toDecimal(RefundSettlement.EPaymentDetails[i].AmtReturning) + FConvert.toDecimal(RefundSettlement.EPaymentDetails[i].ReturningCardCharges), POSCommon.numberOfDecimal);
                }

                RefundSettlement.RefundSettlementPaymentDetails.EPaymentPaid = epaymentPaidSum;
            }
            else
                RefundSettlement.RefundSettlementPaymentDetails.EPaymentPaid = 0;

            //Gift Voucher
            var gvAmt = 0;
            if (RefundSettlement.RefundSettlementPaymentDetails.GVRegDetails != null && RefundSettlement.RefundSettlementPaymentDetails.GVRegDetails != undefined
                && RefundSettlement.RefundSettlementPaymentDetails.GVRegDetails.length > 0) {
                var giftVoucherPaidSum = 0;
                for (let i = 0; i < RefundSettlement.RefundSettlementPaymentDetails.GVRegDetails.length; i++)
                    giftVoucherPaidSum = FConvert.toDecimal(FConvert.toDecimal(giftVoucherPaidSum) + FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.GVRegDetails[i].TotalValueOfVoucher), POSCommon.numberOfDecimal);

                RefundSettlement.RefundSettlementPaymentDetails.GiftVoucherPaid = giftVoucherPaidSum;
            }
            else
                RefundSettlement.RefundSettlementPaymentDetails.GiftVoucherPaid = 0;

            //Credit Note
            var creditNote = 0;
            if (RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails != null
                && RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails != undefined
                && RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails != ''
                && RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails.length > 0) {
                for (let i = 0; i < RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails.length; i++)
                    creditNote = FConvert.toDecimal(FConvert.toDecimal(creditNote) + FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaidDetails[i].AmountDetail.Amount), POSCommon.numberOfDecimal);
                RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaid = creditNote;
            }
            else {
                RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaid = 0;
            }

            //**********************************************************************************

            //Total Paid Amount
            RefundSettlement.RefundSettlementPaymentDetails.TotalPaidAmt = FConvert.toDecimal(FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.CashPaid) +
                FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.CreditCardPaid) +
                FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.DebitCardPaid) +
                FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.GiftVoucherPaid) +
                FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.CreditNotePaid) +
                FConvert.toDecimal(RefundSettlement.RefundSettlementPaymentDetails.EPaymentPaid), POSCommon.numberOfDecimal);

            //Method called to update footer right side fields
            REFUNDSETTLEMENT.updateTextBlocks_RightSide();
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:REFUNDSETTLEMENT.updatePaidAmt, Catch block : Error Message : " + Ex.message);
            return false;
        }
