                            case "Card Type":
                                cardIntegrationResponse.Card_Type = FConvert.toString(pineLabsConfirmStatusResponseArgs.TransactionData[prc].Value);
                                break;
                            case "Acquirer Name":
                                cardIntegrationResponse.Acquirer_Bank = FConvert.toString(pineLabsConfirmStatusResponseArgs.TransactionData[prc].Value);
                                break;
