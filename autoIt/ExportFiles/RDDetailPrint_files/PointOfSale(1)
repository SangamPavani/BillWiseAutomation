            //debugger;
            navigationModel.RowNumber = FConvert.toInt(navigationModel.RowNumber) + 50;
            navigationModel.PageNumber = navigationModel.PageNumber + 1;
            navigationModel.IsLoading = false;

            let isNextPageLoaded = TREEVIEWCONTROL.NAVIGATIONEVENT.setHTMLString(navigationModel);
            if (isNextPageLoaded == null || isNextPageLoaded == undefined || isNextPageLoaded == false) {
