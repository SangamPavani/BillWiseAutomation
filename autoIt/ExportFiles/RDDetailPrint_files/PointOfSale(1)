    updateGrossForSetProduct: function (SetData, SetPrice, ProductData, line) {
        try {
            let _productPrice = 0;
            if (SetData.BodyHeader.RateType == 1) {
                _productPrice = ProductData.Price;
                line.DefaultValue4 = _productPrice;
                if (SetData.BodyHeader.Discount > 0) {
                    POSSCHEMEIMPLEMENTATIONGENERICS.proportionateSetPrice(SetData, ProductData, SetPrice, line);
                }
                else {
                    if (SetPrice > 0)
                        line.DefaultValue5 = FConvert.toDecimal(line.DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(_productPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    else
                        line.DefaultValue5 = 0;
                }
            }
            else {
                if (SetData.BodyHeader.ApplyType == 3)
                    POSSCHEMEIMPLEMENTATIONGENERICS.equalSetPrice(SetData, ProductData, SetPrice, line);
                else if (SetData.BodyHeader.ApplyType == 4)
                    POSSCHEMEIMPLEMENTATIONGENERICS.proportionateSetPrice(SetData, ProductData, SetPrice, line);
            }
            if (line.DefaultValue4 != 0)
                line.DefaultValue4 = FConvert.toDecimal(line.DefaultValue4, POSCommon.numberOfDecimal);

            if (line.DefaultValue5 != 0)
                line.DefaultValue5 = FConvert.toDecimal(line.DefaultValue5, POSCommon.numberOfDecimal);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : posSchemeImplementationGenerics.js :: JavaScript Function :: POSSCHEMEIMPLEMENTATIONGENERICS.updateGrossForSetProduct :: Catch  Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    proportionateSetPrice: function (SetData, ProductData, SetPrice, line) {
        try {
            let _productPrice = 0;
            let fixedAmt = SetPrice;
            let _MatchedItemsGross = 0;
            if (SetData.BodyHeader.BodyList != null && SetData.BodyHeader.BodyList != undefined && SetData.BodyHeader.BodyList.length > 0) {
                for (let i = 0; i < SetData.BodyHeader.BodyList.length; i++) //SetData.BodyHeader.BodyList.Sum(f => f.Price);
                    _MatchedItemsGross = FConvert.toDecimal(_MatchedItemsGross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(SetData.BodyHeader.BodyList[i].Price, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            }
            if (_MatchedItemsGross == 0)
                _MatchedItemsGross = 1;
            _productPrice = (FConvert.toDecimal(ProductData.Price, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(fixedAmt, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(_MatchedItemsGross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
            line.DefaultValue4 = FConvert.toDecimal(_productPrice, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(ProductData.Quantity, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
