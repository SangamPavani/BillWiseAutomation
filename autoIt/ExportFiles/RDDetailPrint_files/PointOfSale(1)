    isValidBatchAssignment: function () {
        try {
            let strItems = "", strRateIssue = "";
            let msgBatchNotAvailableForProds = $("#msgBatchNotAvailableForProds").val();
            let msgBatchRateIssue = $("#msgBatchRateIssue").val();
            if (POSCommon.inputBatchEvenIfStockIsNotUpdated == false && (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER")))
                return true;

            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                if (ApplicationNew.ListOfItems[i].ProductType == 4) // Fully Replaced Product (Adishawar Client : DUSMinutes App Integration)
                    continue;

                if (ApplicationNew.ListOfItems[i].ProductMake == PosProductMake.get("PRODUCT")
                    && ApplicationNew.ListOfItems[i].DonotMaintainStockbyBatch == false) {
                    if (ApplicationNew.ListOfItems[i].BatchData == null || ApplicationNew.ListOfItems[i].BatchData == undefined
                        || ApplicationNew.ListOfItems[i].BatchData.BatchNo == null || ApplicationNew.ListOfItems[i].BatchData.BatchNo == undefined
                        || ApplicationNew.ListOfItems[i].BatchData.BatchNo == "")
                        strItems += ApplicationNew.ListOfItems[i].DefaultValue2 + "\n ";
                    else if (ApplicationNew.ListOfItems[i].BatchData == null
                        || ApplicationNew.ListOfItems[i].BatchData == undefined
                        || ApplicationNew.ListOfItems[i].BatchData.BatchNo == null
                        || ApplicationNew.ListOfItems[i].BatchData.BatchNo == undefined
                        || ApplicationNew.ListOfItems[i].BatchData.BatchRate > FConvert.toDecimal(ApplicationNew.ListOfItems[i].DefaultValue4) * 2)
                        strRateIssue = BILLSETTLEMENT.SERVERMETHOD.isValidBatchRate(strRateIssue, ApplicationNew.ListOfItems[i]);

                }
                else if (ApplicationNew.ListOfItems[i].ProductMake == PosProductMake.get("SET")) {
                    if (ApplicationNew.ListOfItems[i].RetailSetsDetails != null && ApplicationNew.ListOfItems[i].RetailSetsDetails != undefined
                        && ApplicationNew.ListOfItems[i].RetailSetsDetails.length > 0) {
                        for (let j = 0; j < ApplicationNew.ListOfItems[i].RetailSetsDetails.length; j++) {
                            if (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DonotMaintainStockbyBatch == false) {
                                if (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchNo == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchNo == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchNo == ""
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo.length <= 0)
                                    strItems += ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue2 + "\n ";
                                else if (ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchNo == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchNo == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo == null
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo == undefined
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchNo.length <= 0
                                    || ApplicationNew.ListOfItems[i].RetailSetsDetails[j].BatchData.BatchRate > FConvert.toDecimal(ApplicationNew.ListOfItems[i].RetailSetsDetails[j].DefaultValue4) * 2)
                                    strRateIssue = BILLSETTLEMENT.SERVERMETHOD.isValidBatchRate(strRateIssue, ApplicationNew.ListOfItems[i].RetailSetsDetails[j]);
                            }
                        }
                    }
                }
            }
            if (strItems != null && strItems != undefined && strItems.trim().length > 0) {
                toastr.info(msgBatchNotAvailableForProds + " " + strItems, "POS Information");
                return false;
            }

            if (strRateIssue != null && strRateIssue != undefined && strRateIssue.trim().length > 0) {
                toastr.info(msgBatchRateIssue + " " + strRateIssue, "POS Information");
                return false;
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleBillSettlement.js :: Method :: BILLSETTLEMENT.isValidBatchAssignment :: Catch Block :: Exception :: " + Ex.message);
            return false;
        }
    },
