                    $("#divImgProductSets").find('img').attr('src') != "") {
                    var convertedImage = [];
                    var base64String = $("#divImgProductSets").find('img').attr('src');
                    convertedImage = PRODUCTSETS.convertBase64toByteArray(base64String);
