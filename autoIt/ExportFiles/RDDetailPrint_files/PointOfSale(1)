    getInputControlDialogEvent: function (evt, inputControl) {

        try {
            var total = 0;
            var enteredValue = $(inputControl).val();
            if (enteredValue == null || enteredValue == undefined || enteredValue.trim() == "")
                enteredValue = 0;

            var charCode = null;
            if (evt != null && evt != undefined)
                charCode = (evt.which) ? evt.which : evt.keyCode;
            else
                charCode = 13;

            if (charCode == 39 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (evt.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }

            if (charCode == 13 || charCode == 9) {
                var inputControlClosestTableCell = $(inputControl).closest('td');
                var inputControlClosestTableRow = $(inputControl).closest('tr');

                var parsedDenominationInfo = JSON.parse($(inputControlClosestTableRow).attr('data-DenominationDetails'));
                var calculatedTotal = FConvert.toDecimal(($(inputControl).val() * parsedDenominationInfo.DenominationValue), CASHINOUTCOLLECTION.VARIABLE.posCommon.numberOfDecimal);
                var inputentry = $(inputControl).val() == "" ? 0 : $(inputControl).val();
                parsedDenominationInfo.Denomination = inputentry;
                parsedDenominationInfo.TotalValue = calculatedTotal;

                $(inputControlClosestTableCell).html(parsedDenominationInfo.Denomination);
                $(inputControlClosestTableRow).find('td:last-child').html(parsedDenominationInfo.TotalValue);
                $(inputControlClosestTableRow).attr('data-DenominationDetails', JSON.stringify(parsedDenominationInfo));

                var inputFound = $(inputControl).find('input');
                if (inputFound != null && inputFound != undefined && inputFound.length > 0)
                    $(inputControl).find('input').remove();

                inputFound = $(inputControlClosestTableCell).find('input');
                if (inputFound != null && inputFound != undefined && inputFound.length > 0)
                    $(inputControlClosestTableCell).find('input').remove();

                var totalValueCell = $("#tblDenominationDialog #tBodyDenominationDialog tr").find("td:last-child");
                if (totalValueCell != null && totalValueCell != undefined && totalValueCell.length > 0) {
                    for (var i = 0; i < totalValueCell.length; i++)
                        total = FConvert.toDecimal(total) + FConvert.toDecimal($(totalValueCell[i]).html());
                }
                $("#txtAmount").val(FConvert.toDecimal(total, CASHINOUTCOLLECTION.VARIABLE.posCommon.numberOfDecimal));
                return true;
            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: CASHINOUTCOLLECTION.getInputControlDialogEvent :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
    },
