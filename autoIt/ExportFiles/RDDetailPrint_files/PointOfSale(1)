    validateTransaction: function () {
        try {
            debugger;
            //Return [] = ['try/catch block', 'stop next excution in parent call.']
            let msgPointOfSaleInformation = $("#msgPointOfSaleInformation").val();
            let sProductIds = "", NegativeRateProds = [];

            if (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length <= 0) {
                toastr.info("Please add product to post transaction.", msgPointOfSaleInformation);
                return [true, false];
            }

            // NETT Amount negative validation
            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                if (ApplicationNew.ListOfItems[i].ProductType == 0 && ApplicationNew.ListOfItems[i].DefaultValue15 < 0) {
                    NegativeRateProds.push(ApplicationNew.ListOfItems[i]);
                    sProductIds += ApplicationNew.ListOfItems[i].DefaultValue2 + ",";
                }
            }
            if (sProductIds != null && sProductIds != undefined && sProductIds.length > 0)
                sProductIds = sProductIds.substring(0, sProductIds.length - 1);

            if (NegativeRateProds != null && NegativeRateProds != undefined && NegativeRateProds.length > 0 && sProductIds != null && sProductIds != undefined && sProductIds.length > 0) {
                toastr.error("Net amount cannot be negative for the Products : \n" + sProductIds);
                return [true, false];
            }

            // BATCH validation.
            if (POSCommon.isEnableBatchNumbers == true && BILLSETTLEMENT.isValidBatchAssignment() == false)
                return [true, false];

            // Checking Footer fields if any mandatory
            if (ExtraFields.retailTransFooter.FooterFieldsList.length > 0) {
                for (let k = 0; k < ExtraFields.retailTransFooter.FooterFieldsList.length; k++) {
                    if (ExtraFields.retailTransFooter.FooterFieldsList[k].FieldTypeID == 4) {
                        if (ExtraFields.retailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("HOMEDELIVERYCHARGES") && ((ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ||
                            ApplicationNew.pPresentTransactionMode == TransactionModes.get("HOMEDELIVERYFEEDBACK") ||
                            (FConvert.toInt(ApplicationNew.SelectedPreOrderDetails.DeliveryType) == 1))) == false) {
                            continue;
                        }
                        if (ExtraFields.retailTransFooter.DynamicFooterFields[k].FieldInput == 0) {
                            toastr.info(ExtraFields.retailTransFooter.FooterFieldsList[k].Name + " data is mandatory.", msgPointOfSaleInformation);
                            return [true, false];
                        }
                    }
                }
            }
            return [true, true];
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error("Exception while executing validateTransaction function. Exception :: " + JSON.stringify(Ex), "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainEstimationBill.js :: JavaScript Function/Event :: ESTIMATIONBILL.validateTransaction :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return [false];
        }
