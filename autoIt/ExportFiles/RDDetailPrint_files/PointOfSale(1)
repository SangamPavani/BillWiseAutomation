                                        Products[j].PromoType = PromoTypes.get("DISCOUNT");
                                        if (Products[j].PosProductMake == PosProductMake.get("SET"))
                                            PRODUCTSELECTION.updateSetsProperties(Products[j]);
                                    }
                                }
                            }
