    roundOff: function (number, interval, Type, numberOfDecimals) {
        try {
            if (numberOfDecimals == null || numberOfDecimals == undefined || parseInt(numberOfDecimals) == 0)
                numberOfDecimals = POSCommon.numberOfDecimal;

            number = FConvert.toDecimal(number);
            if (interval > 0) {
                switch (Type) {
                    case 1: //Nearest
                        var remainder = number % interval;
                        if (remainder > 0)
                            number = number + ((remainder < interval / 2) ? -remainder : interval - remainder);
                        return FConvert.toDecimal(number, numberOfDecimals);
                    //return FConvert.toDecimal(number, numberOfDecimals, true);
                    case 2: //Up
                        return Math.round((Math.ceil(number / interval) * interval));
                    case 3: //Down
                        return Math.round((Math.floor(number / interval) * interval));
                    default:
                        return Math.round(number);
                }
            }
            else {
                return number;
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainCommon.js, Method: COMMONMETHODS.UTILITYMETHODS.roundOff, Catch block : Error Message : " + Ex.message);
        }
    },
