    validateBeforeUpdateCellValue: function (parsedCellRecordOfClickedTableCell, parsedRowRecordOfClickedTableCell, tableCell = null) {
        try {
            if (parsedRowRecordOfClickedTableCell.ProductMake == PosProductMake.get("SET")) {
                if (parsedCellRecordOfClickedTableCell.Name == "Salesman" && PreferenceSetting.PrefMiscellaneousOtherTab.SalesmanSelectionItemWise == true)
                    return true;
            }
            if (parsedRowRecordOfClickedTableCell.PromoType == PromoTypes.get("FREEITEM")) {
                if (POSCommon.isEnableBatchNumbers == false)
                    return false;
                else if (PreferenceSetting.PrefInventoryTab.BatchSelectionMode == BatchSelectionMode.get("USERINPUT")
                    && parsedRowRecordOfClickedTableCell.BatchNo == null || parsedRowRecordOfClickedTableCell.BatchNo == undefined) {
                    if (parsedCellRecordOfClickedTableCell.Name == DefaultTransHeaders.get("BATCH")) {
                        return true;
                    }
                }
            }
            if (parsedCellRecordOfClickedTableCell.Name == "Quantity")
                return true;
            else if (parsedCellRecordOfClickedTableCell.Name == "Salesman") {
                if (PreferenceSetting.PrefMiscellaneousOtherTab.SalesmanSelectionItemWise == true)
                    return true;
            }
            else if (parsedCellRecordOfClickedTableCell.Name == "Unit") {
                if (parsedRowRecordOfClickedTableCell.DonotAllowToChangeUnitInTransaction == true || (PreferenceSetting.PrefInventoryTab.InputUnitsInTran == true
                    && parsedRowRecordOfClickedTableCell.UnitIdNamePair == null))
                    return false;
            }
            else if (parsedCellRecordOfClickedTableCell.Name == "Rate") {
                if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined) {
                    if (ApplicationNew.PreviousTransaction.ReturnedProduct != null && ApplicationNew.PreviousTransaction.ReturnedProduct != undefined && ApplicationNew.PreviousTransaction.ReturnedProduct.length > 0) {
                        var returnedProduct = ApplicationNew.PreviousTransaction.ReturnedProduct.filter((p) => p.Id == parsedRowRecordOfClickedTableCell.DefaultValue1 && p.POSSlNo == parsedRowRecordOfClickedTableCell.ItemSerialNo);
                        if (returnedProduct != null && returnedProduct != undefined && returnedProduct.length > 0)
                            return false;
                    }
                }
                if (parsedRowRecordOfClickedTableCell.ProductType > 0 && parsedCellRecordOfClickedTableCell.IsDiscountField == true) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowDiscountForExchangeTransaction == false)
                        return false;
                    else
                        return true;
                }
                const isManagerApprovalRequired = COMMONMETHODS.managerApprovalRequired(110);
                if (isManagerApprovalRequired == true) {
                    PRODUCTMETHODNEW.CHANGEPRICEMETHODS.getActionApprovedByIfExists(ApplicationNew.CurrentItem, ApplicationNew.RetailTransFooter, false, PosActionIds.get("CHANGEPRICE"));
                    VERIFICATIONPROCESS.VARIABLES.NextShortcutIdData = [];
                    VERIFICATIONPROCESS.VARIABLES.NextShortcutIdData.push(tableCell);
                    MANAGERAPPROVAL.openManagerApproval(1061);
                    return false;
                }
            }
            else if (parsedCellRecordOfClickedTableCell.SequenceNumber == 8) {
                let productType = parsedCellRecordOfClickedTableCell.DonotApplyForItemTypes;
                if (productType != null && productType != undefined && productType.length > 0) {
                    let arrProductType = productType.split(',');
                    if (arrProductType != null && arrProductType != undefined && arrProductType.length > 0) {
                        for (let i = 0; i < arrProductType.length; i++) {
                            if (ProductType.get(arrProductType[i]) == parsedRowRecordOfClickedTableCell.ERPProductType) {
                                return false;
                            }
                        }
                    }
                }

                if (parsedRowRecordOfClickedTableCell.ProductType > 0 && parsedCellRecordOfClickedTableCell.IsDiscountField == true) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowDiscountForExchangeTransaction == false)
                        return false;
                    else
                        return true;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainAddProduct.js, Method: TABLECHANGEMETHODSNEW.validateBeforeUpdateCellValue, Catch block : Error Message : " + Ex.message);
        }
    },
