    isValidCreditCard: function (bIsDisplayMessage) {

        try {
            var creditCardAmount = $.trim(FConvert.toDecimal($("#txtCreditCardAmount").val()));
            var amount = FConvert.toDecimal($("#txtCreditCardAmount").val());
            var creditExpiryMonth = FConvert.toDecimal($("#txtCreditCardExpiryMonth").val());
            var creditAmount = FConvert.toDecimal($("#txtCreditCardAmount").val(), POSCommon.numberOfDecimal);
            var dGVAmt = $.trim(creditAmount);
            var msgSelCardType = $("#msgSelCardType").val();
            var msgBSAlreadySel = $("#msgBSAlreadySel").val();
            var msgCardAmtGrThanZero = $("#msgCardAmtGrThanZero").val();
            var msgInfoBalAmtZero = $("#msgInfoBalAmtZero").val();
            var msgEnterAmt = $("#msgEnterAmt").val();
            var msgMinPmtUsingCard = $("#msgMinPmtUsingCard").val();
            var mstDoNotAllowExcAmtUsingCard = $("#mstDoNotAllowExcAmtUsingCard").val();
            var msgBSApprovalCrCard = $("#msgBSApprovalCrCard").val();

            if (BillSettlement.SelectedCreditCard == null || BillSettlement.SelectedCreditCard == undefined) {
                toastr.error(msgSelCardType);
                return;
            }

            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != null
                && BillSettlement.BillSettlementPaymentDetails.CreditCardDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++) {
                    if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardTypeId == BillSettlement.SelectedCreditCard.ID) {
                        toastr.error(BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardTypeName + msgBSAlreadySel);
                        return;
                    }
                }
            }
            if (FConvert.toDecimal($.trim(amount)) <= 0) {
                if (bIsDisplayMessage == true)
                    toastr.error(msgCardAmtGrThanZero);
                $("#txtCreditCardAmount").focus();
                return false;
            }

            else if (FConvert.toDecimal(BillSettlement.BalanceAmount) <= 0) {
                if (bIsDisplayMessage == true)
                    toastr.error(msgInfoBalAmtZero);
                BILLSETTLEMENT.clearCreditCardFields();
                return false;
            }
            else if ($.trim(amount).length == 0) {
                if (bIsDisplayMessage == true)
                    toastr.error(msgEnterAmt);
                $("#txtCreditCardAmount").focus();
                return false;
            }
            else if (amount < BillSettlement.MinCreditCardBillAmount) {
                if (bIsDisplayMessage == true)
                    toastr.error(msgMinPmtUsingCard + BillSettlement.MinCreditCardBillAmount + "");
                $("#txtCreditCardAmount").focus();
                return false;
            }
            else if (FConvert.toDecimal(dGVAmt) > FConvert.toDecimal(BillSettlement.BalanceAmount)) {
                toastr.error(mstDoNotAllowExcAmtUsingCard);
                $("#txtCreditCardAmount").focus();
                return false;
            }
            else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApprovalCodeForCreditCard == true) {
                var debitCardApprovalCode = $("#txtCreditCardApprovalCode").val();
                if (debitCardApprovalCode.trim().length <= 0) {
                    if (bIsDisplayMessage == true)
                        toastr.error(msgBSApprovalCrCard);
                    $("#txtCreditCardApprovalCode").val();
                    $("#txtCreditCardApprovalCode").focus();
                    return false;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.isValidCreditCard, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
