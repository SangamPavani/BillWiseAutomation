    AssignValuesOnDoubleClick: function (SchemeInfo) {
        try {
            if (SchemeInfo.CriteriaId == 1) {
                $("#chkQuantity").prop("checked", "checked");
                $("#txtMinQty").prop("disabled", false);
                $("#txtMaxQty").prop("disabled", false);
                FCommon.UI.enableButton(true, "divUnit");
                SCHEMES.VARIABLE.unitIsEnabled = true;

                $("#txtMinQty").val(FConvert.toDecimal(SchemeInfo.MinQty, SCHEMES.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtMaxQty").val(FConvert.toDecimal(SchemeInfo.MaxQty, SCHEMES.VARIABLE.POSCommon.numberOfDecimal));

                $("#chkValue").prop("checked", false);
                $("#txtMinValue").prop("disabled", true);
                $("#txtMaxValue").prop("disabled", true);
            }
            else if (SchemeInfo.CriteriaId == 2) {
                $("#chkValue").prop("checked", "checked");
                $("#txtMinValue").prop("disabled", false);
                $("#txtMaxValue").prop("disabled", false);

                $("#txtMinValue").val(FConvert.toDecimal(SchemeInfo.MinValue, SCHEMES.VARIABLE.POSCommon.numberOfDecimal));
                $("#txtMaxValue").val(FConvert.toDecimal(SchemeInfo.MaxValue, SCHEMES.VARIABLE.POSCommon.numberOfDecimal));

                $("#chkQuantity").prop("checked", false);
                $("#txtMinQty").prop("disabled", true);
