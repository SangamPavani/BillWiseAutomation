                        arrCreditNotesExchangeRefundCreditNote[TransactionIndex.HEADER] = arrCreditNotesExchangeRefundCreditNoteHeader;
                        let tags = [];
                        let tagValue = new Object();
                        tagValue.ID = 1101;
                        tagValue.Tag = POSCommon.counterId;
                        tags.push(tagValue);
                        if (PreferenceSetting.PrefMiscellaneousOtherTab.MemberSelectionItemWise == false) {
                            if (VOUCHERPOSTING.VARIABLES.MemberData != null && VOUCHERPOSTING.VARIABLES.MemberData != undefined && VOUCHERPOSTING.VARIABLES.MemberData.ID > 0) {
