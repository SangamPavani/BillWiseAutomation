    getBillSettlementObjectForCreditSale: function () {

        try {
            var msgPlzSelectoneVoucherToAdjust = $("#msgPlzSelectoneVoucherToAdjust").val();
            var billSettlementObject = BILLSETTLEMENTDATASTRUCTURE.getEmptyBillSettlementObjectToOpen();
            var tableRowCreditSaleInfo = [];

            if ($("#rbtAdjustByBill").is(":checked") == true) {
                if (ApplicationNew.SelectedCreditSale.PaidAmount > 0)
                    billSettlementObject.NetAmount = ApplicationNew.SelectedCreditSale.PaidAmount;
                else
                    billSettlementObject.NetAmount = ApplicationNew.SelectedCreditSale.AmountToBePaid;
            }
            else if ($("#rbtAdjustByFIFO").is(":checked") == true) {
                billSettlementObject.NetAmount = ApplicationNew.SelectedCreditSale.PaidAmount;
            }
            else if ($("#rbtAdjustByMultipleBill").is(":checked") == true) {
                var creditSaleInfo = $("#tbodyCreditSaleAdjustment > tr");
                if (creditSaleInfo != null && creditSaleInfo != undefined && creditSaleInfo.length > 0) {
                    for (let i = 0; i < creditSaleInfo.length; i++) {
                        var parsedCreditSaleInfo = $(creditSaleInfo[i]).attr("data-CreditSale");
                        if (parsedCreditSaleInfo != null && parsedCreditSaleInfo != undefined && parsedCreditSaleInfo.trim().length > 0) {
                            parsedCreditSaleInfo = JSON.parse(parsedCreditSaleInfo);
                            if (tableRowCreditSaleInfo == null || tableRowCreditSaleInfo == undefined)
                                tableRowCreditSaleInfo = [];
                            tableRowCreditSaleInfo.push(parsedCreditSaleInfo);
                        }
                    }
                }


                if (tableRowCreditSaleInfo != null && tableRowCreditSaleInfo != undefined && tableRowCreditSaleInfo.length > 0) {
                    var lstCreditSaleMultipleBillAdjustment = tableRowCreditSaleInfo.filter((p) => p.IsBillSelected == true);

                    if (lstCreditSaleMultipleBillAdjustment != null && lstCreditSaleMultipleBillAdjustment != undefined
                        && lstCreditSaleMultipleBillAdjustment.length > 0) {
                        CREDITSALE.VARIABLE.selectedCreditSaleHeader = [];
                        for (let i = 0; i < lstCreditSaleMultipleBillAdjustment.length; i++) {
                            if (lstCreditSaleMultipleBillAdjustment[i].PaidAmount > 0)
                                billSettlementObject.NetAmount = FConvert.toDecimal(billSettlementObject.NetAmount, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(lstCreditSaleMultipleBillAdjustment[i].PaidAmount, POSCommon.numberOfDecimal, true);
                            else
                                billSettlementObject.NetAmount = FConvert.toDecimal(billSettlementObject.NetAmount, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(lstCreditSaleMultipleBillAdjustment[i].AmountToBePaid, POSCommon.numberOfDecimal, true);

                            CREDITSALE.VARIABLE.selectedCreditSaleHeader.push(lstCreditSaleMultipleBillAdjustment[i]);
                        }
                        billSettlementObject.CreditSaleMultipleBillAdjustment = lstCreditSaleMultipleBillAdjustment;
                    }
                    else {
                        toastr.error(msgPlzSelectoneVoucherToAdjust);
                        return;
                    }
                }
            }
            return billSettlementObject;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:CREDITSALE.getBillSettlementObjectForCreditSale, Catch block : Error Message : " + Ex.message);
