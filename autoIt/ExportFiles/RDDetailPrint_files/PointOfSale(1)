    postPOSTransaction: function () {
        try {
            //debugger;
            let rtnValuesBillSettlement = null;
            let voucherPostedSuccesfully = $("#msgPostedSuccessfully").val();
            let msgPOSInformation = $("#msgPOSInformation").val();
            let pointOfConfirmation = $("#msgPointOfSaleConfirmation").val();
            let msgDoyouwanttoprintBill = $("#msgDoyouwanttoprintBill").val();
            let msgDoyouwanttoprintBillorEmail = $("#msgDoyouwanttoprintBillorEmail").val();
            let msgCannotposttransactionpleasecheckthelogformoredetails = $("#msgCannotposttransactionpleasecheckthelogformoredetails").val();
            let msgBatchnotavailableforthisItem = $("#msgBatchnotavailableforthisItem").val();
            let msgStockisnegativefor = $("#msgStockisnegativefor").val();
            let msgRMANotAvailableForProds = $("#msgRMANotAvailableForProds").val();
            let msgUnitconversionnotdefinedfor = $("#msgUnitconversionnotdefinedfor").val();
            let msgsomeitems = $("#msgsomeitems").val();
            VOUCHERPOSTING.assignVoucherPostingVariables();

            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPOSSALES") || ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY")) {
                CALCULATION.setFooterFieldValues(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalSchemeAmount, VOUCHERPOSTING.VARIABLES.RoundOff, FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.CreditCardCharges, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.DebitCardCharges, POSCommon.numberOfDecimal, true), VOUCHERPOSTING.VARIABLES.EPaymentCharges);
                CALCULATION.calculateFooter(ApplicationNew);
                rtnValuesBillSettlement = VOUCHERPOSTING.salesInvoiceVoucher();
            }
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPOSSALES"))
                rtnValuesBillSettlement = VOUCHERPOSTING.updateSalesInvoice();

            if (rtnValuesBillSettlement != null && rtnValuesBillSettlement != undefined) {
                if (rtnValuesBillSettlement.bSuccess == true) {
                    RETAILMAIN.closePopup('#divBillSettlementModal');
                    if (rtnValuesBillSettlement.result[5] != null && rtnValuesBillSettlement.result[5] != undefined)
                        VOUCHERPOSTING.VARIABLES.TransactionStatus = rtnValuesBillSettlement.result[5];

                    if (rtnValuesBillSettlement.result[11] != null && rtnValuesBillSettlement.result[11] != undefined)
                        VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TokenNumber = rtnValuesBillSettlement.result[11];

                    if (rtnValuesBillSettlement.externalModuleData != null && rtnValuesBillSettlement.externalModuleData != undefined && rtnValuesBillSettlement.externalModuleData.Data != null && rtnValuesBillSettlement.externalModuleData.Data != undefined && rtnValuesBillSettlement.externalModuleData.Data.length > 0)
                        VOUCHERPOSTING.VARIABLES.RetailTransFooter.ExternalHeaderExtraFieldsResponse = rtnValuesBillSettlement.externalModuleData.Data[0];

                    VOUCHERPOSTING.VARIABLES.MasterFieldData = rtnValuesBillSettlement.result[9]; //Master Field Data (Printing)
                    VOUCHERPOSTING.VARIABLES.LocalPOSDate = ApplicationNew.LocalPosDate;
                    VOUCHERPOSTING.VARIABLES.LocalPOSTime = ApplicationNew.LocalPosTime;
                    VOUCHERPOSTING.VARIABLES.IsFromJS = true;

                    //Required for External Module Calling
                    ApplicationNew.RetailTransFooter.ExternalHeaderExtraFieldsResponse = VOUCHERPOSTING.VARIABLES.RetailTransFooter.ExternalHeaderExtraFieldsResponse;
                    toastr.success(voucherPostedSuccesfully, msgPOSInformation);
                    //assigning variable for external module
                    addProductToGridObject.printObject = ApplicationNew;

                    //Calling External Module
                    //debugger;
                    if (POSEXTERNALMODULE.getExternalModuleExistWithEventType(PosExternalOnEvent.AfterVoucherSave) == true) {
                        POSEXTERNALMODULE.clearVariables();
                        POSEXTERNALMODULE.VARIABLES.ExternalModuleVoucherType = 3331;
                        POSEXTERNALMODULE.VARIABLES.ExternalModuleEventType = PosExternalOnEvent.AfterVoucherSave;
                        TRANSACTION.SERVERMETHODS.getSessionVariables();
                        return;
                    }

                    if (PRINTERDIALOG.VARIABLE.isCustomPrinting == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AskForConfirmationBeforePrinting == true) {
                            var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                            messageInfoPopup.Caption = pointOfConfirmation;
                            messageInfoPopup.Message = [];
                            if (POSCommon.emailIdExist == true) {
                                messageInfoPopup.Message[0] = msgDoyouwanttoprintBillorEmail;
                                messageInfoPopup.ButtonType = "PrintEmailCancel";
                                messageInfoPopup.EmailMethod = "VOUCHERPOSTING.EMAILMETHODS.openEMailConfirmation('printLayout')";
                                messageInfoPopup.EmailPrintMethod = "VOUCHERPOSTING.EMAILMETHODS.openEMailPrintConfirmation('printLayout')";
                            }
                            else {
                                messageInfoPopup.Message[0] = msgDoyouwanttoprintBill;
                                messageInfoPopup.ButtonType = "PrintCancel";
                            }

                            messageInfoPopup.PrintMethod = "VOUCHERPOSTING.PRINTMETHODS.printLayout()";
                            messageInfoPopup.CancelMethod = "VOUCHERPOSTING.EMAILMETHODS.closePopup()";
                            messageInfoPopup.CloseMarkMethod = "VOUCHERPOSTING.EMAILMETHODS.closePopup()";
                            var arrValue = [];
                            arrValue.push(messageInfoPopup);
                            arrValue.push("divMessageInfo");
                            COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                            return;
                        }
                    }

                    VOUCHERPOSTING.PRINTMETHODS.printLayout();
                }
                else if (rtnValuesBillSettlement.bSuccess == false) {
                    //debugger;
                    let VoucherErrorMsg = "";
                    let productIndex = -1;
                    if (rtnValuesBillSettlement.result.length == 3)
                        toastr.info(msgCannotposttransactionpleasecheckthelogformoredetails, msgPOSInformation);
                    else {
                        if (rtnValuesBillSettlement.result[13] != null && rtnValuesBillSettlement.result[13] != undefined)
                            toastr.info(rtnValuesBillSettlement.result[13], msgPOSInformation);
                    }
                    if (rtnValuesBillSettlement.result != null && rtnValuesBillSettlement.result != undefined) {
                        if (rtnValuesBillSettlement.result[12] == null || rtnValuesBillSettlement.result[12] == undefined) {
                            VoucherErrorMsg = rtnValuesBillSettlement.result[4];
                            toastr.info(VoucherErrorMsg, msgPOSInformation);
                        }
                    }

                    let vStatus = rtnValuesBillSettlement.result[2];
                    if (vStatus != null && vStatus != undefined && vStatus.Messages != null && vStatus.Messages != undefined && vStatus.Messages.length > 0) {
                        if (VoucherErrorMsg != null && VoucherErrorMsg != undefined && VoucherErrorMsg.length > 0)
                            VoucherErrorMsg = "";

                        for (let i = 0; i < vStatus.Messages.length; i++) {
                            if (vStatus.Messages[i] == 46 || vStatus.Messages[i] == 35 || vStatus.Messages[i] == 19 || vStatus.Messages[i] == 1 || vStatus.Messages[i] == 2 || vStatus.Messages[i] == 47 || vStatus.Messages[i] == 40) {
                                switch (vStatus.Messages[i]) {
                                    case 46:
                                    case 35:
                                    case 19:
                                        VoucherErrorMsg = msgBatchnotavailableforthisItem;
                                        break;
                                    case 1:
                                    case 2:
                                        VoucherErrorMsg = msgStockisnegativefor;
                                        break;
                                    case 47:
                                        VoucherErrorMsg = msgRMANotAvailableForProds;
                                        break;
                                    case 40:
                                        VoucherErrorMsg = msgUnitconversionnotdefinedfor;
                                        break;
                                }
                                if (vStatus.BodyIds != null && vStatus.BodyIds != undefined && vStatus.BodyIds.length > 0 && vStatus.BodyIds[i] != null && vStatus.BodyIds[i] != undefined && vStatus.BodyIds[i] >= 0) {
                                    let ProdName = "";
                                    if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction != undefined) {

                                        let productIds = [];
                                        if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != undefined && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.length > 0)
                                            productIds = VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.filter((p) => p.Sales.Product);

                                        if (productIds != null && productIds != undefined && productIds.length > 0) {
                                            let ProdId = productIds[vStatus.BodyIds[i]];
                                            if (VOUCHERPOSTING.VARIABLES.ListOfItems != null && VOUCHERPOSTING.VARIABLES.ListOfItems != undefined && VOUCHERPOSTING.VARIABLES.ListOfItems.length > 0) {
                                                for (let PC = 0; PC < VOUCHERPOSTING.VARIABLES.ListOfItems.length; PC++) {
                                                    if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("PRODUCT") || VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("KIT")) {
                                                        if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue1 == ProdId) {
                                                            ProdName = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                    else if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("SET")) {
                                                        let setItem = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RetailSetsDetails.filter(p => p.DefaultValue1 == ProdId);
                                                        if (setItem != null && setItem != undefined) {
                                                            ProdName = setItem.DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VoucherErrorMsg = VoucherErrorMsg + ProdName;
                                }
                                VoucherErrorMsg = VoucherErrorMsg + msgsomeitems;
                            }
                        }
                    }

                    if (VoucherErrorMsg == null || VoucherErrorMsg == undefined || VoucherErrorMsg.length <= 0)
                        VoucherErrorMsg = "Exception while posting voucher. Please check the log for more details.";

                    toastr.error(VoucherErrorMsg, "POS Exception");
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.postPOSTransaction :: Catch Block :: Exception :: " + JSON.stringify(Ex));
        }
    },
    salesInvoiceVoucher: function () {
        try {
            let msgPaidAmtNetAmtMismatch = $("#msgPaidAmtNetAmtMismatch").val();
            let errWhileCalculatingMemberPointsCheckLogs = $("#errWhileCalculatingMemberPointsCheckLogs").val();
            let errWhileAssigningMemberPointsDetCheckLogs = $("#errWhileAssigningMemberPointsDetCheckLogs").val();
            // Checking 'Total Paid Amount' & 'Total Net Amount' if donot match stoping the transaction
            if (FConvert.toDecimal((VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalPaidAmt - VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalChangeAmount), POSCommon.numberOfDecimal) != FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.NetAmt, POSCommon.numberOfDecimal))
                return [false, msgPaidAmtNetAmtMismatch];

            // Getting MemberPoints when Member is present and will be saved in SaveBillSettlementDetails
            if (VOUCHERPOSTING.VARIABLES.MemberData != null && VOUCHERPOSTING.VARIABLES.MemberData != undefined &&
                VOUCHERPOSTING.VARIABLES.MemberData.ID > 0) {
                let memberPointCalculationResult = VOUCHERPOSTING.MEMBER.getCalculatedMemberPoint();
                if (memberPointCalculationResult == null || memberPointCalculationResult == undefined)
                    return [false, errWhileCalculatingMemberPointsCheckLogs];
            }

            let arrSalesInvoiceTransaction = VOUCHERPOSTING.salesInvoiceTransaction();
            let arrJournalVoucherTransaction = VOUCHERPOSTING.journalVoucherTransaction();
            let arrCreditNotesExchangeRefundCreditNote = VOUCHERPOSTING.postCreditNotesExchangeRefundCreditNoteAmount();

            let arrBillSettlementDetails = [];
            arrBillSettlementDetails[SaveVoucherIndex.TypeOfPosting] = 1;
            arrBillSettlementDetails[SaveVoucherIndex.Revert] = false;
            if (ApplicationNew.RetailTransFooter.IsTourist == true)
                VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.IsTourist = ApplicationNew.RetailTransFooter.IsTourist;

            arrBillSettlementDetails[SaveVoucherIndex.VoucherType] = (VOUCHERPOSTING.VARIABLES.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ? PreferenceSetting.PrefPostingTab.DeliveryNoteVoucher : PreferenceSetting.PrefPostingTab.POSVoucher);
            arrBillSettlementDetails[SaveVoucherIndex.SalesInvoiceTransaction] = arrSalesInvoiceTransaction;
            VOUCHERPOSTING.VARIABLES.PosSalesTransaction = arrSalesInvoiceTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.JournalVoucherTransaction] = arrJournalVoucherTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.BillSettlementPaymentDetails] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails;
            arrBillSettlementDetails[SaveVoucherIndex.HeaderExtraFieldsData] = VOUCHERPOSTING.VARIABLES.HeaderExtraFieldsData;
            if (arrCreditNotesExchangeRefundCreditNote == null || arrCreditNotesExchangeRefundCreditNote == undefined || arrCreditNotesExchangeRefundCreditNote.length <= 0)
                arrBillSettlementDetails[SaveVoucherIndex.CreditNoteRefundTransaction] = null;
            else
                arrBillSettlementDetails[SaveVoucherIndex.CreditNoteRefundTransaction] = arrCreditNotesExchangeRefundCreditNote;

            let paymentRelatedExtraDetails = VOUCHERPOSTING.getPaymentRelatedExtraDetails();
            if (paymentRelatedExtraDetails != null && paymentRelatedExtraDetails != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.PaymentRelatedExtraField] = paymentRelatedExtraDetails;
            if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined) {
                if (ApplicationNew.TotalSchemesInfo.DVToSaveList != null && ApplicationNew.TotalSchemesInfo.DVToSaveList != undefined && ApplicationNew.TotalSchemesInfo.DVToSaveList.length > 0) {
                    for (let i = 0; i < ApplicationNew.TotalSchemesInfo.DVToSaveList.length; i++) {
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].LocationId = POSCommon.locationId;
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].UserId = POSCommon.userId;
                    }
                    arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = ApplicationNew.TotalSchemesInfo.DVToSaveList;
                }
            }
            else
                arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = null;

            //BillSetmntDtls.GvCreditNotePoints = VOUCHERPOSTING.getPaymentRelatedExtraDetails();
            let transactionSchemesApplied = VOUCHERPOSTING.getTransSchemesApplied();
            if (transactionSchemesApplied != null && transactionSchemesApplied != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = transactionSchemesApplied;
            else
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = null;

            if (ApplicationNew.HomeDelivery != null && ApplicationNew.HomeDelivery != undefined) {
                ApplicationNew.HomeDelivery.CreatedBy = POSCommon.userId;
                ApplicationNew.HomeDelivery.ModifiedBy = POSCommon.userId;
