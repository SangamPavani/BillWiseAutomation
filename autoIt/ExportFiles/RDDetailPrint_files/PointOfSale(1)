    afterRMASelected: function () {
        try {
            let msgPOSInformation = $("input#msgPOSInformation ").val();
            let msgNotAllowedAsThereIsMaxItemRestrictionInTheBill = $("#NotAllowedAsThereIsMaxItemRestrictionInTheBill").val();

            if (TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.ColumnSelected == LineWiseColumn.None) {
                if (ApplicationNew.CurrentItem != null && ApplicationNew.CurrentItem != undefined && ApplicationNew.CurrentItem.DefaultValue4 == 0) {
                    let rtnRMAPopup = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopupAddToProduct([ChangePriceLogic.AfterRMASelection]);
                    if (rtnRMAPopup != null && rtnRMAPopup != undefined && rtnRMAPopup.length > 0) {
                        if (FConvert.toBoolean(rtnRMAPopup[0]) == false) {
                            if (rtnRMAPopup[1] != null && rtnRMAPopup[1] != undefined && rtnRMAPopup[1].length > 0)
                                toastr.info(rtnRMAPopup[1], msgPOSInformation);

                            return [false, rtnRMAPopup[1]];
                        }
                        else if (FConvert.toBoolean(rtnRMAPopup[0]) == true && FConvert.toString(rtnRMAPopup[1]) != null && FConvert.toString(rtnRMAPopup[1]) != undefined
                            && FConvert.toString(rtnRMAPopup[1]).trim().length > 0) {
                            PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopup(0);
                            return [false, ""];
                        }
                    }
                }
            }
            else if (TABLECHANGEMETHODSNEW.VARIABLES.LINEWISEEXTRAFIELD.ColumnSelected == LineWiseColumn.Quantity) {
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApplyRateBasedOnQty == true && PreferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == false) {
                    let dRate = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.abs(ApplicationNew.CurrentItem.DefaultValue3), 0);
                    if (dRate == 0) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.IfRateIsZeroAtSettlement == false) {
                            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.WarnIfRateIsZero == WarnIfRateIsZero.get("NOTALLOWED"))
                                alert("Not allowed to add item as Rate is Zero.");
                        }
                        if (POSCommon.manualPriceEntry == true) {
                            ApplicationNew.BatchRelatedList = [];
                            if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET")) {
                                let batchRelatedData = new Object();
                                batchRelatedData.CurrentItem = ApplicationNew.CurrentItem;
                                ApplicationNew.BatchRelatedList.push(batchRelatedData);
                                PRODUCTMETHODNEW.CHANGEPRICEMETHODS.openChangePricePopup(0);
                                return [false, ""];
                            }
                        }
                    }
                    if (dRate == 0) {
                        ApplicationNew.CurrentItem.DefaultValue3 = pProductTypeMultiplier * dPrevQty;
                        alert("Not allowed to add item as Rate is Zero.");
                        return [true, "", ""];
                    }
                }
            }
            if (ApplicationNew.ListOfItems == null)
                ApplicationNew.ListOfItems = [];

            let pushitem = true;
            if (ApplicationNew.CurrentItem.PosProductMake == PosProductMake.get("SET")) {
                if (ApplicationNew.IsNewProdCodeExecuted != null && ApplicationNew.IsNewProdCodeExecuted != undefined)
                    pushitem = ApplicationNew.IsNewProdCodeExecuted;
            }

            if (ApplicationNew.ButtonExchangeMode != 0)
                ApplicationNew.CurrentItem.DefaultValue3 = ApplicationNew.CurrentItem.DefaultValue3 * -1;

            rtnCommonValue = PRODUCTSELECTION.UIMETHODS.callingCommonMethods(ApplicationNew.CurrentItem, pushitem);
            if (rtnCommonValue != null && rtnCommonValue != undefined && rtnCommonValue.length > 0) {
                if (rtnCommonValue != null && rtnCommonValue != undefined && rtnCommonValue.length > 0 && FConvert.toBoolean(rtnCommonValue[0]) == false) {
                    if (rtnCommonValue[1] != null && rtnCommonValue[1] != undefined && rtnCommonValue[1].trim().length > 0)
                        toastr.info(msgNotAllowedAsThereIsMaxItemRestrictionInTheBill, msgPOSInformation);
                }
            }

            if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != undefined) {
                if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != undefined) {
                    if (RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.IsProductReplacementEnabled == true) {
                        let lstCustLineWise = ApplicationNew.ListOfItems;
                        PRODUCTSELECTION.dusMinutesAppIntegrationReplaceProduct(lstCustLineWise, RETAILMAIN.VARIABLE.ApplicationIntegrationArgs);
                        ApplicationNew.ListOfItems = lstCustLineWise;
                    }
                }
            }
            if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET")) {
                for (let i = 0; i < ApplicationNew.BatchRelatedList.length; i++)
                    ApplicationNew.ListOfItems.push(ApplicationNew.BatchRelatedList[i].CurrentItem);
            }
            else {
                if (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length <= 0)
                    ApplicationNew.ListOfItems.push(ApplicationNew.CurrentItem);
                else {
                    if ((ApplicationNew.CurrentItem.ItemSerialNo - 1) < ApplicationNew.ListOfItems.length)
                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                    else
                        ApplicationNew.ListOfItems.push(ApplicationNew.CurrentItem);
                }
            }
            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                ApplicationNew.ListOfItems[i].ItemSerialNo = (i + 1);

            for (let j = 0; j < ApplicationNew.ListOfItems.length; j++) {
                rtnCommonValue = PRODUCTSELECTION.UIMETHODS.callingCommonMethods(ApplicationNew.ListOfItems[j]);
                if (rtnCommonValue != null && rtnCommonValue != undefined && rtnCommonValue.length > 0) {
                    if (rtnCommonValue != null && rtnCommonValue != undefined && rtnCommonValue.length > 0 && FConvert.toBoolean(rtnCommonValue[0]) == false) {
                        if (rtnCommonValue[1] != null && rtnCommonValue[1] != undefined && rtnCommonValue[1].trim().length > 0) {
                            toastr.info(msgNotAllowedAsThereIsMaxItemRestrictionInTheBill, msgPOSInformation);
                            if (UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitId != null && UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitId != undefined && UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitId > 0)
                                ApplicationNew.CurrentItem.ProductUnit = ApplicationNew.ListOfItems[j].ProductUnit = UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitId;

                            if (UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitName != null && UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitName != undefined && UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitName.length > 0)
                                ApplicationNew.CurrentItem.ProductUnitName = ApplicationNew.ListOfItems[j].ProductUnitName = UPDATEPRODUCT.VARIABLES.UNIT.PreviousUnitName;

                            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[i], ApplicationNew);

                            PRODUCTVIEW.updateLeftPanel();
                            return [false, ""];
                        }
                    }
                }
            }
            //if (ApplicationNew.PresentTransactionMode < TransactionModes.ViewPreOrder && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == null || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == undefined) {
            //    if (PreferenceSettings.PrefGeneral.ImplSchAtBillStlmnt == false)
            //      //  ImplementLineWiseSchemes(ApplicationNew); Ojha Sir
            //}

            for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[i], ApplicationNew);

            ApplicationNew.BatchRelatedList = [];
            PREORDER.DUSMINUTESAPPINTEGRATION.VARIABLES.IsProductReplaceInitiate = false;
            PRODUCTVIEW.updateLeftPanel();

            PRODUCTMETHODNEW.SERVERMETHODS.afterAddedProduct();
