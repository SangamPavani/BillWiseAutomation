                }
                else {
                    billSettlementPaymentDetails = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails;
                }
            }
            else {
                billSettlementPaymentDetails = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails;
            }
            let sum = 0, qtySum = 0, fTotalNetWithoutVAT = 0;
            if (VOUCHERPOSTING.VARIABLES.ListOfItems != null && VOUCHERPOSTING.VARIABLES.ListOfItems != undefined && VOUCHERPOSTING.VARIABLES.ListOfItems.length > 0) {
                for (let i = 0; i < VOUCHERPOSTING.VARIABLES.ListOfItems.length; i++) {
                    if (VOUCHERPOSTING.VARIABLES.ListOfItems[i].ProductType == 3)
                        sum = sum + 0;
                    else
                        sum = sum + FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.ListOfItems[i].DefaultValue5, POSCommon.numberOfDecimal,true);

                    qtySum = qtySum + VOUCHERPOSTING.VARIABLES.ListOfItems[i].DefaultValue3;
                    fDiscount = fDiscount + FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.ListOfItems[i].DynamicLineFields[0].FieldInput);
                    fTotalNetWithoutVAT = fTotalNetWithoutVAT + VOUCHERPOSTING.VARIABLES.ListOfItems[i].DefaultValue15;
                }
                fGrossAmount = sum;
                fQTY = qtySum;
            }
            let fNetAmount = FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.RetailTransFooter.UserWiseNet);
           // fTotalNetWithoutVAT = fTotalNetWithoutVAT + fNetAmount;
            //SERVERSIDE Converted
            //FillFooterDateTime(Date, Time, ref billPrintFooter);
            arrBillPrintingFooter[BillPrintFooter.Date] = date;
            arrBillPrintingFooter[BillPrintFooter.Time] = time;
            arrBillPrintingFooter[BillPrintFooter.FDiscount] = fDiscount;
