        }
    },
    getLastPage: function (navigationModel) {
        try {
            //debugger;

            var iLastPageNumber = Math.abs(FConvert.toInt(navigationModel.TotalRecordCount) / 50);
            var iMaxCount = 50 * Math.abs(FConvert.toInt(navigationModel.TotalRecordCount) / 50);
            if (FConvert.toInt(iMaxCount) == FConvert.toInt(navigationModel.TotalRecordCount))
                iMaxCount = FConvert.toInt(iMaxCount) - 50;

