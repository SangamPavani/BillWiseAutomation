    callImplementSchemesOnItemGridEdit: function (index) {
        try {
            let billwiseSchemesCalled = false;
            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER")) {
                let divPreorderDetail = $("#divPreOrderDetails");
                if (divPreorderDetail != null && divPreorderDetail != undefined && divPreorderDetail.length > 0 || PREORDERDETAILS.PRIVATEVARIABLE.PreOrderDetailsScreenOpened == true) {
                    billwiseSchemesCalled = true;
                    UPDATEPRODUCT.implementBillwiseSchemesPreorder();
                }
            }
            if (billwiseSchemesCalled == false && PreferenceSetting.PrefGeneralTab.ImplSchAtBillStlmnt == false)
                POSSCHEMEIMPLEMENTATIONGENERICS.implementLineWiseSchemesExtension();

            if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts != null && ApplicationNew.TotalSchemesInfo.LinePrompts != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts.length > 0) {
                let discount = 0;
                for (let i = 0; i < ApplicationNew.TotalSchemesInfo.LinePrompts.length; i++)
                    discount = FConvert.toDecimal(discount, POSCommon.NumberOfDecimals, true) + FConvert.toDecimal(ApplicationNew.TotalSchemesInfo.LinePrompts[i].Amount, POSCommon.NumberOfDecimals, true);

                if (discount > 0 && !PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExcludeSchemeDiscountsMaximumDiscountAllowed && CHECKDISCOUNTAUTHORIZATION.checkDiscountAuthorization(discount) == false) {
                    /*  sbSchemeLog.AppendLine($"{DateTime.Now.ToString("HH: mm: ss")}::CheckDiscountAuthorization() started::Scheme Discount ::{discount}");*/
                    ApplicationNew.TotalSchemesInfo.LinePrompts = ApplicationNew.TotalSchemesInfo.LinePrompts.filter((p) => p.PromoType == PromoTypes.FreeItem);
                    POSSCHEMEIMPLEMENTATIONGENERICS.updatePromptsList(ApplicationNew.TotalSchemesInfo.LinePrompts);
                    let productsToImplementSchemes = null;
                    productsToImplementSchemes = POSSCHEMEIMPLEMENTATIONGENERICS.getProductToImplementSchemes(true, true, true, PreferenceSetting.PrefGeneralTab.SchemesImplementOnDefinedUnit, false, PosProductType.get("NORMAL"), false);
                    for (let ic = 0; ic < productsToImplementSchemes.length; ic++) {
                        discount = 0;
                        if (productsToImplementSchemes[ic].PromoType != PromoTypes.get("FREEITEM")) {
                            for (let mainitemscount = 0; mainitemscount < ApplicationNew.TotalSchemesInfo.LinePrompts.length; mainitemscount++) {
                                if (ApplicationNew.TotalSchemesInfo.LinePrompts[mainitemscount].DefaultValue1 == productsToImplementSchemes[ic].DefaultValue1) {
                                    /*discount += ApplicationNew.TotalSchemesInfo.LinePrompts[mainitemscount].DefaultValue6;*/
                                    discount = discount + FConvert.toDecimal(ApplicationNew.TotalSchemesInfo.LinePrompts[mainitemscount].DynamicLineFields[0].FieldInput, POSCommon.NumberOfDecimals);
                                }
                            }
                            /*productsToImplementSchemes[ic].DefaultValue6 = discount;*/
                            productsToImplementSchemes[ic].DynamicLineFields[0].FieldInput = productsToImplementSchemes[ic].DynamicLineFields[0].FieldValue = discount;
                        }
                    }
                    RETAILMAINSCREENSCHEMESIMPLEMENTATION.UpdateSchemesToProducts(ApplicationNew, productsToImplementSchemes, false, true);
                }
            }

            return index;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainServerToJavaScript.js :: Method :: UPDATEPRODUCT.callImplementSchemesOnItemGridEdit :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
