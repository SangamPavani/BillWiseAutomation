                        objSDD.MaxDiscountAllowedD = FConvert.toDecimal(txtMaxDiscountAllowed);
                    }
                    objSDD.DiscountOn = 0;
                    objSDD.DiscountOnName = "";
                    objSDD.FreeItems = "";
                    objSDD.FreeItemTypeName = "";
