    onSuccessPrintReprintBill: function (bSuccess, data, arrTags) {
        try {
            let msgClientIPAddressIsNotvalid = $("input#msgClientIPAddressIsNotvalid").val();
            let msgErrorOccurredWhileFetchingRecordOfMember = $("input#msgErrorOccurredWhileFetchingRecordOfMember").val();
            let msgClientIPAddress = $("input#msgClientIPAddress").val();
            GLOBAL.LoadingEnd();
            if (bSuccess == false)
                return;

            if (data.bSuccess == false) {
                toastr.error(data.sMessage);
                $("#btnPrintReprintBill").attr('data-clickedRowDetails', "");
                return;
            }

            var parsedReprintModel = arrTags[0], iPrintCount = 1;
            if (parsedReprintModel != null && parsedReprintModel != undefined) {
                if (parsedReprintModel.ScreenOpenForm == 0) {
                    iPrintCount = PreferenceSetting.PrefOutletTab.OutletPrintFormatsTab.SalesCopiesToPrint;
                    if (iPrintCount == null || iPrintCount == undefined || iPrintCount <= 0)
                        iPrintCount = 1;
                }
                else if (parsedReprintModel.ScreenOpenForm == 1) {
                    iPrintCount = PreferenceSetting.PrefOutletTab.OutletPrintFormatsTab.SaleReturnCopiesToPrint;
                    if (iPrintCount == null || iPrintCount == undefined || iPrintCount <= 0)
                        iPrintCount = 1;
                }
            }

            ////debugger;
            if (PreferenceSetting.PrefMiscellaneousTab.POSPrintType == 0) //Direct Printing
                PRINTTOPRINTER.directPrinting([data.printFileName, iPrintCount]);
            else if (PreferenceSetting.PrefMiscellaneousTab.POSPrintType == 1)  //Popup Printing
            {
                for (let i = 0; i < iPrintCount; i++)
                    MESSAGEPOPUP.PRINTMETHODS.loadPrintPopup(i + 1);
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File: retailPopup.js :: Method :: REPRINTBILL.SERVERSUCCESSMETHODS.onSuccessPrintReprintBill :: Catch block :: Exception :: " + Ex.message);
        }
