    validatePostVoucherIfAmountTallied: function (arrParameters) {
        try {
            ////debugger;
            let systemGeneratedAmount = 0, userEnteredAmount = 0;
            let isDayEndSummary = arrParameters[0], parsedModelRecord = arrParameters[1], okClickEvent = arrParameters[2];
            DAYEND.VARIABLE.modelRecord = parsedModelRecord;
            let controlValue = $("#txtCashInDrawer").attr("data-Tag");
            if (controlValue == null || controlValue == undefined || controlValue.length <= 0)
                systemGeneratedAmount = 0;
            else
                systemGeneratedAmount = FConvert.toDecimal(controlValue, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == false && PreferenceSetting.PrefMiscellaneousOtherTab.MaintnCashDen == false) {
                controlValue = $("#txtCashInDrawer").val();
                if (controlValue == null || controlValue == undefined || controlValue.length <= 0)
                    userEnteredAmount = 0;
                else
                    userEnteredAmount = FConvert.toDecimal(controlValue, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
            }
            else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == false && PreferenceSetting.PrefMiscellaneousOtherTab.MaintnCashDen == true) {
                let dayEndModel = $("#divDayEndMain").attr("data-ModelRecord");
                if (dayEndModel == null || dayEndModel == undefined || dayEndModel.length <= 0)
                    return;

                dayEndModel = JSON.parse(dayEndModel);
                let totalDenominationValue = 0;
                if (dayEndModel.DayInPos != null && dayEndModel.DayInPos != undefined && dayEndModel.DayInPos.CurrencyDetails != null && dayEndModel.DayInPos.CurrencyDetails != undefined
                    && dayEndModel.DayInPos.CurrencyDetails[0].DenominationList != null && dayEndModel.DayInPos.CurrencyDetails[0].DenominationList != undefined
                    && dayEndModel.DayInPos.CurrencyDetails[0].DenominationList.length > 0) {

                    for (let i = 0; i < dayEndModel.DayInPos.CurrencyDetails[0].DenominationList.length; i++)
                        totalDenominationValue = FConvert.toDecimal(totalDenominationValue, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal(dayEndModel.DayInPos.CurrencyDetails[0].DenominationList[i].Total, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                }
                userEnteredAmount = totalDenominationValue;

            }
            else if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == true) {
                if (parsedModelRecord != null && parsedModelRecord != undefined && parsedModelRecord.EODPos != null && parsedModelRecord.EODPos != undefined && parsedModelRecord.EODPos.CurrencyDetails != null && parsedModelRecord.EODPos.CurrencyDetails != undefined && parsedModelRecord.EODPos.CurrencyDetails.length > 0) {
                    for (let k = 0; k < parsedModelRecord.EODPos.CurrencyDetails.length; k++)
                        userEnteredAmount = FConvert.toDecimal(userEnteredAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal(parsedModelRecord.EODPos.CurrencyDetails[k].ReportedAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                }
            }
            userEnteredAmount = FConvert.toDecimal(userEnteredAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
            if (systemGeneratedAmount != userEnteredAmount) {
                var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                messageInfoPopup.Caption = "Confirmation Dialog";
                messageInfoPopup.Message = [];
                messageInfoPopup.ButtonType = "Ok";
                messageInfoPopup.OkMethod = okClickEvent;
                var arrValue = [];
                arrValue.push(messageInfoPopup);
                arrValue.push("divMessageInfo");

                if (isDayEndSummary == false) {
                    messageInfoPopup.Message[0] = "Cash In Drawer amount is not matching.";
                    messageInfoPopup.Message[1] = "System Reported Cash In Drawer Amount :: " + systemGeneratedAmount + " & User Reported Cash In Drawer Amount :: " + userEnteredAmount;
                }
                else {
                    messageInfoPopup.Message[0] = "Cash In Drawer amount is not matching. You can see Summary screen but you can not able to post the Day End.";
                    messageInfoPopup.Message[1] = "System Reported Cash In Drawer Amount :: " + systemGeneratedAmount + " & User Reported Cash In Drawer Amount :: " + userEnteredAmount;
                }

                DAYEND.VARIABLE.IsPostRequired = false;
                COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                return false;
            }
            DAYEND.VARIABLE.IsPostRequired = true;
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: DAYEND.validatePostVoucherIfAmountTallied :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
