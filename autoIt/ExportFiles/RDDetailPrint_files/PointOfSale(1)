                    let ColumnRoundOff = FConvert.toDecimal(cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue);
                    if (ColumnRoundOff > 0) {
                        // cProduct.DynamicLineFields[retailBodyField.ColumnIndex].FieldValue = Convert.ToDouble(ColumnRoundOff.RoundOff(Convert.ToDecimal(PosCommon.LocalCurrency.GeneralRoundOff), Convert.ToInt32(PosCommon.LocalCurrency.RoundOffType)));
