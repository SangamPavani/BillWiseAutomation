            document.getElementById(buttonName).style.backgroundColor = "#FFFFFF";
            document.getElementById(buttonName).style.color = "#50CEE4";
            document.getElementById(buttonName).style.border = "1px solid #D2D2D2";
            //debugger;
            $("#btnLineWiseFields").removeClass('btnPanelFields');
            $("#btnLineWiseFields").addClass('btnFields');
            // Get theelement with id="defaultOpen" and click on it

            switch (buttonName) {
                case "btnLineWiseFields":
                    $("#btnBodyPanelCustomizationSave").show();
                    $("#btnBodyPanelCustomizationDelete").show();
                    $("#btnBodyPanelCustomizationSave").attr("data-Tag", buttonName);
                    $("#btnLineWiseFields").addClass('active');
                    $("#btnFooterInputs").removeClass('active');
                    $("#btnDefaultHeaderFields").removeClass('active');
                    $("#btnHeaderExtraFields").removeClass('active');
                    $("#btnLineWiseFields").css('cursor', 'pointer');
                    break;
