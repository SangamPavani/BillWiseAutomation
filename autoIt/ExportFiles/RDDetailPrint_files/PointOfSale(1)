                if (PreferenceSetting.PrefGeneralTab.ImplementSchemeUnitWise == true) {
                    if (productIds != null && productIds != undefined && productIds.length > 0) {
                        var zipProductIds = LZString.compressToUTF16(FConvert.toString(productIds));
                        let unitIds = [];
                        NETWORK.executeServerMethod(GLOBAL.getContextPath("GetUnitIdBasedOnProductId", "RetailMainScreen", "PointOfSale"),
