                        }
                    }
                }

                ///Added this condition by Naveen on 08/08/2013 : In some cases itemsMatchedInBill is coming as null or 
                ///count is coming as zero that is the reason this condition is added.
                if (itemsMatchedInBill != null && itemsMatchedInBill != undefined && itemsMatchedInBill.length > 0) {
                    if (LowestPriceItemId == 0) {
                        if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.PosModule == ModuleType.get("RETAIL")) {
                            if (MatchedBody != null && MatchedBody != undefined && MatchedBody.length > 0)
                                _LowestPriceItem = MatchedBody.Aggregate((agg, next) => next.Price < agg.Price ? next : agg); //**Aggregate
                        }
                        else {
                            do {
                                _LowestPriceItem = MatchedBody.Aggregate((agg, next) => next.Price < agg.Price ? next : agg);// **Aggregate
                                if (_LowestPriceItem != null && m_SchemesPromptMsgs.length > 0) {
                                    let dLineListQty = LineList.filter((p) => p.DefaultValue1 == _LowestPriceItem.ProductID) //.Sum(p => p.DefaultValue3);
                                    if (dLineListQty != null && dLineListQty != undefined && dLineListQty.length > 0)
                                        for (let i = 0; i < dLineListQty.length; i++)
                                            dLineListQty = FConvert.toDecimal(dLineListQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(dLineListQty[i].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                                    let dCalPromptsQty = m_SchemesPromptMsgs.Where(p => p.ProductId == _LowestPriceItem.ProductID) //.Sum(p => p.FreeQtyPresent);
                                    if (dCalPromptsQty != null && dCalPromptsQty != undefined && dCalPromptsQty.length > 0)
                                        for (let j = 0; j < dCalPromptsQty.length; j++)
                                            dCalPromptsQty = FConvert.toDecimal(dCalPromptsQty, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(dCalPromptsQty[j].FreeQtyPresent, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                                    if (dLineListQty - dCalPromptsQty <= 0)
                                        MatchedBody = MatchedBody.filter((p) => p.ProductID != _LowestPriceItem.ProductID);
                                    else
                                        break;
                                }
                                else
                                    break;
                            } while (MatchedBody.length > 0);
                        }
                    }
                    else {
                        _LowestPriceItem = MatchedBody.filter((f) => f.ProductID == LowestPriceItemId);
                        _LowestPriceItem = _LowestPriceItem[0];
                    }
                }
            }
            if (_LowestPriceItem == null || _LowestPriceItem.ProductID == 0) {
                //let _Price = ItemsList.sort((a, b) => a.Price - b.Price); //Min(f => f.Price);
                //_LowestPriceItem = ItemsList.filter((f) => f.Price == _Price[0].Price);
                //let _Price = 100;// ItemsList.min(f => f.Price);
                let arryPrice = [];
                for (let i = 0; i < ItemsList.length; i++)
                    arryPrice.push(FConvert.toDecimal(ItemsList[i].Price, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true));

                let _Price = Math.min(...arryPrice); //ItemsList.Min(f => f.Price);
                _LowestPriceItem = ItemsList.filter((f) => f.Price == _Price);
                _LowestPriceItem = _LowestPriceItem[0];
            }
            return _LowestPriceItem;
        }
