                                        /*let ProportionateValue = (FConvert.toDecimal(SchemesImplementedProds[ic].DefaultValue6, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(Products[j].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(gross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);*/
                                        let ProportionateValue = (FConvert.toDecimal(SchemesImplementedProds[ic].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(Products[j].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true)) / FConvert.toDecimal(gross, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                                        if (ProportionateValue >= 0) {
                                            /*Products[j].DynamicLineFields[0].FieldInput = Products[j].DefaultValue6 = ProportionateValue;*/
                                            Products[j].DynamicLineFields[0].FieldInput = Products[j].DynamicLineFields[0].FieldValue = ProportionateValue;
