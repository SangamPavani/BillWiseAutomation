    assignRMAToLine: function (RMAItem, presentTransactionMode) {
        try {
            if (POSCommon.isRMASupport == false || RMAItem.DonotMaintainStockbyRMA == true || presentTransactionMode == TransactionModes.get("NEWPREORDER") || presentTransactionMode == TransactionModes.get("EDITPREORDER")
                || (POSCommon.posTemplate != null && POSCommon.posTemplate != undefined && POSCommon.posTemplate.IsEstimatedBill == true))
                return [true, ""];
            else {
                if (RMAItem.RetailSetsDetails != null && RMAItem.RetailSetsDetails != undefined && RMAItem.RetailSetsDetails.length > 0) {
                    for (let i = 0; i < RMAItem.RetailSetsDetails.length; i++) {
                        if (POSCommon.isRMASupport == false || RMAItem.RetailSetsDetails[i].DonotMaintainStockbyRMA == true || presentTransactionMode == TransactionModes.get("NEWPREORDER") || presentTransactionMode == TransactionModes.get("EDITPREORDER")) {
                            if (RMAItem.RetailSetsDetails.length - 1 == i)
                                return [true, ""];

                            continue;
                        }
                        else if (RMAItem.RetailSetsDetails[i].DonotMaintainStockbyRMA == false) {
                            PRODUCTMETHODNEW.RMAPOPUPMETHODS.VARIABLES.currentIndex = i - 1;
                            return [false, "RMAPOPUP"];
                        }
                    }
                }
                return [false, "RMAPOPUP"];
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMainAddProduct.js, Method: PRODUCTMETHODNEW.RMAPOPUPMETHODS.assignRMAToLine, Catch block : Error Message : " + Ex.message);
