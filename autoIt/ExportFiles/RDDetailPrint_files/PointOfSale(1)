                MEMBERPOINTSDEFINITION.PRIVATEVARIABLE.selectedCounters.push(selectedOutlets[i]);

            var outletId = "";
            var outletName = "";
            for (let i = 0; i < MEMBERPOINTSDEFINITION.PRIVATEVARIABLE.selectedCounters.length; i++) {
                outletId += MEMBERPOINTSDEFINITION.PRIVATEVARIABLE.selectedCounters[i].id + ",";
                outletName += MEMBERPOINTSDEFINITION.PRIVATEVARIABLE.selectedCounters[i].text + ",";
            }

            if (outletId.length > 0 && outletName.length > 0) {
                outletId = outletId.substring(0, outletId.length - 1);
                outletName = outletName.substring(0, outletName.length - 1);
