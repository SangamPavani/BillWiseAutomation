                                    /*Products[0].DynamicLineFields[0].FieldInput = Products[0].DynamicLineFields[0].FieldValue = Products[0].DefaultValue6 = SchemesImplementedProds[ic].DynamicLineFields[0].FieldInput;*/
                                    Products[0].DynamicLineFields[0].FieldInput = Products[0].DynamicLineFields[0].FieldValue = SchemesImplementedProds[ic].DynamicLineFields[0].FieldInput;
                                }
                                else {
                                    Products[0].DefaultValue4 = SchemesImplementedProds[ic].DefaultValue4;
                                    let ProportionateValue = FConvert.toDecimal(SchemesImplementedProds[ic].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) / FConvert.toDecimal(Products[0].DefaultValue3, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
