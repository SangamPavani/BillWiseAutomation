    getEPaymentPayClickEvent: function () {
        try {
            var ePaymentAmount = FConvert.toDecimal($("#txtEPaymentAmount").val());
            var ePaymentTransactionId = $("#txtEPaymentTransactionId").val();
            var msgInfoBalAmtZero = $("#msgInfoBalAmtZero").val();
            var msgPleaseSelectEPaymentType = $("#msgPleaseSelectEPaymentType").val();
            var msgCannotUseMoreThan10EPaymentTypesInATransaction = $("#msgCannotUseMoreThan10EPaymentTypesInATransaction").val();
            var msgBSAlreadySel = $("#msgBSAlreadySel").val();
            var msgBSEPaymentExtraNotAllowed = $("#msgBSEPaymentExtraNotAllowed").val();
            var msgBSEPaymentTransIdMand = $("#msgBSEPaymentTransIdMand").val();

            if (FConvert.toDecimal(BillSettlement.BalanceAmount) <= 0) {
                toastr.error(msgInfoBalAmtZero);
                return;
            }
            else if (BillSettlement.SelectedEPayment == null || BillSettlement.SelectedEPayment == undefined && BillSettlement.SelectedEPayment.Id == 0) {
                toastr.error(msgPleaseSelectEPaymentType);
                return;
            }
            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != null
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length > 0) {
                if (BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length > 10) {
                    toastr.error(msgCannotUseMoreThan10EPaymentTypesInATransaction);
                    return;
                }
            }
            if (BillSettlement.BillSettlementPaymentDetails != null && BillSettlement.BillSettlementPaymentDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != null
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet != undefined
                && BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length > 0) {
                for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.EPaymentDet.length; i++) {
                    if (BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].EPaymentId == BillSettlement.SelectedEPayment.ID) {
                        toastr.error(BillSettlement.BillSettlementPaymentDetails.EPaymentDet[i].CardTypeName + msgBSAlreadySel);// " already selected");
                        return;
                    }
                }
            }
            else if (BillSettlement.BalanceAmount < ePaymentAmount) {
                toastr.error(msgBSEPaymentExtraNotAllowed);
                return;
            }

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.ApprovalCodeForEPayment == true && (ePaymentTransactionId <= 0 || ePaymentTransactionId == null || ePaymentTransactionId == "" || ePaymentTransactionId == undefined)) {
                toastr.error(msgBSEPaymentTransIdMand);
                $("#txtEPaymentTransactionId").focus();
                return;
            }
            if (FConvert.toDecimal($.trim(ePaymentAmount)) <= 0) {
                // alert("Amount should be greater than zero");
                $("#txtEPaymentAmount").focus();
                return false;
            }

            BILLSETTLEMENT.SERVERMETHOD.checkEPaymentTransIdExists($("#txtEPaymentTransactionId").val());
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.getEPaymentPayClickEvent, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
