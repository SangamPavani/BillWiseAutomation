                VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.SchemesAppliedList = ApplicationNew.TotalSchemesInfo.LinePrompts;

            let schemesApplied = new Object();
            schemesApplied.CreatedBy = POSCommon.userId;
            schemesApplied.ModifiedBy = POSCommon.userId;
            schemesApplied.LocationId = POSCommon.locationId;
            schemesApplied.EditingLocation = POSCommon.locationId;

            switch (ApplicationNew.PresentTransactionMode) {
                case TransactionModes.get("NEWPOSSALES"):
                case TransactionModes.get("EDITPOSSALES"):
                    schemesApplied.PresentTransMode = TransactionModes.get("NEWPOSSALES");
                    break;
                case TransactionModes.get("HOMEDELIVERY"):
                case TransactionModes.get("HOMEDELIVERYFEEDBACK"):
                    schemesApplied.PresentTransMode = TransactionModes.get("HOMEDELIVERY");
                    break;
                case TransactionModes.get("SPLITBILLSALES"):
                    break;
                case TransactionModes.get("NEWPREORDER"):
                case TransactionModes.get("VIEWPREORDER"):
                case TransactionModes.get("EDITPREORDER"):
                case TransactionModes.get("PREORDERCOLLECTION"):
                    schemesApplied.PresentTransMode = TransactionModes.get("NEWPREORDER");
                    break;
            }

            schemesApplied.TranSchemesPrompts = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.SchemesAppliedList;
            schemesApplied.DbOperation = DbOperationMode.Save;
            return schemesApplied;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.getTransSchemesApplied :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return null;
        }
