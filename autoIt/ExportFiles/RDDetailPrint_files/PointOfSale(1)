        SavePaymentData: function () {
            try {

                MESSAGEPOPUPSFORSCHEMES.closeSchemesDefinitionPopup();
                var optPaymentDiscountScheme = OPTIONCONTROL.getControlDataObject("optPaymentSchemeName");
                var PymntSchemeId = optPaymentDiscountScheme.iId;
                var dtpFromDate = DATEPICKER.getDate(dtpFromDatePymnt);
                var dtpToDate = DATEPICKER.getDate(dtpToDatePymnt);
                var objSchemesDiscountDef = new Object();
                objSchemesDiscountDef.Name = optPaymentSchemeName.value;
                objSchemesDiscountDef.DiscTypeID = 1;
                objSchemesDiscountDef.SchemeTypeID = $("#ddlSchemeTypePymnt").val(); // Re-Check
                objSchemesDiscountDef.Outlets = SCHEMESOUTLETS.VARIABLE.OutletId;
                var tbodyPaymentList = [];
                if ($("#tbodyPaymentDiscount tr").length > 0) {
                    var paymentRows = $("#tbodyPaymentDiscount tr");

                    for (let i = 0; i < paymentRows.length; i++) {
                        if ($(paymentRows[i]).attr('data-paymentSchemeDiscountDetails') != null && $(paymentRows[i]).attr('data-paymentSchemeDiscountDetails') != undefined) {
                            var parsedPaymentRow = JSON.parse($(paymentRows[i]).attr('data-paymentSchemeDiscountDetails'));
                            if (parsedPaymentRow.ProductIds != null && parsedPaymentRow.ProductIds != undefined && parsedPaymentRow.ProductIds != "" && parsedPaymentRow.ProductIds.length > 0)
                                parsedPaymentRow.ProductIds = parsedPaymentRow.ProductIds;
                            else
                                parsedPaymentRow.ProductIds = "";
                            tbodyPaymentList.push(parsedPaymentRow);
                        }
                    }
                }
                objSchemesDiscountDef.Payments = tbodyPaymentList;
                objSchemesDiscountDef.TreeID = 0; // Re-Check after Tree is done
                objSchemesDiscountDef.MndtryItemsFlag = 1; // Re-Check after Tree is done

                // Days
                var SchemesDays = "";
                for (var i = 0; i < SCHEMESDISCOUNT.PAYMENTDISCOUNT.VARIABLE.lstPaymentWeekDays.length; i++)
                    SchemesDays += SCHEMESDISCOUNT.PAYMENTDISCOUNT.VARIABLE.lstPaymentWeekDays[i].ID + ",";

                if (SchemesDays.length > 0) {
                    SchemesDays = SchemesDays.substring(0, SchemesDays.length - 1);
                    objSchemesDiscountDef.SchemesDays = SchemesDays;
                }
                else
                    objSchemesDiscountDef.SchemesDays = "";

                // Scheme For
                objSchemesDiscountDef.PreOrderScheme = false;
                objSchemesDiscountDef.Inactive = false;
                var selOptionList = LISTCHECKBOXCONTROL.getControlData("ddlSchemeForPymnt");
                for (var i = 0; i < selOptionList.length; i++) {
                    if (selOptionList[i].ID == 1)
                        objSchemesDiscountDef.PreOrderScheme = true;
                    if (selOptionList[i].ID == 2)
                        objSchemesDiscountDef.Inactive = true;
                }

                objSchemesDiscountDef.FromDateInt = dtpFromDate;
                objSchemesDiscountDef.ToDateInt = dtpToDate;
                objSchemesDiscountDef.FromTimeInt = FTIMECONTROL.getTime("tpFromTimePymnt");
                objSchemesDiscountDef.ToTimeInt = FTIMECONTROL.getTime("tpToTimePymnt");

                //objSchemesDiscountDef.PreOrderScheme = $("#chkPaymentSchemePreOrderScheme").is(":checked");
                //objSchemesDiscountDef.Inactive = $("#chkPaymentSchemeInactive").is(":checked");

                if (PymntSchemeId != null && PymntSchemeId != undefined && PymntSchemeId > 0)//if (optPymntSchemeName.Tag == null)
                {
                    objSchemesDiscountDef.ID = PymntSchemeId;
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("UpdatePaymentSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", true, "SCHEMESDISCOUNT.PAYMENTONSUCCESSSERVERMETHODS.onSuccessUpdatePaymentData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
                else {
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("SavePaymentSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", true, "SCHEMESDISCOUNT.PAYMENTONSUCCESSSERVERMETHODS.onSuccessSavePaymentData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESDISCOUNT.PAYMENTDISCOUNT.SavePaymentData :: Catch block :: Exception :: " + Ex.message);
            }
        },
