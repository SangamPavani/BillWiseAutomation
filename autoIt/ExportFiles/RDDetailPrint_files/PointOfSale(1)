                BILLSETTLEMENT.SCHEMESMETHODS.revertSchemesApplied(selectedPrompts);
            }

            for (let i = 0; i < BillSettlement.BillSettlementPaymentDetails.CreditCardDet.length; i++) {
                if (BillSettlement.BillSettlementPaymentDetails.CreditCardDet[i].CardTypeId == BILLSETTLEMENT.VARIABLE.selectedCreditCard.CardTypeId) {

                    const counterRelatedSettings = PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords.filter(p => p.CounterId == POSCommon.counterId);
                    if (counterRelatedSettings == null || counterRelatedSettings == undefined || counterRelatedSettings.length <= 0) {
