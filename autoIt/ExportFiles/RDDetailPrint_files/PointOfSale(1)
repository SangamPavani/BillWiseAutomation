    setPreviousColumn: function (table, iRow, iColumn) {
        try {
            //////debugger;
            iColumn = FConvert.toInt(iColumn);
            --iColumn;
            if (FConvert.toInt(iColumn) <= 0) {
                if ((FConvert.toInt(iRow) - 1) < 0)
                    iColumn = 1;
                else
                    iColumn = 6;

                $(table).attr("data-Column", iColumn);
                iRow = FConvert.toInt(iRow);
                --iRow;
                if (iRow < 0)
                    iRow = 0;
                $(table).attr("data-Row", iRow);
            }
            else {
                $(table).attr("data-Column", iColumn);
