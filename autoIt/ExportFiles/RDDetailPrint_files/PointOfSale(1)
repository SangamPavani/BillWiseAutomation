    loadProductUsingNavigation: function (navigationButtonType, schemeId) {
        try {
            debugger;
            let posSchemesCurrentIndexRecord = null;
            if (POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.FreeItemSchemesRateIndex != null && POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.FreeItemSchemesRateIndex != undefined
                && POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.FreeItemSchemesRateIndex.length > 0) {
                posSchemesCurrentIndexRecord = POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.FreeItemSchemesRateIndex.filter((p) => p.POSSchemeId == schemeId);
                if (posSchemesCurrentIndexRecord != null && posSchemesCurrentIndexRecord != undefined && posSchemesCurrentIndexRecord.length > 0)
                    posSchemesCurrentIndexRecord = posSchemesCurrentIndexRecord[0];
            }

            let currentSchemesRecord = [], productDetailCount = 0;
            switch (navigationButtonType) {
                case NavigationButtonType.FIRST:
                    posSchemesCurrentIndexRecord.CurrentIndex = 1;
                    /*Previous & First button must be disabled*/

                    $("#btnAnyItemPrevious_" + schemeId).removeClass("nextPreviousActive");
                    $("#btnAnyItemPrevious_" + schemeId).addClass("nextPrevious");
                    $("#btnAnyItemFirst_" + schemeId).removeClass("nextPreviousActive");
                    $("#btnAnyItemFirst_" + schemeId).addClass("nextPrevious");
                    $("#btnAnyItemNext_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemNext_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemLast_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemLast_" + schemeId).addClass("nextPreviousActive");

                    break;
                case NavigationButtonType.PREVIOUS:
                    posSchemesCurrentIndexRecord.CurrentIndex = posSchemesCurrentIndexRecord.CurrentIndex - POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.RecordPerPage;
                    if (posSchemesCurrentIndexRecord.CurrentIndex <= 0)
                        posSchemesCurrentIndexRecord.CurrentIndex = 1;

                    $("#btnAnyItemFirst_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemFirst_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemPrevious_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemPrevious_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemNext_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemNext_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemLast_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemLast_" + schemeId).addClass("nextPreviousActive");

                    break;
                case NavigationButtonType.NEXT:
                    posSchemesCurrentIndexRecord.CurrentIndex = posSchemesCurrentIndexRecord.CurrentIndex + POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.RecordPerPage;
                    $("#btnAnyItemFirst_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemFirst_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemPrevious_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemPrevious_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemNext_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemNext_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemLast_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemLast_" + schemeId).addClass("nextPreviousActive");

                    break;
                case NavigationButtonType.LAST:
                    currentSchemesRecord = ApplicationNew.TotalSchemesInfo.PromptsToShow.filter((p) => p.SchemeId == schemeId);
                    if (currentSchemesRecord != null && currentSchemesRecord != undefined && currentSchemesRecord.length > 0)
                        productDetailCount = currentSchemesRecord.length;

                    posSchemesCurrentIndexRecord.CurrentIndex = POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.RecordPerPage * (parseInt(productDetailCount / POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.RecordPerPage));
                    if (posSchemesCurrentIndexRecord.CurrentIndex == productDetailCount)
                        posSchemesCurrentIndexRecord.CurrentIndex = posSchemesCurrentIndexRecord.CurrentIndex - POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.VARIABLES.RecordPerPage;

                    /*Next & Last button must be disabled*/
                    $("#btnAnyItemFirst_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemFirst_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemPrevious_" + schemeId).removeClass("nextPrevious");
                    $("#btnAnyItemPrevious_" + schemeId).addClass("nextPreviousActive");
                    $("#btnAnyItemNext_" + schemeId).removeClass("nextPreviousActive");
                    $("#btnAnyItemNext_" + schemeId).addClass("nextPrevious");
                    $("#btnAnyItemLast_" + schemeId).removeClass("nextPreviousActive");
                    $("#btnAnyItemLast_" + schemeId).addClass("nextPrevious");
                    break;
            }

            let arrPromptToShowReturn = [], arrPromptToShow = [];
            POSPROCESSING.ProcessStart();
            arrPromptToShow = POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.getPromptsListUsingIndex([posSchemesCurrentIndexRecord.CurrentIndex, schemeId, navigationButtonType]);
            POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.getPromptMappedObject(arrPromptToShow, arrPromptToShowReturn);
            let arrRates = POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.loadProductRate(arrPromptToShowReturn[0]);
            if (arrRates != null && arrRates != undefined && arrRates.length > 0) {
                if (arrPromptToShowReturn[0].PromptDetails != null && arrPromptToShowReturn[0].PromptDetails != undefined && arrPromptToShowReturn[0].PromptDetails.length > 0) {
                    for (let i = 0; i < arrPromptToShowReturn[0].PromptDetails.length; i++)
                        arrPromptToShowReturn[0].PromptDetails[i].Rate = arrRates[i];
                }
            }

            POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.addPromptInTableBody(arrPromptToShowReturn, true);
            POSPROCESSING.ProcessEnd();
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: posSchemeImplementationGenerics.js :: JavaScript Function :: POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.loadProductUsingNavigation :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
