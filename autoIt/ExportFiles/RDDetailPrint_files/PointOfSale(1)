                            price = POSSCHEMEIMPLEMENTATIONGENERICS.CALCULATION.getProductRate(mandatoryItem);
                        }
                    }
                }

                //double actualGross = qtyInBaseUnits * price;
                let actualGross = FConvert.toDecimal(maxQtyToConsider, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) * FConvert.toDecimal(price, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
