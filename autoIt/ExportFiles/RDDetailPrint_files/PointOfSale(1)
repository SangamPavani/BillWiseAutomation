                && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != undefined) {
                localPreOrderDetails.OrderNumber = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.Header.DocNo;
