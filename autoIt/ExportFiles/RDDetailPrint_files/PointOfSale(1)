                            }
                        }
                    }
                }
                else if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 2) //Search On Group
                {
                    //
                    var productSearchItem = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " div#divPageRecord_" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " input#inputProductSearchGroup");
                    if (productSearchItem != null && productSearchItem != undefined && productSearchItem.length > 0) {
                        var selectedProductId = $(productSearchItem).attr("data-ProductSearch");
                        if (selectedProductId != null && selectedProductId != undefined)
                            selectedProductId = JSON.parse(selectedProductId);

                        for (var i = 0; i < selectedProductId.length; i++) {
                            var jsonString = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " div#divProductTree").jstree().get_json(selectedProductId[i]);
                            var nodeString = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " div#divProductTree").jstree().get_node(selectedProductId[i]);
                            foundSelectedNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(selectedProductId[i]);
                            if (foundSelectedNode != null && foundSelectedNode != undefined) {
                                if (foundSelectedNode != true && foundSelectedNode != false) {
                                    var jsonobject = new Object();
                                    jsonobject.id = jsonString.id;
                                    jsonobject.text = jsonString.text;
                                    jsonobject.icon = jsonString.icon;
                                    jsonobject.state = jsonString.state;
                                    jsonobject.Tag = nodeString.original.Tag;
                                    jsonobject.children = [];

                                    for (let j = 0; j < jsonString.children.length; j++) {
                                        var childJson = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " div#divProductTree").jstree().get_json(jsonString.children[j]);
                                        var childNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.parentControlName + " div#divProductTree").jstree().get_node(jsonString.children[j]);

                                        var childJsonString = new Object();
                                        childJsonString.id = childJson.id;
                                        childJsonString.text = childJson.text;
                                        childJsonString.icon = childJson.icon;
                                        childJsonString.state = childJson.state;
                                        childJsonString.Tag = childNode.original.Tag;
                                        jsonobject.children.push(childJsonString);
                                    }

                                    $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().delete_node(foundSelectedNode);
                                    $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().create_node("#", jsonobject, foundSelectedNode.original.position);
                                }
                            }
                        }
                    }
                }

                var controlName = $(data.instance.element).attr('data-ControlName');
                if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 1)//Search On - Item
                    $("#" + controlName + " div#divProductSearchTree ul li a i.false").css("display", "none");
                else if (FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.searchOn == 2) //Search On - Group
                    $("#" + controlName + " #divProductSearchTree ul li a i.jstree-themeicon").attr('onclick', 'FPRODUCTCONTROL.PRODUCTSEARCH.getChildren(this)');
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainControl.js :: Method :: FPRODUCTCONTROL.PRODUCTSEARCH.loadedTreeEvent :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            }
