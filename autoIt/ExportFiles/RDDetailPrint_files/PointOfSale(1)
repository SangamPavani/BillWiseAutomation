                                tagValue.ID = 1106;
                                tagValue.Tag = iMemberId;
                                tags.push(tagValue);
                            }
                            else {
                                tagValue = new Object();
                                tagValue.ID = 1106;
                                tagValue.Tag = PreferenceSetting.PrefMiscellaneousTab.DefaultMember;
                                tags.push(tagValue);
