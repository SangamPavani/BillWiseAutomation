            RETAILMAIN.VARIABLE.TableHeaderRMARequiredRemove = false;
            /*RETAILMAIN.VARIABLE.TableHeaderRMAIndex = -1;*/
            RETAILMAIN.VARIABLE.LeftPanelTableHeader = $("#tblSelectedProduct > #tHeadSelectedProduct").html();

            if (RETAILMAIN.VARIABLE.EnableHorizentalScrollBar == false) {
                RETAILMAIN.resetTableHeaderWidth();
                RETAILMAIN.resetTableFooterWidth();
            }
        }
