    onShortcutClicked: function (divClickedShortcut, iModuleFunctionId) {
        try {
            debugger;
            let msgYouDoNotHaveAccess = $("#msgYouDoNotHaveAccess").val();
            let msgScreeniscurrentlynotavailable = $("#msgScreeniscurrentlynotavailable").val();
            let msgConfirmationDialog = $("#msgConfirmationDialog").val();
            let msgdoyouwanttoclearthecurrenttransactionandopencreditsaleadjustment = $("#msgdoyouwanttoclearthecurrenttransactionandopencreditsaleadjustment").val();
            localStorage.setItem("iNextShortcutId", -1);
            localStorage.setItem("iShortcutId", 0);
            ALTERNATIVERELATIVEPRODUCT.VARIABLES.IsProductClicked = false;
            RETAILMAIN.VARIABLE.ShortcutId = iModuleFunctionId;
            RETAILMAIN.VARIABLE.divClickedShortcut = divClickedShortcut;
            var bAvailable = COMMONMETHODS.isShortcutAvailable(iModuleFunctionId);
            if (bAvailable == false) {
                toastr.error(msgScreeniscurrentlynotavailable);
                return;
            }

            if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync != null && RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync != undefined && RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayInRequired == true) {
                if (iModuleFunctionId == 40 || iModuleFunctionId == 41 || iModuleFunctionId == 42)
                    RETAILMAIN.setPOSSecondRowHeight(14);
            }

            RETAILMAIN.showRightPanelOnShortcutClicked();
            if (iModuleFunctionId == 92) {          //Creditsaleadjustment
                if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                    var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                    messageInfoPopup.Caption = msgConfirmationDialog;
                    messageInfoPopup.Message = [];
                    messageInfoPopup.Message[0] = msgdoyouwanttoclearthecurrenttransactionandopencreditsaleadjustment;
                    messageInfoPopup.ButtonType = "YesNo";
                    messageInfoPopup.YesMethod = `CREDITSALE.openCreditSaleAdjustmentPopup(${iModuleFunctionId})`;
                    messageInfoPopup.NoMethod = "CREDITSALE.closePopup()";
                    var arrValue = [];
                    arrValue.push(messageInfoPopup);
                    arrValue.push("divMessageInfo");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return;
                }
            }
            if (iModuleFunctionId != 47) {
                if (RETAILMAIN.VARIABLE.IsDayEndOpened == true) {
                    let msgPointOfSaleConfirmation = $("#msgPointOfSaleConfirmation").val();
                    let msgnewAreYouSureToCloseThe = $("#msgnewAreYouSureToCloseThe").val();
                    var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                    if (msgPointOfSaleConfirmation != null && msgPointOfSaleConfirmation != undefined)
                        messageInfoPopup.Caption = msgPointOfSaleConfirmation;// "Point Of Sale Confirmation";

                    messageInfoPopup.Message = [];
                    if (msgnewAreYouSureToCloseThe != null && msgnewAreYouSureToCloseThe != undefined)
                        messageInfoPopup.Message[0] = msgnewAreYouSureToCloseThe + " EOD?";// "Are you sure to Close?";

                    messageInfoPopup.ButtonType = "YesNo";
                    messageInfoPopup.YesMethod = "RETAILMAIN.SHORTCUT.confirmToOpenShortcut()";
                    messageInfoPopup.NoMethod = "RETAILMAIN.SHORTCUT.closeEODValidationPopup()";
                    var arrValue = [];
                    arrValue.push(messageInfoPopup);
                    arrValue.push("divForModalMain");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return;
                }
            }
            let validatePOSPreference = RETAILMAIN.validatePOSPreference(iModuleFunctionId);
            if (validatePOSPreference != null && validatePOSPreference != undefined && validatePOSPreference.length > 0) {
                if (validatePOSPreference[0] == false) {
                    toastr.error(validatePOSPreference[1]);
                    return;
                }
                if (validatePOSPreference[0] == true && validatePOSPreference[1] == false)
                    return;
            }

            var iScreenPermissionId = COMMONMETHODS.VALIDATIONMETHODS.getScreenPermissionId(iModuleFunctionId);
            if (iScreenPermissionId > 0) {
                var bGrantAccess = COMMONMETHODS.VALIDATIONMETHODS.checkScreenPermission(iScreenPermissionId);
                if (bGrantAccess == false) {
                    toastr.info(msgYouDoNotHaveAccess, "POS Information");
                    COMMONMETHODS.eraseShortcutData();
                    return;
                }
            }
            else if (iScreenPermissionId == 0) {
                //For Shortcuts whose ScreenPermission is not mentioned(Copy To All, Proportionate To All,etc..)
            }
            else {
                toastr.info(msgYouDoNotHaveAccess, "POS Information");
                COMMONMETHODS.eraseShortcutData();
                return;
            }
            ////Getting right panel html string
            //if (RETAILMAIN.VARIABLE.rightPanelHTML == null || RETAILMAIN.VARIABLE.rightPanelHTML == undefined)
            //    RETAILMAIN.VARIABLE.rightPanelHTML = document.createElement("div");

            //RETAILMAIN.VARIABLE.rightPanelHTML.innerHTML = null;
            //COMMONMETHODS.getRightPanel();

            if (iModuleFunctionId > 1000 && iModuleFunctionId < 2999) {
                BATCHPRINTING.verifyBatchPrinting(divClickedShortcut, (iModuleFunctionId - 1000));
                return;
            }
            else if (iModuleFunctionId > 3000) {
                //This will work only on client side
                if (POSEXTERNALMODULE.getExternalModuleExistWithEventType(PosExternalOnEvent.AsShortcutButtonOnMainScreen) == true) {
                    POSEXTERNALMODULE.VARIABLES.ExternalModuleEventType = PosExternalOnEvent.AsShortcutButtonOnMainScreen;
                    POSEXTERNALMODULE.VARIABLES.ExternalModuleRequestParams = [];
                    POSEXTERNALMODULE.VARIABLES.ExternalModuleRequestParams.push(POSCommon.companyId);
                    POSEXTERNALMODULE.VARIABLES.ExternalModuleRequestParams.push(POSCommon.companyCode);
                   const isFlowContinue = POSEXTERNALMODULE.callExternalModule(POSEXTERNALMODULE.VARIABLES.ExternalModuleEventType);
                    if (isFlowContinue == false)
                        return;
                }
            }
            //Manager Approval OR User Verification Required Or Not
            var isUserVerificationRequired = $(divClickedShortcut).attr('data-UserVerification');
            var isManagerApprovalRequired = $(divClickedShortcut).attr('data-ManagerApproval');
            addProductToGridObject.clickedShortcut = divClickedShortcut;

            var iShortcutIdExchange = $(divClickedShortcut).attr("data-ShortcutId");
            if (iShortcutIdExchange != null && iShortcutIdExchange != undefined && FConvert.toInt(iShortcutIdExchange) > 0)
                addProductToGridObject.exchangeSpoilageButton = divClickedShortcut;

            if (isUserVerificationRequired == "True" && isManagerApprovalRequired == "True") {
                VERIFICATIONPROCESS.clearVerificationProcessVariables();
                VERIFICATIONPROCESS.VARIABLES.IsManagerApprovalRequired = true;
                USERVERIFICATION.openUserVerification(iModuleFunctionId);
            }
            else if (isUserVerificationRequired == "True" && isManagerApprovalRequired == "False") {
                VERIFICATIONPROCESS.clearVerificationProcessVariables();
                USERVERIFICATION.openUserVerification(iModuleFunctionId);
            }
            else if (isUserVerificationRequired == "False" && isManagerApprovalRequired == "True") {
                VERIFICATIONPROCESS.clearVerificationProcessVariables();
                MANAGERAPPROVAL.openManagerApproval(iModuleFunctionId);
            }
            else if (isUserVerificationRequired == "False" && isManagerApprovalRequired == "False") {
                VERIFICATIONPROCESS.clearVerificationProcessVariables();
                VERIFICATIONPROCESS.VARIABLES.ShortcutId = iModuleFunctionId;
                //////debugger;
                var result = COMMONMETHODS.validateShortcut(iModuleFunctionId);
                if (result == undefined || result == null)
                    return;
                if (result == true) {
                    if (VERIFICATIONPROCESS.VARIABLES.ShortcutId > 0)
                        SHORTCUTMETHODS.loadShortcutFunction(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                    else
                        SHORTCUTMETHODS.loadShortcutFunction(iModuleFunctionId);
                }
                else if (result == false) {
                    if (VERIFICATIONPROCESS.VARIABLES.ShortcutId > 0)
                        SHORTCUTMETHODS.loadShortcutFunction(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ", File: retailMain.js, Method:RETAILMAIN.onShortcutClicked, Catch block : Error Message : " + Ex.message);
        }
    },//End of onShortcutClicked
