                        var nonFreeItemDiscTypesCount = SCHEMES.VARIABLE.SchemesDiscDtls.filter((p) => p.DisctypeId != 3);
                        var freeItemDiscTypesCount = SCHEMES.VARIABLE.SchemesDiscDtls.filter((p) => p.DisctypeId == 3);

