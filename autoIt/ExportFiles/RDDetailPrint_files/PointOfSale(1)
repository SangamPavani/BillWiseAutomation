                    let productIndex = -1;
                    if (rtnValuesBillSettlement.result.length == 3)
                        toastr.info("Can not post transaction. please check the log for more details.", msgPOSInformation);
                    else {
                        if (rtnValuesBillSettlement.result[13] != null && rtnValuesBillSettlement.result[13] != undefined)
                            toastr.info(rtnValuesBillSettlement.result[13], msgPOSInformation);
                    }
                    let vStatus = rtnValuesBillSettlement.result[2];
                    if (vStatus != null && vStatus != undefined) {
                        if (vStatus.Messages != null && vStatus.Messages != undefined) {
                            if (VoucherErrorMsg != null && VoucherErrorMsg != undefined && VoucherErrorMsg.length > 0)
                                VoucherErrorMsg = "";

                            for (let i = 0; i < vStatus.Messages.length; i++) {
                                if (vStatus.Messages[i] == 46 || vStatus.Messages[i] == 35 || vStatus.Messages[i] == 19 || vStatus.Messages[i] == 1 || vStatus.Messages[i] == 2 || vStatus.Messages[i] == 47 || vStatus.Messages[i] == 40) {
                                    switch (vStatus.Messages[i]) {
                                        case 46:
                                        case 35:
                                        case 19:
                                            VoucherErrorMsg = "Batch not available for this Item ";
                                            break;
                                        case 1:
                                        case 2:
                                            VoucherErrorMsg = "Stock is negative for ";
                                            break;
                                        case 47:
                                            VoucherErrorMsg = "RMA not available/Quantity not match with RMANos for these Items: ";
                                            break;
                                        case 40:
                                            VoucherErrorMsg = "Unit conversion not defined for ";
                                            break;
                                    }
                                    if (vStatus.BodyIds != null && vStatus.BodyIds != undefined && vStatus.BodyIds.length > 0 && vStatus.BodyIds[i] != null && vStatus.BodyIds[i] != undefined && vStatus.BodyIds[i] >= 0) {
                                        let ProdName = "";
                                        if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction != undefined) {

                                            let productIds = [];
                                            if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != undefined && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.length > 0)
                                                productIds = VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.filter((p) => p.Sales.Product);

                                            if (productIds != null && productIds != undefined && productIds.length > 0) {
                                                let ProdId = productIds[vStatus.BodyIds[i]];
                                                if (VOUCHERPOSTING.VARIABLES.ListOfItems != null && VOUCHERPOSTING.VARIABLES.ListOfItems != undefined && VOUCHERPOSTING.VARIABLES.ListOfItems.length > 0) {
                                                    for (let PC = 0; PC < VOUCHERPOSTING.VARIABLES.ListOfItems.length; PC++) {
                                                        if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("PRODUCT") || VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("KIT")) {
                                                            if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue1 == ProdId) {
                                                                ProdName = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue2;
                                                                productIndex = PC;
                                                                VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                                break;
                                                            }
                                                        }
                                                        else if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("SET")) {
                                                            let setItem = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RetailSetsDetails.filter(p => p.DefaultValue1 == ProdId);
                                                            if (setItem != null && setItem != undefined) {
                                                                ProdName = setItem.DefaultValue2;
                                                                productIndex = PC;
                                                                VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                                break;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        VoucherErrorMsg = VoucherErrorMsg + ProdName;
                                    }
                                    VoucherErrorMsg = VoucherErrorMsg + " some item(s).";
                                }
                            }

                            if (VoucherErrorMsg == null || VoucherErrorMsg == undefined || VoucherErrorMsg.length <= 0)
                                VoucherErrorMsg = "Exception while posting voucher. Please check the log.";

                            toastr.error(VoucherErrorMsg, "POS Exception");
                        }
                    }
                }
            }
        }
        catch (err) {
            toastr.error(err.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.postHomeDeliveryFeedback :: Catch Block :: Exception :: " + JSON.stringify(err));
            return null;
        }
    },
    updateSalesInvoice: function () {
        try {
            let msgPaidAmtNetAmtMismatch = $("#msgPaidAmtNetAmtMismatch").val();
            let errWhileCalculatingMemberPointsCheckLogs = $("#errWhileCalculatingMemberPointsCheckLogs").val();
            let errWhileAssigningMemberPointsDetCheckLogs = $("#errWhileAssigningMemberPointsDetCheckLogs").val();
            // Checking 'Total Paid Amount' & 'Total Net Amount' if donot match stoping the transaction
            if (FConvert.toDecimal((VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalPaidAmt - VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalChangeAmount), POSCommon.numberOfDecimal) != FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.NetAmt, POSCommon.numberOfDecimal)) {
                toastr.error(msgPaidAmtNetAmtMismatch, "POS Exception");
                return null;
            }

            // Getting MemberPoints when Member is present and will be saved in SaveBillSettlementDetails
            if (VOUCHERPOSTING.VARIABLES.MemberData != null && VOUCHERPOSTING.VARIABLES.MemberData != undefined &&
                VOUCHERPOSTING.VARIABLES.MemberData.ID > 0) {
                let memberPointCalculationResult = VOUCHERPOSTING.MEMBER.getCalculatedMemberPoint();
                if (memberPointCalculationResult == null || memberPointCalculationResult == undefined) {
                    toastr.error(errWhileCalculatingMemberPointsCheckLogs, "POS Exception");
                    return null;
                }
            }

            let arrSalesInvoiceTransaction = VOUCHERPOSTING.salesInvoiceTransaction();
            let arrJournalVoucherTransaction = VOUCHERPOSTING.journalVoucherTransaction();
           
            let arrBillSettlementDetails = [];
            arrBillSettlementDetails[SaveVoucherIndex.TypeOfPosting] = 2;
            arrBillSettlementDetails[SaveVoucherIndex.Revert] = false;
            arrBillSettlementDetails[SaveVoucherIndex.VoucherType] = (VOUCHERPOSTING.VARIABLES.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ? PreferenceSetting.PrefPostingTab.DeliveryNoteVoucher : PreferenceSetting.PrefPostingTab.POSVoucher);
            arrBillSettlementDetails[SaveVoucherIndex.SalesInvoiceTransaction] = arrSalesInvoiceTransaction;
            VOUCHERPOSTING.VARIABLES.PosSalesTransaction = arrSalesInvoiceTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.JournalVoucherTransaction] = arrJournalVoucherTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.BillSettlementPaymentDetails] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails;
            arrBillSettlementDetails[SaveVoucherIndex.HeaderExtraFieldsData] = VOUCHERPOSTING.VARIABLES.HeaderExtraFieldsData;
            let paymentRelatedExtraDetails = VOUCHERPOSTING.getPaymentRelatedExtraDetails();
            if (paymentRelatedExtraDetails != null && paymentRelatedExtraDetails != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.PaymentRelatedExtraField] = paymentRelatedExtraDetails;
            if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined) {
                if (ApplicationNew.TotalSchemesInfo.DVToSaveList != null && ApplicationNew.TotalSchemesInfo.DVToSaveList != undefined && ApplicationNew.TotalSchemesInfo.DVToSaveList.length > 0) {
                    for (let i = 0; i < ApplicationNew.TotalSchemesInfo.DVToSaveList.length; i++) {
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].LocationId = POSCommon.locationId;
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].UserId = POSCommon.userId;
                    }
                    arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = ApplicationNew.TotalSchemesInfo.DVToSaveList;
                }
            }
            else
                arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = null;

            let transactionSchemesApplied = VOUCHERPOSTING.getTransSchemesApplied();
            if (transactionSchemesApplied != null && transactionSchemesApplied != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = transactionSchemesApplied;
            else
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = null;

            if (ApplicationNew.HomeDelivery != null && ApplicationNew.HomeDelivery != undefined) {
                ApplicationNew.HomeDelivery.CreatedBy = POSCommon.userId;
                ApplicationNew.HomeDelivery.ModifiedBy = POSCommon.userId;
                ApplicationNew.HomeDelivery.LocationId = POSCommon.locationId;

                arrBillSettlementDetails[SaveVoucherIndex.HomeDeliveryDetails] = ApplicationNew.HomeDelivery;
            }

            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID > 0 && ApplicationNew.MemberData.PointsAccumulateOnBill > 0) {
                let memberPointDetails = VOUCHERPOSTING.MEMBER.getMemberPointsDetails();
                if (memberPointDetails != null && memberPointDetails != undefined)
                    arrBillSettlementDetails[SaveVoucherIndex.MemberPointsDetails] = memberPointDetails;
                else if (memberPointDetails == null || memberPointDetails == undefined)
                    return [false, errWhileAssigningMemberPointsDetCheckLogs];
            }

            let memberLastTransactionDetails = VOUCHERPOSTING.MEMBER.fillMemberLastTransactionDetails(VOUCHERPOSTING.VARIABLES.MemberData);
            if (memberLastTransactionDetails != null && memberLastTransactionDetails != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.MemberDetails] = memberLastTransactionDetails;
            else
                arrBillSettlementDetails[SaveVoucherIndex.MemberDetails] = null;

            //debugger;
            if (ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers != null && ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers != undefined && ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers.length > 0) {
                let arrEstimatedVoucherNumber = [];
                for (let i = 0; i < ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers.length; i++)
                    arrEstimatedVoucherNumber.push(ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers[i].VoucherNumber);

                arrBillSettlementDetails[SaveVoucherIndex.LodedEstimatedVoucher] = arrEstimatedVoucherNumber;
            }
            else
                arrBillSettlementDetails[SaveVoucherIndex.LodedEstimatedVoucher] = null;

            VOUCHERPOSTING.BILLSETTLEMENT.saveBillSettlementDetails(arrBillSettlementDetails);

            let posTransaction = new Object();
            posTransaction.BillSettlementDetails = [];
            posTransaction.BillSettlementDetails = arrBillSettlementDetails;
            let rtnValuesBillSettlement = VOUCHERPOSTING.SERVER.saveAllDetailsAfterBillSettlement(posTransaction);
            return rtnValuesBillSettlement;
            //debugger;

        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.updateSalesInvoice :: Catch Block :: Exception :: " + JSON.stringify(Ex));
        }
    },
