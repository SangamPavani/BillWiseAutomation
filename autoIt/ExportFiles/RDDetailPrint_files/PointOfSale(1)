    setBalanceAmount: function () {
        try {
            var netAmount = FConvert.toDecimal($("#txtPreOrderNetAmount").val(), POSCommon.numberOfDecimal);
            var depositAmount = FConvert.toDecimal(PREORDERDETAILS.COMMONMETHOD.getDeposit(), POSCommon.numberOfDecimal);
            var enteredDeposit = $("#txtPreOrderDeposit").val();

            if (enteredDeposit != null && enteredDeposit != undefined && FConvert.toDecimal(enteredDeposit) > 0) {

                var totalDepositAmount = FConvert.toDecimal(PREORDERDETAILS.COMMONMETHOD.getDeposit());
                var balanceAmount = FConvert.toDecimal($("#txtPreOrderBalancePending").val(), POSCommon.numberOfDecimal);
                var dBalPending = 0;
                if (balanceAmount != null && balanceAmount != undefined && balanceAmount > 0)
                    dBalPending = FConvert.toDecimal(netAmount - FConvert.toDecimal(totalDepositAmount), POSCommon.numberOfDecimal);
                else if (balanceAmount != null && balanceAmount != undefined && balanceAmount == 0)
                    dBalPending = FConvert.toDecimal((FConvert.toDecimal(netAmount) - FConvert.toDecimal(totalDepositAmount)), POSCommon.numberOfDecimal);

                dBalPending = (dBalPending > 0 ? dBalPending : 0);
                $("#txtPreOrderBalancePending").val(FConvert.toDecimal(dBalPending, POSCommon.numberOfDecimal));
                $("#btnSaveOrPayText").html('Pay');
                return;
            }
            else {
                $("#btnSaveOrPayText").html('Save');
            }

            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailMainPreOrder.js, Method:PREORDERDETAILS.setBalanceAmount, Catch block : Error Message : " + Ex.message);
            return false;
        }
