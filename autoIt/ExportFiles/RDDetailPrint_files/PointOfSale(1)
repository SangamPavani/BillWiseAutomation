                if (ApplicationNew.PreOrderInfo.CardPaymentDetails != null && ApplicationNew.PreOrderInfo.CardPaymentDetails != undefined && ApplicationNew.PreOrderInfo.CardPaymentDetails.length > 0) {

                    var creditCards = ApplicationNew.PreOrderInfo.CardPaymentDetails.filter((p) => p.PaymentType == 2);
                    if (creditCards != null && creditCards != undefined && creditCards.length > 0)
                        RefundSettlement.CreditCardPaymentDetails = creditCards;
                    else
                        RefundSettlement.CreditCardPaymentDetails = null;

                    var debitCards = ApplicationNew.PreOrderInfo.CardPaymentDetails.filter((p) => p.PaymentType == 3);
                    if (debitCards != null && debitCards != undefined && debitCards.length > 0)
                        RefundSettlement.DebitCardPaymentDetails = debitCards;
                    else
                        RefundSettlement.DebitCardPaymentDetails = null;

                    //debugger;
                    var epayment = ApplicationNew.PreOrderInfo.CardPaymentDetails.filter((p) => p.PaymentType == 14);
