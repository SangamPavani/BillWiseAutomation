    getFieldTypeLostFocusEvent: function () {
        try {
            debugger;
            var msgFieldTypealreadyexisted = $("#msgFieldTypealreadyexisted").val();
            var cbFieldType = $("#ddlLineWiseFieldType option:selected").text();
            var cbFieldTypeValue = FConvert.toInt($("#ddlLineWiseFieldType option:selected").val());
            var lineWiseData = RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.bodyPanelLineWiseModelData;
            var lstLineFieldType = lineWiseData.OutputValueListColl;
            //Validate Field Behavior
            var linewiseList = [];
            var linewiseListInfo = $("#tbodyBodyPanelLineWiseFieldRecord tr");
            if (cbFieldTypeValue != FieldBehaviour.get("PLEASESELECT") && cbFieldTypeValue != FieldBehaviour.get("OTHERS")) {
                if (linewiseListInfo != null && linewiseListInfo != undefined && linewiseListInfo.length > 0) {
                    for (let i = 0; i < linewiseListInfo.length; i++) {
                        var parsedlinewiseListInfo = $(linewiseListInfo[i]).attr("data-LineWiseData");
                        if (parsedlinewiseListInfo != null && parsedlinewiseListInfo != undefined) {
                            parsedlinewiseListInfo = JSON.parse(parsedlinewiseListInfo);
                            linewiseList.push(parsedlinewiseListInfo);
                        }
                    }
                    if (linewiseList != null && linewiseList != undefined && linewiseList.length > 0) {
                        var valiadteFieldbehavior = linewiseList.filter((p) => p.FieldBehaviour == cbFieldTypeValue)
                        if (valiadteFieldbehavior != null && valiadteFieldbehavior != undefined && valiadteFieldbehavior.length > 0) {
                            var selectedFieldTypeValue = RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.selectedFieldType;
