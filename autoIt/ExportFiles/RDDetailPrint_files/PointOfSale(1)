        onSuccessRetailMainDayInEndAsync: function (bSuccess, data) {
            try {
                debugger;
                if (bSuccess == false || data == null || data == undefined)
                    return false;

                if (data.bSuccess == false) {
                    if (data.sMessage != null && data.sMessage != undefined && data.sMessage.length > 0) {
                        toastr.info(data.sMessage, "POS Information");
                        GLOBAL.enableFullScreenMode(false);
                    }
                    return;
                }
                RETAILMAIN.VARIABLE.DayEndLoad = true;
                RETAILMAIN.settingClientSideDataOfServer();
                if (RETAILMAIN.VARIABLE.retailMainAsync == null || RETAILMAIN.VARIABLE.retailMainAsync == undefined)
                    RETAILMAIN.VARIABLE.retailMainAsync = new Object();

                RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync = data.retailMainAsync.RetailMainDayInEndAsync;

                $("#POSMainScreen").attr("data-RetailMainAsync", JSON.stringify(RETAILMAIN.VARIABLE.retailMainAsync));

                var dayInHTMLString = data.dayInHTMLString;
                var retailMainFooterPanelHTMLString = data.sRetailMainFooterPanelHTMLString;
                if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync != null && RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync != undefined) {
                    if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayInRequired == true) {
                        RETAILMAIN.VARIABLE.dayInHTMLString = dayInHTMLString;

                        $("#leftColumnRowFluid").html(data.dayInLeftPanelHTMLString);
                        RETAILMAIN.LOADINGRETAILMAINASYNC.calculateRetailMainLeftPanel();

                        $("#divFooterPanelViewPort").html(data.retailMainFooterPanelHTMLString);
                        RETAILMAINFOOTER.setFooterPanelHeightWidth();

                        var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                        messageInfoPopup.Caption = "Day In";
                        messageInfoPopup.Message = [];
                        messageInfoPopup.Message[0] = "Please do 'Day In' before proceeding further.";
                        messageInfoPopup.ButtonType = "Ok";
                        messageInfoPopup.OkMethod = "RETAILMAIN.LOADINGRETAILMAINASYNC.openDayInScreenAsync()";
                        var arrValue = [];
                        arrValue.push(messageInfoPopup);
                        arrValue.push("divForModalMain");
                        COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    }
                    else if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayEndRequired == true) {
                        let dayEndOpenArgs = new Object();
                        dayEndOpenArgs.EmployeeRecord = null;
                        dayEndOpenArgs.IsFocus8MenuCalling = false;
                        dayEndOpenArgs.ModuleType = 0;

                        NETWORK.executeServerMethod(GLOBAL.getContextPath("OpenDayEndScreen", "RetailMainScreen", "PointOfSale"),
                            true, { sDayEndOpenArgs: JSON.stringify(dayEndOpenArgs) }, "HTML", true,
                            function (bSuccess, data) {
                                GLOBAL.LoadingEnd();
                                if (bSuccess == false) {
                                    toastr.error("Exception while returning from Server. Please check the log for more details.", "POS Exception");
                                    return;
                                }
                                $("#divDayEndMadatoryModalBody").html(data);
                                if (GlobalPref.Version == eVersion.Version10)
                                    $("#divMainScreenDayEndMandatory").modal('show');
                                else
                                    $('#divMainScreenDayEndMandatory').modal({ 'show': true });

                                DAYEND.VARIABLE.DayEndMandatoryAfterTime = true;
                                let dayEndSelectionOutletPreferences = $("#divDayEndMain").attr("data-dayEndSelectionOutletPreference");
                                if (dayEndSelectionOutletPreferences == null || dayEndSelectionOutletPreferences == undefined || dayEndSelectionOutletPreferences.trim().length <= 0) {
                                    toastr.error("Exception while reading Outlet Preference.", "POS Exception");
                                    return;
                                }

                                dayEndSelectionOutletPreferences = JSON.parse(dayEndSelectionOutletPreferences);
                                RETAILMAIN.VARIABLE.preferenceSetting = PreferenceSetting;
                                DAYEND.VARIABLE.preferenceSetting = PreferenceSetting;
                                RETAILMAIN.VARIABLE.poscommon = POSCommon;
                                DAYEND.VARIABLE.posCommon = POSCommon;

                                POSCOMMUNICATIONSERVICE.getLocalSystemIPAddress();
                            }, "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", [dayEndOpenArgs]);
                    }
                    else {
                        RETAILMAIN.LOADINGRETAILMAINASYNC.callRetailMainAsync();
                        RETAILMAIN.VARIABLE.DayEndLoad = true;
                        RETAILMAIN.settingClientSideDataOfServer();
                        /*POSCOMMUNICATIONSERVICE.getLocalSystemIPAddress();*/

                        if (PreferenceSetting.PrefGeneralTab.UseLineDisp == true)
                            POSCOMMUNICATIONSERVICE.checkPoleDisplay();

                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableMessageBroadcasting == true) {
                            var messageMinutes = PreferenceSetting.PrefOutletTab.OutletGeneralTab.BrdCastNewMsgTime * 60000;
                            messageCountInterval = setInterval(RETAILMAIN.MESSAGEBROADCASTING.getMessageCount, messageMinutes);
                        }
                    }
                }
                else {
                    RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync = new Object();
                    RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayInRequired = false;
                    RETAILMAIN.LOADINGRETAILMAINASYNC.callRetailMainAsync();
                    RETAILMAIN.VARIABLE.DayEndLoad = true;
                    RETAILMAIN.settingClientSideDataOfServer();

                    if (PreferenceSetting.PrefGeneralTab.UseLineDisp == true)
                        POSCOMMUNICATIONSERVICE.checkPoleDisplay();

                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableMessageBroadcasting == true) {
                        var messageMinutes = PreferenceSetting.PrefOutletTab.OutletGeneralTab.BrdCastNewMsgTime * 60000;
                        messageCountInterval = setInterval(RETAILMAIN.MESSAGEBROADCASTING.getMessageCount, messageMinutes);
                    }
                }
                POSCOMMUNICATIONSERVICE.showPoleDisplay("=== Welcome ===", POSCommon.companyName);
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailMain.js :: Method :: RETAILMAIN.LOADINGRETAILMAINASYNC.onSuccessRetailMainDayInEndAsync :: Catch block :: Exception :: " + Ex.message + " :: Description ::" + Ex.description);
            }
        },
