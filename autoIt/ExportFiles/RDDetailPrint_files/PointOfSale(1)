                                if (AtBillSettlement == true && discPrompt != null && discPrompt.SchemeImplType == SchemeImplementedType.get("LINEWISE") && PreferenceSetting.PrefGeneralTab.ImplSchAtBillStlmnt == false)
                                    continue;
