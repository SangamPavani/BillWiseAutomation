        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: JavaScript File :: retailMainPreOrder.js :: JavaScript Function :: PREORDERCOLLECTION.preOrderCollectionFinalPayment :: Catch Block :: Exception :: " + Ex.message);
        }
    },
    getPreOrderNoDetails: function (evt) {
        try {
            var msgPleaseEnterBillNumber = $("#msgPleaseEnterBillNumber").val();
            var charCode = 0;
            if (evt == null)
                charCode = 13;
            else
                charCode = (evt.which) ? evt.which : evt.keyCode;

            if (charCode == 13) {
                var billNumber = $("#txtPreOrderCollectionOrderNumber").val();
                if (billNumber == null || billNumber == undefined || billNumber == "" || billNumber.trim().length <= 0) {
                    toastr.error(msgPleaseEnterBillNumber);
                    return false;
                }

                var reprintBill = new Object();
                reprintBill.BillNumber = billNumber;
                reprintBill.PreOrderType = TransactionModes.get("PREORDERCOLLECTION");

                CLEAROBJECTSNEW.clearVariablesSwitchToPreOrderMode();
                ApplicationNew.PresentTransactionMode = TransactionModes.get("PREORDERCOLLECTION");

                //Set Selected Pre Order Details in ApplicationNew.PreOrderInfo object
                if (ApplicationNew.PreOrderInfo == null || ApplicationNew.PreOrderInfo == undefined)
                    ApplicationNew.PreOrderInfo = {};

                var rtnValues = PREORDER.SERVERMETHODS.loadPreOrderTransaction(reprintBill);

                if (rtnValues != null && rtnValues != undefined) {
