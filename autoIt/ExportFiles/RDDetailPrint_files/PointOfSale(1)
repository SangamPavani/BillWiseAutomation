    loadChildren: function (element) {
        try {
            let isLoaded = $(element).attr("data-IsLoaded");
            if (isLoaded != null && isLoaded != undefined && FConvert.toBoolean(isLoaded) == true)
                return;

            let iProductGroupId = $(element).attr("data-ProductGroupId");
            if (iProductGroupId == null || iProductGroupId == undefined || iProductGroupId == 0) {
                toastr.error("Can not read Product Group Id from attribute");
                return;
            }

            let controlName = $(element).attr("data-ControlName");
            if (controlName == null || controlName == undefined || controlName == 0) {
                toastr.error("Can not read controlName from attribute");
                return;
            }
            //debugger;
            let childrenLength = $("#" + controlName + " #ulChildren_" + iProductGroupId + " > li").length;
            if (childrenLength == null || childrenLength == undefined || childrenLength <= 0) {
                let treeViewProductControlArgs = new Object();
                treeViewProductControlArgs.ProductGroupId = iProductGroupId;
                treeViewProductControlArgs.TreeTypeId = 0;
                treeViewProductControlArgs.ControlName = controlName;
                treeViewProductControlArgs.IsLoading = false;
                TREEVIEWCONTROL.SERVER.loadChildren(treeViewProductControlArgs);
            }
            else if (childrenLength != null && childrenLength != undefined && childrenLength > 0) {
                let ulChildren = $("#" + controlName + " #ulChildren_" + iProductGroupId);
                if (ulChildren != null && ulChildren != undefined) {
                    let ulChildrenDisplay = $(ulChildren).css('display');
                    if (ulChildrenDisplay == 'block') {
                        $("#" + controlName + " #ulChildren_" + iProductGroupId).slideUp('slow');
                        $("#" + controlName + " #gpIcon_" + iProductGroupId).addClass("glyphicon-circle-arrow-right");
                        $("#" + controlName + " #gpIcon_" + iProductGroupId).removeClass("glyphicon-circle-arrow-down");
                    }
                    else if (ulChildrenDisplay == 'none') {
                        $("#" + controlName + " #ulChildren_" + iProductGroupId).slideDown('slow');
                        $("#" + controlName + " #gpIcon_" + iProductGroupId).addClass("glyphicon-circle-arrow-down");
                        $("#" + controlName + " #gpIcon_" + iProductGroupId).removeClass("glyphicon-circle-arrow-right");
                    }
                }
            }
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Function :: TREEVIEWCONTROL.loadChildren :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    getTreeId: function (controlName) {
        try {
            //debugger;
            let ddlTreeType = $("#" + controlName + " select#ddlTreeTypeOption");
            if (ddlTreeType == null || ddlTreeType == undefined || ddlTreeType.length <= 0)
                return 0;

            let ddlTreeTypeSelect = $(ddlTreeType).find("option:selected").val();
            if (ddlTreeTypeSelect == null || ddlTreeTypeSelect == undefined)
                ddlTreeTypeSelect = FConvert.toInt(ddlTreeTypeSelect);

            return ddlTreeTypeSelect;
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: treeViewControl.js :: Method :: TREEVIEWCONTROL.getTreeId :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return 0;
        }
    },
    addSelectedProduct: function (element) {
        try {
            debugger;
            let controlName = $(element).attr("data-ControlName");
            if (controlName == null || controlName == undefined || controlName.trim().length <= 0) {
                toastr.error("Exception while reading attribute value");
                return;
            }

            let selectedProductId = [], selectedProductGroupId = [], selectedProductUnitId = [], selectedProductObject = [];
            var navigationProperties = $("#" + controlName).attr("data-NavigationProperties");
            if (navigationProperties != null && navigationProperties != undefined && navigationProperties.length > 0) {
                navigationProperties = JSON.parse(navigationProperties);

                //Getting All Page Attribute To Add 'Product Id & Product Group Id' (Not Getting Current Page Number)
                let treeViewControlPageWiseRecord = null;
                let divAllPageRecord = $("#" + controlName + " div#divPageRecord_" + controlName + " > input[type = hidden][id != " + navigationProperties.PageNumber + "]");
                if (divAllPageRecord != null && divAllPageRecord != undefined && divAllPageRecord.length > 0) {
                    for (let i = 0; i < divAllPageRecord.length; i++) {
                        treeViewControlPageWiseRecord = $(divAllPageRecord[i]).attr("data-TreeViewControlPageWiseRecord");
                        if (treeViewControlPageWiseRecord != null && treeViewControlPageWiseRecord != undefined && treeViewControlPageWiseRecord.length > 0) {
                            treeViewControlPageWiseRecord = JSON.parse(treeViewControlPageWiseRecord);

                            if (treeViewControlPageWiseRecord.SelectedProductId != null && treeViewControlPageWiseRecord.SelectedProductId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductId.length; i++)
                                    selectedProductId.push(treeViewControlPageWiseRecord.SelectedProductId[i]);
                            }

                            if (treeViewControlPageWiseRecord.SelectedProductUnitId != null && treeViewControlPageWiseRecord.SelectedProductUnitId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductUnitId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductUnitId.length; i++)
                                    selectedProductUnitId.push(treeViewControlPageWiseRecord.SelectedProductUnitId[i]);
                            }

                            if (treeViewControlPageWiseRecord.SelectedProductGroupId != null && treeViewControlPageWiseRecord.SelectedProductGroupId != undefined
                                && treeViewControlPageWiseRecord.SelectedProductGroupId.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductGroupId.length; i++)
                                    selectedProductGroupId.push(treeViewControlPageWiseRecord.SelectedProductGroupId[i]);
                            }

                            debugger;
                            if (treeViewControlPageWiseRecord.SelectedProductObject != null && treeViewControlPageWiseRecord.SelectedProductObject != undefined
                                && treeViewControlPageWiseRecord.SelectedProductObject.length > 0) {

                                for (let i = 0; i < treeViewControlPageWiseRecord.SelectedProductObject.length; i++)
                                    selectedProductObject.push(treeViewControlPageWiseRecord.SelectedProductObject[i]);
                            }
                        }
                    }
                }

                //Finding Only Current Page Record, If Not Exist Then Create New Variables(treeViewControlPageWiseRecord) 
