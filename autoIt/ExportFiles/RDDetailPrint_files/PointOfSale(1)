    closeBatchPopupFreeItem: function (bFlag, arrBatchList, sCustomData) {
        try {
            var customData = JSON.parse(sCustomData);
            var iIndex = customData.iIndex;

            RETAILMAIN.closePopup('#MBatch_Modal_dialog');

            if (bFlag == false) {
                if (arrBatchList == null || arrBatchList == undefined || arrBatchList.length <= 0) {
                    toastr.info("Batch is not available or expired for selected item.", "POS Information");
                    return;
                }

                ApplicationNew.TotalSchemesInfo.PromptsToShow.splice(iIndex, 1);
                if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined
                    && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0 && (iIndex) < ApplicationNew.TotalSchemesInfo.PromptsToShow.length) {
                    if (POSCommon.isEnableBatchNumbers == true && ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].DonotMaintainStockbyBatch == false) {
                        POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.BATCHPOPUP.openBatchPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex], iIndex]);
                        return;
                    }
                    else if (POSCommon.isRMASupport == true && ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].DonotMaintainStockbyRMA == false) {
                        PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex], iIndex]);
                        return;
                    }
                }
            }
            else {
                if (arrBatchList != null && arrBatchList != undefined && arrBatchList.length > 0) {
                    ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].BatchNo = arrBatchList[0].BatchNo;
                    ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex].BatchData = arrBatchList[0];
                }
                if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined
                    && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0 && (iIndex + 1) < ApplicationNew.TotalSchemesInfo.PromptsToShow.length) {

                    if (POSCommon.isEnableBatchNumbers == true && ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1].DonotMaintainStockbyBatch == false
                        && (PreferenceSetting.PrefInventoryTab.BatchSelectionMode == BatchSelectionMode.get("POPUP") || PreferenceSetting.PrefInventoryTab.BatchSelectionMode == BatchSelectionMode.get("BATCHPICKFIFOSETTINGFROMPOSSALES"))) {
                        POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.BATCHPOPUP.openBatchPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1], iIndex + 1]);
                        return;
                    }
                    else if (POSCommon.isRMASupport == true && ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1].DonotMaintainStockbyRMA == false) {
                        PRODUCTMETHODNEW.RMAPOPUPMETHODS.openRMAPopupFreeItem([ApplicationNew.TotalSchemesInfo.PromptsToShow[iIndex + 1], iIndex + 1]);
                        return;
                    }
                }
            }
            POSSCHEMEIMPLEMENTATIONGENERICS.addToBill([true, true]);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: posSchemeImplementationGenerics.js :: JavaScript Function :: POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.BATCHPOPUP.closeBatchPopupFreeItem :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
};
