        }
    },
    //001/03
    calculateFooterSubTotalFields: function (Application) {
        try {
            if (Application.RetailTransFooter.BodyPanelExtraFields == null
                || Application.RetailTransFooter.BodyPanelExtraFields == undefined
                || Application.RetailTransFooter.BodyPanelExtraFields.length <= 0)
                return;

            if (Application.RetailTransFooter.DynamicSubTotalFooterFields == null
                || Application.RetailTransFooter.DynamicSubTotalFooterFields == undefined
                || Application.RetailTransFooter.DynamicSubTotalFooterFields.length <= 0)
                return;

            var _net = Application.RetailTransFooter.UserWiseSubTotal;
            if ((Application.ListOfItems == null || Application.ListOfItems == undefined || Application.ListOfItems.length <= 0)
                || (_net == 0 && Application.ListOfItems[0].DefaultValue1 == 0)) {

                $.each(Application.RetailTransFooter.DynamicSubTotalFooterFields, function (index, record) { record.FieldValue = 0; });
                return;
            }

            if (Application.RetailTransFooter.DynamicSubTotalFooterFields != null && Application.RetailTransFooter.DynamicSubTotalFooterFields != undefined && Application.RetailTransFooter.DynamicSubTotalFooterFields.length > 0) {
                for (let Counter = 0; Counter < Application.RetailTransFooter.DynamicSubTotalFooterFields.length; Counter++)
                    Application.RetailTransFooter.DynamicSubTotalFooterFields[Counter].FieldValue = 0;
            }
            //Discount
            var total = 0;
            for (let k = 0; k < Application.RetailTransFooter.BodyPanelExtraFields.length; k++) {
                let iOutputCalculationId = Application.RetailTransFooter.BodyPanelExtraFields[k].OutputCalculationId;
                total = 0;

                for (let i = 0; i < Application.ListOfItems.length; i++) {
                    if (Application.ListOfItems[i].ProductType == PosProductType.get("COMPLIMENTARY"))
                        total = parseFloat(parseFloat(total) + parseFloat(0)).toFixed(POSCommon.numberOfDecimal);
                    else if (Application.ListOfItems[i].ProductType == PosProductType.get("NORMAL") || ApplicationNew.ListOfItems[i].ProductType == 4 || ApplicationNew.ListOfItems[i].ProductType == 5) {
                        if (Application.ListOfItems[i].DynamicLineFields == null || Application.ListOfItems[i].DynamicLineFields == undefined
                            || Application.ListOfItems[i].DynamicLineFields.length <= 0)
                            total = parseFloat(parseFloat(total) + 0);
                        else
                            total = parseFloat(parseFloat(total) + parseFloat(Application.ListOfItems[i].DynamicLineFields[k].FieldValue));
                    }
                    else {
                        let dFieldValue = 0;
                        if (Application.ListOfItems[i].DynamicLineFields != null && Application.ListOfItems[i].DynamicLineFields != undefined && Application.ListOfItems[i].DynamicLineFields.length > 0) {
                            if (Application.RetailTransFooter.BodyPanelExtraFields[k].OutputCalculationId == 1)
                                dFieldValue = Application.ListOfItems[i].DynamicLineFields[k].FieldValue;
                            else
                                dFieldValue = Application.ListOfItems[i].DynamicLineFields[k].FieldValue;
                        }

                        total = parseFloat(parseFloat(total) + parseFloat(dFieldValue)).toFixed(POSCommon.numberOfDecimal);
                    }
                }

                Application.RetailTransFooter.DynamicSubTotalFooterFields[k].FieldValue = parseFloat(parseFloat(Application.RetailTransFooter.DynamicSubTotalFooterFields[k].FieldValue) + parseFloat(total)).toFixed(POSCommon.numberOfDecimal);
                if (Application.FooterCalculation.LinewiseExtraFields == null || Application.FooterCalculation.LinewiseExtraFields == undefined)
                    Application.FooterCalculation.LinewiseExtraFields = [];

                let idValueCalculation = Application.FooterCalculation.LinewiseExtraFields.filter((p) => p.Id == Application.RetailTransFooter.BodyPanelExtraFields[k].ID);
                if (idValueCalculation != null && idValueCalculation != undefined && idValueCalculation.length > 0) {
                    idValueCalculation = idValueCalculation[0];
                    idValueCalculation.Value = Application.RetailTransFooter.DynamicSubTotalFooterFields[k].FieldValue;
                }
                else
                    Application.FooterCalculation.LinewiseExtraFields.push({ Id: Application.RetailTransFooter.BodyPanelExtraFields[k].ID, Value: Application.RetailTransFooter.DynamicSubTotalFooterFields[k].FieldValue });
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainCalculation.js :: Method :: CALCULATION.calculateFooterSubTotalFields :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    calculateFooterExtraFields: function () {
        try {
            ApplicationNew.FooterCalculation.TotalNumberOfItem = 0;
            ApplicationNew.FooterCalculation.UserWiseSchemeDiscount = 0;
            let noOfItems = ApplicationNew.ListOfItems.filter((p) => p.DefaultValue1 > 0);
            if (noOfItems != null && noOfItems != undefined && noOfItems.length > 0) {
                ApplicationNew.FooterCalculation.TotalNumberOfItem = noOfItems.length;
                ApplicationNew.RetailTransFooter.TotalItems = noOfItems.length;
            }
            ApplicationNew.RetailTransFooter.UserWiseSchemeDiscount = 0;
            ApplicationNew.RetailTransFooter.UserWiseDiscount = 0;
            let _NetRoundOffPref = POSCommon.netRoundOffPreference;
            if ((ApplicationNew.RetailTransFooter.FooterFieldsList != null && ApplicationNew.RetailTransFooter.FooterFieldsList != undefined && ApplicationNew.RetailTransFooter.FooterFieldsList.length > 0)
                && (ApplicationNew.RetailTransFooter.DynamicFooterFields != null && ApplicationNew.RetailTransFooter.DynamicFooterFields != undefined && ApplicationNew.RetailTransFooter.DynamicFooterFields.length > 0)) {

                let _net = ApplicationNew.FooterCalculation.UserWiseSubTotal;
                if (_net == 0 && (ApplicationNew.ListOfItems == null || ApplicationNew.ListOfItems == undefined || ApplicationNew.ListOfItems.length == 0 || ApplicationNew.ListOfItems[0].DefaultValue1 == 0)) {
                    for (let i = 0; i < ApplicationNew.RetailTransFooter.DynamicFooterFields.length; i++) {
                        ApplicationNew.RetailTransFooter.DynamicFooterFields[i].FieldColMap = ApplicationNew.RetailTransFooter.FooterFieldsList[i].ColMap;
                        ApplicationNew.RetailTransFooter.DynamicFooterFields[i].FieldInput = ApplicationNew.RetailTransFooter.FooterFieldsList[i].PreloadValue;
                    }
                    ApplicationNew.RetailTransFooter.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
                    ApplicationNew.FooterCalculation.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
                    return;
                }
                let iRoundOffIndex = -1, iCardChargesIndex = -1;
                if (ApplicationNew.RetailTransFooter.FooterFieldsList != null && ApplicationNew.RetailTransFooter.FooterFieldsList != undefined && ApplicationNew.RetailTransFooter.FooterFieldsList.length > 0) {
                    for (let k = 0; k < ApplicationNew.RetailTransFooter.FooterFieldsList.length; k++) {
                        if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].DonotConsider > 0) {
                            if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPOSSALES") || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPOSSALES") || ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") || ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERYFEEDBACK")) {
                                if ((ApplicationNew.RetailTransFooter.FooterFieldsList[k].DonotConsider & (1 << 1)) != 0) {
                                    ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput = 0;
                                    continue;
                                }
                            }
                            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("VIEWPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER") || ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION")) {
                                if ((ApplicationNew.RetailTransFooter.FooterFieldsList[k].DonotConsider & (1 << 2)) != 0) {
                                    ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput = 0;
                                    continue;
                                }
                            }
                        }
                        if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("SCHEMEDISCOUNT"))
                            ApplicationNew.RetailTransFooter.UserWiseSchemeDiscount = ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput;

                        if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("HOMEDELIVERYCHARGES")) {
                            if ((ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") || ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERYFEEDBACK") ||
                                ((ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined && ApplicationNew.PreOrderInfo.SelectedPreOrderDetails != null && ApplicationNew.PreOrderInfo.SelectedPreOrderDetails != undefined) &&
                                    FConvert.toInt(ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.DeliveryType) == 1)) == false) {
                                ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput = 0;
                            }
                        }
                        if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("SERVICECHARGE") || ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("PREORDERADVANCE")) {
                            ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldValue = ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput;
                            continue;
                        }
                        else if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("ROUNDOFF"))
                            iRoundOffIndex = k;
                        else if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("CARDCHARGES"))
                            iCardChargesIndex = k;
                        else {
                            if (ApplicationNew.RetailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("VATDISCOUNT"))
                                ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldInput = ApplicationNew.RetailTransFooter.DynamicFooterFields[k].FieldValue = PRODUCTSELECTION.UIMETHODS.getTaxFromTransaction(ApplicationNew.ListOfItems);
                            _net = CALCULATION.calculateNetAmountWithFooterFieldInput(k, _net, ApplicationNew.RetailTransFooter);
                        }
                    }
                }
                ApplicationNew.RetailTransFooter.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
                ApplicationNew.FooterCalculation.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);

                if (iCardChargesIndex != -1)
                    _net = CALCULATION.calculateNetAmountWithFooterFieldInput(iCardChargesIndex, _net, ApplicationNew.RetailTransFooter);

                ApplicationNew.RetailTransFooter.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
                ApplicationNew.FooterCalculation.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);

                if (iRoundOffIndex != -1) {
                    if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOff == true && BILLSETTLEMENT.VARIABLE.IsBillSettlementDone == false) {
                        if (_NetRoundOffPref.RoundoffValue != 0)
                            CALCULATION.calculateNetRoundOffWithPreference();
                    }
                    _net = CALCULATION.calculateNetAmountWithFooterFieldInput(iRoundOffIndex, _net, ApplicationNew.RetailTransFooter);
                }
                ApplicationNew.RetailTransFooter.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
                ApplicationNew.FooterCalculation.UserWiseNet = FConvert.toDecimal(_net, POSCommon.numberOfDecimal, true);
            }
            else {
                ApplicationNew.RetailTransFooter.UserWiseNet = FConvert.toDecimal(ApplicationNew.RetailTransFooter.UserWiseSubTotal, POSCommon.numberOfDecimal, true);
                ApplicationNew.FooterCalculation.UserWiseNet = FConvert.toDecimal(ApplicationNew.FooterCalculation.UserWiseSubTotal, POSCommon.numberOfDecimal, true);
            }

        } catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainCalculation.js :: Method :: CALCULATION.calculateFooterExtraFields :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },//03/03
    calculateNetAmountWithFooterFieldInput: function (k, _net, retailTransFooter) {
        try {
            let _NetRoundOffPref = POSCommon.netRoundOffPreference;// System.Web.HttpContext.Current.Session["_NetRoundOffPref"] as PaymentRoundOff;
            var dAmt = 0;

            if (retailTransFooter.FooterFieldsList[k].OutputCalculationId == 1)
                dAmt = retailTransFooter.DynamicFooterFields[k].FieldInput;
            else if (retailTransFooter.FooterFieldsList[k].OutputCalculationId == 2) {
                ///Percentage on Gross
                if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 3)
                    dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput), parseFloat(retailTransFooter.UserWiseGross))).toFixed(POSCommon.numberOfDecimal);
                else
                    dAmt = parseFloat((parseFloat(retailTransFooter.UserWiseGross) * parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput)) / 100).toFixed(POSCommon.numberOfDecimal);
            }
            else if (retailTransFooter.FooterFieldsList[k].OutputCalculationId == 3) {
                if (retailTransFooter.FooterFieldsList[k].ExempFieldIds != null
                    && retailTransFooter.FooterFieldsList[k].ExempFieldIds != undefined
                    && retailTransFooter.FooterFieldsList[k].ExempFieldIds.length > 0) {
                    ///Percentage on Net with some fields exemption
                    var dNetAmt = parseFloat(CALCULATION.getNetAmountAfterExempt(k)).toFixed(POSCommon.numberOfDecimal);
                    if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 3)
                        dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput), dNetAmt)).toFixed(POSCommon.numberOfDecimal);
                    else
                        dAmt = parseFloat((dNetAmt * parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput)) / 100).toFixed(POSCommon.numberOfDecimal);
                }
                else {
                    ///Percentage on Net
                    if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 3)
                        dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput), _net)).toFixed(POSCommon.numberOfDecimal);
                    else
                        dAmt = parseFloat((_net * parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput)) / 100).toFixed(POSCommon.numberOfDecimal);
                }
            }
            else if (retailTransFooter.FooterFieldsList[k].OutputCalculationId == OutputCalculation.get("PERCENTAGEONLINENETT")) {
                ///Percentage on Line Nett
                if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 3)
                    dAmt = parseFloat(COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput), retailTransFooter.UserWiseSubTotal)).toFixed(POSCommon.numberOfDecimal);
                else
                    dAmt = parseFloat((retailTransFooter.UserWiseSubTotal * parseFloat(retailTransFooter.DynamicFooterFields[k].FieldInput)) / 100).toFixed(POSCommon.numberOfDecimal);
            }

            if (retailTransFooter.FooterFieldsList[k].FieldBehaviour != FieldBehaviour.get("ROUNDOFF")) {
                let dValueInDecimal = COMMONMETHODS.UTILITYMETHODS.roundOff(dAmt, POSCommon.localCurrency.GeneralRoundOff, POSCommon.localCurrency.RoundOffType, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);//parseFloat(dAmt); //.RoundOff(POSCommon.localCurrency.GeneralRoundOff, POSCommon.localCurrency.RoundOffType, PreferenceSetting.PrefMiscellaneousTab.NoOfDecimalInFooter);
                dAmt = dValueInDecimal;
            }
            retailTransFooter.DynamicFooterFields[k].FieldValue = dAmt;

            if (retailTransFooter.FooterFieldsList[k].IsDiscountField == true
                && retailTransFooter.FooterFieldsList[k].EffectOnNetId == 2) {
                dAmt = FConvert.toDecimal(dAmt);
                retailTransFooter.UserWiseDiscount = FConvert.toDecimal(retailTransFooter.UserWiseDiscount);
                retailTransFooter.UserWiseDiscount = FConvert.toDecimal(retailTransFooter.UserWiseDiscount + dAmt, POSCommon.numberOfDecimal);
                // parseFloat(retailTransFooter.UserWiseDiscount + dAmt).toFixed(POSCommon.numberOfDecimal);
                retailTransFooter.UserWiseDiscount = FConvert.toDecimal(retailTransFooter.UserWiseDiscount);
            }

            if (retailTransFooter.FooterFieldsList[k].FieldBehaviour != FieldBehaviour.get("ROUNDOFF")) {
                dAmt = FConvert.toDecimal(dAmt);
                if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 1) {
                    _net = FConvert.toDecimal(FConvert.toDecimal(_net) + FConvert.toDecimal(dAmt), POSCommon.numberOfDecimal);
                    if (retailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("CARDCHARGES") ||
                        retailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("EPAYMENTCHARGES"))
                        retailTransFooter.FooterScreenFieldsTotalValue = FConvert.toDecimal(retailTransFooter.FooterScreenFieldsTotalValue) + dAmt;
                }
                else if (retailTransFooter.FooterFieldsList[k].EffectOnNetId == 2) {
                    retailTransFooter.FooterScreenFieldsTotalValue = FConvert.toDecimal(retailTransFooter.FooterScreenFieldsTotalValue) - dAmt;
                    _net = FConvert.toDecimal(FConvert.toDecimal(_net) - FConvert.toDecimal(dAmt), POSCommon.numberOfDecimal);
                    // _net = parseFloat(_net - dAmt).toFixed(POSCommon.numberOfDecimal);                    
                }
            }
            else
                _net = FConvert.toDecimal(FConvert.toDecimal(_net) + FConvert.toDecimal(dAmt), POSCommon.numberOfDecimal); //+_net = parseFloat(_net + dAmt).toFixed(POSCommon.numberOfDecimal);

            if (ApplicationNew.FooterCalculation.FooterExtraFields == null)
                ApplicationNew.FooterCalculation.FooterExtraFields = [];

            let idValueCalculation = ApplicationNew.FooterCalculation.FooterExtraFields.filter((p) => p.Id == retailTransFooter.FooterFieldsList[k].ID);
            if (idValueCalculation != null && idValueCalculation != undefined && idValueCalculation.length > 0) {
                idValueCalculation = idValueCalculation[0];
                idValueCalculation.Value = retailTransFooter.DynamicFooterFields[k].FieldInput;
            }
            else {
                if (ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") && retailTransFooter.FooterFieldsList[k].FieldBehaviour == FieldBehaviour.get("HOMEDELIVERYCHARGES"))
                    ApplicationNew.FooterCalculation.FooterExtraFields.push({ Id: retailTransFooter.FooterFieldsList[k].ID, Value: retailTransFooter.DynamicFooterFields[k].FieldInput });
                else if (retailTransFooter.FooterFieldsList[k].FieldBehaviour != FieldBehaviour.get("HOMEDELIVERYCHARGES"))
                    ApplicationNew.FooterCalculation.FooterExtraFields.push({ Id: retailTransFooter.FooterFieldsList[k].ID, Value: retailTransFooter.DynamicFooterFields[k].FieldInput });
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainCalculation.js :: Method :: CALCULATION.calculateNetAmountWithFooterFieldInput :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
        return _net;
    },
    calculateNetRoundOffWithPreference: function () {
        try {
            let _NetRoundOffPref = POSCommon.netRoundOffPreference;
