                            switch (data.retailMainAsync.RetailMainLeftPanelAsync.BodyPanelExtraFieldList[bec].FieldBehaviour) {
                                case FieldBehaviour.get("GST"):
                                    POSCommon.GSTBodyExtraField = data.retailMainAsync.RetailMainLeftPanelAsync.BodyPanelExtraFieldList[bec];
