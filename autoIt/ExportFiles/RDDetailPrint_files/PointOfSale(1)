        try {
            var charCode = (e.which) ? e.which : e.keyCode;
            if (charCode == 8 || (charCode >= 48 && charCode <= 57) || (charCode >= 96 && charCode <= 105))
                return true;

            if (charCode == 13 || charCode == 9) {
                BILLSETTLEMENTSCHEMES.getInputControlEvent(inputControl);
                return true;
            }
            else
                return false;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENTSCHEMES.getInputControlEventByEnterKey, Catch block : Error Message : " + Ex.message);
            return false;
        }
