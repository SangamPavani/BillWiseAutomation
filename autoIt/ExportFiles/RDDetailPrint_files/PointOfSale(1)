                        //    dDiscount = itemsToConsider[i].DynamicLineFields[0].FieldInput = itemsToConsider[i].DynamicLineFields[0].FieldValue = FConvert.toDecimal(itemsToConsider[i].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(dDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
