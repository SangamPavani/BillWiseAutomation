        onBlurTokenNumberInLabel: function (element) {

            try {
                var txtBlurTokenNumberInLabel = $(element).val();
                if (txtBlurTokenNumberInLabel.length > 0) {

                    if (txtBlurTokenNumberInLabel.trim() != null && txtBlurTokenNumberInLabel.trim().length > 0) {

                        var sLastChar = txtBlurTokenNumberInLabel.trim().slice(-1);//substring(0, txtBlurTokenNumberInLabel.length - 1);
                        if (!isNaN(sLastChar)) {
                            toastr.error("Last character of 'Token number prefix' can not be Digit");
                            $(element).select();
                            return;
                        }
                    }
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainPreference.js :: Method :: PREFERENCE.OutletRestaurantTab.onBlurTokenNumberInLabel :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
