    validateControlsData: function (iSearchBy, parsedReprintModel) {
        try {
            let MsgFromDatecannotbegreaterthanToDate = $("input#MsgFromDatecannotbegreaterthanToDate").val();
            let MsgPleaseselectSalesman = $("input#MsgPleaseselectSalesman").val();
            var msgtxtInfoMemberNameCantEpt = $("#msgtxtInfoMemberNameCantEpt").val();
            var msgtxtInfoPlsSelMemberName = $("#msgtxtInfoPlsSelMemberName").val();
            var msgtxtInfoPlzSelBillDate = $("#msgtxtInfoPlzSelBillDate").val();
            var msgtxtInfoBillDateNotGrtThenToday = $("#msgtxtInfoBillDateNotGrtThenToday").val();
            var msgtxtInfoPlzSelFrmDate = $("#msgtxtInfoPlzSelFrmDate").val();
            var msgtxtInfoPlzSelToDate = $("#msgtxtInfoPlzSelToDate").val();
            var msgtxtInfoFrmToDateLessThenToday = $("#msgtxtInfoFrmToDateLessThenToday").val();

            // Member Name
            if (iSearchBy == "MemberName") {
                var reprintBillName = OPTIONCONTROL.getControlText("optReprintBillControl");
                if (reprintBillName == "" || reprintBillName == null || reprintBillName.length == 0) {
                    toastr.error(msgtxtInfoMemberNameCantEpt);
                    $("input#optReprintBillControl").focus();
                    return;
                }
                if (OPTIONCONTROL.getControlValue(optReprintBillControl.id) == 0) {
                    toastr.error(msgtxtInfoPlsSelMemberName);
                    $("input#optReprintBillControl").focus();
                    return false;
                }
            }
            //    // Date
            else if (iSearchBy == "BillDate") {
                var dtDeliveryDate = DATEPICKER.getDate(dpReprintDate);
                if (dtDeliveryDate <= 0) {
                    toastr.error(msgtxtInfoPlzSelBillDate);
                    return false;
                }
                if (dtDeliveryDate > DATE.prototype.today(POSCommon.CalType)) {
                    toastr.error(msgtxtInfoBillDateNotGrtThenToday);
                    return false;
                }
            }
            // Between Dates
            else if (iSearchBy == "BetweenDates") {
                if (DATEPICKER.getDate(dpReprintFromDate) <= 0) {
                    toastr.error(msgtxtInfoPlzSelFrmDate);
                    return false;
                }
                if (DATEPICKER.getDate(dpReprintToDate) <= 0) {
                    toastr.error(msgtxtInfoPlzSelToDate);
                    return false;
                }

                if (DATEPICKER.getDate(dpReprintFromDate) > DATE.prototype.today(POSCommon.CalType) || DATEPICKER.getDate(dpReprintToDate) > DATE.prototype.today(POSCommon.CalType)) {
                    toastr.error(msgtxtInfoFrmToDateLessThenToday);
                    return false;
                }
                if (DATEPICKER.getDate(dpReprintFromDate) > DATEPICKER.getDate(dpReprintToDate)) {
                    toastr.error(MsgFromDatecannotbegreaterthanToDate);
                    return false;
                }
            }
            else if (iSearchBy == "ReprintSaleman") {
                if (parsedReprintModel.PosTransactionFilter.EmployeeId == 0 || parsedReprintModel.PosTransactionFilter.EmployeeId == undefined) {
                    toastr.error(MsgPleaseselectSalesman);
                    return;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:REPRINTBILL.validateControlsData, Catch block : Error Message : " + Ex.message);
        }
    },
