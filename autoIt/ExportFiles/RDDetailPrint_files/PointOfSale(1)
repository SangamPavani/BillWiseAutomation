                        gross = parseFloat(parseFloat(gross) + 0).toFixed(POSCommon.numberOfDecimal);
                        _net = parseFloat(parseFloat(gross) + 0).toFixed(POSCommon.numberOfDecimal);
                        subtotal = parseFloat(parseFloat(gross) + 0).toFixed(POSCommon.numberOfDecimal);
                    }
                    else {
                        gross = parseFloat(parseFloat(gross) + parseFloat(record.DefaultValue15)).toFixed(POSCommon.numberOfDecimal);
