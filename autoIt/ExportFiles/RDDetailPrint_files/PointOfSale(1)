    setValidDiscountVoucherSeriesNumber: function (inputControl) {
        try {
            var parsedDiscountVoucherMain = JSON.parse($('#tBodySchemeDiscountVoucher').attr('data-SchemesDiscountVoucherDetails'));
            var seriesNumber = $(inputControl).val();
            var inputControlText = FConvert.toInt($(inputControl).val());
            var inputControlTableCell = $(inputControl).closest('td')[0];
            var inputControlTableRow = $(inputControlTableCell).closest('tr')[0];

            var clickedTr = JSON.parse($(inputControlTableRow).attr("data-SchemesDiscountVoucher"));
            var trId = $(inputControlTableRow).attr('id');
            clickedTr.DVSeriesNo = seriesNumber;
            if (clickedTr != null && clickedTr != undefined && clickedTr.DVSeriesNoReq == true && (clickedTr.DVSeriesNo != "" && clickedTr.DVSeriesNo != null && clickedTr.DVSeriesNo != undefined)) {
                parsedDiscountVoucherMain[trId].DVSeriesNo = clickedTr.DVSeriesNo;
                let dVPromptsCopy = parsedDiscountVoucherMain.filter((p) => p.ProductId == clickedTr.ProductId && p.DVSeriesNo != null && p.DVSeriesNo != undefined);
                let dVPromptsCopy1 = dVPromptsCopy.filter((p) => (p.DVSeriesNo.trim()) == clickedTr.DVSeriesNo.trim());
                if (dVPromptsCopy1 != null && dVPromptsCopy1 != undefined && dVPromptsCopy1.length > 1) {
                    clickedTr.DVSeriesNo = "";
                    clickedTr.DVSeriesNoIsValid = false;
                    $(inputControl).css('border-color', 'red');
                    $(inputControl).css('background', 'white');
                    return true;
                }

                GLOBAL.LoadingStart();
                NETWORK.executeServerMethod(GLOBAL.getContextPath("setSeriesNumber", "RetailMainScreen", "PointOfSale"),
                    true, { sApplication: JSON.stringify(clickedTr) }, "JSON", false,
                    function (bSuccess, data) {
                        if (bSuccess == false) {
                            GLOBAL.LoadingEnd();
                            return false;
                        }

                        GLOBAL.LoadingEnd();
                        if (data.bSuccess == true) {
                            clickedTr.DVSeriesNoIsValid = data.seriesResult;
                        }
                        if (clickedTr.DVSeriesNoIsValid == true) {
                            $(inputControl).css('background', 'SeaGreen');
                            $(inputControl).css('border-color', 'SeaGreen');
                        }
                        else {
                            $(inputControl).css('border-color', 'red');
                            $(inputControl).css('background', 'white');
                        }
                    });
                $(inputControlTableRow).find($(trId)).attr("data-SchemesDiscountVoucher", JSON.stringify(clickedTr));
                var tbodylength = $("#tBodySchemeDiscountVoucher > tr");
                var isSelected = true;
                for (let i = 0; i < tbodylength.length; i++) {
                    var trID = $(tbodylength[i]).attr('id');
                    var chkProductClick = $(tbodylength[i]).find("input[type=checkbox]");
                    if (chkProductClick != null && chkProductClick != undefined && chkProductClick.length > 0) {
                        if ($(chkProductClick).is(":checked") == true)
                            isSelected = true;
                        else
                            isSelected = false;
                        for (let j = 0; j < parsedDiscountVoucherMain.length; j++) {
                            if (i == j)
                                parsedDiscountVoucherMain[j].IsSelected = isSelected;
                        }
                    }
                    if (trID == trId) {
                        trId = FConvert.toInt(trId);
                        parsedDiscountVoucherMain[trId].DVSeriesNo = clickedTr.DVSeriesNo;
                        parsedDiscountVoucherMain[trId].DVSeriesNoIsValid = clickedTr.DVSeriesNoIsValid;
                    }
                    $('#tBodySchemeDiscountVoucher').attr('data-SchemesDiscountVoucherDetails', JSON.stringify(parsedDiscountVoucherMain));
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENTSCHEMES.setValidDiscountVoucherSeriesNumber, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
