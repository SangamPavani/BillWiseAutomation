                var iRecurTypeID = 0;
                var iRecurApplyTypeID = 0;
                if ($("#rbtMemberDiscountOverAll").prop('checked') == true)
                    iRecurApplyTypeID = 1;
                var DiscountApplyType = 0;
                var MaxAmount = 0;
                if ($("#chkMemberSchemeNone").prop('checked') == true) {
                    DiscountApplyType = 4;
                    if ($("#chkMemberDiscountLimitOnAmount").prop('checked') == true) {
                        if ($("#rbtMemberDiscountLimitMonthly").prop('checked') == true)
                            iRecurTypeID = 1;
                        else
                            iRecurTypeID = 2;
                        MaxAmount = $("#txtMemberDiscountLimit").val(); //Convert.ToDecimal(txtAmtLimit.Text);
                    }
                    else
                        iRecurTypeID = 3;
                }
                else if ($("#chkMemberSchemeRegular").prop('checked') == true || $("#chkMemberSchemeFirstPurchase").prop('checked') == true) {
                    if ($("#chkMemberSchemeRegular").prop('checked') == true)
                        DiscountApplyType += 1;
                    if ($("#chkMemberSchemeFirstPurchase").prop('checked') == true)
                        DiscountApplyType += 2;

                    if ($("#rbtMemberDiscountMonthly").prop('checked') == true)
                        iRecurTypeID = 1;
                }

                var optMemberDiscountScheme = OPTIONCONTROL.getControlDataObject("optMemberSchemeName");
                var MemberSchemeId = optMemberDiscountScheme.iId;
                var dtpFromDate = DATEPICKER.getDate(dtpFromDateMem);
                var dtpToDate = DATEPICKER.getDate(dtpToDateMem);

                var objSchemesDiscountDef = new Object();
                objSchemesDiscountDef.Name = optMemberSchemeName.value;
                objSchemesDiscountDef.DiscTypeID = 2;
                objSchemesDiscountDef.Outlets = SCHEMESOUTLETS.VARIABLE.OutletId;
                objSchemesDiscountDef.Members = SCHEMESDISCOUNT.VARIABLE.ItemId;

                // Days
                var SchemesDays = "";
                for (var i = 0; i < SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays.length; i++) {
                    SchemesDays += SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays[i].ID + ",";
                }
                if (SchemesDays.length > 0) {
                    SchemesDays = SchemesDays.substring(0, SchemesDays.length - 1);
                    objSchemesDiscountDef.SchemesDays = SchemesDays;
                }
                else
                    objSchemesDiscountDef.SchemesDays = "";

                // Scheme For
                objSchemesDiscountDef.PreOrderScheme = false;
                objSchemesDiscountDef.Inactive = false;
                var selOptionList = LISTCHECKBOXCONTROL.getControlData("ddlSchemeForMem");
                for (var i = 0; i < selOptionList.length; i++) {
                    if (selOptionList[i].ID == 1)
                        objSchemesDiscountDef.PreOrderScheme = true;
                    if (selOptionList[i].ID == 2)
                        objSchemesDiscountDef.Inactive = true;
                }

                objSchemesDiscountDef.FromDateInt = dtpFromDate;
                objSchemesDiscountDef.ToDateInt = dtpToDate;
                objSchemesDiscountDef.FromTimeInt = FTIMECONTROL.getTime("tpFromTimeMem");
                objSchemesDiscountDef.ToTimeInt = FTIMECONTROL.getTime("tpToTimeMem");
                objSchemesDiscountDef.SchemeTypeID = $("#ddlSchemeTypeMem").val(); // Re-Check
