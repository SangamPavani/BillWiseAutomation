    convertBase64toByteArray: function (base64String) {
        try {
            //debugger;
            var BASE64_MARKER = 'data:image/jpeg;base64,';
            var base64Index = base64String.indexOf(BASE64_MARKER) + BASE64_MARKER.length;
            var base64 = base64String.substring(base64Index);
            var raw = window.atob(base64);
            var rawLength = raw.length;
            var array = Uint8Array.from(atob(base64), c => c.charCodeAt(0));
            return array;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + ":: File: retailMainCustomization.js:: Method: RETAILMAINGROUPCUSTOMIZATION.convertBase64toByteArray :: Catch block : Error Message : " + ex.message);
            return;
        }
