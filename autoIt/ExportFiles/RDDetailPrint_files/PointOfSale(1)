                    toastr.error(toDateCannotBLessThanFromdate);
                    return false;
                }
                var selectedItemId = FConvert.toInt(OPTIONCONTROL.getControlValue(optMemberSchemeName));

                if (selectedItemId == 0) {

                    var SchemesDiscountDef = new Object();
                    SchemesDiscountDef.Name = optMemberSchemeName.value;
                    SchemesDiscountDef.DiscTypeID = 6;

                    var result = SCHEMESCOMMONMETHODS.checkForSchemeNameDuplicate(SchemesDiscountDef)
                    if (result == true) {
                        toastr.error(duplicateSchemeName);
                        OPTIONCONTROL.clear("optMemberSchemeName");
                        $("input#optMemberSchemeName").focus();
                        return false;
                    }
                }

                //If outlets are not selected display a message to select else load into property which will decrease one loop at the time of retriving outlet ids for saving.                
                if (SCHEMESOUTLETS.VARIABLE.OutletId == null) {
                    toastr.error(selectOutlets);
                    return false;
                }

                if (SCHEMESDISCOUNT.MEMBERDISCOUNT.PromptToSelectSchemeType() == false)
                    return false;

                if ($("#rbtMemberDiscountWeekly").is(':checked') == true) {
                    SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays = LISTCHECKBOXCONTROL.getControlData("ddlWeekdaysMem");
                    if (SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays.length == 0) {
                        toastr.error(selectDays);
