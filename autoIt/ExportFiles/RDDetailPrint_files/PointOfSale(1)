                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOff == true && POSCommon.netRoundOffPreference.RoundoffValue != 0 && BILLSETTLEMENT.VARIABLE.IsBillSettlementDone == false && (ApplicationNew.PreviousTransaction == null || ApplicationNew.PreviousTransaction == undefined || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == null || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == undefined)) {

