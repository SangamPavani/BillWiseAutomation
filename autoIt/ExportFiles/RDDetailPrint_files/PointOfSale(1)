                    switch (POSCommon.sellingRateTagCompany) {
                        case POSCommon.outletTypeId:
                            POSCommon.sellingTagValue = POSCommon.outletId;
                            break;
                        case POSCommon.memberTypeMasterTypeId:
                            POSCommon.sellingTagValue = ApplicationNew.MemberData.MemberTypeId;
                            break;
                        case POSCommon.memberCardDefinitionMasterTypeId:
                            POSCommon.sellingTagValue = ApplicationNew.MemberData.CardNumberId;
                            break;
                        default:
                            POSCommon.sellingTagValue = PreferenceSetting.PrefOutletTab.OutletAccountsTab.SellingRateTag;
                            break;
                    }
                }
                else if (data.bSuccess == false) {
                    toastr.error(data.sMessage);
                    return;
                }
