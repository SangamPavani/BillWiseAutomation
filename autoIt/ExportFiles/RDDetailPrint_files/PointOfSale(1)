                if (bIsDVCurDifferFrmLocalCur == true) {
                    $("#tbDVCurrencyDets").val(data.objDiscountVoucherReg.CurrencyCode, data.objDiscountVoucherReg.DefinitionDenomination, data.LocalCurrency.CurrencyCode, dExcRate);
                    $("#tbDVCurrencyDets").show();
                    consideringDVDefValue = objDiscountVoucherReg.DefinitionDenomination * dExcRate;
                }
                $("#txtDiscountVoucherValue").val(consideringDVDefValue);
            }
            else {
                if (objDiscountVoucherReg.ProductsList != null && objDiscountVoucherReg.ProductsList.Count > 0) {
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("GetMatchedItemsWithDVProducts", "RetailMainScreen", "PointOfSale"),
