                arrBillPrintingFooter[BillPrintFooter.FCrCardAmount] = billSettlementPaymentDetails.CreditCardPaid;
                arrBillPrintingFooter[BillPrintFooter.FDrCardAmount] = billSettlementPaymentDetails.DebitCardPaid;
