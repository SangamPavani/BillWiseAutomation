        getSearchedProduct: function (navigationProductClick) {
            try {
                let msgPleaseEnterMinimum = $("#msgPleaseEnterMinimum").val();
                let msgCharacterToSearch = $("#msgCharacterToSearch").val();
                let msgMemberSelection = $("#msgMandatoryMemSel").val();
                if (RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync == null || RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync == undefined
                    || RETAILMAIN.VARIABLE.retailMainAsync.RetailMainDayInEndAsync.DayInRequired == true)
                    return;

                var result = RETAILMAIN.validateProductClick();
                if (result == null || result == undefined || result == false) {
                    $("#txtSearchProduct").val("");
                    return;
                }

                if (PreferenceSetting.PrefMiscellaneousOtherTab.MandCustSelInBillng == true &&
                    PreferenceSetting.PrefOutletTab.OutletGeneralTab.CalculateRateOnMemberTypeProfitPercentage == true) {
                    if (SEARCHCLAUSE.SEARCHPRODUCT.openSearchMemberScreen() == false) {
                        $("#txtSearchProduct").val("");
                        return;
                    }
                }
                var defaultParameter = new Object();
                if (POSCommon.sellingRateTagCompany == POSCommon.memberTypeMasterTypeId || POSCommon.sellingRateTagCompany == POSCommon.memberCardDefinitionMasterTypeId) {
                    if ((ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined || ApplicationNew.MemberData.ID <= 0)) {
                        var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                        messageInfoPopup.Caption = "Point Of Sale Information";
                        messageInfoPopup.Message = [];
                        messageInfoPopup.Message[0] = msgMemberSelection;
                        messageInfoPopup.ButtonType = "Ok";
                        messageInfoPopup.OkMethod = "MESSAGEPOPUP.CUSTOMERSELECTIONMANDATORY.openMemberScreen()";
                        var arrValue = [];
                        arrValue.push(messageInfoPopup);
                        arrValue.push("divForModalMain");
                        COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                        $("#txtSearchProduct").val("");
                        return;
                    }
                    RETAILMAIN.loadingSellingTagValue();
                }
                defaultParameter.SellingTagValue = POSCommon.sellingTagValue;
                var SearchTextProduct = $("#txtSearchProduct").val();
                if (SearchTextProduct == null || SearchTextProduct == undefined || SearchTextProduct.length <= 0)
                    return;

                var iMinchar = $("#divSearchProductCol").attr('data-MinChar');
                if ($.trim(SearchTextProduct).length < iMinchar) {
                    toastr.success(msgPleaseEnterMinimum + " " + iMinchar + " " + msgCharacterToSearch);
                    $("#txtSearchProduct").focus();
                    return;
                }
                var iCount = parseInt($("#divSearchProductCol").attr('data-Count'));
                var iMaxCount = parseInt($("#divSearchProductCol").attr('data-MaxRecordCount'));
                var iRecordsPerPage = parseInt($("#divSearchProductCol").attr('data-RecordPerPage'));
                if (navigationProductClick == 1)
                    iCount = 0;
                else if (navigationProductClick == 2)
                    iCount -= iRecordsPerPage;
                else if (navigationProductClick == 3)
                    iCount += iRecordsPerPage;
                else if (navigationProductClick == 4) {
                    iCount = iRecordsPerPage * (parseInt(iMaxCount / iRecordsPerPage));
                    if (iCount == iMaxCount)
                        iCount -= iRecordsPerPage;
                    $("#btnSearchProductFirst").removeClass("nextPrevious");
                    $("#btnSearchProductFirst").addClass("nextPreviousActive");
                    $("#btnSearchProductPrevious").removeClass("nextPrevious");
                    $("#btnSearchProductPrevious").addClass("nextPreviousActive");
                    $("#btnSearchProductNext").removeClass("nextPreviousActive");
                    $("#btnSearchProductNext").addClass("nextPrevious");
                    $("#btnSearchProductLast").removeClass("nextPreviousActive");
                    $("#btnSearchProductLast").addClass("nextPrevious");
                }
                defaultParameter.SearchText = SearchTextProduct;
                defaultParameter.Count = iCount;
                defaultParameter.MaxRecordCount = iMaxCount;
                defaultParameter.NavigationButtonType = navigationProductClick;
                defaultParameter.LabelText = null;
                defaultParameter.RecordPerPage = iRecordsPerPage;

                if (ApplicationNew.PresentTransactionMode == TransactionModes.get("EDITPREORDER")
                    || ApplicationNew.PresentTransactionMode == TransactionModes.get("VIEWPREORDER")
                    || ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION")) {
                    defaultParameter.Date = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionDateDT;
                }
                else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("NEWPREORDER")) {
                    if (ApplicationNew.PreOrderInfo == null || ApplicationNew.PreOrderInfo == undefined)
                        defaultParameter.Date = DATE.prototype.today(POSCommon.CalType);
                    else if (ApplicationNew.PreOrderInfo != null && ApplicationNew.PreOrderInfo != undefined && ApplicationNew.PreOrderInfo.PreOrderCollectionDate > 0)
                        defaultParameter.Date = ApplicationNew.PreOrderInfo.PreOrderCollectionDate;
                    else
                        defaultParameter.Date = DATE.prototype.today(POSCommon.CalType);
                }
                SEARCHCLAUSE.SEARCHPRODUCT.SERVERMETHOD.searchProduct(defaultParameter);
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: SEARCHCLAUSE.SEARCHPRODUCT.getSearchedProduct, Catch block : Error Message : " + Ex.message);
                return false;
            }
        },
