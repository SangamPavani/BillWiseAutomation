    getDiscountVoucherValidity: function (objDiscountVoucherReg) {
        try {
            let gross = 0;
            var applicationException = [];
            applicationException[0] = false; //bsuccess
            applicationException[1] = objDiscountVoucherReg;
            applicationException[2] = gross;
            applicationException[3] = null; //message

            //Checking Validity of the discount voucher if product are selected in discount voucher definition

            if (objDiscountVoucherReg.ProductsList != null && objDiscountVoucherReg.ProductsList != undefined && objDiscountVoucherReg.ProductsList.length > 0) {
                POSSCHEMEIMPLEMENTATIONGENERICS.assignSchemeImplementationClass(null);
                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DummyBill == null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DummyBill == undefined && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DummyBill.length <= 0)
                    POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DummyBill = POSSCHEMEIMPLEMENTATIONGENERICS.getProductToImplementSchemes(false, true, true, PreferenceSetting.PrefGeneralTab.SchemesImplementOnDefinedUnit, true);

                // Logic For All Items to be considered for discount

                if (POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_SchemesImplGeneric != null && POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.m_SchemesImplGeneric != undefined) {
                    if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0)
                        POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.DummyLineList = ApplicationNew.ListOfItems.filter((f) => f.DefaultValue3 > 0);
                }
                let _MatchedProducts = POSSCHEMEIMPLEMENTATIONGENERICS.getMatchedItemsWithDVProducts(objDiscountVoucherReg.ProductsList);
                if (_MatchedProducts != null && _MatchedProducts != undefined && _MatchedProducts.length > 0) {
                    for (let i = 0; i < _MatchedProducts.length; i++)
                        gross = gross + FConvert.toDecimal(_MatchedProducts[i].DefaultValue5, POSCommon.numberofDecimal) - FConvert.toDecimal(_MatchedProducts[i].DiscountTotal_UptoCurrentField, POSCommon.numberofDecimal);

                    applicationException[0] = true;
                    applicationException[1] = objDiscountVoucherReg;
                    applicationException[2] = gross;
                    return applicationException;
