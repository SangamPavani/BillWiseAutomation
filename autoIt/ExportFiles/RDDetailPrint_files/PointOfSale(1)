                                if (data.bSuccess == false) {
                                    toastr.error(data.sMessage);
                                }
                                else if (data.bSuccess == true) {
                                    unitIds = data.rtnValue;
                                    if (unitIds != null && unitIds != undefined && unitIds.length > 0) {
                                        let unitIdStringValue = "";
