    payPreOrderCollection: function () {
        try {
            if (PREORDER.DUSMINUTESAPPINTEGRATION.VARIABLES.DUSMinutesAppIntegrationEnable == true) {
                let totalVoucherLoadedQuantity = 0, totalProductQuantity = 0;
                // Calculating Original Voucher's Product Quantity
                if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != null
                    && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != undefined) {
                    if (ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData.length > 0) {

                        for (let i = 0; i < ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData.length; i++) {
                            if (ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData[i].Sales != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData[i].Sales != undefined)
                                totalVoucherLoadedQuantity = totalVoucherLoadedQuantity + Math.abs(ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData[i].Sales.Quantity);
                        }
                    }
                }

                // Calculating Voucher's Product Quantity
                for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                    totalProductQuantity = totalProductQuantity + ApplicationNew.ListOfItems[i].DefaultValue3;

                if (totalProductQuantity > totalVoucherLoadedQuantity) {
                    if (!(POSCommon.addProductInPreOrder == true && (POSCommon.changeQuantityInPreOrder == true || POSCommon.changeQuantityInPreOrder == false))) {
                        toastr.info("Item(s) total quantity (" + totalProductQuantity + ") should not be greater then Voucher's total quantity (" + totalVoucherLoadedQuantity + ").", "POS Information");
                        return;
                    }
                }
            }
            if (POSCommon.isEnableBatchNumbers == true && BILLSETTLEMENT.isValidBatchAssignment() == false)
                return;

            if (MESSAGEPOPUP.BILLSETTLEMENT.checkIsValidRMAForAllItems() == false)
                return;

            let msgPlsSelectPaymentMethodFromPref = $("input#msgPlsSelectPaymentMethodFromPref").val();
            var msgSelDeliveredBy = $("#msgSelDeliveredBy").val();
            let orderOutlet = OPTIONCONTROL.getControlValue("optPreOrderCollectionOrderOutlet");
            if (PreferenceSetting.PrefMiscellaneousOtherTab.ReceiveCallcenterPreorders == false) {
                if (PREORDERCOLLECTION.validateCollAllwdAtDiffrntOutletSetting(orderOutlet, POSCommon.outletId) == false)
                    return;
            }

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.PreorderPayMethods == null || PreferenceSetting.PrefOutletTab.OutletGeneralTab.PreorderPayMethods == undefined
                || PreferenceSetting.PrefOutletTab.OutletGeneralTab.PreorderPayMethods.trim() == "" || PreferenceSetting.PrefOutletTab.OutletGeneralTab.PreorderPayMethods.trim().length <= 0) {
                toastr.error(msgPlsSelectPaymentMethodFromPref);
                return null;
            }

            var controlValue = "";
            var isValid = PREORDERCOLLECTION.validateControl();
            if (isValid == false)
                return false;

            controlValue = FTIMECONTROL.getTime("tpPreOrderCollectionCollectedTime");
            if (controlValue == null || controlValue == undefined || controlValue == "" || FConvert.toInt(controlValue) <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionTimeInt = FTime.getCurrentTime();
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionTimeInt = controlValue;

            controlValue = OPTIONCONTROL.getControlValue("optPreOrderCollectionCollectedOutlet");
            if (controlValue == null || controlValue == undefined || controlValue == "" || FConvert.toInt(controlValue) <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionOutletId = POSCommon.outletId;
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionOutletId = controlValue;

            controlValue = OPTIONCONTROL.getControlText("optPreOrderCollectionCollectedOutlet");
            if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionOutletName = "";
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectionOutletName = controlValue;

            controlValue = $("#txtPreOrderCollectionCollectedBy").val();
            if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectedBy = "";
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.CollectedBy = controlValue;

            controlValue = $("#txtPreOrderCollectionContactNumber").val();
            if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.ContactNumber = "";
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.ContactNumber = controlValue;

            controlValue = $("#txtPreOrderCollectionRemarks").val();
            if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.Remarks = "";
            else
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.Remarks = controlValue;

            if (ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.DeliveryType == 1) //Home Delivery Type
            {
                controlValue = OPTIONCONTROL.getControlValue("optPreOrderCollectionDeliveredBy");
                if (controlValue == null || controlValue == undefined || controlValue == "0" || controlValue.trim().length <= 0) {
                    toastr.error(msgSelDeliveredBy);
                    return;
                }
                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredBy = controlValue;

                controlValue = OPTIONCONTROL.getControlText("optPreOrderCollectionDeliveredBy");
                if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredByName = "";
                else
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredByName = controlValue;

                controlValue = DATEPICKER.getDate("dpPreOrderCollectionCollectedDate");
                if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredDate = DATE.prototype.today(POSCommon.CalType);
                else
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredDate = controlValue;

                controlValue = FTIMECONTROL.getTime("tpPreOrderCollectionCollectedTime");
                if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredTime = FTime.getCurrentTime();
                else
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredTime = 0;

                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliveredDateTimeInt = 0;

                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.DeliveryTimeInterval == true) {
                    controlValue = OPTIONCONTROL.getControlValue("optPreOrderCollectionDeliveryTimeInterval");
                    if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0) {
                        ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliverTimeInterval = 0;
                        ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliverTimeIntervalName = "";
                    }
                    else {
                        ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliverTimeInterval = controlValue;
                        controlValue = OPTIONCONTROL.getControlText("optPreOrderCollectionDeliveryTimeInterval");
                        if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                            ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliverTimeIntervalName = "";
                        else
                            ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.DeliverTimeIntervalName = controlValue;
                    }
                }
                else {
                    controlValue = FTIMECONTROL.getTime("tpPreOrderCollectionHomeDeliveryTime");
                    if (controlValue == null || controlValue == undefined) {
                    }
                    else {
                    }
                }

                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.IsDelivered = true;

                controlValue = $("#txtPreOrderCollectionHomeDeliveryRemarks").val();
                if (controlValue == null || controlValue == undefined || controlValue == "" || controlValue.length <= 0)
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.Remarks = "";
                else
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.Remarks = controlValue;

                ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.EditingLocation = POSCommon.locationId;

                if (ApplicationNew.MemberData == null || ApplicationNew.MemberData == undefined || ApplicationNew.MemberData.ID <= 0 || ApplicationNew.MemberData.ID == PreferenceSetting.PrefMiscellaneousTab.DefaultMember)
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.MemberID = 0;
                else
                    ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.PreOrderHomeDelivery.MemberID = ApplicationNew.MemberData.ID;
            }

            var totalDeposit = FConvert.toDecimal($("#txtPreOrderCollectionAmountToPay").val()) + FConvert.toDecimal(PREORDERCOLLECTION.getDeposit());
            var orderStatus = 0;
            var nettAmount = $("#txtPreOrderCollectionTotalAmount").val();
            if (nettAmount != null && nettAmount != undefined && nettAmount.trim().length > 0)
                nettAmount = FConvert.toDecimal(nettAmount, POSCommon.numberOfDecimal);

            if (totalDeposit != null && totalDeposit != undefined) {
                if (totalDeposit == 0)
                    orderStatus = 1;
                else if (totalDeposit < FConvert.toDecimal(nettAmount))
                    orderStatus = 2;
                else if (totalDeposit == FConvert.toDecimal(nettAmount))
                    orderStatus = 4;
            }

            ApplicationNew.PreOrderInfo.LocalPreOrderDetails = Object.assign({}, ApplicationNew.PreOrderInfo.SelectedPreOrderDetails);
            ApplicationNew.PreOrderInfo.LocalPreOrderDetails.Deposit = FConvert.toDecimal(totalDeposit, POSCommon.numberOfDecimal);
            ApplicationNew.PreOrderInfo.LocalPreOrderDetails.Status = orderStatus;

            //Check For Negative Stock
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.CheckNegStock == true) {
                let itemsToCheckStock = [];
                if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                        if (ApplicationNew.ListOfItems[i].PosProductMake == PosProductMake.get("SET") || ApplicationNew.ListOfItems[i].ERPProductType == ProductType.get("SERVICE")
                            || ApplicationNew.ListOfItems[i].ERPProductType == ProductType.get("NONSTOCKITEM"))
                            continue;

                        if (ApplicationNew.ListOfItems[i].ProductType == 4)
                            continue;

                        let unitIdNamePair = new Object();
                        unitIdNamePair.ID = ApplicationNew.ListOfItems[i].DefaultValue1;
                        unitIdNamePair.Name = ApplicationNew.ListOfItems[i].DefaultValue2;
                        itemsToCheckStock.push(unitIdNamePair);
                    }
                }
                let preorderCollectionDetails = POSDATASTRUCTURE.getPreorderCollectionDetails();
                preorderCollectionDetails.ItemUnitIdNamePair = itemsToCheckStock;
                preorderCollectionDetails.YearId = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.YearId;
                preorderCollectionDetails.OrderNumber = ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.OrderNumber;
                preorderCollectionDetails.IsLoadedPreOrderCollection = ApplicationNew.PreOrderInfo.IsLoadedPreOrderCollection;
                preorderCollectionDetails.ManagerApproval = ApplicationNew.ManagerApproval;

                var rtnValue = PREORDERCOLLECTION.SERVERMETHODS.validatePreOrderCollection(preorderCollectionDetails);
                if (rtnValue != null && rtnValue != undefined) {
                    if (rtnValue.bSuccess == false) {
                        toastr.error(rtnValue.sMessage);
                        return;
                    }

                    if (rtnValue.bSuccess == true) {
                        if (rtnValue.sMessage != null && rtnValue.sMessage != undefined && rtnValue.sMessage.trim().length > 0) {
                            toastr.info(rtnValue.sMessage, "POS Information");
                            if (rtnValue.sPopupName != null && rtnValue.sPopupName != undefined && rtnValue.sPopupName.trim().length > 0) {
                                if (rtnValue.sPopupName == "COLLECTED")
                                    return;
                                else if (rtnValue.sPopupName == "MANAGERAPPROVALNEGATIVESTOCK") {
                                    if (rtnValue.preorderCollectionDetailsManagerApproval != null && rtnValue.preorderCollectionDetailsManagerApproval != undefined)
                                        ApplicationNew.ManagerApproval = rtnValue.preorderCollectionDetailsManagerApproval;

                                    VERIFICATIONPROCESS.clearVerificationProcessVariables();
                                    VERIFICATIONPROCESS.VARIABLES.ShortcutId = 1029;
                                    MANAGERAPPROVAL.openManagerApproval(VERIFICATIONPROCESS.VARIABLES.ShortcutId);
                                    return;
                                }
                            }
                        }
                    }
                }
            }

            //debugger;
            PREORDERCOLLECTION.PRIVATEVARIABLE.preOrderCollectionPayClick = true;
            var preOrderStatus = $("#ddlPreOrderCollectionStatus").val();
            if (preOrderStatus == 1 || preOrderStatus == 2) //New OR Deposit
            {
                //Open Header Extra Field screen, If any mandatory field is exist
                if (POSCommon.isPreOrderAnyMandatoryExistsInHeaderExtraFields == true || POSCommon.isPosSalesAnyMandatoryExistsInHeaderExtraFields == true) {
                    if (ApplicationNew.IsAllMandatoryHeaderExtraFieldsFilled == false) {
                        SHORTCUTMETHODS.loadShortcutFunction(124, false, ["divForModalSecond"], null);
                        return;
                    }
                }

                //Open Bill Settlement
                var arrValues = [];
                arrValues.push(FromScreen.get("PREORDERCOLLECTION"));
                arrValues.push("TRANSACTION.postPreOrderCollection()");
                arrValues.push(56);
                var billSettlementObject = BILLSETTLEMENT.getBillSettlementObject();
                arrValues.push(billSettlementObject);
                SHORTCUTMETHODS.loadShortcutFunction(56, false, arrValues, null);
                RETAILMAIN.setFocusBarCodeTextBox();
                return;
            }
            else if (preOrderStatus == 3) //Final Payment
            {
                //debugger;
                if (POSCommon.isPreOrderAnyMandatoryExistsInHeaderExtraFields == true || POSCommon.isPosSalesAnyMandatoryExistsInHeaderExtraFields == true) {
                    if (ApplicationNew.IsAllMandatoryHeaderExtraFieldsFilled == false) {
                        SHORTCUTMETHODS.loadShortcutFunction(124, false, ["divForModalSecond"], null);
                        return;
                    }
                }
                let controlValue = $("#txtPreOrderCollectionBalancePending").val();
                if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue, POSCommon.numberofDecimal) < 0) {
                    var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                    messageInfoPopup.Caption = "Confirmation Dialog";
                    messageInfoPopup.Message = [];
                    messageInfoPopup.Message[0] = "You will get the refund of amount '" + Math.abs(FConvert.toDecimal(controlValue, POSCommon.numberofDecimal)) + "'.";
                    messageInfoPopup.ButtonType = "Ok";
                    messageInfoPopup.OkMethod = "PREORDERCOLLECTION.preOrderCollectionFinalPayment()";
                    var arrValue = [];
                    arrValue.push(messageInfoPopup);
                    arrValue.push("divMessageInfo");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return;
                }
                else if (controlValue != null && controlValue != undefined && FConvert.toDecimal(controlValue, POSCommon.numberofDecimal) > 0) {
                    //Open Bill Settlement
                    var arrValues = [];
                    arrValues.push(FromScreen.get("PREORDERCOLLECTION"));
                    arrValues.push("TRANSACTION.postPreOrderCollection()");
                    arrValues.push(56);
                    var billSettlementObject = BILLSETTLEMENT.getBillSettlementObject();
                    arrValues.push(billSettlementObject);
                    SHORTCUTMETHODS.loadShortcutFunction(56, false, arrValues, null);
                    return;
                }
                if (ApplicationNew.PreOrderInfo.SelectedPreOrderDetails.Status == 3) {
                    debugger;
                    let result = POSSCHEMEIMPLEMENTATIONGENERICS.implementBillWiseSchemes();
                    debugger;
                    if (result != null && result != undefined && result[0] == true && result[1] == "MANAGERAPPROVALDISCOUNTAUTHORIZATIONSCHEMES")
                        return;

                    if (ApplicationNew.TotalSchemesInfo.PromptsToShow != null && ApplicationNew.TotalSchemesInfo.PromptsToShow != undefined && ApplicationNew.TotalSchemesInfo.PromptsToShow.length > 0)
                        BILLSETTLEMENT.SCHEMESMETHODS.openSchemeFreeItemSelectionScreen();
                    else if (ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != null && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts != undefined && ApplicationNew.TotalSchemesInfo.DiscountVoucherPrompts.length > 0)
                        BILLSETTLEMENT.SCHEMESMETHODS.openSchemeDiscountVoucherScreen();
                    else
                        PREORDERCOLLECTION.preOrderCollectionFinalPayment();
                }
            }
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + ", File: retailMainPreOrder.js, Method:PREORDERCOLLECTION.payPreOrderCollection, Catch block : Error Message : " + Ex.message);
        }
    },
