                POSSCHEMEIMPLEMENTATIONGENERICS.addToSchemePrompts_New(FromScreen, FreeItem.ProductID, FreeItem.ProductName, SchemeId, SchemeName, (_promptCount * FreeItem.Price), PromoTypes.get("FREEITEM"), _freeItemCount, _promptCount, Prompts, DoChanges, BodyId, BaseItems, FreeItem, null, FreeItemType);
