    fillBillPrintingFooter: function (arrBillPrintingFooter, fTotalSavingTotTransDisc, date,
        time, fBalanceMemberPoints, totalTransTaxFVatFTax, arrBillPrintingHeader,
        gSTAssumeIncl, gSTAdd, actCustomerAccount, fVATDiscountVal) {
        try {
            debugger;
            let billSettlementPaymentDetails = null;
            let fGrossAmount = 0, fDiscount = 0, fQTY = 0;
            if (VOUCHERPOSTING.VARIABLES.PreOrderInfo != null && VOUCHERPOSTING.VARIABLES.PreOrderInfo != undefined && VOUCHERPOSTING.VARIABLES.PreOrderInfo.RefundSettlement != null && VOUCHERPOSTING.VARIABLES.PreOrderInfo.RefundSettlement != undefined) {
                if (VOUCHERPOSTING.VARIABLES.PreOrderInfo.RefundSettlement.RefundSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.PreOrderInfo.RefundSettlement.RefundSettlementPaymentDetails != undefined) {
