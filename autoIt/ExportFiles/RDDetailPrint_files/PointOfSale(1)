    getBodyPanelCustomizationLineWiseAddClickEvent: function () {
        try {
            debugger;
            var msgalreadypresentinList = $("#msgalreadypresentinList").val();
            if (!RETAILMAINBODYPANELCUSTOMIZATION.validateLineControls())
                return;

            var bFResult = false;
            var sFieldName = OPTIONCONTROL.getControlText("optLineWiseFieldList");
            //Checking if Field Name already exists
            var linewiseList = [];
            var linewiseListInfo = $("#tbodyBodyPanelLineWiseFieldRecord tr");
            if (linewiseListInfo != null && linewiseListInfo != undefined && linewiseListInfo.length > 0) {
                for (let i = 0; i < linewiseListInfo.length; i++) {
                    var parsedlinewiseListInfo = $(linewiseListInfo[i]).attr("data-LineWiseData");
                    if (parsedlinewiseListInfo != null && parsedlinewiseListInfo != undefined) {
                        parsedlinewiseListInfo = JSON.parse(parsedlinewiseListInfo);
                        linewiseList.push(parsedlinewiseListInfo);
                    }
                }
            }
            var footerList = [];
            var footerListInfo = $("#tbodyBodyPanelFooterFieldRecord tr");
            if (footerListInfo != null && footerListInfo != undefined && footerListInfo.length > 0) {
                for (let i = 0; i < footerListInfo.length; i++) {
                    var parsedFooterListInfo = $(footerListInfo[i]).attr("data-FooterList");
                    if (parsedFooterListInfo != null && parsedFooterListInfo != undefined) {
                        parsedFooterListInfo = JSON.parse(parsedFooterListInfo);
                        footerList.push(parsedFooterListInfo);
                    }
                }
            }
            var fieldData = linewiseList.filter((p) => p.Name == sFieldName);
            var footerFieldData = footerList.filter((p) => p.Name == sFieldName);
            if (fieldData != null && fieldData != undefined && fieldData.length > 0) {
                toastr.error("Field Name " + "'" + sFieldName + "'" + msgalreadypresentinList);
                bFound = true;
                if ($("#txtLineWiseAlias").attr("readonly") == true) {
                    RETAILMAINBODYPANELCUSTOMIZATION.clearAllControls();
                    RETAILMAINBODYPANELCUSTOMIZATION.makeLineControlsReadOnly(false);
                }
                return;
            }
            else if (footerFieldData != null && footerFieldData != undefined && footerFieldData.length > 0) {
                toastr.error("Field Name " + "'" + sFieldName + "'" + msgalreadypresentinList);
                bFound = true;
                if ($("#txtLineWiseAlias").attr("readonly") == true) {
                    RETAILMAINBODYPANELCUSTOMIZATION.clearAllControls();
                    RETAILMAINBODYPANELCUSTOMIZATION.makeLineControlsReadOnly(false);
                }
                return;
            }
            else
                RETAILMAINBODYPANELCUSTOMIZATION.getBodyPanelCustomizationLineWiseRecords();

            RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.isSaveClicked = true;
        }
        catch (Ex) {
