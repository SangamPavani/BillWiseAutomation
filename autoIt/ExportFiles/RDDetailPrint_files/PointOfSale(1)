                                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                        responseDiscountCellValue[0] = true;// rtnAvgPrice[0];
                                        responseDiscountCellValue[1] = rtnAvgPrice[1];
                                        return responseDiscountCellValue;
                                    }
                                    else if (FConvert.toBoolean(rtnAvgPrice[0]) == true && rtnAvgPrice[1] != null && rtnAvgPrice[1] != undefined && rtnAvgPrice[1].length > 0) {
                                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                        responseDiscountCellValue[0] = true;// rtnAvgPrice[0];
                                        responseDiscountCellValue[2] = rtnAvgPrice[1];
                                        return responseDiscountCellValue;
                                    }
                                }
                            }
                            else {
                                let rtnPriceBookRate = [];
                                rtnPriceBookRate = PRODUCTSELECTION.validateDiscountWithPriceBookRate(ApplicationNew.CurrentItem, 1050);
                                if (rtnPriceBookRate != null && rtnPriceBookRate != undefined && rtnPriceBookRate.length > 0 && rtnPriceBookRate[0] != null && rtnPriceBookRate[0] != undefined) {
                                    if (FConvert.toBoolean(rtnPriceBookRate[0]) == false) {
                                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                        responseDiscountCellValue[1] = rtnPriceBookRate[1];
                                        return responseDiscountCellValue;
                                    }
                                    else if (FConvert.toBoolean(rtnPriceBookRate[0]) == true && rtnPriceBookRate[1] != null && rtnPriceBookRate[1] != undefined && rtnPriceBookRate[1].length > 0) {
                                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                        CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                        responseDiscountCellValue[0] = true;
                                        responseDiscountCellValue[2] = rtnPriceBookRate[1];
                                        return responseDiscountCellValue;
                                    }
                                }
                            }
                        }

                        // CutOff Price / Manager Approval
                        let rtnCutOffPrice = [];
                        rtnCutOffPrice = PRODUCTSELECTION.validateDiscountWithCutOffPrice(ApplicationNew.CurrentItem, 1005);
                        if (rtnCutOffPrice.length > 0 && rtnCutOffPrice[0] != null && rtnCutOffPrice[0] != undefined) {
                            if (FConvert.toBoolean(rtnCutOffPrice[0]) == false) {
                                ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                responseDiscountCellValue[0] = true;
                                responseDiscountCellValue[2] = rtnCutOffPrice[1];
                                return responseDiscountCellValue;
                            }
                            else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && FConvert.toString(rtnCutOffPrice[1]) != null && FConvert.toString(rtnCutOffPrice[1]) != undefined && rtnCutOffPrice[1].length > 0) {
                                ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
                                CALCULATION.calculateLineWiseNet(ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1], ApplicationNew);
                                responseDiscountCellValue[2] = rtnCutOffPrice[1];
                                return responseDiscountCellValue;
                            }
                            else if (FConvert.toBoolean(rtnCutOffPrice[0]) == true && rtnCutOffPrice[1] == "") {
                                if (rtnCutOffPrice[2] != null && rtnCutOffPrice[2] != undefined && rtnCutOffPrice.length > 2) {
                                    //ApprovalRecord objApprovalRecordCutOffPrice = (ApprovalRecord)rtnCutOffPrice[2];
                                    //CommonPos mgrPreferences = GetUserPreferences(objApprovalRecordCutOffPrice.ApprovalId);
                                    let dCutOffPriceForMgr = PRODUCTSELECTION.UIMETHODS.getUnitAndQuantityWiseRate(ApplicationNew.CurrentItem.DefaultValue1, ApplicationNew.CurrentItem.ProductUnit, Math.abs(ApplicationNew.CurrentItem.DefaultValue3), ApplicationNew.CurrentItem.CutOffPriceIndex);

                                    if ((Math.abs(ApplicationNew.CurrentItem.DefaultValue3) * dCutOffPriceForMgr) > (Math.abs(ApplicationNew.CurrentItem.DefaultValue3 * ApplicationNew.CurrentItem.DefaultValue4) - dCurrentCellEnteredValue)) {
                                        ApplicationNew.CurrentItem.DynamicLineFields[objColumnRecord.ColumnIndex].FieldInput = dPrevDiscExtFldVal;
                                        ApplicationNew.ListOfItems[ApplicationNew.CurrentItem.ItemSerialNo - 1] = ApplicationNew.CurrentItem;
