    roundOffNetAmt: function (inputControlCashAmount, dSchemeAmt, paymenttype) {
        try {
            var dAmtAftrRoundOff = 0;
            var selectedCurrency = BillSettlement.SelectedCurrency;
            var msgBSRoundOffFldValidation = $("#msgBSRoundOffFldValidation").val();
            var PaymentRoundOffs = PreferenceSetting.PrefOutletTab.OutletGeneralTab.PaymentRoundOffs;

            if ((PaymentRoundOffs == null || PaymentRoundOffs == undefined)
                || BillSettlement.Screen == FromScreen.get("GIFTVOUCHERSALE")
                || BillSettlement.Screen == FromScreen.get("WNDCREDITSALE") ||
                (BillSettlement.ModuleType == ModuleType.get("RESTAURANT")
                    || PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableNetRoundOff == true))
                return inputControlCashAmount;

            var _NetRoundOffPref = null;
            for (let i = 0; i < PaymentRoundOffs.length; i++) {
                if (PaymentTypes.get(PaymentRoundOffs[i].PaymentType) == paymenttype) {
                    _NetRoundOffPref = PaymentRoundOffs[i];
                    break;
                }
            }

            if (_NetRoundOffPref == null || _NetRoundOffPref == undefined || _NetRoundOffPref.RoundoffValue == 0)
                return inputControlCashAmount;


            //Checking whether Round off customized field exists in footer of POS Sales voucher
            if (BillSettlement.ModuleType == ModuleType.get("RETAIL")) {
                if (BillSettlement.FooterColMap == null || BillSettlement.FooterColMap == undefined) {
                    dAmtAftrRoundOff = FConvert.toDecimal(inputControlCashAmount.trim());
                    BillSettlement.RoundOff = 0;
                    toastr.error(msgBSRoundOffFldValidation);
                    return dAmtAftrRoundOff;
                }
                else if (BillSettlement.FooterColMap != null && BillSettlement.FooterColMap != undefined && BillSettlement.FooterColMap.length > 0) {
                    var footerColMapExist = BillSettlement.FooterColMap.filter((p) => p.FieldBehaviour == FieldBehaviour.get("ROUNDOFF"));
                    if (footerColMapExist == null || footerColMapExist == undefined || footerColMapExist.length <= 0) {
                        dAmtAftrRoundOff = FConvert.toDecimal(inputControlCashAmount.trim());
                        BillSettlement.RoundOff = 0;
                        toastr.error(msgBSRoundOffFldValidation);
                        return dAmtAftrRoundOff;
                    }
                }
            }
            else if (BillSettlement.ModuleType == ModuleType.get("RESTAURANT")) {
                if (BillSettlement.RestFooterColMap == null || BillSettlement.RestFooterColMap == undefined) {
                    dAmtAftrRoundOff = FConvert.toDecimal(inputControlCashAmount.trim());
                    BillSettlement.RoundOff = 0;
                    toastr.error(msgBSRoundOffFldValidation);
                    return dAmtAftrRoundOff;
                }
                else if (BillSettlement.RestFooterColMap != null && BillSettlement.RestFooterColMap != undefined && BillSettlement.RestFooterColMap.length > 0) {
                    var footerColMapExist = BillSettlement.RestFooterColMap.filter((p) => p.FieldBehaviour == FieldBehaviour.get("ROUNDOFF"));
                    if (footerColMapExist == null || footerColMapExist == undefined || footerColMapExist.length <= 0) {
                        dAmtAftrRoundOff = FConvert.toDecimal(inputControlCashAmount.trim());
                        BillSettlement.RoundOff = 0;
                        toastr.error(msgBSRoundOffFldValidation);
                        return dAmtAftrRoundOff;
                    }
                }
            }


            var _cashPaid = FConvert.toDecimal(inputControlCashAmount);
            var dBalancAmtAfterSchemeDisc = BillSettlement.BalanceAmount - dSchemeAmt;
            if (_cashPaid < dBalancAmtAfterSchemeDisc) {
                dAmtAftrRoundOff = _cashPaid;
                return _cashPaid;
            }

            var _BalanceAmtRoundOff = COMMONMETHODS.UTILITYMETHODS.roundOff(dBalancAmtAfterSchemeDisc, FConvert.toDecimal(_NetRoundOffPref.RoundoffValue), _NetRoundOffPref.RoundOffType, 3);
            BillSettlement.RoundOff = dBalancAmtAfterSchemeDisc - _BalanceAmtRoundOff;
            BillSettlement.RoundOff = BillSettlement.RoundOff * COMMONMETHODS.UTILITYMETHODS.getRoundOffSign(_NetRoundOffPref, BillSettlement.RoundOff);
            var balanceAmountRoundOff = FConvert.addNumericSeparator(FConvert.toDecimal(_BalanceAmtRoundOff, POSCommon.numberOfDecimals));
            BillSettlement.BalanceAmount = balanceAmountRoundOff;
            if (paymenttype == PaymentTypes.get("CASH")) {
                //Rounding off Cash amount
                if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowMultipleCurrencies == true
                    && BillSettlement.SelectedCurrency.IsBaseCurrency == false && BillSettlement.SelectedCurrency.GeneralRoundOff != 0) {
                    dAmtAftrRoundOff = COMMONMETHODS.UTILITYMETHODS.roundOff(_cashPaid, BillSettlement.SelectedCurrency.GeneralRoundOff, BillSettlement.SelectedCurrency.RoundOffType);
                    return dAmtAftrRoundOff;
                }
                else {
                    dAmtAftrRoundOff = COMMONMETHODS.UTILITYMETHODS.roundOff(_cashPaid, _NetRoundOffPref.RoundoffValue, _NetRoundOffPref.RoundOffType);
                    return dAmtAftrRoundOff;
                }
            }
            else
                dAmtAftrRoundOff = COMMONMETHODS.UTILITYMETHODS.roundOff(_cashPaid, _NetRoundOffPref.RoundoffValue, _NetRoundOffPref.RoundOffType);
            return dAmtAftrRoundOff;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.roundOffNetAmt, Catch block : Error Message : " + Ex.message);
            return false;
        }
