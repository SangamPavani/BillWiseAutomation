            //Checking adding product rights while editing transaction
            if (ApplicationNew.PresentTransactionMode == 2 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictAddNewProdWhileEditTran == true
                && ApplicationNew.IsRecallTransaction == false) {
                toastr.info("Not allowed to add Item while editing transaction.", "POS Information");
