            tagValue.ID = 1111;
            tagValue.Tag = 0;
            arrTags.push(tagValue);

            arrTransBody[SalesInvoiceTransactionBodyIndex.Tags] = arrTags;
            if (custLineWise.ProductType == 2 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.SpoiledGoodsTag > 0) {
                arrTransBody[SalesInvoiceTransactionBodyIndex.InvTag] = PreferenceSetting.PrefOutletTab.OutletGeneralTab.SpoiledGoodsTag;
                arrTransBody[SalesInvoiceTransactionBodyIndex.FATag] = PreferenceSetting.PrefOutletTab.OutletGeneralTab.SpoiledGoodsTag;
