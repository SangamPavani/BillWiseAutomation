    beforeOpenHeaderExtraFieldScreen: function () {
        try {
            let iVoucherType = 0;
            switch (ApplicationNew.PresentTransactionMode) {
                case TransactionModes.get("NEWPOSSALES"):
                case TransactionModes.get("EDITPOSSALES"):
                    iVoucherType = PreferenceSetting.PrefPostingTab.POSVoucher;

                    if (POSCommon.posTemplate != null && POSCommon.posTemplate != undefined) {
                        if (POSCommon.posTemplate.IsEstimatedBill == true)
                            iVoucherType = PreferenceSetting.PrefPostingTab.PreOrderVoucher;
                    }
                    if (ApplicationNew.SalesReturn != null && ApplicationNew.SalesReturn != undefined && ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined)
                        iVoucherType = PreferenceSetting.PrefPostingTab.SalesReturnVoucher;

                    if ((ApplicationNew.HeaderExtraFieldsData == null || ApplicationNew.HeaderExtraFieldsData == undefined)
                        && ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction != null && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra != null && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra != undefined && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra.length > 0)
                        ApplicationNew.HeaderExtraFieldsData = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra;
                    break;
                case TransactionModes.get("HOMEDELIVERY"):
                case TransactionModes.get("HOMEDELIVERYFEEDBACK"):
                    iVoucherType = PreferenceSetting.PrefPostingTab.DeliveryNoteVoucher;
                    if ((ApplicationNew.HeaderExtraFieldsData == null || ApplicationNew.HeaderExtraFieldsData == undefined)
                        && ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction != null && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra != null && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra != undefined && ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra.length > 0)
                        ApplicationNew.HeaderExtraFieldsData = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.HeaderExtra;
                    break;
                case TransactionModes.get("SPLITBILLSALES"):
                    break;
                case TransactionModes.get("NEWPREORDER"):
                case TransactionModes.get("VIEWPREORDER"):
                case TransactionModes.get("EDITPREORDER"):
                case TransactionModes.get("PREORDERCOLLECTION"):
                    iVoucherType = PreferenceSetting.PrefPostingTab.PreOrderVoucher;
                    if ((ApplicationNew.HeaderExtraFieldsData == null || ApplicationNew.HeaderExtraFieldsData == undefined)
                        && ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                        && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction != undefined) {
                        if (ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.HeaderExtra != null && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.HeaderExtra != undefined && ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.HeaderExtra.length > 0)
                            ApplicationNew.HeaderExtraFieldsData = ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.HeaderExtra;
                    }
                    break;
            }

            if (ApplicationNew.TaxCodeInfo == null || ApplicationNew.TaxCodeInfo == undefined)
                ApplicationNew.TaxCodeInfo = new Object();

            if (ApplicationNew.RetailTransFooter != null && ApplicationNew.RetailTransFooter != undefined) {
                if (ApplicationNew.RetailTransFooter.FooterFieldsList != null && ApplicationNew.RetailTransFooter.FooterFieldsList != undefined) {
                    var arrFooterFieldList = ApplicationNew.RetailTransFooter.FooterFieldsList.filter((p) => p.FieldBehaviour == FieldBehaviour.get("TAXCODEFOOTER"));
                    if (arrFooterFieldList != null && arrFooterFieldList != undefined && arrFooterFieldList.length > 0)
                        ApplicationNew.TaxCodeInfo.TaxCodeFooterField = arrFooterFieldList[0];
                }
            }

            let headerExtraFieldWeb = new Object();
            headerExtraFieldWeb.TaxCodeFooterField = ApplicationNew.TaxCodeInfo.TaxCodeFooterField;
            if (POSCommon.posTemplate != null && POSCommon.posTemplate != undefined) {
                if (POSCommon.posTemplate.IsEstimatedBill == true)
                    headerExtraFieldWeb.PresentTransactionMode = TransactionModes.get("NEWPREORDER");
                else
                    headerExtraFieldWeb.PresentTransactionMode = ApplicationNew.PresentTransactionMode;
            }
            else
                headerExtraFieldWeb.PresentTransactionMode = ApplicationNew.PresentTransactionMode;

            headerExtraFieldWeb.TaxCodeHeaderExtraFieldsData = ApplicationNew.TaxCodeInfo.TaxCodeHeaderExtraFieldsData;
            headerExtraFieldWeb.iVoucherType = iVoucherType;
            return headerExtraFieldWeb;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method:BILLSETTLEMENT.UIMETHODS.beforeOpenHeaderExtraFieldScreen, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
