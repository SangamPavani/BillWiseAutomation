                    //    return;
                    //});

                }
                if (footerField == null || footerField == undefined)
                    return;

                footerField = footerField[0];
                roundOff = parseFloat(roundOff * COMMONMETHODS.UTILITYMETHODS.getRoundOffSign(POSCommon.netRoundOffPreference, roundOff)).toFixed(POSCommon.numberOfDecimal);
                footerFieldData = ApplicationNew.RetailTransFooter.DynamicFooterFields.filter((p) => p.FieldId == footerField.ID);
