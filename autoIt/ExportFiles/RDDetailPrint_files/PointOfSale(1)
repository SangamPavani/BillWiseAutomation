                SCHEMES.SCHEMESBUTTONCLICK.GetItemIdAndItemName();

                var selSchemeTypId = $("#ddlSchemeType option:selected").attr("id");
                var selDiscountType = $("#ddlDiscountType option:selected").attr("value");
                if (FConvert.toInt(selSchemeTypId) == 2) {

                    if (SCHEMES.VARIABLE.ItemId == null && SCHEMES.VARIABLE.ItemId == undefined || SCHEMES.VARIABLE.ItemId.trim().length <= 0) {
                        COMMON.prototype.showMessage(txtPleaseIncludeAtleastOneItemAsMandInTheCriteria, "");
