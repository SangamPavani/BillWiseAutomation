    verifyOTP: function (isPrePaidWallet) {
        try {
            let msgProblemWhileReadingOTP = $("#msgProblemWhileReadingOTP").val();
            let msgProblemWhileReadingMobileNumber = $("#msgProblemWhileReadingMobileNumber").val();
            var controlValueMobile = "";
            if ($("#txtMemberPointPrepaidMobile").val() != null && $("#txtMemberPointPrepaidMobile").val() != undefined && $("#txtMemberPointPrepaidMobile").val().trim().length > 0)
                controlValueMobile = $("#txtMemberPointPrepaidMobile").val()
            else if ($("#txtPointsRedemptionMobile").val() != null && $("#txtPointsRedemptionMobile").val() != undefined && $("#txtPointsRedemptionMobile").val().trim().length > 0)
                controlValueMobile = $("#txtPointsRedemptionMobile").val();

            if (controlValueMobile == null || controlValueMobile == undefined || controlValueMobile.trim().length <= 0) {
                toastr.error(msgProblemWhileReadingMobileNumber);
                return;
            }
            var controlValueOTP = "";
            if ($("#txtMemberPointPrepaidMobileOTP").val() != null && $("#txtMemberPointPrepaidMobileOTP").val() != undefined && $("#txtMemberPointPrepaidMobileOTP").val().trim().length > 0)
                controlValueOTP = $("#txtMemberPointPrepaidMobileOTP").val();
