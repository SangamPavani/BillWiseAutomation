    PAYMENTINTEGRATION: {
        showPaymentIntegrationTabSetting: function () {
            try {
                if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab == null || PREFERENCE.VARIABLE.PrefPaymentIntegrationTab == undefined)
                    return;

                var paymentIntegration = $("#divPreferenceMainTab").attr("data-PrefPaymentIntegrationTab");
                if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.IsPaymentIntegrationEnable == true)
                    $("#chkPaymentIntegrationTab").prop("checked", "checked");
                else
                    $("#chkPaymentIntegrationTab").prop("checked", false);

                $("#ddlProvider").val(PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationProvider);
                PREFERENCE.PAYMENTINTEGRATION.onChangePaymentIntegration();
                PREFERENCE.PAYMENTINTEGRATION.onSelectProvider();

                let paymentIntegrationType = $("#divInnovitiType").attr("data-PaymentIntegrationType");
                if (paymentIntegrationType != null && paymentIntegrationType != undefined)
                    var parsedPaymentIntegrationType = JSON.parse(paymentIntegrationType);
                if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationType != null && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationType != "" &&
                    PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationType != undefined && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationType.length > 0) {
                    if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationTypeId != null && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationTypeId != "" &&
                        PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationTypeId != undefined && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationTypeId.length > 0) {
                        var arrPaymentIntegrationType = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationType.split(',');
                        var arrPaymentIntegrationTypeId = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationTypeId.split(',');
                        var IdNamePair = new Object();
                        var arrValue = [];
                        if (parsedPaymentIntegrationType != null && parsedPaymentIntegrationType != undefined && parsedPaymentIntegrationType != "") {
                            for (let i = 0; i < parsedPaymentIntegrationType.length; i++) {
                                for (let j = 0; j < arrPaymentIntegrationType.length; j++) {
                                    if (arrPaymentIntegrationType[j].trim() == parsedPaymentIntegrationType[i].Name) {
                                        for (let k = 0; k < arrPaymentIntegrationTypeId.length; k++) {
                                            if (arrPaymentIntegrationTypeId[k].trim() == parsedPaymentIntegrationType[i].ID) {
                                                var IdNamePair = new Object();
                                                IdNamePair.ID = parsedPaymentIntegrationType[i].ID;
                                                IdNamePair.Name = parsedPaymentIntegrationType[i].Name;
                                                arrValue.push(IdNamePair);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    LISTCHECKBOXCONTROL.setControlData("ddlPaymentIntegrationType", arrValue);
                }

                if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText != null && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText != "" &&
                    PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText != undefined && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText.length > 0) {
                    if (PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId != null && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId != "" &&
                        PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId != undefined && PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId.length > 0) {

                        var arrCounterText = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText.split(',');
                        var arrCounterId = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId.split(',');
                        var arrValue = [];
                        for (let i = 0; i < PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounter.length; i++) {
                            for (let j = 0; j < arrCounterText.length; j++) {
                                if (arrCounterText[j].trim() == PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounter[i].Name) {
                                    for (let k = 0; k < arrCounterId.length; k++) {
                                        if (arrCounterId[k].trim() == PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounter[i].ID) {
                                            var IdNamePair = new Object();
                                            IdNamePair.ID = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounter[i].ID;
                                            IdNamePair.Name = PREFERENCE.VARIABLE.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounter[i].Name;
                                            arrValue.push(IdNamePair);
                                        }
                                    }
                                }
                            }
                        }
                        LISTCHECKBOXCONTROL.setControlData("ddlNotRequiredForCounters", arrValue);
                    }
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainPreference.js :: Method :: PREFERENCE.PAYMENTINTEGRATION.showPaymentIntegrationTabSetting:: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
                return false;
            }
