                        if (jobRelatedTag == null || jobRelatedTag == undefined || jobRelatedTag.length <= 0)
                            arrTags.push(ApplicationNew.PreviousTransaction.LoadedPreOrderTransaction.BodyData[tempCounter].Tags[bodyTagCounter]);
