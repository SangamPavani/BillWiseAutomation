    PayGiftVoucherSale: function () {
        try {
            let isFromMainScreen = JSON.parse($('#divGiftVoucherSaleModal').attr('data-GiftVouchersalescreenDetails'));
            if (isFromMainScreen != null && isFromMainScreen != undefined)
                GIFTVOUCHERSALE.PRIVATEVARIABLE.isOpenFromMainScreen = isFromMainScreen;

