    getPointsConvertData: function () {

        try {
            //////debugger;
            var txtPointsConvert = FConvert.toDecimal($("#txtManualCreditNotePointsConvert").val());
            //            if (txtPointsConvert <= 0)
            //            {
            //                toastr.error(" Points to be converted should be greater than zero");
            //                $("#txtManualCreditNotePointsConvert").focus();
            //                return false;
            //}
            var txtPointsAccumlation = FConvert.toDecimal($("#txtManualCreditNotePoints").val());
            var selectedMemberTypeId = OPTIONCONTROL.getControlDataObject("optMemberType");
            var selectedMemberName = OPTIONCONTROL.getControlDataObject("optMemberName");
            var msgtxtInfoConvertPointLessAccPoint = $("#msgtxtInfoConvertPointLessAccPoint").val();
            var msgtxtInfoPlsSelMemberType = $("#msgtxtInfoPlsSelMemberType").val();
            var msgtxtInfoPlsSelMemberName = $("#msgtxtInfoPlsSelMemberName").val();
            if (selectedMemberTypeId == null || selectedMemberTypeId == undefined ||
                selectedMemberTypeId.iMasterId == undefined ||
                selectedMemberTypeId.iMasterId == 0 || selectedMemberTypeId.iMasterId == null) {
                toastr.error(msgtxtInfoPlsSelMemberType);
                $("#optMemberType").focus();
                return false;
            }
            if (selectedMemberName == null || selectedMemberName == undefined ||
                selectedMemberName.iMasterId == undefined ||
                selectedMemberName.iMasterId == 0 || selectedMemberName.iMasterId == null) {
                toastr.error(msgtxtInfoPlsSelMemberName);
                $("#optMemberName").focus();
                return false;
            }


            if ((($("#txtManualCreditNotePoints").length) == 0) && ($("#txtManualCreditNotePointsConvert").length)) {
                $("#txtManualCreditNoteBalancePoints").val("");
                $("#txtManualCreditNoteAmount").val("");
                return false;
            }
            else if (txtPointsConvert > txtPointsAccumlation) {
                toastr.error(msgtxtInfoConvertPointLessAccPoint);
                $("#txtManualCreditNotePointsConvert").focus();
                return false;
            }
            else {
                var dBalPoint = txtPointsAccumlation - txtPointsConvert;
                if (dBalPoint < 0)
                    $("#txtManualCreditNoteBalancePoints").val("");
                else
                    $("#txtManualCreditNoteBalancePoints").val(FConvert.toDecimal(dBalPoint, CREDITNOTE.VARIABLE.posCommon.numberOfDecimal));
                var txtPointsRedemption = FConvert.toDecimal($("#txtManualCreditNoteRedemptionValue").val());
                if ($("#txtManualCreditNoteRedemptionValue").length > 0)
                    var amount = txtPointsConvert * txtPointsRedemption;
                $("#txtManualCreditNoteAmount").val(FConvert.toDecimal(amount, CREDITNOTE.VARIABLE.posCommon.numberOfDecimal));
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd(); toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method:CREDITNOTE.getPointsConvertData, Catch block : Error Message : " + Ex.message);
