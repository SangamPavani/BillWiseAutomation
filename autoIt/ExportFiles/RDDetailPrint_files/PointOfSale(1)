                    var aTag = $("#divPreferenceTab a.pref_Selected_Tab");
                    var selectedTab = $(aTag).prop("id");
                    if (selectedTab == "OUTLET" || selectedTab == "PREORDER" || selectedTab == "PAYMENT" || selectedTab == "REFUNDPOLICY" || selectedTab == "HOMEDELIVERY" || selectedTab == "DAYEND" || selectedTab == "RESTAURANT") {
                        outletTab.OutletTabFlag = 1;
                    }
                    if (selectedTab == "ACCOUNT") {
                        outletTab.OutletTabFlag = 2;
                    }
                    if (selectedTab == "PRINTFORMATS") {
                        outletTab.OutletTabFlag = 3;
                    }
                }

                outletTab.OutletId = $('#ddlOutlets option:selected').attr('value');
                outletTab.OutletGeneralTab = outletGeneralTab;
                outletTab.OutletAccountsTab = outletAccountTab;
                outletTab.OutletPrintFormatsTab = outletPrintFormatTab;

                var outletPreference = new Object();
                outletPreference.PrefOutletTab = outletTab;

                return outletPreference;
            }
