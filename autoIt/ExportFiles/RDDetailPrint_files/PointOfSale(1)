                        return false;
                    }
                }
                else {
                    SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays = LISTCHECKBOXCONTROL.getControlData("ddlMonthdaysMem");
                    if (SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.lstMemberWeekDays.length == 0) {
                        toastr.error(selectDays);
                        $("ddlMonthdaysMem").focus();
                        return false;
                    }
                }

                if ($("#ddlMemberTypeScheme").val() <= 0) {
                    toastr.error(pleaseSelectMemberType);
                    return false;
                }
                if ($("#tbodyMemberDiscount tr").length == 0) {
                    toastr.error(pleaseAddDiscountDefinition);
                    return false;
                }
                if ($("#ddlSchemeTypeMem").val() == 2) {
                    if (SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.MemberSchemeInfo != null && SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.MemberSchemeInfo != undefined && SCHEMESDISCOUNT.MEMBERDISCOUNT.VARIABLE.MemberSchemeInfo.length > 0) {
