            if (bSuccess == false)
                return;
            if (data.bSuccess == true) {
                CREDITNOTE.VARIABLE.preferenceSetting = CREDITNOTE.VARIABLE.preferenceSetting;
                CREDITNOTE.VARIABLE.posCommon = CREDITNOTE.VARIABLE.posCommon;

                if (data.CreditNoteExtendValidityWeb != null && data.CreditNoteExtendValidityWeb != undefined) {
                    $("#objExtendValidity").val(JSON.stringify(data.CreditNoteExtendValidityWeb));
                    if (data.CreditNoteExtendValidityWeb.CreditNoteStatus == CreditNoteStatus.get("USED")) {
                        toastr.error(msgCreditNoteisalreadyfullyused);
                        CREDITNOTE.clearCreditNoteInfo();
                        return;
                    }

                    $("#txtCreditNoteAmount").val(data.CreditNoteExtendValidityWeb.CreditNoteAmount);
                    //////debugger;
                    if (data.CreditNoteExtendValidityWeb.CreditNoteStatus == CreditNoteStatus.get("UNUSED"))
                        $("#rdbtnUnused").prop("checked", true);
