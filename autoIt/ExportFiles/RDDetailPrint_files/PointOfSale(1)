                                cardIntegrationResponse.RRN_No = FConvert.toString(pineLabsConfirmStatusResponseArgs.TransactionData[prc].Value);
                                break;
                            case "ApprovalCode":
                                cardIntegrationResponse.ApprovalCode = FConvert.toString(pineLabsConfirmStatusResponseArgs.TransactionData[prc].Value);
                                break;
                            case "Invoice Number":
                                cardIntegrationResponse.BankInvoice_Num = FConvert.toString(pineLabsConfirmStatusResponseArgs.TransactionData[prc].Value);
                                break;
                            case "Card Number":
