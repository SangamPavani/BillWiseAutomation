                    toastr.info(msgFromDateToDateShouldBelessThanOrEqualToTodayDate, "POS Information");
                    $("#dtpMsgBrdCastDeleteFromDate").focus();
                    return false;
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: MESSAGEBROADCAST.checkMessageBroadCastDateSelection, Catch block : Error Message : " + Ex.message);
