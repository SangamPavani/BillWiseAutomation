                            let discPrompt = ApplicationNew.TotalSchemesInfo.LinePrompts.filter((p) => p.PromoType == PromoTypes.get("DISCOUNT") && p.ProductId == SchemesImplementedProds[ic].DefaultValue1);
                            if (discPrompt != null && discPrompt != undefined && discPrompt.length > 0) {
