                        if (BILLSETTLEMENT.VARIABLE.cNDetails == null || BILLSETTLEMENT.VARIABLE.cNDetails == undefined || BILLSETTLEMENT.VARIABLE.cNDetails.length <= 0)
                            dCreditNoteAmountUnpaid = BILLSETTLEMENT.VARIABLE.dCNValue - BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt;
                        else
                            dCreditNoteAmountUnpaid = BILLSETTLEMENT.VARIABLE.dCNValue - (BILLSETTLEMENT.VARIABLE.cNDetails.RedeemedAmount + BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt);


                        if (dCreditNoteAmountUnpaid > 0) {
