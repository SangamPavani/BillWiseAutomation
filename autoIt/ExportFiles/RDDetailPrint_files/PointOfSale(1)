                    sHexaColor = "00";

                iColorVal = (iColorVal % (0x10000));

                shValue = (iColorVal / (0x100)); // green
                //sHexaColor = sHexaColor + shValue.ToString("X").Substring(0, 2);
                strVal = shValue.toString(16);
                if (strVal.length >= 2)
                    sHexaColor += strVal.substring(0, 2);
                else
                    sHexaColor += "00";

                shValue = (iColorVal % (0x100));  //blue
                //sHexaColor = sHexaColor + shValue.ToString("X").Substring(0, 2);
                strVal = shValue.toString(16);
                if (strVal.length >= 2)
