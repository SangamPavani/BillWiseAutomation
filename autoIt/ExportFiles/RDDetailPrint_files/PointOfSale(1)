        try {
            RefundSettlement = REFUNDSETTLEMENTDATASTRUCTURE.getEmptyRefundSettlement();
            RefundSettlement.FromScreen = 15;
            RefundSettlement.BillAmount = depositAmount;
            RefundSettlement.NetAmount = RefundSettlement.BillAmount;
            RefundSettlement.AmountToPay = RefundSettlement.BillAmount;
            RefundSettlement.BalanceAmount = RefundSettlement.BillAmount;
