    proportionateDiscount: function () {
        try {
            let onBillDiscount = FConvert.toDecimal(POSSCHEMEIMPLEMENTATIONGENERICS.getDiscountOnBill());
            /*ProportionateOnBillDiscountToItemWise*/

            if (onBillDiscount > 0 && PreferenceSetting.PrefGeneralTab.ProportionateOnBillDiscountToItemWise == true) {
                let gross = 0;
                if (ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                    for (let i = 0; i < ApplicationNew.ListOfItems.length; i++)
                        if ((ApplicationNew.ListOfItems[i].PromoType == PromoTypes.get("FREEITEM") || ApplicationNew.ListOfItems[i].ProductType != 0) == false)
                            gross = gross + (FConvert.toDecimal(ApplicationNew.ListOfItems[i].DefaultValue5, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) - FConvert.toDecimal(ApplicationNew.ListOfItems[i].DiscountTotal_UptoCurrentField, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true));
                }
                let linegrossafterdiscount = 0;
                let passingArgs = new Object();
                passingArgs.ProportionatedDiscount = 0;
                for (let ic = 0; ic < ApplicationNew.ListOfItems?.length; ic++) {
                    if (ApplicationNew.ListOfItems[ic].PromoType == PromoTypes.get("FREEITEM") || ApplicationNew.ListOfItems[ic].ProductType != 0)
                        continue;
                    linegrossafterdiscount = ApplicationNew.ListOfItems[ic].DefaultValue5 - ApplicationNew.ListOfItems[ic].DiscountTotal_UptoCurrentField;
                    ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc = (FConvert.toDecimal(onBillDiscount, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals) * linegrossafterdiscount) / gross;
                    if (POSCommon.localCurrency.RoundOffType > 0 && POSCommon.localCurrency.GeneralRoundOff > 0) {
                        let ColumnRoundOff = FConvert.toDecimal(ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals);
                        if (ColumnRoundOff > 0)
                            ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc = FConvert.toDecimal(COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals), FConvert.toInt(POSCommon.localCurrency.RoundOffType)), POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                        else if (ColumnRoundOff < 0 && ApplicationNew.ListOfItems[ic].ProductType > 0) {
                            ColumnRoundOff = Math.abs(ColumnRoundOff);
                            let RoundOffResult = FConvert.toDecimal(COMMONMETHODS.UTILITYMETHODS.roundOff(ColumnRoundOff, FConvert.toDecimal(POSCommon.localCurrency.GeneralRoundOff), FConvert.toInt(POSCommon.localCurrency.RoundOffType)));
                            ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc = - RoundOffResult;
                        }
                    }
                    passingArgs.discountAmt = ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc;
                    POSSCHEMEIMPLEMENTATIONGENERICS.checkProportionateValueAndAdjustIfAnyDecimalIssue(onBillDiscount, passingArgs);// ref ProportionatedDiscount, ref discountAmt
                    ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc = passingArgs.discountAmt;
                    /*ApplicationNew.ListOfItems[ic].DefaultValue6 = FConvert.toDecimal(ApplicationNew.ListOfItems[ic].DefaultValue6, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);*/
                    ApplicationNew.ListOfItems[ic].DynamicLineFields[0].FieldInput = FConvert.toDecimal(ApplicationNew.ListOfItems[ic].DynamicLineFields[0].FieldInput, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
                    ApplicationNew.ListOfItems[ic].DynamicLineFields[0].FieldValue = FConvert.toDecimal(ApplicationNew.ListOfItems[ic].DynamicLineFields[0].FieldValue, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true) + FConvert.toDecimal(ApplicationNew.ListOfItems[ic].OnBillProportionatedDisc, POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.NumberOfDecimals, true);
