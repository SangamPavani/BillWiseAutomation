    checkBatchInProductList: function (line, dPreviousQuantity, applicationException) {
        try {
            let objBatchRelatedData = new Object();
            let BatchItemQty = 0;
            let LineListCopy = null;
            if (line.PosProductMake != PosProductMake.get("SET"))
                LineListCopy = ApplicationNew.ListOfItems;
            else
                LineListCopy = ApplicationNew.CurrentItem.RetailSetsDetails;

            let BatchProductsInTrans = null;
            if (LineListCopy != null && LineListCopy != undefined && LineListCopy.length > 0) {
                BatchProductsInTrans = LineListCopy.filter((p) => p.DefaultValue1 == line.DefaultValue1
                    && p.ProductType == line.ProductType && p.ProductMake == line.ProductMake
                    && (line.PromoType == PromoTypes.get("FREEITEM") ? p.PromoType == PromoTypes.get("FREEITEM") : p.PromoType != PromoTypes.get("FREEITEM"))
                    && p.ProductUnit == line.ProductUnit);
            }

            if (ApplicationNew.IsUpdateQuantity == true) {
                let qtyFromErp = 0;
                for (let i = 0; i < BatchProductsInTrans.length; i++) {
                    if (BatchProductsInTrans[i].BatchNo != null && BatchProductsInTrans[i].BatchNo != undefined && BatchProductsInTrans[i].BatchNo.length > 0) {
                        let data = PRODUCTMETHODNEW.BATCHPOPUPMETHODS.SERVER.getBatchDetails(line.DefaultValue1, line.BatchNo, dPreviousQuantity);
                        if (PRODUCTMETHODNEW.VARIABLES.BatchDetails != null && PRODUCTMETHODNEW.VARIABLES.BatchDetails != undefined)
                            data = PRODUCTMETHODNEW.VARIABLES.BatchDetails;

                        for (let j = 0; j < data.length; j++)
                            qtyFromErp = qtyFromErp + FConvert.toDecimal(data[j][1]);
                    }
                }

                ApplicationNew.TotalBatchQuantity = qtyFromErp;
            }

            if (BatchProductsInTrans != null && BatchProductsInTrans != undefined && BatchProductsInTrans.length > 0) {
                let sum = 0;
                for (let i = 0; i < BatchProductsInTrans.length; i++)
                    sum = sum + FConvert.toDecimal(BatchProductsInTrans[i].DefaultValue3);

                if (ApplicationNew.IsNewProdCodeExecuted == true)
                    BatchItemQty = sum + FConvert.toDecimal(line.DefaultValue3);
                else
                    BatchItemQty = sum;
            }

            //Batch Item Quantity Assignment In Exchange / Spoilage Mode
            let ProductTypeMultiplier = (line.ProductType == 0 || line.ProductType == 3) ? 1 : -1;
            if (BatchItemQty == 0)
                BatchItemQty = (line.DefaultValue3 != 0 ? line.DefaultValue3 : 1);
            else if (LineListCopy.filter((p) => p.ItemSerialNo == line.ItemSerialNo).length <= 0 && ApplicationNew.IsUpdateQuantity == true) {//(LineListCopy.Contains(line) == false && objApplication.IsUpdateQuantity == true)
                if (BatchProductsInTrans.length > 1 && BatchItemQty > ApplicationNew.TotalBatchQuantity)
                    BatchItemQty = (line.DefaultValue3 != 0 ? ApplicationNew.TotalBatchQuantity : BatchItemQty + 1);
                else
                    BatchItemQty = (line.DefaultValue3 != 0 ? BatchItemQty : BatchItemQty + 1);
            }
            else if (LineListCopy.filter((p) => p.DefaultValue1 == line.DefaultValue1).length <= 0) //LineListCopy.Contains(line) == false)
                BatchItemQty = (line.DefaultValue3 != 0 ? BatchItemQty + line.DefaultValue3 : BatchItemQty + 1);

            if (ApplicationNew.ButtonExchangeMode != 0) //Exchange/Spoilage Transaction Mode
            {
                if (ApplicationNew.IsUpdateQuantity == false) {
                    line.DefaultValue3 = ProductTypeMultiplier * line.DefaultValue3;
                    BatchItemQty = ProductTypeMultiplier * BatchItemQty;
                }
                else if (ApplicationNew.IsUpdateQuantity == true) {
                    if (TABLECHANGEMETHODSNEW.VARIABLES.UNIT.IsUpdateUnit == true) {
                        line.DefaultValue3 = ProductTypeMultiplier * line.DefaultValue3;
                        BatchItemQty = ProductTypeMultiplier * BatchItemQty;
                    }
                }
            }

            if (ApplicationNew.CurrentItem != null && ApplicationNew.CurrentItem != undefined && ApplicationNew.CurrentItem.PosProductMake == PosProductMake.get("SET") && ApplicationNew.IsUpdateQuantity == true) {
                if (BatchItemQty > FConvert.toDecimal(ApplicationNew.TotalBatchQuantity))
                    BatchItemQty = ApplicationNew.TotalBatchQuantity;
            }

            if (PreferenceSetting.PrefInventoryTab.AddProductToNewLine == true)
                BatchItemQty = (line.DefaultValue3 != 0 ? line.DefaultValue3 : 1);

            //Batch Item Quantity In Base Unit
            let IsBaseUnit = true;
            if (PreferenceSetting.PrefInventoryTab.InputUnitsInTran == true) {
                if (line.ProductUnit != 0 && line.BaseUnit != line.ProductUnit) {
                    let batchItemQty = PRODUCTSELECTION.UIMETHODS.getQtyInBaseOrRateInSales_Units(line, BatchItemQty);
                    if (batchItemQty != null && batchItemQty != undefined && batchItemQty > 0)
                        BatchItemQty = batchItemQty;

                    IsBaseUnit = false;
                }
            }

            //Getting Used Batch Data
            let UsedBatches = [];
            if (PreferenceSetting.PrefInventoryTab.AddProductToNewLine == true) {
                if (BatchProductsInTrans != null && BatchProductsInTrans != undefined && BatchProductsInTrans.length > 0) {
                    for (let i = 0; i < BatchProductsInTrans.length; i++) {
                        if (ApplicationNew.IsNewProdCodeExecuted == false) {
                            if (line.ItemSerialNo == BatchProductsInTrans[i].ItemSerialNo)
                                continue;
                        }
                        if (BatchProductsInTrans[i].BatchData != null) {
                            BatchProductsInTrans[i].BatchData.BodyId = 0;
                            BatchProductsInTrans[i].BatchData.InvTagId = POSCommon.outletId;
                            UsedBatches.push(BatchProductsInTrans[i].BatchData);
                        }
                    }
                    objBatchRelatedData.BatchListUsed = UsedBatches;
                }
            }
            else {
                if (BatchProductsInTrans != null && BatchProductsInTrans != undefined && BatchProductsInTrans.length > 0) {
                    for (let i = 0; i < BatchProductsInTrans.length; i++) {
                        if (BatchProductsInTrans[i].BatchData != null && BatchProductsInTrans[i].BatchData != undefined) {
                            BatchProductsInTrans[i].BatchData.BodyId = 0;
                            BatchProductsInTrans[i].BatchData.InvTagId = POSCommon.outletId;
                            if (dPreviousQuantity > 0 && line.ItemSerialNo == BatchProductsInTrans[i].ItemSerialNo) {
                                if (BatchProductsInTrans[i].ProductUnit == BatchProductsInTrans[i].BaseUnit) {
                                    if (ApplicationNew.CurrentItem != null && ApplicationNew.CurrentItem != undefined) {
                                        if (ApplicationNew.CurrentItem.PosProductMake != PosProductMake.get("SET") && ApplicationNew.IsUpdateQuantity == false)
                                            BatchProductsInTrans[i].BatchData.Qty = dPreviousQuantity;
                                    }
                                }
                                else {
                                    let BaseQty = dPreviousQuantity;
                                    PRODUCTSELECTION.UIMETHODS.getQtyInBaseOrRateInSales_Units(line, BaseQty);
                                    BatchProductsInTrans[i].BatchData.Qty = BaseQty;
                                }
                            }
                            UsedBatches.push(BatchProductsInTrans[i].BatchData);
                        }
                    }
                }
                objBatchRelatedData.POSBatchList = UsedBatches;
            }

            //Adding line Into Object
            objBatchRelatedData.CurrentItem = line;
            objBatchRelatedData.IsBaseUnit = IsBaseUnit;
            objBatchRelatedData.IsOpenPopup = true;

            if (ApplicationNew.PresentTransactionMode != TransactionModes.get("PREORDERCOLLECTION"))
                objBatchRelatedData.BatchItemQuantity = BatchItemQty;
            else if (ApplicationNew.PresentTransactionMode == TransactionModes.get("PREORDERCOLLECTION") &&
                RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs != undefined &&
                RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != null && RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs != undefined &&
                RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.IsProductReplacementEnabled == true) {
                if (BatchProductsInTrans != null && BatchProductsInTrans != undefined && BatchProductsInTrans.length > 0) {
                    objBatchRelatedData.BatchItemQuantity = 0;
                    for (let i = 0; i < BatchProductsInTrans.length; i++)
                        objBatchRelatedData.BatchItemQuantity = objBatchRelatedData.BatchItemQuantity + BatchProductsInTrans[i].DefaultValue3;

                    objBatchRelatedData.BatchItemQuantity = objBatchRelatedData.BatchItemQuantity + FConvert.toInt(RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.SelectedProductReplaceQuantity);
                }
                else
                    objBatchRelatedData.BatchItemQuantity = RETAILMAIN.VARIABLE.ApplicationIntegrationArgs.DUSMinutesAppIntegrationArgs.SelectedProductReplaceQuantity;
            }
            else
                objBatchRelatedData.BatchItemQuantity = BatchItemQty;

            objBatchRelatedData.PreviousQuantity = dPreviousQuantity;

            if (ApplicationNew.BatchRelatedList == null || ApplicationNew.BatchRelatedList == undefined)
                ApplicationNew.BatchRelatedList = [];

            ApplicationNew.BatchRelatedList.push(objBatchRelatedData);

            applicationException.ApplicationExceptionReturnType = (ApplicationExceptionReturnType.Success);
            applicationException.ApplicationExceptionMessageType = (ApplicationExceptionMessageType.Popup);
            if (applicationException.ApplicationExceptionMessage == null || applicationException.ApplicationExceptionMessage == undefined || applicationException.ApplicationExceptionMessage.length <= 0)
                applicationException.ApplicationExceptionMessage = "";
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.BATCHPOPUPMETHODS.checkBatchInProductList :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
