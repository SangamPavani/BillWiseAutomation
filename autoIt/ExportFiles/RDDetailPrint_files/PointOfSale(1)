            if (memberData.Address2 != null && memberData.Address2 != undefined && memberData.Address2.trim() != ""
                && memberData.Address2.trim().length > 0 && memberData.Address2.trim() != "0") {
                sAddress = sAddress + "\n" + memberData.Address2;
