                    objSDD.DiscountOnName = SCHEMES.GetDiscItemTypeNameByID(selDiscountItemTypes);

                    objSDD.FreeItems = "";
                    objSDD.FreeItemTypeName = "";
                }
                else if (selDiscountType == "FreeItem") {
                    objSDD.DisctypeId = 3;
                    objSDD.DisctypeName = "Free";
                    objSDD.DiscountD = FConvert.toDecimal(0);
                    objSDD.DiscountOnName = "";
                    if ($("#rbtAnyItem").is(":checked") == true) {
                        objSDD.FreeitemType = 1;
                        objSDD.FreeItemTypeName = "Any Item";
                    }
                    if ($("#rbtAllItem").is(":checked") == true) {
                        objSDD.FreeitemType = 2;
                        objSDD.FreeItemTypeName = "All Items";
                    }
                    var strProductIds = "";

                    var tr = $("#tbodyFreeItem").find('tr');
                    var arrFreeItemRecord = [];
                    var freeItemsList = [];
                    var arrFreeItemsList = [];
                    for (var i = 0; i < tr.length; i++) {
                        var trFreeItemRecord = $(tr[i]).attr("data-FreeItemRecord");
                        if (trFreeItemRecord != null && trFreeItemRecord != "" && trFreeItemRecord != undefined && trFreeItemRecord.length > 0) {
                            trFreeItemRecord = JSON.parse(trFreeItemRecord);
                            arrFreeItemRecord.push(trFreeItemRecord);
                            var freeItem = arrFreeItemRecord.filter((p) => p.ItemId > 0 && p.Quantity > 0);
                            if (freeItem != null && freeItem != "" && freeItem != undefined)
                                freeItemsList.push(freeItem[i]);
                        }
                    }
                    if (freeItemsList != null || freeItemsList != undefined || freeItemsList.length > 0) {
                        for (var i = 0; i < freeItemsList.length; i++) {
                            strProductIds = strProductIds + freeItemsList[i].UnitId + "@" + freeItemsList[i].ItemId + "(" + freeItemsList[i].Quantity + ")" + ",";

                            FreeItemsList = new Object();
                            FreeItemsList.ProductID = freeItemsList[i].ItemId;
                            FreeItemsList.ProductName = freeItemsList[i].ItemName;
                            FreeItemsList.Unit = freeItemsList[i].UnitId;
                            FreeItemsList.UnitName = freeItemsList[i].UnitName;
                            FreeItemsList.UnitIdNamePair = freeItemsList[i].UnitIdNamePair;
                            FreeItemsList.Quantity = freeItemsList[i].Quantity;
                            arrFreeItemsList.push(FreeItemsList);
                        }
                        if (strProductIds.length > 0) {
                            objSDD.FreeItems = strProductIds.substring(0, strProductIds.length - 1);
                        }

                        objSDD.FreeItemsList = arrFreeItemsList;
                        freeItemsList = [];
                        arrFreeItemsList = [];
                    }
                }
                else if (selDiscountType == "FixedRate") {
                    objSDD.DisctypeId = 4;
                    objSDD.DisctypeName = "Fixed Rate";
                    var txtFixedRate = $("#txtFixedRate").val();
                    if (txtFixedRate != null && txtFixedRate.trim() != "" && txtFixedRate != undefined) {
                        objSDD.Discount = txtFixedRate.trim();
                        objSDD.DiscountD = FConvert.toDecimal(txtFixedRate);
                    }
                    var selFixedRateOnItem = $("#ddlFixedRateOnItem option:selected").attr("value");
                    objSDD.DiscountOn = FConvert.toInt(selFixedRateOnItem);
                    objSDD.DiscountOnName = SCHEMES.GetFixedItemTypeNameByID(selFixedRateOnItem);

                    objSDD.FreeItems = "";
                    objSDD.FreeItemTypeName = "";
                }

                else if (selDiscountType == "DiscountVouchers") {

                    objSDD.DisctypeId = 5;
                    objSDD.DisctypeName = "Discount Vouchers";
                    objSDD.DiscountD = FConvert.toDecimal(0);
                    var sDVIds = "";
                    var tr = $("#tbodyDVouchers").find('tr');

                    var arrDiscountVouchers = [];
                    var discountVouchersList = [];
                    var arrDiscVouchersList = [];
                    for (var i = 0; i < tr.length; i++) {
                        var trDiscountVouchersRecord = $(tr[i]).attr("data-DiscountVouchers");
                        if (trDiscountVouchersRecord != null && trDiscountVouchersRecord != "" && trDiscountVouchersRecord != undefined && trDiscountVouchersRecord.length > 0) {
                            trDiscountVouchersRecord = JSON.parse(trDiscountVouchersRecord);
                            arrDiscountVouchers.push(trDiscountVouchersRecord);
                            var discountVouchers = arrDiscountVouchers.filter((p) => p.DVouchersId > 0 && p.Quantity > 0);
                            if (discountVouchers != null && discountVouchers != "" && discountVouchers != undefined)
                                discountVouchersList.push(discountVouchers[i]);
                        }
                    }
                    if (discountVouchersList != null || discountVouchersList != undefined || discountVouchersList.length > 0) {
                        for (var i = 0; i < discountVouchersList.length; i++) {
                            sDVIds = sDVIds + discountVouchersList[i].DVouchersId + "(" + discountVouchersList[i].Quantity + ")" + ",";

                            DiscVouchersList = new Object();
                            DiscVouchersList.DVRegId = discountVouchersList[i].DVouchersId;
                            DiscVouchersList.DVRegName = discountVouchersList[i].DVouchersName;
                            DiscVouchersList.Quantity = discountVouchersList[i].Quantity;
                            DiscVouchersList.MinBillValToRedeem = discountVouchersList[i].MinBill;
                            arrDiscVouchersList.push(DiscVouchersList);
                        }
                        if (sDVIds.length > 0) {
                            objSDD.DiscVouchers = sDVIds.substring(0, sDVIds.length - 1);
                            objSDD.DiscountOnName = sDVIds.substring(0, sDVIds.length - 1);
                        }
                        objSDD.DiscVouchersList = arrDiscVouchersList;
                        discountVouchersList = [];
                        arrDiscVouchersList = [];
                    }

                    objSDD.FreeItems = "";
                    objSDD.FreeItemTypeName = "";
                }
                // PreferenceSetting.PrefGeneral.ImplementSchemeUnitWise
                // Units aks Naveen for unit ComboBox              
                if (SCHEMES.VARIABLE.unitsVisible == true && SCHEMES.VARIABLE.unitIsEnabled == true) {
                    var selUnitId = $("#ddlUnit option:selected").attr("value");
                    if (selUnitId == null || selUnitId == undefined)
                        objSDD.UnitId = 0;
                    else
                        objSDD.UnitId = selUnitId;
                    var lstUnit = [];
                    var option = $("#ddlUnit option");
                    if (option != null && option != undefined && option.length > 0) {
                        for (let i = 0; i < option.length; i++) {
                            var lst = $(option[i]).attr("data-UnitDetails");
                            lst = JSON.parse(lst);
                            lstUnit.push(lst);
                        }
                    }

                    if (lstUnit == null || lstUnit == undefined || lstUnit.length == 0)
                        objSDD.BaseUnitId = 0;
                    else
                        objSDD.BaseUnitId = lstUnit[0].ID;
                    objSDD.UnitPair = (lstUnit == null) ? null : (lstUnit);
                }

                debugger;
                SCHEMES.SCHEMESBUTTONCLICK.GetItemIdAndItemName();
                if (SCHEMES.VARIABLE.ItemId != null && SCHEMES.VARIABLE.ItemId != undefined && SCHEMES.VARIABLE.ItemId.length > 0)
                    objSDD.Itemstobepresent = SCHEMES.VARIABLE.ItemId;
                else
                    objSDD.Itemstobepresent = "";

                let selectedProductGroupId = $("#divTreeViewControlStoreInformation").attr("data-SelectedProductGroupId");
                if (selectedProductGroupId != null && selectedProductGroupId != undefined && selectedProductGroupId.trim().length > 0)
                    objSDD.Groupidspresent = selectedProductGroupId;
                else
                    objSDD.Groupidspresent = "";

                var schemesProductType = $("#divTreeViewControlStoreInformation").attr("data-SelectedSchemesProductType");
                if (schemesProductType != null && schemesProductType != undefined && schemesProductType.trim().length > 0)
                    objSDD.MandatoryItemSelectionType = schemesProductType;
                else
                    objSDD.MandatoryItemSelectionType = 0;

                debugger;
                objSDD.ApplyToNewlyCreatedProducts = $('#chkApplyToCreatedGroup').is(":checked");

                if (objSDD.Itemstobepresent != null && objSDD.Itemstobepresent != undefined && objSDD.Itemstobepresent.length > 0) {
                    objSDD.Itemspresentid = 2;

                    var _Type = 0;
                    let selectedTreeTypeId = $("#divTreeViewControlStoreInformation").attr("data-SelectedTreeTypeId");
                    if (selectedTreeTypeId != null && selectedTreeTypeId != undefined && selectedTreeTypeId.trim().length > 0)
                        _Type = FConvert.toInt(selectedTreeTypeId);

