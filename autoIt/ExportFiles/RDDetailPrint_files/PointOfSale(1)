                                else if (objVoucherPostStatus.Posted == true && bPostedNegativeStock == false)
                                    toastr.success(msgSaved + "<br/>" + msgDeliveryNote + objVoucherPostStatus.VoucherNo + msgpostedsuccessfullyDayEnd);
