            ProductSets.TaxCategoryValue = FConvert.toInt($("#ddlTaxCategory option:selected").attr("value"));

            if (PRODUCTSETS.VARIABLE.setData != null && PRODUCTSETS.VARIABLE.setData != undefined) {
                var batchDate = PRODUCTSETS.VARIABLE.setData.PriceBookDate;
                PRODUCTSETS.VARIABLE.setData.PriceBookDate = {};
                PRODUCTSETS.VARIABLE.setData.PriceBookDate.Value = batchDate;

                ProductSets.SetsList = PRODUCTSETS.VARIABLE.setData;
            }

            ProductSets.ProductList = PRODUCTSETS.VARIABLE.arrProduct;
            if (GlobalPref.Version == eVersion.Version9) {
                if ($("#rbFixedRate").is(":checked") == true) {
                    ProductSets.RateType = 1;
                    if ($("#txtFixedAmount").val() != "")
                        ProductSets.FixedAmount = FConvert.toDecimal($("#txtFixedAmount").val());

                    var CurrencyId = OPTIONCONTROL.getControlDataObject("optCurrency");
                    if (CurrencyId.iCurrencyId != null && CurrencyId.iCurrencyId != undefined && CurrencyId.iCurrencyId != "")
                        ProductSets.CurrencyId = CurrencyId.iCurrencyId;

                    if ($("#rbEqual").is(":checked") == true)
                        ProductSets.Apply = 0;
                    else
                        ProductSets.Apply = 1;
                }
                else {
                    ProductSets.RateType = 0;
                    if ($("#txtDiscount").val() != "")
                        ProductSets.Discount = FConvert.toDecimal($("#txtDiscount").val());
                    if ($("#rbPercentage").is(":checked") == true)
                        ProductSets.DiscType = 0;
                    else
                        ProductSets.DiscType = 1;

                    if ($("#rbToSet").is(":checked") == true)
                        ProductSets.ApplyTo = 0;
                    else
                        ProductSets.ApplyTo = 1;

                    ProductSets.AllowModificationOfItemAfterloading = $("#chkAllowModificationOfItemAfterloading").prop('checked');
                }

            }
            else if (GlobalPref.Version == eVersion.Version10) {
                if ($("#ddlRateType").val() == 1) {
                    ProductSets.RateType = 1;
                    if ($("#txtFixedAmount").val() != "")
                        ProductSets.FixedAmount = FConvert.toDecimal($("#txtFixedAmount").val());

                    var CurrencyId = OPTIONCONTROL.getControlDataObject("optCurrency");
                    if (CurrencyId.iCurrencyId != null && CurrencyId.iCurrencyId != undefined && CurrencyId.iCurrencyId != "")
                        ProductSets.CurrencyId = CurrencyId.iCurrencyId;

                    if ($("#ddlApply").val() == 0)
                        ProductSets.Apply = 0;
                    else
                        ProductSets.Apply = 1;
                }
                else {
                    ProductSets.RateType = 0;
                    if ($("#txtDiscount").val() != "")
                        ProductSets.Discount = FConvert.toDecimal($("#txtDiscount").val());
                    if ($("#ddlDiscntType").val() == 0)
                        ProductSets.DiscType = 0;
                    else
                        ProductSets.DiscType = 1;

                    if ($("#ddlApplyTo").val() == 0)
                        ProductSets.ApplyTo = 0;
                    else
                        ProductSets.ApplyTo = 1;

                    ProductSets.AllowModificationOfItemAfterloading = $("#chkAllowModificationOfItemAfterloading").prop('checked');
                }
            }
            ProductSets.Quantity = FConvert.toDecimal($("#txtQty").text());
            ProductSets.Gross = FConvert.toDecimal($("#txtGross").text());
            ProductSets.SetValue = FConvert.toDecimal($("#txtSetValue").text());
            ProductSets.ReverFixedPrice = PRODUCTSETS.VARIABLE.ReverFixedPrice;
            ProductSets.HasTransactionData = PRODUCTSETS.VARIABLE.HasTransactionData;
            ProductSets.CombineWithOtherSchemes = PRODUCTSETS.VARIABLE.CombineWithOtherSchemes;

