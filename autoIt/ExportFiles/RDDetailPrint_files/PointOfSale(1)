                        if (arrValues.length > 5 && arrValues[3] == true && arrValues[4].length > 0 && arrValues[5] > 0) {
                            BILLSETTLEMENTNEW.VARIABLES.employeeDiscountAuthorization = true;
                            BILLSETTLEMENT.dDiscAllowedPerTrans = arrValues[5];
