        try {
            var m_iCount = parseInt($("#divGVRegBody").attr('data-Count'));
            var iMaxRecordCount = parseInt($("#divGVRegBody").attr('data-MaxCount'));
            var iRecordsPerPage = parseInt($("#divGVRegBody").attr('data-RecordPerPage'));

            if (navigationButtonType == 1)//First
                m_iCount = 0;
            else if (navigationButtonType == 2)//Previous
                m_iCount -= iRecordsPerPage;
            else if (navigationButtonType == 3)//Next
                m_iCount += iRecordsPerPage;
            else if (navigationButtonType == 4)//Last
            {
                m_iCount = iRecordsPerPage * (parseInt(iMaxRecordCount / iRecordsPerPage));
