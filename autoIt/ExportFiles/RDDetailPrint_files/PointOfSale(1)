    deliveryTypeClickEvent: function (radioClicked) {
        try {
            let rbButton = 0;
            let rbtClickedID = $(radioClicked).attr('id');
            if (rbtClickedID == "rbtNone") {
                rbButton = 0;
            }
            else if (rbtClickedID == "rbtHomeDelivery") {
                rbButton = 1;
            }
            else if (rbtClickedID == "rbtPickUp") {
                rbButton = 2;
            }
            switch (rbButton) {
                case 0: //None
                    $("#divPreOrderCollectionOrderType #rbtNone").prop("checked", true);
                    $("#divPreOrderCollectionOrderType #rbtNone").attr("checked", true);

                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").removeAttr("checked");

                    $("#divPreOrderCollectionOrderType #rbtPickUp").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtPickUp").removeAttr("checked");
                    $("#divPreOrderCollectionHomeDeliveryRecord").css('display', 'none');
                    break;
                case 1: //Home Delivery
                    $("#divPreOrderCollectionOrderType #rbtNone").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtNone").removeAttr("checked");

                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").prop("checked", true);
                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").attr("checked", true);

                    $("#divPreOrderCollectionOrderType #rbtPickUp").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtPickUp").removeAttr("checked");

                    $("#divPreOrderCollectionHomeDeliveryRecord").css('display', 'block');
                    break;
                case 2: //PickUp
                    $("#divPreOrderCollectionOrderType #rbtNone").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtNone").removeAttr("checked");

                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").prop("checked", false);
                    $("#divPreOrderCollectionOrderType #rbtHomeDelivery").removeAttr("checked");

                    $("#divPreOrderCollectionOrderType #rbtPickUp").prop("checked", true);
                    $("#divPreOrderCollectionOrderType #rbtPickUp").attr("checked", true);
                    $("#divPreOrderCollectionHomeDeliveryRecord").css('display', 'none');
                    break;
            }
            if (rbButton == 1) {
                $('#divPreOrderHomeDeliveryRecord').css('display', 'block');
                $("#txtPreOrderExistingAddress").focus();
