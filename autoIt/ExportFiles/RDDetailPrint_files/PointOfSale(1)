                                toastr.error(pleaseIncludeAtleastOneItemAsMandatory);
                                return false;
                            }
                        }
                    }
                }
                return true;
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESDISCOUNT.PAYMENTDISCOUNT.IsValidationFree_Save :: Catch block :: Exception :: " + Ex.message);
                return false;
            }
        },
