    updateCreditCardSlider: function () {
        const wrapper = document.getElementById('divCreditCardSliderWrapper');
        const row = document.getElementById('divRowCreditCard');
        const wrapperWidth = wrapper.offsetWidth;
        const rowWidth = row.scrollWidth;

        // Clamp offset
        creditCardSliderOffset = Math.max(0, Math.min(creditCardSliderOffset, rowWidth - wrapperWidth));
        row.style.transform = `translateX(-${creditCardSliderOffset}px)`;
    },
