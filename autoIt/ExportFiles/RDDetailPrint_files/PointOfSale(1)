    setDenominationToCurrency: function () {
        try {
            let dayEndModel = $("#divDayEndMain").attr("data-ModelRecord");
            if (dayEndModel == null || dayEndModel == undefined || dayEndModel.length <= 0)
                return;
            dayEndModel = JSON.parse(dayEndModel);

            let currencyModel = $("#divDenominationModal").attr("data-CurrencyModel");
            if (currencyModel == null || currencyModel == undefined || currencyModel.trim().length <= 0)
                return;
            currencyModel = JSON.parse(currencyModel);

            let exchangeRateOfCurrency = null;
            if (dayEndModel.ExchangeRate != null && dayEndModel.ExchangeRate != undefined && dayEndModel.ExchangeRate.length > 0) {
                exchangeRateOfCurrency = dayEndModel.ExchangeRate.filter((p) => p.CurrencyId == currencyModel.CurrencyId);

                if (exchangeRateOfCurrency != null && exchangeRateOfCurrency != undefined && exchangeRateOfCurrency.length > 0)
                    exchangeRateOfCurrency = exchangeRateOfCurrency[0];
                else {
                    exchangeRateOfCurrency = new Object();
                    exchangeRateOfCurrency.Rate = 1;
                }
            }
            else {
                exchangeRateOfCurrency = new Object();
                exchangeRateOfCurrency.Rate = 1;
            }

            let selectedDenomination = currencyModel.DenominationList.filter((p) => p.Count > 0);
            if (selectedDenomination == null || selectedDenomination == undefined || selectedDenomination.length <= 0) {
                $("#divDenominationModal").hide();
                return;
            }

            let reportedAmount = 0;
            currencyModel.SelectedDenominations = [];
            for (let i = 0; i < selectedDenomination.length; i++) {
                currencyModel.SelectedDenominations.push(
                    {
                        ID: selectedDenomination[i].DenominationId,
                        Tag: selectedDenomination[i].Count,
                        Name: selectedDenomination[i].DenominationValue
                    });

                reportedAmount = FConvert.toDecimal(reportedAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + (FConvert.toDecimal(currencyModel.SelectedDenominations[i].Tag, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) * FConvert.toDecimal(currencyModel.SelectedDenominations[i].Name, DAYEND.VARIABLE.posCommon.numberOfDecimal, true));
            }

            let selectedCurrency = dayEndModel.DayInPos.CurrencyDetails.filter((p) => p.CurrencyId == currencyModel.CurrencyId);
            if (selectedCurrency != null && selectedCurrency != undefined && selectedCurrency.length > 0) {
                selectedCurrency = selectedCurrency[0];
                selectedCurrency.SelectedDenominations = currencyModel.SelectedDenominations;
                selectedCurrency.ReportedAmount = reportedAmount;
                selectedCurrency.ReportedAmountInBaseCurrency = FConvert.toDecimal(selectedCurrency.ReportedAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) * FConvert.toDecimal(exchangeRateOfCurrency.Rate, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                selectedCurrency.DifferenceAmount = FConvert.toDecimal((FConvert.toDecimal(selectedCurrency.AmountBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) - FConvert.toDecimal(selectedCurrency.ReportedAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true)), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
            }
            if (selectedCurrency != null && selectedCurrency != undefined)
                $("#tBodyMultiCurrency > tr[id='" + currencyModel.CurrencyId + "']").attr("data-multicurrencydetails", JSON.stringify(selectedCurrency));

            // Setting Total Denomination Value in Currency's Reported Amount Column
            let currencyReportedAmount = $("#tBodyMultiCurrency > tr[id='" + currencyModel.CurrencyId + "']").find("td:eq(3)");
            if (currencyReportedAmount != null && currencyReportedAmount != undefined && currencyReportedAmount.length > 0) {
                currencyReportedAmount = currencyReportedAmount[0];

                let reportedAmount = 0;
                for (let i = 0; i < currencyModel.SelectedDenominations.length; i++)
                    reportedAmount = FConvert.toDecimal(reportedAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + (FConvert.toDecimal(currencyModel.SelectedDenominations[i].Tag, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) * FConvert.toDecimal(currencyModel.SelectedDenominations[i].Name, DAYEND.VARIABLE.posCommon.numberOfDecimal, true))

                $(currencyReportedAmount).html(reportedAmount);
            }

            let totalAmountInBaseCurrency = 0;
            for (let i = 0; i < dayEndModel.DayInPos.CurrencyDetails.length; i++)
                totalAmountInBaseCurrency = FConvert.toDecimal(totalAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal(dayEndModel.DayInPos.CurrencyDetails[i].ReportedAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

            if (totalAmountInBaseCurrency > 0)
                $("#txtCashInDrawer").val(FConvert.toDecimal(totalAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal));

            $("#divDayEndMain").attr("data-ModelRecord", JSON.stringify(dayEndModel));
            $("#divDenominationModal").hide();

            RETAILMAIN.setFocusBarCodeTextBox();
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: DAYEND.setDenominationToCurrency :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
