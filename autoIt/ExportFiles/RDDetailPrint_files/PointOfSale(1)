                    MastersExternalModule.callExternalModule(EXTERNALMODULE_EVENT_ENUM.AFTER_SAVE, 0, 'MASTERENTRYSCREEN.continueEMProcess', PRODUCTSETS.VARIABLE.ExternalModuleData);
                }

                if (rtnValue.bHasTransactionData == true) {
                    var messageInfoPopup = POSFOCUSWDATASTRUCTURE.getEmptyMessageInfoPopup();
                    messageInfoPopup.Caption = "Item Sets saved";
                    messageInfoPopup.Message = [];
                    messageInfoPopup.Message[0] = "Details saved successfully";
                    messageInfoPopup.ButtonType = "Ok";
                    messageInfoPopup.OkMethod = "PRODUCTSETS.MESSAGEPOPUP.onOkClick()";
                    var arrValue = [];
