            ApplicationNew.PreviousTransaction.LoadedRetailTransFooter = LOADTRANSACTION.loadFooterData_Generic(loadedTransaction, ESTIMATIONBILL.VARIABLES.LoadEstimatedVoucher);
            ApplicationNew.RetailTransFooter = ApplicationNew.PreviousTransaction.LoadedRetailTransFooter;
            CALCULATION.calculateFooter(ApplicationNew);
