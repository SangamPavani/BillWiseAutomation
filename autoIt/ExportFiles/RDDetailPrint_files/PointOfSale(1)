    validateNumberControlValue: function (element) {
        HEADEREXTRAFIELDS.VARIABLE.isNumericValidate = true;
        try {

            var parsedHeaderExtraFields = JSON.parse($(element).attr('data-Tag'));
            var inputControlValue = 0;

            if (parsedHeaderExtraFields.DataTypeName == "Number" || parsedHeaderExtraFields.DataTypeName == "Big Number")
                inputControlValue = $(element).val();
            else if (parsedHeaderExtraFields.DataTypeName == "Fraction")
                inputControlValue = $(element).val();

            if (parsedHeaderExtraFields.DataTypeName == "Number" || parsedHeaderExtraFields.DataTypeName == "Big Number") {
                if (FConvert.toInt(parsedHeaderExtraFields.MinimumValue) >= 0 && FConvert.toInt(parsedHeaderExtraFields.MaximumValue) > 0) {
                    if (inputControlValue == null || inputControlValue == undefined || $.trim(inputControlValue).length <= 0) {
                        toastr.error(msgPleaseEnterValueBetween + " " + FConvert.toInt(parsedHeaderExtraFields.MinimumValue) + " - " + FConvert.toInt(parsedHeaderExtraFields.MaximumValue));
                        $(element).val(parsedHeaderExtraFields.DefaultValue);
                        $(element).focus();
                        HEADEREXTRAFIELDS.VARIABLE.isNumericValid = false;
                        return;
                    }

                    if (FConvert.toInt(inputControlValue) < FConvert.toInt(parsedHeaderExtraFields.MinimumValue) || FConvert.toInt(inputControlValue) > FConvert.toInt(parsedHeaderExtraFields.MaximumValue)) {
                        toastr.error(msgPleaseEnterValueBetween + " " + FConvert.toInt(parsedHeaderExtraFields.MinimumValue) + " - " + FConvert.toInt(parsedHeaderExtraFields.MaximumValue));
                        $(element).val(parsedHeaderExtraFields.DefaultValue);
                        $(element).focus();
                        HEADEREXTRAFIELDS.VARIABLE.isNumericValid = false;
                        return;
                    }
                }
            }
            else if (parsedHeaderExtraFields.DataTypeName == "Fraction") {
                if (FConvert.toDecimal(parsedHeaderExtraFields.MinimumValue, POSCommon.numberOfDecimal) >= 0 && FConvert.toDecimal(parsedHeaderExtraFields.MaximumValue, POSCommon.numberOfDecimal) > 0) {
                    if (inputControlValue == null || inputControlValue == undefined || $.trim(inputControlValue).length <= 0) {
                        toastr.error(msgPleaseEnterValueBetween + " " + FConvert.toDecimal(parsedHeaderExtraFields.MinimumValue, POSCommon.numberOfDecimal) + " - " + FConvert.toDecimal(parsedHeaderExtraFields.MaximumValue, POSCommon.numberOfDecimal));
                        $(element).val(parsedHeaderExtraFields.DefaultValue);
                        $(element).focus();
                        HEADEREXTRAFIELDS.VARIABLE.isNumericValid = false;
                        return;
                    }

                    if (FConvert.toDecimal(inputControlValue, POSCommon.numberOfDecimal) < FConvert.toDecimal(parsedHeaderExtraFields.MinimumValue, POSCommon.numberOfDecimal) || FConvert.toDecimal(inputControlValue, POSCommon.numberOfDecimal) > FConvert.toDecimal(parsedHeaderExtraFields.MaximumValue, POSCommon.numberOfDecimal)) {
                        toastr.error(msgPleaseEnterValueBetween + " " + FConvert.toDecimal(parsedHeaderExtraFields.MinimumValue, POSCommon.numberOfDecimal) + " - " + FConvert.toDecimal(parsedHeaderExtraFields.MaximumValue, POSCommon.numberOfDecimal));
                        $(element).val(parsedHeaderExtraFields.DefaultValue);
                        $(element).focus();
                        HEADEREXTRAFIELDS.VARIABLE.isNumericValid = false;
                        return;
                    }
                }
            }

            HEADEREXTRAFIELDS.VARIABLE.isNumericValid = true;
        }
        catch (Ex) {
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + ", File: retailPopup.js, Method: HEADEREXTRAFIELDS.validateNumberControlValue, Catch block : Error Message : " + Ex.message);
        }
