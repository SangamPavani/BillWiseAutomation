    getProductToImplementSchemes: function (AssignDiscount = true, AddFreeItems = true, ConvertToBaseUnit = true, SchemesImplementOnDefinedUnit = false, AddFreeItemToNormalIfExists = true, itemsToConsider, posProductType = PosProductType.get("NORMAL")) {
        try {
            var ProductsToImplementSchemes = [];

            itemsToConsider = itemsToConsider == null ? ApplicationNew.ListOfItems : itemsToConsider;

            if (itemsToConsider != null && itemsToConsider != undefined && itemsToConsider.length > 0) {
                for (let i = 0; i < itemsToConsider.length; i++) //foreach(CustLineWise p in _linelist)
                {
                    if (itemsToConsider[i].ProductType != null && itemsToConsider[i].ProductType != undefined && itemsToConsider[i].ProductType != FConvert.toInt(posProductType))
                        continue;
                    if (itemsToConsider[i].DonotConsiderWhileApplyingSchemes)
                        continue;
                    if (itemsToConsider[i].PromoType == PromoTypes.get("FREEITEM")) {
                        if (AddFreeItems == false)
                            continue;
                        itemsToConsider[i].DefaultValue4 = 0;
                    }
                    let passingArgs = new Object();

                    if (posProductType == PosProductType.get("NORMAL"))
                        passingArgs.dQuantity = 1;
                    else
                        passingArgs.dQuantity = -1;

                    passingArgs.dQuantity = passingArgs.dQuantity * itemsToConsider[i].DefaultValue3;
                    passingArgs.dRate = itemsToConsider[i].DefaultValue4;
                    passingArgs.QtyOrPrice = 0;

                    let dDiscount = 0;
                    if (posProductType == PosProductType.get("NORMAL"))
                        dDiscount = 1;
                    else
                        dDiscount = -1;

                    dDiscount = dDiscount * itemsToConsider[i].DynamicLineFields[0].FieldInput;

                    if (PreferenceSetting.PrefInventoryTab.InputUnitsInTran == true && SchemesImplementOnDefinedUnit == false) {
                        if (ConvertToBaseUnit == true && itemsToConsider[i].ProductUnit != itemsToConsider[i].BaseUnit) {
                            POSSCHEMEIMPLEMENTATIONGENERICS.POSSCHEMESIMPLEMENTATION.getQtyInBaseOrRateInSales_Units_CustLineWise(itemsToConsider[i], passingArgs, true); //ref dQuantity,
