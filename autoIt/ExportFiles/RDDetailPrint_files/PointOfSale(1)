                        checkbox.checked = true;
                        if (GlobalPref.Version == eVersion.Version9)
                            arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                        else if (GlobalPref.Version == eVersion.Version10)
                            arrSelectedValues.push(checkbox.dataset.name);
                    }
