            PRODUCTSETS.VARIABLE.ExternalModuleData.Data = [];
            PRODUCTSETS.VARIABLE.ExternalModuleData.Data.push(ProductSets.SetId);
            ////debugger;
            var iCount = MastersExternalModule.callExternalModule(EXTERNALMODULE_EVENT_ENUM.BEFORE_SAVE, 0, 'MASTERENTRYSCREEN.continueEMProcess', PRODUCTSETS.VARIABLE.ExternalModuleData);
