    onKeyDown: function (event, table) {
        //////debugger;
        try {
            let iRow = $(table).attr("data-Row");
            let iColumn = $(table).attr("data-Column");

            if (event.keyCode != eKeyCode.CR && event.keyCode != eKeyCode.Tab)
                return true;
            else if (event.keyCode == eKeyCode.CR || event.keyCode == eKeyCode.Tab) {
                EMPLOYEEDISCOUNTDEFINATION.onLeaveTableCellEmployee(table, iRow, iColumn);
                let diamention = [];
                if (event.shiftKey == true)
                    diamention = EMPLOYEEDISCOUNTDEFINATION.setPreviousColumn(table, iRow, iColumn);
                else
                    diamention = EMPLOYEEDISCOUNTDEFINATION.setNextColumn(table, iRow, iColumn);

                //////debugger;
                iRow = diamention[0];
                iColumn = diamention[1];
                EMPLOYEEDISCOUNTDEFINATION.onEnterTableCellEmployee(table, iRow, iColumn);
            }

            return true;
        }
