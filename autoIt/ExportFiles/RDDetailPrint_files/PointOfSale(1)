    calculateEPaymentCharges: function (selectedEPaymentType) {

        try {
            var dEPayAmt = 0, screen = "NewRetailMainScreen", charges = 0;
            var msgBSEPaymentChargesFieldValidation = $("#msgBSEPaymentChargesFieldValidation").val();
            var cardCharges = 0;
            $("#txtEPaymentCharges").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
            if ($("#txtEPaymentAmount").val() == null || $("#txtEPaymentAmount").val().length <= 0) {
                $("#txtEPaymentAmount").focus();
                return;
            }
            dEPayAmt = FConvert.toDecimal($("#txtEPaymentAmount").val(), POSCommon.numberOfDecimal);
            if (dEPayAmt <= 0)
                return;

            if (screen != FromScreen.get("GIFTVOUCHERSALE") && screen != FromScreen.get("WNDCREDITSALE") && selectedEPaymentType != null && selectedEPaymentType != undefined && selectedEPaymentType.CardCharges > 0) {
                if (BillSettlement.ModuleType == ModuleType.get("RETAIL")) {
                    var colMapFound = 0;
                    //Count of FooterColMap  
                    if (BillSettlement.FooterColMap != null && BillSettlement.FooterColMap != undefined &&
                        BillSettlement.FooterColMap.length > 0)
                        colMapFound = BillSettlement.FooterColMap.filter(p => p.FieldBehaviour == 2);//FieldBehaviour.get("CARDCHARGES")=2

                    if (BillSettlement.FooterColMap == null || BillSettlement.FooterColMap == undefined ||
                        BillSettlement.FooterColMap.length <= 0 || colMapFound <= 0) {
                        toastr.error(msgBSEPaymentChargesFieldValidation);
                        return;
                    }
                    else {
                        if (selectedEPaymentType.PaymentChargesType == 1)
                            cardCharges = ((dEPayAmt * selectedEPaymentType.CardCharges) / 100);
                        else
                            cardCharges = (selectedEPaymentType.CardCharges);

                        $("#txtEPaymentCharges").val(FConvert.toDecimal(cardCharges, POSCommon.numberOfDecimal)); //((dCardAmt * selectedCardType.CardCharges) / 100);
                    }
                }
                else {
                    if (BillSettlement.RestFooterColMap != null || BillSettlement.RestFooterColMap != undefined)
                        var restFooterMapFound = BillSettlement.RestFooterColMap.filter(p => p.FieldBehaviour == 2);

                    if (BillSettlement.RestFooterColMap == null || BillSettlement.RestFooterColMap == undefined || restFooterMapFound <= 0) {
                        toastr.error(msgBSEPaymentChargesFieldValidation);
                    }
                    else {
                        if (selectedEPaymentType.PaymentChargesType == 1)
                            cardCharges = ((dEPayAmt * selectedEPaymentType.CardCharges) / 100);
                        else
                            cardCharges = (selectedEPaymentType.CardCharges);
                        $("#txtEPaymentCharges").val(FConvert.toDecimal(cardCharges, POSCommon.numberOfDecimal));//((dCardAmt * SelectedCardType.CardCharges) / 100);
                    }
                }
            }
            else {
                $("#txtEPaymentCharges").val(FConvert.toDecimal(0, POSCommon.numberOfDecimal));
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime: " + new Date() + ",File:pointOfSaleBillSettlement.js, Method: BILLSETTLEMENT.calculateEPaymentCharges, Catch block : Error Message : " + Ex.message);
            return false;
        }
    },
