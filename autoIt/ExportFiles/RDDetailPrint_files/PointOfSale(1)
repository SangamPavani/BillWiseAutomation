                    objSDD.CombineWithOtherSchemes = $('#chkCombineWithOtherSchemes').is(":checked")
                }

                if ($("#chkBatchesExpiring").is(":checked") == true) {
                    objSDD.BatchesExpiry = 1;
                    var selBatchesExp = $("#ddlBatchesExp option:selected").attr("value");
                    if (selBatchesExp == "0")//In Days
