                        {
                            toastr.info("You can not edit the order in '" + TransactionModeName.get(ApplicationNew.PresentTransactionMode) + "' mode.", "POS Information");
                            return false;
                        }
                    }
                }
            }

            if (ApplicationNew.IsReadOnly == true && ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                var iCount = 0;
                $.each(ApplicationNew.ListOfItems, function (index, record) {
                    if (record.ProductType != 0)
                        iCount++;
                });
                if (iCount > 0) {
                    toastr.info("You can not edit the order in 'Exchange/Spoilage' mode.", "POS Information");
                    return false;
                }
            }

            //Checking adding product rights while editing transaction
            if (ApplicationNew.PresentTransactionMode == 2 && PreferenceSetting.PrefOutletTab.OutletGeneralTab.RestrictAddNewProdWhileEditTran == true && ApplicationNew.IsRecallTransaction == false) {
                toastr.info("Not allowed to add Item while editing transaction.", "POS Information");
                return false;
            }

            //Checking unit conversuion is defined or not
            if (objCustDefLeftPanelDisplay.ProductUnit > 0 && objCustDefLeftPanelDisplay.UnitIdNamePair != null
                && objCustDefLeftPanelDisplay.UnitIdNamePair != undefined && objCustDefLeftPanelDisplay.UnitIdNamePair.length > 0) {
                //checking base unit exists or not
                var unit = objCustDefLeftPanelDisplay.UnitIdNamePair.filter((p) => p.IsBaseUnit == true);
                if (unit != null && unit != undefined && unit.length > 0 && unit[0].Id != objCustDefLeftPanelDisplay.ProductUnit) {
                    //checking sales unit exists or not
                    unit = objCustDefLeftPanelDisplay.UnitIdNamePair.filter((p) => p.Id == objCustDefLeftPanelDisplay.ProductUnit);
                    if (unit != null && unit != undefined && unit.length > 0 && unit[0].Xfactor == 0) {
                        toastr.info("Unit conversion not defined for '" + objCustDefLeftPanelDisplay.ProductName + "'.", "POS Information");
                        if (ApplicationNew.ArrayOfSearchProduct != null && ApplicationNew.ArrayOfSearchProduct != undefined && ApplicationNew.ArrayOfSearchProduct.length > 0)
                            PRODUCTMETHODNEW.SERVERMETHODS.afterAddedProduct();

                        return false;
                    }
                }
                for (let i = 0; i < objCustDefLeftPanelDisplay.UnitIdNamePair.length; i++) {
                    if (objCustDefLeftPanelDisplay.UnitIdNamePair[i].Id != 0 && !objCustDefLeftPanelDisplay.UnitIdNamePair[i].IsBaseUnit && objCustDefLeftPanelDisplay.UnitIdNamePair[i].Xfactor == 0) {
                        toastr.info("Unit conversion not defined for '" + objCustDefLeftPanelDisplay.ProductName + "'.", "POS Information");
                        return false;
                    }
                }
            }

            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainAddProduct.js :: Method :: PRODUCTMETHODNEW.validateProductBeforeAdd :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
