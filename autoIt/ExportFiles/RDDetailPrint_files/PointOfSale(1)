    isValidReturn: function () {
        try {
            let msgReturnIsnotAllowedAfter = $("input#msgReturnIsnotAllowedAfter").val();
            let lbldays = $("input#lbldays").val()
            let selectedReturnType = $("#ddlSalesReturnReturnType").val();

            let AlwdWithInDys = PreferenceSetting.PrefOutletTab.OutletGeneralTab.RtrnAlwdWithInDys;
            let AllowedCriteriaList = PreferenceSetting.PrefOutletTab.OutletGeneralTab.RefundAllowedCriteriaList;
            if (selectedReturnType == 1) {
                AlwdWithInDys = PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedWithInDays;
                AllowedCriteriaList = PreferenceSetting.PrefOutletTab.OutletGeneralTab.ExchangeAllowedCriteriaList;
            }
            if (AlwdWithInDys != null && AlwdWithInDys != undefined && AlwdWithInDys > 0) {
                if (ApplicationNew.SalesReturn.SalesReturnWeb != null && ApplicationNew.SalesReturn.SalesReturnWeb != undefined) {
                    let exchangeAllowedWithinDays = DATE.prototype.addDays(DATE.prototype.today(POSCommon.CalType), parseInt(-AlwdWithInDys), DATEPICKER.getCalendarType());
                    if (ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction != null && ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction != undefined) {
                        if (exchangeAllowedWithinDays > ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction.Header.Date) {
                            toastr.error(msgReturnIsnotAllowedAfter + " " + AlwdWithInDys + " " + lbldays);
                            SALESRETURN.clearSalesReturnsFields(true);
                            return false;
                        }
                    }
                    if (AllowedCriteriaList != null && AllowedCriteriaList != undefined && AllowedCriteriaList.length > 0) {
                        if (ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction != null && ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction != undefined) {
                            let NoOfDays = DATE.prototype.today(POSCommon.CalType) - ApplicationNew.SalesReturn.SalesReturnWeb.LoadedPOSSaleTransaction.Header.Date;
                            NoOfDays = NoOfDays <= 0 ? 1 : NoOfDays;
                            for (let DayCount = 0; DayCount < AllowedCriteriaList.length; DayCount++) {
                                if (NoOfDays >= AllowedCriteriaList[DayCount].FromDays && NoOfDays <= AllowedCriteriaList[DayCount].ToDays) {
                                    AllowedPaymentMethods = AllowedCriteriaList[DayCount].AllowedPaymentTypeId;
                                    break;
                                }
                            }
                        }
                    }
                }
            }
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: SALESRETURN.isValidReturn :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
