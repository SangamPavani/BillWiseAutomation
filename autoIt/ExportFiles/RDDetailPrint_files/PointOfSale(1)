                && memberData.City.trim().length > 0 && memberData.City.trim() != "0") {
                sAddress = sAddress + msgCity + memberData.City;
            }

            if (memberData.State != null && memberData.State != undefined && memberData.State.trim() != ""
                && memberData.State.trim().length > 0 && memberData.State.trim() != "0") {
                sAddress = sAddress + msgState + memberData.State;
            }

            if (memberData.Country != null && memberData.Country != undefined && memberData.Country.trim() != ""
                && memberData.Country.trim().length > 0 && memberData.Country.trim() != "0") {
                sAddress = sAddress + msgCountry + memberData.Country;
