    validateKeyPress: function (event, inputControl) {
        try {

            var charCode = (event.which) ? event.which : event.keyCode;
            if (charCode == 46 || charCode == 8 || (charCode >= 48 && charCode <= 57)) {
                if (event.key == '.') {
                    var value = $(inputControl).val();
                    if (value.indexOf(".") >= 0)
                        return false;
                }
                return true;
            }
            return false;
        }
        catch (Ex) {
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMES.validateKeyPress :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            return;
        }
    },

