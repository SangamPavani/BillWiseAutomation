    getInputControlEvent: function (inputControl, evt = null) {
        try {
            if (evt == null)
                charCode = 13;
            else if (evt != null && evt != undefined)
                charCode = evt.which ? evt.which : evt.keyCode;

            if (charCode == 13 || charCode == 9) {
                let iDenominationId = 0;
                let dayEndModel = $("#divDayEndMain").attr("data-ModelRecord");
                if (dayEndModel == null || dayEndModel == undefined || dayEndModel.length <= 0)
                    return;

                dayEndModel = JSON.parse(dayEndModel);
                let inputControlClosestTableRow = $(inputControl).closest('tr');
                let inputControlClosestTableCell = $(inputControl).closest('td');
                if (inputControlClosestTableRow == null || inputControlClosestTableRow == undefined || inputControlClosestTableRow.length <= 0
                    || inputControlClosestTableCell == null || inputControlClosestTableCell == undefined || inputControlClosestTableCell.length <= 0)
                    return;

                iDenominationId = $(inputControlClosestTableRow).attr('id');

                let selectedDenomination = dayEndModel.DayInPos.CurrencyDetails[0].DenominationList.filter((p) => p.DenominationId == iDenominationId);
                if (selectedDenomination == null || selectedDenomination == undefined || selectedDenomination.length <= 0)
                    return;

                selectedDenomination = selectedDenomination[0];
                selectedDenomination.Count = FConvert.toDecimal($(inputControl).val(), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                selectedDenomination.Total = FConvert.toDecimal((FConvert.toDecimal(selectedDenomination.Count, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) * FConvert.toDecimal(selectedDenomination.DenominationValue, DAYEND.VARIABLE.posCommon.numberOfDecimal, true)), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

                ////debugger;
                let totalDenominationValue = 0;
                for (let i = 0; i < dayEndModel.DayInPos.CurrencyDetails[0].DenominationList.length; i++)
                    totalDenominationValue = FConvert.toDecimal(totalDenominationValue, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal(dayEndModel.DayInPos.CurrencyDetails[0].DenominationList[i].Total, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

                dayEndModel.DayInPos.CurrencyDetails[0].ReportedAmountInBaseCurrency = dayEndModel.DayInPos.CurrencyDetails[0].ReportedAmount = totalDenominationValue;

                $(inputControlClosestTableCell).html(FConvert.toDecimal(selectedDenomination.Count, DAYEND.VARIABLE.posCommon.numberOfDecimal, true));
                $(inputControlClosestTableRow).find('td:last-child').html(FConvert.toDecimal(selectedDenomination.Total, DAYEND.VARIABLE.posCommon.numberOfDecimal, true));

                $("#txtCashInDrawer").val(FConvert.toDecimal(totalDenominationValue, DAYEND.VARIABLE.posCommon.numberOfDecimal));
                $("#txtAmount").val(FConvert.toDecimal(totalDenominationValue, DAYEND.VARIABLE.posCommon.numberOfDecimal));

                let inputControlFound = $(inputControlClosestTableCell).find('input');
                if (inputControlFound != null && inputControlFound != undefined && inputControlFound.length > 0)
                    $(inputControlFound[0]).remove();

                $("#divDayEndMain").attr("data-ModelRecord", JSON.stringify(dayEndModel));
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: retailPopup.js :: Method :: DAYEND.getInputControlEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
    getInputControlMultiCurrencyEvent: function (inputControl) {
        try {
            let iCurrencyId = 0;

            // Getting DayEndModel & Parse
            let dayEndModel = $("#divDayEndMain").attr("data-ModelRecord");
            if (dayEndModel == null || dayEndModel == undefined || dayEndModel.length <= 0)
                return;

            dayEndModel = JSON.parse(dayEndModel);

            // Getting Closest Table Row / table Cell
            let inputControlClosestTableRow = $(inputControl).closest('tr');
            let inputControlClosestTableCell = $(inputControl).closest('td');
            if (inputControlClosestTableRow == null || inputControlClosestTableRow == undefined || inputControlClosestTableRow.length <= 0
                || inputControlClosestTableCell == null || inputControlClosestTableCell == undefined || inputControlClosestTableCell.length <= 0)
                return;

            // Getting Selected Currency Record
            iCurrencyId = $(inputControlClosestTableRow).attr('id');
            let selectedCurrency = $(inputControlClosestTableRow).attr("data-MultiCurrencyDetails");
            if (selectedCurrency == null || selectedCurrency == undefined || selectedCurrency.length <= 0)
                return;

            selectedCurrency = JSON.parse(selectedCurrency);

            // Getting Exchange Rate 
            let exchangeBody = null;
            if (selectedCurrency.IsBaseCurrency == false) {
                exchangeBody = dayEndModel.ExchangeRate.filter((p) => p.CurrencyId == iCurrencyId);
                if (exchangeBody != null && exchangeBody != undefined && exchangeBody.length > 0)
                    exchangeBody = exchangeBody[0];
            }

            ////debugger;
            selectedCurrency.ReportedAmount = FConvert.toDecimal($(inputControl).val(), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
            if (selectedCurrency.IsBaseCurrency == true)
                selectedCurrency.ReportedAmountInBaseCurrency = selectedCurrency.ReportedAmount;
            else
                selectedCurrency.ReportedAmountInBaseCurrency = FConvert.toDecimal(FConvert.toDecimal(selectedCurrency.ReportedAmount) * FConvert.toDecimal(exchangeBody.Rate), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

            selectedCurrency.DifferenceAmount = FConvert.toDecimal((FConvert.toDecimal(selectedCurrency.AmountBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) - FConvert.toDecimal(selectedCurrency.ReportedAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true)), DAYEND.VARIABLE.posCommon.numberOfDecimal, true);

            // Removing Input Control
            $(inputControlClosestTableCell).find('input').remove();
            $(inputControlClosestTableCell).html(FConvert.toDecimal(selectedCurrency.ReportedAmount, DAYEND.VARIABLE.posCommon.numberOfDecimal, true));

            $(inputControlClosestTableRow).attr("data-MultiCurrencyDetails", JSON.stringify(selectedCurrency));

            let totalAmountInBaseCurrency = 0;
            //Read all Table Row ' data-Attribute. Make loop.. 
            let tBodyMultiCurrency = $("#tBodyMultiCurrency > tr"), parsedCurrencyRecord = null;
            if (tBodyMultiCurrency != null && tBodyMultiCurrency != undefined && tBodyMultiCurrency.length > 0) {
                for (let i = 0; i < tBodyMultiCurrency.length; i++) {
                    parsedCurrencyRecord = $(tBodyMultiCurrency[i]).attr("data-MultiCurrencyDetails");
                    if (parsedCurrencyRecord != null && parsedCurrencyRecord != undefined && parsedCurrencyRecord.trim().length > 0) {
                        parsedCurrencyRecord = JSON.parse(parsedCurrencyRecord);
                        totalAmountInBaseCurrency = FConvert.toDecimal(totalAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true) + FConvert.toDecimal(parsedCurrencyRecord.ReportedAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal, true);
                    }
                }
            }

            if (totalAmountInBaseCurrency > 0)
                $("#txtCashInDrawer").val(FConvert.toDecimal(totalAmountInBaseCurrency, DAYEND.VARIABLE.posCommon.numberOfDecimal));
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: DAYEND.getInputControlMultiCurrencyEvent :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
