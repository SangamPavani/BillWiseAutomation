        getPaymentIntegrationTabPreferences: function () {
            try {
                debugger;
                let controlValue = null;
                let paymentIntegrationTab = new Object();
                paymentIntegrationTab.PrefPaymentIntegrationTab = new Object();

                paymentIntegrationTab.PrefKey = "PINT";
                paymentIntegrationTab.PrefPaymentIntegrationTab.IsPaymentIntegrationEnable = $("#chkPaymentIntegrationTab").is(":checked");

                controlValue = $("#ddlProvider option:selected").val();
                if (controlValue == null || controlValue == undefined)
                    paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationProvider = 0;
                else
                    paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationProvider = controlValue;

                // Provider : Innoviti
                paymentIntegrationTab.PrefPaymentIntegrationTab.InnovitiIntegration = new Object();

                controlValue = $("#txtAPIURL").val();
                if (controlValue == null || controlValue == undefined || controlValue == "/" || controlValue.trim().length <= 0)
                    paymentIntegrationTab.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationAPIUrl = null;
                else
                    paymentIntegrationTab.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationAPIUrl = controlValue.trim();

                let selOptionList = LISTCHECKBOXCONTROL.getControlData("ddlPaymentIntegrationType"), paymentIntegrationTypeText = "", paymentIntegrationTypeId = "";
                if (selOptionList != null && selOptionList != undefined && selOptionList.length > 0) {
                    for (let i = 0; i < selOptionList.length; i++) {
                        paymentIntegrationTypeText += selOptionList[i].Name + ", ";
                        paymentIntegrationTypeId += selOptionList[i].ID + ", ";
                    }

                    if (paymentIntegrationTypeText.length > 0)
                        paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationType = paymentIntegrationTypeText.substring(0, paymentIntegrationTypeText.length - 2);

                    if (paymentIntegrationTypeId.length > 0)
                        paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationTypeId = paymentIntegrationTypeId.substring(0, paymentIntegrationTypeId.length - 2);
                }

                selOptionList = LISTCHECKBOXCONTROL.getControlData("ddlNotRequiredForCounters"), notRequiredCounterText = "", notRequiredCounterId = "";
                if (selOptionList != null && selOptionList != undefined && selOptionList.length > 0) {
                    for (let i = 0; i < selOptionList.length; i++) {
                        notRequiredCounterText += selOptionList[i].Name + ", ";
                        notRequiredCounterId += selOptionList[i].ID + ", ";
                    }

                    if (notRequiredCounterText != null && notRequiredCounterText != undefined && notRequiredCounterText.length > 0)
                        paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText = notRequiredCounterText.substring(0, notRequiredCounterText.length - 2);
                    else
                        paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterText = null;

                    if (notRequiredCounterId != null && notRequiredCounterId != undefined && notRequiredCounterId.length > 0)
                        paymentIntegrationTab.PrefPaymentIntegrationTab.PaymentIntegrationNotAllowedCounterId = notRequiredCounterId.substring(0, notRequiredCounterId.length - 2);
