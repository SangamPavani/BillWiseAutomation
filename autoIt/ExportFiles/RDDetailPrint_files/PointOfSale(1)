                var msgtxtInfoToSearch = $("#msgtxtInfoToSearch").val();
                var msgtxtNoResultsFound = $("#msgtxtNoResultsFound").val();
                var msgtxtErrWhileRetrvingSelctdItmDtlsPlzContYourSystmAdminstr = $("#msgtxtErrWhileRetrvingSelctdItmDtlsPlzContYourSystmAdminstr").val();
                if ($.trim(SearchTextItem).length < iMinchar) {
                    toastr.error(msgtxtInfoPlzMin + iMinchar + msgtxtInfoToSearch);
                    return;
                }
