        getChildren: function (clickedElement) {
            //
            try {

                var clsName = clickedElement.classList;
                if (clsName != null && clsName != undefined && clsName.length > 0) {
                    for (var i = 0; i < clsName.length; i++) {
                        if (clsName[i] == "false")
                            return;
                    }

                    var parentli = $(clickedElement).closest("li");
                    var node = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(parentli[0]);
                    if (node.children != null && node.children != undefined && node.children.length > 0) {
                        for (let i = 0; i < node.children.length; i++) {
                            var productInfo = node.children[i].Tag;
                            if (productInfo != null && productInfo != undefined && productInfo != "") {
                                if (productInfo.IsGroup == false)
                                    return;
                            }
                        }
                    }
                    var bCallServerMethod = true;
                    if (node.children == null || node.children == undefined || node.children.length <= 0)
                        bCallServerMethod = true;
                    else if (node.children != null && node.children != undefined && node.children.length > 0) {
                        for (let i = 0; i < node.children.length; i++) {
                            var childrenNode = $("#" + FPRODUCTCONTROL._PRIVATEVARIABLE.SEARCHOPTION.controlName + " div#divProductSearchTree").jstree().get_node(node.children[i]);
                            if (childrenNode != null && childrenNode != undefined && childrenNode.original != null
                                && childrenNode.original != undefined && childrenNode.original.Tag != null && childrenNode.original.Tag != undefined)
                                if (childrenNode.original.Tag.IsGroup == false) {
                                    bCallServerMethod = false;
                                    break;
                                }
                        }
                    }
                    if (bCallServerMethod == true)
                        FPRODUCTCONTROL.SERVERMETHODS.getProductsListBasedOnGroupIdAsync(node);
                    else
                        node.state.selected = false;
                }
            }
            catch (Ex) {
                COMMON.prototype.showMessage(Ex.message, "");
                console.log("DateTime :: " + new Date() + " :: File :: retailMainControl.js :: Method :: FPRODUCTCONTROL.TREEEVENT.getChildren :: Catch block :: Message :: " + Ex.message + " :: Description :: " + Ex.description);
            }
        },
