                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails != undefined
                && BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length > 0) {
                if (BillSettlement.BillSettlementPaymentDetails.CreditNotePaidDetails.length > 10) {
                    toastr.error(msgCannotRedeemMoreThan10CreditNotesTrans, msgPOSException);
                    return;
                }
            }

            if (BILLSETTLEMENT.isValidCreditNote(true)) {

                BILLSETTLEMENT.VARIABLE.dCNRedeemedAmt = FConvert.toDecimal(creditNoteValue);
                BILLSETTLEMENT.VARIABLE.dCNValue = FConvert.toDecimal($("#txtCreditNoteValue").attr("data-Tag"));
