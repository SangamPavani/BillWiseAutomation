        try {
            //debugger;
            if (RETAILMAIN.VARIABLE.TableHeaderRMARequiredRemove == true && RETAILMAIN.VARIABLE.TableHeaderRMA != null && RETAILMAIN.VARIABLE.TableHeaderRMA != undefined && POSCommon.posTemplate.IsEstimatedBill == false) {
                let tableHeaderColumn = RETAILMAIN.VARIABLE.TableHeader;
                if (tableHeaderColumn != null && tableHeaderColumn != undefined && tableHeaderColumn.length > 0) {
                    for (let i = 0; i < tableHeaderColumn.length; i++) {
                        let columnId = $(tableHeaderColumn[i]).attr("id");
                        if (columnId != null && columnId != undefined && columnId.length > 0 && columnId == "tHeadRMA") {
                            //debugger;
                            let tableHeaderRow = $("#tblSelectedProduct > #tHeadSelectedProduct > tr");
                            let tableFooterRow = $("#tblSelectedProduct > #tFootSelectedProduct > tr");

                            if (tableHeaderRow != null && tableHeaderRow != undefined && tableHeaderRow.length > 0)
                                tableHeaderRow = tableHeaderRow[0];

                            if (tableFooterRow != null && tableFooterRow != undefined && tableFooterRow.length > 0)
                                tableFooterRow = tableFooterRow[0];

                            let previousSibling = null;
                            if (tableHeaderRow.children != null && tableHeaderRow.children != undefined && tableHeaderRow.children.length > 0) {
                                previousSibling = tableHeaderRow.children[i - 1];
                                if (previousSibling != null && previousSibling != undefined)
                                    $(previousSibling).after(RETAILMAIN.VARIABLE.TableHeaderRMA);
                            }
                            if (tableFooterRow.children != null && tableFooterRow.children != undefined && tableFooterRow.children.length > 0) {
                                previousSibling = tableFooterRow.children[i - 1];
                                if (previousSibling != null && previousSibling != undefined)
                                    $(previousSibling).after(RETAILMAIN.VARIABLE.TableFooterRMA);
                            }
                        }
                    }
                }

                const tHeadProduct = $("#tblSelectedProduct > #tHeadSelectedProduct #tHeadProduct");
                const tHeadRMA = $("#tblSelectedProduct > #tHeadSelectedProduct #tHeadRMA");
                if (tHeadProduct != null && tHeadProduct != undefined && tHeadProduct.length > 0 && tHeadRMA != null && tHeadRMA != undefined && tHeadRMA.length > 0) {
