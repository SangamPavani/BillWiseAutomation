            let postVATInPreOrderCreditNote = arrParams[6];

            let journalVoucherExtraFields = VOUCHERPOSTING.SINGLTONVARIABLES.VoucherExtraFieldsInfo.filter((p) => p.VoucherType == PreferenceSetting.PrefPostingTab.JournalVoucher);
            if (journalVoucherExtraFields != null && journalVoucherExtraFields != undefined && journalVoucherExtraFields.length > 0)
                journalVoucherExtraFields = journalVoucherExtraFields[0];

            let CNBodyExtra = [], extraValue = new Object();

            // Adding Header Extra Field(Payment Type Id)
            if (journalVoucherExtraFields.JournalVoucherPaymentTypeId > 0) {
                extraValue = new Object();
                extraValue.ID = journalVoucherExtraFields.JournalVoucherPaymentTypeId;
                extraValue.Name = PosBodyExtraFieldNames.iPaymentType;
                extraValue.Tag = paymentType;
                CNBodyExtra.push(extraValue);
            }

            // Pre Order VAT Posting
            if (postVATInPreOrderCreditNote == true && POSCommon.creditNoteVATEnabled == true && vatEligibleBalance != 0) {

                VOUCHERHEADEREXTRAFIELD.fillTransactionBodyExtraData(PosBodyExtraFieldNames.TaxCode, CNBodyExtra, POSCommon.vatTaxCode, journalVoucherExtraFields.VoucherHeaderBodyExtraFields, voucherType);
                let VAT = 0;
                if (vatEligibleBalance >= paidAmount) {
                    VAT = (totalVAT * paidAmount) / vatNetAmount;
                    vatEligibleBalance = vatEligibleBalance - paidAmount;
                }
                else {
                    if (totalVAT > 0) {
                        VAT = (totalVAT * vatEligibleBalance) / vatNetAmount;
                        vatEligibleBalance = 0;
                    }
                    else {
                        VAT = 0;
                        vatEligibleBalance = 0;
                    }
                }
                VOUCHERHEADEREXTRAFIELD.fillTransactionHeaderExtraData(PosBodyExtraFieldNames.VAT, CNBodyExtra, VAT, journalVoucherExtraFields.VoucherHeaderBodyExtraFields, voucherType);
