                            _loadingProduct.DefaultValue5 = FConvert.toDecimal(_loadingProduct.DefaultValue5, POSCommon.NumberOfDecimals, true) + FConvert.toDecimal(_NewLineList[RateCounter].DefaultValue5, POSCommon.NumberOfDecimals, true);
                            if (FConvert.toDecimal(_loadingProduct.DefaultValue3, POSCommon.NumberOfDecimals, true) * FConvert.toDecimal(_loadingProduct.DefaultValue4, POSCommon.NumberOfDecimals, true) != FConvert.toDecimal(_loadingProduct.DefaultValue5, POSCommon.NumberOfDecimals, true))
                                _loadingProduct.DefaultValue4 = FConvert.toDecimal(_loadingProduct.DefaultValue5, POSCommon.NumberOfDecimals, true) / FConvert.toDecimal(_loadingProduct.DefaultValue3, POSCommon.NumberOfDecimals, true);

                            // Filling Screen Data For "Main Product Set"
                            if (_NewLineList[ProductCounter].DynamicLineFields != null && _NewLineList[ProductCounter].DynamicLineFields != undefined && _NewLineList[ProductCounter].DynamicLineFields.length > 0) {
                                for (let k = 0; k < _NewLineList[ProductCounter].DynamicLineFields.length; k++) {
                                    if (setItmeCounter == 0) {
