        SaveEmployeeData: function () {
            try {
                MESSAGEPOPUPSFORSCHEMES.closeSchemesDefinitionPopup();
                var optEmployeeDiscountScheme = OPTIONCONTROL.getControlDataObject("optEmployeeSchemeName");
                var EmpSchemeId = optEmployeeDiscountScheme.iId;
                var dtpFromDate = DATEPICKER.getDate(dtpFromDateEmp);
                var dtpToDate = DATEPICKER.getDate(dtpToDateEmp);
                var objSchemesDiscountDef = new Object();
                objSchemesDiscountDef.Name = optEmployeeSchemeName.value;
                objSchemesDiscountDef.DiscTypeID = 3;
                objSchemesDiscountDef.Outlets = SCHEMESOUTLETS.VARIABLE.OutletId;
                objSchemesDiscountDef.Employees = SCHEMESDISCOUNT.VARIABLE.ItemId;

                // Days
                var SchemesDays = "";
                for (var i = 0; i < SCHEMESDISCOUNT.EMPLOYEEDISCOUNT.VARIABLE.lstEmployeeWeekDays.length; i++)
                    SchemesDays += SCHEMESDISCOUNT.EMPLOYEEDISCOUNT.VARIABLE.lstEmployeeWeekDays[i].ID + ",";

                if (SchemesDays.length > 0) {
                    SchemesDays = SchemesDays.substring(0, SchemesDays.length - 1);
                    objSchemesDiscountDef.SchemesDays = SchemesDays;
                }
                else
                    objSchemesDiscountDef.SchemesDays = "";

                // Scheme For
                objSchemesDiscountDef.PreOrderScheme = false;
                objSchemesDiscountDef.Inactive = false;
                var selOptionList = LISTCHECKBOXCONTROL.getControlData("ddlSchemeForEmp");
                for (var i = 0; i < selOptionList.length; i++) {
                    if (selOptionList[i].ID == 1)
                        objSchemesDiscountDef.PreOrderScheme = true;
                    if (selOptionList[i].ID == 2)
                        objSchemesDiscountDef.Inactive = true;
                }

                objSchemesDiscountDef.FromDateInt = dtpFromDate;
                objSchemesDiscountDef.ToDateInt = dtpToDate;
                objSchemesDiscountDef.FromTimeInt = FTIMECONTROL.getTime("tpFromTimeEmp");
                objSchemesDiscountDef.ToTimeInt = FTIMECONTROL.getTime("tpToTimeEmp");
                objSchemesDiscountDef.SchemeTypeID = $("#ddlSchemeTypeEmp").val();
                //objSchemesDiscountDef.PreOrderScheme = $("#chkEmployeeSchemePreOrderScheme").is(":checked");
                //objSchemesDiscountDef.Inactive = $("#chkEmployeeSchemeInactive").is(":checked");
                var tbodyEmployeeList = [];
                if ($("#tbodyEmployeeDiscount tr").length > 0) {
                    var employeeRows = $("#tbodyEmployeeDiscount tr");

                    for (let i = 0; i < employeeRows.length; i++) {
                        if ($(employeeRows[i]).attr('data-employeeSchemeDiscountDetails') != null && $(employeeRows[i]).attr('data-employeeSchemeDiscountDetails') != undefined) {
                            var parsedEmployeeRow = JSON.parse($(employeeRows[i]).attr('data-employeeSchemeDiscountDetails'));
                            if (parsedEmployeeRow.ProductIds != null && parsedEmployeeRow.ProductIds != undefined && parsedEmployeeRow.ProductIds != "" && parsedEmployeeRow.ProductIds.length > 0)
                                parsedEmployeeRow.ProductIds = parsedEmployeeRow.ProductIds;
                            else
                                parsedEmployeeRow.ProductIds = "";
                            tbodyEmployeeList.push(parsedEmployeeRow);
                        }
                    }
                }
                objSchemesDiscountDef.Employees = tbodyEmployeeList;
                objSchemesDiscountDef.TreeID = 0; // Re-Check after Tree is done
                objSchemesDiscountDef.MndtryItemsFlag = 1; // Re-Check after Tree is done
                if (EmpSchemeId != null && EmpSchemeId != undefined && EmpSchemeId > 0)//if (optPymntSchemeName.Tag == null)
                {
                    objSchemesDiscountDef.ID = EmpSchemeId;
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("UpdateEmployeeSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", false, "SCHEMESDISCOUNT.EMPLOYEEONSUCCESSSERVERMETHODS.onSuccessUpdateEmployeeData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
                else {
                    NETWORK.executeServerMethod(GLOBAL.getContextPath("SaveEmployeeSchemesDiscDef", "RetailMainScreen", "PointOfSale"),
                        true, { SchemesDiscountDef: objSchemesDiscountDef }, "JSON", true, "SCHEMESDISCOUNT.EMPLOYEEONSUCCESSSERVERMETHODS.onSuccessSaveEmployeeData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
            }
            catch (Ex) {
                GLOBAL.LoadingEnd();
                toastr.error(Ex.message, "POS Exception");
                console.log("DateTime: " + new Date() + " :: File :: retailMainSchemes.js :: Method :: SCHEMESDISCOUNT.EMPLOYEEDISCOUNT.SaveEmployeeData :: Catch block :: Exception :: " + Ex.message);
            }
        },

