    getSelectedRMANos: function () {
        try {
            //debugger;
            //let msgPleaseSelectReprintDayEnd = $("input#msgPleaseSelectReprintDayEnd").val();
            //let msgCannotselectmorethanQuantity = $("input#msgCannotselectmorethanQuantity").val();
            //let msgErrorWhilefetchingTablerow = $("input#msgErrorWhilefetchingTablerow").val();
            let msgPleaseSelectReprintDayEnd = "Please select ";
            let msgCannotselectmorethanQuantity = "Cannot select more than Quantity ";
            let msgRMAsToReturn = " RMAs to return.";
            let msgErrorWhilefetchingTablerow = "Error while fetching table row";

            var selectedRMANos = [];
            var SRRMANos = $('#tBodySalesReturnRMA').find('tr');
            if (SRRMANos != null && SRRMANos != undefined && SRRMANos.length > 0) {

                if (SALESRETURN.VARIABLES.CustLineWiseUIR != null && SALESRETURN.VARIABLES.CustLineWiseUIR != undefined) {
                    if (SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn == 0)
                        return;
                    var SelectedRMA = null;
                    for (let i = 0; i < SRRMANos.length; i++) {
                        if ($(SRRMANos[i]).find('td:first').find('input[type="checkbox"]').prop('checked') == true) {
                            SelectedRMA = $(SRRMANos[i]).attr('data-RMA'); // ReturningRMANos
                            selectedRMANos.push(SelectedRMA);
                        }
                    }

                    if (selectedRMANos.length == 0) {
                        toastr.error(msgPleaseSelectReprintDayEnd + SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn + msgRMAsToReturn);
                        return;
                    }
                    if (SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex == -1) {
                        if (selectedRMANos.length > SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn) {
                            toastr.error(msgCannotselectmorethanQuantity, "POS Exception");
                            return;
                        }
                        else if (selectedRMANos.length < SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn) {
                            toastr.error(msgPleaseSelectReprintDayEnd + SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn + msgRMAsToReturn, "POS Exception");
                            return;
                        }
                    }
                    else if (SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex > -1) {
                        if (selectedRMANos.length > ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex].SetsDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex].QtyToReturn) {
                            toastr.error(msgCannotselectmorethanQuantity, "POS Exception");
                            return;
                        }
                        else if (selectedRMANos.length < SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn) {
                            toastr.error(msgPleaseSelectReprintDayEnd + SALESRETURN.VARIABLES.CustLineWiseUIR.QtyToReturn + msgRMAsToReturn, "POS Exception");
                            return;
                        }
                    }

                    var tableRow = null;

                    if (SALESRETURN.VARIABLES.rmaIndex[0].ProductType == 0)
                        tableRow = $('#tBodySalesReturn').find('tr[data-SelectedIndex=' + SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex + ']');
                    else if (SALESRETURN.VARIABLES.rmaIndex[0].ProductType == 1)
                        tableRow = $('#tBodySalesReturn').find('tr[data-SelectedIndex=' + SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex + SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex + ']');

                    if (tableRow == null || tableRow == undefined || tableRow.length <= 0) {
                        toastr.error(msgErrorWhilefetchingTablerow);
                        return;
                    }

                    if (SALESRETURN.VARIABLES.CustLineWiseUIR.PosProductMake == 1) {
                        var parsedBillRecord = $(tableRow).attr('data-RowRecord');
                        if (parsedBillRecord != null && parsedBillRecord != undefined)
                            parsedBillRecord = JSON.parse(parsedBillRecord);

                        var seperatedRMAs = "";
                        for (let j = 0; j < selectedRMANos.length; j++)
                            seperatedRMAs = seperatedRMAs + selectedRMANos[j] + ",";

                        if (seperatedRMAs != null && seperatedRMAs != undefined && seperatedRMAs.trim().length > 0)
                            seperatedRMAs = seperatedRMAs.substr(0, (seperatedRMAs.length - 1));

                        parsedBillRecord.ReturningRMANos = selectedRMANos;
                        $(tableRow).find("td[id='SalesReturnReturnedRMANos']").html(seperatedRMAs);
                        $(tableRow).attr('data-RowRecord', JSON.stringify(parsedBillRecord));
                        //SALESRETURN.VARIABLES.CustLineWiseUIR[SALESRETURN.VARIABLES.currentIndex] = parsedBillRecord;

                        var parentRowAttr = $(SALESRETURN.VARIABLES.parentTableRow).attr('data-SRRowRecord');
                        if (parentRowAttr != null && parentRowAttr != undefined && parentRowAttr.length > 0) {
                            parentRowAttr = JSON.parse(parentRowAttr);
                            parentRowAttr.SetsDetails[SALESRETURN.VARIABLES.currentIndex] = parsedBillRecord;
                            $(SALESRETURN.VARIABLES.parentTableRow).attr('data-SRRowRecord', JSON.stringify(parentRowAttr));
                        }

                        ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex].SetsDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex].ReturningRMANos = selectedRMANos;
                    }
                    else if (SALESRETURN.VARIABLES.CustLineWiseUIR.PosProductMake == 0) {

                        var parsedBillRecord = $(tableRow).attr('data-SRRowRecord');
                        if (parsedBillRecord != null && parsedBillRecord != undefined)
                            parsedBillRecord = JSON.parse(parsedBillRecord);

                        var seperatedRMAs = "";
                        for (let j = 0; j < selectedRMANos.length; j++)
                            seperatedRMAs = seperatedRMAs + selectedRMANos[j] + ",";

                        if (seperatedRMAs != null && seperatedRMAs != undefined && seperatedRMAs.trim().length > 0)
                            seperatedRMAs = seperatedRMAs.substr(0, (seperatedRMAs.length - 1));

                        parsedBillRecord.ReturningRMANos = selectedRMANos;
                        $(tableRow).find("td[id='SalesReturnReturnedRMANos']").html(seperatedRMAs);
                        $(tableRow).attr('data-SRRowRecord', JSON.stringify(parsedBillRecord));

                        ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex].ReturningRMANos = selectedRMANos;
                    }
                }

                $("#divSalesReturnRMAModal").hide();
                RETAILMAIN.setFocusBarCodeTextBox();

                //debugger;
                if (SALESRETURN.VARIABLES.rmaIndex != null && SALESRETURN.VARIABLES.rmaIndex != undefined && SALESRETURN.VARIABLES.rmaIndex.length > 0) {
                    SALESRETURN.VARIABLES.rmaIndex.splice(0, 1);
                    if (SALESRETURN.VARIABLES.rmaIndex != null && SALESRETURN.VARIABLES.rmaIndex != undefined && SALESRETURN.VARIABLES.rmaIndex.length > 0) {
                        if (SALESRETURN.VARIABLES.rmaIndex[0].ProductType == 1) {
                            SALESRETURN.VARIABLES.CustLineWiseUIR = ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex].SetsDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductChildIndex];
                            SALESRETURN.openSalesReturnRMAPopup(ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex]);
                        }
                        else if (SALESRETURN.VARIABLES.rmaIndex[0].ProductType == 0) {
                            SALESRETURN.VARIABLES.CustLineWiseUIR = ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex];
                            SALESRETURN.openSalesReturnRMAPopup(ApplicationNew.SalesReturn.SalesReturnWeb.ProductDetails[SALESRETURN.VARIABLES.rmaIndex[0].ProductIndex]);
                        }

                    }
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: File :: pointOfSaleCommon.js :: Method :: SALESRETURN.getSelectedRMANos :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
