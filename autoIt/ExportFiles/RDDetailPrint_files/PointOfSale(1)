    createPagesDynamically: function (iTotalPage, iRecordPerPage, isProductButtonCreating, iParentOrFunctionId, itotalCount) {
        try {
            //debugger;
            var iTemplateId = $("#posTemplateId").val();

            var onClickString = null;
            if (isProductButtonCreating == 1)
                onClickString = "RETAILMAIN.getProductPaging(this,'" + iTemplateId + "')";
            else if (isProductButtonCreating == 2)
                onClickString = "RETAILMAIN.getFuncShortPaging(this,'" + iTemplateId + "','" + iRecordPerPage + "','" + itotalCount + "')";
            else if (isProductButtonCreating == 3)
                onClickString = "RETAILMAIN.getStarProductPaging(this,'" + iTemplateId + "','" + iRecordPerPage + "','" + itotalCount + "')";
            else if (isProductButtonCreating == 5)
                onClickString = "RETAILMAIN.getFuncShortPagingonLoad(this,'" + iTemplateId + "','" + iRecordPerPage + "','" + itotalCount + "')";

            var iStartNumber = 0;
            for (let i = 1; i <= iTotalPage; i++) {
                var r = null; //btnPageButton
