    debitCardClick: function (btnCardClicked) {
        try {
            var deditCardBtn = document.getElementById("divRowDebitCard");
            if (deditCardBtn != null && deditCardBtn != undefined && deditCardBtn.children != null
                && deditCardBtn.children != undefined && deditCardBtn.children.length > 0) {
                for (let i = 0; i < deditCardBtn.children.length; i++)
                    deditCardBtn.children[i].classList.remove('billsettlement-selected-card');
            }

            $(btnCardClicked).addClass('billsettlement-selected-card');
            BillSettlement.SelectedDebitCard = JSON.parse($(btnCardClicked).attr('data-CardDetails'));
            var schemeDisc = 0, cCAmtPaying = 0;
            cCAmtPaying = FConvert.toDecimal($("#txtDebitCardAmount").val(), POSCommon.numberOfDecimal);
            if (FConvert.toDecimal($("#txtDebitCardSchemeDiscount").val()) > 0) {
                schemeDisc = FConvert.toDecimal($("#txtDebitCardSchemeDiscount").val());
                cCAmtPaying = FConvert.toDecimal(cCAmtPaying);
                cCAmtPaying += FConvert.toDecimal(schemeDisc);
            }
            schemeDisc = 0;
            let _prompts = BILLSETTLEMENT.SCHEMESMETHODS.applyPaymentTypeSchemes(PaymentTypes.get("DEBITCARD"), 0, BillSettlement.SelectedDebitCard.ID, 0, cCAmtPaying, false, 0, false);
