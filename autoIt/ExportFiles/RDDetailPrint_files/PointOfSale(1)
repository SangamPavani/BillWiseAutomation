    getProductIdFromBarcodeAndAddItem: function (barCodeText, schemesId) {
        try {
            //debugger;
            let tableIndex = -1;
            let inputControl = $("input[type=checkbox][id*='chkAnyItem'][data-SchemesId=" + schemesId + "]");
            if (inputControl != null && inputControl != undefined && inputControl.length > 0)
                tableIndex = $(inputControl).attr("data-index");

            let barCodeArray = BILLSETTLEMENTSCHEMES.SERVERMETHODS.getSearchFreeItemByBarCode(barCodeText);
            if (barCodeArray == null || barCodeArray == undefined || barCodeArray.length <= 0) {
                if (PreferenceSetting.PrefMiscellaneousOtherTab.DisplayMsgBarcodeNotExists == true) {
                    toastr.info("The entered Barcode does not exist.", "POS Information");
                    return;
                }
            }
            //debugger;
            if (barCodeArray != null && barCodeArray != undefined && barCodeArray.length > 0) {
                let barCodeTag = barCodeArray[0].Tag;
                if (barCodeArray[0].ID <= 0) {
                    toastr.info("The entered Barcode is not valid.", "POS Information");
                    return;
                }

                if (barCodeTag != null && barCodeTag != undefined && barCodeTag.length > 0) {
                    let barCodeIdNamePair = barCodeTag.filter((p) => p.ID == 0 && (p.Value != null && p.Value != undefined && p.Value.trim().length > 0));
                    if (barCodeIdNamePair != null && barCodeIdNamePair != undefined && barCodeIdNamePair.length > 0)
                        barCodeIdNamePair = barCodeIdNamePair[0];

                    batch = barCodeIdNamePair != null ? FConvert.toString(barCodeIdNamePair.Value) : " ";

                    barCodeIdNamePair = barCodeTag.filter((p) => p.ID == 2);
                    if (barCodeIdNamePair != null && barCodeIdNamePair != undefined && barCodeIdNamePair.length > 0) {
                        barCodeIdNamePair = barCodeIdNamePair[0];
                        quantity = FConvert.toDecimal(barCodeIdNamePair.Value, POSCommon.numberOfDecimal, true);
                    }
                    else
                        quantity = 0;

                    barCodeIdNamePair = barCodeTag.filter((p) => p.ID == 3);
                    if (barCodeIdNamePair != null && barCodeIdNamePair != undefined && barCodeIdNamePair.length > 0)
                        barCodeIdNamePair = barCodeIdNamePair[0];

                    Rate = barCodeIdNamePair != null ? FConvert.toDecimal(barCodeIdNamePair.Value, POSCommon.numberOfDecimal, true) : 0;

                    barCodeIdNamePair = barCodeTag.filter((p) => p.ID == 8);
                    if (barCodeIdNamePair != null && barCodeIdNamePair != undefined && barCodeIdNamePair.length > 0)
                        barCodeIdNamePair = barCodeIdNamePair[0];

                    unit = barCodeIdNamePair != null ? FConvert.toInt(barCodeIdNamePair.Value) : 0;
                }

                if (barCodeArray[0].ID > 0 && barCodeArray[0].ID <= 0) {
                    toastr.info("The entered Barcode does not exist.", "POS Information");
                    return;
                }

                if (barCodeArray[0].ID > 0) {
                    let foundPrompts = ApplicationNew.TotalSchemesInfo.PromptsToShow.filter((f) => f.SchemeId == schemesId && f.ProductId == barCodeArray[0].ID);
                    if (foundPrompts == null || foundPrompts == undefined || foundPrompts.length <= 0) {
                        toastr.info("The entered Barcode does not exist.", "POS Information");
                        return;
                    }

                    if (foundPrompts != null && foundPrompts != undefined && foundPrompts.length > 0) {
                        foundPrompts = foundPrompts[0];

                        let lastPrompt = new Object();
                        lastPrompt.SchemeId = foundPrompts.SchemeId;
                        lastPrompt.FromScreen = foundPrompts.FromScreen;
                        lastPrompt.FreeItemType = foundPrompts.FreeItemType;
                        lastPrompt.FreeItemTypeString = foundPrompts.FreeItemType == 1 ? "Any Item" : "All Items";
                        lastPrompt.SchemeName = foundPrompts.SchemeName;
                        lastPrompt.IsChecked = true;
                        lastPrompt.IsReadOnly = foundPrompts.FreeItemType == 1 ? false : true;
                        lastPrompt.SearchVisibility = 1;
                        lastPrompt.Quantity = 0;
                        lastPrompt.FreeQtyToAdd = 0;

                        lastPrompt.PromptDetails = ApplicationNew.TotalSchemesInfo.PromptsToShow.filter((f) => f.SchemeId == schemesId && f.ProductId == barCodeArray[0].ID);

                        if (lastPrompt.PromptDetails != null && lastPrompt.PromptDetails != undefined && lastPrompt.PromptDetails.length > 0) {
                            lastPrompt.PromptDetails[0].FreeQtyToAdd = 0;

                            $("#tBodySchemeFreeItemSelection" + tableIndex).html("");
                            $("#tBodySchemeFreeItemSelection" + tableIndex).append("<tr class='pos-table-row' data-ProductId=" + lastPrompt.PromptDetails[0].ProductId + "><td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-left'>" + lastPrompt.PromptDetails[0].ProductName + "</td>" + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-left'>" + lastPrompt.PromptDetails[0].ProductCode + "</td>" + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-right' style=width:15%>" + FConvert.toDecimal(lastPrompt.PromptDetails[0].Rate, POSCommon.numberOfDecimal) + "</td>" + "<td class='pos-table-body-cell pos-table-body-cell-trim pos-table-cell-right' style=width:15% onclick=BILLSETTLEMENTSCHEMES.setRequiredQuantity(this);>" + lastPrompt.PromptDetails[0].FreeQtyToAdd + "</td>" + "</tr>");
                            var tBodyChild = document.getElementById("tBodySchemeFreeItemSelection" + tableIndex);
                            if (tBodyChild != undefined && tBodyChild != null && tBodyChild.children.length > 0) {
                                var lastChild = tBodyChild.children[tBodyChild.children.length - 1];
                                lastChild.setAttribute("data-SchemeAnyItem", JSON.stringify(lastPrompt.PromptDetails[0]));
                            }

                            $("#divSchemeFreeItemSelectionModalBodyAnyItemsFooterLeftPanel" + tableIndex).hide();
                            $("#divSchemeFreeItemSelectionModalBodyAnyItemsFooterRightPanel" + tableIndex).show();
                        }
                    }
                }
            }
        }
        catch (EX) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: pointOfSaleBillSettlement.js :: JavaScript function :: BILLSETTLEMENTSCHEMES.getProductIdFromBarcodeAndAddItem :: Catch Block :: Exception :: " + Ex.message);
        }
