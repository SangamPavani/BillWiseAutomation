    setWalletORCardIntegrationEnabled: function (billSettlement) {
        try {
            var strPaymentMethods = "";
            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab != undefined) {
                if (billSettlement.IsPreOrderScreen == true)
                    strPaymentMethods = PreferenceSetting.PrefOutletTab.OutletGeneralTab.PreorderPayMethods;
                else
                    strPaymentMethods = PreferenceSetting.PrefOutletTab.OutletGeneralTab.AllowdPaymntMethds;
            }

            if (PreferenceSetting.PrefPaymentIntegrationTab.IsPaymentIntegrationEnable == true) {
                PreferenceSetting.PrefPaymentIntegrationTab.IsCardPaymentIntegrationEnable = true;

                if (PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.Innoviti) {
                    PreferenceSetting.PrefPaymentIntegrationTab.IsWalletIntegrationEnable = false;

                    if (PreferenceSetting.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationNotAllowedCounterId != null
                        && PreferenceSetting.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationNotAllowedCounterId != undefined &&
                        PreferenceSetting.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationNotAllowedCounterId.trim().length > 0) {
                        const arrCounterids = PreferenceSetting.PrefPaymentIntegrationTab.InnovitiIntegration.PaymentIntegrationNotAllowedCounterId.split(',');
                        for (let c = 0; c < arrCounterids.length; c++) {
                            if (arrCounterids[c] == POSCommon.counterId) {
                                PreferenceSetting.PrefPaymentIntegrationTab.IsCardPaymentIntegrationEnable = false;
                                break;
                            }
                        }
                    }
                }
                else if (PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.Valor) {
                    PreferenceSetting.PrefPaymentIntegrationTab.IsWalletIntegrationEnable = false;

                    if (PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords != null && PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords != undefined &&
                        PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords.length > 0) {
                        const arrSelectedCounter = PreferenceSetting.PrefPaymentIntegrationTab.ValorIntegration.CounterWiseRecords.filter((p) => p.CounterId == POSCommon.counterId);
                        if (arrSelectedCounter == null || arrSelectedCounter == undefined || arrSelectedCounter.length <= 0)
                            PreferenceSetting.PrefPaymentIntegrationTab.IsCardPaymentIntegrationEnable = false;
                    }
                }
                else if (PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.PineLabs || PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.WorldLine || PreferenceSetting.PrefPaymentIntegrationTab.PaymentIntegrationProvider == PaymentIntegrationProvider.RazorPay) {
                    PreferenceSetting.PrefPaymentIntegrationTab.IsWalletIntegrationEnable = false;
                    const arrSelectedCounter = PreferenceSetting.PrefPaymentIntegrationTab.PineLabIntegration.PineLabsCounterIMEI.filter((p) => p.PineLabsMerchantCounterId == POSCommon.counterId);
                    if (arrSelectedCounter == null || arrSelectedCounter == undefined || arrSelectedCounter.length <= 0)
                        PreferenceSetting.PrefPaymentIntegrationTab.IsCardPaymentIntegrationEnable = false;
                }
            }
        }
        catch (Ex) {

        }
    },
