    getInputControlEvent: function (inputControl) {
        try {
            //debugger;
            var total = 0;
            var defaultHeaderInfo = JSON.parse($("#divDefaultHeaderFields").attr("data-DefaultHeaderData"));
            var defaultHedaer = $("#tbodyDefaultHeaderFields").attr("data-DefaultHeader");
            var parsedDefaultHeaderMain = JSON.parse(defaultHedaer);
            var inputControlClosestTableCell = $(inputControl).closest('td');
            var inputControlClosestTableRow = $(inputControl).closest('tr');
            var parsedDefaultHeaderInfo = JSON.parse($(inputControlClosestTableRow).attr('data-DefaultHeaderDetails'));
            if ($(inputControl).val() != null && $(inputControl).val() != undefined && $(inputControl).val() != "") {
                parsedDefaultHeaderInfo.Description = $(inputControl).val();
                $(inputControl).find('input').remove();
                $(inputControlClosestTableCell).html(parsedDefaultHeaderInfo.Description);
            }
            else {
                parsedDefaultHeaderInfo.Description = $(inputControl).val();
                $(inputControl).find('input').remove();
                $(inputControlClosestTableCell).html(RETAILMAINBODYPANELCUSTOMIZATION.VARIABLES.previousDefaultValue);
            }
            $(inputControlClosestTableRow).attr('data-DefaultHeaderDetails', JSON.stringify(parsedDefaultHeaderInfo));

            for (let j in parsedDefaultHeaderMain) {
                if (parsedDefaultHeaderMain[j].Id == parsedDefaultHeaderInfo.Id) {
                    parsedDefaultHeaderMain[j].Description = $(inputControl).val();
                }
            }
            $(inputControlClosestTableRow).attr('data-DefaultHeaderDetails', JSON.stringify(parsedDefaultHeaderInfo));
            $('#tbodyDefaultHeaderFields').attr('data-DefaultHeader', JSON.stringify(parsedDefaultHeaderMain));
            defaultHeaderInfo.DefaultHeaderList.push(parsedDefaultHeaderMain);
