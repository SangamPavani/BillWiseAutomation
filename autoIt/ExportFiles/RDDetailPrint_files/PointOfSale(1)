var CHECKDISCOUNTAUTHORIZATION = {
    checkDiscountAuthorization: function (iShortcutId, dAppliedSchemeDiscount = 0, FromSchemeImplementation = false, FromPercentageOrOtherDiscount = false) {
        try {
            var msgMaxDiscountAllowedFor = $("#msgMaxDiscountAllowedFor").val();
            var lblOutlet = $("#lblOutletName").val();
            var lblCounter = $("#lblCounterName").val();
            //debugger;
            let dManualDiscount = 0, UserWiseGross = ApplicationNew.RetailTransFooter.UserWiseGross;
            let dApprovalDiscAmt = 0, dApprovalDiscPer = 0, dApprovalDiscAmtFromPerc = 0, _ManualDiscountDecimal = 0;

            if (ApplicationNew != null && ApplicationNew != undefined && ApplicationNew.ListOfItems != null && ApplicationNew.ListOfItems != undefined && ApplicationNew.ListOfItems.length > 0) {
                let sum = 0;
                for (let i = 0; i < ApplicationNew.ListOfItems.length; i++) {
                    sum = FConvert.toDecimal(sum) + FConvert.toDecimal(ApplicationNew.ListOfItems[i].ManualDiscountTotal);
                }
                dManualDiscount = FConvert.toDecimal(dManualDiscount) + FConvert.toDecimal(sum) + FConvert.toDecimal(ApplicationNew.RetailTransFooter.UserWiseDiscount);
                if (PreferenceSetting.PrefMiscellaneousOtherTab.ConsiderSchemeDiscountAllowedBySalemanORWaiter) {
                    sum = 0;
                    for (let j = 0; j < ApplicationNew.ListOfItems.length; j++) {
                        sum = FConvert.toDecimal(sum) + FConvert.toDecimal(ApplicationNew.ListOfItems[j].SchemeDiscount);
                    }
                    dManualDiscount = FConvert.toDecimal(dManualDiscount) + FConvert.toDecimal(sum) + FConvert.toDecimal(ApplicationNew.RetailTransFooter.UserWiseSchemeDiscount);
                    if (FromSchemeImplementation)
                        dManualDiscount = FConvert.toDecimal(dManualDiscount) + FConvert.toDecimal(dAppliedSchemeDiscount);
                }
                if (dManualDiscount <= 0) {
                    ApplicationNew.MaxDiscAllowedPerTrans = true;
                    return [true, false, ""];
                }
                if (PreferenceSetting.PrefMiscellaneousOtherTab.CheckDiscountAllowedBySalemanAndWaiter == true) {
                    let employee = PreferenceSetting.PrefMiscellaneousOtherTab.CheckDiscountAllowedById == 0 ? ApplicationNew.EmployeeData : ApplicationNew.SchemeEmployeeData;
                    if (employee == null || employee == undefined) {
                        ApplicationNew.MaxDiscAllowedPerTrans = true;
                        return [true, false, ""];
                    }
                    else {
                        if (employee.MaximumDiscountRestriction == null || employee.MaximumDiscountRestriction == undefined) {
                            ApplicationNew.MaxDiscAllowedPerTrans = true;
                            return [true, false, ""];
                        }
                        else {
                            if (employee.MaximumDiscountRestriction.MaximumDiscountAllowed == 0) {
                                ApplicationNew.MaxDiscAllowedPerTrans = true;
                                return [true, false, ""];
                            }
                        }
                    }
                    let TransactionDate = 0;
                    if (POSCommon.transactionDate == 0)
                        TransactionDate = DATE.prototype.today(POSCommon.CalType);
                    else
                        TransactionDate = POSCommon.transactionDate;
                    if (!(TransactionDate >= employee.MaximumDiscountRestriction.StartDate && TransactionDate <= employee.MaximumDiscountRestriction.EndDate)) {
                        ApplicationNew.MaxDiscAllowedPerTrans = true;
                        return [true, false, ""];
                    }
                    if (employee.MaximumDiscountRestriction.DiscountTypeId == 2)
                        dApprovalDiscAmt = FConvert.toDecimal(employee.MaximumDiscountRestriction.MaximumDiscountAllowed);
                    else
                        dApprovalDiscPer = FConvert.toDecimal(employee.MaximumDiscountRestriction.MaximumDiscountAllowed);
                    if (employee.MaximumDiscountRestriction.RestrictionType != EmployeeDiscountRestrictionType.EachBill) {
                        UserWiseGross = FConvert.toDecimal(UserWiseGross) + ApplicationNew.RetailTransFooter.EmployeeGrossSaleForDiscountRestriction;
                        dManualDiscount = FConvert.toDecimal(dManualDiscount) + ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction;
                    }
                }
                else {
                    ///Maximum Discount Allowed Per Transaction validation
                    if (PreferenceSetting.PrefUserWise == null)
                        return [false, false, "Problem in loading maximum discount authorization details."];

                    dApprovalDiscAmt = PreferenceSetting.PrefUserWise.MaxDiscountAllowePerTransAmt;
                    dApprovalDiscPer = PreferenceSetting.PrefUserWise.MaxDiscountAllowePerTransPercent;
                }
                _ManualDiscountDecimal = FConvert.toDecimal(dManualDiscount);
                dApprovalDiscAmtFromPerc = (FConvert.toDecimal(UserWiseGross) * dApprovalDiscPer) / 100;

                dApprovalDiscAmt = (dApprovalDiscAmt == 0 ? (dApprovalDiscAmtFromPerc == 0 ? 0 : dApprovalDiscAmtFromPerc) : dApprovalDiscAmt);
                dApprovalDiscAmtFromPerc = (dApprovalDiscAmtFromPerc == 0 ? (dApprovalDiscAmt == 0 ? 0 : dApprovalDiscAmt) : dApprovalDiscAmtFromPerc);
                var strSymbol = dApprovalDiscAmt < dApprovalDiscAmtFromPerc ? "" : "%";
                let dDiscAllowedPerTrans = (dApprovalDiscAmt < dApprovalDiscAmtFromPerc ? dApprovalDiscAmt : dApprovalDiscAmtFromPerc);
                if (dDiscAllowedPerTrans >= 0 && _ManualDiscountDecimal > 0 && _ManualDiscountDecimal > dDiscAllowedPerTrans) {
                    if (PreferenceSetting.PrefMiscellaneousOtherTab.CheckDiscountAllowedBySalemanAndWaiter == false && PreferenceSetting.PrefUserWise.DiscountPerDay == true) {
                        let approvedBy = PRODUCTMETHODNEW.CHANGEPRICEMETHODS.getActionApprovedByIfExists(ApplicationNew.CurrentItem, ApplicationNew.RetailTransFooter, false, PosActionIds.get("DISCOUNTLINEITEM"));

                        if (approvedBy != null && approvedBy != undefined)
                            ApplicationNew.ApprovedBy = approvedBy;

                        if (ApplicationNew.ManagerApproval == null || ApplicationNew.ManagerApproval == undefined || ApplicationNew.ManagerApproval.length <= 0)
                            ApplicationNew.ManagerApproval = [];

                        let objApprovalRecord = ApplicationNew.ManagerApproval.filter((p) => p.ShortcutId == iShortcutId);
                        if (objApprovalRecord == null || objApprovalRecord == undefined || objApprovalRecord.length <= 0) {
                            VERIFICATIONPROCESS.VARIABLES.OTPMessageTemplate = msgMaxDiscountAllowedFor + " " + UserWiseGross + " " + "@" + " " +
                                dDiscAllowedPerTrans + " " + strSymbol + " " + lblOutlet + " : " + POSCommon.outletDetails.OutletName + " " + lblCounter + " : " + POSCommon.outletDetails.CounterName;
                            return [true, true, ""];
                        }
                        else if (objApprovalRecord != null && objApprovalRecord != undefined && objApprovalRecord.Approved == true) {
                            ApplicationNew.DiscApprvdBy = objApprovalRecord.ApprovalId;
                            ApplicationNew.MaxDiscAllowedPerTrans = true;
                            ApplicationNew.DiscAllwdPerTrans = dDiscAllowedPerTrans;
                            ApplicationNew.AddlDiscGiven = FConvert.toDecimal(_ManualDiscountDecimal) - FConvert.toDecimal(dDiscAllowedPerTrans);
                            if (ApplicationNew.ApprovedBy != null && ApplicationNew.ApprovedBy != undefined)
                                PRODUCTMETHODNEW.CHANGEPRICEMETHODS.assignApprovedByToLineOrTransaction(null);
                        }
                        else if (objApprovalRecord != null && objApprovalRecord != undefined && objApprovalRecord.Approved == false)
                            ApplicationNew.MaxDiscAllowedPerTrans = false;
                    }
                    else if (dDiscAllowedPerTrans > 0) {
                        let DiscountBodyExtraFieldDetails = POSCommon.discountBodyExtraField;
                        let strMaxDisc = "";
                        let strBal = "";
                        let strProp = "";
                        let strMsg = "";
                        if (dDiscAllowedPerTrans - FConvert.toDecimal(ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction, POSCommon.numberOfDecimal) > 0) {
                            if (DiscountBodyExtraFieldDetails != null && DiscountBodyExtraFieldDetails != undefined) {
                                strMaxDisc = "Maximum Discount allowed : " + dDiscAllowedPerTrans + "";
                                strBal = " Balance : " + (dDiscAllowedPerTrans - FConvert.toDecimal(ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction)) + "";
                                strProp = "Do you want to proportionate the " + DiscountBodyExtraFieldDetails.Name + " : " + (dDiscAllowedPerTrans - FConvert.toDecimal(ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction)) + "";
                                strMsg = strMaxDisc + "<br />" + strBal + "<br />" + strProp + "";
                                if (FromPercentageOrOtherDiscount || FromSchemeImplementation)
                                    POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MaximumDiscountAllowed = false;
                                else
                                    POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MaximumDiscountAllowed = true;
                            }
                            return [false, false, "You have exceeded the Maximum discount allowed per Transaction.", true, strMsg, dDiscAllowedPerTrans];
                        }
                        else {
                            strMaxDisc = "Maximum Discount allowed : " + dDiscAllowedPerTrans + "<br />Balance : " + (dDiscAllowedPerTrans - FConvert.toDecimal(ApplicationNew.RetailTransFooter.EmployeeDiscountGivenForDiscountRestriction)) + "";
                            POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MaximumDiscountAllowed = false;
                            return [false, false, "You have exceeded the Maximum discount allowed per Transaction.", true, strMaxDisc, 0];
                        }
                        ApplicationNew.MaxDiscAllowedPerTrans = false;
                        POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MaximumDiscountAllowed = false;
                        return [false, false, "You have exceeded the Maximum discount allowed per Transaction."];
                    }
                }
                ApplicationNew.MaxDiscAllowedPerTrans = true;
                POSSCHEMEIMPLEMENTATIONGENERICS.VARIABLES.MaximumDiscountAllowed = true;
                return [true, false, ""];
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime ::  " + new Date() + " :: File : pointOfSaleCommon.js :: JavaScript Function :: CHECKDISCOUNTAUTHORIZATION.checkDiscountAuthorization :: Catch Block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return false;
        }
    },
};;
