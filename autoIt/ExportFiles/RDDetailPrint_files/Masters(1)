                            break;
                        }
                    }
                    if (msDetails.masterSearchBy == true) {
                        $("#MasterSearchOptionDiv input[name=SearchBy][value='1']").prop('checked', true);
                    }
                    else {
                        $("#MasterSearchOptionDiv input[name=SearchBy][value='2']").prop('checked', true);
                    }

                    if (msDetails.masterAlias != null && FCommon.UI.isValidObject(document.getElementById("txtAlias"))) {
                        document.getElementById("txtAlias").value = msDetails.masterAlias;
                    }
                    if (msDetails.masterIsDefault == true) {
                        document.getElementById("chkIsDefault").checked = true;
                        document.getElementById("chkIsDefault").disabled = true;
                        if (document.getElementById("btnDelete_ConfigureMasters") != null && document.getElementById("btnDelete_ConfigureMasters") != undefined) {
                            document.getElementById("btnDelete_ConfigureMasters").style.display = "none";
                        }
                    }
                    else {
                        document.getElementById("chkIsDefault").checked = false;
                        document.getElementById("chkIsDefault").disabled = true;
                        if (document.getElementById("btnDelete_ConfigureMasters") != null && document.getElementById("btnDelete_ConfigureMasters") != undefined) {
                            document.getElementById("btnDelete_ConfigureMasters").style.display = "inline-block";
                        }
                    }
                    if (document.getElementById("chkAllowRivisions") != undefined) {
                        if (msDetails.masterAllowRevision == true) {
                            document.getElementById("chkAllowRivisions").checked = true;
                        }
                        else {
                            document.getElementById("chkAllowRivisions").checked = false;
                        }
                    }
                    if (msDetails.masterbPickCode) {
                        document.getElementById("chkPickCode").checked = true;
                    }
                    else { document.getElementById("chkPickCode").checked = false; }

                    if (msDetails.masterbGroupMandatory) {
                        document.getElementById("chkGroupMandatory").checked = true;
                    }
                    else { document.getElementById("chkGroupMandatory").checked = false; }

                    if (document.getElementById("chkEditMaster") != undefined) {
                        document.getElementById('chkEditMaster').checked = msDetails.masterbIsAddReason == true ? true : false;
                    }

                }

                $("#MViewCustomizationTabs, #MViewCustomizationDetailsDiv").html("");
                OPTIONCONTROL.clear("txtMasterViewName", false);
                $("#chkIsVisible, #chkIsAvailableInMobile").prop("checked", false);

                var urlPath = GLOBAL.getContextPath("GetDependenciesDetails", "MasterCustomization", "Masters");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { iMasterId: msTypeId }, "JSON", true, "MASTERSETTINGS.ShowDependency_onSuccess");
            }
            else {
                mName = mName.replace(/[^a-z]+/gi, '').trim(); //mName.replace(/\s/g, '').replace(/[0-9]/g, '').trim();
                OPTIONCONTROL.setControlText("txtMasterName", mName);
                $("#tblDependency_Master tbody").empty();
                $("#tblUsed_Master tbody").empty();
                document.getElementById('ddlModule').disabled = false;
                document.getElementById("chkIsDefault").checked = false;
                document.getElementById("chkIsDefault").disabled = false;
            }
            $("#txtMasterCaption").focus();
        }
