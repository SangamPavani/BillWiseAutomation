                                        if (id2 != null && id2 !== "") childrenIds.push(parseInt(id2, 10));
                                    }
                                }
                                if (IsFromPOS) {
                                    if (SelectedMasterChildData && SelectedMasterChildData.lstMasters && SelectedMasterChildData.lstMasters.length) {
                                        // Build a Set of existing keys for O(1) lookup.
                                        var POSMasterChildData = new Set();
                                        for (var ei = 0; ei < MasterSelectedGroupNodes.length; ei++) {
                                            var e = MasterSelectedGroupNodes[ei];
                                            var eid = (e && e.Id !== undefined) ? parseInt(e.Id, 10) : e;
                                            POSMasterChildData.add(eid + '|' + !!e.IsGroup);
                                        }

                                        var lst = SelectedMasterChildData.lstMasters;
                                        for (var j = 0, len = lst.length; j < len; j++) {
                                            var data = lst[j];
                                            var did = (data && data.Id !== undefined) ? parseInt(data.Id, 10) : data;
                                            var key = did + '|' + !!data.IsGroup;
                                            if (!POSMasterChildData.has(key)) {
                                                MasterSelectedGroupNodes.push(data);
                                                POSMasterChildData.add(key);
                                            }
                                        }
                                    }
                                }
                            }
                            if (childrenIds.length > 0) {
                                // Create a Set from current GridrowidValues (numbers) and add childrenIds — O(n)
                                var gridSet = new Set();
                                for (var gi = 0; gi < GridrowidValues.length; gi++) {
                                    gridSet.add(parseInt(GridrowidValues[gi], 10));
                                }
                                for (var k = 0; k < childrenIds.length; k++) {
                                    gridSet.add(childrenIds[k]);
                                }
                                // Rebuild GridrowidValues once
                                GridrowidValues = Array.from(gridSet);
                            }
                        }
                        else {
                            if (IsFromPOS) {
                                var SelectedChildData = [];
                                var IdNamePairValues = {
                                    Id: value,
                                    IsGroup: false
