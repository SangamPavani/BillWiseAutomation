            if (moduleTypeVal == 1) {
                var moduleNameTxt = $("#ddlAllDllFiles_" + suffixId + " option:selected").text();
                var functionName = $("#ddlClassMethods_" + suffixId + " option:selected").text();
                var functionVal = $("#ddlClassMethods_" + suffixId).val();
            }
            else if (moduleTypeVal == 2) {
                var moduleNameTxt = $("#txtServiceUrl_" + suffixId).val().trim();
                var functionName = $("#ddlClassMethods_" + suffixId + " option:selected").text();
                var functionVal = $("#ddlClassMethods_" + suffixId).val();
            }
            else if (moduleTypeVal == 3) {
                var moduleNameTxt = $("#txtServiceUrl_" + suffixId).val().trim();
                var functionName = $("#txtUrlFunctionName_" + suffixId).val().trim();
            }

            var className = $("#ddlClassNames_" + suffixId).val();
            //var functionName = $("#ddlClassMethods_" + suffixId + " option:selected").text();
            //var functionVal = $("#ddlClassMethods_" + suffixId).val();
            var availOnVal = "";
            var availOnTxt = "";
            if (isMaster == "True") {
                if (onEventVal == 7) {
                    availOnVal = $("#ddlAvailability_" + suffixId + " option:selected").val();
                    availOnTxt = $("#ddlAvailability_" + suffixId + " option:selected").text().trim();
                }
            }
            else
                availOnVal = 0;

            var tbodyIndex = $("#tblExternalModules_" + suffixId + " tbody tr").length;

            if (onEventVal == undefined || onEventVal == null) {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgSelecttheEvent")); // "Select the Event."
                return false;
            }
            if ((onEventVal == 7 || onEventVal == 8) && isMaster == "True") {
                if (btnCaption == "" || btnCaption == null) {
                    EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgEnterButtonCaption")); // "Enter Button Caption."
                    document.getElementById("txtbuttonCaption_" + suffixId).focus();
                    return false;
                }
            }
            if (moduleTypeVal == undefined || moduleTypeVal == null) {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgSelectMaduleType")); // "Select the Module Type."
                return false;
            }
            if (moduleTypeVal == 1 && (moduleNameVal == null || moduleNameVal == undefined || moduleNameVal == "")) {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("EnterModuleName")); // "Enter Module Name."
                return false;
            }
            else if ((moduleTypeVal == 2 || moduleTypeVal == 3) && moduleNameTxt == "") {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgEnterURL")); // "Enter Url."
                return false;
            }
            //else if (moduleTypeVal == 3 && (functionVal == null || functionVal == undefined || functionVal == "")) {
            //    EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgSelecttheFunctionName")); // "Select the Function Name."
            //    return false;
            //}

            if (moduleTypeVal == 1 && (className == null || className == undefined || className == "")) {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgSelecttheClassName")); // "Select the Class Name."
                return false;
            }
            if (moduleTypeVal == 1 && (functionVal == null || functionVal == undefined || functionVal == "")) {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, EXTERNAL_MODULE.GetResourceMessage("msgSelecttheFunctionName")); // "Select the Function Name."
                return false;
            }
            ////debugger;
            $("#tblExternalModules_" + suffixId + " tbody")
                .append('<tr onclick="EXTERNAL_MODULE.SelectExternalModuleTr(this);">' +
                    '<td data-bexecuteonserver="' + bExecuteOnServer + '">' + (tbodyIndex + 1) + '</td>' +
                    '<td data-onevent="' + onEventVal + '">' + onEventTxt + '</td>' +
                    '<td data-moduletype="' + moduleTypeVal + '">' + moduleTypeTxt + '</td>' +
                    '<td>' + moduleNameTxt + '</td>' +
                    '<td>' + className + '</td>' +
                    '<td>' + functionName + '</td>' +
                    '<td>' + btnCaption + '</td>' +
                    '<td data-availablein="' + availOnVal + '">' + availOnTxt + '</td>' +
                    '</tr>');

            $("#ExternalModulesDiv_" + suffixId + " select").find("option:first-child").prop("selected", true);
            $("#txtbuttonCaption_" + suffixId).val('').prop('disabled', true);
            $("#ddlClassNames_" + suffixId).empty().append("<option></option>");
            $("#ddlClassMethods_" + suffixId).empty().append("<option></option>");
            $("#ddlAvailability_" + suffixId).prop('disabled', true);
            if (document.getElementById("lblErrorMsg_ExtraField") != null && document.getElementById("lblErrorMsg_ExtraField") != undefined) {
                document.getElementById("lblErrorMsg_ExtraField").innerHTML = "";
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("EXTERNAL_MODULE.InsertExternalModule : " + err.message, "Exception");
            return false;
        }
    },

    EditExternalModule: function (ele) {
       ////debugger;
        try {
            var isMaster = ele.dataset.from;
            var suffixId = ele.dataset.extruserid;
            var iTotalRows = $("#tblExternalModules_" + suffixId + " tbody tr").length;
            if (iTotalRows > 0) {
                var iSelectedRow = $("#tblExternalModules_" + suffixId + " tbody tr.FRowColor").length;
                if (iSelectedRow > 0) {
                    var arrExternalModule = EXTERNAL_MODULE.GetSelectedRowData(suffixId);
                    $("#ddlOnEvent_" + suffixId).val(arrExternalModule[0].OnEvent);
                    $("#ddlOnEvent_" + suffixId).trigger("change");
                    $("#txtbuttonCaption_" + suffixId).val(arrExternalModule[0].ButtonCaption);
                    $("#ddlModuleType_" + suffixId).val(arrExternalModule[0].ModuleType);
                    $("#ddlModuleType_" + suffixId).trigger("change");
                    if (parseInt(arrExternalModule[0].ModuleType) == 1) {
                        $("#ddlAllDllFiles_" + suffixId).find('option').each(function () {
                            if ($(this).text().trim() == arrExternalModule[0].ModuleName.trim()) {
                                $(this).attr('selected', 'selected');
                            }
                        });
                        //debugger;
                        EXTERNAL_MODULE.onAllDllFiles_Change(document.getElementById("ddlAllDllFiles_" + suffixId));
                        $("#ddlClassNames_" + suffixId).val(arrExternalModule[0].ClassName);
                        EXTERNAL_MODULE.onClassNames_Change(document.getElementById("ddlClassNames_" + suffixId))
                        $("#ddlClassMethods_" + suffixId).val(arrExternalModule[0].FunctionName);
                    }
                    else if (parseInt(arrExternalModule[0].ModuleType) == 2) {
                        $("#txtServiceUrl_" + suffixId).val(arrExternalModule[0].ModuleName);
                        $("#ddlClassNames_" + suffixId).val(arrExternalModule[0].ClassName);
                        EXTERNAL_MODULE.onClassNames_Change(document.getElementById("ddlClassNames_" + suffixId))
                        $("#ddlClassMethods_" + suffixId).val(arrExternalModule[0].FunctionName);
                    }
                    else if (parseInt(arrExternalModule[0].ModuleType) == 3) {
                        $("#txtServiceUrl_" + suffixId).val(arrExternalModule[0].ModuleName);
                        $("#txtUrlFunctionName_" + suffixId).val(arrExternalModule[0].FunctionName);
                    }
                    if (isMaster == "True") {
                        if (parseInt(arrExternalModule[0].OnEvent) == 7) {
                            $("#ddlAvailability_" + suffixId).val(arrExternalModule[0].AvailableIn);
                        }
                    }
                    if (parseInt(arrExternalModule[0].OnEvent) == 3 || parseInt(arrExternalModule[0].OnEvent) == 4) {
                        document.getElementById("chkExecuteOnServer_MasterExternalModule").checked = arrExternalModule[0].ExecuteOnServer;
                    }

                    EXTERNAL_MODULE.DeleteExternalModule(document.getElementById("btnDeleteExternalModule"));
                }
                else {
                    EXTERNAL_MODULE.ShowAlertMessage(suffixId, "Select the row in to edit.");
                    return false;
                }
            }
            else {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, "There is no record in the table to edit.");
                return false;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("EXTERNAL_MODULE.EditExternalModule : " + err.message, "Exception");
            return false;
        }
    },

    SelectExternalModuleTr: function (ele) {
        try {
            $(ele).parent().children().removeClass("FRowColor");
            $(ele).addClass("FRowColor");
        }
        catch (err) {
            COMMON.prototype.showMessage("EXTERNAL_MODULE.SelectExternalModuleTr : " + err.message, "Exception");
            return false;
        }
    },

    DeleteExternalModule: function (ele) {
        //////debugger;
        try {
            var suffixId = ele.dataset.extruserid;
            var tr = $("#tblExternalModules_" + suffixId + " tbody").find(".FRowColor");
            if (tr.length > 0) {
                $("#tblExternalModules_" + suffixId + " tbody").find(".FRowColor").remove();
                if (document.getElementById("lblErrorMsg_ExtraField") != null && document.getElementById("lblErrorMsg_ExtraField") != undefined) {
                    document.getElementById("lblErrorMsg_ExtraField").textContent = "";
                }
                if (document.getElementById("tblExternalModules_" + suffixId) != undefined && document.getElementById("tblExternalModules_" + suffixId) != null) {
                    var allTr = document.getElementById("tblExternalModules_" + suffixId).tBodies[0].children;
                    for (var i = 0; i < allTr.length; i++) {
                        allTr[i].children[0].textContent = (i + 1);
                    }
                }
            }
            else {
                EXTERNAL_MODULE.ShowAlertMessage(suffixId, "Select the External Module to delete.");
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("EXTERNAL_MODULE.DeleteExternalModule : " + err.message, "Exception");
            return false;
        }
    },

    GetExternalModules: function (moduleId) {
        ////debugger;
        try {
            var arrExternalModule = [];
            if (document.getElementById("tblExternalModules_" + moduleId) != undefined && document.getElementById("tblExternalModules_" + moduleId) != null) {
                var allExtrModules = document.getElementById("tblExternalModules_" + moduleId).tBodies[0].rows;
                for (var i = 0; i < allExtrModules.length; i++) {
                    extrModule = {
                        CallingOrder: (i + 1),
                        OnEvent: allExtrModules[i].children[1].dataset.onevent,
                        ModuleType: allExtrModules[i].children[2].dataset.moduletype,
                        ModuleName: allExtrModules[i].children[3].textContent.trim(),
                        ClassName: allExtrModules[i].children[4].textContent.trim(),
                        FunctionName: allExtrModules[i].children[5].textContent.trim(),
                        ButtonCaption: allExtrModules[i].children[6].textContent.trim(),
                        AvailableIn: allExtrModules[i].children[7].dataset.availablein,
                        ExecuteOnServer: document.getElementById("chkExecuteOnServer_MasterExternalModule").checked
                    }
                    arrExternalModule.push(extrModule);
                }
            }
            return arrExternalModule;
        }
        catch (err) {
            COMMON.prototype.showMessage("EXTERNAL_MODULE.GetExternalModules : " + err.message, "Exception");
            return null;
        }
    },

