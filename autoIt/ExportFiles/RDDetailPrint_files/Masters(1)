        try {
            var FilterTree = document.getElementById(FILTER.getFilterFormulaId(iFilterId, iSubFilterId));
            FilterTree.style.top = "auto";
            FilterTree.style.display = "";
            if (element.getBoundingClientRect().top > (GLOBAL.getPageHeight() / 2)) {
