function scrollIntoView(element, container, bcomboBlur) {
    //
    try {
        if (bcomboBlur == undefined)
            bcomboBlur = false;
        var containerTop = $(container).scrollTop();
        var containerBottom = containerTop + $(container).height();
        var elemTop = element[0].offsetTop;
        var elemBottom = elemTop + $(element).height();
        if (elemTop < containerTop) {
            $(container).scrollTop(elemTop);
        } else if (elemBottom > containerBottom) {
            if (!bcomboBlur) {
                $(container).scrollTop(elemBottom - $(container).height());
            }
            else {
                $(container).scrollTop(elemBottom - $(container).height() + 50);
            }
        }
    }
    catch (err) {
        COMMON.prototype.showMessage("{scrollIntoView } " + err.message, "Exception");
    }
}
function scrollIntoTreeView(element, container, bcomboBlur) {
    debugger
    try {
        if (bcomboBlur == undefined)
            bcomboBlur = false;
        var elemTop = element[1].offsetTop;
        $(container).scrollTop(0);
        var elemBottom = elemTop + $(element).height();
        if (!bcomboBlur) {
            $(container).scrollTop(elemBottom - $(container).height());
        }
        else if ($(container).offset() != undefined) {
            if ($(element[1]).offset().top > $(container).offset().top) {
                $(container).scrollTop(($(element[1]).offset().top) - ($(container).offset().top + $(container).scrollTop()));
            }
        }
        else {
            $(container).scrollTop($(element[1]).offset().top);
        }
    }
    catch (err) {
        COMMON.prototype.showMessage("{scrollIntoTreeView } " + err.message, "Exception");
    }
}

