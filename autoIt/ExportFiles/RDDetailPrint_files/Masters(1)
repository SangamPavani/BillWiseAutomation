    SaveMasterDetails: function () {
        //debugger;
        try {
            if (!MASTERSETTINGS.IsExtraFieldOpened()) {
                var menuselection = MASTER_MENU.isMenuSelected();
                if (menuselection == true) {
                    var masterCaption = document.getElementById("txtMasterCaption").value.trim();
                    var mAlias = "";
                    if (FCommon.UI.isValidObject(document.getElementById("txtAlias"))) {
                        mAlias = document.getElementById("txtAlias").value;
                    }
                    var masterName = MASTERSETTINGS.GetMasterName();
                    if (masterName == "") {
                        COMMON.prototype.showMessage(MASTERSETTINGS.GetResourceErrorMessage("msgSelectMaster"));
                        //MASTERSETTINGS.ShowAlertMessage(MASTERSETTINGS.GetResourceErrorMessage("msgSelectMaster"));//"Enter Master Name."
                        document.getElementById("txtMasterName").focus();
                        return false;
                    }
                    if (masterCaption == "") {
                        COMMON.prototype.showMessage(MASTERSETTINGS.GetResourceErrorMessage("EnterCaption"));
                        //MASTERSETTINGS.ShowAlertMessage(MASTERSETTINGS.GetResourceErrorMessage("EnterCaption"));//"Enter Caption."
                        document.getElementById("txtMasterCaption").focus();
                        return false;
                    }
                    if (masterCaption != "" && masterName != "") {
                        //debugger;
                        var selectedMasterId = MASTERSETTINGS.GetMasterTypeId();
                        if (selectedMasterId <= 0) {
                            if (MASTERSETTINGS.IsMasterAlreadyExist(masterName)) {
                                COMMON.prototype.showMessage(MASTERSETTINGS.GetResourceErrorMessage("msgMstrNameAlreadyExst"));
                                //MASTERSETTINGS.ShowAlertMessage("Master Name already exist");
                                return false;
                            }
                        }
                        var searchBy = $("#MasterSearchOptionDiv input[type='radio']:checked").val();
                        if (searchBy == 1) {
                            searchBy = true;
                        }
                        else {
                            searchBy = false;
                        }
                        var allowRevision = document.getElementById('chkAllowRivisions').checked;
                        var PickCode = document.getElementById('chkPickCode').checked;
                        var GroupMandatory = document.getElementById('chkGroupMandatory').checked;
                        var isDefault = document.getElementById('chkIsDefault').checked;
                        var isAddReason = document.getElementById('chkEditMaster').checked;
                        var module = document.getElementById('ddlModule').options[document.getElementById('ddlModule').selectedIndex].text;
                        var menuData = MASTERSETTINGS.GetMenuDetails();
                        //debugger;
                        var menuId, parentId;
                        if (selectedMasterId > 0) {
                            if (menuData.isGroup == "True") {
                                menuId = menuData.menuId;
                            }
                            else {
                                menuId = menuData.parentId;
                            }
                        }
                        else {
                            menuId = menuData.menuId;
                        }
                        parentId = menuData.parentId;
                        var urlPath = GLOBAL.getContextPath("SaveConfigureMaster", "MasterCustomization", "Masters");
                        var fnResult = NETWORK.executeServerMethod(urlPath, true, { iMasterTypeId: selectedMasterId, strMasterName: masterName, strCaption: masterCaption, strAlias: mAlias, bSearchBy: searchBy, bAllowRivisions: allowRevision, bPickCode: PickCode, bGroupMandatory: GroupMandatory, bIsDefault: isDefault, sModule: module, iSelectedMenuId: menuId, iParentId: parentId, bAddReason: isAddReason }, "HTML", true, "MASTERSETTINGS.SaveMasterDetails_onSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                    }
                }
                else {
                    COMMON.prototype.showMessage(MASTERSETTINGS.GetResourceErrorMessage("msgSelectmenu"));
                    //MASTERSETTINGS.ShowAlertMessage(MASTERSETTINGS.GetResourceErrorMessage("msgSelectmenu"));//"Select Menu."
                    return false;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("MASTERSETTINGS.SaveMasterDetails : " + err.message, "Exception");
            return false;
        }
    },
