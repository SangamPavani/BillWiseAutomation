                        $("#" + BinCapacity).val(objProductBinCapacityDetails.BinCapacityPrev);
                    }
                    return false;
                }
            }
        }
        catch (ex) {
            COMMON.prototype.showMessage("MASTERENTRYSCREEN.BinCapacitySuccess " + ex.message);
        }
