            cellObjHolderForUserSelectionCondition.setCellData("value", "");
            cellObjHolderForUserSelectionCondition.setCellText("");
        }
        arrLimitCondition = [];
        var iTotalRows = FGRIDCONTROL.getTotalRows(id_tblUserSelection);

