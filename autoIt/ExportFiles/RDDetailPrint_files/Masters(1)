    validateSpinnerCtrl: function (event, min) {
        
        try {
            var value = event.target.value + "" + event.key;
            var key = window.event ? event.keyCode : event.which;
            return (event.keyCode == 8 || event.keyCode == 9 || event.keyCode == 37 || event.keyCode == 39) ? true : (key < 48 || key > 57) ? false : (value >= min) ? true : false;
        }
        catch (e) {

        }
