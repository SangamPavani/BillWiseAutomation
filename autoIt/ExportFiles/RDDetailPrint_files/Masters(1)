function GetSelectedMasterIds() {
    try {
        var MasterIds = [];
        var childrenMasterIds = [];
        var id = document.getElementById('landgridData');
        var totalRows = $($(id).find('tbody').find('tr'));
        var IsReport = $('#MasterRetrieval_IsReport').val();
        for (var i = 0; i < totalRows.length; i++) {
            var MasterId = totalRows[i].cells[8].innerHTML.trim();
            MasterId = getEnglishDigits(MasterId);
            var IsGroup = totalRows[i].cells[0].innerHTML.trim();
            //Added condition to call the method to get the child masters if the selected master is group
            if (IsGroup == "True") {
                var SelectedMasterChildData = getAllMasterChildren(IsReport, MasterId);
                if (SelectedMasterChildData) {
                    //Getting the child master ids from SelectedMasterChildData object
                    if (Array.isArray(SelectedMasterChildData.lstMasters)) {
                        for (var ci = 0; ci < SelectedMasterChildData.lstMasters.length; ci++) {
                            var m = SelectedMasterChildData.lstMasters[ci];
                            var id = m && (m.Id || m.id);
                            if (id != null && id !== "") childrenMasterIds.push(parseInt(id, 10));
                        }
                    } else if (Array.isArray(SelectedMasterChildData)) {
                        for (var ci2 = 0; ci2 < SelectedMasterChildData.length; ci2++) {
                            var mm = SelectedMasterChildData[ci2];
                            var id2 = mm || (mm.Id || mm.id);
                            if (id2 != null && id2 !== "") childrenMasterIds.push(parseInt(id2, 10));
                        }
                    }
                }
            }
            else {
                MasterIds.push(parseInt(MasterId));
            }
        }
        MasterIds = MasterIds.concat(childrenMasterIds);
        MasterIds = [...new Set(MasterIds)];
        //Added condition to remove the selected group nodes from MasterSelectedGroupNodes array if any group master is unselected in POS
        if (IsFromPOS) {
            if (MasterSelectedGroupNodes.length > 0) {
                for (let ids = 0; ids < MasterIds.length; ids++) {
                    for (let nodes = 0; nodes < MasterSelectedGroupNodes.length; nodes++) {
                        //removing unselected group nodes from MasterSelectedGroupNodes array
                        if (MasterIds[ids] == MasterSelectedGroupNodes[nodes].Id) {
                            MasterSelectedGroupNodes.splice(nodes, 1);
                            break;
                        }
                    }
                }
            }
        }
        //removing unselected master ids from GridrowidValues array
        for (var j = 0; j < MasterIds.length; j++) {
            for (var k = 0; k < GridrowidValues.length; k++) {

                GridrowidValues.splice(k, 1);
                break;
            }
        }
    }
    catch (ex) {
        COMMON.prototype.showMessage("{GetSelectedMasterIds } " + ex.message, "Exception");
        return;
    }
}


