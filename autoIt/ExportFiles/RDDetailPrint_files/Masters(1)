    GetFixedAssetRateofDep: function () {
        //debugger;
        try {
            if ($('#hdnAutoCalaculateRateOfDepreciation').attr("data-favalue") == "True") {
                if ($('#iDepreciationMethod').val() == '3') {
                    var iYears = parseInt($("#iDepreciationInYears").val().replace(/,/g, ''));
                    var fScrapValue = parseFloat($("#fScrapValue").val().replace(/,/g, ''));
                    var fPrice = parseFloat($("#fPrice").val().replace(/,/g, ''));
                    var RateOfDepreciation = 0;
                    if (fPrice > 0 && iYears > 0) {
                        //Rate of Depreciation  R=100[1-√(n&s/c])
                        var innerValue = (fScrapValue / fPrice);
                        var RootValue = (1 / parseFloat(iYears));
                        var FinaRootValue = parseFloat(Math.pow(parseFloat(innerValue), parseFloat(RootValue)));

                        RateOfDepreciation = 100 * (1 - FinaRootValue);
                        if (RateOfDepreciation != "0") {
                            document.getElementById("fRateOfDepreciation").value = parseFloat(RateOfDepreciation).toFixed(parseInt($("#fRateOfDepreciation").attr("data-noofdec")));
                        }
                        else {
                            document.getElementById("fRateOfDepreciation").value = "0.00";
                        }
                    }
                    else {
                        document.getElementById("fRateOfDepreciation").value = "0.00";
                    }
                }
            }
        }
        catch (ex) {
            COMMON.prototype.showMessage("MASTERENTRYSCREEN.GetFixedAssetRateofDep " + ex.message);
        }
    },
