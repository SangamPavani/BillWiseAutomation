    validateInputNumber: function (eleInput, iType, evt) {
        ////debugger

        var charCode = null;

        try {
            bResult = false;

            if (evt.which == 1 || evt.which == 8) {
                return (true);
            }

            charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 45) { // -
                return false;
                //if ((iType == 0 || iType == 2)) { // Signed Integer, Signed Decimal
                //    return (true);
                //}
            }
            else if (charCode == 46) { //.
                var splitedValue = parseInt(eleInput.value.split('.')[0]);
                if ((iType == 2 || iType == 3)
                    && (eleInput.value.indexOf(".") == -1 || splitedValue == 0)) { // Signed Decimal, Unsingned Decimal
                    return (true);
                }
            }
            else if (charCode >= 48 && charCode <= 57) { // 0 to 9
                return (true);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{FORM_MENU.validateInputNumber} " + err.message, "Exception");
        }

        return (false);
    },
