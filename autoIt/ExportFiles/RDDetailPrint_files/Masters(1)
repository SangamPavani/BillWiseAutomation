function isHTML(str) {
    try {
        var doc = new DOMParser().parseFromString(str, "text/html");
        return Array.from(doc.body.childNodes).some(node => node.nodeType === 1);
    }
    catch (err) {
        COMMON.prototype.showMessage("{isHTML } " + err.message, "Exception");
    }
}

