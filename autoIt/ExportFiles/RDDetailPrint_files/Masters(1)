                    }
                    return false;
                }
                else if (BinCapacity.trim() == "iBinCapacity") {
                    var ProjectedQTY = parseInt(binCapacityValue) * objProductBinCapacityDetails.QTYConsumedbyProduct + objProductBinCapacityDetails.OtherProductQTYUsed;
