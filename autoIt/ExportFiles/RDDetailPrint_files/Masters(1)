                if (parseFloat(CumulativeDepreciation.value.replace(/\,/g, '')) <= parseFloat((iQuantity.value.replace(/\,/g, '') * Price.value.replace(/\,/g, '')))) {
                    return '';//true
                }
                else {
                    return errorMsg = "Cumulative Depreciation can not be greater than  (Price * Quantity)";
                }
            }
            else if (iQuantity != null && iQuantity != undefined && iQuantity.value.replace(/\,/g, '') == 1 && IsChecked == false) {
                if (parseFloat(CumulativeDepreciation.value.replace(/\,/g, '')) <= parseFloat((Price.value.replace(/\,/g, '')))) {
                    return '';//true
                }
                else {
                    return errorMsg = "Cumulative Depreciation can not be greater than Price";
                }
