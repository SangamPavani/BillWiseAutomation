                    case MasterDataType.get("BigNumber"):
                    case MasterDataType.get("SmallNumber"):
                    case MasterDataType.get("TinyNumber"):
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setCellData("value", element.value);
                        cellobj.setCellText(element.value);
                        if (element.dataset.evaluateon != undefined) {
                            var sOnLeave = element.dataset.evaluateon.includes('OnLeave');
                            if (sOnLeave) {
                                MASTERENTRYSCREEN.getControlRules(element, 'OnLeave', event);
                            }
                        }
                        break;
                    case MasterDataType.get("TEXT"):
                        if (cellobj.bHidden == true) {
                            var cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, (cellobj.iColumn - 1));
                            if (FConvert.toInt(cell.ColumnAttribute.datatypeid) == 7 || FConvert.toInt(cell.ColumnAttribute.datatypeid) == 10) {
                                break;
                            }
                        }
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setCellData("value", element.value);
                        cellobj.setCellText(element.value);
                        if (element.dataset.evaluateon != undefined) {
                            var sOnLeave = element.dataset.evaluateon.includes('OnLeave');
                            if (sOnLeave) {
                                MASTERENTRYSCREEN.getControlRules(element, 'OnLeave', event);
                            }
                        }
                        break;
                    case MasterDataType.get("DOCUMENTVIEWER"):
                    case MasterDataType.get("PICTURE"):
                        if (cellobj.bHidden == true) {
                            if (FConvert.toInt(cellobj.ColumnAttribute.datatypeid) == 7 || FConvert.toInt(cellobj.ColumnAttribute.datatypeid) == 10) {
                                break;
                            }
                        }
                        bBase64Data = FATTACHMENTCONTROL.PRIVATE.isBase64Data(cellobj.ColumnAttribute.ctrlid);
                        data = FATTACHMENTCONTROL.getData(cellobj.ColumnAttribute.ctrlid);
                        var cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, (cellobj.iColumn + 1));
                        cell.setCellText(data.data.sFileName);
                        cell.setCellData("value", data.data.sFileName);
                        if (MasterDataType.get("DOCUMENTVIEWER") == FConvert.toInt(cellobj.ColumnAttribute.datatypeid)) {
                            if (cellobj.ColumnAttribute.fieldname == "biDocument") {
                                var iFillSizecell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, 8);
                                iFillSizecell.setCellText(data.lValue);
                                iFillSizecell.setCellData("value", data.lValue);
                            }
                        }
                        else {
                            MASTERENTRYSCREEN.compressImage("data:image/png;base64," + data.data.sData, function (compressedImage) {
                                console.log("thumbSrc", compressedImage);
                                var Cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, (cellobj.iColumn + 2));
                                Cell.setCellText(compressedImage);
                                Cell.setCellData("value", compressedImage);
                                var cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, (cellobj.iColumn + 3));
                                cell.setCellText(data.data.sFileName);
                                cell.setCellData("value", data.data.sFileName);
                            });
                        }
                        console.log("originalsrc", data.data.sData)
                        obj = {};
                        obj.sFileName = data.data.sFileName;

                        if (data.data.iDataSource == eWebAttachmentStorage.Disk) {
                            if (bBase64Data == true) {
                                obj.sData = data.data.sData;
                            }
                            else {
                                obj.arrData = data.data.data;
                            }

                            MASTERENTRYSCREEN.updateAttachmentValue(cellobj,
                                obj,
                                cellobj.ColumnAttribute.ctrlid,
                                false,
                                data.data.iDataSource);
                        }
                        else {
                            obj.sData = data.data.sData;

                            MASTERENTRYSCREEN.updateAttachmentValue(cellobj,
                                obj,
                                cellobj.ColumnAttribute.ctrlid,
                                false,
                                data.data.iDataSource);
                        }
                        break;
                    case MasterDataType.get("BOOLEAN"):
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        if (element.checked == true) {
                            element.value = true;
                        } else {
                            element.value = false;
                        }
                        cellobj.setCellData("value", element.value);
                        cellobj.setCellText(element.value);
                        break;
                    case MasterDataType.get("STRINGLIST"):
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        if (element.selectedIndex != -1) {
                            cellobj.setCellData("value", element.options[element.selectedIndex].text);
                            cellobj.setCellText(element.options[element.selectedIndex].text);
                        }
                        if (element.dataset.evaluateon != undefined) {
                            var sOnLeave = element.dataset.evaluateon.includes('OnLeave');
                            if (sOnLeave) {
                                MASTERENTRYSCREEN.getControlRules(element, 'OnLeave', event);
                            }
                        }
                        break;
                    default:
                        break;
                }
            }
            m_ExternalModuleRowIndex = cellobj.iRow;
            var ExtModCustomData = {};
            ExtModCustomData.ExtModEvent = EXTERNALMODULEFIELD_EVENT_ENUM.ON_LEAVE;
            if (element != null) {
                var iCount = MastersExternalModule.callExternalModuleField(EXTERNALMODULEFIELD_EVENT_ENUM.ON_LEAVE, element.id + cellobj.iRow, 0, 'MASTERENTRYSCREEN.continueEMProcess', ExtModCustomData);
                if (iCount > 0) {
                    return;
                }
            }
            return (true);
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception - MASTERENTRYSCREEN.onLeave " + err.message);
        }
    },

    onEnter: function (cellobj, event) {
        //debugger;
        try {
            let PreloadValue = 0;
            var element = null;
            var sGridCtrlId = "";
            var iValue = 0;
            var data = null;
            var iTotalRow = $("#" + cellobj.Grid.id + "_body")[0].children.length;
            var iCurrentRow = cellobj.iRow;
            if (iTotalRow == iCurrentRow) {
                FGRIDCONTROL.insertRows(cellobj.Grid.id, 0, 1);
            }
            sGridCtrlId = FGRIDCONTROL.getGridIdFromCell(cellobj.cell);
            if (cellobj.bHidden == true) {
                cellobj.processDefault(event);
                return true;
            }
            switch (FConvert.toInt(cellobj.ColumnAttribute.datatypeid)) {
                case MasterDataType.get("MASTER"):
                case MasterDataType.get("EXTERNALTABLE"):

                    if (cellobj.ColumnAttribute.ctrlid == "iCLFATag") {
                        var cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, (cellobj.iRow - 1), cellobj.iColumn);
                        sFilter.push(cell.getCellData("value"));
                        sFilter = sFilter.toString();
                        if (sFilter.trim() != "")
                            OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "a.iMasterId NOT IN (" + sFilter + ")");
                        else
                            OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "iStatus=0");
                    }
                    cellobj.setCellText("");
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    OPTIONCONTROL.setParent(element, cellobj.cell, true);
                    iValue = 0;
                    if (COMMON.prototype.isInteger(cellobj.CellData.value) == true) {
                        iValue = parseInt(cellobj.getCellData("value"));
                    }
                    if (cellobj.CellData.value == undefined || cellobj.CellData.value == "0" || cellobj.CellData.value == 'NaN') {
                        cellobj.CellData.value = "";
                    }
                    if (iValue <= 0) {
                        OPTIONCONTROL.clear(element);
                        if (element.value == "") {
                            OPTIONCONTROL.setControlText(element, cellobj.CellData.value);
                        }
                        else {
                            OPTIONCONTROL.setControlValue(element, element.value);
                        }
                    }
                    else {
                        OPTIONCONTROL.setControlValue(element, iValue);
                    }
                    if (element.dataset.evaluateon != undefined) {
                        var sOnEnter = element.dataset.evaluateon.includes('OnEnter');
                        if (sOnEnter) {
                            MASTERENTRYSCREEN.getControlRules(element, 'OnEnter', event);
                        }
                    }
                    break;
                case MasterDataType.get('DATE'):
                    cellobj.setCellText("");
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (cellobj.CellData.value != "0" && cellobj.CellData.value != undefined) {
                        element.value = cellobj.CellData.value;
                    }
                    DATEPICKER.setParent(element, cellobj.cell);
                    iValue = parseInt(cellobj.getCellData("value"));
                    if (iValue > 0) {
                        DATEPICKER.setDate(element, iValue);
                        /*document.getElementById(cellobj.ColumnAttribute.ctrlid + '_checkbox').checked = true;*/
                    }
                    if (element.dataset.evaluateon != undefined) {
                        var sOnEnter = element.dataset.evaluateon.includes('OnEnter');
                        if (sOnEnter) {
                            MASTERENTRYSCREEN.getControlRules(element, 'OnEnter', event);
                        }
                    }
                    break;
                case MasterDataType.get('TIME'):
                    cellobj.setCellText("");
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    // attach time control UI to the cell
                    FTIMECONTROL.setParent(element, cellobj.cell);
                    // Prefer existing cell data value; if present set it into control
                    var currentValue = cellobj.getCellData("value");
                    if (currentValue != null && currentValue !== "" && currentValue !== "0") {
                        FTIMECONTROL.setTime(element, currentValue);
                    } else if (cellobj.CellData && cellobj.CellData.value != undefined && cellobj.CellData.value !== "" && cellobj.CellData.value !== "0") {
                        FTIMECONTROL.setTime(element, cellobj.CellData.value);
                    } else {
                        // clear the control so user sees empty time picker
                        FTIMECONTROL.clear(element);
                    }
                    break;
                case MasterDataType.get('DATETIME'):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    cellobj.setCellData("value", new Date().getTime());
                    cellobj.setCellText(element.attributes.value.value);
                    break;
                case MasterDataType.get("NUMBERLIST"):
                case MasterDataType.get("STRINGLIST"):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (cellobj.getCellData("value") == null) {
                        cellobj.setControl(element, "0");
                    }
                    else {
                        element.value = "";
                        if (cellobj.CellData.value == undefined) {
                            cellobj.setControl(element, "0");
                        }
                        else {
                            cellobj.setControl(element, cellobj.CellData.value);
                        }
                    }
                    $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    if (element.dataset.evaluateon != undefined) {
                        var sOnEnter = element.dataset.evaluateon.includes('OnEnter');
                        if (sOnEnter) {
                            MASTERENTRYSCREEN.getControlRules(element, 'OnEnter', event);
                        }
                    }
                    break;
                case MasterDataType.get("FRACTION"):
                case MasterDataType.get("NUMBER"):
                case MasterDataType.get("BigNumber"):
                case MasterDataType.get("SmallNumber"):
                case MasterDataType.get("TinyNumber"):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (element != null) {
                        cellobj.setControl(element, cellobj.getCellData("value"));
                        $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    }
                    if (element.dataset.evaluateon != undefined) {
                        var sOnEnter = element.dataset.evaluateon.includes('OnEnter');
                        if (sOnEnter) {
                            MASTERENTRYSCREEN.getControlRules(element, 'OnEnter', event);
                        }
                    }
                    break;
                case MasterDataType.get("TEXT"):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (element != null) {
                        cellobj.setControl(element, cellobj.getCellData("value"));
                        $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    }
                    if (element.dataset.evaluateon != undefined) {
                        var sOnEnter = element.dataset.evaluateon.includes('OnEnter');
                        if (sOnEnter) {
                            MASTERENTRYSCREEN.getControlRules(element, 'OnEnter', event);
                        }
                    }
                    break;
                case MasterDataType.get("DOCUMENTVIEWER"):
                case MasterDataType.get("PICTURE"):
                    PreloadValue = {};
                    PreloadValue.sFileName = cellobj.getCellText();
                    PreloadValue.sData = cellobj.getCellData();
                    PreloadValue.iDataSource = DataType.toInt(cellobj.getCellData("datasource"));

                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue);
                    break;
                case MasterDataType.get("BOOLEAN"):
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    ele = document.getElementById(cellobj.cell.id);
                    if (ele == null) {
                        element.value = true;
                        element.setAttribute('checked', 'checked');
                    }
                    else {
                        if (element != null) {
                            if (ele != null) {
                                if (ele.dataset.value == 'True' || ele.dataset.value == 'true') {
                                    element.value = true;
                                    element.setAttribute('checked', 'checked');
                                } else {
                                    element.value = false;
                                    element.removeAttribute('checked');
                                }
                            } else {
                                element.value = false;
                                element.removeAttribute('checked');
                            }
                        }
                    }
                    cellobj.setControl(element, cellobj.getCellData("value"));
                    ele = document.getElementById(cellobj.cell.id);

                    if (cellobj.cell.childNodes[0].checked == true && ele == null) {
                        cellobj.cell.childNodes[0].checked = false;
                    }
                    $("#" + cellobj.ColumnAttribute.ctrlid).focus();
                    break;
                default:
                    cellobj.processDefault(event);
                    break;
            }
            m_ExternalModuleRowIndex = cellobj.iRow;
            var ExtModCustomData = {};
            ExtModCustomData.ExtModEvent = EXTERNALMODULEFIELD_EVENT_ENUM.ON_ENTER;
            if (element != null) {
                var iCount = MastersExternalModule.callExternalModuleField(EXTERNALMODULEFIELD_EVENT_ENUM.ON_ENTER, element.id + cellobj.iRow, 0, 'MASTERENTRYSCREEN.continueEMProcess', ExtModCustomData);
                if (iCount > 0) {
                    return;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception - MASTERENTRYSCREEN.onEnter " + err.message);
        }
    },
    updateAttachmentValue: function (cell, value, iFieldId, bConvert, iDataSource) {
        //debugger
        let sCtrlId = "";
        let sData = null;
        let objAttachment = null;

        try {
            if (DataType.isString(value) == true) {
                value = DataType.stringToObject(value).data;
            }

            if ((typeof value).toLowerCase() == "object") {
                objAttachment = value;

                iDataSource = DataType.toInt(iDataSource);

                sData = null;
                if (DataType.isValidObject(objAttachment) == true && DataType.isNullOrEmpty(objAttachment.sFileName) == false) {
                    if (DataType.isArray(objAttachment.arrData) == true) {
                        if (bConvert == true) {
                            sData = LZUTF8.encodeBase64(objAttachment.arrData);
                        }
                        else {
                            sData = DataType.arrayToCSV(objAttachment.arrData);
                        }
                        //sData = DataType.arrayToCSV(objAttachment.arrData);
                    }
                    else {
                        sData = objAttachment.sData;
                    }

                    if (DataType.isValidObject(objAttachment.iDataSource) == true) {
                        iDataSource = objAttachment.iDataSource;
                    }
                }
                sCtrlId = cell.ColumnAttribute.ctrlid;
                if (sData != null) {
                    FATTACHMENTCONTROL.setData(sCtrlId,
                        objAttachment.sFileName,
                        "",
                        sData,
                        true,
                        iDataSource);
                }
                else {
                    FATTACHMENTCONTROL.clear(sCtrlId);
                }
                if (sData != null) {
                    cell.setCellText(objAttachment.sFileName, sData);
                    cell.setCellData("datasource", iDataSource);
                }
                else {
                    cell.clear();
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("MASTERENTRYSCREEN.updateAttachmentValue " + err.message);
        }
    },
    compressImage: function (imageSrc, callback) {
        const img = new Image();
        img.src = imageSrc;

        img.onload = function () {
            var canvas = document.createElement("canvas");
            var context = canvas.getContext("2d");
            canvas.width = img.width / 4;
            canvas.height = img.height / 4;

            context.drawImage(
                img,
                0,
                0,
                img.width,
                img.height,
                0,
                0,
                canvas.width,
                canvas.height
            );

            const compressedImage = canvas.toDataURL();

            if (callback) {
                callback(compressedImage);
            }
        };
    },
