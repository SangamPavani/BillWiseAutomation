function getEnglishDigits(str) {
    try {
        if (parseInt($("#hdnLanguageId").val()) == 1) {
            return Number(str.replace(/[٠١٢٣٤٥٦٧٨٩]/g, function (d) {
                return d.charCodeAt(0) - 1632;
            }).replace(/[۰۱۲۳۴۵۶۷۸۹]/g, function (d) { return d.charCodeAt(0) - 1776; }));
        }
        else {
            return str;
        }
    }
    catch (err) {

    }

}
