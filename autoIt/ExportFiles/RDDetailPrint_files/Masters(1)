                    $(eleTxt.parentNode).toggleClass("open");
                    eleTxt.parentElement.appendChild(FilterTree);
                }
            }
        }
        catch (err) {
            alert("Exception: {FILTER.getDataFieldsTree} " + err.message);
        }
