                if (parseFloat(CumulativeDepreciation.value.replace(/\,/g, '')) <= parseFloat((Price.value.replace(/\,/g, '') * iQuantity.value.replace(/\,/g, '')))) {
                    return '';//true
                }
                else {
                    return errorMsg = "Cumulative Depreciation can not be greater than  (Price * Quantity)";
                }
            }
            return errorMsg;
        }
        catch (ex) {
            COMMON.prototype.showMessage("MASTERENTRYSCREEN.FixedAssetCumulativeDepreciationValidation " + ex.message);
        }
