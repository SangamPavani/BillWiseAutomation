                return false;
            }
            if (SelectedUnitValue == 0) {
                COMMON.prototype.showMessage(getResourceValue("SelectPrimaryBaseUnit", GetMasterResourceMessages));
                return false;
            }
            for (let i = 0; i < divHierarchyChildren.children.length; i++) {
                var SplitValue = divHierarchyChildren.children[i].id.split('_');
                Sequence = SplitValue[1];
                var SelectedUnitData = OPTIONCONTROL.getControlData("optionHierarchyBaseUnit_" + (SplitValue[1]));
                var OptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionHierarchyBaseUnit_' + (SplitValue[1]), SelectedUnitData);
                var SelectedUnitTypeName = OptionValues.UnitTypeName == "Basic" ? "Basic" : OptionValues.UnitTypeName;
                if (PrimarySelectedUnitTypeName == "Pallet" && SelectedUnitTypeName == "Pallet") {
                    COMMON.prototype.showMessage(getResourceValue("msgMaxBasicAndPalletReached", GetMasterResourceMessages));
                    return false;
                }
                else if (SelectedUnitTypeName == "Pallet" && PrimarySelectedUnitTypeName == "Basic") {
                    var PrevSelectedUnitData = OPTIONCONTROL.getControlData("optionHierarchyBaseUnit_" + (SplitValue[1] - 1));
                    var PrevOptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionHierarchyBaseUnit_' + (SplitValue[1] - 1), PrevSelectedUnitData);
                    var PrevSelectedUnitTypeName = PrevOptionValues.UnitTypeName == "Basic" ? "Basic" : PrevOptionValues.UnitTypeName;
                    if (PrevSelectedUnitTypeName == SelectedUnitTypeName) {
                        COMMON.prototype.showMessage(getResourceValue("msgMaxBasicAndPalletReached", GetMasterResourceMessages));
                        return false;
                    }
                }
                var SelectedHierarchyUnit = OPTIONCONTROL.getControlValue("optionHierarchyBaseUnit_" + SplitValue[1]);
                if (SelectedHierarchyUnit == "0") {
                    COMMON.prototype.showMessage(getResourceValue("msgSelectHierarchialUnit", GetMasterResourceMessages));
                    return false;
                }
                var ChildQty = document.getElementById('QuantityId_' + SplitValue[1]).value;
                if (ChildQty == "" || ChildQty == "0") {
                    COMMON.prototype.showMessage(getResourceValue("msgDisposalQty", GetMasterResourceMessages));
                    return false;
                }
            }
            $('#divHierarchy').each(function () {
                divLen = $(this).find('.innerDiv').length;
            });
            if (divLen < 5) {
                if (divLen == 0) {
                    HierarchyIndex = '1';
                }
                else {
                    var lastDivId = $('#divHierarchy').find('.innerDiv')[divLen - 1].id
                    var regex = /(\d+)/g;
                    var lastDivNo = lastDivId.match(regex);
                    HierarchyIndex = '' + (parseInt(lastDivNo[0]) + parseInt(1)) + '';
                }
                NETWORK.executeServerMethod(url, false, { ProductId: SelectedMasterId, SelectedUnit: SelectedUnitValue, Index: HierarchyIndex },
                        "html",
                        true,
                        "ItemPackType.onAddHierarchyClickSuccess",
                        "",
                        "",
                        {});
            }
            else {
                COMMON.prototype.showMessage(getResourceValue("msgMaxLimit", GetMasterResourceMessages));
            }
        }
    },
