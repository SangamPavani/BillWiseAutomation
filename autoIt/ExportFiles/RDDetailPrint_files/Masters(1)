            }
            $("#txtMasterCaption").val(mName.replace(/[^a-z\d\s]+/gi, '').trim());
            //debugger;
            var msTypeId = OPTIONCONTROL.getControlValue("txtMasterName");
            if (msTypeId > 0) {
                MASTER_MENU.selectMenuForMaster(mName, "masterTreeMenu");
