    validateInputNumber: function (eleInput, iType, evt,iNoofDecimals,iSeq) {
        
        var charCode = null;
        try {
            bResult = false;
            var NoOfDecimals = 0;
            if (iSeq == -1) {
                var SelectedUnitData = OPTIONCONTROL.getControlData("optionPrimaryBaseUnit");
                var PrimaryOptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionPrimaryBaseUnit', SelectedUnitData);
                NoOfDecimals = parseFloat(parseFloat(PrimaryOptionValues.iNoOfDecimals) == 0 ? iNoofDecimals : parseFloat(PrimaryOptionValues.iNoOfDecimals));
            }
            else {
                var SelectedHierarchalUnitData = OPTIONCONTROL.getControlData("optionHierarchyBaseUnit_" + iSeq);
                var OptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionHierarchyBaseUnit_' + iSeq, SelectedHierarchalUnitData);
                NoOfDecimals = parseFloat(parseFloat(OptionValues.iNoOfDecimals) == 0 ? iNoofDecimals : parseFloat(OptionValues.iNoOfDecimals));
            }
            if (evt.which == 0 || evt.which == 8) {
                return (true);
            }
            charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 45) {
                if (eleInput.value.search("-") == 0)
                    return false;// -
                if ((iType == 0 || iType == 2)
                    && eleInput.value.length == 0) { // signed integer, signed decimal
                    return (true);
                }
            }
            if (charCode == 46) { // .
                var splitedValue = parseFloat(eleInput.value.split('.')[0]);
                if ((iType == 2 || iType == 3)
                    && (eleInput.value.indexOf(".") == -1 || splitedValue == 0)) { // Signed Decimal, Unsingned Decimal
                    return (true);
                }
            }
            else if (eleInput.value != "" && eleInput.value.split(".") != undefined && eleInput.value.split(".")[1] != undefined && eleInput.value.split(".")[1].length > 0) {
                if (eleInput.value.split(".")[1].length >= NoOfDecimals) {
                    return (false);
                }
                else {
                    return (true);
                }
            }
            else if (charCode >= 45 && charCode <= 57) { // 0 to 9
                return (true);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{validateInputNumber} " + err.message, "Exception");
        }
        return (false);
    },
