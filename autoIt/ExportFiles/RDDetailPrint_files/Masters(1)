                //if (IsTreeTabExists == "True") {
                //    InsertUpdateCheckedIdsTreeTab(value, true);
                //}
                if (((IsReport == "True") || IsFromPOS) && bChecked == true) {
                    bRetain = true;
                    if (GridrowidValues.length > 0) {
                        if (IsGroup == "True") {
                            var SelectedMasterChildData = getAllMasterChildren(IsReport, value);

                            // Extract numeric ids in a fast, robust way
                            var childrenIds = [];
                            if (SelectedMasterChildData) {
                                if (Array.isArray(SelectedMasterChildData.lstMasters)) {
                                    for (var ci = 0; ci < SelectedMasterChildData.lstMasters.length; ci++) {
                                        var m = SelectedMasterChildData.lstMasters[ci];
