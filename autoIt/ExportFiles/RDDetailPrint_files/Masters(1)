                                Fields.Tag = Fields.Tag == 0 ? false : true;
                                cellobj.setCellData("value", Fields.Tag);
                                cellobj.setCellText(Fields.Tag);
                            }
                            else if (Fields.DataTypeId == 4 || Fields.DataTypeId == 17 || Fields.DataTypeId == 18 || Fields.DataTypeId == 19) {
                                if (Fields.Tag != "") {
                                    var Tag = JSON.parse(Fields.Tag);
                                    cellobj.setCellData("value", Tag.Value);
                                    cellobj.setCellText(Tag.Text);
                                }
                                else {
                                    cellobj.setCellData("value", Fields.Tag);
                                    cellobj.setCellText(Fields.Tag);
                                }
                            }
                            else if (Fields.DataTypeId == 3 || Fields.DataTypeId == 5) {
                                var Tag = JSON.parse(Fields.Tag);
                                cellobj.setCellData("value", Tag.Value);
                                cellobj.setCellText(Tag.Text);
                            }
                            else if (Fields.DataTypeId == 12 || Fields.DataTypeId == 14 || Fields.DataTypeId == 22) {
                                var Tag = JSON.parse(Fields.Tag);
                                cellobj.setCellData("value", Tag.MasterId);
                                cellobj.setCellText(Tag.Name);
                            }
                            else if (Fields.DataTypeId == 7 || Fields.DataTypeId == 10) {
                                obj = {};
                                obj.sFileName = myApiFields[k + 1].Tag;
                                obj.sData = Fields.Tag;
                                MASTERENTRYSCREEN.updateAttachmentValue(cellobj,
                                    obj,
                                    cellobj.ColumnAttribute.ctrlid,
                                    false,
                                    0);
                            }
                            else {
                                cellobj.setCellData("value", Fields.Tag);
                                cellobj.setCellText(Fields.Tag);
                            }
                        }
                    }
                }
            }
        } catch (error) {
            COMMON.prototype.showMessage("Exception--PasteMasterData" + error.message);
        }

