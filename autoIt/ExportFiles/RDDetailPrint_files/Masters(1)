            var PrimarySelectedUnitData = OPTIONCONTROL.getControlData("optionPrimaryBaseUnit");
            var PrimaryOptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionPrimaryBaseUnit', PrimarySelectedUnitData);
