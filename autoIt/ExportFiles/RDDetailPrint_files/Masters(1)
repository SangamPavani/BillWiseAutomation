    ItemPackCalculateUOMQty: function (event, index) {
        var divHierarchyChildren = document.getElementById('divHierarchy');
            for (let i = 0; i < divHierarchyChildren.children.length; i++) {
                SplitValue = divHierarchyChildren.children[i].id.split('_');
                var SelectedHieararchyUnit = OPTIONCONTROL.getControlValue('optionHierarchyBaseUnit_' + SplitValue[1]);
                if (SelectedHieararchyUnit != null || SelectedHieararchyUnit != 0) {
                        if (divHierarchyChildren.children[i - 1] != undefined) {
                            var previousIndex = divHierarchyChildren.children[i - 1].id.split('_')[1];
                        }
                        else {
                            var previousIndex = 0;
                    }
                    var SelectedHierarchalUnitData = OPTIONCONTROL.getControlData("optionHierarchyBaseUnit_" + SplitValue[1]);
                    var OptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionPrimaryBaseUnit', SelectedHierarchalUnitData);
                    var SelectedUnitTypeName = OptionValues.UnitTypeName == "Basic" ? "Basic" : OptionValues.UnitTypeName;
                    var PrevSelectedHierarchalUnitData = OPTIONCONTROL.getControlData("optionHierarchyBaseUnit_" + previousIndex);
                    var PrevOptionValues = OPTIONCONTROL.convertRawDataIntoObject('optionPrimaryBaseUnit', PrevSelectedHierarchalUnitData);
                    var PrevSelectedUnitTypeName = PrevOptionValues.UnitTypeName == "Basic" ? "Basic" : PrevOptionValues.UnitTypeName;
                    var PreviousQty = document.getElementById('BaseQuantityId_' + previousIndex);
                    if (SelectedUnitTypeName == "Pallet" && PrevSelectedUnitTypeName == "Pallet") {
                        var Qty = document.getElementById('BaseQuantityId_' + (previousIndex - 1));
                        var PrevChildQty = document.getElementById('QuantityId_' + previousIndex);
                        var BaseQty = document.getElementById('BaseQuantityId_' + SplitValue[1]);
                        var NextQty = document.getElementById('QuantityId_' + SplitValue[1]);
                        if (NextQty.value == PrevChildQty.value) {
                            COMMON.prototype.showMessage(getResourceValue("msgQtyforPallet", GetMasterResourceMessages));
                            NextQty.value = "";
                            return false;
                        }
                        if (NextQty != null) {
                            if (PreviousQty == null) {
                                BaseQty.value = NextQty.value * 1;
                            }
                            else {
                                if (Qty != null) {
                                    BaseQty.value = NextQty.value * Qty.value;
                                }
                                else {
                                    BaseQty.value = NextQty.value * 1;
                                }
                            }
                        }

                    }
                    else {
                        var PreviousQty = document.getElementById('BaseQuantityId_' + previousIndex);
                        var BaseQty = document.getElementById('BaseQuantityId_' + SplitValue[1]);
                        var NextQty = document.getElementById('QuantityId_' + SplitValue[1]);
                        if (NextQty != null) {
                            if (PreviousQty == null) {
                                BaseQty.value = NextQty.value * 1;
                            }
                            else {
                                BaseQty.value = NextQty.value * PreviousQty.value;
                            }
                        }
                        index++;
                    }
                }
                else {
                    COMMON.prototype.showMessage(getResourceValue("msgSelectUnit", GetMasterResourceMessages));
                    return false;
                }
            }
    },
