                        for (var i = 0; i < arrTempSetAuthDetails.length; i++) {
                            if (parseInt(objData.SequenceNumber) == parseInt(arrTempSetAuthDetails[i][0].Data.value)) {
                                $(cellobj1.cell).find('input').prop("checked", true);
                            }
                        }

                    }
                    //debugger
                    GlobalFlags = {};
                    const firstItem = data.arrNew[0]?.[0];
                    if (firstItem) {
                        GlobalFlags.ApprovalRemarksMandatory = firstItem.ApprovalRemarksMandatory || false;
                        GlobalFlags.RejectionRemarksMandatory = firstItem.RejectionRemarksMandatory || false;
                        GlobalFlags.StoppedRemarksMandatory = firstItem.StoppedRemarksMandatory || false;
                        GlobalFlags.AskRemarks = firstItem.AskRemarksOnApproval || firstItem.AskRemarksOnRejection || firstItem.AskRemarksonStopped || false;
                    }

                    FGRIDCONTROL.hideColumn("GridPBAuthorize", 2, !GlobalFlags.AskRemarks);
