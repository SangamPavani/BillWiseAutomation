    btnCloseForView_Click: function (ele) {
        //debugger;
        try {
            var btnId = ele.id;
            var modalBody_Id = ele.parentElement.offsetParent.id;

            if (btnId == 'btnCloseCustomizeGrid') {
                $('#myCustomizePopup').modal('hide');

            }
            else {
                if (modalBody_Id == 'divViewPriceModalBody') {
                    if ($($('#myModal2')[0]).hasClass('show')) {
                        $('#myModal2').removeClass('show');
                    }
                    $('#myModal2').modal('hide');
                }
                else {
                    if ($($('#LoadViewPrice')[0]).hasClass('show')) {
                        $('#LoadViewPrice').removeClass('show');
                    }
                    $('#LoadViewPrice').modal('hide');
                }
            }
        } catch (err) {
            COMMON.prototype.showMessage("{PRICEBOOK.btnCloseForView_Click} " + err.message, "Exception");
            return false;
        }

    },

    LoadViewPricePopUp: function (ItemId, priceBookType, isFromPriceBook, modalBodyDivId) {
        //debugger;
        try {
            bFromPriceBook = isFromPriceBook;
            //iNoOfDecimal = 6;
            if (isFromPriceBook == false && ItemId == 0 && FCommon.UI.isValidObject("productQuery_data")) {
                ItemId = OPTIONCONTROL.getControlText("productQuery_data");
            }
            itemId = ItemId;
            ipriceBookType = priceBookType;
            viewPriceModalBodyDiv = modalBodyDivId;

            var tempData = {
                isFromPriceBook: isFromPriceBook,
                divId: modalBodyDivId,
                ItemId: ItemId
            }

            result = NETWORK.executeServerMethod(
                GLOBAL.getContextPath("ViewPriceBook", "PriceBook", "CoreMasters"),
                true,
                { typeId: priceBookType, isFromPriceBook: isFromPriceBook, iMenuId: 76 },
                "",
                true,
                "PRICEBOOK.LoadViewPricePopUp_Success",
                "GLOBAL.LoadingStart",
                "GLOBAL.LoadingEnd", tempData);
        } catch (err) {
            COMMON.prototype.showMessage("{PRICEBOOK.LoadViewPricePopUp} " + err.message, "Exception");
            return false;
        }

    },

    LoadViewPricePopUp_Success: function (flag, data, tempData) {
        try {
            //debugger;
            if (tempData.isFromPriceBook == true) {
                $("#" + tempData.divId + "").html(data);
                $('#myModal2').modal('show');
                $('#myModal2').addClass('show');
                $('#myModal2').css('display', 'block');
            } else {
                $("#" + tempData.divId + "").html(data);
                $('#LoadViewPrice').modal('show');
                $('#LoadViewPrice').addClass('show');
                $('#LoadViewPrice').css('diplay', 'block');
                OPTIONCONTROL.setControlValue("ctrlOptionProUPH2", tempData.ItemId);

            }
            PRICEBOOK.LoadViewPriceGrid();
        } catch (err) {
            COMMON.prototype.showMessage("{PRICEBOOK.LoadViewPricePopUp_Success} " + err.message, "Exception");
            return false;
        }
    },
