    setHeight: function (onLoadHeight) {
        try {
            var extraHeight = parseInt(onLoadHeight, 10) || 0;
            var PriceBookContainer = document.getElementById('PriceBookContainer');
            var mainHeader_MainLayout = document.getElementById('mainHeader_MainLayout');
            var winWidth = $(window).width();
            if (PriceBookContainer && mainHeader_MainLayout) {
                var headerHeight = mainHeader_MainLayout.getBoundingClientRect().height || 0;
                PriceBookContainer.style.height = (window.innerHeight - headerHeight - 40) + "px";
            }
            // small screens time apply scroll to the PriceBookContainer
            if (PriceBookContainer) {
                if (winWidth <= 768) {
                    PriceBookContainer.style.setProperty('overflow-y', 'auto', 'important');
                    PriceBookContainer.style.setProperty('overflow-x', 'hidden', 'important');
                    PriceBookContainer.style.setProperty('-webkit-overflow-scrolling', 'touch', 'important');
                } else {
                    try { PriceBookContainer.style.removeProperty('overflow-y'); } catch (e) { }
                    try { PriceBookContainer.style.removeProperty('overflow-x'); } catch (e) { }
                    try { PriceBookContainer.style.removeProperty('-webkit-overflow-scrolling'); } catch (e) { }
                }
            }

            var menuId = parseInt($("#hdnMenuId").val(), 10) || 0;

            var pageHeight = (typeof GLOBAL !== "undefined" && typeof GLOBAL.getPageHeight === "function")
                ? GLOBAL.getPageHeight()
                : window.innerHeight;

            var pricebookPageHeight = (typeof PRICEBOOK !== "undefined" && typeof PRICEBOOK.getPageHeight === "function")
                ? PRICEBOOK.getPageHeight()
                : pageHeight;

            // common header/button height calculations (used for both large and small screens)
            var pricebookhead = document.getElementById("pricebookhead");
            var headerRow = document.getElementById("headerRow");
            var btnbottom = document.getElementById("btnbottom");
            var myPagerDiv = document.getElementById("myPagerDiv");
            //  --- headerRow  on small screens to avoid overlap ---
            if (headerRow) {
                if (winWidth <= 768) {
                    headerRow.style.height = 'auto';
                    headerRow.style.minHeight = '68px'; 
                    headerRow.style.paddingBottom = '8px';
                    var needed = headerRow.scrollHeight + 6;
                    var minH = Math.max(88, needed);
                    headerRow.style.minHeight = minH + 'px';
                   
                } else {
                    headerRow.style.removeProperty('min-height');
                    headerRow.style.removeProperty('padding-bottom');
                    headerRow.style.removeProperty('height');
                }
            }
            var totalHeaderHeight = 0;
            if (pricebookhead) totalHeaderHeight += $(pricebookhead).outerHeight(true) || 0;
            if (headerRow) totalHeaderHeight += $(headerRow).outerHeight(true) || 0;

            var btnHeight = 0;
            if (btnbottom) btnHeight = $(btnbottom).outerHeight(true) || 0;
            var pagerHeight = 0;
            if (myPagerDiv) pagerHeight = $(myPagerDiv).outerHeight(true) || 0;

            // choose containers
            var rightDiv = document.getElementById("rightPriceBookDiv") || document.getElementById("rightPriceBookDiv1") || document.getElementById("rightPriceBookDiv2");
            var leftDiv = document.getElementById("leftPriceBookDiv");
            var PriceBookMainDiv = document.getElementById("PriceBookMainDiv");
            var rightUpdateDiv = document.getElementById("rightPriceBookDiv2");

            // available page area (usable by panels and grid)
            var reservedBottomMargin = 8;
            var availableHeight = Math.max(160, pricebookPageHeight - totalHeaderHeight - reservedBottomMargin);
            // Desktop / tablet — keep existing behaviour for > 768
            if (menuId > 0 && winWidth > 768) {
                var $pager = $('#myPager');
                $pager.removeClass("myPagerSmallScreen myPager myPager914 myPager1024 myPager1200");
                if (winWidth <= 991) {
                    $pager.addClass("myPager914");
                }
                else if (winWidth <= 1024) {
                    if ($('#leftPriceBookDiv').is(':visible')) {
                        $pager.addClass("myPager1024");
                    }
                }
                else if (winWidth <= 1199) {
                    $pager.addClass("myPager1024");
                }
                else {
                    $pager.addClass("myPager");
                }
                if (leftDiv) {
                    leftDiv.style.height = (availableHeight - 25) + "px";
                    leftDiv.style.overflowY = "auto";
                }
                if (rightDiv) {
                    rightDiv.style.height = (availableHeight - 25) + "px";
                    rightDiv.style.overflow = "hidden";
                }
                if (rightUpdateDiv) {
                    rightUpdateDiv.style.height = (availableHeight - 25) + "px";
                    rightUpdateDiv.style.overflow = "auto";
                }
                if (PriceBookMainDiv) {
                    PriceBookMainDiv.style.height = (availableHeight - 25) + "px";
                }
                var gridHead = document.getElementById("PriceBookWebGrid_head");
                var gridHeadHeight = (gridHead) ? gridHead.getBoundingClientRect().height || 0 : 40;

                // 1st time loadig screen
                var increaseGridBy = 80;
                if (typeof PRICEBOOK._initialGridBoostApplied === "undefined" || PRICEBOOK._initialGridBoostApplied === false) {
                    var firstLoadBoost = 60; // pixel boost for initial load
                    increaseGridBy += firstLoadBoost;
                }

                var gridBodyReserve = pagerHeight + btnHeight + 8;
                var gridBodyHeight = Math.max(90, availableHeight - gridHeadHeight - gridBodyReserve + extraHeight + increaseGridBy);

                var PriceBookWebGrid_body = document.getElementById("PriceBookWebGrid_body");
                if (PriceBookWebGrid_body) {
                    PriceBookWebGrid_body.style.height = gridBodyHeight + "px";
                    PriceBookWebGrid_body.style.overflowY = "auto";
                    PriceBookWebGrid_body.style.overflowX = "hidden";
                }

                if (myPagerDiv) {
                    myPagerDiv.style.position = "relative";
                    myPagerDiv.style.zIndex = 3;
                    myPagerDiv.style.marginTop = "6px";
                }
                if (btnbottom) {
                    btnbottom.style.position = "relative";
                    btnbottom.style.zIndex = 4;
                    btnbottom.style.display = "flex";
                    btnbottom.style.flexWrap = "wrap";
                    btnbottom.style.alignItems = "center";
                    btnbottom.style.gap = "8px";
                    // ensure footer is visible and force a reflow so it is not clipped on initial render in some browsers
                    try { btnbottom.style.visibility = 'visible'; } catch (e) { }
                    try { btnbottom.getBoundingClientRect(); } catch (e) { }
                }

                //  use the computed gridBodyHeight for overflow calculation
                if (PriceBookWebGrid_body && rightDiv) {
                    var rightInnerH = rightDiv.clientHeight;
                    var used = (gridHeadHeight + btnHeight + pagerHeight + 6); // safety
                    if ((gridBodyHeight + used) > rightInnerH) {
                        var shrink = (gridBodyHeight + used) - rightInnerH;
                        if (PRICEBOOK._initialGridBoostApplied)
                            PriceBookWebGrid_body.style.height = Math.max(60, gridBodyHeight - shrink) + "px";
                        else
                            PriceBookWebGrid_body.style.height = Math.max(60, (gridBodyHeight + 60) - shrink) + "px";
                    }
                }
                PRICEBOOK._initialGridBoostApplied = true;
            }
          else {
                $('#myPager').removeClass("myPager myPager914 myPager1024 myPagerSmallScreen");
                $('#myPager').addClass("myPagerSmallScreen");

                var gridHead = document.getElementById("PriceBookWebGrid_head");
                var gridHeadHeight = (gridHead) ? gridHead.getBoundingClientRect().height || 0 : 40;

                var increaseGridBySmall = 60;
                var gridBodyReserveSmall = pagerHeight + btnHeight + 12;

                // apply a modest initial boost on mobile as well (one-time)
                if (typeof PRICEBOOK._initialGridBoostApplied === "undefined" || PRICEBOOK._initialGridBoostApplied === false) {
                    increaseGridBySmall += 30;
                }
                var gridBodyHeightSmall = Math.max(120, pricebookPageHeight - totalHeaderHeight - gridHeadHeight - gridBodyReserveSmall + extraHeight + increaseGridBySmall);

                if (leftDiv) {
                    leftDiv.style.height = Math.max(160, pricebookPageHeight - 120) + "px";
                    leftDiv.style.overflowY = "auto";
                }

                if (rightDiv) {
                    rightDiv.style.height = Math.max(160, pricebookPageHeight - 120) + "px";
                    rightDiv.style.overflow = "hidden";
                }

                if (PriceBookMainDiv) {
                    PriceBookMainDiv.style.height = Math.max(160, pricebookPageHeight - 120) + "px";
                }

                var PriceBookWebGrid_body = document.getElementById("PriceBookWebGrid_body");
                if (PriceBookWebGrid_body) {
                    PriceBookWebGrid_body.style.height = gridBodyHeightSmall + "px";
                    PriceBookWebGrid_body.style.overflowY = "auto";
                    PriceBookWebGrid_body.style.overflowX = "hidden";
                }

                // mark the initial boost as applied
                PRICEBOOK._initialGridBoostApplied = true;

                if (myPagerDiv) {
                    myPagerDiv.style.position = "relative";
                    myPagerDiv.style.zIndex = 3;
                    myPagerDiv.style.marginTop = "4px";
                }

                if (btnbottom) {
                    btnbottom.style.position = "relative";
                    btnbottom.style.display = "flex";
                    btnbottom.style.flexWrap = "wrap";
                    btnbottom.style.justifyContent = "center";
                    btnbottom.style.gap = "6px";
                    var btnsDiv = document.getElementById("btnsDiv");
                    if (btnsDiv) {
                        btnsDiv.style.marginTop = "-4px";
                    }
                    btnbottom.style.marginTop = "2px";
                    btnbottom.style.paddingTop = "4px";
                    // ensure footer is visible and trigger reflow
                    try { btnbottom.style.visibility = 'visible'; } catch (e) { }
                    try { btnbottom.getBoundingClientRect(); } catch (e) { }
                }
                if (PriceBookWebGrid_body && rightDiv) {
                    var rightInnerH = rightDiv.clientHeight;
                    var used = (gridHeadHeight + btnHeight + pagerHeight + 6);
                    if ((gridBodyHeightSmall + used) > rightInnerH) {
                        var shrink = (gridBodyHeightSmall + used) - rightInnerH;
                        PriceBookWebGrid_body.style.height = Math.max(80, gridBodyHeightSmall - shrink) + "px";
                    }
                }
            }
            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("{PRICEBOOK.setHeight} " + err.message, "Exception");
            return false;
        }
    },
    getPageHeight: function () {
        try {
            var pageContainer = (window.innerHeight - 100);
            if (pageContainer != null)
                return parseInt(pageContainer);
            else
                return 0;
        }
        catch (ex) {
            return (parseInt($(window).height()));
        }
    },

