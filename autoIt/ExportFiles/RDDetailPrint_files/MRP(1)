            document.getElementById("txtTotalQuantity_Policy_DMR").innerText = parseFloat(MRP_DEPREQ.arrQuantityPolicy[MRP_DEPREQ.iSelectedOrderRowIndex]).toFixed(MRP_DEPREQ.DecimalInQuantity);
            document.getElementById("txtAvailableStock_Policy_DMR").innerText = parseFloat(0).toFixed(MRP_DEPREQ.DecimalInQuantity);
                var policyId = 0;
            var cell = FGRIDCONTROL.getCellObject("Id_PolicyDetails_FGrid_DMR", (MRP_DEPREQ.iSelectedOrderRowIndex + 1), 7);
            if (bSetPolicy) {
                policyId = MRP_DEPREQ.GetSelectedOrderPolicy();
            }
            else
                policyId = parseInt(cell.getCellData("ipolicy"));

            var OrderPolicy = MRP_DEPREQ.DepReqData.lstMRPProductDetails[MRP_DEPREQ.iSelectedOrderRowIndex];
            var OrdersQuantity = MRP_DEPREQ.arrQuantityPolicy[MRP_DEPREQ.iSelectedOrderRowIndex];
            var arrCalcQty = [];
            if (OrdersQuantity > 0) {
                var cellData = null;
                if (policyId == 0) {
                    cellData = FConvert.stringToObject(cell.getCellData("arrmanualdata"));
                }
                else {
                    cellData = FConvert.stringToObject(cell.getCellData("arrpolicydata"));
                    if (cellData.lValue > 0) {
                        if (cellData.data.length > 0) {
                            cellData = cellData.data;
                        }
                    }
                    else
                        cellData = new Array();
                }
                switch (policyId) {
                    case 0:
                        if (cellData.lValue > 0) {
                            if (cellData.data.length > 0) {
                                MRP_DEPREQ.FillOrderQuantityGrid(cellData.data, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].sProductName);
                            }
                        }
                        break;
                    case 1: /// ReOrderLevel : Min = reOrderQty && Max = maxOrderQty                
                        arrCalcQty = MRP_DEPREQ.CalculateQuantityByPolicy(OrdersQuantity, OrderPolicy.dReorderQty, OrderPolicy.dMaxOrderQty, false, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID);
                        MRP_DEPREQ.SetQuantityGrid(arrCalcQty, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].sProductName, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID, cellData);
                        break;

                    case 2: /// MaxLevel : Min = minOrderQty && Max = maxOrderQty
                        arrCalcQty = MRP_DEPREQ.CalculateQuantityByPolicy(OrdersQuantity, OrderPolicy.dMinOrderQty, OrderPolicy.dMaxOrderQty, true, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID);
                        MRP_DEPREQ.SetQuantityGrid(arrCalcQty, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].sProductName, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID, cellData);
                        break;

                    case 4: /// LotToLot : Min = minOrderQty && Max = maxOrderQty
                        arrCalcQty = MRP_DEPREQ.CalculateQuantityByPolicy(OrdersQuantity, OrderPolicy.dMinOrderQty, OrderPolicy.dMaxOrderQty, false, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID);
                        MRP_DEPREQ.SetQuantityGrid(arrCalcQty, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].sProductName, MRP_DEPREQ.arrMergedOrders[MRP_DEPREQ.iSelectedOrderRowIndex].iProductID, cellData);
                        break;

                    case 3: /// OrderToOrder : Raise Lots For The Complete Order Quantity
                        ////debugger;
                        var data = cell.CellData;
                        var arrVals;
                        if (data.arrqty.toString().indexOf(',') != -1) {
                            arrVals = data.arrqty.split(",");
                        }
                        else {
                            arrVals = [];
                            arrVals.push(data.arrqty);
                        }
                        MRP_DEPREQ.SetQuantityGrid(arrVals, data.sproductname, 0, cellData);
                        break;
                }
            }
            if (bSetPolicy == true) {
                var cell = FGRIDCONTROL.getCellObject("Id_PolicyDetails_FGrid_DMR", (MRP_DEPREQ.iSelectedOrderRowIndex + 1), 7);
                cell.setCellData("ipolicy", MRP_DEPREQ.GetSelectedOrderPolicy());
            }
        }
        else
            //COMMON.prototype.showMessage("Select any Order to Apply Order Policy", "Error Message");
            COMMON.prototype.showMessage(MRP_DEPREQ.MRP_DEPREQMsgs.MRP_DR_msgSelectAnyOrderToApplyOrderPolicy, MRP_DEPREQ.MRP_DEPREQMsgs.lblErrorMsg);
    },

    // Get Quantity array by calculating of sub quantity based on selected policy 
    CalculateQuantityByPolicy: function (totalLotQty, minOrderQty, maxOrderQty, bIsMaxLevel, iProductId) {
        ////debugger;
        var policyDetails = [];
        for (var i = 0; i < MRP_DEPREQ.DepReqData.lstMRPProductDetails.length; i++) {
            if (MRP_DEPREQ.DepReqData.lstMRPProductDetails[i].iID == iProductId) {
                policyDetails.push(MRP_DEPREQ.DepReqData.lstMRPProductDetails[i]);
            }
        }

        if (!bIsMaxLevel) {
            var totalSafetyStock = 0;
            for (var j = 0; j < policyDetails.length; j++) {
                totalSafetyStock += parseFloat(policyDetails[j].dSafetyStock);
            }
            totalLotQty += totalSafetyStock;
        }
        else {
            var totalSafetyStock = 0;
            if (policyDetails[0].dMaxInventory > policyDetails[0].dReordePoint &&
                policyDetails[0].dMaxInventory > policyDetails[0].dSafetyStock) {
                for (var j = 0; j < policyDetails.length; j++) {
                    totalSafetyStock += parseFloat(policyDetails[j].dMaxInventory);
                }
            }
            else if (policyDetails[0].dReordePoint > policyDetails[0].dMaxInventory &&
                    policyDetails[0].dReordePoint > policyDetails[0].dSafetyStock) {
                for (var j = 0; j < policyDetails.length; j++) {
                    totalSafetyStock += parseFloat(policyDetails[j].dReordePoint);
                }
            }
            else {
                for (var j = 0; j < policyDetails.length; j++) {
                    totalSafetyStock += parseFloat(policyDetails[j].dSafetyStock);
                }
            }
            totalLotQty += totalSafetyStock;
        }

        arrOrderQuantity = [];
        if (maxOrderQty > 0) {
            while (totalLotQty > maxOrderQty) {
                arrOrderQuantity.push(maxOrderQty);
                totalLotQty -= maxOrderQty;
            }
            if (totalLotQty > 0) {
                if (totalLotQty > minOrderQty)
                    arrOrderQuantity.push(totalLotQty);
                else
                    arrOrderQuantity.push(minOrderQty);
            }
        }
        else
            arrOrderQuantity.push(totalLotQty);

        return arrOrderQuantity;
    },

