                                FGRIDCONTROL.setCellData(rowEle, "irouintgid", data[i].iRoutingID);
                                break;
                            case 2:
                                Objcell.setCellText(data[i].sProductName);
                                Objcell.setCellData("value", data[i].iParentID);
                                break;
                            case 3:
                                Objcell.setCellText(data[i].sProductCode);
                                Objcell.setCellData("value", data[i].iParentID);
                                break;
                            case 4:
                                Objcell.setCellText(lstDates[i].startDate);
                                Objcell.setCellData("value", lstDates[i].startDate);
                                break;
                            case 5:
                                Objcell.setCellText(lstDates[i].EndDate);
                                Objcell.setCellData("value", lstDates[i].EndDate);
                                break;
                            case 6:
                                Objcell.setCellText(lstDates[i].DueDate);
