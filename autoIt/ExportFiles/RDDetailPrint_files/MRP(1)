                        }
                        //var sFilter = "iProductId = " + parseInt(OPTIONCONTROL.getControlValue("FOption_ProductName_Req"));
                        //if (REQUISITION.bSeriesEnabled) {
                        //    var Checked = document.getElementById("chkEnableTagFilter").checked;
