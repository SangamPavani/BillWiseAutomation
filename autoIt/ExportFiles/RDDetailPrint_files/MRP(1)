    OpenWorkCenter: function (bodyId, nodeId) {
        //debugger
        try {
            if (R_WORKCENTER.IsValidObject(bodyId) == false) {
                bodyId = 0;
            }
            R_WORKCENTER.iBodyId = bodyId;
            if (R_WORKCENTER.IsValidObject(nodeId) == false) {
                nodeId = 0;
            }
            else {
                nodeId = parseInt(nodeId);
            }
            R_WORKCENTER.iNodeId = nodeId;
            var urlPath = GLOBAL.getContextPath("_RoutingWorkCenter", "Routing", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, null, "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
            if (fnResult.lValue > 0 && fnResult.data != null) {
                //debugger;
                $("#container_RoutingWorkCenter").html(fnResult.data);

                if (R_WORKCENTER.IsValidObject(bodyId) == true && bodyId > 0) {
                    R_WORKCENTER.isNewNode = false;
                    R_WORKCENTER.FillWorkCenterData(bodyId);
                }
                else {
                    R_WORKCENTER.objWorkCenter = {};
                    var objWorkCenter = ROUTING.arrRoutingNodes.find(item=>item.iNodeSeq == R_WORKCENTER.iNodeId);
                    if (R_WORKCENTER.IsValidObject(objWorkCenter) == true) {
                        R_WORKCENTER.objWorkCenter = objWorkCenter;
                        R_WORKCENTER.iNodeXPos = objWorkCenter.iXPos;
                        R_WORKCENTER.iNodeYPos = objWorkCenter.iYPos;
                        R_WORKCENTER.isNewNode = false;
                        R_WORKCENTER.FillGeneralTabData(objWorkCenter);
                        R_WORKCENTER.FillWorkCenterPRTData(objWorkCenter.arrRoutingPRT);
                        R_WORKCENTER.FillSkillSetTab(objWorkCenter.arrSkillDef);

                        if (R_WORKCENTER.IsValidObject(objWorkCenter.arrRoutingBOMProduct) == true) {
                            R_WORKCENTER.FillWorkCenterInputData(objWorkCenter.arrRoutingBOMProduct, true);
                        }
                        //remove
                        if (objWorkCenter.arrRoutingOutput == null) {
                            objWorkCenter.arrRoutingOutput = [];
                        }
                        if (objWorkCenter.arrRoutingOutput.length > 0) {
                            R_WORKCENTER.FillWorkCenterOutputData(objWorkCenter.arrRoutingOutput, true);
                        }
                        else {
                            if (R_WORKCENTER.IsValidObject(ROUTING.g_routingOutput) == true) {
                                R_WORKCENTER.FillWorkCenterOutputData(ROUTING.g_routingOutput, false);
                            }
                        }
                    }
                    else {
                        R_WORKCENTER.objWorkCenter.iNodeSeq = 0;
                        R_WORKCENTER.isNewNode = true;
                        if (R_WORKCENTER.IsValidObject(ROUTING.arrForWorkCenterInput) == true) {
                            R_WORKCENTER.FillWorkCenterInputData(ROUTING.arrForWorkCenterInput, true);
                        }
                        if (R_WORKCENTER.IsValidObject(ROUTING.g_routingOutput) == true) {
                            R_WORKCENTER.FillWorkCenterOutputData(ROUTING.g_routingOutput, false);
                        }
                    }

                }
                $("#id_RoutingWorkCenter_Modal_Routing").modal("show");


                //if (ROUTING.bProcessApplyCapacityFilter) {
                //    OPTIONCONTROL.setFilter("objFOption_ProcessName", "bApplyCapacityFilter=1");
                //}
                //else {
                //    OPTIONCONTROL.setFilter("objFOption_ProcessName", "");
                //}
            }
        }
        catch (e) {
            alert("Exception {R_WORKCENTER.OpenWorkCenter} : ", e.message);
        }
    },

