    OnLeaveTags: function (id, data) {
        try {
            //debugger
            var iPIOId = PIORDER.GetPIOHeaderId();
            if (iPIOId == 0) {
                var lstData = [];
                var iMasterId = 0;
                var iTableId = 0;

                var Header = PIORDER.PIORDERFocustags.arrFocusTags;

                for (var i = 0; i < Header.length; i++) {
                    if (Header[i].iPos == 0) {
                        var Id = "Id_Header_" + Header[i].FieldName;
                        iMasterId = OPTIONCONTROL.getControlValue(Id);
                        iTableId = document.getElementById("hdnTagid_" + Id).value;
                        //if (iMasterId == 0) {
                        //    OPTIONCONTROL.clear(id.id);
                        //    COMMON.prototype.showMessage(PIORDER.PIORDERMsgs.BRS_lblSelect + " " + Header[i].MasterName, PIORDER.PIORDERMsgs.MRP_PIO_msgPIO);
                        //    return false;
                        //}

                        var sFieldNames = Header[i].FieldName;
                        if (Header[i].FieldName != Header[i].MasterName) {
                            sFieldNames = Header[i].MasterName;
                        }

                        var obj = {
                            iMasterId: iMasterId,
                            iTableId: iTableId,
                            sFieldOrValue: sFieldNames
                        }

                        lstData.push(obj);
                    }
                }

                var urlPath = GLOBAL.getContextPath("GetMaxNoForPIO", "PlanIndependentOrder", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { lstPIOSeriesHeaderTags: lstData }, "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");

                if (fnResult.data != null && fnResult.data != undefined && fnResult.data != "") {
                    document.getElementById("txtDocumentNo_PIO").value = fnResult.data;
                }

                FGRIDCONTROL.gotoCell(document.getElementById("Id_PlanIndependentOrder_Grid_PIO"), 1, 2);
            }

        } catch (e) {
            COMMON.prototype.showMessage("Exception: {PIORDER.OnLeaveTags} " + e.message, PIORDER.PIORDERMsgs.lblErrorMsg);
        }
    },

