    this.CalculateCostingPer = function () {
        //debugger;
        var iRowCount = 0;
        var dCostPer = 100;
        var eleput = document.getElementById('BOM_UL').getElementsByClassName("active")[0].id;
        var iVarId = eleput.split('_')[2];
        var sGridId = "Bom_OutputGrid_" + iVarId;
        var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
        for (var i = 0; i < totalRows; i++) {
            var RowCellcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 7);
            var iProcessIdvalue = RowCellcount.getCellData("value");
            if (iProcessIdvalue > 0) {
                iRowCount++;
            }
        }
        if (iRowCount > 0) {
            for (var i = 0; i < iRowCount; i++) {
                var RowCellcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 1);
                //var iProcessIdvalue = parseFloat(RowCellcount.getCellData("value"));
                var iProcessIdvalue = (RowCellcount.getCellData("value"));
                if (iProcessIdvalue == "") {
                    iProcessIdvalue = 0;
                }

                var RowcolCostingPerEditedcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 19 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                var scolCostingPerEdited = RowcolCostingPerEditedcount.getCellData("value");
                //if (iProcessIdvalue < 0)
                //continue;
                //if (iProcessIdvalue > 0 && scolCostingPerEdited == "True") {
                var RowcolCostingPercount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                var dCostPerCent = RowcolCostingPercount.getCellData("value");
                if ((scolCostingPerEdited == "True") || (scolCostingPerEdited == "true") || dCostPerCent > 0) {                    
                    if (dCostPerCent > 100) {
                        var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                        cell.setCellText(parseFloat(100));
                        cell.setCellData("value", parseFloat(100));
                        for (var k = 0; k < iRowCount; k++) {
                            if (i != k) {
                                var cell = FGRIDCONTROL.getCellObject(sGridId, (k + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                                cell.setCellText(parseFloat(0));
                                cell.setCellData("value", parseFloat(0));
                            }
                        }
                        dCostPer = 0;
                        break;
                    }
                    else if ((dCostPer - dCostPerCent) < 0) {
                        var dtempper = 100 - dCostPerCent;
                        dtempper = parseFloat(dtempper / (iRowCount - 1)).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity)
                        alert('You have Entered Above Remaining Percentage (' + dCostPer + ')');
                        for (var k = 0; k < iRowCount; k++) {
                            if (i != k) {
                                var cell = FGRIDCONTROL.getCellObject(sGridId, (k + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                                cell.setCellText(parseFloat(dtempper));
                                cell.setCellData("value", parseFloat(dtempper));
                            }
                        }
                        dCostPer = 0;
                        break;
                    }
                    else {
                        var RowcolCostingPer = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                        var dcolCostingPer = parseFloat(RowcolCostingPer.getCellData("value"));
                        dCostPer = parseFloat(dCostPer - parseFloat(dcolCostingPer)).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity);
                    }
                }
                else {
                    var dTempCost = Math.round(dCostPer / (iRowCount - i), 2);
                    if ((dTempCost * (iRowCount - i)) == dCostPer) {
                        dCostPer = dCostPer - dTempCost;
                    }
                    else {
                        dTempCost = dTempCost + (dCostPer - (dTempCost * (iRowCount - i)));
                        dCostPer = dCostPer - dTempCost;
                    }
                    dTempCost = parseFloat(dTempCost).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity);
                    var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                    cell.setCellText(parseFloat(dTempCost));
                    cell.setCellData("value", parseFloat(dTempCost));
                }
            }
            if (dCostPer > 0) {
                var dTempCostPer = 100; var dTemp = 0; var iCount = 0;
                for (var i = 0; i < iRowCount; i++) {
                    var RowCellcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 1);
                    var iProcessIdvalue = parseFloat(RowCellcount.getCellData("value"));

                    var RowcolCostingPerEditedcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 19 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                    var scolCostingPerEdited = RowcolCostingPerEditedcount.getCellData("value");

                    var RowcolCostingPervalue = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                    var scolCostingPervalue = RowcolCostingPervalue.getCellData("value");
                    if (iProcessIdvalue > 0 && scolCostingPerEdited == "True") {
                        dTemp += scolCostingPervalue;
                        iCount++;
                    }
                }
                if ((dTempCostPer - dTemp) > 0) {
                    var dRemaing = dTempCostPer - dTemp;
                    if ((iRowCount - iCount) > 0) {
                        var dtempper = Math.round(dRemaing / (iRowCount - iCount), 2);
                        for (var i = 0; i < iRowCount; i++) {
                            var RowCellProduct = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 1);
                            var iProductidvalue = RowCellProduct.getCellData("value");
                            var RowCostingPerEdited = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 19 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                            var sCostingPerEditedvalue = RowCostingPerEdited.getCellData("value");
                            if (iProductidvalue > 0 && sCostingPerEditedvalue == "False") {
                                var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 18 + BOM_OUTPUTGRID.QtyExtraFieldsCount);
                                dtempper = parseFloat(dtempper).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity);
                                cell.setCellText(parseFloat(dtempper));
                                cell.setCellData("value", parseFloat(dtempper));
                            }
                        }
                    }
                }
            }
        }
    }

