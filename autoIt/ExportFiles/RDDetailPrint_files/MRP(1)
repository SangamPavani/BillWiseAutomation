    clkClosePIO: function () {
        try {
            debugger;
            var arrProdOrderId = [];                        
            var lstCloseProdOrder = [];           
            var arrProductionOrders = [];         
            var sNotReleasedPO = "", sAlreadyClosedPO = "", sAlreadyFinishedPO = "", sClosedPO = "";            

            //Get Current Production order...(in Grid)...
            var result = RAISE_PO_LANDING.GetSelectedRowCountinGridAndIndexClosePO();
            if (result.iSelectedRowCount == 0 || result.lstrowIndex.length == 0) {
                //COMMON.prototype.showMessage("Select any Production Order", "Error Message");
                COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSelectAnyProductionOrder, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
                return false;
            }
            //else if (result.iSelectedRowCount > 1) {
            //    //COMMON.prototype.showMessage("Select One  Production Order.", "Error Message");
            //    COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSelectOnlyOneProductionOrder, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
            //    return false;
            //}

            var rowCount = FGRIDCONTROL.getTotalRows("Id_RaisePOLanding_Grid");
            for (var p = 0; p < result.lstrowIndex.length; p++) {                
                var GridRdata = FGRIDCONTROL.getRowValue("Id_RaisePOLanding_Grid", result.lstrowIndex[p]);
                arrProductionOrders.push(parseInt(GridRdata[1].Data.value));                
            }
            var urlPath = GLOBAL.getContextPath("GetMultipleProductionOrderStatus", "RaiseProductionOrders", "MRP");
            var OrderStatusdata = NETWORK.executeServerMethod(urlPath, true, { arrProductionOrders: arrProductionOrders }, "", false);            
            if (OrderStatusdata.data.length > 0) {
                var data = OrderStatusdata.data;
                for (var s = 0; s < data.length; s++) {
                    var iStatus = data[s].ID;
                    if (parseInt(iStatus) < 2) {
                        sNotReleasedPO += data[s].Name + ",";
                    }
                    else if (parseInt(iStatus) == 2 || parseInt(iStatus) == 3) {
                        sClosedPO += data[s].Name + ",";
                        arrProdOrderId.push(data[s].LID);
                    }
                    else if (parseInt(iStatus) == 4) {
                        sAlreadyFinishedPO += data[s].Name + ",";
                    }
                    else if (parseInt(iStatus) == 6) {
                        sAlreadyClosedPO += data[s].Name + ",";
                    }
                    var objCloseProdOrder = {};
                    objCloseProdOrder.iProdOrderId = data[s].LID;
                    objCloseProdOrder.sProdOrderNo = data[s].Name;
                    objCloseProdOrder.iOrderStatusvalue = data[s].ID;
                    objCloseProdOrder.CloseProdorder = false;
                    lstCloseProdOrder.push(objCloseProdOrder);                                       
                }
            }
          
            if (arrProdOrderId.length > 0) {
                var Result = "", lstIRdata = [];
                //NewOne                
                if (RAISE_PO_LANDING.bMrp1Enabled == true || RAISE_PO_LANDING.bMrp2Enabled == true) {
                    var urlPath = GLOBAL.getContextPath("ValidateIssuesAndReceiptsForPOMRP1", "RaiseProductionOrders", "MRP");
                    Result = NETWORK.executeServerMethod(urlPath, true, { arrProdOrderId: arrProdOrderId, iViewId: RAISE_PO_LANDING.iView }, "JSON", false);
                    lstIRdata = Result.data;
                }
                else {
                    //Basic Orders Close
                    if (confirm("Closing of this order will refresh rate as per the issued Quantity and the valuation of the item will increase, Do you still want to close production Order(s)")) {
                        var CloseProdorder = true;
                        var arrPos = [];
                        var sProductionOrders = "";
                        if (CloseProdorder == true) {
                            var bFirstRecord = true;
                            for (var i = 0; i < lstCloseProdOrder.length; i++) {

                                if (lstCloseProdOrder[i].iOrderStatusvalue >= 2) {
                                    arrPos.push(lstCloseProdOrder[i].iProdOrderId);
                                    if (bFirstRecord == true) {

                                        sProductionOrders = sProductionOrders + lstCloseProdOrder[i].sProdOrderNo;
                                    }
                                    else {
                                        sProductionOrders = "," + sProductionOrders + lstCloseProdOrder[i].sProdOrderNo;
                                    }
                                    bFirstRecord = false;

                                }
                            }
                            var urlPath = GLOBAL.getContextPath("GetClosePoDetailsMultipleBasic", "RaiseProductionOrders", "MRP");
                            var dataClosePIO = NETWORK.executeServerMethod(urlPath, true, { arrProductioOrderId: arrPos, iViewId: RAISE_PO_LANDING.iView }, "HTML", false);
                            if (dataClosePIO.data != null && dataClosePIO.data != undefined) {
                                if (dataClosePIO.data == "true" || dataClosePIO.data == "false") {
                                    if (dataClosePIO.data == "true") {
                                        COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSuccessfullyClosedProductionOrder + sProductionOrders, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.ProductionOrder);
                                        var selcetedvalue = document.getElementById('ddlProductionFilter').value;
                                        var urlPath = GLOBAL.getContextPath("GetRaiseProductionOrder_Landing", "RaiseProductionOrders", "MRP");
                                        var ResultRaisePOLanding = NETWORK.executeServerMethod(urlPath, true, { ddlSelectedvalue: selcetedvalue, cntpageNo: 0, selectionchanged: true, bfromReleaseProdOrder: false, iMenuId: document.getElementById("RaisePOmenuId").value, iViewId: RAISE_PO_LANDING.iView }, "HTML", false);
                                        if (ResultRaisePOLanding.data != null && ResultRaisePOLanding.data != undefined) {
                                            $('#Id_RaisePOLanding').html('');
                                            $('#Id_RaisePOLanding').html(ResultRaisePOLanding.data);
                                        }
                                        return;
                                    }
                                }
                            }

                        }
                        return;
                    }
                }
                var lstSortedCloseProdOrder = [];
                sClosedPO = "";
                for (var j = 0; j < lstIRdata.length; j++) {
                    //Confirmation Popup
                    //var CloseProdorder = false;
                    var iIndexCPO = lstCloseProdOrder.findIndex(x => x.iProdOrderId == lstIRdata[j].iProductionOrderId);                                               
                    if (lstIRdata[j].dIssuedProductionSize > lstIRdata[j].dReceiptProductionSize) {                        
                        if (confirm("Issued Production quantity is not received fully for this Order,Closing of this order will refresh rate as per the issued Quantity and the valuation of the item will increase, Do you still want to close production Order For PO number -" + " " + lstCloseProdOrder[iIndexCPO].sProdOrderNo)) {
                            //CloseProdorder = true;
                            sClosedPO += lstCloseProdOrder[iIndexCPO].sProdOrderNo + ",";
                            lstCloseProdOrder[iIndexCPO].CloseProdorder = true;
                            lstSortedCloseProdOrder.push(lstIRdata[j].iProductionOrderId);
                        }                                           
                    }
                    if (lstIRdata[j].dIssuedProductionSize <= lstIRdata[j].dReceiptProductionSize) {                                                
                        //CloseProdorder = true;
                        sClosedPO += lstCloseProdOrder[iIndexCPO].sProdOrderNo + ",";
                        lstCloseProdOrder[iIndexCPO].CloseProdorder = true;
                        lstSortedCloseProdOrder.push(lstIRdata[j].iProductionOrderId);
                    }                   
                }

                if (lstSortedCloseProdOrder.length > 0) {
                    var urlPath = GLOBAL.getContextPath("GetMultipleClosePODetails", "RaiseProductionOrders", "MRP");
                    var dataClosePIO = NETWORK.executeServerMethod(urlPath, true, { iProductioOrderIds: lstSortedCloseProdOrder, iViewId: RAISE_PO_LANDING.iView }, "HTML", false);
                    var PONO = sClosedPO;
                    if (dataClosePIO.data != null && dataClosePIO.data != undefined) {
                        if (dataClosePIO.data == "true" || dataClosePIO.data == "false") {
                            if (dataClosePIO.data == "true") {
                                //COMMON.prototype.showMessage("Successfully Closed Production Order " + PONO, "Production order");
                                COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSuccessfullyClosedProductionOrder + PONO, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.ProductionOrder);
                                var selcetedvalue = document.getElementById('ddlProductionFilter').value;
                                var urlPath = GLOBAL.getContextPath("GetRaiseProductionOrder_Landing", "RaiseProductionOrders", "MRP");
                                var ResultRaisePOLanding = NETWORK.executeServerMethod(urlPath, true, { ddlSelectedvalue: selcetedvalue, cntpageNo: 0, selectionchanged: true, bfromReleaseProdOrder: false, iMenuId: document.getElementById("RaisePOmenuId").value, iViewId: RAISE_PO_LANDING.iView }, "HTML", false);
                                if (ResultRaisePOLanding.data != null && ResultRaisePOLanding.data != undefined) {
                                    $('#Id_RaisePOLanding').html('');
                                    $('#Id_RaisePOLanding').html(ResultRaisePOLanding.data);
                                }
                                return;
                            }
                            else if (dataClosePIO.data == "false") {
                                //COMMON.prototype.showMessage("Cannot Close Production Order " + PONO, "Production order");
                                COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgCaanotCloseProductionOrder + PONO, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.ProductionOrder);
                                return;
                            }
                        }
                        $('#BindPartialClosePOData').html('');
                        $('#BindPartialClosePOData').html(dataClosePIO.data);
                        OPTIONCONTROL.setControlValue("FOption_ClosePO_RPOLanding", parseInt(lstSortedCloseProdOrder[0]));

                        var cell = FGRIDCONTROL.getCellObject("Id_ClosePODataDetails_Grid", 0, 1);
                        var Id = "#" + cell.cell.children[0].id;
                        $(Id).trigger('click');

                        if (window.GlobalPref.Version == eVersion.Version10) {
                            $("#id_CloseRPO").modal("show");
                        }
                        else {
                            $("#id_CloseRPO").modal();
                        }
                        
                    }
                }                               
            }
            if (sNotReleasedPO != "") {
                COMMON.prototype.showMessage("Prodction Order : " + sNotReleasedPO + " Not Released.Cannot Close.", RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
            }
            if (sAlreadyClosedPO != "") {
                COMMON.prototype.showMessage("Prodction Order : " + sAlreadyClosedPO + " has Already been Closed.", RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
            }
            if (sAlreadyFinishedPO != "") {
                COMMON.prototype.showMessage("Prodction Order : " + sAlreadyFinishedPO + " has Already been Finished.", RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
            }                 
        }
        catch (e) {

        }
    },

