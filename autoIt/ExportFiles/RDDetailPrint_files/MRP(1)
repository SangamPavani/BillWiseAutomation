                            OBJPPPW.bDontMaintainStocksByRMA = 0;//ERF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStocksByRMA;
                        }
                    }
                }
            }
            ERF_PRODUCTION.PPPW.push(OBJPPPW);
            arrRowExtraF = arrExtra;
            arrRowTagsF = arrTags;

            ObjF = ERF_PRODUCTION.LoadDataFromArr(ERF_PRODUCTION.arrRFPProductData.BodyData[iRow - 1], OBJPPPW);

        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {ERF_PRODUCTION.LoadGridDate} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {ERF_PRODUCTION.LoadGridDate} " + e.message, ERF_PRODUCTION.ERF_PRODUCTIONMsgs.lblErrorMsg);
        }
        return ObjF;
