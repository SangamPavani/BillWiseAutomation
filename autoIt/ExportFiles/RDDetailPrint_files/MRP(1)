                ////    }
                ////    else {
                ////        iWareHouseId = InvData.iMasterId;
                ////    }
                ////}
                var iInventoryTagIds = [];
                if (!MRP_PROCESS.bAllowLineWiseWarehouseSelection) {
                    if (document.getElementById("InvListCheckBox") != null) {
                        var InvListCheckBoxData = LISTCHECKBOX.getControlData("InvListCheckBox");
                        if (InvListCheckBoxData != null && InvListCheckBoxData.length > 0) {
                            for (var i = 0; i < InvListCheckBoxData.length; i++) {
                                var iId = InvListCheckBoxData[i].ID;
                                iInventoryTagIds.push(iId);
                            }
                        }
                    }
                }
                else {
                    var arrTemp = MRP_PROCESS.arrAllInvData[MRP_PROCESS.MRPProcessingPONo];
                    var objTep = [];
                    for (t = 0; t < arrTemp.length; t++) {
                        var obj = arrTemp[t].find(m => m.iProduct == parseInt(MRP_PROCESS.iMaterialID));
                        if (MRP_PROCESS.IsValidObject(obj) == true) {
                            for (var i = 0; i < arrTemp[t].length; i++) {
                                var iId = arrTemp[t][i].ID;
                                iInventoryTagIds.push(iId);
                            }
                            break;
                        }
                    }
                    //iInventoryTagIds.push(objTep);
                }

                debugger
                var arrTempStockStruct = [];
                var objStock = {
                    iProductId: MRP_PROCESS.iMaterialID,
                    iWareHouseId: 0, //optIssuingWarehouse.SelectedID < 0 ? 0 : parseInt(optIssuingWarehouse.SelectedID);
                    iDate: DATE.prototype.today(MRP_PROCESS.CalanderType),
                    iUseId: 0 //GlobalPref.iUserId;
                }
                arrTempStockStruct.push(objStock);
                var urlPath = GLOBAL.getContextPath("GetStockAvailabilityToReserve", "MRPProcess", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { arrStockStruct: arrTempStockStruct, bDoReservation: true, iInventoryTagIds: iInventoryTagIds }, "JSON", false);
                //
                if (fnResult.lValue > 0) {
                    var arrAvailableStock = fnResult.data;
                    if (arrAvailableStock != null) {
                        var lstReservation = []; // MRPReservation
                        MRP_PROCESS.arrStockReservation = [];
                        MRP_PROCESS.arrProductionOrderLinks = [];
                        for (var i = 0; i < arrAvailableStock.length; i++) {
                            var MRPReservation = {
                                iProductID: arrAvailableStock[i].iProductId,
                                dStock: arrAvailableStock[i].dQuantity,
                                iDueDate: arrAvailableStock[i].iDate,
                                sDocumentType: 0,
                                iReservationType: arrAvailableStock[i].ReserveType,
                                iTransactionID: arrAvailableStock[i].iTransactionId,
                                iWarehouseID: arrAvailableStock[i].iWareHouseId,
                                sReservationType: arrAvailableStock[i].sStockType,
                            };
                            lstReservation.push(MRPReservation);
                        }
                        //
                        if (lstReservation.length > 0) {
                            var iTotQty = 0;
                            var dAdjustedQty = 0;
                            var iDocID = parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].sReserveBy);
                            var iDocType = parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iDocumentType);
                            lstReservation.sort(MRP_PROCESS.SortBasedOnProp('iDueDate'));
                            for (var i = 0; i < lstReservation.length; i++) {
                                if (AvailableQty > 0) {
                                    if (AvailableQty <= parseFloat(lstReservation[i].dStock).toFixed(MRP_PROCESS.iDecimalInQuantity)) {
                                        dAdjustedQty = AvailableQty;
                                        iTotQty = iTotQty + dAdjustedQty;
                                        AvailableQty = 0;
                                    }
                                    else if (AvailableQty > parseFloat(lstReservation[i].dStock).toFixed(MRP_PROCESS.iDecimalInQuantity)) {
                                        dAdjustedQty = parseFloat(lstReservation[i].dStock).toFixed(MRP_PROCESS.iDecimalInQuantity);
                                        iTotQty = parseFloat(iTotQty) + parseFloat(parseFloat(lstReservation[i].dStock).toFixed(MRP_PROCESS.iDecimalInQuantity));
                                        AvailableQty = AvailableQty - parseFloat(parseFloat(lstReservation[i].dStock).toFixed(MRP_PROCESS.iDecimalInQuantity));
                                    }
                                    //
                                    MRP_PROCESS.FillStockReservation(iDocID, iDocType, lstReservation[i].iReservationType,
                                        lstReservation[i].iTransactionID, lstReservation[i].iProductID, dAdjustedQty, 0,
                                        lstReservation[i].iDueDate, true, lstReservation[i].iWarehouseID);

                                    if ((parseInt(lstReservation[i].sDocumentType) == 1) || (parseInt(lstReservation[i].sDocumentType) == 2) || (parseInt(lstReservation[i].sDocumentType) == 0)) {
                                        var iLinkType = 0;
                                        if (parseInt(lstReservation[i].sDocumentType) == 1)
                                            iLinkType = 1;
                                        else if (parseInt(lstReservation[i].sDocumentType) == 2)
                                            iLinkType = 0;
                                        else if (parseInt(lstReservation[i].sDocumentType) == 0)
                                            iLinkType = 2;
                                        MRP_PROCESS.FillProductionOrderLinks(ParentOrderID, dAdjustedQty, iLinkType, parseInt(lstReservation[i].iTransactionID), 1, true);
                                    }
                                }
                                else {
                                    break;
                                }
                            }

                            MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dAdjustedQty = parseFloat(parseFloat(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dAdjustedQty) + iTotQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
                            MRP_PROCESS.SaveMRPRaiseStockReservationData(MRP_PROCESS.arrStockReservation);
                            if (MRP_PROCESS.arrProductionOrderLinks != null) {
                                if (MRP_PROCESS.arrProductionOrderLinks.length > 0) {
                                    MRP_PROCESS.SaveMRPDataInProdOrderLinksTable(MRP_PROCESS.arrProductionOrderLinks);
                                }
                            }
                        }
                    }
                }
            }
            return AvailableQty;
        } catch (e) {
            alert("Exception: {MRP_PROCESS.DoReservation} " + e.message);
            return AvailableQty;
        }
    },

    // Fills Issue to Production List to save 
    FillIssueToProduction: function (ProductID, iProductionOrderiD, iUnitID, dQuantity, ScrapPercentage, iProcureType, iSpecificVendor, iPDRID, iParentProductId, bEditedQuantity) {
        try {

            var iInvTagValue = 0;
            var OrderIndex = MRP_PROCESS.GetRaisingPOIndex();
            if (MRP_PROCESS.arrExplodedBOM != null && MRP_PROCESS.arrExplodedBOM[OrderIndex] != null) {
                for (var i = 0; i < MRP_PROCESS.arrExplodedBOM[OrderIndex].length; i++) {
                    if (ProductID == MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iProduct) {
                        if (iParentProductId == MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iParentProductID) {
                            iInvTagValue = MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iInvTagValue;
                            break;
                        }
                    }
                }
            }
            else {
                //Implement to Get the InvTag Value from BOM and Set the Value to iInvTagValue
                var urlPath = GLOBAL.getContextPath("GetInvTagValueBasedOnProductAndProdOrder", "MRPProcess", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { iProductId: ProductID, iProdOrderId: iProductionOrderiD }, "JSON", false, "", QUICKMRP.bfromQuickMRP == true ? "" : "GLOBAL.LoadingStart", QUICKMRP.bfromQuickMRP == true ? "" : "GLOBAL.LoadingEnd");
                if (fnResult.data != null && fnResult.data != undefined) {
                    iInvTagValue = fnResult.data;
                }
            }

            MRP_PROCESS.arrIssueToProduction = [];
            var ProductionIssue = {
                iProductID: ProductID,
                iProductionOrderiD: iProductionOrderiD,
                iUnitID: iUnitID,
                dQuantity: dQuantity,
                dScrapPercentage: ScrapPercentage,
                iProcureType: iProcureType,
                iWarehouseID: iInvTagValue, // iWarehouseID,
                iSpecificVendorID: iSpecificVendor,
                iPDRID: iPDRID,
                bEditedQuantity: bEditedQuantity
            }
            MRP_PROCESS.arrIssueToProduction.push(ProductionIssue);
        } catch (e) {
            alert("Exception: {MRP_PROCESS.FillIssueToProduction} " + e.message);
        }
    },

