    SetBOMTagWiseSequenceSettings: function (bSuccess, data) {
        //debugger;
        if (bSuccess && data != "") {
            PO_SERIES.ResetDocumentData(true);


            FGRIDCONTROL.deleteRows("Id_BomTagDetails_Grid", 1, FGRIDCONTROL.getTotalRows("Id_BomTagDetails_Grid"));
            FGRIDCONTROL.insertRows("Id_BomTagDetails_Grid", 1, data.length);
            var sGridId = "Id_BomTagDetails_Grid";
            var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridId);
            for (var i = 0; i < data.length; i++) {
                for (var j = 1; j <= iTotalColumns; j++) {
                    var cellobj = FGRIDCONTROL.getCellObject(sGridId, i + 1, j);
                    switch (j) {
                        case 1:
                            cellobj.setCellData(data[i].id);
                            cellobj.setCellText(data[i].id);
                            break;
                        case 2:
                            OPTIONCONTROL.setControlValue("FOption_BomTagName", data[i].iWareHouseId)
                            cellobj.setCellText(OPTIONCONTROL.getControlText("FOption_BomTagName"));
                            cellobj.setCellData("value", data[i].iWareHouseId);
                            break;
                        case 3:
                            cellobj.setCellData(data[i].iSequence);
                            cellobj.setCellText(data[i].iSequence);
                            break;
                        case 4:
                            FGRIDCONTROL.setColumnCheckboxState(sGridId, cellobj.iRow, cellobj.iColumn, data[i].bMandatory)
                            break;
                    }
                }
            }


        } else {
            PO_SERIES.ResetDocumentData(true);
        }
    },
