        }


        var allPOs = $("#Id_RaisedPOsList_div > div");
        for (var i = 0; i < allPOs.length; i++) {
            if ($(allPOs[i]).hasClass("mrpDonePO") == false && $(allPOs[i]).length > 0) {
                if ($(allPOs[i])[0].dataset.mrpdonestatus == 0) {
                    $(allPOs[i]).addClass("raisedPO-selected");
                    $(allPOs[i]).removeClass("theme_background-color theme_color").addClass("theme_background-color theme_color");
                    break;
                }
            }
        }

        var menuId = parseInt(document.getElementById("mrpType_MenuId").value);
