    /**
     * Return Success Data of Saving TC
     * @param {any} bSuccess
     * @param {any} data
     * @returns
     */
    Save_Success: function (bSuccess, data) {
        try {
            //debugger
            if (bSuccess && data != "") {
                if (data != undefined) {
                    if (data.sTransactionErrorMessage != "" && data.sTransactionErrorMessage != null) {
                        COMMON.prototype.showMessage(data.sTransactionErrorMessage, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                        if (confirm(data.sTransactionErrorMessage + "\n" + " Do you want to close Requition with out posting stock transfer ?")) {
                            TotalCheck.OnClick_Save(true);
                        }
                        else {
                            return false;
                        }
                    }
                    else if (data.sErrorMessage != "" && data.sErrorMessage != null) {
                        COMMON.prototype.showMessage(data.sErrorMessage, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                    }
                    else if (data.bReqSaved) {
                        COMMON.prototype.showMessage(TotalCheck.TotalCheckMsgs.msgDOASuccess, TotalCheck.TotalCheckMsgs.cmbTD_Total);
                        TotalCheck.OnClick_New();
                    }
                    else {
                        COMMON.prototype.showMessage(TotalCheck.TotalCheckMsgs.msgSavngFailed, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                        return false;
                    }
                }

            }
            else {
                COMMON.prototype.showMessage(TotalCheck.TotalCheckMsgs.msgSavngFailed, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                return false;
            }

        } catch (err) {
            COMMON.prototype.showMessage("{TotalCheck.Save_Success}" + err.message, TotalCheck.TotalCheckMsgs.QC_TD_msgException);
        }
    },
    /**
     * filling Grid Data
     * @param {any} data
     * @returns
     */
    FillGridDataFromList: function (data) {
        try {
            //debugger
            if (data != null) {
                dataFields = OPTIONCONTROL.getControlDataObject("FOption_RequisitionNo");
                var TestQuantity = parseInt(dataFields.dQtyAvailable);
                if (data.objQCTotalTestDefinitionHeader != null) {
                    var QuantityToTest = TestQuantity - (data.objQCTotalTestDefinitionHeader.dTestedQty);
                }

                var bPrefixRMA = false;
                if (TotalCheck.lstRMADataTemp.length > 0) {
                    bPrefixRMA = true;
                }

                var PrefixText = "";
                if (bPrefixRMA == false) {
                    var CheckBox = document.getElementById("PieceNoCheckBox").checked;
                    if (CheckBox == true) {
                        PrefixText = document.getElementById("txtPieceNoPrefix").value;
                    }
                }

                var lstTotalCheckBody = []
                var objQCSTotalCheckBody = {};
                var lstTotalCheckBodyValues = []
                var objQCSTotalCheckBodyValues = {};

                var iColumnNo = 0;
                var iRowNo = 0;
                var MinValue = 0;
                var MaxValue = 0;

                var TotalRows = QuantityToTest;
                var TotalColumns = 4 + (TotalCheck.NoOfParameters * 4);
                var PassCount = parseInt(document.getElementById("txtPopQtyPassed").value);
                //debugger
                for (var RowCount = 0; RowCount < TotalRows; RowCount++) {
                    iRowNo++;
                    var x = 0;
                    for (var colCount = 0; colCount < TotalColumns; colCount++) {
                        switch (colCount) {
                            case 1:
                                if (bPrefixRMA == true) {
                                    objQCSTotalCheckBody.sPieceNo = TotalCheck.lstRMADataTemp[RowCount].sRMANo
                                } else {
                                    objQCSTotalCheckBody.sPieceNo = PrefixText == "" ? (RowCount + 1) : (PrefixText + (RowCount + 1));
                                }
                                if (data.lstQCTotalTestBody != null && data.lstQCTotalTestBody.length > 0) {
                                    objQCSTotalCheckBody.iBodyId = data.lstQCTotalTestBody[RowCount].iBodyId;
                                }
                                break;
                            case (2 + (x * 4)):
                                objQCSTotalCheckBodyValues.iQCTestDefBodyId = TotalCheck.lstQCTestDefinitionBodyTemp[x].iQCTestDefBodyId;
                                break;
                            case (3 + (x * 4)):
                                MinValue = TotalCheck.lstQCTestDefinitionBodyTemp[x].sPassedFrom;
                                break;
                            case (4 + (x * 4)):
                                MaxValue = TotalCheck.lstQCTestDefinitionBodyTemp[x].sPassedTo;
                                break;
                            case (5 + (x * 4)):
                                var iType = TotalCheck.lstQCTestDefinitionBodyTemp[x].iResultType;
                                switch (iType) {
                                    case 0: //Text
                                        objQCSTotalCheckBodyValues.sValue = "";
                                        objQCSTotalCheckBodyValues.iResult = 1;
                                        break;
                                    case 1: //Interger
                                        if (PassCount != 0) {
                                            TotalCheck.PassedAndFailed[RowCount] = "Passed";
                                            objQCSTotalCheckBodyValues.sValue = parseInt(MaxValue);
                                            objQCSTotalCheckBodyValues.iResult = 1;
                                        } else {
                                            TotalCheck.PassedAndFailed[RowCount] = "Failed";
                                            objQCSTotalCheckBodyValues.sValue = parseInt(MinValue - 1);
                                            objQCSTotalCheckBodyValues.iResult = 0;
                                        }
                                        break;
                                    case 2: //Double
                                        if (PassCount != 0) {
                                            TotalCheck.PassedAndFailed[RowCount] = "Passed";
                                            objQCSTotalCheckBodyValues.sValue = parseFloat(MaxValue).toFixed(TotalCheck.NoOfDecimals);
                                            objQCSTotalCheckBodyValues.iResult = 1;
                                        } else {
                                            TotalCheck.PassedAndFailed[RowCount] = "Failed";
                                            objQCSTotalCheckBodyValues.sValue = parseFloat(MinValue - 1).toFixed(TotalCheck.NoOfDecimals);
                                            objQCSTotalCheckBodyValues.iResult = 0;
                                        }
                                        break;
                                    case 3: //Check Box
                                        if (PassCount != 0) {
                                            TotalCheck.PassedAndFailed[RowCount] = "Passed";
                                            objQCSTotalCheckBodyValues.iResult = 1;
                                            objQCSTotalCheckBodyValues.sValue = "true";
                                        } else {
                                            TotalCheck.PassedAndFailed[RowCount] = "Failed";
                                            objQCSTotalCheckBodyValues.iResult = 0;
                                            objQCSTotalCheckBodyValues.sValue = "false";
                                        }
                                        break;
                                    case 4: //Combo Box
                                        break;
                                    case 5: //Information
                                        break;
                                    default:
                                        break;
                                }

                                //objQCSTotalCheckBodyValues.sValue = 0;
                                //objQCSTotalCheckBodyValues.iResult = 1;

                                lstTotalCheckBodyValues.push(objQCSTotalCheckBodyValues);
                                objQCSTotalCheckBodyValues = {};

                                if (TotalCheck.NoOfParameters > x + 1) {
                                    x = x + 1;
                                }
                                break;

                            case (6 + (x * 4)):
                                if (PassCount != 0) {
                                    objQCSTotalCheckBody.iResult = 1;
                                } else {
                                    objQCSTotalCheckBody.iResult = 0;
                                }
                                break;
                            case (7 + (x * 4)):
                                objQCSTotalCheckBody.sRemarks = "";
                                break;
                            default:
                                break;
                        }
                    }

                    if (PassCount != 0) {
                        PassCount = PassCount - 1;
                    }

                    objQCSTotalCheckBody.lstQCSTotalCheckBodyValues = lstTotalCheckBodyValues;

                    lstTotalCheckBody.push(objQCSTotalCheckBody);
                    objQCSTotalCheckBody = {};

                    lstTotalCheckBodyValues = [];
                }
                TotalCheck.QCSTotalCheckBody = lstTotalCheckBody;
                return true;
            }
        } catch (err) {
            COMMON.prototype.showMessage("{TotalCheck.FillGridDataFromList}" + err.message, TotalCheck.TotalCheckMsgs.QC_TD_msgException);
        }
    },
