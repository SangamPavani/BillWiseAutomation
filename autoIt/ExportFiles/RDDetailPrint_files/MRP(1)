                                var iSkillId = R_WORKCENTER.objWorkCenter.arrSkillDef[i].iSkillType;
                                var iEmployeeId = R_WORKCENTER.objWorkCenter.arrSkillDef[i].iEmployeeId;
                                if (iSkillId > 0) {
                                    if (CurrentSkillId == iSkillId) {
                                        bExists = true;
                                        COMMON.prototype.showMessage("Already Exists.", "Routing");
                                        return false;
                                        break;
                                    }
                                }
                            }
                        }

                        if (bExists) {
                            cellobj.setCellData("value", 0);
                            cellobj.setCellText("");
                            R_WORKCENTER.objWorkCenter.arrSkillDef[cellobj.iRow - 1].iSkillType = 0;
                        }
                        else {
