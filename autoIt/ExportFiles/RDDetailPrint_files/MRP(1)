    /**
     * Quantity Split Validation on Integer data type
     * @param {any} num
     * @param {any} parts
     * @returns
     */
    splitInteger: function (num, parts) {
        try {
            //debugger
            var val;
            var mod = num % parts;
            if (mod == 0) {
                val = num / parts;
                retData = Array(parts).fill(val);
            } else {
                val = (num - mod) / parts;
                retData = Array(parts).fill(val);
                for (i = 0; i < mod; i++) {
                    retData[i] = retData[i] + 1;
                }
                retData.reverse()
            }

            return retData;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {SAMPLECHECK.splitInteger} " + err.message, SAMPLECHECK.SAMPLECHECKMsgs.QC_TD_msgException);
        }
    },
    /**
     *  Quantity Split Validation on Decimal data type
     * @param {any} num
     * @param {any} parts
     * @returns
     */
    splitDecimal: function (num, parts) {
        try {
            var iValue = parseFloat(num / parts).toFixed(SAMPLECHECK.DecimalInQuantity);
            var retData = Array(parts).fill(parseFloat(iValue));
            var sum = parseFloat(retData.reduce((a, b) => a + b, 0)).toFixed(SAMPLECHECK.DecimalInQuantity);
            if (parseFloat(sum) < num) {
                let diff = parseFloat(num - parseFloat(sum)).toFixed(SAMPLECHECK.DecimalInQuantity);
                sVal = parseFloat(retData[retData.length - 1] + parseFloat(diff)).toFixed(SAMPLECHECK.DecimalInQuantity);
                retData[retData.length - 1] = parseFloat(sVal);
                retData.reverse();
            } else if (parseFloat(sum) > num) {
                let diff = parseFloat(parseFloat(sum) - num).toFixed(SAMPLECHECK.DecimalInQuantity);
                let sVal = parseFloat(retData[retData.length - 1] - parseFloat(diff)).toFixed(SAMPLECHECK.DecimalInQuantity);
                retData[retData.length - 1] = parseFloat(sVal);
                retData.reverse();
            }

            return retData;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {SAMPLECHECK.splitDecimal} " + err.message, SAMPLECHECK.SAMPLECHECKMsgs.QC_TD_msgException);
        }
    },
