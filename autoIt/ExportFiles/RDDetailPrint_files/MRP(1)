                            cellobj.setCellText(data.sName);
                            R_WORKCENTER.objWorkCenter.arrSkillDef[cellobj.iRow - 1].iSkillType = data.iMasterId;
                        }

                        if (cellobj.iRow == FGRIDCONTROL.getTotalRows(GridID)) {
                            FGRIDCONTROL.insertRows(GridID, cellobj.iRow + 1, 1);
                            var objAllocateEmployeeAndSkills = {
                                iSkillType: 0,
                                iEmployeeId: 0
                            }
                            R_WORKCENTER.objWorkCenter.arrSkillDef.push(objAllocateEmployeeAndSkills);
                        }

                        break;
                    case "EmpName":
                        data = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);

                        cellobj.setCellData("value", parseInt(data.iMasterId));
                        cellobj.setCellText(data.sName);
                        break;

                    case "NoOfEmployees":
                        var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setCellText(parseInt(element.value.trim()));
                        cellobj.setCellData("value", parseInt(element.value.trim()));

                        break;

                    default:
                        cellobj.processDefault(event);
                        break;
                }

            }
            else {
                switch (cellobj.ColumnAttribute.ctrlatt.trim()) {

                    case "SkillType":
                        cellobj.setCellText("");
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
