                                previousValue = previousValue == '' ? dQtyToreceive : previousValue;
                                cellobj.setCellText(parseFloat(previousValue).toFixed(RF_PRODUCTION.dNoOfDecimals));
                                cellobj.setCellData("value", parseFloat(previousValue));
