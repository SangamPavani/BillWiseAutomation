    // Grid Cell change method for (not in use)
    onProductDetailsChange: function (objCell, event) {
        //
        if (objCell.iColumn != 1 && objCell.iColumn != 0 && MRP_PROCESS.MRPDocData != null) {
            if (objCell.bLeave == false) {   /// onCell Enter event
                var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                objCell.setControl(element, objCell.getCellData("value"));
            }
            else { /// onCell Leave event
                var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                if (objCell.iColumn == 4 || objCell.iColumn == 7) {
                    //
                    objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                    objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                }
                else if (objCell.iColumn == 2 || objCell.iColumn == 12) {
                    objCell.setCellText($(element).find("option:selected").text().trim());
                    objCell.setCellData("value", element.value);
                }
                else if (objCell.iColumn == 5 || objCell.iColumn == 6) {
                    objCell.setCellText(DATEPICKER.getText(objCell.ColumnAttribute.ctrlid));
                    objCell.setCellData("value", DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid));
                }
                else if (objCell.iColumn == 8 || objCell.iColumn == 9 || objCell.iColumn == 10 || objCell.iColumn == 11 || objCell.iColumn == 13) {
                    objCell.setCellText(parseFloat(element.value.trim()).toFixed(MRP_PROCESS.iDecimalInQuantity));
                    objCell.setCellData("value", parseFloat(element.value.trim()).toFixed(MRP_PROCESS.iDecimalInQuantity));
                }
                else {
                    objCell.setCellText(element.value.trim());
                    objCell.setCellData("value", element.value.trim());
                }
                return (true);
            }
        }
        else {
            objCell.processDefault();
            return (true);
        }
    },

