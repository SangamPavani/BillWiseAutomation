    //Load Data To Grid.
    LoadBomDetails_onSuccess: function (bSuccess, data) {
        //debugger
        if (bSuccess && data != "") {
            if (data != null) {
                var sGridId = "Id_ChangeBom_Grid";
                FGRIDCONTROL.clearData(sGridId, true);
                var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
                var bBOMLatestVersion = document.getElementById("Chk_BOMLatestVersion").checked ? true : false;
                let lstFinalBOM = [];
                if (data.length > 0) {
                    if (bBOMLatestVersion) {
                        CHANGEBOM.lstBOMData = data;
                        for (var r = 0; r < data.length; r++) {
                            var lstSortedBOM = [];
                            for (var s = 0; s < CHANGEBOM.lstBOMData.length; s++) {
                                if (data[r].BOMCode == CHANGEBOM.lstBOMData[s].BOMCode) {
                                    if (lstSortedBOM.length > 0) {
                                        var objBCodeChk = lstSortedBOM.find(m => m.VariantId == CHANGEBOM.lstBOMData[s].VariantId);
                                        if (objBCodeChk == undefined) {
                                            lstSortedBOM.push(CHANGEBOM.lstBOMData[s]);
                                        }
                                    }
                                    else {
                                        lstSortedBOM.push(CHANGEBOM.lstBOMData[s]);
                                    }
                                }
                                if (s == CHANGEBOM.lstBOMData.length - 1) {
                                    if (lstSortedBOM.length > 0) {
                                        let maxValue = 0;
                                        const values = Object.values(lstSortedBOM);
                                        values.map((el) => {
                                            const valuesFromObject = el.iVersion;
                                            maxValue = Math.max(maxValue, valuesFromObject)
                                        });
                                        let iVersion = maxValue;
                                        var lastestVariantdata = lstSortedBOM.find(p => p.iVersion == iVersion);
                                        if (lstFinalBOM.length > 0) {
                                            var objckhVersion = lstFinalBOM.find(q => q.BOMCode == lastestVariantdata.BOMCode);
                                            if (objckhVersion == undefined) {
                                                lstFinalBOM.push(lastestVariantdata);
                                            }
                                        }
                                        else {
                                            lstFinalBOM.push(lastestVariantdata);
                                        }
                                    }
                                }
                            }
                        }
                        data = lstFinalBOM;
                    }
                }
                if (totalRows < data.length) {
                    FGRIDCONTROL.insertRows(sGridId, totalRows, (data.length - totalRows));
                }
                else if (data.length < totalRows) {
                    FGRIDCONTROL.deleteRows(sGridId, (data.length + 1), totalRows);
                }
                var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridId);
                //debugger;
                for (var i = 0; i < data.length; i++) {
                    for (var j = 1; j <= iTotalColumns; j++) {
                        var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), j);
                        switch (j) {
                            case 2:
                                cell.setCellData("value", data[i].VariantId);
                                break;
                            case 3:
                                cell.setCellData("value", data[i].BomId);
                                break;
                            case 4:
                                cell.setCellData("value", data[i].BomItemId);
                                break;
                            case 5:
                                cell.setCellData("value", data[i].ProductId);

                                break;
                            case 6:
                                cell.setCellText(data[i].BOMName);
                                cell.setCellData("value", data[i].BOMName);
                                break;
                            case 7:
                                //cell.setCellText(data[i].FromQty);
                                cell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].FromQty, CHANGEBOM.NoOfDecimals)));
                                cell.setCellData("value", data[i].FromQty);
