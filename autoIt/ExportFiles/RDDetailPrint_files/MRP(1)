                //}
                document.getElementById("txtProductionSizeJWR").value = parseFloat(dMaxProductionCanBeReceipt).toFixed(RECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity);
                document.getElementById("txtProductionSizeJWR").setAttribute("ProductionSizeJWR", parseFloat(dMaxProductionCanBeReceipt).toFixed(RECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity));
