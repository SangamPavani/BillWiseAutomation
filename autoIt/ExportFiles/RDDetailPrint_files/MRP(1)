                    document.getElementById("btnPlanningGetStock_MRPProcess").style.display = "inline-block";
                }
                //
                //debugger
                MRP_PROCESS.DisplayExplodedBOM(nextPO);
                if (menuId == 3020 && QUICKMRP.bfromQuickMRP) {
                    if (!QUICKMRP.bApplyFilter) {
                        QUICKMRP.ProcessManulforNextOrderWithNoFilter();
                    }
                }
            }
            else {
                if (MRP_PROCESS.IsMRP2Enabled() == true)
                    MRP_PROCESS.SelectTab($("#MrpProcessTabs li:eq(4)"));
                else
                    MRP_PROCESS.SelectTab($("#MrpProcessTabs li:eq(3)"));
                MRP_PROCESS.SetCurrentTab(5);
                var nextPO = $("#Id_RaisedPOsList_div .raisedPO-selected")[0];
                if ($(nextPO).hasClass("mrpDonePO") == false && $(nextPO).length > 0) {
                    if ($(nextPO)[0].dataset.mrpdonestatus == 0) {
                        $("#Id_RaisedPOsList_div div").removeClass("raisedPO-selected");
                        $(nextPO).addClass("raisedPO-selected");
                        $(nextPO).removeClass("theme_background-color theme_color").addClass("theme_background-color theme_color");
