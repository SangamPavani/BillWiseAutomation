    RecursiveGroupParameterFilter: function (data, iMasterid, iLevel) {
        //debugger
        try {
            var iMinLevel = parseInt(iLevel) + parseInt(1);
            var arrTempLevelData = [];
            for (var i = 0; i < data.length; i++) {
                var objParameter = data[i].split(",");
                if (parseInt(iMinLevel) == parseInt(objParameter[objParameter.length - 1])) {
                    arrTempLevelData.push(data[i]);
                    data.splice(i, 1);
                    i--;
                }
            }
            arrTempLevelData = TESTDEFINITION.SortingGroupData(arrTempLevelData);
            for (var k = 0; k < arrTempLevelData.length; k++) {
                var obj = arrTempLevelData[k].split(",");
                if (obj[obj.length - 4] == "False" || obj[obj.length - 4] == "false") {
                    TESTDEFINITION.arrFinalGroupData.push(arrTempLevelData[k]);
                    arrTempLevelData.splice(k, 1);
                    k--;
                }
                else {
                    TESTDEFINITION.RecursiveGroupParameterFilter(data, obj[0], obj[obj.length - 1]);
                }

            }
        } catch (e) {
            COMMON.prototype.showMessage("Exception: TESTDEFINITION.RecursiveGroupParameterFilter"+ e.message, TESTDEFINITION.TESTDEFINITIONMsgs.lblErrorMsg);
        }

    },
    // Sorting QC Parameter Group Data
    SortingGroupData:function(data){
        try {
            //debugger
            for (var p = 0; p < data.length; p++) {
                var objtemp = {};
                objtemp = data[p].split(",");
                var iSeq = parseInt(objtemp[objtemp.length - 2]);
                for (q = p + 1; q < data.length; q++) {
                    var objtemp1 = data[q].split(",");
                    var iSeq1 = parseInt(objtemp1[objtemp1.length - 2]);
                    if (iSeq > iSeq1) {
                        var a = data[p];
                        data[p] = data[q];
                        data[q] = a;
                        iSeq = iSeq1;
                    }
                }
            }
            return data;
        } catch (e) {
            COMMON.prototype.showMessage("Exception: TESTDEFINITION.RecursiveGroupParameterFilter" + e.message, TESTDEFINITION.TESTDEFINITIONMsgs.lblErrorMsg);
        }
