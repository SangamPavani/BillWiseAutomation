    // Check if Multiple product is selected for Process from Lots-Breakup and Go to Lot-Breakup tab if remaining
    CheckAndProcessForNextLots: function () {
        try {
            var allLotsProduct = $("#ul_LotsBreakup_ProductTree_MRPProcess > li");
            for (var i = 0; i < allLotsProduct.length; i++) {
                if ($(allLotsProduct[i]).hasClass("OrderRaisedForProduct") == false && $(allLotsProduct[i]).length > 0) {
                    $(allLotsProduct[i]).addClass("OrderRaisePending");
                    break;
                }
            }
            if ($("#ul_LotsBreakup_ProductTree_MRPProcess .OrderRaisePending").length > 0) {
                MRP_PROCESS.RaisePOIndex = 0;
                MRP_PROCESS.hasRemainingLotsToRaise = true;
                MRP_PROCESS.SetCurrentTab(2);
                MRP_PROCESS.ProcessToNextTab(2);
                var nextLot = $("#ul_LotsBreakup_ProductTree_MRPProcess .OrderRaisePending")[0];
                if (MRP_PROCESS.IsValidObject(nextLot.children[0].children[1]) == true) {
                    nextLot.children[0].children[1].click();
                }
                return true;
            }
            else {
                return false;
            }

        } catch (e) {
            alert("Exception: {MRP_PROCESS.CheckAndProcessForNextLots} " + e.message);
            return false;
        }
    },
