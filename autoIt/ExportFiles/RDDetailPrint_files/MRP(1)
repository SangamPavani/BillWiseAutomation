    // Attach product to Test grid cell change handler
    onAttachingProductGridCellChange: function (cellobj, event) {
        try {
            //debugger;
            var GridID = "Id_AttachingProdDetail_Grid";
            if (cellobj.bLeave == true) {     // On Leave Event
                switch (cellobj.iColumn) {
                    case 2:
                        if (parseInt(OPTIONCONTROL.getControlValue("FOption_TestName_MTP")) > 0) {
                            var productId = parseInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));
                            var bExisting = false;
                            bExisting = MAPTEST_PRODUCT.IsProductExists(MAPTEST_PRODUCT.arrExistingProduct, productId);
                            var rowCount = FGRIDCONTROL.getTotalRows(GridID);
                            for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                                if (iRowIndex != cellobj.iRow) {
                                    var cell = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 2);
                                    var cellValue = cell.getCellData("value");
                                    if (cellValue != "" && cellValue != undefined) {
                                        if (parseInt(cellValue) == productId) {
                                            bExisting = true;
                                            break;
                                        }
                                    }
                                }
                            }
                            if (!bExisting && productId > 0) {
                                cellobj.setCellData("value", productId);
                                cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                                FGRIDCONTROL.setColumnCheckboxState(GridID, cellobj.iRow, 1, true);
                            }
                            else {
                                COMMON.prototype.showMessage(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid) + " Product Already Exist For Test", MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.lblErrorMsg);
                            }
                        }
                        break;
                    case 1:
                    case 3:
                        cellobj.processDefault();
                        break;
                }
            }
            else {
                if (cellobj.iColumn == 2) {
                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    cellobj.setControl(element, cellobj.getCellData("value"));
                }
                else
                    cellobj.processDefault();
            }
            return (true);
        }
        catch (e) {
            alert("Exception: MAPTEST_PRODUCT.onAttachingProductGridCellChange " + e.message);
        }
    },

