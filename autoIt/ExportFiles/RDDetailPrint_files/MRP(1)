                        //    }
                        //}
                        //OPTIONCONTROL.setFilter("FOption_Grid_TestName_Req", sFilter);
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setControl(element, cellobj.getCellData("value"));
                        break;
                    case 3:
                    case 4:
                    case 5:
                        cellobj.processDefault(event);
                        break;
                    case 6:
                        Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 2)
                        if (Rowcell.getCellData("value") != "" && Rowcell.getCellData("value") != undefined && document.getElementById("ReqHeaderId").value == 0) {
                            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setControl(element, cellobj.getCellData("value"));
                        }
                        break;
                    case 7:
