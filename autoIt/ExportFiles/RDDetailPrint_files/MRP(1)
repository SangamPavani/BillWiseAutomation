                    if (arrT == false)
                        return false;
                    if (arrT.length > 0)
                        arrTags.push(arrT[0]);
                } else if (arrRowData[j].MetaData.ctrltype == "ExtraField") {
                    //debugger;
                    var arr = ERF_PRODUCTION.GetBodyExtraFieldsData(arrRowData[j]);
                    if (arr == false)
                        return false;
                    if (arr.length > 0)
                        arrExtra.push(arr[0]);
                }
                else {
                    if (arrRowData[j].MetaData.ctrlatt == "ProductionOrder") {
                        if (arrRowData[j].Value == "") {
                            var iProdOrderId = OPTIONCONTROL.getControlValue("FOption_ProductionOrder");
                            if (iProdOrderId == 0 || iProdOrderId == null) {
                                //ERF_PRODUCTION.sError = "Select Production Order.";
                                ERF_PRODUCTION.sError = ERF_PRODUCTION.ERF_PRODUCTIONMsgs.MRP_IP_msgSelectProductionOrder;
                                return false;
                            } else {
                                arrRowData[j].Value = iProdOrderId;
                            }
                        }
                        OBJPPPW.iProdPrderId = parseInt(arrRowData[j].Value);
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "ProcessName") {
                        //if (arrRowData[j].Value == "") {
                        //    ERF_PRODUCTION.sError = "Select Process Name.";
                        //    return false;
                        //}
                        var Prodata = OPTIONCONTROL.getControlDataObject("FOption_ProcessName");
                        if (Prodata.iMasterId == "" || Prodata.iMasterId == 0) {                        
                            //ERF_PRODUCTION.sError = "Select Process Name.";
                            ERF_PRODUCTION.sError = ERF_PRODUCTION.ERF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + ERF_PRODUCTION.ERF_PRODUCTIONMsgs.ProcessName;
                            return false;
                        }
                        // //debugger;                       
                        OBJPPPW.iProcessId = ERF_PRODUCTION.iNodeProcessId;                        
                        OBJPPPW.iExistOutPut = 0;
                        if (ERF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs != null && ERF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs.length > 0) {
                            for (var i = 0; i < ERF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs.length; i++) {
                                if (ERF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs[i].ID == ERF_PRODUCTION.iNodeProcessId) {
                                    OBJPPPW.iExistOutPut = 1;
                                }
                            }
                        }
                        OBJPPPW.iProcessMasterId = Prodata.iMasterId;                       
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "ProductName") {
                        if (arrRowData[j].Value == "") {
                            //ERF_PRODUCTION.sError = "Select Product Name.";
                            ERF_PRODUCTION.sError = ERF_PRODUCTION.ERF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + ERF_PRODUCTION.ERF_PRODUCTIONMsgs.MRPProductName;
