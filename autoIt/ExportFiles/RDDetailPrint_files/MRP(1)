    // Insert/ delete Grid rows based on length of data
    ClearGridRowData: function (sGridId, iNoOfRows) {
        try {
            FGRIDCONTROL.clearData(sGridId);
            var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
            if (totalRows < iNoOfRows) {
                FGRIDCONTROL.insertRows(sGridId, totalRows, (iNoOfRows - totalRows));
            }
            else if (iNoOfRows < totalRows) {
                FGRIDCONTROL.deleteRows(sGridId, (iNoOfRows + 1), totalRows);
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("Exception {TESTDEFINITION.ClearGridRowData} : ", e.message);
        }
    },

    // checking of already saved Test Definition if changed after load details
    IsUpdatedTestDefinition: function () {
         try {
            if (TESTDEFINITION.objTestDefinitionData != null) {
                if (TESTDEFINITION.objTestDefinitionData.TestDefHeaderId > 0) {
                    if (TESTDEFINITION.objTestDefinitionData.Date != DATEPICKER.getDate("fDatePicker_DocDate")) {
                        return true;
                    }
                    if (TESTDEFINITION.objTestDefinitionData.TestName != document.getElementById("txtTestName_TD").value.trim()) {
                        return true;
                    }
                    if (TESTDEFINITION.objTestDefinitionData.TestType != $("#ddlTestType_TD").val()) {
                        return true;
                    }
                    if (TESTDEFINITION.objTestDefinitionData.SampleSize != parseFloat(document.getElementById("txtSampleSize_TD").value.trim())) {
                        return true;
                    }
                    var isChanged = false;
                    var rowCount = FGRIDCONTROL.getTotalRows("Id_TestDefinitionDetail_Grid");
                    for (var iRowIndex = 1; iRowIndex < rowCount; iRowIndex++) {
                        var gridRowData = FGRIDCONTROL.getRowValue("Id_TestDefinitionDetail_Grid", iRowIndex);
                        if (gridRowData[1].Value != "" && gridRowData[1].Text && gridRowData[4].Value != "" && gridRowData[4].Text != "" && gridRowData[5].Value != "" && gridRowData[5].Text != "" && gridRowData[6].Value != "" && gridRowData[6].Text != "") {
                            if (gridRowData[1].Value != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].ParameterId) {
                                isChanged = true;
                                break;
                            }
                            if (gridRowData[4].Value != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].PassedFrom ||
                                gridRowData[4].Text != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].PassedFrom) {
                                isChanged = true;
                                break;
                            }
                            if (gridRowData[5].Value != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].PassedTo ||
                                gridRowData[5].Text != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].PassedTo) {
                                isChanged = true;
                                break;
                            }
                            if (gridRowData[6].Value != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].Tolerance ||
                                gridRowData[6].Text != TESTDEFINITION.objTestDefinitionData.lstBobyDetails[iRowIndex - 1].Tolerance) {
                                isChanged = true;
                                break;
                            }
                        }
                    }
                    if (isChanged == true) {
                        return true
                    }
                }
            }
            return false;
        } catch (e) {
            alert("Exception: TESTDEFINITION.IsUpdatedTestDefinition " + e.message);
            return false;
        }
    },

