    ValidateData: function (m_objRoutingData) {
        //debugger
        try {
            var strError = "";
            //
            var iRouintg = OPTIONCONTROL.getControlValue("id_Code");
            if (!R_WORKCENTER.IsValidNumber(iRouintg)) {
                //strError = false + ";" + "Enter Rouitng Code.";
                strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgEnterRoutingCode;
                return strError
            }
            if (m_objRoutingData.iValidFrom > m_objRoutingData.iValidTo) {
                strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_RR_msgFromDateShoulbBeLessThanToDate;
                return strError
            }
            //m_objRoutingData.iValidFrom = DATEPICKER.getDate("id_date_validfrom");
            //m_objRoutingData.iValidTo = DATEPICKER.getDate("id_date_validto");

            var m_bBomAlreadyUsedAndIsDefault = m_objRoutingData.arrBomProduct[0].bBomAlreadyUsedInRouting;
            var m_bRoutingAlreadyExistsWithMainOutputProduct = m_objRoutingData.arrBomProduct[0].bRoutingWithMainOutputAlreadyExists;
            var iOutPutProduct = 0;
            for (var i = 0; i < m_objRoutingData.arrBomProduct.length; i++) {
                if (m_objRoutingData.arrBomProduct[i].iInput == 1) {
                    var iProductId = m_objRoutingData.arrBomProduct[i].iProductId;
                    var Qty = 0;
                    for (var j = 0; j < m_objRoutingData.arrRoutingNodes.length; j++) {
                        for (var k = 0; k < m_objRoutingData.arrRoutingNodes[j].arrRoutingBOMProduct.length; k++) {
                            var Obj = m_objRoutingData.arrRoutingNodes[j].arrRoutingBOMProduct[k];
                            if (Obj.iProductId == iProductId) {
                                Qty += Obj.dQuantity;
                            }
                        }
                    }
                    if (m_objRoutingData.arrBomProduct[i].dQuantity != Qty) {
                        //FMessageBox.Show("Enter Full Quantity", "Routing", MessageBoxButton.OK, MessageBoxImage.Information);
                        //strError = false + ";" + "Duplicate items are defined in Input.";
                        strError = false + ";" + "Select all the Inputs in Nodes.";
                        //strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgEnterFullQuantity;
                        //strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgSelectAllTheInputsInNodes;
                        return strError;   //vijay
                    }
                }
                else {
                    if (m_objRoutingData.arrBomProduct[i].bMainProduct == true) {
                        iOutPutProduct = m_objRoutingData.arrBomProduct[i].iProductId;
                    }
                }
            }
            //debugger
            m_objRoutingData.bSetAsDefault = m_objRoutingData.bSetAsDefault == 0 ? true : false;
            if (m_bBomAlreadyUsedAndIsDefault && m_objRoutingData.bSetAsDefault == true) {
                //if (confirm("Routing with this bom already exists and set as default, do you want to save this routing as defualt")) {
                if (confirm(ROUTING.ROUTINGMsgs.MRP_R_msgRoutingWithThisBOMalreadyExists)) {
                    m_objRoutingData.arrBomProduct[0].bBomAlreadyUsedInRouting = false;
                    ROUTING.bConfirmCount = ROUTING.bConfirmCount + 1;
                    m_objRoutingData.bSetAsDefault = true;
                    ROUTING.bCheckDFSave = true;
                }
                else {
                    m_objRoutingData.arrBomProduct[0].bBomAlreadyUsedInRouting = m_bBomAlreadyUsedAndIsDefault;
                    m_objRoutingData.bSetAsDefault = false;
                    ROUTING.bCheckDFSave = true;
                }

            }
            else {
                m_objRoutingData.arrBomProduct[0].bBomAlreadyUsedInRouting = false;
                m_objRoutingData.bSetAsDefault = false;
            }




            //if (m_bRoutingAlreadyExistsWithMainOutputProduct && m_objRoutingData.bSetAsDefault == false) {
            //    //if (!confirm("Routing with this bom's Main output Product already exists and set as default, do you want to save this routing as defualt")) {
            //    if (!confirm(ROUTING.ROUTINGMsgs.MRP_R_msgRoutingWithThisBOMmainOutputProductExists)) {
            //        m_objRoutingData.arrBomProduct[0].bRoutingWithMainOutputAlreadyExists = false;
            //    }
            //    else {
            //        m_objRoutingData.arrBomProduct[0].bRoutingWithMainOutputAlreadyExists = m_bRoutingAlreadyExistsWithMainOutputProduct;
            //    }
            //} else {
            //    m_objRoutingData.arrBomProduct[0].bRoutingWithMainOutputAlreadyExists = false;
            //    if (m_objRoutingData.bSetAsDefault == 0) {
            //        //if (confirm("Do you want to Consider this Routing as Default for the BOM?"))
            //        if (confirm(ROUTING.ROUTINGMsgs.MRP_R_msgDoYouWantToConsiderThisRoutingAsDefault))
            //            m_objRoutingData.bSetAsDefault = 1;
            //    }
            //}



            //gap
            var iLastNode = 0;            
            //checking all inputs are checked or not in nodes for a routing
            if (m_objRoutingData.arrRoutingNodes != null && m_objRoutingData.arrRoutingNodes.length > 0) {
                //Global.Preference.AllowUserToSelectEitherAlternateOrMainProductInRoutingNode)//Added for removing of this validation
                var bExistInFrom = false, bLinked = false, bCircularloop = false;
                if (m_objRoutingData.arrRoutingNodes.length > 1) {
                    for (var i = 0; i < m_objRoutingData.arrRoutingPath.length; i++) {
                        bExistInFrom = false;
                        for (var j = 0; j < m_objRoutingData.arrRoutingPath.length; j++) {
                            if (m_objRoutingData.arrRoutingPath[j].iFrom == m_objRoutingData.arrRoutingPath[i].iTo) {
                                bExistInFrom = true;
                                break;
                            }
                        }
                        if (!bExistInFrom) {
                            iLastNode = m_objRoutingData.arrRoutingPath[i].iTo;
                        }
                    }
                    //debugger
                    for (var i = 0; i < m_objRoutingData.arrRoutingNodes.length; i++) {
                        bLinked = false;
                        for (var j = 0; j < m_objRoutingData.arrRoutingPath.length; j++) {
                            if (m_objRoutingData.arrRoutingPath[j].iFrom == m_objRoutingData.arrRoutingNodes[i].iNodeSeq ||
                                m_objRoutingData.arrRoutingPath[j].iTo == m_objRoutingData.arrRoutingNodes[i].iNodeSeq) {
                                bLinked = true;
                                break;
                            }
                        }
                        if (!bLinked)
                            break;

                    }
                    for (var i = 0; i < m_objRoutingData.arrRoutingPath.length; i++) {
                        bCircularloop = false;
                        for (var j = i; j < m_objRoutingData.arrRoutingPath.length; j++) {
                            if (m_objRoutingData.arrRoutingPath[j].iTo == m_objRoutingData.arrRoutingPath[i].iFrom) {
                                bCircularloop = true;
                                break;
                            }
                        }
                        if (bCircularloop)
                            break;
                    }
                    if (bCircularloop) {
                    }
                }
                else {
                    bLinked = true;
                    iLastNode = m_objRoutingData.arrRoutingNodes[0].iNodeSeq;
                }
                if (bCircularloop) {
                    //FMessageBox.Show("WARNING:: you cannot have Circular loop in Routing Definitation", "Routing", MessageBoxButton.OK, MessageBoxImage.Warning);
                    //strError = false + ";" + "you cannot have Circular loop in Routing Definitation.";
                    strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgYouCannotHaveCircularLoopInRoutingDefinitation;
                    return strError
                }
                if (!bLinked) {
                    //FMessageBox.Show("All the Nodes should be Linked in the Routing", "Routing", MessageBoxButton.OK, MessageBoxImage.Exclamation);
                    //strError = false + ";" + "All the Nodes should be Linked in the Routing.";
                    strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgAllNodesShouldBeLinkedInTheRouting;
                    return strError
                }

                //debugger
                var InputIds = [];
                var icount = 0;                
                for (var node = 0; node < m_objRoutingData.arrRoutingNodes.length; node++) {
                    for (var i = 0; i < m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct.length; i++) {
                        var id = m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct[i].iProductId;
                        if (InputIds.indexOf(id) == -1) {
                            InputIds.push(id);
                        }
                        if (m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct[i].iAlternateOf > 0)
                            icount++;
                    }
                }                
                var iAlternateCount = icount;
                //InputIds.Sort();
                var tempChkInputs = [], iWastageItem = [];
                for (var node = 0; node < m_objRoutingData.arrRoutingNodes.length; node++) {
                    //debugger
                    //BomProduct[] arrProducts = m_objRoutingData.BomProduct.Where(p => p.Input == 1).ToArray();
                    for (var i = 0; i < m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct.length; i++) {
                        if (m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct[i].bSelect == true) {
                            // if (m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct[i].Input == 1) {
                            var iProdId = m_objRoutingData.arrRoutingNodes[node].arrRoutingBOMProduct[i].iProductId;
                            if (tempChkInputs.indexOf(iProdId) == -1)
                                tempChkInputs.push(iProdId);
                            //}
                        }
                    }
                    for (var k = 0; k < m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput.length; k++) {
                        if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[k].iType == 1) { //Wastage = 1
                            var iProdid = m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[k].iProductId;
                            if (iWastageItem.indexOf(iProdid) == -1) {
                                iWastageItem.push(iProdid);
                            }
                        }
                    }
                }
                
                //tempChkInputs = tempChkInputs.Distinct().ToList();
                //tempChkInputs.Sort();
                //debugger;
                var newInputs = [];
                if (iWastageItem.length > 0) {
                    newInputs = InputIds.filter((e) => !iWastageItem.includes(e));
                    InputIds = newInputs;
                }
                var data = document.getElementById('id_rountingcontent').dataset;
                if ((!data.alternateormainproduct) || iAlternateCount == 0) {
                    if (InputIds.length > tempChkInputs.length) {
                        //debugger
                        //strError = false + ";" + " select all the Inputs in Nodes. ";                               
                        strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgSelectAllTheInputsInNodes;
                        return strError;
                    }
                }
                else {
                    if ((InputIds.length - iAlternateCount) > tempChkInputs.length) {
                        //strError = false + ";" + "Select all the Inputs ie Either alternate or Main Products in Nodes. ";                        
                        strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgSelectAllTheInputsEitherAlternativeOrMainProducts;
                        return strError;
                    }
                }

            }
            //debugger
            //debugger
            //iOutPutProduct = m_objRoutingData.arrRoutingNodes[parseInt(iLastNode].arrRoutingOutput[0].iProductId;
            var bInputData = false;
            var TotalQtyInput = false;
            var blastNodeOutputType = 0;
            var iLastNodeOutputProduct = 0;
            for (var i = 0; i < m_objRoutingData.arrRoutingNodes.length; i++) {
                if (m_objRoutingData.arrRoutingNodes[i].iNodeSeq == iLastNode) {
                    if (m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput.length > 0) {
                        for (var k = 0; k < m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput.length; k++) {
                            if (m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput[k].bMainProduct) {
                                iOutPutProduct = m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput[k].iProductId;

                                if (m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput[k].iType == 0) {
                                    iLastNodeOutputProduct++;
                                    blastNodeOutputType++;
                                }
                            }
                        }
                    }
                    for (var z = 0; z < m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct.length; z++) {
                        if (m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct[z].bSelect == true) {
                            bInputData = true;
                        }
                        //Valadation For in Last Node all input Should be selected till last Node...
                        //if (parseFloat(m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct[z].dActRemQuantity) > parseFloat(0)) {
                        else if (z == m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct.length - 1) {
                            if (m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct[z].bSelect == false) {
                                bInputData = true;
                            }
                        }
                        //}
                        //Checking Total Quantity USe
                        if (TotalQtyInput == false)
                            if (parseFloat(m_objRoutingData.arrRoutingNodes[i].arrRoutingBOMProduct[z].dActRemQuantity) != parseFloat(0)) {
                                TotalQtyInput = true;
                            }
                    }
                } else {
                    if (m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput.length > 0) {
                        for (var k = 0; k < m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput.length; k++) {
                            if (m_objRoutingData.arrRoutingNodes[i].arrRoutingOutput[k].iType == 0) {
                                iLastNodeOutputProduct++;
                            }
                        }
                    }
                }

            }
            //if (TotalQtyInput) {
            //    //strError = false + ";" + "Enter Full Quantity. ";
            //    strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgEnterFullQuantity;
            //    return strError;
            //}

            if (!bInputData) {
                //strError = false + ";" + "Select Inputs in Node. ";
                strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgSelectInputsInNode;
                return strError;
            }
            if (blastNodeOutputType == 0) {
                strError = false + ";" + "Last Node Output Product Should be Type Output.";
                return strError;
            }
            if (iLastNodeOutputProduct != 1) {
                strError = false + ";" + "Only One Output Product Type should Output.";
                return strError;
            }
            if (m_objRoutingData.iUsed > 0) {
                //if (confirm("Routing already used, do you want to save version ")) {
                if (confirm(ROUTING.ROUTINGMsgs.MRP_R_msgRoutingAlreadyUsed_DoYouWantToSaveVersion)) {
                    m_objRoutingData.iRoutingId = 0;
                    if ((m_objRoutingData.bSetAsDefault == 0 || m_objRoutingData.bSetAsDefault == false) && ROUTING.bCheckDFSave == false)
                        //if (confirm("Do you want this version to be set as default")) {
                        if (confirm(ROUTING.ROUTINGMsgs.MRP_R_msgDoYouWantThisVersionToSetAsDefault)) {
                            m_objRoutingData.bSetAsDefault = 1;                                     
                        }
                    ROUTING.bCheckDFSave = true;
                    // bool bResult = objProductionClient.SaveRouting(m_objRoutingData, Global.m_CompSettings.CompanyId);
                    if (false)//Rescheduling Wise
                    {
                        m_objRoutingData.iUsed = 1;
                        //objOutput = Conn.Connection.CallServeRequest(ServiceTypeMRP.MRP, AllMethods.SaveNewRoutingFromRescheduling, m_objRoutingData, iNewRoutingId, m_iPOId);
                        iNewRoutingId = objOutput.Message == "" ? 0 : Convert.ToInt32(objOutput.Message);

                    }
                    else {
                        var checkMainOutput = false;
                        //Added For Checking of Update Production Quantity
                        var iUpdateProductionQtyCount = 0;
                        if (m_objRoutingData.arrRoutingNodes != null && m_objRoutingData.arrRoutingNodes.length > 0) {
                            for (var node = 0; node < m_objRoutingData.arrRoutingNodes.length; node++) {
                                if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput.length > 0) {
                                    for (var i = 0; i < m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput.length; i++) {
                                        if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].bMainProduct == true) //checking if the last node has selected MainProduct
                                        {
                                            if (m_objRoutingData.arrRoutingNodes[node].iNodeSeq == iLastNode && m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].iProductId == iOutPutProduct) //checking for last node    
                                            {
                                                checkMainOutput = true;
                                            }

                                            if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].UpdateProductionQty == true) {
                                                iUpdateProductionQtyCount++;
                                                if (iUpdateProductionQtyCount > 1) {
                                                    //strError = false + ";" + "Can not update Production Quantity multiple Times..Select it at one node only";
                                                    strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgCannotUpdateProductionQuantityMultipleTimes;
                                                    return strError;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (checkMainOutput == false) {
                            //strError = false + ";" + "Select the BOM Main Output in Last Node. ";
                            //return strError;
                        }
                        else {
                            //return strError = true + ";" + "Success";
                            return strError = true + ";" + ROUTING.ROUTINGMsgs.rdoSuccess;
                        }

                    }
                }
                else {
                    //strError = false + ";" + "Routing Already Used. Create version";
                    strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgRoutingAlreadyUsed_CreateVersion;
                    return strError;;
                }
            }
            else {
                //Added for checking the MainOutput of BOM in Last Node
                if (m_objRoutingData.arrRoutingNodes != null && m_objRoutingData.arrRoutingNodes.length > 0) {
                    var checkMainOutput = false;
                    //Added For Checking of Update Production Quantity
                    var iUpdateProductionQtyCount = 0;
                    for (var node = 0; node < m_objRoutingData.arrRoutingNodes.length; node++) {
                        if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput.length > 0) {
                            for (var i = 0; i < m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput.length; i++) {
                                if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].bMainProduct == true) //checking if the last node has selected MainProduct
                                {
                                    if (m_objRoutingData.arrRoutingNodes[node].iNodeSeq == iLastNode && m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].iProductId == iOutPutProduct) //checking for last node    
                                    {
                                        checkMainOutput = true;
                                    }
                                    if (m_objRoutingData.arrRoutingNodes[node].arrRoutingOutput[i].UpdateProductionQty == true) {
                                        iUpdateProductionQtyCount++;
                                        if (iUpdateProductionQtyCount > 1) {
                                            //strError = false + ";" + "Can not update Production Quantity multiple Times..Select it at one node only";
                                            strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgCannotUpdateProductionQuantityMultipleTimes;
                                            return strError;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (checkMainOutput == false) {
                        //strError = false + ";" + "Select the BOM Main Output in Last Node. ";
                        strError = false + ";" + ROUTING.ROUTINGMsgs.MRP_R_msgSelectBomMainOutputInLastNode;
                        return strError;
                    }
                    if ((m_objRoutingData.bSetAsDefault == 0 || m_objRoutingData.bSetAsDefault == false) && ROUTING.bCheckDFSave == false) {
                        //if (confirm("Do you want this version to be set as default")) {
                        if (confirm(ROUTING.ROUTINGMsgs.MRP_R_msgDoYouWantThisVersionToSetAsDefault)) {
                            m_objRoutingData.bSetAsDefault = 1;                            
                        }
                        ROUTING.bCheckDFSave = true;
                    }
                }
            }

            //return strError = true + ";" + "Success";
            return strError = true + ";" + ROUTING.ROUTINGMsgs.rdoSuccess;

        } catch (e) {
            strError = false + ";" + "Exception: {ROUTING.ValidateData} " + e.message;
            return strError;
        }
    },

