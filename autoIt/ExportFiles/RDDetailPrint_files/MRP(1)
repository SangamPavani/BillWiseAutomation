    this.PostToSave = function (OBJMRP) {
        try {
            //debugger
            RF_PRODUCTION.ObjFinalMRP = {};
            OBJMRP.iVoucherDate = DATEPICKER.getDate('fDatePicker_VouchertDate');
            OBJMRP.iShiftId = RF_PRODUCTION.iShiftId;
            if (OBJMRP.RececiptsFromProductionData.length == 0) {
                COMMON.prototype.showMessage("Enter Quantity to Receive Value for Atleast one Row", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                return false;
            }
            var bMain = false;
            for (var i = 0; i < OBJMRP.RececiptsFromProductionData.length; i++) {
                if (OBJMRP.RececiptsFromProductionData[i].bMainProduct == true || OBJMRP.RececiptsFromProductionData[i].iOutPutType == 3) {
                    bMain = true;
                }
            } 
            if (bMain == false) {
                COMMON.prototype.showMessage("Enter Main Item " + RF_PRODUCTION.MainProductName + " Details", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                return false;
            }

            var bResult = RF_PRODUCTION.QuantityToReceiveValidation();

            var bCanClosePO = document.getElementById("RFProduction_Close").checked;

            if (bResult == true && bCanClosePO == true) {
                for (var i = 0; i < OBJMRP.RececiptsFromProductionData.length; i++) {
                    if (OBJMRP.RececiptsFromProductionData[i].bMainProduct == true || OBJMRP.RececiptsFromProductionData[i].iOutPutType == 3) {
                        OBJMRP.RececiptsFromProductionData[i].iStatus = 4;
                    }
                } 
            }
            if (bResult != false) {
                var bCheck = document.getElementById("RFProduction_Close").checked;
                var urlPath = GLOBAL.getContextPath("RFPSave", "ReceiptfromProduction", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, {
                    objRFPPostingDetails: OBJMRP, lstRFPProcessNodeInfo: RF_PRODUCTION.arrProcessData, bCloseRFProduction: bCheck,
                    lstAllocateEmployeeAndSkills: RF_PRODUCTION.lstAllocateEmployeeAndSkillsToSave
                },
                    "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                if (fnResult.lValue > 0 && fnResult.data != "") {
                    //debugger
                    $('.modal-backdrop').remove();
                    var iMenuId = document.getElementById('divEntryField_container_ISPO').dataset.imenuid;
                    RF_PRODUCTION.onNew_Click(iMenuId);
                    //COMMON.prototype.showMessage(fnResult.data, "Receipt From Production");
                    COMMON.prototype.showMessage(fnResult.data, RF_PRODUCTION.RF_PRODUCTIONMsgs.ReceiptFromProduction);
                } else {
                    //COMMON.prototype.showMessage("Error In Saving", "Error Message");
                    COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgSErrorInSaving, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                }
            }
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.onSave_Click} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.onSave_Click} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }
