        try {
            //debugger
            var iProductIds = [];
            var totalRows = FGRIDCONTROL.getTotalRows("Id_ProductDetails_FGrid");
            MRP_PROCESS.MRPSelectedProds = [];
            var hasCellData = false;
            for (var m = 0; m < totalRows; m++) {
                var cell = FGRIDCONTROL.getCellObject("Id_ProductDetails_FGrid", (m + 1), 2);
                var cell2 = FGRIDCONTROL.getCellObject("Id_ProductDetails_FGrid", (m + 1), 3);
                if (cell.getCheckboxState() == true) {
                    if (cell2.CellData.value != null && cell2.CellData.value != undefined) {
                        MRP_PROCESS.MRPSelectedProds.push(MRP_PROCESS.MRPDocData[m]);
                    }
                }
                if (cell2.CellData.value != null && cell2.CellData.value != undefined) {
                    hasCellData = true;
                }
            }
            if (MRP_PROCESS.MRPSelectedProds.length > 0) {
                for (var n = 0; n < MRP_PROCESS.MRPSelectedProds.length; n++) {
                    iProductIds.push(MRP_PROCESS.MRPSelectedProds[n].iProductID);
                }
            }
            else {
                //if (hasCellData) {                    
                COMMON.prototype.showMessage("Select Orders to Save Inventory Tags", MRP_PROCESS.MRP_PROCESSMsgs.QuickMRP);
                GLOBAL.LoadingEnd();
                return false;
                //}
            }
            var iInventoryTagIds = [];
            //if (MRP_PROCESS.bUsePreviousInvtagValuesForLoadingStocks) {
            if (document.getElementById("QuickInvListCheckBox") != null) {
                var InvListCheckBoxData = LISTCHECKBOX.getControlData("QuickInvListCheckBox");
                if (InvListCheckBoxData != null && InvListCheckBoxData.length > 0) {
                    for (var i = 0; i < InvListCheckBoxData.length; i++) {
                        var obj = {
                            ID: InvListCheckBoxData[i].ID,
                            Name: "",
                        }
                        iInventoryTagIds.push(obj);
                    }
                }
            }
            //}
            if (iInventoryTagIds != null && iInventoryTagIds.length > 0) {
                var urlPath = GLOBAL.getContextPath("QuickSaveMRPStockFilterInvtagsData", "MRPProcess", "MRP");
                fnResult = NETWORK.executeServerMethod(urlPath, true, { iProductIds: iProductIds, lstinvtagList: iInventoryTagIds }, "JSON", false);

