                            //CellObject.setCellData("value", data[i].sUnit);
                            break;
                        case 4:
                            //CellObject.setCellText(data[i].dTotalQuantity);
                            CellObject.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dTotalQuantity, 2)), data[i].dTotalQuantity);
                            CellObject.setCellData("value", data[i].dTotalQuantity);
                            break;

                        case 5:
                            if (iOption == 0)
                                OPTIONCONTROL.setControlValue(CellObject.ColumnAttribute.ctrlid, parseInt(data[i].iUnitId));
                            else if (iOption == 1)
                                OPTIONCONTROL.setControlValue(CellObject.ColumnAttribute.ctrlid, parseInt(data[i].iDefaultBaseUnit));
                            else if (iOption == 2)
                                OPTIONCONTROL.setControlValue(CellObject.ColumnAttribute.ctrlid, parseInt(data[i].iDefaultPurchaseUnit));
                            else
                                OPTIONCONTROL.setControlValue(CellObject.ColumnAttribute.ctrlid, parseInt(data[i].iDefaultSalesUnit));

                            CellObject.setCellText(OPTIONCONTROL.getControlText(CellObject.ColumnAttribute.ctrlid));
                            //CellObject.setCellText(data[i].sUnit);
                            //CellObject.setCellData("value", data[i].sUnit);
                            break;
                        case 6:
                            //CellObject.setCellText(data[i].dTotalQuantity);
                            CellObject.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dConvertedTotalQuantity, 2)), data[i].dConvertedTotalQuantity);
                            CellObject.setCellData("value", data[i].dConvertedTotalQuantity);
                            break;

                        case 7:
                            //CellObject.setCellText(data[i].dStockAvailability);
                            CellObject.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dStockAvailability, 2)), data[i].dStockAvailability);
                            CellObject.setCellData("value", data[i].dStockAvailability);
                            break;
                        case 8:
                            //CellObject.setCellText(data[i].PendingPurchaseOrderQty);
                            CellObject.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].PendingPurchaseOrderQty, 2)), data[i].PendingPurchaseOrderQty);
                            CellObject.setCellData("value", data[i].PendingPurchaseOrderQty);
                            break;
                        case 9:
                            CellObject.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dRemainingQty, 2)), dRemainingQty);
