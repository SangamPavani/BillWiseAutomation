    onSkillSetGridCellChange: function (cellobj, event) {
        try {
            //debugger;
            var GridID = "Id_SkillSetGrid_WorkCenter_Routing";
            var rowCount = FGRIDCONTROL.getTotalRows(GridID);
            if (R_WORKCENTER.objWorkCenter.arrSkillDef == undefined) {
                R_WORKCENTER.objWorkCenter.arrSkillDef = [];
            }

            if (R_WORKCENTER.objWorkCenter.arrSkillDef.length == 0) {
                //R_WORKCENTER.objWorkCenter.arrSkillDef = [];
                var objAllocateEmployeeAndSkills = {
                    iSkillType: 0,
                    iEmployeeId: 0,
                    iNoOfEmployees: 0,
                }
                R_WORKCENTER.objWorkCenter.arrSkillDef[0] = objAllocateEmployeeAndSkills;
            }

            if (cellobj.bLeave == true) {
                switch (cellobj.ColumnAttribute.ctrlatt.trim()) {
                    case "SkillType":
                        data = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);
                        if (data.iMasterId == "" && data.sName == "") {
                            COMMON.prototype.showMessage("Select Any Skill", "Error Message");
                            //return false;
                        }

                        var bExists = false;
                        var CurrentSkillId = data.iMasterId;
                        //var CurrentEmployeeId = R_WORKCENTER.objWorkCenter.arrSkillDef[cellobj.iRow - 1].iEmployeeId;
                        for (var i = 0; i < R_WORKCENTER.objWorkCenter.arrSkillDef.length; i++) {
