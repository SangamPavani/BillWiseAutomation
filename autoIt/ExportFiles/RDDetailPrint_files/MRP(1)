                        //While Stock Reservation for SFG
                        //Always Total Quantity is Passed Instead of Pending Quantity, So Commented
                        //(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dPendingQty > MRP_PROCESS.dRatioQuantity) ? MRP_PROCESS.dRatioQuantity : MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dPendingQty,
                        PenQuantity,
                        MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iScrapPercentage, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iProcureType,
                        MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iSpecificVendorID, iDocID, parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iParentID), MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].bEditedQuantity);
                    //
                    var OrderID = 0;
                    if (MRP_PROCESS.bFromDPR) {
                        MRP_PROCESS.arrIssueToProduction = [];
                    }
                    OrderID = MRP_PROCESS.SaveRaiseDependentRequirements(MRP_PROCESS.arrPurchaseOrder, MRP_PROCESS.arrStockReservation, MRP_PROCESS.arrIssueToProduction);

                    MRP_PROCESS.FillProductionOrderLinks(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].ParentOrderID, StockReserveQty, 0, OrderID, 0, false);
                    MRP_PROCESS.SaveMRPDataInProdOrderLinksTable(MRP_PROCESS.arrProductionOrderLinks);

