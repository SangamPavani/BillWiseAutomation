    this.SetBodyLayoutFieldValues = function (a, data, iRowNo) {
        try {
            //debugger
            if (a == false)
                return null;
            var sGridName = RF_PRODUCTION.GetGridId();
            //Default value for Layout Fields
            var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);

            //for (var i = 0; i < TotalRows; i++) {
            for (var j = 0; j < TotalColumns; j++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, iRowNo, j + 1);

                if (data != null && data.length > 0) {
                    for (var k = 0; k < data.length; k++) {
                        if (cellobj.ColumnAttribute.colid == data[k].sFieldName) {
                            var id = "FOption_" + data[k].sFieldName;
                            var Value = "", text = "";
                            var itype = parseInt(cellobj.ColumnAttribute.ctrltagvalue);
                            if (itype == 0 || itype == 6 || itype == 1) {
                                document.getElementById(id).value = data[k].Value;
                                Value = document.getElementById(id).value;
                                text = document.getElementById(id).value;
                            }
                            else if (itype == 8 || itype == 9) {
                                var ele = document.getElementById(id);
                                ele.value = data[k].Value;
                                text = ele.options[ele.selectedIndex].text;
                                Value = ele.value;
                            }
                            else if (itype == 4) {
                                DATEPICKER.setDate(id, data[k].Value, true);
                                Value = DATEPICKER.getDate(id);
                            }
                            else if (itype == 12 || itype == 14) {
                                OPTIONCONTROL.setControlValue(id, data[k].Value);
                                Value = OPTIONCONTROL.getControlValue(id.id)
                            }
                            else if (itype == 5) {
                                FTIMECONTROL.setTime(id, data[k].Value);
                                Value = FTIMECONTROL.getTime(id.id);
                            }
                            if (Value == "" || Value == null) {
                                if (itype == 0) {
                                    Value = "";
                                }
                                else {
                                    Value = 0;
                                }
                            }
                            cellobj.setCellData("value", Value);
                            if (text != "") {
                                cellobj.setCellText(text);
                            }
                            else {
                                cellobj.setCellText(Value);
                            }
                        }
                    }
                }
            }
            //}

        } catch (e) {
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.SetBatch} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }

