    sCellChangeHandlerAdjustPlanOrders: function (cellobj, event) {
        //debugger
        if (cellobj.bLeave == true) {
            if (cellobj.ColumnAttribute.ctrlatt == "QuantityToPlan") {
                //debugger;
                var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                var dAlternateQuantity = 0;
                var dQuantityToPlan = element.value;
                var iVarientId = MRPProductionOrderDetails.lstAdjustProducionOrder[cellobj.iRow - 1].iVaraintId;
                var iProductionOrderId = MRPProductionOrderDetails.lstAdjustProducionOrder[cellobj.iRow - 1].iProductionOrderId;
                var PendingQty = MRPProductionOrderDetails.lstAdjustProducionOrder[cellobj.iRow - 1].PendingPlanQty;

                var dMaxAllowedQty = 0;
                var Result = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetMaxAllowedQuantity", "CapacityPlanning", "MRP"),
                             true,
                            {
                                iProductionOrderId: iProductionOrderId, iVarientId: iVarientId
                            },
                             "JSON", false);
                if (Result.lValue > 0) {
                    dMaxAllowedQty = Result.data;
                }

                if (dMaxAllowedQty > 0) {
                    if (parseFloat(dQuantityToPlan) > dMaxAllowedQty) {
                        COMMON.prototype.showMessage("Quantity To Plan cannot be greater than " + dMaxAllowedQty + ".", "Manual Scheduling");
                        dQuantityToPlan = dMaxAllowedQty;
                    }
                }

                if (parseFloat(dQuantityToPlan) > PendingQty) {
                    COMMON.prototype.showMessage("Quantity To Plan cannot be greater than Pending Quantity", "Manual Scheduling");
                    dQuantityToPlan = PendingQty;
                }

                var Result = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetAlternateQty", "CapacityPlanning", "MRP"),
                     true,
                    {
                        dQuantity: dQuantityToPlan, iVarientId: iVarientId
                    },
                     "JSON", false);
                if (Result.lValue > 0) {
                    dAlternateQuantity = Result.data;
                }
                cellobj.setCellData("value", parseFloat(dQuantityToPlan));
                //cellobj.setCellText(parseFloat(dQuantityToPlan));
                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dQuantityToPlan, MRPProductionOrderDetails.iNoOfDecimalsinQunatity)));
                MRPProductionOrderDetails.lstAdjustProducionOrder[cellobj.iRow - 1].dQuantityToPlan = dQuantityToPlan;
                var AlternateQuantitycellobj = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, 9);
                //AlternateQuantitycellobj.setCellText(parseFloat(dAlternateQuantity));
                AlternateQuantitycellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dAlternateQuantity, MRPProductionOrderDetails.iNoOfDecimalsinQunatity)));
                AlternateQuantitycellobj.setCellData("value", parseFloat(dAlternateQuantity));
                MRPProductionOrderDetails.lstAdjustProducionOrder[cellobj.iRow - 1].dAlternateQuantityToPlan = dAlternateQuantity;
            }
        } else {
            if (cellobj.ColumnAttribute.ctrlatt == "QuantityToPlan") {
                cellobj.setCellText("");
                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                cellobj.setControl(element)
                var dValue = parseFloat(cellobj.getCellData("value"));
                element.value = dValue;
            }
        }
        return true;
    },

