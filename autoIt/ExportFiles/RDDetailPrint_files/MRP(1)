                                //if (arrRowData[j].Value == "") {
                                //    ERF_PRODUCTION.sError = "Select Bin.";
                                //    //ERF_PRODUCTION.sError = ERF_PRODUCTION.ERF_PRODUCTIONMsgs.msgAUEnterBatch;
                                //    return false;
                                //}
                            //}
                            OBJPPPW.arrBinsQuantity = arrRowData[j].Value;
                            OBJPPPW.bDoNotInputBin = 0;// ERF_PRODUCTION.arrRFItemData[iRow - 1].bDoNotInputBin;
