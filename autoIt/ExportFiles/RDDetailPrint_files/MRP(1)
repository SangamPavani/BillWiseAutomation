                        else if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.Master) {
                            cellobj.setCellData("value", OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                        }
                        else {
                            var objCellData = cellobj.CellData.value;
                            if (resultType == 3 && bFormulaCell == true) {
                                if (objCellData == undefined) {
                                    objCellData = chkData;
                                }
                                if (objCellData == "True" || objCellData == "true" || objCellData == true) {
                                    objCellData = "True";
                                } else if (objCellData == "False" || objCellData == "false" || objCellData == false) {
                                    objCellData = "False";
                                }
                                if (element.value == "True" || element.value == "true" || element.value == true) {
                                    element.value = "True";
                                } else if (element.value == "False" || element.value == "false" || element.value == false) {
                                    element.value = "False";
                                }
                            }
                            if (SAMPLECHECK.chkResultValueData == 0) {
                                if (resultType == 1 && bFormulaCell == true) {
                                    cellobj.setCellText(isNaN(parseInt(element.value)) ? 0 : parseInt(element.value), isNaN(parseInt(element.value)) ? 0 : parseInt(element.value));
                                }
                                else if (resultType == 2 && bFormulaCell == true) {
                                    cellobj.setCellText(isNaN(parseFloat(element.value)) ? 0 : parseFloat(element.value).toFixed(SAMPLECHECK.DecimalInQuantity), isNaN(parseFloat(element.value)) ? 0 : parseFloat(element.value).toFixed(SAMPLECHECK.DecimalInQuantity));
                                }
                                else {
                                    cellobj.setCellText(element.value, element.value);
                                }
                            }
                            else {
                                if (resultType == 1 && bFormulaCell == true) {
                                    cellobj.setCellText(isNaN(parseInt(objCellData)) ? 0 : parseInt(objCellData), isNaN(parseInt(objCellData)) ? 0 : parseInt(objCellData));
