                //Get Data In Grid  Data...
                iProductionOrderdataId = parseInt(GridRdata[1].Data.value);
                // iOrderStatus = parseInt(GridRdata[2].Data.value);
                PONO = GridRdata[2].Data.value;
                PO = GridRdata[1].Data.value;

            }
        }

        var urlPath = GLOBAL.getContextPath("GetProductionOrderStatus", "RaiseProductionOrders", "MRP");
        var ResultStatus = NETWORK.executeServerMethod(urlPath, true, { arrProductionOrders: [PO] }, "", false);
        OrderStatus = ResultStatus.data[0].ID;

