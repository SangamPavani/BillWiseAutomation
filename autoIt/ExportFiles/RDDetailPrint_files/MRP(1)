    this.Update_BOMRates = function () {
        //debugger
        var arrProduct = [];
        var vdata = MRP_Ribbon.objVarientDetails;
        var iVarientId = MRP_Ribbon.getVarientId;
        var GridId = "Bom_InputGrid_" + iVarientId;

        for (var i = 0; i < vdata.InputGridHeaderDetails.Data.length; i++) {
            var iProductId = vdata.InputGridHeaderDetails.Data[i][6];
            arrProduct.push(iProductId);
        }

        var url = GLOBAL.getContextPath("GetAverageRateForBOM", "BOM", "MRP");
        fnResult = NETWORK.executeServerMethod(url, true, {
            arrProductid: arrProduct
        }, "JSON", false);

        if (fnResult != null) {
            var iTotalRow = FGRIDCONTROL.getTotalRows(GridId);
            for (var j = 0; j < iTotalRow-1; j++) {
                var cellobj = FGRIDCONTROL.getCellObject(GridId, j + 1, 14)

                var fRate = fnResult.data[j].Tag;
                var iValue = parseFloat(fRate.toFixed(BOM_INPUTGRID.DecimalsInCurrency)) != 'NaN' ? parseFloat(fRate.toFixed(BOM_INPUTGRID.DecimalsInCurrency)) : '0.0000';

                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(iValue, BOM_INPUTGRID.DecimalsInCurrency)), FConvert.addNumericSeparator(FConvert.toDecimal(iValue, BOM_INPUTGRID.DecimalsInCurrency)));
                cellobj.setCellData("value", parseFloat(iValue).toFixed(BOM_INPUTGRID.DecimalsInCurrency));

                var iUnit = 0;
                var sGrid = FGRIDCONTROL.getGridIdFromCell(cellobj.cell);
                iUnit = FGRIDCONTROL.getCellObject(sGrid, cellobj.iRow, 11);
                if (MRP_Ribbon.lstsDecimal != "") {
                    for (var m = 0; m < MRP_Ribbon.lstsDecimal.length; m++) {
                        if (iUnit.CellData.value == MRP_Ribbon.lstsDecimal[m].ID) {
                            if (MRP_Ribbon.lstsDecimal[m].Tag > 0) {
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(iValue, MRP_Ribbon.lstsDecimal[m].Tag)), iValue);
                                break;
                            }
                        }
                    }
                } 
            }
        }
    }
