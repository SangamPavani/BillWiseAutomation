                }
                else {
                    factualSampleSize = fSampleSizePercent;
                }

                var SampleSize = parseFloat(factualSampleSize).toFixed(SAMPLECHECK.DecimalInQuantity);

                if (iRoundType == 0) { //None
                    SampleSize = SampleSize;
                } else if (iRoundType == 1) { //Nearest
                    SampleSize = Math.round(SampleSize);
                }
                else if (iRoundType == 3) { // Ceiling
