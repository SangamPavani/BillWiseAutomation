    onSelectInputProduct: function (RowIndex) {
        try {
            if (BOM_PROCESS.IsValidObject(RowIndex) == true) {
                RowIndex = parseInt(RowIndex);
                var sGridId = "Id_InputBOMProcess_Grid";
                var cellRemainQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 7);
                var RemainQty = parseFloat(cellRemainQty.getCellData("value"));
                RemainQty = isNaN(RemainQty) == true ? 0 : RemainQty;
                if (RemainQty <= 0) {
                    //COMMON.prototype.showMessage("Full quantity already used", "Work Center");
                    COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.MRP_R_msgFullQuantityAlreadyUsed, BOM_PROCESS.BOM_PROCESSMsgs.WorkCenter);
                    return false;
                }
                var cellQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 6);
                cellQty.setCellText(parseFloat(RemainQty).toFixed(BOM_PROCESS.NoofDecimals));
                cellQty.setCellData("value", RemainQty);
                cellRemainQty.setCellText(parseFloat(0).toFixed(BOM_PROCESS.NoofDecimals));
                cellRemainQty.setCellData("value", 0);
                cellRemainQty.setCellData("actquantity", RemainQty);
                cellRemainQty.setCellData("actremquantity", 0);                
            }
        }
        catch (e) {
            alert("Exception {BOM_PROCESS.onSelectInputProduct} : ", e.message);
        }
    },

    onSelectInputProductSelectAll: function (RowIndex) {
        try {
            //debugger
            if (BOM_PROCESS.IsValidObject(RowIndex) == true) {
                RowIndex = parseInt(RowIndex);
                var sGridId = "Id_InputBOMProcess_Grid";
                var cellRemainQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 7);
                var cellProcessingQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 6);
                var ProcessingQty = parseFloat(cellProcessingQty.getCellData("value"));
                var RemainQty = parseFloat(cellRemainQty.getCellData("value"));
                RemainQty = isNaN(RemainQty) == true ? 0 : RemainQty;
                if (ProcessingQty == 0 && RemainQty == 0) {
                    FGRIDCONTROL.setColumnCheckboxState(sGridId, RowIndex, 2, false);
                    //obj.Checkbox.checked = false;
                }
                else if (RemainQty <= 0) {
                    var cellProd = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 5);
                    //FGRIDCONTROL.setColumnCheckboxState(sGridId, RowIndex, 2, false);
                    return cellProd.getCellData();
                }
                if (ProcessingQty <= 0) {
                    var cellQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 6);
                    cellQty.setCellText(parseFloat(RemainQty).toFixed(BOM_PROCESS.NoofDecimals));
                    cellQty.setCellData("value", RemainQty);
                    cellRemainQty.setCellText(parseFloat(0).toFixed(BOM_PROCESS.NoofDecimals));
                    cellRemainQty.setCellData("value", 0);
                    cellRemainQty.setCellData("actquantity", RemainQty);
                    cellRemainQty.setCellData("actremquantity", 0);
                }
                else if (ProcessingQty > 0 && RemainQty > 0) {
                    RowIndex = parseInt(RowIndex);
                    var sGridId = "Id_InputBOMProcess_Grid";
                    var cellQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 6);
                    var cellRemainQty = FGRIDCONTROL.getCellObject(sGridId, RowIndex, 7);
                    var RemainQty = parseFloat(cellRemainQty.getCellData("value"));
                    RemainQty = isNaN(RemainQty) == true ? 0 : RemainQty;
                    var Qty = parseFloat(cellQty.getCellData("value"));
                    Qty = isNaN(Qty) == true ? 0 : Qty;
                    cellQty.setCellText(parseFloat(RemainQty + Qty).toFixed(BOM_PROCESS.NoofDecimals));
                    cellQty.setCellData("value", (RemainQty + Qty));
                    cellQty.setCellData("actquantity", 0);
                    cellQty.setCellData("actremquantity", (RemainQty + Qty));
                    cellRemainQty.setCellText(parseFloat(0).toFixed(BOM_PROCESS.NoofDecimals));
                    cellRemainQty.setCellData("value", 0);
                    //FGRIDCONTROL.setColumnCheckboxState(sGridId, RowIndex, 2, false);
                }                
                else
                {
                    FGRIDCONTROL.setColumnCheckboxState(sGridId, RowIndex, 2, false);
                }
                return "";
            }
        }
        catch (e) {
            alert("Exception {BOM_PROCESS.onSelectInputProduct} : ", e.message);
        }
    },

