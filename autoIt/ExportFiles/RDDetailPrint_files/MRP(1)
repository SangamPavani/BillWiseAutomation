                    var bTotalCheck = parseInt(lstData.TestType) == 0 ? false : true;
                    if (bTotalCheck) { // Total Check
                        var urlPath = REQUISITION.GetQualityControlAreaName("GetQCTotalCheckTestingDetails", "TotalCheck", eVersion.Version10);
                        var fnResult = NETWORK.executeServerMethod(urlPath, true, { sDocumentNo: lstData.sQCInspectionNo, iMenuId: 4006 }, "JSON", false);

                        if (fnResult.data == 0) {
                            COMMON.prototype.showMessage("Unable to Close Requisition", REQUISITION.REQUISITIONMsgs.lblErrorMsg);
                            return false;
                        } else if (fnResult.data != "") {
                            fPassedQty = fnResult.data.objQCTotalCheckHeader.fQtyPassed;
                            fFailedQty = fnResult.data.objQCTotalCheckHeader.fQtyFailed;
                            fQuantity = fnResult.data.objQCTotalCheckHeader.fQtyAvailable;
                            iApprovedBy = fnResult.data.objQCTotalCheckHeader.iCheckedBy;
                        }

                        if ((fPassedQty != fQuantity) && (fFailedQty != fQuantity)) {
