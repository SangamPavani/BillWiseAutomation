                            menuData.detailTag[0].style.setProperty("color", "blue", "important");
                            if ($(selectedMenu).hasClass("OrderRaisePending") == true) {
                                $(selectedMenu).removeClass("OrderRaisePending");
                            }
                            $(selectedMenu).addClass("OrderRaisedForProduct");
                        }


                        MRP_PROCESS.bRaisedPO = false;
                        var bNextLot = MRP_PROCESS.CheckAndProcessForNextLots();
                        if (bNextLot == false) {
                            QUICKMRP.showLog = true;
                            MRP_PROCESS.FinishProcessAndResetData();
                        }
                        else {
                            if (QUICKMRP.bApplyFilter == true && (QUICKMRP.bShowPolicy == false || QUICKMRP.iLotsProductPolicy != 0)) {
                                QUICKMRP.bPODeleted = false;
                                //Auto Click for Reaise PO Event 
                                MRP_PROCESS.ShowQuickMRPLog();
                                QUICKMRP.ProcessFromRaisePO();
                            }
                        }

                    }
                }
            }
        }
        catch (e) {
            alert("Exception: {MRP_PROCESS.GetRaisingPO} " + e.message);
        }
    },

