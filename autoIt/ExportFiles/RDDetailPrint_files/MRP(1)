    // Fills and Return Posting Data and other details for voucher posting method
    FillPostingData: function () {
        //debugger
        var postingData = {};
        try {
            var arrRaisingOrders = [];
            var attachmentType = MRP_DEPREQ.GetSelectedAttachmentPolicy();
            var postingOrderType = 0;
            var rdoSingleOrderForAllRows = document.getElementById("rbgRaiseSingleOrderForAllRows").value;
            //if (rdoSingleOrderForAllRows != null && rdoSingleOrderForAllRows != undefined) {
            //    postingOrderType = (rdoSingleOrderForAllRows.checked == true) ? 0 : 1;
            //}

            if (MRP_DEPREQ.bDontRestrictAcc2Type == false) {
                for (var k = 0; k < MRP_DEPREQ.arrSelectedPO.length; k++) {
                    if (MRP_DEPREQ.arrSelectedPO[k].iVendorID == undefined || MRP_DEPREQ.arrSelectedPO[k].iVendorID == 0)
                        MRP_DEPREQ.arrSelectedPO[k].iVendorID = -1;
                }
            }

            postingOrderType = rdoSingleOrderForAllRows;
            if (attachmentType == 0) {
                arrRaisingOrders = MRP_DEPREQ.arrSelectedPO;
            }
            else {
                arrRaisingOrders = MRP_DEPREQ.arrRaisingOrderData;
            }
            var bAskVendor = MRP_DEPREQ.AskForVendorWhileRaisingOrder();
            var bVendorExists = true;
            var isValidData = true;
            var Tags_DRR = null;
            var arrVendorId = null;
            var productName = "";
            var arrBOMTags = [];

            if (arrRaisingOrders != null) {
                arrVendorId = [];
                for (var i = 0; i < arrRaisingOrders.length; i++) {

                    if ((arrRaisingOrders[i].iVendorID == 0 || arrRaisingOrders[i].iVendorID == "")) {
                        if (bAskVendor > 0) {
                            isValidData = false;
                            productName = arrRaisingOrders[i].sProductName;
                            bVendorExists = false;
                            break;
                        }
                    }
                    else {
                        var obj = arrVendorId.find(item => item === arrRaisingOrders[i].iVendorID);
                        if (obj != null && obj != undefined) {
                            continue;
                        }
                        else {
                            arrVendorId.push(arrRaisingOrders[i].iVendorID);
                        }
                    }
                }

                for (var j = 0; j < arrRaisingOrders.length; j++) {
                    arrRaisingOrders[j].dRemainingQuantity = 0;
                    arrRaisingOrders[j].iIndentRaisedStatus = 0;
                    arrRaisingOrders[j].iSlotcount = 1;

                    if (arrRaisingOrders[j].iUnitID == -1) {
                        arrRaisingOrders[j].iUnitID = 0;
                    }
                    if (MRP_DEPREQ.bTagWisePosting == true) {
                        var obj = arrBOMTags.find(m => m === arrRaisingOrders[j].iBOMTagValue);
                        if (obj != null && obj != undefined) {
                            continue;
                        }
                        else {
                            arrBOMTags.push(arrRaisingOrders[j].iBOMTagValue);
                        }
                    }
                }
                //debugger
                if (isValidData == true && arrRaisingOrders != null) {
                    var VoucherTags = null;
                    Tags_DRR = MRP_DEPREQ.LoadTages();
                    if (typeof Tags_DRR == "boolean" && Tags_DRR == false) {
                        arrRaisingOrders = [];
                        Tags_DRR = null;
                        isValidData = false;
                    }

                    if (isValidData == true && arrRaisingOrders != null) {
                        VoucherTags = MRP_DEPREQ.LoadVoucherTags();
                        if (typeof VoucherTags == "boolean" && VoucherTags == false) {
                            arrRaisingOrders = [];
                            VoucherTags = null;
                            isValidData = false;
                            //return false;
                        }
                    }

                    if (isValidData == true) {
                        if (arrRaisingOrders != null) {
                            for (var ii = 0; ii < arrRaisingOrders.length; ii++) {
                                var BodyTagData = MRP_DEPREQ.LoadBodyTages((ii + 1));
                                if (typeof BodyTagData == "boolean" && BodyTagData == false) {
                                    arrRaisingOrders = [];
                                    isValidData = false;
                                }
                                if (isValidData == true && arrRaisingOrders != null) {
                                    var VoucherBodyData = MRP_DEPREQ.LoadVoucherBodyTages((ii + 1));
                                    if (typeof VoucherBodyData == "boolean" && VoucherBodyData == false) {
                                        arrRaisingOrders = [];
                                        isValidData = false;
                                    }
                                }
                                if (isValidData == true) {
                                    arrRaisingOrders[ii].lstBodyTags = BodyTagData;
                                    var arr = [];
                                    arr.push(MRP_DEPREQ.arrVoucherBodyDataF);
                                    arrRaisingOrders[ii].arrDocBodyFields = arr;
                                }
                            }
                        }
                    }
                }
            }

            //debugger
            for (var i = 0; i < arrRaisingOrders.length; i++) {
                var sPONo = arrRaisingOrders[i].sProductionOrderNo;
                var sRefNo = arrRaisingOrders[i].sRefOrderNo;
                var POID = arrRaisingOrders[i].iProdOrderID;

                if (arrRaisingOrders[i].arrDocBodyFields != null) {
                    for (var j = 0; j < arrRaisingOrders[i].arrDocBodyFields.length; j++) {
                        for (var k = 0; k < arrRaisingOrders[i].arrDocBodyFields[j].length; k++) {
                            if (arrRaisingOrders[i].arrDocBodyFields[j][k].sFieldName == "sProductionOrderNo") {
                                arrRaisingOrders[i].arrDocBodyFields[j][k].objFieldValue = sPONo;
                            }
                            else if (arrRaisingOrders[i].arrDocBodyFields[j][k].sFieldName == "sRefOrderNo") {
                                arrRaisingOrders[i].arrDocBodyFields[j][k].objFieldValue = sRefNo;
                            }
                            else if (arrRaisingOrders[i].arrDocBodyFields[j][k].sFieldName == "iProductionOrderId") {
                                arrRaisingOrders[i].arrDocBodyFields[j][k].objFieldValue = POID;
                            }
                        }
                    }
                }
            }

            postingData.isValid = isValidData;
            postingData.productName = productName;
            postingData.arrVendorId = arrVendorId;
            postingData.arrBOMTags = arrBOMTags;
            postingData.postingOrderType = postingOrderType;
            postingData.Data = arrRaisingOrders;
            postingData.Tags = Tags_DRR;
            postingData.bVendorExists = bVendorExists;
            return postingData;
        }
        catch (e) {
            alert("Exception: {MRP_DEPREQ.FillPostingData} " + e.message);
            postingData.isValid = false;
            postingData.productName = "";
            postingData.arrVendorId = null;
            postingData.postingOrderType = -1;
            postingData.Data = null;
            postingData.Tags = null;
            return postingData;
        }
    },

