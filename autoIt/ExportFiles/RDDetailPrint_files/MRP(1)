    GetDocuments: function () {
        try {
            //debugger;
            MRP_DEPPROD.sReplenishmentType = "";
            var  iTag = 0;
            iTag = MRP_DEPPROD.GetProductTpe();
            var iProd = MRP_DEPPROD.GetOptionControlValue('FOption_FilterProductionOrder_DMR');
            var Product = MRP_DEPPROD.GetOptionControlValue('FOption_FilterProduct_DMR');
            if (iProd == null || iProd == "")
                iProd = 0

            if (Product == null || Product == "")
                Product = 0

            var iReplenishmentType = 2
            var RType = document.getElementsByName('RepleshmentType');
            for (var i = 0; i < RType.length; i++) {
                if (RType[i].checked == true) {
                    iReplenishmentType = RType[i].value;
                    break;
                }
            }
            var sRefORderNo = document.getElementById("sRefOrderNoDepProd").value;
            var url = GLOBAL.getContextPath("GetDocuments", "DependentProductionRequirment", "MRP");
            var selectMastersResult = NETWORK.executeServerMethod(url, true, {
                iProductID: parseFloat(Product), iProductionID: parseFloat(iProd), iTag: iTag, iReplenishmentType: iReplenishmentType, sRefORderNo: sRefORderNo
            }, "JSON", false);
