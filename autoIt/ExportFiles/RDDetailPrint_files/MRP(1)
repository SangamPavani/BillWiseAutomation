    GetSelectedBATCHData: function () {
        try {
            //debugger
            var FinalList = [];
            //var ObjData = {};
            var obj = {};
            var FinalObjList = [];
            var TotalColumns = FGRIDCONTROL.getTotalColumns(MRP_BATCH.GetBatchGridName());
            var GridTotalRows = FGRIDCONTROL.getTotalRows(MRP_BATCH.GetBatchGridName());
            var CellObj = null, m_AdjBatchQtyCol = 0;
            for (var irow = 0; irow < GridTotalRows; irow++) {
                //var i = irow;
                for (var i = 0; i < MRP_BATCH.OBJLIST.length; i++) {
                    //  ObjData = {};
                    var CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iBatchIdCol + 1);
                    var iBatch = CellObj.getCellData()
                    if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] != iBatch) {
                        continue;
                    }

                    CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iAdjustedCol + 1);
                    if (parseFloat(CellObj.getCellData()) == 0) {
                        continue;
                    }
                    obj = {}; var sDate = "";

                    var dValue = FConvert.addNumericSeparator(FConvert.toDecimal(MRP_BATCH.OBJLIST[i][MRP_BATCH.iAdjustedColumn], MRP_BATCH.iNoofDecimalQty));
                    if (dValue > 0) {
                        for (var j = 0; j < TotalColumns; j++) {
                            CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, j + 1);
                            switch (CellObj.ColumnAttribute.ctrlatt) {
                                case "sBatchNo":
                                    //ObjData.m_strBatchNo = CellObj.getCellData();
                                    obj.BatchNo = CellObj.getCellData();
                                    break;
                                case "BatchQty":
                                    //ObjData.m_dQty = CellObj.getCellData();
                                    obj.Qty = CellObj.getCellData();
                                    break;
                                case "iMfDate":
                                    //ObjData.m_iMfgDate = parseFloat(CellObj.getCellData());
                                    sDate = CellObj.getCellData();
                                    obj.MfgDate = parseFloat(sDate == "" ? 0 : sDate);
                                    break;
                                case "iExpiryDate":
                                    //ObjData.m_iExpDate = parseFloat(CellObj.getCellData());
                                    sDate = CellObj.getCellData();
                                    obj.ExpDate = parseFloat(CellObj.getCellData());
                                    break;
                                case "mRate":
                                    //ObjData.m_dRate = CellObj.getCellData();
                                    obj.BatchRate = parseFloat(CellObj.getCellData());
                                    break;
                                case "AdjBatchQty":
                                    m_AdjBatchQtyCol = CellObj.getCellData();
                                    obj.QtyAdjusted = CellObj.getCellData();
                                    break;
                                case "iBatchId":
                                    //ObjData.m_iBatchId = CellObj.getCellData();
                                    obj.BatchId = CellObj.getCellData();
                                    break;
                                case "fValue1":
                                    //ObjData.m_dValue1 = CellObj.getCellData();
                                    obj.Value1 = CellObj.getCellData();
                                    break;
                                case "fValue2":
                                    //ObjData.m_dValue2 = CellObj.getCellData();
                                    obj.Value2 = CellObj.getCellData();
                                    break;
                                case "bReserved":
                                    //ObjData.m_bFromReservation = CellObj.getCellData();
                                    obj.FromReservation = CellObj.getCellData();
                                    break;
                                case "ReservedQty":
                                    //ObjData.m_dResQuantity = CellObj.getCellData();
                                    obj.ReservedQty = CellObj.getCellData();
                                    break;
                                case "PurchaseDate":
                                    obj.PurchaseDate = CellObj.getCellData();
                                    break;
                                case "iReservationId":
                                    //ObjData.m_iReservationId = CellObj.getCellData();
                                    obj.IReservationId = CellObj.getCellData();
                                    break;
                                case "bRemove":
                                    break;
                            }
                        }
                        //debugger
                        obj.Qty = obj.QtyAdjusted;
                        obj.InvTagId = MRP_BATCH.OBJINPUTBATCH.iTagId;
                        obj.BodyId = MRP_BATCH.OBJINPUTBATCH.BodyId == undefined ? MRP_BATCH.OBJINPUTBATCH.BodyId : MRP_BATCH.OBJINPUTBATCH.iBodyId;
                        //obj.iBodyId = MRP_BATCH.OBJINPUTBATCH.iBodyId;

                        //ObjData.m_dQty = m_AdjBatchQtyCol;
                        //ObjData.m_iInvTagId = MRP_BATCH.OBJINPUTBATCH.iTagId;
                        obj.arrBinData = MRP_BATCH.OBJINPUTBATCH.arrBins;
                        obj.AllocationTagId = MRP_BATCH.OBJINPUTBATCH.iAllocationTag;
                        //arrBatchListUsed = MRP_BATCH.arrBatchList;
                        var dAleadyReleasedQty = 0;
                        if (MRP_BATCH.arrINPUTUSEDBATCH != null && MRP_BATCH.arrINPUTUSEDBATCH.length > 0) {
                            for (var j = 0; j < MRP_BATCH.arrINPUTUSEDBATCH.length; j++) {
                                if (obj.BatchId == MRP_BATCH.arrINPUTUSEDBATCH[j].BatchId && obj.IReservationId == MRP_BATCH.arrINPUTUSEDBATCH[j].IReservationId) {
                                    dAleadyReleasedQty += m_AdjBatchQtyCol;
                                }
                            }
                        }

                        obj.ReservedQty = parseFloat(obj.ReservedQty) - dAleadyReleasedQty >
                            parseFloat(m_AdjBatchQtyCol) ? parseFloat(m_AdjBatchQtyCol) :
                            parseFloat(obj.ReservedQty) - dAleadyReleasedQty;
                        FinalObjList.push(obj);
                        //FinalList.push(ObjData);
                    }
                }
            }
            return FinalObjList;
        } catch (e) {
            COMMON.prototype.showMessage("Exception: {MRP_BATCH.GetSelectedBATCHData} " + e.message, "Error Message");
        }
    },

