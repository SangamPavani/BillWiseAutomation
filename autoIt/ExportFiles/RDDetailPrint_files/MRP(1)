                                    var iExcessQty = iTotalQuantityToRelease - RemainingQuantity;
                                    COMMON.prototype.showMessage("Quantity can not be Greater than Remaining Quantity", "Error Message");
                                    objCell.setCellData("value", parseFloat(0).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                    objCell.setCellText(parseFloat(0).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                }
                            }

                            if (rbchkCostPerUnit == true && jobRateQty > 0) {
                                var totalColqty = 0;
                                var txtjobrateqty = QunatityToRelease * jobRateQty;
                                var cellobj = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", objCell.iRow, 12 + prodColIndexCount);
                                cellobj.setCellText("");
                                cellobj.setCellData("value", parseFloat(txtjobrateqty).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                //cellobj.setCellText(parseFloat(txtjobrateqty).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(txtjobrateqty, RELEASEJOBORDER.NoofDecimalsInQuantity)));

                                for (var rowindex = 1; rowindex <= rowGridCount; rowindex++) {
                                    var RowCell12 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 12 + prodColIndexCount);
                                    var CostPriceQty = parseFloat(RowCell12.getCellData("value"));
                                    totalColqty = parseFloat(totalColqty) + CostPriceQty;
                                }

                                document.getElementById("txtJobRateId").value = "";
                                document.getElementById("txtJobRateId").value = totalColqty == NaN ? 0 : totalColqty;
                            }
                            //Second Radio button
                            //debugger;
                            var currenttotaljobrate = parseFloat(document.getElementById("txtJobRateId").value);
                            if (rbchktotalcost == true && currenttotaljobrate > 0) {
                                var irowcounttotalqty = 0;
                                //For Row Count
                                var rowGridtotalRecords = FGRIDCONTROL.getTotalRows("Id_ReleaseJobOrder_Grid");
                                for (var rowtotalc = 1; rowtotalc <= rowGridtotalRecords; rowtotalc++) {
                                    var RowCellDataQty = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowtotalc, 11 + prodColIndexCount);
                                    var qtytoRelease = RowCellDataQty.getCellData("value");
                                    if (qtytoRelease > 0) {
                                        irowcounttotalqty = irowcounttotalqty + 1;
                                    }
                                }
                                var qtytojobrate = currenttotaljobrate / irowcounttotalqty;
                                //Bind Data to grid
                                for (var rowtotalindex = 0; rowtotalindex <= rowGridtotalRecords; rowtotalindex++) {
                                    var RowCellDataQty = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowtotalindex, 11 + prodColIndexCount);
                                    var qtytoRelease = parseFloat(RowCellDataQty.getCellData("value"));
                                    if (qtytoRelease > 0) {
                                        var cellobjdata = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowtotalindex, 12 + prodColIndexCount);
                                        cellobjdata.setCellText("");
                                        cellobjdata.setCellData("value", parseFloat(qtytojobrate).toFixed(RELEASEJOBORDER.iNoOfDecimalsCurrency));
                                        //cellobjdata.setCellText(parseFloat(qtytojobrate).toFixed(RELEASEJOBORDER.iNoOfDecimalsCurrency));
                                        cellobjdata.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(qtytojobrate, RELEASEJOBORDER.iNoOfDecimalsCurrency)));
                                    }
                                }
                            }
                        }

                        FGRIDCONTROL.gotoNextCell(document.getElementById("Id_ReleaseJobOrder_Grid"), objCell.iRow, 13 + prodColIndexCount);
                        break;

                    case "txtJobRate":
                        if (rbchkCostPerUnit == true) {
                            objCell.setCellData("value", parseFloat(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim()).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                            //objCell.setCellText(parseFloat(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim()).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                            objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim(), RELEASEJOBORDER.NoofDecimalsInQuantity)));
                            var rowGridCount = FGRIDCONTROL.getTotalRows("Id_ReleaseJobOrder_Grid");
                            var totalQuantity = 0;
                            for (var rowindex = 1; rowindex <= rowGridCount; rowindex++) {
                                //debugger;
                                var RowCell11 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 11 + prodColIndexCount);
                                var QunatityToRelease = parseFloat(RowCell11.getCellData("value"));

                                var RowCell13 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 14 + prodColIndexCount);
                                var jobRateQuantity = parseFloat(RowCell13.getCellData("value"));
                                var txtjobrateqty = QunatityToRelease * jobRateQuantity;

                                var cellobj = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 12 + prodColIndexCount);
                                cellobj.setCellText("");
                                cellobj.setCellData("value", parseFloat(txtjobrateqty).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                //cellobj.setCellText(parseFloat(txtjobrateqty).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(txtjobrateqty, RELEASEJOBORDER.NoofDecimalsInQuantity)));
                                txtjobrateqty = 0;

                                var RowCell12 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 12 + prodColIndexCount);
                                var costQuantity = parseFloat(RowCell12.getCellData("value"));
                                totalQuantity = totalQuantity + costQuantity;
                            }
                            document.getElementById("txtJobRateId").value = "";
                            document.getElementById("txtJobRateId").value = totalQuantity;

                        }

                        break;
                    case "optVendorName":
                        element = OPTIONCONTROL.getControlData(objCell.ColumnAttribute.ctrlid);
                        objCell.setCellData(element);
                        if (FCommon.UI.isValidObject(element) == true && element.length >= 2) {
                            objCell.setCellData(FConvert.toInt(COMMON.prototype.getObjectFirstPropertyValue(element[0])));
                            objCell.setCellText(COMMON.prototype.getObjectFirstPropertyValue(element[1]));

                            RELEASEJOBORDER.LoadJobRate(objCell);
                        }
                        break;


                    case "CostPrice":

                        var totalColqty = 0;
                        if (rbchkCostPrice == true) {
                            objCell.setCellData("value", parseFloat(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim()).toFixed(RELEASEJOBORDER.iNoOfDecimalsCurrency));
                            //objCell.setCellText(parseFloat(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim()).toFixed(RELEASEJOBORDER.iNoOfDecimalsCurrency));
                            objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim(), RELEASEJOBORDER.iNoOfDecimalsCurrency)));
                            var rowGridCount = FGRIDCONTROL.getTotalRows("Id_ReleaseJobOrder_Grid");
                            for (var rowindex = 1; rowindex <= rowGridCount; rowindex++) {
                                var RowCell12 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 12 + prodColIndexCount);
                                var CostPriceQty = parseFloat(RowCell12.getCellData("value"));
                                totalColqty = parseFloat(totalColqty) + CostPriceQty;

                            }
                            document.getElementById("txtJobRateId").value = "";
                            document.getElementById("txtJobRateId").value = totalColqty == NaN ? 0 : totalColqty;
                        }

                        break;
                    case "txtRemarks":
                        //debugger
                        objCell.setCellData("value", document.getElementById(objCell.ColumnAttribute.ctrlid).value);
                        objCell.setCellText(document.getElementById(objCell.ColumnAttribute.ctrlid).value);
                        break;
                    default:
                        var bDefault = false;
                        if (objCell.ColumnAttribute.ctrlid == "FOption_sProductionOrderNo" || objCell.ColumnAttribute.ctrlid == "FOption_iProductionOrderId" || objCell.ColumnAttribute.ctrlid == "FOption_sRefOrderNo")
                            bDefault = true;
                        if (objCell.ColumnAttribute.ctrltags == "ExtraField" && bDefault == false) {
                            var value = document.getElementById(objCell.ColumnAttribute.ctrlid).value;
                            objCell.setCellData("value", value != null || "" ? value : "");
                            objCell.setCellText(value != null || "" ? value : "");
                        }
                        else
                            objCell.processDefault();
                        break;

                }

                if (objCell.ColumnAttribute.ctrlrpotype == "tagbind" && RELEASEJOBORDER.arrFocusBodyTags.length + 1 == objCell.iColumn) {
                    FGRIDCONTROL.gotoNextCell(document.getElementById("Id_ReleaseJobOrder_Grid"), objCell.iRow, 10 + prodColIndexCount);
                }
            }
            else {
                switch (objCell.ColumnAttribute.ctrlrpotype) {
                                        
                    case "tagbind":
                        if (objCell.iRow > 1) {
                            var CurrentValue = isNaN(parseInt(objCell.getCellData("value"))) ? 0 : parseInt(objCell.getCellData("value"));
                            if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
                                var PrevEle = FGRIDCONTROL.getCellObject(objCell.Grid.id, objCell.iRow - 1, objCell.iColumn);
                                objCell.setCellData("value", PrevEle.getCellData("value"));
                                objCell.setCellText(PrevEle.getCellText("value"));
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            } else {
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            }
                        } else {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                        break;

                    case "txtQunttoRelease":
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                        break;

                    case "txtJobRate":
                        if (rbchkCostPrice == false && rbchktotalcost == false) {
                            if (rbchkCostPerUnit == true) {
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            }
                        }
                        break;

                    case "optVendorName":
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        if (COMMON.prototype.isValidObject(element) == true) {
                            objCell.setControl(element, objCell.getCellData("value"));

                        } else {
                            objCell.processDefault(event);
                        }
                        break;

                    case "CostPrice":

                        if (rbchkCostPrice == true) {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        } else {
                            objCell.processDefault(event);
                        }
                        break;
                    case "txtRemarks":
                        //debugger
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                        break;
                    default:
                        var bDefault = false;
                        if (objCell.ColumnAttribute.ctrlid == "FOption_sProductionOrderNo" || objCell.ColumnAttribute.ctrlid == "FOption_iProductionOrderId" || objCell.ColumnAttribute.ctrlid == "FOption_sRefOrderNo")
                            bDefault = true;
                        if (objCell.ColumnAttribute.ctrltags == "ExtraField" && bDefault == false) {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                        else
                            objCell.processDefault();
                    break;
                }
            }

            return true;
        }
        catch (err) {
            alert("Exception:" + err.message);
        }
    },

    LoadJobRate: function (cellobj) {
