                }
            }
            if (document.getElementById("hdnIsOpenFromOtherScreen_MRP").value == "0") {
                if (MRP_PROCESS.IsValidObject(MRP_PROCESS.MRPSelectedProds) == false) {
                    MRP_PROCESS.FinishProcessAndResetData();
                }
                else {
                    // bRaisedPO = False   -   not allowing to next process in Lots BreakUp
                    MRP_PROCESS.bRaisedPO = false;
                    var bNextLot = MRP_PROCESS.CheckAndProcessForNextLots();
                    if (bNextLot == false) {
                        MRP_PROCESS.FinishProcessAndResetData();
