    SerialNodbClick: function (cellobj, event) {
        try {
            //debugger
            MRP_BATCH.m_AdjQtyInTransUnit = MRP_BATCH.stringToBoolean(document.getElementById("bAdjBatchInTransUnit").value);
            FGRIDCONTROL.update(MRP_BATCH.GetBatchGridName(), null);
            var TotalAmt = parseFloat(FConvert.toDecimal(document.getElementById('lblBalnceQty').innerText, MRP_BATCH.iNoofDecimalQty));
            var dTotalAdj = parseFloat(FConvert.toDecimal(document.getElementById('lblAdjustQty').innerText, MRP_BATCH.iNoofDecimalQty));
            var AdjustedQty = parseFloat(0);
            var BalanceQty = parseFloat(TotalAmt);
            var bToBreak = false;
            var GridTotalRows = FGRIDCONTROL.getTotalRows(MRP_BATCH.GetBatchGridName());
            if (BalanceQty == 0) {
                MRP_BATCH.UnselectFromGrid();
                TotalAmt = parseFloat(FConvert.toDecimal(document.getElementById('lblBalnceQty').innerText, MRP_BATCH.iNoofDecimalQty));
                dTotalAdj = parseFloat(FConvert.toDecimal(document.getElementById('lblAdjustQty').innerText, MRP_BATCH.iNoofDecimalQty));
                BalanceQty = parseFloat(TotalAmt);
            }
            var irow = cellobj.iRow - 1;
            for (var i = 0; i < MRP_BATCH.OBJLIST.length; i++) {

                var CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iBatchIdCol + 1);
                var iBatch = CellObj.getCellData()
                if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] != iBatch) {
                    continue;
                }

                CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, 2);
                if (CellObj.sText.trim() == "") {
                    COMMON.prototype.showMessage("No Batch Data To Pick ", "BATCHES");
                    break;
                    return;
                }
                CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.iAdjustedColumn + 1);
                var dValue = parseFloat(CellObj.getCellData());
                if (dValue > 0) {
                    if (MRP_BATCH.m_AdjQtyInTransUnit == true) {
                        if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_TranUnitBatchQty]) == parseFloat(CellObj.getCellData())) {
                            continue;
                        }
                    }
                    else {
                        if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_BatchQtyCol]) == parseFloat(CellObj.getCellData())) {
                            continue;
                        }
                    }
                } else {
                    dValue = 0;
                }
                if (MRP_BATCH.m_AdjQtyInTransUnit == true) {
                    if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_TranUnitBatchQty]) < BalanceQty) {
                        dValue = parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_TranUnitBatchQty]).toFixed(MRP_BATCH.iNoofDecimalQty);
                    } else if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_TranUnitBatchQty]) >= BalanceQty) {
                        dValue = BalanceQty.toFixed(MRP_BATCH.iNoofDecimalQty);
                        bToBreak = true;
                    }
                }
                else {
                    if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_BatchQtyCol]) < BalanceQty) {
                        dValue = parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_BatchQtyCol]).toFixed(MRP_BATCH.iNoofDecimalQty);
                    } else if (parseFloat(MRP_BATCH.OBJLIST[i][MRP_BATCH.m_BatchQtyCol]) >= BalanceQty) {
                        dValue = BalanceQty.toFixed(MRP_BATCH.iNoofDecimalQty);
                        bToBreak = true;
                    }
                }

                CellObj.setCellData("value", dValue);
                CellObj.setCellText(FConvert.addNumericSeparator(dValue, MRP_BATCH.iNoofDecimalQty));
                MRP_BATCH.arrIssuingList[i] = parseFloat(dValue).toFixed(MRP_BATCH.iNoofDecimalQty);
                BalanceQty = BalanceQty - dValue;
                dTotalAdj = dTotalAdj + parseFloat(dValue);
                document.getElementById('lblBalnceQty').innerText = BalanceQty.toFixed(MRP_BATCH.iNoofDecimalQty);
                document.getElementById('lblAdjustQty').innerText = (dTotalAdj).toFixed(MRP_BATCH.iNoofDecimalQty);
                document.getElementById('lblAdjSum').innerText = (dTotalAdj).toFixed(MRP_BATCH.iNoofDecimalQty);
                if (bToBreak)
                    break;
                //}
            }
        } catch (e) {
            COMMON.prototype.showMessage("Exception: {MRP_BATCH.SerialNodbClick} " + e.message, "Error Message");
        }
    },

