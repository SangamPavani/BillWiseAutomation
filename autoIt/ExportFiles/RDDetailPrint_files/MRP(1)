                else if (PIORDER.IsMRP2Enabled() == true) {
                    if ((objCell.ColumnAttribute.ctrlid == "txtActualProductQuantity_PIO" || objCell.ColumnAttribute.ctrlid == "fDatePicker_ActualDueDate_PIO" && objCell.ColumnAttribute.ctrlid != "txtRemarks_PIO")) {
                        //  element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        // objCell.setControl(element, objCell.getCellData("value"));
                        objCell.processDefault(event);
                    } else {
                        objCell.processDefault(event);
                    }
                }
                else {
                    objCell.processDefault(event);
                }
                if (FGRIDCONTROL.getTotalRows("Id_PlanIndependentOrder_Grid_PIO") == objCell.iRow) {
                    FGRIDCONTROL.insertRows("Id_PlanIndependentOrder_Grid_PIO", 0, 1);
                    FGRIDCONTROL.makeCellVisible("Id_PlanIndependentOrder_Grid_PIO", objCell.iRow, objCell.iColumn);
                }
            }
            return (true);
        } catch (e) {
            alert("Exception: PIORDER.PIReqGrid_onCellChange " + e.message);
        }
