            if (ROUTING.arrRoutingNodes != null) {
                for (var i = 0; i < ROUTING.arrRoutingNodes.length; i++) {
                    if (ROUTING.arrRoutingNodes[i].iNodeSeq == iTo) {
                        //ObjOutPut = ROUTING.arrRoutingNodes[i].arrRoutingOutput;
                        for (var j = 0; j < arrInput.length; j++) {
                            var count = 0;
                            for (var k = 0; k < ROUTING.arrRoutingNodes[i].arrRoutingBOMProduct.length; k++) {
                                if (ROUTING.arrRoutingNodes[i].arrRoutingBOMProduct[k].iProductId == arrInput[j].iProductId) {
                                    count = count + 1;
                                }
                            }
                            if (count == 0) {
                                ROUTING.arrRoutingNodes[i].arrRoutingBOMProduct.push(arrInput[j]);
                            }

                            //ROUTING.arrForWorkCenterInput = ObjOutPut.arrRoutingBOMProduct;
                        }
                    }
                }
            }
