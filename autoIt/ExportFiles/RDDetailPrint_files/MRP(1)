                                    parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iSpecificVendorID),
                                    parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].sReserveBy), parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iParentID), MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].bEditedQuantity);//arrvijay

                                MRP_PROCESS.SaveMRPRaiseIssueToProduction(MRP_PROCESS.arrIssueToProduction);
                                MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iDueDate = MRP_PROCESS.arrMRPPOData[i].iProductionStartDate;
                            }
                        }

                        //changes on 06092019 as Date Change to Long
                        if (TotQty > 0) {
                            if (MinQty == 0 && MaxQty == 0) {
                                //var iStDate = MRP_PROCESS.GetIntDateFromLong(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate)
                                //MRP_PROCESS.FillRows(ChildTableID, TotQty + SafetyStockQty, TotQty + SafetyStockQty,iStDate, //MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iDueDate,//MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, change06092019
                                MRP_PROCESS.FillRows(ChildTableID, TotQty + SafetyStockQty, TotQty + SafetyStockQty, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iDueDate,//MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, change06092019
                                    VendorID, BuyingRate, parseInt(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].RowID), MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID,
                                    Type, iRoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].sOrderNo,
                                    MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iSpecificVendorID, MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iWIPAccount,
                                    MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionEndDate,
                                    MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].sProductType, RatioQty, MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iUnitID);
                            }
                            else {
                                MRP_PROCESS.SplitPO(ParentTableId, ChildTableID, TotQty + SafetyStockQty, MaxQty, MinQty, MRP_PROCESS.arrMRPPOData[i].iProductionStartDate, VendorID, BuyingRate,
                                    MRP_PROCESS.arrMRPPOData[i].RowID, MRP_PROCESS.arrMRPPOData[i].OrderID, Type, iRoutingID, ProcureType, strBatch, VariantID, MRP_PROCESS.arrMRPPOData[i].sOrderNo,
                                    MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iSpecificVendorID, MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iWIPAccount,
                                    MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionEndDate, MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iUnitID);
                            }
                        }
                    }
                }
                if (dSafetyStockQty > 0) {
                    MRP_PROCESS.ApplySafetyStock(ChildTableID, dSafetyStockQty);
                }
            }
        } catch (e) {
            alert("Exception: {MRP_PROCESS.FillPOTable} " + e.message);
            return;
        }
    },

    // Returns Available quantity and Do Reservation of stock for available quantity
    DoReservation: function (ParentOrderID, iSpecificVendor, AvailableQty) {
        try {
            debugger
            if (AvailableQty > 0) {
                AvailableQty = parseFloat(parseFloat(AvailableQty).toFixed(MRP_PROCESS.iDecimalInQuantity));

                ////var iWareHouseId = 0;
                ////if (document.getElementById("InvOptionCtrl") != null) {
                ////    var InvData = OPTIONCONTROL.getControlDataObject("InvOptionCtrl");
                ////    if (Object.keys(InvData).length === 0 || InvData.iMasterId == "" || InvData.iMasterId == null || InvData.iMasterId == 0) {
