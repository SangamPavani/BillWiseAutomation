    // Final Finish method for Run MRP to stop MRP Process
    this.MRPProcessFinish = function () {
        try {
            //debugger;
            var hasRemainingPO = false;
            for (var i = 0; i < MAIN_MRPPROCESS.arrRaisedPOsListIndex.length; i++) {
                if (MAIN_MRPPROCESS.arrRaisedPOsListIndex[i].isMRPDone == false) {
                    MAIN_MRPPROCESS.RaisePOIndex = MAIN_MRPPROCESS.arrRaisedPOsListIndex[i].index;
                    hasRemainingPO = true;
                    break;
                }
            }
            if (hasRemainingPO == true) {
                MAIN_MRPPROCESS.PreferenceProcessAndFinalPlanning();
            }
            else {
                var strVoucherNos = "";
                if (MAIN_MRPPROCESS.IsValidObject(MAIN_MRPPROCESS.arrRaisingPO) == true) {
                    for (var i = 0; i < MAIN_MRPPROCESS.arrRaisingPO.length; i++) {
                        if (MAIN_MRPPROCESS.arrRaisingPO[i].sProductionOrderNo != "") {
                            strVoucherNos += MAIN_MRPPROCESS.arrRaisingPO[i].sProductionOrderNo + ", ";
                        }
                    }
                }
                if (strVoucherNos != "") {
                    strVoucherNos = strVoucherNos.substring(0, strVoucherNos.lastIndexOf(','));
                    //COMMON.prototype.showMessage("Production Order(s) " + strVoucherNos + " Raised Successfully.", "MRP Process")
                    COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_MP_msgProductionOrders + " " + strVoucherNos + " " + MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_MP_msgRaisedSuccessfully, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRPProcess)
                }
                MAIN_MRPPROCESS.ResetMRPData();
                MRP_REPLANNING.GetRePlanningDocumentData();
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.MRPProcessFinish} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

