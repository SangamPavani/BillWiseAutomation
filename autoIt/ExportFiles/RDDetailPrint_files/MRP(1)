                    case "BatchExpiryDate":
                        if (objCell.bHidden) {
                            objCell.processDefault();
                            break;
                        }
                        var BEFdata = DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid);
                        var sBEDtext = OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid);
                        var iJobOrderDate = parseInt(JOdata.iDate);
                        var JODate = FDate.convertDateIntoString(iJobOrderDate, RECEIPTFROMJOBWORKER.dateFormat, RECEIPTFROMJOBWORKER.CalanderType, RECEIPTFROMJOBWORKER.iLanguageId);
                        if (iJobOrderDate > BEFdata) {
                            sBEDtext = "";
                            COMMON.prototype.showMessage("Batch Expiry Date connot be less than Job Order Date : " + JODate, RECEIPTFROMJOBWORKER.RECEIPTFROMJOBWORKERMsgs.lblErrorMsg);
                        }
                        var BMDate = "";
                        for (var i = 0; i < FGRIDCONTROL.getTotalColumns(sGridCtrlId); i++) {
                            var obj = FGRIDCONTROL.getCellObject(sGridCtrlId, objCell.iRow, i + 1);
                            if (obj.ColumnAttribute.ctrlirfjobw == "BatchManufacturingDate") {
                                BMDate = DATEPICKER.getDate(obj.ColumnAttribute.ctrlirfjobw);
                                break;
                            }
                        }
                        if (BEFdata < BMDate && BMDate != "") {
                            sBEDtext = "";
                            COMMON.prototype.showMessage("Batch Expiry Date connot be less than Manufacturing Date", RECEIPTFROMJOBWORKER.RECEIPTFROMJOBWORKERMsgs.lblErrorMsg);
                        }
                        if (BEFdata == 0)
                            sBEDtext = "";
                        objCell.setCellData("value", BEFdata);
                        objCell.setCellText(sBEDtext);
                        break;
                    case "RMA":

                        break;
                    default:
                        objCell.processDefault();
                        break;
                }
                if (objCell.ColumnAttribute.ctrlirfjobw == "QuantityToReceive") {
                    RECEIPTFROMJOBWORKER.LoadFooterData();
                }
            }
            else {
                //debugger;
                switch (objCell.ColumnAttribute.ctrlirfjobw) {
                    case "RFJWBTAG":
                        if (objCell.iRow > 1) {
                            var CurrentValue = isNaN(parseInt(objCell.getCellData("value"))) ? 0 : parseInt(objCell.getCellData("value"));
                            if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
                                var PrevEle = FGRIDCONTROL.getCellObject(objCell.Grid.id, objCell.iRow - 1, objCell.iColumn);
                                objCell.setCellData("value", PrevEle.getCellData("value"));
                                objCell.setCellText(PrevEle.getCellText("value"));
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            } else {
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            }
                        } else {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                        break;

                    case "RFJWBExtraF":
                        //debugger
                        if (objCell.ColumnAttribute.ctrlid != "sProductionOrderNo" && objCell.ColumnAttribute.ctrlid != "iProductionOrderId" && objCell.ColumnAttribute.ctrlid != "sRefOrderNo") {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        } else {
                            objCell.processDefault();
                        }
                        break;

                    case "QuantityToReceive":
                        if (RECEIPTFROMJOBWORKER.bQuantityReadOnly == false) {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                        break;
                    case "Batch":
                        //debugger
                        if (objCell.bHidden) {
                            objCell.processDefault();
                            break;
                        }
                        RECEIPTFROMJOBWORKER.generateBatchFromSeries(objCell);
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        var sValue = element.value;
                        objCell.setControl(element, objCell.getCellData("value"));
                        //RF_PRODUCTION.iBatchColumnNo = cellobj.iColumn;
                        element.value = sValue;
                        objCell.setCellText(element.value);
                        //RF_PRODUCTION.GetBatch(cellobj.iRow);

                        break;
                    case "BatchManufacturingDate":
                        if (objCell.bHidden) {
                            objCell.processDefault();
                            break;
                        }
                        var PreloadValue = objCell.getCellData("value");
                        if (PreloadValue == null || PreloadValue == undefined || PreloadValue == "" || PreloadValue == "0" || PreloadValue == 0) {
                            PreloadValue = DATE.prototype.today();
                        }
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, PreloadValue);
                        break;
                    case "BatchExpiryDate":
                        if (objCell.bHidden) {
                            objCell.processDefault();
                            break;
                        }
                        var PreloadValue = objCell.getCellData("value");
                        if (PreloadValue == null || PreloadValue == undefined || PreloadValue == "" || PreloadValue == "0" || PreloadValue == 0) {
                            PreloadValue = DATE.prototype.today();
                        }
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, PreloadValue);
                        break;
                    case "RMA":
                        //debugger
                        if (objCell.bHidden || RECEIPTFROMJOBWORKER.arrRFJWBodyData[objCell.iRow - 1].bNoRMA == true) {
                            objCell.processDefault();
                            break;
                        }
                        RECEIPTFROMJOBWORKER.GetRMA(objCell.iRow, objCell.sText);
                        break;
                    default:
                        objCell.processDefault();
                        break;
                }
            }

            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception:" + err.message, RECEIPTFROMJOBWORKER.RECEIPTFROMJOBWORKERMsgs.lblErrorMsg);
        }
    },

