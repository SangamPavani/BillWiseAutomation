    SaveProcessTimeTrackerData: function (iType) {
        //debugger;

        if (PTT.Result == -1) {
            COMMON.prototype.showMessage("Previous Process Not Completed.", "Process Time Tracker");
            return false;
        }
        if (PTT.Result == -300) {
            COMMON.prototype.showMessage("Issues Not Done for the Process.", "Process Time Tracker");
            return false;
        }
        data = OPTIONCONTROL.getControlDataObject("FOption_PTT_ProductionOrder");
        if (Object.keys(data).length === 0 || data.iProdOrderId == undefined || data.iProdOrderId == null || data.iProdOrderId == "") {
            COMMON.prototype.showMessage("Select Production Order", "Process Time Tracker");
            return false;
        }
        var iProductionOrderId = data.iProdOrderId;
        var iProcessId = 0;
        if (iType != 4) {
            iProcessId = document.getElementById("PTT_processName").value;
            if (iProcessId == 0 || iProcessId == undefined || iProcessId == null || iProcessId == "") {
                COMMON.prototype.showMessage("Select Process", "Process Time Tracker");
                return false;
            }
        }

        var ProcessQuantity = document.getElementById("PTT_ProcessQuantity").value;
        var OutputQuantity = document.getElementById("PTT_OutputQuantity").value;
        var Remarks = document.getElementById("PTT_Remarks").value;

        var lstEmployee = [];

        for (var i = 0; i < PTT.lstEmployee.length; i++) {
            if (PTT.lstEmployee[i].iEmployeeId != 0) {
                if (PTT.lstEmployee[i].id == 0) {
                    PTT.lstEmployee[i].iProductionOrderId = iProductionOrderId;
                    PTT.lstEmployee[i].iProcessId = iProcessId;

                    element = document.getElementById("PTT_Operation");
                    element.value = iType;
                    var OperationTypeId = document.getElementById("PTT_Operation").value;
                    var OperationTypeName = document.getElementById("PTT_Operation").children[document.getElementById("PTT_Operation").selectedIndex].innerHTML;
                    PTT.lstEmployee[i].iOperationType = OperationTypeId;
                }
                lstEmployee.push(PTT.lstEmployee[i]);
            }
        }

        var bCancel = false;
        var bHold = false;

        if (iType == 3) {
            bHold = true;
        }
        else if (iType == 4) {
            bCancel = true;
        }

        var ActualStartDate = DATEPICKER.getDate("ActualStartDate");
        var ActualStartTime = FTIMECONTROL.getTime("ActualStartTime");

        var ActualEndDate = DATEPICKER.getDate("ActualEndDate");
        var ActualEndTime = FTIMECONTROL.getTime("ActualEndTime");


        if (iType == 2) {
            data = OPTIONCONTROL.getControlDataObject("FOption_PTT_ProductionOrder");
            if (PTT.iLastProcessId == iProcessId) {
                if (data.iOrderStatus != 4) {
                    COMMON.prototype.showMessage("Production not Completed to End the Process.Check Whether Production Order Closed or Not.", "Process Time Tracker");
                    return false;
                }
            }

            if (ActualStartDate > ActualEndDate) {
                COMMON.prototype.showMessage("Actual Start Date Should be greater than Actual End Date", "Process Time Tracker");
                return false;
            }
            if (ActualStartDate == ActualEndDate) {
                if (ActualStartTime > ActualEndTime) {
                    COMMON.prototype.showMessage("Actual Start Time Should be greater than Actual End Time", "Process Time Tracker");
                    return false;
                }
            }
        }

        var lActualStartDate = 0;
        var lActualEndDate = 0;

        var iNodeSeq = 0;
        var lScheduledStartDatetime = 0;
        var lScheduledEndDateTime = 0;
        var ScheduleNodeDtls = [];
        if (PTT.objProcessTrackerData.ScheduleNodeDtls != null && PTT.objProcessTrackerData.ScheduleNodeDtls != undefined && PTT.objProcessTrackerData.ScheduleNodeDtls.length>0) {
            iNodeSeq = PTT.objProcessTrackerData.ScheduleNodeDtls[0].iNodeNo;
            lScheduledStartDatetime = PTT.objProcessTrackerData.ScheduleNodeDtls[0].lScheduleStratDate;
            lScheduledEndDateTime = PTT.objProcessTrackerData.ScheduleNodeDtls[0].lScheduleEndDate;
            ScheduleNodeDtls = PTT.objProcessTrackerData.ScheduleNodeDtls;
        }

        var objProcessTrackerData = {
            iProductionOrderId: iProductionOrderId,
            iProcessId: iProcessId,
            dInputQty: ProcessQuantity,
            dOutputQty: OutputQuantity,
            sRemarks: Remarks,
            lstEmployee: lstEmployee,
            iRemarksType: iType,
            iNodeSeq: iNodeSeq,
            bCancel: bCancel,
            iProcessStatus: iType,
            bHold: bHold,
            lActualStartDate: lActualStartDate,
            lActualEndDate: lActualEndDate,
            lScheduledStartDatetime: lScheduledStartDatetime,
            lScheduledEndDateTime: lScheduledEndDateTime,
            ScheduleNodeDtls: ScheduleNodeDtls
        };

        NETWORK.executeServerMethod(GLOBAL.getContextPath("SaveProcessTimeTrackerData", "ProcessTimeTracker", "MRP"),
          true, { objProcessTrackerData: objProcessTrackerData, DateTimes: [ActualStartDate, ActualStartTime, ActualEndDate, ActualEndTime]
