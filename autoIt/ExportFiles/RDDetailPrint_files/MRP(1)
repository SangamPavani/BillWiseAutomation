                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "Batch") {
                        debugger
                        if (ERF_PRODUCTION.bBatchEnable) {
                            //if (ERF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStockbyBatch != true) {
