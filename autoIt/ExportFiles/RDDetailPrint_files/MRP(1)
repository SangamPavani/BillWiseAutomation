    onAttachingItemGridCellChange: function (cellobj, event) {
        try {
            //debugger;
            if (MAPTEST_PRODUCT.bFromEdit == false) {
                var GridID = "Id_AttachingItemDetail_Grid";
                var ControlId = cellobj.ColumnAttribute.ctrlid;

                if (cellobj.bLeave == true) {     // On Leave Event
                    switch (cellobj.iColumn) {
                        case 2:
                            var productId = parseInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));
                            var bExisting = false;
                            bExisting = MAPTEST_PRODUCT.IsProductExists(MAPTEST_PRODUCT.arrExistingProduct, productId);
                            var rowCount = FGRIDCONTROL.getTotalRows(GridID);
                            for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                                if (iRowIndex != cellobj.iRow) {
                                    var cell = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 2);
                                    var cellValue = cell.getCellData("value");
                                    if (cellValue != "" && cellValue != undefined) {
                                        if (parseInt(cellValue) == productId) {
                                            bExisting = true;
                                            COMMON.prototype.showMessage("This Item Already Added", "Error Message");
                                            return false;
                                            break;
                                        }
                                    }
                                }
                            }
                            if (!bExisting && productId > 0) {
                                //debugger
                                
                                var urlPath = GLOBAL.getContextPath("GetExistingTestProducts", "MapTestToProducts", MAPTEST_PRODUCT.GetQualityControlAreaName());
                                var fnResult = NETWORK.executeServerMethod(urlPath, true, { TestDefHeaderId: productId, bForProduct: true }, "json", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                                if (fnResult.data.length > 0) {
                                    var sTestNames = "";
                                    for (var i = 0; i < fnResult.data.length; i++) {
                                        OPTIONCONTROL.setControlValue("FOption_ExistingTestName", fnResult.data[i].TestDefHeaderId)
                                        dataFields = OPTIONCONTROL.getControlDataObject("FOption_ExistingTestName");
                                        sTestNames += dataFields.sTestName + ", ";
                                    }
                                    sTestNames = sTestNames.slice(0, -2);
                                    COMMON.prototype.showMessage("This Product Already Mapped with these Tests : " + sTestNames + ". Cannot be Added.", "Error Message");
                                    return false;
                                } else {
                                    cellobj.setCellData("value", productId);
                                    cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                                    FGRIDCONTROL.setColumnCheckboxState(GridID, cellobj.iRow, 1, true);

                                    var datafields = OPTIONCONTROL.getControlDataObject("FOption_ItemGroupName");
                                    var cellobjItem = FGRIDCONTROL.getCellObject("Id_AttachingItemDetail_Grid", cellobj.iRow, 3)
                                    cellobjItem.setCellText(datafields.sCode);
                                    cellobjItem.setCellData("value", productId);
                                }
                            }
                            break;
                        case 1:
                            cellobj.processDefault();
                            break;
                        default:
                            cellobj.processDefault();
                    }
                }
                else {
                    if (cellobj.iColumn == 2) {
                        var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setControl(element, cellobj.getCellData("value"));
                    } else if (cellobj.iColumn == 4) {
                        cellobj.setCellText("");
                        var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setControl(element, cellobj.getCellData("value"));
                    }

                    else
                        cellobj.processDefault();
                }
            }
            return (true);
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {MAPTEST_PRODUCT.onAttachingItemGridCellChange} " + err.message, "Exception");
        }
    },

    onExistingTestDetailGridCellChange: function (cellobj, event) {
        try {
            //debugger;
            var GridID = "Id_ExistingTestDetail_Grid";
            var ControlId = cellobj.ColumnAttribute.ctrlid;

            if (cellobj.bLeave == true) {     // On Leave Event
                switch (cellobj.iColumn) {
                    case 2:
                        var productId = parseInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));
                        var bExisting = false;
                        bExisting = MAPTEST_PRODUCT.IsProductExists(MAPTEST_PRODUCT.arrExistingProduct, productId);
                        var rowCount = FGRIDCONTROL.getTotalRows(GridID);
                        for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                            if (iRowIndex != cellobj.iRow) {
                                var cell = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 2);
                                var cellValue = cell.getCellData("value");
                                if (cellValue != "" && cellValue != undefined) {
                                    if (parseInt(cellValue) == productId) {
                                        bExisting = true;
                                        COMMON.prototype.showMessage("This Test Already Added", "Error Message");
                                        return false;
                                        break;
                                    }
                                }
                            }
                        }
                        if (!bExisting && productId > 0) {
                            cellobj.setCellData("value", productId);
                            cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                            var datafields = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setCellData("testtype", datafields.bTestType);
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cellobj.iRow, 1, true);

                            if (window.GlobalPref.Version == eVersion.Version10) {
                                var cellobjdata = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 4)
                                cellobjdata.setCellText(cellobj.iRow);
                                cellobjdata.setCellData("value", cellobj.iRow);
                                MAPTEST_PRODUCT.arrangeSequence();
                            }
                            //var cellobjdata = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 4)
                            //cellobjdata.setCellText(cellobj.iRow);
                            //cellobjdata.setCellData("value", cellobj.iRow);
                            //MAPTEST_PRODUCT.arrangeSequence();
                        }
                        break;
                    case 1:
                    case 3:
                        cellobj.processDefault();
                        break;
                   
                    case 4:
                        if (window.GlobalPref.Version == eVersion.Version9) {
                            var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            var text = parseInt(element.value.trim());
                            var rowCount = FGRIDCONTROL.getTotalRows(GridID);
                            if (isNaN(text)) {
                                COMMON.prototype.showMessage("Enter Sequence", "Error Message");
                                return false;
                            }
                            for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                                var cell = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 4);
                                var cellValue = cell.getCellData("value");
                                if (cellValue == text && iRowIndex != cellobj.iRow) {
                                    COMMON.prototype.showMessage("This Sequence is Already Added", "Error Message");
                                    return false;
                                    break;
                                }
                            }

                            if (isNaN(text)) {
                                text = cellobj.iRow;
                            } else {
                                text = text;
                            }
                            cellobj.setCellText(text);
                            cellobj.setCellData("value", text);
                        }
                        break;
                    default:
                        cellobj.processDefault();
                }
            }
            else {
                if (cellobj.iColumn == 2) {
                    var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    cellobj.setControl(element, cellobj.getCellData("value"));
                }
                else if (cellobj.iColumn == 4 && window.GlobalPref.Version == eVersion.Version9) {
                cellobj.setCellText("");
                var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                cellobj.setControl(element, cellobj.getCellData("value"));
                }
            else
                cellobj.processDefault();
            }
            return (true);
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {MAPTEST_PRODUCT.onExistingTestDetailGridCellChange} " + err.message, "Exception");
        }
