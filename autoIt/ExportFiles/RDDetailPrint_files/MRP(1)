    // Grid Cell change events. Which is Hidden Grid
    QuantityBreakupGridCellChange: function (cellobj, event) {
        try {
            //debugger
            var GridID = "Id_QunatityBreakup_Grid";
            var rowCount = FGRIDCONTROL.getTotalRows(GridID);

            if (cellobj.bLeave == true) {     // On Leave Event
                switch (cellobj.iColumn) {

                    case QuantityBreakup.NoOfTestes + 2:
                        var FinalResultId = document.getElementById("ddlFinalResult").value;
                        var FinalResultName = document.getElementById("ddlFinalResult").children[document.getElementById("ddlFinalResult").selectedIndex].innerHTML
                        cellobj.setCellData("value", FinalResultId);
                        cellobj.setCellText(FinalResultName);

                        QuantityBreakup.PassedAndFailed[cellobj.iRow - 1] = FinalResultName;

                        document.getElementById("txtQtyPassed").value = QuantityBreakup.PassedAndFailed.filter(QuantityBreakup.ispassed).length;
                        document.getElementById("txtQtyFailed").value = QuantityBreakup.PassedAndFailed.filter(QuantityBreakup.isfailed).length;
                        break;
                    default:
                        cellobj.processDefault(event);
                        break;
                }
            }
            else {      // On Enter Event
                switch (cellobj.iColumn) {
                    case QuantityBreakup.NoOfTestes + 2:
                        cellobj.setCellText("");
                        element = document.getElementById("ddlFinalResult");
                        cellobj.setControl(element);
                        iValue = 0;
                        if (COMMON.prototype.isInteger(cellobj.CellData.value) == true) {
                            iValue = parseInt(cellobj.getCellData("value"));
                        }
                        if (iValue <= 0) {
                            element.value = 0;
                        }
                        else {
                            element.value = iValue;
                        }
                        break;
                    default:
                        cellobj.processDefault(event);
                        break;
                }
            }
            return (true);


        } catch (err) {
            COMMON.prototype.showMessage("Exception: QuantityBreakup.QuantityBreakupGridCellChange " + err.message, QuantityBreakup.QuantityBreakupMsgs.QC_TD_msgException);
        }
    },

