    //////Capacity Planning

    // On Plan Orders
    // if bAdjust is True Get the selected Production Orders into arrProductionOrders
    // First Checks Whether Child Production Orders are Planned Or Not 
    // Open Adjust Plan Orders Screen
    //
    // if bAdjust is False Get the selected Production Orders into arrProductionOrders
    // Push Selected WorkCenter in to arrWorkCenterInfo
    // select atleast one Production Order Or one Workcenter
    // Checks Whether Child Production Orders are Planned Or Not 
    // Plans Schedules and LOad the Data in View
    PlanOrders: function (bAdjust) {
        //debugger;
        if (MRPProductionOrderDetails.bPlanOrders == 1) {
            //debugger;


            if (bAdjust) {
                var arrProductionOrders = [];
                var sGrid = MRPProductionOrderDetails.GetGridElement().id;
                var iTotalRows = FGRIDCONTROL.getTotalRows(sGrid);

                for (var i = 0; i < iTotalRows; i++) {
                    var ObjCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, 1);
                    if (ObjCell.cell.firstChild.checked) {
                        arrProductionOrders.push(MRPProductionOrderDetails.lstPendingProductionOrders[i]);
                    }
                }

                var arriSchStartDateTime = [];
                for (var i = 0; i < arrProductionOrders.length; i++) {
                    var url = "";
                    if (window.GlobalPref.Version == eVersion.Version10) {
                        url = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "MRPPoductionHierarchy", "MRP");
                    } else {
                        url = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "ManualScheduling", "MRP");
                    }
                    var Result = NETWORK.executeServerMethod(url,
                                   true,
                                  {
                                      iProductionOrderId: arrProductionOrders[i].iProductionOrderId
                                  },
                                "JSON", false);
                    var iSchStartDateTime = 0;
                    var sProductionOrderNo = arrProductionOrders[i].ProductionOrderNo;
                    if (Result.lValue > 0) {
                        var data = Result.data;
                        if (data.bStatus == false || data.bStatus == "false") {
                            //COMMON.prototype.showMessage("Schedule " + data.ProductionOrderNos + "to Plan Production Order: " + sProductionOrderNo, "Manual Scheduling");
                            COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.lblScheduleReport + " " + data.ProductionOrderNos + " " + MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgToPlanProductionOrder + ": " + sProductionOrderNo, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                            return;
                        }
                        iSchStartDateTime = data.iMaxEndDate;
                        arriSchStartDateTime.push(iSchStartDateTime);
                    }
                }

                NETWORK.executeServerMethod(GLOBAL.getContextPath("AdjustPlanOrders", "CapacityPlanning", "MRP"),
                    true, { lstProductionOrders: arrProductionOrders },
                    "",
                    false,
                    "MRPProductionOrderDetails.PlanOrders_onSuccess",
                    "GLOBAL.LoadingStart",
                    "GLOBAL.LoadingEnd", bAdjust);
            }
            else {
                var arrProductionOrders = [];
                var arrWorkCenterInfo = [];
                var sGrid = "Id_AdjustPlanOrders_Grid";
                var iTotalRows = FGRIDCONTROL.getTotalRows(sGrid);

                for (var i = 0; i < iTotalRows; i++) {
                    var ObjCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, 1);
                    if (ObjCell.cell.firstChild.checked) {
                        arrProductionOrders.push(MRPProductionOrderDetails.lstAdjustProducionOrder[i]);
                    }
                }

                var arrWorkCenterInfo = [];
                var sGrid = "Id_AdjustWorkCenterDetails_Grid";
                var iTotalRows = FGRIDCONTROL.getTotalRows(sGrid);

                for (var i = 0; i < iTotalRows; i++) {
                    var ObjCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, 1);
                    if (ObjCell.cell.firstChild.checked) {
                        arrWorkCenterInfo.push(MRPProductionOrderDetails.lstAdjustWorkCenterInfo[i]);
                    }
                }


                if (arrProductionOrders.length == 0) {
                    COMMON.prototype.showMessage("Select Production Order.", "Manual Scheduling");
                    return false;
                }

                if (arrWorkCenterInfo.length == 0) {
                    COMMON.prototype.showMessage("Select Work Center", "Manual Scheduling");
                    return false;
                }


                var arriSchStartDateTime = [];
                for (var i = 0; i < arrProductionOrders.length; i++) {
                    var url = "";
                    if (window.GlobalPref.Version == eVersion.Version10) {
                        url = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "MRPPoductionHierarchy", "MRP");
                    } else {
                        url = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "ManualScheduling", "MRP");
                    }
                    var Result = NETWORK.executeServerMethod(url,
                                   true,
                                  {
                                      iProductionOrderId: arrProductionOrders[i].iProductionOrderId
                                  },
                                "JSON", false);
                    var iSchStartDateTime = 0;
                    var sProductionOrderNo = arrProductionOrders[i].ProductionOrderNo;
                    if (Result.lValue > 0) {
                        var data = Result.data;
                        if (data.bStatus == false || data.bStatus == "false") {
                            //COMMON.prototype.showMessage("Schedule " + data.ProductionOrderNos + "to Plan Production Order: " + sProductionOrderNo, "Manual Scheduling");
                            COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.lblScheduleReport + " " + data.ProductionOrderNos + " " + MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgToPlanProductionOrder + ": " + sProductionOrderNo, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                            return;
                        }
                        iSchStartDateTime = data.iMaxEndDate;
                        arriSchStartDateTime.push(iSchStartDateTime);
                    }
                }

                var SelectedDate = document.getElementById("ScheduleStartDate_PlanOrders_Adjust").value;
                var SelectedTime = document.getElementById("ScheduleStartTime_PlanOrders_Adjust").value;
                var arrSelectedDate = SelectedDate.split("/");
                var arrSelectedTime = SelectedTime.split(":");
                var SelectedDateTime = new Date(arrSelectedDate[2], (parseInt(arrSelectedDate[1]) - 1), arrSelectedDate[0], arrSelectedTime[0], arrSelectedTime[1], 0, 0);

                var PresentDateTime = new Date();

                if (PresentDateTime > SelectedDateTime) {
                    //COMMON.prototype.showMessage("Schedule Cannot be started before current Date and Time", "Manual Scheduling");
                    COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgScheduleCannotBeStartedBeforeCurrentDateAndTime, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                    return;
                }

                var iScheduleStartDate = DATEPICKER.getDate("ScheduleStartDate_PlanOrders_Adjust");
                var iScheduleStartTime = FTIMECONTROL.getTime("ScheduleStartTime_PlanOrders_Adjust");

                //var iRoutingId = iRoutingId;
                NETWORK.executeServerMethod(GLOBAL.getContextPath("PlanOrders", "CapacityPlanning", "MRP"),
                   true, {
                       lstProductionOrders: arrProductionOrders,
                       iScheduleStartDate: iScheduleStartDate,
                       iScheduleStartTime: iScheduleStartTime,
                       lstWorkCenterInfo: arrWorkCenterInfo,
                       arriSchStartDateTime: arriSchStartDateTime
                   },
                   "",
                   false,
                   "MRPProductionOrderDetails.PlanOrders_onSuccess",
                   "GLOBAL.LoadingStart",
                   "GLOBAL.LoadingEnd", bAdjust);
            }
        }
        else if (MRPProductionOrderDetails.iProfileId == -1) {

            var ProductionOrders = {};
            var sGrid = MRPProductionOrderDetails.GetGridElement().id;
            var iTotalRows = FGRIDCONTROL.getTotalRows(sGrid);
            var ObjCell = null;
            for (var i = 0; i < iTotalRows; i++) {
                ObjCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, 1);
                if (ObjCell.cell.firstChild.checked) {
                    ProductionOrders = MRPProductionOrderDetails.lstPendingProductionOrders[i];
