                                }
                                else {
                                    cell.cell.innerHTML = "<span class='fa fa-circle bom-childProd-icon' data-lavel='" + Treelavel + "' data-childid='" + data[i].iPDRChildID + "' data-parentid='" + data[i].iPDRParentID + "'></span><label class='Flabel'>" + data[i].sProductName + "</label>";
                                }
                                if (i > 0) {
                                    cell.cell.style.paddingLeft = ((Treelavel) * 20) + 4 + "px";
                                }
                            }
                            else
                                cell.setCellText(data[i].sProductName);
                            cell.setCellData("value", data[i].sProductName);
                            break;
                        case 2:
                            cell.setCellText(data[i].sProductCode);
                            cell.setCellData("value", data[i].sProductCode);
                            break;
                        case 3:
                            cell.setCellText(data[i].sReplenishmentTypeName);
                            cell.setCellData("value", data[i].sReplenishmentTypeName);
                            break;
                        case 4:
                            cell.setCellText(data[i].sProductType);
                            cell.setCellData("value", data[i].sProductType);
                            break;
                        case 5:

                            var procureType = "";
                            if (data[i].iProcureType == 0) {
                                procureType = "Default";
                            }
                            else if (data[i].iProcureType == 1) {
                                procureType = "Always Procure";
                            }
                            else if (data[i].iProcureType == 2) {
                                procureType = "Do Not Check For Availability";
                            }
                            else if (data[i].iProcureType == 3) {
                                procureType = "Always Produce";
