    // Adjust All sub child product quantities based on parent quantity
    QuantityAdjustment: function (arrChilds, index, qtyVal, mainActualQty, rowIndex,strConditions) {
        //debugger;
        if (strConditions.length > 0) {
            strConditions = strConditions+ " & " ;
        }
        rowIndex = rowIndex + 1;
        var bodyTagCount = 0;
        if (RELEASE_PO.arrBodyTag != null) {
            bodyTagCount = bodyTagCount + RELEASE_PO.arrBodyTag.length;
        }
        var bAllow = false;//RELEASE_PO.IsProcurementDoneForPO(arrChilds.iMasterId);
        var GridID = "Id_ReleaseProductionOrder_Grid";
        qtyPerUnit = arrChilds.dActualQuantity / mainActualQty;
        //totalRows = FGRIDCONTROL.getTotalRows(GridID);
        //for (var j = rowIndex; j <= totalRows; j++) {
        var cell8 = FGRIDCONTROL.getCellObject(GridID, rowIndex, (8 + bodyTagCount));
        parentid = cell8.getCellData("ParentId");
        if (arrChilds.iParentId == parentid) {

            remainValue = FGRIDCONTROL.getCellObject(GridID, rowIndex, (6 + bodyTagCount)).getCellData("value");
            if (remainValue != null && remainValue != undefined) {
                remainValue = parseFloat(remainValue);
                remainValue = isNaN(remainValue) == true ? 0 : remainValue;
            }
            else
                remainValue = 0;

            cell4 = FGRIDCONTROL.getCellObject(GridID, rowIndex, (4 + bodyTagCount));
            childActualQty = cell4.getCellData("value");
