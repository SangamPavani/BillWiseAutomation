            // Added while Moving of Sample size from Body to Header
            if (SAMPLECHECK.lstTestDetails != null && SAMPLECHECK.lstTestDetails.length > 0) {
                var factualSampleSize = 0;
                var fSampleSizePercent = SAMPLECHECK.lstTestDetails[0].SampleSize;
                var iRoundType = SAMPLECHECK.lstTestDetails[0].iRoundType;
                var qtyTested = document.getElementById("txtAvailableQty_SC").value;
                if (SAMPLECHECK.lstTestDetails[0].iSampleSizeType == 2) {
                    factualSampleSize = SAMPLECHECK.lstTestDetails[0].dExternalSampleSize;
                }
