        DATEPICKER.setDate('BOM_ToDate_' + VariantId, BOMHeader.ToDate, true);
        DATEPICKER.setDate('BOM_FROMDate_' + VariantId, BOMHeader.FromDate, true);
        if (BOMHeader.idefault == 1)
            document.getElementById('BOM_default_' + VariantId).checked = true;
        else
