        evaluateCellFormula: function (cellobj, objMetaData, bCheckForMandatory, iScreenId) {
            var sPreload = "";
            var sDefaultValue = "";
            var sFormula = "";
            var objCurrentValue = null;
            var objFormula = null;
            var objTemp = null;
            var result = null;

            try {
                sPreload = objMetaData.sPreload.toString();
                sDefaultValue = objMetaData.sDefaultValue.toString();
                bCheckForMandatory = FConvert.toBoolean(bCheckForMandatory);

                objCurrentValue = cellobj.getCellData();

                if (objMetaData.bReadOnly == false
                    || EntryMainCalculation.isEvaluationInputExist(sPreload, sDefaultValue) == false
                    || objMetaData.iDataTypeId == eMasterDataType.Master
                    || objMetaData.iDataTypeId == eMasterDataType.ExternalTable) {
                    objCurrentValue = cellobj.getCellData();
                }
                else {
                    if (objMetaData.bReadOnly == true
                        && EntryMainCalculation.isEvaluationInputExist(sPreload, sDefaultValue) == true
                        && EntryMainCommon.hasAutoRefresh(sPreload, sDefaultValue) == true) {
                        objCurrentValue = null;
                    }
                    else {
                        objCurrentValue = cellobj.getCellData();
                    }
                }

                if (FCommon.String.isNullOrEmpty(objCurrentValue) == false
                    && objMetaData.iDataTypeId == eMasterDataType.Fraction
                    && FConvert.toDecimal(objCurrentValue) == 0
                    && (FCommon.String.isNullOrEmpty(sPreload) == false || FCommon.String.isNullOrEmpty(sDefaultValue) == false)) {
                    objCurrentValue = null;
                }

                if (FCommon.String.isNullOrEmpty(sPreload, true) == false) {
                    result = MRPCommon.PRELOAD.evaluateBodyFormula(sPreload, cellobj.iRow, objCurrentValue, cellobj.iColumn - 1, iScreenId);
                }
                else if (FCommon.String.isNullOrEmpty(sDefaultValue, true) == false) {
                    objTemp = EntryMainCommon.getFormulaDetail(sDefaultValue);
                    if (objTemp.lValue > 0) {
                        if (objTemp.bRefresh == true || FCommon.String.isNullOrEmpty(objCurrentValue, true) == true) {
                            sFormula = objTemp.data;
                            switch (objMetaData.iDataTypeId) {
                                case eMasterDataType.Date:
                                    result = MRPCommon.PRELOAD.evaluateBodyFormula(sFormula, cellobj.iRow, null, cellobj.iColumn - 1, iScreenId);
                                    result = FConvert.toInt(result);
                                    break;
                                case eMasterDataType.Master:
                                case eMasterDataType.ExternalTable:
                                    result = MRPCommon.PRELOAD.evaluateBodyFormula(sFormula, cellobj.iRow, null, cellobj.iColumn - 1, iScreenId);
                                    result = FConvert.toInt(result);
                                    break;
                                default:
                                    objFormula = new FFormula();
                                    objFormula.m_CalType = transEntryInfo.CalendarType;
                                    if (objFormula.GetVariables(sFormula, true).length == 1 && sFormula.indexOf('(') == -1 && FCommon.String.startsWith(sFormula, "[") == false && FCommon.String.startsWith(sFormula, "]") == false) {
                                        var objVar = objFormula.getEmptyVariableParObject();
                                        objVar.Var = sFormula;
                                        //debugger;
                                        result = MRPCommon.PRELOAD.getVariableValue(objVar, cellobj.iRow, null, cellobj.iColumn - 1, iScreenId);
                                    }
                                    else {
                                        result = MRPCommon.PRELOAD.evaluateBodyFormula(sFormula, cellobj.iRow, null, cellobj.iColumn - 1, iScreenId);
                                    }
                                    break;
                            }
                        }
                        else {
                            result = objCurrentValue;
                        }
                    }
                    else {
                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                                if (bCheckForMandatory == true && FConvert.toString(objCurrentValue) == "" && FConvert.toInt(sDefaultValue) == 0) {
                                    return ("");
                                }

                                if (FConvert.toInt(objCurrentValue) == 0) {
                                    objCurrentValue = "";
                                }
                                break;
                            case eMasterDataType.Fraction:
                                if (bCheckForMandatory == true && FConvert.toString(objCurrentValue) == "" && FConvert.toDecimal(sDefaultValue) == 0) {
                                    return ("");
                                }

                                if (FConvert.toDecimal(objCurrentValue) == 0) {
                                    objCurrentValue = "";
                                }
                                break;
                        }

                        if (FCommon.String.isNullOrEmpty(objCurrentValue, true) == true) {
                            result = sDefaultValue;
                        }
                        else {
                            result = objCurrentValue;
                        }
                    }
                }
                else {
                    result = objCurrentValue;
                }
            }
            catch (err) {
                transEntryGlobal.showAlert("{TRANSACTION_ENTRY.FORMULA.evaluateCellFormula} " + err.message, "Exception");
            }

            return (result);
        },
        getVariableValue: function (objVar, iRowIndex, objTag, iColumnIndex, iScreenId) {
            var sAbbr = "";
            var iFactor = 0;
            var iFnNo = 0;
            var iRateIndex = 0;
            var value = 0;
            var result = null;
            var obj = null;
            var objResult = null;
            var arrLinks = null;
            var outputValue = "";
            var arrLinks = null;
            var cell = null;
            //debugger;
            try {
                if (FCommon.String.isNullOrEmpty(objVar.Var, true) == true) {
                    return (0);
                }

                if (DataType.isNumeric(objVar.Var) == true) {
                    return (FConvert.toDecimal(objVar.Var));
                }

                objVar.Var = objVar.Var.toLowerCase();

                iFactor = objVar.Var.indexOf('-') == 0 ? -1 : 1;

                if (iFactor == -1) {
                    objVar.Var = objVar.Var.substr(1);
                }

                if (iRowIndex < 1) {
                    iRowIndex = 1;
                }

                // {Block Start} Master Variable
                result = MRPCommon.PRELOAD.processMasterVariables(objVar, iFactor, iRowIndex, iScreenId);
                if (result.lValue > 0) {
                    return (result.data);
                }
                // {Block End} Master Variable

                if (window.GlobalPref.Version == eVersion.Version10) {
                    result = TRANSACTION_ENTRY.PRELOAD.processScreenBodyVariables(objVar, iFactor, iRowIndex);
                } else {
                    result = EntryMainPreload.processScreenBodyVariables(objVar, iFactor, iRowIndex);
                }
                if (result.lValue > 0) {
                    return (result.data);
                }
                if (window.GlobalPref.Version == eVersion.Version10) {
                    result = TRANSACTION_ENTRY.PRELOAD.processScreenFooterVariables(objVar, iFactor, iRowIndex);
                } else {
                    result = EntryMainPreload.processScreenFooterVariables(objVar, iFactor, iRowIndex);
                }
                if (result.lValue > 0) {
                    return (result.data);
                }
                if (window.GlobalPref.Version == eVersion.Version10) {
                    result = TRANSACTION_ENTRY.PRELOAD.processLayoutVariables(objVar, iFactor, iRowIndex);
                } else {
                    result = EntryMainPreload.processLayoutVariables(objVar, iFactor, iRowIndex);
                }
                if (result.lValue > 0) {
                    return (result.data);
                }

                iFnNo = 0;
                if (EntryMainCommon.isMatch("^sqlf[\\d]+$", objVar.Var) == true) {
                    iFnNo = FConvert.toInt(objVar.Var.substr(4));
                    objVar.Var = "sqlf";
                }

                if (EntryMainCommon.isMatch("^sqlsf[\\d]+$", objVar.Var) == true) {
                    iFnNo = FConvert.toInt(objVar.Var.substr(5));
                    objVar.Var = "sqlsf";
                }

                if (EntryMainCommon.isMatch("^pv[\\d]+$", objVar.Var) == true) {
                    iFnNo = FConvert.toInt(objVar.Var.substr(2));
                    objVar.Var = "pv";
                }

                iRateIndex = 0;
                if (objVar.Var.length > 5 && objVar.Var.indexOf("purrt") != -1 && objVar.Var != "purrtlst" && objVar.Var != "purrtgrp") {
                    iRateIndex = FConvert.toInt(objVar.Var.substr(5, objVar.Var.length - 5));
                    objVar.Var = objVar.Var.substr(0, 5);
                    if (objVar.arrParams == null) {
                        objVar.arrParams = [];
                    }
                    if (objVar.arrParams.length == 0) {
                        objVar.arrParams.push(iRateIndex);
                    }
                }

                if (objVar.Var.length > 5 && objVar.Var.indexOf("salrt") != -1 && objVar.Var != "salrtlst" && objVar.Var != "salrtgrp") {
                    iRateIndex = FConvert.toInt(objVar.Var.substr(5, objVar.Var.length - 5));
                    objVar.Var = objVar.Var.substr(0, 5);
                    if (objVar.arrParams == null) {
                        objVar.arrParams = [];
                    }
                    if (objVar.arrParams.length == 0) {
                        objVar.arrParams.push(iRateIndex);
