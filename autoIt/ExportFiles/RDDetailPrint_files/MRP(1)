                                else if (resultType == 2 && bFormulaCell == true) {
                                    cellobj.setCellText(isNaN(parseFloat(objCellData)) ? 0 : parseFloat(objCellData).toFixed(SAMPLECHECK.DecimalInQuantity), isNaN(parseFloat(objCellData)) ? 0 : parseFloat(objCellData).toFixed(SAMPLECHECK.DecimalInQuantity));
                                }
                                else {
                                    cellobj.setCellText(objCellData, objCellData);
                                }
                            }                           
                        }
                    }
                }
            }
            else {
                if (element != null) {
                    if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                        if (COMMON.prototype.isValidObject(element.selectedOptions[0])) {
                            cellobj.setCellText(element.selectedOptions[0].innerText, element.value);
