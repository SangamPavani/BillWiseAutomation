    // Reset the Order Grid data and clear filters value
    ClearGridRowData: function (sGridId, iNoOfRows) {
        FGRIDCONTROL.clearData(sGridId);
        var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
        if (totalRows < iNoOfRows) {
            FGRIDCONTROL.insertRows(sGridId, totalRows, (iNoOfRows - totalRows));
