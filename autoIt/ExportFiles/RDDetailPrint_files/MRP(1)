    //id=string type and it should be unique mandatory
    //arrValue=string[] type and it mandatory
    setControlData: function (id, arrValue) {
        var arrSelectedValues = [];
        if (id != undefined && id != null) {
            var controlEle = document.getElementById("ul_" + id);
            if (controlEle != null) {
                var lstCheckbox = controlEle.children;
                if (arrValue != undefined && arrValue != null && arrValue.length > 0) {
                    for (var count = 0; count < arrValue.length; count++) {
                        for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                            var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                            if ((arrValue[count].Name + "_" + arrValue[count].ID) == checkbox.value) {
                                checkbox.checked = true;
                                if (GlobalPref.Version == eVersion.Version9)
                                    arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                                else if (GlobalPref.Version == eVersion.Version10)
                                    arrSelectedValues.push(checkbox.dataset.name);
                                break;
                            }
                        }
                    }
                }
                else {
                    let checkBox = null;
                    for (let i = 0; i < lstCheckbox.length; i++) {
                        checkBox = lstCheckbox[i].children[0].children[0].children[0];
                        if (checkBox != null && checkBox != undefined)
                            checkBox.checked = false;
                    }
                }
            }
        }
        if (arrSelectedValues != null && arrSelectedValues != undefined && arrSelectedValues.length > 0) {
            document.getElementById("txtbox_" + id).value = arrSelectedValues.join(',');
            $("#txtbox_" + id).attr("title", arrSelectedValues.join(','));
            LISTCHECKBOXCONTROL.VARIABLES.selectedId = arrSelectedValues.join(",");
        }
        else {
            document.getElementById("txtbox_" + id).value = null;
            $("#txtbox_" + id).attr("title", null);
            LISTCHECKBOXCONTROL.VARIABLES.selectedId = null;
        }
    },
    clearControlData: function (id) {
        if (id != undefined && id != null) {
            var controlEle = document.getElementById("ul_" + id);
            if (controlEle != null) {
                var lstCheckbox = controlEle.children;
                for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                    var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                    checkbox.checked = false;
                }
            }
            document.getElementById("txtbox_" + id).value = "Please select...";
            $("#txtbox_" + id).attr("title", "");
        }
    },
    disableControl: function (id) {
        $("#" + id).css('pointer-events', 'none');
        $("#" + id).css('opacity', 0.5);
    },
    enableControl: function (id) {
        $("#" + id).css('pointer-events', 'auto');
        $("#" + id).css('opacity', 1);
    },
    getControlData: function (id) {
        var arrValues = [], iMasterTypeId;
        if (id == "doc_Accountdepandency")
            iMasterTypeId = 1;
        if (id == "doc_Productdepandency")
            iMasterTypeId = 2;
        if (id != undefined && id != null) {
            var controlEle = document.getElementById("ul_" + id);
            if (controlEle != null) {
                var lstCheckbox = controlEle.children;
                if (lstCheckbox != undefined && lstCheckbox != null && lstCheckbox.length > 0) {
                    for (var count = 0; count < lstCheckbox.length; count++) {
                        var checkbox = lstCheckbox[count].children[0].children[0].children[0];
                        if (checkbox.checked == true) {
                            arrValues.push({ ID: checkbox.dataset.id, Name: checkbox.dataset.name, Tag: iMasterTypeId });
                        }
                    }
                }
                else {
                    return null;
                }
            }
            else {
                return null;
            }
            return arrValues;
        }
        else {
            return null;
        }
    },
    setControlText: function (id) {
        var arrSelectedValues = [];
        var controlEle = document.getElementById("ul_" + id);
        if (controlEle != null) {
            var lstCheckbox = controlEle.children;
            if (lstCheckbox != undefined && lstCheckbox != null && lstCheckbox.length > 0) {
                for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                    var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                    if (checkbox.dataset.name == "Select All")
                        continue;
                    if (checkbox.checked == true) {
                        if (GlobalPref.Version == eVersion.Version9)
                            arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                        else if (GlobalPref.Version == eVersion.Version10)
                            arrSelectedValues.push(checkbox.dataset.name);


                    }
                }
            }
        }
        document.getElementById("txtbox_" + id).value = arrSelectedValues.join(',');
        $("#txtbox_" + id).attr("title", arrSelectedValues.join(','))
    },
    setControlTextAll: function (id) {
        var arrSelectedValues = [];
        var controlEle = document.getElementById("ul_" + id);
        if (controlEle != null) {
            var lstCheckbox = controlEle.children;
            if (lstCheckbox != undefined && lstCheckbox != null && lstCheckbox.length > 0) {
                var checkboxAll = lstCheckbox[0].children[0].children[0].children[0];
                if (checkboxAll.checked == true) {
                    for (var count1 = 1; count1 < lstCheckbox.length; count1++) {
                        var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                        checkbox.checked = true;
                        if (GlobalPref.Version == eVersion.Version9)
                            arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                        else if (GlobalPref.Version == eVersion.Version10)
                            arrSelectedValues.push(checkbox.dataset.name);
                    }
                }
                else if (checkboxAll.checked == false) {
                    arrSelectedValues = [];
                    for (var count1 = 1; count1 < lstCheckbox.length; count1++) {
                        var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                        checkbox.checked = false;
                    }
                }

            }
        }
        document.getElementById("txtbox_" + id).value = arrSelectedValues.join(',');
        $("#txtbox_" + id).attr("title", arrSelectedValues.join(','))
    },
    getControlText: function (id) {
        var arrSelectedValues = [];
        var controlEle = document.getElementById("ul_" + id);
        if (controlEle != null) {
            var lstCheckbox = controlEle.children;
            if (lstCheckbox != undefined && lstCheckbox != null && lstCheckbox.length > 0) {
                for (var count1 = 0; count1 < lstCheckbox.length; count1++) {
                    var checkbox = lstCheckbox[count1].children[0].children[0].children[0];
                    if (checkbox.checked == true) {
                        arrSelectedValues.push(checkbox.nextElementSibling.textContent);
                    }
                }
            }
        }
        return arrSelectedValues.join(',');
    },
    getAllBindingValue: function (id) {
        try {
            //debugger;
            let arrAllBindingOptions = JSON.parse($("div#" + id).attr("data-AllBindingOption"));
        }
        catch (Ex) {
            //debugger;
        }
    },
};
