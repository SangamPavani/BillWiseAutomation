    onProductGridChange: function (cellobj, event) {
        try {

            if (cellobj.bLeave == true) {       // On Leave Event
                switch (cellobj.iColumn) {
                    case 1:
                        cellobj.processDefault(event);
                        break;
                    case 2:
                        break;
                    case 3:
                        var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setCellText(element.value.trim());
                        cellobj.setCellData("value", element.value.trim());
                        break;
                    default:
                        break;
                }
            }
            else {      // On Enter Event
                switch (cellobj.iColumn) {
                    case 1:
                        cellobj.processDefault(event);
                        break;
                    case 2:
                        break;
                    case 3:
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setControl(element, cellobj.getCellData("value"));
                        break;
                    default:
                        break;
                }
            }
            return (true);
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {MRP_PROCESS.onProductGridChange} " + err.message, MRP_PROCESS.MRP_PROCESSMsgs.lblErrorMsg);
        }
