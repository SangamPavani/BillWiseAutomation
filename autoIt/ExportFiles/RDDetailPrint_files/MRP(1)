    // Get All Sub Products based on Lots Product selection of Product Tree.
    GetChildProducts: function () {
        //
        var arrChildProds = [];
        try {
            if (MRP_PROCESS.MRPSelectedProds != null) {
                var selectedMenu = MRP_TREEMENU.getSelectedMenu("LotsBreakup_ProductTree");
                for (var i = 0; i < MRP_PROCESS.MRPSelectedProds.length; i++) {
                    if (selectedMenu.isParent == "true") {
                        if (MRP_PROCESS.MRPSelectedProds[i].iProductID == selectedMenu.productId) {
                            arrChildProds.push(MRP_PROCESS.MRPSelectedProds[i]);
                        }
                    }
                    else {
                        if (MRP_PROCESS.MRPSelectedProds[i].iDocumentId == selectedMenu.documentId) {
                            arrChildProds.push(MRP_PROCESS.MRPSelectedProds[i]);
                        }
                    }
                }
            }
        }
        catch (e) {
            alert("Exception: {MRP_PROCESS.GetChildProducts} " + e.message);
        }
        return (arrChildProds);
    },
    // Get Main Product from selection of Products.
    GetParentProducts: function (arrProducts) {
        var ParentProds = [];
        try {
            for (var iParent = 0; iParent < arrProducts.length; iParent++) {
                var obj = ParentProds.find(item => item.iProductID == arrProducts[iParent].iProductID);
                if (obj == null || obj == undefined) {
                    if (iParent > 0) {
                        if (arrProducts[iParent - 1].iProductID != arrProducts[iParent].iProductID) {
                            ParentProds.push(arrProducts[iParent]);
                        }
                    }
                    else {
                        ParentProds.push(arrProducts[iParent]);
                    }
                }
            }
        }
        catch (e) {
            alert("Exception: {MRP_PROCESS.GetParentProducts} " + e.message);
        }
        return (ParentProds);
    },
