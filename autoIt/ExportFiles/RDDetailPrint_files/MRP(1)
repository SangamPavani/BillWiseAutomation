    //ExtraFields Validation
    LoadVoucherTags: function () {
        var VoucherTags = MRP_DEPREQ.arrVoucherHeaderTags;
        var sError = "";
        var arrVoucherHeaderData = [];

        for (var i = 0; i < MRP_DEPREQ.arrVoucherHeaderTags.length ; i++) {
            ////debugger
            var ele = "Id_Extra_" + i + "_TagDRR";
            var hndele = document.getElementById("hdnExtraid_" + ele).dataset;
            if (parseInt(hndele.imandatory) == 1) {
                var value = "";
                if (hndele.itype == 0 || hndele.itype == 6 || hndele.itype == 1) {
                    value = document.getElementById(ele).value;
                } else if (hndele.itype == 4) {
                    value = DATEPICKER.getDate(ele);
                } else if (hndele.itype == 8 || hndele.itype == 9) {
                    value = document.getElementById(ele).value;
                } else if (hndele.itype == 12) {
                    value = OPTIONCONTROL.getControlValue(ele);
                } else if (hndele.itype == 5) {
                    value = FTIMECONTROL.getTime(ele);
                }

                ////debugger
                if (value == null || value == "") {
                    sError = hndele.fieldname + " Field is Empty"
                    COMMON.prototype.showMessage(sError, "Error Message");
                    sError = "";
                    return false;
                } else {
                    var obj = {
                        iFieldId: MRP_DEPREQ.arrVoucherHeaderTags[i].iFieldId,
                        bBody: false,
                        objFieldValue: value,
                        sFieldName: hndele.fieldname
                    }
                    arrVoucherHeaderData.push(obj)
                    MRP_DEPREQ.arrVoucherHeaderTags[i].objFieldValue = value;
                }
            }
        }

        MRP_DEPREQ.arrVoucherHeaderDataF = arrVoucherHeaderData
        return VoucherTags;
    },

    GetHeaderExtraFields: function (id, data, tag) {
        try {
            //debugger
            var Value = "", text = "";
            var hidele = document.getElementById("hdnExtraid_" + id);
            if (data == null || data == undefined) {
                var itype = parseInt(hidele.dataset.itype);
                if (itype == 0 || itype == 6 || itype == 1) {
                    Value = document.getElementById(id).value;
                    text = document.getElementById(id).value;
                } else
                    if (itype == 8 || itype == 9) {
                        var ele = document.getElementById(id);
                        text = ele.options[ele.selectedIndex].text;
                        Value = ele.value;
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id);
                        }
            } else {
                hidele = document.getElementById("hdnExtraid_" + id);
                if (hidele != null) {
                    var itype = parseInt(hidele.dataset.itype);
                    if (itype == 12) {
                        Value = OPTIONCONTROL.getControlValue(id)
                    } else if (itype == 5) {
                        Value = FTIMECONTROL.getTime(id);
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id);
                        }
                }
            }
            if (Value == "" || Value == null) {
                if (itype == 0) {
                    Value = "";
                }
                else {
                    Value = 0;
                }
            }

            MRP_DEPREQ.arrVoucherHeaderTags[hidele.value].objFieldValue = Value;

        } catch (e) {
            COMMON.prototype.showMessage("Exception: {MRP_DEPREQ.GetHeaderExtraFields} " + e.message, MRP_DEPREQ.MRP_DEPREQMsgs.lblErrorMsg);
        }
    },

