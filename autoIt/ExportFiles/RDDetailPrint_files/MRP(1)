    // On Plan Schedule Button Click
    // First Checks Whether Child Production Orders are Planned Or Not 
    // If not then raises a error Message and returns
    // If all Child Production Orders are Planned then the Max End date time is Taken as Schedule Start Date Time for the Current Production Order
    // Schedule Can not be Started before Current Start date time
    // Plans the Selected Production Order
    OnPlanScheduleClick: function (iProductId, ScheduleStartTimeId, ScheduleStartDateId, sProductionOrderNo, sProductName, ProductCode, dQuantity, iRoutingId, ProductionOrder, Element, DueDate) {
        try {
            //debugger

            MRPProductionOrderDetails.ResetJavascript();

            //Sorting the Work Center as per the date time
            MRPProductionOrderDetails.UpdatedlstPPOrders = MRPProductionOrderDetails.lstPlannedProductionOrders;
            if (MRPProductionOrderDetails.UpdatedlstPPOrders != null || MRPProductionOrderDetails.UpdatedlstPPOrders.length > 0) {
                var iCurrentStartDate = DATEPICKER.getDate("CurrentScheduleStartDate");
                var iCurrentStartTime = FTIMECONTROL.getTime("CurrentScheduleStartTime");
                var url = GLOBAL.getContextPath("CombineDateTime", "ManualScheduling", "MRP");
                var sResult = NETWORK.executeServerMethod(url, true, { iStartDate: iCurrentStartDate, iStartTime: iCurrentStartTime }, "JSON", false);
                var sCurrentDateTime = sResult.data;
                for (var k = 0; k < MRPProductionOrderDetails.UpdatedlstPPOrders.length; k++) {
                    if (MRPProductionOrderDetails.UpdatedlstPPOrders[k].iSchStartDt < sCurrentDateTime && MRPProductionOrderDetails.UpdatedlstPPOrders[k].iSchEndtDt <= sCurrentDateTime) {
                        MRPProductionOrderDetails.UpdatedlstPPOrders.splice(k, 1);
                        k = 0;
                    }
                }
            }

            //debugger;
            var urlPath1 = "";
            if (window.GlobalPref.Version == eVersion.Version10) {
                urlPath1 = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "MRPPoductionHierarchy", "MRP");
            } else {
                urlPath1 = GLOBAL.getContextPath("ProductionHeirarchyScheduleStatus", "ManualScheduling", "MRP");
            }
            var Result = NETWORK.executeServerMethod(urlPath1,
                 true,
                {
                    iProductionOrderId: ProductionOrder
                },
                 "JSON", false);
            var iSchStartDateTime = 0;
            if (Result.lValue > 0) {
                var data = Result.data;
                if (data.bStatus == false || data.bStatus == "false") {
                    //COMMON.prototype.showMessage("Schedule " + data.ProductionOrderNos + "to Plan Production Order: " + sProductionOrderNo, "Manual Scheduling");
                    COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.lblScheduleReport + " " + data.ProductionOrderNos + MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgToPlanProductionOrder + ": " + sProductionOrderNo, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                    return;
                }
                iSchStartDateTime = data.iMaxEndDate;

            }


            var SelectedDate = document.getElementById(ScheduleStartDateId).value;
            var SelectedTime = document.getElementById(ScheduleStartTimeId).value;
            var arrSelectedDate = SelectedDate.split("/");
            var arrSelectedTime = SelectedTime.split(":");
            var SelectedDateTime = new Date(arrSelectedDate[2], (parseInt(arrSelectedDate[1]) - 1), arrSelectedDate[0], arrSelectedTime[0], arrSelectedTime[1], 0, 0);

            var PresentDateTime = new Date();

            if (PresentDateTime > SelectedDateTime) {
                //COMMON.prototype.showMessage("Schedule Cannot be started before current Date and Time", "Manual Scheduling");
                COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgScheduleCannotBeStartedBeforeCurrentDateAndTime, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                return;
            }

            var arrDuedate = DueDate.split("/");
            var PODuedate = new Date(arrDuedate[2], (parseInt(arrDuedate[1]) - 1), arrDuedate[0], 0, 0, 0, 0);
            var PODueDateTemp = new Date(PODuedate);
            PODueDateTemp.setDate(PODueDateTemp.getDate() + 1);

            if (PODueDateTemp < SelectedDateTime) {
                //COMMON.prototype.showMessage("Schedule Cannot be started after Due Date and Time", "Manual Scheduling");
                COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgScheduleCannotBeStartedafterDueDateAndTime, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
                return;
            }

            MRPProductionOrderDetails.iProductId = iProductId;
            MRPProductionOrderDetails.ScheduleStartTimeId = ScheduleStartTimeId;
            MRPProductionOrderDetails.ScheduleStartDateId = ScheduleStartDateId;
            MRPProductionOrderDetails.sProductionOrderNo = sProductionOrderNo;
            MRPProductionOrderDetails.sProductName = sProductName;
            MRPProductionOrderDetails.ProductCode = ProductCode;
            MRPProductionOrderDetails.dQuantity = dQuantity;
            MRPProductionOrderDetails.iRoutingId = iRoutingId;
            MRPProductionOrderDetails.ProductionOrder = ProductionOrder;
            MRPProductionOrderDetails.PendingOrdersSelectedIndex = Element.parentNode.parentNode.rowIndex - 1;
            MRPProductionOrderDetails.sLinkScheduleSelected = Element.id;
            var iScheduleStartDate = DATEPICKER.getDate(ScheduleStartDateId);
            var iScheduleStartTime = FTIMECONTROL.getTime(ScheduleStartTimeId);
            MRPProductionOrderDetails.DueDate = DueDate;
            MRPProductionOrderDetails.iSchStartDateTime = iSchStartDateTime;
            var urlPath = "";
            if (window.GlobalPref.Version == eVersion.Version10) {
                urlPath = GLOBAL.getContextPath("PlanSchedulePopUp", "MRPPoductionHierarchy", "MRP");
            } else {
                urlPath = GLOBAL.getContextPath("PlanSchedulePopUp", "ManualScheduling", "MRP");
            }            
            NETWORK.executeServerMethod(urlPath,
                         true,
                        {
                            iProductId: iProductId, sProdOrderNo: sProductionOrderNo, sProductName: sProductName,
                            sProductCode: ProductCode, iRoutingId: iRoutingId, dQuantity: dQuantity,
                            iScheduleStartDate: iScheduleStartDate, iScheduleStartTime: iScheduleStartTime,
                            bHoldSchedules: false, PlanScheduleDataToHold: null, lstPlanScheduleDataOnHold: null,
                            iCurrentNode: MRPProductionOrderDetails.CurrentNode, lstSelectedPlanScheduleData: null,
                            DueDate: MRPProductionOrderDetails.DueDate, iSchStartDateTime: MRPProductionOrderDetails.iSchStartDateTime
                        },
                         "HTML", true,
                        "MRPProductionOrderDetails.OnPlanScheduleClick_onSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");


        } catch (e) {
            alert("Exception: MRPProductionOrderDetails.OnPlanScheduleClick" + e.message);
        }
    },
