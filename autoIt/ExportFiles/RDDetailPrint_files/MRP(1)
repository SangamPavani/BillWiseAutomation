                            objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim(), PIORDER.iNoOfDecimals)));
                            break;
                        case PIO_CTRLTYPE.BOOLEAN:

                            break;
                        case PIO_CTRLTYPE.STRINGLIST:
                        case PIO_CTRLTYPE.NUMBERLIST:
                            var eleSelect = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            if (eleSelect.selectedIndex > -1) {
                                objCell.setCellData(eleSelect.options[eleSelect.selectedIndex].value);
                                objCell.setCellText(eleSelect.options[eleSelect.selectedIndex].text);
                            }
                            break;
                        case PIO_CTRLTYPE.DATE:
                            var docDate = DATEPICKER.getDate("fDatePicker_DocDate_PIO");
                            var CalenderType = DATEPICKER.getCalendarType('fDatePicker_DocDate_PIO');
                            var cDate = DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid);
                            //if (cDate < DATE.prototype.today(1)) {
                            if (cDate < DATE.prototype.today(CalenderType)) {
                                //COMMON.prototype.showMessage("Date cannot be less then today's date", "PIO"); // PIO Changed to Error Message
                                COMMON.prototype.showMessage(PIORDER.PIORDERMsgs.MRP_PIO_msgDateCannotBeLessthanTodaysDate, PIORDER.PIORDERMsgs.lblErrorMsg);
                            }
                            if (cDate < docDate) {
                                COMMON.prototype.showMessage("Due Date cannot be less than the Document Date", PIORDER.PIORDERMsgs.lblErrorMsg);
                            }
                            else {
                                objCell.setCellData("value", DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid));
                                objCell.setCellText(DATEPICKER.getText(objCell.ColumnAttribute.ctrlid));
                            }
                            break;
                        case PIO_CTRLTYPE.MASTER:
                            objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                            objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                            var iTempItem = isNaN(parseInt(OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid))) ? 0 : parseInt(OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                            if (objCell.ColumnAttribute.ctrlid == "FOption_ProductName_PIO") {
                                var cell = FGRIDCONTROL.getCellObject(objCell.Grid.id, objCell.iRow, 1);
                                if (iTempItem > 0) {
                                    cell.cell.className = "icon-info";
                                    cell.cell.style.fontWeight = "Bold";
                                    cell.cell.setAttribute("title", "View Extra Fields Info");
                                    cell.setCellData("txtiitem", iTempItem);
                                    PIORDER.GetExtraFields(iTempItem, objCell.iRow);
                                    //cell.cell.setAttribute("onclick", "PIORDER.OnClickShowCustomizeData(" + objCell.iRow + "," + objCell.iColumn + ")");
                                    //cell.cell.setAttribute("onmouseenter", "PIORDER.OnClickShowCustomizeData(" + (objCell.iRow) + "," + (objCell.iRow) + ")");
                                    //cell.cell.setAttribute("onmouseleave", "PIORDER.closePopupOver()");
                                } else {
                                    cell.cell.className = "";
                                    cell.cell.setAttribute("title", "");
                                    cell.setCellData("txtiitem", 0);
                                    //cell.cell.setAttribute("onmouseenter", "");
                                    //cell.cell.setAttribute("onmouseleave", "");
                                }
                            }
                            break;
                        case PIO_CTRLTYPE.EXTERNALTABLE:
                            break;
                    }
                    if (objCell.ColumnAttribute.colid == "Quantity_PIO") {
                        var sGridId = "Id_PlanIndependentOrder_Grid_PIO";
                        if (PIORDER.PIOEntryData.lstBody != null && PIORDER.IsMRP2Enabled() == true) {
                            if (PIORDER.PIOEntryData.lstBody[objCell.iRow - 1] != null && PIORDER.PIOEntryData.lstBody[objCell.iRow - 1] != undefined) {
                                if (PIORDER.PIOEntryData.lstBody[objCell.iRow - 1].bRePlanRequired == false) {
                                    if (PIORDER.PIOEntryData.lstBody[objCell.iRow - 1].dQuantity < parseFloat(objCell.getCellData("value"))) {
                                        var cell = FGRIDCONTROL.getCellObject(sGridId, objCell.iRow, 1);
                                        cell.setCellData("isreplanrequired", true);
                                    }
                                    else {
                                        var cell = FGRIDCONTROL.getCellObject(sGridId, objCell.iRow, 1);
                                        cell.setCellData("isreplanrequired", false);
                                    }
                                }
                            }
                        }
                        var rowCount = FGRIDCONTROL.getTotalRows(sGridId);
                        var iTotalQty = 0;
                        for (var Rowind = 1; Rowind < rowCount; Rowind++) {
                            // For Footer total Qty
                            var iQtyCell = 0;
                            var totalqtycellobj = FGRIDCONTROL.getCellObject(sGridId, Rowind, objCell.iColumn);
                            iQtyCell = isNaN(parseFloat(totalqtycellobj.getCellData("value"))) ? 0 : parseFloat(totalqtycellobj.getCellData("value"));
                            iTotalQty = iTotalQty + iQtyCell;

                            if (PIORDER.PIOEntryData.lstBody != null) {
                                if (Rowind <= PIORDER.PIOEntryData.lstBody.length) {
                                    var PrevQuantity = PIORDER.PIOEntryData.lstBody[Rowind - 1].dQuantity;
                                    var Rowcell = FGRIDCONTROL.getCellObject(sGridId, Rowind, objCell.iColumn);
                                    var Qunatitydata = Rowcell.getCellData("value");
                                    var iDetailId = PIORDER.PIOEntryData.lstBody[Rowind - 1].iDetailId;
                                    var urlPath = GLOBAL.getContextPath("GetPIOStutas", "PlanIndependentOrder", "MRP");
                                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { DetailId: iDetailId }, "json", false);
                                    var ResultStatus = fnResult.data;
                                    if (PrevQuantity > Qunatitydata) {
                                        if (ResultStatus == true) {
                                            var cell = FGRIDCONTROL.getCellObject(sGridId, Rowind, 2);
                                            Qunatitydata = "";
                                            //COMMON.prototype.showMessage("Quantity can not be modified for this order", "PIO"); // PIO Changed to Error Message
                                            COMMON.prototype.showMessage(PIORDER.PIORDERMsgs.MRP_PIO_msgQuantityCannotBeModifiedForThisOrder, PIORDER.PIORDERMsgs.lblErrorMsg);
                                            //cell.setCellText(PrevQuantity);
                                            cell.setCellData("value", PrevQuantity);
                                            cell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(PrevQuantity, PIORDER.iNoOfDecimals)));
                                        }
                                    }
                                }
                            }
                        }

                        var Footergridid = sGridId + "_row_footer";
                        Footcell = document.getElementById(Footergridid);
                        var stylep = "";
                        if (PIORDER.IsMRP2Enabled()) {
                            stylep = "border: 1px solid #ccc; word-wrap:break-word; white-space: normal; min-width: 200px; max-width: 200px; text-align: left;padding:0px;";
                        } else {
                            stylep = "border: 1px solid #ccc; word-wrap:break-word; white-space: normal; min-width: 200px; max-width: 200px; text-align: left;padding:0px;";
                        }
                        Footcell.children[objCell.iColumn].setAttribute("style", stylep);

                        Footcell.children[objCell.iColumn].innerHTML = FConvert.addNumericSeparator(FConvert.toDecimal(iTotalQty, PIORDER.iNoOfDecimals));
                        Footcell.children[objCell.iColumn].innerText = FConvert.addNumericSeparator(FConvert.toDecimal(iTotalQty, PIORDER.iNoOfDecimals));
                    }
                }
                else if (objCell.ColumnAttribute.ctrldbl == "txtExtraInfo") {
                    objCell.processDefault(event);
                }
                else if (PIORDER.IsMRP2Enabled() == true) {
                    if (objCell.ColumnAttribute.ctrlid == "fDatePicker_ActualDueDate_PIO") {
                        objCell.processDefault(event);
                        // objCell.setCellData("value", DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid));
                        // objCell.setCellText(DATEPICKER.getText(objCell.ColumnAttribute.ctrlid));
                    }
                    else if (objCell.ColumnAttribute.ctrlid == "txtActualProductQuantity_PIO") {
                        // objCell.setCellData("value", document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim());
                        // objCell.setCellText(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim());
                        objCell.processDefault(event);
                    }
                } else if (objCell.ColumnAttribute.ctrlid == "imginfo") {
                    objCell.processDefault(event);
                }
            }
            else {      // On Enter Event
                //debugger;
                var GridID = "Id_PlanIndependentOrder_Grid_PIO";
                var iTotalColumns = FGRIDCONTROL.getTotalColumns(GridID);
                if (objCell.ColumnAttribute.ctrlid == "FOption_ProductName_PIO") {
                    var rowIndex = objCell.iRow;
                    var iCountervalue = parseInt(document.getElementById("hdnProduct_ColumnIndex_PIOBody").value);
                    var RowCellIsplanned = FGRIDCONTROL.getCellObject(GridID, rowIndex, (iCountervalue + 6));
