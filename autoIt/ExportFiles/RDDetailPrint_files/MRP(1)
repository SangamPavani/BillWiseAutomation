    // Checking of Tolerance as for the given passed from and passed to values
    CheckTolerance: function (iRowIndex) {
        GridID = "Id_TestDefinitionDetail_Grid";
        var cell2 = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 2);
        var resultType = cell2.getCellData("resulttype");
        if (resultType != null && resultType != undefined && resultType != "") {
            if (resultType == 1 || resultType == 2) {
                var val = parseFloat(document.getElementById("txtTolerance_TD").value.trim()).toFixed(TESTDEFINITION.DecimalInQuantity);
                val = parseFloat((isNaN(val) == true) ? 0 : (val > 100 ? 100 : val)).toFixed(TESTDEFINITION.DecimalInQuantity);
                var minSpec = parseFloat(cell2.CellData.minspec).toFixed(TESTDEFINITION.DecimalInQuantity);
                var maxSpec = parseFloat(cell2.CellData.maxspec).toFixed(TESTDEFINITION.DecimalInQuantity);
                var passedFrom = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 5).getCellData("value");
                var passedTo = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 6).getCellData("value");
                if (passedFrom == "" && passedTo == "") {
                    return
                }
                passedFrom = parseFloat((isNaN(parseFloat(passedFrom)) == true) ? 0 : passedFrom).toFixed(TESTDEFINITION.DecimalInQuantity);
                passedTo = parseFloat((isNaN(parseFloat(passedTo)) == true) ? 0 : passedTo).toFixed(TESTDEFINITION.DecimalInQuantity);

                var rangeFrom = parseFloat(passedFrom) - parseFloat((passedFrom * val / 100));
                var rangeTo = parseFloat(passedTo) + parseFloat((passedTo * val / 100));
                if (minSpec > rangeFrom || maxSpec < rangeTo) {
                    //COMMON.prototype.showMessage("Tolerance Crossed the Range", "Error Message");
                    COMMON.prototype.showMessage(TESTDEFINITION.TESTDEFINITIONMsgs.msgTD_ToleranceChk, TESTDEFINITION.TESTDEFINITIONMsgs.lblErrorMsg);
                    cellobj = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 7);
                    cellobj.setCellData("value", "");
                    cellobj.setCellText("");
                    document.getElementById("txtTolerance_TD").value = "";
                }
                else {
                    cellobj = FGRIDCONTROL.getCellObject(GridID, iRowIndex, 7);
                    cellobj.setCellData("value", val);
                    cellobj.setCellText(val);
                }
                //if (!bValidate && val > 0) {
                //    cellobj.setCellData("value", 0);
                //    cellobj.setCellText(0);
                //}
            }
        }


    },

