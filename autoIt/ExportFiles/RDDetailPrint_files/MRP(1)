    ValidateRaisedPOForExploadBOM: function () {
        try {
            //
            var sGridId = "Id_RaisePO_FGrid";
            var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
            for (var i = 0; i < totalRows; i++) {
                var bmCell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 6);
                var bmId = OPTIONCONTROL.getControlValue(bmCell.ColumnAttribute.ctrlid);
                bmId = isNaN(parseInt(bmId)) == true ? 0 : parseInt(bmId);
                if (bmId <= 0) {
                    //COMMON.prototype.showMessage("Select BOM for Order No: " + MRP_PROCESS.arrRaisingPO[i].sProductionOrderNo, "MRP Process"); //MRP Process Change To Error Message
                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgSelectBOMForOrderNo + ": " + MRP_PROCESS.arrRaisingPO[i].sProductionOrderNo, MRP_PROCESS.MRP_PROCESSMsgs.lblErrorMsg);
                    return false;
                }
                if (FGRIDCONTROL.getColumnCheckboxState(sGridId, (i + 1), 12) == true) {
                    var vendorCell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 13);
                    var vendorId = OPTIONCONTROL.getControlValue(vendorCell.ColumnAttribute.ctrlid);
                    vendorId = isNaN(parseInt(vendorId)) == true ? 0 : parseInt(vendorId);
                    if (vendorId <= 0) {
                        //COMMON.prototype.showMessage("Select Vendor for Order No: " + MRP_PROCESS.arrRaisingPO[i].sProductionOrderNo, "MRP Process"); //MRP Process Change To Error Message
                        COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgSelectVendorForOrderNo + ": " + MRP_PROCESS.arrRaisingPO[i].sProductionOrderNo, MRP_PROCESS.MRP_PROCESSMsgs.lblErrorMsg);
                        return false;
                    }
                }
                if (MRP_PROCESS.arrRaisingPO[i].iProductionStartDate < DATE.prototype.addDays(DATE.prototype.today(MRP_PROCESS.CalanderType), 0, MRP_PROCESS.CalanderType)) {
                    //COMMON.prototype.showMessage("Production Start Date can not be less than current Production start Date", "MRP Process"); //MRP Process Change To Error Message
                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgProductionStartDateCannotBeLessThanCurrentProductionStartDate, MRP_PROCESS.MRP_PROCESSMsgs.lblErrorMsg);
                    return false;
                }
            }
            return true;
        }
        catch (e) {
            alert("Exception: MRP_PROCESS.ValidateRaisedPOForExploadBOM " + e.message);
            return false;
        }
    },
    // Update Variant Details on BOM/Vendor/Production Date changes.
    UpdateBOMVarient: function (prodOrderId, varientId, prodStartDate, isBackFlush, isTrailPO, isOutSource, vendorId, iUpdateFor) {
        try {
            if (MRP_PROCESS.IsValidObject(prodOrderId) == true &&
                MRP_PROCESS.IsValidObject(varientId) == true &&
                MRP_PROCESS.IsValidObject(prodStartDate) == true &&
                MRP_PROCESS.IsValidObject(isBackFlush) == true &&
                MRP_PROCESS.IsValidObject(isTrailPO) == true &&
                MRP_PROCESS.IsValidObject(isOutSource) == true &&
                MRP_PROCESS.IsValidObject(vendorId) == true &&
                MRP_PROCESS.IsValidObject(iUpdateFor) == true) {

                var urlPath = GLOBAL.getContextPath("SetUpdatedBOMVariant", "MRPProcess", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, {
                    ProdOrderId: prodOrderId,
                    VariantId: varientId,
                    ProdStartDate: prodStartDate,
                    IsBackFlush: isBackFlush,
                    IsTrailPO: isTrailPO,
                    IsOutSource: isOutSource,
                    VendorId: vendorId,
                }, "JSON", false);
                if (fnResult.lValue > 0 && fnResult.data != null) {
                    if (fnResult.data == false) {
                        if (iUpdateFor == 0) {
                            //COMMON.prototype.showMessage("Cannot Explode BOM for Selected BOM", "MRP");
                            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgCannotExplodeBOMForSelectedBOM, MRP_PROCESS.MRP_PROCESSMsgs.MRP);
                        }
                        else if (iUpdateFor == 1) {
                            //COMMON.prototype.showMessage("Cannot Explode BOM for Selected Production Start Date", "MRP");
                            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgCannotExplodeBOMForSelectedProductionStartDate, MRP_PROCESS.MRP_PROCESSMsgs.MRP);
                        }
                        else {
                            //COMMON.prototype.showMessage("Cannot Explode BOM for Selected out source Vendor", "MRP");
                            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgCannotExplodeBOMForSelectedOutSourceVendor, MRP_PROCESS.MRP_PROCESSMsgs.MRP);
                        }
                        return false;
                    }
                    else {
                        return true;
                    }
                }
            }
            return false;
        }
        catch (e) {
            alert("Exception: MRP_PROCESS.UpdateBOMVarient " + e.message);
            return false;
        }
    },
