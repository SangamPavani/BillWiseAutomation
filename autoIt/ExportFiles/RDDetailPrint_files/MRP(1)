                } else {
                    sHTML = sHTML + "<li id='UL_LI_" + VariantId + "' data-VariantId=" + VariantId + " onclick='BOM.ONLiClick(this,event)' ><a data-toggle='tab' href='#BOM_Tab_div_" + VariantId + "' class='legend_bom_a theme_color-inverse' >" + VariantName + "</a><div class=''></div></li>";
                }
                newGroup = "";
                newGroup = document.createElement("div");
                newGroup.id = "BOM_Tab_div_" + VariantId;
                newGroup.style.padding = 15 + "px";
                newGroup.style.height = "auto";
                newGroup.style.overflow = "auto";
                parent.appendChild(newGroup);
                BOM.SetAttribute("btnCreateVariant", "Variant", VariantId)
                url = GLOBAL.getContextPath("GetGridBasedOnVarient", "BOM", "MRP");
                selectMastersResult = NETWORK.executeServerMethod(url, true, {
                    ObjBomDetails: Data, iVarentId: VariantId, iMenuId: BOM_OUTPUTGRID.iMenuId
