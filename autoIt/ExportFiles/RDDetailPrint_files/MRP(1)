    ProductionQuantityLeave: function () {
        debugger
        var Quantity = parseFloat(document.getElementById("txtProductionSizeJWReturn").getAttribute("IssuedQty"), RFJW.iNoOfDecimalsQuantity);
        var dSize = parseFloat(document.getElementById("txtProductionSizeJWReturn").value, RFJW.iNoOfDecimalsQuantity);
        if (!isNaN(dSize)) {
            if (dSize > Quantity) {
                dSize = Quantity;
                COMMON.prototype.showMessage("Quantity Should not be Greater than Issued Quantity", "Issue To Job Work");
            }
            if (parseFloat(dSize) == 0) {
                dSize = 0;
                COMMON.prototype.showMessage("Quantity Should not be Zero", "Issue To Production");
            }
        }
        else {
            dSize = 0;
            COMMON.prototype.showMessage("Quantity Should not be Empty", "Issue To Job Work");
        }
        document.getElementById("txtProductionSizeJWReturn").value = parseFloat(dSize).toFixed(RFJW.iNoOfDecimalsQuantity);

        var sGridName = "Id_ReturnFromJobWorker_Grid";
        var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
        var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        for (var i = 0; i < TotalRows; i++) {

            var cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, 23);

            var dSize = parseFloat(document.getElementById("txtProductionSizeJWReturn").value, RFJW.iNoOfDecimalsQuantity);
            var IssuedQuantity = 0;
            var dAvailableStock = 0;
            var dClearStock = 0;
            for (var j = 0; j < TotalColumns; j++) {
                var cellobj1 = FGRIDCONTROL.getCellObject(sGridName, i + 1, j + 2);
                if ((cellobj1.ColumnAttribute.ctrlid == 'txtIssuedQty') && (cellobj1.ColumnAttribute.ctrlid != undefined)) {
                    IssuedQuantity = cellobj1.getCellData();
                    break;
                }
            }
            for (var j = 0; j < TotalColumns; j++) {
                var cellobj2 = FGRIDCONTROL.getCellObject(sGridName, i + 1, j + 2);
                if ((cellobj2.ColumnAttribute.ctrlid == 'txtStockQuantity') && (cellobj2.ColumnAttribute.ctrlid != undefined)) {
                    dAvailableStock = cellobj2.getCellData();
                    break;
                }
            }
            for (var j = 0; j < TotalColumns; j++) {
                var cellobj3 = FGRIDCONTROL.getCellObject(sGridName, i + 1, j + 2);
                if ((cellobj3.ColumnAttribute.ctrlid == 'txtClearStockQty') && (cellobj3.ColumnAttribute.ctrlid != undefined)) {
                    dClearStock = cellobj3.getCellData();
                    break;
                }
            }
            var dTotalProductionSize = parseFloat(document.getElementById("txtProductionSizeJWReturn").getAttribute("IssuedQty"), RFJW.dNoOfDecimal);
            var dPerQty = parseFloat(IssuedQuantity) / parseFloat(dTotalProductionSize)

            //var dAlreadyIssuedProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("AlreadyIssuedProductionSize"), ISSUETOJOBWORKER.dNoOfDecimal);
            //var dTotal = parseFloat(dAlreadyIssuedProductionSize) + parseFloat(dSize);
            var dTotal =  parseFloat(dSize);

            ///Stock calculation
            var Qty = parseFloat(dPerQty * dTotal) - parseFloat(IssuedQuantity);//Data[i].dIssuedQuantity
            if (Qty < 0)
                Qty = 0;
            
            var dStock = parseFloat(dAvailableStock)
            if (RFJW.bConsiderClearStock) {
                dStock = dStock + parseFloat(dClearStock);
            }

            if (Qty <= dStock) {
                IssueingDataQty = Qty;
            } else {
                IssueingDataQty = dStock;
            }
            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(IssueingDataQty, ISSUETOJOBWORKER.dNoOfDecimal)));
            cellobj.setCellData("value", IssueingDataQty);

        }


    },
