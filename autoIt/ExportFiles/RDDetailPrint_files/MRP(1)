    this.ProductionQuantityLeave = function () {
        //debugger
        var iProductionOrderId = OPTIONCONTROL.getControlValue("FOption_ProductionOrder");
        var Quantity = parseFloat(document.getElementById("txtProductionSize").getAttribute("RemainingQuantity"), IssueTP.dNoOfDecimal);
        var dSize = parseFloat(document.getElementById("txtProductionSize").value, IssueTP.dNoOfDecimal);
        if (!isNaN(dSize)) {
            if (dSize > Quantity) {
                dSize = Quantity;
                COMMON.prototype.showMessage("Quantity Should not be Greater than Production Order Quantity", "Issue To Production");
            }
            if (parseFloat(dSize) == 0) {
                dSize = 0;
                //COMMON.prototype.showMessage("Quantity Should not be Zero", "Issue To Production");
            }
        }
        else {
            dSize = 0;
            COMMON.prototype.showMessage("Quantity Should not be Empty", "Issue To Production");
        }
        document.getElementById("txtProductionSize").value = parseFloat(dSize).toFixed(IssueTP.dNoOfDecimal);

        var sGridName = IssueTP.GetGridId();
        var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
        var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        var Data = IssueTP.arrBodyData;
        for (var i = 0; i < IssueTP.arrBodyData.length; i++) {
            //for (var j = 0; j < TotalColumns; j++)
            //{
            cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, IssueTP.IssueNowColNo);
            //var cell = cellobj.ColumnAttribute.ctrlatt.trim()
            //switch (cell) {
            //case "issueingnow":
            //debugger
            //IssueTP.IssueNowColNo = cellobj.iColumn;
            var dTotalProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("TotalProductionSize"), IssueTP.dNoOfDecimal);
            var dPerQty = parseFloat(Data[i].dTotalQuantityToIssue) / parseFloat(dTotalProductionSize)
            var IssueingDataQty = 0;
            var dAlreadyIssuedProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("AlreadyIssuedProductionSize"), IssueTP.dNoOfDecimal);
            var dTotal = parseFloat(dAlreadyIssuedProductionSize) + parseFloat(dSize);
            var Qty = parseFloat(dPerQty * dTotal) - parseFloat(Data[i].dIssuedQuantity);
            if (Qty < 0)
                Qty = 0;
            var dStock = parseFloat(IssueTP.arrRowWiseStockData[i].dAvailableStock)
            if (IssueTP.bConsiderClearStock) {

                dStock = dStock + parseFloat(IssueTP.arrRowWiseStockData[i].dClearStock);
            }

            if (Qty <= dStock) {
                IssueingDataQty = Qty;
            } else {
                IssueingDataQty = dStock;
            }
            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(IssueingDataQty, IssueTP.dNoOfDecimal)));
            cellobj.setCellData("value", IssueingDataQty);
            IssueTP.arrBodyData[cellobj.iRow - 1].dIssuingNow = IssueingDataQty;
            IssueTP.arrBodyData[cellobj.iRow - 1].sRMA = "";
            // break;
            //   }
            //}
        }
    }

