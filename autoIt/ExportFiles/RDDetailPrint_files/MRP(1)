                var AlreadyReceivedProdQty= parseFloat(Result.data.AlreadyReceivedPOsize).toFixed(RECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity)
                var dMaxProductionCanBeReceipt = parseFloat(ReceivingNow - AlreadyReceivedProdQty, RECEIPTFROMJOBWORKER.dNoOfDecimals);

