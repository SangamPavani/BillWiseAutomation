    // Merge Orders for Quantity based on selected products in policy grid
    MergeOrdersBasedOnProduct: function () {
        ////debugger;
        MRP_DEPREQ.arrMergedOrders = [];
        MRP_DEPREQ.arrQuantityPolicy = [];
        MRP_DEPREQ.arrMergedQuantities = [];
        if (MRP_DEPREQ.arrAttachedOrders.length > 1) {
            MRP_DEPREQ.arrSortedOrders = [];
            var tempIds = [];

            for (var i = 0; i < MRP_DEPREQ.arrAttachedOrders.length; i++) {
                if (tempIds.indexOf(MRP_DEPREQ.arrAttachedOrders[i].iProductID) == -1) {
                    tempIds.push(MRP_DEPREQ.arrAttachedOrders[i].iProductID);
                }
            }

            MRP_DEPREQ.arrSortedOrders = MRP_DEPREQ.arrAttachedOrders;
            MRP_DEPREQ.arrSortedOrders.sort(MRP_DEPREQ.SortBasedOnProp('iProductID'));
            for (var i = 0; i < tempIds.length; i++) {
                var totalQty = 0;
                var tempData = {};
                var qty = "";
                for (var j = 0; j < MRP_DEPREQ.arrSortedOrders.length; j++) {
                    if (tempIds[i] == MRP_DEPREQ.arrSortedOrders[j].iProductID) {
                        totalQty += MRP_DEPREQ.arrSortedOrders[j].dQuantity;
                        tempData = MRP_DEPREQ.arrSortedOrders[j];
                        qty += MRP_DEPREQ.arrSortedOrders[j].dQuantity + ",";
                    }
                }
                document.getElementById("txtProductNameId").innerText = MRP_DEPREQ.arrSortedOrders[0].sProductName;
                document.getElementById("txtProductCodeId").innerText = MRP_DEPREQ.arrSortedOrders[0].sProductCode;
                qty = qty.substring(0, qty.lastIndexOf(','));
                MRP_DEPREQ.arrMergedQuantities.push(qty);
                MRP_DEPREQ.arrQuantityPolicy.push(totalQty);
                MRP_DEPREQ.arrMergedOrders.push(tempData);
            }
        }
        else if (MRP_DEPREQ.arrAttachedOrders.length == 1) {
            MRP_DEPREQ.arrSortedOrders = MRP_DEPREQ.arrAttachedOrders;
            document.getElementById("txtProductNameId").innerText = MRP_DEPREQ.arrSortedOrders[0].sProductName
            document.getElementById("txtProductCodeId").innerText = MRP_DEPREQ.arrSortedOrders[0].sProductCode
            MRP_DEPREQ.arrMergedOrders.push(MRP_DEPREQ.arrAttachedOrders[0]);
            MRP_DEPREQ.arrQuantityPolicy.push(MRP_DEPREQ.arrAttachedOrders[0].dQuantity);
            MRP_DEPREQ.arrMergedQuantities.push(MRP_DEPREQ.arrAttachedOrders[0].dQuantity.toString());
        }
    },

    // Sort data array based on property using sort method of array
    SortBasedOnProp: function (key) {
        return function (a, b) {
            if (a[key] > b[key]) return 1;
            if (a[key] < b[key]) return -1;
            return 0;
        }
    },

