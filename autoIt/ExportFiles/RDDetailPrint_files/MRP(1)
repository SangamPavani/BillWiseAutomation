    ProductionQuantityLeave:function () {
        //debugger
        var Quantity = parseFloat(document.getElementById("txtProductionSize").getAttribute("RemainingQuantity"), ISSUETOJOBWORKER.iNoOfDecimalsQuantity);
        var dSize = parseFloat(document.getElementById("txtProductionSize").value, ISSUETOJOBWORKER.iNoOfDecimalsQuantity);
        if (!isNaN(dSize)) {
            if (dSize > Quantity) {
                dSize = Quantity;
                COMMON.prototype.showMessage("Quantity Should not be Greater than Released Job Order Quantity", "Issue To Job Work");
            }
            if (parseFloat(dSize) == 0) {
                dSize = 0;
                //COMMON.prototype.showMessage("Quantity Should not be Zero", "Issue To Production");
            }
        }
        else {
            dSize = 0;
            COMMON.prototype.showMessage("Quantity Should not be Empty", "Issue To Job Work");
        }
        document.getElementById("txtProductionSize").value = parseFloat(dSize).toFixed(ISSUETOJOBWORKER.iNoOfDecimalsQuantity);

        var sGridName = "Id_IssueToJobWorker_Grid";
        var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
        var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        var Data = ISSUETOJOBWORKER.lstRowWiseStocksdata;
        for (var i = 0; i < ISSUETOJOBWORKER.lstRowWiseStocksdata.length; i++) {

            var cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, ISSUETOJOBWORKER.IssueNowColNo);

            //var cellobj1 = FGRIDCONTROL.getCellObject(sGridName, i + 1, 18);//1 Quanity to issue 
            var IssuingNow = 0;

            for (var j = 0; j < TotalColumns ; j++) {
                var cellobj1 = FGRIDCONTROL.getCellObject(sGridName, i + 1, j+2);
                if ((cellobj1.ColumnAttribute.ctrlid == 'txtQuantitytoIssue') && (cellobj1.ColumnAttribute.ctrlid != undefined)) {
                    IssuingNow = cellobj1.getCellData();
                    break;
                }
            }
            var dTotalProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("TotalProductionSize"), ISSUETOJOBWORKER.dNoOfDecimal);
            var dPerQty = parseFloat(IssuingNow) / parseFloat(dTotalProductionSize)
            var IssueingDataQty = 0;
            var dAlreadyIssuedProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("AlreadyIssuedProductionSize"), ISSUETOJOBWORKER.dNoOfDecimal);
            var dTotal = parseFloat(dAlreadyIssuedProductionSize) + parseFloat(dSize);

            //var cellobj2 = FGRIDCONTROL.getCellObject(sGridName, i + 1, 19);//2 Issued Qty 
            var IssuedQty = 0;

            for (var k = 0; k < TotalColumns; k++) {
                var cellobj2 = FGRIDCONTROL.getCellObject(sGridName, i + 1, k+2);
                if ((cellobj2.ColumnAttribute.ctrlid == 'txtIssuedQty') && (cellobj2.ColumnAttribute.ctrlid != undefined)) {
                    IssuedQty = cellobj2.getCellData();
                    break;
                }
            }
            var Qty = parseFloat(dPerQty * dTotal) - parseFloat(IssuedQty);//Data[i].dIssuedQuantity
            if (Qty < 0)
                Qty = 0;
            var Availstock = 0;
            var Clearstock = 0;
            if (ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dAvailableStock <= 0) {
                for (var k = 0; k < TotalColumns; k++) {
                    var cellobj3 = FGRIDCONTROL.getCellObject(sGridName, i + 1, k + 2);
                    if ((cellobj3.ColumnAttribute.ctrlid == 'txtStockQuantity') && (cellobj3.ColumnAttribute.ctrlid != undefined)) {
                        Availstock = cellobj3.getCellData();
                        break;
                    }
                }
            } else {
                Availstock = ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dAvailableStock;
            }
            if (ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dClearStock <= 0) {
                for (var k = 0; k < TotalColumns; k++) {
                    var cellobj5 = FGRIDCONTROL.getCellObject(sGridName, i + 1, k + 2);
                    if ((cellobj5.ColumnAttribute.ctrlid == 'txtClearStockQty') && (cellobj5.ColumnAttribute.ctrlid != undefined)) {
                        Clearstock = cellobj5.getCellData();
                        break;
                    }
                }
            } else {
                Clearstock = ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dClearStock;
            }
            var dStock = parseFloat(Availstock)
            if (ISSUETOJOBWORKER.bConsiderClearStock) {
                dStock = dStock + parseFloat(Clearstock);
            }

            if (Qty <= dStock) {
                IssueingDataQty = Qty;
            } else {
                IssueingDataQty = dStock;
            }
            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(IssueingDataQty, ISSUETOJOBWORKER.dNoOfDecimal)));
            cellobj.setCellData("value", IssueingDataQty);
            ISSUETOJOBWORKER.lstRowWiseStocksdata[cellobj.iRow - 1].dIssuingNow = IssueingDataQty;
            ISSUETOJOBWORKER.lstRowWiseStocksdata[cellobj.iRow - 1].sRMA = "";
        }
    },
