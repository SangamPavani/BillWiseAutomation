                            break;
                        default:
                            if (cellobj.ColumnAttribute.ctrlatt == "tagfield") {
                                if (cellobj.iRow > 1) {
                                    var CurrentValue = isNaN(parseInt(cellobj.getCellData("value"))) ? 0 : parseInt(cellobj.getCellData("value"));
                                    if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
                                        var PrevEle = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow - 1, cellobj.iColumn);
                                        cellobj.setCellData("value", PrevEle.getCellData("value"));
                                        cellobj.setCellText(PrevEle.getCellText("value"));
                                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                        cellobj.setControl(element, cellobj.getCellData("value"));
                                    } else {
                                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                        cellobj.setControl(element, cellobj.getCellData("value"));
                                    }
                                } else {
                                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                    cellobj.setControl(element, cellobj.getCellData("value"));
                                }
                            } else if (cellobj.ColumnAttribute.ctrlatt == "Extrafield") {
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                cellobj.setControl(element, cellobj.getCellData("value"));
                            } else {
                                cellobj.processDefault(event);
                            }
                            break;
                    }
                }
            }
            return (true);


        } catch (err) {
            COMMON.prototype.showMessage("Exception: QuantityBreakup.onQuantityBreakupGridCellChange " + err.message, QuantityBreakup.QuantityBreakupMsgs.QC_TD_msgException);
        }
