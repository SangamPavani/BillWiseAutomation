                    break;
                }
            }
            var ProdOrderData = OPTIONCONTROL.getControlDataObject("FOption_ProductionOrder");
            var iOrderStatus = ProdOrderData.iOrderStatus;
            //debugger
            var ObjF = {};
            ObjF.arrRFPProcessNodeInfo = [];//RFPProcessNode[]
            ObjF.arrRFPToolWiseInfo = [];//RFPToolWiseInfo[]
            ObjF.bBackFlush = false;
            ObjF.bCheckClose = document.getElementById("RFProduction_Close").checked;
