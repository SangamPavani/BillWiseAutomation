                    }
                }
                //PIO Authorization
                PIORDER.iAuthstatus = data.objMRPPIO.header.iAuthStatus;
                if (data.objProductionAuth != null && data.objProductionAuth.AuthId > 0) {
                    document.getElementById("AuthId").value = data.objProductionAuth.AuthId;
                    document.getElementById("AuthNodeId").value = data.objProductionAuth.AuthNodeId;
                    document.getElementById("DocumentId").value = data.objMRPPIO.header.iPIOId;
                    var divAuthDetailsId = document.getElementById("divAuthorizeDetails");
                    var divAuthApproveId = document.getElementById("divAuthApprove");
                    var divAuthRejectId = document.getElementById("divAuthorizeReject");
                    if (data.objProductionAuth.AuthId > 0) {
                        divAuthDetailsId.style.display = "";
                    }
                    else {
                        divAuthDetailsId.style.display = "none";
                    }
                    if (data.ShowAuthReject) {
                        divAuthApproveId.style.display = "";
                        divAuthRejectId.style.display = "";
                    }
                    else {
                        divAuthApproveId.style.display = "none";
                        divAuthRejectId.style.display = "none";
                    }
                    if (data.objQCAuthRemarksSetting != null) {
                        AskRemarksOnApproval = data.objQCAuthRemarksSetting.AskRemarksOnApproval;
                        ApprovalMandatory = data.objQCAuthRemarksSetting.ApprovalMandatory;
                        AskRemarksOnRejection = data.objQCAuthRemarksSetting.AskRemarksOnRejection;
                        RejectionMandatory = data.objQCAuthRemarksSetting.RejectionMandatory;
                    }
                }
            }
            else {
                if (dataTags.isFromPrevNext == true) {
                    if (data.objMRPPIO.header == null && data.objMRPPIO.lstBody == null) {
                        var nextOrderNo = document.getElementById('id_hiddenNextvalue').value;
                        if (nextOrderNo == 3) {
                            PIORDER.GetNewPIO();
                            document.getElementById('id_hiddenNextvalue').value = null;
                        }
                        else {
                            return false;
                        }
                    }
                }
                else {
                    if (dataTags.docNo == "") {
                        PIORDER.GetNewPIO();
                    }
                    else {
                        document.getElementById("txtDocumentNo_PIO").value = dataTags.docNo;
                        DATEPICKER.clear("fDatePicker_DocDate_PIO");
                        var arrTagElements = document.getElementsByClassName("clsPIOHeaderTags_PIO");
                        if (arrTagElements != null && arrTagElements != undefined) {
                            for (var i = 0; i < arrTagElements.length; i++) {
                                if (arrTagElements[i].id != "") {
                                    OPTIONCONTROL.clear(arrTagElements[i].id);
                                }
                            }
                        }
                        FGRIDCONTROL.clearData("Id_PlanIndependentOrder_Grid_PIO");
                        var totalRows = FGRIDCONTROL.getTotalRows("Id_PlanIndependentOrder_Grid_PIO");
                        if (totalRows > 1)
                            FGRIDCONTROL.deleteRows("Id_PlanIndependentOrder_Grid_PIO", 1, totalRows - 1);
                    }
                }
            }
        }
