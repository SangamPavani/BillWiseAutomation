    onImport_click: function (iMenuId) {
        try {
            MRP_Import.iMenuId = iMenuId;
            document.getElementById("UploadedFileId1").value = "";
            $("#ImportBOM_Modal").modal('show');
        }
        catch (e) {
            COMMON.prototype.showMessage("Exception: MRP_Import.onImport_click" + e.message);
        }
