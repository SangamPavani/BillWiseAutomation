    // Load Test details based on Selected Series Tag
    OnEnableTagFilter: function () {
        try {
            //debugger
            var bTagWiseDetails = false;
            var sTestDefHeaderIds = "";
            var iQCTagValue = OPTIONCONTROL.getControlValue("FOption_objReqSeriesTag");
            var Checked = document.getElementById("chkEnableTagFilter").checked;
            var sFilter = "iProductId = " + parseInt(OPTIONCONTROL.getControlValue("FOption_ProductName_Req")) + REQUISITION.sQCTagSearch;
            var bConfirm = true;
            if (iQCTagValue > 0 && Checked == true) {
                if (document.getElementById("ReqHeaderId").value <= 0) {
                    bConfirm=confirm("Are you sure to Apply Filter for Tests ?");
                }
                if (bConfirm) {
                    document.getElementById("chkEnableTagFilter").disabled = true;
                    document.getElementById("FOption_objReqSeriesTag").disabled = true;
                    var urlPath = REQUISITION.GetQualityControlAreaName("LoadTestsBasedOnQCTag", "Requisition", eVersion.Version10);
                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { iSeriesTagValue: iQCTagValue }, "JSON", false);
                    if (fnResult.data != null && fnResult.data.length > 0) {
                        sTestDefHeaderIds = fnResult.data.join(',');
                        bTagWiseDetails = true;
                    }

                    var sGridId = "Id_RequisitionDetails_FGrid";
                    var iTotalRows = FGRIDCONTROL.getTotalRows(sGridId);
                    if (bTagWiseDetails == true) {
                        REQUISITION.sTestFilter = sFilter + " and iTestDefHeaderId in (" + sTestDefHeaderIds + ")";
                        OPTIONCONTROL.setFilter("FOption_Grid_TestName_Req", REQUISITION.sTestFilter);
                    } else {
                        REQUISITION.sTestFilter = sFilter + " and iSeriesTag = " + iQCTagValue;
                        OPTIONCONTROL.setFilter("FOption_Grid_TestName_Req", REQUISITION.sTestFilter);
                    }

                    for (var i = 0; i < iTotalRows; i++) {
                        var cellobjs = FGRIDCONTROL.getCellObject(sGridId, i + 1, 2);
                        var iTestDeId = isNaN(parseInt(cellobjs.CellData.value)) ? 0 : parseInt(cellobjs.CellData.value);
                        if (iTestDeId > 0) {
                            if (bTagWiseDetails == false && iQCTagValue != cellobjs.CellData.iqctagvalue) {
                                FGRIDCONTROL.deleteRows(sGridId, cellobjs.iRow, 1);
                                FGRIDCONTROL.setCurrentRow("Id_RequisitionDetails_FGrid", (FGRIDCONTROL.getCurrentRow("Id_RequisitionDetails_FGrid") - 1));
                                iTotalRows--;
                            } else {
                                for (var iZ = 0; iZ < fnResult.data.length; iZ++) {
                                    if (iQCTagValue == parseInt(fnResult.data[iZ])) {
                                        FGRIDCONTROL.deleteRows(sGridId, cellobjs.iRow, 1);
                                        FGRIDCONTROL.setCurrentRow("Id_RequisitionDetails_FGrid", (FGRIDCONTROL.getCurrentRow("Id_RequisitionDetails_FGrid") - 1));
                                        iTotalRows--;
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                OPTIONCONTROL.setFilter("FOption_Grid_TestName_Req", sFilter);
            }

            var prodData = OPTIONCONTROL.getControlDataObject("FOption_DocumentNo_Req");
            var DocData = OPTIONCONTROL.getControlDataObject("FOption_DocumentType_Req");

            var OptionControlId = "FOption_objReqSeriesTag" + "_data";
            var parameter = "data-" + REQUISITION.sTagLabel;
            var ReqHeaderId = document.getElementById("ReqHeaderId").value;
            var sSeries = document.getElementById(OptionControlId).value;

            if ((ReqHeaderId == null || parseInt(ReqHeaderId) <= 0) && (sSeries != "" && sSeries != undefined && sSeries != null)) {
                var RequisitionNo = "";
                var urlPath = REQUISITION.GetQualityControlAreaName("GetMaxNoForQCRequisition", "Requisition", eVersion.Version10);
