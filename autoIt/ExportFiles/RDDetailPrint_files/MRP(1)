            else {
                document.getElementById("txtProductionSizeJWR").value = parseFloat(Result.data.JOQtySize).toFixed(RECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity);
                document.getElementById("txtProductionSizeJWR").setAttribute("ProductionSizeJWR", parseFloat(Result.data.JOQtySize).toFixed(RECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity));
