    // Returns Unique Product/Production details to make Order Tree
    UniqueProductOrders: function (arrOrders, iOrderBy) {
        ////debugger;
        var arrUniqueOrders = [];
        try {
            if (arrOrders.length > 1) {
                arrUniqueOrders.push(arrOrders[0]);
                var orderIds = [];
                if (iOrderBy == 0) {
                    orderIds.push(arrOrders[0].iProdOrderID);
                    for (var i = 0; i < arrOrders.length; i++) {
                        if (orderIds.indexOf(arrOrders[i].iProdOrderID) == -1) {
                            orderIds.push(arrOrders[i].iProdOrderID);
                            arrUniqueOrders.push(arrOrders[i]);
                        }
                    }
                }
                else {
                    orderIds.push(arrOrders[0].iProductID);
                    for (var i = 0; i < arrOrders.length; i++) {
                        if (orderIds.indexOf(arrOrders[i].iProductID) == -1) {
                            orderIds.push(arrOrders[i].iProductID);
                            arrUniqueOrders.push(arrOrders[i]);
                        }
                    }
                }
            }
            else
                arrUniqueOrders.push(arrOrders[0]);
        } catch (e) {
            alert("Exception: {MRP_DEPREQ.UniqueProductOrders} " + e.message);
        }
        return arrUniqueOrders;
    },

