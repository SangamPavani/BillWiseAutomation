    onOutputGridCellChange: function (objCell, event) {
        try {
            debugger;
            if (objCell.bLeave == true) {
                if (objCell.iColumn == 1) {
                    var Cellattribute = objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                    objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                    var objProdData = OPTIONCONTROL.getControlDataObject(objCell.ColumnAttribute.ctrlid);
                    var cellProductName = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 11);
                    var cellProdDescription = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 12);
                    if (objProdData != null && objProdData != undefined) {
                    var prodName = objProdData.sName;
                    var prodId = objProdData.iMasterId;
                    var prodDescription = objProdData.sDescription;
                    cellProductName.setCellText(prodName);
                    cellProductName.setCellData("value", prodId);
                    cellProdDescription.setCellText(prodDescription);
                        cellProdDescription.setCellData("value", prodId);
                    }
                }
                else if (objCell.iColumn == 7) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (R_WORKCENTER.IsValidObject(element.value.trim()) == true) {
                        var cellCostingBasis = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 6);
                        var CostingBasis = parseFloat(cellCostingBasis.getCellData("value"));
                        CostingBasis = isNaN(CostingBasis) == true ? 0 : CostingBasis;
                        if (CostingBasis == 0) {
                            var value = parseFloat(element.value.trim());
                            value = isNaN(value) == true ? 0 : value;
                            objCell.setCellText(parseFloat(value).toFixed(ROUTING.GlobalNoofDecimalsInQuantity));
                            objCell.setCellData("value", value);
                        }
                        else if (CostingBasis == 1) {
                            var value = parseFloat(element.value.trim());
                            value = isNaN(value) == true ? 0 : value;
                            let arr = [];
                            var GridId = "Id_OutputGrid_WorkCenter_Routing";
                            var rowcount = FGRIDCONTROL.getTotalRows(GridId);
                            for (i = 1; i < rowcount; i++) {
                                const MyCellObj = FGRIDCONTROL.getCellObject(GridId, i, 7);
                                arr.push(i == objCell.iRow ? value : Number(MyCellObj.getCellData("value")))
                            }
                            let iIndexChanging = objCell.iRow - 1;
                            if (iIndexChanging != 0)
                                arr = R_WORKCENTER.AdjustQuantities(arr, iIndexChanging);
                            //debugger;
                            for (i = 1; i <= arr.length; i++) {
                                NewCellObj = FGRIDCONTROL.getCellObject(GridId, i, 7);
                                NewCellObj.setCellText(parseFloat(arr[i - 1]));
                                NewCellObj.setCellData("value", arr[i - 1]);
                            }
                        }
                        else {
                            objCell.setCellText(element.value.trim());
                            objCell.setCellData("value", element.value.trim());
                        }
                    }
                }
                else if (objCell.iColumn == 2 || objCell.iColumn == 3) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (R_WORKCENTER.IsValidObject(element.value.trim()) == true) {
                        //objCell.setCellText(parseFloat(element.value.trim()).toFixed(ROUTING.GlobalNoofDecimalsInQuantity));
                        objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(element.value.trim(), ROUTING.GlobalNoofDecimalsInQuantity)));
                        objCell.setCellData("value", parseFloat(element.value.trim()));
                    }
                    if (objCell.iColumn == 2) {
                        var cell10 = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 10);
                        cell10.setCellData("totalqty", parseFloat(element.value.trim()));
                    }
                }
                else if (objCell.iColumn == 4 || objCell.iColumn == 6 || objCell.iColumn == 9) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (element.selectedIndex > -1) {
                        objCell.setCellText(element.options[element.selectedIndex].text);
                        objCell.setCellData("value", element.options[element.selectedIndex].value);
                    }
                }
                else if (objCell.iColumn == 10) {
                    objCell.processDefault(event);
                }
                else if (objCell.iColumn == 11) {
                    objCell.processDefault(event);
                }
                else if (objCell.iColumn == 12) {
                    objCell.processDefault(event);
                }
            }
            else {
                if (objCell.iColumn == 5 || objCell.iColumn == 8) {
                    if (R_WORKCENTER.IsValidObject(objCell.cell.children[0]) == true) {
                        objCell.cell.children[0].focus();
                    }
                }
                else if (objCell.iColumn != 10 && objCell.iColumn !== 11 && objCell.iColumn !== 12) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (objCell.iColumn == 7) {
                        var cellCostingBasis = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 6);
                        var CostingBasis = parseFloat(cellCostingBasis.getCellData("value"));
                        CostingBasis = isNaN(CostingBasis) == true ? 0 : CostingBasis;
                        if (CostingBasis == 0 || CostingBasis == 1) {
                            element.setAttribute("onkeypress", "return MRPCommon.TextBoxType(event,this,2, " + ROUTING.GlobalNoofDecimalsInQuantity + ")");
                        }
                        else {
                            element.removeAttribute("onkeypress");
                        }
                    }
                    objCell.setControl(element, objCell.getCellData("value"));
                }
                else {
                    objCell.processDefault(event);
                }
            }
            if (objCell.iRow == FGRIDCONTROL.getTotalRows(objCell.Grid)) {
                FGRIDCONTROL.insertRows(objCell.Grid, 0, 1);
            }
            return (true);
        } catch (e) {
            alert("Exception {R_WORKCENTER.onOutputGridCellChange} : ", e.message);
        }
    },

    AdjustQuantities: function (arr, iIndexChanging) {
        //debugger;
        var iSumTotal = 0;
        for (var i = 0; i < arr.length; i++) {
            if (i !== iIndexChanging) {
                iSumTotal = iSumTotal + Number(arr[i]);
            }
        }
        if (iSumTotal < 100) {
            arr[0] = Number(arr[0]) + (100 - iSumTotal);
        }

        if (arr == null || arr.length > 1) {
            if (arr[0] > arr[iIndexChanging]) {
                arr[0] -= arr[iIndexChanging];
                arr[iIndexChanging] = arr[iIndexChanging];
            } else {
                arr[iIndexChanging] = 100 - iSumTotal;
                var sum = 0;
                for (i = 1; i < arr.length; i++) { sum = sum + arr[i] }
                arr[0] = 100 - sum;
                COMMON.prototype.showMessage("Costing Percentage Cannot Exceed", "Error Message"); 
            }
        }
        return arr;
    },
