            }
            else {

                GLOBAL.LoadingEnd();
            }
        }

        else {

            var strSalesOrderOrPIONUmber = document.getElementById("txt_DocumentNo").value;
            var urlPath = GLOBAL.getContextPath("GetMRPDocuments", "MRPProcess", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { iStartDate: startDate, iEndDate: endDate, iCustomerId: customerId, iProductId: productId, iReplenishmentTypeId: replenishmentTypeId, iWareHouseId: wareHouseId, arrFocusTags: arrFocusTag, sMRPOrdersFilter: MRP_PROCESS.sMRPOrdersFilter, iOrderTypeFilter: iOrderTypeFilter, strSalesOrderOrPIONUmber: strSalesOrderOrPIONUmber }, "JSON", true, "MRP_PROCESS.SetDocumentData", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        }
        QUICKMRP.bDontLoadDocuments = false;
        //debugger
        //Differentiate With or Without Filter if Required
        if (QUICKMRP.bfromQuickMRP == true) {
            if (QUICKMRP.showLog == true)
                MRP_PROCESS.ShowQuickMRPLog();
            QUICKMRP.showLog = false;
        }
