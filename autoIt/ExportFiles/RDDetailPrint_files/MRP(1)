    this.ProductionQuantityLeave = function () {
        debugger
        var iProductionOrderId = OPTIONCONTROL.getControlValue("FOption_ProductionOrder");
        var Quantity = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("IssuedQty"), RF_PRODUCTION.dNoOfDecimals);
        var dSize = parseFloat(document.getElementById("txtProductionSizeRFP").value, RF_PRODUCTION.dNoOfDecimals);

        var AlreadyReceivedProdQty = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("ReceivedProdQty"), RF_PRODUCTION.dNoOfDecimals);
        var Pordsizeset = false;

        var iProcessValue = document.getElementById("ddlProcessName").value;
        if (parseInt(iProcessValue) == 0) {
            //COMMON.prototype.showMessage("Select Process Name.", "Error Message");
            COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + RF_PRODUCTION.RF_PRODUCTIONMsgs.ProcessName, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
            return false;
        }
        if (dSize > 0) {
            var iInputCount = 0;
            for (var k = 0; k < RF_PRODUCTION.arrProcessData[0].arrProcess.length; k++) {
                if (iProcessValue == RF_PRODUCTION.arrProcessData[0].arrProcess[k].iBodyId)
                    iInputCount = RF_PRODUCTION.arrProcessData[0].arrProcess[k].InputCount;
            }
            if (RF_PRODUCTION.bReceiptQuantityBasedonIssuesonly == true && iInputCount > 0) {
                //debugger
                //var iProcessValue = document.getElementById("ddlProcessName").value;
                var urlPath = GLOBAL.getContextPath("GetValidProductionSizeForReceipt", "ReceiptfromProduction", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { iProdOrderId: iProductionOrderId, iProcessId: iProcessValue }, "JSON", false);
                var ReceivingNow = fnResult.data.dMaxProductionCanBeReceipt;

                var dMaxProductionCanBeReceipt = parseFloat(ReceivingNow - AlreadyReceivedProdQty, RF_PRODUCTION.dNoOfDecimals);

                if (dMaxProductionCanBeReceipt < dSize) {
                    if (dMaxProductionCanBeReceipt == 0) {

                        COMMON.prototype.showMessage("Input Items for the selected order no is not issued fully", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                    }
                    else {
                        COMMON.prototype.showMessage("Quantity Should not be Greater than " + dMaxProductionCanBeReceipt + " quantity", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);

                    }
                    document.getElementById("txtProductionSizeRFP").value = parseFloat(dMaxProductionCanBeReceipt).toFixed(RF_PRODUCTION.dNoOfDecimals);
                } else {
                    document.getElementById("txtProductionSizeRFP").value = parseFloat(dSize).toFixed(RF_PRODUCTION.dNoOfDecimals);
                    Pordsizeset = true;
                }
            } else {
                var dMaxProductionCanBeReceipt = parseFloat(Quantity, RF_PRODUCTION.dNoOfDecimals);
                if (dSize > dMaxProductionCanBeReceipt) {
                    COMMON.prototype.showMessage("Quantity Should not be Greater than " + dMaxProductionCanBeReceipt + " quantity", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                    document.getElementById("txtProductionSizeRFP").value = parseFloat(dMaxProductionCanBeReceipt).toFixed(RF_PRODUCTION.dNoOfDecimals);
                } else {
                    document.getElementById("txtProductionSizeRFP").value = parseFloat(dSize).toFixed(RF_PRODUCTION.dNoOfDecimals);
                    Pordsizeset = true;
                }
            }
        } else {
            COMMON.prototype.showMessage("Quantity Should not be Zero / Empty", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }

        if (RF_PRODUCTION.bDonotAllowDecimalinProductionReceipts) {            
            var dSizeCheck = (dSize - Math.floor(dSize)) !== 0;
            if (dSizeCheck) {
                COMMON.prototype.showMessage("Production Size Cannot Accept Decimal Value", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                dSize = 0;
                document.getElementById("txtProductionSizeRFP").value = parseFloat(dSize).toFixed(RF_PRODUCTION.dNoOfDecimals);
            }
        }

        var sGridName = "Id_MRPReceiptFromProduction_Grid";
        var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
        var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        for (var j = 1; j <=TotalRows; j++) {
            var LineWisePlannedQty = 0;
            var dAlreadyReceivedLineWise = 0;
            var iOutPutType = 0;//'FOption_OutPut'
            var iCol = RF_PRODUCTION.iIndexOfOutputCol + RF_PRODUCTION.arrBodyTags.length;
            var cellobjOutPut = FGRIDCONTROL.getCellObject(sGridName, j, iCol);
            iOutPutType = parseInt(cellobjOutPut.getCellData());
            for (var i = 1; i < TotalColumns; i++) {
                var cellobj = FGRIDCONTROL.getCellObject(sGridName, j, i);//Quantity To receive
                if (cellobj.ColumnAttribute.ctrlid == "txtProductActualQty") {
                    LineWisePlannedQty = parseFloat(cellobj.getCellData())
                }
                if (cellobj.ColumnAttribute.ctrlid == "FOption_AlreadyRecievedQty") {
                    dAlreadyReceivedLineWise = parseFloat(cellobj.getCellData())
                }
                if (cellobj.ColumnAttribute.ctrlid == "FOption_QtytoReceive") {
                    
                    if (iOutPutType == 0) {
                        if (Pordsizeset == true) {
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dSize, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", dSize);
                            break;
                        } else {
                            dMaxProductionCanBeReceipt = dMaxProductionCanBeReceipt == undefined ? cellobj.getCellText() : dMaxProductionCanBeReceipt;
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dMaxProductionCanBeReceipt, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", dMaxProductionCanBeReceipt);
                            break;
                        }
                    }
                    else {
                        //var LineWisePlannedQty = 1140;
                        var dSize = parseFloat(document.getElementById("txtProductionSizeRFP").value, RF_PRODUCTION.dNoOfDecimals);
                        var AlreadyReceivedProdQty = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("ReceivedProdQty"), RF_PRODUCTION.dNoOfDecimals);
                        var dIssuedPOSizeTotal = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("IssuedQty"), RF_PRODUCTION.dNoOfDecimals);
                        var dTotalProductionsize = parseFloat(dIssuedPOSizeTotal + AlreadyReceivedProdQty);

                        var dCalculatedValueAlreadyReceived = (LineWisePlannedQty / dTotalProductionsize) * AlreadyReceivedProdQty;
                        //dAlreadyReceivedLineWise = 0;
                        var BalancePending = parseFloat(dCalculatedValueAlreadyReceived - dAlreadyReceivedLineWise);

                        var dCalculatedValue = ((LineWisePlannedQty / dTotalProductionsize) * dSize) + BalancePending;

                        if (dCalculatedValue > 0) {
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dCalculatedValue, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", dCalculatedValue);
                        }
                        else {
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(0, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", 0);
                        }
                        if (iOutPutType == 3) {
                            Quantity = Quantity + RF_PRODUCTION.arrRFPProductData[j - 1].dAlreadyRecievedQty;
                            LineWisePlannedQty = Quantity * RF_PRODUCTION.arrRFPProductData[j - 1].dMainOutputQty;
                            if (dSize != 0) {
                                dCalculatedValue = ((LineWisePlannedQty / dTotalProductionsize) * dSize);
                            }
                            else {
                                dCalculatedValue = 0;
                            }
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dCalculatedValue, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", dCalculatedValue);
                        }
                        break;
                    }
                }
            }
        }
        //if (!isNaN(dSize)) {
        //    if (dSize > Quantity) {
        //        dSize = Quantity;
        //        COMMON.prototype.showMessage("Quantity Should not be Greater than " + dMaxProductionCanBeReceipt + " Quantity", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        //    }
        //    if (parseFloat(dSize) == 0) {
        //        dSize = 0;
        //        //COMMON.prototype.showMessage("Quantity Should not be Zero", "Issue To Production");
        //    }
        //}
        //else {
        //    dSize = 0;
        //    COMMON.prototype.showMessage("Quantity Should not be Empty", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        //}
        //document.getElementById("txtProductionSizeRFP").value = parseFloat(dSize).toFixed(RF_PRODUCTION.dNoOfDecimals);
    }
