                document.getElementById("TestHeaderId").value = data.objSampleCheck.TestHeaderId;
                DATEPICKER.setDate("fDatePicker_ScDate", data.objSampleCheck.Date);
                OPTIONCONTROL.setControlValue("FOption_ProductName_SC", data.objSampleCheck.ProductId);
                SAMPLECHECK.SetRequisitionNoFilter();
                OPTIONCONTROL.setControlValue("FOption_RequisitionNo_SC", data.objSampleCheck.ReqHeaderId);
                OPTIONCONTROL.setControlValue("FOption_Warehouse_SC_ID", data.objSampleCheck.iWareHouseId);
                SAMPLECHECK.SetTestNameFilter();
                OPTIONCONTROL.setControlValue("FOption_TestName_SC", data.objSampleCheck.TestDefHeaderId);
                document.getElementById("txtAvailableQty_SC").value = parseFloat(data.objSampleCheck.QtyTested).toFixed(SAMPLECHECK.DecimalInQuantity);
                dataFields = OPTIONCONTROL.getControlDataObject("FOption_TestName_SC");
                document.getElementById("txtTestType_SC").value = (dataFields.bTestType = "False") ? "Sample Check" : "Total Check";
                if (document.getElementById("txtBatchNo_SC") != null && document.getElementById("txtBatchNo_SC") != undefined) {
                    document.getElementById("txtBatchNo_SC").value = data.objSampleCheck.sBatchNo;
                }
                document.getElementById("txtNarration_SC").value = data.objSampleCheck.Narration;
                $("#ddlFinalResult_SC").val(data.objSampleCheck.FinalResult);
                SAMPLECHECK.FinalResult_OnChange();
                OPTIONCONTROL.setControlValue("FOption_CheckedBy_SC", data.objSampleCheck.ApprovedBy);
                var bAllowUserToCheckAllSampleQuantity = false; //dataFields.bAllowUserToCheckAllSampleQuantity == "True" || true ? true : false;
                if (dataFields.bAllowUserToCheckAllSampleQuantity == "True" || dataFields.bAllowUserToCheckAllSampleQuantity == true) {
                    bAllowUserToCheckAllSampleQuantity = true;
                }
                else if (dataFields.bAllowUserToCheckAllSampleQuantity == "False" || dataFields.bAllowUserToCheckAllSampleQuantity == false) {
                    bAllowUserToCheckAllSampleQuantity = false;
                }
                if (bAllowUserToCheckAllSampleQuantity == true && SAMPLECHECK.AllowEntervalueforsampleQtyQCInspection == true) {
                    document.getElementById("txtPieceNoPrefix").value = data.objSampleCheck.sPrefix;
                    if (data.objSampleCheck.sPrefix == "") {
                        document.getElementById("txtPieceNoPrefix").disabled = true;
                        document.getElementById("PieceNoCheckBox").checked = false;
                    } else {
                        document.getElementById("txtPieceNoPrefix").disabled = false;
                        document.getElementById("PieceNoCheckBox").checked = true;
                    }
                }
                OPTIONCONTROL.setControlValue("FOption_ddlReason", data.objSampleCheck.iStandardReason);

                var bSplit = false;
                var iParameterId = data.objSampleCheck.lstQcSampleCheckBody[0].ParameterId;
                var fActSize = parseFloat(data.objSampleCheck.dEditedSampleSize); //parseFloat(data.objSampleCheck.lstQcSampleCheckBody[0].dLineWiseSampleQty);
                var iRoundType = data.objSampleCheck.lstQcSampleCheckBody[0].iRoundType;
                for (var iL = 1; iL < data.objSampleCheck.lstQcSampleCheckBody.length; iL++) {
                    if (data.objSampleCheck.lstQcSampleCheckBody[iL].ParameterId == iParameterId) {
                        fActSize += parseFloat(data.objSampleCheck.lstQcSampleCheckBody[iL].dLineWiseSampleQty);
                        bSplit = true;
                        break;
                    }
                }
                if (iRoundType == 0) { //None
                    fActSize = fActSize;
                } else if (iRoundType == 1) { //Nearest
                    fActSize = Math.round(fActSize);
                }
                else if (iRoundType == 3) { // Ceiling
                    fActSize = Math.ceil(fActSize);
                } else if (iRoundType == 2) { //Floor
                    fActSize = Math.floor(fActSize);
                }
                document.getElementById("txtActualSampleSize_SC").value = fActSize;

                if ((bAllowUserToCheckAllSampleQuantity == "True" || bAllowUserToCheckAllSampleQuantity == true) && SAMPLECHECK.AllowEntervalueforsampleQtyQCInspection == true) {
                    document.getElementById('btnEnterResult').style.display = "";
                }
                //else {
                //    document.getElementById('btnEnterResult').style.display = "none";
                //}
                SAMPLECHECK.iNoOfParameters = data.objSampleCheck.lstQcSampleCheckBody.length;
                if (SAMPLECHECK.AllowEntervalueforsampleQtyQCInspection == true && fActSize >= 1) {
                    if ((bAllowUserToCheckAllSampleQuantity == "True" || bAllowUserToCheckAllSampleQuantity == true)) {
                        var urlPath = SAMPLECHECK.GetQualityControlAreaName("LoadQCSampleCheckDetails", "SampleCheck", eVersion.Version10);
                        var fnResult = NETWORK.executeServerMethod(urlPath, true,
                            { QCInspectionTestDetails: data.objSampleCheck.lstQcSampleCheckBody, dActualSampleSize: $('#txtActualSampleSize_SC').val() }, "html", false, "");
                        $('#divSampleCheckGrid').html(fnResult.data);
                        var iRowNo = 0;
                        for (var row = 0; row < fActSize; row++) {
                            SAMPLECHECK.GetResult(row, 0);
                            var GridId = "Id_SampleCheck_Grid_body";
                            var table = document.getElementById(GridId);
                            if (table == null) {
                                break;
                            }
                            iRowNo++;
                            var TotalColumns = table.rows.length > 0 ? table.rows[row].cells.length : 0;
                            for (var colCount = 0; colCount < TotalColumns; colCount++) {
                                iColumnNo = colCount + 1;
                                switch (iColumnNo) {
                                    case 2:
                                        var sPrefix = document.getElementById('txtPieceNoPrefix').value;
                                        table.rows[row].cells[1].innerHTML = sPrefix + iRowNo;
                                        break;
                                }

                            }
                        }
                    }
                }

                SAMPLECHECK.SetSampleCheckDetailGrid(data.objSampleCheck.lstQcSampleCheckBody, bSplit);
                if (SAMPLECHECK.bSeriesEnabled) {
                    OPTIONCONTROL.setControlValue("FOption_objSeriesTag", data.objSampleCheck.iSeriesTag);
                }
                document.getElementById("settingsData").style.display = "";

                var dataFieldsReq = OPTIONCONTROL.getControlDataObject("FOption_RequisitionNo_SC");
                if (dataFieldsReq.bClose == "True" || dataFieldsReq.bClose == "true") {
                    $('.dvSampleTags').hide();
                } else {
                    $('.dvSampleTags').show();
                    if (SAMPLECHECK.arrHeaderFocusTags != null || SAMPLECHECK.arrBodyFocusTags != null) {
                        var urlPath = SAMPLECHECK.GetQualityControlAreaName("GetTagValuesByBodyId", "MRPCommonReports", eVersion.Version10);
                        var fTagsResult = NETWORK.executeServerMethod(urlPath, true,
                            { iTransactionId: dataFieldsReq.iTransactionId }, "JSON", false);
                        if (fTagsResult.data != null && fTagsResult.lValue > 0) {
                            for (var iH = 0; iH < SAMPLECHECK.arrHeaderFocusTags.length; iH++) {
                                for (var iT = 0; iT < fTagsResult.data.length; iT++) {
                                    if (SAMPLECHECK.arrHeaderFocusTags[iH].iMasterType == fTagsResult.data[iT].ID) {
                                        var sId = "STags_" + fTagsResult.data[iT].ID;
                                        OPTIONCONTROL.setControlValue(sId, fTagsResult.data[iT].Tag);
                                        break;
                                    }
                                }
                            }

                            for (var iB = 0; iB < SAMPLECHECK.arrBodyFocusTags.length; iB++) {
                                for (var iT = 0; iT < fTagsResult.data.length; iT++) {
                                    if (SAMPLECHECK.arrBodyFocusTags[iB].iMasterType == fTagsResult.data[iT].ID) {
                                        var sId = "STagsBody_" + fTagsResult.data[iT].ID;
                                        OPTIONCONTROL.setControlValue(sId, fTagsResult.data[iT].Tag);
                                        break;
                                    }
                                }
                            }
                        }
                    }
                }

                //debugger
                SAMPLECHECK.LoadExtraFieldData();

                if (data.objSampleCheck.arrSampleTestHeaderExtra.length > 0 && SAMPLECHECK.arrExtraHeaderGroups != null && SAMPLECHECK.arrExtraHeaderGroups.length > 0) {
                    for (var i = 0; i < SAMPLECHECK.arrExtraHeaderGroups.length; i++) {
                        var sId = SAMPLECHECK.arrExtraHeaderGroups[i] == "" ? "Default" : SAMPLECHECK.arrExtraHeaderGroups[i];
