    // Set existing mapped Tests to grid and display detail
    LoadExistingTestList: function (data) {
        //debugger;
        try {
            var sGridId = "Id_ExistingTestDetail_Grid";
            if (data != "" && data != null) {
                MAPTEST_PRODUCT.arrExistingProduct = data;
                FGRIDCONTROL.clearData(sGridId, true);
                var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
                if (totalRows < data.length) {
                    FGRIDCONTROL.insertRows(sGridId, totalRows, (data.length - totalRows));
                }
                else if (data.length < totalRows) {
                    FGRIDCONTROL.deleteRows(sGridId, (data.length + 1), totalRows);
                }
                for (var i = 0; i < data.length; i++) {
                    for (var j = 1; j <= 4; j++) {
                        var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), j);
                        switch (j) {
                            case 1:
                                FGRIDCONTROL.setColumnCheckboxState(sGridId, cell.iRow, cell.iColumn, true)
                                break;
                            case 2:
                                OPTIONCONTROL.setControlValue("FOption_ExistingTestName", data[i].TestDefHeaderId)
                                var Datafields = OPTIONCONTROL.getControlDataObject("FOption_ExistingTestName");
                                cell.setCellText(OPTIONCONTROL.getControlText("FOption_ExistingTestName"));
                                cell.setCellData("value", data[i].TestDefHeaderId);
                                cell.setCellData("mapid", data[i].MappingId);
                                cell.setCellData("testtype", Datafields.bTestType);
                                break;
                            case 3:
                                FGRIDCONTROL.setColumnCheckboxState(sGridId, cell.iRow, cell.iColumn, data[i].IsMandatory)
                                break;
                            case 4:
                                cell.setCellText(data[i].iSequence);
                                cell.setCellData(data[i].iSequence);
                                break;
                        }
                    }
                }
            }

        } catch (err) {
            COMMON.prototype.showMessage("Exception: {MAPTEST_PRODUCT.LoadExistingTestList} " + err.message, "Exception");
        }
    },

