    // Cancel existing order and start MRP Process
    CancelOrderAndStartProcess: function (bCancel) {
        try {
            //debugger;
            if (bCancel == true) {
                var ReturnData = MRP_REPLANNING.CancelPlannedProductionOrder();
                if (MRP_REPLANNING.IsValidObject(ReturnData) == true) {
                    if (ReturnData.Status == true) {
                        //COMMON.prototype.showMessage("PO cancelled successfully, Re-planing Started", "Cancel PO");
                        COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgPOCancelledSuccessfullyReplaniingStarted, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_CP_msgCancelPO);
                        MAIN_MRPPROCESS.MRPProcessEntry(MRP_REPLANNING.arrMRPDocData);
                    }
                    else {
                        if (ReturnData.lstStatus.length > 0) {
                            if (ReturnData.lstStatus[0].bIssued == true) {
                                var sMessage = "";
                                if (ReturnData.lstStatus[0].arrPOListIssued.length > 0) {
                                    for (var i = 0; i < ReturnData.lstStatus[0].arrPOListIssued.length; i++) {
                                        sMessage += ReturnData.lstStatus[0].arrPOListIssued + ",";
                                    }
                                    sMessage = sMessage.substring(0, sMessage.lastIndexOf(','));
                                }
                                //COMMON.prototype.showMessage("Issues are done against this production Orders [" + sMessage + "]. Either you can do Return From Shop Floor Or Receive the Finished Quantity Cannot Cancel the order", "Cancel PO");
                                COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgIssuesAreDoneAgainstThisProductionOrders + sMessage + MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgEitherYouCanDoReturnFromShopFloor, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_CP_msgCancelPO);
                            }
                            else if (ReturnData.lstStatus[0].bIssued == false && ReturnData.ErrorMsg != "" && ReturnData.ErrorMsg != null) {
                                //COMMON.prototype.showMessage(ReturnData.ErrorMsg, "Cancel PO");
                                COMMON.prototype.showMessage(ReturnData.ErrorMsg, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_CP_msgCancelPO);
                            }
                        }
                        else if (ReturnData.ErrorMsg != "" && ReturnData.ErrorMsg != null) {
                            //COMMON.prototype.showMessage(ReturnData.ErrorMsg, "Cancel PO");
                            COMMON.prototype.showMessage(ReturnData.ErrorMsg, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_CP_msgCancelPO);
                        }
                        else {
                            //COMMON.prototype.showMessage("Cannot Cancel the Order, Re-plan not Done", "Cancel PO");
                            COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgCannotCancelTheOrderRePlanNotDone, MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_CP_msgCancelPO);
                        }
                    }
                }
            }
            else {
                MAIN_MRPPROCESS.MRPProcessEntry(MRP_REPLANNING.arrMRPDocData);
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MRP_REPLANNING.CancelOrderAndStartProcess} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    },

    // Cancel Planned production order and return status to Replanning
    CancelPlannedProductionOrder: function () {
        try {
            ////debugger;
            MRP_REPLANNING.arrMRPDocData[0].dPIOPendingQuantity = MRP_REPLANNING.arrMRPDocData[0].dPIOQuantity - MRP_REPLANNING.arrMRPDocData[0].dRaisedQuantity;
            MRP_REPLANNING.arrMRPDocData[0].dPendingQuantity = MRP_REPLANNING.arrMRPDocData[0].dPIOQuantity - MRP_REPLANNING.arrMRPDocData[0].dRaisedQuantity;
            MRP_REPLANNING.arrMRPDocData[0].dTotalPendingQty = MRP_REPLANNING.arrMRPDocData[0].dPIOQuantity - MRP_REPLANNING.arrMRPDocData[0].dRaisedQuantity;
            var Data = MRP_REPLANNING.arrMRPDocData;
            var urlPath = GLOBAL.getContextPath("CancelPlannedPOForPIO", "MRPRePlanning", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { PIODetailId: Data[0].iPIODetailsID, MainProduct: Data[0].iProductID, ProducedQty: Data[0].dAdjQty, OptionType: 3 }, "JSON", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
            if (fnResult.lValue > 0 && fnResult.data != null) {
                return fnResult.data;
            }
            else
                return null;
        }
        catch (e) {
            COMMON.prototype.showMessage("{MRP_REPLANNING.CancelPlannedProdOrder} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
            return null;
        }
    },

    // Discard PIO changes and reset to initial order
    DiscardPlanningChanges: function () {
        try {
            ////debugger;
            if (MRP_REPLANNING.GetSelectedOrderCount() > 0) {
                var arrPlanningData = [];
                for (var i = 0; i < MRP_REPLANNING.arrRePlanningData.length; i++) {
                    if (FGRIDCONTROL.getColumnCheckboxState("Id_PlannedOrderGrid_MRPRePlanning", (i + 1), 1) == true) {
                        if (MRP_REPLANNING.arrRePlanningData[i].sVoucherNo != "" && MRP_REPLANNING.arrRePlanningData[i].sVoucherNo != null && parseInt(MRP_REPLANNING.arrRePlanningData[i].sVoucherNo) > 0 &&
                            MRP_REPLANNING.arrRePlanningData[i].iProductID > 0 && MRP_REPLANNING.arrRePlanningData[i].sTransactionID != "" && parseFloat(MRP_REPLANNING.arrRePlanningData[i].sTransactionID) > 0) {
                            arrPlanningData.push(MRP_REPLANNING.arrRePlanningData[i]);
                        }
                    }
                }
                if (arrPlanningData.length > 0) {
                    if (arrPlanningData.length == 1) {
                        var voucherId = 0;
                        var productId = 0;
                        var transactionId = 0;
                        if (arrPlanningData.length > 0) {
                            voucherId = parseInt(arrPlanningData[0].sVoucherNo);
                            productId = parseInt(arrPlanningData[0].iProductID);
                            transactionId = parseInt(arrPlanningData[0].sTransactionID);
                        }
                        if (voucherId > 0) {
                            var urlPath = GLOBAL.getContextPath("SavePIODiscardChanges", "MRPRePlanning", "MRP");
                            var fnResult = NETWORK.executeServerMethod(urlPath, true, { iVoucherId: voucherId, iProductId: productId, iPIOId: transactionId }, "JSON", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                            if (fnResult.lValue > 0 && fnResult.data != null) {
                                if (fnResult.data == true) {
                                    //COMMON.prototype.showMessage("Changes are Successfully Discarded..", "Re-Planning")
                                    COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgChangesAreSuccessfullyDiscarded, MRP_REPLANNING.MRP_REPLANNINGMsgs.RePlanning)
                                    MRP_REPLANNING.GetRePlanningDocumentData();
                                }
                                else {
                                    //COMMON.prototype.showMessage("Discard changes failed to update the PIO", "Re-Planning")
                                    COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgDiscardChangesFailedToUpdateThePIO, MRP_REPLANNING.MRP_REPLANNINGMsgs.RePlanning)
                                }
                            }
                        }
                    }
                    else {
                        //COMMON.prototype.showMessage("Select any one Order to Process Changes.", "Re-Planning")
                        COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgSelectAnyOrderToProcessChanges, MRP_REPLANNING.MRP_REPLANNINGMsgs.RePlanning)
                    }
                }
                else {
                    //COMMON.prototype.showMessage("Select any Order to Process..", "Re-Planning")
                    COMMON.prototype.showMessage(MRP_REPLANNING.MRP_REPLANNINGMsgs.MRP_RP_msgSelectAnyOrderToProcess, MRP_REPLANNING.MRP_REPLANNINGMsgs.RePlanning)
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MRP_REPLANNING.DiscardPlanningChanges} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    },

