                    if (PREFERENCES.lstScreenTypeId.indexOf(parseFloat(data)) == -1 || parseFloat(data) == 0) {
                        PREFERENCES.lstScreenTypeId[cellobj.iRow - 1] = (parseFloat(data));
                        cellobj.setCellData("value", data);
                        cellobj.setCellText(stext);
                        PREFERENCES.lstDetailCosting[cellobj.iRow - 1].SceenFieldId = parseFloat(data);
                        PREFERENCES.lstDetailCosting[cellobj.iRow - 1].bSelect = true;
                    } else {
                        for (var i = 0; i < FGRIDCONTROL.getTotalRows(sGrid) ; i++) {
                            if (i == (cellobj.iRow - 1)) {
                                continue;
                            }
                            var objCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, 3);
                            if (parseFloat(objCell.getCellData()) == parseFloat(data)) {
                                cellobj.setCellData("value", 0);
                                cellobj.setCellText("");
                                COMMON.prototype.showMessage(PREFERENCES.PREFERENCESMsgs.MRP_PR_msgScreenFieldAlreadySelected, PREFERENCES.PREFERENCESMsgs.lblErrorMsg);
                                break;
                            }
                            else {
                                cellobj.setCellData("value", data);
                                cellobj.setCellText(stext);
                            }
                        }
                    }
                }
                else {
                    cellobj.processDefault(event);
                }
            } else {
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "ScreenType") {
                    var cell = FGRIDCONTROL.getCellObject(cellobj.Grid, cellobj.iRow, (cellobj.iColumn - 2));
                    if (cell.cell.children[0].checked) {
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
