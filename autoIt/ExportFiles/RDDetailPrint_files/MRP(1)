    // Set Quantity Grid Based on Lots and selected Policy
    this.SetLotsQuantityByPolicy = function () {
        try {
            ////debugger;
            var ChildProds = MAIN_MRPPROCESS.MRPSelectedProds;
            var arrLotQuantity = [];
            //var quantity = 0;
            //var availableStock = 0;
            //var totalQuantity = 0;
            for (var i = 0; i < ChildProds.length; i++) {
                arrLotQuantity.push(ChildProds[i].dPendingQuantity);
                //quantity += parseInt(ChildProds[i].dPendingQuantity);
                //if (MAIN_MRPPROCESS.IsValidObject(ChildProds[i].dPIOPendingQuantity) == true) {
                //    totalQuantity += parseInt(ChildProds[i].dPIOPendingQuantity);
                //}
                //else {
                //    totalQuantity += parseInt(ChildProds[i].dPendingQuantity);
                //}
            }
            var LotQuantity = 0;
            for (var i = 0; i < arrLotQuantity.length; i++) {
                LotQuantity += parseFloat(arrLotQuantity[i]);
            }
            var policyId = 3; /// For Order-To-Order Policy
            if (LotQuantity > 0) {
                switch (policyId) {
                    case 0:
                        break;
                    case 1: /// ReOrderLevel : Min = reOrderQty && Max = maxOrderQty                
                        var arrLotsQty = MAIN_MRPPROCESS.CalculateLotsQuantity(LotQuantity, MAIN_MRPPROCESS.MRPProductPolicy[0].dReorderQty, MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxOrderQty, false);
                        MAIN_MRPPROCESS.arrLotsQuantity = (arrLotsQty);
                        break;

                    case 2: /// MaxLevel : Min = minOrderQty && Max = maxOrderQty
                        var arrLotsQty = MAIN_MRPPROCESS.CalculateLotsQuantity(LotQuantity, MAIN_MRPPROCESS.MRPProductPolicy[0].dMinOrderQty, MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxOrderQty, true);
                        MAIN_MRPPROCESS.arrLotsQuantity = (arrLotsQty);
                        break;

                    case 4: /// LotToLot : Min = minOrderQty && Max = maxOrderQty
                        var arrLotsQty = MAIN_MRPPROCESS.CalculateLotsQuantity(LotQuantity, MAIN_MRPPROCESS.MRPProductPolicy[0].dMinOrderQty, MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxOrderQty, false);
                        MAIN_MRPPROCESS.arrLotsQuantity(arrLotsQty);
                        break;

                    case 3: /// OrderToOrder : Raise Lots For The Complete Order Quantity
                        MAIN_MRPPROCESS.arrLotsQuantity = (arrLotQuantity);
                        break;
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.SetLotsQuantityByPolicy} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Calculate final Lot quantities to set on Quantity Grid.
    this.CalculateLotsQuantity = function (totalLotQty, minOrderQty, maxOrderQty, bIsMaxLevel) {
        var arrLotQuantity = [];

        try {
            ////debugger;
            if (!bIsMaxLevel) {
                var totalSafetyStock = 0;
                for (var j = 0; j < MAIN_MRPPROCESS.MRPProductPolicy.length; j++) {
                    totalSafetyStock += parseFloat(MAIN_MRPPROCESS.MRPProductPolicy[j].dSafetyStock);
                }
                totalLotQty += totalSafetyStock;
            }
            else {
                var totalSafetyStock = 0;
                if (MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxInventory > MAIN_MRPPROCESS.MRPProductPolicy[0].dReordePoint &&
                    MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxInventory > MAIN_MRPPROCESS.MRPProductPolicy[0].dSafetyStock) {
                    for (var j = 0; j < MAIN_MRPPROCESS.MRPProductPolicy.length; j++) {
                        totalSafetyStock += parseFloat(MAIN_MRPPROCESS.MRPProductPolicy[j].dMaxInventory);
                    }
                }
                else if (MAIN_MRPPROCESS.MRPProductPolicy[0].dReordePoint > MAIN_MRPPROCESS.MRPProductPolicy[0].dMaxInventory &&
                        MAIN_MRPPROCESS.MRPProductPolicy[0].dReordePoint > MAIN_MRPPROCESS.MRPProductPolicy[0].dSafetyStock) {
                    for (var j = 0; j < MAIN_MRPPROCESS.MRPProductPolicy.length; j++) {
                        totalSafetyStock += parseFloat(MAIN_MRPPROCESS.MRPProductPolicy[j].dReordePoint);
                    }
                }
                else {
                    for (var j = 0; j < MAIN_MRPPROCESS.MRPProductPolicy.length; j++) {
                        totalSafetyStock += parseFloat(MAIN_MRPPROCESS.MRPProductPolicy[j].dSafetyStock);
                    }
                }
                totalLotQty += totalSafetyStock;
            }

            if (maxOrderQty > 0) {
                while (totalLotQty > maxOrderQty) {
                    arrLotQuantity.push(maxOrderQty);
                    totalLotQty -= maxOrderQty;
                }
                if (totalLotQty > 0) {
                    if (totalLotQty > minOrderQty)
                        arrLotQuantity.push(totalLotQty);
                    else
                        arrLotQuantity.push(minOrderQty);
                }
            }
            else
                arrLotQuantity.push(totalLotQty);

            return arrLotQuantity;
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.CalculateLotsQuantity} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
            return arrLotQuantity = [];
        }
    }

    // Get Product details and Raise PO
    this.GetSelectedProductForRaisePO = function () {
        try {
            ////debugger;
            var totalQty = 0;
            var arrQty = [];
            for (var i = 0; i < MAIN_MRPPROCESS.arrLotsQuantity.length; i++) {
                arrQty.push(MAIN_MRPPROCESS.arrLotsQuantity[i]);
                totalQty += parseInt(MAIN_MRPPROCESS.arrLotsQuantity[i]);
            }
            var childProds = MAIN_MRPPROCESS.MRPSelectedProds;
            var arrOrders = [];
            var arrSeletedOrder = [];
            var policy = 3; /// For Order-To-Order Policy
            var count = 0;
            var adjustQty = 0;
            if (arrQty.length > 0) {
                for (var iIndex = 0; iIndex < arrQty.length; iIndex++) {
                    if (policy == 0) {
                        var pendingQuantity = 0;
                        pendingQuantity = childProds[iIndex].dPendingQuantity;
                        while (pendingQuantity > 0) {
                            if (arrQty[count] > 0) {
                                arrOrders.push(MAIN_MRPPROCESS.GetProductDetailsToRaisePO(childProds[iIndex], arrQty[count]));
                            }
                            if ((pendingQuantity - arrQty[count]) < 0) {
                                adjustQty = pendingQuantity - arrQty[count];
                            }
                            pendingQuantity -= arrQty[count];
                            count++;
                        }
                    }
                    else {
                        arrOrders.push(MAIN_MRPPROCESS.GetProductDetailsToRaisePO(childProds[iIndex], arrQty[count]));
                        count++;
                    }
                    arrSeletedOrder.push(childProds[iIndex]);
                }
                if (arrQty.length > arrOrders.length && arrOrders.length > 0) {
                    var totalLessOrder = arrQty.length - arrOrders.length;
                    for (var i = 0; i < totalLessOrder; i++) {
                        arrOrders.push(MAIN_MRPPROCESS.GetProductDetailsToRaisePO(childProds[childProds.length - 1], arrQty[count]));
                        count++;
                    }
                }
                if (arrOrders.length > 0) {
                    arrOrders = MAIN_MRPPROCESS.SetRODataBasedOnLots(arrSeletedOrder, arrOrders, totalQty);
                    if (arrOrders != null && arrOrders != undefined && arrOrders.length > 0) {
                        var urlPath = GLOBAL.getContextPath("GetRaisePO", "MRPProcess", "MRP");
                        var fnResult = NETWORK.executeServerMethod(urlPath, true, { arrOrdersToRaise: arrOrders }, "JSON", false, "MAIN_MRPPROCESS.LoadRaisingPO", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                    }
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.GetSelectedProductForRaisePO} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

