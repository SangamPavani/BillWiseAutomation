                return false;
            }
            if (window.GlobalPref.Version == eVersion.Version10) {
                $("#MRPCustomization_Tabs li").removeClass("active");
                $("#MRPCustomization_Tabs li a").removeClass("active");
                $(ele).addClass("active");
                $(ele.children[0]).addClass("active");
            } else {

                $("#MRPCustomization_Tabs li").removeClass("active");
