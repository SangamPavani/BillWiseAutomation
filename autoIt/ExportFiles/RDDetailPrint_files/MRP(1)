    LoadEnteredData: function () {
        try {
            var sGridName = RFSF.GetGridId();
            var iIssueNowColNo = 0, iProductColNo = 0, iNarrationColNo = 0, iRateColNo = 0;
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            for (var j = 0; j < TotalColumns; j++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, 1, j + 1);
                var cell = cellobj.ColumnAttribute.ctrlatt.trim();
                if (cell == "qtytoreturn") {
                    iIssueNowColNo = j + 1;
                } else
                    if (cell == "productname") {
                        iProductColNo = j + 1;
                    }
                    else
                        if (cell == "rate") {
                            iRateColNo = j + 1;
                        }
                        else
                            if (cell == "narration") {
                                iNarrationColNo = j + 1;
                            }

                if ((iIssueNowColNo > 0 && iProductColNo > 0) && (iRateColNo > 0 && iNarrationColNo > 0)) break;
            }
            if (RFSF.arrBodyData != null) {
                for (var i = 0; i < RFSF.arrBodyData.length; i++) {
                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iProductColNo);
                    var iIssueNow = cellobj.getCellData();
                    RFSF.arrBodyData[i].iProductId = parseFloat(cellobj.getCellData());
                    //vara= cellobj.getControlText();

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iIssueNowColNo);
                    RFSF.arrBodyData[i].dIssuingNow = parseFloat(cellobj.getCellData()).toFixed(RFSF.dNoOfDecimal);

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iRateColNo);
                    RFSF.arrBodyData[i].dRate = parseFloat(cellobj.getCellData()).toFixed(RFSF.dNoOfDecimal);

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iNarrationColNo);
                    RFSF.arrBodyData[i].sNarration = cellobj.getCellData();
                }
                var strError = "true;Enter Quantity To Return";
                for (var i = 0; i < RFSF.arrBodyData.length; i++) {
                    if (RFSF.arrBodyData[i].dIssuingNow > 0) {
                        strError = "";
                    }
                }
                return strError;
            }
        } catch (e) {
            COMMON.prototype.showMessage("Exception: {RFSF.LoadEnteredData} " + e.message, "Error Message");
        }
    },
    ValidationBeforeSave: function () {
        //debugger
        var strError = false + ";";
        try {
            var sGridName = RFSF.GetGridId();
            var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
            if (TotalRows != RFSF.arrBodyData.length) return strError = true + "; Data Not Loaded Correctly";

            for (var i = 0; i < TotalRows; i++) {
                if (RFSF.arrBodyData[i].dIssuingNow > 0) {
                    if (RFSF.arrBodyData[i].iProductId == 0) return strError = true + "; 'Product Name ' Cannot be Empty";

                    if (RFSF.arrBodyData[i].dIssuingNow == 0) return strError = true + "; 'Issueing Now ' should be Greater than Zero";

                    if (RFSF.arrBodyData[i].dRate == 0) return strError = true + "; 'Rate ' Cannot be Empty or Zero";

                    if (RFSF.arrBodyData[i].dRate <= 0 && RFSF.arrBodyData[i].dIssuingNow > 0) return strError = true + "; Enter Rate for all products to issue";
                }
            }

            if (false && !blnIssueToProd) {
                var arrProcessIds = [];
                for (var i = 0; i < RFSF.arrBodyData.length; i++) {
                    if (RFSF.arrBodyData[i].iProcessId > 0)
                        arrProcessIds.push(RFSF.arrBodyData[i].iProcessId);
                }
                for (var i = 0; i < arrProcessIds.length; i++) {
                    var arrGridBodyDetails = null;
                    for (var k = 0; k < RFSF.arrBodyData.length; k++) {
                        if (RFSF.arrBodyData[k].iProcessId < arrProcessIds[i]) {
                            arrGridBodyDetails.push(RFSF.arrBodyData[k]);
                        }
                    }
                    if (arrGridBodyDetails != null && arrGridBodyDetails.Length > 0) {
                        var imax = 0;
                        for (var i = 0; i < arrGridBodyDetails.length; i++) {
                            imax = arrGridBodyDetails[i].iProcessId;
                        }
                        var iNum = 0;
                        if (imax > 0) {
                            for (var l = 0; l < arrGridBodyDetails.length; l++) {
                                if (arrGridBodyDetails[l].iProcessId == imax && (parseFloat(arrGridBodyDetails[l].IssuedQuantity) + parseFloat(arrGridBodyDetails[l].IssuingNow)) > 0) {
                                    iNum++;
                                }
                            }
                            if (iNum == 0) return strError = true + "; Cannot issue if previous process are not issued";
                        }
                    }
                }
            }

            var iProdOrderId = OPTIONCONTROL.getControlValue("FOption_ProductionOrderNo_RFSF");
            var sProdOrder = OPTIONCONTROL.getControlText("FOption_ProductionOrderNo_RFSF");
            if (!RFSF.bCompleteHeirachy) {
                //if ((parseInt(RFSF.arrObjProductonOrder[0]) != iProdOrderId) && (RFSF.arrObjProductonOrder[2] != sProdOrder))
                //   return true + "; Production Order is Not Matched in Details Grid..Select Correct Production Order.";
                arrObjProductonOrder = {
                    0: iProdOrderId,
                    2: sProdOrder
                }
                RFSF.arrObjProductonOrder[0] = iProdOrderId,
                RFSF.arrObjProductonOrder[2] = sProdOrder
            }
            else {
                var iProductionOrderiD = RFSF.arrBodyData[0].iProdOrderId;
                if (iProductionOrderiD != iProdOrderId) return strError = true + "; Production Order is Not Matched in Details Grid..Select Correct Production Order.";
            }
        } catch (e) {
            COMMON.prototype.showMessage("Exception: {RFSF.ValidationBeforeSave} " + e.message, "Error Message");
        }
        return strError;
    },
