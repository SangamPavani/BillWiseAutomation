                //debugger
                for (var j = 0; j < TotalColumns; j++) {
                    cellobj = FGRIDCONTROL.getCellObject(sGridName, iRow, j + 1);
                    var cell = cellobj.ColumnAttribute.ctrlatt.trim()
                    switch (cell) {
                        case "WorkCenter":
                            OPTIONCONTROL.setControlValue(cellobj.ColumnAttribute.ctrlid, data.iWorkCenter);
                            //cellobj.setControl(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellData("value", data.iWorkCenter);
                            break;
                        case "ActualQty":
                            //cellobj.setCellText(parseFloat(data.dTotalQty).toFixed(RF_PRODUCTION.dNoOfDecimals));
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data.dTotalQty, RF_PRODUCTION.dNoOfDecimals)));
                            cellobj.setCellData("value", data.dTotalQty);
                            break;
                        case "PartialReleasedQty":
                            if (data.iOutPutType == 3) {
                                var PendingProdQty = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("IssuedQty"), RF_PRODUCTION.dNoOfDecimals);
                                var AlreadyReceivedProdQty = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("ReceivedProdQty"), RF_PRODUCTION.dNoOfDecimals);
                                var POQuantity = PendingProdQty + AlreadyReceivedProdQty;
                                data.dPartialReleasedQty = POQuantity * data.dMainOutputQty
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data.dPartialReleasedQty, RF_PRODUCTION.dNoOfDecimals)));
                                cellobj.setCellData("value", data.dPartialReleasedQty);
