                } else if (cellobj.ColumnAttribute.ctrlatt.trim() == "rma") {
                    data = cellobj.CellData.value;
                    stext = cellobj.sText;
                    IssueTP.arrBodyData[cellobj.iRow - 1].RMA = stext;
                    FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow, IssueTP.ExtafieldsColumnNo);
                } else if (cellobj.ColumnAttribute.ctrlatt.trim() == "productType") {

                    data = cellobj.CellData.value;
                    stext = cellobj.sText;
                    cellobj.processDefault(event);
                } else if (cellobj.ColumnAttribute.ctrlatt.trim() == "bins") {
                    data = cellobj.CellData.value;
                    if (stext == "")
                        stext = cellobj.sText;
                    if (IssueTP.bRMAEnabled == false) {
                        FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow, IssueTP.ExtafieldsColumnNo);
                    }
                }               
                if (cellobj.ColumnAttribute.ctrlcount == "12") {
                    var ele = document.getElementById('divEntryField_container_ISPO').dataset;
                    if (parseInt(cellobj.ColumnAttribute.ispo_body_tagid) == parseInt(ele.inventorytype)) {
                        if (IssueTP.arrInventory.length == cellobj.iRow && IssueTP.arrInventory.length < cellobj.iRow) {
                            //IssueTP.arrBodyData[cellobj.iRow - 1].iWareHouseId = parseInt(data);
                            //IssueTP.GetStocks(cellobj.iRow)
                            IssueTP.arrInventory.push(data);
                        } else {
                            IssueTP.arrInventory[cellobj.iRow - 1] = parseInt(data);
                        }
                        if (IssueTP.IsNewRow(cellobj.iRow) == false) {
                            IssueTP.arrBodyData[cellobj.iRow - 1].iWareHouseId = parseInt(data);
                            IssueTP.GetStocks(cellobj.iRow)
                        }
                        IssueTP.LoadFooterData();
                        if (window.GlobalPref.Version == eVersion.Version9) {
                            var sGridName = IssueTP.GetGridId();
                            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
                            for (var k = 0; k < TotalColumns; k++) {
                                var batchcellobj = FGRIDCONTROL.getCellObject(sGridName, cellobj.iRow, k + 1);
                                var cell = batchcellobj.ColumnAttribute.ctrlatt.trim();
                                if (cell == "batch") {
                                    batchcellobj.setCellData("value", "");
                                    batchcellobj.setCellText("");
                                    break;
                                }
                            }
                        }

                    }
                }
                cellobj.setCellData("value", data);
                cellobj.setCellText(stext);
                //debugger
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "issueingnow") {
                    IssueTP.LoadFooterData();
                    if (IssueTP.bBatchEnabled == false) {
                        if (IssueTP.bBinEnabled == false) {
                            if (IssueTP.bRMAEnabled == false) {
                                FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow, IssueTP.ExtafieldsColumnNo);
                            }
                        }
                    }
                }
            } else {
                cellobj.processDefault();
            }
            if (cellobj.ColumnAttribute.ctrlcount == "12" && IssueTP.arrTagBody.length == cellobj.iColumn) {
                FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow, IssueTP.IssueNowColNo);
            } else if (cellobj.ColumnAttribute.ctrltags == "ExtraField") {
                if (IssueTP.arrExtraFieldBody[IssueTP.arrExtraFieldBody.length - 1].sFieldName == cellobj.ColumnAttribute.colid) {
                    if (IssueTP.arrTagBody.length > 0) {
                        FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow + 1, 1);
                    } else {
                        FGRIDCONTROL.gotoNextCell(document.getElementById("Id_MRPIssueToProduction_Grid"), cellobj.iRow + 1, IssueTP.IssueNowColNo);
                    }
                }
            }
            return true;
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {IssueTP.OnLeaveGrid} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {IssueTP.OnLeaveGrid} " + e.message, MRP_ISTPO.MRP_ISTPOMsgs.lblErrorMsg);
        }
    }

    this.GetRateFromBatch = function (iRow, BatchId) {
        var ObjData = OPTIONCONTROL.getControlDataObject('FOption_ProductionOrderNo_ISPO');
        var iVoucherDate = DATEPICKER.getDate("fDatePicker_IssueDate");
        var urlPath = GLOBAL.getContextPath("GetStock", "IssueToProduction", "MRP");
        var fnResult = NETWORK.executeServerMethod(urlPath, true, {
            ObjBody: IssueTP.arrBodyData[iRow - 1], iOrderDueDate: iVoucherDate, iBatch: BatchId
        },
            "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        if (fnResult.lValue > 0 && fnResult.data != "") {
            //// //debugger
            var ObjStocksStruct = fnResult.data.ObjStocksStruct;
            var sGridName = IssueTP.GetGridId();
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            var dRate = ObjStocksStruct.dBuyingRate == 0 ? parseFloat(ObjStocksStruct.dAvaerageRate).toFixed(IssueTP.iDecimalsInCurrency) : parseFloat(ObjStocksStruct.dBuyingRate).toFixed(IssueTP.iDecimalsInCurrency);
            if (parseInt(dRate) > 0) {
                cellData = FGRIDCONTROL.getCellObject(sGridName, parseInt(iRow), IssueTP.iRateColumnNo);
