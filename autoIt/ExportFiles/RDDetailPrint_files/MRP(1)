    LoadOutPutAfterLink: function (lstData) {
        try {
            //if (ROUTING.bFromTemplate) return false;
            var iFrom = lstData.fromOperator.split('_')[1];
            var iTo = lstData.toOperator.split('_')[1];
            var ObjInput = {}, ObjOutPut = {};
            var Obj = {};
            var arrInput = [];

            ObjInput = ROUTING.arrRoutingNodes.find(p=>p.iNodeSeq == iFrom);

            if (ObjInput != null || ObjInput != undefined) {
                if (ObjInput.arrRoutingOutput != null) {
                    if (ObjInput.arrRoutingOutput.length > 0) {
                        for (var j = 0; j < ObjInput.arrRoutingOutput.length; j++) {
                            Obj = ROUTING.LoadOutPut(ObjInput.arrRoutingOutput[j]);
