    GetOrderStatusString: function (iOrderStatus) {
        var sOrderStatus = "";
        switch (iOrderStatus) {
            case 0:
                sOrderStatus = "Planned";
                break;
            case 1:
                sOrderStatus = "Not Released";
                break;
            case 2:
                sOrderStatus = "Released";
                break;
            case 3:
                sOrderStatus = "WIP";
                break;
            case 4:
                sOrderStatus = "Finished";
                break;
            case 6:
                sOrderStatus = "Closed";
                break;
            default:
                sOrderStatus = "";
        }
        return sOrderStatus;
    },

