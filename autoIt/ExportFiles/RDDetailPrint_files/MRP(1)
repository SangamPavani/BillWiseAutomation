    // Set Quantity Grid based on selected policy type and available quantity
    SetOrderQuantityByPolicy: function (bSetPolicy,sProductName) {
       
        //debugger;
        MRP_DEPREQ.iSelectedQuantityRowIndex = 0;
        if (MRP_DEPREQ.iSelectedOrderRowIndex > -1) {
            FGRIDCONTROL.clearData("Id_OrderQuantity_FGrid", true);
            //MRP_DEPREQ.arrOrdersQuantity = [];
            if (sProductName != "" && sProductName != undefined && sProductName != null) {
                var index = MRP_DEPREQ.DepReqData.lstMRPProductDetails.findIndex(p => p.Name === sProductName);
                var mappedIndex = index > -1 ? index : 0;
                document.getElementById("txtProductNameId").innerText = MRP_DEPREQ.DepReqData.lstMRPProductDetails[mappedIndex].Name;
                document.getElementById("txtProductCodeId").innerText = MRP_DEPREQ.DepReqData.lstMRPProductDetails[mappedIndex].Code;
