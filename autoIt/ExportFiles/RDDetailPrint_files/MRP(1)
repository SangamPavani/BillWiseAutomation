    // Get the all order documents/details for MRP Process based on selected filters.
    GetDocumentData: function () {
        //debugger;        
        MRP_PROCESS.btnClicked = true;
        if (QUICKMRP.MenuId != 3020) {
            QUICKMRP.bfromQuickMRP = false;
        }
        //$("#id_InsertSchedule_Modal_MRPProcess").modal("show");
        //return
        var startDate = DATEPICKER.getDate("fDatePicker_Filter_StartDate");
        var endDate = DATEPICKER.getDate("fDatePicker_Filter_EndDate");
        if (startDate > endDate) {
            //COMMON.prototype.showMessage("Start Date should not be grater than End Date", "MRP Process"); //MRP Process Changed To Error Message
            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_PP_msgStartDateShouldNotGreaterThanEndDate, MRP_PROCESS.MRP_PROCESSMsgs.lblErrorMsg);
            return;
        }
        var customerId = OPTIONCONTROL.getControlValue("FOption_Filter_Customer");
        if (customerId == null)
            customerId = 0;
        var productId = OPTIONCONTROL.getControlValue("FOption_Filter_Product");

        if (productId == null)
            productId = 0;
        var replenishmentTypeId = 1;
        var wareHouseId = 0;
        var arrFocusTag = [];
        if (MRP_PROCESS.arrFocusTags != null) {
            if (MRP_PROCESS.arrFocusTags.length > 0) {
                for (var i = 0; i < MRP_PROCESS.arrFocusTags.length; i++) {
                    var tagValue = OPTIONCONTROL.getControlValue("Id_FTag_" + MRP_PROCESS.arrFocusTags[i].FieldName + "_MRPProcess");
                    tagValue = isNaN(parseInt(tagValue)) == true ? 0 : parseInt(tagValue);
                    if (tagValue > 0) {
                        MRP_PROCESS.arrFocusTags[i].FieldValue = tagValue;
                        arrFocusTag.push(MRP_PROCESS.arrFocusTags[i]);
                    }
                }
            }
        }
        var iOrderTypeFilter = 0;
        if (document.getElementById("chkAllOrders").checked == true) {
            iOrderTypeFilter = 0;
        }
        else if (document.getElementById("chkSalesOrders").checked == true) {
            iOrderTypeFilter = 1;
        }
        else if (document.getElementById("chkPlannedIndependentOrders").checked == true) {
            iOrderTypeFilter = 2;
