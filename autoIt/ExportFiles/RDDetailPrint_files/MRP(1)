            return false;
        }

        if (iRouting == 0 && ROUTING.bConfirmCount < 1 && ROUTING.bCheckDFSave == false) {
            if (confirm("Do You want to Save this Routing as Default ")) {
                bCheckDefault = true;                
            }
            ROUTING.bCheckDFSave = true;
        }

        selectMastersResult = NETWORK.executeServerMethod(url, true, {
            objRoutingHeader: ObjHeader
        }, "json", false);
