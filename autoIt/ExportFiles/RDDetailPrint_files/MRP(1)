    PullSuccess: function (bsuccess, data) {
        debugger;
        try {
            if (bsuccess == true) {
                if (data.lstErrors.length > 0) {
                    var lstELogdata = data.lstErrorLogs;
                    if (lstELogdata.length > 0 && data.objMRPScreen != MRPScreens.PIO) {
                        MRP_Import.lstErrorLogMsg = lstELogdata;
                        var html = '';
                        for (var i = 0; i < lstELogdata.length; i++) {
                            html += '<tr>';
                            html += '<td style="border-right: 1px solid;border-left: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].iId + '</td>';                                                  
                            if (data.objMRPScreen == MRPScreens.BOM) {
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].sName + '</td>';      
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].sCode + '</td>';
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].sMainProductName + '</td>';
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].sMainProductCode + '</td>';
                                if ((lstELogdata[i].sErrorMessage == null || lstELogdata[i].sErrorMessage == "") && data.bImport != "Please Check Log File Some BOMs are Not Imported") {
                                    lstELogdata[i].sErrorMessage = " --> " + data.bImport;
                                }
                            }
                            else {
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].sCode + '</td>';
                                html += '<td style="border-right: 1px solid;border-bottom: 1px solid;">' + lstELogdata[i].iExtraId + '</td>';
