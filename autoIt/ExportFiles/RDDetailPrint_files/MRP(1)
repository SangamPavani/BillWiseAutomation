                        cellobj.setCellData("value", iSequence);
                        cellobj.setCellText(iSequence);
                        
                        
                        break;
                    default:
                        cellobj.processDefault();
                }
            } else {
                if (cellobj.iColumn == 2) {
                    var iBOMTag = OPTIONCONTROL.getControlValue("FOption_BOMTag_BTD");
                    //if (iBOMTag > 0) {
                    //    var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
