                            options.remove();
                            ROUTING.RemoveGridRow(iBodyId);
                            document.getElementById("div_AddNode").setAttribute("data-value", 0);
                            R_WORKCENTER.ClearGridRowData("Id_OutputGrid_WorkCenter_Routing", arrBOMOutput.length);
                            COMMON.prototype.showMessage("Deleted Node successfully.", "Success Message");
                        }
                    }
                } else {
                    if (operatorId.split('_')[1] != undefined) {
                        var iBodyId = operatorId.split('_')[1];
                        for (var i = 0; i < ROUTING.arrRoutingNodes.length; i++) {
                            if (ROUTING.arrRoutingNodes[i].iNodeSeq == iBodyId)
