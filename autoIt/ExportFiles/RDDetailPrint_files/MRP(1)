    /**Binding Requisition status Data in Grid*/
    BindRequisitionTestStatusGrid: function () {
        try {
            //debugger
            var GridID = "Id_RequisitionConfirm_FGrid";
            FGRIDCONTROL.deleteRows(GridID, 1, FGRIDCONTROL.getTotalRows(GridID));
            FGRIDCONTROL.insertRows(GridID, 1, REQUISITION.lstRequistionTestStatus.length);

            var iTotalColumns = FGRIDCONTROL.getTotalColumns(GridID);
            for (var i = 0; i < REQUISITION.lstRequistionTestStatus.length; i++) {
                for (var j = 1; j <= iTotalColumns; j++) {
                    var cell = FGRIDCONTROL.getCellObject(GridID, (i + 1), j);
                    switch (j) {
                        case 1:
                            OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, REQUISITION.lstRequistionTestStatus[i].TestDefHeaderId)
                            cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                            cell.setCellData("value", REQUISITION.lstRequistionTestStatus[i].TestDefHeaderId);
                            break;
                        case 2:
                            var Result = REQUISITION.lstRequistionTestStatus[i].iResult;
                            cell.setCellText((Result == 0) ? "Failed" : "Passed");
                            cell.setCellData("value", Result);
                            break;
                        case 3:
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, REQUISITION.lstRequistionTestStatus[i].IsMandatory);
                            break;
                        case 4:
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, REQUISITION.lstRequistionTestStatus[i].bQCDone);
                            break;
                        case 5:
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, REQUISITION.lstRequistionTestStatus[i].bReTestApplicable);
                            break;
                    }
                }
            }

            $("#Id_RequisitionConfirm_FGrid input[type='checkbox']").prop("disabled", true);
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {REQUISITION.BindRequisitionTestStatusGrid} " + err.message, REQUISITION.REQUISITIONMsgs.QC_TD_msgException);
