    ProcessStockSubMaterial: function (PDRParentId, sProdOrderNo) {
        try {
            debugger
            var ReplenishmentType = -1;
            var PDRChildID = 0;
            for (var i = 0; i < MRP_PROCESS.arrMRPProcessingDetail.length; i++) {
                if (MRP_PROCESS.arrMRPProcessingDetail[i].iPDRParentID == PDRParentId) {
                    MRP_PROCESS.MainRowID = i;
