                        OBJPPPW.dAlreadyReceiveQty = objWC.WCReceivedQty - ERF_PRODUCTION.QtyDoneNow;
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "QtyToReceive") {
                        if (arrRowData[j].Value == "" || arrRowData[j].Value == 0) {
                            //ERF_PRODUCTION.sError = "Enter Quantity To Receive.";
