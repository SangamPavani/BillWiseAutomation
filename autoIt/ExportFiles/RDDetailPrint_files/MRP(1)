    ConfirmOk: function () {
        //debugger;                        
        $('#UploadExcelFile1').submit(function (e) {
            e.preventDefault();
            //debugger;

            var FileUploaddata = $("#UploadedFileId1").val();
            if (FileUploaddata == null || FileUploaddata == "" || FileUploaddata == undefined) {
                COMMON.prototype.showMessage("Select Any File", "Error Message");
                return false;
            }
            var ScreenId = document.getElementById("objMRPScreen").value;
            if (ScreenId == MRPScreens.BOM) {
                var form = $('#UploadExcelFile1')[0];
                var data = new FormData(form);
                data.append("objMRPScreen", MRPScreens.BOM);
            }
            else if (ScreenId == MRPScreens.Routing) {
                var form = $('#UploadExcelFile1')[0];
                var data = new FormData(form);
                data.append("objMRPScreen", MRPScreens.Routing);
            }
            else if (ScreenId == MRPScreens.PIO) {
                var form = $('#UploadExcelFile1')[0];
                var data = new FormData(form);
                data.append("objMRPScreen", MRPScreens.PIO);
            }

            GLOBAL.LoadingStart();
            $.ajax({
                url: GLOBAL.getContextPath("MRPImport", "MRPImports", "MRP"),
                type: "POST",
                //data: new FormData(this),
                data: data,
                cache: false,
                contentType: false,
                processData: false,
                success: function (data) {
                    MRP_Import.LoadImport_onSuccess(true, data);
                    GLOBAL.LoadingEnd();
                },
                error: function (xhr, error, status) {
                    GLOBAL.LoadingEnd();
                }
            });
        });

    },

    LoadImport_onSuccess: function (bsuccess, data) {
        //debugger;

        $("#ImportBOM_Modal").modal('hide');
        $("#GetImportDetails_Modal").modal('show');

        MRP_Import.ImportDataPush = data;

        if (data.BOM == MRPScreens.BOM) {
            $("#Import_HBody").empty();
            $("#Import_BBody").empty();
            MRP_Import.loadBOMData();
        }
        else if (data.Routing == MRPScreens.Routing) {
            $("#Import_RHBody").empty();
            $("#Import_RBPBody").empty();
            $("#Import_RNBody").empty();
            $("#Import_RNDBody").empty();
            $("#Import_ROBody").empty();
            $("#Import_RPBody").empty();
            MRP_Import.loadRoutingData();
        }
        else if (data.PIO == MRPScreens.PIO) {
            $("#Import_HBody").empty();
            $("#Import_BBody").empty();
            MRP_Import.loadPIOData();
        }
    },

