                    case "AlreadyRecievedQty":
                        iAlreadyReceivedQtyTot = iAlreadyReceivedQtyTot + iTempVal;
                        Footcell.children[cellobj.iColumn].setAttribute("style", styleq);
                        Footcell.children[cellobj.iColumn].innerHTML = FConvert.addNumericSeparator(FConvert.toDecimal(iAlreadyReceivedQtyTot, RF_PRODUCTION.dNoOfDecimals));
                        Footcell.children[cellobj.iColumn].innerText = FConvert.addNumericSeparator(FConvert.toDecimal(iAlreadyReceivedQtyTot, RF_PRODUCTION.dNoOfDecimals));
