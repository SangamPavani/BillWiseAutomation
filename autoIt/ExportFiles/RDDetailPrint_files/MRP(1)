    // Get Safety Quantities and stock by Policy
    ApplySafetyPolicy: function (objProductionDetail) {
        var ResultData = {
            MaxQty: 0,
            MinQty: 0,
            SafetyStock: 0,
        };
        try {
            var dMax = parseFloat(objProductionDetail.dMaxOrderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
            var dMin = parseFloat(objProductionDetail.dMinOrderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
            var dReorderQty = parseFloat(objProductionDetail.dReorderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
            var dSafetyStock = parseFloat(objProductionDetail.dSafetyStockQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
            var iReOrderPolicy = 0;
            if (objProductionDetail.sReplenishmentTypeName == "Purchase") {
                if (MRP_PROCESS.bRDR == true) {
                    iReOrderPolicy = document.getElementById("rdoRaiseSingleOrderForQty_MRPProcessing").checked == true ? 0 : parseInt(objProductionDetail.iReorderPolicy);
                }
                else
                    iReOrderPolicy = parseInt(objProductionDetail.iReorderPolicy);
            }
            else {
                iReOrderPolicy = parseInt(objProductionDetail.iReorderPolicy);
            }
            if (iReOrderPolicy == 0 || iReOrderPolicy == 3) {
                ResultData.MaxQty = 0;
                ResultData.MinQty = 0;
                ResultData.SafetyStock = 0;
            }
            else if (iReOrderPolicy == 2 || iReOrderPolicy == 4) {
                ResultData.MaxQty = dMax;
                ResultData.MinQty = dMin;
                ResultData.SafetyStock = dSafetyStock;
            }
            else if (iReOrderPolicy == 1) {
                ResultData.MaxQty = dMax;
                ResultData.MinQty = dReorderQty;
                ResultData.SafetyStock = dSafetyStock;
            }

        } catch (e) {
            alert("Exception: {MRP_PROCESS.ApplySafetyPolicy} " + e.message);
        }
        return ResultData;
    },

    FillPOTable: function (ParentTableId, ChildTableID, RatioQty, MaxQty, MinQty, DueDate, VendorID,
        BuyingRate, dSafetyStockQty, Type, iRoutingID, ProcureType, strBatch, VariantID, bRoundOff) {
        try {

            var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(ParentTableId);
            if (iTableExists > 0) {
                var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(ParentTableId);
                var ParentRowCount = MRP_PROCESS.GetCountFromMRPDataCollection(iTableIndex);
                var Qty;
                iWarehouseID = parseInt(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iWarehouseID);
                for (var i = 0; i < MRP_PROCESS.arrMRPPODataCollection[iTableIndex].length; i++) {
                    if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].iType == 0 && MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].RaisedQty > 0) {
                        var SafetyStockQty = 0;
                        if (i == ParentRowCount) {
                            SafetyStockQty = dSafetyStockQty;
                        }

                        var dTempRatioQty = RatioQty / MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].dRatio;
                        MRP_PROCESS.dRatioQuantity = MRP_PROCESS.bFromDPR == true ? parseFloat(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dPendingQty) :
                            parseFloat(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].RaisedQty).toFixed(MRP_PROCESS.iDecimalInQuantity) * dTempRatioQty;

                        // Provided Option for Changing of RM Qty While Planning
                        if (MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].bEditedQuantity == true) {
                            MRP_PROCESS.dRatioQuantity = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].dPendingQty);
                        }

                        Qty = MRP_PROCESS.dRatioQuantity;
                        Qty = bRoundOff == true ? Math.ceil(Qty) : Qty;
                        var TotQty = Qty;
                        //
                        if (ProcureType == 2) {
                            MRP_PROCESS.FillIssueToProduction(MRP_PROCESS.iMaterialID, parseInt(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iUnitID, Qty,
