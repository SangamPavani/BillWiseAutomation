            QUICKMRP.bfromQuickMRP = true;
            MRP_PROCESS.iProductionPlanningDoneCount = 0;
            MRP_PROCESS.iTotalProductionOrderQuantity = 0;
            var lstinternaldata = [];
            if (MRP_PROCESS.IsValidObject(MRP_PROCESS.MRPDocData) == true) {
                if (MRP_PROCESS.MRPDocData.length > 0) {
                    if (document.getElementById("chkFilterOptions_QuickMRP").checked == true) {
                        if (document.getElementById("rdoDoMRP_QuickMRP").checked == false) {
                            QUICKMRP.bMRP = false;
                            QUICKMRP.bMPS = true;
                        }
                        QUICKMRP.bApplyFilter = true;
                        QUICKMRP.iLotsProductPolicy = parseInt($("#ProductPolicies_QuickMRP .Fradio:checked").val());
                        QUICKMRP.bShowPolicy = document.getElementById("chkShowLotsPolicyPopUpOpt_QuickMRP").checked;
                        QUICKMRP.bShowRaisePO = document.getElementById("chkShowRaisePOPopUpOpt_QuickMRP").checked;
                        QUICKMRP.bShowExplodeBOM = document.getElementById("chkShowExpBOMPopUpOpt_QuickMRP").checked;
                        QUICKMRP.bShowVendorForPO = document.getElementById("chkShowVendorsPopUpOpt_QuickMRP").checked;
                        if (QUICKMRP.bMrp2Enabled == true)
                            QUICKMRP.bProdStartDateChecked = document.getElementById("chkPOStartDate_QuickMRP").checked;
                        if (document.getElementById("rbtnRaisePurchaseOpt_QuickMRP").checked == true) {
                            QUICKMRP.bRaisePurchaseOrder = true;
                            QUICKMRP.bRaiseDMR = false;
                            QUICKMRP.bShowVendorForPO = document.getElementById("chkShowVendorsPopUpOpt_QuickMRP").checked;
                        }
                    }
                    else {
                        QUICKMRP.ResetFilterData();
                    }
                    MRP_PROCESS.CurrentTab = 2;
                    var totalRows = FGRIDCONTROL.getTotalRows("Id_ProductDetails_FGrid");
                    MRP_PROCESS.MRPSelectedProds = [];
                    var hasCellData = false;
                    for (var i = 0; i < totalRows; i++) {
                        var cell = FGRIDCONTROL.getCellObject("Id_ProductDetails_FGrid", (i + 1), 2);
                        var cell2 = FGRIDCONTROL.getCellObject("Id_ProductDetails_FGrid", (i + 1), 3);
                        if (cell.getCheckboxState() == true) {
                            if (cell2.CellData.value != null && cell2.CellData.value != undefined) {
                                MRP_PROCESS.MRPSelectedProds.push(MRP_PROCESS.MRPDocData[i]);
                            }
                        }
                        if (cell2.CellData.value != null && cell2.CellData.value != undefined) {
                            hasCellData = true;
                        }
                    }
                    //For ProductionOrderFinishCount
                    MRP_PROCESS.sMRPPOSelected = MRP_PROCESS.MRPSelectedProds;
                    for (var i = 0; i < MRP_PROCESS.sMRPPOSelected.length; i++) {
                        var ProductId = MRP_PROCESS.sMRPPOSelected[i].sProductCode;
                        if (MRP_PROCESS.SelectedAfterFilter.length > 0) {
                            var bFound = false;
                            for (var j = 0; j < MRP_PROCESS.SelectedAfterFilter.length; j++) {
                                if (ProductId == MRP_PROCESS.SelectedAfterFilter[j].sProductCode) {
                                    bFound = true;
                                }
                            }
                            if (bFound == false)
                                MRP_PROCESS.SelectedAfterFilter.push(MRP_PROCESS.sMRPPOSelected[i]);
                        }
                        if (i == 0)
                            MRP_PROCESS.SelectedAfterFilter.push(MRP_PROCESS.sMRPPOSelected[i]);
                    }

                    if (QUICKMRP.bfromQuickMRP == true) {
                        MRP_PROCESS.ProductionOrderFinishCount = MRP_PROCESS.SelectedAfterFilter.length;
                    }
                    //debugger
                    if (MRP_PROCESS.bDontAllowToDoMROIfStockIsAvailable == true) {
                        MRP_PROCESS.arrSelectedSalesOrders = [];

                        for (var i = 0; i < MRP_PROCESS.MRPSelectedProds.length; i++) {
                            if (MRP_PROCESS.MRPSelectedProds[i].iDocumentType == 0 && MRP_PROCESS.MRPSelectedProds[i].dStocks > 0) {
                                var objSalesOrders = MRP_PROCESS.MRPSelectedProds[i];
                                MRP_PROCESS.arrSelectedSalesOrders.push(objSalesOrders);
                            }
                        }
                        if (MRP_PROCESS.arrSelectedSalesOrders.length > 0) {
                            GLOBAL.LoadingEnd();
                            MRP_PROCESS.LoadStockAdjustmentsForSalesOrder();
                            return;
                        }
                    }


                    if (MRP_PROCESS.MRPSelectedProds.length > 0) {
                        for (var i = 1; i < MRP_PROCESS.MRPSelectedProds.length; i++) {
                            if (MRP_PROCESS.MRPSelectedProds[i - 1].iReplenishmentType != MRP_PROCESS.MRPSelectedProds[i].iReplenishmentType) {
                                //COMMON.prototype.showMessage("You cannot select products of both Replenishment Type", "Quick MRP");
                                COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_QM_msgYouCannotSelectProductsOfBothReplenishmentType, MRP_PROCESS.MRP_PROCESSMsgs.QuickMRP);
                                GLOBAL.LoadingEnd();
                                return false;
                            }
                        }
                    }
                    else {
                        if (hasCellData) {
                            //COMMON.prototype.showMessage("Select Orders for further Processing...", "Quick MRP");
                            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_QM_msgSelectOrdersForfurtherProcessing, MRP_PROCESS.MRP_PROCESSMsgs.QuickMRP);
                            GLOBAL.LoadingEnd();
                            return false;
                        }
                    }
                    if (MRP_PROCESS.MRPSelectedProds.length > 0) {
                        if (!MRP_PROCESS.bFromProductionPlanning) {
                            GLOBAL.LoadingStart();
                        }

                        QUICKMRP.QuickMRPFilterChecking(); // 

                    }
                    if (!MRP_PROCESS.bFromProductionPlanning && !QUICKMRP.bfromQuickMRP) {
                        GLOBAL.LoadingEnd();
                    }
                }
            }
            else {
                //COMMON.prototype.showMessage("No Record Found");
                COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgNoRecordFound);
                GLOBAL.LoadingEnd();
            }
        }
        catch (e) {
            alert("Exception: {QUICKMRP.StartProcess} " + e.message);
            GLOBAL.LoadingEnd();
        }
    },
    QuickMRPFilterChecking: function () {
        //debugger;;
        if (QUICKMRP.bApplyFilter == false) {
            // GLOBAL.LoadingStart();
            lstinternaldata = MRP_PROCESS.MRPSelectedProds;
            var arrlistProductIds = [];
            var lstselecteddataafterfilter = null;
            for (var ilstIndex = 0; ilstIndex < lstinternaldata.length; ilstIndex++) {
                MRP_PROCESS.bRoutingSubProductFailed = false;
                lstselecteddataafterfilter = [];
                if (arrlistProductIds.indexOf(lstinternaldata[ilstIndex].iProductID) > -1) {
                    continue;
                } else {
                    arrlistProductIds.push(lstinternaldata[ilstIndex].iProductID);
                    for (var irow = 0; irow < lstinternaldata.length; irow++) {
                        if (lstinternaldata[ilstIndex].iProductID == lstinternaldata[irow].iProductID) {
                            lstselecteddataafterfilter.push(lstinternaldata[irow]);
                        }
                    }
                    MRP_PROCESS.MRPSelectedProds = lstselecteddataafterfilter;
                    MRP_PROCESS.MakeLotBreakUpProductTree(lstselecteddataafterfilter);
                    MRP_PROCESS.ClearGridRowData("Id_LotQuantity_FGrid", 1);
                    //after design change
                    for (var j = 0; j < FGRIDCONTROL.getTotalRows("Id_LotOrderDetails_FGrid"); j++) {
                        var Lotscell = FGRIDCONTROL.getCellObject("Id_LotOrderDetails_FGrid", (j + 1), 5);
                        Lotscell.setCellText(0);
                        Lotscell.setCellData("value", 0);
                    }
                    $("#LotsBreakup_ProductTree li span").first().trigger('click');
                    document.getElementById("rdoMPSchedule_LotsBreakup").checked = false;
                    document.getElementById("rdoMRPlanning_LotsBreakup").checked = true;

                    // document.getElementById("ddlMRPType").value = 0;

                    document.getElementById("rbgOrderToOrder_ProductPolicies_MRPPrcs").click();
                    MRP_PROCESS.arrRaisingPO = null;
                    //debugger
                    MRP_PROCESS.CurrentTab = 2;
                    MRP_PROCESS.GetSelectedProductForRaisePO();
                    if (MRP_PROCESS.arrRaisingPO == null && QUICKMRP.bMrp2Enabled == true) {
                        document.getElementById("ddlSchedulingType").value = document.getElementById("ddlQuickSchedulingType").value;
                        //PROCESS.OnchangeSchedulingType(document.getElementById("ddlSchedulingType"));
                        MRP_PROCESS.GetRaisingPO();
                    }
                    //debugger
                    if (MRP_PROCESS.arrRaisingPO != null) {
                        if (MRP_PROCESS.GetExplodBOM() != false) {
                            if (MRP_PROCESS.PlanningPreferenceMRP() != false) {
                                if (MRP_PROCESS.bRoutingSubProductFailed == false) {
                                    if (MRP_PROCESS.DoMRP() != false) {
                                        QUICKMRP.bStopProcess = false;
                                        MRP_PROCESS.MRPProcessFinish();
                                    }
                                }
                            }
                        }
                    }
                    else {
                        if (QUICKMRP.bfromQuickMRP) {
                            GLOBAL.LoadingEnd();
                        }
                        if (QUICKMRP.bfromQuickMRP == false) {
                            //COMMON.prototype.showMessage("Order not raised, cannot continue MRP Process", "Quick MRP");
                            COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_QM_msgOrderNotRaisedCannotContinueMRPProcess, MRP_PROCESS.MRP_PROCESSMsgs.QuickMRP);
                        }
                    }
                }
            }
        }
        //Vijay
        else {
            //debugger
            MRP_PROCESS.MakeLotBreakUpProductTree(MRP_PROCESS.MRPSelectedProds);
            MRP_PROCESS.ClearGridRowData("Id_LotQuantity_FGrid", 1);
            //after design change
            for (var j = 0; j < FGRIDCONTROL.getTotalRows("Id_LotOrderDetails_FGrid"); j++) {
                var Lotscell = FGRIDCONTROL.getCellObject("Id_LotOrderDetails_FGrid", (j + 1), 5);
                Lotscell.setCellText(0);
                Lotscell.setCellData("value", 0);
            }
            $("#LotsBreakup_ProductTree li span").first().trigger('click');
            document.getElementById("rbgOrderToOrder_ProductPolicies_MRPPrcs").click();
            if (QUICKMRP.bMPS == true) {
                document.getElementById("rdoMPSchedule_LotsBreakup").click();
                document.getElementById("ddlMRPType").value = 1;
            }
            else {
                document.getElementById("rdoMRPlanning_LotsBreakup").click();
                document.getElementById("ddlMRPType").value = 0;
            }
            $('#ddlPolicys').val(QUICKMRP.iLotsProductPolicy);
            $('#ddlPolicys').trigger("change");
            $("#btnClearOrderDocs_QuickMRP").hide();
            if (QUICKMRP.bShowPolicy == true || QUICKMRP.iLotsProductPolicy == 0) {
                GLOBAL.LoadingEnd();
                $("#Planned_Orders_MrpProcess").hide();
                $("#Lots_Breakup_MrpProcess").show();
                $("#Lots_Breakup_MrpProcess").css("margin-top", "15px");
                $("#btnMRPProcess_QuickMRP").hide();
                $("#btnRaisePO_QuickMRP").show();
                return false;
            }
            //debugger
            if (MRP_PROCESS.arrRaisingPO == null && QUICKMRP.bMrp2Enabled == true) {
                document.getElementById("ddlSchedulingType").value = document.getElementById("ddlQuickSchedulingType").value;
                //PROCESS.OnchangeSchedulingType(document.getElementById("ddlSchedulingType"));
                MRP_PROCESS.GetRaisingPO();
            }
            QUICKMRP.ProcessFromRaisePO();
        }
