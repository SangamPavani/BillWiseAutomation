                                        var DateDiffInDays = DiffInMS / (1000 * 60 * 60 * 24);

                                        var iSuggestedDate = DATE.prototype.addDays(MRP_PROCESS.arrRaisePODataFromLots[0].iDueDate, (DateDiffInDays + 1), MRP_PROCESS.CalanderType);
                                        var sSuggestedDate = MRP_PROCESS.TwoDigitNumber(DATE.prototype.getDayFromFocusDate(iSuggestedDate)) + "/" + MRP_PROCESS.TwoDigitNumber(DATE.prototype.getMonthFromFocusDate(iSuggestedDate)) + "/" + DATE.prototype.getYearFromFocusDate(iSuggestedDate);
