                    dtDueDate = MRP_PROCESS.arrMRPProcessingDetail[i].iDueDate;
                    PDRChildID = parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iPDRChildID);
                    MRP_PROCESS.iProductionType = parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iProductionTypeID);

                    var MaxQty = 0;
                    var MinQty = 0;
                    var SafetyStock = 0;
                    var PolicyData = MRP_PROCESS.ApplySafetyPolicy(MRP_PROCESS.arrMRPProcessingDetail[i]);
                    MaxQty = PolicyData.MaxQty;
                    MinQty = PolicyData.MinQty;
                    SafetyStock = PolicyData.SafetyStock;
                    if (MRP_PROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName == "Purchase") {
                        ReplenishmentType = 1;
                    }
                    else {
                        ReplenishmentType = 0;
                    }
                    MRP_PROCESS.FillPOTable(PDRParentId, PDRChildID, parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dRatio), MaxQty, MinQty,
                        MRP_PROCESS.arrMRPProcessingDetail[i].iDueDate, parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iVendorID),
                        parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dBuyingRate).toFixed(MRP_PROCESS.iDecimalInQuantity), SafetyStock, ReplenishmentType, MRP_PROCESS.arrMRPProcessingDetail[i].iRoutingId,//0,-- routing id
                        parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iProcureType), "", parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iVariantID), MRP_PROCESS.arrMRPProcessingDetail[i].bRoundOff);
                    var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(PDRChildID);
                    if (iTableExists > 0) {
                        var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(PDRChildID);
                        if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex].length > 0) {
                            MRP_PROCESS.MaterialProcess(PDRParentId, PDRChildID, sProdOrderNo);
