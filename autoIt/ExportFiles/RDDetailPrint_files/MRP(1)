            //{
            //    Output objOutput = Conn.Connection.CallServeRequest(ServiceTypeMRP.MRP, AllMethods.GetRoutingBasedOnSize, VariantID, dQunatityToRaise);
            //    iRouting = (int)objOutput.ReturnData;
            //}
