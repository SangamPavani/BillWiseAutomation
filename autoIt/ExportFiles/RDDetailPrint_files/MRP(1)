        try {
            //debugger
            var iDuedate = DATEPICKER.getDate("fDatePicker_DueDate_PO");
            if (iDuedate < DATE.prototype.today(RAISE_PO.iCalendarType)) {
                DATEPICKER.setDate("fDatePicker_DueDate_PO", RAISE_PO.ObjRaisePOData.DueDate);
                COMMON.prototype.showMessage("Due date cannot be less than Today's date", RAISE_PO.RAISE_POMsgs.lblErrorMsg);
                return false;
            }
            else {
                var POId = RAISE_PO.GetProductionOrderNO();
                var fnResult = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetMainPoDueDateAndChildPOs", "RaiseProductionOrders", "MRP"),
                    true, { iProductionOrderId: POId }, "", false);
                if (fnResult.lValue > 0 && fnResult.data != null) {
                    RAISE_PO.objDueDate = fnResult.data;
                    if (fnResult.data.DueDate > 0 && iDuedate > fnResult.data.DueDate) {
                        var sDate = DATE.prototype.intToString(fnResult.data.DueDate, DATEPICKER.getFormat("fDatePicker_DueDate_PO"), RAISE_PO.iCalendarType, GlobalPref.LanguageId);
                        DATEPICKER.setDate("fDatePicker_DueDate_PO", RAISE_PO.ObjRaisePOData.DueDate);
                        COMMON.prototype.showMessage("Due date cannot be greater than Main PO Due date : " + sDate, RAISE_PO.RAISE_POMsgs.lblErrorMsg);
                        return false;
                    }
                }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: RAISE_PO.OnDueDateLeave " + err.message, RAISE_PO.RAISE_POMsgs.lblErrorMsg);
        }
