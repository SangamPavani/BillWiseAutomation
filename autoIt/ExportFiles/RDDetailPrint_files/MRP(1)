    BindExplodBOMGridFromAlternate: function (BOMData, GridData, iRow) {
        //debugger;
        var data = GridData;
        var sGridId = "Id_BOMExplosion_FGrid";
        //FGRIDCONTROL.clearData(sGridId, true);
        //MRP_PROCESS.ClearGridRowData(sGridId, data.length);



        var AlternateCost = 0;
        var AlternateQuantity = 0;
        var AlternateTotalCost = 0;
        var BOMExtraFieldValue = 0;

        if (!MRP_PROCESS.IsMRP2Enabled() && MRP_PROCESS.DisplayBothBOMQuantityandAlternateQuantityinPlanning) {
            var AvgRate = parseFloat(data.dCostPrice).toFixed(MRP_PROCESS.iDecimalInCurrency);
            var iBOMBodyId = data.iBomBodyId;
            var iVariantId = MRP_PROCESS.TempExplodedData[data.iParentID].iVariantId;
            var BomQty = parseFloat(data.dQuantity).toFixed(MRP_PROCESS.iDecimalInQuantity);
            var Result = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetAlternatesQtyAndCostData", "MRPProcess", "MRP"),
                true,
                {
                    iVariantId: iVariantId, iBOMBodyId: iBOMBodyId, AvgRate: AvgRate, BomQty: BomQty, lstTotalIdNamePair: null
                },
                "JSON", false);
            if (Result.lValue > 0 && Result.data.lstAlternatevalues.length > 0) {
                AlternateCost = parseFloat(Result.data.lstAlternatevalues[1]).toFixed(MRP_PROCESS.iDecimalInCurrency);
                var PlanningQty = parseFloat(MRP_PROCESS.TempExplodedData[data.iParentID].dTotalQuantity).toFixed(MRP_PROCESS.iDecimalInQuantity);
                AlternateQuantity = parseFloat((parseFloat(Result.data.lstAlternatevalues[0]) * parseFloat(PlanningQty))).toFixed(MRP_PROCESS.iDecimalInQuantity);
                AlternateTotalCost = parseFloat((parseFloat(AlternateCost) * parseFloat(AlternateQuantity))).toFixed(MRP_PROCESS.iDecimalInCurrency);
