        //debugger;
        try {
            PIORDER.ChkEvent = objCell;
            if (objCell.bLeave == true) {   // On Leave Event
                if ((objCell.ColumnAttribute.ctrlid != "txtActualProductQuantity_PIO" && objCell.ColumnAttribute.ctrlid != "fDatePicker_ActualDueDate_PIO")) {
                    switch (parseInt(objCell.ColumnAttribute.ctrltype)) {
                        case PIO_CTRLTYPE.TEXT:
