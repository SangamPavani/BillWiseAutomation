    // Add Safety Stock quantity to Sub Materials(Products) for Raise Order and Apply safety stock
    this.AddSafetyStockForSubMaterial = function (PdrParentId, Qty) {
        try {
            for (var i = 0; i < MAIN_MRPPROCESS.arrMRPProcessingDetail.length; i++) {
                if (MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iPDRParentID == PdrParentId) {
                    MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dRatio = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dQuantityPerPiece).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) / Qty;

                    var dSafetyStock = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var dMax = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dMaxOrderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var dMin = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dMinOrderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var dReorderPt = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dReordePoint).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var dReorderQty = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dReorderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var dMaxInventory = parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dMaxInventory).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                    var iReOrderPolicy;
                    if (MAIN_MRPPROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName == "Purchase") {
                        if (MAIN_MRPPROCESS.bRDR == true) {
                            iReOrderPolicy = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iReorderPolicy);//(document.getElementById("rdoRaiseSingleOrderForQty_MRPProcessing").checked == true) ? 0 : parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iReorderPolicy);
                        }
                        else
                            iReOrderPolicy = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iReorderPolicy);
                    }
                    else
                        iReOrderPolicy = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iReorderPolicy);

                    if (iReOrderPolicy == 0) {
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                    }
                    else if (iReOrderPolicy == 1) {
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = ((dMax == 0) || (dReorderQty == 0)) ? 0 : dSafetyStock;
                    }
                    else if (iReOrderPolicy == 2) {
                        if ((dMax == 0) || (dMin == 0)) {
                            MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                        }
                        else {
                            if ((dMaxInventory > dSafetyStock) || (dMaxInventory > dReorderPt)) {
                                MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dMaxInventory;
                            }
                            else if ((dSafetyStock > dMaxInventory) || (dSafetyStock > dReorderPt)) {
                                MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dSafetyStock;
                            }
                            else if ((dReorderPt > dMaxInventory) || (dReorderPt > dSafetyStock)) {
                                MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dReorderPt;
                            }
                        }
                    }
                    else if (iReOrderPolicy == 3) {
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                    }
                    else if (iReOrderPolicy == 4) {
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = ((dMax == 0) || (dMin == 0)) ? 0 : dSafetyStock;
                    }

                    MAIN_MRPPROCESS.AddSafetyStockForSubMaterial(parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iPDRChildID), parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dQuantityPerPiece).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity));
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.AddSafetyStockForSubMaterial} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

