    SetGridIssueToJobOrderFromHeader: function (bSuccess, data) {
        try {
            debugger
            data = data.lstStocksStruct;
            if (data != null) {
                var sGridId = "Id_IssueToJobWorker_Grid";
                var ColIndex = parseInt(document.getElementById("hdnProduct_ColumnIndex_ITOJWBody").value);
                if (ColIndex == 0) {
                    ColIndex = 1;
                }
                var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridId);
                for (var i = 0; i < data.length; i++) {
                    for (var j = ColIndex; j <= iTotalColumns; j++) {
                        var cellobj = FGRIDCONTROL.getCellObject(sGridId, i + 1, j);
                        var cell = cellobj.ColumnAttribute.ctrlitojobwordtype;
                        if (cellobj.ColumnAttribute.ctrlitojobwordtype == "ITJWExtraF")
                            cell = cellobj.ColumnAttribute.ctrlid;
                        switch (cell) {
                            case "Rate":
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dAvaerageRate, ISSUETOJOBWORKER.iNoOfDecimalsCurrency)));
                                cellobj.setCellData("value", data[i].dAvaerageRate);
                                ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dAvaerageRate = data[i].dAvaerageRate;
                                break;
                            case "StockQuantity":
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dAvailableStock, ISSUETOJOBWORKER.iNoOfDecimalsQuantity)));
                                cellobj.setCellData("value", data[i].dAvailableStock);
                                ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dAvailableStock = data[i].dAvailableStock
                                break;
                            case "ClearStockQty":
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dClearStock, ISSUETOJOBWORKER.iNoOfDecimalsQuantity)));
                                cellobj.setCellData("value", parseFloat(data[i].dClearStock).toFixed(ISSUETOJOBWORKER.iNoOfDecimalsQuantity));
                                ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dClearStock = data[i].dClearStock
                                break;
                            case "TotalStock":
                                cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[i].dTotalStock, ISSUETOJOBWORKER.iNoOfDecimalsQuantity)));
                                cellobj.setCellData("value", data[i].dTotalStock);
                                ISSUETOJOBWORKER.lstRowWiseStocksdata[i].dTotalStock = data[i].dTotalStock
                                break;
                            default:
                                break;
                        }
                    }
                }
            }
            ISSUETOJOBWORKER.ProductionQuantityLeave();
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ISSUETOJOBWORKER.SetGridIssueToJobOrderFromHeader} " + err.message, ISSUETOJOBWORKER.ISSUETOJOBWORKERMsgs.lblErrorMsg);
