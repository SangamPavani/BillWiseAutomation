                            var value = document.getElementById(objCell.ColumnAttribute.ctrlid).value
                            objCell.setCellData("value", value != null && "" && undefined ? value : "");
                            objCell.setCellText(value != "" ? value : "");
                        } else {
                            objCell.processDefault();
                        }
                        break

                    case "QuantityToReceive":
                        objCell.setCellData("value", document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim());
                        //objCell.setCellText(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim());
                        objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(document.getElementById(objCell.ColumnAttribute.ctrlid).value.trim(),EditRECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity)));
                        EditRECEIPTFROMJOBWORKER.bCloseOrderStatus = false;
                        //debugger;
                        var prodColTagIndex = parseInt(document.getElementById("hdnProduct_ColumnIndex_RFJWBody").value);
                        var Rowcell = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", objCell.iRow, 11 + prodColTagIndex);
                        var QuantitytoIssue = parseFloat(Rowcell.getCellData("value"));

                        var RowCellcount = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", objCell.iRow, 8 + prodColTagIndex);
                        var dReceivedQuantity = parseFloat(RowCellcount.getCellData("value"));

                        var RowCellcount = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", objCell.iRow, 10 + prodColTagIndex);
                        var ActualQty = parseFloat(RowCellcount.getCellData("value"));


                        var RowpProductionOrder = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", objCell.iRow, 2 + prodColTagIndex);
                        var iproductionOrderId = parseInt(RowpProductionOrder.getCellData("value"));


                        //debugger;
                        if (EditRECEIPTFROMJOBWORKER.DontAllowToReceiveMoreQuantityThanRequired) {
                            if ((QuantitytoIssue) > ActualQty) {
                                objCell.setCellData("value", parseFloat(0).toFixed(EditRECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity));
                                objCell.setCellText(parseFloat(0).toFixed(EditRECEIPTFROMJOBWORKER.iNoOfDecimalsQuantity));
                                COMMON.prototype.showMessage("Quantity To Receive Can not be more than Planned Quantity ",EditRECEIPTFROMJOBWORKER. EditRECEIPTFROMJOBWORKERMsgs.lblErrorMsg);
                                return false;
                            }
                        }
                        //open the Confirm Box in javascript...
                        var dQtyProd = dReceivedQuantity + QuantitytoIssue;
                        // Call Method For Get Details of Production Order is Close or not. 
                        var bCloseStatus = false;
                        if (dQtyProd >= ActualQty) {
                           EditRECEIPTFROMJOBWORKER.bCloseOrderStatus = false;//need to check 
                            //Resume Current Process data index..
                            for (var k = 0; k <EditRECEIPTFROMJOBWORKER.arrProdOrdersData.length; k++) {
                                if (EditRECEIPTFROMJOBWORKER.arrProdOrdersData[k].iProductionOrderId == iproductionOrderId) {
                                   EditRECEIPTFROMJOBWORKER.arrProdOrdersData.splice(k, 1);
                                }
                            }
                            //Add One More Process ...
                            var objdata = {
                                iProductionOrderId: iproductionOrderId,
                                bIsClose: bCloseStatus
                            }
                           EditRECEIPTFROMJOBWORKER.arrProdOrdersData.push(objdata);
                        }
                        //var prodColTagIndex = parseInt(document.getElementById("hdnProduct_ColumnIndex_RFJWBody").value);
                        //var cellDataRMA = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", parseInt(objCell.iRow), 12 + prodColTagIndex);
                        //cellDataRMA.setCellText("", "");
                        //var cellDataBatch = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", parseInt(objCell.iRow), 13 + prodColTagIndex);
                        //cellDataBatch.setCellText("", "");
                        break;
                    case "Batch":
                        var stext = OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid);
                        objCell.setCellData("value", stext);
                        objCell.setCellText(stext);
                        break;
                    case "RMA":

                        objCell.processDefault();
                        break;
                    default:
                        objCell.processDefault();
                        break;
                }
                if (objCell.ColumnAttribute.ctrlirfjobw == "QuantityToReceive") {
                   EditRECEIPTFROMJOBWORKER.LoadFooterData();
                }
            }
            else {
                //debugger;
                switch (objCell.ColumnAttribute.ctrlirfjobw) {
                    case "RFJWBTAG":
                        if (objCell.iRow > 1) {
                            var CurrentValue = isNaN(parseInt(objCell.getCellData("value"))) ? 0 : parseInt(objCell.getCellData("value"));
                            if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
                                var PrevEle = FGRIDCONTROL.getCellObject(objCell.Grid.id, objCell.iRow - 1, objCell.iColumn);
                                objCell.setCellData("value", PrevEle.getCellData("value"));
                                objCell.setCellText(PrevEle.getCellText("value"));
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            } else {
                                element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                objCell.setControl(element, objCell.getCellData("value"));
                            }
                        } else {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                        break;

                    case "RFJWBExtraF":
                        //debugger
                        if (objCell.ColumnAttribute.ctrlid != "sProductionOrderNo" && objCell.ColumnAttribute.ctrlid != "iProductionOrderId" && objCell.ColumnAttribute.ctrlid != "sRefOrderNo") {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                        } else {
                            objCell.processDefault();
                        }
                        break;
                    case "QuantityToReceive":
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                        break;
                    case "Batch":
                        //debugger
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                        break;
                    case "RMA":
                        //debugger
                        if (objCell.bHidden || EditRECEIPTFROMJOBWORKER.arrRFJWBodyData[objCell.iRow - 1].bNoRMA == true) {
                            objCell.processDefault();
                            break;
                        }
                        EditRECEIPTFROMJOBWORKER.GetRMA(objCell.iRow, objCell.sText);
                    default:
                        objCell.processDefault();
                        break;
                }
            }

            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception:" + err.message,EditRECEIPTFROMJOBWORKER. EditRECEIPTFROMJOBWORKERMsgs.lblErrorMsg);
        }
