                            objCell.setCellText("");
                            objCell.setCellData("value", parseFloat(QunatityToRelease).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                            //objCell.setCellText(parseFloat(QunatityToRelease).toFixed(RELEASEJOBORDER.NoofDecimalsInQuantity));
                            objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(QunatityToRelease, RELEASEJOBORDER.NoofDecimalsInQuantity)));

                            //  When First radio button Seleted then only Execute Part.
                            var rbchkCostPerUnit = document.getElementById("rbCostPerUnit").checked;
                            var RowCelldata13 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", objCell.iRow, 14 + prodColIndexCount);
