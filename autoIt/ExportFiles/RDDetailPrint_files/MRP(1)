    this.FillGetStockData = function (ObjStocksStruct, iRow) {
        let sGridName = IssueTP.GetGridId();
        let TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        for (var j = 0; j < TotalColumns; j++) {
            cellobj = FGRIDCONTROL.getCellObject(sGridName, iRow, j + 1);
            var cell = cellobj.ColumnAttribute.ctrlatt.trim();
            switch (cell) {
                case "rate":
                    var dRate = ObjStocksStruct.dBuyingRate == 0 ? parseFloat(ObjStocksStruct.dAvaerageRate).toFixed(IssueTP.iDecimalsInCurrency) : parseFloat(ObjStocksStruct.dBuyingRate).toFixed(IssueTP.iDecimalsInCurrency);
                    if (dRate == 0)
                        dRate = 1;
                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dRate, IssueTP.iDecimalsInCurrency)));
                    cellobj.setCellData("value", dRate);
                    if (IssueTP.IsNewRow(iRow) == false)
                        IssueTP.arrRowWiseStockData[iRow - 1].dBuyingRate = dRate;
                    IssueTP.iRateColumnNo = j + 1;
                    break;
                case "availablestock":
                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dAvailableStock, IssueTP.dNoOfDecimal)));
                    cellobj.setCellData("value", ObjStocksStruct.dAvailableStock);
                    if (IssueTP.IsNewRow(iRow) == false)
                        IssueTP.arrRowWiseStockData[iRow - 1].dAvailableStock = ObjStocksStruct.dAvailableStock;
                    break;
                case "clearstock":
                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dClearStock, IssueTP.dNoOfDecimal)));
                    cellobj.setCellData("value", ObjStocksStruct.dClearStock);
                    if (IssueTP.IsNewRow(iRow) == false)
                        IssueTP.arrRowWiseStockData[iRow - 1].dClearStock = ObjStocksStruct.dClearStock;
                    break;

                case "totalstockqty":
                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dTotalStock, IssueTP.dNoOfDecimal)));
                    cellobj.setCellData("value", ObjStocksStruct.dTotalStock);
                    if (IssueTP.IsNewRow(iRow) == false)
                        IssueTP.arrRowWiseStockData[iRow - 1].dTotalStock = ObjStocksStruct.dTotalStock;
                    break;
                case "issueingnow":
                    //debugger
                    var bPExcess = false;
                    if (IssueTP.lstFinalEI != null && IssueTP.lstFinalEI.length > 0) {
                        var iProd = IssueTP.arrBodyData[cellobj.iRow - 1].iProductId;
                        for (var k = 0; k < IssueTP.lstFinalEI.length; k++) {
                            if (iProd == IssueTP.lstFinalEI[k].iProduct) {
                                bPExcess = true;
                                break;
                            }
                        }
                    }
                    if (IssueTP.IsNewRow(cellobj.iRow) == true && bPExcess == false) {
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(0, IssueTP.dNoOfDecimal)));
                        cellobj.setCellData("value", parseFloat(0).toFixed(IssueTP.dNoOfDecimal));
                        break;
                    }
                    if (IssueTP.arrBodyData[cellobj.iRow - 1].iProductType != 8 && IssueTP.arrBodyData[cellobj.iRow - 1].iProductType != 7) {
                        var dStock = parseFloat(IssueTP.arrRowWiseStockData[cellobj.iRow - 1].dAvailableStock) + parseFloat(IssueTP.arrRowWiseStockData[cellobj.iRow - 1].dClearStock);
                        var Qty = parseFloat(IssueTP.arrBodyData[cellobj.iRow - 1].dTotalQuantityToIssue);
                        if (dStock < Qty)
                            Qty = dStock;
                        if (Qty > 0) {
                            var dSize = parseFloat(document.getElementById("txtProductionSize").value, IssueTP.dNoOfDecimal);
                            var dEISize = parseFloat(document.getElementById("txtPQuantity").value, IssueTP.dNoOfDecimal);
                            if (dEISize > 0 && bPExcess == false) {
                                dSize = 0;
                            }
                            var dTotalProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("TotalProductionSize"), IssueTP.dNoOfDecimal);
                            var dPerQty = parseFloat(IssueTP.arrBodyData[cellobj.iRow - 1].dTotalQuantityToIssue) / parseFloat(dTotalProductionSize)
                            var IssueingDataQty = 0;
                            var dAlreadyIssuedProductionSize = parseFloat(document.getElementById("txtProductionSize").getAttribute("AlreadyIssuedProductionSize"), IssueTP.dNoOfDecimal);
                            var dTotal = parseFloat(dAlreadyIssuedProductionSize) + parseFloat(dSize);
                            var Qty = parseFloat(dPerQty * dTotal) - parseFloat(IssueTP.arrBodyData[cellobj.iRow - 1].dIssuedQuantity);
                            if (bPExcess) {
                                Qty = dEISize;
                            }
                            if (Qty < 0)
                                Qty = 0;
                            var dStock = parseFloat(IssueTP.arrRowWiseStockData[cellobj.iRow - 1].dAvailableStock)
                            if (IssueTP.bConsiderClearStock) {
                                dStock = dStock + parseFloat(IssueTP.arrRowWiseStockData[cellobj.iRow - 1].dClearStock);
                            }

                            if (Qty <= dStock) {
                                IssueingDataQty = Qty;
                            } else {
                                IssueingDataQty = dStock;
                            }                      
                            
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(IssueingDataQty, IssueTP.dNoOfDecimal)));
                            cellobj.setCellData("value", IssueingDataQty);
                            //if (MRP_ISTPO.bInvHeader) {
                            IssueTP.arrBodyData[cellobj.iRow - 1].dIssuingNow = IssueingDataQty;
                            //}                            
                        }
                        else {
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(0, IssueTP.dNoOfDecimal)));
                            cellobj.setCellData("value", parseFloat(0).toFixed(IssueTP.dNoOfDecimal));
                        }
                    }
                    else {
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(0, IssueTP.dNoOfDecimal)));
                        cellobj.setCellData("value", parseFloat(0).toFixed(IssueTP.dNoOfDecimal));
                    }
                    break;  
                    
            }
        }
    }
