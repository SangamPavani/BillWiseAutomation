    // Calculate final Lot quantities to set on Quantity Grid.
    CalculateLotsQuantity: function (totalLotQty, minOrderQty, maxOrderQty, bIsMaxLevel) {
        //
        if (!bIsMaxLevel) {
            var totalSafetyStock = 0;
            for (var j = 0; j < MRP_PROCESS.MRPProductPolicy.length; j++) {
                totalSafetyStock += parseFloat(MRP_PROCESS.MRPProductPolicy[j].dSafetyStock);
            }
            totalLotQty += totalSafetyStock;
        }
        else {
            var totalSafetyStock = 0;
            if (MRP_PROCESS.MRPProductPolicy[0].dMaxInventory > MRP_PROCESS.MRPProductPolicy[0].dReordePoint &&
                MRP_PROCESS.MRPProductPolicy[0].dMaxInventory > MRP_PROCESS.MRPProductPolicy[0].dSafetyStock) {
                for (var j = 0; j < MRP_PROCESS.MRPProductPolicy.length; j++) {
                    totalSafetyStock += parseFloat(MRP_PROCESS.MRPProductPolicy[j].dMaxInventory);
                }
            }
            else if (MRP_PROCESS.MRPProductPolicy[0].dReordePoint > MRP_PROCESS.MRPProductPolicy[0].dMaxInventory &&
                MRP_PROCESS.MRPProductPolicy[0].dReordePoint > MRP_PROCESS.MRPProductPolicy[0].dSafetyStock) {
                for (var j = 0; j < MRP_PROCESS.MRPProductPolicy.length; j++) {
                    totalSafetyStock += parseFloat(MRP_PROCESS.MRPProductPolicy[j].dReordePoint);
                }
            }
            else {
                for (var j = 0; j < MRP_PROCESS.MRPProductPolicy.length; j++) {
                    totalSafetyStock += parseFloat(MRP_PROCESS.MRPProductPolicy[j].dSafetyStock);
                }
            }
            totalLotQty += totalSafetyStock;
        }

        arrLotsQuantity = [];
        if (maxOrderQty > 0) {
            while (totalLotQty > maxOrderQty) {
                arrLotsQuantity.push(maxOrderQty);
                totalLotQty -= maxOrderQty;
            }
            if (totalLotQty > 0) {
                if (totalLotQty > minOrderQty)
                    arrLotsQuantity.push(totalLotQty);
                else
                    arrLotsQuantity.push(minOrderQty);
            }
        }
        else
            arrLotsQuantity.push(totalLotQty);

        return arrLotsQuantity;
    },
