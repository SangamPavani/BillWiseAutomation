                            cellobj.setCellText(FTIMECONTROL.getText(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellData("value", data.iEndTime);
                            break;
                        case "Duration":
                            cellobj.setCellText(data.dDuration);
                            cellobj.setCellData("value", data.dDuration);
                            break;
                        case "Output":
                            //debugger
                            var ele = "";
                            ele = document.getElementById(cellobj.ColumnAttribute.ctrlid);
