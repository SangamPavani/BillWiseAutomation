    // Split Lot Quantity for Stock reservation while raising of PO
    SetRODataBasedOnLots: function (arrSeletedOrders, arrOrdersToRaise, totalQty) {

        try {

            var iTotalQty = totalQty;
            var iTrancRemainingQty = 0;
            var iPlannedRemaining = 0;
            var iStatus = 0;

            for (var i = 0; i < arrSeletedOrders.length; i++) {
                if (iTotalQty <= 0)
                    break;
                iTrancRemainingQty = arrSeletedOrders[i].dPendingQuantity - arrSeletedOrders[i].dReserverQty - arrSeletedOrders[i].dRaisedQuantity;

                for (var j = iStatus; j < arrOrdersToRaise.length; j++) {
                    if (arrOrdersToRaise[j].dQuantity <= 0)
                        break;
                    if (arrOrdersToRaise[j].lstTransQty == null || arrOrdersToRaise[j].lstTransQty == undefined) {
                        arrOrdersToRaise[j].lstTransQty = [];
                    }
                    if (iPlannedRemaining > 0) {
                        if (iPlannedRemaining <= iTrancRemainingQty) {
                            var objTransQty = {
                                iTransactionID: parseInt(arrSeletedOrders[i].sTransactionID),
                                iQty: iPlannedRemaining,
                                iDueDate: arrSeletedOrders[i].iDueDate,
                                sDocumentNo: arrSeletedOrders[i].sDocumentNo,
                                iDocumentType: arrSeletedOrders[i].iDocumentType,

                            }
                            arrOrdersToRaise[j].lstTransQty.push(objTransQty);
                            iTrancRemainingQty = iTrancRemainingQty - iPlannedRemaining;
                            iTotalQty = iTotalQty - iPlannedRemaining;
                            iPlannedRemaining = 0;
                            if (iTrancRemainingQty == 0)
                                break;
                        }
                        else {
                            if (iTrancRemainingQty <= iPlannedRemaining) {
                                var objTransQty = {
                                    iTransactionID: parseInt(arrSeletedOrders[i].sTransactionID),
                                    iQty: iTrancRemainingQty,
                                    iDueDate: arrSeletedOrders[i].iDueDate,
                                    sDocumentNo: arrSeletedOrders[i].sDocumentNo,
                                    iDocumentType: arrSeletedOrders[i].iDocumentType,

                                }
                                arrOrdersToRaise[j].lstTransQty.push(objTransQty);
                                iPlannedRemaining = iTrancRemainingQty - iPlannedRemaining;
                                iTotalQty = iTotalQty - iTrancRemainingQty;
                                iTrancRemainingQty = 0;
                                if (iPlannedRemaining > 0) {
                                    iStatus = j;
                                    break;
                                }
                            }
                            else {
                                iPlannedRemaining = iPlannedRemaining - iTrancRemainingQty;
                                iTotalQty = iTotalQty - iTrancRemainingQty;
                                iTrancRemainingQty = 0;
                                var objTransQty = {
                                    iTransactionID: parseInt(arrSeletedOrders[i].sTransactionID),
                                    iQty: iPlannedRemaining,
                                    iDueDate: arrSeletedOrders[i].iDueDate,
                                    sDocumentNo: arrSeletedOrders[i].sDocumentNo,
                                    iDocumentType: arrSeletedOrders[i].iDocumentType,
                                }
                                arrOrdersToRaise[j].lstTransQty.push(objTransQty);
                                if (iPlannedRemaining > 0) {
                                    iStatus = j;
                                    break;
                                }
                            }
                        }
                    }
                    else if (arrOrdersToRaise[j].dQuantity <= iTrancRemainingQty && iPlannedRemaining <= 0) {
                        var objTransQty = {
                            iTransactionID: parseInt(arrSeletedOrders[i].sTransactionID),
                            iQty: arrOrdersToRaise[j].dQuantity,
                            iDueDate: arrSeletedOrders[i].iDueDate,
                            sDocumentNo: arrSeletedOrders[i].sDocumentNo,
                            iDocumentType: arrSeletedOrders[i].iDocumentType,
                        }
                        arrOrdersToRaise[j].lstTransQty.push(objTransQty);
                        iTrancRemainingQty = iTrancRemainingQty - arrOrdersToRaise[j].dQuantity;
                        iTotalQty = iTotalQty - arrOrdersToRaise[j].dQuantity;
                        if (iTrancRemainingQty <= 0) {
                            iStatus = j + 1;
                            break;
                        }
                    }
                    else if (arrOrdersToRaise[j].dQuantity > iTrancRemainingQty) {
                        var objTransQty = {
                            iTransactionID: parseInt(arrSeletedOrders[i].sTransactionID),
                            iQty: iTrancRemainingQty,
                            iDueDate: arrSeletedOrders[i].iDueDate,
                            sDocumentNo: arrSeletedOrders[i].sDocumentNo,
                            iDocumentType: arrSeletedOrders[i].iDocumentType,
                        }
                        iPlannedRemaining = arrOrdersToRaise[j].dQuantity - iTrancRemainingQty;
                        iTotalQty = iTotalQty - iTrancRemainingQty;
                        iTrancRemainingQty = 0;
                        arrOrdersToRaise[j].lstTransQty.push(objTransQty);
                        if (iPlannedRemaining > 0) {
                            iStatus = j;
                            break;
                        }
                    }
                }
            }
            return arrOrdersToRaise;

        } catch (e) {
            alert("Exception: {MRP_PROCESS.SetRODataBasedOnLots} " + e.message);
        }
    },

