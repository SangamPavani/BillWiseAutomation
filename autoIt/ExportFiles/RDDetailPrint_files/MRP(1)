    this.POSearch_OnSuccess = function (bsuccess, data) {
        try {
            //debugger
            if (bsuccess && data != null) {
                if (window.GlobalPref.Version == eVersion.Version10) {
                    RF_PRODUCTION.ProductionOrderData = data;
                } else {
                    RF_PRODUCTION.ReceiptPOData = data;
                }
                if (data.length > 0) {
                    var sGridId = "FGrid_PendingReceiptsPOData";
                    FGRIDCONTROL.deleteRows(sGridId, 1, FGRIDCONTROL.getTotalRows(sGridId));
                    FGRIDCONTROL.insertRows(sGridId, 1, data.length);
                    for (var i = 0; i < FGRIDCONTROL.getTotalRows(sGridId); i++) {
                        for (var j = 1; j <= FGRIDCONTROL.getTotalColumns(sGridId); j++) {
                            var CellObject = FGRIDCONTROL.getCellObject(sGridId, i + 1, j);
                            switch (j) {
                                case 1:
                                    CellObject.setCellText(data[i].iProdOrderId);
                                    CellObject.setCellData("value", data[i].iProdOrderId);
                                    break;
                                case 2:
                                    CellObject.setCellText(data[i].sProdOrderNo);
                                    CellObject.setCellData("value", data[i].sProdOrderNo);
                                    break;
                                case 3:
                                    CellObject.setCellText(data[i].sItemName);
                                    CellObject.setCellData("value", data[i].sItemName);
                                    break;
                                case 4:
                                    CellObject.setCellText(data[i].sItemCode);
                                    CellObject.setCellData("value", data[i].sItemCode);
                                    break;
                                case 5:
                                    CellObject.setCellText(data[i].iItemId);
                                    CellObject.setCellData("value", data[i].iItemId);
                                    break;
                                default:
                                    break;
                            }
                        }

                    }
                    $('#PendingReceiptsPOData_Popup').modal("show");
                }
                else {
                    COMMON.prototype.showMessage("There are no Pending Production Orders on Order Date", "Message");
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.POSearch_OnSuccess} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }
