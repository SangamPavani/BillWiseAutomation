        else if (result.iSelectedRowCount > 1) {
            //COMMON.prototype.showMessage("Select One  Production Order.", "Error Message");
            COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSelectOnlyOneProductionOrder, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
            return false;
        }
        var iProductionOrderdataId = 0;
        // var iOrderStatus = 0;
        var PONO = "";
        var PO = "";
        var OrderStatus = "";
        var rowCount = FGRIDCONTROL.getTotalRows("Id_RaisePOLanding_Grid");
        for (var rowindex = 1; rowindex <= rowCount; rowindex++) {
