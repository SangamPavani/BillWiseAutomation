                            MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iDueDate = MRP_PROCESS.arrMRPPOData[i].iProductionStartDate;
                            TotQty = 0;
                        }
                        else if (!(ProcureType == 1 || ProcureType == 3)) {
                            var AvailableQty = MRP_PROCESS.DoReservation(parseInt(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iSpecificVendorID, TotQty);
                            if (AvailableQty != null && AvailableQty != undefined) {
                                if (isNaN(AvailableQty) == false) {
                                    TotQty = AvailableQty;
                                }
                            }
                            if (TotQty == 0) {
                                MRP_PROCESS.FillIssueToProduction(MRP_PROCESS.iMaterialID, parseInt(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iUnitID, Qty,
