                        //COMMON.prototype.showMessage("Select Checkbox to Enter Screen Field", "Error Message");
                        COMMON.prototype.showMessage(PREFERENCES.PREFERENCESMsgs.MRP_PR_msgSelectCheckBoxToEnterScreenField, PREFERENCES.PREFERENCESMsgs.lblErrorMsg);
                    }
                } else {
                    cellobj.processDefault(event);
                }
            }
            return (true);
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {PREFERENCES.CostingGrid_OnCellChange} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {PREFERENCES.CostingGrid_OnCellChange} " + e.message, PREFERENCES.PREFERENCESMsgs.lblErrorMsg);
