    this.OnProductionOrderLeave = function (iValue) {
        try {
            if (parseInt(iValue) == 0) {
                return false;
            }
            var urlPath = GLOBAL.getContextPath("GetProcessData", "ReceiptfromProduction", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { iProdOrderId: iValue, iWorkCenterId: -1 }, "JSON", false);
            if (fnResult.lValue > 0 && fnResult.data != null) {
                //debugger
                ObjMRPData = fnResult.data.ObjMRPData;
                if (fnResult.data.ObjMRPData.arrProcess != null) {
                    RF_PRODUCTION.arrProcessData = [];
                    if (fnResult.data.ObjMRPData.arrProcess.length > 0) {
                        RF_PRODUCTION.iLastProcess = fnResult.data.iProcessId;
                        RF_PRODUCTION.arrProcessData.push(fnResult.data.ObjMRPData);
                        if (!ObjMRPData.bBackFlush) {
                            if (ObjMRPData != null && ObjMRPData.arrProcess != null && ObjMRPData.arrProcess.length == 1 && ObjMRPData.arrProcess[0].iNodeSequence == -1) {
                                //COMMON.prototype.showMessage("No Quantity Issued against selected PO.\r\nFirst do Issue to production against PO", "FocusI"); //FocusI Changed to Error Message
                                COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgNoQuantityIssuedAgainstSelectedPO, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                                //return false;
                            }
                            if (ObjMRPData.bPoIssued == false) {
                                //COMMON.prototype.showMessage("No Quantity Issued against selected PO.\r\nFirst do Issue to production against PO", "FocusI"); //FocusI Changed to Error Message
                                COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgNoQuantityIssuedAgainstSelectedPO, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                                // return false;
                            }
                            if (ObjMRPData.arrProcess != null && !ObjMRPData.bIntermediateIssued) {
                                //COMMON.prototype.showMessage("Semi Finished Goods which are Mandatory for this Process are Not been Issued.\r\n you can receive only after you issue these products", "Receipt From Production");
                                COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgSemiFinishedGoodsWhichAreMandatoryForThisProcessAreNotBeenIssued, RF_PRODUCTION.RF_PRODUCTIONMsgs.ReceiptFromProduction);
                                //return false;
                            }
                        }
                    }
                } else {
                    var sPO = OPTIONCONTROL.getControlText("FOption_ProductionOrder");
                    //COMMON.prototype.showMessage("No Process Data for Production No: " + sPO, "Warning Message"); //Warning Message Chamged to Error Message
                    //COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgNoProcessDataForProductionNo + ": " + sPO, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                    COMMON.prototype.showMessage("Raw Materials are not issued against this Production Order" + ": " + sPO, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                }
                //RF_PRODUCTION.arrProcessData.push(ObjMRPData);

                if (RF_PRODUCTION.arrProcessData.length > 0) {
                    var sddlOption = "";
                    sddlOption = sddlOption + " <option value=0>" + " " + "</option>";
                    $("#" + "ddlProcessName" + "option[value='option']").remove();
                    $("#ddlProcessName").children('option:not(:first)').remove();
                    var select = document.getElementById("ddlProcessName");
                    RF_PRODUCTION.ObjRowData.iProdOrderId = iValue;
                    for (var i = 0; i < RF_PRODUCTION.arrProcessData[0].arrProcess.length; i++) {
                        var opt = document.createElement('option');
                        opt.value = RF_PRODUCTION.arrProcessData[0].arrProcess[i].iBodyId;
                        opt.innerHTML = RF_PRODUCTION.arrProcessData[0].arrProcess[i].sProcesssName;
                        select.appendChild(opt);
                    }
                }

            }
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.OnProductionOrderLeave} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.OnProductionOrderLeave} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
