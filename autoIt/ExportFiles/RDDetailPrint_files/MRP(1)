    SetAuthorizationStatus: function () {
        debugger;
        var iStatus;
        iStatus = CurrentStatus;
        if (ApprovalMandatory == true && iStatus == 1) {
            if (document.getElementById("txtAuthRemarks").value.trim().length <= 0) {
                //alert(sResourceMessage.msgRemarksAreMandatory);
                alert("Remarks Are Mandatery");
                return;
            }
        }
        if (RejectionMandatory == true && iStatus == 2) {
            if (document.getElementById("txtAuthRemarks").value.trim().length <= 0) {
                // alert(sResourceMessage.msgRemarksAreMandatory);
                alert("Remarks Are Mandatery");
                return;
            }
        }
        $("#AuthRemarks").modal('hide');
        var AuthorizePOData = [];
        var POApproveReject = [];
