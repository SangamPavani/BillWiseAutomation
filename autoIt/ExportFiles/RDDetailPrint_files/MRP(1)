                                        //   if (Global.bAllowScheduleBackDated)
                                        //     DR = FMessageBox.Show("Available Schedule Start Date is " + dtStartDate + " which is before todays date. Do you want to continue with this Date. Press No to select the date manually.", "ERP Information", MessageBoxButton.YesNo, MessageBoxImage.Question);
