    // Method To get Production Type Items Lead Time
    GetProductionLeadTime: function () {
        //debugger
        var iMaxLeadTimeForProductionItems = 0;
        var lstMRPProductionDetails = [];
        if (MRP_PROCESS.arrRaisePODataFromLots != null) {
            for (var i = 0; i < MRP_PROCESS.arrRaisePODataFromLots.length; i++) {
                var objMRPProductionDetails = {
                    iVendorID: MRP_PROCESS.arrRaisePODataFromLots[i].iVendorID,
                    iWarehouseID: MRP_PROCESS.arrRaisePODataFromLots[i].iBaseWareHouseId,
                    iMaterialID: MRP_PROCESS.arrRaisePODataFromLots[i].iProductID,
                    dRaisedQty: MRP_PROCESS.arrRaisePODataFromLots[i].dQuantity,
                    sReplenishmentTypeName: "Production"
                }
                lstMRPProductionDetails.push(objMRPProductionDetails);
            }
        }
        for (var i = 0; i < MRP_PROCESS.arrMRPProcessingDetail.length; i++) {
            if (MRP_PROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName == "Production") {
                var objMRPProductionDetails = {
                    iVendorID: MRP_PROCESS.arrMRPProcessingDetail[i].iVendorID,
                    iWarehouseID: MRP_PROCESS.arrMRPProcessingDetail[i].iWarehouseID,
                    iMaterialID: MRP_PROCESS.arrMRPProcessingDetail[i].iMaterialID,
                    dRaisedQty: MRP_PROCESS.arrMRPProcessingDetail[i].dRaisedQty,
                    sReplenishmentTypeName: MRP_PROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName
                }
                lstMRPProductionDetails.push(objMRPProductionDetails);
            }
        }

        if (lstMRPProductionDetails != null) {
            var urlPath = GLOBAL.getContextPath("GetMaxLeadTimeForProductionItems", "MRPProcess", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { lstMRPProductionDetails: lstMRPProductionDetails }, "JSON", false);
            if (fnResult.lValue > 0 && fnResult.data != null) {
                iMaxLeadTimeForProductionItems = fnResult.data;
            }
        }
        return iMaxLeadTimeForProductionItems;
    },


    // Check for Opening of Depanedent Requirement sreen popup based on Production date
    CheckForNextLevel: function () {
        try {
            //debugger
            if (MRP_PROCESS.bRDR == true) {
                var ProductionOrderId = parseInt(OPTIONCONTROL.getControlValue("FOption_ProductionOrder_MRP"));
                ProductionOrderId = isNaN(ProductionOrderId) ? 0 : ProductionOrderId;
                if (!MRP_PROCESS.bAllowCapacityOrMachinePlanningManually) {//as per Srinivas to skip Schudeling
                    if (MRP_PROCESS.bForwardScheduling) {


                        var iProductionLeadTime = MRP_PROCESS.GetProductionLeadTime();
                        var iMaxLeadTime = 0;
                        var urlPath = GLOBAL.getContextPath("GetMaxLeadTimeForRM", "MRPProcess", "MRP");
                        var fnResult = NETWORK.executeServerMethod(urlPath, true, { arrProductionDetail: MRP_PROCESS.arrMRPProcessingDetail }, "JSON", false);
                        if (fnResult.lValue > 0 && fnResult.data != null) {
                            iMaxLeadTime = fnResult.data;
                        }

                        var ProductLeadStartDate = 0;
                        if (iProductionLeadTime > 0) {
                            ProductLeadStartDate = DATE.prototype.addDays(MRP_PROCESS.arrRaisePODataFromLots[0].iDueDate, -iProductionLeadTime, MRP_PROCESS.CalanderType);
                        }
                        var dtProcurementMaxDueDate = 0;
                        if (iMaxLeadTime > 0) {
                            var urlPath = GLOBAL.getContextPath("FDateTimeLongToInt", "MRPProcess", "MRP");
                            var fnResult = NETWORK.executeServerMethod(urlPath, true, { strDateTime: MRP_PROCESS.dtProductionStartDate }, "JSON", false);
                            if (fnResult.lValue > 0 && fnResult.data != null) {
                                MRP_PROCESS.dtProductionStartDate = DATE.prototype.addDays(fnResult.data, iMaxLeadTime, MRP_PROCESS.CalanderType);
                                dtProcurementMaxDueDate = DATE.prototype.addDays(fnResult.data, -iMaxLeadTime, MRP_PROCESS.CalanderType);
                            }
                            // MRP_PROCESS.dtProductionStartDate = DATE.prototype.addDays(iMaxLeadTime, 1, 1);
                        }
                        else {
                            // MRP_PROCESS.dtProductionStartDate = DATE.prototype.addDays(MRP_PROCESS.dtProductionStartDate, 1, 1);

                            var urlPath = GLOBAL.getContextPath("FDateTimeLongToInt", "MRPProcess", "MRP");
                            var fnResult = NETWORK.executeServerMethod(urlPath, true, { strDateTime: MRP_PROCESS.dtProductionStartDate }, "JSON", false);
                            if (fnResult.lValue > 0 && fnResult.data != null) {
                                MRP_PROCESS.dtProductionStartDate = fnResult.data;//DATE.prototype.addDays(fnResult.data, 1, MRP_PROCESS.CalanderType);
                            }
                        }

                        if (ProductLeadStartDate > MRP_PROCESS.dtProductionStartDate) {
                            MRP_PROCESS.dtProductionStartDate = ProductLeadStartDate;
                        }

                        if (MRP_PROCESS.AllowUserToAddScheduling) {
                            if (MRP_PROCESS.IsMRP2Enabled() == true) {
                                var urlPath = GLOBAL.getContextPath("MRPGetPODetailsforScheduling", "MRPProcess", "MRP");
                                var fnResult = NETWORK.executeServerMethod(urlPath, true, { ProductionStartDate: MRP_PROCESS.dtProductionStartDate }, "JSON", false);

                                if (fnResult.lValue > 0 && fnResult.data != null) {
                                    if (fnResult.data.lstMRPProductionOrderDetails.length > 0 && fnResult.data.lstMRPProductionOrderDetails.length > 0) {
                                        MRP_PROCESS.LoadandShowInsertPopup(fnResult.data.lstMRPProductionOrderDetails, fnResult.data.lstOBJ);
                                        if (QUICKMRP.bfromQuickMRP) {
                                            GLOBAL.LoadingEnd();
                                        }
                                        return false;
                                    }
                                    else {

                                        if (MRP_PROCESS.IsMRP2Enabled() == true) {   //MRP_PROCESS.IsMRP2Enabled()==true
                                            MRP_PROCESS.ScheduleTheHierarchy(false, 0, ProductionOrderId);
                                        }
                                    }
                                }
                            }
                        } else {
                            if (MRP_PROCESS.IsMRP2Enabled() == true) { //MRP_PROCESS.IsMRP2Enabled()==true
                                MRP_PROCESS.ScheduleTheHierarchy(false, 0, ProductionOrderId);
                            }
                            else {
                                //debugger
                                if (false) { // if Lead days exists then max lead days >0 
                                    if (MRP_PROCESS.dtProductionStartDate > MRP_PROCESS.arrRaisePODataFromLots[0].iDueDate || dtProcurementMaxDueDate < DATE.prototype.today()) {
                                        var bResult = confirm("Cannot be processed as Lead days defined doesn't match with the customer Due date for the Planned order.Do you Wish to Continue the Process?");
                                        //COMMON.prototype.confirm("Cannot be processed as Lead days defined doesn't match with the customer Due date for the Planned order.Do you Wish to Continue the Process?", "MRP Process");
                                        if (!bResult) {
                                            urlPath = GLOBAL.getContextPath("DeleteProductionOrder", "MRPProcess", "MRP");
                                            var Result = NETWORK.executeServerMethod(urlPath, true, { iProductionOrderId: ProductionOrderId }, "JSON", false);
                                            if (Result.lValue > 0 && Result.data != null) {
                                                if (Result.data == true) {
                                                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgProductionOrderDeletedSuccessfully, MRP_PROCESS.MRP_PROCESSMsgs.MRPProcess);
                                                } else {
                                                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgProductionOrderNotDeleted, MRP_PROCESS.MRP_PROCESSMsgs.MRPProcess);
                                                }
                                            }


                                            var menuId = parseInt(document.getElementById("mrpType_MenuId").value);
                                            menuId = isNaN(menuId) == true ? 0 : menuId;
                                            if (menuId == 3020) {
                                                QUICKMRP.bStopProcess = true;
                                                QUICKMRP.ResetToNewProcess();
                                            } else {
                                                MRP_PROCESS.FinishProcessAndResetData();
                                            }
                                            return true;
                                        }
                                    }
                                }
                                else {
                                    //MRP_PROCESS.UpdateDependentRequirementDueDate(ProductionOrderId);
                                }

                            }
                        }
                    }
                }
                var bDueDateCrossed = false;
                if (!bDueDateCrossed) {
                    var urlPath = GLOBAL.getContextPath("CorrectPDRTableData", "MRPProcess", "MRP");
                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { ProdOrderId: ProductionOrderId }, "JSON", false);
                }
                else
                    //COMMON.prototype.showMessage("Order cannot be processed", "MRP Process");
                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgOrderCannotBeProcessed, MRP_PROCESS.MRP_PROCESSMsgs.MRPProcess);
            }
            else {
                if (MRP_PROCESS.strVoucherNos.length > 0) {
                    MRP_PROCESS.strVoucherNos = MRP_PROCESS.strVoucherNos.substring(0, MRP_PROCESS.strVoucherNos.length - 1);
                    //COMMON.prototype.showMessage("Orders Raised successfully. Purchase Orders raised of the voucher no(s): " + MRP_PROCESS.strVoucherNos, "MRP Process");
                    COMMON.prototype.showMessage(MRP_PROCESS.MRP_PROCESSMsgs.MRP_MP_msgOrdersRaisedSuccessfully + ": " + MRP_PROCESS.strVoucherNos, MRP_PROCESS.MRP_PROCESSMsgs.MRPProcess);
                }//Procurement Voucher
            }

        } catch (e) {
            alert("Exception: {MRP_PROCESS.CheckForNextLevel} " + e.message);
        }
        return true;
    },

    LoadandShowInsertPopup: function (data, lstDates) {
        try {

            var sGrid = "Id_InsertSchedule_FGrid";
            var tatalColumns = FGRIDCONTROL.getTotalColumns(sGrid);
            FGRIDCONTROL.deleteRows(sGrid, 1, FGRIDCONTROL.getTotalRows(sGrid));
            var Objcell = null; var rowEle = null;
            if (data.length > 0) {
                FGRIDCONTROL.insertRows(sGrid, 1, data.length);
                for (var i = 0; i < data.length; i++) {
                    for (var j = 0; j < tatalColumns; j++) {
                        Objcell = FGRIDCONTROL.getCellObject(sGrid, i + 1, j + 1);
                        rowEle = FGRIDCONTROL.getRowElement(document.getElementById(sGrid), i + 1);
                        switch (Objcell.iColumn) {
                            case 1:
                                Objcell.setCellText(data[i].sProductionOrderNo);
                                Objcell.setCellData("value", data[i].iProdOrderId);
                                FGRIDCONTROL.setCellData(rowEle, "iprodorderid", data[i].iProdOrderId);
