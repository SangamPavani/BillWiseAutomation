    /**
     * Return Test Result from Result Grid
     * @param {any} RowNo
     * @param {any} ele
     */
    GetResult: function (RowNo, ele) {
        try {
            //debugger
            var iColumnNo = 0;
            var iRowNo = 0;

            var DDlValue = -1;
            var ddlid = "ddlResult_" + (RowNo);
            for (var i = 0; i < TotalCheck.NoOfParameters; i++) {
                var Textboxid = "ResultValue_" + RowNo + "_" + i;
                var iType = parseInt(document.getElementById(Textboxid).dataset.iresulttype)
                switch (iType) {
                    case 0:
                        break;
                    case 1:
                    case 2:
                        var element = document.getElementById(Textboxid);

                        var MinValue = parseFloat(element.dataset.passedfrom).toFixed(TotalCheck.NoOfDecimals);
                        var MaxValue = parseFloat(element.dataset.passedto).toFixed(TotalCheck.NoOfDecimals);
                        var UserValue = parseFloat(element.value).toFixed(TotalCheck.NoOfDecimals);
                        if (UserValue != null && UserValue != undefined && UserValue != "NaN") {
                            if (parseFloat(UserValue) >= parseFloat(MinValue) && parseFloat(UserValue) <= parseFloat(MaxValue)) {
                                if (DDlValue != 0) {
                                    DDlValue = 1;
                                }
                            }
                            else {
                                DDlValue = 0;
                            }
                        }
                        break;
                    case 3:
                        var element = document.getElementById(Textboxid);

                        if (element.checked) {
                            if (DDlValue != 0) {
                                DDlValue = 1;
                            }
                        }
                        else {
                            DDlValue = 0;
                        }
                        break;
                    case 4:
                        break;
                    case 5:
                        break;
                    default:
                        break;

                }

            }
            document.getElementById(ddlid).value = DDlValue;
            if (TotalCheck.NoOfParameters == 1) {
                document.getElementById(ddlid).disabled = true;
            }
            if (DDlValue == 1) {
                TotalCheck.PassedAndFailed[RowNo] = "Passed";
            }
            else if (DDlValue == 0) {
                TotalCheck.PassedAndFailed[RowNo] = "Failed";
            }
            else if (DDlValue == -1) {
                TotalCheck.PassedAndFailed[RowNo] = "";
            }

            document.getElementById("txtQuantityPassed").value = TotalCheck.PassedAndFailed.filter(TotalCheck.ispassed).length;
            document.getElementById("txtQuantityFailed").value = TotalCheck.PassedAndFailed.filter(TotalCheck.isfailed).length;
            TotalCheck.TextChange();

        } catch (err) {
            COMMON.prototype.showMessage("{TotalCheck.GetResult}" + err.message, TotalCheck.TotalCheckMsgs.QC_TD_msgException);
        }
