    // Row selection change handler 
    onRowSelectionChange: function (obj, event) {
        if (obj.iRow != 0) {
            var bSelectAll = true;
            var totalRows = FGRIDCONTROL.getTotalRows(obj.Grid.id);
            var counter = 0;
            for (var i = 0; i < totalRows; i++) {
                var cell = FGRIDCONTROL.getCellObject(obj.Grid.id, (i + 1), 1);
                if (cell.getCheckboxState() != true) {
                    bSelectAll = false;
                }
                counter++;
            }
            if (!bSelectAll) {
                document.getElementById(obj.Grid.id + "_control_heading_ctrl_1").checked = false;
            }
            else if (counter == totalRows) {
                document.getElementById(obj.Grid.id + "_control_heading_ctrl_1").checked = true;
            }
