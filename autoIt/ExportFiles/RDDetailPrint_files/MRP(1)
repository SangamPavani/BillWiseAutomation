                                        //debugger
                                        if (data.objMRPPIO.lstBody[iRow].arrPIOTags != null) {
                                            for (var z = 0; z < data.objMRPPIO.lstBody[iRow].arrPIOTags.length; z++) {
                                                if (parseInt(data.objMRPPIO.lstBody[iRow].arrPIOTags[z].iTagId) == parseInt(cell.ColumnAttribute.pio_body_tagid)) {
                                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data.objMRPPIO.lstBody[iRow].arrPIOTags[z].iTagValue);
