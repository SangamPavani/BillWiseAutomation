    // RaisePO Grid cell change handler.
    onRaisePOGridCellChange: function (objCell, event) {
        try {
            
            var GridID = "Id_RaisePO_FGrid";
            if (objCell.bLeave == true) {
                if (objCell.iColumn == 6) {
                    if (MRP_PROCESS.IsMRP2Enabled() == true) {
                        objCell.processDefault(event);
                    } else {
                        objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                        objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                    }
                }
                else if (objCell.iColumn == 12) {
                    if (FGRIDCONTROL.getColumnCheckboxState(GridID, objCell.iRow, objCell.iColumn) == false) {
                        var cellVendor = FGRIDCONTROL.getCellObject(GridID, objCell.iRow, 12);
                        cellVendor.setCellData("value", 0);
                        cellVendor.setCellText("");
                    }
                }
                else if (objCell.iColumn == 13) {
                    var isOutSource = FGRIDCONTROL.getColumnCheckboxState(GridID, objCell.iRow, 12);
                    if (isOutSource == true) {
                        var vendorId = OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid);
                        objCell.setCellData("value", vendorId);
                        objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                    }
                    else {
                        objCell.setCellData("value", 0);
                        objCell.setCellText("");
                    }
                }
                else if (objCell.iColumn == 14) {
                    if (MRP_PROCESS.bAllowCapacityOrMachinePlanningManually) {
                        objCell.processDefault(event);
                    } else {
                        var produtionStartDate = 0;
                        if (DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid) >= DATE.prototype.today(MRP_PROCESS.CalanderType)) {
                            produtionStartDate = DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid);
                            objCell.setCellData("value", produtionStartDate);
                            objCell.setCellText(DATEPICKER.getText(objCell.ColumnAttribute.ctrlid));
                        }
                        else {
                            DATEPICKER.setDate(objCell.ColumnAttribute.ctrlid, DATE.prototype.today(MRP_PROCESS.CalanderType));
                            produtionStartDate = DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid);
                            objCell.setCellData("value", produtionStartDate);
                            objCell.setCellText(DATEPICKER.getText(objCell.ColumnAttribute.ctrlid));
                        }
                        MRP_PROCESS.arrRaisingPO[objCell.iRow - 1].iProductionStartDate = produtionStartDate;
                    }
                }
                else if (objCell.iColumn == 15) {
                    var iStartScheduleAfterMin = 5;
                    if (MRP_PROCESS.IsMRP2Enabled() == true && MRP_PROCESS.objMrp2preferenceData != null) {
                        iStartScheduleAfterMin = MRP_PROCESS.objMrp2preferenceData.iStartScheduleAfterMin;
                        iStartScheduleAfterMin = iStartScheduleAfterMin == 0 ? 5 : iStartScheduleAfterMin;
                    }
                    var ProductionStartTime = FTIMECONTROL.getTime(objCell.ColumnAttribute.ctrlid);
                    var CurrentDate = DATE.prototype.today(MRP_PROCESS.CalanderType);
                    var ProductionStartDateTemp = MRP_PROCESS.arrRaisingPO[objCell.iRow - 1].iProductionStartDate;
                    if (CurrentDate == ProductionStartDateTemp) {
                        var CurrentTime = FTime.addSeconds(FTime.getCurrentTime(), (iStartScheduleAfterMin - 1) * 60);
                        if (CurrentTime.iTime >= ProductionStartTime) {
                            CurrentTime = FTime.addSeconds(FTime.getCurrentTime(), iStartScheduleAfterMin * 60);
                            ProductionStartTime = CurrentTime.iTime;
                            FTIMECONTROL.setTime(objCell.ColumnAttribute.ctrlid, CurrentTime.iTime);
                            //objCell.setCellData("value", CurrentTime.iTime);
                            //objCell.setCellText(FTIMECONTROL.getText(objCell.ColumnAttribute.ctrlid));
                            COMMON.prototype.showMessage("Production Start Time Cannot be Less than " + FTIMECONTROL.getText(objCell.ColumnAttribute.ctrlid), "MRP");
                            return false;
                        }
                    }
                    objCell.setCellData("value", ProductionStartTime);
                    objCell.setCellText(FTIMECONTROL.getText(objCell.ColumnAttribute.ctrlid));
                    MRP_PROCESS.arrRaisingPO[objCell.iRow - 1].iProductionStartTime = ProductionStartTime;
                }
            }
            else {
                if (objCell.iColumn == 6) {
                    if (MRP_PROCESS.IsMRP2Enabled() == true) {
                        objCell.processDefault(event);
                    } else {
                        if (MRP_PROCESS.arrRaisingPO != null) {
                            var sBOMFilterr = "iProductId = " + MRP_PROCESS.arrRaisingPO[objCell.iRow - 1].iProductID + " and iAuthStatus=1" + " and iStatus = 1";
                            OPTIONCONTROL.setFilter(objCell.ColumnAttribute.ctrlid, sBOMFilterr);
                            //OPTIONCONTROL.setFilter(objCell.ColumnAttribute.ctrlid, "iProductId = " + MRP_PROCESS.arrRaisingPO[objCell.iRow - 1].iProductID);
                        }
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                    }
                }
                else if (objCell.iColumn == 12) {
                    if (objCell.cell != null && objCell.cell != undefined) {
                        objCell.cell.children[0].focus();
                    }
                }
                else if (objCell.iColumn == 13) {
                    var isOutSource = FGRIDCONTROL.getColumnCheckboxState(GridID, objCell.iRow, 12);
                    if (isOutSource == true) {
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                    }
                    else {
                        objCell.processDefault(event);
                    }
                }
                else if (objCell.iColumn == 14) {
                    if (MRP_PROCESS.bAllowCapacityOrMachinePlanningManually) {
                        objCell.processDefault(event);
                    } else {
                            element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                            objCell.setControl(element, objCell.getCellData("value"));
                    }
                }
                else if (objCell.iColumn == 15) {
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                }
                else {
                    var Row = FGRIDCONTROL.getRowElement("Id_RaisePO_FGrid", objCell.iRow);
                    var CellData = objCell;
                    CellData.Row = Row;
                    MRP_PROCESS.SelectRaisedProdOrderNo(CellData);
                }
            }
            return (true);
        } catch (e) {
            alert("Exception: MRP_PROCESS.onRaisePOGridCellChange " + e.message);
        }

    },
