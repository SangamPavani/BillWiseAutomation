    // Calculate Pending stock quantity and product quantity for Raising of Order(s)
    this.EvaluatePendingQty = function (iRowID, iChildTableId) {
        var data = {
            PendingStockQuantity: 0,
            PenQuantity: 0,
        };
        try {
            var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(iChildTableId);
            if (iTableExists > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(iChildTableId);
                if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise < MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty) {
                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty;
                }
                data.PendingStockQuantity = (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty -
                                             MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dRaisedReserveQty -
                                             MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dStockReserveQty -
                                             MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dAvailableStock);
                if (data.PendingStockQuantity == 0) {
                    data = {
                        PendingStockQuantity: 0,
                        PenQuantity: 0,
                    };
                    return data;
                }
                data.PenQuantity = (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise -
                                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dRaisedReserveQty -
                                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dStockReserveQty -
                                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dAvailableStock);
                if (data.PenQuantity < MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dMinQty) {
                    data.PenQuantity = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dMinQty;
                }
            }
        }
        catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.EvaluatePendingQty} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
            data = {
                PendingStockQuantity: 0,
                PenQuantity: 0,
            };
        }
        return data;
    }

