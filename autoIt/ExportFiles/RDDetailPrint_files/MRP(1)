                        MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dStockReserveQty -
                        MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSafetyStockQty);
                    MRP_PROCESS.FillStockReservation(iDocID, iDocType, 2, 0, MRP_PROCESS.iMaterialID, StockReserveQty, MRP_PROCESS.arrMRPProcessingDetail[MRP_PROCESS.MainRowID].iUnitID, MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iProductionEndDate, false, 0);
