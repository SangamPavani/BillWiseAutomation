            for (var i = 0; i < Data.VariantDetails.length; i++) {
                //VariantId = Data.VariantDetails[i].VariantId;
                var VariantName = Data.VariantDetails[i].VariantName;
                if (window.GlobalPref.Version == eVersion.Version10) {
