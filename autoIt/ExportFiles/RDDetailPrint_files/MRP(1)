            //setting Next Order After Explode
            if (MRP_PROCESS.bFromDPR == false || document.getElementById("hdnIsOpenFromOtherScreen_MRP").value == "0") {
                if (menuId != 3020) {
                    document.getElementById("btnPlanningPref_MRPProcess").style.display = "inline-block";
