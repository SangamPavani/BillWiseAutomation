        var iPlannedQty = 0;
        var iAlreadyReceivedQtyTot = 0;
        var iQtyToReceiveTot = 0;

        var sGridId = "Id_MRPReceiptFromProduction_Grid";
        var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
