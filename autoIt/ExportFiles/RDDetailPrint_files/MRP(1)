    // Get the product policy details for Safety stock based on selected policy type.
    GetProductPolicy: function (isLotsBreakup) {

        var ProductList = MRP_PROCESS.GetChildProducts();
        var productIds = "";
        var warehouseId = 0;
        if (ProductList.length > 0) {
            for (var i = 0; i < ProductList.length; i++) {
                productIds += ProductList[i].iProductID + ",";
                warehouseId = ProductList[i].irWarehouse;
            }
            productIds = productIds.substring(0, productIds.lastIndexOf(','));
        }
        //
        var urlPath = GLOBAL.getContextPath("GetProductsPolicy", "MRPProcess", "MRP");
        var fnResult = NETWORK.executeServerMethod(urlPath, true, { sProductIds: productIds, iWareHouseId: warehouseId }, "JSON", false, "MRP_PROCESS.SetProductPolicy", "", "", isLotsBreakup);
    },
