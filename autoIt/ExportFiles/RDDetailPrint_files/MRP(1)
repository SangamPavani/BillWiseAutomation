                                document.getElementById("Planning_Preferences_MrpProcess").style.display = "none";
                            }
                            $("#btnMRPProcess_QuickMRP").hide();
                            $("#btnRaisePO_QuickMRP").show();
                            return false;
                        }
                        //Bcz Of Unchecking showPolicys
                        //debugger
                        if (QUICKMRP.bApplyFilter == true && QUICKMRP.bfromQuickMRP == true && QUICKMRP.bShowPolicy == false) {
                            QUICKMRP.ProcessFromRaisePO();

                        }
                    }
                    else {
                        QUICKMRP.ResetToNewProcess();
                    }
                }
            }
            //debugger
            //Purchase Orders Stopper selected in quick MRP
            if (QUICKMRP.bfromQuickMRP == true && QUICKMRP.bApplyFilter == true) {
                if (document.getElementById("rbtnRaisePurchaseOpt_QuickMRP").checked == true) {
                    MRP_PROCESS.MRPProcessFinish();
                    MRP_PROCESS.SetToNextOrderOrNextLot();
                    if ($("#Id_RaisedPOsList_div .raisedPO-selected").length > 0) {
                        QUICKMRP.ProcessFromPlanningPreference();
                    }
                    var allLotsProduct = $("#ul_LotsBreakup_ProductTree_MRPProcess > li");
                    var bNextLot = false;
                    for (var i = 0; i < allLotsProduct.length; i++) {
                        if ($(allLotsProduct[i]).hasClass("OrderRaisePending") == true && $(allLotsProduct[i]).length > 0) {
                            bNextLot = true;
                            break;
                        }
                    }
                    if (bNextLot == false) {
                        MRP_PROCESS.FinishProcessAndResetData();
                    }
                    else {
                        if (QUICKMRP.bShowPolicy == false || QUICKMRP.iLotsProductPolicy == 0) {
                            QUICKMRP.ProcessFromRaisePO();
                        }
                    }
                }
            }
            //
            GLOBAL.LoadingEnd();
        }
        catch (e) {
            alert("Exception: {QUICKMRP.ProcessFromPlanningPreference} " + e.message);
            GLOBAL.LoadingEnd();
        }
