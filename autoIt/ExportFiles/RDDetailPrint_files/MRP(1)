    SetSchedulingDetail: function (data) {
        //debugger
        try {
            if (MRP_PROCESS.IsValidObject(data) == true) {
                if (data.length > 0) {
                    var GridId = "Id_SchedulePref_FGrid";
                    MRP_PROCESS.ClearGridRowData(GridId, data.length);
                    var totalColumns = FGRIDCONTROL.getTotalColumns(GridId);

                    var lstCurrLots = MRP_PROCESS.arrRaisePODataFromLots;
                    for (var irow = 0; irow < data.length; irow++) {
                        var sDoucument = "";
                        if (lstCurrLots[irow].lstTransQty.length > 0) {
                            for (var j = 0; j < lstCurrLots[irow].lstTransQty.length; j++) {
                                sDoucument = (sDoucument == "" ? "" : sDoucument + ",") + lstCurrLots[irow].lstTransQty[j].sDocumentNo;
                                //sCustomerName = (sCustomerName == string.Empty ? "" : sCustomerName + ",") + lstCurrLots[i].lstTransQty[j].sCustomer;                                
                            }
                            //iDuedate = data[i].lstTransQty.Min(p => p.iDueDate);
                        }

                        for (var icolumn = 0; icolumn < totalColumns; icolumn++) {
                            var cell = FGRIDCONTROL.getCellObject(GridId, (irow + 1), icolumn);
                            switch (icolumn) {
                                case 2:
                                    FGRIDCONTROL.setColumnCheckboxState(GridId, (irow + 1), icolumn, false);
                                    break;
                                case 3:
                                    FGRIDCONTROL.setColumnCheckboxState(GridId, (irow + 1), icolumn, data[irow].bBackFlush);
                                    break;
                                case 4:
                                    FGRIDCONTROL.setColumnCheckboxState(GridId, (irow + 1), icolumn, data[irow].bTrialPO);
                                    break;
                                case 5:
                                    cell.setCellText(sDoucument);
                                    cell.setCellData("value", sDoucument);
                                    //cell.setCellText(data[irow].sDocumentNo);
                                    //cell.setCellData("value", data[irow].sDocumentNo);
                                    break;
                                case 6:
                                    cell.setCellText(data[irow].sProductName);
                                    cell.setCellData("value", data[irow].sProductName);
                                    break;
                                case 7:
                                    cell.setCellText(data[irow].sProductCode);
                                    cell.setCellData("value", data[irow].sProductCode);
                                    break;
                                case 8:
                                    //cell.setCellText(parseFloat(data[irow].dQuantity).toFixed(MRP_PROCESS.iDecimalInQuantity));
                                    cell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(data[irow].dQuantity, MRP_PROCESS.iDecimalInQuantity)));
                                    cell.setCellData("value", data[irow].dQuantity);
                                    break;
                                case 9:
                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data[irow].iUnitID);
                                    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", data[irow].iUnitID);
                                    break;
                                case 10:
                                    var vendorId = isNaN(parseInt(data[irow].iVendorID)) == true ? 0 : parseInt(data[irow].iVendorID);
                                    if (vendorId > 0) {
                                        OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data[irow].iVendorID);
                                        cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                        cell.setCellData("value", data[irow].iVendorID);
                                    }
                                    break;
                                case 11:
                                    var sBOMFilter = "iProductId = " + data[irow].iProductID + " and iAuthStatus=1" + " and iStatus!=0 and iStatus<5";
                                    OPTIONCONTROL.setFilter(cell.ColumnAttribute.ctrlid, sBOMFilter);
                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data[irow].iVariantID);
                                    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", data[irow].iVariantID);
                                    break;
                                case 12:
                                    OPTIONCONTROL.setFilter(cell.ColumnAttribute.ctrlid, "iBomId=" + data[irow].iVariantID);
                                    // OPTIONCONTROL.setFilter(cell.ColumnAttribute.ctrlid, "iBomId=" + data[irow].iVariantID);


                                    var Result = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetRoutingIdDefaultOrBasedOnSize", "MRPProcess", "MRP"),
                                        true,
                                        {
                                            iBomId: data[irow].iVariantID, dQty: data[irow].dQuantity
                                        },
                                        "JSON", false);

                                    if (Result.lValue > 0 && Result.data > 0) {
                                        data[irow].iRoutingID = Result.data;
                                    }
                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data[irow].iRoutingID);
                                    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", data[irow].iRoutingID);
                                    break;
                                case 13:
                                    cell.setCellText(data[irow].iWIPAccount);
                                    cell.setCellData("value", data[irow].iWIPAccount);
                                    break;

                                case 1:
                                    cell.setCellText(data[irow].sDescription);
                                    cell.setCellData("value", data[irow].sDescription);
                                    break;
                            }
                        }
                    }
                    MRP_PROCESS.SelectAllGridRow(GridId);
                    MRP_PROCESS.ProcessToNextTab(3);
                }
            }
        }
        catch (e) {
            alert("Exception: MRP_PROCESS.SetSchedulingDetail " + e.message);
        }
    },

