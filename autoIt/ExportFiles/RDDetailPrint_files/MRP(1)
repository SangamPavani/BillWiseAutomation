    // Returns RaiseOrder list and Stock reservation list for posting or voucher
    GetFinalOrderAndStockDataToPost: function (arrRaisingOrders) {
        var objOrderAndStockData = {};
        try {
            var arrStockReservationList = [];
            if (MRP_DEPREQ.GetSelectedAttachmentPolicy() != 0) {
                for (var i = 0; i < MRP_DEPREQ.arrSelectedPO.length; i++) {
                    var arrRaiseOrder = [];
                    var Qty = MRP_DEPREQ.arrSelectedPO[i].dQuantity;
                    var RemainQty = Qty;
                    var OrderCount = 0;
                    for (var j = 0; j < arrRaisingOrders.length; j++) {
                        if (arrRaisingOrders[j].iProductID == MRP_DEPREQ.arrSelectedPO[i].iProductID) {
                            arrRaisingOrders[j].dRemainingQty = arrRaisingOrders[j].dQuantity;
                            arrRaisingOrders[j].lTransactionID = (OrderCount + 1);
                            arrRaiseOrder.push(arrRaisingOrders[j]);
                            OrderCount++;
                        }
                    }
                    var arrStock = MRP_DEPREQ.SplitStock(arrRaiseOrder, new Array(MRP_DEPREQ.arrSelectedPO[i]), 1, 0);
                    if (arrStock.length > 0) {
                        for (var s = 0; s < arrStock.length; s++) {
                            arrStockReservationList.push(arrStock[s]);
                        }
                    }
                }
            }
            else {
                arrStockReservationList = MRP_DEPREQ.arrStockReservation;
            }
            objOrderAndStockData.RaisedPO = arrRaisingOrders;
            objOrderAndStockData.arrStockReserve = arrStockReservationList;
            return objOrderAndStockData;
        }
        catch (e) {
            objOrderAndStockData.RaisedPO = arrRaisingOrders;
            objOrderAndStockData.arrStockReserve = MRP_DEPREQ.arrStockReservation;
            return objOrderAndStockData;
        }
    },

