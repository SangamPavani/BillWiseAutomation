    // This below function is used to calculating value from variable in Extra Fields    
    GetVariableValue: function (cellobj, event) {
        //debugger;
        var GridID = "Id_SampleCheckDetail_FGrid";
        var QCExtraData = SAMPLECHECK.lstQCInspectionExtraBodyData;
        var QCScreenList = SAMPLECHECK.lstMRPScreenFields.arrayOPbody;
        var Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 3);
        var resultType = parseInt(Rowcell.getCellData("resulttype"));
        var chkFormulaValue = 0;
        var objRowData = {};
        var lstRowData = [];
        var totalRows = FGRIDCONTROL.getTotalRows(GridID);
        var bFormulaCell = false; 
        let chkData = "";
        for (var iRowIndex = 1; iRowIndex <= totalRows; iRowIndex++) {
            if (cellobj.iRow == iRowIndex) {
                var gridRowData = FGRIDCONTROL.getRowValue(GridID, iRowIndex);
                for (var coldata = 0; coldata < gridRowData.length; coldata++) {                                        
                    objRowData = {};
                    objRowData.iRowIndex = iRowIndex;
                    objRowData.iDatatype = 0;
                    objRowData.iFieldId = gridRowData[coldata].MetaData.ifieldid;                        
                    if (gridRowData[coldata].MetaData.colid != undefined) {
                        objRowData.sFieldName = gridRowData[coldata].MetaData.colid;
                    } else {
                        objRowData.sFieldName = "";
                    }
                    objRowData.iVariableValue = gridRowData[coldata].Data.value;
                    objRowData.sVariableName = "";
                    objRowData.sFormulaValue = "";
                    lstRowData.push(objRowData);                                           
                }
                for (var sc = 0; sc < QCScreenList.length; sc++) {
                    for (var sd = 0; sd < lstRowData.length; sd++) {
                        if (lstRowData[sd].iFieldId == QCScreenList[sc].iFieldId) {
                            lstRowData[sd].sVariableName = QCScreenList[sc].sFieldName;
                        }
                    }
                }
                for (var qc = 0; qc < QCExtraData.length; qc++) {
                    for (var qd = 0; qd < lstRowData.length; qd++) {
                        if (lstRowData[qd].sFieldName == QCExtraData[qc].FieldName) {
                            lstRowData[qd].sVariableName = QCExtraData[qc].VariableName;
                            lstRowData[qd].sFormulaValue = QCExtraData[qc].Formula;
                        }
                    }
                }
            }
        }
        for (var ef = 0; ef < QCExtraData.length; ef++) {
            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
            chkData = element.value;
            if (cellobj.ColumnAttribute.colid == QCExtraData[ef].FieldName) {
                chkFormulaValue = QCExtraData[ef].Formula;
                var splitFormula = [], arrFormulaValues = [];
                if ((chkFormulaValue.charAt(0) === "&" || chkFormulaValue.charAt(0) === "#") && lstRowData != null) {
                    if (resultType == 1 || resultType == 2) { 
                        if (QCExtraData[ef].FieldType == 1 || QCExtraData[ef].FieldType == 6) {
                        } else {
                            //COMMON.prototype.showMessage("Please check Field Type is not matching of this column " + ' " ' + QCExtraData[ef].Caption + ' " ', "Information Message");
                            return false;
                        }
                    }
                    splitFormula = chkFormulaValue.split(/([-+*\/@#$()]|[^-+*\/]+])/);
                    bFormulaCell = true;  
                    if (splitFormula.length > 0 && (resultType == 3 || resultType == 4)) {
                        if (QCExtraData[ef].FieldType == 8) {
                            for (var fd = 0; fd < lstRowData.length; fd++) {
                                for (var op = 0; op < splitFormula.length; op++) {
                                    if (lstRowData[fd].sVariableName == splitFormula[op] && lstRowData[fd].sVariableName != "") {
                                        if (typeof lstRowData[fd].iVariableValue == "boolean") {
                                            arrFormulaValues.push(lstRowData[fd].iVariableValue);
                                        }
                                    }
                                }
                            }
                        }
                        else {
                            //COMMON.prototype.showMessage("Please check Field Type is not matching of this column " + ' " ' + QCExtraData[ef].Caption + ' " ', "Information Message");
                            return false;
                        }
                    }
                }                
                if (arrFormulaValues != null && arrFormulaValues.length > 0 && resultType == 3) {
                    let chkbooleanData = arr => arr.every(v => v === true);
                    chkData = chkbooleanData(arrFormulaValues);
                }
                if ((chkFormulaValue.charAt(0) === "&" || chkFormulaValue.charAt(0) === "#") && lstRowData != null) {                    
                    if (resultType == 1 || resultType == 2) {
                        var urlPath = SAMPLECHECK.GetQualityControlAreaName("GetValueFromVariable", "MRPCommonReports", eVersion.Version10);
                        var fnResult = NETWORK.executeServerMethod(urlPath, true,
                            { strFormula: chkFormulaValue, arrParams: lstRowData }, "JSON", false, "");
                        if (fnResult.data != null) {
                            if (resultType == 1) {
                                cellobj.setCellData("value", isNaN(parseInt(fnResult.data)) ? 0 : parseInt(fnResult.data));
                                cellobj.setCellText(isNaN(parseInt(fnResult.data)) ? 0 : parseInt(fnResult.data));
                            }
                            else if (resultType == 2) {
                                cellobj.setCellData("value", isNaN(parseFloat(fnResult.data)) ? 0 : parseFloat(fnResult.data).toFixed(SAMPLECHECK.DecimalInQuantity));
                                cellobj.setCellText(isNaN(parseFloat(fnResult.data)) ? 0 : parseFloat(fnResult.data).toFixed(SAMPLECHECK.DecimalInQuantity));
                            }
                        }
                        break;
                    }
                    else if (resultType == 3) {                                             
                        
                        if (chkData == "True" || chkData == "true" || chkData == true) {
                            chkData = "True";
                        } else if (chkData == "False" || chkData == "false" || chkData == false) {
                            chkData = "False";
                        }                       
                        if (chkData == "") {
                            cellobj.setCellData("value", "False");
                            cellobj.setCellText("False");
                        } else {
                            cellobj.setCellData("value", chkData);
                            cellobj.setCellText(chkData);
                        }
                        break;
                    }
                    else {
                        cellobj.setCellText(element.value, element.value);
                    }
                }
                else {
                    if (element != null) {
                        if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                            if (COMMON.prototype.isValidObject(element.selectedOptions[0])) {
                                cellobj.setCellText(element.selectedOptions[0].innerText, element.value);
                            } else {
                                cellobj.setCellText("", "");
                            }
                        } else if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.Date) {
                            cellobj.setCellData("value", DATEPICKER.getDate(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellText(DATEPICKER.getText(cellobj.ColumnAttribute.ctrlid));
