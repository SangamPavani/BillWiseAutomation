    // Process planning for Sub material and Do stock reservation
    this.ProcessStockSubMaterial = function (PDRParentId, sProdOrderNo) {
        try {
            ////debugger;
            var ReplenishmentType = -1;
            var PDRChildID = 0;
            for (var i = 0; i < MAIN_MRPPROCESS.arrMRPProcessingDetail.length; i++) {
                if (MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iPDRParentID == PDRParentId) {
                    MAIN_MRPPROCESS.MainRowID = i;
                    sProdOrderNo = sProdOrderNo + "-";
                    MAIN_MRPPROCESS.iMaterialID = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iMaterialID);
                    MAIN_MRPPROCESS.ParentProductId = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iParentID);//using in FillPurchase Order
                    dtDueDate = MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iDueDate;
                    PDRChildID = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iPDRChildID);
                    MAIN_MRPPROCESS.iProductionType = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iProductionTypeID);

                    var MaxQty = 0;
                    var MinQty = 0;
                    var SafetyStock = 0;
                    var PolicyData = MAIN_MRPPROCESS.ApplySafetyPolicy(MAIN_MRPPROCESS.arrMRPProcessingDetail[i]);
                    MaxQty = PolicyData.MaxQty;
                    MinQty = PolicyData.MinQty;
                    SafetyStock = PolicyData.SafetyStock;
                    if (MAIN_MRPPROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName == "Purchase") {
                        ReplenishmentType = 1;
                    }
                    else {
                        ReplenishmentType = 0;
                    }
                    MAIN_MRPPROCESS.FillPOTable(PDRParentId, PDRChildID, parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dRatio).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity), MaxQty, MinQty,
                      MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iDueDate, parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iVendorID),
                      parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].dBuyingRate).toFixed(MRP_REPLANNING.iNoOfDecimalsCurrency), SafetyStock, ReplenishmentType, 0,
                      parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iProcureType), "", parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[i].iVariantID),
                      MAIN_MRPPROCESS.arrMRPProcessingDetail[i].bRoundOff);

                    var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(PDRChildID);
                    if (iTableExists > 0) {
                        var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(PDRChildID);
                        if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex].length > 0) {
                            MAIN_MRPPROCESS.MaterialProcess(PDRParentId, PDRChildID, sProdOrderNo);
                        }
                    }
                    MAIN_MRPPROCESS.ProcessStockSubMaterial(PDRChildID, sProdOrderNo);
                }
            }
            return true;
        } catch (e) {
            return false;
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.ProcessStockSubMaterial} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Apply Safety policy for Sub Material and Main Material for Stock
    this.ApplySafetyPolicy = function (objProductionDetail) {
        var ResultData = {
            MaxQty: 0,
            MinQty: 0,
            SafetyStock: 0,
        };
        try {
            var dMax = parseFloat(objProductionDetail.dMaxOrderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
            var dMin = parseFloat(objProductionDetail.dMinOrderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
            var dReorderQty = parseFloat(objProductionDetail.dReorderQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
            var dSafetyStock = parseFloat(objProductionDetail.dSafetyStockQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
            var iReOrderPolicy = 0;
            if (objProductionDetail.sReplenishmentTypeName == "Purchase") {
                if (MAIN_MRPPROCESS.bRDR == true) {
                    iReOrderPolicy = 3;// document.getElementById("rdoRaiseSingleOrderForQty_MRPProcessing").checked == true ? 0 : parseInt(objProductionDetail.iReorderPolicy);
                }
                else
                    iReOrderPolicy = parseInt(objProductionDetail.iReorderPolicy);
            }
            else {
                iReOrderPolicy = parseInt(objProductionDetail.iReorderPolicy);
            }
            if (iReOrderPolicy == 0 || iReOrderPolicy == 3) {
                ResultData.MaxQty = 0;
                ResultData.MinQty = 0;
                ResultData.SafetyStock = 0;
            }
            else if (iReOrderPolicy == 2 || iReOrderPolicy == 4) {
                ResultData.MaxQty = dMax;
                ResultData.MinQty = dMin;
                ResultData.SafetyStock = dSafetyStock;
            }
            else if (iReOrderPolicy == 1) {
                ResultData.MaxQty = dMax;
                ResultData.MinQty = dReorderQty;
                ResultData.SafetyStock = dSafetyStock;
            }

        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.ApplySafetyPolicy} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
        return ResultData;
    }

    // Fills Order Table array and sub order and spliting of quantity
    this.FillPOTable = function (ParentTableId, ChildTableID, RatioQty, MaxQty, MinQty, DueDate, VendorID,
          BuyingRate, dSafetyStockQty, Type, iRoutingID, ProcureType, strBatch, VariantID, bRoundOff) {
        try {
            ////debugger;
            var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(ParentTableId);
            if (iTableExists > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(ParentTableId);
                var ParentRowCount = MAIN_MRPPROCESS.GetCountFromMRPDataCollection(iTableIndex);
                var Qty;
                iWarehouseID = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iWarehouseID);
                for (var i = 0; i < MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex].length; i++) {
                    if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iType == 0 && MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].RaisedQty > 0) {
                        var SafetyStockQty = 0;
                        if (i == ParentRowCount) {
                            SafetyStockQty = dSafetyStockQty;
                        }
                        ////debugger;
                        MAIN_MRPPROCESS.dRatioQuantity = MAIN_MRPPROCESS.bFromDPR == true ? parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].dPendingQty) : parseFloat(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].RaisedQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) * RatioQty;
                        Qty = MAIN_MRPPROCESS.dRatioQuantity;
                        Qty = bRoundOff == true ? Math.ceil(Qty) : Qty;
                        var TotQty = Qty;
                        if (!(ProcureType == 1 || ProcureType == 3)) {
                            var AvailableQty = MAIN_MRPPROCESS.DoReservation(parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID, TotQty);
                            if (AvailableQty != null && AvailableQty != undefined) {
                                if (isNaN(AvailableQty) == false) {
                                    TotQty = AvailableQty;
                                }
                            }
                            if (TotQty == 0) {
                                MAIN_MRPPROCESS.FillIssueToProduction(MAIN_MRPPROCESS.iMaterialID, parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), 1, Qty,
                                   parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iScrapPercentage).toFixed(4), ProcureType,
                                   parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID),
                                   parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReserveBy));

                                MAIN_MRPPROCESS.SaveMRPRaiseIssueToProduction(MAIN_MRPPROCESS.arrIssueToProduction);
                                MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iDueDate = MAIN_MRPPROCESS.arrMRPPOData[i].iProductionStartDate;
                            }
                        }
                        else if (ProcureType == 2) {
                            MAIN_MRPPROCESS.FillIssueToProduction(MAIN_MRPPROCESS.iMaterialID, parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID), 1, Qty,
                                  parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iScrapPercentage).toFixed(4), ProcureType,
                                  parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID),
                                  parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReserveBy));

                            MAIN_MRPPROCESS.SaveMRPRaiseIssueToProduction(MAIN_MRPPROCESS.arrIssueToProduction);
                            MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iDueDate = MAIN_MRPPROCESS.arrMRPPOData[i].iProductionStartDate;
                            TotQty = 0;
                        }
                        if (TotQty > 0) {
                            if (MinQty == 0 && MaxQty == 0) {
                                MAIN_MRPPROCESS.FillRows(ChildTableID, TotQty + SafetyStockQty, TotQty + SafetyStockQty, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate,
                                    VendorID, BuyingRate, parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].RowID), MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].OrderID,
                                    Type, iRoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].sOrderNo,
                                    MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID, MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iWIPAccount,
                                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionEndDate);
                            }
                            else {
                                MAIN_MRPPROCESS.SplitPO(2, TotQty + SafetyStockQty, MaxQty, MinQty, MAIN_MRPPROCESS.arrMRPPOData[i].iProductionStartDate, VendorID, BuyingRate,
                                    MAIN_MRPPROCESS.arrMRPPOData[i].RowID, MAIN_MRPPROCESS.arrMRPPOData[i].OrderID, Type, iRoutingID, ProcureType, strBatch, VariantID, MAIN_MRPPROCESS.arrMRPPOData[i].sOrderNo,
                                    MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID, MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iWIPAccount,
                                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionEndDate);
                            }
                        }
                    }
                }
                if (dSafetyStockQty > 0) {
                    MAIN_MRPPROCESS.ApplySafetyStock(ChildTableID, dSafetyStockQty);
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.FillPOTable} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
            return;
        }
    }

    // Stock reservation method for available stocks quantity
    this.DoReservation = function (ParentOrderID, iSpecificVendor, AvailableQty) {
        try {
            ////debugger;
            if (AvailableQty > 0) {
                AvailableQty = parseFloat(parseFloat(AvailableQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity));
                var arrTempStockStruct = [];
                var objStock = {
                    iProductId: MAIN_MRPPROCESS.iMaterialID,
                    iWareHouseId: 0, //optIssuingWarehouse.SelectedID < 0 ? 0 : parseInt(optIssuingWarehouse.SelectedID);
                    iDate: DATE.prototype.today(1),
                    iUseId: 0 //GlobalPref.iUserId;
                }
                arrTempStockStruct.push(objStock);
                var urlPath = GLOBAL.getContextPath("GetStockAvailabilityToReserve", "MRPProcess", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { arrStockStruct: arrTempStockStruct, bDoReservation: true }, "JSON", false);
                ////debugger
                if (fnResult.lValue > 0) {
                    var arrAvailableStock = fnResult.data;
                    if (arrAvailableStock != null) {
                        var lstReservation = []; // MRPReservation
                        for (var i = 0; i < arrAvailableStock.length; i++) {
                            var MRPReservation = {
                                iProductID: arrAvailableStock[i].iProductId,
                                dStock: arrAvailableStock[i].dQuantity,
                                iDueDate: arrAvailableStock[i].iDate,
                                sDocumentType: 0,
                                iReservationType: arrAvailableStock[i].ReserveType,
                                iTransactionID: arrAvailableStock[i].iTransactionId,
                                iWarehouseID: arrAvailableStock[i].iWareHouseId,
                                sReservationType: arrAvailableStock[i].sStockType,
                            };
                            lstReservation.push(MRPReservation);
                        }
                        if (lstReservation.length > 0) {
                            var iTotQty = 0;
                            var dAdjustedQty = 0;
                            var iDocID = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReserveBy);
                            var iDocType = parseInt(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iDocumentType);
                            lstReservation.sort(MAIN_MRPPROCESS.SortBasedOnProp('iDueDate'));
                            for (var i = 0; i < lstReservation.length; i++) {
                                if (AvailableQty > 0) {
                                    if (AvailableQty <= parseFloat(lstReservation[i].dStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity)) {
                                        dAdjustedQty = AvailableQty;
                                        iTotQty = iTotQty + dAdjustedQty;
                                        AvailableQty = 0;
                                    }
                                    else if (AvailableQty > parseFloat(lstReservation[i].dStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity)) {
                                        dAdjustedQty = parseFloat(lstReservation[i].dStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                                        iTotQty = iTotQty + parseFloat(lstReservation[i].dStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                                        AvailableQty = AvailableQty - parseFloat(lstReservation[i].dStock).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                                    }
                                    MAIN_MRPPROCESS.FillStockReservation(iDocID, iDocType, lstReservation[i].iReservationType, lstReservation[i].iTransactionID, lstReservation[i].iProductID, dAdjustedQty, 0, lstReservation[i].iDueDate, true);
                                    if ((parseInt(lstReservation[i].sDocumentType) == 1) || (parseInt(lstReservation[i].sDocumentType) == 2) || (parseInt(lstReservation[i].sDocumentType) == 0)) {
                                        var iLinkType = 0;
                                        if (parseInt(lstReservation[i].sDocumentType) == 1)
                                            iLinkType = 1;
                                        else if (parseInt(lstReservation[i].sDocumentType) == 2)
                                            iLinkType = 0;
                                        else if (parseInt(lstReservation[i].sDocumentType) == 0)
                                            iLinkType = 2;
                                        MAIN_MRPPROCESS.FillProductionOrderLinks(ParentOrderID, dAdjustedQty, iLinkType, parseInt(lstReservation[i].iTransactionID), 1, true);
                                    }
                                }
                                else {
                                    break;
                                }
                            }

                            MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].dAdjustedQty = parseFloat(parseFloat(MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].dAdjustedQty) + iTotQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                            MAIN_MRPPROCESS.SaveMRPRaiseStockReservationData(MAIN_MRPPROCESS.arrStockReservation);
                            if (MAIN_MRPPROCESS.arrProductionOrderLinks != null) {
                                if (MAIN_MRPPROCESS.arrProductionOrderLinks.length > 0) {
                                    MAIN_MRPPROCESS.SaveMRPDataInProdOrderLinksTable(MAIN_MRPPROCESS.arrProductionOrderLinks);
                                }
                            }
                        }
                    }
                }
            }
            return AvailableQty;
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.DoReservation} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
            return AvailableQty;
        }
    }

    // Fills PO Data collection Array object and Table Ids Array
    this.FillRows = function (iTableID, Qty, dQunatityToRaise, dtDueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID,
         MinQty, MaxQty, ProcureType, strBatch, VariantID, strParentOrderNo, iSpecificVendor, iWipAccount, dtProdStart, dtProdEnd) {
        try {
            var objPOData = {
                dSplitQty: Qty,
                dQuantityToRaise: dQunatityToRaise,
                iDueDate: dtDueDate,
                iVendorID: VendorID,
                dBuyingRate: BuyingRate,
                dSafetyStockQty: 0,
                RowID: 0,//can change later 
                ParentRowID: ParentRowID,
                OrderID: 0,
                ParentOrderID: ParentOrderID,
                sOrderNo: "",
                sParentOrderNo: strParentOrderNo,
                iType: Type,
                iProductionStartDate: dtProdStart,
                iProductionEndDate: dtProdEnd,
                dStockReserveQty: 0,
                dRaisedReserveQty: 0,
                RaisedQty: 0,
                dMinQty: MinQty,
                dMaxQty: MaxQty,
                dAvailableStock: 0,
                iProcureType: ProcureType,
                iSpecificVendorID: iSpecificVendor,
                iWIPAccount: iWipAccount,
                dITPQuantity: MAIN_MRPPROCESS.dRatioQuantity,
            }
            tempArray = [];
            tempArray.push(objPOData);
            MAIN_MRPPROCESS.arrMRPPODataCollection.push(tempArray);
            MAIN_MRPPROCESS.arrMRPTableIDs.push({ ID: iTableID, Tag: MAIN_MRPPROCESS.arrMRPPODataCollection.length - 1 }); // length-1

        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.FillRows} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Splits Order Quantity to File PO data
    this.SplitPO = function (TableID, TotalQty, MaxQty, MinQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type,
         RoutingID, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd) {
        try {
            var Count = 0;
            var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(TableID);
            if (iTableExists > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(TableID);
                if (TotalQty < MinQty) {
                    MAIN_MRPPROCESS.FillRows(TableID, TotalQty, MinQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd);
                    return;
                }
                else if (TotalQty > MinQty && TotalQty <= MaxQty) {
                    MAIN_MRPPROCESS.FillRows(TableID, TotalQty, TotalQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd);
                    return;
                }
                while (TotalQty > 0) {
                    MAIN_MRPPROCESS.FillRows(TableID, MaxQty, MaxQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd);
                    TotalQty = TotalQty - MaxQty;
                    Count = Count + 1;
                }
                if (TotalQty < 0) {
                    Count = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex].length - 1;
                    while (TotalQty < 0) {
                        if (Count >= 0) {
                            if (MaxQty + TotalQty < MinQty) {
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise = MinQty;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty = MinQty;
                                TotalQty = TotalQty + (MaxQty - MinQty);
                            }
                            else {
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise = parseFloat(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) + TotalQty;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty = parseFloat(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) + TotalQty;
                                TotalQty = 0;
                            }
                            Count = Count - 1;
                        }
                        else
                            TotalQty = 0;
                    }
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.SplitPO} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Apply Safety Stock quantity to the PO Data collection
    this.ApplySafetyStock = function (TableID, SafetyStockQty) {
        try {
            var Count = 0;
            var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(TableID);
            if (iTableExists > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(TableID);
                while (SafetyStockQty > 0) {
                    if (Count >= 0) {
                        if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise > SafetyStockQty) {
                            MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty = SafetyStockQty;
                            SafetyStockQty = SafetyStockQty - MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty;
                        }
                        else {
                            MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise;
                            if (SafetyStockQty - MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise > 0)
                                SafetyStockQty = SafetyStockQty - MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise;
                            else
                                SafetyStockQty = 0;
                        }
                        Count = Count - 1;
                    }
                    else
                        SafetyStockQty = 0;
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.ApplySafetyStock} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Final Material Process to Raise order for material based on Type
    this.MaterialProcess = function (ParentTableId, ChildTableID, strPONo) {
        try {
            ////debugger;
            var AddSafetyStockQty = 0;
            var iTableCunt = MAIN_MRPPROCESS.GetCountFromMRPTableIds(ChildTableID);
            if (iTableCunt > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(ChildTableID);
                for (var i = 0; i < MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex].length; i++) {
                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSplitQty = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSplitQty + AddSafetyStockQty;
                    MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty + AddSafetyStockQty;
                    if (parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType) != 2) {
                        if (!((parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType) == 1) ||
                            (parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType) == 3))) {
                            if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty > 0) {
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dAvailableStock = 0;//AvailableStock;
                            }
                        }
                        else if ((MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReplenishmentTypeName == "Production") &&
                            (parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType) == 1)) {
                            MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReplenishmentTypeName = "Purchase";
                            for (var iRowCount = 0; iRowCount < MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex].length; iRowCount++) {
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowCount].iType = 1;
                            }
                        }
                        if ((MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSplitQty -
                            MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dRaisedReserveQty -
                            MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dStockReserveQty -
                            MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dAvailableStock) > 0) {
                            if (MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReplenishmentTypeName == "Production" ||
                                MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReplenishmentTypeName == "Always Produce") {
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionStartDate = MAIN_MRPPROCESS.dtProductionStartDate;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProductionEndDate = MAIN_MRPPROCESS.dtProductionStartDate;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iType = 0;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].bOutSource = false;
                                MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iVendorID = 0;
                            }
                            AddSafetyStockQty = 0;
                        }
                        else {
                            AddSafetyStockQty = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty;
                            MAIN_MRPPROCESS.FillIssueToProduction(MAIN_MRPPROCESS.iMaterialID, parseInt(MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].ParentOrderID), 1,
                             (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSplitQty - MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty),
                             MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iScrapPercentage, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType,
                             MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID, MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReserveBy);

                            MAIN_MRPPROCESS.SaveMRPRaiseIssueToProduction(MAIN_MRPPROCESS.arrIssueToProduction);
                            MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iDueDate = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iDueDate;
                        }
                    }
                    else {
                        AddSafetyStockQty = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty;
                        MAIN_MRPPROCESS.FillIssueToProduction(MAIN_MRPPROCESS.iMaterialID, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].ParentOrderID, 1,
                        (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSplitQty - MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].dSafetyStockQty),
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iScrapPercentage, MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iProcureType,
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iSpecificVendorID, MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReserveBy);

                        MAIN_MRPPROCESS.SaveMRPRaiseIssueToProduction(MAIN_MRPPROCESS.arrIssueToProduction);
                        MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].iDueDate = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][i].iDueDate;
                    }
                }
                lstTempPO = MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex];
                if (MAIN_MRPPROCESS.arrMRPProcessingDetail[MAIN_MRPPROCESS.MainRowID].sReplenishmentTypeName == "Production") {
                    lstTempPO.sort(MAIN_MRPPROCESS.SortBasedOnProp('iProductionStartDate'));
                }
                for (var i = 0; i < lstTempPO.length; i++) {
                    if ((lstTempPO[i].dSplitQty - lstTempPO[i].dRaisedReserveQty - lstTempPO[i].dStockReserveQty - lstTempPO[i].dAvailableStock) > 0) {
                        MAIN_MRPPROCESS.RaiseOrderByType(i, ChildTableID, ParentTableId, strPONo);
                    }
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.MaterialProcess} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Raise Order By Product Type (Purchase/Production/Dependent Requirement)
    this.RaiseOrderByType = function (iRowID, iChildTableID, iParentTableID, strPONo) {
        try {
            ////debugger;
            var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(iChildTableID);
            if (iTableExists > 0) {
                var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(iChildTableID);
                if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iType == 1) {
                    if (MAIN_MRPPROCESS.bRDR == true) {
                        MAIN_MRPPROCESS.RaiseDependentRequirements(iRowID, iChildTableID, iParentTableID);
                    }
                    else {
                        MAIN_MRPPROCESS.RaisePurchaseOrder(iRowID, iChildTableID, iParentTableID);
                    }
                }
                else if (MAIN_MRPPROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iType == 0) {
                    MAIN_MRPPROCESS.RaiseProductionOrder(iRowID, iChildTableID, iParentTableID, strPONo);
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.RaiseOrderByType} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }

    // Save data for Dependent Requirement and production order links
    this.RaiseDependentRequirements = function (iRowID, iChildTableID, iParentTableID) {
        try {
            ////debugger;
            var PendingStockQuantity = 0;
            var PenQuantity = 0;
            var PendingData = MAIN_MRPPROCESS.EvaluatePendingQty(iRowID, iChildTableID);
            PendingStockQuantity = PendingData.PendingStockQuantity;
            PenQuantity = PendingData.PenQuantity;
            if (PendingStockQuantity > 0) {
                var iTableExists = MAIN_MRPPROCESS.GetCountFromMRPTableIds(iChildTableID);
                if (iTableExists > 0) {
                    var iTableIndex = MAIN_MRPPROCESS.GetTableIndexFromMRPTable(iChildTableID);
