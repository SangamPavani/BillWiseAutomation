            MRPProductionOrderDetails.OnPlanScheduleClick(ProductionOrders.MaterialID, "ScheduleStartTime_PlanOrders", "ScheduleStartDate_PlanOrders", ProductionOrders.ProductionOrderNo, ProductionOrders.ProductName, ProductionOrders.ProductCode, ProductionOrders.Quantity, ProductionOrders.iRoutingId, ProductionOrders.iProductionOrderId, ObjCell.cell.children[0], duedate);
