                            switch (iType) {
                                case 0: //Text
                                    objQCSTotalCheckBodyValues.sValue = document.getElementById(ResultValueId).value;
                                    objQCSTotalCheckBodyValues.iResult = 1;
                                    break;
                                case 1: //Interger
                                    objQCSTotalCheckBodyValues.sValue = document.getElementById(ResultValueId).value;
                                    UserValue = parseInt(document.getElementById(ResultValueId).value);

                                    if (isNaN(UserValue)) {
                                        COMMON.prototype.showMessage(TotalCheck.TotalCheckMsgs.msgEnterValue, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                                        return false;
                                    }

                                    objQCSTotalCheckBodyValues.iResult = 0;
                                    if (parseFloat(UserValue) >= parseFloat(MinValue) && parseFloat(UserValue) <= parseFloat(MaxValue)) {
                                        objQCSTotalCheckBodyValues.iResult = 1;
                                    }
                                    break;
                                case 2: //Double
                                    objQCSTotalCheckBodyValues.sValue = document.getElementById(ResultValueId).value;
                                    UserValue = parseFloat(document.getElementById(ResultValueId).value).toFixed(TotalCheck.NoOfDecimals);

                                    if (isNaN(UserValue)) {
                                        COMMON.prototype.showMessage(TotalCheck.TotalCheckMsgs.msgEnterValue, TotalCheck.TotalCheckMsgs.lblErrorMsg);
                                        return false;
                                    }

                                    objQCSTotalCheckBodyValues.iResult = 0;
                                    if (parseFloat(UserValue) >= parseFloat(MinValue) && parseFloat(UserValue) <= parseFloat(MaxValue)) {
                                        objQCSTotalCheckBodyValues.iResult = 1;
                                    }
                                    break;
                                case 3: //Check Box
                                    objQCSTotalCheckBodyValues.sValue = document.getElementById(ResultValueId).checked;
                                    objQCSTotalCheckBodyValues.iResult = 1;

                                    break;
                                case 4: //Combo Box

                                    break;
                                case 5: //Information
                                    break;
                                default:
                                    break;
                            }

                            lstTotalCheckBodyValues.push(objQCSTotalCheckBodyValues);
                            objQCSTotalCheckBodyValues = {};

                            if (TotalCheck.NoOfParameters > x + 1) {
                                x = x + 1;
                            }
                            break;
                        case (6 + (x * 4)):
                            var ddlid = "ddlResult_" + RowCount;
                            objQCSTotalCheckBody.iResult = document.getElementById(ddlid).value;
                            break;
                        case (7 + (x * 4)):
                            var txtRemarks = "txtRemarks_" + RowCount;
                            objQCSTotalCheckBody.sRemarks = document.getElementById(txtRemarks).value;
                            break;
                        default:
                    }
                }

                objQCSTotalCheckBody.lstQCSTotalCheckBodyValues = lstTotalCheckBodyValues;

                lstTotalCheckBody.push(objQCSTotalCheckBody);
                objQCSTotalCheckBody = {};

                lstTotalCheckBodyValues = [];
            }
            TotalCheck.QCSTotalCheckBody = lstTotalCheckBody;
            return true;

        } catch (err) {
            COMMON.prototype.showMessage("{TotalCheck.GetTotalCheckBody}" + err.message, TotalCheck.TotalCheckMsgs.QC_TD_msgException);
        }
    },


