                            cellobj.setCellData("value", data[i].sRefOrderNo);
                            break;
                        case "sRefOrderNo":
                            cellobj.setCellText(data[i].sRefOrderNo);
                            cellobj.setCellData("value", data[i].sRefOrderNo);
                            break;

                        case "iProductionOrderId":
                            cellobj.setCellText(data[i].iProductionOrderId);
                            cellobj.setCellData("value", data[i].iProductionOrderId);
