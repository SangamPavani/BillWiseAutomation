    // Set Sample check details to grid
    SetSampleCheckDetailGrid: function (arrSampleCheckBody, bFromSplit) {
        //debugger;
        var testHeaderId = SAMPLECHECK.GetSampleCheckHeaderId();
        var sPrefix = "";
        if (SAMPLECHECK.AllowEntervalueforsampleQtyQCInspection) {
            sPrefix = document.getElementById("txtPieceNoPrefix").value;
        }
        var ReqdataFields = OPTIONCONTROL.getControlDataObject("FOption_TestName_SC");
        var urlPath = SAMPLECHECK.GetQualityControlAreaName("GetExtraFieldsData", "Requisition", eVersion.Version10);
        var fnResult = NETWORK.executeServerMethod(urlPath, true,
            { iScreenId: MRPScreens.Requisition, Id: ReqdataFields.iReqBodyId, bHeader: false }, "json", false, "");
        var GridID = "Id_SampleCheckDetail_FGrid";
        if (arrSampleCheckBody != null)
            SAMPLECHECK.ClearGridRowData(GridID, arrSampleCheckBody.length);
        FGRIDCONTROL.clearData(GridID, true);
        if (arrSampleCheckBody != null) {
            var iTotalColumns = FGRIDCONTROL.getTotalColumns(GridID);
            for (var i = 0; i < arrSampleCheckBody.length; i++) {
                for (var j = 1; j <= iTotalColumns; j++) {
                    var cell = FGRIDCONTROL.getCellObject(GridID, (i + 1), j);
                    switch (j) {
                        case 1:
                            cell.setCellData("testbodyid", arrSampleCheckBody[i].TestBodyId);
                            cell.setCellData("testheaderid", arrSampleCheckBody[i].TestHeaderId);
                            cell.setCellData("testdefbodyid", arrSampleCheckBody[i].TestDefBodyId);
                            cell.setCellData("testdefheaderid", arrSampleCheckBody[i].TestDefHeaderId);
                            cell.setCellData("resulttype", arrSampleCheckBody[i].ResultType);
                            cell.setCellData("minspec", arrSampleCheckBody[i].MinSpec);
                            cell.setCellData("maxspec", arrSampleCheckBody[i].MaxSpec);
                            cell.setCellData("passedfrom", arrSampleCheckBody[i].PassedFrom);
                            cell.setCellData("passedto", arrSampleCheckBody[i].PassedTo);
                            cell.setCellData("tolerance", arrSampleCheckBody[i].Tolerance);
                            cell.setCellData("bconsumeduringtest", arrSampleCheckBody[i].bConsumeDuringTest);
                            if (arrSampleCheckBody[i].bConsumeDuringTest == true || arrSampleCheckBody[i].bConsumeDuringTest == "True") {
                                SAMPLECHECK.bConsumeDuringTest = true;
                            }
                            break;
                        case 2:
                            if (testHeaderId > 0) {
                                cell.setCellText(arrSampleCheckBody[i].sPieceNo == null ? (sPrefix + "1") : arrSampleCheckBody[i].sPieceNo);
                                cell.setCellData("value", arrSampleCheckBody[i].sPieceNo == null ? (sPrefix + "1") : arrSampleCheckBody[i].sPieceNo);
                            } else {
                                if (!bFromSplit) {
                                    cell.setCellText(sPrefix + "1");
                                    cell.setCellData("value", sPrefix + "1");
                                } else {
                                    cell.setCellText(arrSampleCheckBody[i].sPieceNo);
                                    cell.setCellData("value", arrSampleCheckBody[i].sPieceNo);
                                }
                            }
                            break;
                        case 3:
                            OPTIONCONTROL.setControlValue("FOption_ParametersName_SC", arrSampleCheckBody[i].ParameterId)
                            cell.setCellText(OPTIONCONTROL.getControlText("FOption_ParametersName_SC"));
                            cell.setCellData("value", arrSampleCheckBody[i].ParameterId);
                            dataFields = OPTIONCONTROL.getControlDataObject("FOption_ParametersName_SC");
                            cell.setCellData("resulttype", dataFields.iResultType);
                            cell.setCellData("resultvalue", dataFields.Resultvalue);
                            break;
                        case 4:
                            cell.setCellText(arrSampleCheckBody[i].SampleSize);
                            cell.setCellData("value", arrSampleCheckBody[i].SampleSize);
                            break;
                        case 5:
                            var actualSampleSize = 0;

                            //debugger
                            if (!bFromSplit) {
                                var qtyTested = document.getElementById("txtAvailableQty_SC").value;
                                if (arrSampleCheckBody[i].iSampleSizeType == 2) {

                                    actualSampleSize = parseFloat(arrSampleCheckBody[i].dExternalSampleSize).toFixed(SAMPLECHECK.DecimalInQuantity);
                                }

                                else if (arrSampleCheckBody[i].iSampleSizeType == 0) {

                                    actualSampleSize = parseFloat((qtyTested * arrSampleCheckBody[i].SampleSize) / 100).toFixed(SAMPLECHECK.DecimalInQuantity);

                                    if (arrSampleCheckBody[i].iRoundType == 0) { //None
                                        actualSampleSize = actualSampleSize;
                                    } else if (arrSampleCheckBody[i].iRoundType == 1) { //Nearest
                                        actualSampleSize = Math.round(actualSampleSize);
                                    } else if (arrSampleCheckBody[i].iRoundType == 2) { //Floor
                                        actualSampleSize = Math.floor(actualSampleSize);
                                    } else if (arrSampleCheckBody[i].iRoundType == 3) { // Ceiling
                                        actualSampleSize = Math.ceil(actualSampleSize);
                                    }
                                }
                                else {
                                    actualSampleSize = arrSampleCheckBody[i].SampleSize;
                                }
                            } else {
                                actualSampleSize = arrSampleCheckBody[i].dLineWiseSampleQty;
                            }
                            cell.setCellText(isNaN(actualSampleSize) ? 0.00 : actualSampleSize);
                            cell.setCellData("value", isNaN(actualSampleSize) ? 0.00 : actualSampleSize);
                            break;
                        case 6:
                            var iCheckStatus = arrSampleCheckBody[i].TestBodyId == 0 ? 1 : arrSampleCheckBody[i].TestStatus;
                            FGRIDCONTROL.setColumnCheckboxState(GridID, (i + 1), 6, iCheckStatus);
                            break;
                        case 7:
                            cell.setCellText(arrSampleCheckBody[i].PassedFrom);
                            cell.setCellData("value", arrSampleCheckBody[i].PassedFrom);
                            break;
                        case 8:
                            cell.setCellText(arrSampleCheckBody[i].PassedTo);
                            cell.setCellData("value", arrSampleCheckBody[i].PassedTo);
                            break;
                        case 9:
                            if (arrSampleCheckBody[i].Value) {
                                cell.setCellText(arrSampleCheckBody[i].Value);
                                cell.setCellData("value", arrSampleCheckBody[i].Value);
                            }
                            break;
                        case 10:
                            //debugger;
                            var sResult = "";
                            if (arrSampleCheckBody[i].ResultType == 0 || arrSampleCheckBody[i].ResultType == 5) {
                                sResult = "None";
                            }
                            else {
                                sResult = (arrSampleCheckBody[i].Result == 0) ? "Failed" : "Passed";
                            }
                            cell.setCellText(sResult);
                            cell.setCellData("value", arrSampleCheckBody[i].Result);
                            break;
                        case 11:
                            OPTIONCONTROL.setControlValue("FOption_Grid_TestedBy_SC", arrSampleCheckBody[i].TestedBy)
                            cell.setCellText(OPTIONCONTROL.getControlText("FOption_Grid_TestedBy_SC"));
                            cell.setCellData("value", arrSampleCheckBody[i].TestedBy);
                            break;
                        case 12:
                            cellobj = FGRIDCONTROL.getCellObject("Id_SampleCheckDetail_FGrid", cell.iRow, 3);//Parameter
                            cell.setCellText(cellobj.CellData.resultvalue);
                            cell.setCellData("value", cellobj.CellData.resultvalue);
                            break;
                        case 13:
                            if (arrSampleCheckBody[i].Remarks != null) {
                                cell.setCellText(arrSampleCheckBody[i].Remarks);
                                cell.setCellData("value", arrSampleCheckBody[i].Remarks);
                            }
                            break;
                    }
                    document.getElementById("Id_SampleCheckDetail_FGrid_body").children[i].style.backgroundColor = "";
                    document.getElementById("Id_SampleCheckDetail_FGrid_body").children[i].setAttribute("onclick", "SAMPLECHECK.SelectSamePiecenoRows(this)");
                }
                var iCount = 0;
                var iSampleCheckCount = 0;
                for (var k = 13; k <= iTotalColumns; k++) {
                    cell = FGRIDCONTROL.getCellObject(GridID, (i + 1), k);
                    if (cell.ColumnAttribute.ctrltype == "ReqExtrafields") {
                        iCount++;
                        var element = document.getElementById(cell.ColumnAttribute.ctrlid);
                        if (fnResult.data != null) {
                            if (fnResult.data[iCount - 1] != null && fnResult.data[iCount - 1] != "") {
                                if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                                    cell.setCellText(element.options[fnResult.data[iCount - 1] - 1].text, element.options[fnResult.data[iCount - 1] - 1].value);
                                } else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Date) {
                                    DATEPICKER.setDate(cell.ColumnAttribute.ctrlid, fnResult.data[iCount - 1]);
                                    cell.setCellText(DATEPICKER.getText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", fnResult.data[iCount - 1]);
                                } else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Master) {
                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, fnResult.data[iCount - 1]);
                                    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", fnResult.data[iCount - 1]);
                                }
                                else {
                                    cell.setCellText(fnResult.data[iCount - 1], fnResult.data[iCount - 1]);
                                }
                            } else {
                                cell.setCellText("", "");
                            }
                        }
                    } else if (cell.ColumnAttribute.ctrltype == "SampleCheckExtrafields") {
                        iSampleCheckCount++;
                        var element = document.getElementById(cell.ColumnAttribute.ctrlid);
                        if (arrSampleCheckBody[i].arrSampleCheckBodyExtra != null) {
                            if (arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1] != null && arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1] != "") {
                                if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                                    cell.setCellText(element.options[arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1] - 1].text, element.options[arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1] - 1].value);
                                } else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Date) {
                                    DATEPICKER.setDate(cell.ColumnAttribute.ctrlid, arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1]);
                                    cell.setCellText(DATEPICKER.getText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1]);
                                } else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Master) {
                                    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1]);
                                    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                    cell.setCellData("value", arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1]);
                                }
                                else {
                                    cell.setCellText(arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1], arrSampleCheckBody[i].arrSampleCheckBodyExtra[iSampleCheckCount - 1]);
                                }
                            } else {
                                cell.setCellText("", "");
                            }
                        }
                    }
                }

            }
        }
        $("#Id_SampleCheckDetail_FGrid_body input[type='checkbox']").css("display", "inline-block");
    },

