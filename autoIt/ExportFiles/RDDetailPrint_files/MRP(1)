    SplitPO: function (ParentTableId, TableID, TotalQty, MaxQty, MinQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type,
        RoutingID, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd, iUnitId) {
        try {
            var Count = 0;
            var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(ParentTableId);
            if (iTableExists > 0) {
                var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(ParentTableId);
                if (TotalQty < MinQty) {
                    MRP_PROCESS.FillRows(TableID, TotalQty, MinQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd, '', 0, iUnitId);
                    return;
                }
                else if (TotalQty > MinQty && TotalQty <= MaxQty) {
                    MRP_PROCESS.FillRows(TableID, TotalQty, TotalQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd, '', 0, iUnitId);
                    return;
                }
                while (TotalQty > 0) {
                    MRP_PROCESS.FillRows(TableID, MaxQty, MaxQty, DueDate, VendorID, BuyingRate, ParentRowID, ParentOrderID, Type, RoutingID, MinQty, MaxQty, ProcureType, strBatch, VariantID, strProdOrderNo, iSpecificVendor, iWIPAccount, dtProdStart, dtProdEnd, '', 0, iUnitId);
                    TotalQty = TotalQty - MaxQty;
                    Count = Count + 1;
                }
                if (TotalQty < 0) {
                    Count = MRP_PROCESS.arrMRPPODataCollection[iTableIndex].length - 1;
                    while (TotalQty < 0) {
                        if (Count >= 0) {
                            if (MaxQty + TotalQty < MinQty) {
                                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise = MinQty;
                                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty = MinQty;
                                TotalQty = TotalQty + (MaxQty - MinQty);
                            }
                            else {
                                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise = parseFloat(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise).toFixed(MRP_PROCESS.iDecimalInQuantity) + TotalQty;
                                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty = parseFloat(MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSplitQty).toFixed(MRP_PROCESS.iDecimalInQuantity) + TotalQty;
                                TotalQty = 0;
                            }
                            Count = Count - 1;
                        }
                        else
                            TotalQty = 0;
                    }
                }
            }
        } catch (e) {
            alert("Exception: {MRP_PROCESS.SplitPO} " + e.message);
        }
    },

    ApplySafetyStock: function (TableID, SafetyStockQty) {
        try {
            var Count = 0;
            var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(TableID);
            if (iTableExists > 0) {
                var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(TableID);
                while (SafetyStockQty > 0) {
                    if (Count >= 0) {
                        if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise > SafetyStockQty) {
                            MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty = SafetyStockQty;
                            SafetyStockQty = SafetyStockQty - MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty;
                        }
                        else {
                            MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dSafetyStockQty = MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise;
                            if (SafetyStockQty - MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise > 0)
                                SafetyStockQty = SafetyStockQty - MRP_PROCESS.arrMRPPODataCollection[iTableIndex][Count].dQuantityToRaise;
                            else
                                SafetyStockQty = 0;
                        }
                        Count = Count - 1;
                    }
                    else
                        SafetyStockQty = 0;
                }
            }
        } catch (e) {
            alert("Exception: {MRP_PROCESS.ApplySafetyStock} " + e.message);
        }
    },

