                            for (var iRowIndex = 1; iRowIndex <= rowCount - 1; iRowIndex++) {
                                var gridRowData = FGRIDCONTROL.getRowValue("Id_BomTagDetails_Grid", iRowIndex);
                                if (gridRowData[1].Value > 0) {
                                    iSequence = gridRowData[2].Value == "" ? -1 : gridRowData[2].Value;
