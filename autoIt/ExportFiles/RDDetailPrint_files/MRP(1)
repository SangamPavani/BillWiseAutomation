    this.CheckProductExistsOrNot = function (sGridId, iProducId) {
        try {
            //debugger
            var iVarientId = sGridId.split('_')[2];
            var bExists = false;
            var sOutPutGrid = "Bom_OutputGrid_" + iVarientId;
            var iTotalRows = FGRIDCONTROL.getTotalRows(sGridId);
            if (this.bDontAllowSelctionofMultipleProducts) {
                for (var i = 0; i < iTotalRows; i++) {
                    var celldataobj = FGRIDCONTROL.getCellObject(sGridId, i + 1, 8);
                    var iTempProduct = isNaN(parseInt(celldataobj.CellData.value)) ? 0 : parseInt(celldataobj.CellData.value);
                    if (iTempProduct == iProducId) {
                        bExists = true;
                        break;
                    }
                }
                let iAllowOutputProdAsInput = parseInt(document.getElementById('bAllowtoaddoutputasinput').innerText);
                if (iAllowOutputProdAsInput == 0) {
                    if (bExists == false) {
                        var iOutTotalRows = FGRIDCONTROL.getTotalRows(sOutPutGrid);
                        for (var j = 0; j < iOutTotalRows; j++) {
                            var opcelldataobj = FGRIDCONTROL.getCellObject(sOutPutGrid, j + 1, 7);
                            var iTempOPProduct = isNaN(parseInt(opcelldataobj.CellData.value)) ? 0 : parseInt(opcelldataobj.CellData.value);
                            if (iTempOPProduct == iProducId) {
                                bExists = true;
                                break;
                            }
                        }
                    }
                }
            }                        
            if (MRP_Ribbon.bRestrictItemFromBeingRepeatedInBillofMaterial) {
                for (var j = 0; j < iTotalRows; j++) {
                    var celldataobj = FGRIDCONTROL.getCellObject(sGridId, j + 1, 8);
                    var iTempProduct = isNaN(parseInt(celldataobj.CellData.value)) ? 0 : parseInt(celldataobj.CellData.value);
                    if (iTempProduct == iProducId) {
                        bExists = true;
                        break;
                    }
                }
                let iRestrictItemFromBeingRepeatedInBillofMaterial = parseInt(document.getElementById('iRestrictItemFromBeingRepeatedInBillofMaterial').innerText);
                if (iRestrictItemFromBeingRepeatedInBillofMaterial == 0) {
                    if (bExists == false) {
                        var iInputTotalRows = FGRIDCONTROL.getTotalRows(sGridId);
                        for (var k = 0; k < iInputTotalRows; k++) {
                            var opcelldataobj = FGRIDCONTROL.getCellObject(sGridId, k + 1, 7);
                            var iTempOPProduct = isNaN(parseInt(opcelldataobj.CellData.value)) ? 0 : parseInt(opcelldataobj.CellData.value);
                            if (iTempOPProduct == iProducId) {
                                bExists = true;
                                break;
                            }
                        }
                    }
                }
            }
            return bExists;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: BOM_INPUTGRID.CheckProductExistsOrNot " + err.message, MRP_Ribbon.MRP_RibbonMsgs.lblErrorMsg);
            return false;
        }
    }

