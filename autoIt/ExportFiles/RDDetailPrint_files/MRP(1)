                                    objCell.cell.innerText = celldata.sStdVal6;
                            }
                            break;

                    }
                }

                var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
                for (var iRow = 0; iRow < data.length; iRow++) {
                    //debugger
                    for (var iColumn = 0; iColumn < TotalColumns; iColumn++) {
                        var objCell = FGRIDCONTROL.getCellObject("Id_GeneralGrid_WorkCenterGroup_Routing", iRow + 1, iColumn + 1);
                        switch (objCell.iColumn) {
                            case 1:
                                objCell.setCellText(data[iRow].sWorkCenter);
