            else {
                cell = FGRIDCONTROL.getCellObject("Id_OrderQuantity_FGrid", (i + 1), 1);
                if (cell.CellData.value != "" && cell.CellData.value != undefined && cell.CellData.value != null) {
                    totalValue += parseInt(cell.CellData.value);
                }
            }
        }
        if (parseInt(document.getElementById("txtTotalQuantity_Policy_DMR").innerText.trim()) < totalValue && ele.value != "" && ele.value > 0) {
            //var isYes = confirm("Total Quantity is less then given quantities.\nAre you sure want to raise purchase Order(s) ?");
