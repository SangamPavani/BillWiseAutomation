                            //}
                            OBJPPPW.sBatchExpiry = parseInt(arrRowData[j].Text);
                            OBJPPPW.iExpiry = parseInt(arrRowData[j].Value);
                        }
                    }
                    //"BatchManufacturingDate"
                    else if (arrRowData[j].MetaData.ctrlatt == "BatchManufacturingDate") {
                        if (ERF_PRODUCTION.bBatchManufacturingDate) {
                            OBJPPPW.bBatchMfgDate = parseInt(arrRowData[j].Text);
                            OBJPPPW.iMfg = parseInt(arrRowData[j].Value);
                        }
                    }
                    //sRMA rma
                    else if (arrRowData[j].MetaData.ctrlatt == "rma") {
                        //debugger
                        if (ERF_PRODUCTION.bRMAEnable) {
                            //if (ERF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStocksByRMA != true) {
