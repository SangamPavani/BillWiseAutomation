        //debugger;
        var lstBOMRowDataTempOutPut = [];
        var lstBOMRowDataTempInput = [];
        var iMainIndex = -1;
        var iOutputIndex = 0;
        if (data.OutputGridHeaderDetails != null) {
            for (var k = 0; k < data.OutputGridHeaderDetails.Data.length; k++) {
                if (data.OutputGridHeaderDetails.Data[k][15] == true) {
                    iOutputIndex = k;
                    BOM_PROCESS.MainOutputProductCode = data.OutputGridHeaderDetails.Data[k][7];
                    break;
                }
            }
            for (var i = 0; i < data.OutputGridHeaderDetails.GridHeaderDetails.length; i++) {                
                var strcolumnname = data.OutputGridHeaderDetails.GridHeaderDetails[i].GridColumnName;
                if (strcolumnname == "ProductCode") {
                    document.getElementById("txtProductCodeId").value = data.OutputGridHeaderDetails.Data[iOutputIndex][i];

                }
                if (strcolumnname == "ProductName") {
                    $("#txtProductNameId").val(data.OutputGridHeaderDetails.Data[iOutputIndex][i]);
                }
                if (strcolumnname == "Quantity") {
                    $("#txtQuantityId").val(data.OutputGridHeaderDetails.Data[iOutputIndex][i]);
                }
                if (strcolumnname == "Unit") {
                    OPTIONCONTROL.setControlValue("FOption_Unit_BomProcess", data.OutputGridHeaderDetails.Data[iOutputIndex][i]);

                    // $("#txtUnitId").val(data.OutputGridHeaderDetails.Data[0][i]);
                }
            }
        }
        var iBOMId = isNaN(parseInt(OPTIONCONTROL.getControlValue("OC_BOMProcess_Name"))) ? 0 : parseInt(OPTIONCONTROL.getControlValue("OC_BOMProcess_Name"));
        //debugger;
        // Store Data input data
        if (data.InputGridHeaderDetails != null) {
            var iIndex = BOM_PROCESS.GetIndexForVariantId(data.InputGridHeaderDetails.GridHeaderDetails);
            for (var i = 0; i < data.InputGridHeaderDetails.Data.length; i++) {
                if (parseInt(data.InputGridHeaderDetails.Data[i][iIndex]) == iBOMId) {
                    BOMRowData = {};
                    for (var j = 0; j < data.InputGridHeaderDetails.GridHeaderDetails.length; j++) {
                        var strColumnName = data.InputGridHeaderDetails.GridHeaderDetails[j].GridColumnName;
                        switch (strColumnName) {
                            case "ProductId":
                                BOMRowData.iProductId = parseInt(data.InputGridHeaderDetails.Data[i][j]);
                                break;
                            case "ProductName":
                                BOMRowData.sProductName = data.InputGridHeaderDetails.Data[i][j];
                                break;

                            case "ProductCode":
                                BOMRowData.sProductCode = data.InputGridHeaderDetails.Data[i][j];
                                break;

                            case "Quantity":
                                BOMRowData.dActualQuantity = parseFloat(data.InputGridHeaderDetails.Data[i][j]).toFixed(BOM_PROCESS.NoofDecimals);
                                BOMRowData.dRemainingQuantity = parseFloat(data.InputGridHeaderDetails.Data[i][j]).toFixed(BOM_PROCESS.NoofDecimals);
                                BOMRowData.dProcessQuantity = parseFloat(0).toFixed(BOM_PROCESS.NoofDecimals);
                                break;

                            case "iAlternateOf":
                                BOMRowData.iAlternateOf = parseInt(data.InputGridHeaderDetails.Data[i][j]);
                                //Extra Coloumn............
                                BOMRowData.iProcessId = parseInt(0);
                                break;

                            default:
                                break;
                        }
                    }
                    lstBOMRowDataTempInput.push(BOMRowData);
                }
            }
        }
        //debugger;
        //   Store data output Grid
        if (data.OutputGridHeaderDetails != null) {
            var iIndex = BOM_PROCESS.GetIndexForVariantId(data.OutputGridHeaderDetails.GridHeaderDetails);
            for (var i = 0; i < data.OutputGridHeaderDetails.Data.length; i++) {
                if (parseInt(data.OutputGridHeaderDetails.Data[i][iIndex]) == iBOMId) {
                    BOMRowData = {};
                    for (var j = 0; j < data.OutputGridHeaderDetails.GridHeaderDetails.length; j++) {
                        var strColumnName = data.OutputGridHeaderDetails.GridHeaderDetails[j].GridColumnName;

                        switch (strColumnName) {
                            case "ProductId":
                                BOMRowData.iProductId = parseInt(data.OutputGridHeaderDetails.Data[i][j]);
                                break;
                            case "ProductCode":
                                BOMRowData.sProductCode = data.OutputGridHeaderDetails.Data[i][j];
                                BOMRowData.sProductName = data.OutputGridHeaderDetails.Data[i][j];
                                break;
                            case "Quantity":
                                BOMRowData.dActualQuantity = parseFloat(data.OutputGridHeaderDetails.Data[i][j]).toFixed(BOM_PROCESS.NoofDecimals);
                                BOMRowData.dRemainingQuantity = parseFloat(data.OutputGridHeaderDetails.Data[i][j]).toFixed(BOM_PROCESS.NoofDecimals);
                                break;
                            case "dType":
                                BOMRowData.iType = data.OutputGridHeaderDetails.Data[i][j];
                                break;
                            case "Unit":
                                BOMRowData.iUnit = data.OutputGridHeaderDetails.Data[i][j];
                                break;
                            case "Description":
                                BOMRowData.sDescription = data.OutputGridHeaderDetails.Data[i][j];
                                break;
                            case "IsMainOutPut":
                                BOMRowData.bMainOutput = data.OutputGridHeaderDetails.Data[i][j];
                                BOMRowData.iProcessId = 0;
                                BOMRowData.iCostingType = 1;
                                BOMRowData.iNodeId = 0;
                                break;
                            case "CostingPer":                                
                                BOMRowData.dCostPercentage = data.OutputGridHeaderDetails.Data[i][j];
                                break;                           
                            default:
                                break;
                        }
                    }
                    lstBOMRowDataTempOutPut.push(BOMRowData)
                }
            }
        }
        //This Array For PickProduct Product output.
        BOM_PROCESS.m_MainallProductOutPutGrid = lstBOMRowDataTempOutPut;

        for (var k = 0; k < lstBOMRowDataTempOutPut.length; k++) {
            if (lstBOMRowDataTempOutPut[k].bMainOutput == true || lstBOMRowDataTempOutPut[k].bMainOutput == "true") {
                BOM_PROCESS.m_iMainOutputProductId = lstBOMRowDataTempOutPut[k].iProductId;
                BOM_PROCESS.m_iMainOutputQty = lstBOMRowDataTempOutPut[k].dActualQuantity;
                BOM_PROCESS.m_sMainOutPutProduct = lstBOMRowDataTempOutPut[k].sProductCode;
            }
        }
        //ADDed New code
        if (BOM_PROCESS.isstatus == 0) {
            for (var m = 0; m < lstBOMRowDataTempOutPut.length; m++) {
                lstBOMRowDataTempOutPut[m].bMainOutput = false;
            }
        }

        //When First GetBOMProcessData this Method Return Null that time Global Object We have Fill 
        if (parseInt(BOM_PROCESS.isstatus) == parseInt(0)) {
            //debugger;
            var lstBomProcessName = [];
            BOM_PROCESS.objGBomProcessName = {
                iProcessId: 0,
                lstInputGridData: [],
                lstOutputGridData: [],
                sProcessName: "",
            };
            BOM_PROCESS.objGBomProcessName.lstInputGridData = lstBOMRowDataTempInput;
            BOM_PROCESS.objGBomProcessName.lstOutputGridData = lstBOMRowDataTempOutPut;
            BOM_PROCESS.objGBomProcessName.iProcessId = 1;
            BOM_PROCESS.objGBomProcessName.sProcessName = "fhfaf";
            lstBomProcessName.push(BOM_PROCESS.objGBomProcessName);
            BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName = lstBomProcessName;
            BOM_PROCESS.M_GridBOMProcess.iHeaderId = data.iHeaderId;

        }
    },

    GetIndexForVariantId: function (DataGrid) {
        try {
            var iIndex = 0;
            for (var i = 0; i < DataGrid.length; i++) {
                if ("VariantId" == DataGrid[i].GridColumnName) {
                    iIndex = i;
                    break;
                }
            }
            return iIndex;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {BOM_PROCESS.GetIndexForVariantId " + err.message, BOM_PROCESS.BOM_PROCESSMsgs.lblErrorMsg);
            return 1;
        }
    },

