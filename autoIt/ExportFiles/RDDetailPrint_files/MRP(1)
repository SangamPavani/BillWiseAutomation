// Methods for Product Tree Menu List
var MRP_TREEMENU = {
    MRP_PROCESSMsgs,
    selectElement: function (ele) {
        //
        try {
            ele.className += " menu-selected theme_color-inverse";
            if ($(ele.children[0]).hasClass('fa fa-circle')) {
                $(ele.children[0]).removeClass("circle-icon-color");
                $(ele.children[0]).addClass("theme_color-inverse");
            }
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.selectElement} " + err.message);
        }
    },

    unselectElement: function (ele) {
        try {
            $(ele).removeClass("menu-selected");
            $(ele).removeClass("theme_color-inverse");
            if ($(ele.children[0]).hasClass('fa fa-circle')) {
                $(ele.children[0]).removeClass("theme_color-inverse");
                $(ele.children[0]).addClass("circle-icon-color");
            }
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.unselectElement} " + err.message);
        }
    },

    toggleNodes: function (ele, event) {
        try {
            //debugger
            if (event != null) {
                event.stopImmediatePropagation();
            }
            allChilds = $(ele.parentElement.parentElement).children("ul");
            if (allChilds.length > 0) {
                for (iCounter = 0; iCounter < allChilds.length; iCounter++) {
                    if (allChilds[iCounter].style.display != "none") {
                        allChilds[iCounter].style.display = "none";
                    }
                    else {
                        allChilds[iCounter].style.display = "block";
                    }
                }
                if (window.GlobalPref.Version == eVersion.Version10) {
                    $(ele).toggleClass('icon-new icon-collepse');
                } else {
                    $(ele).toggleClass('icon-expand icon-collepse');
                }
            }
        }
        catch (err) {
            alert("Exception: MRP_TREEMENU.toggleNodes " + err.message);
        }
    },

    getParentElements: function (ele) {
        var isFound = false;
        var arrData = [];
        try {
            ele = ele.parentElement;
            while (COMMON.prototype.isValidObject(ele) == true) {
                if ($(ele).hasClass("TreeMenu") == true) {
                    isFound = true;
                    break;
                }
                if (COMMON.prototype.isNullOrEmpty(ele.nodeName) == false
                    && ele.nodeName.toLowerCase() == "li"
                    && ele.children.length > 0
                    && ele.children[0].nodeName.toLowerCase() == "a") {
                    arrData.push(ele.children[0]);
                }
                ele = ele.parentElement;
            }
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.getParentElements} " + err.message);
        }
        return (arrData);
    },

    unselectAll: function (ele) {
        var isFound = false;
        try {
            do {
                if ($(ele).hasClass("TreeMenu") == true) {
                    isFound = true;
                    break;
                }
                ele = ele.parentElement;
            } while (COMMON.prototype.isValidObject(ele) == true);
            //
            if (isFound == true) {
                $("#" + ele.id + " li a").each(function () {
                    MRP_TREEMENU.unselectElement(this);
                });
            }
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.unselectAll} " + err.message);
        }
    },

    selectNode: function (ele) {
        //
        try {
            MRP_TREEMENU.selectParentNodes(ele);
            currentMenu = $(ele).parent("a");
            //
            MRP_TREEMENU.selectElement(currentMenu[0]);
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.selectNode} " + err.message);
        }
    },

    selectParentNodes: function (ele) {
        //
        var arrParent = null;
        try {
            arrParent = MRP_TREEMENU.getParentElements(ele);
            for (var iCount = 0; iCount < arrParent.length; iCount++) {
                MRP_TREEMENU.selectElement(arrParent[iCount]);
            }
        }
        catch (err) {
            alert("Exception: {MASTER_MENU.selectParentNodes} " + err.message);
        }
    },

    expandAllParent: function (ele) {
        var arrParent = null;
        try {
            arrParent = MRP_TREEMENU.getParentElements(ele);
            for (var iCount = 0; iCount < arrParent.length; iCount++) {
                var eleI = arrParent[iCount].children[0];
                MRP_TREEMENU.toggleNodes(eleI, null);
            }
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.expandAllParent} " + err.message);
        }
    },

    isMenuSelected: function (sMainMenuId) {
        var bSelected = false;
        $("#" + sMainMenuId + " li a").each(function () {
            if ($(this).hasClass('menu-selected')) {
                bSelected = true;
            }
        });
        return bSelected;
    },

    selectMenu: function (ele, event) {
        //debugger
        try {
            if (event != null) {
                event.stopImmediatePropagation();
            }
            MRP_TREEMENU.unselectAll(ele);
            MRP_TREEMENU.selectNode(ele);
        }
        catch (err) {
            alert("Exception: {MRP_TREEMENU.selectMenu} " + err.message);
        }
    },

    getSelectedMenu: function (sMainMenuId) {
        var mnuData = {
        };
        try {
            //
            var selectedMenu = $("#" + sMainMenuId + " li .menu-selected").last();
            if (selectedMenu.length > 0) {
                var menuDetailTag = selectedMenu;
