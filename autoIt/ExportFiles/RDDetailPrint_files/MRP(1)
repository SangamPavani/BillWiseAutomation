    // For Calculation of Remaining Stock quantity to Raise order
    EvaluatePendingQty: function (iRowID, iChildTableId, iParentTableID) {


        var data = {
            PendingStockQuantity: 0,
            PenQuantity: 0,
        };
        var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(iChildTableId);
        if (iTableExists > 0) {
            var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(iChildTableId);
            if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise < MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty) {
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise = MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty;
            }
            data.PendingStockQuantity = (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dSplitQty -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dRaisedReserveQty -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dStockReserveQty -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dAvailableStock);
            if (data.PendingStockQuantity == 0) {
                data = {
                    PendingStockQuantity: 0,
                    PenQuantity: 0,
                };
                return data;
            }


            data.PenQuantity = (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dQuantityToRaise -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dRaisedReserveQty -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dStockReserveQty -
                MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dAvailableStock);
            //}
            if (data.PenQuantity < MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dMinQty) {
                data.PenQuantity = MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].dMinQty;
            }
        }
        return data;
    },

