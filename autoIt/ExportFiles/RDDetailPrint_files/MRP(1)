                if (OBJPPPW.iProcessMasterId == ERF_PRODUCTION.arrRFProductData[k].iProcessId && OBJPPPW.iProductId == ERF_PRODUCTION.arrRFProductData[k].iProductId) {
                    bMainProduct = ERF_PRODUCTION.arrRFProductData[k].bMainProduct;
                    iCostingType = ERF_PRODUCTION.arrRFProductData[k].iCostingType;
                    iCostingValue = ERF_PRODUCTION.arrRFProductData[k].iCostingValue;
