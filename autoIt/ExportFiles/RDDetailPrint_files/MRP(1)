    // Delete entry details from mapping grid
    DeleteSelectedRow: function (sGridId, iRowIndex) {
        //debugger;
        var GridId = FGRIDCONTROL.getGridIdFromCell(sGridId);
        if (GridId == "Id_ExistingProdDetail_Grid") {
            var cell2 = FGRIDCONTROL.getCellObject(GridId, iRowIndex, 2);
            if (cell2.getCellData("value") != null && cell2.getCellData("value") != undefined) {
                var bContinue = false;
                rowCount = FGRIDCONTROL.getTotalRows(GridId);
                if (cell2.getCellData("value") != "")
                    //bContinue = confirm("Are you sure to delete this details ?");
                    bContinue = confirm(MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.QC_TD_msgAreYouSureToDeleteThisDetails);
                else if (rowCount > 1 && cell2.getCellData("value") == "") {
                    bContinue = true;
                }
                if (bContinue == true) {
                    MAPTEST_PRODUCT.DeleteMappedProductFromTest(iRowIndex, GridId);
                }
            }
        } else if (GridId == "Id_ExistingTestDetail_Grid") {
            var cell2 = FGRIDCONTROL.getCellObject(GridId, iRowIndex, 2);
            if (cell2.getCellData("value") != null && cell2.getCellData("value") != undefined) {
                var bContinue = false;
                rowCount = FGRIDCONTROL.getTotalRows(GridId);
                if (cell2.getCellData("value") != "")
                    bContinue = confirm(MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.QC_TD_msgAreYouSureToDeleteThisDetails);
                else if (rowCount > 1 && cell2.getCellData("value") == "") {
                    bContinue = true;
                }
                if (bContinue == true) {
                    MAPTEST_PRODUCT.DeleteMappedProductFromTest(iRowIndex, GridId);
                }
            }
        }
        else {
            if (iRowIndex == 1) {
                FGRIDCONTROL.clearRowData(GridId, iRowIndex, true);
            }
            else {
                FGRIDCONTROL.clearRowData(GridId, iRowIndex, true);
                FGRIDCONTROL.deleteRows(GridId, iRowIndex, 1);
            }
        }
    },

    // Delete Product from Mapped Test and from Mapping product list of Test
    DeleteMappedProductFromTest: function (RowIndex, GridId) {
        //debugger;
        if (RowIndex > 0) {
            var mappedId;
            var cell2 = FGRIDCONTROL.getCellObject(GridId, RowIndex, 2);
            if (cell2.getCellData("mapid") != null && cell2.getCellData("mapid") != undefined && cell2.getCellData("mapid") != "") {
                mappedId = parseInt(cell2.getCellData("mapid"));
                
                if (isNaN(mappedId) == false) {

                    var urlPath = GLOBAL.getContextPath("CheckMappingProductUsedorNot", "MapTestToProducts", MAPTEST_PRODUCT.GetQualityControlAreaName());
                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { MappedId: mappedId }, "", false);
                    if (fnResult.data != null) {
                        if (fnResult.data == "True" || fnResult.data == true) {
                            COMMON.prototype.showMessage("It's already Used.Can't delete this Record.", MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.lblErrorMsg);
                            return false;
                        }
                    }

                    var urlPath = GLOBAL.getContextPath("DeleteQCMappedProduct", "MapTestToProducts", MAPTEST_PRODUCT.GetQualityControlAreaName());
                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { MappedId: mappedId }, "", false);
                    if (fnResult.lValue > 0 && fnResult.data != null) {
                        if (fnResult.data) {
                            if (RowIndex == 1) {
                                if (FGRIDCONTROL.getTotalRows(GridId) > 1) {
                                    FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                                    FGRIDCONTROL.deleteRows(GridId, RowIndex, 1);
                                }
                                else
                                    FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                            }
                            else {
                                FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                                FGRIDCONTROL.deleteRows(GridId, RowIndex, 1);
                            }

                            if (GridId == "Id_ExistingTestDetail_Grid") {
                                COMMON.prototype.showMessage("Deleted Successfully", MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.MapTestToProducts);
                                MAPTEST_PRODUCT.OnClick_New(true);
                            } else if (GridId == "Id_ExistingProdDetail_Grid") {
                                COMMON.prototype.showMessage("Deleted Successfully", MAPTEST_PRODUCT.MAPTEST_PRODUCTMsgs.MapTestToProducts);
                                MAPTEST_PRODUCT.OnReloadScreen();
                            }
                        }
                        if (GridId == "Id_ExistingTestDetail_Grid") {
                            MAPTEST_PRODUCT.GetAllExistingTestProducts();
                        }
                    }
                }
                else
                    FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
            }
            else {
                if (RowIndex == 1) {
                    if (FGRIDCONTROL.getTotalRows(GridId) > 1) {
                        FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                        FGRIDCONTROL.deleteRows(GridId, RowIndex, 1);
                    }
                    else
                        FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                }
                else {
                    FGRIDCONTROL.clearRowData(GridId, RowIndex, true);
                    FGRIDCONTROL.deleteRows(GridId, RowIndex, 1);
                }
            }
        }
    },

