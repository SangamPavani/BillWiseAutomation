        //debugger

        var lstExplodedBom = WIA.lstMRPExplodeBOM;
        var CurrentExplodeBOM = {};
        var index = 0;
        for (var i = 0; i < lstExplodedBom.length; i++) {
            if (lstExplodedBom[i].iChildID == iChildId) {
                index = i;
                CurrentExplodeBOM = lstExplodedBom[i];
            }
        }

        for (var i = 0; i < lstExplodedBom.length; i++) {
            if (lstExplodedBom[i].iVariantId > 0) {
                if (lstExplodedBom[i].iChildID == CurrentExplodeBOM.iParentID && lstExplodedBom[i].bScheduleCompleted == true) {
                    COMMON.prototype.showMessage("Scheduling Done for Parent Product: " + lstExplodedBom[i].sProductName, "What If Analysis");
                    return false;
                }
                if (lstExplodedBom[i].iChildID == CurrentExplodeBOM.iParentID && lstExplodedBom[i].bScheduleStarted == true) {
                    COMMON.prototype.showMessage("Scheduling Started for Parent Product: " + lstExplodedBom[i].sProductName + ". Clear the Schedules", "What If Analysis");
                    return false;
                }
            }
        }

        var url = GLOBAL.getContextPath("CancelPreSchedule", "WhatIfAnalysis", "MRP");
        var id = "LevelWise_" + (TableIndex) + "_Process_" + iChildId;
        var selectMastersResult = NETWORK.executeServerMethod(url, true, {
            iScheduleId: iSchedule,
            bOutSource: bOutSourceProcess == 0 ? true : false
        }, "JSON", false,
    "",
    "GLOBAL.LoadingStart",
    "GLOBAL.LoadingEnd");

        if (selectMastersResult.data != null && selectMastersResult.data != undefined) {
            //debugger
            if (parseInt(selectMastersResult.data) > 0) {

                var MainDivId = "LevelWiseExplodeGrid_" + TableIndex;
                var NoOfProcesses = document.getElementById(MainDivId).children.length;

                if (bOutSourceProcess == 1) {
                    for (var i = NoOfProcesses - 1; i >= 4; i--) {
                        document.getElementById(MainDivId).children[i].remove();
                    }
                }
                else if (bOutSourceProcess == 0) {
                    for (var i = NoOfProcesses - 1; i >= 5; i--) {
                        document.getElementById(MainDivId).children[i].remove();
                    }

                    var VendorOCId = "FOption_VendorName_" + TableIndex;
                    var jobRatetxtId = "WIA_JobRate_" + TableIndex;

                    document.getElementById(VendorOCId).disabled = "";
                    document.getElementById(jobRatetxtId).disabled = "";


