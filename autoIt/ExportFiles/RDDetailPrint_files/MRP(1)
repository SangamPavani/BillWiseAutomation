            MRP_PROCESS.BindExplodBOMGrid(data, TempData);
            MRP_PROCESS.ProcessToNextTab(5);
            if (parseInt(document.getElementById("mrpType_MenuId").value) != 3020) {
                //if (document.getElementById("rdoMPSchedule_LotsBreakup").checked == true)
                if (document.getElementById("ddlMRPType").value == 1) {
                    document.getElementById("btnDoMPSOrPPrefText_MRPProcess").textContent = "Run MPS";
                    document.getElementById("btnPlanning_MRPProcess").textContent = "Run MPS";
