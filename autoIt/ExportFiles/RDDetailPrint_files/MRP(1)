    LoadGridforWorkcenterGroup: function (data, celldata) {
        try {
            if (data.length > 0) {
                R_WORKCENTER.ClearGridRowData("Id_GeneralGrid_WorkCenterGroup_Routing", data.length);
            }
            else {
                R_WORKCENTER.ClearGridRowData("Id_GeneralGrid_WorkCenterGroup_Routing", 1);
            }
            if (R_WORKCENTER.IsValidObject(data) == true) {
                var sGridName = "Id_GeneralGrid_WorkCenterGroup_Routing";
                if (data.length > 1) {
                    FGRIDCONTROL.insertRows(sGridName, 1, data.length);
                    for (var i = 1; i < 8; i++) {
                        var Cell = FGRIDCONTROL.getCellObject(sGridName, parseInt(data.length + 1), i + 1);
                        Cell.setCellText(0);
                        Cell.setCellData("value", 0);
                    }
                }
                if (ROUTING.bAllowMultipleWorkCenterSelectioninRouting) {
                    FGRIDCONTROL.deleteRows(sGridName, 1, FGRIDCONTROL.getTotalRows(sGridName));
                    FGRIDCONTROL.insertRows(sGridName, 1, data.length + 1);
                }
                for (var i = 0; i < 8; i++) {
                    var objCell = FGRIDCONTROL.getCellObject("Id_GeneralGrid_WorkCenterGroup_Routing", 0, i + 1);
                    switch (i + 1) {
                        case 1:
                            break;
                        case 2:
                            if (celldata.sStdVal0 != undefined) {
                                if (celldata.sStdVal0 != null && celldata.sStdVal0 != "" && celldata.sStdVal0 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal0;
                            }
                            break;
                        case 3:
                            if (celldata.sStdVal1 != undefined) {
                                if (celldata.sStdVal1 != null && celldata.sStdVal1 != "" && celldata.sStdVal0 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal1;
                            }
                            break;
                        case 4:
                            if (celldata.sStdVal2 != undefined) {
                                if (celldata.sStdVal2 != null && celldata.sStdVal2 != "" && celldata.sStdVal2 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal2;
                            }
                            break;
                        case 5:
                            if (celldata.sStdVal3 != undefined) {
                                if (celldata.sStdVal3 != null && celldata.sStdVal3 != "" && celldata.sStdVal3 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal3;
                            }
                            break;
                        case 6:
                            if (celldata.sStdVal4 != undefined) {
                                if (celldata.sStdVal4 != null && celldata.sStdVal4 != "" && celldata.sStdVal4 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal4;
                            }
                            break;
                        case 7:
                            if (celldata.sStdVal5 != undefined) {
                                if (celldata.sStdVal5 != null && celldata.sStdVal5 != "" && celldata.sStdVal5 != undefined)
                                    objCell.cell.innerText = celldata.sStdVal5;
                            }
                            break;
                        case 8:
                            if (celldata.sStdVal6 != undefined) {
