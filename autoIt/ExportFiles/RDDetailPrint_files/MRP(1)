    CalculatedValue: function (iProductId, dOriginalQty) {
        //debugger;
        for (var i = 0; i < ROUTING.arrRoutingNodes.length; i++) {
            var ObjNode = ROUTING.arrRoutingNodes[i];
            for (var j = 0; j < ObjNode.arrRoutingBOMProduct.length; j++) {
                if (ObjNode.arrRoutingBOMProduct[j].iProductId == iProductId) {
                    dOriginalQty = dOriginalQty - ObjNode.arrRoutingBOMProduct[j].dQuantity;
                }
            }
        }
        return dOriginalQty;
    },
