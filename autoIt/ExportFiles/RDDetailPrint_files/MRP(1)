    resultBatch: function (bSuccess, arrBatchList, sCustomData) {
        debugger;
        let cellobject = null;
        let cellobj = null;
        let element = null;
        var SelectBatchList = [];
        var TotalBatchList = [];
        try {
            if (bSuccess == false) {
                return;
            }
            var sGridName = "Id_IssueToJobWorker_Grid";
            var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            var iBatchRow = -1;
            TotalBatchList = arrBatchList;
            for (var i = 0; i < TotalBatchList.length; i++) {
                TotalBatchList[i].iProductId = ISSUETOJOBWORKER.arrBodyData[TotalBatchList[i].iRowNo - 1].iProductId;
                TotalBatchList[i].dQuantityToIssue = ISSUETOJOBWORKER.arrBodyData[TotalBatchList[i].iRowNo - 1].dQuantityToIssue;
            }
            for (var j = 0; j < TotalRows; j++) {
                for (var k = 0; k < TotalColumns; k++) {
                    cellobj = FGRIDCONTROL.getCellObject(sGridName, j + 1, k + 2);
                    var cell = cellobj.ColumnAttribute.ctrlid.trim();
                    if (cell == "txtBatchId") {
                        ISSUETOJOBWORKER.iBatchColumnNo = cellobj.iColumn;
                        break;
                    }
                }
            }
            for (var i = 0; i < ISSUETOJOBWORKER.arrBodyData.length; i++) {
                ISSUETOJOBWORKER.arrBodyData[i].batchChecked = false;
                if (i < iBatchRow) {                   
                    continue;                                        
                }
                for (var s = 0; s < TotalBatchList.length; s++) {
                    if (TotalBatchList[s].iProductId == ISSUETOJOBWORKER.arrBodyData[i].iProductId && TotalBatchList[s].InvTagId == ISSUETOJOBWORKER.arrBodyData[i].iInvTagValue && TotalBatchList[s].dQuantityToIssue == ISSUETOJOBWORKER.arrBodyData[i].dQuantityToIssue) {
                        ISSUETOJOBWORKER.arrBodyData[i].batchChecked = true;
                        SelectBatchList.push(TotalBatchList[s]);
                        iBatchRow = i + 1;
                    }
                }
                if (SelectBatchList.length > 0) {
                    ISSUETOJOBWORKER.OnBatchOkClick(true, SelectBatchList, iBatchRow);
                    iBatchRow = iBatchRow + SelectBatchList.length - 1;
                    SelectBatchList = [];
                }
            }

            var autoallocate = document.getElementById('id_transactionentry_autoallocate');
            if (autoallocate != undefined || autoallocate != null) {
                autoallocate.setAttribute("disabled", true);
            }

        }
        catch (err) {
            COMMON.prototype.showMessage("Exception : {ISSUETOJOBWORKER.resultBatch} " + err.message, "Exception");
        }
    },
