    //Save BOM Process Data.
    SaveBomProcessData: function () {
        try {
            //debugger;
            arrBOMProcessData = [];
            arrBOMInputProcessData = [];
            arrBOMOutputProcessData = [];
            objBomProcessgriddata = {};

            if (BOM_PROCESS.b_ProductionExist == true)
            {
                COMMON.prototype.showMessage("Trasaction already exists cannot create BOM Process", "Warning Message");
                return false;
            }

            var BomfilterId = OPTIONCONTROL.getControlValue("OC_BOMProcess_Name");

            if (BomfilterId < 0 || BomfilterId == null || BomfilterId == "" || BomfilterId == "0") {
                //COMMON.prototype.showMessage("Select Bom", "Bom Process");
                COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.SelectBom, BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                return false;
            }

            //Here Save Method call Method;
            var iprocessid = 0;
            var sprocessName = "";
            var iProcessNodeId = 0;
            var beforeProcessindex = 0;
            var ivalueaddprocess = document.getElementsByClassName("dynamiccls");
            var ele = "";
            if (ivalueaddprocess.length > 0) {
                ele = document.getElementById(ivalueaddprocess[0].id);
                // iprocessid = document.getElementById(ele.id).value;
                iprocessid = document.getElementById(ele.id).value;
                iProcessNodeId = ele.title;
                sprocessName = ele.innerText;
                beforeProcessindex = ele.tabIndex;
            }
            BOM_PROCESS.UpdateProcessGridData(false, iprocessid, sprocessName, beforeProcessindex, iProcessNodeId);

            //debugger;
            var bvalidationStatus = BOM_PROCESS.ChkQuantityAllProduct();
            if (bvalidationStatus == false) {
                return false;
            }
            //debugger;
            var bvalidateMainOutPut = BOM_PROCESS.ValidateLastProcessOutput();
            var bFirstProcessQuantity = BOM_PROCESS.validateFirstProcessInput();
            var dCostingpercentagedata = 0;
            var bomProcessCostingstatus = false;
            if (bvalidationStatus == true && bvalidateMainOutPut == true && bFirstProcessQuantity == true) {
                //debugger;
                if (BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName != null) {
                    for (var i = 0; i < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName.length; i++) {
                        bomProcessCostingstatus = false;
                        dCostingpercentagedata = 0;
                        arrBOMInputGridtempdata = [];
                        arrBOMOutputGridtempdata = [];
                        for (var j = 0; j < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData.length; j++) {
                            BOMInputProcessData = {
                                //bSelect: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].bSelect,
                                iProductId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].iProductId,
                                sProductName: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].sProcessName,
                                sProductCode: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].sProductCode,
                                dActualQuantity: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].dActualQuantity,
                                dRemainingQuantity: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].dRemainingQuantity,
                                dProcessQuantity: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].dProcessQuantity,
                                iProcessId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].iProcessId,
                                bBiProduct: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].bBiProduct,
                                iAlternateOf: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].iAlternateOf,
                                iNodeId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[j].iNodeId,
                            }
                            arrBOMInputGridtempdata.push(BOMInputProcessData);
                        }

                        for (var k = 0; k < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData.length; k++) {
                            BOMOutputProcessData = {
                                iProductId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iProductId,
                                dQuantity: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].dActualQuantity,
                                iType: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iType,
                                bMainOutput: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].bMainOutput,
                                iProcessId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iProcessId,
                                iCostingType: parseInt(1),
                                bPercentageEdited: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].bPercentageEdited,
                                dCostPercentage: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].dCostPercentage,
                                iNodeId: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iNodeId,
                                // iNodeId
                                // sProductName: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].sProcessName,
                                //  iUnit: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iUnit,
                                // sDescription: BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].sDescription,   
                            }

                            if (parseInt(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].iProductId) > 0) {
                                bomProcessCostingstatus = true;                                
                                dCostingpercentagedata = +dCostingpercentagedata.toFixed(BOM_PROCESS.NoofDecimals) + +parseFloat(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstOutputGridData[k].dCostPercentage).toFixed(BOM_PROCESS.NoofDecimals);
                            }
                            arrBOMOutputGridtempdata.push(BOMOutputProcessData);
                        }

                        if (parseFloat(dCostingpercentagedata) != parseFloat(100) && bomProcessCostingstatus == true) {
                            //COMMON.prototype.showMessage("No Costing 100%", "Bom Process");
                            COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.MRP_BOMP_msgNoCosting100, BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                            return;
                        }

                        BOMProcessData = {};
                        BOMProcessData.iProcessId = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].iProcessId;
                        BOMProcessData.sProcessName = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].sProcessName;
                        BOMProcessData.iNodeId = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].iNodeId,
                        BOMProcessData.arrBOMInputProcessData = arrBOMInputGridtempdata;
                        BOMProcessData.arrBOMOutputProcessData = arrBOMOutputGridtempdata;
                        arrBOMProcessData.push(BOMProcessData);
                    }
                }
                var countOutputType = 0;                
                var BOMProcessLength = arrBOMProcessData.length;
                for (var l = 0; l < arrBOMProcessData.length; l++) {
                    for (var m = 0; m < arrBOMProcessData[l].arrBOMOutputProcessData.length; m++) {
                        if (arrBOMProcessData[l].arrBOMOutputProcessData[m].iType == 0) {
                            countOutputType++;
                        }
                        if (arrBOMProcessData[l].arrBOMOutputProcessData[m].iType == undefined) {
                            COMMON.prototype.showMessage("Output Type is missing in Some Output Product", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                            return;
                        }
                    }
                    if (l == BOMProcessLength -1) {
                        if (countOutputType > 1) {
                            COMMON.prototype.showMessage("Select Only One Output in Output Type", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                            return;
                        }
                        if (countOutputType == 0) {
                            COMMON.prototype.showMessage("Select atleast One Output in Output Type", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                            return;
                        }
                    }                    
                }
                for (var l = 0; l < arrBOMProcessData.length; l++) {
                    for (var n = 0; n < arrBOMProcessData[l].arrBOMOutputProcessData.length; n++) {
                        var iOutputProduct = arrBOMProcessData[l].arrBOMOutputProcessData[n].iProductId;
                        var bOutputProduct = arrBOMProcessData[l].arrBOMOutputProcessData[n].bMainOutput;
                        for (var p = 0; p < arrBOMProcessData.length; p++) {
                            for (var q = 0; q < arrBOMProcessData[p].arrBOMInputProcessData.length; q++) {
                                if (iOutputProduct == arrBOMProcessData[p].arrBOMInputProcessData[q].iProductId && bOutputProduct == true) {
                                    if (BOM_PROCESS.bAllowToSelectOutputItemAsInputBomProduct == false) {
                                        COMMON.prototype.showMessage("Cannot add Output Product in Input", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                                        return;
                                    }
                                }
                            }
                        }                        
                    }
                }
                objBomProcessgriddata.iBomId = OPTIONCONTROL.getControlValue("OC_BOMProcess_Name");
                objBomProcessgriddata.sProcessCode = OPTIONCONTROL.getControlText("OC_BOMProcess_Name");
                objBomProcessgriddata.iHeaderId = parseInt(BOM_PROCESS.M_GridBOMProcess.iHeaderId) == parseInt(0) ? 0 : parseInt(BOM_PROCESS.M_GridBOMProcess.iHeaderId);
                objBomProcessgriddata.lstProcessData = arrBOMProcessData;

                var urlPath = GLOBAL.getContextPath("SaveBOMProcess", "BOMProcess", "MRP");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { objBomProcess: objBomProcessgriddata, iNewBOMProcessId: 1 }, "JSON", true, "BOM_PROCESS.SetDataBomProcess");
            } //If Condition Close
        }
        catch (e) {
            alert("Exception: BOM_PROCESS.SaveBomProcessData " + e.message);
        }
    },

    //Quantity Check Depend On Product
    ChkQuantityAllProduct: function () {
        debugger;
        try {            
            for (var i = 0; i < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName.length; i++) {                                      
                for (var p = 0; p < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData.length; p++) {
                    var chkProcessQty = 0;
                    var iInputProductid = parseFloat(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[p].iProductId);                    
                    var sInputProductCode = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[p].sProductCode;
                    var dActualQuantity = parseFloat(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[p].dActualQuantity).toFixed(BOM_PROCESS.NoofDecimals);                   
                    var bBiProduct = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[i].lstInputGridData[p].bBiProduct;
                    for (var q = 0; q < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName.length; q++) {
                        var inputgridlength = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName.length - 1;
                        for (var r = 0; r < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[q].lstInputGridData.length; r++) {
                            if (BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[q].lstInputGridData[r].iProductId == iInputProductid) {
                                var Processingqty = parseFloat(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[q].lstInputGridData[r].dProcessQuantity);
                                chkProcessQty = parseFloat(chkProcessQty) + Processingqty;
                                chkProcessQty = parseFloat(chkProcessQty).toFixed(BOM_PROCESS.NoofDecimals);
                            }
                        }
                        if (q == inputgridlength) {
                            if (dActualQuantity != chkProcessQty) {
                                if (bBiProduct == true || bBiProduct == "true" || bBiProduct == "True") {
                                    for (var s = 0; s < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName.length; s++) {
                                        for (var r = 0; r < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[s].lstOutputGridData.length; r++) {
                                            var iOutputProductid = parseFloat(BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[s].lstOutputGridData[r].iProductId);
                                            var iType = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[s].lstOutputGridData[r].iType;
                                            if (iInputProductid == iOutputProductid) {
                                                if (iType == 1) {
                                                    COMMON.prototype.showMessage("Qunatity Invalid of Intermediate Product", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                                                    return false;
                                                }
                                                else if (iType == 2) {
                                                    // continue
                                                }
                                            }
                                        }
                                    }
                                }                               
                                else {
                                    COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.MRP_BOMP_msgQuantityInvalidated + " of this Product: " + sInputProductCode, BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                                    return false;
                                }
                            }                           
                        }
                    }
                }
            }
            return true;
        }
        catch (e) {
            alert("Exception: BOM_PROCESS.ChkQuantityAllProduct " + e.message);
        }
    },
