    // Split On Hold Click From Plan
    // Sum Of Adjusted Quantiy Should be equal to To Total Quantity
    // Create and Check Schedule
    // then after hide and unhide the Required controls
    SplitOnHoldClickFromPlan: function () {
        var element = document.getElementById("lbldQuantity");
        var quantity = parseFloat(element.innerText);
        var adjQty = 0;
        for (var i = 0; i < MRPProductionOrderDetails.arrSplitSchedule.length; i++) {
            if (MRPProductionOrderDetails.arrSplitSchedule[i].bSelect = true) {
                adjQty += MRPProductionOrderDetails.arrSplitSchedule[i].dAdjustedQty;
            }
        }
        if (adjQty != quantity) {
            //COMMON.prototype.showMessage("Adjusted Quantity Should be equal to Total Quantity", "Manual Scheduling");
            COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgAdjustedQuantityShouldBeEqualToTotalQuantity, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgManualScheduling);
            return;
        }
        var Routing = element.dataset.irouting;
        var StartDateTime = element.dataset.istartdatetime;
        var bodyid = element.dataset.ibodyid;
        var prodOrderno = element.dataset.sprodorderno;
        var process = element.dataset.processname;
        var productname = element.dataset.sproductname;
        var productcode = element.dataset.sproductcode;
        var sduedate = element.dataset.duedate;
        var SplitPlanScheduleDataToHold = null;
        if (document.getElementById("PanelbodyManualSchedulingDiv") != null) {
            SplitPlanScheduleDataToHold = MRPMANUALSCHEDULING.objPlanScheduleData;
        }
        var url = "";
        if (window.GlobalPref.Version == eVersion.Version10) {
            url = GLOBAL.getContextPath("CheckSchedule", "MRPPoductionHierarchy", "MRP");
        } else {
            url = GLOBAL.getContextPath("CheckSchedule", "ManualScheduling", "MRP");
        }
        var selectMastersResult = NETWORK.executeServerMethod(url, true, {
            iRoutingId: Routing,
            iStartDateTime: StartDateTime,
            arrAllocations: null,
            sProcessName: process,
            DueDate: sduedate,
            sProdOrderNo: prodOrderno,
            sProductName: productname,
            sProductCode: productcode,
            iNodeBodyId: bodyid,
            arrSplitSchedule: MRPProductionOrderDetails.arrSplitSchedule,
            lstSelectedPlanScheduleData: MRPProductionOrderDetails.lstSelectedPlanScheduleData,
            bFromOthers: true,
            SplitPlanScheduleDataToHold: SplitPlanScheduleDataToHold,
            lstSplitPlanScheduleDataOnHold: MRPProductionOrderDetails.lstSplitPlanScheduleDataOnHold,
        }, "HTML", false);
        if (selectMastersResult.data != null && selectMastersResult.data != undefined) {
            var data = selectMastersResult.data;
            id = "FirstManualSchedulingDiv_" + MRPProductionOrderDetails.CurrentNode;

            if (document.getElementById(id) != null) {
                id = "#" + id;
                $(id).html(data);
                // document.getElementById(id).innerHTML = data;
            }
            else {
                var div = document.createElement("div");
                div.id = id;
                document.getElementById("MS_PlanSchBody_body").appendChild(div);
                id = "#" + id;
                $(id).html(data);
            }
            id = "FirstManualSchedulingDiv_" + (MRPProductionOrderDetails.CurrentNode);
            if (document.getElementById(id) != null) {
                var elms = document.getElementById(id).getElementsByTagName("table");
                elms[0].style.pointerEvents = "none";
                var tbody = elms[0].children[0];
                var NoOfRows = tbody.children.length;
                for (var i = 2; i < NoOfRows; i++) {
                    var Element = tbody.children[i].children[6].children[0];
                    Element.checked = true;
                }
            }
            MRPProductionOrderDetails.lstManualSchedulingData = MRPProductionOrderDetails.lstSplitPlanScheduleData;
            var iCurrentNode = MRPProductionOrderDetails.CurrentNode;
            MRPProductionOrderDetails.lstSelectedPlanScheduleData[iCurrentNode] = MRPProductionOrderDetails.lstSplitPlanScheduleData;
            MRPProductionOrderDetails.lstPlanScheduleDataOnHold[iCurrentNode] = MRPProductionOrderDetails.lstSplitPlanScheduleDataOnHold;

            document.getElementById("MS_PlanSchBody").style.display = "";
            document.getElementById("MS_ChangeSchBody").style.display = "none";
            document.getElementById("MS_MainBody").style.display = "none";
            document.getElementById("MS_SplitSchBody").style.display = "none";

            document.getElementById("MS_PlanSchClose").style.display = "";
            document.getElementById("MS_MainClose").style.display = "none";
            document.getElementById("MS_ChangeSchSave").style.display = "none";
            document.getElementById("MS_ChangeSchChange").style.display = "none";
            document.getElementById("MS_ChangeSchCancel").style.display = "none";
            document.getElementById("MS_SplitSchClose").style.display = "none";

            document.getElementById("btnSplit").style.display = "none";
            ////if (!MRPProductionOrderDetails.bIncludeMoldInCapacityOrMachinePlanning) {
            ////    document.getElementById("btnSplit").style.display = "none";
            ////}
            var objRoutingHeader = MRPProductionOrderDetails.objRoutingHeader;
            if (MRPProductionOrderDetails.CurrentNode >= objRoutingHeader.arrRoutingNodes.length - 1) {
                document.getElementById("btnNext").style.display = "none";
                document.getElementById("btnSave").style.display = "";
                //MRPProductionOrderDetails.CurrentNode = MRPProductionOrderDetails.CurrentNode + 1;
            }
            else {
                document.getElementById("btnSave").style.display = "none";
                document.getElementById("btnNext").style.display = "";
                //MRPProductionOrderDetails.CurrentNode = MRPProductionOrderDetails.CurrentNode + 1;
            }
        }
