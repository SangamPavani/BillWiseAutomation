            iItem = ObjCell.CellData.value;
            if (bItemWise == false) {
                iItem = 0;
            }

            objGlobal = GLOBAL.getGlobalValue();
            if (bIncrement == true) {
                arrBatch = null;
                for (iCounter = 0; iCounter < EditRECEIPTFROMJOBWORKER.BatchUsedList.length; iCounter++) {
                    if (EditRECEIPTFROMJOBWORKER.BatchUsedList[iCounter].ID == iItem) {
                        arrBatch = EditRECEIPTFROMJOBWORKER.BatchUsedList[iCounter].Tag;
                        break;
                    }
                }
                if (iCounter < EditRECEIPTFROMJOBWORKER.BatchUsedList.length) {
                    sPre = arrBatch[0].substr(0, FConvert.toInt(arrBatch[1]));
                    iStart = FConvert.toInt(arrBatch[1]) + FConvert.toInt(arrBatch[2]);
                    if (arrBatchSeries[arrBatchSeries.length - 1].Type == 6) {
                        sPost = "";
                    }
                    else {
                        if (iStart < arrBatch[0].length) {
                            sPost = arrBatch[0].substr(iStart, arrBatch[0].length - iStart);
                        }
                        else {
                            sPost = "";
                        }
                    }

                    if (arrBatchSeries[arrBatchSeries.length - 1].Type == 6) {
                        sIncr = arrBatch[0].substr(FConvert.toInt(arrBatch[1]), arrBatch[0].length - FConvert.toInt(arrBatch[1]));
                    }
                    else {
                        sIncr = arrBatch[0].substr(FConvert.toInt(arrBatch[1]), FConvert.toInt(arrBatch[2]));
                    }

                    sIncr = FConvert.getNextNo(sIncr);
                    arrBatch[0] = sPre + sIncr + sPost;
                    EditRECEIPTFROMJOBWORKER.BatchUsedList[iCounter].Tag = arrBatch;

                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    if (FCommon.UI.isValidObject(element) == true) {
                        cellobj.setCellText(arrBatch[0]);
                    }

                    return;
                }

                sTemp = "";
                arrBatchData = [];
                for (iCounter = 0; iCounter < arrBatchSeries.length; iCounter++) {
                    sTemp = "";
                    switch (arrBatchSeries[iCounter].Type) {
                        case 0: // Login
                            if (FConvert.toInt(arrBatchSeries[iCounter].FieldValue) == 0) {
                                sTemp = objGlobal.UserName;
                            }
                            else {
                                sTemp = objGlobal.UserName; // GlobalPref.LoginAbbr;
                            }
                            break;
                        case 1: // Vendor
                            //if (tranEntryGlobal.FieldHelper.Area.Book == FieldArea.get("HEADER")) {
                            //    if (FConvert.toInt(arrBatchSeries[iCounter].FieldValue) == 0) {
                            //        sTemp = TRANSACTION_ENTRY.FIELDS.getBookValue(0, "sname").data;
                            //    }
                            //    else {
                            //        sTemp = TRANSACTION_ENTRY.FIELDS.getBookValue(0, "scode").data;
                            //    }
                            //}
                            break;
                        case 2: // Product
                            if (FConvert.toInt(arrBatchSeries[i].FieldValue) == 0) {
                                var ObjCell = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", cellobj.iRow, 4);
                                sTemp = ObjCell.sText;
                            }
                            else {
                                var rowEle = FGRIDCONTROL.getCellObject("Id_EditReceiptToJobWorker_Grid", cellobj.iRow);
                                sCode = FGRIDCONTROL.getCellData(rowEle, "scode", OBJD[2].scode);
                                if (FCommon.String.isNullOrEmpty(sCode)) {
                                    sTemp = sCode
                                }
                            }
                            break;
                        case 3: // Char Input
                            switch (FConvert.toInt(arrBatchSeries[iCounter].FieldValue)) {
                                case 0:
                                    sTemp = "/";
                                    break;
                                case 1:
                                    sTemp = "-";
                                    break;
                                case 2:
                                    sTemp = "*";
                                    break;
                                case 3:
                                    sTemp = "*";
                                    break;
                                default:
                                    sTemp = " ";
                                    break;
                            }
                            break;
                        case 5: // INput
                            sTemp = arrBatchSeries[iCounter].FieldValue;
                            break;
                        case 4: // Date
                            var dtdate = DATEPICKER.getDate('fDatePicker_DocumentDate')
                            switch (FConvert.toInt(arrBatchSeries[iCounter].FieldValue)) {
                                case 0: // Day
                                    sTemp = FConvert.toString(DATE.prototype.getDayFromFocusDate(dtdate));
                                    break;
                                case 1: // Month Name
                                    sTemp = DATEPICKER.getSelectedMonthName(dtdate);
                                    break;
                                case 2: // Year
                                    sTemp = FConvert.toString(DATE.prototype.getYearFromFocusDate(dtdate));
                                    break;
                                case 3: // Month
                                    sTemp = FConvert.toString(DATE.prototype.getMonthFromFocusDate(dtdate));
                                    break;
                            }
                            break;
                        case 7: // Doc No
                            sTemp = OPTIONCONTROL.getControlText("FOption_ProductionOrder");//As per KSR
                            break;
                        case 8: // Time
                            break;
                        case 9: // Voucher abbr
                            sTemp = "";//tranEntryGlobal.EntryModel.Settings.Misc.Abbr;//As per KSR
                            break;
                        case 10: // MRP
                            break;
                        case 11: // Row Id
                            sBatch += FConvert.toString(cellobj.iRow);
                            break;
                    }

                    objIdNamePair = FocusDataStructs.getIdNamePairObject();
                    objIdNamePair.ID = arrBatchSeries[iCounter].Type;
                    objIdNamePair.Name = sTemp;
                    objIdNamePair.Tag = arrBatchSeries[iCounter].FieldValue;
                    arrBatchData.push(objIdNamePair);
                }

                TRANSACTION_ENTRY.SERVER.getNewBatchNo(arrBatchSeries, arrBatchData, true, cellobj);
            }
            else {
                sBatch = "";
                sTemp = "";
                for (iCounter = 0; iCounter < arrBatchSeries.length; iCounter++) {
                    switch (arrBatchSeries[iCounter].Type) {
                        case 0: // Login
                            if (FConvert.toInt(arrBatchSeries[iCounter].FieldValue) == 0) {
                                sTemp = objGlobal.UserName;
                            }
                            else {
                                sTemp = objGlobal.UserName; // GlobalPref.LoginAbbr;
                            }
