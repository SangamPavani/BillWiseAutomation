    onStandardValueChange: function (objCell, event) {
        try {
            if (objCell.bLeave == true) {

                if (objCell.iColumn == 2) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (element.value.trim() != "") {
                        //objCell.setCellText(parseFloat(element.value.trim()).toFixed(ROUTING.GlobalNoofDecimalsInQuantity));
                        objCell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(element.value.trim(), ROUTING.GlobalNoofDecimalsInQuantity)));
                        objCell.setCellData("value", parseFloat(element.value.trim()));
                    }
                }
                else {
                    objCell.processDefault(event);
                }
            }
            else {
                if (objCell.iColumn == 2) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    element.dataset.rowno = objCell.iRow;
                    element.dataset.columnno = objCell.iColumn;
                    objCell.setControl(element, objCell.getCellData("value"));
                }
                else {
                    objCell.processDefault(event);
                }
            }
            return (true);
        } catch (e) {
            alert("Exception {R_WORKCENTER.onStandardValueChange} : ", e.message);
        }
    },

