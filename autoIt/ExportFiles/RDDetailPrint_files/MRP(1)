                                        if (PIORDER.IsMRP2Enabled() == false && (cell.ColumnAttribute.ctrlid == "fDatePicker_ActualDueDate_PIO" || cell.ColumnAttribute.ctrlid == "txtActualProductQuantity_PIO")) {
                                            cell.setCellText(0);
                                            cell.setCellData("value", 0);
                                            break;
