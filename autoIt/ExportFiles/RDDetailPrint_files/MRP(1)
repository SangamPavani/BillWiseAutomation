    /**
     * Return View with Data of Settings 
     * @param {any} bSuccess
     * @param {any} data
     */
    LoadSettingsGridDataOnSuccess: function (bSuccess, data) {
        try {
            //debugger
            if (bSuccess && data != "") {

                var objResultProduct = {}, lstResultProduct = [];
                var objResultParam = {}, lstResultParam = [];
                var objResultVoucher = {}, lstResultVoucher = [];
                for (var m = 0; m < data.length; m++) {
                    objResultProduct = {};
                    objResultParam = {};
                    objResultVoucher = {};
                    if (data[m].ExtraInfo == '-100') {
                        objResultProduct.ID = data[m].ID;
                        objResultProduct.Name = data[m].Name;
                        objResultProduct.Tag = data[m].Tag;
                        objResultProduct.ExtraInfo = data[m].ExtraInfo;
                        lstResultProduct.push(objResultProduct);
                    }
                    else if (data[m].ExtraInfo == '-200') {
                        objResultParam.ID = data[m].ID;
                        objResultParam.Name = data[m].Name;
                        objResultParam.Tag = data[m].Tag;
                        objResultParam.ExtraInfo = data[m].ExtraInfo;
                        lstResultParam.push(objResultParam);
