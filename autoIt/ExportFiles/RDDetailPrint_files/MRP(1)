    DeleteRaiseProdOrderFromLandingGrid: function () {
        try {
            //debugger
            var arrProdOrderId = [];
            var sProdOrderNo = "";
            var sProdOrdersProcess = "";
            var sProdOrdersInProcess = "";
            var iOrderStatusvalue = 0;
            var arrBasicProdOrderNo = [];
            var sOrderStatus = "";

            var result = RAISE_PO_LANDING.GetSelectedRowCountinGridAndIndex();
            if (result.iSelectedRowCount == 0 || result.iRowIndex == 0) {
                //COMMON.prototype.showMessage("Select any Production Order", "Raise Production Order"); //Raise Production Order Changed to Error Message
                COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgSelectAnyProductionOrder, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
                return false;
            }
            //if (result.iSelectedRowCount > 1) {
            //    COMMON.prototype.showMessage("Select only Single Order to Delete", "Raise Production Order");
            //    return false;
            //}
            //debugger;
            //var OrderSatus = FGRIDCONTROL.getCellObject("Id_RaisePOLanding_Grid", result.iSelectedRowCount, 11);
            //if (OrderSatus.getCellData() >= 2) {
            //    COMMON.prototype.showMessage("Released Production Orders, can not be deleted.", "Error Message");
            //    return;
            //}
            var rowCount = FGRIDCONTROL.getTotalRows("Id_RaisePOLanding_Grid");
            for (var rowindex = 1; rowindex <= rowCount; rowindex++) {
                var GridRdata = FGRIDCONTROL.getRowValue("Id_RaisePOLanding_Grid", rowindex);
                if (FGRIDCONTROL.getColumnCheckboxState("Id_RaisePOLanding_Grid", rowindex, 1) == true) {
                    var urlPath = GLOBAL.getContextPath("GetProductionOrderStatus", "RaiseProductionOrders", "MRP");
                    var OrderStatusdata = NETWORK.executeServerMethod(urlPath, true, { arrProductionOrders: [GridRdata[1].Data.value] }, "", false);
                    var bFound = false;
                    if (OrderStatusdata.data.length > 1) {
                        for (var s = 0; s < OrderStatusdata.data.length; s++) {
                            var iStatus = OrderStatusdata.data[s].ID;
                            if (parseInt(iStatus) >= 3) {
                                bFound = true;
                                sProdOrdersInProcess += OrderStatusdata.data[s].Name + ",";
                                //break;
                            }
                        }
                        if (bFound) {
                            sProdOrdersProcess += GridRdata[2].Data.value + ",";
                        }
                    }
                    if (!bFound) {
                        iOrderStatusvalue = OrderStatusdata.data[0].ID;
                        if (parseInt(iOrderStatusvalue) < 3) {
                            arrProdOrderId.push(GridRdata[1].Data.value);
                            sProdOrderNo += GridRdata[2].Data.value + ", ";
                            iOrderStatusvalue: iOrderStatusvalue;
                            arrBasicProdOrderNo.push(GridRdata[2].Data.value);
                        }
                        else {
                            sProdOrdersProcess += GridRdata[2].Data.value + ",";
                        }
                    }
                }
            }
            //debugger
            if (iOrderStatusvalue == 2) {
                sOrderStatus = RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_RPO_cmbReleasedProductionOrder; //"Released Order";
            }
            else if (iOrderStatusvalue == 3) {
                sOrderStatus = RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_RPO_cmbWorkinProgress;//"Work In Progress";
            }
            else if (iOrderStatusvalue == 4) {
                sOrderStatus = RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_RPO_cmbFinished;//"Finished";
            }
            else if (iOrderStatusvalue == 6) {
                sOrderStatus = RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_RPO_cmbClosed;//"Closed";
            }
            if (sProdOrdersProcess != null && sProdOrdersProcess != "") {
                if (sProdOrderNo != null && sProdOrderNo != "") {
                    RAISE_PO_LANDING.arrRaiseProdOrder_DeletingId = arrProdOrderId;
                    RAISE_PO_LANDING.arrBasicProductionOrderNOs = arrBasicProdOrderNo;
                    document.getElementById("lblWarnMessage_Modal_LandingRaisePO").textContent = sProdOrdersProcess.substring(0, sProdOrdersProcess.lastIndexOf(',')) +
                         //" Orders in Process cannot delete.. Do you want to delete the Selected  Record(s): " + sProdOrderNo.substring(0, sProdOrderNo.lastIndexOf(',')) + " ?";
                         " " + RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgOrdersInProcessCannotDeleteDoYoyWantToDelteTheSelectedRecords + ": " + sProdOrderNo.substring(0, sProdOrderNo.lastIndexOf(',')) + " ?";
                    $("#DeleteRecord_Modal_LandingRaisePO").modal("show");
                }
                else {
                    if (sProdOrdersInProcess != null && sProdOrdersInProcess != "") {
                        COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgCannotDeleteProductionOrder + ", " + sProdOrdersProcess.substring(0, sProdOrdersProcess.lastIndexOf(','))
                       + " " + " , Due to  Production Order(s) " + sProdOrdersInProcess.substring(0, sProdOrdersInProcess.lastIndexOf(',')) +  RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgAlreadyReleased, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
                    }
                    else {

                        COMMON.prototype.showMessage(RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.MRP_PO_msgCannotDeleteProductionOrder + ", " + sProdOrdersProcess.substring(0, sProdOrdersProcess.lastIndexOf(','))
                        + " " + sOrderStatus, RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.lblErrorMsg);
                    }
                    return;
                }
            }
            else {
                if (sProdOrderNo != null && sProdOrderNo != "") {
                    RAISE_PO_LANDING.arrRaiseProdOrder_DeletingId = arrProdOrderId;
                    RAISE_PO_LANDING.arrBasicProductionOrderNOs = arrBasicProdOrderNo;
                    document.getElementById("lblWarnMessage_Modal_LandingRaisePO").textContent = //"Do you want to delete the Selected  Record(s): " + sProdOrderNo.substring(0, sProdOrderNo.lastIndexOf(',')) + " ?";
                      RAISE_PO_LANDING.RAISE_PO_LANDINGMsgs.QC_TD_msgDoYoyWantToDeleteSelectedRecords + " " + sProdOrderNo.substring(0, sProdOrderNo.lastIndexOf(',')) + " ?";
                    $("#DeleteRecord_Modal_LandingRaisePO").modal("show");
                }
            }
        }
        catch (e) {
            alert("Exception: " + e.message);
        }
    },
