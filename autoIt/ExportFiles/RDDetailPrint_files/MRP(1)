        var expandiconclass = (window.GlobalPref.Version == eVersion.Version10) ? "icon-new" : "icon-expand";
        if ($(ele).hasClass("icon-collepse")) {
            for (var i = 0; i < allTr.length; i++) {
                if (i > ele.parentElement.parentElement.sectionRowIndex) {
                    var tdchild = allTr[i].children[5].children[0];
                    if (tdchild.dataset.parentid == ele.dataset.parentid) {
                        break;
                    }
                    else if (tdchild.dataset.iProductlevel <= ele.dataset.iProductlevel) {
                        break;
                    }
                    else {
                        if ($(tdchild).hasClass("icon-collepse")) {
                            $(tdchild).removeClass("icon-collepse").addClass(expandiconclass);
                        }
                        $(allTr[i]).hide();
                    }
                }
            }
            $(ele).removeClass("icon-collepse").addClass(expandiconclass);
        }
        else {
            for (var i = 0; i < allTr.length; i++) {
                if (i > ele.parentElement.parentElement.sectionRowIndex) {
                    var tdchild = allTr[i].children[5].children[0];
                    if (tdchild.dataset.parentid == ele.dataset.parentid) {
