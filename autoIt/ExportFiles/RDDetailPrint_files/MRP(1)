                    if (bIsplanneddata == true || bIsplanneddata == "true") {
                        //COMMON.prototype.showMessage("Already planned Order you can't update Product", "PIO");
                        COMMON.prototype.showMessage(PIORDER.PIORDERMsgs.MRP_PIO_msgAlreadyPlannedOrderYouCantUpdateProduct, PIORDER.PIORDERMsgs.MRP_PIO_msgPIO);
                    }
                    else {
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                    }
                }
                else if (objCell.ColumnAttribute.ctrldbl == "ExtraTags") {
                    if (objCell.iRow > 1) {
                        var CurrentValue = isNaN(parseInt(objCell.getCellData("value"))) ? 0 : parseInt(objCell.getCellData("value"));
                        if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
