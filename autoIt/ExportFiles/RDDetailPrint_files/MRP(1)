    // Add Safety Stock quantity to Sub Materials(Products) for Raise Order and Apply safety stock
    AddSafetyStockForSubMaterial: function (PdrParentId, Qty) {
        try {
            for (var i = 0; i < MRP_PROCESS.arrMRPProcessingDetail.length; i++) {
                if (MRP_PROCESS.arrMRPProcessingDetail[i].iPDRParentID == PdrParentId) {
                    MRP_PROCESS.arrMRPProcessingDetail[i].dRatio = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dQuantityPerPiece);//.toFixed(MRP_PROCESS.iDecimalInQuantity) / Qty;

                    var dSafetyStock = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStock).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var dMax = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dMaxOrderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var dMin = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dMinOrderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var dReorderPt = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dReordePoint).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var dReorderQty = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dReorderQty).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var dMaxInventory = parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dMaxInventory).toFixed(MRP_PROCESS.iDecimalInQuantity);
                    var iReOrderPolicy;
                    if (MRP_PROCESS.arrMRPProcessingDetail[i].sReplenishmentTypeName == "Purchase") {
                        if (MRP_PROCESS.bRDR == true) {
                            iReOrderPolicy = (document.getElementById("rdoRaiseSingleOrderForQty_MRPProcessing").checked == true) ? 0 : parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iReorderPolicy);
                        }
                        else
                            iReOrderPolicy = parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iReorderPolicy);
                    }
                    else
                        iReOrderPolicy = parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iReorderPolicy);

                    if (iReOrderPolicy == 0) {
                        MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                    }
                    else if (iReOrderPolicy == 1) {
                        MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = ((dMax == 0) || (dReorderQty == 0)) ? 0 : dSafetyStock;
                    }
                    else if (iReOrderPolicy == 2) {
                        if ((dMax == 0) || (dMin == 0)) {
                            MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                        }
                        else {
                            if ((dMaxInventory > dSafetyStock) || (dMaxInventory > dReorderPt)) {
                                MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dMaxInventory;
                            }
                            else if ((dSafetyStock > dMaxInventory) || (dSafetyStock > dReorderPt)) {
                                MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dSafetyStock;
                            }
                            else if ((dReorderPt > dMaxInventory) || (dReorderPt > dSafetyStock)) {
                                MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = dReorderPt;
                            }
                        }
                    }
                    else if (iReOrderPolicy == 3) {
                        MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = 0;
                    }
                    else if (iReOrderPolicy == 4) {
                        MRP_PROCESS.arrMRPProcessingDetail[i].dSafetyStockQty = ((dMax == 0) || (dMin == 0)) ? 0 : dSafetyStock;
                    }

                    MRP_PROCESS.AddSafetyStockForSubMaterial(parseInt(MRP_PROCESS.arrMRPProcessingDetail[i].iPDRChildID), parseFloat(MRP_PROCESS.arrMRPProcessingDetail[i].dQuantityPerPiece).toFixed(MRP_PROCESS.iDecimalInQuantity));
                }
            }
        } catch (e) {
            alert("Exception: {MRP_PROCESS.AddSafetyStockForSubMaterial} " + e.message);
        }
    },

