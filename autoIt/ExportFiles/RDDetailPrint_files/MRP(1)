    TextValidation: function (e, DecimalsInQuantity) {
        try {
            //debugger
            var FieldValue = document.getElementById("ddlFieldType").value;
            var DefaultValue = document.getElementById("txtDefaultValue").value;
            var sFormulaCheckBox = document.getElementById("IsDefaultFormulaCheckBox");
            if ((FieldValue == MasterDataTypeEnum.Text || FieldValue == MasterDataTypeEnum.Fraction || FieldValue == MasterDataTypeEnum.Number || FieldValue == MasterDataTypeEnum.StringList) && sFormulaCheckBox.checked == true) {
                return;
            }
            //For selection
            if (FieldValue == MasterDataTypeEnum.StringList) {
                var DefaultValue = document.getElementById("txtDefaultValueNew").value;
                if (e.shiftKey == true) {
                    return;
                }
                if (DefaultValue.charAt(0) === "&") {
                    if (e.keyCode > 65 && e.keyCode < 90 || e.keyCode < 48 || e.keyCode > 57)
                        return;
                    else
                        e.preventDefault();
                }
                else {
                    e.preventDefault();
                }
            }
            //For MasterType
            if (FieldValue == MasterDataTypeEnum.Master) {
                var DefaultValue = document.getElementById("txtDefaultValueNew").value;
                if (e.shiftKey == true) {
                    return;
                }
                if (DefaultValue.charAt(0) === "&") {
                    if (e.keyCode > 65 && e.keyCode < 90 || e.keyCode < 48 || e.keyCode > 57) 
                        return;
                     else 
                        e.preventDefault();
                }
                else {
                    e.preventDefault();
                }
            }
            if (e.shiftKey == true && (FieldValue == MasterDataTypeEnum.Number || FieldValue == MasterDataTypeEnum.Fraction)) {
                return;
            }
            if ((FieldValue == MasterDataTypeEnum.Number || FieldValue == MasterDataTypeEnum.Fraction) && DefaultValue.charAt(0) === "&") {
                if (e.keyCode > 65 && e.keyCode < 90) {
                    return;
                }
            }
            if (e.keyCode == 188) {
                e.preventDefault();
            }

            if (FieldValue == MasterDataTypeEnum.Text) { // Text
                return;
            } else if (FieldValue == MasterDataTypeEnum.Fraction) { // Fraction

                var length = e.currentTarget.value.length;
                var Index = e.currentTarget.value.indexOf('.');
                if (e.keyCode == 110) {
                    if (Index === -1) {
                        return;
                    } else {
                        e.preventDefault();
                    }
                }

                if (Index > -1) {
                    var CharAfterdot = (length) - Index;
                    if (CharAfterdot > DecimalsInQuantity) {
                        if (e.keyCode == 8 || e.keyCode == 9) {
                            return;
                        }
                        else {
                            e.preventDefault();
                        }
                    }
                }
                // Allow: backspace, delete, tab, escape, enter and .
                if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
                    // Allow: Ctrl+A, Command+A
                    (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                    // Allow: home, end, left, right, down, up
                    (e.keyCode >= 35 && e.keyCode <= 40)) {
                    // let it happen, don't do anything
                    return;
                }
                // Ensure that it is a number and stop the keypress
                if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                    e.preventDefault();
                }
            } else if (FieldValue == MasterDataTypeEnum.Number) { //Number
                if (e.keyCode == 110) {
                    e.preventDefault();
                }
                // Allow: backspace, delete, tab, escape, enter and .
                if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
                    // Allow: Ctrl+A, Command+A
                    (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                    // Allow: home, end, left, right, down, up
                    (e.keyCode >= 35 && e.keyCode <= 40)) {
                    // let it happen, don't do anything
                    return;
                }
                // Ensure that it is a number and stop the keypress
                if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                    e.preventDefault();
                }
            }


        } catch (err) {
            COMMON.prototype.showMessage("Exception: {Customize.TextValidation} " + err.message, "Exception");
        }
    },

