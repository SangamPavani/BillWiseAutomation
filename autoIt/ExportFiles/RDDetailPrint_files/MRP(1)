    // Failed Body Grid cell change events
    onQuantityBreakupGridCellChange: function (cellobj, event) {
        try {
            //debugger
            var GridID = "Id_QunatityBreakupDetail_Grid";
            var rowCount = FGRIDCONTROL.getTotalRows(GridID);
            if (document.getElementById("btnsave").style.display != "none") {    
                if (cellobj.bLeave == true) {     // On Leave Event
                    switch (cellobj.ColumnAttribute.ctrlatt.trim()) {

                        case "Reasons":
                            data = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);

                            if (QuantityBreakup.arrReasons.length > 0) {
                                for (var i = 0; i < QuantityBreakup.arrReasons.length; i++) {
                                    if (cellobj.iRow != i + 1) {
                                        if (QuantityBreakup.arrReasons[i] == parseInt(data.iMasterId)) {
                                            COMMON.prototype.showMessage("This Reason Already Added", QuantityBreakup.QuantityBreakupMsgs.lblErrorMsg);
                                            return false;
                                        }
                                    }
                                }
                            }

                            QuantityBreakup.arrReasons[cellobj.iRow - 1] = (parseInt(data.iMasterId));
                            cellobj.setCellData("value", parseInt(data.iMasterId));
                            cellobj.setCellText(data.sName);

                            QuantityBreakup.lstQuantityBreakUpQuantities[cellobj.iRow - 1].iStandardReson = parseInt(data.iMasterId);



                            if (rowCount == cellobj.iRow) {
                                FGRIDCONTROL.insertRows(GridID, cellobj.iRow + 1, 1);
                                var obj = {
                                    bPassed: false,
                                    iStandardReson: 0,
                                    dQSplityQuantity: 0,
                                    arrRMA: [],
                                    sRMA: "",
                                    iFailedWarehouse: 0
                                };

                                QuantityBreakup.lstQuantityBreakUpQuantities.push(obj);
                            }

                            break;
                        case "Quantity":
                            var Quantity = parseFloat(document.getElementById(cellobj.ColumnAttribute.ctrlid).value).toFixed(QuantityBreakup.NoOfDecimals);


                            QuantityBreakup.arrQuanties[cellobj.iRow - 1] = Quantity;
                            var arrQuantity = QuantityBreakup.arrQuanties;
                            var totalQunatity = 0;
                            for (var i = 0; i < arrQuantity.length; i++) {
                                totalQunatity = totalQunatity + parseFloat(arrQuantity[i]);
                            }
                            var QuantityFailed = parseFloat(document.getElementById("txtQtyFailed").value).toFixed(QuantityBreakup.NoOfDecimals);
                            if (totalQunatity > QuantityFailed) {
                                Quantity = 0;
                                QuantityBreakup.arrQuanties[cellobj.iRow - 1] = Quantity;
                                COMMON.prototype.showMessage("Quantity Should not be greater than Failed Quantity", QuantityBreakup.QuantityBreakupMsgs.QC_QB_msgQuantityBreakUp);
                            }
                            cellobj.setCellData("value", Quantity);
                            //cellobj.setCellText(Quantity);
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(Quantity, QuantityBreakup.NoOfDecimals)));
                            QuantityBreakup.lstQuantityBreakUpQuantities[cellobj.iRow - 1].dQSplityQuantity = parseInt(Quantity);

                            var dTotalQty = 0;
                            for (var i = 0; i < QuantityBreakup.lstQuantityBreakUpQuantities.length - 1; i++) {
                                if (QuantityBreakup.lstQuantityBreakUpQuantities[i].bPassed == false) {
                                    var dQuantity = QuantityBreakup.lstQuantityBreakUpQuantities[i].dQSplityQuantity;
                                    var arr = QuantityBreakup.FailedPieceNos;
                                    var arr2 = arr.slice(dTotalQty, (dTotalQty + dQuantity));
                                    QuantityBreakup.lstQuantityBreakUpQuantities[cellobj.iRow - 1].sRMA = arr2.join(',');
                                    QuantityBreakup.lstQuantityBreakUpQuantities[cellobj.iRow - 1].arrRMA = arr2;
                                    dTotalQty = dTotalQty + dQuantity;
                                }
                            }

                            break;
                        case "FailedWareHouse":
                            data = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);

                            cellobj.setCellData("value", parseInt(data.iMasterId));
                            cellobj.setCellText(data.sName);
                            QuantityBreakup.lstQuantityBreakUpQuantities[cellobj.iRow - 1].iFailedWarehouse = parseInt(data.iMasterId);
                            break;
                        default:
                            if (cellobj.ColumnAttribute.ctrlatt == "tagfield") {
                                data = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                cellobj.setCellData("value", parseInt(data.iMasterId));
                                cellobj.setCellText(data.sName);
                            } else if (cellobj.ColumnAttribute.ctrlatt == "Extrafield") {
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                if (element != null) {
                                    if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                                        if (COMMON.prototype.isValidObject(element.selectedOptions[0])) {
                                            cellobj.setCellText(element.selectedOptions[0].innerText, element.value);
                                        } else {
                                            cellobj.setCellText("", "");
                                        }
                                    } else if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.Date) {
                                        cellobj.setCellData("value", DATEPICKER.getDate(cellobj.ColumnAttribute.ctrlid));
                                        cellobj.setCellText(DATEPICKER.getText(cellobj.ColumnAttribute.ctrlid));
                                    } else if (cellobj.ColumnAttribute.datatypeid == MasterDataTypeEnum.Master) {
                                        cellobj.setCellData("value", OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));
                                        cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                                    }
                                    else {
                                        cellobj.setCellText(element.value, element.value);
                                    }

                                }
                            }
                            else {
                                cellobj.processDefault(event);
                            }
                            break;
                    }
                }
                else {      // On Enter Event                            
                    switch (cellobj.ColumnAttribute.ctrlatt.trim()) {
                        case "Reasons":
                            cellobj.setCellText("");
                            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setControl(element)
                            iValue = 0;
                            if (COMMON.prototype.isInteger(cellobj.CellData.value) == true) {
                                iValue = parseInt(cellobj.getCellData("value"));
                            }
                            if (iValue <= 0) {
                                OPTIONCONTROL.clear(element);
                            }
                            else {
                                OPTIONCONTROL.setControlValue(element, iValue);
                            }
                            break;
                        case "Quantity":
                            //cellobj.processDefault(event);

                            cellobj.setCellText("");
                            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setControl(element);
                            if (cellobj.CellData.value != null || cellobj.CellData.value != undefined) {
                                element.value = cellobj.getCellData("value");
                            }
                            break;
                        case "FailedWareHouse":
                            //cellobj.processDefault(event);

                            cellobj.setCellText("");
                            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setControl(element)
                            iValue = 0;
                            if (COMMON.prototype.isInteger(cellobj.CellData.value) == true) {
                                iValue = parseInt(cellobj.getCellData("value"));
                            }
                            if (iValue <= 0) {
                                OPTIONCONTROL.clear(element);
                            }
                            else {
                                OPTIONCONTROL.setControlValue(element, iValue);
                            }
                            break;
                        default:
                            if (cellobj.ColumnAttribute.ctrlatt == "tagfield") {
                                if (cellobj.iRow > 1) {
                                    var CurrentValue = isNaN(parseInt(cellobj.getCellData("value"))) ? 0 : parseInt(cellobj.getCellData("value"));
                                    if ((CurrentValue != null || CurrentValue != "") && CurrentValue <= 0) {
                                        var PrevEle = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow - 1, cellobj.iColumn);
                                        cellobj.setCellData("value", PrevEle.getCellData("value"));
                                        cellobj.setCellText(PrevEle.getCellText("value"));
                                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                        cellobj.setControl(element, cellobj.getCellData("value"));
                                    } else {
                                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                        cellobj.setControl(element, cellobj.getCellData("value"));
                                    }
                                } else {
                                    element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                    cellobj.setControl(element, cellobj.getCellData("value"));
                                }
                            } else if (cellobj.ColumnAttribute.ctrlatt == "Extrafield") {
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                cellobj.setControl(element, cellobj.getCellData("value"));
                            } else {
                                cellobj.processDefault(event);
                            }
                            break;
                        }                
                }
            }
            return (true);


        } catch (err) {
            COMMON.prototype.showMessage("Exception: QuantityBreakup.onQuantityBreakupGridCellChange " + err.message, QuantityBreakup.QuantityBreakupMsgs.QC_TD_msgException);
        }
    },

