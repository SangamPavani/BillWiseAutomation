    SetPagingData: function (bSuccess, data) {
        debugger
        if (bSuccess && data != "") {
            if (data != null) {
                var sGridId = "Id_BOMLanding_Grid";
                FGRIDCONTROL.clearData(sGridId, true);
                var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
                if (totalRows < data.objReportMatrix.ColumnData.length) {
                    FGRIDCONTROL.insertRows(sGridId, totalRows, (data.objReportMatrix.ColumnData.length - totalRows));
                }
                else if (data.objReportMatrix.ColumnData.length < totalRows) {
                    FGRIDCONTROL.deleteRows(sGridId, (data.objReportMatrix.ColumnData.length + 1), totalRows);
                }
                var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridId);
                debugger;
                if (data.objReportMatrix.ColumnData.length != 0) {
                    for (var i = 0; i < data.objReportMatrix.ColumnData.length; i++) {
                        var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 2);
                        cell.setCellText(data.objReportMatrix.ColumnData[i].CellData[0].LongId);
                        cell.setCellData("value", data.objReportMatrix.ColumnData[i].CellData[0].LongId);

                        cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 3);
                        cell.setCellText(data.lstDocNo[i]);
                        cell.setCellData("value", data.lstDocNo[i]);
                        for (var j = 1; j < data.objReportMatrix.ColumnData[i].CellData.length; j++) {
                            cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), j + 3);
                            cell.setCellText(data.objReportMatrix.ColumnData[i].CellData[j] == null ? "" : data.objReportMatrix.ColumnData[i].CellData[j]);
                            cell.setCellData("value", data.objReportMatrix.ColumnData[i].CellData[j] == null ? "" : data.objReportMatrix.ColumnData[i].CellData[j]);
                        }
                    }
                }
                else {
                    var currentPageNo = parseInt(document.getElementById("hdnCurrentPage_BOMLanding").value);
                    currentPageNo -= 1;
                    document.getElementById("hdnCurrentPage_BOMLanding").value = currentPageNo;
                    document.getElementById("BOMLanding_pageNumber").innerHTML = currentPageNo + 1;
                    BOM_LANDING.GetPagingData(currentPageNo, false, false);
                    document.getElementById("btnNextPage_BOMLanding").className = "Fbutton disableBtnPrevNext";
                    document.getElementById("btnLastPage_BOMLanding").className = "Fbutton disableBtnPrevNext";
                }
                if (data.objReportMatrix.EndOfFile == true || data.objReportMatrix.EndOfFile == "true") {
                    document.getElementById("btnNextPage_BOMLanding").className = "Fbutton disableBtnPrevNext";
                    document.getElementById("btnLastPage_BOMLanding").className = "Fbutton disableBtnPrevNext";
                    var currentPageNos = data.objRepRecord.CurrentPage;
                    document.getElementById("hdnCurrentPage_BOMLanding").value = currentPageNos;
                    document.getElementById("BOMLanding_pageNumber").innerHTML = currentPageNos + 1;
                }
                else {
                    document.getElementById("btnNextPage_BOMLanding").className = "Fbutton theme_background-color theme_color";
                    document.getElementById("btnLastPage_BOMLanding").className = "Fbutton theme_background-color theme_color";
                }
                var cPageNo = document.getElementById("BOMLanding_pageNumber").innerHTML;
                BOM_LANDING.SetCheckBoxSelectBOM(cPageNo);
            }
        }
    },

    GetCheckBoxSelectBOM: function (pageNumber) {
        //debugger;
        var rowCount = FGRIDCONTROL.getTotalRows("Id_BOMLanding_Grid");
        var arrBOMIds = [];
        var arrVarientIds = [];
        var objCBSelect = {};
        var icount = 0;
        for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
            if (FGRIDCONTROL.getColumnCheckboxState("Id_BOMLanding_Grid", iRowIndex, 1) == true) {
                var BomID = FGRIDCONTROL.getCellObject("Id_BOMLanding_Grid", iRowIndex, 2).getCellData("value");
                var ivarientId = FGRIDCONTROL.getCellObject("Id_BOMLanding_Grid", iRowIndex, 3).getCellData("value");
                arrBOMIds.push(BomID);
                arrVarientIds.push(ivarientId);
            }
        }
        //debugger;
        objCBSelect = {
            PageNumber: pageNumber,
            SelectBOMList: arrBOMIds,
            SelectVarientList: arrVarientIds
        };
        if (BOM_LANDING.CheckBoxSelectedlst.length > 0) {
            for (var k = 0; k < BOM_LANDING.CheckBoxSelectedlst.length; k++) {               
                if (BOM_LANDING.CheckBoxSelectedlst[k].PageNumber == pageNumber) {
                    BOM_LANDING.CheckBoxSelectedlst[k].SelectBOMList = arrBOMIds;
                    BOM_LANDING.CheckBoxSelectedlst[k].SelectVarientList = arrVarientIds;
                    icount++;
                    break;
                }                               
            }
            if (icount == 0) {
                BOM_LANDING.CheckBoxSelectedlst.push(objCBSelect);
            }
        }
        else {
            BOM_LANDING.CheckBoxSelectedlst.push(objCBSelect);
        }        
    },

    SetCheckBoxSelectBOM: function (pageNumber) {
        //debugger;
        var rowCount = FGRIDCONTROL.getTotalRows("Id_BOMLanding_Grid");
        var sGridId = "Id_BOMLanding_Grid";
        if (BOM_LANDING.CheckBoxSelectedlst.length > 0) {
            for (var m = 0; m < BOM_LANDING.CheckBoxSelectedlst.length; m++) {
                if (BOM_LANDING.CheckBoxSelectedlst[m].PageNumber == pageNumber) {
                    for (var n = 0; n < BOM_LANDING.CheckBoxSelectedlst[m].SelectVarientList.length; n++) {
                        for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                            var ivarientId = FGRIDCONTROL.getCellObject("Id_BOMLanding_Grid", iRowIndex, 3).getCellData("value");
                            if (BOM_LANDING.CheckBoxSelectedlst[m].SelectVarientList[n] == ivarientId) {
                                FGRIDCONTROL.setColumnCheckboxState(sGridId, iRowIndex, 1, true);
                                break;
                            }
                        }
                    }                    
                }
            }            
        }
    },

