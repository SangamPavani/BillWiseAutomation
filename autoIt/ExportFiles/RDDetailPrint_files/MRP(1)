    CheckRequisitionTestStatus: function (objQcSampleCheckHeader) {
        //debugger;
        if (SAMPLECHECK.lstRequistionTestStatus != null) {
            if (SAMPLECHECK.lstRequistionTestStatus.length > 0) {
                if (SAMPLECHECK.lstRequistionTestStatus.length == 1 && objQcSampleCheckHeader.TestDefHeaderId == SAMPLECHECK.lstRequistionTestStatus[0].TestDefHeaderId) {
                    objQcSampleCheckHeader.bRequisitionResult = objQcSampleCheckHeader.FinalResult == 1 ? true : false;
                    //if (objQcSampleCheckHeader.bRequisitionResult) {
                    //    objQcSampleCheckHeader.bClose = true;
                    //}
                    //else {
                    //var res = confirm("Do You Want to Close Requisition?");
                    //if (res == true)
                    //    objQcSampleCheckHeader.bClose = true;
                    //else
                    //    objQcSampleCheckHeader.bClose = false;
                    //}
                    var iWarehouseIdtemp = 0;
                    for (var k = 0; k < SAMPLECHECK.lstRequistionTestStatus.length; k++) {
                        if (parseInt(SAMPLECHECK.lstRequistionTestStatus[k].TestDefHeaderId) == parseInt(objQcSampleCheckHeader.TestDefHeaderId)) {
                            if (parseInt(objQcSampleCheckHeader.FinalResult) == parseInt(1)) {
                                iWarehouseIdtemp = SAMPLECHECK.lstRequistionTestStatus[k].iPassedWarehouse;
                                document.getElementById("ddlFinalResult_Popup_SC").disabled = true;
                            }
                            else {
                                iWarehouseIdtemp = SAMPLECHECK.lstRequistionTestStatus[k].iFailedWarehouse;
                            }

                        }
                    }
                    objQcSampleCheckHeader.iWareHouseId = iWarehouseIdtemp;
                    //SAMPLECHECK.GetConfirmModal(1, "Do You Want to Close Requisition ?");
                    //debugger;
                    if ((SAMPLECHECK.bAuthorizationExists == false) || (SAMPLECHECK.bAuthorizationExists == true && SAMPLECHECK.iAuthstatus == 1)) {
                        SAMPLECHECK.GetConfirmModal(1, SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgDoYouWantToCloseRequisition);
                        SAMPLECHECK.SetSampleCheckHeaderObject(objQcSampleCheckHeader);
