                                    objHeaderExtra.bHeader = fResultData.data[b].bVoucherHeader == 1 ? true : fResultData.data[b].bVoucherHeader == 0 ? false : fResultData.data[b].IsHeader;
                                    objHeaderExtra.ExtraFieldName = fResultData.data[b].FieldName;
                                    objHeaderExtra.FieldType = fResultData.data[b].FieldType;
                                    lstHeaderExtra.push(objHeaderExtra);
                                    if (fResultData.data[b].bVoucherHeader == 0) {
                                        if (objHeaderExtra.ExtraFieldValue == null || objHeaderExtra.ExtraFieldValue == "" && fResultData.data[b].IsMandatory == true) {
                                            objHeaderExtra.ExtraFieldName = 1;
                                        }
                                        objBodyExtraFileds = {};
                                        objBodyExtraFileds.Name = objHeaderExtra.ExtraFieldName,
                                        objBodyExtraFileds.Tag = objHeaderExtra.ExtraFieldValue
                                        lstBodyExtraFileds.push(objBodyExtraFileds);
                                    }
                                }
                            }
                        }

                        var lstP = [];
                        var lstF = [];
                        for (var s = 0; s < fnResult.data.objQCTotalCheckHeader.lstQCSTotalCheckBody.length; s++) {
                            if (fnResult.data.objQCTotalCheckHeader.lstQCSTotalCheckBody[s].iResult == 1) {
                                lstP.push(fnResult.data.objQCTotalCheckHeader.lstQCSTotalCheckBody[s].sPieceNo);
                            } else if (fnResult.data.objQCTotalCheckHeader.lstQCSTotalCheckBody[s].iResult == 0) {
                                lstF.push(fnResult.data.objQCTotalCheckHeader.lstQCSTotalCheckBody[s].sPieceNo);
                            }
                        }

                        if (iFinalResult == 1) {
                            var obj = {
                                iStandardReson: 0,
                                dQSplityQuantity: fPassedQty,
                                sRMA: lstP.join(','),
                                bPassed: true,
                                iPassedWarehouse: iWareHouse,
                                arrRMA: lstP,
                                lstBodyTags: REQUISITION.arrBodyFocusTags,
                                lstBodyExtraFields: lstBodyExtraFileds
                            };

                            REQUISITION.lstQuantityBreakUpQuantities.push(obj);
                        } else if (iFinalResult == 0) {
                            var obj = {
                                iStandardReson: iFailureReason,
                                dQSplityQuantity: fFailedQty,
                                sRMA: lstF.join(','),
                                bPassed: false,
                                iPassedWarehouse: iWareHouse,
                                arrRMA: lstF,
                                lstBodyTags: REQUISITION.arrBodyFocusTags,
                                lstBodyExtraFields: lstBodyExtraFileds
                            };
                            REQUISITION.lstQuantityBreakUpQuantities.push(obj);
                        }

                    } else { // Sample Check                        
                        REQUISITION.bConsumeDuringTest = false;
                        var urlPath = REQUISITION.GetQualityControlAreaName("GetSampleCheckDetails", "SampleCheck", eVersion.Version10);
                        var fnResult = NETWORK.executeServerMethod(urlPath, true, { sDocumentNo: lstData.sQCInspectionNo, SampleCheckHeaderId: lstData.iQCInspectionId, CurrentOrPrevOrNext: 0 }, "JSON", false);

                        if (fnResult.data != null && fnResult.data != undefined) {
                            fQuantity = fnResult.data.objSampleCheck.QtyTested;
