    GetBOMAlternateProductCount: function (iPOIndex, ProductId) {
        try {
            var AlternateProdCount = 0;
            if (iPOIndex != null && iPOIndex != undefined && ProductId != null && ProductId != undefined) {
                iPOIndex = isNaN(parseInt(iPOIndex)) == true ? -1 : parseInt(iPOIndex);
                ProductId = isNaN(parseInt(ProductId)) == true ? -1 : parseInt(ProductId);
                if (iPOIndex >= 0 && ProductId > 0) {
                    for (var i = 0; i < MRP_PROCESS.arrExplodedBOM[iPOIndex].length; i++) {
                        if (MRP_PROCESS.arrExplodedBOM[iPOIndex][i].iAlternateOf == ProductId) {
                            AlternateProdCount++;
                        }
                    }
                }
            }
            return AlternateProdCount;

        } catch (e) {
            alert("Exception: {MRP_PROCESS.GetAlternateProductCount} " + e.message);
            return 0;
        }
    },

