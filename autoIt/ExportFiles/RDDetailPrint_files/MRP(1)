    OnLeaveGrid: function (cellobj, event) {
        //debugger
        try {
            if (RFSF.listOfColumns.indexOf(cellobj.ColumnAttribute.ctrlatt.trim()) == -1) {
                data = OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid);
                var stext = OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid);
                if (data == null) {
                    if (cellobj.ColumnAttribute.ctrltagvalue != undefined && cellobj.ColumnAttribute.ctrltagvalue != null) {
                        if (cellobj.ColumnAttribute.ctrltagvalue == 9 || cellobj.ColumnAttribute.ctrltagvalue == 8) {
                            var ele = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            data = ele.value;
                            stext = ele.options[ele.selectedIndex].text;
                        }

                        if (cellobj.ColumnAttribute.ctrltagvalue == 4) {
                            data = DATEPICKER.getDate(cellobj.ColumnAttribute.ctrlid);
                        }
                        if (cellobj.ColumnAttribute.ctrltagvalue == 6 || cellobj.ColumnAttribute.ctrltagvalue == 0) {
                            data = document.getElementById(cellobj.ColumnAttribute.ctrlid).value;
                        }
                    }
                    else
                        data = stext;
                } else {
                    //debugger
                    if (cellobj.ColumnAttribute.ctrlatt.trim() == "productname") {
                        RFSF.LoadProductCodeAndUnits(cellobj);
                    }
                }
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "qtytoreturn") {
                    //debugger
                    data = data == "" ? 0 : parseFloat(data);
                    if (RFSF.arrBodyData == null || RFSF.arrBodyData.length == 0)
                        return;
                    var PrevValue = parseFloat(RFSF.arrBodyData[cellobj.iRow - 1].dIssuingNow);

                    var dAlreadyReturnedQty = parseFloat(0);
                    var dTotal = dAlreadyReturnedQty + data;
                    var dIssuedQty = parseFloat(RFSF.arrBodyData[cellobj.iRow - 1].dIssuedQuantity);

                    if (dTotal > dIssuedQty) {
                        COMMON.prototype.showMessage("Quantity To Be returned Cannot be More than Issued Quantity", "Return From Shop Floor");
                        return false;
                    }

                    var ele = document.getElementById('divEntryField_container_RFSF').dataset;
                    if (data > PrevValue && (ele.batchenable == "True" || ele.batchenable == "true")) {
                        RFSF.BatchUsedList.splice(cellobj.iRow - 1, 1);
                        var cell = FGRIDCONTROL.getCellObject(cellobj.Grid.id, cellobj.iRow, cellobj.iColumn + 1);
                        cell.setCellData("value", "");
                        cell.setCellText("");
                    }
                    //if (RFSF.iReleasedQty == 0) {
                        RFSF.arrBodyData[cellobj.iRow - 1].dIssuingNow = data;
                    //}

                } else if (cellobj.ColumnAttribute.ctrlatt.trim() == "batch") {
                    data = cellobj.CellData.value;
                    stext = cellobj.sText;
                } else if (cellobj.ColumnAttribute.ctrlatt.trim() == "rma") {
                    data = cellobj.CellData.value;
                    stext = cellobj.sText;
                    RFSF.arrBodyData[cellobj.iRow - 1].RMA = stext;
                }
                else if (cellobj.ColumnAttribute.ctrlatt.trim() == "bin") {
                    data = cellobj.CellData.value;
                    stext = cellobj.sText;
                }
                if (cellobj.ColumnAttribute.ctrlcount == "12") {
                    var ele = document.getElementById('divEntryField_container_RFSF').dataset;
                    if (parseInt(cellobj.ColumnAttribute.rfsf_body_tagid) == parseInt(ele.inventorytype)) {
                        if (RFSF.arrInventory.length == cellobj.iRow && RFSF.arrInventory.length < cellobj.iRow) {
                            RFSF.arrInventory.push(data);
                        } else {
                            RFSF.arrInventory[cellobj.iRow - 1] = parseInt(data);
                        }
                        RFSF.arrBodyData[cellobj.iRow - 1].iWareHouseId = parseInt(data);
                        RFSF.GetStocks(cellobj.iRow)
                    }
                }

                if (cellobj.ColumnAttribute.ctrlatt.trim() == "qtytoreturn") {
                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(stext, RFSF.dNoOfDecimal)));
                } else {
                    cellobj.setCellText(stext);
                }
                cellobj.setCellData("value", data);
            } else {
                cellobj.processDefault();
            }
            if (cellobj.ColumnAttribute.ctrlatt.trim() == "qtytoreturn") {
                RFSF.LoadFooterData();
            }
            return true;
        } catch (e) {
            COMMON.prototype.showMessage("Exception: {RFSF.OnLeaveGrid} " + e.message, "Error Message");
        }
    },
    GetStocks: function (iRow) {
        //debugger
        var ObjData = OPTIONCONTROL.getControlDataObject('FOption_ProductionOrderNo_RFSF');
        var urlPath = GLOBAL.getContextPath("GetStock", "IssueToProduction", "MRP");
        var fnResult = NETWORK.executeServerMethod(urlPath, true, { ObjBody: RFSF.arrBodyData[iRow - 1], iOrderDueDate: ObjData.iEndDate },
            "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        if (fnResult.lValue > 0 && fnResult.data != "") {
            //debugger
            var ObjStocksStruct = fnResult.data.ObjStocksStruct;
            var sGridName = RFSF.GetGridId();
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            for (var j = 0; j < TotalColumns; j++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, iRow, j + 1);
                var cell = cellobj.ColumnAttribute.ctrlatt.trim()
                switch (cell) {
                    case "rate":
                        var dRate = ObjStocksStruct.dBuyingRate == 0 ? parseFloat(ObjStocksStruct.dAvaerageRate).toFixed(RFSF.dNoOfDecimal) : parseFloat(ObjStocksStruct.dBuyingRate).toFixed(RFSF.dNoOfDecimal);
                        if (dRate == 0)
                            dRate = 1;
                        //cellobj.setCellText(parseFloat(dRate).toFixed(RFSF.dNoOfDecimal));
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(dRate, RFSF.dNoOfDecimal)));
                        cellobj.setCellData("value", dRate);
                        RFSF.arrRowWiseStockData[iRow - 1].dBuyingRate = dRate;
                        break;
                    case "availablestock":
                        //cellobj.setCellText(parseFloat(ObjStocksStruct.dAvailableStock).toFixed(RFSF.dNoOfDecimal));
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dAvailableStock, RFSF.dNoOfDecimal)));
                        cellobj.setCellData("value", ObjStocksStruct.dAvailableStock);
                        RFSF.arrRowWiseStockData[iRow - 1].dAvailableStock = ObjStocksStruct.dAvailableStock;
                        break;
                    case "clearstock":
                        //cellobj.setCellText(parseFloat(ObjStocksStruct.dClearStock).toFixed(RFSF.dNoOfDecimal));
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dClearStock, RFSF.dNoOfDecimal)));
                        cellobj.setCellData("value", ObjStocksStruct.dClearStock);
                        RFSF.arrRowWiseStockData[iRow - 1].dClearStock = ObjStocksStruct.dClearStock;
                        break;

                    case "totalstockqty":
                        //dTotalStock
                        //cellobj.setCellText(parseFloat(ObjStocksStruct.dTotalStock).toFixed(RFSF.dNoOfDecimal));
                        cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(ObjStocksStruct.dTotalStock, RFSF.dNoOfDecimal)));
                        cellobj.setCellData("value", ObjStocksStruct.dTotalStock);
                        RFSF.arrRowWiseStockData[iRow - 1].dTotalStock = ObjStocksStruct.dTotalStock;
                        break;
                    case "issueingnow":
                        var dStock = parseFloat(RFSF.arrRowWiseStockData[cellobj.iRow - 1].dAvailableStock) + parseFloat(RFSF.arrRowWiseStockData[cellobj.iRow - 1].dClearStock);
                        var Qty = parseFloat(RFSF.arrBodyData[cellobj.iRow - 1].dTotalQuantityToIssue) - parseFloat(RFSF.arrBodyData[cellobj.iRow - 1].dIssuedQuantity);
                        if (dStock < Qty)
                            Qty = dStock;
                        if (Qty > 0) {
                            //cellobj.setCellText(parseFloat(Qty).toFixed(RFSF.dNoOfDecimal));
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(Qty, RFSF.dNoOfDecimal)));
                            cellobj.setCellData("value", Qty);
                        }
                        else {
                            cellobj.setCellText(parseFloat(0).toFixed(RFSF.dNoOfDecimal));
                            cellobj.setCellData("value", parseFloat(0).toFixed(RFSF.dNoOfDecimal));
                        }
                        //RFSF.arrBodyData[iRow - 1].dIssuedQuantity = Qty;
                        break;
                }
            }
        }
    },
