            if (data[0].arrMRPPendingPO == null || data[0].arrMRPPendingPO == undefined || data[0].arrMRPPendingPO.length == 0) {
                MRP_PROCESS.FillPlanningOrderGridTreeData(1, MRP_PROCESS.TreeFilledData[0].dPendingQty, MRP_PROCESS.GetIntDateFromLong(MRP_PROCESS.TreeFilledData[0].iOrderStartDt), bFromOtherScreen);
