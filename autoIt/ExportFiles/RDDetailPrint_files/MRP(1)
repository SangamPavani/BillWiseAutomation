                                    if (fnResult.data.objSampleCheck.lstQcSampleCheckBody[iK].bConsumeDuringTest == "true" || fnResult.data.objSampleCheck.lstQcSampleCheckBody[iK].bConsumeDuringTest == true) {
                                        REQUISITION.bConsumeDuringTest = true;
                                        break;
                                    }
                                }
                            }
                        }

                        var urlPath = REQUISITION.GetQualityControlAreaName("GetLoadExtraFieldData", "Requisition", eVersion.Version10);
                        var fResultData = NETWORK.executeServerMethod(urlPath, true, { iScreenId: MRPScreens.QCInspection }, "json", false, "");

                        if (fResultData != null && fResultData.data.length > 0 && fnResult.data.arrSampleTestHeaderExtra != null && fnResult.data.arrSampleTestHeaderExtra.length > 0) {
                            for (var b = 0; b < fResultData.data.length; b++) {
                                if (fResultData.data[b].bVoucherHeader != -1 && fResultData.data[b].bMappingQCStockTransfer == true) {
                                    objHeaderExtra = {};
                                    objHeaderExtra.ExtraFieldDefaultValue = fResultData.data[b].DefValue;
                                    objHeaderExtra.ExtraFieldIndex = b + 1;
                                    objHeaderExtra.StringValues = "";
                                    objHeaderExtra.ExtraFieldValue = fnResult.data.objSampleCheck.arrTestDefHeaderExtra[b];
                                    objHeaderExtra.iScreenId = fResultData.data[b].ScreenId;
                                    objHeaderExtra.bHeader = fResultData.data[b].bVoucherHeader == 1 ? true : fResultData.data[b].bVoucherHeader == 0 ? false : fResultData.data[b].IsHeader;
                                    objHeaderExtra.ExtraFieldName = fResultData.data[b].FieldName;
                                    objHeaderExtra.FieldType = fResultData.data[b].FieldType;
                                    lstHeaderExtra.push(objHeaderExtra);
                                    if (fResultData.data[b].bVoucherHeader == 0) {
                                        if (objHeaderExtra.ExtraFieldValue == null || objHeaderExtra.ExtraFieldValue == "" && fResultData.data[b].IsMandatory == true) {
                                            objHeaderExtra.ExtraFieldName = 1;
                                        }
                                        objBodyExtraFileds = {};
                                        objBodyExtraFileds.Name = objHeaderExtra.ExtraFieldName,
                                        objBodyExtraFileds.Tag = objHeaderExtra.ExtraFieldValue
                                        lstBodyExtraFileds.push(objBodyExtraFileds);
                                    }
                                }
                            }
                        }

                        REQUISITION.GetBatchRMADetails(transId);
                        var lstTemp = [];
                        if (REQUISITION.lstRMAData.length != null && REQUISITION.lstRMAData.length > 0) {
                            for (var i = 0; i < fQuantity; i++) {
                                lstTemp.push(REQUISITION.lstRMAData[i].sRMANo);
                            }
                        }

                        if (iFinalResult == 0) {
                            var obj = {
                                iStandardReson: iFailureReason,
                                dQSplityQuantity: fQuantity,
                                sRMA: lstTemp.join(','),
                                bPassed: false,
                                iFailedWarehouse: iWareHouse,
                                arrRMA: lstTemp,
                                lstBodyTags: REQUISITION.arrBodyFocusTags,
                                lstBodyExtraFields: lstBodyExtraFileds
                            };

                            REQUISITION.lstQuantityBreakUpQuantities.push(obj);
                        } else {
                            var obj = {
                                iStandardReson: 0,
                                dQSplityQuantity: fQuantity,
                                sRMA: lstTemp.join(','),
                                bPassed: true,
                                iPassedWarehouse: iWareHouse,
                                arrRMA: lstTemp,
                                lstBodyTags: REQUISITION.arrBodyFocusTags,
                                lstBodyExtraFields: lstBodyExtraFileds
                            };

                            REQUISITION.lstQuantityBreakUpQuantities.push(obj);
                        }

                    }
                } else {
                    COMMON.prototype.showMessage("Unable to Close Requisition", REQUISITION.REQUISITIONMsgs.lblErrorMsg);
                    return false;
                }

                var iUnitid = document.getElementById("txtUnits_Req").value;

                var SaveObjQuantityBreakUpData = {
                    iProductId: productId,
                    fQuantity: fQuantity,
                    fFailedQuantity: fFailedQty,
                    fPassedQuantity: fPassedQty,
                    iUnitId: iUnitid,
                    lstQuantityBreakUpQuantities: REQUISITION.lstQuantityBreakUpQuantities,
                    lstHeaderTags: REQUISITION.arrHeaderFocusTags,
                    arrQCExtraFieldsHeaders: lstHeaderExtra,
                }

                var itemDatafields = OPTIONCONTROL.getControlDataObject("FOption_ProductName_Req");
                if (itemDatafields.bDontMaintainStocksByRMA == "True" || itemDatafields.bDontMaintainStocksByRMA == true) {
                    SaveObjQuantityBreakUpData.bRMA = false;
                } else {
                    SaveObjQuantityBreakUpData.bRMA = true;
                }

                //debugger
                if (REQUISITION.bConsumeDuringTest && bTotalCheck == false) {
                    REQUISITION.objCloseRequisitionData = {
                        iApprovedBy: iApprovedBy,
                        SaveObjQuantityBreakUpData: SaveObjQuantityBreakUpData,
                        bTotalCheck: bTotalCheck,
                        iTestHeaderId: iTestHeaderId
                    }
                    REQUISITION.OnLoadShortageStocksPopup();
                } else {
                    var urlPath = REQUISITION.GetQualityControlAreaName("CloseRequisition", "Requisition", eVersion.Version10);
                    var fnResult = NETWORK.executeServerMethod(urlPath, true, { iReqHeaderId: ReqHeaderId, iTransactionId: transId, iWareHouseId: iWareHouse, iApprovedBy: iApprovedBy, iRequisitionResult: iFinalResult, objQuantityBreakUpData: SaveObjQuantityBreakUpData, bTotalTest: bTotalCheck, iTestHeaderId: iTestHeaderId },
                        "json", true, "REQUISITION.OnClickCloseReqOk_Success", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
                }
            }

        } catch (err) {
            COMMON.prototype.showMessage("Exception: {REQUISITION.CloseRequisitionSave} " + err.message, REQUISITION.REQUISITIONMsgs.QC_TD_msgException);
            return false;
        }
