                //}

                var rowGridCount = FGRIDCONTROL.getTotalRows("Id_ReleaseJobOrder_Grid");
                var totalQuantity = 0;
                for (var rowindex = 1; rowindex <= rowGridCount; rowindex++) {
                    //debugger;
                    var RowCell11 = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", rowindex, 11 + prodColIndex);
