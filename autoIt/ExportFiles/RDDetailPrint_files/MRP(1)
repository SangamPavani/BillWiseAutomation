        processMasterVariables: function (objVar, iFactor, iRowIndex, iScreenId) {
            var iMasterType = 0;
            var result = null;
            var iBookNo = 0;
            var iMaster = 0;
            var bAsync = false;
            var value = null;
            //debugger;
            try {
                result = COMMON.prototype.getEmptyResultObject();
                result.lValue = 0;
                result.sValue = "";
                result.data = null;

                iMasterType = FConvert.getMasterTypeIdFromVariable(objVar.Var);
                if (iMasterType <= 0) {
                    return (result);
                }

                if (FCommon.String.startsWith(objVar.Var.toLowerCase(), "mpb6c") == true
                    || FCommon.String.startsWith(objVar.Var.toLowerCase(), "mpb5c") == true) {
                    iBookNo = transEntryBook.getValue(iRowIndex);
                }

                iMasterId = MRPCommon.PRELOAD.getMasterValue(iRowIndex, iMasterType, iScreenId);

                value = transEntryCache.MASTER.getValue(objVar.Var, iMasterId, iBookNo);
                if (value != undefined) {
                    result = {};
                    result.lValue = 1;

                    if (iFactor >= 0) {
                        result.data = value;
                    }
                    else {
                        result.data = FConvert.toDecimal(value) * iFactor;
                    }

                    return (result);
                }

                //alert("processMasterVariables (" + iRowIndex + "," + objVar.Var + "," + iMasterId + "," + iBookNo + ")", "red");
                result = NETWORK.executeServerMethod(GLOBAL.getContextPath("GetMasterVariableValueForTran", "Customize", "MRP"),
                                            false,
                                            { sVariableName: objVar.Var, iMasterId: iMasterId, iBodyId: iBookNo },
                                            "json",
                                            false);

                if (result.lValue > 0) {
                    transEntryCache.MASTER.setValue(objVar.Var, iMasterId, iBookNo, result.data.data);

                    if (iFactor >= 0) {
                        result.data = result.data.data;
                    }
                    else {
                        result.data = FConvert.toDecimal(result.data.data) * iFactor;
                    }
                }
                else {
                    result.lValue = 1;
                    result.data = 0;
                }
            }
            catch (err) {
                transEntryGlobal.showAlert("{TRANSACTION_ENTRY.PRELOAD.processMasterVariables}" + err.message, "Exception");
            }

            return (result);
        },
        getMasterValue: function (iRowIndex, iMasterType, iScreenId) {
            var cellobj = null;
            var sGridName = "";
            var iValue = 0;
                        
            if (iScreenId == MRPScreens.ReceiptFromProduction) {
                sGridName = RF_PRODUCTION.GetGridId();
            }
            if (iScreenId == MRPScreens.ReceiptFromJobWork) {
                sGridName = RECEIPTFROMJOBWORKER.GetGridId();
            }
            if (iScreenId == MRPScreens.IssueToProduction) {
                sGridName = IssueTP.GetGridId();
            }
            if (iScreenId == MRPScreens.ReturnFromJobWork) {
                sGridName = RFJW.GetGridId();
            }
            if (iScreenId == MRPScreens.ReturnFromShopFloor) {
                sGridName = RFSF.GetGridId();
            }
            var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            for (var i = 0; i < iTotalColumns; i++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, iRowIndex, i + 1);
                if (parseInt(cellobj.ColumnAttribute.imastertype) == iMasterType) {
                    iValue = cellobj.getCellData("value");
                    if (parseInt(iValue) > 0) {
                        break;
                    }

                }
            }
            return iValue;
        },
        evaluateBodyFormula: function (sFormula, iRowIndex, objCurrentValue, iColumnIndex, iScreenId) {
            var sResult = "";
            var iCounter = 0;
            var objFormula = null;
            var arrVariables = null;
            var arrIdNamePair = null;
            //debugger;
            try {
                if (FCommon.String.isNullOrEmpty(sFormula, true) == true) {
                    if (FCommon.UI.isValidObject(objCurrentValue) == true) {
                        return (objCurrentValue);
                    }

                    return (0);
                }

                sFormula = DataType.stringRemoveSpace(sFormula);
                if (FCommon.String.startsWith(sFormula, "&") == false) {
                    if (FConvert.toDecimal(objCurrentValue) != 0) {
                        return (objCurrentValue);
                    }
                }
                else {
                    sFormula = sFormula.substr(1);
                }

                if (FCommon.String.startsWith(sFormula, "#") == true) {
                    sFormula = sFormula.substr(1);
                }

                if (iColumnIndex == undefined) {
                    iColumnIndex = -1;
                }

                arrVariables = EntryMainFormula.getSQLVariables(sFormula);
                if (arrVariables.length > 1) {
                    arrIdNamePair = TRANSACTION_ENTRY.PRELOAD.getSQLVariablesValue(arrVariables, iRowIndex);
                }

                objFormula = new FFormula();
                objFormula.m_CalType = transEntryInfo.CalendarType;
                objFormula.setRowIndex(iRowIndex);
                objFormula.setColumnIndex(iColumnIndex);
                objFormula.fnValueNeeded = "MRPCommon.PRELOAD.formula_ValueNeeded";

                objFormula.ResetVars();
                if (FCommon.Array.getLength(arrIdNamePair) > 0) {
                    for (iCounter = 0; iCounter < arrIdNamePair.length; iCounter++) {
                        objFormula.AddVar(arrIdNamePair[iCounter].Name, arrIdNamePair[iCounter].Tag);
                    }
                }

                sResult = objFormula.Result(sFormula, true);
                if (sResult == "NaN") {
                    return (0);
                }
            }
            catch (err) {
                transEntryGlobal.showAlert("{TRANSACTION_ENTRY.FORMULA.evaluateBodyFormula} " + err.message, "Exception");
            }
            return (FConvert.toDecimal(sResult));
        },
        formula_ValueNeeded: function (objFormula, objVar, iRowIndex, objTag, iColumnIndex) {
            //debugger;
            var obj = MRPCommon.PRELOAD.getVariableValue(objVar, iRowIndex, objTag, iColumnIndex);
            if (FCommon.UI.isValidObject(obj) == false || FCommon.String.isNullOrEmpty(obj.toString()) == true) {
                return (0);
            }
            else {
                if (FConvert.hasStringTypeValue(obj) == true) {
                    return ("'" + obj + "'");
                }

                return (FConvert.toDecimal(obj));
            }
        },
