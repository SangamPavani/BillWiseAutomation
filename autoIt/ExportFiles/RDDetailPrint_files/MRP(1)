    this.GetHeaderExtraFields = function (id, data, tag) {
        try {
            //debugger
            var Value = "", text = "";
            var hidele = document.getElementById("hdnExtraid_" + id);
            if (data == null || data == undefined) {
                //var sID = "hdnExtraid_" + id;
                var itype = parseInt(hidele.dataset.itype);
                if (itype == 0 || itype == 6 || itype == 1) {
                    Value = document.getElementById(id).value;
                    text = document.getElementById(id).value;
                } else
                    if (itype == 8 || itype == 9) {
                        var ele = document.getElementById(id);
                        text = ele.options[ele.selectedIndex].text;
                        Value = ele.value;
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id);
                        }
            } else {
                hidele = document.getElementById("hdnExtraid_" + id.id);
                if (hidele != null) {
                    var itype = parseInt(hidele.dataset.itype);
                    if (itype == 12 || itype == 14) {
                        Value = OPTIONCONTROL.getControlValue(id.id)
                    } else if (itype == 5) {
                        Value = FTIMECONTROL.getTime(id.id);
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id.id);
                        }
                        else if (itype == 10) {
                            var sresult = FATTACHMENTCONTROL.getData(id.id);
                            if (sresult.lValue > 0) {
                                Value = FConvert.toString({
                                    iFieldId: 10, sFileName: sresult.data.sFileName, sData: sresult.data.sData
                                });
                            }
                            else {
                                Value = "";
                            }
                        }
                }
            }
            if (Value == "" || Value == null) {
                if (itype == 0) {
                    Value = "";
                }
                else {
                    Value = 0;
                }
            }


            RF_PRODUCTION.arrFinalHeaderEFields[hidele.value].objFieldValue = Value;
            if (parseInt(hidele.value) == RF_PRODUCTION.arrHeaderExtraFields.length - 1) {
                FGRIDCONTROL.gotoCell(document.getElementById("Id_MRPReceiptFromProduction_Grid"), 1, 1);
            }

        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.GetHeaderExtraFields} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.GetHeaderExtraFields} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }
    this.LoadGridDate = function (arrRowData, iRow) {
        ObjF = {};
        try {
            var arrExtra = [], arrTags = [];
            var OBJPPPW = {};
            //debugger
            var sGridName = "Id_MRPReceiptFromProduction_Grid";
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            if (arrRowData.length != TotalColumns)
                return ObjF;
            for (var j = 0; j < TotalColumns; j++) {
                //cellobj = FGRIDCONTROL.getCellObject(sGridName, iRow, j + 1)
                if (arrRowData[j].MetaData.ctrltype == "tagfield") {
                    //debugger
                    var arrT = RF_PRODUCTION.GetBodyTagsData(arrRowData[j], iRow)
                    if (arrT == false)
                        return false;
                    if (arrT.length > 0)
                        arrTags.push(arrT[0]);
                } else if (arrRowData[j].MetaData.ctrltype == "ExtraField") {
                    //debugger;
                    var arr = RF_PRODUCTION.GetBodyExtraFieldsData(arrRowData[j]);
                    if (arr == false)
                        return false;
                    if (arr.length > 0)
                        arrExtra.push(arr[0]);
                }
                else {
                    if (arrRowData[j].MetaData.ctrlatt == "ProductionOrder") {
                        if (arrRowData[j].Value == "") {
                            var iProdOrderId = OPTIONCONTROL.getControlValue("FOption_ProductionOrder");
                            if (iProdOrderId == 0 || iProdOrderId == null) {
                                //RF_PRODUCTION.sError = "Select Production Order.";
                                RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_IP_msgSelectProductionOrder;
                                return false;
                            } else {
                                arrRowData[j].Value = iProdOrderId;
                            }
                        }
                        OBJPPPW.iProdPrderId = parseInt(arrRowData[j].Value);
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "ProcessName") {
                        //if (arrRowData[j].Value == "") {
                        //    RF_PRODUCTION.sError = "Select Process Name.";
                        //    return false;
                        //}
                        if (document.getElementById("ddlProcessName").value == "" || document.getElementById("ddlProcessName") == 0) {
                            //RF_PRODUCTION.sError = "Select Process Name.";
                            RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + RF_PRODUCTION.RF_PRODUCTIONMsgs.ProcessName;
                            return false;
                        }
                        // //debugger;
                        var iProcessId = parseInt(document.getElementById("ddlProcessName").value)
                        OBJPPPW.iProcessId = iProcessId;
                        OBJPPPW.iExistOutPut = 0;
                        if (RF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs != null && RF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs.length > 0) {
                            for (var i = 0; i < RF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs.length; i++) {
                                if (RF_PRODUCTION.arrProcessData[0].lstExistProcessOutputs[i].ID == iProcessId) {
                                    OBJPPPW.iExistOutPut = 1;
                                }
                            }
                        }
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "ProductName") {
                        if (arrRowData[j].Value == "") {
                            //RF_PRODUCTION.sError = "Select Product Name.";
                            RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + RF_PRODUCTION.RF_PRODUCTIONMsgs.MRPProductName;
                            return false;
                        }
                        OBJPPPW.iProductId = parseInt(arrRowData[j].Value);
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "WorkCenter") {
                        if (arrRowData[j].Value == "") {
                            //RF_PRODUCTION.sError = "Select WorkCenter.";
                            RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_PP_msgSelect_ + " " + RF_PRODUCTION.RF_PRODUCTIONMsgs.WorkCenter;
                            return false;
                        }
                        OBJPPPW.iWorkCenterId = parseInt(arrRowData[j].Value);
                        var objWC = OPTIONCONTROL.getControlDataObject(arrRowData[j].MetaData.ctrlid);
                        OBJPPPW.dRemainingQtyForWC = parseFloat(objWC.fQty) - parseFloat(objWC.WCReceivedQty);
                        OBJPPPW.dPartialWisePlannedQtyForWC = objWC.fQty;
                        OBJPPPW.dAlreadyReceiveQtyForWC = objWC.WCReceivedQty;
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "QtyToReceive") {
                        if (arrRowData[j].Value == "" || arrRowData[j].Value == 0) {
                            //RF_PRODUCTION.sError = "Enter Quantity To Receive.";
                            RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgEnterQuantityToReceive;
                            return false;
                        }
                        OBJPPPW.dQtyToReceive = parseFloat(arrRowData[j].Value, RF_PRODUCTION.dNoOfDecimals);
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "Batch") {
                        //debugger
                        if (RF_PRODUCTION.bBatchEnable) {
                            if (RF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStockbyBatch != true) {
                                if (arrRowData[j].Value == "") {
                                    //RF_PRODUCTION.sError = "Enter Batch No.";
                                    RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.msgAUEnterBatch;
                                    return false;
                                }
                            }
                            OBJPPPW.sBatchNo = arrRowData[j].Value;
                            OBJPPPW.bDontMaintainStockbyBatch = RF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStockbyBatch;
                        }
                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "bin") {
                        //debugger
                        if (RF_PRODUCTION.bEnableBin) {
                            //if (RF_PRODUCTION.arrRFItemData[iRow - 1].bDoNotInputBin != true) {
                            //    if (arrRowData[j].Value == "") {
                            //        RF_PRODUCTION.sError = "Select Bin.";
                            //        //RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.msgAUEnterBatch;
                            //        return false;
                            //    }
                            //}

                            if (RF_PRODUCTION.bDontMaintainBin != 'True') {
                                if (arrRowData[j].Value == "") {
                                    RF_PRODUCTION.sError = "Select Bin";
                                    return false;
                                }
                            } else {
                                if (RF_PRODUCTION.arrRFItemData[iRow - 1].bDoNotInputBin != true) {
                                    if (arrRowData[j].Value == "") {
                                        RF_PRODUCTION.sError = "Select Bin";
                                        return false;
                                    }
                                }
                            }
                            OBJPPPW.arrBinsQuantity = RF_PRODUCTION.arrRFItemData[iRow - 1].arrBinsQuantity;
                            OBJPPPW.bDoNotInputBin = RF_PRODUCTION.arrRFItemData[iRow - 1].bDoNotInputBin;
                        }

                    }
                    else if (arrRowData[j].MetaData.ctrlatt == "BatchExpiryDate") {
                        if (RF_PRODUCTION.bBatchExpiryDate) {
                            var iTempVal = isNaN(parseInt(arrRowData[j].Value)) ? 0 : parseInt(arrRowData[j].Value);
                            if (iTempVal <= 0) {
                                if (RF_PRODUCTION.arrRFItemData[0].bIgnoreExpiryforthisItem == true) {
                                    arrRowData[j].Text = parseInt(0);
                                }
                                else {
                                    //RF_PRODUCTION.sError = "Enter Batch ExpiryDate.";
                                    RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_EnterBatchExpiryDate;
                                    return false;
                                }
                            }
                            OBJPPPW.sBatchExpiry = parseInt(arrRowData[j].Text);
                            OBJPPPW.iExpiry = parseInt(arrRowData[j].Value);
                        }
                    }
                    //"BatchManufacturingDate"
                    else if (arrRowData[j].MetaData.ctrlatt == "BatchManufacturingDate") {
                        if (RF_PRODUCTION.bBatchManufacturingDate) {
                            var iTempValu = isNaN(parseInt(arrRowData[j].Value)) ? 0 : parseInt(arrRowData[j].Value);
                            if (iTempValu <= 0) {
                                if (RF_PRODUCTION.arrRFItemData[0].bIgnoreMfgDateforthisItem == true) {
                                    arrRowData[j].Text = parseInt(0);
                                }
                                else {                                    
                                    RF_PRODUCTION.sError = "Enter Batch Manufacture Date.";
                                    return false;
                                }
                            }
                            OBJPPPW.bBatchMfgDate = parseInt(arrRowData[j].Text);
                            OBJPPPW.iMfg = parseInt(arrRowData[j].Value);
                        }
                    }
                    //sRMA rma
                    else if (arrRowData[j].MetaData.ctrlatt == "rma") {
                        //debugger
                        if (RF_PRODUCTION.bRMAEnable) {
                            if (RF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStocksByRMA != true) {
                                if (arrRowData[j].Value == "") {
                                    //RF_PRODUCTION.sError = "Enter RMA.";
                                    RF_PRODUCTION.sError = RF_PRODUCTION.RF_PRODUCTIONMsgs.lbBackTrack + " " + RF_PRODUCTION.RF_PRODUCTIONMsgs.RMA
                                    return false;
                                }
                            }
                            //debugger
                            OBJPPPW.sRMA = arrRowData[j].Text;
                            OBJPPPW.bDontMaintainStocksByRMA = RF_PRODUCTION.arrRFItemData[iRow - 1].bDontMaintainStocksByRMA;
                        }
                    }
                }
            }
            RF_PRODUCTION.PPPW.push(OBJPPPW);
            arrRowExtraF = arrExtra;
            arrRowTagsF = arrTags;

            ObjF = RF_PRODUCTION.LoadDataFromArr(RF_PRODUCTION.arrRFPProductData[iRow - 1], OBJPPPW);

        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.LoadGridDate} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.LoadGridDate} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
        return ObjF;
    }
