    TreeFilledData: [],
    // Fills Quantity and Production date to Planning Tree data
    FillPlanningOrderGridTreeData: function (iPDRParentID, dQuantity, dtDueDate, bFromDPR) {
        //
        try {
            if (MRP_PROCESS.TreeFilledData.length > 0) {
                for (var i = 0; i < MRP_PROCESS.TreeFilledData.length; i++) {
                    if (MRP_PROCESS.TreeFilledData[i].iPDRParentID == iPDRParentID) {
                        var bRoundOff = (MRP_PROCESS.TreeFilledData[i].bRoundOff);
                        var OptDataField = OPTIONCONTROL.getControlDataObject("FOption_ProductionOrder_MRP");
                        var dQty = 0;
                        if (MRP_PROCESS.TreeFilledData[i].dQuantityPerPiece == 0) {
                            if (isNaN(parseFloat(OptDataField.Quantity)) == false && bFromDPR == false) {
                                dQty = parseFloat(OptDataField.Quantity).toFixed(MRP_PROCESS.iDecimalInQuantity) * 1;
                            }
                            else {
                                dQty = MRP_PROCESS.TreeFilledData[i].dPendingQty * 1;
                            }
                        }
                        else {
                            if (isNaN(parseFloat(OptDataField.Quantity)) == false && bFromDPR == false) {
                                dQty = parseFloat(OptDataField.Quantity).toFixed(MRP_PROCESS.iDecimalInQuantity) * (MRP_PROCESS.TreeFilledData[i].dQuantityPerPiece);
                            }
                            else {
                                dQty = MRP_PROCESS.TreeFilledData[i].dPendingQty * (MRP_PROCESS.TreeFilledData[i].dQuantityPerPiece);
                            }
                        }
                        dQty = bRoundOff ? Math.ceil(dQty) : dQty;

                        var iMaterialID = parseInt(MRP_PROCESS.TreeFilledData[i].iMaterialID);
                        var iChildID = parseInt(MRP_PROCESS.TreeFilledData[i].iPDRChildID);
                        MRP_PROCESS.TreeFilledData[i].sRequiredPieces = parseFloat(dQuantity).toFixed(MRP_PROCESS.iDecimalInQuantity);
                        MRP_PROCESS.TreeFilledData[i].dPendingQty = parseFloat(dQty).toFixed(MRP_PROCESS.iDecimalInQuantity);

                        if ((MRP_PROCESS.TreeFilledData[i].dPendingQty - MRP_PROCESS.TreeFilledData[i].dAdjustedQty) > 0) {
                            if (MRP_PROCESS.TreeFilledData[i].IsBOM == true) {
                                MRP_PROCESS.TreeFilledData[i].iProductionStartDate = dtDueDate;
                                var dblMulQty = 0;
                                dblMulQty = (MRP_PROCESS.TreeFilledData[i].dPendingQty - MRP_PROCESS.TreeFilledData[i].dAdjustedQty) / (MRP_PROCESS.TreeFilledData[i].dQuantityPerPiece);
                                MRP_PROCESS.FillPlanningOrderGridTreeData(iChildID, dblMulQty, MRP_PROCESS.TreeFilledData[i].iProductionStartDate, bFromDPR);
                                //MRP_PROCESS.FillPlanningOrderGridTreeData(iChildID, dblMulQty, (m_bFromOtherScreenRPO == true && iOtherScrnCnt == 2) ? lstOtherScreenOrdersalreadyRaised[i].iProductionStartDate : MRP_PROCESS.arrMRPProcessingDetail[i].iProductionStartDate);
                            }
                        }
                    }
                }
            }
        } catch (e) {
            alert(e.message);
        }
    },
    // Set Data to Material Planning Grid
    BindPlanningOrderGrid: function (data) {
        //debugger
        if (data != null) {
            //debugger
            var iQtyPerPieceTot = 0;
            var iPendingQtyTot = 0;
            var iAdjustedQtyTot = 0;
            var iRaisedQtyTot = 0;

            var GridId = "Id_MrpProcessing_FGrid";
            //FGRIDCONTROL.clearData(GridId, true);
            //MRP_PROCESS.ClearGridRowData(GridId, data.length);
            var totalRows = FGRIDCONTROL.getTotalRows(GridId);
            FGRIDCONTROL.deleteRows(GridId, (data.length), totalRows);
            FGRIDCONTROL.insertRows(GridId, totalRows, (data.length - totalRows));
            if (MRP_PROCESS.bMRPDone) {
                var lstStock = MRP_PROCESS.arrStockForPlanning;
                for (var i = 0; i < data.length; i++) {
                    var raisedQty = 0;
                    for (var j = 0; j < lstStock.length; j++) {
                        if (lstStock[j].iProductId == data[i].iMaterialID) {
                            if (parseFloat(data[i].dPendingQty) <= lstStock[j].dQuantity) {
                                raisedQty = 0;
                                data[i].dAdjustedQty = parseFloat(data[i].dPendingQty);
                            } else {
                                raisedQty = parseFloat(data[i].dPendingQty) - lstStock[j].dQuantity;
                            }
                            data[i].dRaisedQty = raisedQty.toFixed(MRP_PROCESS.iDecimalInQuantity);
                        }
                    }
                }
                MRP_PROCESS.bMRPDone = false;
            }

            //dsd
