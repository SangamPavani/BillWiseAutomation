                        case "Unit":
                            OPTIONCONTROL.setControlValue(cellobj.ColumnAttribute.ctrlid, data.iUnit);
                            cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
