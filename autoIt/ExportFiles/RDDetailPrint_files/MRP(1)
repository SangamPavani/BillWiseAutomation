    SaveProductionSeries: function () {
        try {
            var totalRows = FGRIDCONTROL.getTotalRows("Id_ProductionSeries_Grid");
            var arrProductionSeriesData = [];
            var SeqNo = 0;
            //debugger;
            for (var i = 0; i < totalRows; i++) {
                var iFieldId = -1;
                var rowData = FGRIDCONTROL.getRowValue("Id_ProductionSeries_Grid", (i + 1));
                if (rowData[0].Value > 0) {
                    if (rowData[3].Value <= 0) {
                        COMMON.prototype.showMessage("No Of character Should be greater than Zero(0) ", "Error Message");
                        return false;
                    }
                    if (rowData[1].Text == "" || rowData[1].Text == "undefined") {
                        COMMON.prototype.showMessage("Field/Value Should not be Empty ", "Error Message");
                        return false;
                    }

                    if (rowData[0].Value == 1) {
                        iFieldId = rowData[1].Value;
                    }

                    //var iVoucherType = OPTIONCONTROL.getControlValue("FOption_VoucherType");

                    var model = {
                        Type: rowData[0].Value,
                        FieldOrValue: rowData[1].Text,
                        StartingChatacter: rowData[2].Value,
                        NoOFChatacter: rowData[3].Value,
                        VoucherType: 0,
                        Seq: SeqNo,
                        iFieldId: iFieldId,
                        iScreenId: ProductionSeries.iScreenId,
                    }
                    arrProductionSeriesData.push(model);
                    SeqNo++;
                }
            }
            var hasIncremental = false;
            if (arrProductionSeriesData.length > 0) {
                for (var i = 0; i < arrProductionSeriesData.length; i++) {
                    if (arrProductionSeriesData[i].Type == 5) {
                        hasIncremental = true;
                        break;
                    }
                }
            }

            if (hasIncremental == false) {
                COMMON.prototype.showMessage("Enter Incremental Type to Save Production Series", "Error Message");
                return false;
            }

            var objPOSeries = {
                lstProductionOrderSeries: arrProductionSeriesData
            }

            var urlPath = GLOBAL.getContextPath("SaveProductionSeries", "ProductionSeries", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { objPOSeries: objPOSeries }, "", true, "ProductionSeries.SaveProductionSeriesOnSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");

        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ProductionSeries.SaveProductionSeries} " + err.message, "Exception");
        }
