                                    sTemp = sCode
                                }
                            }
                            break;
                        case 3: // Char Input
                        case 5: // Input
                            sBatch += arrBatchSeries[iCounter].FieldValue;
                            break;
                        case 4: // Date
                            var dtdate = DATEPICKER.getDate('fDatePicker_DocumentDate')
                            switch (FConvert.toInt(arrBatchSeries[iCounter].FieldValue)) {
                                case 0: // Day
                                    sTemp = FConvert.toString(DATE.prototype.getDayFromFocusDate(dtdate));
                                    break;
                                case 1: // Month Name
                                    sTemp = DATEPICKER.getSelectedMonthName(dtdate);
                                    break;
                                case 2: // Year
                                    sTemp = FConvert.toString(DATE.prototype.getYearFromFocusDate(dtdate));
                                    break;
                                case 3: // Month
                                    sTemp = FConvert.toString(DATE.prototype.getMonthFromFocusDate(dtdate));
                                    break;
                            }
                            break;
                        case 7: // Doc No
                            sTemp = OPTIONCONTROL.getControlText("FOption_ProductionOrder");//As per KSR
                            break;
                        case 8: // Time
                            break;
                        case 9: // Voucher abbr
                            sTemp = "";//tranEntryGlobal.EntryModel.Settings.Misc.Abbr;//As per KSR
                            break;
                        case 10: // MRP
                            break;
                        case 11: // Row Id
                            sBatch += FConvert.toString(cellobj.iRow);
                            break;
                    }

                    if (FCommon.String.isNullOrEmpty(sTemp) == false && arrBatchSeries[iCounter].Type != 3
                        && arrBatchSeries[iCounter].Type != 5 && arrBatchSeries[iCounter].Type != 11) {
                        iMaxLength = sTemp.length - arrBatchSeries[iCounter].StartPosition;
                        if (arrBatchSeries[iCounter].NumberOfChars > iMaxLength) {
                            arrBatchSeries[iCounter].NumberOfChars = iMaxLength;
                        }

                        if (arrBatchSeries[iCounter].StartPosition >= sTemp.length) {
                            continue;
                        }
                        sBatch += sTemp.substr(arrBatchSeries[iCounter].StartPosition, arrBatchSeries[iCounter].NumberOfChars);
                    }
                    sTemp = "";
                }
                //debugger
                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                if (FCommon.UI.isValidObject(element) == true) {
                    cellobj.setCellText(sBatch);
                    element.value = sBatch;
                    var OBJB = {};
                    OBJB.Tag = sBatch;
                    EditRECEIPTFROMJOBWORKER.BatchUsedList.push(OBJB);
                }
            }
        }
        catch (err) {
            //COMMON.prototype.showMessage("{RF_PRODUCTION.generateBatchFromSeries} " + err.message, "Exception");
            COMMON.prototype.showMessage("{RF_PRODUCTION.generateBatchFromSeries} " + err.message, EditRECEIPTFROMJOBWORKER. EditRECEIPTFROMJOBWORKERMsgs.QC_TD_msgException);
        }            
