      this.BindDataInputGrid = function (sGridId, iProduct, bStatus) {
          //debugger;
          try {
              var urlPath = GLOBAL.getContextPath("GetBomChildProducts", "BOM", "MRP");
              var fnResult = NETWORK.executeServerMethod(urlPath, true, { iProductId: iProduct }, "", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
              var rowCount = FGRIDCONTROL.getTotalRows(sGridId);
              var arrResultData = fnResult.data.length;

              // alert(StrlstData[0]);
              FGRIDCONTROL.insertRows(sGridId, rowCount, arrResultData);
              var iRowIndexlength = FGRIDCONTROL.getTotalRows(sGridId);
              var iTotalColumns = FGRIDCONTROL.getTotalColumns(sGridId);
              var i = 0;
              //debugger;
              for (var iRow = rowCount; iRow < iRowIndexlength; iRow++) {
                  var StrlstData = [];
                  if (fnResult.data[i] != null) {
                      //StrlstData = fnResult.data[i].split("`");
                      StrlstData = fnResult.data[i].split(",");
                  }
                  else {
                      return false;
                  }
                  for (var iColumn = 0; iColumn < iTotalColumns; iColumn++) {
                      var cell = FGRIDCONTROL.getCellObject(sGridId, iRow, (iColumn + 1));
                      switch (cell.iColumn) {
                          case 7:
                              cell.setCellData("value", parseInt(StrlstData[0]));
                              cell.setCellText(StrlstData[1]);
                              break;

                          case 8:
                              cell.setCellData("value", parseInt(StrlstData[0]));
                              cell.setCellText(StrlstData[StrlstData.length - 3]);
                              break;
                          case 9:
                              cell.setCellText(StrlstData[1]);
                              break;
                          case 10:
                              cell.setCellData("value", parseInt(StrlstData[StrlstData.length - 2]));
                              cell.setCellText(StrlstData[StrlstData.length - 1]);
                              break;
                          case 11:
                              cell.setCellData("value", parseInt(StrlstData[5]));
                              cell.setCellText(StrlstData[6]);
                              break;
                          case 13:
                              cell.setCellText(parseFloat(1).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity));
                              cell.setCellData("value", parseFloat(1).toFixed(BOM_OUTPUTGRID.DecimalsInQuantity));
                              var iUnit = 0;
                              var sGrid = FGRIDCONTROL.getGridIdFromCell(cell.cell);
                              iUnit = FGRIDCONTROL.getCellObject(sGrid, cell.iRow, 11);
                              if (MRP_Ribbon.lstsDecimal != "") {
                                  for (var m = 0; m < MRP_Ribbon.lstsDecimal.length; m++) {
                                      if (iUnit.CellData.value == MRP_Ribbon.lstsDecimal[m].ID) {
                                          if (MRP_Ribbon.lstsDecimal[m].Tag > 0) {
                                              cell.setCellText(parseFloat(1).toFixed(MRP_Ribbon.lstsDecimal[m].Tag));
                                              cell.setCellData("value", parseFloat(1).toFixed(MRP_Ribbon.lstsDecimal[m].Tag));
                                              break;
                                          }
                                      }
                                  }
                              }     
                              break;
                          case 14:
                              var arrProduct = [];
                              arrProduct.push(parseInt(StrlstData[0]));
                              var url = GLOBAL.getContextPath("GetAverageRateForBOM", "BOM", "MRP");
                              selectMastersResult = NETWORK.executeServerMethod(url, true, {
                                  arrProductid: arrProduct
                              }, "JSON", false);
                              if (selectMastersResult.data != null && selectMastersResult.data != undefined) {
                                  cell.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(selectMastersResult.data[0].Tag, BOM_INPUTGRID.DecimalsInCurrency)), FConvert.addNumericSeparator(FConvert.toDecimal(selectMastersResult.data[0].Tag, BOM_INPUTGRID.DecimalsInCurrency)));
                                  cell.setCellData("value", parseFloat(selectMastersResult.data[0].Tag).toFixed(BOM_INPUTGRID.DecimalsInCurrency));
                              }
                              break;
                          case 15:
                              cell.setCellText("Default");
                              cell.setCellData("value", parseInt(0));
                              break;
                          case 16:
                              cell.setCellText("Percentage");
                              cell.setCellData("value", parseInt(0));
                              break;
                          case 17:
                              cell.setCellText("0.00", "0.00");
                              cell.setCellData("value", parseInt(0));
                              break;
                      }
                  }

                  i++;
              }
          } catch (e) {
              COMMON.prototype.showMessage("Exception: BOM_INPUTGRID.BindDataInputGrid " + e.message, MRP_Ribbon.MRP_RibbonMsgs.lblErrorMsg);




          }
      }
}

