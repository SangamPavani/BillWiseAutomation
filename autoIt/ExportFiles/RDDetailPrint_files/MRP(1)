            var sGridName = "Id_MRPEditReceiptFromProduction_Grid";
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            if (arrRowData.length != TotalColumns)
                return ObjF;
            for (var j = 0; j < TotalColumns; j++) {
                //cellobj = FGRIDCONTROL.getCellObject(sGridName, iRow, j + 1)
                if (arrRowData[j].MetaData.ctrltype == "tagfield") {
                    //debugger
