    //// Validation Methods....
    // Accept only number from input on keypress
    IsNumber: function (evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    },
    // Returns Two digit number which is less than 9 (like '2' -> '02')
    TwoDigitNumber: function (num) {
        return num > 9 ? "" + num : "0" + num;
    },
    // Accept Decimal number upto 4 decimal place from input on keypress
    IsNumberWithDotAnd4Decimal: function (ele, evt) {
        //
        var charCode;
        if (evt.keyCode > 0) {
            charCode = evt.which || evt.keyCode;
        }
        else if (typeof (evt.charCode) != "undefined") {
            charCode = evt.which || evt.keyCode;
        }
        if (charCode == 46) {
            if (ele.value.trim().indexOf('.') > -1) {
                return false;
            }
            return true
        }
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        else {
            var text = ele.value.trim();
            if ((text.indexOf('.') != -1) && (text.substring(text.indexOf('.')).length > 4) &&
                (event.which != 0 && event.which != 8) && ($(ele)[0].selectionStart >= text.length - 4)) {
                event.preventDefault();
            }
            else {
                return true;
            }
        }
    },
    // Sort Array based on gives property name. It is used as internal method for sort
    SortBasedOnProp: function (skey) {
        if (skey != null && skey != undefined)
            return function (a, b) {
                if (a[skey] > b[skey]) return 1;
                if (a[skey] < b[skey]) return -1;
                return 0;
            }
    },

