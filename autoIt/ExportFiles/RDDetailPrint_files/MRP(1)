    CostingGrid_OnCellChange: function (cellobj, event) {
        try {
            //debugger
            if (cellobj.bLeave == true) {
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "ScreenType") {
                    var data = OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid);
