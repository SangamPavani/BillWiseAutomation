                if (!confirm("Do You want to propagate this default varient to this Product : " + ProductName + MRP_Ribbon.MRP_RibbonMsgs.MRP_BOM_msgDoYouWantToContinue)) {

                }
                else {
                    ObjBOM.arrSaveNewBomHeader[0].bSetTheDefaultVarient = true
                }
