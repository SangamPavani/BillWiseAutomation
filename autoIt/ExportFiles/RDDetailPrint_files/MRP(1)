                    return false;
                } else {
                    if (objHeaderExtra.FieldType == 4 || objHeaderExtra.FieldType == 6 || objHeaderExtra.FieldType == 12 || objHeaderExtra.FieldType == 8 || objHeaderExtra.FieldType == 1) {
                        objHeaderExtra.ExtraFieldValue = 0;
