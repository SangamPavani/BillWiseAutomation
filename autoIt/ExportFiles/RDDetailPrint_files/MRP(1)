    LoadChangedQuantity: function (ObjNode) {
        try {
            //debugger
            var isEdited = false;
            var Obj = ROUTING.arrRoutingNodes.find(p=>p.iNodeSeq == ObjNode.iNodeSeq);
            for (var i = 0; i < Obj.arrRoutingBOMProduct.length; i++) {
                for (var j = 0; j < ObjNode.arrRoutingBOMProduct.length; j++) {
                    if (ObjNode.arrRoutingBOMProduct[j].iProductId == Obj.arrRoutingBOMProduct[i].iProductId) {
                        if (ObjNode.arrRoutingBOMProduct[j].dQuantity != Obj.arrRoutingBOMProduct[i].dQuantity) {
                            isEdited = true;
                            break;
                        }
                        if (!isEdited) {
                            if (ObjNode.arrRoutingBOMProduct[j].dTrailQuantity == Obj.arrRoutingBOMProduct[i].dTrailQuantity) {
                                isEdited = true; break;
                            }
                        }
                    }
                }
            }
            //debugger
            if (isEdited) {
                var ChangeValue = [];
                var ProductId = [];
                var ObjChange = null;
                for (var i = 0; i < Obj.arrRoutingBOMProduct.length; i++) {
                    for (var j = 0; j < ObjNode.arrRoutingBOMProduct.length; j++) {
                        if (ProductId.indexOf(ObjNode.arrRoutingBOMProduct[j].iProductId) == -1) {
                            ObjChange = {};
                            if (ObjNode.arrRoutingBOMProduct[j].iProductId == Obj.arrRoutingBOMProduct[i].iProductId) {
                                ObjChange.iProduct = ObjNode.arrRoutingBOMProduct[j].iProductId;
                                ObjChange.iChangedValue = Obj.arrRoutingBOMProduct[i].dQuantity - ObjNode.arrRoutingBOMProduct[j].dQuantity;
                                ProductId.push(ObjChange.iProduct);
                                ChangeValue.push(ObjChange);
                            }
                        }
                    }
                }
                //debugger
                var iChangeFromSeqNo = ObjNode.iNodeSeq;
                for (var iIndex = 0; iIndex < ROUTING.arrRoutingNodes.length; iIndex++) {
                    var ObjInput = ROUTING.arrRoutingNodes[iIndex];
                    if (ObjInput.iNodeSeq == iChangeFromSeqNo) {
                        ROUTING.arrRoutingNodes[iIndex] = ObjNode;
                    }
                    if (ObjInput.iNodeSeq > iChangeFromSeqNo) {
                        for (var i = 0; i < ObjInput.arrRoutingBOMProduct.length; i++) {
                            for (var j = 0; j < ChangeValue.length; j++) {
                                if (ChangeValue[j].iProduct == ObjInput.arrRoutingBOMProduct[i].iProductId) {
                                    var dValue = ROUTING.arrRoutingNodes[iIndex].arrRoutingBOMProduct[i].dRemainingQty;
                                    if (dValue > 0) {
                                        ROUTING.arrRoutingNodes[iIndex].arrRoutingBOMProduct[i].dRemainingQty =
                                            parseFloat(dValue)
                                            + ChangeValue[j].iChangedValue;
                                    }
                                    //var c = ROUTING.arrRoutingNodes[iIndex].arrRoutingBOMProduct[i].dRemainingQty;
                                    break;
                                }
                            }
                        }
                        iChangeFromSeqNo++;
                    }

                }

            } else {
                //ROUTING.arrRoutingNodes
                ROUTING.arrRoutingNodes = ROUTING.arrRoutingNodes.filter(function (obj) {
                    return obj.iNodeSeq !== ObjNode.iNodeSeq;
                });
                ROUTING.arrRoutingNodes.push(ObjNode);
            }

        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {ROUTING.LoadChangedQuantity} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {ROUTING.LoadChangedQuantity} " + e.message, ROUTING.ROUTINGMsgs.lblErrorMsg);
        }
    },
