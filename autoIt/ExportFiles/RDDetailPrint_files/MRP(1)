    // Fills Quantity and Production date to Planning Tree data
    this.FillPlanningOrderGridTreeData = function (iPDRParentID, dQuantity, dtDueDate, bFromDPR) {
        ////debugger;
        try {
            if (MAIN_MRPPROCESS.TreeFilledData.length > 0) {
                for (var i = 0; i < MAIN_MRPPROCESS.TreeFilledData.length; i++) {
                    if (MAIN_MRPPROCESS.TreeFilledData[i].iPDRParentID == iPDRParentID) {
                        var bRoundOff = (MAIN_MRPPROCESS.TreeFilledData[i].bRoundOff);
                        var OptDataField = OPTIONCONTROL.getControlDataObject("FOption_ProductionOrder_MRPRePlanning");
                        var dQty = 0;
                        if (MAIN_MRPPROCESS.TreeFilledData[i].dQuantityPerPiece == 0) {
                            if (isNaN(parseFloat(OptDataField.Quantity)) == false && bFromDPR == false) {
                                dQty = parseFloat(OptDataField.Quantity).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) * 1;
                            }
                            else {
                                dQty = MAIN_MRPPROCESS.TreeFilledData[i].dPendingQty * 1;
                            }
                        }
                        else {
                            if (isNaN(parseFloat(OptDataField.Quantity)) == false && bFromDPR == false) {
                                dQty = parseFloat(OptDataField.Quantity).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity) * (MAIN_MRPPROCESS.TreeFilledData[i].dQuantityPerPiece);
                            }
                            else {
                                dQty = MAIN_MRPPROCESS.TreeFilledData[i].dPendingQty * (MAIN_MRPPROCESS.TreeFilledData[i].dQuantityPerPiece);
                            }
                        }
                        dQty = bRoundOff ? Math.ceil(dQty) : dQty;

                        var iMaterialID = parseInt(MAIN_MRPPROCESS.TreeFilledData[i].iMaterialID);
                        var iChildID = parseInt(MAIN_MRPPROCESS.TreeFilledData[i].iPDRChildID);
                        MAIN_MRPPROCESS.TreeFilledData[i].sRequiredPieces = parseFloat(dQuantity).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);
                        MAIN_MRPPROCESS.TreeFilledData[i].dPendingQty = parseFloat(dQty).toFixed(MRP_REPLANNING.iNoOfDecimalsQuantity);

                        if ((MAIN_MRPPROCESS.TreeFilledData[i].dPendingQty - MAIN_MRPPROCESS.TreeFilledData[i].dAdjustedQty) > 0) {
                            if (MAIN_MRPPROCESS.TreeFilledData[i].IsBOM == true) {
                                MAIN_MRPPROCESS.TreeFilledData[i].iProductionStartDate = dtDueDate;
                                var dblMulQty = 0;
                                dblMulQty = (MAIN_MRPPROCESS.TreeFilledData[i].dPendingQty - MAIN_MRPPROCESS.TreeFilledData[i].dAdjustedQty) / (MAIN_MRPPROCESS.TreeFilledData[i].dQuantityPerPiece);
                                MAIN_MRPPROCESS.FillPlanningOrderGridTreeData(iChildID, dblMulQty, MAIN_MRPPROCESS.TreeFilledData[i].iProductionStartDate, bFromDPR);
                            }
                        }
                    }
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage("{MAIN_MRPPROCESS.FillPlanningOrderGridTreeData} " + e.message, MRP_REPLANNING.MRP_REPLANNINGMsgs.QC_TD_msgException);
        }
    }


