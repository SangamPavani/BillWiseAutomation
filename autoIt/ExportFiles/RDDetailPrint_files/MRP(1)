    CheckNextPoSelectionDone: function () {
        var allPOs = $("#Id_RaisedPOsList_div > div");
        var bNextPoSelected = false;
        var bNextPoExists = false;
        for (var i = 0; i < allPOs.length; i++) {
            if ($(allPOs[i]).hasClass("mrpDonePO") == false && $(allPOs[i]).length > 0) {
                if ($(allPOs[i])[0].dataset.mrpdonestatus == 0) {
                    if ($(allPOs[i]).hasClass("raisedPO-selected") == true) {
                        bNextPoExists = true;
                        break;
                    }
                }
            }

        }
        if (bNextPoExists == true) {
            bNextPoSelected = true;
        }
        return bNextPoSelected;
    },
