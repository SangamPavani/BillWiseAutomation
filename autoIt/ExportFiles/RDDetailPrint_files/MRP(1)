                                }
                            }
                            else {
                                // item  can be intermediate or bi product or wastage are not considered in split qty option
                            }
                        }
                        data = parseFloat(data) + parseFloat(AllQuantity);

                        if (parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty) < PlannedQty) {
                            var dRemainingQtyOverAll = parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty) - parseFloat(AlreadyReceivedQty);
