    RaiseOrderByType: function (iRowID, iChildTableID, iParentTableID, strPONo) {
        try {
            debugger
            var iTableExists = MRP_PROCESS.GetCountFromMRPTableIds(iChildTableID);
            if (iTableExists > 0) {
                var iTableIndex = MRP_PROCESS.GetTableIndexFromMRPTable(iChildTableID);
                if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iType == 1) {
                    if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].sProductType != "Service") {
                        if (MRP_PROCESS.bRDR == true) {
                            MRP_PROCESS.RaiseDependentRequirements(iRowID, iChildTableID, iParentTableID);
                        }
                        else {
                            MRP_PROCESS.RaisePurchaseOrder(iRowID, iChildTableID, iParentTableID);
                        }
                    }
                }
                else if (MRP_PROCESS.arrMRPPODataCollection[iTableIndex][iRowID].iType == 0) {
                    MRP_PROCESS.RaiseProductionOrder(iRowID, iChildTableID, iParentTableID, strPONo);
                }
            }
        } catch (e) {
            alert("Exception: {MRP_PROCESS.RaiseOrderByType} " + e.message);
        }
    },

