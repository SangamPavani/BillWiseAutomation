    //SplitSchedule Table Cell Chnage Handler
    // Cell Leave and Enter Events
    SplitsCellChangeHandler: function (cellobj, event) {
        try {
            //debugger
            if (cellobj.bLeave == true) {
                if (cellobj.iColumn == 6) {
                    var CellObj1 = FGRIDCONTROL.getCellObject(MRPProductionOrderDetails.GetSplitGridName(), cellobj.iRow, 1);
                    if (CellObj1.cell.children[0].checked) {
                        var Element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        var iValue = parseFloat(Element.value);
                        cellobj.setCellData("value", iValue);
                        cellobj.setCellText(iValue);
                        var TotalQuantity = parseFloat(document.getElementById("lbldQuantity").innerText.trim());
                        var GridTotalRows = FGRIDCONTROL.getTotalRows(MRPProductionOrderDetails.GetSplitGridName());
                        var CellObj1 = ""; var CellObj2 = "";
                        var Adjustedamount = 0;
                        for (var irow = 0; irow < GridTotalRows; irow++) {
                            var CellObj1 = FGRIDCONTROL.getCellObject(MRPProductionOrderDetails.GetSplitGridName(), irow + 1, 1);
                            if (CellObj1.cell.children[0].checked) {
                                var CellObj2 = FGRIDCONTROL.getCellObject(MRPProductionOrderDetails.GetSplitGridName(), irow + 1, 6);
                                Adjustedamount = parseFloat(Adjustedamount) + parseFloat(CellObj2.getCellData());

                            }
                        }

                        if (Adjustedamount > TotalQuantity) {
                            //COMMON.prototype.showMessage("Adjusted Quantity Cannot be more than Total Quantity.", "SplitSchedule");
                            COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgAdjustedQuantityCannotBeMorethanTotalQuantity, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgSplitSchedule);
                            iValue = 0;
                            MRPProductionOrderDetails.arrSplitSchedule[cellobj.iRow - 1].dAdjustedQty = 0;
                        } else {
                            MRPProductionOrderDetails.arrSplitSchedule[cellobj.iRow - 1].dAdjustedQty = parseFloat(iValue);
                        }
                        cellobj.setCellData("value", iValue);
                        cellobj.setCellText(iValue);
                    }
                } else {
                    cellobj.processDefault(event);
                }
            } else {
                if (cellobj.iColumn == 6) {
                    var CellObj1 = FGRIDCONTROL.getCellObject(MRPProductionOrderDetails.GetSplitGridName(), cellobj.iRow, 1);
                    if (CellObj1.cell.children[0].checked) {
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        cellobj.setControl(element, cellobj.getCellData("value"));
                    } else {
                        //COMMON.prototype.showMessage("Select checkbox to enter Quantity.", "SplitSchedule");
                        COMMON.prototype.showMessage(MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgSelectCheckBoxToEnterQuantity, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgSplitSchedule);
                    }

                } else {
                    cellobj.processDefault(event);
                }
            }
            return true;
        } catch (e) {
            COMMON.prototype.showMessage("MRPProductionOrderDetails.SplitsCellChangeHandler" + e.message, MRPProductionOrderDetails.MRPProductionOrderDetailsMsgs.MRP_MS_msgSplitSchedule);
        }
    },
