    this.LoadEnteredData = function () {
        try {
            var sGridName = IssueTP.GetGridId();
            var iIssueNowColNo = 0, iProductColNo = 0, iNarrationColNo = 0, iRateColNo = 0;
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            for (var j = 0; j < TotalColumns; j++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, 1, j + 1);
                var cell = cellobj.ColumnAttribute.ctrlatt.trim();
                if (cell == "issueingnow") {
                    iIssueNowColNo = j + 1;
                } else
                    if (cell == "productname") {
                        iProductColNo = j + 1;
                    }
                    else
                        if (cell == "rate") {
                            iRateColNo = j + 1;
                        }
                        else
                            if (cell == "narration") {
                                iNarrationColNo = j + 1;
                            }

                if ((iIssueNowColNo > 0 && iProductColNo > 0) && (iRateColNo > 0 && iNarrationColNo > 0)) break;
            }
            if (IssueTP.arrBodyData != null) {
                for (var i = 0; i < IssueTP.arrBodyData.length; i++) {
                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iProductColNo);
                    var iIssueNow = cellobj.getCellData();
                    IssueTP.arrBodyData[i].iProductId = parseFloat(cellobj.getCellData());
                    //vara= cellobj.getControlText();

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iIssueNowColNo);
                    IssueTP.arrBodyData[i].dIssuingNow = parseFloat(cellobj.getCellData()).toFixed(IssueTP.dNoOfDecimal);

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iRateColNo);
                    IssueTP.arrBodyData[i].dRate = parseFloat(cellobj.getCellData()).toFixed(IssueTP.iDecimalsInCurrency);

                    cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, iNarrationColNo);
                    IssueTP.arrBodyData[i].sNarration = cellobj.getCellData();
                }
            }
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {IssueTP.LoadEnteredData} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {IssueTP.LoadEnteredData} " + e.message, MRP_ISTPO.MRP_ISTPOMsgs.lblErrorMsg);
        }
    }
    this.ValidationBeforeSave = function () {
        //debugger
        var strError = false + ";";
        try {
            var sGridName = IssueTP.GetGridId();
            var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
            var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
            //if (TotalRows != IssueTP.arrBodyData.length) return strError = true + "; Data Not Loaded Correctly";
            if (TotalRows != IssueTP.arrBodyData.length) return strError = true + "; " + MRP_ISTPO.MRP_ISTPOMsgs.MRP_IP_msgDataNotLoadedCorrectly;
            var bConsiderClearStock = IssueTP.bConsiderClearStock;
            var sErrors = "";            
            var stockMap = {};
            for (var k = 0; k < IssueTP.arrRowWiseStockData.length; k++) {
                var stock = IssueTP.arrRowWiseStockData[k];
                var pid = stock.iProductId;                
                var invTagId = (stock.iInvTagValue && stock.iInvTagValue !== 0)
                    ? stock.iInvTagValue
                    : (MRP_ISTPO.bInvHeader ? IssueTP.HeaderInventory : 0);
                var key = pid + "_" + invTagId;             
                if (!stockMap[key]) {
                    stockMap[key] = {
                        dAvailableStock: parseFloat(stock.dAvailableStock) || 0,
                        dClearStock: parseFloat(stock.dClearStock) || 0
                    };
                }
            }            
            for (var i = 0; i < TotalRows; i++) {
                if (IssueTP.arrBodyData[i].dIssuingNow > 0) {
                    if (IssueTP.arrBodyData[i].iProductId == 0)
                        return strError = true + "; '" + MRP_ISTPO.MRP_ISTPOMsgs.MRP_IP_msgProductNameCannotBeEmpty;

                    if (IssueTP.arrBodyData[i].dIssuingNow == 0)
                        return strError = true + "; '" + MRP_ISTPO.MRP_ISTPOMsgs.MRP_IP_msgIssueingNowShouldBeGreaterThanZero;

                    if (IssueTP.arrBodyData[i].dRate == 0)
                        return strError = true + "; '" + MRP_ISTPO.MRP_ISTPOMsgs.MRP_IP_msgRateCannotBeEmptyOrZero;

                    if (IssueTP.arrBodyData[i].dRate <= 0 && IssueTP.arrBodyData[i].dIssuingNow > 0)
                        return strError = true + "; " + MRP_ISTPO.MRP_ISTPOMsgs.MRP_IP_msgEnterRateForAllProductsToIssue;
                }

                //DateTime dt = Convert.ToDateTime(dgvProdOrders.GetText(i, "CanIssueOn"));
                //if (dt.Date > DateTime.Now.Date)
                //    // if (DateTime.Compare(dt, DateTime.Today) > 0)
                //{
                //    FMessageBox.Show("Cannot issue  stock before the actual issue date", "Issue to production", MessageBoxButton.OK, MessageBoxImage.Information);
                //    return;
                //}

                for (var j = 0; j < TotalColumns; j++) {
                    var cellobj = FGRIDCONTROL.getCellObject(sGridName, i + 1, j + 1);
                    var cello = cellobj.ColumnAttribute.ctrlatt.trim();
                    if (cello == "issueingnow") {
                        var product = IssueTP.arrBodyData[i];
                        if (parseFloat(product.dIssuingNow) > 0) {                            
                            var key = product.iProductId + "_" + product.iWareHouseId;
                            var stockRecord = stockMap[key];
                            if (stockRecord) {
                                var dStock = bConsiderClearStock
                                    ? stockRecord.dAvailableStock + stockRecord.dClearStock
                                    : stockRecord.dAvailableStock;
                                if (parseFloat(product.dIssuingNow) > dStock) {
                                    sErrors = sErrors + " => " + product.sProductName + ".";
                                }
                            }                            
                        }
                        break;
                    }
                }
            }
            if (sErrors.length > 0) {
                return strError = true + "; Please check the Stock for the Products : '" + sErrors;
            }

            if (!IssueTP.SplitQtyValidation()) {
                return;
            }
            //if (IssueTP.bRMAEnabled) {
            //    var objgridbodydetailsForRMA = IssueTP.arrBodyData;
            //    for (var i = 0; i < objgridbodydetailsForRMA.length; i++) {
            //        if (objgridbodydetailsForRMA[i].bNoRMA == 0 && objgridbodydetailsForRMA[i].dIssuedQuantity > 0) {
            //            if (objgridbodydetailsForRMA[i].RMA == null || objgridbodydetailsForRMA[i].RMA == "") return strError = true + "; Select RMA for all products to be issued";
            //            else {
            //                var arrRMAs = [];
            //                for (var i = 0; i < objgridbodydetailsForRMA.length; i++) {
            //                    arrRMAs.push(objgridbodydetailsForRMA[i].RMA)
            //                }
            //                if (arrRMAs.length != objgridbodydetailsForRMA[i].dIssuedQuantity) return strError = true + "; select RMA For Entire Requested Quantity";
            //            }
            //        }
            //    }
            //}
            if (this.DoNotIssueBeforePreviousProcessIsIssued && !this.blnIssueToProd) {
                var arrProcessIds = [];
                for (var i = 0; i < IssueTP.arrBodyData.length; i++) {
                    if (IssueTP.arrBodyData[i].iProcessId > 0)
                        arrProcessIds.push(IssueTP.arrBodyData[i].iProcessId);
                }
                for (var i = 0; i < arrProcessIds.length; i++) {
                    var arrGridBodyDetails = null;
                    for (var k = 0; k < IssueTP.arrBodyData.length; k++) {
                        if (IssueTP.arrBodyData[k].iProcessId < arrProcessIds[i]) {
                            arrGridBodyDetails.push(IssueTP.arrBodyData[k]);
                        }
                    }
                    if (arrGridBodyDetails != null && arrGridBodyDetails.Length > 0) {
                        var imax = 0;
                        for (var i = 0; i < arrGridBodyDetails.length; i++) {
                            imax = arrGridBodyDetails[i].iProcessId;
                        }
                        var iNum = 0;
                        if (imax > 0) {
                            for (var l = 0; l < arrGridBodyDetails.length; l++) {
                                if (arrGridBodyDetails[l].iProcessId == imax && (parseFloat(arrGridBodyDetails[l].IssuedQuantity) + parseFloat(arrGridBodyDetails[l].IssuingNow)) > 0) {
                                    iNum++;
