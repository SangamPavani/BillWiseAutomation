    // Raise Purchase order Grid cell change handler
    onRaisingOrderGridChange: function (objCell, event) {
        //debugger;
        var attachmentType = MRP_DEPREQ.GetSelectedAttachmentPolicy();
        if (objCell.bLeave == true) {

            if (objCell.ColumnAttribute.ctrltags == "ExtraField") {

                for (var k = 0; k < MRP_DEPREQ.arrVoucherBodyTags.length; k++) {
                    if (objCell.ColumnAttribute.colid == MRP_DEPREQ.arrVoucherBodyTags[k].sFieldName) {
                        var id = "FOption_" + MRP_DEPREQ.arrVoucherBodyTags[k].sFieldName;
                        //var Value = "", text = "";
                        var Value = OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid);
                        var text = OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid);

                        var itype = parseInt(objCell.ColumnAttribute.ctrltagvalue);
                        if (Value == null) {

                            if (itype == 0 || itype == 6 || itype == 1) {
                                Value = document.getElementById(objCell.ColumnAttribute.ctrlid).value;
                            }
                            else if (itype == 8 || itype == 9) {
                                var ele = document.getElementById(objCell.ColumnAttribute.ctrlid);
                                text = ele.options[ele.selectedIndex].text;
                                Value = ele.value;
                            }
                            else if (itype == 4) {
                                Value = DATEPICKER.getDate(objCell.ColumnAttribute.ctrlid);
                            }
                            else if (itype == 12) {
                                Value = OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid);
                            }
                            else if (itype == 5) {
                                Value = FTIMECONTROL.getTime(objCell.ColumnAttribute.ctrlid);
                            }
                            else {
                                Value = text;
                            }
                        }

                        if (Value == "" || Value == null) {
                            if (itype == 0) {
                                Value = "";
                            }
                            else {
                                Value = 0;
                            }
                        }
                    }
                }
            }

            if (objCell.ColumnAttribute.colname == "Extra") {
                objCell.setCellData("value", Value);
                objCell.setCellText(text);
