    OnReleaseReserveStockClick: function () {
        //debugger;
        //Get Current Production order...(in Grid)...
        var result = RAISE_PO_LANDING.GetSelectedRowCountinGridAndIndex();
        if (result.iSelectedRowCount == 0 || result.iRowIndex == 0) {
            //COMMON.prototype.showMessage("Select any Production Order", "Error Message");
