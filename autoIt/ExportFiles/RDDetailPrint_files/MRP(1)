                }
                else {
                    COMMON.prototype.showMessage(SAMPLECHECK.SAMPLECHECKMsgs.QC_TD_msgSelectOneTestDefinition, SAMPLECHECK.SAMPLECHECKMsgs.msgTD);
                }
            }
        }
        catch (err) {
