    SaveProductionOrderDetailInMRP1: function () {
        //debugger
        var ProductionOrderNo = RAISE_PO.GetProductionOrderNO();
        var sBatchNo = document.getElementById('txtBatchNo_PO').value;
        var sRemarks = document.getElementById("txtRemarks").value;
        var sSpecificRemarks = document.getElementById("txtSpecialInstructions").value;
        var OrderStatus = document.getElementById("ddlOrderStatus_PO").value;
        var iDueDate = DATEPICKER.getDate("fDatePicker_DueDate_PO");
        var isOutSource = document.getElementById("chkOutsourced_PO").checked;

        var divElement = document.getElementById("chkOutsourced_PO");
        if (document.getElementById("chkOutsourced_PO").checked == true){
            if (FCommon.UI.isValidObject(divElement) == true) {
                document.getElementById("chkOutsourced_PO").disabled = true;
            }
        }

        if (OrderStatus == 4) {
            COMMON.prototype.showMessage("Closed Order Can Not be Saved", RAISE_PO.RAISE_POMsgs.lblErrorMsg);
            return false;
        }

        var objMRPLogInfo = null;
        if (iDueDate != RAISE_PO.ObjRaisePOData.DueDate) {
            if (RAISE_PO.objDueDate != null && RAISE_PO.objDueDate.sProdOrderNo != null) {
                if (confirm("Are you sure to Continue Change due date for these Production Orders : " + RAISE_PO.objDueDate.sProdOrderNo + " ?")) {
                    objMRPLogInfo = {
                        sPreviousValue: RAISE_PO.ObjRaisePOData.DueDate,
                        sChangedValue: iDueDate
                    }
                }
            }
        }

        //For Extra Feilds Saving MRP 1
        //debugger
        var lstHeaderExtra = [];
        var temp = 0;
        if (RAISE_PO.arrExtraHeaderGroups != null && RAISE_PO.arrExtraHeaderGroups.length > 0) {
            for (var i = 0; i < RAISE_PO.arrExtraHeaderGroups.length; i++) {
                var sId = RAISE_PO.arrExtraHeaderGroups[i] == "" ? "Default" : RAISE_PO.arrExtraHeaderGroups[i];
                sId = sId.replaceAll(" ", "_");
                var arrTemplstExtraHeaderData = [];
                for (var j = 0; j < RAISE_PO.lstExtraHeaderData.length; j++) {
                    if (RAISE_PO.arrExtraHeaderGroups[i] == RAISE_PO.lstExtraHeaderData[j].Group) {
                        arrTemplstExtraHeaderData.push(RAISE_PO.lstExtraHeaderData[j]);
                    }
                }
                for (var k = 0; k < arrTemplstExtraHeaderData.length; k++) {
                    var id = "txtHeaderExtra_" + sId + "_" + k;
                    objHeaderExtra = {};
                    if (arrTemplstExtraHeaderData[k].FieldType == MasterDataTypeEnum.Date) {
                        objHeaderExtra.ExtraFieldValue = DATEPICKER.getDate(id);
                    }
                    else if (arrTemplstExtraHeaderData[k].FieldType == MasterDataTypeEnum.Master) {
                        objHeaderExtra.ExtraFieldValue = OPTIONCONTROL.getControlValue(id);
                    }
                    else {
                        objHeaderExtra.ExtraFieldValue = document.getElementById(id).value;
                    }
                    objHeaderExtra.ExtraFieldDefaultValue = arrTemplstExtraHeaderData[k].DefValue;
                    objHeaderExtra.ExtraFieldIndex = temp + 1;
                    objHeaderExtra.StringValues = "";
                    objHeaderExtra.ExtraFieldName = arrTemplstExtraHeaderData[k].FieldName;
                    objHeaderExtra.FieldType = arrTemplstExtraHeaderData[k].FieldType;
                    if (arrTemplstExtraHeaderData[k].IsMandatory == true) {
                        if (objHeaderExtra.ExtraFieldValue == null || objHeaderExtra.ExtraFieldValue == "" || objHeaderExtra.ExtraFieldValue == '0') {
                            COMMON.prototype.showMessage(arrTemplstExtraHeaderData[k].Caption + " is Mandatory Value.", RAISE_PO.RAISE_POMsgs.lblErrorMsg);
                            return false;
                        }
                    }
                    lstHeaderExtra.push(objHeaderExtra);
                    temp = temp + 1;
                }
            }
        }        
        if (ProductionOrderNo > 0 && OrderStatus < 4) {
            NETWORK.executeServerMethod(GLOBAL.getContextPath("SaveProductionOrderDetails", "RaiseProductionOrders", "MRP"),
                true, { iProductionOrderId: ProductionOrderNo, bBackFlush: false, bOutSource: isOutSource, sRemarks: sRemarks, sSpecificRemarks: sSpecificRemarks, objMRPLogInfo: objMRPLogInfo, lstHeaderExtraData: lstHeaderExtra, sBatchNo: sBatchNo }, "",
                false, "RAISE_PO.SaveProductionOrderDetail_onSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        } else {
            COMMON.prototype.showMessage("MRP Not Done For This ProductionOrder", RAISE_PO.RAISE_POMsgs.lblErrorMsg);
            return false;
        }
    },

