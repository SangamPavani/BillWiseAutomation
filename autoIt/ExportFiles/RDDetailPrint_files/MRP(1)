                                            }

                                            //if (data.lstBody[iRow].arrPIOTags.length > 0) {
                                            //    OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, data.lstBody[iRow].arrPIOTags[iColumn].iTagValue);
                                            //    cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
