                                break;
                            case 4:
                                cell.setCellText(data[i].ProductionOrderNo);//Production Order No
                                cell.setCellData("value", data[i].ID);
                                break;

                            case 5:
                                cell.setCellText(data[i].ProductName);//Product Name
                                cell.setCellData("value", data[i].ProductId);
                                break;
                            case 6:
                                cell.setCellText(data[i].ProductCode);//Product Code
                                cell.setCellData("value", data[i].ProductId);
                                break;
                            case 7:
                                cell.setCellText(data[i].sScheduleStartDate);//Start Date 
                                cell.setCellData("value", data[i].sScheduleStartDate);
                                break;
                            case 8:
                                cell.setCellText(data[i].sScheduleEndDate);//End Date
                                cell.setCellData("value", data[i].sScheduleEndDate);
                                break;
                        }
                    }
                }
            }
