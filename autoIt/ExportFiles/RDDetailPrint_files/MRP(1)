    GetAlternateBOMProduct: function (RowIndex) {
        try {
            debugger;
            if (document.getElementById("rdo_BOMExplodeAlternate_MRPProcess").checked == true) {
                document.getElementById("RdoBOMExplosionAlternateOption_MainOrAlt_Expload").click();
                //
                var productId = 0;
                var alternateProductId = -1;
                var cell10 = FGRIDCONTROL.getCellObject("Id_BOMExplosion_FGrid", RowIndex, 16);
                if (MRP_PROCESS.IsValidObject(cell10) == true) {
                    productId = parseInt(cell10.getCellData("value"));
                }
                var cell11 = FGRIDCONTROL.getCellObject("Id_BOMExplosion_FGrid", RowIndex, 17);
                if (MRP_PROCESS.IsValidObject(cell11) == true) {
                    alternateProductId = parseInt(cell11.getCellData("value"));
                }
                var OrderIndex = MRP_PROCESS.GetRaisingPOIndex();
                var arrMainAndAltProduct = [];
                for (var i = 0; i < MRP_PROCESS.arrExplodedBOM[OrderIndex].length; i++) {
                    if (MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iProduct == productId) {
                        arrMainAndAltProduct.push(MRP_PROCESS.arrExplodedBOM[OrderIndex][i]);
                        break;
                    }
                }
                if (alternateProductId <= 0) {
                    for (var i = 0; i < MRP_PROCESS.arrExplodedBOM[OrderIndex].length; i++) {
                        if (MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iAlternateOf == productId) {
                            arrMainAndAltProduct.push(MRP_PROCESS.arrExplodedBOM[OrderIndex][i]);
                        }
                    }
                }
                else {
                    for (var i = 0; i < MRP_PROCESS.arrExplodedBOM[OrderIndex].length; i++) {
                        if (MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iProduct == alternateProductId) {
                            arrMainAndAltProduct.push(MRP_PROCESS.arrExplodedBOM[OrderIndex][i]);
                        }
                        else if (MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iAlternateOf == alternateProductId) {
                            var obj = arrMainAndAltProduct.find(item => item.iProduct == MRP_PROCESS.arrExplodedBOM[OrderIndex][i].iProduct);
                            if (MRP_PROCESS.IsValidObject(obj) == false) {
                                arrMainAndAltProduct.push(MRP_PROCESS.arrExplodedBOM[OrderIndex][i]);
                            }
                        }
                    }

                }
                MRP_PROCESS.arrMainAndAltBOMProduct = arrMainAndAltProduct;
                MRP_PROCESS.arrMainAndAltBOMProduct.sort(MRP_PROCESS.SortBasedOnProp("iAlternateOf"));
                FGRIDCONTROL.clearData("Id_BOMExplosionAlternate_FGrid", true);
                MRP_PROCESS.ClearGridRowData("Id_BOMExplosionAlternate_FGrid", arrMainAndAltProduct.length);
                for (var i = 0; i < arrMainAndAltProduct.length; i++) {
                    for (var j = 1; j < 12; j++) {
                        var cell = FGRIDCONTROL.getCellObject("Id_BOMExplosionAlternate_FGrid", (i + 1), j);
                        switch (j) {
                            case 2:
                                cell.setCellText(arrMainAndAltProduct[i].sProductName);
                                cell.setCellData("value", arrMainAndAltProduct[i].sProductName);
                                break;
                            case 3:
                                cell.setCellText(arrMainAndAltProduct[i].sProductCode);
                                cell.setCellData("value", arrMainAndAltProduct[i].sProductCode);
                                break;
                            case 4:
                                cell.setCellText(arrMainAndAltProduct[i].dQuantity);
                                cell.setCellData("value", arrMainAndAltProduct[i].dQuantity);
                                break;
                            case 5:
                                cell.setCellText(arrMainAndAltProduct[i].sUnit);
                                cell.setCellData("value", arrMainAndAltProduct[i].sUnit);
                                break;
                            case 6:
                                cell.setCellText(arrMainAndAltProduct[i].dCostPrice);
                                cell.setCellData("value", arrMainAndAltProduct[i].dCostPrice);
                                break;
                            case 7:
                                cell.setCellText(arrMainAndAltProduct[i].dTotalQuantity);
                                cell.setCellData("value", arrMainAndAltProduct[i].dTotalQuantity);
                                break;
                            case 8:
                                cell.setCellText(arrMainAndAltProduct[i].dTotalCostPrice);
                                cell.setCellData("value", arrMainAndAltProduct[i].dTotalCostPrice);
                                break;
                            case 9:
                                cell.setCellText(arrMainAndAltProduct[i].sProductType);
                                cell.setCellData("value", arrMainAndAltProduct[i].sProductType);
                                break;
                            case 10:
                                cell.setCellText(arrMainAndAltProduct[i].dStockAvailability);
                                cell.setCellData("value", arrMainAndAltProduct[i].dStockAvailability);
