    onPRTGridCellChange: function (objCell, event) {
        try {
            //debugger;
            if (objCell.bLeave == true) {
                if (objCell.iColumn == 1) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    if (element.selectedIndex > -1) {
                        objCell.setCellText(element.options[element.selectedIndex].text);
                        objCell.setCellData("value", element.options[element.selectedIndex].value);
                    }
                }
                else if (objCell.iColumn == 2) {
                    cell1 = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 1);
                    if (R_WORKCENTER.IsValidObject(cell1.CellData.value) == true) {
                        if (parseInt(cell1.CellData.value) == 0) {
                            objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                            objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                        }
                    }
                }
                else if (objCell.iColumn == 3) {
                    cell1 = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 1);
                    if (R_WORKCENTER.IsValidObject(cell1.CellData.value) == true) {
                        if (parseInt(cell1.CellData.value) == 1) {
                            objCell.setCellText(OPTIONCONTROL.getControlText(objCell.ColumnAttribute.ctrlid));
                            objCell.setCellData("value", OPTIONCONTROL.getControlValue(objCell.ColumnAttribute.ctrlid));
                        }
                    }
                }
                else if (objCell.iColumn == 4) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    objCell.setCellText(element.value.trim());
                    objCell.setCellData("value", element.value.trim());
                }
            }
            else {
                var bShowControl = false;
                if (objCell.iColumn == 2) {
                    cell1 = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 1);
                    if (R_WORKCENTER.IsValidObject(cell1.CellData.value) == true) {
                        if (parseInt(cell1.CellData.value) == 0) {
                            bShowControl = true;
                        }
                    }
                }
                else if (objCell.iColumn == 3) {
                    cell1 = FGRIDCONTROL.getCellObject(objCell.Grid, objCell.iRow, 1);
                    if (R_WORKCENTER.IsValidObject(cell1.CellData.value) == true) {
                        if (parseInt(cell1.CellData.value) == 1) {
                            bShowControl = true;
                        }
                    }
                }
                else if (objCell.iColumn == 1 || objCell.iColumn == 4) {
                    bShowControl = true;
                }
                if (bShowControl == true) {
                    var element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    objCell.setControl(element, objCell.getCellData("value"));
                }
                else {
                    objCell.processDefault(event);
                }
            }
            if (objCell.iRow == FGRIDCONTROL.getTotalRows(objCell.Grid)) {
                FGRIDCONTROL.insertRows(objCell.Grid, 0, 1);
            }
            return (true);
        } catch (e) {
            alert("Exception {R_WORKCENTER.onPRTGridCellChange} : ", e.message);
        }
    },

