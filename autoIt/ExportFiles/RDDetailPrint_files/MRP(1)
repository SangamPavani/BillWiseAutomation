    generateBatchFromSeries: function (cellobj) {
        var sId = "";
        var sTemp = "";
        var sBatch = "";
        var sPre = "";
        var sPost = "";
        var sIncr = "";
        var bIncrement = false;
        var bItemWise = false;
        var iItem = 0;
        var iIndex = 0;
        var iCounter = 0;
        var iStart = 0;
        var iMaxLength = 0;
        var arrBatchSeries = null;
        var arrBatchData = [];
        var arrBatch = [];
        var objIdNamePair = null;
