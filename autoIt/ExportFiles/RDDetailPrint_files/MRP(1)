                    else if (arrRowData[j].MetaData.ctrlatt == "BatchExpiryDate") {
                        if (ERF_PRODUCTION.bBatchExpiryDate) {
                            var iTempVal = isNaN(parseInt(arrRowData[j].Value)) ? 0 : parseInt(arrRowData[j].Value);
