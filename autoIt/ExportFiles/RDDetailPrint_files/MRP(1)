    // Set Requisition's Test Status to grid of pupup to save final Result of Sample Check
    BindRequisitionTestStatusGrid: function (arrRequisitionTestStatus, TestDefHeaderId, FinalResult) {
        //debugger;
        var GridID = "Id_SampleCheckConfirm_FGrid";
        FGRIDCONTROL.clearData(GridID, true);
        SAMPLECHECK.ClearGridRowData(GridID, arrRequisitionTestStatus.length);
        SAMPLECHECK.arrQcDone = [];
        SAMPLECHECK.arrIsMandatory = [];
        var arrAllTestPassed = [];
        var IsAllTestMandatory = false;
        var IsAllQCDone = false;
        if (arrRequisitionTestStatus != null) {
            var iTotalColumns = FGRIDCONTROL.getTotalColumns(GridID);
            for (var i = 0; i < arrRequisitionTestStatus.length; i++) {
                for (var j = 1; j <= iTotalColumns; j++) {
                    var cell = FGRIDCONTROL.getCellObject(GridID, (i + 1), j);
                    switch (j) {
                        case 1:
                            OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, arrRequisitionTestStatus[i].TestDefHeaderId)
                            cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                            cell.setCellData("value", arrRequisitionTestStatus[i].TestDefHeaderId);
                            break;
                        case 2:
                            var Result = 0;
                            if (arrRequisitionTestStatus[i].TestDefHeaderId == TestDefHeaderId) {
                                Result = FinalResult;
                            }
                            else
                                Result = arrRequisitionTestStatus[i].iResult;
                            cell.setCellText((Result == 0) ? "Failed" : "Passed");
                            cell.setCellData("value", Result);
                            arrAllTestPassed.push(Result);
                            break;
                        case 3:
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, arrRequisitionTestStatus[i].IsMandatory);
                            break;
                        case 4:
                            if (arrRequisitionTestStatus[i].TestDefHeaderId == TestDefHeaderId) {
                                FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, true);
                                if (FinalResult == 1) {
                                    IsAllQCDone = true;
                                }
                                else
                                    IsAllQCDone = false;
                            }
                            else {
                                FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, arrRequisitionTestStatus[i].bQCDone);
                                IsAllQCDone = arrRequisitionTestStatus[i].bQCDone;
                            }
                            SAMPLECHECK.arrQcDone.push(IsAllQCDone);
                            break;
                        case 5:
                            FGRIDCONTROL.setColumnCheckboxState(GridID, cell.iRow, cell.iColumn, arrRequisitionTestStatus[i].bReTestApplicable);
                            break;
                    }
                }
                SAMPLECHECK.arrIsMandatory.push(arrRequisitionTestStatus[i].IsMandatory);
            }
        }
        //debugger;
        for (var i = 0; i < SAMPLECHECK.arrQcDone.length; i++) {
            if (SAMPLECHECK.arrQcDone[i] == false) {
                IsAllQCDone = false;
                break;
            }
        }
        MandatoryCount = 0;
        MandatoryPassedCount = 0;
        for (var i = 0; i < SAMPLECHECK.arrIsMandatory.length; i++) {
            if (SAMPLECHECK.arrIsMandatory[i] == true) {
                MandatoryCount++;
                if (arrAllTestPassed[i] != 0) {
                    MandatoryPassedCount++;
                }
            }
        }
        var ifinalOutputStatus = document.getElementById("ddlFinalResult_SC").value;
        if (IsAllQCDone == true) {

            $("#ddlFinalResult_Popup_SC").val(ifinalOutputStatus);
            // $("#ddlFinalResult_Popup_SC").val(1);
        }
        else {
            if (IsAllQCDone == false) {
                $("#ddlFinalResult_Popup_SC").val(ifinalOutputStatus);
                //$("#ddlFinalResult_Popup_SC").val(0);
            }
            else
                $("#ddlFinalResult_Popup_SC").val(ifinalOutputStatus);
            //  $("#ddlFinalResult_Popup_SC").val(FinalResult);
        }

        if (MandatoryCount == SAMPLECHECK.arrIsMandatory.length && IsAllQCDone == true) {
            document.getElementById("ddlFinalResult_Popup_SC").disabled = true;
        }
        else {
            //if (IsAllQCDone == true) {
            //    document.getElementById("ddlFinalResult_Popup_SC").disabled = true;
            //}
            //else
            document.getElementById("ddlFinalResult_Popup_SC").disabled = false;
        }

        $("#Id_SampleCheckConfirm_FGrid input[type='checkbox']").prop("disabled", true);
    },

    // Get Requisition's Test Status to save final Result of Sample Check
    GetRequisitionTestDataForSave: function () {
        // on Popup OK Click
        //debugger;
        if (SAMPLECHECK.objSampleCheckHeader != null) {
            var res = false;
            var urlPath = SAMPLECHECK.GetQualityControlAreaName("CheckAllAuthorisedRecorsForRequisition", "SampleCheck", eVersion.Version10);
            var fnResult = NETWORK.executeServerMethod(urlPath, true,
                { RequisitionId: parseInt(OPTIONCONTROL.getControlValue("FOption_RequisitionNo_SC")) }, "", false, "", "", "");
            if (fnResult.data) {
                res = true;
            }
            var arrTestStatusData = [];
            //Both Coditions Are required true(IsQcdone and Re-TestApplication ) then only raise New Requisiuon Order
            //If Final Result Fails that time only we have to show Popup...
            var warehouseId = parseInt(OPTIONCONTROL.getControlValue("FOption_WarehouseId"));
            if (warehouseId == 0 || warehouseId == null) {
                COMMON.prototype.showMessage("Select " + SAMPLECHECK.InvTagName , SAMPLECHECK.SAMPLECHECKMsgs.lblErrorMsg);
                return false;
            }
            SAMPLECHECK.objSampleCheckHeader.iWareHouseId = warehouseId;
            var iFinalResultPopup = parseInt($("#ddlFinalResult_Popup_SC").val())
            if (iFinalResultPopup == parseInt(0)) {
                var rowCount = FGRIDCONTROL.getTotalRows("Id_SampleCheckConfirm_FGrid");
                for (var rowindex = 1; rowindex <= rowCount; rowindex++) {
                    var GridRdata = FGRIDCONTROL.getRowValue("Id_SampleCheckConfirm_FGrid", rowindex);
                    if (GridRdata[4].Value == true && GridRdata[4].Value == true) {
                        var retVal = confirm("For this Test Re-Test AppliCable Exists.\n Press 'Yes' to  Raise New Requisition.?");
                        //var retVal = false;
                        //var urlPath = GLOBAL.getContextPath("CheckAllAuthorisedRecorsForRequisition", "SampleCheck", "MRP");
                        //var fnResult = NETWORK.executeServerMethod(urlPath, true, {
                        //    RequisitionId: parseInt(OPTIONCONTROL.getControlValue("FOption_RequisitionNo_SC"))
                        //}, "", true, "", "", "");
                        //if (fnResult.data) {
                        //    retVal = confirm(SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgForThisTestReTestApplicableExists);
                        //}
                        //else {
                        //    retVal = false;
                        //}

                        if (retVal == true) {
                            SAMPLECHECK.objSampleCheckHeader.bRaiseNewRequisiton = true;
                            break;
                        }
                        else {
                            SAMPLECHECK.objSampleCheckHeader.bRaiseNewRequisiton = false;
                            break;
                        }
                    }
                } //For Loop Close
            }

            //Bind All Test ids..
            if (SAMPLECHECK.objSampleCheckHeader.bRaiseNewRequisiton == true) {
                for (var rowno = 1; rowno <= rowCount; rowno++) {
                    var GridRdata = FGRIDCONTROL.getRowValue("Id_SampleCheckConfirm_FGrid", rowno);
                    SAMPLECHECK.lstTestId.push(GridRdata[0].Data.value);
                } //For Loop Close

            }

            var PopupShownCount = 0;
            if (document.getElementById("ddlFinalResult_Popup_SC").selectedIndex == 0)// Failed
            { 
                var iQcNotDoneCount = 0;
                var rowCount = FGRIDCONTROL.getTotalRows("Id_SampleCheckConfirm_FGrid");
                for (var iRowIndex = 1; iRowIndex <= rowCount; iRowIndex++) {
                    var gridRowData = FGRIDCONTROL.getRowValue("Id_SampleCheckConfirm_FGrid", iRowIndex);
                    if (gridRowData[3].Value == false) {
                        iQcNotDoneCount++;
                    }
                }
                //Validation for Sample Check (As per Srinivas Rao Sir told)
                var bCurTestMandatory = false;
                var iCurrentResult = document.getElementById("ddlFinalResult_Popup_SC").selectedIndex;
                var iCurrentTest = parseInt(OPTIONCONTROL.getControlValue("FOption_TestName_SC"));
                for (var i = 0; i < SAMPLECHECK.lstRequistionTestStatus.length; i++) {
                    if (SAMPLECHECK.lstRequistionTestStatus[i].TestDefHeaderId == iCurrentTest) {
                        bCurTestMandatory = SAMPLECHECK.lstRequistionTestStatus[i].IsMandatory;
                    }
                }

                if (iCurrentResult == 0 && bCurTestMandatory && iQcNotDoneCount > 0) {
                    //var result = confirm("This Test is Mandatory Test and It is Failed.\n Press 'Ok' to Close the Requisition or \n Press 'Cancel' to Perform the Next Test");
                    var result = confirm(SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgThisTestIsMandatoryTest);
                    if (result == true || result == "true") {
                        iQcNotDoneCount = 0;
                    }
                }

                // if (SAMPLECHECK.iAuthstatus != 0)             
                // if ((iQcNotDoneCount == 0 && SAMPLECHECK.bAuthorizationExists == false) || (iQcNotDoneCount == 0 && SAMPLECHECK.iAuthstatus == 1)) {
                if ((iQcNotDoneCount == 0 && SAMPLECHECK.bAuthorizationExists == false) || (iQcNotDoneCount == 0 && (SAMPLECHECK.bAuthorizationExists == true && SAMPLECHECK.iAuthstatus == 1))) {
                    //res = confirm("Do You Want to Close Requisition?");
                    PopupShownCount++;
                    res = confirm(SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgDoYouWantToCloseRequisition);
                }
                if (res == true)
                    SAMPLECHECK.objSampleCheckHeader.bClose = true;
                else
                    SAMPLECHECK.objSampleCheckHeader.bClose = false;
                //  SAMPLECHECK.GetConfirmModal(1, "Do You Want to Close Requisition ?");
                //  SAMPLECHECK.objSampleCheckHeader.bRequisitionResult = parseInt($("#ddlFinalResult_Popup_SC").val()) == 1 ? true : false;
            }
            else if (document.getElementById("ddlFinalResult_Popup_SC").selectedIndex == 1) // Passed
            {
                var allManditoryPassed = true;
                var totalRows = FGRIDCONTROL.getTotalRows("Id_SampleCheckConfirm_FGrid");
                for (var i = 0; i < totalRows; i++) {
                    var cell = FGRIDCONTROL.getCellObject("Id_SampleCheckConfirm_FGrid", (i + 1), 2);
                    if (parseInt(cell.getCellData("value")) != 1 && FGRIDCONTROL.getColumnCheckboxState("Id_SampleCheckConfirm_FGrid", (i + 1), 3) == true) {
                        allManditoryPassed = false;
                    }
                }
                if ((SAMPLECHECK.bAuthorizationExists == false) || (SAMPLECHECK.bAuthorizationExists == true && res == true)) {
                    if (allManditoryPassed == true) {
                        PopupShownCount++;
                        res = confirm(SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgDoYouWantToCloseRequisition);
                    }
                }
                //res = confirm("Do You Want to Close Requisition ?");

                if (res == true)
                    SAMPLECHECK.objSampleCheckHeader.bClose = true;
                else {
                    SAMPLECHECK.objSampleCheckHeader.bClose = false;

                }
                //  SAMPLECHECK.GetConfirmModal(1, "Do You Want to Close Requisition ?");
                // SAMPLECHECK.objSampleCheckHeader.bRequisitionResult = parseInt($("#ddlFinalResult_Popup_SC").val()) == 1 ? true : false;
            }
            SAMPLECHECK.objSampleCheckHeader.bRequisitionResult = parseInt($("#ddlFinalResult_Popup_SC").val()) == 1 ? true : false;
            if (SAMPLECHECK.objSampleCheckHeader.bRequisitionResult == true) {
                var allPassed = true;
                var totalRows = FGRIDCONTROL.getTotalRows("Id_SampleCheckConfirm_FGrid");
                for (var i = 0; i < totalRows; i++) {
                    var cell = FGRIDCONTROL.getCellObject("Id_SampleCheckConfirm_FGrid", (i + 1), 2);
                    if (parseInt(cell.getCellData("value")) != 1) {
                        allPassed = false;
                    }
                }
                if (allPassed == true)
                    SAMPLECHECK.objSampleCheckHeader.FinalResult = 1;
            }
            //Changes here
            if (SAMPLECHECK.objSampleCheckHeader.bRaiseNewRequisiton == true) {
                SAMPLECHECK.objSampleCheckHeader.bClose = true;
            }

            var isAllQcDone = true;
            var totalRows = FGRIDCONTROL.getTotalRows("Id_SampleCheckConfirm_FGrid");
            for (var i = 0; i < totalRows; i++) {
                if (FGRIDCONTROL.getColumnCheckboxState("Id_SampleCheckConfirm_FGrid", (i + 1), 4) == false) {
                    isAllQcDone = false;
                    break;
                }
            }
            $("#id_SampleCheck_Modal_ConfirmSave").modal("hide");
            $('.modal-backdrop').remove();
            if ((isAllQcDone == true && SAMPLECHECK.bAuthorizationExists == false) && PopupShownCount == 0 || (isAllQcDone == true && (SAMPLECHECK.bAuthorizationExists == true && res == true)) && PopupShownCount == 0) {
                //SAMPLECHECK.GetConfirmModal(1, "Do You Want to Close Requisition ?");
                SAMPLECHECK.GetConfirmModal(1, SAMPLECHECK.SAMPLECHECKMsgs.QC_SC_msgDoYouWantToCloseRequisition);
            }
            else {
                if (SAMPLECHECK.bConsumeDuringTest == true && SAMPLECHECK.objSampleCheckHeader.bClose == true) {
                    SAMPLECHECK.OnLoadShortageStocksPopup();
                } else {
                    if (SAMPLECHECK.objSampleCheckHeader.bClose == true)
                        SAMPLECHECK.SaveFinalSampleCheckDetails(false);
                    else
                        SAMPLECHECK.SaveFinalSampleCheckDetails(true);
                }
            }
        }
    },

