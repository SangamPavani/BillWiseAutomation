    //process added for ok Button in add process
    ConfirmOk: function () {
        //debugger;
        var ProcessId = OPTIONCONTROL.getControlValue("OC_AddProcess_NameId");
        if (parseInt(ProcessId) <= 0 || ProcessId == null) {
            //COMMON.prototype.showMessage("Select any Process", "Error Message");
            COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.MRP_BOMP_msgSelectAnyProcess, BOM_PROCESS.BOM_PROCESSMsgs.lblErrorMsg);
            return false;
        }

        var ProcessName = OPTIONCONTROL.getControlText("OC_AddProcess_NameId");
        if (BOM_PROCESS.m_lstProcessIds != null) {
            for (var l = 0; l < BOM_PROCESS.m_lstProcessIds.length; l++) {
                if (BOM_PROCESS.m_lstProcessIds[l] == ProcessId) {
                    //COMMON.prototype.showMessage("Already Process Available", "Error Message");
                    COMMON.prototype.showMessage(BOM_PROCESS.BOM_PROCESSMsgs.MRP_BOMP_msgAlreadyProcessAvailable, BOM_PROCESS.BOM_PROCESSMsgs.lblErrorMsg);
                    return;
                }
            }
        }

        var icounter = 0;
        var addProcessindex = 0;
        var ivaddprocess = document.getElementsByClassName("dynamiccls");
        if (ivaddprocess.length > 0) {
            ele = document.getElementById(ivaddprocess[0].id);          
            addProcessindex = ele.tabIndex;
        }
        var inputgridlength = BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[addProcessindex].lstInputGridData.length;
        if (inputgridlength > 0) {
            for (var m = 0; m < BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[addProcessindex].lstInputGridData.length; m++) {
                if (BOM_PROCESS.M_GridBOMProcess.lstGridBomProcessName[addProcessindex].lstInputGridData[m].dRemainingQuantity == 0) {
                    icounter++;
                    if (icounter == inputgridlength) {
                        COMMON.prototype.showMessage("Process cannot be add, there is no Quantity Available", BOM_PROCESS.BOM_PROCESSMsgs.BomProces);
                        return false;
                    }
                }
            }
        }

        BOM_PROCESS.m_lstProcessIds.push(ProcessId);

        var iprocessid = 0;
        var sprocessName = "";
        var beforeProcessindex = 0;
        var iProcessNodeId = 0;
        var ivalueaddprocess = document.getElementsByClassName("dynamiccls");
        var iNodeId = 0;
        var ele = "";
        if (ivalueaddprocess.length > 0) {
            ele = document.getElementById(ivalueaddprocess[0].id);
            iprocessid = document.getElementById(ele.id).value;
            sprocessName = ele.innerText;
            beforeProcessindex = ele.tabIndex;
            iProcessNodeId = ele.title;
            ele.classList.remove("dynamiccls");
        }        
        var guts = '<button id="ProcessNameId_' + BOM_PROCESS.ProcessIndex + '"   title=' + iNodeId + '    tabIndex=' + BOM_PROCESS.ProcessIndex + '  value=' + ProcessId + '   class="list-group-item Fbutton" onclick="BOM_PROCESS.btnprocessclk(' + ProcessId + ',' + BOM_PROCESS.ProcessIndex + ');" style="text-align:center;">' + ProcessName + '</button>';
        $("#divAddProcessId").append(guts)

        document.getElementById("ProcessNameId_" + BOM_PROCESS.ProcessIndex).className = "list-group-item Fbutton dynamiccls";

        if (iprocessid == 0 && BOM_PROCESS.isstatus == 0) {
            BOM_PROCESS.BinddataInputOutputGrid(0);
        }
        if (iprocessid > 0) {
            //update before Record which class is added
            BOM_PROCESS.UpdateProcessGridData(false, iprocessid, sprocessName, beforeProcessindex, iProcessNodeId);            
            //debugger;
            //Bind data to next Record Purpose
            var previndex = BOM_PROCESS.ProcessIndex - 1;
            if (previndex == -1) {
                previndex = 0;
                BOM_PROCESS.BindDataToNextProcessList(previndex, ProcessId, ProcessName, iProcessNodeId);
                BOM_PROCESS.ProcessIndex = BOM_PROCESS.ProcessIndex + 1;
                var currentindex = BOM_PROCESS.ProcessIndex;
                BOM_PROCESS.DataBindToInputOutputGrid(currentindex);
                return;
            }
            BOM_PROCESS.BindDataToNextProcessList(previndex, ProcessId, ProcessName, iProcessNodeId);
            //Bind Data to Next Process data to grid
            var currentindex = BOM_PROCESS.ProcessIndex;

            BOM_PROCESS.DataBindToInputOutputGrid(currentindex);
        }
        BOM_PROCESS.ProcessIndex = BOM_PROCESS.ProcessIndex + 1;
    },

