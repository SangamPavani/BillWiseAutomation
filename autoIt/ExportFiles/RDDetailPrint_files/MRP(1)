    DeleteSelectRow: function (sGridId, iRow, event) {
        //debugger;
        try {
            var iTotalRows = FGRIDCONTROL.getTotalRows(sGridId);
            if (iTotalRows == 1)
                return false;
            FCommon.UI.stopKeyProcess(event);
            FGRIDCONTROL.update(sGridId);
            var ObjCell = FGRIDCONTROL.getCellObject(sGridId, iRow, 1);
            var iProduct = parseInt(ObjCell.getCellData("value"));
            PIORDER.arrProductsUsed.splice(PIORDER.arrProductsUsed.indexOf(iProduct), 1);
            FGRIDCONTROL.deleteRows(sGridId, iRow, 1);
            FGRIDCONTROL.gotoCell(sGridId, iRow + 1, 1);
            document.getElementById('PlanIndependentOrder_Grid').style.display = "none";

        } catch (e) {
            COMMON.prototype.showMessage("Exception: PIORDER.DeleteSelectRow " + e.message, PIORDER.PIORDERMsgs.lblErrorMsg);
        }
    },

