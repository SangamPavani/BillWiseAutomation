                grpVariant[obj.VariantId].push(obj);               
            });
            let VariantIds = BOMData.map(id => id.VariantId).filter((value, index, self) => self.indexOf(value) === index);
            for (var iv = 0; iv < VariantIds.length; iv++) {
                var dTotalCosting = 0;
                var iVariantId = VariantIds[iv];
