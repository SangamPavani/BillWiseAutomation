                iOption = selectedUnit.value;

            for (var i = 0; i < data.length; i++) {
                var dRemainingQty;
                if (data[i].dTotalQuantity > data[i].dStockAvailability) {
                    dRemainingQty = data[i].dTotalQuantity - data[i].dStockAvailability;
                } else {
                    dRemainingQty = 0;
                }
                for (var j = 1; j <= iTotalColumns; j++) {
                    var CellObject = FGRIDCONTROL.getCellObject(GridId, i + 1, j);
                    switch (j) {
                        case 1:
                            CellObject.setCellText(data[i].sProductName);
                            CellObject.setCellData("value", data[i].sProductName);
                            break;
                        case 2:
                            CellObject.setCellText(data[i].sProductCode);
