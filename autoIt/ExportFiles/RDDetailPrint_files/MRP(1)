                            var dQtyToreceive = data.dPartialReleasedQty - data.dAlreadyRecievedQty;
                            //var previousValue = cellobj.getCellText();
                            var previousValue = cellobj.getCellData();
                            if (RF_PRODUCTION.AllowProductionSizePosting == true && previousValue == '') {
                                var PendingPoSize = parseFloat(document.getElementById("txtProductionSizeRFP").getAttribute("IssuedQty"), RF_PRODUCTION.dNoOfDecimals);
                                if (data.iOutPutType==0 && PendingPoSize <= dQtyToreceive) {
                                    //PendingPoSize
                                    cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(PendingPoSize, RF_PRODUCTION.dNoOfDecimals)));
                                    cellobj.setCellData("value", PendingPoSize);
