    this.GetHeaderExtraFields = function (id, data, tag) {
        try {
            //debugger
            var Value = "", text = "";
            var hidele = document.getElementById("hdnExtraid_" + id);
            if (data == null || data == undefined) {
                //var sID = "hdnExtraid_" + id;
                var itype = parseInt(hidele.dataset.itype);
                if (itype == 0 || itype == 6 || itype == 1) {
                    Value = document.getElementById(id).value;
                    text = document.getElementById(id).value;
                } else
                    if (itype == 8 || itype == 9) {
                        var ele = document.getElementById(id);
                        text = ele.options[ele.selectedIndex].text;
                        Value = ele.value;
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id);
                        }
            } else {
                hidele = document.getElementById("hdnExtraid_" + id.id);
                if (hidele != null) {
                    var itype = parseInt(hidele.dataset.itype);
                    if (itype == 12 || itype == 14) {
                        Value = OPTIONCONTROL.getControlValue(id.id)
                    } else if (itype == 5) {
                        Value = FTIMECONTROL.getTime(id.id);
                    } else
                        if (itype == 4) {
                            Value = DATEPICKER.getDate(id.id);
                        }
                        else if (itype == 10) {
                            var sresult = FATTACHMENTCONTROL.getData(id.id);
                            if (sresult.lValue > 0) {
                                Value = FConvert.toString({
                                    iFieldId: 10, sFileName: sresult.data.sFileName, sData: sresult.data.sData
                                });
                            }
                            else {
                                Value = "";
                            }
                        }
                }
            }
            if (Value == "" || Value == null) {
                if (itype == 0) {
                    Value = "";
                }
                else {
                    Value = 0;
                }
            }
            ERF_PRODUCTION.arrFinalHeaderEFields[hidele.value].objFieldValue = Value;
            if (parseInt(hidele.value) == ERF_PRODUCTION.arrHeaderExtraFields.length - 1) {
                FGRIDCONTROL.gotoCell(document.getElementById("Id_MRPEditReceiptFromProduction_Grid"), 1, 1);
            }
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {ERF_PRODUCTION.GetHeaderExtraFields} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {ERF_PRODUCTION.GetHeaderExtraFields} " + e.message, ERF_PRODUCTION.ERF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }

