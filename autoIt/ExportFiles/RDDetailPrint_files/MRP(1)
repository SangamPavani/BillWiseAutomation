                            var objCurrentProdOrderId = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", objCell.iRow, 2 + prodColIndexCount);
                            var iCurrentProdOrderId = parseInt(objCurrentProdOrderId.getCellData("value"));
                            var iTotalQuantityToRelease = 0;
                            var bSplitPOExists = false;
                            for (var irow = 1; irow <= rowGridCount; irow++) {
                                var objProdOrderId = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", irow, 2 + prodColIndexCount);
                                var iProdOrderId = parseInt(objProdOrderId.getCellData("value"));
                                if (iCurrentProdOrderId == iProdOrderId && irow != objCell.iRow) {
                                    bSplitPOExists = true;
                                    var objQuantityRelease = FGRIDCONTROL.getCellObject("Id_ReleaseJobOrder_Grid", irow, objCell.iColumn);
                                    var iQtyRelease = parseFloat(objQuantityRelease.getCellData("value"));
                                    iTotalQuantityToRelease = parseFloat(iTotalQuantityToRelease) + iQtyRelease;
                                }
                            }
                            if (bSplitPOExists) {
                                iTotalQuantityToRelease = iTotalQuantityToRelease + QunatityToRelease;
