            for (var i = 0; i < data.length; i++) {
                for (var j = 1; j < 14; j++) {
                    var cell = FGRIDCONTROL.getCellObject(GridId, (i + 1), j);
                    switch (j) {
                        case 1:
                            //
                            if (data.length > 1) {
                                var hasChild = false;
