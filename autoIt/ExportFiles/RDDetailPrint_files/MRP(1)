                            break;
                        case "RMA":
                            cellobj.setCellText(data[i].sRMA);
                            cellobj.setCellData("value", data[i].sRMA);
                            break;

                        case "Date":
                            cellobj.setCellText(RECEIPTFROMJOBWORKER.TwoDigitNum(DATE.prototype.getDayFromFocusDate(data[i].sDate)) + "/" + RECEIPTFROMJOBWORKER.TwoDigitNum(DATE.prototype.getMonthFromFocusDate(data[i].sDate)) + "/" + DATE.prototype.getYearFromFocusDate(data[i].sDate));
