    SetExplodBOM: function (data) {
        //debugger;
        if (data.length > 0) {
            var TempData = [];
            var arrFinalExplodeData = [];
            var iProductionOrderId = parseInt(OPTIONCONTROL.getControlValue("FOption_ProductionOrderNo_PO"));
            var arrloadAlternativeData = [];
            var urldata = GLOBAL.getContextPath("loadAlternativeData", "RaiseProductionOrders", "MRP");
            var fnResultdata = NETWORK.executeServerMethod(urldata, true, { iProductionOrderId: iProductionOrderId, }, "JSON", false, "", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");

            if (fnResultdata.lValue > 0 && fnResultdata.data != null) {
                if (fnResultdata.data.length > 0) {
                    arrloadAlternativeData = fnResultdata.data;
                }
            }

            // Check alternative avilable For Current Production Order.  
            for (var i = 0; i < data.length; i++) {
                for (var l = 0; l < arrloadAlternativeData.length; l++) {
                    if (data[i].iProduct == arrloadAlternativeData[l].iProductId || data[i].sProductTyspe == "Finished goods") {
                        data[i].dTotalQuantity = arrloadAlternativeData[l].dQuantity;
                        arrFinalExplodeData.push(data[i]);
                        break;
                    }
                }

            }

            //Finally Bind Selected Alternative
            if (arrFinalExplodeData.length > 0) {
                TempData = arrFinalExplodeData;
            }
            else {
                for (var j = 0; j < data.length; j++) {
                    if (P_Order.bSetAlternativedata == true) {
                        TempData.push(data[j]);
                    }
                    else {
                        if (data[j].iAlternateOf <= 0) {
                            TempData.push(data[j]);
                        }
                    }
                }
            }

            P_Order.BindExplodBOMGrid(data, TempData);

        }
    },
