    // Check for available quantity from selected order detail and show confirmation if quantity is more than available quantity
    CheckAvailableQuantity: function (ele) {
        //debugger;
        var totalRows = FGRIDCONTROL.getTotalRows("Id_OrderQuantity_FGrid");
        var totalValue = 0;
        for (var i = 0; i < totalRows; i++) {
            if ((ele.dataset.rowno - 1) == i) {
                if (ele.value.trim() != "" && ele.value > 0) {
                    totalValue += parseInt(ele.value);
                    var productName = $("#Id_PolicyDetails_FGrid_DMR_body tr.selectedRow")[0].children[4].textContent;
                    cell = FGRIDCONTROL.getCellObject("Id_OrderQuantity_FGrid", ele.dataset.rowno, 3);
                    cell.setCellText(productName);
