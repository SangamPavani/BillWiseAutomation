    SetTotalCheckBodyPop: function () {
        try {
            debugger;
            var grid = document.getElementById("Id_TotalCheck_Grid_body");
            var totalRows = grid.rows.length;
            var iPassCount = parseInt(document.getElementById("txtPopQtyPassed").value);
            var FailedCount = parseInt(document.getElementById("txtPopQtyFailed").value);
            var TotalColumns = grid.rows[0].cells.length;
            
            var ParamColums = (TotalColumns - 4) / 4;
           
            for (var r = 0; r < totalRows; r++) {
                
                for (var p = 0; p <= ParamColums; p++) {
                   
                    if (p === ParamColums) {
                        var remainingPass = iPassCount;
                        var ddlid = "ddlResult_" + r;
                        if (remainingPass > 0) {
                            document.getElementById(ddlid).value = 1; // Pass
                            remainingPass--;
                        } else {
                            document.getElementById(ddlid).value = 0; // Fail
                        }
                        continue; // move to next row
                    }
                   
                    var CellNumberMIN = 3 + (4 * p);
                    var CellNumberMax = 3 + (4 * p) + 1;

                    // Read Min/Max from this row
                    var MinValue = parseFloat(grid.rows[r].cells[CellNumberMIN].innerText).toFixed(TotalCheck.NoOfDecimals);
                    var MaxValue = parseFloat(grid.rows[r].cells[CellNumberMax].innerText).toFixed(TotalCheck.NoOfDecimals);

                    var idtxt = "ResultValue_" + r + "_" + p;
                    var iType = parseInt(document.getElementById(idtxt).dataset.iresulttype);

                    // Decide pass/fail based on row index
                    if (r < iPassCount) {
                        // Passed row
                        TotalCheck.setResultValueInGrid(iType, idtxt, MinValue, MaxValue, iPassCount, r);
                    } else if (r < iPassCount + FailedCount) {
                        // Failed row
                        TotalCheck.setResultValueInGrid(iType, idtxt, MinValue, MaxValue, 0, r);
                    }
                }
            }

        } catch (err) {
            COMMON.prototype.showMessage("{TotalCheck.SetTotalCheckBodyPop}" + err.message, TotalCheck.TotalCheckMsgs.QC_TD_msgException);
        }
    },    
