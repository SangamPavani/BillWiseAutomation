    // Requisition Grid cell change handler to bind control and for entry
    onNewRequisitionGridCellChange: function (cellobj, event) {
        try {
            debugger;
            var GridID = "Id_RequisitionDetails_FGrid";
            if (cellobj.bLeave == true) {     // On Leave Event
                switch (cellobj.iColumn) {
                    case 1:
                        cellobj.processDefault(event);
                        break;
                    case 2:
                        if (cellobj.getCellData("value") != "" && document.getElementById("ReqHeaderId").value > 0) {
                            return true;
                        }
                        var paramVal = OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid);
                        if (paramVal == 0 || paramVal == null) {
                            FGRIDCONTROL.clearRowData(GridID, cellobj.iRow, true);
                            return true;
                        }
                        cellobj.setCellData("value", paramVal);
                        var rowCount = FGRIDCONTROL.getTotalRows(GridID);
                        var bExist = false;
                        var Count = 0;
                        for (var i = 1; i < rowCount; i++) {
                            if (FGRIDCONTROL.getCellObject(GridID, i, 2).CellData.value != undefined && FGRIDCONTROL.getCellObject(GridID, i, 2).CellData.value != null && FGRIDCONTROL.getCellObject(GridID, i, 2).CellData.value != "") {
                                if (FGRIDCONTROL.getCellObject(GridID, i, 2).CellData.value == paramVal) {
                                    bExist = true;
                                    Count++;
                                }
                            }
                        }
                        var sTextName = OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid);
                        if (!bExist || (bExist && Count == 1)) {
                            dataFields = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);
                            cellobj.setCellData("value", paramVal);
                            cellobj.setCellText(OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid));
                            cellobj.setCellData("sumofsamplesize", dataFields.SumOfSampleSize);
                            cellobj.setCellData("testtype", dataFields.bTestType);
                            cellobj.setCellData("testdefheaderid", dataFields.iTestDefHeaderId);
                            cellobj.setCellData("iqctagvalue", dataFields.iSeriesTag);

                            var iRoundType = dataFields.iRoundType;

                            var Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 3);
                            Rowcell.setCellData("value", parseFloat(dataFields.SumOfSampleSize).toFixed(REQUISITION.DecimalInQuantity));
                            Rowcell.setCellText(parseFloat(dataFields.SumOfSampleSize).toFixed(REQUISITION.DecimalInQuantity));

                            var availQty = parseFloat(document.getElementById("txtAvailableQuantity_Req").value).toFixed(REQUISITION.DecimalInQuantity);
                            Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 4);

                            if (dataFields.iSampleSizeType == 0) {

                                var sampleSize = ((availQty * dataFields.SumOfSampleSize) / 100);
                                sampleSize = (isNaN(sampleSize) == true) ? 0 : parseFloat(sampleSize).toFixed(REQUISITION.DecimalInQuantity);

                                if (iRoundType == 0) { //None
                                    sampleSize = sampleSize;
                                } else if (iRoundType == 1) { //Nearest
                                    sampleSize = Math.round(sampleSize);
                                } else if (iRoundType == 2) { //Floor
                                    sampleSize = Math.floor(sampleSize);
                                } else if (iRoundType == 3) { // Ceiling
                                    sampleSize = Math.ceil(sampleSize);
                                }

                                Rowcell.setCellData("value", sampleSize);
                                Rowcell.setCellText(sampleSize);
                            } else if (dataFields.iSampleSizeType == 1) {
                                var sampleSize = dataFields.SumOfSampleSize;
                                sampleSize = (isNaN(sampleSize) == true) ? 0 : parseFloat(sampleSize).toFixed(REQUISITION.DecimalInQuantity);
                                Rowcell.setCellData("value", sampleSize);
                                Rowcell.setCellText(sampleSize);
                            }
                            else {
                                debugger
                                var productId = parseInt(OPTIONCONTROL.getControlValue("FOption_ProductName_Req"));
                                var urlPath = REQUISITION.GetQualityControlAreaName("GetSampleSizeQuantityFromExternalMethod", "Requisition", eVersion.Version10);
                                var fnResult = NETWORK.executeServerMethod(urlPath, true, { ProductId: productId, QtyAvailable: availQty }, "json", false, "");
                                if (fnResult.data != null) {
                                    sampleSize = parseFloat(fnResult.data);
                                    Rowcell.setCellData("value", sampleSize);
                                    Rowcell.setCellText(parseFloat(sampleSize).toFixed(REQUISITION.DecimalInQuantity));
                                }
                            }


                            var maxSampleSize = parseFloat(document.getElementById("txtMaxSampleSize_Req").value).toFixed(REQUISITION.DecimalInQuantity);
                            var totalMaxSize = maxSampleSize;
                            var rowCount = FGRIDCONTROL.getTotalRows("Id_RequisitionDetails_FGrid");
                            for (var iRowIndex = 1; iRowIndex < rowCount; iRowIndex++) {
                                var cell = FGRIDCONTROL.getCellObject("Id_RequisitionDetails_FGrid", iRowIndex, 4);
                                var cellValue = cell.getCellData("value");
                                if (cellValue != "" && cellValue != undefined) {
                                    if (parseInt(dataFields.bTestType) == 0) {
                                        if (parseFloat(cellValue) > totalMaxSize) {
                                            totalMaxSize = parseFloat(cellValue).toFixed(REQUISITION.DecimalInQuantity);
                                        }
                                    }
                                }
                            }
                            document.getElementById("txtMaxSampleSize_Req").value = parseFloat(totalMaxSize).toFixed(REQUISITION.DecimalInQuantity);

                            Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 5);
                            Rowcell.setCellData("value", dataFields.bTestType);
                            Rowcell.setCellText((dataFields.bTestType == 0 ? "Sample Test" : "Total Test"));

                            Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 6);
                            DATEPICKER.setDate("fDatePicker_Grid_DueDate_Req", dataFields.iDueDate)
                            Rowcell.setCellText(DATEPICKER.getText("fDatePicker_Grid_DueDate_Req"));
                            Rowcell.setCellData("value", dataFields.iDueDate);

                            var bTestType = isNaN(parseInt(dataFields.bTestType)) ? 0 : parseInt(dataFields.bTestType);
                            var AllotedRowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 7);
                            if (bTestType == 0) {
                                OPTIONCONTROL.setFilter(AllotedRowcell.ColumnAttribute.ctrlid, REQUISITION.strSampleCheckUsers);
                            } else if (bTestType == 1) {
                                OPTIONCONTROL.setFilter(AllotedRowcell.ColumnAttribute.ctrlid, REQUISITION.strTotalCheckUsers);
                            }

                            //debugger
                            var urlPath = REQUISITION.GetQualityControlAreaName("GetExtraFieldsData", "Requisition", eVersion.Version10);
                            var fnResult = NETWORK.executeServerMethod(urlPath, true, { iScreenId: MRPScreens.TestDefinition, Id: dataFields.iTestDefHeaderId, bHeader: true }, "json", false, "");
                            if (fnResult.data != null && fnResult.data.length > 0) {
                                var iTotalColumns = FGRIDCONTROL.getTotalColumns("Id_RequisitionDetails_FGrid");
                                var iCount = 0;
                                for (var k = 13 + REQUISITION.lstReqExtrBodyData.length; k <= iTotalColumns; k++) {
                                    cell = FGRIDCONTROL.getCellObject("Id_RequisitionDetails_FGrid", (cellobj.iRow), k);
                                    if (cell.ColumnAttribute.ctrltype == "TestDefExtrafield") {
                                        iCount++;
                                        var element = document.getElementById(cell.ColumnAttribute.ctrlid);
                                        if (fnResult.data[iCount - 1] != null && fnResult.data[iCount - 1] != "") {
                                            if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.StringList) {
                                                cell.setCellText(element.options[fnResult.data[iCount - 1] - 1].text, element.options[fnResult.data[iCount - 1] - 1].value);
                                            } else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Date) {
                                                DATEPICKER.setDate(cell.ColumnAttribute.ctrlid, fnResult.data[iCount - 1]);
                                                cell.setCellText(DATEPICKER.getText(cell.ColumnAttribute.ctrlid));
                                                cell.setCellData("value", fnResult.data[iCount - 1]);
                                            }
                                            else if (cell.ColumnAttribute.datatypeid == MasterDataTypeEnum.Master) {
                                                OPTIONCONTROL.setControlValue(cell.ColumnAttribute.ctrlid, fnResult.data[iCount - 1])
                                                cell.setCellText(OPTIONCONTROL.getControlText(cell.ColumnAttribute.ctrlid));
                                                cell.setCellData("value", fnResult.data[iCount - 1]);
                                            }
                                            else {
                                                cell.setCellText(fnResult.data[iCount - 1], fnResult.data[iCount - 1]);
                                            }
                                        } else {
                                            cell.setCellText("", "");
                                        }
                                    }
                                }
                            }

                        }
                        else {
                            FGRIDCONTROL.clearRowData(GridID, cellobj.iRow);
                            COMMON.prototype.showMessage(sTextName + " Already Added", REQUISITION.REQUISITIONMsgs.lblErrorMsg);
                            return false;
                        }
                        break;
                    case 3:
                    case 4:
                    case 5:
                        cellobj.processDefault(event);
                        break;
                    case 6:
                        if (document.getElementById("ReqHeaderId").value == 0) {
                            Rowcell = FGRIDCONTROL.getCellObject(GridID, cellobj.iRow, 2)
                            if (Rowcell.getCellData("value") != "" && Rowcell.getCellData("value") != undefined) {
                                cellobj.setCellData("value", DATEPICKER.getDate(cellobj.ColumnAttribute.ctrlid));
