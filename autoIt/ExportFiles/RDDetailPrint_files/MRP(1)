    // On Next Schedule button Click
    // On Next button Click Plan the Next node  
    OnNextScheduleClick: function () {
        //debugger;
        ////if (MRPProductionOrderDetails.bIncludeMoldInCapacityOrMachinePlanning) {
        ////    document.getElementById("btnSplit").style.display = "";
        ////}
        document.getElementById("btnSplit").style.display = "";

        MRPProductionOrderDetails.lstSplitPlanScheduleData = [];
        MRPProductionOrderDetails.lstSplitPlanScheduleDataOnHold = [];
        MRPProductionOrderDetails.CurrentNode = MRPProductionOrderDetails.CurrentNode + 1;
        var iCurrentNode = MRPProductionOrderDetails.CurrentNode;
        var SelectedData = [];
        var Index = 0;
        var id = "FirstManualSchedulingDiv_" + (MRPProductionOrderDetails.CurrentNode - 1);
        var elm = {};
        var elms = document.getElementById(id).getElementsByTagName("table");
        for (var i = 0; i < elms.length; i++) {
            if (elms[i].id == "PlanSchedulePopUpTable1") {
                elm = elms[i];
                break;
            }
        }

        var tbody = elm.children[0];
        var NoOfRows = tbody.children.length;
        for (var i = 2; i < NoOfRows; i++) {
            var Element = tbody.children[i].children[6].children[0];
            if (Element.checked) {
                var objManualSchedulingReportData = MRPProductionOrderDetails.lstManualSchedulingData[Index];
                SelectedData.push(objManualSchedulingReportData);
            }
            Index = Index + 1;
        }

        MRPProductionOrderDetails.lstSelectedPlanScheduleData[iCurrentNode - 1] = SelectedData;

        //debugger
        var iScheduleStartDate = DATEPICKER.getDate(MRPProductionOrderDetails.ScheduleStartDateId);
        var iScheduleStartTime = FTIMECONTROL.getTime(MRPProductionOrderDetails.ScheduleStartTimeId);

        var urlPath = "";
        if (window.GlobalPref.Version == eVersion.Version10) {
            urlPath = GLOBAL.getContextPath("PlanSchedulePopUp", "MRPPoductionHierarchy", "MRP");
        } else {
            urlPath = GLOBAL.getContextPath("PlanSchedulePopUp", "ManualScheduling", "MRP");
        }
        NETWORK.executeServerMethod(urlPath,
                     true,
                    {
                        iProductId: MRPProductionOrderDetails.iProductId,
                        sProdOrderNo: MRPProductionOrderDetails.sProductionOrderNo,
                        sProductName: MRPProductionOrderDetails.sProductName,
                        sProductCode: MRPProductionOrderDetails.ProductCode,
                        iRoutingId: MRPProductionOrderDetails.iRoutingId,
                        dQuantity: MRPProductionOrderDetails.dQuantity,
                        iScheduleStartDate: iScheduleStartDate,
                        iScheduleStartTime: iScheduleStartTime,
                        bHoldSchedules: true,
                        PlanScheduleDataToHold: null,
                        lstPlanScheduleDataOnHold: MRPProductionOrderDetails.lstPlanScheduleDataOnHold,
                        iCurrentNode: MRPProductionOrderDetails.CurrentNode,
                        lstSelectedPlanScheduleData: MRPProductionOrderDetails.lstSelectedPlanScheduleData,
                        DueDate: MRPProductionOrderDetails.DueDate,
                        iSchStartDateTime: MRPProductionOrderDetails.iSchStartDateTime
                    },
                     "HTML", true,
                    "MRPProductionOrderDetails.OnPlanScheduleClick_onSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");

