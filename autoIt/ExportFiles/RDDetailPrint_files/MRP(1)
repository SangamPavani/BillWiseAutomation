    // Toggle Between Parameters and PRT tools Tab
    ToggleWCTab: function (ele, tabId, event) {
        try {
            event.preventDefault();
            if ($(ele).hasClass("active") == true) {
                return false;
            }
            $("#TestDefTabs li").removeClass("active");
            $(ele).addClass("active");
            if (window.GlobalPref.Version == eVersion.Version10) {
                $("#TestDefTabs a").removeClass("active");
                $(ele.children[0]).addClass("active");
            }
            var divId;
            var actClass = (window.GlobalPref.Version == eVersion.Version10) ? "active" : "active in";
            $("#TestDefTabs li").each(function () {
                divId = $(this).children(':first-child').attr("href");
                $(divId).css("display", "none");
                $(divId).removeClass(actClass);
            });
            divId = $(ele).children(':first-child').attr("href");
            $(divId).fadeIn(50);
            $(divId).addClass(actClass);
        }
        catch (e) {
            COMMON.prototype.showMessage("Exception: {TESTDEFINITION.ToggleWCTab} " + e.message, TESTDEFINITION.TESTDEFINITIONMsgs.lblErrorMsg);
        }
    },
