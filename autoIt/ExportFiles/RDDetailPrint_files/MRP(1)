                    //cellobj.setCellText("");
                    //var element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    //cellobj.setControl(element, cellobj.getCellData("value"));
                    cellobj.processDefault();
                }
                else {
                    cellobj.processDefault();
                }
            }
            return (true);
        }
        catch (er) {
            COMMON.prototype.showMessage("Exception: {PO_SERIES.onBOMTagGridCellChange} " + err.message, "Exception");
        }
