    // Save production order series details
    SaveProductionOrderSeries: function () {
        var totalRows = FGRIDCONTROL.getTotalRows("Id_ProductionOrderSeries_Grid");
        var arrPOSeriesData = [];
        var SeqNo = 0;        
        //debugger;
        for (var i = 0; i < totalRows; i++) {
            var iFieldId = -1;
            var rowData = FGRIDCONTROL.getRowValue("Id_ProductionOrderSeries_Grid", (i + 1));
            if (rowData[0].Value > 0) {
                if (rowData[3].Value <= 0) {
                    //COMMON.prototype.showMessage("No Of character Should be greater than Zero(0) ","Error Message");
                    COMMON.prototype.showMessage(PO_SERIES.PO_SERIESMsgs.MRP_POS_msgNoOfCharactersShouldBeGreaterThanZero, PO_SERIES.PO_SERIESMsgs.lblErrorMsg);
                    return false;
                }
                if (rowData[1].Text == "" || rowData[1].Text=="undefined") {
                    //COMMON.prototype.showMessage("Field/Value Should not be Empty ", "Error Message");
                    COMMON.prototype.showMessage(PO_SERIES.PO_SERIESMsgs.MRP_POS_msgFieldValueShouldNotBeEmpty, PO_SERIES.PO_SERIESMsgs.lblErrorMsg);
                    return false;
                }

                if (rowData[0].Value == 1) {
                    iFieldId = rowData[1].Value;
                }

                var model = {
                    Type: rowData[0].Value,
                    FieldOrValue: rowData[1].Text,
                    StartingChatacter: rowData[2].Value,
                    NoOFChatacter: rowData[3].Value,
                    VoucherType: 24576,
                    Seq: SeqNo,
                    iFieldId: iFieldId,
                }
                arrPOSeriesData.push(model);
                SeqNo++;
            }
        }
        var hasIncremental = false;
        if (arrPOSeriesData.length > 0) {
            for (var i = 0; i < arrPOSeriesData.length; i++) {
                if (arrPOSeriesData[i].Type == 5) {
                    hasIncremental = true;
                    break;
                }
            }
        }
        var prefixPO = document.getElementById("chkPrefixProdOrderNo_ParentToChild").checked;
        var canSave = false;
        if (prefixPO == true && arrPOSeriesData.length == 0) {
            canSave = true;
        }
        else if (arrPOSeriesData.length > 0 && hasIncremental == true) {
            canSave = true;
        }
        else {
            if (hasIncremental == false) {
                //COMMON.prototype.showMessage("Enter Incremental Type to Save Production Order Series", "Error Message");
                COMMON.prototype.showMessage(PO_SERIES.PO_SERIESMsgs.MRP_POS_msgEnterIncrementalTypeToSaveProductionOrderSeries, PO_SERIES.PO_SERIESMsgs.lblErrorMsg);
            }
            canSave = false;
            return false;
        }
        if (canSave == true) {
            var objMainModel = {
                lstProductionOrderSeries: arrPOSeriesData,
                bPrefixProdOrder: prefixPO,
            }
            var urlPath = GLOBAL.getContextPath("SaveProductionOrderSeriesDefinition", "ProductionOrderSeries", "MRP");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { objPOSeries: objMainModel }, "", true, "PO_SERIES.SaveProductionOrderSeries_onSuccess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        }
    },

