                    PlannedQty = parseFloat(cellobj.CellData.value);
                }
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "AlreadyRecievedQty") {
                    {
                        AlreadyReceivedQty = parseFloat(cellobj.CellData.value);
                    }
                }
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "ProductName") {
                    iProductId = cellobj.CellData.value;
                }
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "WorkCenter") {
                    var objWC = OPTIONCONTROL.getControlDataObject(cellobj.ColumnAttribute.ctrlid);
                    WCPlannedQty = objWC.fQty;
                    WCAlreadyReceivedQty = objWC.WCReceivedQty;
                    dRemainingQtyForWC = WCPlannedQty - WCAlreadyReceivedQty;

                }
                if (cellobj.ColumnAttribute.ctrlatt.trim() == "QtyToReceive") {
                    data = parseFloat(cellobj.CellData.value);
                    break;
                }
            }

            var AllQuantity = 0;
            for (var i = 0; i < FGRIDCONTROL.getTotalRows(sGridCtrlId); i++) {
                var obj = FGRIDCONTROL.getCellObject(sGridCtrlId, i + 1, cellobj.iColumn);
                var iRowProduct = FGRIDCONTROL.getCellObject(sGridCtrlId, i + 1, RF_PRODUCTION.arrBodyTags.length + 3).CellData.value;
                if (iProductId == iRowProduct) {
                    if (obj.ColumnAttribute.ctrlatt.trim() == "QtyToReceive" && RF_PRODUCTION.arrRFPProductData[i].iOutPutType == 0 && i + 1 != cellobj.iRow) {
                        //data = parseFloat(data) + parseFloat(obj.sText);
                        AllQuantity = parseFloat(AllQuantity) + parseFloat(obj.CellData.value);
                    }
                }
                else {
                    // item  can be intermediate or bi product or wastage are not considered in split qty option
                }
            }
            data = parseFloat(data) + parseFloat(AllQuantity);

            if (RF_PRODUCTION.DontAllowToReceiveMoreQuantityThanRequired) {
                if (data == null || data == "") {
                    data = parseFloat(0).toFixed(RF_PRODUCTION.dNoOfDecimals);
                    stext = parseFloat(0).toFixed(RF_PRODUCTION.dNoOfDecimals);
                }
                if (RF_PRODUCTION.objMRPPreference.bConsiderToleranceInReceipts) {
                    var dProdQty = PlannedQty + AlreadyReceivedQty;
                    var dTolerance = RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dTolerancePer;
                    if (dTolerance > 0) {
                        var dTolValue = (dProdQty * dTolerance) / 100;
                        //if (data < (dProdQty - dTolValue)) {
                        //    COMMON.prototype.showMessage("Quantity To Be Receive Cannot be Less than " + (dProdQty - dTolValue), RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                        //    return false;
                        //}
                        if (data > (dProdQty + dTolValue)) {
                            COMMON.prototype.showMessage("Quantity To Be Receive Cannot be More than " + (dProdQty + dTolValue), RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                            return false;
                        }
                    } else {
                        if (PlannedQty > 0) {
                            if ((PlannedQty - AlreadyReceivedQty) < parseFloat(data)) {
                                data = parseFloat(0).toFixed(RF_PRODUCTION.dNoOfDecimals);
                                stext = parseFloat(0).toFixed(RF_PRODUCTION.dNoOfDecimals);
                                //COMMON.prototype.showMessage("Quantity To Receive Can not be Greater than " + PlannedQty, "Error Message");
                                COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgQuantityToReceiveCannotBeGreaterThan + " " + PlannedQty, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                            }
                        }
                    }
                } else {
                    if (PlannedQty > 0) {
                        if ((PlannedQty - AlreadyReceivedQty) < parseFloat(data)) {
                            data = parseFloat((PlannedQty - AlreadyReceivedQty)).toFixed(RF_PRODUCTION.dNoOfDecimals);
                            stext = parseFloat((PlannedQty - AlreadyReceivedQty)).toFixed(RF_PRODUCTION.dNoOfDecimals);
                            cellobj.setCellData("value", data);
                            cellobj.setCellText(stext);
                            //COMMON.prototype.showMessage("Quantity To Receive Can not be Greater than " + PlannedQty, "Error Message");
                            COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgQuantityToReceiveCannotBeGreaterThan + " " + (PlannedQty - AlreadyReceivedQty), RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                            return false;
                        }
                    }
                }
            }
            else {
                if (RF_PRODUCTION.bPostReceiptWorkCenterwise) {
                    if (parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty) == PlannedQty) {
                        if (parseFloat(data) + parseFloat(WCAlreadyReceivedQty) > parseFloat(WCPlannedQty)) {
                            COMMON.prototype.showMessage("Workcenter Quantity Exceeded ", RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                            data = 0;
                            stext = 0;
                            FGRIDCONTROL.gotoNextCell(document.getElementById(sGridCtrlId), cellobj.iRow, cellobj.iColumn - 1);
                            //return false;
                        }
                    }
                    else {
                        var dRemainingQtyOverAll = parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty) - parseFloat(AlreadyReceivedQty);
                        var dQty = 0;
                        if (dRemainingQtyForWC <= dRemainingQtyOverAll) {
                            dQty = dRemainingQtyForWC;
                        }
                        else {
                            dQty = data;//dRemainingQtyOverAll;
                        }
                        data = dQty;
                        stext = parseFloat(dQty).toFixed(RF_PRODUCTION.dNoOfDecimals);
                    }
                }
            }
            if (parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty) < PlannedQty) {
                if (parseFloat(data) + AlreadyReceivedQty > parseFloat(RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].dPartialReleasedQty)) {
                    COMMON.prototype.showMessage(RF_PRODUCTION.RF_PRODUCTIONMsgs.ReleaseFullQuantityForReceivingofExcessQuantity, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
                    data = 0;
                    stext = 0;
                    FGRIDCONTROL.gotoNextCell(document.getElementById(sGridCtrlId), cellobj.iRow, cellobj.iColumn - 1);
                    //return false;
                }
            }
            if (RF_PRODUCTION.iLastProcess == RF_PRODUCTION.ObjRowData.iProcessId) {
                if ((PlannedQty - AlreadyReceivedQty) <= parseFloat(data)) {
                    var bMain = RF_PRODUCTION.arrRFPProductData[cellobj.iRow - 1].bMainProduct;
                    if (bMain == true) {
                        //if (confirm("Do you want to Close Receipt from Production ?")) {
                        if (confirm(RF_PRODUCTION.RF_PRODUCTIONMsgs.MRP_RF_msgDoYouWantToCloseReceiptFromProduction)) {
                            RF_PRODUCTION.arrRFPProductData[0].iStatus = 4;
                            document.getElementById("RFProduction_Close").checked = true;
                        }
                    }
                }
            }

            if (data - AllQuantity > 0) {
                data = parseFloat(data) - parseFloat(AllQuantity);
            }

            //RF_PRODUCTION.iQtyColumnNo = cellobj.iColumn;
            //RF_PRODUCTION.ObjRowData.dQtReceive = parseFloat(data);
            //if (cellobj.iRow == RF_PRODUCTION.arrObjRowData) {
                //RF_PRODUCTION.arrObjRowData[cellobj.iRow - 1] = RF_PRODUCTION.ObjRowData;
            //} else {
                //RF_PRODUCTION.arrObjRowData.push(RF_PRODUCTION.ObjRowData);
            //}
            if (data == 0) {
                //COMMON.prototype.showMessage("Quantity Cannot be zero", "Error Message");
                FGRIDCONTROL.gotoNextCell(document.getElementById(sGridCtrlId), cellobj.iRow, cellobj.iColumn - 1);
            }
            return true;
        } catch (e) {
            //COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.QuantityToReceiveValidation} " + e.message, "Error Message");
            COMMON.prototype.showMessage("Exception: {RF_PRODUCTION.QuantityToReceiveValidation} " + e.message, RF_PRODUCTION.RF_PRODUCTIONMsgs.lblErrorMsg);
        }
    }
