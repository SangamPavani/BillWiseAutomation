                        ProductUnitCell.setCellText(UnitCellCodes.sName)
                        ProductUnitCell.setCellData("value", UnitCellCodes.sName);
                    }
                    break;
                case 3://Item Code
                    break;
                case 4://UnitId
                    break;
                case 5://Quantity
                    var element = document.getElementById(CellObj.ColumnAttribute.ctrlid);
                    CellObj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(element.value, 2)), element.value);
                    CellObj.setCellData("value", element.value);
                    break;
                default:
                    CellObj.processDefault(event);
                    break;
            }
        }
        else {
            switch (CellObj.iColumn) { //Enter Event
                case 1:
                    element = document.getElementById(CellObj.ColumnAttribute.ctrlid);
                    CellObj.setControl(element, CellObj.getCellData("value"));
                    break;
                case 2:
                    element = document.getElementById(CellObj.ColumnAttribute.ctrlid);
                    CellObj.setControl(element, CellObj.getCellData("value"));
                    break;
                case 3:
                    break;
                case 4:
                    break;
                case 5:
                    element = document.getElementById(CellObj.ColumnAttribute.ctrlid);
                    CellObj.setControl(element, CellObj.getCellData("value"));
                    break;
                default:
                    CellObj.processDefault(event);
                    break;
            }
        }
        var ControlValue = OPTIONCONTROL.getControlValue(CellObj.ColumnAttribute.ctrlid);
        if (CellObj.iRow == FGRIDCONTROL.getTotalRows(GridId) && ControlValue > 0) {
            FGRIDCONTROL.insertRows(GridId, 0, 1);
