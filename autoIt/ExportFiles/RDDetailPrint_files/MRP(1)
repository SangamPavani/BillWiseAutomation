    //Calculate Costing Percentage..
    CalculateCostingPer: function (objcell) {
        //debugger;       
        var iRowCount = 0;
        var dCostPer = 100;

        var sGridId = "Id_OutPutBOMProcess_Grid";
        var totalRows = FGRIDCONTROL.getTotalRows(sGridId);
        for (var i = 0; i < totalRows; i++) {
            var RowCellcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 1);
            var iProcessIdvalue = RowCellcount.getCellData("value");
            if (iProcessIdvalue > 0) {
                iRowCount++;
            }
        }

        if (iRowCount > 0) {
            for (var i = 0; i < iRowCount; i++) {
                var RowCellcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 1);
                var iProcessIdvalue = parseFloat(RowCellcount.getCellData("value"));

                var RowcolCostingPerEditedcount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 10);
                var scolCostingPerEdited = RowcolCostingPerEditedcount.getCellData("value");
                if (iProcessIdvalue < 0)
                    continue;

                if (iProcessIdvalue > 0 && scolCostingPerEdited == "True") {
                    var RowcolCostingPercount = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 9);
                    var dCostPerCent = RowcolCostingPercount.getCellData("value");

                    if (dCostPerCent > 100) {
                        var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 9);
                        cell.setCellText(parseFloat(100));
                        cell.setCellData("value", parseFloat(100));
                        for (var k = 0; k < iRowCount; k++) {
                            if (i != k) {
                                var cell = FGRIDCONTROL.getCellObject(sGridId, (k + 1), 9);
                                cell.setCellText(parseFloat(0).toFixed(BOM_PROCESS.NoofDecimals));
                                cell.setCellData("value", parseFloat(0));
                            }
                        }
                        break;
                    }
                    else if ((dCostPer - dCostPerCent) < 0) {
                        var dtempper = 100 - dCostPerCent;
                        dtempper = dtempper / (iRowCount - 1);
                        for (var k = 0; k < iRowCount; k++) {
                            if (i != k) {
                                var cell = FGRIDCONTROL.getCellObject(sGridId, (k + 1), 9);                                
                                cell.setCellText(parseFloat(dtempper).toFixed(BOM_PROCESS.NoofDecimals));
                                cell.setCellData("value", parseFloat(dtempper));
                            }
                        }
                        break;
                    }
                    else {
                        var RowcolCostingPer = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 9);
                        var dcolCostingPer = parseFloat(RowcolCostingPer.getCellData("value"));
                        dCostPer = dCostPer - parseFloat(dcolCostingPer);
                    }
                }
                else {
                    var dTempCost = Math.round(dCostPer / (iRowCount - i), 2);
                    if ((dTempCost * (iRowCount - i)) == dCostPer) {
                        dCostPer = dCostPer - dTempCost;
                    }
                    else {
                        dTempCost = dTempCost + (dCostPer - (dTempCost * (iRowCount - i)));
                        dCostPer = dCostPer - dTempCost;
                    }
                    var cell = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 9);
                    if (cell.CellData.value == "" || cell.CellData.value == 0 || cell.CellData.value == undefined) {                       
                        cell.setCellText(parseFloat(dTempCost).toFixed(BOM_PROCESS.NoofDecimals));
                        cell.setCellData("value", parseFloat(dTempCost));
                    }           
                    var cellOType = FGRIDCONTROL.getCellObject(sGridId, (i + 1), 4);
                    if (cellOType.CellData.value == "") {
                        cell.setCellText(parseFloat(0));
                        cell.setCellData("value", parseFloat(0));
                    }
                }
            }
        }

    },
