                            objCell.setControl(element, objCell.getCellData("value"));
                        }
                    } else {
                        element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                        objCell.setControl(element, objCell.getCellData("value"));
                    }
                }
                else if (objCell.ColumnAttribute.ctrldbl == "txtExtraInfo") {
                    objCell.processDefault(event);
                }
                else if (objCell.ColumnAttribute.ctrlid == "txtRemarks_PIO") {
                    element = document.getElementById(objCell.ColumnAttribute.ctrlid);
                    objCell.setControl(element, objCell.getCellData("value"));

                }
