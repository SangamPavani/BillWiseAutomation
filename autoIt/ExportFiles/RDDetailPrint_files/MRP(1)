    LoadExtraFieldsBodyData: function () {
        //debugger
        var FinalExtraBody = [];
        var sGridName = "Id_ReleaseJobOrder_Grid";
        var TotalRows = FGRIDCONTROL.getTotalRows(sGridName);
        var TotalColumns = FGRIDCONTROL.getTotalColumns(sGridName);
        var arrBodyExtra = RELEASEJOBORDER.arrExtraFieldBody;
        var k = 0;

        for (var j = 0; j < TotalRows; j++) {
            var lst = [];
            var checked = false;
            for (var i = 0; i < TotalColumns; i++) {
                cellobj = FGRIDCONTROL.getCellObject(sGridName, j + 1, i + 1);
                var rowvalue = FGRIDCONTROL.getRowValue(sGridName, j + 1);
                var sattr = cellobj.ColumnAttribute.ctrltags;
                if (sattr == undefined && sattr == null) {
                    continue;
                } else if (sattr == "ExtraField") {
                    var objTag = {};
                    for (var t = 0; t < arrBodyExtra.length; t++) {
                        if (arrBodyExtra[t].sFieldName == cellobj.ColumnAttribute.ctrlatt) {
                            var iValue = parseInt(cellobj.ColumnAttribute.ctrltagvalue);
                            if (iValue == 0 || iValue == 6 || iValue == 1)//textbox
                                objTag.objFieldValue = rowvalue[i].Value;
                            else
                                if (iValue == 4)//date
                                    objTag.objFieldValue = parseFloat(rowvalue[i].Value);
                                else if (iValue == 12)//optioncontrol{
                                    objTag.objFieldValue = parseFloat(rowvalue[i].Value);
                                else if (iValue == 9)
                                    objTag.objFieldValue = rowvalue[i].Value;
                                else if (iValue == 8)
                                    objTag.objFieldValue = rowvalue[i].Value;
                                else if (iValue == 5) // Time Control
                                    objTag.objFieldValue = rowvalue[i].Value;

                            objTag.iFieldId = parseInt(cellobj.ColumnAttribute.ctrlfieldvalue);
                            objTag.bBody = true;

                            if (parseInt(cellobj.ColumnAttribute.ctrlmandatory) == 1) {
                                if (rowvalue[i].Value == null || rowvalue[i].Value == "") {
                                    RELEASEJOBORDER.sError = "Select Mandatory Value in " + cellobj.ColumnAttribute.ctrlatt;
                                    return false;
                                }
                            }
                            lst.push(objTag);
                        }
                    }
                }

                else {
                    break;
                }
            }
            cellobj = FGRIDCONTROL.getCellObject(sGridName, j + 1, 1);
            checked = cellobj.getCheckboxState();
            if (checked == true) {
                if (lst == 0)
                    break;
                FinalExtraBody[k] = lst;
                k++;
            }

        }
        return FinalExtraBody;
    },
