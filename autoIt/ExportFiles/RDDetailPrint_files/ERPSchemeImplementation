    BifercateCombAndUnCombSchemes: function (AllValidSchemes, CombinedSchemes, UnCombinedSchemes) {
        try {
            if (AllValidSchemes.SchemesList != null && AllValidSchemes.SchemesList != undefined) {
                CombinedSchemes.SchemesList = [];
                UnCombinedSchemes.SchemesList = [];

                if (AllValidSchemes.SchemesList.length > 0) {
                    for (let i = 0; i < AllValidSchemes.SchemesList.length; i++) //_Scheme
                    {
                        if (AllValidSchemes.SchemesList[i] == null)
                            continue;
                        var _CombinedList = AllValidSchemes.SchemesList[i].SchemesBodyList.filter((f) => f.CombineWithOtherSchemes == true);
                        if (_CombinedList != null && _CombinedList.length > 0) {
                            let _Local = Object.assign({}, AllValidSchemes.SchemesList[i]);
                            _Local.SchemesBodyList = [];

                            for (let j = 0; j < _CombinedList.length; j++) //_Body
                                _Local.SchemesBodyList.push(_CombinedList[j]);

                            CombinedSchemes.SchemesList.push(_Local);
                        }

                        var _UnCombinedList = AllValidSchemes.SchemesList[i].SchemesBodyList.filter((f) => f.CombineWithOtherSchemes == false);
                        if (_UnCombinedList != null && _UnCombinedList != undefined && _UnCombinedList.length > 0) {
                            let _Local1 = Object.assign({}, AllValidSchemes.SchemesList[i]);
                            _Local1.SchemesBodyList = [];

                            for (let j = 0; j < _UnCombinedList.length; j++) //_Body
                                _Local1.SchemesBodyList.push(_UnCombinedList[j]);

                            UnCombinedSchemes.SchemesList.push(_Local1);
                        }
                    }
                }
            }

            if (AllValidSchemes.FreeSchemesList != null && AllValidSchemes.FreeSchemesList != undefined
                && AllValidSchemes.FreeSchemesList.length > 0) {
                CombinedSchemes.FreeSchemesList = [];
                UnCombinedSchemes.FreeSchemesList = [];
                for (let i = 0; i < AllValidSchemes.FreeSchemesList.length; i++) //_FreeScheme
                {
                    if (AllValidSchemes.FreeSchemesList[i] == null)
                        continue;
                    if (AllValidSchemes.FreeSchemesList[i].Criteria.CombineWithOtherSchemes == true)
                        CombinedSchemes.FreeSchemesList.push(AllValidSchemes.FreeSchemesList[i]);
                    else
                        UnCombinedSchemes.FreeSchemesList.push(AllValidSchemes.FreeSchemesList[i]);
                }
            }

            if (AllValidSchemes.SchemeDiscntsList != null && AllValidSchemes.SchemeDiscntsList != undefined
                && AllValidSchemes.SchemeDiscntsList.length > 0) {
                CombinedSchemes.SchemeDiscntsList = [];
                UnCombinedSchemes.SchemeDiscntsList = [];
                for (let i = 0; i < AllValidSchemes.SchemeDiscntsList.length; i++) //_DiscDef
                {
                    if (AllValidSchemes.SchemeDiscntsList[i] == null)
                        continue;
                    let _CombinedDiscDef = Object.assign({}, AllValidSchemes.SchemeDiscntsList[i]);
                    let _UnCombinedDiscDef = Object.assign({}, AllValidSchemes.SchemeDiscntsList[i]);

                    if (AllValidSchemes.SchemeDiscntsList[i].Payments != null && AllValidSchemes.SchemeDiscntsList[i].Payments != undefined
                        && AllValidSchemes.SchemeDiscntsList[i].Payments.length > 0) {
                        let _CombinedPayments = AllValidSchemes.SchemeDiscntsList[i].Payments.filter((p) => p.CombineWithOtherSchemes == true);
                        let _UnCombinedPayments = AllValidSchemes.SchemeDiscntsList[i].Payments.filter((p) => p.CombineWithOtherSchemes == false);

                        _CombinedDiscDef.Payments = _CombinedPayments;
                        _UnCombinedDiscDef.Payments = _UnCombinedPayments;
                    }

                    if (AllValidSchemes.SchemeDiscntsList[i].Members != null && AllValidSchemes.SchemeDiscntsList[i].Members != undefined
                        && AllValidSchemes.SchemeDiscntsList[i].Members.length > 0) {
                        let _CombinedMembers = AllValidSchemes.SchemeDiscntsList[i].Members.filter((p) => p.CombineWithOtherSchemes == true);
                        let _UnCombinedMembers = AllValidSchemes.SchemeDiscntsList[i].Members.filter((p) => p.CombineWithOtherSchemes == false);

                        _CombinedDiscDef.Members = _CombinedMembers;
                        _UnCombinedDiscDef.Members = _UnCombinedMembers;
                    }

                    if (AllValidSchemes.SchemeDiscntsList[i].Employees != null && AllValidSchemes.SchemeDiscntsList[i].Employees != undefined
                        && AllValidSchemes.SchemeDiscntsList[i].Employees.length > 0) {
                        let _CombinedEmployees = AllValidSchemes.SchemeDiscntsList[i].Employees.filter((p) => CombineWithOtherSchemes == true);
                        let _UnCombinedEmployees = AllValidSchemes.SchemeDiscntsList[i].Employees.filter((p) => CombineWithOtherSchemes == false);

                        _CombinedDiscDef.Employees = _CombinedEmployees;
                        _UnCombinedDiscDef.Employees = _UnCombinedEmployees;
                    }

                    if ((_CombinedDiscDef.Payments != null && _CombinedDiscDef.Payments != undefined && _CombinedDiscDef.Payments.length > 0)
                        || (_CombinedDiscDef.Members != null && _CombinedDiscDef.Members != undefined && _CombinedDiscDef.Members.length > 0)
                        || (_CombinedDiscDef.Employees != null && _CombinedDiscDef.Employees != undefined && _CombinedDiscDef.Employees.length > 0)) {
                        CombinedSchemes.SchemeDiscntsList.push(_CombinedDiscDef);
                    }

                    if ((_UnCombinedDiscDef.Payments != null && _UnCombinedDiscDef.Payments != undefined && _UnCombinedDiscDef.Payments.length > 0)
