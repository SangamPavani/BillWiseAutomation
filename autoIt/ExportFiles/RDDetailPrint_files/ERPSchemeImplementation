                    let freeExistingPrompt = ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList.filter((p) => FConvert.toInt(p.SchemeId) == FConvert.toInt(ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts[i].SchemeId)
