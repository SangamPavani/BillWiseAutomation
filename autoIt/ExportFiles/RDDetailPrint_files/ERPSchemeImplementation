                        if ((FConvert.toDecimal(dLineListQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) - FConvert.toDecimal(dCalPromptsQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) <= FConvert.toDecimal(0, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))
                            itemsMatchedInBill = itemsMatchedInBill.filter((p) => p.DefaultValue1 != CalculatedPrompts[i].ProductId);
                    }
                }

                ///Added this condition by Naveen on 08/08/2013 : In some cases itemsMatchedInBill is coming as null or 
                ///count is coming as zero that is the reason this condition is added.
                if (itemsMatchedInBill != null && itemsMatchedInBill != undefined && itemsMatchedInBill.length > 0) {
                    _Price = 0;
                    arrMin = [];
                    for (let i = 0; i < itemsMatchedInBill.length; i++) {
                        if (FConvert.toDecimal(itemsMatchedInBill[i].DefaultValue4, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) != 0)
                            arrMin.push(FConvert.toDecimal(itemsMatchedInBill[i].DefaultValue4, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                    }

                    _Price = Math.min(...arrMin);

                    let line = itemsMatchedInBill.filter((f) => FConvert.toDecimal(f.DefaultValue4, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) == FConvert.toDecimal(_Price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                    if (line != null && line != undefined && line.length > 0)
                        line = line[0];

                    _LowestPriceItem = ItemsList.filter((f) => f.ProductID == line.DefaultValue1 && f.Unit == line.ProductUnit);
                    if (_LowestPriceItem != null && _LowestPriceItem != undefined && _LowestPriceItem.length > 0)
                        _LowestPriceItem = _LowestPriceItem[0];
                }
            }
            else {
                _Price = 0;
                arrMin = [];
                for (let i = 0; i < ItemsList.length; i++) {
                    if (FConvert.toDecimal(ItemsList[i].Price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) != 0)
                        arrMin.push(FConvert.toDecimal(ItemsList[i].Price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                }

                _Price = Math.min(...arrMin);
                _LowestPriceItem = ItemsList.filter((f) => FConvert.toDecimal(f.Price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) == FConvert.toDecimal(_Price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                if (_LowestPriceItem != null && _LowestPriceItem != undefined && _LowestPriceItem.length > 0)
                    _LowestPriceItem = _LowestPriceItem[0];
            }

            return _LowestPriceItem;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementation.js :: Method :: ERPSCHEMEIMPLEMENTATION.GetLowestPriceItemForFreeItemsScreen_FreeItem :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
