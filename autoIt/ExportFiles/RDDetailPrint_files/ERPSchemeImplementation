                        && f.BodyId == prompt.BodyId
                        && f.Unit == prompt.Unit);
                    if (arrSchemeAppliedList != null && arrSchemeAppliedList != undefined && arrSchemeAppliedList.length > 0) {
                        for (let i = 0; i < arrSchemeAppliedList.length; i++)
