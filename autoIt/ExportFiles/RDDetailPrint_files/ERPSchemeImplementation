                                _HasOnlineSchemesData = true;
                            else if (FConvert.toInt(_filterdData[i].SchemesBodyList[j].DisctypeId) == 4)
                                _HasOnlineSchemesData = true;

                            if (_HasOnlineSchemesData == true)
                                break;
                        }
                        if (_HasOnlineSchemesData == true)
