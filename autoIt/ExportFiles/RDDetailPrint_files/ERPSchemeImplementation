    ImplementBillWiseSchemes: function (trans, schemeImplType) {
        let mbr = true;
        debugger;
        try {
            ERPSCHEMEIMPLEMENTATION.VARIABLES.SchemesPromptMsgs = [];
            ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts = [];
            ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList = [];
            ERPSCHEMEIMPLEMENTATION.VARIABLES.ConsiderRate = false;

            if (trans == null || trans.BodyData == null)
                return false;

            //Call Server method to load Voucher's Schemes
            ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes = ERPSCHEMEIMPLEMENTATION.GetProductToImplementSchemes(trans);

            if (ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes == null || ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes == undefined
                || ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes.length <= 0)
                return false;

            if (ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts != null && ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts != undefined
                && ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.length > 0) {
                let assignBodyIds = trans.BodyData.filter((p) => p.Sales != null && p.Sales != undefined && p.Sales.SchemeSource == 2 && p.Sales.SchemeBodyId == 0);
                if (assignBodyIds != null && assignBodyIds != undefined && assignBodyIds.length > 0) {
                    for (let i = 0; i < assignBodyIds.length; i++) {
                        let existingprompt = ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.filter((p) => p.SchemeId == assignBodyIds[i].Sales.SchemeId
                            && FConvert.toInt(p.FromScreen) == FConvert.toInt(assignBodyIds[i].Sales.SchemeSource)
                            && FConvert.toInt(p.ProductId) == FConvert.toInt(assignBodyIds[i].Sales.Product)
                            && FConvert.toInt(p.Unit) == FConvert.toInt(assignBodyIds[i].Sales.Unit));

                        if (existingprompt != null && existingprompt != undefined && existingprompt.length > 0)
                            assignBodyIds[i].Sales.SchemeBodyId = existingprompt[0].BodyId;
                    }
                }
            }

            debugger;
            ERPSCHEMEIMPLEMENTATION.LoadPropertiesOfSchemesImplemenationClass(SchemeImplementedType.get("ONBILL"));
            if (ERPSCHEMEIMPLEMENTATION.VARIABLES.SelectedMember != null && ERPSCHEMEIMPLEMENTATION.VARIABLES.SelectedMember != undefined) {
                ERPSCHEMEIMPLEMENTATION.VARIABLES.MemberTypeId = ERPSCHEMEIMPLEMENTATION.VARIABLES.SelectedMember.MemberTypeId;
                ERPSCHEMEIMPLEMENTATION.VARIABLES.MemberId = ERPSCHEMEIMPLEMENTATION.VARIABLES.SelectedMember.ID;
            }

            let CombPrompts = [];
            let UnCombPrompts = [];

            if (ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasCombinedSchemesData == true && ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasUnCombinedSchemesData == true) {
                CombPrompts = ERPSCHEMEIMPLEMENTATION.GetPromptsListFromValidSchemes(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_CombinedSchemes, ERPSCHEMEIMPLEMENTATION.GetBillValue(), ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes);
                UnCombPrompts = ERPSCHEMEIMPLEMENTATION.GetPromptsListFromValidSchemes(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_UnCombinedSchemes, ERPSCHEMEIMPLEMENTATION.GetBillValue(), ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes);
                debugger;
                let _CombinedAmt = 0, _UnCombinedAmt = 0;
                if (CombPrompts != null && CombPrompts != undefined && CombPrompts.length > 0) {
                    for (let i = 0; i < CombPrompts.length; i++)
                        _CombinedAmt = FConvert.toDecimal(_CombinedAmt, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(CombPrompts[i].Amount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                }

                if (UnCombPrompts != null && UnCombPrompts != undefined && UnCombPrompts.length > 0) {
                    for (let i = 0; i < UnCombPrompts.length; i++)
                        _UnCombinedAmt = FConvert.toDecimal(_UnCombinedAmt, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(UnCombPrompts[i].Amount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                }

                debugger;
                if (Math.abs(_CombinedAmt) >= Math.abs(_UnCombinedAmt))
                    mbr = ERPSCHEMEIMPLEMENTATION.ApplyCombinedSchemes(trans);
                else
                    mbr = ERPSCHEMEIMPLEMENTATION.ApplyUnCombinedSchemes(UnCombPrompts, trans);
            }
            else if (ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasCombinedSchemesData == true && ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasUnCombinedSchemesData == false)
                mbr = ERPSCHEMEIMPLEMENTATION.ApplyCombinedSchemes(trans);
            else if (ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasCombinedSchemesData == false && ERPSCHEMEIMPLEMENTATION.VARIABLES.m_HasUnCombinedSchemesData == true) {

                UnCombPrompts = ERPSCHEMEIMPLEMENTATION.GetPromptsListFromValidSchemes(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_UnCombinedSchemes, ERPSCHEMEIMPLEMENTATION.GetBillValue(), ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes);
                mbr = ERPSCHEMEIMPLEMENTATION.ApplyUnCombinedSchemes(UnCombPrompts, trans);
            }

            //debugger;
            if (schemeImplType == SchemeImplementedType.get("LINEWISE")) {
                for (let i = 0; i < ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList.length; i++)
                    ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList[i].SchemeImplType = (ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList[i].SchemeImplType == SchemeImplementedType.get("ONBILL") && ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList[i].PromoType == PromoTypes.get("FREEITEM") ? schemeImplType : ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList[i].SchemeImplType);
            }

            ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes = ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes.filter((p) => p.PromoType == PromoTypes.get("NORMAL"));
            ERPSCHEMEIMPLEMENTATION.ShowSetDiscountInBillDefault();
            debugger;
            return mbr;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementation.js :: Method :: ERPSCHEMEIMPLEMENTATION.ImplementBillWiseSchemes :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return true;
        }
