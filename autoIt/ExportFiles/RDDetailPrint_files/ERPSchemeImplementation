    GetBestUnCombinedScheme: function (UnCombinedPrompts) {
        let _BestSchemeList = [];
        ////////////////////debugger;
        try {
            var groupedDemoClasses = ERPSCHEMEIMPLEMENTATION.COMMONMETHOD.GetDictionaryObjectSchemeIdFromScreen(UnCombinedPrompts);
            ////////////////////debugger;
            let _MaxAmount = 0;
            for (let i = 0; i < groupedDemoClasses.length; i++) {
                let _List = groupedDemoClasses[i].Value;
                let _Sum = 0;

                if (_List != null && _List != undefined && _List.length > 0) {
                    for (let j = 0; j < _List.length; j++)
                        _Sum = FConvert.toDecimal(FConvert.toDecimal(_Sum, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(_List[j].Amount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true), ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                }
                if (FConvert.toDecimal(_MaxAmount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) == FConvert.toDecimal(0, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                    _MaxAmount = FConvert.toDecimal(_Sum, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                    _BestSchemeList = _List;
                }
                else if (FConvert.toDecimal(_Sum, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) >= FConvert.toDecimal(_MaxAmount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                    _MaxAmount = FConvert.toDecimal(_Sum, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                    _BestSchemeList = _List;
                }
            }
            return _BestSchemeList;
