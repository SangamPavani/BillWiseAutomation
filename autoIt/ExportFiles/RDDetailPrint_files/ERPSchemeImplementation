    GetLowestPriceItemForFreeItemsScreen_FreeItem: function (ItemsList, LineList, CalculatedPrompts) {
        let _LowestPriceItem = null;
        let _Price = 0;
        let arrMin = [];
        try {
            let itemsMatchedInBill = ERPSCHEMEIMPLEMENTATION.GetAllItemsMatchedInBill(ItemsList);
            if (itemsMatchedInBill != null && itemsMatchedInBill != undefined && itemsMatchedInBill.length > 0) {
                if (CalculatedPrompts != null && CalculatedPrompts != undefined && CalculatedPrompts.length > 0) {
                    for (let i = 0; i < CalculatedPrompts.length; i++)//item
                    {
                        let dLineListQty = 0, arrLineList = LineList.filter((p) => p.DefaultValue1 == CalculatedPrompts[i].ProductId);
                        for (let j = 0; j < arrLineList.length; j++)
                            dLineListQty = dLineListQty + arrLineList[j].DefaultValue3;

                        let dCalPromptsQty = 0, arrCalculatedPrompts = CalculatedPrompts.filter((p) => p.DefaultValue1 == CalculatedPrompts[i].ProductId);
                        for (let j = 0; j < arrCalculatedPrompts.length; j++)
