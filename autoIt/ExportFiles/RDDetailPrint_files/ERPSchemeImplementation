    HasOnlineSchemesDataDefinedInSchemesScreen: function (SchemesList) {
        var _HasOnlineSchemesData = false;
        try {
            if (SchemesList != null && SchemesList != undefined && SchemesList.length > 0) {
                var _filterdData = SchemesList.filter((f) => f.SchemeTypeID == 2);
                if (_filterdData != null && _filterdData != undefined && _filterdData.length > 0) {
                    for (let i = 0; i < _filterdData.length; i++) {
                        for (let j = 0; j < _filterdData[i].SchemesBodyList.length; j++) {
                            if (FConvert.toInt(_filterdData[i].SchemesBodyList[j].DisctypeId) == 1)
                                _HasOnlineSchemesData = true;
                            else if (FConvert.toInt(_filterdData[i].SchemesBodyList[j].DisctypeId) == 2 && FConvert.toInt(_filterdData[i].SchemesBodyList[j].DiscountOn) == 3)
