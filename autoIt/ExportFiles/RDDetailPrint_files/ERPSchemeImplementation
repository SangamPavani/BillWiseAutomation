                        foundItemsList = null;
                    }
                    else if (ERPSCHEMEIMPLEMENTATION.VARIABLES.ShowSetName == true) {
                        let _foundItem = ERPSCHEMEIMPLEMENTATION.VARIABLES.LineList.filter((f) => f.ParentId == line1.ParentId
                            && (ERPSCHEMEIMPLEMENTATION.VARIABLES.ConsiderRate ? FConvert.toDecimal(f.DefaultValue4, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) != FConvert.toDecimal(0, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) : 0 == 0)
                            && f.ProductUnit == line1.ProductUnit);
                        if (_foundItem != null && _foundItem != undefined && _foundItem.length > 0) {
                            _foundItem = _foundItem[0];
                            let index = ERPSCHEMEIMPLEMENTATION.VARIABLES.LineList.IndexOf(_foundItem);
