                let _dProptionateValue = (FConvert.toDecimal(gross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(FSGHeaderData.DiscountD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) / FConvert.toDecimal(_dMatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                let discountAmt = FConvert.toDecimal(gross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) - FConvert.toDecimal(_dProptionateValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                let iProductId = _MatchedItems[i].DefaultValue1;
                if (_MatchedItems[i].ProductMake == 1)
