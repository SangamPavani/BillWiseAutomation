                            let toremovefromexistingprompts = ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.filter((p) => FConvert.toInt(p.PromoType) == PromoTypes.get("FREEITEM")
                                && FConvert.toInt(p.SchemeId) == FConvert.toInt(tempBody[i].Sales.SchemeId)
                                && FConvert.toInt(p.FromScreen) == FConvert.toInt(tempBody[i].Sales.SchemeSource)
