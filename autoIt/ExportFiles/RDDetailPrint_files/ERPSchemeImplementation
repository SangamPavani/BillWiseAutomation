    DoChangesRelatedToSchemesAddedInTransaction: function (trans) {
        //iBillAmtDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountAmount;
        //iBillPerDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountPer;
        ////debugger;

        //SchemesId, SchemesBodyId, 
        if (trans == null || trans == undefined || trans.BodyData == null || trans.BodyData == undefined || trans.BodyData.length <= 0)
            return;

        let iDiscountPercentageFieldld = transEntryInfo.Settings.VoucherScheme.iDiscountField;
        let iDiscountAmountFieldId = transEntryInfo.Settings.VoucherScheme.iAmountDiscountField;

        try {
            ////debugger;
            let productExistInTransaction = null;
            let tempBody = trans.BodyData;
            for (let i = 0; i < tempBody.length && i >= 0; i++) {
                if (tempBody[i].Flags.FreeQty == false) {
                    if (tempBody[i].Sales != null && tempBody[i].Sales != undefined && tempBody[i].Sales.SchemeId != null
                        && tempBody[i].Sales.SchemeId != undefined && tempBody[i].Sales.SchemeId > 0) {
                        if (ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts != null && ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts != undefined
                            && ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.length > 0) {
                            productExistInTransaction = ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.filter((p) => p.ProductId == tempBody[i].Sales.Product);
                            if (productExistInTransaction == null || productExistInTransaction == undefined || productExistInTransaction.length <= 0) {
                                if (tempBody[i].Sales.ScreenData != null && tempBody[i].Sales.ScreenData != undefined && tempBody[i].Sales.ScreenData.length > 0) {
                                    let discountPercentageColumn = tempBody[i].Sales.ScreenData.filter((p) => (p.FieldId & eVTFIELDFLAG.TOFLDID) == iDiscountPercentageFieldld)
                                    if (discountPercentageColumn != null && discountPercentageColumn != undefined && discountPercentageColumn.length > 0) {
                                        discountPercentageColumn = discountPercentageColumn[0];
                                        discountPercentageColumn.Input = 0;
                                        discountPercentageColumn.Value = 0;
                                    }
                                }
                            }
                        }
                        else if (ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts == null || ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts == undefined || ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.length <= 0) {
                            if (tempBody[i].Sales.ScreenData != null && tempBody[i].Sales.ScreenData != undefined && tempBody[i].Sales.ScreenData.length > 0) {
                                let discountPercentageColumn = tempBody[i].Sales.ScreenData.filter((p) => p.FieldId == iDiscountPercentageFieldld);
                                if (discountPercentageColumn != null && discountPercentageColumn != undefined && discountPercentageColumn.length > 0) {
                                    discountPercentageColumn = discountPercentageColumn[0];
                                    discountPercentageColumn.Input = 0;
                                    discountPercentageColumn.Value = 0;
                                }
                            }
                        }
                    }
                }
