    ApplyDiscountAmt_Scheme_OnItem: function (Scheme, SDD, FromScreen, MultiplyValue, Prompts, LineList, DoChanges) {
        try {
            ////////debugger;;
            let _MandatoryItemsMatchedInBill = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(SDD.MandatoryItemsList);
            //Logic to Calculate Discount Amount

            /*
                 * Suppose say there are there products matched say P1 - 400(Gross) , P2 - 200 , P3 - 200
                 * And the discount to be given is Rs 10
                 * Then calculate the each share value
                 * 
                 * Formula :  (Each Product Gross * Discount Value) / (Sum of Gross of all the three products)
                 * 
                 * 
            */

            let _DiscToBeGiven = FConvert.toDecimal(SDD.DiscountD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true), _MatchedItemsGross = 0;
            for (let i = 0; i < _MandatoryItemsMatchedInBill.length; i++)
                _MatchedItemsGross = FConvert.toDecimal(_MatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(_MandatoryItemsMatchedInBill[i].DefaultValue5, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

            for (let i = 0; i < _MandatoryItemsMatchedInBill.length; i++) {
                if (_MatchedItemsGross == 0)
                    continue;

                let _ProportionateValue = (FConvert.toDecimal(_MandatoryItemsMatchedInBill[i].DefaultValue5, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(_DiscToBeGiven, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) / FConvert.toDecimal(_MatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                let iProductId = _MandatoryItemsMatchedInBill[i].DefaultValue1;
                if (_MandatoryItemsMatchedInBill[i].ProductMake == 1)
                    iProductId = _MandatoryItemsMatchedInBill[i].ParentId;

                ////////debugger;
                ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, _MandatoryItemsMatchedInBill[i].DefaultValue2, Scheme.ID, Scheme.Name, _ProportionateValue, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, SDD.Id, _MandatoryItemsMatchedInBill[i].ProductMake, _MandatoryItemsMatchedInBill, PaymentTypes.get("DUMMY"), 0, _MandatoryItemsMatchedInBill[i].ProductUnit);
                ERPSCHEMEIMPLEMENTATION.DoChangesInBilling(LineList, DoChanges);
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementationSchemes.js :: Method :: ERPSCHEMEIMPLEMENTATIONSCHEME.ApplyDiscountAmt_Scheme_OnItem :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
    },
