                                iIndexPrompt = ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList.indexOf(freeExistingPrompt[j]);
                                if (iIndexPrompt >= 0)
                                    ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList.splice(iIndexPrompt, 1);
                            }
                            else {
                                ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts[i].FreeQty = ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts[i].FreeQtyToAdd = freeExistingPrompt[j].FreeQty;
                                iIndexPrompt = ERPSCHEMEIMPLEMENTATION.VARIABLES.PromptsToShowList.indexOf(freeExistingPrompt[j]);
