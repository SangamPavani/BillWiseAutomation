    AddToCriteriaSatisfiedList: function (Scheme, SDD, MandItemsQty, FreeItemCount, CriteriaSatisfiedList, LineList) {
        try {
            //debugger;
            let isProductsCriteriaStatisfied = true;
            if (SDD.MandatoryItemsList != null && SDD.MandatoryItemsList != undefined && SDD.MandatoryItemsList.length > 0) {
                if (Scheme.SchemeTypeID == 2) {
                    let _mandItemsCountInBill = ERPSCHEMEIMPLEMENTATION.GetMandatoryItemsCountInBill(SDD.MandatoryItemsList);
                    if (_mandItemsCountInBill < SDD.MinQtyI)
                        isProductsCriteriaStatisfied = false;
                }
                else
                    isProductsCriteriaStatisfied = ERPSCHEMEIMPLEMENTATIONSCHEME.CheckMandatoryProdsCriteria_OnBill(Scheme, 0, SDD);
            }

            //debugger;
            if (isProductsCriteriaStatisfied == false)
                return;

            let _dBillQty = MandItemsQty;
            let MultiplyValue = FConvert.toInt(Math.floor(_dBillQty / SDD.MaxQtyI));
            if (MultiplyValue < 1)
                MultiplyValue = 1;

            let _tempBillQty = 0;
            if (FConvert.toDecimal(MandItemsQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) > FConvert.toInt(SDD.MaxQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal))
                _tempBillQty = FConvert.toDecimal(SDD.MaxQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
            else
                _tempBillQty = FConvert.toDecimal(MandItemsQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

            let extnd = new Object();
            extnd.BodyData = SDD;
            extnd.MultiplyValue = MultiplyValue;
            extnd.IsQtyMulitplyValue = true;
            extnd.ItemQtyToConsider = _tempBillQty + FreeItemCount;
            CriteriaSatisfiedList.push(extnd);
            extnd = null;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementation.js :: Method :: ERPSCHEMEIMPLEMENTATION.AddToCriteriaSatisfiedList :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
