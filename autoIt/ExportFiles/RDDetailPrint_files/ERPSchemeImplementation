                            if (toremovefromexistingprompts != null && toremovefromexistingprompts != undefined && toremovefromexistingprompts.length > 0) {
                                for (let j = 0; j < toremovefromexistingprompts.length; j++) {
                                    let iIndex = ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.indexOf(toremovefromexistingprompts[j]);
                                    if (iIndex >= 0)
                                        ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.splice(iIndex, 1);
                                }
                            }

                            let count = freeitemsintrans.length;
                            for (let k = 0; k < freeitemsintrans.length; k++) {
                                let iIndexBody = tempBody.indexOf(freeitemsintrans[k]);
                                if (iIndexBody >= 0)
                                    tempBody.splice(iIndexBody, 1);
                            }
                            i = i - count;
                            continue;
                        }
                        else {
                            if (freeitemsintrans != null && freeitemsintrans != undefined && freeitemsintrans.length > 0) {
                                if (freeitemsintrans.length == 1) {
                                    let quantity = Math.abs(freeitemsintrans[0].Sales.Quantity);
                                    let freeqty = FConvert.toDecimal(toremoveprompts[0].FreeQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                                    if (quantity != freeqty)
                                        freeitemsintrans[0].Sales.Quantity = -freeqty;
                                }
                                else {
                                    let quantity = 0;
                                    for (let i = 0; i < freeitemsintrans.length; i++)
                                        quantity = FConvert.toDecimal(quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(freeitemsintrans[i].Sales.Quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                                    quantity = Math.abs(quantity);
                                    let freeqty = FConvert.toDecimal(toremoveprompts[0].FreeQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                                    if (FConvert.toDecimal(quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) != FConvert.toDecimal(freeqty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                                        let existfreePrompts = ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.filter((p) =>
