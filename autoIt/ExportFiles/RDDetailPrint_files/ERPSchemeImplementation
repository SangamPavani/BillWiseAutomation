    ApplyFixedPrice_FreeItems_QuantityBased_Group: function (FreeScheme, FSGHeaderData, FromScreen, MultiplyValue, Prompts, LineList, DoChanges, BaseItems) {
        try {
            ////debugger;
            ////debugger;
            let _MatchedItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(FSGHeaderData.BodyList);

            //If all the items are not present then return
            if (_MatchedItems != null && _MatchedItems != undefined && _MatchedItems.length <= 0) //&& _MatchedItems.length != FSGHeaderData.BodyList.length
                return;

            let ReCalculatedMultiplyValue = 0;
            for (let i = MultiplyValue; i > 0; i--) {
                let bIsQtySatsified = true;
                for (let j = 0; j < _MatchedItems.length; j++) {
                    let itemQtyInBaseUnits = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(_MatchedItems[j]);
                    if (FConvert.toDecimal(itemQtyInBaseUnits, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) < FConvert.toDecimal(FSGHeaderData.Quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                        bIsQtySatsified = false;
                        break;
                    }

                    let multiplyValue = FConvert.toInt(Math.floor(FConvert.toDecimal(itemQtyInBaseUnits, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(FSGHeaderData.Quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)));

                    if (multiplyValue < i) {
                        bIsQtySatsified = false;
                        break;
                    }
                }

                if (bIsQtySatsified == true) {
                    ReCalculatedMultiplyValue = i;
                    break;
                }
            }

            if (ReCalculatedMultiplyValue == 0)
                return;

            if (ReCalculatedMultiplyValue < MultiplyValue)
                MultiplyValue = ReCalculatedMultiplyValue;

            ////debugger;
            let _dMatchedItemsGross = 0;
            for (let i = 0; i < _MatchedItems.length; i++)//line
            {
                let lineCopy = Object.assign({}, _MatchedItems[i])
                lineCopy.DefaultValue3 = FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                let itemQtyInBaseUnits = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(lineCopy);

                let maxQtyToConsider = FConvert.toDecimal(FSGHeaderData.Quantity, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                let qtyToConsider = 0;
                if (FConvert.toDecimal(itemQtyInBaseUnits, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) < FConvert.toDecimal(maxQtyToConsider, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))
                    qtyToConsider = itemQtyInBaseUnits;
                else
                    qtyToConsider = maxQtyToConsider;

                let price = _MatchedItems[i].DefaultValue4;
                let mandatoryItem = FSGHeaderData.BodyList.filter((f) => f.ProductID == lineCopy.DefaultValue1);
                if (mandatoryItem != null && mandatoryItem != undefined && mandatoryItem.length > 0) {
                    mandatoryItem = mandatoryItem[0];
                    if (mandatoryItem.BaseUnit != lineCopy.ProductUnit)
                        price = ERPSCHEMEIMPLEMENTATION.COMMONMETHOD.GetProductRate(mandatoryItem);
                }

                let gross = FConvert.toDecimal(price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(qtyToConsider, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                _dMatchedItemsGross = FConvert.toDecimal(_dMatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + FConvert.toDecimal(gross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                lineCopy = null;
