    ApplyDiscountPerForSchemeDefinedOnBillAndCumulativeBill_ValueBased: function (Scheme, SDD, FromScreen, MultiplyValue, QtyToConsider, TotalBillValue, Prompts, LineList, DoChangesInBill) {
        //ref double _previousDiscount, ref double _DiscPerTotalBillValue, ref string _DiscPerPrevBodyIds
        try {
            ////////debugger;
            let _baseItems = [];
            if (SDD.MandatoryItemsList != null && SDD.MandatoryItemsList != undefined && SDD.MandatoryItemsList.length > 0)
                _baseItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(SDD.MandatoryItemsList);

            if (SDD.DiscountOn == 1 || SDD.DiscountOn == 4) //Lowest Price Item in the bill
            {
                //Lowest or Any Item Logic
                let _LowestPriceItem = ERPSCHEMEIMPLEMENTATION.GetLowestPriceItem_CustLineWise(LineList);
                let _dTotalDisc = 0, _billValueToConsider = TotalBillValue;
                _dTotalDisc = COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(SDD.DiscountD, _LowestPriceItem.DefaultValue5);
                let iProductId = _LowestPriceItem.DefaultValue1;
                if (_LowestPriceItem.ProductMake == 1)
                    iProductId = _LowestPriceItem.ParentId;

                ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, _LowestPriceItem.DefaultValue2, Scheme.ID, Scheme.Name, _dTotalDisc, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChangesInBill, SDD.Id, _LowestPriceItem.ProductMake, _baseItems, PaymentTypes.get("DUMMY"), 0, _LowestPriceItem.ProductUnit, SDD.DiscountD, DiscountType.Percentage);
                ERPSCHEMEIMPLEMENTATION.DoChangesInBilling(LineList, DoChangesInBill);
            }
            else if (SDD.DiscountOn == 2) //Highest Price Item in the bill
            {
                //Highest Price Item
                let _HighestPriceItem = ERPSCHEMEIMPLEMENTATION.GetHighestPriceItem(LineList);
                let _dTotalDisc = 0, _billValueToConsider = TotalBillValue;
                _dTotalDisc = COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(SDD.DiscountD, _HighestPriceItem.DefaultValue5);
                let iProductId = _HighestPriceItem.DefaultValue1;
                if (_HighestPriceItem.ProductMake == 1)
                    iProductId = _HighestPriceItem.ParentId;

                ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, _HighestPriceItem.DefaultValue2, Scheme.ID, Scheme.Name, _dTotalDisc, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChangesInBill, SDD.Id, _HighestPriceItem.ProductMake, _baseItems, PaymentTypes.get("DUMMY"), 0, _HighestPriceItem.ProductUnit, SDD.DiscountD, DiscountType.Percentage);
                ERPSCHEMEIMPLEMENTATION.DoChangesInBilling(LineList, DoChangesInBill);
            }
            else if (SDD.DiscountOn == 3) // On all considered items
            {
                //Items Considered Logic
                let _MatchedItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(SDD.MandatoryItemsList);
                if (_MatchedItems != null && _MatchedItems != undefined && _MatchedItems.length > 0) {
                    let _billValueToConsider = TotalBillValue;

                    for (let i = 0; i < _MatchedItems.length; i++) {
                        let gross = _MatchedItems[i].DefaultValue5;
                        let lineDisc = COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(SDD.DiscountD, gross);
                        let iProductId = _MatchedItems[i].DefaultValue1;
                        if (_MatchedItems[i].ProductMake == 1)
                            iProductId = _MatchedItems[i].ParentId;
                        ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, _MatchedItems[i].DefaultValue2, Scheme.ID, Scheme.Name, lineDisc, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChangesInBill, SDD.Id, _MatchedItems[i].ProductMake, _baseItems, PaymentTypes.get("DUMMY"), 0, _MatchedItems[i].ProductUnit, SDD.DiscountD, DiscountType.Percentage);
                    }

                    ERPSCHEMEIMPLEMENTATION.DoChangesInBilling(LineList, DoChangesInBill);
                }
                _MatchedItems = null;
            }
            else if (SDD.DiscountOn == 5) // on all items in the bill
            {
                //All Items
                let _billValueToConsider = TotalBillValue;
                let _dTotalDisc = COMMONMETHODS.UTILITYMETHODS.convertPercentageToValue(SDD.DiscountD, _billValueToConsider);

                if (ERPSCHEMEIMPLEMENTATION.VARIABLES.DummyBill != null && ERPSCHEMEIMPLEMENTATION.VARIABLES.DummyBill != undefined
                    && ERPSCHEMEIMPLEMENTATION.VARIABLES.DummyBill.length > 0) {
                    for (let i = 0; i < ERPSCHEMEIMPLEMENTATION.VARIABLES.DummyBill.length; i++) {
