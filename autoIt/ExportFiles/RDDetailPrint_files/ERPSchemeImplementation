    ApplyFixedPrice_Scheme_OnBillAndCumulativeBill_QuantityBased_Group: function (Scheme, SDD, FromScreen, MultiplyValue, Prompts, LineList, DoChanges) {
        try {
            let _matchedItemsInBill = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(SDD.MandatoryItemsList);

            //Fixed price cannot be applied as all the items defined for a group must present to avail fixed price.
            if (SDD.MandatoryItemsList == null || SDD.MandatoryItemsList == undefined
                || _matchedItemsInBill == null || _matchedItemsInBill == undefined
                || SDD.MandatoryItemsList.length != _matchedItemsInBill.length)
                return;
            let MaxQtyMultiplier = 1;
            if (_matchedItemsInBill != null && _matchedItemsInBill != undefined && _matchedItemsInBill.length > 0) {
                if (SDD.MinQtyI == SDD.MaxQtyI) {
                    let ReCalculatedMultiplyValue = 0;
                    for (let i = MultiplyValue; i > 0; i--) {
                        let bIsQtySatsified = true;
                        for (let j = 0; j < _matchedItemsInBill.length; j++) {
                            let itemQtyInBaseUnits = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(_matchedItemsInBill[j]);
                            if (FConvert.toDecimal(itemQtyInBaseUnits, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) < FConvert.toDecimal(SDD.MinQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                                bIsQtySatsified = false;
                                break;
                            }

                            let multiplyValue = FConvert.toInt(Math.floor(FConvert.toDecimal(itemQtyInBaseUnits, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(SDD.MaxQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)));
                            if (multiplyValue < i) {
                                bIsQtySatsified = false;
                                break;
                            }
                        }

                        if (bIsQtySatsified == true) {
                            ReCalculatedMultiplyValue = i;
                            break;
                        }
                    }

                    if (ReCalculatedMultiplyValue == 0) return;

                    if (FConvert.toDecimal(ReCalculatedMultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) < FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))
                        MultiplyValue = ReCalculatedMultiplyValue;
                    MaxQtyMultiplier = SDD.MaxQtyI * MultiplyValue;
                }
                else {
                    ///Logic added to implement below requirement
                    ///POS-20001:Scenario : scheme name : Test Unit For On Bill Scheme (Fixed Rate), if the Min Qty :1 and Max Qty : 3 and 
                    ///the mandatory items : 3 (100001, 100002, 100003), in the POS Main screnn, if I select the 3 mandatory items with 3 different Qty's as 1,2,3, 
                    ///then scheme is not getting applied. If the Qty for 3 items is 3, then only the scheme is getting applied
                    let ReCalculatedMultiplyValue = 0;
                    let BillQtyToConsider = 0;
                    for (let i = 0; i < _matchedItemsInBill.length; i++) {
                        let qty = 0;
                        qty = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(_matchedItemsInBill[i]);
                        BillQtyToConsider = BillQtyToConsider + qty;
                    }
                    let dMinQty = SDD.MinQtyI;
                    do {
                        ReCalculatedMultiplyValue = ReCalculatedMultiplyValue + 1;
                        BillQtyToConsider = BillQtyToConsider - SDD.MaxQtyI;
                    } while (BillQtyToConsider >= dMinQty);
                    if (ReCalculatedMultiplyValue <= 0) return;
                    if (ReCalculatedMultiplyValue < MultiplyValue) {
                        MultiplyValue = ReCalculatedMultiplyValue;
                    }

                    for (let i = 0; i < _matchedItemsInBill.length; i++) {
                        let qty = 0;
                        qty = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(_matchedItemsInBill[i]);
                        if (qty < MultiplyValue) {
                            MultiplyValue--;
                            i--;
                        }
                    }
                    if (MultiplyValue <= 0) return;
                }
            }

            let _dMatchedItemsGross = 0;
            for (let i = 0; i < _matchedItemsInBill.length; i++) {
                let matcheditemCopy = Object.assign({}, _matchedItemsInBill[i]);
                matcheditemCopy.DefaultValue3 = FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                let MandItemQty = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(matcheditemCopy);
                let price = _matchedItemsInBill[i].DefaultValue4;

                let mandatoryItem = SDD.MandatoryItemsList.filter((f) => f.ProductID == matcheditemCopy.DefaultValue1);
                if (mandatoryItem != null && mandatoryItem != undefined) {
                    if (mandatoryItem.length > 0)
                        mandatoryItem = mandatoryItem[0];

                    if (matcheditemCopy.BaseUnit != matcheditemCopy.ProductUnit)
                        price = ERPSCHEMEIMPLEMENTATION.COMMONMETHOD.GetProductRate(mandatoryItem);
                }

                _dMatchedItemsGross = FConvert.toDecimal(_dMatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) + (FConvert.toDecimal(MandItemQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                matcheditemCopy = null;
            }

            for (let i = 0; i < _matchedItemsInBill.length; i++) {
                let matcheditemCopy = Object.assign({}, _matchedItemsInBill[i]);
                matcheditemCopy.DefaultValue3 = FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                let MandItemQty = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(matcheditemCopy);
                let price = _matchedItemsInBill[i].DefaultValue4;

                let mandatoryItem = SDD.MandatoryItemsList.filter((f) => f.ProductID == matcheditemCopy.DefaultValue1);
                if (mandatoryItem != null && mandatoryItem != undefined) {
                    if (mandatoryItem.length > 0)
                        mandatoryItem = mandatoryItem[0];

                    if (mandatoryItem.BaseUnit != matcheditemCopy.ProductUnit)
                        price = ERPSCHEMEIMPLEMENTATION.COMMONMETHOD.GetProductRate(mandatoryItem);
                }

                let gross = (FConvert.toDecimal(MandItemQty, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(price, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                let _dProptionateValue = (FConvert.toDecimal(gross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(SDD.DiscountD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(MultiplyValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) / FConvert.toDecimal(_dMatchedItemsGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                let discountAmt = FConvert.toDecimal(gross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) - FConvert.toDecimal(_dProptionateValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);

                let iProductId = matcheditemCopy.DefaultValue1;
                if (matcheditemCopy.ProductMake == 1)
                    iProductId = matcheditemCopy.ParentId;

                ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, matcheditemCopy.DefaultValue2, Scheme.ID, Scheme.Name, discountAmt, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, SDD.Id, matcheditemCopy.ProductMake, _matchedItemsInBill, PaymentTypes.get("DUMMY"), 0, matcheditemCopy.ProductUnit);
            }
            ERPSCHEMEIMPLEMENTATION.DoChangesInBilling(LineList, DoChanges);
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementationSchemes.js :: Method :: ERPSCHEMEIMPLEMENTATIONSCHEME.ApplyFixedPrice_Scheme_OnBillAndCumulativeBill_QuantityBased_Group :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
        }
