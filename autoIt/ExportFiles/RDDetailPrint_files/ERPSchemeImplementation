    ApplyCombinedSchemes: function (trans) {
        try {
            debugger;
            ERPSCHEMEIMPLEMENTATION.VARIABLES.DummyBill = ERPSCHEMEIMPLEMENTATION.GetDummyBill();

            // Step 1 Implement schemes defined in free items screen.
            ERPSCHEMEIMPLEMENTATION.ImplementSchemesDefInFreeItemsScreenAtBillSttlement(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_CombinedSchemes);

            debugger;
            // Step 2 Implement schemes defined in schemes screen by filtering on free items discount type
            let _SchemesListCopy = ERPSCHEMEIMPLEMENTATION.VARIABLES.m_CombinedSchemes.SchemesList;
            ERPSCHEMEIMPLEMENTATION.VARIABLES.ImplementDiscAmtAndPerSchemesOnBillAndCumBill = false;
            let _FreeItemDiscountTypesList = _SchemesListCopy;
            if (_FreeItemDiscountTypesList != null && _FreeItemDiscountTypesList != undefined && _FreeItemDiscountTypesList.length > 0) {
                debugger;
                let CS_S_OnBill_Prompts = ERPSCHEMEIMPLEMENTATIONSCHEME.ApplyCombinedSchemes_Schemes_OnBill(_FreeItemDiscountTypesList, ERPSCHEMEIMPLEMENTATION.GetBillValue(), ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes, true);
                debugger;
                ERPSCHEMEIMPLEMENTATIONPROMPT.UpdatePromptsList(CS_S_OnBill_Prompts);
            }

            /* Till Step 2 all the free items that has to be given or about to give will have no effect on step 3
            * As in step 3 we have to consider bill quantity which is minus of free items quantity. This will be known only after
            * completing step 2 */

            //debugger;
            ERPSCHEMEIMPLEMENTATION.DoChangesRelatedToFreeItemsAddedInTransaction(trans);
            //debugger;

            // Step 3 Implement schemes defined in member discount screen.
            let _memberPrompts = [];
            ERPSCHEMEIMPLEMENTATIONDISCOUNTDEFINITION.ImplementSchemesDefinedInMemberDiscScreen(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_CombinedSchemes, ERPSCHEMEIMPLEMENTATION.GetBillValue(), _memberPrompts, ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes, true);
            ERPSCHEMEIMPLEMENTATIONPROMPT.UpdatePromptsList(_memberPrompts);

            // Step 4 Implement schemes defined in employee discount screen.
            let _employeePrompts = [];
            ERPSCHEMEIMPLEMENTATIONDISCOUNTDEFINITION.ImplementSchemesDefinedInEmployeeDiscScreen(ERPSCHEMEIMPLEMENTATION.VARIABLES.m_CombinedSchemes, ERPSCHEMEIMPLEMENTATION.GetBillValue(), _employeePrompts, ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes, true);
            ERPSCHEMEIMPLEMENTATIONPROMPT.UpdatePromptsList(_employeePrompts);

            ////////////////debugger;
            // Step 5 finally implement schemes defined in schemes screen with discount type as disc Amt, or Disc %
            ERPSCHEMEIMPLEMENTATION.VARIABLES.ImplementDiscAmtAndPerSchemesOnBillAndCumBill = true;
            let _NonFreeItemDiscountTypesList = _SchemesListCopy;
            if (_NonFreeItemDiscountTypesList != null && _NonFreeItemDiscountTypesList != undefined && _NonFreeItemDiscountTypesList.length > 0) {
                let CS_S_OnBill_Prompts = ERPSCHEMEIMPLEMENTATIONSCHEME.ApplyCombinedSchemes_Schemes_OnBill(_NonFreeItemDiscountTypesList, ERPSCHEMEIMPLEMENTATION.GetBillValue(), ERPSCHEMEIMPLEMENTATION.VARIABLES.ProductsToImplementSchemes, true);
                ERPSCHEMEIMPLEMENTATIONPROMPT.UpdatePromptsList(CS_S_OnBill_Prompts);
            }

            //////////////////debugger;
            ///Allowing Discount voucher pop up only when raising new POS sales  and collecting pre order
            if (ERPSCHEMEIMPLEMENTATION.VARIABLES.TransactionType == TransactionModes.get("NEWPOSSALES") || ERPSCHEMEIMPLEMENTATION.VARIABLES.TransactionType == TransactionModes.get("PREORDERCOLLECTION"))
                ERPSCHEMEIMPLEMENTATION.ShowDiscountVoucherPrompts();

            ////debugger;
            ERPSCHEMEIMPLEMENTATION.DoChangesRelatedToSchemesAddedInTransaction(trans);
            return true;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementation.js :: Method :: ERPSCHEMEIMPLEMENTATION.ApplyCombinedSchemes :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return true;
        }
