                            {
                                let _proportionateValue = FConvert.toDecimal(((FConvert.toDecimal(foundItemsList[i].DefaultValue5, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(discount, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) / FConvert.toDecimal(foundItemsListGross, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)), ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
