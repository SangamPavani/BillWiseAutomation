                ERPSCHEMEIMPLEMENTATIONPROMPT.AddToSchemePrompts(FromScreen, "", iProductId, _MatchedItems[i].DefaultValue2, FreeScheme.ID, FreeScheme.Name, discountAmt, PromoTypes.get("DISCOUNT"), 0, Prompts, DoChanges, FSGHeaderData.Id, _MatchedItems[i].ProductMake, BaseItems, PaymentTypes.get("DUMMY"), 0, _MatchedItems[i].ProductUnit);
            }

