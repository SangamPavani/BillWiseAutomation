    IsCriteriaSatisfied_FreeSchemes: function (FreeScheme, passingObject, LineList, BaseItems) {
        ////debugger;
        let _IsCriteriaSatisfied = false;
        try {
            if (FreeScheme.Criteria.CriteriaId == 1) {
                let _CountMandatoryItemsInBill = ERPSCHEMEIMPLEMENTATION.GetMandatoryItemsCountInBill(FreeScheme.Criteria.MandatoryItemsList);
                if (FConvert.toDecimal(_CountMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) >= FConvert.toDecimal(FreeScheme.Criteria.MinQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                    BaseItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(FreeScheme.Criteria.MandatoryItemsList);
                    _IsCriteriaSatisfied = true;
                    passingObject.MultiplyValue = FConvert.toInt(Math.floor(FConvert.toDecimal(_CountMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(FreeScheme.Criteria.MaxQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)));
                    if (passingObject.MultiplyValue < 1)
                        passingObject.MultiplyValue = 1;

                    passingObject.IsQtyMulitplyValue = true;
                }
            }
            else if (FreeScheme.Criteria.CriteriaId == 2) {
                let _ValueOfMandatoryItemsInBill = ERPSCHEMEIMPLEMENTATION.GetMandatoryItemsValueInBill(FreeScheme.Criteria.MandatoryItemsList);
                if (FConvert.toDecimal(_ValueOfMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) >= FConvert.toDecimal(FreeScheme.Criteria.MinValueD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)) {
                    BaseItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(FreeScheme.Criteria.MandatoryItemsList);
                    _IsCriteriaSatisfied = true;
                    let maxValue = FConvert.toDecimal(FreeScheme.Criteria.MaxValueD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                    passingObject.MultiplyValue = FConvert.toInt(Math.floor(FConvert.toDecimal(_ValueOfMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(maxValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true)));
                    if (passingObject.MultiplyValue < 1)
                        passingObject.MultiplyValue = 1;

                    passingObject.IsQtyMulitplyValue = false;
                }
            }
            else if (FreeScheme.Criteria.CriteriaId == 3) {
                let _CountMandatoryItemsInBill = ERPSCHEMEIMPLEMENTATION.GetMandatoryItemsCountInBill(FreeScheme.Criteria.MandatoryItemsList);
                let _ValueOfMandatoryItemsInBill = ERPSCHEMEIMPLEMENTATION.GetMandatoryItemsValueInBill(FreeScheme.Criteria.MandatoryItemsList);
                if ((FConvert.toDecimal(_CountMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) >= FConvert.toDecimal(FreeScheme.Criteria.MinQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))
                    && (FConvert.toDecimal(_ValueOfMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) >= FConvert.toDecimal(FreeScheme.Criteria.MinValueD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))) {
                    BaseItems = ERPSCHEMEIMPLEMENTATION.GetItemsMatchedInBill(FreeScheme.Criteria.MandatoryItemsList);
                    _IsCriteriaSatisfied = true;

                    let mulitplyValueFromQty = FConvert.toInt(FConvert.toDecimal(_CountMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(FreeScheme.Criteria.MaxQtyI, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));
                    let multiplyValueFromValue = FConvert.toInt(FConvert.toDecimal(_ValueOfMandatoryItemsInBill, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(FreeScheme.Criteria.MaxValueD, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true));

                    if (mulitplyValueFromQty == multiplyValueFromValue) {
                        //if both are equal then any one can be assigned to mulitplyvalue
                        passingObject.MultiplyValue = mulitplyValueFromQty;
                        passingObject.IsQtyMulitplyValue = true;
                    }
                    else if (mulitplyValueFromQty < multiplyValueFromValue) {
                        //if both are equal then any one can be assigned to mulitplyvalue
                        passingObject.MultiplyValue = mulitplyValueFromQty;
                        passingObject.IsQtyMulitplyValue = true;
                    }
                    else if (mulitplyValueFromQty > multiplyValueFromValue) {
                        //if both are equal then any one can be assigned to mulitplyvalue
                        passingObject.MultiplyValue = multiplyValueFromValue;
                        passingObject.IsQtyMulitplyValue = false;
                    }

                    if (passingObject.MultiplyValue < 1)
                        passingObject.MultiplyValue = 1;
                }
            }

            return _IsCriteriaSatisfied;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            COMMON.prototype.showMessage(Ex.message, "");
            console.log("DateTime :: " + new Date() + " :: File :: erpSchemeImplementationFreeItems.js :: Method :: ERPSCHEMEIMPLEMENTATIONFREEITEMS.IsCriteriaSatisfied_FreeSchemes :: Catch block :: Exception :: " + Ex.message + " :: Description :: " + Ex.description);
            return _IsCriteriaSatisfied;
        }
    },
