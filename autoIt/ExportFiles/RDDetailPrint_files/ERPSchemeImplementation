                                    let dValue = FConvert.toDecimal(ERPSCHEMEIMPLEMENTATION.VARIABLES.LineList[index].DefaultValue6, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) - FConvert.toDecimal(_proportionateValue, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
