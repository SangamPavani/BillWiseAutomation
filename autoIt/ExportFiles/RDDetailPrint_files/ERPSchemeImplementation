                passingObject.ItemQtyOrRate = FConvert.toDecimal(passingObject.ItemQtyOrRate, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * FConvert.toDecimal(xFactor, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
            }
            else {
                if (passingObject.UnitIdNamePair == null || passingObject.UnitIdNamePair == undefined || passingObject.UnitIdNamePair.length <= 0) {
                    let productsGroupData = new Object();
                    productsGroupData.IncludeEmptyRow = true;
                    productsGroupData.Products = [];
                    productsGroupData.Products.push({ Id: ProductId, UnitId: salesUnit });
                    passingObject.UnitIdNamePair = ERPSCHEMEIMPLEMENTATION.SERVERMETHOD.GetUnitsByProductId(productsGroupData);
                }

                if (passingObject.UnitIdNamePair != null && passingObject.UnitIdNamePair != undefined && passingObject.UnitIdNamePair.length > 0) {
                    let salesUnitData = passingObject.UnitIdNamePair.filter((f) => f.Id == salesUnit);
                    if (salesUnitData != null && salesUnitData != undefined) {
                        if (salesUnitData.length > 0)
                            salesUnitData = salesUnitData[0];

                        salesUnitData.Xfactor = FConvert.toDecimal(salesUnitData.Xfactor, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                        //Here idNamePair.Xfactor is item sales unit qty interms of base unit
                        if (FConvert.toDecimal(salesUnitData.Xfactor, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) < FConvert.toDecimal(0, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true))
                            passingObject.ItemQtyOrRate = FConvert.toDecimal(FConvert.toDecimal(passingObject.ItemQtyOrRate, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * (FConvert.toDecimal(salesUnitData.Xfactor, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) * -1), ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                        else
                            passingObject.ItemQtyOrRate = FConvert.toDecimal(FConvert.toDecimal(passingObject.ItemQtyOrRate, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true) / FConvert.toDecimal(salesUnitData.Xfactor, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true), ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                    }
                    else
                        passingObject.ItemQtyOrRate = FConvert.toDecimal(0, ERPSCHEMEIMPLEMENTATION.VARIABLES.NumberOfDecimal, true);
                }
            }
            //passingObject.ItemQtyOrRate = passingObject.ItemQtyOrRate.ToCompanyDecimal(IsQty, true);
        }
