                    let _qtyInBaseUnit = ERPSCHEMEIMPLEMENTATION.GetQtyAndPriceInInBaseUnit_CustLineWiseScheme(_matchedline);
                    if (FConvert.toDecimal(_addedQty) < FConvert.toDecimal(_qtyInBaseUnit)) {
                        let _prompt = new Object();
