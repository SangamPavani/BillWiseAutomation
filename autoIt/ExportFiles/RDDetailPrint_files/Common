                else {
                    ele = $('#ddlZAxisiLevel_' + sTrans);
                }
                ele.html('');
                ele.append('<option value=8 >Linear</option>');
                for (var i = 0; i < data.length; i++) {
                    var opt = '<option value=' + data[i] + '>' + data[i] + '</option>'
                    ele.append(opt);
                }
            }
        }
    },

