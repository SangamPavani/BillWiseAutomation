function ConnetLinkBetweenNode(linkpathData, ilineCount, linkConnectiondata) {
    if (GlobalTagValue != "") {
        $flowchart = GlobalTagValue;
        $flowchart.flowchart({
            multipleLinksOnInput: true,
            multipleLinksOnOutput: true,
            displayContextMenu: false,
            canUserEditLinks: false,
            fromDashboard: true
        });
        $(".flowchart-links-layer").css({ width: '100% !important' }, { overflow: 'initial' });
    }

    $flowchart.flowchart("createLink", ilineCount, linkConnectiondata);
    document.getElementById("line" + ilineCount).setAttribute('data-LinkPathId', linkpathData.LinkPathId);
    document.getElementById("line" + ilineCount).setAttribute('data-link_value', linkpathData.LinkValue);
    document.getElementById("line" + ilineCount).setAttribute('data-fromVoucher', linkpathData.FVoucher);
    document.getElementById("line" + ilineCount).setAttribute('data-toVoucher', linkpathData.TVoucher);
    document.getElementById("line" + ilineCount).setAttribute('data-FormLinkId', linkpathData.FromLinkId);
    document.getElementById("line" + ilineCount).setAttribute('data-ToLinkId', linkpathData.ToLinkId);
    if (linkpathData.LinkFields.length > 0) {
        SetLinkPathFields(linkpathData.LinkFields, ilineCount);
    }
}

function SetLinkPathFields(LinkFields, iLineCount) {
    var arrLinkdata = [];
    for (var i = 0; i < LinkFields.length; i++) {
        arrLinkdata.push(LinkFields[i].FieldId);
    }
    document.getElementById("line" + iLineCount).dataset.link_field_value = arrLinkdata;
}

