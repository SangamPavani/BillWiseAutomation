        var reportCaption = document.getElementById("Caption" + sTrans).value.trim();
        if (reportCaption != null && reportCaption == "") {
            COMMON.prototype.showMessage(DashletResourceMsgs.msgReportCaption, "Focus10");
            //NewGraph.ShowErrorMessage(DashletResourceMsgs.msgReportCaption); //"Enter Report Caption"
            document.getElementById("Caption" + sTrans).focus();
            return false;
        }
        var graph = 0;
        var layoutId = 0;
        var reportdata = REPORTVIEW.GetRepRecordData(true, undefined, 'dashletReport_' + dashReportId);
        var dashletID = document.getElementById("DashletsId" + sTrans).value.trim();
        //////debugger;
        if (reportdata == false) {
            COMMON.prototype.showMessage(DashletResourceMsgs.msgMTP_Record, "Focus10");
            //NewGraph.ShowErrorMessage(DashletResourceMsgs.msgMTP_Record); //"Select the record first"
            return false;
        }
        //////debugger;
        if (reportdata != null) {
            layoutId = reportdata.LayoutId;
        }
        if (layoutId < 0 || layoutId == '') {
            COMMON.prototype.showMessage(DashletResourceMsgs.msgSelectLayout, "Focus10");
            //NewGraph.ShowErrorMessage(DashletResourceMsgs.msgSelectLayout); //"Select Layout"
            return false;
        }
        if (FCommon.UI.isValidObject(document.getElementById('DateOptions_' + DashletId))) {
            SelectedDateOptions = document.getElementById('DateOptions_' + DashletId).selectedIndex;
        }
        if (SelectedDateOptions != 1) {
            Startdate = DATEPICKER.getDate('id_starting_date_' + DashletId);
            if (Startdate < iAccDate) {
                COMMON.prototype.showMessage(DashletResourceMsgs.msgStartDateCantbeLessThanFinancialDate, msgs.Error);
                return;
            }
        }

        var graphType = 0;
        var theme = 0;
        var legendPlace = 0;
        var isGraph = document.getElementById("chkGraph" + sTrans).checked;
        if (isGraph) {
            if (reportdata != null) {
                GetOptionData = reportdata.GraphOption;
            }
            graphType = graphtype;
            theme = sGraphTheme[0];
            legendPlace = bGraphlegendPosition[0];
            //if (GetOptionData == null) {
            //    if (reportdata != null) {
            //        GetOptionData = reportdata.GraphOption;
            //    }
            //}
            try {
                if (GetOptionData != undefined && GetOptionData != null) {
                    reportdata.GraphOption = GetOptionData; graph = true;
                    bGraphBtnClicked = false;
                }
                else {
                    COMMON.prototype.showMessage(DashletResourceMsgs.msgGraphOption, "Focus10");
                    //NewGraph.ShowErrorMessage(DashletResourceMsgs.msgGraphOption); //"Select Graph Option"
                    document.getElementById("dvgraphOption_dashletReport_" + dashReportId).focus();
                    return false;
                }
            }
            catch (err) {
                if (err != null && err != "") {
                    COMMON.prototype.showMessage(DashletResourceMsgs.msgGraphOption, "Focus10");
                    //NewGraph.ShowErrorMessage(DashletResourceMsgs.msgGraphOption); //"Select Graph Option"
                    document.getElementById("dvgraphOption_dashletReport_" + dashReportId).focus();
                    return false;
                }
            }
        }
        if (isGraph) {
            isGraph = 1;
        }
        else
            isGraph = 0;

        var customReportID = document.getElementById("CustomReportId" + sTrans).value.trim();
        var moduleid = document.getElementById("ModuleId" + sTrans);
        var moduletypeid = moduleid.options[moduleid.selectedIndex].value.trim();
        var isuser = $("#rdo_user").is(':checked') ? true : $("#rdo_role").is(':checked') ? false : true;
        var UserOrRoleIds = [];
        var divdashletsetid = isuser == true ? "div_dashlet_setting_binduser" : "div_dashlet_setting_bindrole";
        $("#" + divdashletsetid + " input[type=checkbox]").each(function (index, value) {
            // ////debugger
            if (value.checked) {
                UserOrRoleIds.push(value.id);
            }
        })
        var dsfiltervalues = [];
        $("#div_filter input[type=checkbox]").each(function (index, value) {
            ////debugger
            if (value.checked) {
                var objref = {
                    iMasterTypeId: value.id,
                    bRefresh: 0
                };
                dsfiltervalues.push(objref);
            }
        })
        $("#div_refresh input[type=checkbox]").each(function (index, value) {
            ////debugger
            if (value.checked) {
                var objref = {
                    iMasterTypeId: value.id,
                    bRefresh: 1
                };
                dsfiltervalues.push(objref);
            }
        })
        var dashletData = {
            DashletsId: dashletID,
            CustomReportId: customReportID,
            DashletName: reportName,
            ExpressionHeading: reportCaption,
            Type: isGraph,
            DashletType: 2,
            ModuleId: moduletypeid,
            GraphType: graphType,
            Themes: theme,
            LegendPosition: legendPlace,
            IsUser: isuser,
            UserOrRoleIds: UserOrRoleIds,
            TransDashletFilter: dsfiltervalues,
            DashboardId: parseInt($("#hid_reportdashboardid" + sTrans).val()),
        };
        if (bTrans) {
            var urlPath = GLOBAL.getContextPath("SaveDashlet", "Dashboard", "Dashboard");
            var result = NETWORK.executeServerMethod(urlPath, true, { objDashlet: dashletData, objReport: reportdata, dashletId: DashletId, selectedWorkflows: arrSelectedWorkFlows }, "JSON", true, "NewGraph.RefreshTransDashboard", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        }
        else {
            var urlPath = GLOBAL.getContextPath("SaveDashlet", "Dashboard", "Dashboard");
            var result = NETWORK.executeServerMethod(urlPath, true, { objDashlet: dashletData, objReport: reportdata, dashletId: DashletId, selectedWorkflows: arrSelectedWorkFlows }, "JSON", true, "NewGraph.RefreshDashboard", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        }
