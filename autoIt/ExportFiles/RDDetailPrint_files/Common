                                iYear = iMonth < DATE.prototype.getMonthFromFocusDate(parseInt(accDate)) ? iYear - 1 : iYear;
                                iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(accDate));
                                iDay = DATE.prototype.getDayFromFocusDate(parseInt(accDate));
                                data[i].RepRecordParameters.StartingDate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                                data[i].RepRecordParameters.EndingDate = iDashlettodaydate;
                                break;
                            case 10://Last Financial Year
                                var cYear = iYear - 1;

                                var lastfinstartdate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, cYear);
                                var iDay1 = DATE.prototype.getDayFromFocusDate(parseInt(accDate));
                                var iMonth1 = DATE.prototype.getMonthFromFocusDate(parseInt(accDate));//DATE.prototype.getMonthFromFocusDate(parseInt(iLastYrEnd));
                                var iYear1 = DATE.prototype.getYearFromFocusDate(parseInt(accDate));

                                if (iDay1 == 1) {
                                    if (iMonth1 == 1) {
                                        iMonth1 = 12;
                                        iYear1 = iYear1 - 1;
                                    }
                                    else {
                                        iMonth1 = iMonth1 - 1;
                                    }
                                    iDay1 = REPORTVIEW.getLastDayoftheMonth(iMonth1);
                                }
                                else {
                                    iDay1 = iDay1 - 1;
                                }
                                var lastfinenddate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, iYear1);
                                data[i].RepRecordParameters.StartingDate = lastfinstartdate;
                                data[i].RepRecordParameters.EndingDate = lastfinenddate;
                                break;
                            case 11://Yesterday
                                iYear = iMonth == 1 && iDay == 1 ? iYear - 1 : iYear;
                                iMonth = iMonth == 1 && iDay == 1 ? 12 : iDay == 1 ? iMonth - 1 : iMonth;
                                iDay = iDay == 1 ? FDate.maxDays(iMonth, iYear, calType) : iDay - 1;
                                data[i].RepRecordParameters.StartingDate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                                data[i].RepRecordParameters.EndingDate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                                break;
                            case 12: //CurrentQuarter
                                iDiff = iMonth >= 4 && iMonth <= 6 ? 4 : iMonth >= 6 && iMonth <= 9 ? 7 : iMonth >= 9 && iMonth <= 12 ? 10 : iMonth >= 1 && iMonth <= 3 ? 1 : iMonth;
                                data[i].RepRecordParameters.StartingDate = DATE.prototype.convertIntoFocusDate(1, iDiff, iYear);

                                iDiff = iMonth >= 4 && iMonth <= 6 ? 6 : iMonth >= 6 && iMonth <= 9 ? 9 : iMonth >= 9 && iMonth <= 12 ? 12 : iMonth >= 1 && iMonth <= 3 ? 3 : iMonth;
                                data[i].RepRecordParameters.EndingDate = DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iYear);
                                break;
                            case 13: //PreviousQuarter
                                iTempCalc = iMonth < 4 ? iYear - 1 : iYear;
                                iDiff = iMonth >= 4 && iMonth <= 6 ? 1 : iMonth >= 6 && iMonth <= 9 ? 4 : iMonth >= 9 && iMonth <= 12 ? 7 : iMonth >= 1 && iMonth <= 3 ? 10 : iMonth;
                                data[i].RepRecordParameters.StartingDate = DATE.prototype.convertIntoFocusDate(1, iDiff, iTempCalc);

                                iDiff = iMonth >= 4 && iMonth <= 6 ? 3 : iMonth >= 6 && iMonth <= 9 ? 6 : iMonth >= 9 && iMonth <= 12 ? 9 : iMonth >= 1 && iMonth <= 3 ? 12 : iMonth;
                                data[i].RepRecordParameters.EndingDate = DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iTempCalc);
                                break;
                        }
                        if (data[i].Dashlets.GraphType == 17) {
                            data[i].Dashlets.GraphType = 18;
                        }
                        if (data[i].RepRecordParameters.ReportId == FocusReport.ListingOfDocument) {
                            if (data[i].RepRecordParameters.Inputs.length > 5) {
                                if (data[i].RepRecordParameters.Inputs[5].Value.length > 0) {
                                    arrSelectedWorkFlows = data[i].RepRecordParameters.Inputs[5].Value;
                                    data[i].RepRecordParameters.Inputs[5].ID = -1;
                                    data[i].RepRecordParameters.Inputs[5].Value = null;
                                }
                            }
                        }
                    }
                    reportdata = { repRecord: data[i].RepRecordParameters, OutputScreen: outputType, dashletDivId: "dashletReport_" + data[i].DashletId + "_" + data[i].RepRecordParameters.ReportId, mainDashId: "DBRepdashlate" + i, divHeight: data[i].Height, DashletName: data[i].DashletName };//This is stroring due to use of Globalfilter in Report.
                    arrReptGlobalfilter.push(reportdata);
                    dashletReportData.push({ daslets: data[i].Dashlets, dashletid: "dashletReport_" + data[i].DashletId + "_" + data[i].RepRecordParameters.ReportId });
                    REPORT_GENERATION.DashRepGeneration_Report({ objRec: data[i].RepRecordParameters, OutputScreen: outputType, dashletId: "dashletReport_" + data[i].DashletId + "_" + data[i].RepRecordParameters.ReportId, gTheme: data[i].Dashlets.Themes, glengendPosition: data[i].Dashlets.LegendPosition, graphtype: data[i].Dashlets.GraphType, iContainerId: "DBRepdashlate" + i }, outputType, "DBRepdashlate" + i, data[i].Height);
                }
                else if (data[i].DashletType == 6) {
                    DataStatisticsData();
                }
                else if (data[i].DashletType == 3) {
                    WorkFlow_Generation.GenerateWorkflow(data[i].DashletId, "DBdashlate" + i)
                }
                else if (data[i].DashletType == 9) {
                    QUERYREPORT_GENERATION.DashboardQueryReport(data[i].DashletId, "DBdashlate" + i, data[i].Dashlets);
                }
            }
        }
        else {
            if (chkMaxView == 0) {
                COMMON.prototype.showMessage(sResourceMessage.DashletNotAvailable, "Focus10");
            }
            else {
                $("#FullScreenFooter").show().text(sResourceMessage.DashletNotAvailable);
                $("#FullScreenFooter").css("color", "red")
                setTimeout(function () { $("#FullScreenFooter").hide(); }, 100);
            }
        }

        $(".maximizeDashlet").dblclick(function () {

            if ($(".DashletLoader").is(':visible') == false && $("#Dashboard_ModalMaximize").is(':visible') == false) {
