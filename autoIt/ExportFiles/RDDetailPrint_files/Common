var REPORT_GENERATION = {
    DashboardGeneration_Report: function (ReportParams, outputType, dsId, iContainerHeight) {
        NETWORK.executeServerMethod(GLOBAL.getContextPath("ClearReportSelectedRows", "Dashboard", "Dashboard"), true,
            { iReportId: ReportParams.objRec.ReportId }, "JSON", false);
        //debugger
        var fnResult = NETWORK.executeServerMethod(GLOBAL.getContextPath("ReportParamsforInfo", "RD", "RD"), true, { objRepRec: ReportParams.objRec, ArrInputs: arrReportFilter, bTrans: true });
        if (fnResult != null) {
            ReportParams.objRec = fnResult.data;
        }
        //ReportDivId = dsId;
        //ReportType = outputType;
        //iRptContainerHt = iContainerHeight;
        //////debugger
        // $("#" + dsId).empty();
        ListOfReportsInDashboard = [];
        var result = REPORT.getRepRecView(ReportParams, '', true);
        if (result.data != null && result.data.sValue != "No transaction exists for the selected master(s).") {
            //////debugger
            setTimeout(REPORT_GENERATION.GenerationReport, 100, [result.data, outputType, dsId, iContainerHeight]);
        }
        else {
            // alert("Internal Server Error.");
        }
    },

    DashRepGeneration_Report: function (ReportParams, outputType, dsId, iContainerHeight) {
        //debugger;
        NETWORK.executeServerMethod(GLOBAL.getContextPath("ClearReportSelectedRows", "Dashboard", "Dashboard"), true,
            { iReportId: ReportParams.objRec.ReportId }, "JSON", false);
        UIContainer.show(ePageContainerType.Dashboard);
        //ReportDivId = dsId;
        var objRParams = {
            dashContId: dsId,
            dashRptId: ReportParams.dashletId,
            outputType: outputType
        }
        repDashId.push(objRParams);
        ReportType = outputType;
        iRptContainerHt = iContainerHeight;
        ////debugger
        ListOfReportsInDashboard = [];
        REPORT.getRepRecView(ReportParams, "REPORT_GENERATION.SetReportGenerationData");
        bReportGraph = true;
	
    },

    SetReportGenerationData: function (flag, data) {
        if (data != null) {
        //debugger;
            for (var i = 0; i < repDashId.length ; i++) {
                // dRptCount = dRptCount + 1;
                if (data.sValue == "No transaction exists for the selected master(s).") {
                    $("#" + repDashId[i].dashContId).find('.DashletLoader').remove();
                    // $("#" + repDashId[i].dashContId).append(data);
                }
                else {
                    if (data.search(repDashId[i].dashRptId.toString()) > 0) {
                        if (isReportBacktrack_Graph) {
                            setTimeout(REPORT_GENERATION.GenerationReport, 100, [data, repDashId[i].outputType, "ReportBackTrackModal9", iRptContainerHt]);
                        } else {
                            setTimeout(REPORT_GENERATION.GenerationReport, 100, [data, repDashId[i].outputType, repDashId[i].dashContId, iRptContainerHt]);
                        }
                        break;
                    }
                }
            }
        }
        else {
            alert("Internal Server Error.");
        }
    },

    GenerationReport: function (data) {
        var outputType = data[1];
        var dashId = data[2];
        var repData = data[0];
        var iContainerHeight = data[3];

        if(bReportMaxView == false)
            $("#" + dashId).contents(':not(#divheader)').remove();
        if (outputType == "Graph") {
            $("#" + dashId).append(repData).find("#Graphviewheading").remove();
        }
        else {
            $("#" + dashId).append(repData).find("#dvReportDetails").find(".dvtblRdRender").css('height', iContainerHeight);
        }
        $(".footerdiv").remove();
        $(".Graphviewheading").remove();

        var loaderId = 0;
        if(bFromTrans)
            loaderId = dashId.substring(16, dashId.length);
        else
            loaderId = dashId.substring(13, dashId.length);
        GRAPH_GENERATION.LoadingEnd(loaderId);
    },
};

