    AddLevels: function (flag, data, xAxis) {
        //debugger
        if (data.Error != "") {
            COMMON.prototype.showMessage("{NewGraph.AddLevels} " + data.Error, "Exception");
            return false;
        }

        var data = data.lstLevels
        if (flag == true) {
            if (data != null & data.length > 0) {
                var ele = null;
                if (xAxis) {
                    ele = $('#ddliLevel_' + sTrans);
