function LoadDefultTransDashboard(obj, sMethod, sWorkflowMethod) {
    try {
        ////debugger
        //DashboardId = dashId;
        var dashId = obj.iDashboardId;
        DashboardId = dashId;
        var TransFilter = obj.arrFilter;
        if (TransFilter == undefined) {
            TransFilter = null;
        }
        if (sMethod == undefined) {
            sMethod = null;
        }
        if (sWorkflowMethod == undefined) {
            sWorkflowMethod = null;
        }
        arrTransFilter = TransFilter;
        //debugger;
        if (arrFilterCreteria.length == 0 && bchkFilter == false) {
            bchkFilter = true;
            bDBLoaded = false;
            sMethodName = sMethod;
            sWorkflowMethodName = sWorkflowMethod;

            NewDashboard.getDashboardDetails({
                                                Dashboardid: dashId,
                                                bEnableAuditLog: GlobalPref.EnableAuditLog,
                IsOnCloud: bOnCloud
                                            },
                                            true,
                                            "RenderTransDashboardSuccess");

            var TransDashFilter;
            //var Pathloc = GLOBAL.getContextPath("GetTransDashletFilter", "Dashboard", "Dashboard");
            var Pathloc = GLOBAL.getContextPath("GetTransDashletFilter", "DashboardAPI", "Api");
            var result = NETWORK.executeServerMethod(Pathloc,
                                                    true,
                                                    {
                                                        DashboardId: dashId,
                                                        EnableAuditLog: GlobalPref.EnableAuditLog
                                                    });
            if (result.data != "") {
                TransDashFilter = result.data;
                if (TransDashFilter != undefined) {
                    for (var i = 0; i < TransDashFilter.length; i++) {
                        var objFilter = {
                            iMasterTypeId: TransDashFilter[i].iMasterTypeId,
                            iDashletId: TransDashFilter[i].iDashletId,
                            iValue: 0,
                            sName: "",
                            bRefresh: TransDashFilter[i].bRefresh,
                            FieldId: 0
                        }
                        arrFilterCreteria.push(objFilter);
                    }
                }
                arrFilterTempData = arrFilterCreteria;
            }
        }
        else if (arrFilterCreteria.length > 0 && bDBLoaded == true) {
            bDBLoaded = false;
            var arrDashlets = arrTempDashlets;
            arrTempDashlets = [];
            RenderTransDashboardSuccess(true, arrDashlets)
        }
        else {
            //Refresh Infopanel
            ////debugger
            if (arrFilterCreteria.length == 0)
                return;
            var iVoucherDate = 0;
            var iSelectedField = 0;
            if (obj.UpdateInfo != undefined) {
                iSelectedField = obj.UpdateInfo.FieldId;
            }

            //Filter data saving in temp array
            for (var j = 0; j < arrFilterCreteria.length; j++) {
                for (var k = 0; k < TransFilter.length; k++) {
                    if (arrFilterCreteria[j].iMasterTypeId == TransFilter[k].iMasterTypeId && arrFilterCreteria[j].bRefresh == true) {
                        arrFilterCreteria[j].iValue = TransFilter[k].iValue;
                        arrFilterCreteria[j].FieldId = TransFilter[k].FieldId
                    }
                }
            }
            arrFilterTempData = arrFilterCreteria;

            for (var i = 0; i < arrTempDashlets.length; i++) {
                ////debugger;
                if (arrTempDashlets[i].DashletId != 0) {
                    if (arrTempDashlets[i].DashletType == 1) {
                        if (arrTempDashlets[i].Dashlets.DashletsDetail.length > 0) {
                            if (arrTempDashlets[i].Dashlets.DashletsDetail[0].VariableId == 1028) {
                                continue;
                            }
                        }
                    }
                    arrReportFilter = [];
                    var bRefreshCheck = false;
                    for (var j = 0; j < arrFilterTempData.length; j++) {
                        if (arrTempDashlets[i].DashletId == arrFilterTempData[j].iDashletId) {
                            for (var k = 0; k < TransFilter.length; k++) {
                                // //debugger
                                if (TransFilter[k].FieldId == 2) {
                                    iVoucherDate = TransFilter[k].iValue;
                                }
                                if (arrFilterTempData[j].iMasterTypeId == TransFilter[k].iMasterTypeId && TransFilter[k].FieldId != 2) {
                                    if (arrFilterTempData[j].bRefresh == false) {
                                        if (arrTempDashlets[i].DashletType == 2) {
                                            var iMasterType = arrFilterTempData[j].iMasterTypeId
                                            if (iMasterType == 0) {
                                                iMasterType = 1;
                                            }
                                            if (TransFilter[k].iValue > 0) {
                                                var ObjRepFilter = {
                                                    Id: iMasterType,
                                                    Value: TransFilter[k].iValue,
                                                    Name: TransFilter[k].sName,
                                                    SubId: TransFilter[k].FieldId
                                                }
                                                arrReportFilter.push(ObjRepFilter);
                                            }
                                        }
                                        else {
                                            if (TransFilter[k].iValue > 0) {
                                                var ObjRepFilter = {
                                                    iMasterTypeId: arrFilterTempData[j].iMasterTypeId,
                                                    iValue: TransFilter[k].iValue,
                                                    sName: TransFilter[k].sName
                                                }
                                                arrReportFilter.push(ObjRepFilter);
                                            }
                                        }
                                    }
                                }
                            }
                            ////debugger
                            if (arrFilterTempData[j].bRefresh == true
                                && arrReportFilter.length > 0 && bRefreshCheck == false
                                && (iSelectedField == arrFilterTempData[j].FieldId)) {
                                bFromTrans = true;
                                bRefreshCheck = true;
                                if (arrTempDashlets[i].DashletType == 0) {
                                    bDashboard = false;
                                    GRAPH_GENERATION.DashboardGeneration_Graph(arrTempDashlets[i].DashletId, "DBdashlate" + i, arrTempDashlets[i].Type, null, null, "none", null, null);
                                }
                                if (arrTempDashlets[i].DashletType == 1) {
                                    ////debugger;
                                    DashboardId = dashId;
                                    INFOPANEL_GENERATION.DashboardGeneration_InfoPanel(arrTempDashlets[i].DashletId, "DBdashlate" + i, null, iVoucherDate);
                                }
                                if (arrTempDashlets[i].DashletType == 2) {
                                    //debugger;
                                    if (arrTempDashlets[i].Type == 0) {
                                        outputType = "Screen";
                                    }
                                    else {
                                        outputType = "Graph";
                                    }
                                    if (arrTempDashlets[i].RepRecordParameters != null) {
                                        if (arrTempDashlets[i].RepRecordParameters.DateOption == 1) {
                                            DATEPICKER.clear("ToDate");
                                            arrTempDashlets[i].RepRecordParameters.EndingDate = DATEPICKER.getDate('ToDate');
                                            if (arrTempDashlets[i].RepRecordParameters.ReportId == 631)
                                                arrTempDashlets[i].RepRecordParameters.LayoutId = 1;
                                        }
                                        if (arrTempDashlets[i].RepRecordParameters.graphtype == 17) {
                                            arrTempDashlets[i].RepRecordParameters.graphtype = 18;
                                        }
                                    }
                                    REPORT_GENERATION.DashboardGeneration_Report({ objRec: arrTempDashlets[i].RepRecordParameters, OutputScreen: outputType, dashletId: "dashletReport_" + arrTempDashlets[i].RepRecordParameters.ReportId }, outputType, "DBdashlate" + i, arrTempDashlets[i].Height);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    catch (err) {
        COMMON.prototype.showMessage("{NewDashboard.LoadDefultTransDashboard}" + err.message, "Exception");
    }
}
