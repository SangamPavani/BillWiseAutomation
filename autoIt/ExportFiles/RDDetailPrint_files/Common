    ChangeIlevel: function (ele, xAxis) {
        //debugger
        if (ele.selectedOptions.length == 0 && xAxis == true) {
            $('#diviLevel_' + sTrans).css("visibility", "hidden");
            $('#divZAxisiLevel_' + sTrans).css("visibility", "hidden");
            return;
        }
        if (ele.selectedOptions[0].dataset.datatype != 12 & ele.selectedOptions[0].dataset.datatype.toLowerCase() != "master") {
            if (xAxis == true) {
                $('#diviLevel_' + sTrans).css("visibility", "hidden");
            }
            else {
                $('#divZAxisiLevel_' + sTrans).css("visibility", "hidden");
            }

        }

        else {
            if (xAxis == true) { $('#diviLevel_' + sTrans).css("visibility", "visible"); }
            else {
                $('#divZAxisiLevel_' + sTrans).css("visibility", "visible");
            }
            var iMasterId = ele.selectedOptions[0].dataset.typeid;
