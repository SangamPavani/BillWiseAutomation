    SaveQueryReportDashlet: function (bTrans) {
            //debugger;
        try {
            if (bTrans) {
                sTrans = "Trans";
            }
            var QueryReportDashletName = document.getElementById("tbQueryReportName").value;
            var QRtxtQuery = document.getElementById("QRtxtQuery").value;

            var periodValue = $('#ddlPeriod').val();

            if (QueryReportDashletName.trim() == "") {
                COMMON.prototype.showMessage(DashletResourceMsgs.msgEnterDashlet, DashletResourceMsgs, "Focus10");
                //NewGraph.ShowErrorMessage("Enter title");
                return false;
            }
            if (QRtxtQuery.trim() == "") {
                COMMON.prototype.showMessage(DashletResourceMsgs.msgEnterquery, DashletResourceMsgs, "Focus10");
                //NewGraph.ShowErrorMessage("Select Workflow  Name");
                return false;
            }
            var ySeriesData = [];
            var QueryParams = [];
            var ParamsTextValues = document.getElementById('ddldQueryReportQueryValue').children;
            var FilterTextValues= document.getElementById('ddldQueryReportFilterValue').children;

            if (ParamsTextValues.length > 0) {
                for (let i = 0; i < ParamsTextValues.length; i++) {
                    var queryParam= {
                        ID: i,
                        Name: ParamsTextValues[i].value, 
                        ExtraInfo: "",
                        Tag: FilterTextValues[i].value
                    };
                    if (queryParam.Tag == "") {
                        if (queryParam.Name !== "$iStartDate" && queryParam.Name !== "$iEndDate") {
                            COMMON.prototype.showMessage(DashletResourceMsgs.msgEnterFieldValueFor + " " + queryParam.Name + " " + DashletResourceMsgs.QC_TC_msgParameter, "Info");
                            return false;
                        }            
                    }
                    QueryParams.push(queryParam);
                }
            }
            var DashletDetailData = {
                DashletsDetailId: document.querySelector('.QR_DashletsDetailIds').getAttribute('dashletsdetailid'),
                DashletsRange: periodValue.trim(),
                Query: QRtxtQuery,
                QueryParams: QueryParams
            };
            ySeriesData.push(DashletDetailData);
            var dashletID = document.getElementById("DashletsId").value.trim();
            var dashletData = {
                DashletsId: dashletID,
                DashletsDetail: ySeriesData,
                DashletName: QueryReportDashletName,
                DashletType: 9,
                DashboardId: parseInt($("#hid_urldashboardid").val())
            };

            var urlPath = GLOBAL.getContextPath("SaveDashlet", "Dashboard", "Dashboard");
            var fnResult = NETWORK.executeServerMethod(urlPath, true, { objDashlet: dashletData }, "JSON", true, "NewGraph.RefreshDashboard", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        } catch (err) {
            COMMON.prototype.showMessage("{NewGraph.SaveQueryReportDashlet} " + err.message, "Exception");
            return false;
        }
    },
