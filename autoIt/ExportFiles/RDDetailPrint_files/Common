    GetQueryData: function (ele) {
        // ////debugger;
        var query = ele.value.trim();
        if (query.length > 5) {
            var mayIExecute = false;
            var dataQuery = ele.dataset.queryval.trim();
            if (dataQuery == "") {
                ele.dataset.queryval = query;
                mayIExecute = true;
            }
            else if (dataQuery != query) {
                if (query.indexOf("where") == -1) {
                    query = query + " where 1=0";
                }
                else
                    query = query + " and 1=0";
                ele.dataset.queryval = query;
                mayIExecute = true;
            }
            if (mayIExecute) {
                var urlPath = GLOBAL.getContextPath("Graph_ExecuteQuery", "Dashboard", "Dashboard");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { sQueryString: query }, "JSON", true, "NewGraph.BindQueryValue", "", "", ele.dataset.seriesid);
            }
        }
        else {
            if (query != "") {
                NewGraph.ShowErrorMessage(DashletResourceMsgs.msgCompleteQuery); //"Enter complete query"
            }
        }
