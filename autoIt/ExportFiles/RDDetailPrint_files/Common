    GetQueryFields: function (ele) {
//      debugger
        var query = ele.value.trim();
        if (query.length > 5) {
            var mayIExecute = false;
            var dataQuery = ele.dataset.queryval.trim();
            if (dataQuery == "") {
                ele.dataset.queryval = query;
                mayIExecute = true;
            }
            else if (dataQuery != query) {
                if (query.indexOf("where") == -1) {
                    query = query + " where 1=0";
                }
                else
                    query = query + " and 1=0";
                ele.dataset.queryval = query;
                mayIExecute = true;
            }
            if (mayIExecute) {
                var urlPath = GLOBAL.getContextPath("GetInfoPanelQueryFields", "Dashboard", "Dashboard");
                var fnResult = NETWORK.executeServerMethod(urlPath, true, { sQueryString: query }, "JSON", true, "NewGraph.BindInfoPanelQueryValue", "", "", ele.dataset.seriesid);
            }
        }
        else {
            if (query != "") {
                NewGraph.ShowErrorMessage(DashletResourceMsgs.msgCompleteQuery); //"Enter complete query"
            }
        }
    },
    GetQueryReportQueryFields: function (ele) {
        //debugger
        var query = ele.value.trim();
        var fldValue = document.getElementById("ddldQueryReportQueryValue");
        fldValue.innerHTML = "";
        var filterValue = document.getElementById("ddldQueryReportFilterValue");
        var filterHTMLData = filterValue.cloneNode(true);
        filterValue.innerHTML = "";
        var dashletID = document.getElementById("DashletsId").value.trim();

        if (query !== "") {
            var paramPattern = /\$(\w+)/g;
            var params = [];
            var match;

            while ((match = paramPattern.exec(query)) !== null) {
                params.push(match[1]);
            }
            if (params.length > 0) {
                for (var i = 0; i < params.length; i++) {

                    //Parameter text boxes
                    var param = params[i];
                    var input = document.createElement("input");
                    input.type = "text";
                    input.className = "form-control mb-2";
                    input.disabled = true;
                    input.id = "parameter" + i;
                    input.value = "$" + param;
                    if (input.value == "$iStartDate" || input.value == "$iEndDate")
                    {
                        input.style.display="none"
                    }
                    fldValue.appendChild(input);
                    
                    //Filter Textboxes
                    var filterinput = document.createElement("input");
                    filterinput.type = "text";
                    filterinput.className = "form-control mb-2";
                    filterinput.id = "filter" + i;
                    if (parseInt(dashletID) > 0) {
                        if (filterHTMLData.children[i] != undefined) {
                            filterinput.value = filterHTMLData.children[i].value;
                          } else {
                            filterinput.value = "";
                         }
                    } else {
                        filterinput.value = "";
                    }
                    if (input.value == "$iStartDate" || input.value == "$iEndDate") {
                        filterinput.style.display = "none";
                    }
                    filterValue.appendChild(filterinput);
                }
            }
        }
    }
