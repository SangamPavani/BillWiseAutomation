function RenderMaxStackedAreaChart(GraphDetails, yAxixLength, iContainerId, arrLegend, bLegendPosition, sTheme, IsZoomable, IsExport, XAxisTypeId, XAxisDataType) {
    MultiorSingleGraph = yAxixLength;
    var valueAxies = [];
    if (bDashboard == true) {
        valueAxies.push({ minimum: 0 });
    }
    var arrY = [];
    for (var i = 0; i < yAxixLength; i++) {
        var data_ = arrLegend[i];
        arrY.push({
            "balloonText": data_ + " In [[xAxis]]<br><span style='font-size:14px'><b>[[value]]</b> ([[percents]]%)</span>",
            // "balloonText": "<b>[[value]]</b></span>",
            "fillAlphas": 0.6,
            "hidden": false,
            "lineAlpha": 0.4,
            "title": data_,
            "valueField": data_,
        });
    }
    var chart = AmCharts.makeChart("chartdiv" + iContainerId, {
        "type": "serial",
        "theme": sTheme,
        "marginRight": 60,
        "dataProvider": GraphDetails,
        "legend": bLegendPosition != "none" ? {
            "position": bLegendPosition,
            "markerSize": 10,
            "marginRight": 100,
            "autoMargins": false
        } : false,
        "numberFormatter": {
            "thousandsSeparator": ''
        },
        //"valueAxes": [{
        //    "minimum": 0
        //}],
        "valueAxes": valueAxies,
        "graphs": arrY,
        "plotAreaBorderAlpha": 0,
        "marginTop": 10,
        "marginLeft": 0,
        "marginBottom": 35,
        "chartCursor": {
            "cursorAlpha": 0,
            "bulletsEnabled": true,
        },
        "categoryField": "xAxis",
        "categoryAxis": {
            "gridPosition": "start",
            //"labelRotation": 15
            "autoRotateAngle": 15,
            "autoRotateCount": 4,
            "parseDates": false,
        },
        "mouseWheelZoomEnabled": IsZoomable == "false" ? false : true,
        "chartScrollbar": IsZoomable == "false" ? false : { "autoGridCount": false, "scrollbarHeight": 10, "backgroundColor": Theme_Color, "selectedBackgroundColor": Theme_Color, "selectedBackgroundAlpha": 1 },
