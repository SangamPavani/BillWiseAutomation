    GraphDataArray: function (arrData, dataStruct) {
        ////debugger;
        arrSeries = [];
        GRAPH_GENERATION.ResetGraphParams();
        var zAxis = arrData.zAxis;
        var zAxisId = arrData.zAxisId;
        var arrZAxisData = [];
        for (var i = 0; i < arrData.lstDashletData.length; i++) {
            ////////////////debugger
            var xAxis = arrData.lstDashletData[i].xAxis;
            var iMasterId = arrData.lstDashletData[i].MasterId;
            var SplityAxis = arrData.lstDashletData[i].yAxis;
            var sCaption = "";
            for (var icount = 0; icount < dataStruct.DashletsDetail.length; icount++) {
                sCaption += dataStruct.DashletsDetail[icount].Caption + ",";
            }
            sCaption = sCaption.substring(0, (sCaption.lastIndexOf(',')));
            sCaption = sCaption.split(',');
            if ($(window).width() < 480) {
                GRAPHPARAMS.bLegendPosition = "none";
            }
            else {
                ////////////////debugger
                if (document.getElementById("id_CompanyLanguageId").value == 1) {
                    if (dataStruct.LegendPosition == 1) {
                        dataStruct.LegendPosition = 2;
                    }
                    else if (dataStruct.LegendPosition == 2) {
                        dataStruct.LegendPosition = 1;
                    }
                }
                GRAPHPARAMS.bLegendPosition = GRAPH_GENERATION.GetLegendPosition(dataStruct.LegendPosition);
            }
            var temp = {};
            if (!bIsZAxis) {
                for (var iDetail = 0; iDetail < SplityAxis.length; iDetail++) {
                    temp["xAxis"] = xAxis;
                    temp[sCaption[iDetail]] = SplityAxis[iDetail];
                    temp["MasterId"] = iMasterId;
                    temp["zAxis"] = zAxis;
                    temp["zAxisId"] = zAxisId;
                    
                }
            }
            else
            {
                ////debugger;
                arrZAxisData = arrData.lstDashletData.filter((p) => p.xAxis == xAxis);
                temp["xAxis"] = xAxis;
                for (var iRowCount = 0; iRowCount < arrZAxisData.length; iRowCount++)
                {
                    var iLength = arrSeries.filter((p) => p == arrZAxisData[iRowCount].zAxis).length;
                    if (iLength == 0) {
                        arrSeries.push(arrZAxisData[iRowCount].zAxis);
                    }
                    temp[arrZAxisData[iRowCount].zAxis] = arrZAxisData[iRowCount].yAxis[0];
                }
                i = i + (arrZAxisData.length - 1);
            }
            GRAPHPARAMS.sTheme = GRAPH_GENERATION.GetTheme(dataStruct.Themes);
            GRAPHPARAMS.IsExport = (dataStruct.IsExportDashlet.toString()).toLowerCase();
            GRAPHPARAMS.IsZoomable = (dataStruct.IsZooming.toString()).toLowerCase();
            GRAPHPARAMS.yAxixLength = arrData.yAxisSeriesName.length;
            GRAPHPARAMS.sSummaryHeading = arrData.SummaryHeading[0];
            GRAPHPARAMS.GraphDetails.push(temp);
            GRAPHPARAMS.arrLegend = sCaption;
            GRAPHPARAMS.XAxisTypeId = dataStruct.XAxis.TypeId;
            GRAPHPARAMS.XAxisDataType = dataStruct.XAxis.DataType;
        }
    },

