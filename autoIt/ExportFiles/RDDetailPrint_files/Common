                                if (iDay1 == 1) {
                                    if (iMonth1 == 1) {
                                        iMonth1 = 12;
                                        iYear1 = iYear1 - 1;
                                    }
                                    else {
                                        iMonth1 = iMonth1 - 1;
                                    }
                                    iDay1 = REPORTVIEW.getLastDayoftheMonth(iMonth1);
                                }
                                else {
                                    iDay1 = iDay1 - 1;
                                }
                                var lastfinenddate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, iYear1);
                                reportdata.objReport.StartingDate = lastfinstartdate;
                                reportdata.objReport.EndingDate = lastfinenddate;
                                break;
                            case 11: // Yesterday
                                iYear = iMonth == 1 && iDay == 1 ? iYear - 1 : iYear;
                                iMonth = iMonth == 1 && iDay == 1 ? 12 : iDay == 1 ? iMonth - 1 : iMonth;
                                iDay = iDay == 1 ? FDate.maxDays(iMonth, iYear, calType) : iDay - 1;
                                reportdata.objReport.StartingDate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                                reportdata.objReport.EndingDate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                                break;
                            case 12: //CurrentQuarter
                                iDiff = iMonth >= 4 && iMonth <= 6 ? 4 : iMonth >= 6 && iMonth <= 9 ? 7 : iMonth >= 9 && iMonth <= 12 ? 10 : iMonth >= 1 && iMonth <= 3 ? 1 : iMonth;
                                reportdata.objReport.StartingDate = DATE.prototype.convertIntoFocusDate(1, iDiff, iYear);

                                iDiff = iMonth >= 4 && iMonth <= 6 ? 6 : iMonth >= 6 && iMonth <= 9 ? 9 : iMonth >= 9 && iMonth <= 12 ? 12 : iMonth >= 1 && iMonth <= 3 ? 3 : iMonth;
                                reportdata.objReport.EndingDate = DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iYear);
                                break;
                            case 13: //PreviousQuarter
                                iTempCalc = iMonth < 4 ? iYear - 1 : iYear;
                                iDiff = iMonth >= 4 && iMonth <= 6 ? 1 : iMonth >= 6 && iMonth <= 9 ? 4 : iMonth >= 9 && iMonth <= 12 ? 7 : iMonth >= 1 && iMonth <= 3 ? 10 : iMonth;
                                reportdata.objReport.StartingDate = DATE.prototype.convertIntoFocusDate(1, iDiff, iTempCalc);

                                iDiff = iMonth >= 4 && iMonth <= 6 ? 3 : iMonth >= 6 && iMonth <= 9 ? 6 : iMonth >= 9 && iMonth <= 12 ? 9 : iMonth >= 1 && iMonth <= 3 ? 12 : iMonth;
                                reportdata.objReport.EndingDate = DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iTempCalc);
                                break;
                        }

                        if (reportdata.objReport.DateOption != 1) {
                            Startdate = reportdata.objReport.StartingDate;
                            if (Startdate < accDate) {
                                COMMON.prototype.showMessage(sResourceMessage.msgStartDateCantbeLessThanFinancialDate, sResourceMessage, msgs.Error);
                                return;
                            }
                        }
                    }

                    document.getElementById(divViewControlId).style.display = "none";
                    document.getElementById(divButtonCntrlId).style.display = "block";
                    document.getElementById(divHomeCntrls).style.display = "none";
                    arrReportHomeData[i].Dashlets.DashletsDetail = [];
                    arrReportHomeData[i].Dashlets.RepRecordParameters.Masters = Master_array;
                    arrReportHomeData[i].RepRecordParameters.Masters = Master_array;
                    arrReportHomeData[i].Dashlets.RepRecordParameters.IsSelectAll = IsSelectAll
                    arrReportHomeData[i].RepRecordParameters.IsSelectAll = IsSelectAll
                    if (arrReportHomeData[i].Dashlets.GraphType == 17) {
                        arrReportHomeData[i].Dashlets.GraphType = 18;
                    }
                    arrReportHomeData[i].Dashlets.DashletsDetail = [];
                    dashletReportData.push({ daslets: arrReportHomeData[i].Dashlets, dashletid: "dashletReport_" + arrReportHomeData[i].DashletId + "_" + arrReportHomeData[i].RepRecordParameters.ReportId });
                    REPORT_GENERATION.DashRepGeneration_Report({ objRec: reportdata.objReport, OutputScreen: outputType, dashletId: "dashletReport_" + DashletId + "_" + dashReportId, gTheme: arrReportHomeData[i].Dashlets.Themes, glengendPosition: arrReportHomeData[i].Dashlets.LegendPosition, graphtype: arrReportHomeData[i].Dashlets.GraphType, iContainerId: ContainerId }, outputType, ContainerId, arrReportHomeData[i].Height);
