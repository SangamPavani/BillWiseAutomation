    LPNCodeGenerationScreenNmGridrowChange: function (tabId) {
        //debugger
        var cell = undefined;
        var documentNumberas = "";
        var iTotalRows = FGRIDCONTROL.getTotalRows(tabId);
        var today = new Date();
        var monthNames = ["Jan", "Feb", "March", "April", "May", "Jun", "Jul", "Aug", "Sept", "Oct", "Nov", "Dec"];
        for (var count = 1; count < iTotalRows; count++) {
            var rowValue = FGRIDCONTROL.getRowValue(tabId, count);
            if (rowValue[0].Value != null && rowValue[1].Value != null && rowValue[2].Value != null && rowValue[3].Value != null) {
                var caseIndex = rowValue[0].Value;
                var caseIndex = caseIndex + rowValue[1].Value;
                var startCharPos = parseInt(rowValue[2].Value);
                var noofChars = parseInt(rowValue[3].Value);               
                switch (caseIndex) {
                    case "00":
                        if (startCharPos == 0)
                            documentNumberas += loginName.substring(startCharPos, noofChars);
                        else
                            documentNumberas += loginName.substring(startCharPos, noofChars + 1);
                        break;
                    case "01":
                        if (startCharPos == 0)
                            documentNumberas += loginAbbr.substring(startCharPos, noofChars);
                        else
                            documentNumberas += loginAbbr.substring(startCharPos, noofChars + 1);
                        break;
                    case "10":

                        var tags = "Tags";
                        if (startCharPos == 0)
                            documentNumberas += tags.toString().substring(startCharPos, noofChars);
                        else
                            documentNumberas += tags.toString().substring(startCharPos, noofChars + 1);

                        break;
                    case "92":
                        var tags = "Tags";
                        if (startCharPos == 0)
                            documentNumberas += tags.toString().substring(startCharPos, noofChars);
                        else
                            documentNumberas += tags.toString().substring(startCharPos, noofChars + 1);
                        break;
                    case "20":
                    case "21":
                    case "230":
                    case "231":
                    case "240":
                    case "241":
                    case "130":
                    case "131":
                        documentNumberas += rowValue[0].Text.substring(startCharPos, noofChars);
                        break;
                    case "22":
                        var year = today.getFullYear();
                        if (startCharPos == 0)
                            documentNumberas += year.toString().substring(startCharPos, noofChars);
                        else
                            documentNumberas += year.toString().substring(startCharPos, noofChars + 1);
                        break;
                    case "23":
                        var month = today.getMonth() + 1;
                        if (startCharPos == 0)
                            documentNumberas += month.toString().substring(startCharPos, noofChars);
                        else
                            documentNumberas += month.toString().substring(startCharPos, noofChars + 1);
                        break;
                    default:
                        switch (rowValue[0].Value) {
                            case "3":
                            case "6":
                                if (rowValue[1].Text == "Space") {
                                    documentNumberas += '\xa0\xa0\xa0\xa0\xa0\xa0';
                                } else {
                                    documentNumberas += rowValue[1].Text;

                                }
                                break;
                            case "4":
                                if (parseInt(rowValue[3].Value) >= rowValue[1].Text.length) {
                                    for (var count1 = 0; count1 < (parseInt(rowValue[3].Value) - (isNaN(rowValue[1].Text) ? rowValue[1].Text.length : 0)); count1++)
                                        documentNumberas += "0";
                                }
                                documentNumberas += isNaN(rowValue[1].Text) ? rowValue[1].Text : documentNumberas != "" ? "" : "0";
                                break;
                            case "5":
                                documentNumberas += rowValue[1].Text;
                                break;

                            default:
                                documentNumberas += rowValue[1].Text;
                                break;
                        }
                        break;
                }
            }
        }
        document.getElementById("LPNCodeNum_documentNumberAs").textContent = documentNumberas;
        return true;
    },
