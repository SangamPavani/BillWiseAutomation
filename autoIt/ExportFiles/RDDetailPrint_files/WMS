    LoadAdvBillOverrideBillingSuccess(bFlag, data) {
        try {
            if (bFlag && data.sErrorMsg != "") {
                COMMON.prototype.showMessage(data.sErrorMsg);
                return false;
            }
            if (!COMMON.prototype.isValidObject(data.ObjAdvBillingData)) {
                return false;
            }
            if (data.ObjAdvBillingData.BillFreqType !=0) {
                $('#id_AdvBillingFrequency').val(data.ObjAdvBillingData.BillFreqType);
                $('#id_AdvBillingFrequency').prop('disabled', true);
            } 
            
            ADVANCEBILLING.LocalStore.bInvTag = data.ObjAdvBillingData.InvTagId != 0 ? true : false
            var OBData = data.ObjAdvBillingData.ListBillingHeader;
            ADVANCEBILLING.ClearGridCtrl();
            if (OBData.length > 1) {
                FGRIDCONTROL.insertRows(ADVANCEBILLING.sGridId, 1, OBData.length - 1);
            }
            for (var i = 1; i <= OBData.length; i++) {
                for (var iColCounter = 1; iColCounter <= 7; iColCounter++) {
                    var cell = FGRIDCONTROL.getCellObject(ADVANCEBILLING.sGridId, i, iColCounter);
                    switch (iColCounter) {
                        case 2:
                            cell.setCellText(OBData[i - 1].StorerName, OBData[i - 1].StorerId);
                            break;
                        case 3:
                            cell.setCellText(OBData[i - 1].BillHeaderId, OBData[i - 1].BillHeaderId);
                            break;
                        case 4:
                            var Date = DATEPICKER.convertDateIntoString("AdvBilling_DP_FromDate", OBData[i - 1].FromDate);
                            cell.setCellText(Date, OBData[i - 1].FromDate);
                            break;
                        case 5:
                            var Date = DATEPICKER.convertDateIntoString("AdvBilling_DP_FromDate", OBData[i - 1].ToDate);
                            cell.setCellText(Date, OBData[i - 1].ToDate);
                            break;
                        case 6:
                            var Date = DATEPICKER.convertDateIntoString("AdvBilling_DP_FromDate", OBData[i - 1].BillGenDate);
                            cell.setCellText(Date, OBData[i - 1].BillGenDate);
                            break;
                        case 7:
                            cell.setCellText(OBData[i - 1].WarehouseName, OBData[i - 1].WHId);
                            break;
                        default:
                            break;
                    }
                }
            }
            ADVANCEBILLING.OnChangeBillFrequency();
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ADVANCEBILLING.LoadAdvBillOverrideBillingSuccess} " + err.message, "Exception")
        }
