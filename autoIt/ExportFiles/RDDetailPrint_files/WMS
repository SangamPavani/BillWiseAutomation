                return false;
            }
            //if (!bEditEntry) {
            //    if (arrFoud) {
            //        COMMON.prototype.showMessage(TariffMasterAdvEntryMethods.getResourceValue("msgDuplicateValues", GetResourceMessages));
            //        return false;
            //    }
            //}
            for (var iService = 0; iService < optOperationType.length; iService++) {
