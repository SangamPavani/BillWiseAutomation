                    FGRIDCONTROL.update("grdTierBase");
                    for (var i = 1; i <= FGRIDCONTROL.getTotalRows("grdTierBase"); i++) {
                        var objRow = FGRIDCONTROL.getRowValue("grdTierBase", i);
                        var RowData = [];
                        if (objRow[0].Value != "") {
                            RowData.push(
                                { id: "UnitFValue", value: objRow[0].Value },
                                { id: "UnitToValue", value: objRow[1].Value },
                                { id: "Charges", value: objRow[2].Value }
                            );
                            Field.push(RowData);
                        }
                    }
                }
            }
            else {
                sChangeByPanel = "PerProduct";
                if ($("#rdoPerCount").prop("checked")) {
                    sGrid = "PreProduct_grdPerCount";
                    rdoCheck = "rdoPerCount";
                    Field = [];
                    FGRIDCONTROL.update("PreProduct_grdPerCount");
                    for (var i = 1; i <= FGRIDCONTROL.getTotalRows("PreProduct_grdPerCount"); i++) {
                        var objRow = FGRIDCONTROL.getRowValue("PreProduct_grdPerCount", i);
                        var RowData = [];
                        if (objRow[0].Value != "") {
                            RowData.push(
                                { id: "ProductFValue", value: objRow[0].Value },
                                { id: "UnitFValue", value: objRow[1].Value },
                                { id: "Charges", value: objRow[2].Value }
                            );
                            Field.push(RowData);
                        }
                    }
                }
                if ($("#rdoPerCountRange").prop("checked")) {
                    sGrid = "PreProduct_grdPerCountRange";
                    rdoCheck = "rdoPerCountRange";
                    Field = [];
                    FGRIDCONTROL.update("PreProduct_grdPerCountRange");
                    for (var i = 1; i <= FGRIDCONTROL.getTotalRows("PreProduct_grdPerCountRange"); i++) {
                        var objRow = FGRIDCONTROL.getRowValue("PreProduct_grdPerCountRange", i);
