    Load_ASNDetails: function (ele) {
        //debugger;
        currentPage = 0;
        filterData = [];
        totalNoOfPages = 0;
        $("#myPager").empty();
        $("#myPager").hide();

        var ASNId = OPTIONCONTROL.getControlValue("optASN");
