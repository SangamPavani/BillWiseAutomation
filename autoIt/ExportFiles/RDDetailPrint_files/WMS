            FGRIDCONTROL.update(sStkReplGridId);
            var cell = FGRIDCONTROL.getCellObject(sStkReplGridId, iRow, 8).getCellData('value');
            if (cell != "") {
                if (iRow == 0) {
                    return false;
                }
                var objRowElement = FGRIDCONTROL.getRowValue(sStkReplGridId, iRow);
                var SourceBin = "";
                var TotalRequestQty = 0;
                if (objRowElement && objRowElement.length > 0) {
                    SourceBin = objRowElement[7].Value;
                    TotalRequestQty = objRowElement[8].Value == "" ? 0 : parseInt(objRowElement[8].Value);
                }
                if (SourceBin != "" && TotalRequestQty != 0) {
                    event.target.checked = true
                    event.bChecked = true
                }
                else {
                    event.target.checked = false
                    event.bChecked = false
                }

                if (event.bChecked) {
                    if (confirm(ResourceMessages[7].Value)) {
                        if (SourceBinEdit.length > 0) {
                            SourceBinEdit.forEach((row, index) => {
                                if (row.SelectRow == iRow) {
                                    SourceBinEdit.splice(index, 1)
                                }
                            })
                        }
                        var cellobj = FGRIDCONTROL.getCellObject(sStkReplGridId, iRow, 8);
                        cellobj.setCellData("value", "");
                        cellobj.setCellText("");
                        cellobj = FGRIDCONTROL.getCellObject(sStkReplGridId, iRow, 9);
                        cellobj.setCellData("value", "0");
                        cellobj.setCellText("0");
                        event.target.checked = false
                    }
                    else {
                        event.target.checked = true
                    }
                }
            }
            var chkCount = 0;
            var GridLength = FGRIDCONTROL.getTotalRows(sStkReplGridId);
            for (var iRowCount = 1; iRowCount <= GridLength; iRowCount++) {
                var cellobj = FGRIDCONTROL.getCellObject(sStkReplGridId, iRowCount, 1);
                if ($(cellobj.cell)[0].children[0].checked) {
                    chkCount++;
                }
                cellobj.setCellData("value", $(cellobj.cell)[0].children[0].checked);
            }
            $('#chk_SelectAll')[0].checked = chkCount == GridLength ? true : false
        }
        catch (err) {
            COMMON.prototype.showMessage("StockReplenishment.HandleDeAllocateBins : " + err.message, "Exception");
            return false;
        }
