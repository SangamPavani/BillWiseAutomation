                        if (objRow[0].Value != "") {
                            RowData.push(
                                { id: "UnitFValue", value: objRow[0].Value },
                                { id: "UnitToValue", value: objRow[1].Value },
                                { id: "ProductFValue", value: objRow[2].Value },
                                { id: "ProductToValue", value: objRow[3].Value },
