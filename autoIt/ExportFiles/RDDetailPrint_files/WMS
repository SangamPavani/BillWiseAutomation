    //Below method is used to get the service charges of a grid 
    GetServiceChargesGrid: function (iProductId, dProductQty, dPalletQty, ele) {
        try {
            if (iProductId > 0) {
                var iPreviousPoductId = parseInt($('.ProductsDiv.SelectedRowColor').attr("data-for"));
                if (iPreviousPoductId > 0) {
                    var grdData = ServiceCharges.GetGridData();
                    // 
                    if (grdData != null && grdData != undefined) {
                        lstServiceChargeDetailsVoucherWise = lstServiceChargeDetailsVoucherWise.filter(function (obj) {
                            return obj.iItemId != iPreviousPoductId;
                        });
                        for (var i = 0; i < grdData.length; i++) {
                            lstServiceChargeDetailsVoucherWise.push(grdData[i]);
                        }
                    }
                }

                $('.ProductsDiv').removeClass("SelectedRowColor");
                $(ele).addClass("SelectedRowColor");
                var url = GLOBAL.getContextPath("GetServiceChargesGrid", "ServiceCharges", "WMS");
                result = NETWORK.executeServerMethod(
                    url,
                    true,
                    { iProductId: iProductId, dProductQty: dProductQty, dPalletQty: dPalletQty, lstServiceChargeDetailsVoucherWise: lstServiceChargeDetailsVoucherWise },
                    "HTML",
                    false,
                    "ServiceCharges.GetServiceChargesGrid_Success", "", "");
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ServiceCharges.GetServiceChargesGrid} " + err.message, "Exception")
        }
