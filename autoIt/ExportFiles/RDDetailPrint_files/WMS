    //Below is used to get the grid data in service charges grid 
    GetGridData: function () {
        try {
            var arrServiceCharges = [];
            var iSelectedPoductId = parseInt($('.ProductsDiv.SelectedRowColor').attr("data-for"));
            for (var i = 0; i < FGRIDCONTROL.getTotalRows("Grd_ServiceCharges"); i++) {
                FGRIDCONTROL.update("Grd_ServiceCharges");
                var obj_RowData = FGRIDCONTROL.getRowValue("Grd_ServiceCharges", i + 1);
                if (obj_RowData[1].Value >= 0 && obj_RowData[1].Value != "") {
                    var objSerCharges = {
                        iId: parseInt(obj_RowData[0].Value == "" ? "0" : obj_RowData[0].Value),
                        iServiceId: parseInt(obj_RowData[1].Value),
                        ServiceCode: obj_RowData[1].Text,
                        ApplyType: parseInt(obj_RowData[2].Value),
                        iChargeType: parseInt(obj_RowData[3].Value),
                        Qty: parseFloat(obj_RowData[4].Value),
                        dCBM: parseFloat(obj_RowData[5].Value),
                        dSKUCBM: parseFloat(obj_RowData[5].Value),
                        Rate: parseFloat(obj_RowData[7].Value),
                        dMinChrg: parseFloat(obj_RowData[8].Value),
                        dMaxChrg: parseFloat(obj_RowData[9].Value),
                        dTotalCharges: parseFloat(obj_RowData[10].Value),
                        Date: parseInt(obj_RowData[11].Value),
                        Remarks: obj_RowData[12].Value,
                        TariffId: parseFloat(obj_RowData[13].Value),
                        IsDefaultService: parseFloat(obj_RowData[14].Value),
                        iItemId: parseInt(iSelectedPoductId)
                    }
                    arrServiceCharges.push(objSerCharges);
                }
            }
            return arrServiceCharges;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ServiceCharges.GetGridData} " + err.message, "Exception")
        }
    },
    //Below method is used to set the data in service charge grid
    SetGridData: function (iRow) {
        try {
            var iNoOfQtyDecimal = parseFloat($("#hdnNoOfQtyDecimal").val());
            var iNoOfDecimal = parseFloat($("#hdnNoOfDecimal").val());
            var objService = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 2);
            var iServiceId = parseInt(objService.getCellData("value"));
            if (iServiceId > 0) {
                var lstServiceRow = lstServices.filter(function (obj) {
                    return obj.ServiceId == iServiceId;
                });

                var sChargeType = "";
                var dSKUCBM = 1;
                var dTotalCharge = 0;
                var d_m_ProductQty = 0;
                var d_m_PalletQty = 0
                var objApplyType = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 3);
                var iApplyType = parseInt(objApplyType.getCellData("value"));
                if (iApplyType == 1) {
                    d_m_ProductQty = txtQtyValue;
                    d_m_PalletQty = txtQtyValue;
                }
                else {
                    d_m_ProductQty = dProductQty;
                    d_m_PalletQty = dPalletQty;
                }
                if (lstServiceRow[0] != undefined) {
                    switch (lstServiceRow[0].ChargeType) {
                        case 0:
                            sChargeType = "CBM";
                            dSKUCBM = lstServiceRow[0].dSKUCBM;
                            dTotalCharge = ((d_m_ProductQty * dSKUCBM) * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 1:
                            dSKUCBM = 1;
                            sChargeType = "Quantity";
                            dTotalCharge = (d_m_ProductQty * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 2:
                            sChargeType = " Weight";
                            dSKUCBM = lstServiceRow[0].Weight;
                            dTotalCharge = ((d_m_ProductQty * dSKUCBM) * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 3:
                            sChargeType = "Pallet";
                            dSKUCBM = 1;
                            dTotalCharge = (d_m_PalletQty * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 4:
                            sChargeType = "Hours";
                            dSKUCBM = 1;
                            dTotalCharge = ((d_m_ProductQty * dSKUCBM) * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 5:
                            sChargeType = "Bin";
                            dSKUCBM = 1;
                            dTotalCharge = ((d_m_ProductQty * dSKUCBM) * lstServiceRow[0].Rate) / lstServiceRow[0].dCBM;
                            break;
                        case 6:
                            sChargeType = "Fix Charge";
                            dSKUCBM = 1;
                            dTotalCharge = (d_m_ProductQty * dSKUCBM) * lstServiceRow[0].Rate;
                            break;
                    }
                    var objChrageType = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 4);
                    objChrageType.setCellData(lstServiceRow[0].ChargeType);
                    objChrageType.setCellText(sChargeType);

                    if (lstServiceRow[0].ChargeType == 3) {
                        var objQty = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 5);
                        objQty.setCellData(Number(d_m_PalletQty).toFixed(iNoOfQtyDecimal));
                        objQty.setCellText(Number(d_m_PalletQty).toFixed(iNoOfQtyDecimal));
                    } else {
                        var objQty = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 5);
                        objQty.setCellData(Number(d_m_ProductQty).toFixed(iNoOfQtyDecimal));
                        objQty.setCellText(Number(d_m_ProductQty).toFixed(iNoOfQtyDecimal));
                    }


                    var objCBM = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 6);
                    objCBM.setCellData(Number(dSKUCBM).toFixed(iNoOfQtyDecimal));
                    objCBM.setCellText(Number(dSKUCBM).toFixed(iNoOfQtyDecimal));

                    if (lstServiceRow[0].ChargeType == 3) {
                        var objCBM = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 7);
                        objCBM.setCellData(Number(d_m_PalletQty * dSKUCBM).toFixed(iNoOfQtyDecimal));
                        objCBM.setCellText(Number(d_m_PalletQty * dSKUCBM).toFixed(iNoOfQtyDecimal));
                    }
                    else {
                        var objCBM = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 7);
                        objCBM.setCellData(Number(d_m_ProductQty * dSKUCBM).toFixed(iNoOfQtyDecimal));
                        objCBM.setCellText(Number(d_m_ProductQty * dSKUCBM).toFixed(iNoOfQtyDecimal));
                    }

                    var objRate = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 8);
                    objRate.setCellData(Number(lstServiceRow[0].Rate).toFixed(iNoOfDecimal));
                    objRate.setCellText(Number(lstServiceRow[0].Rate).toFixed(iNoOfDecimal));

                    var objMinChrg = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 9);
                    objMinChrg.setCellData(Number(lstServiceRow[0].MinChrg).toFixed(iNoOfDecimal));
                    objMinChrg.setCellText(Number(lstServiceRow[0].MinChrg).toFixed(iNoOfDecimal));

                    var objMaxChrg = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 10);
                    objMaxChrg.setCellData(Number(lstServiceRow[0].MaxChrg).toFixed(iNoOfDecimal));
                    objMaxChrg.setCellText(Number(lstServiceRow[0].MaxChrg).toFixed(iNoOfDecimal));

                    var dActualTotalCharge = 0;
                    //if (dTotalCharge < parseInt(lstServiceRow[0].MinChrg))
                    //{
                    //    dActualTotalCharge = lstServiceRow[0].MinChrg;
                    //}
                    //else if (parseInt(lstServiceRow[0].MaxChrg) > 0 && (dTotalCharge > parseInt(lstServiceRow[0].MaxChrg)))
                    //{
                    //    dActualTotalCharge = lstServiceRow[0].MaxChrg;
                    //}
                    //else
                    //{
                    //    dActualTotalCharge = dTotalCharge;
                    //}

                    if (parseInt(lstServiceRow[0].MaxChrg) > 0 && (dTotalCharge > parseInt(lstServiceRow[0].MaxChrg))) {
                        dActualTotalCharge = lstServiceRow[0].MaxChrg;
                    }
                    else {
                        if (lstServiceRow[0].ChargeType == 3) {
                            if (Number(d_m_PalletQty * dSKUCBM) < lstServiceRow[0].dCBM) {
                                dActualTotalCharge = lstServiceRow[0].MinChrg;
                            }
                            else {
                                dActualTotalCharge = dTotalCharge;
                            }
                        }
                        else {
                            if (Number(d_m_ProductQty * dSKUCBM) < lstServiceRow[0].dCBM) {
                                dActualTotalCharge = lstServiceRow[0].MinChrg;
                            }
                            else {
                                dActualTotalCharge = dTotalCharge;
                            }
                        }
                    }

                    var objTotalChrg = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 11);
                    objTotalChrg.setCellData(Number(dActualTotalCharge).toFixed(iNoOfDecimal));
                    objTotalChrg.setCellText(Number(dActualTotalCharge).toFixed(iNoOfDecimal));

                    var objDate = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 12);
                    objDate.setCellData(lstServiceRow[0].AffectedDate);
                    DATEPICKER.setDate("AffectedDate", lstServiceRow[0].AffectedDate, true);
                    var sDate = DATEPICKER.getText("AffectedDate");
                    objDate.setCellText(sDate);

                    var objTariffId = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 14);
                    objTariffId.setCellData(lstServiceRow[0].TariffId);
                    objTariffId.setCellText(lstServiceRow[0].TariffId);

                    var objIsDefaultService = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", iRow, 15);
                    objIsDefaultService.setCellData(lstServiceRow[0].IsDefaultService);
                    objIsDefaultService.setCellText(lstServiceRow[0].IsDefaultService);
                }

            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ServiceCharges.SetGridData} " + err.message, "Exception")
        }
    },
    //Below method is used for saving and updating of service charges 
    btnOK_Click: function () {
        try {
            if (iFaTagTypeId > 0 && bInstantServiceBillingEnabled == true) {
                var FaTagId = OPTIONCONTROL.getControlValue('optFATag');
                if (FaTagId == null || FaTagId <= 0) {
                    COMMON.prototype.showMessage(ServiceMsg.lblSelectFATagId);
                    return false;
                }
            }
            var iPreviousPoductId = parseInt($('.ProductsDiv.SelectedRowColor').attr("data-for"));
            if (iPreviousPoductId > 0) {
                var grdData = ServiceCharges.GetGridData();
                if (grdData != null && grdData != undefined) {
                    if (grdData.length > 0) {
                        lstServiceChargeDetailsVoucherWise = lstServiceChargeDetailsVoucherWise.filter(function (obj) {
                            return obj.iItemId != iPreviousPoductId;
                        });
                        for (var i = 0; i < grdData.length; i++) {
                            lstServiceChargeDetailsVoucherWise.push(grdData[i]);
                        }
                    }
                }
            }
            // 
            if (lstServiceChargeDetailsVoucherWise != null && lstServiceChargeDetailsVoucherWise != undefined) {
                if (lstServiceChargeDetailsVoucherWise.length > 0) {
                    var url = GLOBAL.getContextPath("SaveServiceChargeDetails", "ServiceCharges", "WMS")
                    result = NETWORK.executeServerMethod(url, true, { iHeaderId: m_iHeaderId, iVoucherType: m_iVoucherType, lstServiceChargeDetailsVoucherWise: lstServiceChargeDetailsVoucherWise }, "JSON", true, ServiceCharges.SaveServiceChargeDetails_Sucess)
                }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ServiceCharges.btnOK_Click} " + err.message, "Exception")
        }
    },
