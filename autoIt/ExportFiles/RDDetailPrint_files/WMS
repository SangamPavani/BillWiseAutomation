    AutoAllocateClick: function () {
        try {
            //debugger
            FGRIDCONTROL.update("grd_Source")
            if (FGRIDCONTROL.getTotalRows("grd_Source") == 0 || FGRIDCONTROL.getRowValue("grd_Source", 1)[0].Text == "") {
                return;
            }
            var BalancedQ = 0;
            var TotalRequestedQuantity = 0;
            var DeficitQty = FGRIDCONTROL.getCellObject(sStkReplGridId, iRowSelected, 7).getCellData('value');
            var lstTargetQuantity = SourceBinModel.sort((a, b) => b.AvailableTargetQuantity - a.AvailableTargetQuantity);
            for (var i = 0; i < lstTargetQuantity.length; i++) {
                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 10);
                cellobj.setCellData("value", "0");
                cellobj.setCellText("0");
                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 11);
                cellobj.setCellData("value", "0");
                cellobj.setCellText("0");
            }
            for (var i = 0; i < lstTargetQuantity.length; i++) {
                if (BalancedQ < 0)
                    break;
                for (var j = 1; j <= lstTargetQuantity[i].Quantity; j++) {
                    if (BalancedQ == 0) {
                        if (lstTargetQuantity[i].AvailableTargetQuantity >= DeficitQty) {
                            if ((j * lstTargetQuantity[i].Conversion) == DeficitQty) {
                                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 10);
                                cellobj.setCellData("value", j);
                                cellobj.setCellText(j);
                                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 11);
                                cellobj.setCellData("value", (j * lstTargetQuantity[i].Conversion));
                                cellobj.setCellText(j * lstTargetQuantity[i].Conversion);
                                TotalRequestedQuantity += (j * lstTargetQuantity[i].Conversion);
                                document.getElementById('Total_Target_Quantity').innerHTML = TotalRequestedQuantity;
                                return;
                            }
                        }
                        if (lstTargetQuantity[i].AvailableTargetQuantity < DeficitQty) {
                            if ((j * lstTargetQuantity[i].Conversion) == lstTargetQuantity[i].AvailableTargetQuantity) {
                                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 10);
                                cellobj.setCellData("value", j);
                                cellobj.setCellText(j);
                                var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 11);
                                cellobj.setCellData("value", (j * lstTargetQuantity[i].Conversion));
                                cellobj.setCellText(j * lstTargetQuantity[i].Conversion);
                                TotalRequestedQuantity += (j * lstTargetQuantity[i].Conversion);
                                break;
                            }
                        }
                    }
                    else {
                        if ((j * lstTargetQuantity[i].Conversion) == BalancedQ) {
                            var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 10);
                            cellobj.setCellData("value", j);
                            cellobj.setCellText(j);
                            var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 11);
                            cellobj.setCellData("value", (j * lstTargetQuantity[i].Conversion));
                            cellobj.setCellText(j * lstTargetQuantity[i].Conversion);
                            TotalRequestedQuantity += (j * lstTargetQuantity[i].Conversion);
                            BalancedQ = (DeficitQty - lstTargetQuantity[i].AvailableTargetQuantity);
                            document.getElementById('Total_Target_Quantity').innerHTML = TotalRequestedQuantity;
                            return;
                        }
                    }
                    if (Math.max((j * lstTargetQuantity[i].Conversion)) > DeficitQty) {
                        var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 10);
                        cellobj.setCellData("value", j);
                        cellobj.setCellText(j);
                        var cellobj = FGRIDCONTROL.getCellObject("grd_Source", i + 1, 11);
                        cellobj.setCellData("value", (j * lstTargetQuantity[i].Conversion));
                        cellobj.setCellText(j * lstTargetQuantity[i].Conversion);
                        TotalRequestedQuantity += (j * lstTargetQuantity[i].Conversion);
                        BalancedQ = (DeficitQty - lstTargetQuantity[i].AvailableTargetQuantity);
                        break;
                    }
                }
            }
            document.getElementById('Total_Target_Quantity').innerHTML = TotalRequestedQuantity;
        }
        catch (err) {
            COMMON.prototype.showMessage("StockReplenishment.AutoAllocateClick : " + err.message, "Exception");
            return false;
        }
