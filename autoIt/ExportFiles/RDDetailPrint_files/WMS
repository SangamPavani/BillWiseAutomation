                SelectedOperationType: SelectedOperationType,
                ServiceItem: ServiceItem,
                ChargeBy: ChargeBy,
                BillingTag: BillingTag,
                ChargeCalculationType: ChargeCalculationType,
                BinSize: BinSize,
