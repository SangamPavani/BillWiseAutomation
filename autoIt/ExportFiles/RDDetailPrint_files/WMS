                var optStorer = OPTIONCONTROL.getControlValue("optAdvStorer");
                var optAdvInv = OPTIONCONTROL.getControlValue("optAdvInvTag");
                var dpAdvDate = DATEPICKER.getDate("dpAdvDate");
                var productArr = [];
                for (var i = 1; i <= FGRIDCONTROL.getTotalRows("grdAdvChargeVoucher"); i++) {
                    if (i === cellobj.iRow) {
                        continue;
                    }
                    var ObjProduct = FGRIDCONTROL.getCellObject("grdAdvChargeVoucher", i, 2);
                    var Product = ObjProduct.getCellData("value");
                    if (Product != "" && Product != undefined && Product != null && Product != 0 && Product != 'NaN') {
                        productArr.push(Product);
                    }
                }
                var filter = "";
                if (productArr.length > 0) {
                    filter += "iProduct NOT IN (" + productArr.join(",") + ") AND ";
                }
                filter += "iStorerId = " + optStorer + " AND iInvTagId = " + optAdvInv + " AND iCalcStartDate <= " + dpAdvDate;
