    ServiceFilter: function (iRow) {
        try {
            ExcludeServiceIds = [0];
            for (var i = 0; i < FGRIDCONTROL.getTotalRows("Grd_ServiceCharges"); i++) {
                for (var j = 0; j < FGRIDCONTROL.getTotalColumns("Grd_ServiceCharges"); j++) {
                    var cellObj = FGRIDCONTROL.getCellObject("Grd_ServiceCharges", (i + 1), j + 1);
                    if (cellObj != null) {
                        var objRowElement = FGRIDCONTROL.getRowValue("Grd_ServiceCharges", cellObj.iRow);
                        if (iRow != (i + 1)) {
                            switch (cellObj.ColumnAttribute.ctrlid) {
                                case "GridAssetId":
                                    if (objRowElement[j].Data.value != "NaN") {
                                        ExcludeServiceIds.push(objRowElement[j].Data.value == undefined ? 0 : objRowElement[j].Data.value);
                                    }
                                    break;
                                default:
                                    break;
                            }
                        }
                    }
                }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ServiceCharges.ServiceFilter} " + err.message, "Exception")
        }
    }
