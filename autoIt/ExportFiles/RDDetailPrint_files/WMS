    onLeave: function (cellobj, event) {
        try {
            var element = null;
            var data = null;
            if (COMMON.prototype.isValidObject(cellobj.ColumnAttribute.ctrlid) == true) {
                var objAllowInputValue = FGRIDCONTROL.getCellObject(SERVICECHARGESADV.sGridId, cellobj.iRow, AdvServiceChargeCol.get('AllowInputValue'));
                var bAllowInputValue = FConvert.toBoolean(objAllowInputValue.getCellData("value"));
                switch ((FConvert.toInt(cellobj.ColumnAttribute.datatypeid))) {
                    case MasterDataType.get("MASTER"):                     
                        break;
                    case MasterDataType.get('DATE'):
                        break;
                    case MasterDataType.get("NUMBERLIST"):
                        if (cellobj.iColumn != AdvServiceChargeCol.get('ChargeOn')) {
                            if (bAllowInputValue) {
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                if (element.selectedIndex != -1) {
                                    cellobj.setCellData("value", element.value);
                                    cellobj.setCellText(element.options[element.selectedIndex].text);
                                }
                            }
                        }
                        break;
                    case MasterDataType.get("FRACTION"):
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        var objApplyType = FGRIDCONTROL.getCellObject(SERVICECHARGESADV.sGridId, cellobj.iRow, AdvServiceChargeCol.get('ApplyTypeId'));
                        var objCharges = FGRIDCONTROL.getCellObject(SERVICECHARGESADV.sGridId, cellobj.iRow, AdvServiceChargeCol.get('Charges'));
                        var objTotalCharges = FGRIDCONTROL.getCellObject(SERVICECHARGESADV.sGridId, cellobj.iRow, AdvServiceChargeCol.get('TotalCharges'));
                        var iApplyType = parseInt(objApplyType.getCellData("value"));
                        var iCharges = FConvert.toInt(objCharges.getCellData("value"));
                        if (iApplyType == 1 && bAllowInputValue) {
                            if (cellobj.iColumn == AdvServiceChargeCol.get('Quantity')) {
                                var iValue = element.value;
                                if (iValue > 0) {
                                    var iTotalCharges = (iValue * iCharges).toFixed(iNoOfQtyDecimal);
                                    objTotalCharges.setCellData("value", Number(iTotalCharges).toFixed(iNoOfQtyDecimal));
                                    objTotalCharges.setCellText(Number(iTotalCharges).toFixed(iNoOfQtyDecimal));
                                }
                                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                                cellobj.setCellData("value", element.value);
                                cellobj.setCellText(element.value);
                            }
                        }
                        break;
                    case MasterDataType.get("TEXT"):
                        element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                        if (element != null) {
                            cellobj.setCellText($("#" + cellobj.ColumnAttribute.ctrlid).val());
                            cellobj.setCellData("value", $("#" + cellobj.ColumnAttribute.ctrlid).val());
                        }
                        cellobj.processDefault(event);
                        break;
                    case MasterDataType.get("BOOLEAN"):
                        cellobj.processDefault(event);
                        break;
                    default:
                        break;
                }
                return (true);
            }
