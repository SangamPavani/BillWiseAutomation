    SearchAdvEntry: function () {
        try {
            // debugger
            for (var i = 0; i < optOperationType.length; i++) {
                $('#grd_TriffMasterAdvEntry' + optOperationType[i].ID + '_body').scrollTop(30);
                var inputVal = $("#txtsearchTariffAdv").val().trim();
                var table = $('#grd_TriffMasterAdvEntry' + optOperationType[i].ID + '_body');
                var counter = 0;
                table.find('tr').each(function (index, row) {

                    var allCells = $(row).find('td');
                    var found = false;
                    allCells.each(function (index, td) {

                        td.style.color = "";
                        var regExp = new RegExp(inputVal, 'i');
                        if (inputVal == "") {
                            found = false;
                            td.style.color = "";
                        }
                        else if (regExp.test($(td).text())) {
                            found = true;
                            td.style.color = "red";
                        }
                    });
                    if (found == true) {

                        counter++;
                        $(row).addClass("FRowColor");
                        if (counter == 1) {
                            var rowpos = $('.FRowColor').position();
                            var position = rowpos.top - 100;
                            if (position >= 0) {
                                $('#grd_TriffMasterAdvEntry' + optOperationType[i].ID + ' tbody').scrollTop(position);
                            }
                            else {
                                $('#grd_TriffMasterAdvEntry' + optOperationType[i].ID + ' tbody').scrollTop(rowpos.top);
                            }

                        }
                    }
                    else {
                        $(row).removeClass("FRowColor");
                    }
                });
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception - TariffMasterAdvEntryMethods.SearchAdvEntry " + err.message);
        }
