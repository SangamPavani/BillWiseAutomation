                    if (totalrows < arrDataPerPage.length) {
                        FGRIDCONTROL.insertRows("grdASNDetails", iRowCounter, arrDataPerPage.length - totalrows);
                    } else if (totalrows > arrDataPerPage.length) {
                        FGRIDCONTROL.deleteRows("grdASNDetails", iRowCounter, totalrows - arrDataPerPage.length);
                    }
                }

                for (iColCounter = 1; iColCounter <= 11; iColCounter++) {
                    objData = arrDataPerPage[iRowCounter - 1];
                    cellobj = FGRIDCONTROL.getCellObject("grdASNDetails", iRowCounter, iColCounter);

