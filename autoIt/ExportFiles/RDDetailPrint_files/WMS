                    var OperationType = obj.getCellData("value");
                    if (OperationType == "" || OperationType == null || OperationType == undefined) {
                        FGRIDCONTROL.deleteRows("grd_TriffMasterAdvEntry" + SelectedOperationType, 1, 1);
                    }
                }
                bOpenCreateFee = false;
            }
            var GridLength = 0;
            if (iRowLength == 0) {
                FGRIDCONTROL.insertRows("grd_TriffMasterAdvEntry" + SelectedOperationType, 0, 1);
                GridLength = (FGRIDCONTROL.getTotalRows("grd_TriffMasterAdvEntry" + SelectedOperationType));
            }
            else {
                if (SelectedOperationType != iServiceTypeName) {                   
                    var obj = FGRIDCONTROL.getCellObject("grd_TriffMasterAdvEntry" + SelectedOperationType, 1, 2);
                    var OperationType = obj.getCellData("value");
                    if (OperationType != "" && OperationType != null && OperationType != undefined) {
                        FGRIDCONTROL.insertRows("grd_TriffMasterAdvEntry" + SelectedOperationType, 0, 1);
                    }
                    var cellobj = FGRIDCONTROL.getCellObject("grd_TriffMasterAdvEntry" + iServiceTypeName, iRowLength, 7);
                    var iTarrifChargeId = cellobj.getCellData("value") == "" ? "0" : cellobj.getCellData("value");
                    var url = GLOBAL.getContextPath("DeleteTariffMasterAdv", "TariffMaster", "WMS");
                    NETWORK.executeServerMethod(url,
                        true,
                        { iTarrifId: 0, iTariffChargeId: iTarrifChargeId, bMain: false },
                        "json",
                        true,
                        "TariffMasterAdvEntryMethods.DeleteTariffMasterAdvEntry_Success", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", false,false);
                    GridLength = (FGRIDCONTROL.getTotalRows("grd_TriffMasterAdvEntry" + SelectedOperationType));
                    FGRIDCONTROL.deleteRows("grd_TriffMasterAdvEntry" + iServiceTypeName, iRowLength);
                    if (FGRIDCONTROL.getTotalRows("grd_TriffMasterAdvEntry" + iServiceTypeName) == 0) {
                        $("#ServiceId_" + iServiceTypeName).css("display", "none");
                        $("#gridDiv_" + iServiceTypeName).css("display", "none");
                    }
                }
                else {
                    GridLength = iRowLength;
                }
            }

            for (var iCol = 1; iCol <= FGRIDCONTROL.getTotalColumns("grd_TriffMasterAdvEntry" + SelectedOperationType); iCol++) {
                var cellobj = FGRIDCONTROL.getCellObject("grd_TriffMasterAdvEntry" + SelectedOperationType, GridLength, iCol);
                switch (iCol) {
                    case 1:
                        cellobj.setCellData("value", JSON.stringify(ObjCreate));
                        break;
                    case 2:
                        cellobj.setCellData("value", SelectedOperationType);
                        cellobj.setCellText(SelectedOperationTypeTxt);
                        break;
                    case 3:
                        cellobj.setCellData("value", ServiceItem);
                        cellobj.setCellText(ServiceItemTxt);
                        break;
                    case 4:
                        cellobj.setCellData("value", ChargeBy);
                        cellobj.setCellText(ChargeByTxt);
                        break;
                    case 5:
                        cellobj.setCellData("value", BillingTag);
                        cellobj.setCellText(BillingTagtxT);
                        break;
                    case 6:
                        cellobj.setCellData("value", ChargeCalculationType);
                        cellobj.setCellText(ChargeCalculationTypeTxt);
                        break;
                    case 7:
                        cellobj.setCellData("value", cellobj.getCellData("value") == "" ? 0 : cellobj.getCellData("value"));
                        cellobj.setCellText(cellobj.getCellData("value") == "" ? 0 : cellobj.getCellData("value"));
                        break;
                }
            }
            TariffMasterAdvEntryMethods.closeFeePopup();
            TariffMasterAdvEntryMethods.ClearCreateFee();
        }
        catch (err) {
            COMMON.prototype.showMessage("TariffMasterAdvEntryMethods.CreateFeeSave : " + err.message, "Exception");
            return false;
        }
