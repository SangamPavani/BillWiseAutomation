    RiseRequest: function (bSalesOrder = false, OrderNo) {
        //debugger;
        try {
            if (!bSalesOrder) {
                var IsValidate = StockReplenishment.GetHeaderControlsData();
                var IsSelected = StockReplenishment.GetGridControlData();
                OrderNo = OPTIONCONTROL.getControlText("mltOpt_SalesOrders");
                if (!IsValidate || !IsSelected) {
                    return false;
                }
                var strSourceBin = '';
                if (ObjReplenishment.LstBinReplenishment.length > 0) {
                    ObjReplenishment.LstBinReplenishment.forEach((list) => {
                        strSourceBin += list.SourceBin
                    })
                }
                if (strSourceBin == '') {
                    COMMON.prototype.showMessage(ResourceMessages[8].Value, "Message");
                    return false;
                }
                if (ObjReplenishment.LstBinReplenishment.length != SourceBinEdit.length) {
                    if (confirm(ResourceMessages[9].Value) == false) {
                        return false;
                    }
                }
            }
            var UnmatchedBins = [];
            var TargetBinLength = ObjReplenishment.LstBinReplenishment.length;
            ObjReplenishment.LstBinReplenishment.forEach((record, index) => {
                var Bins = [];
                var matched = false;
                if (SourceBinEdit.length > 0) {
                    SourceBinEdit.forEach((item) => {
                        if (record.RowId == item.SelectRow) {
                            for (var i = 0; i < item.SourceBinData.length; i++) {
                                var obj = {
                                    SourceBinId: item.SourceBinData[i].SourceBinId,
                                    SourceBin: item.SourceBinData[i].SourceBin,
                                    SourceUnitId: item.SourceBinData[i].SourceUnitId,
                                    RequestedQuantity: item.SourceBinData[i].RequestedQuantity,
                                    TargetQuantity: item.SourceBinData[i].TargetQuantity,
                                    InvTag: item.SourceBinData[i].InvTag,
                                    ItemId: item.SourceBinData[i].ItemId
                                };
                                Bins.push(obj)
                            }
                            matched = true;
                        }
                    })
                }
                if (!matched) {
                    UnmatchedBins.push({ ...record, index });  
                }
                record.BinsData = Bins;
            })

            if (UnmatchedBins.length > 0) {
                var strMessage = ""
                UnmatchedBins.forEach((bin) => {
                    strMessage += bin.TargetBin + " " + ResourceMessages[8].Value + "\n"
                    for (let i = ObjReplenishment.LstBinReplenishment.length - 1; i >= 0; i--) {
                        if (ObjReplenishment.LstBinReplenishment[i].RowId == bin.RowId) {
                            ObjReplenishment.LstBinReplenishment.splice(i, 1);
                            break;
                        }
                    }
                })
                if (bSalesOrder) {
                    transEntryGlobal.writeErrorLog("{StockReplenishment.RiseRequest} " + strMessage);
                    return false;
                }
                //else {
                //    COMMON.prototype.showMessage(strMessage, "Message");
                //}
                if (TargetBinLength == UnmatchedBins.length) {
                    return false;
                }
            }
            var Result = NETWORK.executeServerMethod(
                GLOBAL.getContextPath("RiseRequestReplenishment", "ProductionProcess", "WMS"),
                true,
                { objReplenishment: ObjReplenishment, sOrderNo: OrderNo },
                "Json", true,
                "StockReplenishment.RiseRequest_Success", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", bSalesOrder);

            return true;
        }
        catch (err) {
            COMMON.prototype.showMessage("StockReplenishment.RiseRequest : " + err.message, "Exception");
        }
    },
