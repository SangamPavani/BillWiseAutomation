    validateInputNumber: function (eleInput, iType, evt) {
        var charCode = null;

        try {
            bResult = false;

            if (evt.which == 0 || evt.which == 8) {
                return (true);
            }

            charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode == 45) {
                if ((iType == 0 || iType == 2)
                    && eleInput.value.length == 0) {
                    return (true);
                }
            }
            else if (charCode == 46) {
                var splitedValue = parseInt(eleInput.value.split('.')[0]);
                if ((iType == 2 || iType == 3)
                    && (eleInput.value.indexOf(".") == -1 || splitedValue == 0)) {
                    return (true);
                }
            }
            else if (charCode >= 48 && charCode <= 57) {
                return (true);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{CartonwiseDistribution.validateInputNumber} " + err.message, "Exception");
        }

        return (false);
