            //debugger
            var iTotalRows = FGRIDCONTROL.getTotalRows("grd_TriffMasterAdvEntry" + SelectedOperationType);
            for (var i = 1; i <= iTotalRows; i++) {
                if (iRowLength != i) {
                    var sDuplicate = TariffMasterAdvEntryMethods.DuplicateRecord(SelectedOperationType, ObjCreate, i, SelectedOperationTypeTxt);
                    if (sDuplicate == false) {
                        return false;
                    }
                }
                if (iServiceTypeName != "" && SelectedOperationType != iServiceTypeName) {
                    var sDuplicate = TariffMasterAdvEntryMethods.DuplicateRecord(SelectedOperationType, ObjCreate, i, SelectedOperationTypeTxt);
                    if (sDuplicate == false) {
                        return false;
                    }
                }
            }
