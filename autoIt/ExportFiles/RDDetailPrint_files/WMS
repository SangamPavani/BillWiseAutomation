    HandleEvents_OverrideBilling: function (overrideData) {
        try {
            //debugger
            var lastCheckedRow = 0;
            var countChecked = 0;
            var GridBillingDetails = [];
            var GridTotalRow = FGRIDCONTROL.getTotalRows(ADVANCEBILLING.sGridId);
            $("#" + ADVANCEBILLING.sGridId +"_control_heading_ctrl_1").prop("checked", false);
            FGRIDCONTROL.update(ADVANCEBILLING.sGridId);
            for (var iRowCounter = 1; iRowCounter <= GridTotalRow; iRowCounter++) {
                gridRowData = FGRIDCONTROL.getRowValue(ADVANCEBILLING.sGridId, iRowCounter);
                var AllBillingDet = {
                    StorerId: parseInt(gridRowData[1].Value),
                    StorerName: gridRowData[1].Text,
                    BillHeaderId: parseInt(gridRowData[2].Value),
                    FromDate: parseInt(gridRowData[3].Value),
                    ToDate: parseInt(gridRowData[4].Value),
                    BillGenDate: parseInt(gridRowData[5].Value),
                    WHId: parseInt(gridRowData[6].Value),
                }
                if (gridRowData[1].Text != '' && COMMON.prototype.isValidObject(gridRowData[1].Text)) {
                    if (gridRowData[0].Value) {
                        GridBillingDetails.push(AllBillingDet)
                        countChecked++;
                        lastCheckedRow = gridRowData[0].iRow;
                    }
                }
            }
            if (countChecked == 0) {
                COMMON.prototype.showMessage("Please Select valid Row");
                //ADVANCEBILLING.ClearGridCtrl()
                return false;
            }
            if (countChecked != lastCheckedRow) {
                COMMON.prototype.showMessage(ResourceMsg.msgselectrecordsaccordingtoBillGeneratedDate);
                return false;
            }
            var URL;
            if (overrideData == true) {
                URL = GLOBAL.getContextPath("RegisterAdvBillOverrideBilling", "AdvanceBilling", "WMS")
            } else {
                URL = GLOBAL.getContextPath("DeleteAdvBillOverrideBilling", "AdvanceBilling", "WMS")
            }
            NETWORK.executeServerMethod(URL, true, { objBillingHeaderData: GridBillingDetails }, "json", true, "ADVANCEBILLING.HandleEvents_OverrideBilling_Sucess", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd");
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {ADVANCEBILLING.HandleEvents_OverrideBilling} " + err.message, "Exception")
        }
