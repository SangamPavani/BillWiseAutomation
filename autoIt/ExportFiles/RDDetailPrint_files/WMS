    getResourceValue: function (sKey, GetResourceMessages) {
        ////debugger;
        try {
            var value = "";
            var result = null;

            result = TariffMasterAdvEntryMethods.findKeyValue(sKey, GetResourceMessages);
            if (result.lValue > 0) {
                value = result.data.Value;

                value = value.replace("{0}", "");
                value = value.replace("{1}", "");
            }
            return (value);
        }
        catch (err) {
            COMMON.prototype.showMessage("TariffMasterAdvEntryMethods.getResourceValue : " + err.message, "Exception");
