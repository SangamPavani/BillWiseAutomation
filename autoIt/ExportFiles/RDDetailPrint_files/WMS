                for (var index = 3; index < grdTriffMasterAdvEntry.rows.length; index++) {
                    var arCharges = [];
                    var arFilter = [];
                    var obj = grdTriffMasterAdvEntry.rows[index].cells[1].dataset.value;
                    if (obj != undefined && obj != "") {
                        var objRow = JSON.parse(obj);
                        for (var i = 0; i < objRow.Field.length; i++) {
                            var objAddCharges = {
                                TariffChargeId: 0
                            };
                            for (var j = 0; j < objRow.Field[i].length; j++) {
                                var col = objRow.Field[i][j];
                                var key = col.id;
                                var value = col.value;
                                objAddCharges[key] = value;
                            }
                            arCharges.push(objAddCharges);
                        }
                        for (var i = 0; i < objRow.Filter.length; i++) {
                            var TreeData = {
                                ParentId: objRow.Filter[i].ParentId,
                                SubParentId: objRow.Filter[i].SubParentId
                            }
                            var objFilter = {
                                TariffChargeId: 0,
                                Conjunction: objRow.Filter[i].Conjuction,
                                FieldId: objRow.Filter[i].FieldId,
                                Operator: objRow.Filter[i].Operator,
                                CompareWith: objRow.Filter[i].CompareWith,
                                CompareValue: objRow.Filter[i].CompareValue,
                                iValue: 0,
                                Name: objRow.Filter[i].sExtraFieldName,
                                iValueType: objRow.Filter[i].DataType,
                                TreeData: TreeData,
                            }
                            arFilter.push(objFilter);
                        }

                        var objAdvTariffCharges = {
                            TariffId: 0,
                            TariffChargeId: grdTriffMasterAdvEntry.rows[index].cells[7].dataset.value,
                            OperationType: parseInt(objRow.SelectedOperationType),
                            ChargeCalcType: parseInt(objRow.ChargeCalculationType),
                            BillingTagId: 0,
                            Product: parseInt(objRow.ServiceItem),
                            ChargedOn: parseInt(objRow.ChargeBy),
                            MinCharges: objRow.Minimumcharges,
                            MaxCharges: objRow.MaximumCharges,
                            Unit: objRow.Unit,
                            ChargeBy: objRow.rdoCheck == 'rdoPerCount' ? 1 : objRow.rdoCheck == 'rdoPerCountRange' ? 2 : 3,
                            AllowInputValue: objRow.InputValue,
                            AdditionalChargesPerSKU: objRow.EveryAdditionalSKU,
                            AdditionalChargesPerUnit: objRow.EveryAdditionalSUnit,
                            ChargeOneTime: objRow.ChargeOneTime,
                            LstAdvanceFilterQuery: arFilter,
                            LstAddCharges: arCharges
                        }
                        arAdvTariffCharges.push(objAdvTariffCharges);
                    }
                }
            }
            if (arAdvTariffCharges.length == 0) {
                COMMON.prototype.showMessage(TariffMasterAdvEntryMethods.getResourceValue("lblChargeDetails", GetResourceMessages) + " " + TariffMasterAdvEntryMethods.getResourceValue("MRP_DR_msgCannotBeEmpty1", GetResourceMessages));
                return;
            }
            var objAdvTariff = {
                TariffId: EditTarrifId,
                Name: sTariffName,
                StorerId: optStorer,
                InvTagId: optInvTag,
                CalcStartDate: CalculationStartDate,
