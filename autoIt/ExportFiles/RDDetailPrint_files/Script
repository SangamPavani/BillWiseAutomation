    getDateInfo: function (sDate, sFormat) {
        let sSequence = "";
        let iCounter = 0;
        let bInvalid = false;
        let cValue = undefined;
        let cLastValue = undefined; 
        let objInfo = undefined;
        let arrData = undefined;

        try {
            objInfo = {};
            objInfo.Init = function () {
                this.Separator = "";
                this.DayText = "";
                this.MonthText = "";
                this.YearText = "";

                this.Day = {};
                this.Day.Index = -1;
                this.Day.Format = "";
                this.Day.Text = "";

                this.Month = {};
                this.Month.Index = -1;
                this.Month.Format = "";
                this.Month.Text = "";

                this.Year = {};
                this.Year.Index = -1;
                this.Year.Format = "";
                this.Year.Text = "";

            }

            objInfo.Init();
            if (DataType.isNullOrEmpty(sFormat, true) == true) {
                return (objInfo);
            }

            sFormat = sFormat.trim();

            bInvalid = false;
            for (iCounter = 0; iCounter < sFormat.length; iCounter++) {
                cValue = sFormat[iCounter];

                if (cValue == 'd' || cValue == 'D') {
                    if (cLastValue != undefined && cLastValue != cValue && objInfo.Day.Format.length > 0) {
                        bInvalid = true;
                        break;
                    }

                    if (objInfo.Day.Format.length == 0) {
                        objInfo.Day.Index = iCounter;
                        sSequence += "D";
                    }

                    objInfo.Day.Format += cValue;
                    cLastValue = cValue;
                }
                else if (cValue == 'm' || cValue == 'M') {
                    if (cLastValue != undefined && cLastValue != cValue && objInfo.Month.Format.length > 0) {
                        bInvalid = true;
                        break;
                    }

                    if (objInfo.Month.Format.length == 0) {
                        objInfo.Month.Index = iCounter;
                        sSequence += "M";
                    }

                    objInfo.Month.Format += cValue;
                    cLastValue = cValue;
                }
                else if (cValue == 'y' || cValue == 'Y') {
                    if (cLastValue != undefined && cLastValue != cValue && objInfo.Year.Format.length > 0) {
                        bInvalid = true;
                        break;
                    }

                    if (objInfo.Year.Format.length == 0) {
                        objInfo.Year.Index = iCounter;
                        sSequence += "Y";
                    }

                    objInfo.Year.Format += cValue;
                    cLastValue = cValue;
                }
                else {
                    objInfo.Separator = cValue;
                }
            }

            if (bInvalid == true
                || (objInfo.Day.Index == -1
                    && objInfo.Month.Index == -1
                    && objInfo.Year.Index == -1)) {

                objInfo.Init();

                return (objInfo);
            }

            if (DataType.isNullOrEmpty(sDate, true) == false && objInfo.Separator != "") {
                sDate = sDate.trim();

                arrData = sDate.split(objInfo.Separator);
                if (arrData != null && arrData.length == sSequence.length) {
                    for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                        switch (sSequence[iCounter]) {
                            case 'D':
                                objInfo.DayText = arrData[iCounter];
                                break;
                            case 'M':
                                objInfo.MonthText = arrData[iCounter];
                                break;
                            case 'Y':
                                objInfo.YearText = arrData[iCounter];
                                break;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FDate.getDateInfo} " + err.message);
        }

        return (objInfo);
    },

    getBrowserDateFormat: function () {
        let sFormat = "";
        let sDateString = "";
        let sSeparator = "";
        let sFirstPart = "";
        let sSecondPart = "";
        let sThirdPart = "";
        let arrDateParts = [];
        let mydate = null;

        try {
            // initialize date value "31st January 2019"
            mydate = new Date(2019, 0, 31);

            sDateString = mydate.toLocaleDateString();
            // get separator : "-", "/" or " "
            if (sDateString.split("-").length == 3) {
                sSeparator = "-";
                arrDateParts = sDateString.split(sSeparator);
            }
            else if (sDateString.split("/").length == 3) {
                sSeparator = "/";
                arrDateParts = sDateString.split(sSeparator);
            }
            else if (sDateString.split(" ").length == 3) {
                sSeparator = " ";
                arrDateParts = sDateString.split(sSeparator);
            }
            else {
                return("");
            }

            // get first part        
            if (arrDateParts[0] == 2019) {
                sFirstPart = "yyyy";
            }
            else if (arrDateParts[0] == 31) {
                sFirstPart = "dd";
            }
            else
            {
                switch(arrDateParts[0].length)
                {
                    case 1:
                        sFirstPart = "m";
                        break;
                    case 2:
                        sFirstPart = "mm";
                        break;
                    default:
                        sFirstPart = "mmm";
                        break;
                }
            }

            // get second part        
            if (arrDateParts[1] == 2019) {
                sSecondPart = "yyyy";
            }
            else if (arrDateParts[1] == 31) {
                sSecondPart = "dd";
            }
            else {
                switch (arrDateParts[1].length) {
                    case 1:
                        sSecondPart = "m";
                        break;
                    case 2:
                        sSecondPart = "mm";
                        break;
                    default:
                        sSecondPart = "mmm";
                        break;
                }
            }

            // get third part        
            if (arrDateParts[2] == 2019) {
                sThirdPart = "yyyy";
            }
            else if (arrDateParts[2] == 31) {
                sThirdPart = "dd";
            }
            else {
                switch (arrDateParts[2].length) {
                    case 1:
                        sThirdPart = "m";
                        break;
                    case 2:
                        sThirdPart = "mm";
                        break;
                    default:
                        sThirdPart = "mmm";
                        break;
                }
            }

            sFormat = sFirstPart + sSeparator + sSecondPart + sSeparator + sThirdPart;
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {FDate.getBrowserDateFormat} " + err.message);

            return ("");
        }

        return(sFormat);
    },

