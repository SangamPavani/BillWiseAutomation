                                    if (objRowData[sProperty].hasOwnProperty(sSibling) == true) { // Property exist
                                        break;
                                    }
                                }

                                if (iCounter1 == arrSibling.length) { // No property exist
                                    continue;
                                }
                            }
                        }
                    }

                    if (arrProperty.length > 2) { // Multiple level
                        sProperty2 = arrProperty[2].trim();

                        if (arrProperty.length == 2) {
                            arrSibling = sProperty2.split(';');
                        }
                        else {
                            arrSibling = [sProperty2];
                        }

                        if (objRowData[sProperty][sProperty1] == undefined
                            || objRowData[sProperty][sProperty1] == null) {
                            continue;
                        }

                        if (arrSibling.length == 1) {
                            if (objRowData[sProperty][sProperty1].hasOwnProperty(sProperty2) == false) {
                                continue;
                            }
                        }
                        else {
                            for (iCounter1 = 0; iCounter1 < arrSibling.length; iCounter1++) {
                                sSibling = arrSibling[iCounter1];
                                if (objRowData[sProperty][sProperty1].hasOwnProperty(sSibling) == true) {
                                    break;
                                }
                            }

                            if (iCounter1 == arrSibling.length) {
                                continue;
                            }
                        }
                    }

                    if (arrProperty.length > 3) {
                        continue;
                    }

                    obj = undefined;
                    for (iCounter = 0; iCounter < arrResult.length; iCounter++) {
                        if (arrResult[iCounter].iRowNo == iRow) {
                            obj = arrResult[iCounter];
                            break;
                        }
                    }

                    if (obj == undefined) {
                        obj = {};
                        obj.iRowNo = iRow;
                        arrResult.push(obj);
                    }

                    if (arrProperty.length > 1) {
                        if (objRowData[sProperty] == undefined || objRowData[sProperty] == null) {
                            obj[sProperty] = objRowData[sProperty];
                            break;
                        }
                    }

                    if (arrProperty.length == 1) { // Single level
                        DataType.copyObjectProperty(sProperty, null, null, arrSibling, objRowData, obj);
                    }
                    else if (arrProperty.length == 2) { // Two level (Object required)
                        if (DataType.isArray(objRowData[sProperty]) == true) { // Property is array type
                            if (obj[sProperty] == undefined) {
                                obj[sProperty] = [];
                            }

                            for (iCounter = 0; iCounter < objRowData[sProperty].length; iCounter++) {
                                if (objRowData[sProperty][iCounter] == undefined
                                    || objRowData[sProperty][iCounter] == null) {
                                    continue;
                                }

                                if (arrSibling.length == 1) { // Single property
                                    if (objRowData[sProperty][iCounter].hasOwnProperty(sProperty1) == false) { // Property exist
                                        continue;
                                    }

                                    obj[sProperty].push({
                                        [sProperty1]: objRowData[sProperty][iCounter][sProperty1]
                                    });
                                }
                                else if (arrSibling.length > 1) { // Multiple property
                                    obj[sProperty].push({});

                                    for (iCounter1 = 0; iCounter1 < arrSibling.length; iCounter1++) {
                                        sSibling = arrSibling[iCounter1];
                                        if (objRowData[sProperty][iCounter].hasOwnProperty(sSibling) == true) { // Property exist
                                            obj[sProperty][obj[sProperty].length - 1][sSibling] = objRowData[sProperty][iCounter][sSibling];
                                        }
                                    }
                                }
                            }
                        }
                        else { //Property is object type
                            if (obj[sProperty] == undefined) {
                                obj[sProperty] = {};
                            }

                            DataType.copyObjectProperty(sProperty, sProperty1, null, arrSibling, objRowData, obj);
                        }
                    }
                    else if (arrProperty.length == 3) { // Three level (Object required)
                        if (obj[sProperty] == undefined) {
                            obj[sProperty] = {};
                        }

                        if (obj[sProperty][sProperty1] == undefined) {
                            obj[sProperty][sProperty1] = {};
                        }

                        DataType.copyObjectProperty(sProperty, sProperty1, sProperty2, arrSibling, objRowData, obj);
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.arraySelect} " + err.message);
        }

        return (arrResult);
    },

    copyObjectProperty: function (sProperty, sProperty1, sProperty2, arrSibling, objSource, objTarget) {
        let sSibling = "";
        let iCounter = 0;

        try {
            if (sProperty == undefined || sProperty == null) {
                return;
            }

            if (sProperty2 != undefined && sProperty2 != null) {
                if (arrSibling.length == 1) { // Single property
                    objTarget[sProperty][sProperty1][sProperty2] = objSource[sProperty][sProperty1][sProperty2];
                }
                else if (arrSibling.length > 1) {
                    for (iCounter = 0; iCounter < arrSibling.length; iCounter++) {
                        sSibling = arrSibling[iCounter];
                        if (objSource[sProperty][sProperty1].hasOwnProperty(sSibling) == true) { // Property exist
                            objTarget[sProperty][sProperty1][sSibling] = objSource[sProperty][sProperty1][sSibling];
                        }
                    }
                }
            }
            else if (sProperty1 != undefined && sProperty1 != null) {
                if (arrSibling.length == 1) { // Single property
                    objTarget[sProperty][sProperty1] = objSource[sProperty][sProperty1];
                }
                else if (arrSibling.length > 1) { // Multiple property
                    for (iCounter = 0; iCounter < arrSibling.length; iCounter++) {
                        sSibling = arrSibling[iCounter];
                        if (objSource[sProperty].hasOwnProperty(sSibling) == true) { // Property exist
                            objTarget[sProperty][sSibling] = objSource[sProperty][sSibling];
                        }
                    }
                }
            }
            else {
                if (arrSibling.length == 1) { // Single property
                    objTarget[sProperty] = objSource[sProperty];
                }
                else { // Multiple property
                    for (iCounter = 0; iCounter < arrSibling.length; iCounter++) {
                        sSibling = arrSibling[iCounter];
                        if (objSource.hasOwnProperty(sSibling) == true) { // Property exist
                            objTarget[sSibling] = objSource[sSibling];
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.copyObjectProperty} " + err.message);
        }
    },

    arrayToString: function(arr) {
        let value;

        try {
            value = String.fromCharCode.apply(null, arr);
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {DataType.arrayToString} " + err.message);
        }

        return(value);
    },

    arrayFromObject: function (obj, bIgnoreBlankKey) {
        /* Returns object property value array */
        let bIgnore = false;
        let result = undefined;

        try {
            result = {};
            result.property = [];
            result.value = [];

            if (DataType.isValidObject(obj) == true) {
                if (DataType.isValidObject(bIgnoreBlankKey) == true) {
                    bIgnore = bIgnoreBlankKey;
                }

                for (skey in obj) {
                    if (bIgnore == false || DataType.isNullOrEmpty(skey) == false) {
                        result.property.push(skey);
                        result.value.push(obj[skey]);
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.arrayFromObject} " + err.message);
        }

        return (result);
    },

    arrayCreate: function (arrObj, PropertyName) {
        /* Creates and returns object or value array of matched property.
           If PropertyName is string or single string value array, return will be value array.
           If PropertyName is multiple string value array, return will be object array. */
        let sProperty = "";
        let iCounter = 0;
        let iIndex = 0;
        let bObject = false;
        let arrProp = undefined;
        let arrResult = undefined;
        let obj = undefined;

        try {
            if (DataType.isArray(arrObj) == false
                || DataType.isValidObject(PropertyName) == false) {
                return;
            }

            bObject = false;
            if (DataType.isString(PropertyName) == true) {
                if (DataType.isNullOrEmpty(PropertyName, true) == true) {
                    return;
                }

                arrProp = [];
                arrProp.push(PropertyName);
            }
            else {
                bArray = DataType.isArray(PropertyName);
                if (bArray == false) {
                    return;
                }

                if (PropertyName.length > 1) {
                    bObject = true;
                }

                arrProp = [];
                for (iCounter = 0; iCounter < PropertyName.length; iCounter++) {
                    arrProp.push(PropertyName[iCounter]);
                }
            }

            arrResult = [];
            for (iCounter = 0; iCounter < arrObj.length; iCounter++) {
                if (bObject == true) {
                    obj = {};
                    for (iIndex = 0; iIndex < arrProp.length; iIndex++) {
                        sProperty = arrProp[iIndex];

                        obj[sProperty] = arrObj[iCounter][sProperty];
                    }

                    arrResult.push(obj);
                }
                else {
                    sProperty = arrProp[0];
                    arrResult.push(arrObj[iCounter][sProperty]);
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.arrayCreate} " + err.message);
        }

        return (arrResult);
    },

    arrayToCSV: function (arrData, separator) {
        let iCounter = 0;
        let sResult = "";
        let bArray = false;

        try {
            if (DataType.isValidObject(arrData) == false) {
                return (sResult);
            }

            if (DataType.isArray(arrData) == true) {
                bArray = true;
            }
            else { // Base64 string is assumed in arrData
                arrData = Uint8Array.from(atob(arrData), c => c.charCodeAt(0));
                bArray = true;
            }

            if (bArray == true) {
                if(DataType.isValidObject(separator) == false) {
                    separator = ",";
                }

                for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                    if (iCounter > 0) {
                        sResult += separator;
                    }

                    sResult += arrData[iCounter];
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.arrayToCSV} " + err.message);
        }

        return (sResult);
    },

    arrayFromCSV: function (sCSVData, separator) {
        let arrData = null;

        try {
            sCSVData = DataType.toString(sCSVData);
            if (DataType.isNullOrEmpty(sCSVData, true) == true) {
                arrData = [];
            }
            else {
                if(DataType.isValidObject(separator) == false) {
                    separator = ",";
                }

                arrData = sCSVData.split(separator);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.arrayFromCSV} " + err.message);
        }

        return (arrData);
    },

    arrayContains: function (arrData, value, sPropertyName, bIgnoreCase) {
        /* Returns index of matched value */
        let iCounter = 0;
        let iIndex = -1;
        let bFlag = false;
        let bPropertyName = false;
        let currentvalue = null;

        try {
            if (DataType.isNullOrEmpty(sPropertyName, true) == false) {
                bPropertyName = true;
            }

            if (DataType.isString(value) == true && DataType.toBoolean(bIgnoreCase) == true) {
                bFlag = true;
            }

            if (DataType.arrayLength(arrData) > 0) {
                for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                    if (bPropertyName == true) {
                        currentvalue = arrData[iCounter][sPropertyName];
                    }
                    else {
                        currentvalue = arrData[iCounter];
                    }

                    if (bFlag == true) {
                        if (currentvalue.toLowerCase() === value.toLowerCase()) {
                            iIndex = iCounter;
                            break;
                        }
                    }
                    else {
                        if (currentvalue === value) {
                            iIndex = iCounter;
                            break;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.arrayContains} " + err.message);
        }

        return (iIndex);
    },

    arraySort: function (arrData, property, bDesc) {
        let iCounter = 0;
        let iIndex = 0;
        let bSwap = false;
        let bProperty = false;
        let bObjIndex = false;
        let bObjCounter = false;
        let objIndex = undefined;
        let objCounter = undefined;
        let objTemp = undefined;

        try {
            if (DataType.isArray(arrData) == true) {
                bProperty = false;
                if (DataType.isString(property) == true) {
                    if (DataType.isNullOrEmpty(property, true) == false) {
                        bProperty = true;
                    }
                }

                for (iIndex = 0; iIndex < arrData.length; iIndex++) {
                    for (iCounter = iIndex + 1; iCounter < arrData.length; iCounter++) {
                        objIndex = arrData[iIndex];
                        objCounter = arrData[iCounter];

                        bObjIndex = DataType.isObject(objIndex);
                        bObjCounter = DataType.isObject(objCounter);
                        if (bProperty == true) {
                            // Both must be object for property comparison
                            if (bObjIndex == false || bObjCounter == false) {
                                continue;
                            }
                        }
                        else {
                            // Both must be non object for comparison
                            if (bObjIndex == true || bObjCounter == true) {
                                continue;
                            }                            
                        }

                        bSwap = false;
                        if (bDesc != true) { // Ascending
                            if (bProperty == true) {
                                if (objIndex[property] > objCounter[property]) {
                                    bSwap = true;
                                }
                            }
                            else {
                                if (objIndex > objCounter) {
                                    bSwap = true;
                                }
                            }
                        }
                        else {
                            if (bProperty == true) {
                                if (objIndex[property] < objCounter[property]) {
                                    bSwap = true;
                                }
                            }
                            else {
                                if (objIndex < objCounter) {
                                    bSwap = true;
                                }
                            }
                        }

                        if (bSwap == true) {
                            objTemp = objIndex;
                            objIndex = objCounter;
                            objCounter = objTemp;

                            arrData[iIndex] = objIndex;
                            arrData[iCounter] = objCounter;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.arraySort} " + err.message);
        }

        return (arrData);
    },

    arraySortNumber: function (arrNumber, bDesc) {
        let iCounter = 0;
        let iIndex = 0;
        let bSwap = false;
        let value = undefined;

        try {
            if (DataType.isArray(arrNumber) == true) {
                for (iIndex = 0; iIndex < arrNumber.length; iIndex++) {
                    for (iCounter = iIndex + 1; iCounter < arrNumber.length; iCounter++) {
                        bSwap = false;
                        if (bDesc != true) { // Ascending
                            if (arrNumber[iIndex] > arrNumber[iCounter]) {
                                bSwap = true;
                            }
                        }
                        else {
                            if (arrNumber[iIndex] < arrNumber[iCounter]) {
                                bSwap = true;
                            }
                        }

                        if (bSwap == true) {
                            value = arrNumber[iIndex];
                            arrNumber[iIndex] = arrNumber[iCounter];
                            arrNumber[iCounter] = value;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.arraySortNumber} " + err.message);
        }

        return (arrNumber);
    },

    arrayRemove: function(arr, value, bValueIsIndex) {
        let iCounter = 0;
        let iIndex = 0;
        let arrExclude = undefined;

        try {
            if(DataType.arrayLength(arr) < 1) {
                return;
            }

            if(bValueIsIndex == true) {
                arr.splice(value, 1);
            }
            else {
                if (DataType.isArray(value) == true) {
                    arrExclude = value;
                }
                else {
                    arrExclude = [];
                    arrExclude.push(value);
                }

                for (iIndex = 0; iIndex < arrExclude.length; iIndex++) {
                    iCounter = 0;
                    while (iCounter < arr.length) {
                        if (arr[iCounter] == arrExclude[iIndex]) {
                            arr.splice(iCounter, 1);
                            continue;
                        }

                        iCounter++;
                    }
                }
            }
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {DataType.arrayRemove} " + err.message);
        }
    },

    toByteArray: function(data, bBase64) {
        let iCounter = 0;
        let charcode = null;
        let value;

        try {
            if(DataType.isValidObject(data) == false) {
                return;
            }

            if(DataType.isObject(data) == true) {
                data = DataType.toString(data);
            }

            if(bBase64 == true) {
                data = LZUTF8.encodeBase64(data);
            }

            if(window.TextEncoder) {
                value = new TextEncoder("utf-8").encode(data);
            }
            else {
                value = [];
                for (iCounter = 0; iCounter < data.length; iCounter++) {
                    charcode = data.charCodeAt(iCounter);
                    if (charcode < 0x80) {
                        value.push(charcode);
                    }
                    else if (charcode < 0x800) {
                        value.push(0xc0 | (charcode >> 6),
                                    0x80 | (charcode & 0x3f));
                    }
                    else if (charcode < 0xd800 || charcode >= 0xe000) {
                        value.push(0xe0 | (charcode >> 12),
                                    0x80 | ((charcode>>6) & 0x3f),
                                    0x80 | (charcode & 0x3f));
                    }
                    // surrogate pair
                    else {
                        iCounter++;
                        // UTF-16 encodes 0x10000-0x10FFFF by
                        // subtracting 0x10000 and splitting the
                        // 20 bits of 0x0-0xFFFFF into two halves
                        charcode = 0x10000 + (((charcode & 0x3ff)<<10)
                                    | (data.charCodeAt(iCounter) & 0x3ff));
                        value.push(0xf0 | (charcode >>18),
                                      0x80 | ((charcode>>12) & 0x3f),
                                      0x80 | ((charcode>>6) & 0x3f),
                                      0x80 | (charcode & 0x3f));
                    }
                }
            }            
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {DataType.toByteArray} " + err.message);
        }

        return(value);
    },

    isNullOrEmpty: function (sValue, bTrim) {
        let sType = undefined;
        let result = false;

        try {
            sType = (typeof sValue).toLowerCase();
            if (sType == "undefined" || sValue == null) {
                result = true;
            }
            else if (sType == "string") {
                if (sValue.length <= 0) {
                    result = true;
                }
                else if (bTrim == true) {
                    if (sValue.trim().length == 0) {
                        result = true;
                    }
                }
            }

        //    if (sType == "undefined" || sValue == null || sValue == "" || sValue.length <= 0) {
        //        result = true;
        //    }

        //    if (DataType.isValidObject(bTrim) == true && bTrim == true) {
        //        if (sType == "string" && sValue.trim().length == 0) {
        //            return (true);
        //        }
        //    }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.isNullOrEmpty} " + err.message);
            result = true;
        }

        return (result);
    },

    stringStartsWith: function (sValue, sSearchString, bIgnoreCase) {
        let bResult = false;

        try {
            if (DataType.isNullOrEmpty(sValue) == false && DataType.isNullOrEmpty(sSearchString) == false) {
                if (bIgnoreCase === true) {
                    sValue = sValue.toLowerCase();
                    sSearchString = sSearchString.toLowerCase();
                }

                bResult = DataType.stringStartsWithRaw(sValue, sSearchString);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringStartsWith} " + err.message);
        }

        return (bResult);
    },

    stringStartsWithRaw: function (sValue, sSearchString) {
        let bResult = false;

        if (sValue.startsWith) {
            bResult = sValue.startsWith(sSearchString);
        }
        else if (sValue.length >= sSearchString.length) {
            if (sValue.substr(0, sSearchString.length) === sSearchString) {
                bResult = true;
            }
        }

        return (bResult);
    },

    stringEndsWith: function (sValue, sSearchString, bIgnoreCase) {
        let bResult = false;

        try {
            if (DataType.isNullOrEmpty(sValue) == false && DataType.isNullOrEmpty(sSearchString) == false) {
                if (sValue.endsWith) {
                    if(bIgnoreCase === true) {
                        bResult = sValue.toLowerCase().endsWith(sSearchString.toLowerCase());
                    }
                    else {
                        bResult = sValue.endsWith(sSearchString);
                    }
                }
                else if (sValue.length >= sSearchString.length) {
                    if(bIgnoreCase === true) {
                        if (sValue.substr((sValue.length - sSearchString.length), sSearchString.length).toLowerCase() === sSearchString.toLowerCase()) {
                            bResult = true;
                        }
                    }
                    else {
                        if (sValue.substr((sValue.length - sSearchString.length), sSearchString.length) === sSearchString) {
                            bResult = true;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringEndsWith} " + err.message);
        }

        return (bResult);
    },

    stringLeft: function(sValue, iCount) {
        let result = "";

        try {
            if (DataType.isNullOrEmpty(sValue) == true) {
                return ("");
            }

            if (DataType.isValidObject(iCount) == false
                || DataType.isInteger(iCount) == false) {
                return (sValue);
            }

            iCount = DataType.toInt(iCount);

            if (DataType.lt(sValue.length, iCount) == true) {
                return ("");
            }

            result = sValue.substr(0, iCount);
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringLeft} " + err.message);
        }

        return (result);
    },

    stringRight: function (sValue, iCount) {
        let result = "";

        try {
            if (DataType.isNullOrEmpty(sValue) == true) {
                return ("");
            }

            if (DataType.isValidObject(iCount) == false
                || DataType.isInteger(iCount) == false) {
                return (sValue);
            }

            iCount = DataType.toInt(iCount);
            if (DataType.lt(sValue.length, iCount) == true) {
                return ("");
            }

            result = sValue.substr((sValue.length - iCount), iCount);
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringRight} " + err.message);
        }

        return (result);
    },

    stringTrimStart: function (sValue, trimChars) {
        let sResult = "";

        try {
            if (DataType.isNullOrEmpty(sValue) == true) {
                return (sValue);
            }

            if (DataType.isNullOrEmpty(trimChars) == true) {
                sResult = sValue.trimLeft();
            }
            else {
                while (sValue.indexOf(trimChars) == 0) {
                    sValue = sValue.substr(1);
                }

                sResult = sValue;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.stringTrimStart} " + err.message);
        }

        return (sResult);
    },

    stringTrimEnd: function (sValue, trimChars) {
        let sResult = "";
        let arr = null;

        try {
            if (DataType.isNullOrEmpty(sValue) == true) {
                return (sValue);
            }

            if (DataType.isNullOrEmpty(trimChars) == true) {
                sResult = sValue.trimRight();
            }
            else {
                arr = sValue.split('');
                while (arr.length > 0) {
                    if (arr[arr.length - 1] == trimChars) {
                        arr.splice(arr.length - 1, 1);
                    }
                    else {
                        break;
                    }
                }

                sResult = arr.join('');
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.stringTrimEnd} " + err.message);
        }

        return (sResult);
    },

    stringIncludes: function (sValue, sSearchString, bIgnoreCase) {
        let bResult = false;

        try {
            if (DataType.isNullOrEmpty(sValue) == false && DataType.isNullOrEmpty(sSearchString) == false) {
                if (bIgnoreCase === true) {
                    sValue = sValue.toLowerCase();
                    sSearchString = sSearchString.toLowerCase();
                }

                bResult = DataType.stringIncludesRaw(sValue, sSearchString);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DataType.stringIncludes} " + err.message);
        }

        return (bResult);
    },

