    hasClass: function (ele, sClassName, bCheckAncestor) {
        let iCounter = 0;
        let arrClass = null;
        let objResult = null;

        try {
            objResult = {};
            objResult.Element = null;
            objResult.Value = false;

            if (DataType.isNullOrEmpty(sClassName) == true) {
                objResult.Value = false;
                return (objResult);
            }

            bCheckAncestor = DataType.toBoolean(bCheckAncestor);

            if (bCheckAncestor == true) {
                ele = FUIElement.getValidElement(ele);
                if (DataType.isValidObject(ele) == false) {
                    objResult.Value = false;

                    return (objResult);
                }

                while (ele.parentElement) {
                    if (FUIElement.hasClass(ele.parentElement, sClassName, false).Value == true) {
                        objResult.Element = ele.parentElement;
                        objResult.Value = true;
                        break;
                    }

                    ele = ele.parentElement;
                }
            }
            else {
                if (ele.classList) {
                    objResult.Element = ele;
                    objResult.Value = ele.classList.contains(sClassName);
                }
                else {
                    arrClass = ele.className.split(' ');
                    for (iCounter = 0; iCounter < arrClass.length; iCounter++) {
                        if (arrClass[iCounter] === sClassName) {
                            objResult.Element = ele;
                            objResult.Value = true;
                            break;
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FUIElement.hasClass} " + err.message, true);
        }

        return (objResult);
    },

