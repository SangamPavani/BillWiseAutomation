    formatDate: function (datePart, format, iCalendarType, iLanguageId, bUseDisplayNumber) { // http://www.codeproject.com/Articles/11011/JavaScript-Date-Format
        let arrMonthName = null;
        let arrDayName = null;
        let value = null;
        let dt = null;

        try {
            if (DataType.isValidObject(iCalendarType) == false) {
                iCalendarType = eCalendarType.Gregorean;
            }

            arrMonthName = FDate.getMonthNames(iCalendarType, iLanguageId);
            arrDayName = FDate.getWeekDaysName(iLanguageId);

            switch(iCalendarType)
            {
                case eCalendarType.Shamsi:
                    dt = PERSIAN.getDate(datePart[0], datePart[1] - 1, datePart[2]);
                    break;
                default:
                    dt = new Date(datePart[2], datePart[1] - 1, datePart[0]);
                    break;
            }

            if (DataType.isNullOrEmpty(format, true) == true) {
                format = GlobalPref.DateFormat;
            }

            value = format.replace(/(yyyy|mmmm|mmm|mm|m|dddd|ddd|dd|d|hh|nn|ss|a\/p)/gi,
                function ($1) {
                    switch ($1.toLowerCase()) {
                        case 'yyyy':
                            if(bUseDisplayNumber == true) {
                                return(FDate.getDisplayNumber(datePart[2], iCalendarType));
                            }

                            return datePart[2];
                        case 'mmmm':
                            return arrMonthName[datePart[1] - 1];
                        case 'mmm':
                            return arrMonthName[datePart[1] - 1].substr(0, 3);
                        case 'mm':
                            if(bUseDisplayNumber == true) {
                                return COMMON.prototype.zeroPadLeft(FDate.getDisplayNumber(datePart[1], iCalendarType), 2);
                            }

                            return COMMON.prototype.zeroPadLeft(datePart[1], 2);
                        case 'm':
                            if(bUseDisplayNumber == true) {
                                return(FDate.getDisplayNumber(datePart[1], iCalendarType));
                            }

                            return datePart[1];
                        case 'dddd':
                            return arrDayName[d.getDay()];
                        case 'ddd':
                            return arrDayName[d.getDay()].substr(0, 3);
                        case 'dd':
                            if(bUseDisplayNumber == true) {
                                return COMMON.prototype.zeroPadLeft(FDate.getDisplayNumber(datePart[0], iCalendarType), 2);
                            }

                            return COMMON.prototype.zeroPadLeft(datePart[0], 2);
                        case 'd':
                            if(bUseDisplayNumber == true) {
                                return(FDate.getDisplayNumber(datePart[0], iCalendarType));
                            }

                            return datePart[0];
                            //case 'hh': return ((h = d.getHours() % 12) ? h : 12).zf(2);
                            //case 'nn': return d.getMinutes().zf(2);
                            //case 'ss': return d.getSeconds().zf(2);
                            //case 'a/p': return d.getHours() < 12 ? 'a' : 'p';
                    }
                }
            );
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FDate.formatDate} " + err.message);
        }

        return (value);
    },

