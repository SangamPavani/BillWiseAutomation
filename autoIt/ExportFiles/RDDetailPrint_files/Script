var FGRIDCONTROL = {
    PRIVATE: {
        onKeyDown: function (table, event) {
            let sHandler = "";
            let bHandled = false;
            let obj = undefined;

            try {
                if (FCommon.UI.isPopupEvent(event) == true) {
                    return;
                }

                sHandler = FGRIDCONTROL.PRIVATE.getKeyPreviewHandler(table);
                if (DataType.isNullOrEmpty(sHandler) == false) {
                    obj = {};
                    obj.Grid = table;
                    obj.iRow = FGRIDCONTROL.getCurrentRow(table);
                    obj.iColumn = FGRIDCONTROL.getCurrentColumn(table);

                    bHandled = DataType.toBoolean(eval(sHandler)(obj, event));
                }

                if (event.keyCode != eKeyCode.CR && event.keyCode != eKeyCode.Tab) {
                    return;
                }

                if (event.keyCode == eKeyCode.Tab) {
                    FUIElement.stopKeyProcess(event);
                }

                if (bHandled == true) {
                    return;
                }

                if (event.shiftKey == true) {
                    FGRIDCONTROL.gotoPreviousCell(table, event);
                    FUIElement.stopKeyProcess(event);
                }
                else {
                    FGRIDCONTROL.gotoNextCell(table, event);
                    FUIElement.stopKeyProcess(event);
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.onKeyDown} " + err.message);
            }
        },

