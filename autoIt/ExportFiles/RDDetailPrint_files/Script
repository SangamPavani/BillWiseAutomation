            obj.PageRefresh = null;
            obj.FocusMessage = null;
            obj.FocusData = null;
            obj.CurrentTabId = null;
            obj.FileType = null;
            obj.FileName = null;
            obj.MenuText = null;
            obj.ClientLog = null;
            obj.DoNothing = null;

            value = jqXHR.getResponseHeader("SESSION_EXPIRE");
            if (DataType.isValidObject(value) == true && value == 1) {
                obj.SessionExpire = value;
            }

            value = jqXHR.getResponseHeader("PAGE_REFRESH");
            if (DataType.isValidObject(value) == true && value == 1) {
                obj.PageRefresh = value;
            }

            value = jqXHR.getResponseHeader("FOCUS_MESSAGE");
            if (DataType.toInt(value) > 0) {
                obj.FocusMessage = value;
            }

            value = jqXHR.getResponseHeader("FOCUS_DATA");
            if (DataType.toInt(value) > 0) {
                obj.FocusData = value;
            }

            value = jqXHR.getResponseHeader("FOCUS_CURRENTTABID");
            if (DataType.isNullOrEmpty(value) == false) {
                obj.CurrentTabId = value;
            }

            value = jqXHR.getResponseHeader("FOCUS_MENUTEXT");
            if (DataType.isNullOrEmpty(value) == false) {
                obj.MenuText = value;

                try {
                    obj.MenuText = DataType.decompress(value, true);
                }
                catch(err) {
                }
            }

            value = jqXHR.getResponseHeader("FOCUS_CLIENTLOG");
            if (DataType.isNullOrEmpty(value) == false) {
                obj.ClientLog = value;
            }

            value = jqXHR.getResponseHeader("content-type");
            if (DataType.isNullOrEmpty(value) == false) {
                obj.FileType = value;
            }

            value = jqXHR.getResponseHeader("Content-Disposition");
            if (DataType.isNullOrEmpty(value) == false) {
                iIndex = value.indexOf("filename=");
                if (iIndex >= 0) {
                    obj.FileName = value.substr(iIndex + "filename=".length);
                }
            }

            value = jqXHR.getResponseHeader("FOCUS_DONOTHING");
            if (DataType.isNullOrEmpty(value) == false) {
                obj.DoNothing = value;
            }

            value = jqXHR.getResponseHeader("ZeroValue");
            if (DataType.isNullOrEmpty(value) == false) {
                FUIElement.writeConsoleLog(value, "red;font-weight:bold;font-size:20px");
            }

            value = jqXHR.getResponseHeader("FOCUS_ADDRESS");
            if (DataType.isNullOrEmpty(value) == false) {
                value = DataType.decompress(value, true);
                value = DataType.stringToObject(value);
                if (value.lValue > 0) {
                    FUIElement.writeKeyValueLog(["RequestURL", "ClientIP"], [value.data.RequestURL, value.data.ClientIP]);
                }
            }

        }
        catch (err) {
            FUIElement.showAlert("Exception: {NETWORK.getResponseHeaderInfo} " + err.message);
        }

        return (obj);
    },

