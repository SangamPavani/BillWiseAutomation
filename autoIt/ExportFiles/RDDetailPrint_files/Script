            $("#dvReportRenderBacktracking" + DashletId).append(div)
            if (arrbacktracking.length == 0) {
                $(eleReportRender).hide();
                $("#" + div.id).html(data);
            }
            if (arrbacktracking.length == 1) {
                $(eleReportRender).hide();
                $("#dvReportRenderBacktracking0" + DashletId).hide();
                $("#" + div.id).html(data);
