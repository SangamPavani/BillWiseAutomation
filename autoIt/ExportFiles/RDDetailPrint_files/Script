    createSetValueExtraObject: function (bLoadAll, bIgnoreChangeCallback, bFromF2, bAsync, bDoNotShowPopup, sDataLoadedCallback, bLoadBalance) {
        let obj = undefined;

        obj = {};
        obj.bLoadAll = OPTIONCONTROL_HELPER.toBoolean(bLoadAll);
        obj.bIgnoreChangeCallback = OPTIONCONTROL_HELPER.toBoolean(bIgnoreChangeCallback);
        obj.bFromF2 = OPTIONCONTROL_HELPER.toBoolean(bFromF2);
        obj.bAsync = bAsync;
        obj.bDoNotShowPopup = bDoNotShowPopup;
        obj.sDataLoadedCallback = sDataLoadedCallback;
        obj.bLoadBalance = bLoadBalance;

        return (obj);
    },

    setValue: function (id, value, tag, objExtra) {
        try {
            if (objExtra == undefined || objExtra == null) {
                objExtra = OPTIONCONTROL.createSetValueExtraObject();
            }

            id = OPTIONCONTROL_HELPER.getValidElement(id);
            if (OPTIONCONTROL_HELPER.isValidObject(id) == false) {
                return ("Invalid id.");
            }

            if (OPTIONCONTROL.getOnlyCustomize(id) == true) {
                return;
            }

            if (eOptionControlDataAttribute.isTextSelectionType(id) == true) {
                id.value = value;
                return;
            }

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.setControlValue(id, value, objExtra.bIgnoreChangeCallback);

                return;
            }

            if (Array.isArray(value) == true) {
                arrLoadedData = OPTIONCONTROL_DATA.fillValueInMemory(id,
                                                                    value,
                                                                    tag,
                                                                    objExtra.bLoadAll,
                                                                    objExtra.bIgnoreChangeCallback,
                                                                    objExtra.sDataLoadedCallback,
                                                                    objExtra.bLoadBalance);

                if (arrLoadedData.length > 0) {
                    sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.DataLoadedCallback, eMasterDataType.Text);
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback) == false) {
                        obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, tag, false);
                        obj.Data = arrLoadedData;
                        obj.bDataArray = true;
                        obj.Flag.bLeave = false;
                        obj.Flag.bDataLoad = true;
                        obj.Flag.bDataChange = false;

                        eval(sCallback)(id, arrLoadedData, obj);
                    }
                }

                return;
            }

            if (OPTIONCONTROL.getMasterTypeId(id) > 0 && value == 0) {
                if (objExtra.bIgnoreChangeCallback == false) {
                    obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, null, true);
                    obj.Event = null;
                    sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.DataChangeCallback);
                }

                OPTIONCONTROL.clear(id);

                if (objExtra.bIgnoreChangeCallback == false && OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false && obj.OldValue != 0) {
                    obj.Flag.bLeave = false;
                    obj.Flag.bDataLoad = false;
                    obj.Flag.bDataChange = true;
                    eval(sCallback)(obj.Control, obj.Data, obj);
                }

                return (true);
            }

            if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Bins) {
                OPTIONCONTROL_BINS.getBinsData(id, " ", null, false, value);

                OPTIONCONTROL_INTERNAL.selectValueInControl(id, value, null, true);
                OPTIONCONTROL_INTERNAL.hidePopup(id);
                return;
            }

            OPTIONCONTROL_DATA.removePartialData(id);
            if (OPTIONCONTROL_INTERNAL.selectValueInControl(id,
                                                            value,
                                                            tag,
                                                            objExtra.bIgnoreChangeCallback,
                                                            objExtra.sDataLoadedCallback) == true) {

                return (true);
            }

            sURL = eOptionControlDataAttribute.getURL(id);

            objParam = OPTIONCONTROL_SERVER.getCommunicationParameterObject(id, sURL);
            objParam.bShowAllCols = true;
            objParam.bLoadAll = objExtra.bLoadAll;
            objParam.bIgnoreChangeCallback = objExtra.bIgnoreChangeCallback;

            if (objExtra.bLoadBalance != undefined && objExtra.bLoadBalance != null) {
                objParam.LoadBalance = objExtra.bLoadBalance;
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(objExtra.sDataLoadedCallback, true) == false) {
                objParam.sDataLoadedCallback = objExtra.sDataLoadedCallback;
            }

            if (objExtra.bFromF2 == true) {
                objParam.iSelectedId = value;
            }
            else {
                sValueFilter = OPTIONCONTROL_HELPER.getAttributeData(id, "data-valuefilterfield");
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValueFilter) == true) {
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(OPTIONCONTROL.getTableName(id)) == true) {
                        sValueFilter = "a.iMasterId=" + value;
                    }
                    else {
                        sValueFilter = OPTIONCONTROL.getPrimaryField(id) + "=" + value;
                    }
                }
                else {
                    sValueFilter += "=";
                    sValueFilter += '\'' + value + '\'';
                }

                objParam.sFilter = sValueFilter;
                objParam.SelectedData = value;
                OPTIONCONTROL_INTERNAL.setSearchBy(id, -1);
            }

            OPTIONCONTROL_INTERNAL.setFirstField(id, -1);

            if (OPTIONCONTROL_HELPER.isValidObject(tag) == true) {
                objParam.tag = tag;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(objExtra.bAsync) == true) {
                objParam.bAsync = objExtra.bAsync;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(objExtra.bDoNotShowPopup) == true) {
                objParam.bDoNotShowPopup = objExtra.bDoNotShowPopup;
            }

            OPTIONCONTROL_UI.resetDataElement(id, true);
            OPTIONCONTROL_SERVER.getDataFromServer(objParam);
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {OPTIONCONTROL.setValue} " + err.message);

            err.message = "Exception: {OPTIONCONTROL::setControlValue} " + err.message;
            throw err;
        }

        return (false);
    },

