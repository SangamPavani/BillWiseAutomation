function FStopWatch() {
    let obj = {
        m_StartDate: null,
        m_EndDate: null,

        init: function () {
            this.m_StartDate = null;
            this.m_EndDate = null;
        },

        start: function () {
            this.m_StartDate = new Date();
            this.m_EndDate = null;
        },

        stop: function () {
            let iDiff = 0;

            this.m_EndDate = new Date();
            if (this.m_StartDate == null) {
                this.m_EndDate = null;

                return (0);
            }

            iDiff = this.m_EndDate.getTime() - this.m_StartDate.getTime();

            return (iDiff);
        },

        getTimeString: function () {
            let sResult = "";

            if (this.m_StartDate != null) {
                sResult = "[Start: " + this.m_StartDate.getFullYear() + "/" + (this.m_StartDate.getMonth() + 1) + "/" + this.m_StartDate.getDate() + " " + this.m_StartDate.getHours() + ":" + this.m_StartDate.getMinutes() + ":" + this.m_StartDate.getSeconds() + " " + this.m_StartDate.getMilliseconds() + "]";
            }

            if (this.m_EndDate != null) {
                sResult += "[End: " + this.m_EndDate.getFullYear() + "/" + (this.m_EndDate.getMonth() + 1) + "/" + this.m_EndDate.getDate() + " " + this.m_EndDate.getHours() + ":" + this.m_EndDate.getMinutes() + ":" + this.m_EndDate.getSeconds() + " " + this.m_EndDate.getMilliseconds() + "]";
            }

            sResult += "[Diff: " + this.getDifferenceString() + "]";

            return (sResult);
        },

        getDifference: function (iDiff) {
            let result = null;

            result = {};
            result.Days = 0;
            result.Hours = 0;
            result.Minutes = 0;
            result.Seconds = 0;
            result.Milliseconds = 0;

            if (DataType.isValidObject(iDiff) == false) {
                iDiff = 0;

                if (this.m_StartDate == null || this.m_EndDate == null) {
                    return (result);
                }

                iDiff = this.m_EndDate.getTime() - this.m_StartDate.getTime();
            }

            result.Days = Math.floor(iDiff / (1000 * 60 * 60 * 24));
            iDiff -= result.Days * (1000 * 60 * 60 * 24);

            result.Hours = Math.floor(iDiff / (1000 * 60 * 60));
            iDiff -= result.Hours * (1000 * 60 * 60);

            result.Minutes = Math.floor(iDiff / (1000 * 60));
            iDiff -= result.Minutes * (1000 * 60);

            result.Seconds = Math.floor(iDiff / (1000));
            iDiff -= result.Seconds * (1000);

            result.Milliseconds = iDiff;

            return (result);
        },

        getDifferenceString: function (iDiff) {
            let sValue = "";
            let temp = null;

            temp = this.getDifference(iDiff);

            if (temp.Days == 0 && temp.Hours == 0 && temp.Minutes == 0 && temp.Seconds == 0 && temp.Milliseconds == 0) {
                return ("");
            }

            sValue = "";
            if (temp.Days > 0) {
                sValue = temp.Days.toString();
            }

            if (sValue != "" || temp.Hours > 0) {
                if (sValue != "") {
                    sValue += ":";
                }

                sValue += DataType.stringPadding(temp.Hours, "00");
            }

            if (sValue != "" || temp.Minutes > 0) {
                if (sValue != "") {
                    sValue += ":";
                }

                sValue += DataType.stringPadding(temp.Minutes, "00");
            }

            if (sValue != "") {
                sValue += ":";
            }
            sValue += DataType.stringPadding(temp.Seconds, "00");

            sValue += ":";
            if (temp.Milliseconds == 0) {
                sValue += "000";
            }
            else {
                sValue += DataType.stringPadding(temp.Milliseconds, "000");
            }

            return (sValue);
        }
    };

    return (obj);
}
