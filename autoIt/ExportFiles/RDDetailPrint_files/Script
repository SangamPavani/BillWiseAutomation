    TABCONTROL: {
        selectFirstTab_bs: function (s_ul_id) {
            var current = null;
            var previous = null;
            var arrChildren = null;

            try {
                current = $('ul#' + s_ul_id + ' li.active');
                if (current != null && current.length > 0) {
                    $(current).removeClass('active'); // Disselect active tab
                    $($(current).children().attr('href')).removeClass('active in'); // Hide selected tab pane                    
                }

                arrChildren = $("#" + s_ul_id).children();
                if (arrChildren != null && arrChildren.length > 0) {
                    $(arrChildren[0]).addClass("active");
                    $($(arrChildren[0]).children().attr('href')).addClass('active in'); // Show first tab pane
                }
            }
            catch (err) {
                err.message = "Exception: {selectFirstTab_bs} " + err.message;
                throw err;
            }

            return (true);
        },

        selectLastTab_bs: function (s_ul_id) {
            var current = null;
            var previous = null;
            var arrChildren = null;

            try {
                current = $('ul#' + s_ul_id + ' li.active');
                if (current != null && current.length > 0) {
                    $(current).removeClass('active'); // Disselect active tab
                    $($(current).children().attr('href')).removeClass('active in'); // Hide selected tab pane
                }

                arrChildren = $("#" + s_ul_id).children();
                if (arrChildren != null && arrChildren.length > 0) {
                    $(arrChildren[arrChildren.length - 1]).addClass("active");
                    $($(arrChildren[arrChildren.length - 1]).children().attr('href')).addClass('active in'); // Show tab pane
                }
            }
            catch (err) {
                err.message = "Exception: {selectLastTab_bs} " + err.message;
                throw err;
            }

            return (true);
        },

        selectNextTab_bs: function (s_ul_id) {
            var current = null;
            var next = null;

            try {
                current = $('ul#' + s_ul_id + ' li.active');
                if (current == null || current.length == 0) { // No tab active
                    return (false);
                }

                next = $(current).next();
                if (next == null || next.length == 0) { // No next tab found
                    return (false);
                }

                $(current).removeClass('active'); // Disselect current tab
                $(next).addClass('active'); // Select next tab

                $($(current).children().attr('href')).removeClass('active in'); // Hide current tab pane
                $($(next).children().attr('href')).addClass('active in'); // Show next tab pane
            }
            catch (err) {
                err.message = "Exception: {selectNextTab_bs} " + err.message;
                throw err;
            }

            return (true);
        },

        selectPreviousTab_bs: function (s_ul_id) {
            var current = null;
            var previous = null;

            try {
                current = $('ul#' + s_ul_id + ' li.active');
                if (current == null || current.length == 0) { // No tab active
                    return (false);
                }

                previous = $(current).prev();
                if (previous == null || previous.length == 0) { // No previous tab found
                    return (false);
                }

                $(current).removeClass('active'); // Disselect current tab
                $(previous).addClass('active'); // Select previous tab

                $($(current).children().attr('href')).removeClass('active in'); // Hide current tab pane
                $($(previous).children().attr('href')).addClass('active in'); // Show previous tab pane
            }
            catch (err) {
                err.message = "Exception: {selectPreviousTab_bs} " + err.message;
                throw err;
            }

            return (true);
        }
    },

