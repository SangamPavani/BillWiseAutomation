                                           { iTemplateId: iTemplateid },
                                           "",
                                           true,
                                           "SMSTEMPLATE.getSMSTemplateFieldsDetailsSuccess",
                                           "GLOBAL.LoadingStart",
                                           "GLOBAL.LoadingEnd"
                                         );
        }
        else {
            document.getElementById('txtTemplate').value = "";
            document.getElementById('txtTemplate').focus();
            document.getElementById('txtPreview').value = "";
            document.getElementById('txtPreview').style.display = "";
            document.getElementById('btnPreviewtab').style.display = '';
        }
    },

    getSMSTemplateFieldsDetailsSuccess: function (bflag, data) {
        document.getElementById('txtTemplate').value = "";
        document.getElementById('txtPreview').value = "";
        if (bflag) {
            if (data.success) {
                for (var i = 0; i < data.objTemplateFields.length; i++) {
                    //if (data.objTemplateFields[i].Values[0] != null)
                    //{
                    //    document.getElementById('txtTemplate').value += "<<" + data.objTemplateFields[i].Name + ">>";
                    //}
                    //else
                    //{
                    //    document.getElementById('txtTemplate').value += " " + data.objTemplateFields[i].Name + " ";
                    //}                    
                }
                document.getElementById('txtTemplate').value = data.TemplateText;
                var bDispayMasterCode = data.DisplayMasterCode;
                document.getElementById('bDisplayMasterCode').checked = bDispayMasterCode;  
                document.getElementById('btnPreviewtab').style.display = '';
                document.getElementById('txtPreview').value = data.strErrorMsg;
            }
        }
    },

    clearAll: function () {
        if (OPTIONCONTROL.isCustomizedPopupVisible("smsTemplateOptCtrl") == true) {
            return;
        }


        $('#fieldtab').find('.in').removeClass('in');
        document.getElementById('txtTemplate').value = "";
        document.getElementById('txtPreview').value = "";
        document.getElementById('btnPreviewtab').style.display = '';
        OPTIONCONTROL.clear("smsTemplateOptCtrl");
    },

    SaveCustomTemplateDetails: function (iScreenID, iType, iTypeId) {
        var arrCols = [];
        var BodyFields = [];

        if (OPTIONCONTROL.isCustomizedPopupVisible("smsTemplateOptCtrl") == true) {
            return;
        }
        var iTypeid = null;
        var iTemplateID = OPTIONCONTROL.getControlValue("smsTemplateOptCtrl");
        var iTemplateText = OPTIONCONTROL.getControlText("smsTemplateOptCtrl");
        var bDisplayMasterCode = document.getElementById("bDisplayMasterCode").checked;     
        if (iTemplateText.trim().length > 0) {
            var textBody = document.getElementById('txtTemplate').value;
            var separators = ['<<', '>>'];
            arrCols = textBody.split(new RegExp(separators.join('|')));
            if (arrCols.length > 0) {
                for (var i = 0; i < arrCols.length; i++) {
                    if (arrCols[i].trim() != "" && arrCols[i].trim() != null) {
                        BodyFields.push(arrCols[i]);
                    }
                }
            }

            if (textBody.trim().length > 0 && BodyFields.length > 0 && iTemplateText.length > 0) {
                iType = FConvert.toInt(iType);
                if (iType == 0) {
                    iType = 4; // eTemplateType.Dashboard
                }
                if (COMMON.prototype.isValidObject(document.getElementById("id_transaction_Emailprint")) == true) {
                    iTypeid = iTypeId
                }
                var objSmsTemplateParameters = {
                    ID: parseInt(iTemplateID) < 0 ? 0 : iTemplateID,
                    Body: textBody.trim(),
                    Name: iTemplateText,
                    ScreenID: iScreenID,                 //screen ID to be picked dynamically.
                    Type: iType,
                    BodyFields: BodyFields,
                    TypeId: iTypeid,
                    DisplayMasterCode: bDisplayMasterCode
                }
                if (objSmsTemplateParameters != null || objSmsTemplateParameters != undefined) {
                    var result = NETWORK.executeServerMethod(
                                                             GLOBAL.getContextPath("SaveCustomTemplateDetails", "Home"),
                                                             true,
                                                             { objSmsTemplateParameters: objSmsTemplateParameters },
                                                             "",
                                                             true,
                                                             "SMSTEMPLATE.SaveCustomTemplateDetailsSuccess",
                                                             "GLOBAL.LoadingStart",
                                                             "GLOBAL.LoadingEnd"
                                                           );
                }
            } else {
                COMMON.prototype.showMessage(document.getElementById('msgenterTemplateText').value, "Information");
                return false;
            }
        }
        else {
            COMMON.prototype.showMessage(document.getElementById('msgenternameoftheTemplate').value, "Information");
            return false;
        }
    },

    SaveCustomTemplateDetailsSuccess: function (bflag, data) {
        //debugger
        try {
            if (bflag) {
                if (data.success) {
                    COMMON.prototype.showMessage(data.strErrorMsg);
                    SMSTEMPLATE.clearAll();
                }
                else {
                    OPTIONCONTROL.clear("smsTemplateOptCtrl");
                    COMMON.prototype.showMessage(data.strErrorMsg);
                    return
                }
            }

        } catch (e) {

            COMMON.prototype.showMessage(e.message);
            return;
        }

    }
};
