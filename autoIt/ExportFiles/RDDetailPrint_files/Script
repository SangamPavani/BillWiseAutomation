            obj.iStart = -1;
            obj.iEnd = -1;
            obj.bHour = false;
            obj.bMinute = false;
            obj.bSecond = false;

            index = eleInput.selectionStart;

            if (index >= 0 && index <= 2) {
                obj.bHour = true;
                obj.iStart = 0;
                obj.iEnd = 2;
            }
            else if (index >= 3 && index <= 5) {
                obj.bMinute = true;
                obj.iStart = 3;
                obj.iEnd = 5;
            }
            else if (index >= 6 && index <= 8) {
                obj.bSecond = true;
                obj.iStart = 6;
                obj.iEnd = 8;
            }

            return (obj);
        }
