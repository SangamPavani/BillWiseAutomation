function copyDataFromList() {
    var data = RD_ENTRY.FIELDTREE.getSelectedTreeData('TreeViewData');
    var isLiMatched = false;
    var option = null;

    if (data != "" && data != null) {
        $("#copiedData option").each(function () {
            if ($(this).text().replace(/\s/g, '').toLowerCase() == (data.sText).replace(/\s/g, '').toLowerCase()) {
                isLiMatched = true;
            }
        });

        if (isLiMatched == false) {
            data.bAscending = true;
            option = createOptionElement(data);

            if (option != null) {
                document.getElementById("copiedData").appendChild(option);
            }
            isLiMatched = false;
        }
    }
}

