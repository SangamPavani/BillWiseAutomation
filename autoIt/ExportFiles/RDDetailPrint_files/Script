var OPTIONCONTROL_HELPER = {
    isValidObject: function (obj) {
        try {
            if (typeof obj == "undefined" || obj == null) {
                return (false);
            }

            return (true);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.isValidObject} " + err.message);
        }

        return (false);
    },

    isNullOrEmpty: function (sValue, bTrim) {
        let bResult = false;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(sValue) == false || sValue == null || sValue == "" || sValue.length <= 0) {
                bResult = true;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(bTrim) == true && bTrim == true) {
                if ((typeof sValue).toLowerCase() == "string" && sValue.trim().length == 0) {
                    return (true);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.isNullOrEmpty} " + err.message);
            bResult = true;
        }

        return (bResult);
    },

    isStartsWith: function (sValue, sSearchString) {
        let bResult = false;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue) == false) {
                if (sValue.startsWith) {
                    bResult = sValue.startsWith(sSearchString);
                }
                else if (sValue.length >= sSearchString.length) {
                    if (sValue.substr(0, sSearchString.length) === sSearchString) {
                        bResult = true;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.isStartsWith} " + err.message);
        }

        return (bResult);
    },

    isEndsWith: function (sValue, sSearchString) {
        let bResult = false;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue) == false) {
                if (sValue.endsWith) {
                    bResult = sValue.endsWith(sSearchString);
                }
                else if (sValue.length >= sSearchString.length) {
                    if (sValue.substr((sValue.length - sSearchString.length), sSearchString.length) === sSearchString) {
                        bResult = true;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.isEndsWith} " + err.message);
        }

        return (bResult);
    },

    isSameElement: function (ele1, ele2) {
        try {
            if(OPTIONCONTROL_HELPER.isValidObject(ele1) == false 
                || OPTIONCONTROL_HELPER.isValidObject(ele2) == false) {
                return (false);
            }

            if (ele1.isSameNode) {
                if (ele1.isSameNode(ele2) == true) {
                    return (true);
                }
            }
            else if (ele1.isEqualNode) {
                if (ele1.isEqualNode(ele2) == true) {
                    return (true);
                }
            }
            else if (ele1 === ele2) {
                return (true);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.isSameElement} " + err.message);
        }

        return (false);
    },

    stringLeft: function (sValue, iCount) {
        let sResult = "";

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue) == true) {
                return ("");
            }

            if (OPTIONCONTROL_HELPER.isValidObject(iCount) == false
                || DataType.isInteger(iCount) == false) {
                return (sValue);
            }

            iCount = parseInt(iCount);

            if (sValue.length < iCount) {
                return ("");
            }

            sResult = sValue.substr(0, iCount);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.stringLeft} " + err.message);
        }

        return (sResult);
    },

    stringIncludes: function (sValue, sSearchString) {
        let bResult = false;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue) == false) {
                if (sValue.includes) {
                    bResult = sValue.includes(sSearchString);
                }
                else {
                    bResult = (sValue.indexOf(sSearchString) >= 0);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.stringIncludes} " + err.message);
        }

        return (bResult);
    },

    toInt: function (value) {
        if (OPTIONCONTROL_HELPER.isValidObject(value) == false) {
            return (0);
        }

        value = parseInt(value);
        if (isNaN(value) == true) {
            return (0);
        }

        return (value);
    },

    toBoolean: function (value) {
        if (OPTIONCONTROL_HELPER.isValidObject(value) == false) {
            return (false);
        }

        if ((typeof value).toLowerCase() == "string") {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(value) == true) {
                return (false);
            }

            if (value.toLowerCase().trim() == "true" || value == "1") {
                return (true);
            }
        }
        else if ((typeof value).toLowerCase() == "boolean") {
            return (eval(value));
        }
        else if ((typeof value).toLowerCase() == "number") {
            if (DataType.toDecimal(value) > 0) {
                return (true);
            }
        }

        return (false);
    },

    toString: function (value) {
        let sType = "";

        if (OPTIONCONTROL_HELPER.isValidObject(value) == false) {
            return ("");
        }

        if ((typeof value).toLowerCase() == "string") {
            return (value);
        }
        else if ((typeof value).toLowerCase() == "boolean") {
            value = value.toString();
        }
        else if ((typeof value).toLowerCase() == "object" && value != null) {
            value = JSON.stringify(value);
        }
        else {
            sType = (typeof value).toLowerCase();
            if (sType == "number") {
                value = value.toString();
            }
            else {
                value = "";
            }
        }

        return (value);
    },

    hasDataAttribute: function (element, sKey, bIgnoreCase) {
        let sName = "";
        let iCounter = 0;

        try {
            sKey = DataType.stringGetValidDataAttribute(sKey);

            bIgnoreCase = OPTIONCONTROL_HELPER.toBoolean(bIgnoreCase);
            for (iCounter = 0; iCounter < element.attributes.length; iCounter++) {
                sName = element.attributes[iCounter].name;

                if (bIgnoreCase == true) {
                    if (sName.toLowerCase() === sKey.toLowerCase()) {
                        return (true);
                    }
                }
                else {
                    if (sName === sKey) {
                        return (true);
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.hasDataAttribute} " + err.message);
        }

        return (false);
    },

    getScrollLeft: function (element, bFirstOnly) {
        let iLeft = 0;
        let obj = null;

        try {
            bFirstOnly = OPTIONCONTROL_HELPER.toBoolean(bFirstOnly);
            while (OPTIONCONTROL_HELPER.isValidObject(element) == true) {
                obj = OPTIONCONTROL_HELPER.hasScrollBar(element);
                if (obj.horizontal == true) {
                    iLeft += element.scrollLeft;
                    if (bFirstOnly == true) {
                        break;
                    }
                }

                element = element.parentElement;
            }
        }
        catch (err) {
        }

        return (iLeft);
    },

    getScrollTop: function (element, bFirstOnly) {
        let iTop = 0;
        let obj = null;

        try {
            bFirstOnly = OPTIONCONTROL_HELPER.toBoolean(bFirstOnly);
            while (OPTIONCONTROL_HELPER.isValidObject(element) == true) {
                obj = OPTIONCONTROL_HELPER.hasScrollBar(element);
                if (obj.vertical == true) {
                    iTop += element.scrollTop;
                    if (bFirstOnly == true) {
                        break;
                    }
                }

                element = element.parentElement;
            }
        }
        catch (err) {
        }

        return (iTop);
    },

    getVisibleWidthHeight: function (ele) {
        let iTemp = 0;
        let rectElement = null;
        let rectContainer = null;
        let obj = null;

        try {
            obj = {};
            obj.iWidth = 0;
            obj.iHeight = 0;
            obj.iVisibleWidth = 0;
            obj.iVisibleHeight = 0;

            ele = OPTIONCONTROL_HELPER.getValidElement(ele);
            if (OPTIONCONTROL_HELPER.isValidObject(ele) == false) {
                return (obj);
            }

            rectElement = ele.getBoundingClientRect();
            obj.iWidth = rectElement.width;
            obj.iHeight = rectElement.height;
            obj.iVisibleWidth = obj.iWidth;
            obj.iVisibleHeight = obj.iHeight;

            do {
                ele = ele.parentElement;
                if (OPTIONCONTROL_HELPER.isValidObject(ele) == false) {
                    break;
                }

                rectContainer = ele.getBoundingClientRect();

                if (rectContainer.width < ele.scrollWidth) {
                    if (rectElement.left >= rectContainer.left && rectElement.right <= rectContainer.right) {
                        iTemp = obj.iVisibleWidth;
                    }
                    else if (rectElement.left <= rectContainer.left) {
                        iTemp = rectElement.width - (rectContainer.left - rectElement.left);
                    }
                    else if (rectElement.right >= rectContainer.right) {
                        iTemp = rectElement.width - (rectElement.right - rectContainer.right);
                    }

                    if (iTemp < obj.iVisibleWidth) {
                        obj.iVisibleWidth = iTemp;
                    }
                }


                if (rectContainer.height < ele.scrollHeight) {
                    if (rectElement.top >= rectContainer.top && rectElement.bottom <= rectContainer.bottom) {
                        iTemp = obj.iVisibleHeight;
                    }
                    else if (rectElement.top <= rectContainer.top) {
                        iTemp = rectElement.height - (rectContainer.top - rectElement.top);
                    }
                    else if (rectElement.bottom >= rectContainer.bottom) {
                        iTemp = rectElement.height - (rectElement.bottom - rectContainer.bottom);
                    }

                    if (iTemp < obj.iVisibleHeight) {
                        obj.iVisibleHeight = iTemp;
                    }
                }
            } while (true);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.getVisibleWidthHeight} " + err.message);
        }

        return (obj);
    },

    hasScrollBar: function (element) {
        let obj = undefined;

        try {
            obj = {};
            obj.horizontal = false;
            obj.vertical = false;
            obj.scrollbarwidth = 0;
            obj.scrollbarheight = 0;

            element = OPTIONCONTROL_HELPER.getValidElement(element);
            if (OPTIONCONTROL_HELPER.isValidObject(element) == false) {
                return (obj);
            }

            obj.vertical = (element.scrollHeight > element.clientHeight);
            obj.horizontal = (element.scrollWidth > element.clientWidth);
            obj.scrollbarwidth = (element.offsetWidth - element.clientWidth);
            obj.scrollbarheight = (element.offsetHeight - element.clientHeight);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.hasScrollBar} " + err.message);
        }

        return (obj);
    },

    getValidElement: function (obj) {
        let element = null;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(obj) == false) {
                return (null);
            }

            if ((typeof obj).toLowerCase() == 'string') {
                element = document.getElementById(obj);
            }
            else if ((typeof obj).toLowerCase() == 'object') {
                element = obj;
            }
        }
        catch (err) {
            err.message = "Exception: {OPTIONCONTROL_HELPER.getValidElement} " + err.message;
            throw err;
        }

        return (element);
    },

    getArrayLength: function (arrData) {
        let iValue = 0;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(arrData) == false) {
                return (0);
            }

            if (Array.isArray(arrData) == true) {
                iValue = arrData.length;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.getArrayLength} " + err.message);
        }

        return (iValue);
    },

    getElementWidth: function (element) {
        let rect = null;
        let iValue = 0;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(element) == true) {
                rect = element.getBoundingClientRect();
                iValue = rect.right - rect.left;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.getElementWidth} " + err.message);
        }

        return (iValue);
    },

    getValueInObjectArray: function (sProperty, arrObject) {
        let iCounter = 0;
        let obj = null;
        let data = null;

        try {
            data = {};
            data.iIndex = -1;
            data.sKey = sProperty;
            data.Value = null;

            sProperty = sProperty.toLowerCase();
            for (iCounter = 0; iCounter < arrObject.length; iCounter++) {
                obj = arrObject[iCounter];

                for (sKey in obj) {
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sKey) == false && sKey.toLowerCase() == sProperty) {
                        data.iIndex = iCounter;
                        data.Value = obj[sKey];
                        break;
                    }
                }

                if (data.iIndex >= 0) {
                    break;
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.getValueInObjectArray} " + err.message);
        }

        return (data);
    },

    getFirstPropertyValue: function (obj, bIgnoreBlankKey) {
        let value = "";

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(obj) == true) {
                bIgnoreBlankKey = OPTIONCONTROL_HELPER.toBoolean(bIgnoreBlankKey);

                for (skey in obj) {
                    if (bIgnoreBlankKey == false || OPTIONCONTROL_HELPER.isNullOrEmpty(skey) == false) {
                        value = obj[skey];
                        break;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_HELPER.getFirstPropertyValue} " + err.message);
        }

        return (value);
    },

    compareValue: function (sValue, sValue1, bIgnoreCase, iLength) {
        let iResult = 0;

        try {
            if (OPTIONCONTROL_HELPER.toBoolean(bIgnoreCase) == false) {
                if (OPTIONCONTROL_HELPER.toInt(iLength) <= 0) {
                    iResult = sValue.localeCompare(sValue1);
                }
                else {
                    iResult = sValue.substr(0, iLength).localeCompare(sValue1.substr(0, iLength));
                }
            }
            else {
                if (OPTIONCONTROL_HELPER.toInt(iLength) <= 0) {
                    iResult = sValue.toLowerCase().localeCompare(sValue1.toLowerCase());
                }
                else {
                    iResult = sValue.substr(0, iLength).toLowerCase().localeCompare(sValue1.substr(0, iLength).toLowerCase());
                }
            }
        }
        catch (err) {
            err.message = "Exception: {OPTIONCONTROL_HELPER.compareValue} " + err.message;
            throw err;
        }

        return (iResult);
