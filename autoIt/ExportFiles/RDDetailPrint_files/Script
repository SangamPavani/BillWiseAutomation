    stringGetNumber: function(value, NumericSeparator, bIntOnly) {
        let iCounter = 0;
        let iAscValue = 0;
        let bMinus = false;
        let bPlus = false;
        let bNumber = false;
        let bDot = false;
        let temp = "";

        try {
            if(DataType.isScientificNotation(value) == true) {
                temp = FNumberOperation.toFixed(value);
            }
            else {
                for (iCounter = 0; iCounter < value.length; iCounter++) {
                    iAscValue = value.charCodeAt(iCounter);
                    if (iAscValue >= 48 && iAscValue <= 57) {
                        temp += value.charAt(iCounter);
                        bNumber = true;
                    }
                    else if(iAscValue == 43) { // +
                        if(bPlus == true || bMinus == true || bNumber == true) {
                            return("");
                        }

                        bPlus  = true;
                    }
                    else if (iAscValue == 45) { // -
                        if (bMinus == true || bPlus == true || bNumber == true) {
                            return ("");
                        }

                        temp += value.charAt(iCounter);
                        bMinus = true;
                    }
                    else if (iAscValue == 46) { //.
                        if(bIntOnly === true) {
                            return(temp);
                        }

                        if (bDot == true) {
                            return ("");
                        }

                        temp += value.charAt(iCounter);
                        bDot = true;
                    }
                    else if (iAscValue == NumericSeparator) {
                        // Ignore separator
                    }
                    else {
                        return ("");
                    }
                }

                if (bNumber == false) {
                    return ("");
                }
            }
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringGetNumber} " + err.message);
        }

        return(temp);
    },

    stringEncrypt: function (sValue) {
        let sCryptKey = "";
        let sEncrypted = "";

        try {
            if(window.CryptoJS) {
                sCryptKey = CryptoJS.enc.Utf8.parse('8080808080808080');

                sEncrypted = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(sValue), sCryptKey,
                {
                    keySize: 128 / 8,
                    iv: CryptoJS.enc.Utf8.parse('8080808080808080'),
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });

                sEncrypted = sEncrypted.ciphertext.toString(CryptoJS.enc.Base64);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringEncrypt} " + err.message);
        }

        return (sEncrypted);
    },

    stringDecrypt: function (sValue) {
        let sCryptKey = "";
        let sDecrypted = "";

        try {
            if(window.CryptoJS) {
                sCryptKey = CryptoJS.enc.Utf8.parse('8080808080808080');

                sDecrypted = CryptoJS.AES.decrypt({ ciphertext: CryptoJS.enc.Base64.parse(sValue) }, sCryptKey,
                {
                    keySize: 128 / 8,
                    iv: CryptoJS.enc.Utf8.parse('8080808080808080'),
                    mode: CryptoJS.mode.CBC,
                    padding: CryptoJS.pad.Pkcs7
                });

                sDecrypted = sDecrypted.toString(CryptoJS.enc.Utf8);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {DataType.stringDecrypt} " + err.message);
        }

        return (sDecrypted);
    },

