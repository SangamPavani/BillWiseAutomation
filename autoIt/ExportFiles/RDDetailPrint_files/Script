            if (bCancel == true) { // Called from row grouping popup cancel handler
                return (false);
            }

            if (DataType.isValidObject(objGroupingData) == false) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.addDataInTree} Drop data cannot be null.", "Error");

                return (false);
            }

            objGroupingData.fnDblClick = "RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.onCubeRowGrouping_DblClick";
            if (DataType.isValidObject(objGroupingData.element) == false) { // New
                objGroupingData.element = RD_ENTRY.CUSTOMIZATION.addCubeColumnInDiv(document.getElementById(RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.getCubeRowGroupingContainerId()), objGroupingData);
                RD_ENTRY.m_arrRowGrouping.push(objGroupingData);

                if (RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.isParticularColumnExist() == false) {
                    RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.createParticularColumn(extravalues);
                }
            }
            else {// Update
                for (iCounter = 0; iCounter < RD_ENTRY.m_arrRowGrouping.length; iCounter++) {
                    if (RD_ENTRY.m_arrRowGrouping[iCounter].element.id == objGroupingData.element.id
                        && RD_ENTRY.m_arrRowGrouping[iCounter].iFieldId == objGroupingData.iFieldId) {
                        RD_ENTRY.m_arrRowGrouping[iCounter] = objGroupingData;
                        break;
                    }
                }
            }

            bResult = true;
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.addDataInTree}" + err.message, "Exception");
