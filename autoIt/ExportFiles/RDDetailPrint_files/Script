                case 192: // ` ~ key
                    return;
                case 219: //[ { key
                    break;
                case 220: // \ | key
                    break;
                case 221: // ] } key
                    break;
                case 222: // ' " key
                    break;
                default:
                    if (evt.keyCode >= eKeyCode.NumPad0 && evt.keyCode <= eKeyCode.NumPad9) { // Numeric pad number 0 to 9
                    }
                    else if (evt.keyCode >= eKeyCode.D0 && evt.keyCode <= eKeyCode.D9) { // Number key 0 to 9
                    }
                    else if (evt.keyCode >= eKeyCode.A && evt.keyCode <= eKeyCode.Z) { // key a to z in both case

                    }

                    break;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.keyup} " + err.message);
        }
    },

    input: function (id, evt, sURL) {
        let sValue = "";
        let bFromKeyboard = false;
        let bPaste = false;

        try {
            if (OPTIONCONTROL.getOnlyCustomize(id) == true) {
                return;
            }

            OPTIONCONTROL_TIMER.stopInputProcessTimer(id);

            sValue = OPTIONCONTROL_HELPER.toString(id.value);

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.processInput(id, sValue);
            }
            else {
                bFromKeyboard = true;
                if (DataType.toString(evt.inputType).toLowerCase() == "insertfrompaste") {
                    bFromKeyboard = false;
                    bPaste = true;
                }

                OPTIONCONTROL_INTERNAL.setInputText(id, sValue);
                OPTIONCONTROL_INTERNAL.processInputs(id,
                                            sValue,
                                            sURL,
                                            OPTIONCONTROL_INTERNAL.getElementData(OPTIONCONTROL_UI.getSelectedRow(id).Row, id), bFromKeyboard);

                if (bPaste == true && id.value != sValue) {
                    id.value = sValue;
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.input} " + err.message);
        }
    },

    onBodyScroll: function (ele, event) {
