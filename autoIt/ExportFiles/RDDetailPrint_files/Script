                                return REPORTRENDER.GetOutputScreen(this, event, false, true, 1)
                                break;
                            case "display":
                                REPORTRENDER.refreshLite(null, reportLineModel.CrossReference);
                                break;
                            case "email":
                                var sEmail = obj.emailid;
