        isAreaChanged: function(iReplaceIndex, iNewIndex, sFormat) {
            let arrDayIndex = null;
            let arrMonthIndex = null;
            let arrYearIndex = null;
            let obj = null;

            try {
                obj = {};
                obj.bChanged = false;
                obj.CurrentArea = eDateArea.None;
                obj.NextArea = eDateArea.None;

                arrDayIndex = FDate.getDayIndex(sFormat);
                arrMonthIndex = FDate.getMonthIndex(sFormat);
                arrYearIndex = FDate.getYearIndex(sFormat);
                
                if(iReplaceIndex >= arrDayIndex[0] && iReplaceIndex < arrDayIndex[1]) {
                    obj.CurrentArea = eDateArea.Day;
                }
                else if(iReplaceIndex >= arrMonthIndex[0] && iReplaceIndex < arrMonthIndex[1]) {
                    obj.CurrentArea = eDateArea.Month;
                }
                else if(iReplaceIndex >= arrYearIndex[0] && iReplaceIndex < arrYearIndex[1]) {
                    obj.CurrentArea = eDateArea.Year;
                }

                if(iNewIndex >= arrDayIndex[0] && iNewIndex < arrDayIndex[1]) {
                    obj.NextArea = eDateArea.Day;
                }
                else if(iNewIndex >= arrMonthIndex[0] && iNewIndex < arrMonthIndex[1]) {
                    obj.NextArea = eDateArea.Month;
                }
                else if(iNewIndex >= arrYearIndex[0] && iNewIndex < arrYearIndex[1]) {
                    obj.NextArea = eDateArea.Year;
                }

                if(obj.CurrentArea != obj.NextArea) {
                    obj.bChanged = true;
                }                
            }
            catch(err) {
                FUIElement.showAlert("Exception: {DATEPICKER.PRIVATE.isAreaChanged} " + err.message);
            }

            return (obj);
        },

