                    VOUCHERPOSTING.VARIABLES.MasterFieldData = rtnValuesBillSettlement.result[9]; //Master Field Data (Printing)
                    VOUCHERPOSTING.VARIABLES.LocalPOSDate = ApplicationNew.LocalPosDate;
                    VOUCHERPOSTING.VARIABLES.LocalPOSTime = ApplicationNew.LocalPosTime;
                    VOUCHERPOSTING.VARIABLES.IsFromJS = true;

                    //Required for External Module Calling
                    ApplicationNew.RetailTransFooter.ExternalHeaderExtraFieldsResponse = VOUCHERPOSTING.VARIABLES.RetailTransFooter.ExternalHeaderExtraFieldsResponse;
                    toastr.success(voucherPostedSuccesfully, msgPOSInformation);
                    //assigning variable for external module
                    addProductToGridObject.printObject = ApplicationNew;

                    //Calling External Module
                    //debugger;
                    if (POSEXTERNALMODULE.getExternalModuleExistWithEventType(PosExternalOnEvent.AfterVoucherSave) == true) {
                        POSEXTERNALMODULE.clearVariables();
                        POSEXTERNALMODULE.VARIABLES.ExternalModuleVoucherType = 3331;
                        POSEXTERNALMODULE.VARIABLES.ExternalModuleEventType = PosExternalOnEvent.AfterVoucherSave;
                        TRANSACTION.SERVERMETHODS.getSessionVariables();
                        return;
                    }

                    if (PRINTERDIALOG.VARIABLE.isCustomPrinting == false) {
                        if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.AskForConfirmationBeforePrinting == true) {
                            var messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
                            messageInfoPopup.Caption = pointOfConfirmation;
                            messageInfoPopup.Message = [];
