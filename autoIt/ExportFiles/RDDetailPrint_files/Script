    correctControlValue: function (id, iLastValue) {
        let sFormat = "";
        let sValue = "";
        let iDay = 0;
        let iMonth = 0;
        let iYear = 0;
        let iIndex = 0;
        let iCalendarType = 0;
        let iMaxDay = 0;
        let iMinYear = 0;
        let iMaxYear = 0;
        let arrPos = null;
        let sOnDataChangeCallback = "";
        let obj = null;

        try {
            obj = {};
            obj.id = id;

            if (DataType.toInt(iLastValue) > 0) {
                obj.iLastDate = iLastValue;
            }
            else {
                obj.iLastDate = DATEPICKER.getDate(id);
            }

            obj.iDate = 0;

            iCalendarType = DATEPICKER.getCalendarType(id);

            iMinYear = FDate.getMinYear(iCalendarType);
            iMaxYear = FDate.getMaxYear(iCalendarType);

            iIndex = FUIElement.getCursorIndexInInput(id);

            sFormat = DATEPICKER.getFormat(id);

            // Correct Month
            arrPos = FDate.getMonthIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length >= 2) {
                sValue = DATEPICKER.getInputMonthText(id);
                iMonth = parseInt(sValue);

                if (iMonth < 1) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], '01');
                    FUIElement.selectText(id, iIndex, iIndex);
                    iMonth = 1;
                }
                else if (iMonth > 12) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], '12');
                    FUIElement.selectText(id, iIndex, iIndex);
                    iMonth = 12;
                }
            }

            // Correct Year
            arrPos = FDate.getYearIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length >= 2) {
                sValue = DATEPICKER.getInputYearText(id);
                iYear = parseInt(sValue);

                if (iYear < iMinYear) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], iMinYear.toString());
                    FUIElement.selectText(id, iIndex, iIndex);
                    iYear = iMinYear;
                }
                else if (iYear > iMaxYear) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], iMaxYear.toString());
                    FUIElement.selectText(id, iIndex, iIndex);
                    iYear = iMaxYear;
                }
            }

            // Correct Day
            arrPos = FDate.getDayIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length >= 2) {
                sValue = DATEPICKER.getInputDayText(id);
                iDay = parseInt(sValue);

                iMaxDay = FDate.maxDays(iMonth, iYear, iCalendarType);
                if (iDay < 1) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], '01');
                    FUIElement.selectText(id, iIndex, iIndex);
                }
                else if (iDay > iMaxDay) {
                    id.value = DataType.stringReplaceAt(id.value, arrPos[0], iMaxDay.toString());
                    FUIElement.selectText(id, iIndex, iIndex);
                }
            }

            sOnDataChangeCallback = DATEPICKER.getOnDataChangeCallback(id);
            if (DataType.isNullOrEmpty(sOnDataChangeCallback) == false) {
                obj.iDate = DATEPICKER.getDate(id);
                eval(sOnDataChangeCallback)(id, obj.iDate, obj);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DATEPICKER.correctControlValue} " + err.message);
        }
    },

