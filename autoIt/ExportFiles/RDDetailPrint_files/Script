                            break;
                        case -7: // Option
                        case -6: // Time Frame
                        case -4: // As on date
                        case -3: // Date Range
                        case -2: // Text
                        case -1: // Number
                            objData.SelectionMode = 0;
                            objData.IsGroupMaster = false;
                            objData.FieldType = _FieldType.get("NORMAL");
                            objData.ControlId = iControlId * -1;
                            break;
                        case -5: // Selection
                            objData.SelectionMode = 0;
                            objData.IsGroupMaster = false;
                            objData.FieldType = _FieldType.get("NORMAL");
                            objData.SelectionValue = RD_ENTRY.PARAMETER.getSelectionValueElement().value;
                            objData.ControlId = iControlId * -1;
                            break;
                        default: // Masters
                            objData.SelectionMode = (RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked == true) ? 1 : 0;
                            objData.IsGroupMaster = RD_ENTRY.PARAMETER.getIsGroupElement().checked;
                            objData.FieldType = _FieldType.get("MASTER");
                            // m_objParameter.FieldId = (int)(RDGlobal.CallServeRequest(RDMethods.GetParameterFieldId, (MasterTypeId)cmbParameters.SelectedValue));
                            objData.ControlId = iControlId;
                            break;
                    }
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.PARAMETER.getData} " + err.message, "Error");
            }

            return (objData);
        },

        setData: function (objData) {
            var arrData = null;
            var iControlId = 0;

            try {
                RD_ENTRY.PARAMETER.clearData();

                RD_ENTRY.PARAMETER.getFieldNameElement().value = objData.FieldName;
                RD_ENTRY.PARAMETER.getVariableNameElement().value = objData.FieldVariable;

                iControlId = objData.ControlId;
                if (objData.FieldType != _FieldType.get("MASTER")) {
                    iControlId *= -1;
                }

                switch (iControlId) {
                    case -10: // View
                        RD_ENTRY.PARAMETER.getFieldTypeElement().value = iControlId;
                        RD_ENTRY.PARAMETER.getViewNameElement().value = objData.DefaultValue;
                        RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked = false;
                        RD_ENTRY.PARAMETER.getIsGroupElement().checked = false;

                        arrData = objData.SelectionValue.split(",");
                        if (arrData.length > 0) {
                            RD_ENTRY.PARAMETER.getValueColumnElement().value = arrData[0];
                            RD_ENTRY.PARAMETER.getDisplayColumnElement().value = arrData[1];
                        }
                        break;
                    case -7: // Option
                    case -6: // Time Frame
                    case -4: // As on date
                    case -3: // Date Range
                    case -2: // Text
                    case -1: // Number
                        RD_ENTRY.PARAMETER.getFieldTypeElement().value = iControlId;
                        RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked = false;
                        RD_ENTRY.PARAMETER.getIsGroupElement().checked = false;
                        break;
                    case -5: // Selection
                        RD_ENTRY.PARAMETER.getFieldTypeElement().value = iControlId;
                        RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked = false;
                        RD_ENTRY.PARAMETER.getIsGroupElement().checked = false;
                        RD_ENTRY.PARAMETER.getSelectionValueElement().value = objData.SelectionValue;
                        break;
                    default: // Masters
                        RD_ENTRY.PARAMETER.getFieldTypeElement().value = iControlId;
                        if (objData.SelectionMode == 1) {
                            RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked = true;
                        }
                        else {
                            RD_ENTRY.PARAMETER.getMultipleSelectionElement().checked = false;
                        }

                        RD_ENTRY.PARAMETER.getIsGroupElement().checked = objData.IsGroupMaster;
                        // m_objParameter.FieldId = (int)(RDGlobal.CallServeRequest(RDMethods.GetParameterFieldId, (MasterTypeId)cmbParameters.SelectedValue));
                        break;
                }

                RD_ENTRY.PARAMETER.onFieldType_Change(RD_ENTRY.PARAMETER.getFieldTypeElement());
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.PARAMETER.setData} " + err.message, "Error");
            }
        },

