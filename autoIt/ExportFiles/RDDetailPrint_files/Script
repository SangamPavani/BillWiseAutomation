        onBrowseFile: function (id, bFromMenu, evt) {
            let sAccept = "";
            let sCallback = "";
            let sFileName = "";
            let sExt = "";
            let iMaxFileSize = 0;
            let iCounter = 0;
            let bResult = true;
            let arrRestricted = undefined;
            let arrAllowed = undefined;
            let input = null;

            try {
                FUIElement.stopKeyProcess(evt);

                id = FUIElement.getValidElement(id);

                if(id.disabled == true) {
                    return;
                }

                input = FATTACHMENTCONTROL.PRIVATE.getFileInputElement(id);
                if (DataType.isValidObject(id) == true && bFromMenu == false) { // Called from onchange of filetype
                    if (evt.target.files.length > 0) {
                        sFileName = evt.target.files[0].name;
                        sFileName = sFileName.toLowerCase();
                        sFileName = DataType.stringRemoveSpace(sFileName);
                        sExt = FCommon.Files.getExtensionFromName(sFileName).toLowerCase();

                        if (sFileName.split('.').length > 2) {
                            FATTACHMENTCONTROL.clear(id);
                            return;
                        }

                        arrAllowed = FATTACHMENTCONTROL.PRIVATE.getAllowedExt(id);
                        if (arrAllowed.length > 0) {
                            for (iCounter = 0; iCounter < arrAllowed.length; iCounter++) {
                                if (arrAllowed[iCounter] == sExt) {
                                    break;
                                }
                            }

                            if (iCounter == arrAllowed.length) {
                                FATTACHMENTCONTROL.clear(id);
                                return;
                            }
                        }
                        else {
                            arrRestricted = FATTACHMENTCONTROL.PRIVATE.getRestrictedExt();
                            for (iCounter = 0; iCounter < arrRestricted.length; iCounter++) {
                                if (arrRestricted[iCounter] == sExt) {
                                    FATTACHMENTCONTROL.clear(id);

                                    return;
                                }

                                if (sFileName.includes("." + arrRestricted[iCounter] + ".") == true) {
                                    FATTACHMENTCONTROL.clear(id);

                                    return;
                                }
                            }
                        }


                        iMaxFileSize = FATTACHMENTCONTROL.PRIVATE.getMaxFileSize(id);
                        if (iMaxFileSize > 0 && evt.target.files[0].size > iMaxFileSize) {
                            FUIElement.showAlert("File size cannot be greater than " + iMaxFileSize + " bytes.");
                            FATTACHMENTCONTROL.clear(id);

                            return;
                        }

                        sCallback = FATTACHMENTCONTROL.PRIVATE.getOnFileSelectCallback(id);
                        if (DataType.isNullOrEmpty(sCallback, true) == false) {
                            bResult = eval(sCallback)(FUIElement.getValidElement(id), evt.target.files[0], evt);
                        }

                        if (DataType.isValidObject(bResult) == false || DataType.toBoolean(bResult) == true) {
                            FATTACHMENTCONTROL.PRIVATE.setFileData(id, evt.target.files[0]);
                        }
                        else {
                            FATTACHMENTCONTROL.clear(id);
                        }

                        sCallback = FATTACHMENTCONTROL.PRIVATE.getOnFileDataChangeCallback(id);
                        if (DataType.isNullOrEmpty(sCallback, true) == false) {
                            eval(sCallback)(FUIElement.getValidElement(id), evt);
                        }
                    }

                    return;
                }

                input = FATTACHMENTCONTROL.PRIVATE.getFileInputElement(id);

                sAccept = FATTACHMENTCONTROL.PRIVATE.getAccept(id);
                if (DataType.isNullOrEmpty(sAccept, true) == false) {
                    input.accept = sAccept;
                }

                $(input).trigger('click'); // opening dialog
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FATTACHMENTCONTROL.PRIVATE.onBrowseFile} " + err.message);
            }
        },

