    printTokenPrinting: function (requestParams) {
        try {
            //debugger;
            let tokenList = requestParams[0];
            let billPrinting = requestParams[1];
            let tokenNumber = requestParams[2];
            let billPrintingToken = [], billPrintTokenList = [];
            let bExists = false;
            let dictionaryByCategory = [];

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableTokenPrintingRetail == true && PreferenceSetting.PrefOutletTab.OutletPrintFormatsTab.Token > 0 &&
                tokenNumber != null && tokenNumber != undefined &&
                PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableTokenPrintingRetailCategoryId != null && PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableTokenPrintingRetailCategoryId != undefined
                && PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableTokenPrintingRetailCategoryId.trim().length > 0) {
                let arrCategoryWiseProduct = tokenList.filter(p => p.Category > 0);
                if (arrCategoryWiseProduct != null && arrCategoryWiseProduct != undefined && arrCategoryWiseProduct.length > 0) {
                    for (let i = 0; i < arrCategoryWiseProduct.length; i++) {
                        const arrCategory = dictionaryByCategory.filter(p => p.Key == arrCategoryWiseProduct[i].Category);
                        if (arrCategory == null || arrCategory == undefined || arrCategory.length <= 0) {
                            const groupingFieldValue = new Object();
                            groupingFieldValue.Key = arrCategoryWiseProduct[i].Category;
                            groupingFieldValue.Tag = [arrCategoryWiseProduct[i]];
                            dictionaryByCategory.push(groupingFieldValue);
                        }
                        else if (arrCategory != null && arrCategory != undefined && arrCategory.length > 0)
                            arrCategory[0].Tag.push(arrCategoryWiseProduct[i]);
                    }
                }

                if (dictionaryByCategory != null && dictionaryByCategory != undefined && dictionaryByCategory.length > 0) {

                    let arrCategoryId = PreferenceSetting.PrefOutletTab.OutletGeneralTab.EnableTokenPrintingRetailCategoryId.split(',');

                    for (let categorycounter = 0; categorycounter < dictionaryByCategory.length; categorycounter++) {
                        billPrintingToken = [];
                        billPrintingToken[BillPrint.NumberOfDecimal] = POSCommon.numberOfDecimal;
                        billPrintingToken[BillPrint.QtyNumberOfDecimal] = PreferenceSetting.PrefInventoryTab.DecmlsInQty;
                        bExists = false;
                        if (arrCategoryId != null && arrCategoryId != undefined && arrCategoryId.length > 0) {
                            for (let cc = 0; cc < arrCategoryId.length; cc++) {
                                if (arrCategoryId[cc] == dictionaryByCategory[categorycounter].Key) {
                                    bExists = true;
                                    break;
                                }
                            }
                            if (bExists == false)
                                continue;

                            let categoryItems = dictionaryByCategory[categorycounter].Tag;

                            billPrintingToken[BillPrint.HEADER] = [];
                            if (PreferenceSetting.PrefMiscellaneousOtherTab.MemberSelectionItemWise == true)
                                billPrintingToken[BillPrint.HEADER][BillPrintHeader.HCustomer] = categoryItems[0].MemberName;

                            billPrintingToken[BillPrint.HEADER] = billPrinting[BillPrint.HEADER];
                            billPrintingToken[BillPrint.HEADER][BillPrintHeader.HBillType] = "";
                            billPrintingToken[BillPrint.HEADER][BillPrintHeader.TokenNumber] = FConvert.toInt(tokenNumber) + "-" + categoryItems[0].CategoryCode;
                            billPrintingToken[BillPrint.HEADER][BillPrintHeader.HOrgVoucherNo] = billPrinting[BillPrint.HEADER][BillPrintHeader.HOrgVoucherNo];
                            let arrBillBodyToken = [], arrBillBody = [];
                            if (categoryItems != null && categoryItems != undefined && categoryItems.length > 0) {
                                for (let lc = 0; lc < categoryItems.length; lc++) {
                                    arrBillBodyToken = [];
                                    arrBillBodyToken[BillPrintBody.ProductId] = categoryItems[lc].DefaultValue1;
                                    arrBillBodyToken[BillPrintBody.Disc] = categoryItems[lc].DefaultValue6;
                                    arrBillBodyToken[BillPrintBody.Net] = categoryItems[lc].DefaultValue15;
                                    arrBillBodyToken[BillPrintBody.ProductName] = categoryItems[lc].DefaultValue2;
                                    arrBillBodyToken[BillPrintBody.ProductAlias] = categoryItems[lc].ProductAlias;
                                    arrBillBodyToken[BillPrintBody.ProductCode] = categoryItems[lc].ProductCode;
                                    arrBillBodyToken[BillPrintBody.Narration] = categoryItems[lc].Narration;
                                    arrBillBodyToken[BillPrintBody.Quantity] = categoryItems[lc].DefaultValue3;
                                    arrBillBodyToken[BillPrintBody.Rate] = categoryItems[lc].DefaultValue4;
                                    arrBillBodyToken[BillPrintBody.SNo] = FConvert.toString(lc + 1);
                                    arrBillBodyToken[BillPrintBody.Gross] = categoryItems[lc].DefaultValue5;

                                    arrBillBody.push(arrBillBodyToken);
                                }

                                billPrintingToken[BillPrint.BODY] = arrBillBody;
                                if (PreferenceSetting.PrefMiscellaneousOtherTab.MemberSelectionItemWise == true) {
                                    billPrintingToken[BillPrint.HEADER][BillPrintHeader.HCustomer] =
                                        billPrintingToken[BillPrint.FOOTER][BillPrintFooter.FCustomer] = categoryItems[0].MemberName;
                                    billPrintingToken[BillPrint.FOOTER][BillPrintFooter.FCustomerCode] = categoryItems[0].MemberCode;
                                }
                            }
                        }

                        billPrintTokenList.push(billPrintingToken);
                    }
                }
            }
            return billPrintTokenList;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function/Event :: VOUCHERPOSTING.PRINTMETHODS.printTokenPrinting :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return false;
        }
    },
