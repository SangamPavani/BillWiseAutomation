    getAlignment: function (iValue) {

        return ((iValue >> 3) & 3);
    },

    getAlignmentClass: function (iValue) {

        var sCellAlign = "";
        switch (iValue) {
            case 0:
                sCellAlign = "TextAlignLeft";
                break;
            case 1:
                sCellAlign = "TextAlignCenter";
                break;
            case 2:
                sCellAlign = "TextAlignRight";
                break;
        }
        return sCellAlign;
    },

    getMiscValue: function (iValue, iField) {

        switch (iField) {
            case MiscFields.HideThisColumn:
                return ((iValue >> 1) & 1) == 1 ? true : false;
            case MiscFields.MandatoryColumn:
                return ((iValue >> 2) & 1) == 1 ? true : false;
            case MiscFields.PrintUnderPrevColumn:
                return ((iValue >> 3) & 1) == 1 ? true : false;
            case MiscFields.FinalCalculation:
                return ((iValue >> 4) & 1) == 1 ? true : false;
            case MiscFields.ScrolltextToNextLine:
                return ((iValue >> 5) & 1) == 1 ? true : false;
            case MiscFields.InsertCommas:
                return ((iValue >> 6) & 1) == 1 ? true : false;
            case MiscFields.TotalTheColumn:
                return ((iValue >> 7) & 1) == 1 ? true : false;
            case MiscFields.ReverseSign:
                return ((iValue >> 8) & 1) == 1 ? true : false;
        }
        return false;
    },

    ConvertIntoDecimal: function (objValue) {
        var dValue = 0;
        try {
            dValue = parseFloat(objValue.toString()).toFixed(2);
        }
        catch (err) { }
        return (dValue);
    },

    convertToColor: function (num) {
        num >>>= 0;
        var b = num & 0xFF,
            g = (num & 0xFF00) >>> 8,
            r = (num & 0xFF0000) >>> 16,
            a = ((num & 0xFF000000) >>> 24) / 255;
        return "rgba(" + [r, g, b, a].join(",") + ")";
    },

    ByteToBase64: function (data) {
        if (data != 0 && data != "") {
            var str = String.fromCharCode.apply(null, data);
            return btoa(str).replace(/.{76}(?=.)/g, '$&\n');
        }
    },

