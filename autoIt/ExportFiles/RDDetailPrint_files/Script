        onCellClick: function (cell, event) {
            let iActiveColumn = -1;
            let iClickedColumn = -1;
            let iClickedRow = -1;
            let objContainerAttribute = undefined;
            let gridElement = undefined;
            let eleInput = undefined;
            let result = undefined;

            try {
                if (DataType.isValidObject(event.target) == true
                    && DataType.isNullOrEmpty(event.target.nodeName) == false
                    && event.target.nodeName.toLowerCase() !== "td") {
                    gridElement = FGRIDCONTROL.getGridElementFromCell(cell);
                    if (DataType.isValidObject(gridElement) == true) {
                        iActiveColumn = FGRIDCONTROL.getCurrentColumn(gridElement);
                        result = FGRIDCONTROL.getRowColumnFromElement(gridElement, cell);
                        if (DataType.isValidObject(result) == true
                            && FGRIDCONTROL.isValidRowIndex(gridElement, result.iRow) == true
                            && FGRIDCONTROL.isValidColumnIndex(gridElement, result.iColumn) == true) {
                            iClickedRow = result.iRow;
                            iClickedColumn = result.iColumn;
                        }
                    }

                    if (iActiveColumn != -1 && iClickedColumn != -1 && iActiveColumn != iClickedColumn) {
                        objContainerAttribute = FGRIDCONTROL.getContainerDataObject(gridElement, iClickedColumn);
                        if (objContainerAttribute.ColumnType == FGRIDCOLUMNTYPE.get("BOOLEAN")) {
                            FGRIDCONTROL.PRIVATE.processCellClick(cell, event);

                            eleInput = cell.children[0];

                            eleInput.checked = !eleInput.checked;
                            FGRIDCONTROL.PRIVATE.onColumnCheckboxClick(eleInput,
                                                                        iClickedRow,
                                                                        iClickedColumn,
                                                                        DataType.toBoolean(FUIElement.getAttribute(eleInput, "allowmultiselection")),
                                                                        DataType.toString(FUIElement.getAttribute(eleInput, "handler")),
                                                                        event);
                            return;
                        }
                    }

                    if (event.target.className != FGRIDCONTROL.getColumnTextDisplayContainerClassName()) {
                        return;
                    }
                    //return;
                }

                FGRIDCONTROL.PRIVATE.processCellClick(cell, event);
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.onCellClick} " + err.message);
            }
        },

        onCellDblClick: function (cell, event) {
            let sHandler = "";
            let iRow = 0;
            let iColumn = 0;
            let gridElement = undefined;
            let obj = undefined;

            try {
                if (DataType.isValidObject(event.target) == true
