    successGetOutputScreen: function (bStatus, data, tag) {
        try {
            ////debugger
            if (data == "") {
                COMMON.prototype.showMessage(msgs.msgNodatatoPrint, msgs.Error);
                return;
            }
            if (data.lValue == -1) {

                COMMON.prototype.showMessage(data.data, msgs.Error);
                return;
            }
            if (!bStatus) {
                if (tag[0] == 13 || tag[0] == 14)
                    COMMON.prototype.showMessage(msgs.msgReportFacebookSharingFailed, msgs.Error);
                else if (tag[0] == 14) {
                    COMMON.prototype.showMessage(msgs.msgReportTwitterSharingFailed, msgs.Error);
                }
                else if (tag[0] == 1) {
                    COMMON.prototype.showMessage(msgs.msgNodatatoPrint, msgs.Error);
                }
            }
            else {
                tag[0] = parseInt(tag[0]);
                if (tag[1] == true) {
                    var w = window.open("", "_blank");
                    if (FCommon.UI.isValidObject(w)) {
                        w.location = GLOBAL.getContextPath("GetDocumentToPrint", "TransHome", "Transactions") + '?fileName=' + data;
                    }
                }
                else {
                    if (tag[0] == 11 || tag[0] == 6) {
                        EMAIL.emailSettings(bSuccess, html);
                    }
                    if (tag[0] == 5) {
                        ////debugger;
                        window.location = GLOBAL.getContextPath("GetExportedFile", "RD", "RD") + '?fileName=' + data;
                        return;
                    }
                    if (tag[0] == 4) {
                        window.location = GLOBAL.getContextPath("GetExportedFile", "RD", "RD") + '?fileName=' + data;
                        REPORTRENDER.sleep(100);
                        return;                       
                    }
                    if (data != null && data != undefined && tag[0] != 13 && tag[0] != 14 && data.lValue == undefined && data != "") {
                        window.location = GLOBAL.getContextPath("GetExportedFile", "RD", "RD") + '?fileName=' + data;
                    }
                    else if (tag[0] == 13 || tag[0] == 14) {
                        if (data == true && tag[0] == 13) {
                            COMMON.prototype.showMessage(msgs.msgReportFacebookSharingSuccess, msgs.Success);
                        }
                        else if (data == true || tag[0] == 14) {
                            COMMON.prototype.showMessage(msgs.msgReportTwitterSharingSuccess, msgs.Success);
                        }
                        else if (data.lValue == undefined && (tag[0] == 14 || tag[0] == 13)) {
                            COMMON.prototype.showMessage(data.data, msgs.Error);
                        }
                        else {
                            var w = window.open("", "_blank");
                            $(w.document).html(data);
                            COMMON.prototype.showMessage(" " + data.sValue + " " + msgs.msgReportFailed, msgs.Error);
                        }
                    }
                    else if (tag[0] == 8) {
                        if (data.lValue == -1) {
                            COMMON.prototype.showMessage(" " + data.sValue + " " + data.data, msgs.Error);
                        }
                        else if (data.sValue != undefined) {
                            COMMON.prototype.showMessage(msgs.msgExportingthis + " '" + data.sValue + "' " + msgs.rdoFailed, msgs.Error);
                        }
                    }
                    else if (data.sValue != undefined) {
                        COMMON.prototype.showMessage(msgs.msgExportingthis + " '" + data.sValue + "' " + msgs.rdoFailed, msgs.Error);
                    }
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{REPORTRENDER.successGetOutputScreen}" + err.message, "Exception");
        }
    },

