                    const arrField = VOUCHERPOSTING.SINGLTONVARIABLES.JournalVoucherExtraFields.filter((p) => p.sFieldName == VOUCHERPOSTING.VARIABLES.BillSettlementExtraFields[i].Name);
                    if (arrField != null && arrField != undefined && arrField.length > 0) {
                        switch (arrField[0].iDataTypeId) {
                            case MasterDataType.Text:
