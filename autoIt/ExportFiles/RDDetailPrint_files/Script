            if (value.toLowerCase().trim() == "true" || value == "1") {
                return (true);
            }
        }
        else if (DataType.isBoolean(value) == true) {
            return (eval(value));
        }
        else if ((typeof value).toLowerCase() == "number") {
            if (FConvert.toDecimal(value) > 0) {
                return (true);
            }
        }

        return (false);
