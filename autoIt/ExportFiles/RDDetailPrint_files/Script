        processDefault: function (obj, event, bChangeRow, bAsync) {
            let iDecimalPlaces = 0;
            let myPromise = undefined;
            let value = undefined;

            try {
                if (obj.bHidden == false) {
                    if (obj.bLeave == true) {
                        switch (obj.ContainerAttribute.ColumnType) {
                            case FGRIDCOLUMNTYPE.get("BOOLEAN"):
                                obj.setCellData(obj.cell.children[0].checked);
