const FAlert = {
    show: function (sMessage, sTitle, sIcon, bStopAutoHide, bAutoWidth) {
        let sHtml = "";
        let sClassName = "";
        let sStyle = "";
        let eleContainer = null;
        let eleToast = null;        
        let toast = null;
        
        try {
            this.closeInactive();

            eleContainer = GLOBAL.getGlobalErrorContainer();
            if (DataType.isNullOrEmpty(eleContainer) == true) {
                alert(sMessage);

                return;
            }

            if (FCommon.String.isNullOrEmpty(sTitle, true) == true) {
                sTitle = "Focus10";
            }

            sClassName = "toast";
            if (bAutoWidth == true) {
                sClassName += " custom_scrollbar";
            }

            
            if (bAutoWidth == true) {
                sStyle = "width:auto;min-height:100px;max-height:500px;margin-left:50px;margin-right:50px;margin-bottom:50px;";
            }
            else {
                sStyle = "margin-bottom:2px;";
            }

            sHtml = "<div class='" + sClassName + "' role='alert' aria-live='assertive' aria-atomic='true' " + (bStopAutoHide === true ? "data-bs-autohide='false'" : "data-bs-autohide='true' data-bs-delay='6000'") + " style='" + sStyle + "'>";
            sHtml += "<div class='toast-header theme_background-color theme_color' style='padding:5px;'>";
            sHtml +=        "<strong class='me-auto' style='margin-left:0px !important;font-size:12px;'>" + sTitle + "</strong>";
            sHtml +=        "<small class='text-muted'></small>";
            sHtml += "<button type='button' class='btn-close alert-message-close' data-bs-dismiss='toast' aria-label='Close'></button>";
            sHtml +=    "</div>";
            sHtml += "<div class='toast-body alert-message-body'>";
            sHtml +=        sMessage;
            sHtml +=    "</div>";
            sHtml += "</div>";

            $(eleContainer).append(sHtml);

            eleToast = eleContainer.children[eleContainer.children.length - 1];
            toast = bootstrap.Toast.getOrCreateInstance(eleToast); // Returns a Bootstrap toast instance
            toast.show();

            if (DataType.isValidObject(window.CentraBOT) == true) {
                CentraBOT.makeVisible(false);
            }

            $(eleToast).on('hidden.bs.toast', function () {
                FAlert.closeInactive();
            });            
        }
        catch (err) {
            alert("Exception: {FAlert.show} " + err.message);
        }
    },

    closeInactive: function () {
        let eleContainer = null;
        let eleToast = null;
        let iCounter = 0;

        try {
            eleContainer = GLOBAL.getGlobalErrorContainer();

            for (iCounter = eleContainer.children.length - 1; iCounter >= 0; iCounter--) {
                eleToast = eleContainer.children[iCounter];
                if (eleToast.getBoundingClientRect().height == 0) {
                    eleContainer.removeChild(eleToast);
                }
            }

            if (eleContainer.children.length == 0 && DataType.isValidObject(window.CentraBOT) == true) {
                CentraBOT.makeVisible(true);
            }
        }
        catch (err) {
        }
    }
};
