    $('#copiedData option:selected').remove();
}

function onCubeRowGroupingPopup_LoadData(objGroupingData) {
    var option = null;
    var data = {};
    var jqResult = null;

    if (objGroupingData.Sorting != null) {
        for (var index = 0; index < objGroupingData.Sorting.length; index++) {
            data = {};

            jqResult = $("#TreeViewData li").find("[data-fieldid=" + objGroupingData.Sorting[index].ID + "]");
            if (jqResult.length < 1) {
                continue;
            }

            data.iFieldId = objGroupingData.Sorting[index].ID;
            data.sText = jqResult[0].getAttribute("data-fieldname");
            data.iDataTypeId = jqResult[0].getAttribute("data-datatypeid");
            data.bAscending = eval(objGroupingData.Sorting[index].Tag);

            option = createOptionElement(data);
            if (option != null) {
                document.getElementById("copiedData").appendChild(option);
            }
        }
    }

    setOptionsValue(objGroupingData.iMiscellaneousOptions);

    if (FCommon.String.isNullOrEmpty(objGroupingData.sDisplayValue) == false) {
        document.getElementById("txtDisplayValue").value = objGroupingData.sDisplayValue;
    }

    if (FCommon.UI.isValidObject(objGroupingData.SelectedClause) == true) {
        if (FCommon.UI.isValidObject(objGroupingData.SelectedClause.ID) == true) {
            document.getElementById("ddlClause").value = objGroupingData.SelectedClause.ID;
        }
            
        if (FCommon.UI.isValidObject(objGroupingData.SelectedClause.Value) == true) {
            document.getElementById("txtClauseValue").value = objGroupingData.SelectedClause.Value;
        }
    }
}

function onSave_Click(objGroupingData, sCallBack) {
    var arrData = [];

    try {
        $('#copiedData option').each(function () {
            var sortingData = {};
                
            sortingData.ID = this.getAttribute("data-fieldid");
            sortingData.Tag = this.getAttribute("data-sortasc");
            arrData.push(sortingData);
        });

        objGroupingData.iMiscellaneousOptions = getOptionsValue();
        objGroupingData.sDisplayValue = "";
        if ($('#chkOption3').prop('checked') || $('#chkOption4').prop('checked')) {
            objGroupingData.sDisplayValue = $("#txtDisplayValue").val();
        }

        objGroupingData.Sorting = arrData;
        objGroupingData.SelectedClause = [];
        objGroupingData.SelectedClause.ID = $("#ddlClause").val();
        objGroupingData.SelectedClause.Value = $("#txtClauseValue").val();

        if (document.getElementById("chkOption3").checked == true
            || document.getElementById("chkOption4").checked == true) {
            if (FCommon.String.isNullOrEmpty(objGroupingData.sDisplayValue) == true) {
                return(false);
            }
        }

        $('#GroupingModal').modal('hide');
        eval(sCallBack)(objGroupingData, false);

        return (true);
    }
    catch (err) {
        COMMON.prototype.showMessage("{_RDCustomizationCubeRowGrouping::onSave_Click} " + err.message, "Exception");
    }

    return (false);
}

function onCancel_Click(objGroupingData, sCallBack) {
    try {
        $('#GroupingModal').modal('hide');
        eval(sCallBack)(objGroupingData, true);
    }
    catch (err) {
        alert("Exception: {_RDCustomizationCubeRowGrouping::onCancel_Click} " + err.message);
    }
}

function createOptionElement(data) {
    var option = null;

    try {
        option = document.createElement("option");
        option.setAttribute("data-fieldid", data.iFieldId);
        option.setAttribute("data-datatypeid", data.iDataTypeId);
        option.setAttribute("data-fieldname", data.sText);
        option.setAttribute("data-sortasc", data.bAscending);
        option.value = data.iFieldId;

        if (data.bAscending == true) {
            option.text = data.sText;
        }
        else {
            option.text = data.sText + " [Desc]";
        }            
    }
    catch (err) {
        console.log("Exception: {_RDCustomizationCubeRowGrouping.createOptionElement} " + err.message);
        option = null;
    }

    return (option);
}

function getOptionsValue() {
    var iMiscellaneousOptions = 0;

    if ($("#chkOption1").prop("checked") == true) { // Do not start the next level on a new line
        iMiscellaneousOptions = 1;
    }

    if ($("#chkOption2").prop("checked") == true) { // Display total at the end of this level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("DISPLAY_TOTAL_AT_END"));
    }

    if ($("#chkOption3").prop("checked") == true) { // Display value at the begining of the level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("DISPLAY_VALUE_AT_START"));
    }

    if ($("#chkOption4").prop("checked") == true) { // Display value at the end of the level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("DISPLAY_VALUE_AT_END"));
    }

    if ($("#chkOption5").prop("checked") == true) { // Display blank line at the beginning of the level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("LEAVE_BLANK_LINE_AT_START"));
    }

    if ($("#chkOption6").prop("checked") == true) { // Display blank line at the end of the level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("DISPLAY_LINE_AT_END"));
    }

    if ($("#chkOption7").prop("checked") == true) { // Skip page at the end of the level
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("SKIP_PAGE_AT_END"));
    }
    if ($("#chkOption8").prop("checked") == true) {
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("HIDE_GROUP_TOTAL"));
    }
    if ($("#chkOption9").prop("checked") == true) {
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("HIDE_GROUP_ROW"));
    }
    if ($("#chkOption10").prop("checked") == true) {
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("INCLUDE_CODE_WITH_NAME"));
    }
    if ($("#chkOption11").prop("checked") == true) {
        iMiscellaneousOptions |= (1 << Focus_RD_DataStructs_GroupingOption.get("DISPLAY_BASED_ON_TREE_SEQUENCE"));
    }

    if ($("#rdbText").prop("checked") == true) { // Display Text
        iMiscellaneousOptions |= (1 << 10);
    }
    else { // Value of the formula
    }

    if ($("#chkDisplayInBold").prop("checked") == true) { // Display in Bold
        iMiscellaneousOptions |= (1 << 11);
    }

    if ($("#chkAddToTotal").prop("checked") == true) { // Add to Total
        iMiscellaneousOptions |= (1 << 12);
    }

    return (iMiscellaneousOptions);
}

function setOptionsValue(iMiscellaneousOptions) {
    if (((iMiscellaneousOptions >> 12) & 1) == 1) { // Add to Total
        document.getElementById("chkAddToTotal").checked = true;
    }

    if (((iMiscellaneousOptions >> 11) & 1) == 1) { // Display in Bold
        document.getElementById("chkDisplayInBold").checked = true;
    }

    if (((iMiscellaneousOptions >> 10) & 1) == 1) { // Display Text
        document.getElementById("rdbText").checked = true;
    }
    else { // Value of the formula
        document.getElementById("rdbValueOfTheFormula").checked = true;
    }
    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("DISPLAY_BASED_ON_TREE_SEQUENCE")) & 1) == 1) {
        document.getElementById("chkOption11").checked = true;
    }
    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("INCLUDE_CODE_WITH_NAME")) & 1) == 1) {
        document.getElementById("chkOption10").checked = true;
    }
    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("HIDE_GROUP_ROW")) & 1) == 1) {
        document.getElementById("chkOption9").checked = true;
    }
    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("HIDE_GROUP_TOTAL")) & 1) == 1) {
        document.getElementById("chkOption8").checked = true;
    }
    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("SKIP_PAGE_AT_END")) & 1) == 1) { // Skip page at the end of the level
        document.getElementById("chkOption7").checked = true;
    }

    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("DISPLAY_LINE_AT_END")) & 1) == 1) { // Display blank line at the end of this level
        document.getElementById("chkOption6").checked = true;
    }

    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("LEAVE_BLANK_LINE_AT_START")) & 1) == 1) { // Display blank line at the beginning of the level
        document.getElementById("chkOption5").checked = true;
    }

    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("DISPLAY_VALUE_AT_END")) & 1) == 1) { // Display value at the end of the level
        document.getElementById("chkOption4").checked = true;
        $("#DisplayValueDiv").show();
    }

    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("DISPLAY_VALUE_AT_START")) & 1) == 1) { // Display value at the begining of the level
        document.getElementById("chkOption3").checked = true;
        $("#DisplayValueDiv").show();
    }

    if (((iMiscellaneousOptions >> Focus_RD_DataStructs_GroupingOption.get("DISPLAY_TOTAL_AT_END")) & 1) == 1) { // Display total at the end of this level
        document.getElementById("chkOption2").checked = true;
    }

    if ((iMiscellaneousOptions & 1) == 1) { // Do not start the next level on a new line
        document.getElementById("chkOption1").checked = true;
    }
}
