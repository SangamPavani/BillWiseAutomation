                if (iNewValue < 0) {
                    iNewValue = 59;
                }
            }

            sValue = DataType.stringPadding(iNewValue, "00");

            sOldValue = element.value;
            if (obj.bHour == true) {
                sNewValue = sValue + sOldValue.substr(obj.iEnd);
            }
            else if (obj.bMinute == true) {
