const FPAGECONTROL = {
    PRIVATE: {
        onNavigation_Click: function (ele, bNext, event) {
            let sHandler = "";
            let iSelectedPage = 0;
            let iMax = 0;
            let obj = null;

            try {
                iMax = FPAGECONTROL.getTotalPages(ele);
                if (iMax < 1) {
                    return;
                }

                iSelectedPage = FPAGECONTROL.getSelectedPage(ele);
                if((bNext == true && iSelectedPage >= iMax) || (bNext == false && iSelectedPage <= 1)) {
                    return;
                }

                sHandler = FPAGECONTROL.PRIVATE.getPageChangeHandler(ele);
                if (bNext == true) {
                    iSelectedPage++;
                }
                else if (bNext == false) {
                    iSelectedPage--;
                }

                FPAGECONTROL.PRIVATE.setSelectedPage(ele, iSelectedPage);

                if (DataType.isNullOrEmpty(sHandler, true) == false) {
                    obj = {};
                    obj.bNext = bNext;
                    obj.iCurrentPage = iSelectedPage;

                    eval(sHandler)(obj, event);
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FPAGECONTROL.PRIVATE.onNavigation_Click} " + err.message);
            }
        },

        getPageChangeHandler: function (id) {
            let sValue = "";

            try {
                id = FUIElement.getValidElement(id);
                if (DataType.isValidObject(id) == true) {
                    sValue = FUIElement.getAttribute(id, "pagechangehandler");
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FPAGECONTROL.getPageChangeHandler} " + err.message);
            }

            return (sValue);
        },

        setSelectedPage: function (id, iPage) {
