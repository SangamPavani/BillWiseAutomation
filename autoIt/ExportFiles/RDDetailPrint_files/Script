                FUIElement.showAlert("Exception: {DATEPICKER.PRIVATE.onKeydown} " + err.message);
            }
        },

        onKeypress: function (id, event) {
            let sFormat = "";
            let sValue = "";
            let sChar = "";
            let iIndex = 0;
            let iReplaceIndex = 0;
            let iLastValue = 0;
            let obj = null;

            try {
                if (DATEPICKER.isMandatory(id) == false) {
                    if (document.getElementById(id.id + "_checkbox").checked == false) {
                        return (false);
                    }
                }
                else {
                    if (id.disabled == true || id.readOnly == true) {
                        return (false);
                    }
                }
                iLastValue = DATEPICKER.getDate(id);
                sValue = id.value;

                if (DataType.isValidObject(event.keyCode) == true && DATEPICKER.isInvalidkeyCode(event.keyCode) == true) {
                    return;
                }
                else if (DataType.isValidObject(event.charCode) == true && event.charCode) {
                    if (DATEPICKER.isValidInput(String.fromCharCode(event.charCode)) == false) {
                        FUIElement.stopKeyProcess(event);
                        return;
                    }

                    sChar = String.fromCharCode(event.charCode);
                }
                else {
                    if (DATEPICKER.isValidInput(String.fromCharCode(event.keyCode)) == false) {
                        FUIElement.stopKeyProcess(event);
                        return;
                    }

                    sChar = String.fromCharCode(event.keyCode);
                }

                iReplaceIndex = FUIElement.getCursorIndexInInput(id);
                if (iReplaceIndex >= sValue.length) {
                    FUIElement.stopKeyProcess(event);
                    return;
                }

                if (DATEPICKER.isValidInput(sValue.substr(iReplaceIndex, 1)) == false) {
                    FUIElement.stopKeyProcess(event);
                    iReplaceIndex = DATEPICKER.getNextValidInputIndex(id, iReplaceIndex);
