                        }
                        REPORTRENDER.ReferenceReport(1, 1, obj.report, obj.Account, iParentReportID);
                    }
                    break;
                case eAIResultType.ReportOutput:
                    debugger
                    var sOutput = obj.output;
                    var eleId = null;
                    var sExportButtonIdText = sUniqueId;
//                        (reportLineModel.CrossReference == true ? "CrossReference" : "") + DashletId;
                    if (sOutput != undefined) {
