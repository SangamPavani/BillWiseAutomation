var OPTIONCONTROL = {
    createControl: function (sControlId, iValue, sWidth, sURL, iMasterTypeId, iGroupType, sFilter, sMandatoryField, sOnLeave, sOnDataLoaded, sClassName, bNoCustomize) {
        let parameter = "";
        let value = null;
        let data = null;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sControlId) == true) {
                FUIElement.showAlert("Error: Control id is mandatory.");

                return (null);
            }

            //////// Control Id
            parameter = NETWORK.createParameterForHTTPPostRequest("sId", sControlId, parameter);

            //////// Value
            value = 0;
            if (OPTIONCONTROL_HELPER.isValidObject(iValue) == true) {
                value = iValue;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("iValue", value, parameter);

            //////// Width
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sWidth) == false) {
                value = sWidth;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sWidth", value, parameter);

            //////// URL
            parameter = NETWORK.createParameterForHTTPPostRequest("sURL", OPTIONCONTROL_HELPER.isNullOrEmpty(sURL) == true ? "" : sURL, parameter);

            //////// MasterTypeId
            value = 0;
            if (OPTIONCONTROL_HELPER.isValidObject(iMasterTypeId) == true && DataType.isInteger(iMasterTypeId) == true) {
                value = parseInt(iMasterTypeId);
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("iMasterTypeId", value, parameter);

            //////// GroupType
            value = 0;
            if (OPTIONCONTROL_HELPER.isValidObject(iGroupType) == true && DataType.isInteger(iGroupType) == true) {
                value = parseInt(iGroupType);
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("iGroupType", value, parameter);

            ///////// Table Name
            value = "";
            parameter = NETWORK.createParameterForHTTPPostRequest("sTableName", value, parameter);


            ///////// Primary Field
            value = "";
            parameter = NETWORK.createParameterForHTTPPostRequest("sPrimaryField", value, parameter);


            ///////// Display Field
            value = "";
            parameter = NETWORK.createParameterForHTTPPostRequest("sDisplayField", value, parameter);

            //////// Filter
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sFilter) == false) {
                value = sFilter;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sFilter", value, parameter);

            /////////// Exact Match
            value = true;
            parameter = NETWORK.createParameterForHTTPPostRequest("bExactMatch", value, parameter);

            /////////// No Customize
            parameter = NETWORK.createParameterForHTTPPostRequest("bNoCustomize", DataType.toBoolean(bNoCustomize), parameter);

            //////// Mandatory Field
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sMandatoryField) == false) {
                value = sMandatoryField;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sMandatoryField", value, parameter);

            //////// Class Name
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sClassName) == false) {
                value = sClassName;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sClassName", value, parameter);

            //////// OnLeave
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sOnLeave) == false) {
                value = sOnLeave;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sOnLeave", value, parameter);

            //////// OnDataLoaded
            value = "";
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sOnDataLoaded) == false) {
                value = sOnDataLoaded;
            }
            parameter = NETWORK.createParameterForHTTPPostRequest("sOnDataLoaded", value, parameter);
            data = OPTIONCONTROL_SERVER.executeServerMethod(OPTIONCONTROL_HELPER.getContextPath("CreateOptionControl", "Home", ""), true, parameter, 'json');
            if (data != null) {
                if (data.lValue < 1 && OPTIONCONTROL_HELPER.isNullOrEmpty(data.sValue) == false) {
                    FUIElement.showAlert(data.sValue);
                }

                if (data.lValue > 0) {
                    data = data.data;
                }
                else {
                    data = null;
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL.createControl} " + err.message);
        }

        return (data);
    },

