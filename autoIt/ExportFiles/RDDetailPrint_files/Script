            value = num.substr(iIndex + 1).length;
            if (bIgnoreTrailingZero == true && value > 0) {
                for (iCounter = num.length - 1; iCounter >= 0; iCounter--) {
                    if (num[iCounter] != '0') {
                        break;
                    }
                }

                if (iCounter > 0) {
                    if (num[iCounter] == '.') {
                        value = 0;
                    }
                    else {
                        value = (iCounter - iIndex);
                    }
                }
                else {
                    value = 0;
                }
            }
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {DataType.getDecimalPlaces} " + err.message);
