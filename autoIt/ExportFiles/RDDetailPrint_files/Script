    PostedgetData: function () {
        var arrProjectedData = [];
        var totalRows = FGRIDCONTROL.getTotalRows('gProjectedDate');
        var totalRowsPickedData = FGRIDCONTROL.getTotalRows('gPickedData');
        FGRIDCONTROL.update("gProjectedDate");
        FGRIDCONTROL.update("gPickedData");
        for (var i = 0 ; i < totalRows; i++) {
            var rowData = FGRIDCONTROL.getRowValue('gProjectedDate', (i + 1));
            if (rowData[0].Value != "" && rowData[1].Value != "" && rowData[2].Value != "") {
                var objProjectedData = {};
                objProjectedData.PostingDate = rowData[0].Data.value;
                objProjectedData.AccountId = rowData[1].Data.value;
                objProjectedData.Formula = rowData[2].Data.value
                arrProjectedData.push(objProjectedData);
            }
            else {
                break;
            }
        }
        for (var j = 0 ; j < totalRowsPickedData ; j++) {
            var rowGridData = FGRIDCONTROL.getRowValue('gPickedData', (j + 1));
            if (rowGridData[0].Value != "" && rowGridData[1].Value != "") {
                var objProjectedData = {};
                objProjectedData.PostingDate = rowGridData[0].Data.value;
                objProjectedData.AccountId = rowGridData[1].Data.value;
                objProjectedData.IsBudget = true;
                arrProjectedData.push(objProjectedData);
            }
        }
        return arrProjectedData
    },

