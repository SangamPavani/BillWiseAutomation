const FUIElement = {
    setText: function (element, sText, bUpdateTooltip) {
        let sNodeName = "";
        let sType = "";

        try {
            element = FUIElement.getValidElement(element);
            if (DataType.isValidObject(element) == false) {
                return;
            }

            if (DataType.isValidObject(window.OPTIONCONTROL) == true
                && FUIElement.hasClass(element, OPTIONCONTROL.getClassName()).Value == true) {
                OPTIONCONTROL.setControlText(element, sText, true);
                return;
            }
            else if (DataType.isValidObject(FHyperLink) == true
                && FUIElement.hasClass(element, FHyperLink.getClassName()).Value == true) {
                FHyperLink.setValue(element, sText);
                return;
            }

