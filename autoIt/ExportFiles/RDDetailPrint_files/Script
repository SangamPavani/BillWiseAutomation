    setReportParameterValues: function (arrReportParameter, arrInputs, DashletId) {
        if (arrReportParameter != undefined && arrReportParameter != null && arrReportParameter.length > 0 && arrInputs != undefined && arrInputs != null && arrInputs.length > 0) {
            for (var count = 1; count < arrReportParameter.length; count++) {
                for (var count1 = 0; count1 < arrInputs.length; count1++) {
                    if (Math.abs(arrReportParameter[count].FieldId) == Math.abs(arrInputs[count1].ID)) {
                        switch (arrReportParameter[count].FieldType) {
                            case FIELDTYPE.Master://_FieldType.Master
                                switch (arrReportParameter[count].SelectionMode) {
                                    case SELECTIONMODE.Single: //_SelectionMode.Single
                                        OPTIONCONTROL.setControlValue("MasterSingle_" + DashletId + "_" + Math.abs(arrReportParameter[count].FieldId), arrInputs[count1].Value);
                                        break;
                                }
                                break;
                            case FIELDTYPE.Normal: //_FieldType.Normal
                                switch (arrReportParameter[count].ControlId) {
                                    case REPORTINPUTTYPE.Number://ReportInputType.Number
                                        document.getElementById("RITNumber_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        break;
                                    case REPORTINPUTTYPE.Text://ReportInputType.Text
                                        document.getElementById("RITText_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        break;
                                    case REPORTINPUTTYPE.DateRange://ReportInputType.DateRange
                                        document.getElementById("RITDateRange_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        break;
                                    case REPORTINPUTTYPE.AsOnDate://ReportInputType.AsOnDate
                                        document.getElementById("RITAsOnDate_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        break;
                                    case REPORTINPUTTYPE.Combobox://ReportInputType.Combobox
                                        document.getElementById("RITCombobox_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        REPORTVIEW.comboSelectionChange(document.getElementById("RITCombobox_" + DashletId + "_" + arrReportParameter[count].FieldId));
                                        break;
                                    case REPORTINPUTTYPE.Time://ReportInputType.Time
                                        FTIMECONTROL.setTime("RITTime_" + DashletId + "_" + arrReportParameter[count].FieldId, arrInputs[count1].Value);
                                        break;
                                    case REPORTINPUTTYPE.CheckBox://ReportInputType.CheckBox
                                        document.getElementById("RITCheckbox_" + DashletId + "_" + arrReportParameter[count].FieldId).checked = arrInputs[count1].Value > 0;
                                        break;
                                    case REPORTINPUTTYPE.Fraction://ReportInputType.Fraction
                                        document.getElementById("RITFraction_" + DashletId + "_" + arrReportParameter[count].FieldId).value = arrInputs[count1].Value;
                                        break;
                                    case REPORTINPUTTYPE.Master://ReportInputType.Master
                                        break;
                                        //case REPORTINPUTTYPE.Table://ReportInputType.Table
                                        //    OPTIONCONTROL.setControlValue("RITTable_" + DashletId + "_" + arrReportParameter[count].FieldId, arrInputs[count1].Value);
                                        //    break;
                                    case REPORTINPUTTYPE.PopupButton://ReportInputType.PopupButton
                                        break;
                                }
                                break;
                        }
                        break;
                    }
                }
            }
        }
    },

