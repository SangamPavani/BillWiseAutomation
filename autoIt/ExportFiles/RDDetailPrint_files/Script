                                eleBodyTable.children[0].children[m].children[n].style.width = eleTHeadSubColumns[k].style.width;
                            }
                            n = n + 1;
                            bAdd = true;
                        }
                        eleTHeadColumns[i].style.width = dblTHeadColumnWidth + "px";
                    }
                }
                if (bAdd == false) {
                    n = n + 1;
                }
            }

            var eleHeadTable = document.getElementById('tblRDRender');
            if (FCommon.UI.isValidObject(eleHeadTable)) {
                //if (eleHeadTable.getBoundingClientRect().width > eleBodyTable.getBoundingClientRect().width) {
