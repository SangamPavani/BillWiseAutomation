        onDelete_Click: function () {
            //debugger
            var parent = null;
            var iCounter = 0;
            var result = null;

            try {
                result = RD_ENTRY.PARAMETER.getSelectedParameter();
                if (result.lValue < 1) {
                    if (FCommon.String.isNullOrEmpty(result.sValue) == false) {
                        COMMON.prototype.showMessage(result.sValue, "Exception");
                    }

                    return;
                }

                if (!confirm("Do you want to Delete?")) {
                    return;
                }

                parent = RD_ENTRY.PARAMETER.getParameterListElement();
                for (iCounter = 0; iCounter < result.lValue; iCounter++) {
                    parent.removeChild(result.data[iCounter]);
                }

                RD_ENTRY.PARAMETER.clearData();
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.PARAMETER.onDelete_Click}" + err.message, "Exception");
