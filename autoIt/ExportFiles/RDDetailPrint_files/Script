    this.getNextNo = function (sSeries) {
        let iCounter = 0;
        let iLength = 0;
        let sNumber = "";
        let sLong = "";
        let sAlpha = "";
        let iTemp = 0;

        try {
            if (DataType.isNullOrEmpty(sSeries) == true) {
                return ("1");
            }

            iLength = sSeries.length;

            // Loop from end of the text till alpha value found and set value to number part
            while (iLength > 0) {
                iTemp = sSeries.charCodeAt(iLength - 1);
                if (iTemp >= 48 && iTemp <= 57) {
                    sNumber += sSeries.substr(iLength - 1, 1);
                }
                else {
                    break;
                }

                iLength--;
            }

            // Seperate alpha and number value from text 
            sAlpha = sSeries.substr(0, iLength);

            iLength = sNumber.length;
            sSeries = "";

            while (iLength > 0) {
                sSeries += sNumber.substr(iLength - 1, 1);
                iLength--;
            }

            if (DataType.stringStartsWith(sSeries, "0") == true) {
                sLong = DataType.toInt64(sSeries);
                if (sLong == "9" || sLong == "99" || sLong == "999" || sLong == "9999" || sLong == "99999" || sLong == "999999") {
                    sSeries = sSeries.substr(1);
                }
