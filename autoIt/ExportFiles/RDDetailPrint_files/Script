                        }
                        break;
                    case eRoundingType.Down:
                        if (dRoundOffTo == 0) {
                            dValue = (dActualNumber * iSign);
                        }
                        else {
                            dValue = Math.floor(dActualNumber / dRoundOffTo) * dRoundOffTo * iSign;
