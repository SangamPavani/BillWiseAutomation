            var eleTHeadSubColumns = null;
            var sGroupName = null;
            var iHeadColNumber = 0;
            var iNextHeadColNumber = 0;
            var n = 0;
            var k = 0;
            var dblTHeadColumnWidth = 0;
            var bAdd = false;
            pressed = false;
            eleBodyTable.style.width = sWidth;

            eleBodyTable.parentElement.style.width = sWidth;//tblRDRender.getBoundingClientRect().width + "px";

            if (FCommon.UI.isValidObject(eleBodyTable.parentElement.previousElementSibling.children[0].children[1].children[1])) {
                eleTHeadSubColumns = eleBodyTable.parentElement.previousElementSibling.children[0].children[1].children[1].children;
            }

            for (var i = 0; i < eleTHeadColumns.length; i++) {
                bAdd = false;
                sGroupName = eleTHeadColumns[i].getAttribute('data-sgroupname');
                if (sGroupName == null) {
                    eleTHeadColumns[i].style.width = eleBodyFirstRow.children[n].getBoundingClientRect().width + "px";
                    for (var m = 0; m < eleBodyTable.children[0].children.length; m++) {
                        eleBodyTable.children[0].children[m].children[n].style.width = eleTHeadColumns[i].style.width;
                    }
                }
                else {
                    dblTHeadColumnWidth = 0;
                    iHeadColNumber = eleTHeadColumns[i].getAttribute('data-icolnumber');
                    if (FCommon.UI.isValidObject(eleTHeadColumns[i + 1])) {
                        iNextHeadColNumber = eleTHeadColumns[i + 1].getAttribute('data-icolnumber');
                        for (var j = 0; j < iNextHeadColNumber - iHeadColNumber; j++) {
                            eleTHeadSubColumns[k].style.width = eleBodyFirstRow.children[n].getBoundingClientRect().width + "px";
                            dblTHeadColumnWidth = dblTHeadColumnWidth + eleBodyFirstRow.children[n].getBoundingClientRect().width;
                            for (var m = 0; m < eleBodyTable.children[0].children.length; m++) {
                                eleBodyTable.children[0].children[m].children[n].style.width = eleTHeadSubColumns[k].style.width;
                            }
                            n = n + 1; k = k + 1;
                            bAdd = true;
                        }
                        eleTHeadColumns[i].style.width = dblTHeadColumnWidth + "px";
                    }
                    else {
                        for (var j = 0; j < eleTHeadSubColumns.length - 1; j++) {
                            eleTHeadSubColumns[k].style.width = eleBodyFirstRow.children[n].getBoundingClientRect().width + "px";
                            dblTHeadColumnWidth = dblTHeadColumnWidth + eleBodyFirstRow.children[n].getBoundingClientRect().width;
