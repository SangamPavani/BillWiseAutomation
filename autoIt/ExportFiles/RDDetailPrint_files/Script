function DynamicArray() {
    this.arrData = [];

    this.clear = function () {
        this.arrData = [];
    },

    this.push = function (value) {
        this.arrData.push(value);

        return (this.count());
    },

    this.peek = function () {
        var value = null;

        if (this.count() < 1) {
            return;
        }

        value = this.arrData[this.arrData.length - 1];

        return (value);
    },

    this.pop = function () {
        var value = null;

        if (this.count() < 1) {
            return;
        }

        value = this.arrData[this.arrData.length - 1];
        this.delete(this.arrData.length - 1);

        return (value);
    },

    this.insert = function (iIndex, value) {
        if (iIndex < this.count()) {
            this.arrData.splice(iIndex, 0, value);

            return (iIndex);
        }
        else {
            this.push(value);

            return (this.count() - 1);
        }
    },

    this.delete = function (iIndex) {
        if (iIndex < 0 || iIndex >= this.count()) {
            return (false);
        }

        this.arrData.splice(iIndex, 1);

        return (true);
    },

    this.getArray = function () {
        return (this.arrData);
    },

    this.count = function () {
        return (this.arrData.length);
    };
};

