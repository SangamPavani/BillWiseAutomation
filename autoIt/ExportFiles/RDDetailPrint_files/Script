        onOK_Click: function () {
            //debugger
            var objData = null;
            var result = null;

            try {
                result = RD_ENTRY.PARAMETER.getSelectedParameter();
                if (result.lValue < 0) {
                    COMMON.prototype.showMessage(result.sValue, "Exception");
                }

                objData = RD_ENTRY.PARAMETER.getData();
                if (RD_ENTRY.PARAMETER.isValidData(objData, true) == false) {
                    return;
                }

                if (RD_ENTRY.PARAMETER.isUniqueFieldName(objData.FieldName, result.lValue > 0 ? result.data[0].id : "") == false) {
                    COMMON.prototype.showMessage("'" + objData.FieldName + "' already added.", "Error");
                    return;
                }

                if (RD_ENTRY.PARAMETER.addParameter(objData, result.lValue > 0 ? result.data[0].id : "") == true) {
                    RD_ENTRY.PARAMETER.clearData();
                    RD_ENTRY.PARAMETER.unselectAll();
