                                    if (DataType.isNullOrEmpty(eleCtrl.value) == false && iDecimalPlaces > 0) {
                                        eleCtrl.value = DataType.toDecimal(eleCtrl.value, iDecimalPlaces);
                                    }

                                    obj.setCellText(eleCtrl.value, eleCtrl.value);
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("STRINGLIST"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == false) {
                                    break;
                                }
                                if (eleCtrl.selectedIndex >= 0) {
                                    obj.setCellText(eleCtrl.options[eleCtrl.selectedIndex].text, eleCtrl.options[eleCtrl.selectedIndex].value);
                                }
                                else {
                                    obj.setCellText("", "");
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("NUMBERLIST"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == false) {
                                    break;
                                }
                                if (eleCtrl.selectedIndex >= 0) {
                                    obj.setCellText(eleCtrl.options[eleCtrl.selectedIndex].text, eleCtrl.options[eleCtrl.selectedIndex].value);
                                }
                                else {
                                    obj.setCellText("", "");
                                }
                                break;
                        }

                    }
                    else // Enter
                    {
                        switch (obj.ContainerAttribute.ColumnType) {
                            case FGRIDCOLUMNTYPE.get("BOOLEAN"):
                                if (FGRIDCONTROL.isCheckboxColumnReadyForInput(obj.Grid, obj.iRow, obj.iColumn) == true) {
                                    obj.cell.children[0].focus();
                                    return;
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("TEXT"):
