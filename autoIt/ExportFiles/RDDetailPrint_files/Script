        for (var i = 0; i < arr_Transcationset.length; i++)
        {
            if (arr_Transcationset[i] != 0) {
                iValue |= arr_Transcationset[i] << (i + 1);
            }
        }
        cashObj.EndDate = parseInt(Enddate);
        cashObj.SelectedMasters = arrMasterIds;
        cashObj.StartDate = Startdate;
        cashObj.TemplateId = TemplateId;
        cashObj.TemplateName = TemplateName;
        cashObj.ProjectedData = CashCalender.PostedgetData();
