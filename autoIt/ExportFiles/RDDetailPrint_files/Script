        prepareURL: function (sURL) {
            let sProtocol = "";
            let sPathName = "";
            let sHost = "";

            try {
                sProtocol = document.location.protocol;
                sHost = document.location.host;

                if (DataType.stringStartsWith(sURL, ".") == true) {
                    sURL = sURL.substr(1); // Remove .

                    sPathName = document.location.pathname;
                    if (sPathName.indexOf("/", 1) < 0) {
                        sPathName = sPathName + "/";
                    }

                    // Remove last /
                    sPathName = sPathName.substr(0, sPathName.indexOf("/", 1));
                }

                sURL = DataType.toString(sURL).trim();
                if (DataType.isNullOrEmpty(sURL) == true) {
                    return (sURL);
                }

                if (DataType.stringStartsWith(sURL, "/") == true) {
                    return (sProtocol + "//" + sHost + sPathName + sURL);
                }

                if (DataType.stringStartsWith(sURL.toLowerCase(), "www.") == true) {
                    return (sURL);
                }

                if (DataType.stringStartsWith(sURL.toLowerCase(), "http:") == true) {
                    return (sURL);
                }

                if (DataType.stringStartsWith(sURL.toLowerCase(), "https:") == true) {
                    return (sURL);
                }

                return (sProtocol + "//" + sHost + sPathName + "/" + sURL);
            }
            catch (err) {
                FUIElement.writeErrorLog("Exception: {FWrapper.prepareURL} " + err.message);
            }

            return (sURL);
        },

