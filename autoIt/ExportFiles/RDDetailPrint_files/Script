                                    myPromise = new Promise(function (myResolve, myReject) {
                                        myResolve({ Grid: obj.Grid, iRow: obj.iRow, event: event });
                                    });

                                    myPromise.then(function (objInput) {
                                        FGRIDCONTROL.gotoCell(objInput.Grid, objInput.iRow + 1, 1, objInput.event);
                                    },
                                    function (error) {
                                        FUIElement.writeErrorLog("Exception: {FGRIDCONTROL.PRIVATE.processDefault.gotoCell} " + error);
                                    });
                                }
                                else {
                                    FGRIDCONTROL.gotoCell(obj.Grid, obj.iRow + 1, 1, event);
                                }

                                //FGRIDCONTROL.gotoCell(obj.Grid, obj.iRow + 1, 1, event);
                            }
                        }
                        else {
                            if (bAsync == true && window.Promise) {
                                myPromise = new Promise(function (myResolve, myReject) {
                                    myResolve({ cell: obj.cell, event: event });
                                });

                                myPromise.then(function (objInput) {
                                    FGRIDCONTROL.PRIVATE.moveToNextCell(objInput.cell, objInput.event);
                                },
                                function (error) {
                                    FUIElement.writeErrorLog("Exception: {FGRIDCONTROL.PRIVATE.processDefault.moveToNextCell} " + error);
                                });
                            }
                            else {
                                FGRIDCONTROL.PRIVATE.moveToNextCell(obj.cell, event);
                            }
                            //FGRIDCONTROL.PRIVATE.moveToNextCell(obj.cell, event);
                        }
                    }
                }
                else {
                    if (event !== undefined) {
                        evt = event;
                    }
                    else if (window.event !== undefined) {
                        evt = window.event;
                    }
                    else if (arguments.callee.caller.arguments !== undefined && arguments.callee.caller.arguments.length > 0) {
                        evt = arguments.callee.caller.arguments[0];
                    }

                    if (bAsync == true && window.Promise) {
                        myPromise = new Promise(function (myResolve, myReject) {
                            myResolve({ cell: obj.cell, event: evt });
                        });

                        myPromise.then(function (objInput) {
                            FGRIDCONTROL.PRIVATE.moveToNextCell(objInput.cell, objInput.event);
                        },
                        function (error) {
                            FUIElement.writeErrorLog("Exception: {FGRIDCONTROL.PRIVATE.processDefault.moveToNextCell} " + err.message);
                        });
                    }
                    else {
                        FGRIDCONTROL.PRIVATE.moveToNextCell(obj.cell, evt);
                    }

                    //FGRIDCONTROL.PRIVATE.moveToNextCell(obj.cell, evt);
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception:  {FGRIDCONTROL.PRIVATE.processDefault} " + err.message);
            }
        },

        getCellObjectInternal: function (cell, iRow, iColumn, bLeave) {
            let gridElement = undefined;
            let obj = undefined;

            try {
                if (DataType.isValidObject(cell) == false) {
                    return;
                }

                gridElement = FGRIDCONTROL.getGridElementFromCell(cell);

                obj = {};
                obj.Grid = gridElement;
                obj.cell = cell;
                obj.iRow = iRow;
                obj.iColumn = iColumn;
                obj.bLeave = bLeave;
                obj.bHidden = false;
                obj.EventType = "";
                if (obj.bLeave == true) {
                    obj.EventType = "cellleave";
                }
                if (DataType.isNullOrEmpty(cell.style.display) == false) {
                    if (cell.style.display.toLowerCase() == "none") {
                        obj.bHidden = true;
                    }
                }
                obj.sText = $(cell).text();
                obj.ColumnAttribute = FGRIDCONTROL.getHeadingDataObject(gridElement, iColumn);
                obj.ContainerAttribute = FGRIDCONTROL.getContainerDataObject(gridElement, iColumn);
                obj.bMultiline = obj.ContainerAttribute.bMultiline;
                obj.iMaxHeight = obj.ContainerAttribute.iMaxHeight;

                obj.CellData = FUIElement.getObjectFromDataAttribute(cell);

                obj.reloadCellData = function () {
                    this.CellData = FUIElement.getObjectFromDataAttribute(this.cell);
                }

                obj.setCellText = function (sText, data, bIgnoreCallback, bIgnoreDelay) {
                    let obj = null;

                    bIgnoreCallback = DataType.toBoolean(bIgnoreCallback);
                    bIgnoreDelay = DataType.toBoolean(bIgnoreDelay);
                    obj = FGRIDCONTROL.setCellText(this.cell,
                                                    sText,
                                                    bIgnoreCallback,
                                                    this.bMultiline,
                                                    this.iMaxHeight,
                        bIgnoreDelay);
                    if (DataType.isValidObject(data) == true && (DataType.isValidObject(obj.eleChild) == false || FUIElement.hasClass(obj.eleChild, "FCellTextDisplayContainer").Value == true)) {
                        this.setCellData(data, undefined, bIgnoreCallback);
                    }

                    return (obj.OldText);
                };
                obj.getCellText = function () {
                    return (FGRIDCONTROL.getCellText(this.cell));
                };
                obj.setCellHtml = function(sHtml) {
                    FGRIDCONTROL.setCellHtml(this.cell, sHtml);
                };
                obj.setCellData = function (key, sValue, bIgnoreCallback) {
                    if (DataType.isValidObject(key) == false) {
                        this.resetCellData();
                        return;
                    }

                    bIgnoreCallback = DataType.toBoolean(bIgnoreCallback);
                    if (DataType.isValidObject(sValue) == false) {
                        if (DataType.isArray(key) == true) {
                            this.resetCellData();
                            FCommon.UI.createAttributesFromArray(this.cell, key);
                        }
                        else if (DataType.isObject(key) == true) {
                            this.resetCellData();
                            FCommon.UI.createAttributesFromObject(this.cell, key);
                        }
                        else {
                            return (FGRIDCONTROL.setCellData(this.cell, "value", key, bIgnoreCallback));
                        }
                    }
                    else {
                        return (FGRIDCONTROL.setCellData(this.cell, key, sValue, bIgnoreCallback));
                    }
                };
                obj.setMasterValue = function(value, optCtrl) {
                    FGRIDCONTROL.setMasterValue(this, value, optCtrl);
                };
                obj.getCellData = function (sKey) {
                    if (DataType.isNullOrEmpty(sKey) == true) {
                        return (FGRIDCONTROL.getCellData(this.cell, "value"));
                    }

                    return (FGRIDCONTROL.getCellData(this.cell, sKey));
                };
                obj.getCellRawData = function (sKey) {
                    if (DataType.isNullOrEmpty(sKey) == true) {
                        return (FGRIDCONTROL.getCellRawData(this.cell, "value"));
                    }

                    return (FGRIDCONTROL.getCellRawData(this.cell, sKey));
                };
                obj.hasDataAttribute = function (sKey) {
                    return (FUIElement.hasDataAttribute(this.cell, sKey));
                };
                obj.getColumnAttributeValue = function (sKey) {
                    let objValue = "";

                    try {
                        if (DataType.isValidObject(this.ColumnAttribute) == true) {
                            objValue = this.ColumnAttribute[sKey];
                        }
                    }
                    catch (err) {
                        FUIElement.showAlert("Exception:  {FGRIDCONTROL::cellobj.getColumnAttributeValue} " + err.message);
                    }

                    return (objValue);
                };
                obj.resetCellData = function (key) {
                    FGRIDCONTROL.resetCellData(this.cell, key);
                };
                obj.setRowData = function (key, sValue) {
                    return (FGRIDCONTROL.setRowData(this.cell.parentElement, key, sValue));
                };
                obj.getRowData = function (sKey) {
                    return (FGRIDCONTROL.getRowData(this.cell.parentElement, sKey));
                };
                obj.clear = function () {
                    try {
                        if (this.ContainerAttribute.ColumnType == FGRIDCOLUMNTYPE.get("BOOLEAN")) {
                            this.setCheckboxState(false);
                        }
                        else {
                            FGRIDCONTROL.setCellText(this.cell, "", false, this.bMultiline, this.iMaxHeight);
                        }

                        this.resetCellData();
                    }
                    catch (err) {
                        FUIElement.showAlert("Exception:  {FGRIDCONTROL::cellobj.clear} " + err.message);
                    }
                };
                obj.hasControl = function () {
                    let bResult = false;

                    if (DataType.isValidObject(this.cell) == true && this.cell.children.length > 0) {
                        bResult = true;
                    }

                    return (bResult);
                };
                obj.getControl = function () {
                    let ele = null;

                    if (DataType.isValidObject(this.cell) == true && this.cell.children.length > 0) {
                        ele = this.cell.children[0];
                    }

                    return (ele);
                };
                obj.setControl = function (element, value, data) {
                    let sText = "";
                    let bFlag = false;
                    let bIgnoreDelay = false;


                    if (this.hasControl() == true) {
                        bIgnoreDelay = true;
                    }

                    sText = this.getCellText();
                    this.setCellText("", undefined, true, bIgnoreDelay);

                    element = FUIElement.getValidElement(element);
                    if (DataType.isValidObject(element) == false) {
                        return (sText);
                    }

                    if ($(element).hasClass(OPTIONCONTROL.getClassName()) == true) {
                        OPTIONCONTROL.setParent(element, this.cell, true);
                        if (DataType.isValidObject(value) == true) {
                            if (OPTIONCONTROL.getControlType(element) == eWebOptionControlType.Narration) {
                                element.value = value;
                                bFlag = true;
                            }
                            else {
                                if (value > 0) {
                                    OPTIONCONTROL.setControlValue(element, value, null, null, true);
                                    bFlag = true;
                                }
                            }
                        }

                        if (bFlag == false) {
                            OPTIONCONTROL.clear(element);
                        }
                    }
                    else if ($(element).hasClass(DATEPICKER.getClassName()) == true) {
                        DATEPICKER.setParent(element, this.cell);
                        if (DataType.isValidObject(value) == true) {
                            if (value > 0) {
                                DATEPICKER.setDate(element, value, true);
                                bFlag = true;
                            }
                        }

                        if (bFlag == false) {
                            DATEPICKER.clear(element);
                        }
                    }
                    else if ($(element).hasClass(FTIMECONTROL.getClassName()) == true) {
                        this.cell.appendChild(element);
                        if (DataType.toInt(value) > 0) {
                            FTIMECONTROL.setTime(element, value);
                        }
                        else {
                            FTIMECONTROL.clear(element);
                        }

                        FUIElement.setFocus(element.id);
                    }
                    else if ($(element).hasClass(FPOPUPCONTROL.getClassName()) == true) {
                        FPOPUPCONTROL.setCurrentRow(element, this.iRow);
                        FPOPUPCONTROL.setCurrentColumn(element, this.iColumn);

                        if (DataType.isNullOrEmpty(value, true) == false) {
                            if(DataType.isValidObject(data) == true) {
                                FPOPUPCONTROL.setControlText(element, value, DataType.toString(data));
                            }
                            else {
                                FPOPUPCONTROL.setControlText(element, value);
                            }

                            bFlag = true;
                        }

                        if (bFlag == false) {
                            FPOPUPCONTROL.clear(element);
                        }

                        FPOPUPCONTROL.setParent(element, this.cell);
                    }
                    else if (FUIElement.hasClass(element, FATTACHMENTCONTROL.getClassName()).Value == true) {
                        FATTACHMENTCONTROL.setParent(element, this.cell, true);

                        if (DataType.isValidObject(value) == true
                            && DataType.isNullOrEmpty(value.sFileName) == false
                            && DataType.isNullOrEmpty(value.sData) == false) {
                            FATTACHMENTCONTROL.setData(element, value.sFileName, "", value.sData, true, value.iDataSource);
                            bFlag = true;
                        }

                        if (bFlag == false) {
                            FATTACHMENTCONTROL.clear(element);
                        }
                    }
                    else if (FUIElement.hasClass(element, FHyperLink.getClassName()).Value == true) {
                        FHyperLink.setParent(element, this.cell);
                        FHyperLink.setValue(element, value);
                    }
                    else {
                        if (element.nodeName.toLowerCase() === "input") {
                            if (element.getAttribute("type").toLowerCase() === "text") {
                                if (DataType.isValidObject(value) == true) {
                                    element.value = value;
                                }
                                else {
                                    element.value = "";
                                }
                            }
                        }
                        else if (element.nodeName.toLowerCase() === "textarea") {
                            if (DataType.isValidObject(value) == true) {
                                element.value = value;
                            }
                            else {
                                element.value = "";
                            }
                        }
                        else if (element.nodeName.toLowerCase() === "select") {
                            if (DataType.isValidObject(value) == true) {
                                element.value = value;
                                if (value == "" && element.selectedIndex == -1 && element.options.length > 0 && data != true) {
                                    element.selectedIndex = 0;
                                }
                            }
                            else {
                                if (element.options.length > 0) {
                                    if (data != true) {
                                        element.selectedIndex = 0;
                                    }
                                    else {
                                        element.selectedIndex = -1;
                                    }
                                    //element.selectedIndex = 0;
                                }
                            }
                        }

                        this.cell.appendChild(element);
                        this.autoHeight(true);

                        FUIElement.setFocus(element.id);
                    }

                    return (sText);
                };
