                        messageInfoPopup.EmailPrintMethod = "VOUCHERPOSTING.EMAILMETHODS.openEMailPrintConfirmation('printPreOrder')";
                    }
                    else {
                        messageInfoPopup.Message[0] = msgDoyouwanttoprintBill;
                        messageInfoPopup.ButtonType = "PrintCancel";
                    }

