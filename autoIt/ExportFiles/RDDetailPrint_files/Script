    fillSortingData: function () {
        var source = null;
        var target = null;
        var element = null;
        var iCounter = 0;
        var obj = null;
        var bAscending = false;

        try {
            source = RD_ENTRY.CUSTOMIZATION.SORTING.getSortingSourceListElement();
            target = RD_ENTRY.CUSTOMIZATION.SORTING.getSortingTargetListElement();

            // Fill cube row grouping fields
            for (iCounter = 0; iCounter < RD_ENTRY.m_arrRowGrouping.length; iCounter++) {
                obj = RD_ENTRY.m_arrRowGrouping[iCounter];

                if (DataType.isValidObject(obj.ColumnOrder) == false) {
                    bAscending = true;
                }
                else {
                    bAscending = obj.ColumnOrder.IsAscending;
                }

                element = RD_ENTRY.CUSTOMIZATION.SORTING.createSortingElement(obj, 1, bAscending);
                if (DataType.isValidObject(obj.ColumnOrder) == false) {
                    source.appendChild(element);
                }
                else {
                    target.appendChild(element);
                }
            }

            // Fill cube column group by fields
            for (iCounter = 0; iCounter < RD_ENTRY.m_arrColumnGroupBy.length; iCounter++) {
                obj = RD_ENTRY.m_arrColumnGroupBy[iCounter];

                if (DataType.isValidObject(obj.ColumnOrder) == false) {
                    bAscending = true;
                }
                else {
                    bAscending = obj.ColumnOrder.IsAscending;
                }


                element = RD_ENTRY.CUSTOMIZATION.SORTING.createSortingElement(obj, 2, bAscending);
                if (DataType.isValidObject(obj.ColumnOrder) == false) {
                    source.appendChild(element);
                }
                else {
                    target.appendChild(element);
                }
            }

            // Fill cube column measure fields
            for (iCounter = 0; iCounter < RD_ENTRY.m_arrColumnMeasure.length; iCounter++) {
                obj = RD_ENTRY.m_arrColumnMeasure[iCounter];

                if (DataType.isValidObject(obj.Column.ColumnOrder) == false) {
                    bAscending = true;
                }
                else {
                    bAscending = obj.Column.ColumnOrder.IsAscending;
                }

                element = RD_ENTRY.CUSTOMIZATION.SORTING.createSortingElement(obj, 3, bAscending);
                if (DataType.isValidObject(obj.Column.ColumnOrder) == false) {
                    source.appendChild(element);
                }
                else {
                    target.appendChild(element);
                }
            }

            // Fill customize column fields
            for (iCounter = 0; iCounter < RD_ENTRY.m_arrCustomizeColumn.length; iCounter++) {
                obj = RD_ENTRY.m_arrCustomizeColumn[iCounter];
                if (obj.iFieldId == eRDFIELDID.PARTICULAR) {
                    continue;
                }

                if (DataType.isValidObject(obj.Column.ColumnOrder) == false) {
                    bAscending = true;
                }
                else {
                    bAscending = obj.Column.ColumnOrder.IsAscending;
                }

                element = RD_ENTRY.CUSTOMIZATION.SORTING.createSortingElement(obj, 0, bAscending);
                if (DataType.isValidObject(obj.Column.ColumnOrder) == false) {
                    source.appendChild(element);
                }
                else {
                    target.appendChild(element);
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.SORTING.fillSortingData} " + err.message, "Exception");
        }
    },

    getSelectedListElement: function (eleList) {
        var element = null;
        var iCounter = 0;

        try {
            for (iCounter = 0; iCounter < eleList.children.length; iCounter++) {
                if (RD_ENTRY.UI.hasClass(eleList.children[iCounter], "rd_selected") == true) {
                    element = eleList.children[iCounter];
                    break;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.SORTING.getSelectedListElement} " + err.message, "Exception");
        }

        return (element);
    },

    onMoveElement_Click: function (bSource) {
        var eleSelected = null;

        try {
            if (bSource == true) {
                eleSelected = RD_ENTRY.CUSTOMIZATION.SORTING.getSelectedListElement(RD_ENTRY.CUSTOMIZATION.SORTING.getSortingSourceListElement());
            }
            else {
                eleSelected = RD_ENTRY.CUSTOMIZATION.SORTING.getSelectedListElement(RD_ENTRY.CUSTOMIZATION.SORTING.getSortingTargetListElement());
