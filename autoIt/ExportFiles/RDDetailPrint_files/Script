    gotoNextCellLeave: function (gridElement, event, objLeaveData) {
        let iRow = 0;
        let iColumn = 0;
        let iRowFlag = 0;
        let bResult = false;
        let bRowChanged = false;
        let sInvalidCellHandler = "";
        let obj = null;

        try {
            iRow = FGRIDCONTROL.getCurrentRow(gridElement);
            iColumn = FGRIDCONTROL.getCurrentColumn(gridElement);
            bResult = FGRIDCONTROL.PRIVATE.onLeaveCell(gridElement, event, objLeaveData);

            iRowFlag = FGRIDCONTROL.getRowFlag(gridElement);
            if (iRowFlag != 0) {
                iRow = iRowFlag;
                FGRIDCONTROL.setRowFlag(gridElement, 0);
            }

            if(DataType.isObject(bResult) == true) {
                if(DataType.isValidObject(bResult.iColumn) == true) {
                    iColumn = bResult.iColumn;
                }

                if(DataType.isValidObject(bResult.iRow) == true) {
                    iRow = bResult.iRow;
                }

                if(DataType.isValidObject(bResult.bResult) == true) {
                    bResult = bResult.bResult;
                }
                else {
                    bResult = true;
                }
            }

            if (DataType.toBoolean(bResult) == true) {
                bRowChanged = false;
                iColumn++;
                if (FGRIDCONTROL.isValidColumnIndex(gridElement, iColumn) == false) {
                    iRow++;
                    iColumn = 1;
                    bRowChanged = true;
                }

                if (bRowChanged == true && FGRIDCONTROL.isValidRowIndex(gridElement, iRow - 1) == true) {
                    bRowChanged = FGRIDCONTROL.onRowChange(FGRIDCONTROL.PRIVATE.getChangeRowObject(gridElement, iRow - 1, iRow), event);
                    if (DataType.toBoolean(bRowChanged) == false) {
                        iRow--;
                        iColumn = FGRIDCONTROL.getTotalColumns(gridElement);
                    }
                    else {
                        if (FGRIDCONTROL.isValidRowIndex(gridElement, iRow) == false) {
                            sInvalidCellHandler = FGRIDCONTROL.getInvalidCellHandler(gridElement);
                            if (DataType.isNullOrEmpty(sInvalidCellHandler, true) == false) {
                                obj = {};
                                obj.iRow = iRow;
                                obj.iColumn = iColumn;
                                obj.bFirstRow = false;
                                obj.Grid = gridElement;

                                bResult = eval(sInvalidCellHandler)(obj, event);
                                if (DataType.toBoolean(bResult) == false) {
                                    obj = {};
                                    obj.iRow = -1;
                                    obj.iColumn = -1;
                                    obj.Grid = gridElement;
                                    obj.bResult = true;

                                    return (obj);
                                }
                            }
                        }
                    }
                }
            }

            obj = {};
            obj.iRow = iRow;
            obj.iColumn = iColumn;
            obj.gridElement = gridElement;
            obj.bResult = false;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.gotoNextCellLeave} " + err.message);
        }

        return (obj);
    },

