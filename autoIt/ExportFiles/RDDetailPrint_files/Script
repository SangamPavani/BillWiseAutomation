    getURL: function (actionName, controllerName, areaName) {
        let sURL = "";
        let protocol = "";
        let hostname = "";
        let pathname = "";

        try {
            protocol = document.location.protocol;
            hostname = document.location.host;
            pathname = document.location.pathname;

            if (pathname.indexOf("/", 1) < 0) {
                pathname = pathname + "/";
            }

            pathname = pathname.substring(0, pathname.indexOf("/", 1));

            if (DataType.isNullOrEmpty(areaName) == true) {
                sURL = protocol + "//" + hostname + pathname + "/" + controllerName + "/" + actionName;
            }
            else {
                sURL = protocol + "//" + hostname + pathname + "/" + areaName + "/" + controllerName + "/" + actionName;
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {NETWORK.getURL} " + err.message);
        }

        return (sURL);
    },

