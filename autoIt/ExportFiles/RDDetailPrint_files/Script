    SetDataTypeSource: function (iDataTypeId) {
        //debugger
        var lstDataType = [];
        var lstDataTypeOpts = [];
        if (iDataTypeId != MasterDataType.get('Text'))
            lstDataType.push('Text');
        lstDataType.push(DataType.typeToString(iDataTypeId));
        switch (iDataTypeId) {
            case eMasterDataType.Boolean:
                {
                    lstDataType.push('Number');
                    lstDataType.push('Fraction');
                    break;
                }
            case eMasterDataType.Number:
                {
                    lstDataType.push('Fraction');
                    lstDataType.push('BigNumber');
                    lstDataType.push('Date');
                    lstDataType.push('Time');
                    break;
                }
            case eMasterDataType.Fraction:
                {
                    lstDataType.push('Number');
                    lstDataType.push('BigNumber');
                    lstDataType.push('Boolean');
                    break;
                }
            case eMasterDataType.BigNumber:
                {
                    lstDataType.push('Number')
                    lstDataType.push('Fraction');
                    lstDataType.push('DateTime');
                    break;
                }
            case eMasterDataType.DateTime:
                {
                    lstDataType.push('Number');
                    lstDataType.push('BigNumber');
                    break;
                }
            case eMasterDataType.Time:
            case eMasterDataType.UpdatedTime:
            case eMasterDataType.Date:
                {
                    lstDataType.push('Number');
                    break;
                }
            case eMasterDataType.Text:
                {
                    lstDataType.push('Number');
                    lstDataType.push('BigNumber');
                    lstDataType.push('Fraction');
                    lstDataType.push('Date');
                    lstDataType.push('Time');
                    lstDataType.push('Boolean');
                    break;
                }
        }
        for (var i = 0; i < lstDataType.length; i++) {
            lstDataTypeOpts.push({ Id: MasterDataType.get(lstDataType[i]), Name: lstDataType[i] });
        }
        return lstDataTypeOpts;
    },

