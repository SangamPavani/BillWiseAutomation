        getNewId: function (eleChildrens, sPrefix) {
            var child = null;
            var iCounter = 0;
            var iLastIndex = 0;
            var iIndex = 0;
            var result = null;

            try {
                result = COMMON.prototype.getEmptyResultObject();

                for (iCounter = 0; iCounter < eleChildrens.length; iCounter++) {
                    child = eleChildrens[iCounter];
                    iIndex = parseInt(child.id.substr(sPrefix.length));
                    if (iIndex > iLastIndex) {
                        iLastIndex = iIndex;
                    }
                }

                if (iLastIndex <= 0) {
                    iLastIndex = 1;
                }
                else {
                    iLastIndex++;
                }

                result.lValue = 1;
                result.data = sPrefix + iLastIndex;
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = "{RD_ENTRY.DATA.getNewId} " + err.message;
            }

            return (result);
        },

        filterMastersFromTreeData: function (data, iLevel) {
            var result = null;
            var iCounter = 0;

            try {
                result = COMMON.prototype.getEmptyResultObject();
                result.data = [];

                for (iCounter = 0; iCounter < data.lValue; iCounter++) {
                    if (data.data[iCounter].iLevel == iLevel
                        && data.data[iCounter].iDataTypeId == eMasterDataType.Master
                        && data.data[iCounter].iMasterLink > 0) {
                        result.data.push(data.data[iCounter]);
                    }
                }

                result.lValue = result.data.length;
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = err.message;
            }

            return (result);
        },

