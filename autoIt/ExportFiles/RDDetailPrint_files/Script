    FIELDTREE: {
        getParentLevelIndex: function (arrTreeData, iIndex) {
            var iCounter = 0;
            var iLevel = 0;
            var iValue = -1;
            var obj = null;

            iLevel = arrTreeData[iIndex].iLevel;
            for (iCounter = iIndex - 1; iCounter >= 0; iCounter--) {
                obj = arrTreeData[iCounter];
                if (obj.iLevel < iLevel && obj.bGroup == true) {
                    iValue = iCounter;
                    break;
                }
            }

            return (iValue);
        },

        updateParentId: function (arrTreeData) {
            var iCounter = 0;
            var iIndex = 0;
            var obj = null;

            try {
                for (iCounter = 0; iCounter < arrTreeData.length; iCounter++) {
                    obj = arrTreeData[iCounter];
                    if (obj.iParentId > 0) {
                        obj.iSubParentId = obj.iParentId;
                        obj.iParentId = 0;
                        arrTreeData[iCounter] = obj;
                    }
                }

                for (iCounter = 0; iCounter < arrTreeData.length; iCounter++) {
                    obj = arrTreeData[iCounter];
                    if (obj.iLevel < 1) {
                        obj.iParentId = -1;
                        obj.iSubParentId = -1;
                        arrTreeData[iCounter] = obj;
                        continue;
                    }

                    if (obj.iSubParentId > 0) {
                        iIndex = RD_ENTRY.FIELDTREE.getParentLevelIndex(arrTreeData, iCounter);
                        if (iIndex >= 0) {
                            obj.iParentId = arrTreeData[iIndex].iSubParentId;
                            arrTreeData[iCounter] = obj;
                        }
                    }
                    else if (obj.iLevel == 1) {
                        obj.iSubParentId = 0;
                        //if (obj.bGroup == false && obj.iFieldId > 0) {
                        //    obj.iSubParentId = 0;
                        //}
                        //else {
                        //    obj.iSubParentId = -1;
                        //}

                        arrTreeData[iCounter] = obj;
                    }
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.FIELDTREE.updateParentId}" + err.message, "Exception");
            }
        },

