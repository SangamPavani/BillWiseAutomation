    getConfirmationMessage: function (_outputScreen) {
        var confirmMessage = "";
        if (FCommon.UI.isValidObject(_outputScreen)) {
            switch (_outputScreen) {
                case OUTPUT.Printer:
                    confirmMessage = "Do you want to export report to the Printer?";
                    break;
                case OUTPUT.Excel:
                    confirmMessage = "Do you want to export report to the Excel?";
                    break;
                case OUTPUT.PDF:
                    confirmMessage = "Do you want to export report to the PDF?";
                    break;
                case OUTPUT.CSV:
                    confirmMessage = "Do you want to export report to the CSV?";
                    break;
                case OUTPUT.File:
                    confirmMessage = "Do you want to export report to the File?";
                    break;
            }
            if (confirmMessage.length > 0) {
                var result = null;
                var elereportId = document.getElementById("getReportId_" + DashletId);//.value;          
                var reportId = elereportId.value;
                result = NETWORK.executeServerMethod(
                                GLOBAL.getContextPath("getLastExportedInfo", "CommonReport", "RD"),
                                 true,
                                 {
                                     iReportId: reportId,
                                     iReportOutput: _outputScreen
                                 },
                                 "json",
                                 false,
                                 "",
                                 "",
                                 "");
                if (result.data != null && result.data.length > 0) {
                    confirmMessage += "\r\n" + result.data;
                }
            }
        }
        return confirmMessage;
