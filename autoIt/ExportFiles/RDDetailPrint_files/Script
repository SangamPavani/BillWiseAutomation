    hasClass: function (ele, sClassName, bCheckAncestor) {
        let iCounter = 0;
        let arrClass = null;
        let bValue = false;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sClassName) == true) {
                return (false);
            }

            bCheckAncestor = OPTIONCONTROL_HELPER.toBoolean(bCheckAncestor);

            if (bCheckAncestor == true) {
                ele = OPTIONCONTROL_HELPER.getValidElement(ele);
                if (OPTIONCONTROL_HELPER.isValidObject(ele) == false) {
                    return (false);
                }

                while (ele.parentElement) {
                    if (OPTIONCONTROL_HELPER.hasClass(ele.parentElement, sClassName, false) == true) {
                        bValue = true;
                        break;
                    }

                    ele = ele.parentElement;
                }
            }
            else {
                if (ele.classList) {
                    bValue = ele.classList.contains(sClassName);
                }
                else {
                    arrClass = ele.className.split(' ');
                    for (iCounter = 0; iCounter < arrClass.length; iCounter++) {
                        if (arrClass[iCounter] === sClassName) {
                            bValue = true;
                            break;
                        }
                    }
                }
            }
