    LoadScreen: function (bSuccess, html, arrData) {
        let sAfterLoadFunction = "";
        let elePageContainer = null;
        let objHeaderInfo = null;

        if (bSuccess == false) {
            return;
        }

        elePageContainer = UIContainer.getDefaultContainer();
        if (elePageContainer != null) {
            $(elePageContainer).html(html);
            UIContainer.show(ePageContainerType.Default);

            if (elePageContainer.children.length > 0 && FUIElement.hasDataAttribute(elePageContainer.children[0], "data-afterload", true) == true) {
                sAfterLoadFunction = elePageContainer.children[0].getAttribute("data-afterload");
                if (FCommon.String.isNullOrEmpty(sAfterLoadFunction) == false) {
                    if (DataType.stringIncludes(sAfterLoadFunction, "(") == true) {
                        eval(sAfterLoadFunction);
                    }
                    else {
                        eval(sAfterLoadFunction)();
                    }
                }
            }

            if (document.getElementById("CancelCreateUser") != null) {
                document.getElementById("CancelCreateUser").style.pointerEvents = "auto";
            }

            try {
                if (FCommon.UI.isValidObject(arrData) == true) {
                    if (Array.isArray(arrData) == true) {
                        if (DataType.stringIncludes(arrData[0], "(") == true) {
                            eval(arrData[0]);
                        }
                        else {
                            eval(arrData[0])(arrData);
                        }
                    }
                    else if ((typeof arrData).toLowerCase() == "string") {
                        if (DataType.stringIncludes(arrData[0], "(") == true) {
                            eval(arrData);
                        }
                        else {
                            eval(arrData)();
                        }
                    }
                    else if ((typeof arrData).toLowerCase() == "object") {
                        if (FCommon.UI.isValidObject(arrData.TransData) == true) {
                            EntryMain.loadUnsavedVoucherData(arrData.TransData, arrData.sMessage);
                        }
                    }
                }
            }
            catch (err) {
            }
        }
    },

