                    iSourceIndex = result.data;
                    objSourceData = RD_ENTRY.m_arrCustomizeColumn[iSourceIndex];
                }
                else {
                    if (result.lValue < 0) {
                        alert(result.sValue);
                    }

                    console.log("{RD_ENTRY.CUSTOMIZATION.onDropReportColumnDragReportColumn} Source index not found.");
                    return;
                }

                result = RD_ENTRY.CUSTOMIZATION.getReportColumnIndex(sTargetId);
                if (result.lValue > 0) {
                    iTargetIndex = result.data;
                }
                else {
                    if (result.lValue < 0) {
                        alert(result.sValue);
                    }

                    console.log("{RD_ENTRY.CUSTOMIZATION.onDropReportColumnDragReportColumn} Target index not found.");

                    return;
                }

                //duplicate = $(element).clone(true);
                element = $(element).detach();

                if (iSourceIndex < iTargetIndex) {
                    $(element).insertAfter($("#" + sTargetId));
                }
                else {
                    $(element).insertBefore($("#" + sTargetId));
                }

                RD_ENTRY.m_arrCustomizeColumn.splice(iSourceIndex, 1);
                RD_ENTRY.m_arrCustomizeColumn.splice(iTargetIndex, 0, objSourceData);

            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.onDropReportColumnDragReportColumn}" + err.message, "Exception");
            }
        },

        isValidTransactionSet: function (objTransactionSet, bError) {
            var bResult = false;

            try {
                if (DataType.isValidObject(objTransactionSet) == false) {
                    if (DataType.isValidObject(bError) == false || bError === true) {
                        COMMON.prototype.showMessage("Transaction set cannot be null.", "Error");
                    }

                    return (false);
                }

                if (DataType.isValidObject(objTransactionSet.iDataSourceType) == false) {
                    if (DataType.isValidObject(bError) == false || bError === true) {
                        COMMON.prototype.showMessage("Invalid transaction set object. 'iDataSourceType' property not found.", "Error");
                    }

                    return (false);
                }

                if (objTransactionSet.iDataSourceType < eDataSourceType.Default || objTransactionSet.iDataSourceType > 3) {
                    if (DataType.isValidObject(bError) == false || bError === true) {
                        COMMON.prototype.showMessage("Invalid 'iDataSourceType' property value.", "Error");
                    }

                    return (false);
                }

                if (objTransactionSet.iDataSourceType == eDataSourceType.Default) {
                    if (DataType.isValidObject(objTransactionSet.arrTranSetIds) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. Either 'arrTranSetIds' property not found or its value is null.", "Error");
                        }

                        return (false);
                    }

                    if (DataType.isValidObject(objTransactionSet.arrVoucher) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. Either 'arrVoucher' property not found or its value is null.", "Error");
                        }

                        return (false);
                    }

                    if (DataType.isValidObject(objTransactionSet.arrBRS) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. Either 'arrBRS' property not found or its value is null.", "Error");
                        }

                        return (false);
                    }

                    if (DataType.isValidObject(objTransactionSet.arrDocumentOption) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. Either 'arrDocumentOption' property not found or its value is null.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.arrTranSetIds.length < 1) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'arrTranSetIds' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.arrVoucher.length < 1) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'arrVoucher' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.arrBRS.length < 1) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'arrBRS' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.arrDocumentOption.length < 1) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'arrDocumentOption' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.arrTranSetIds.length != objTransactionSet.arrVoucher.length
                        || objTransactionSet.arrTranSetIds.length != objTransactionSet.arrBRS.length
                        || objTransactionSet.arrTranSetIds.length != objTransactionSet.arrDocumentOption.length) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Mismatched data length.", "Error");
                        }

                        return (false);
                    }
                }
                else if (objTransactionSet.iDataSourceType == eDataSourceType.Query) {
                    if (DataType.isValidObject(objTransactionSet.sQuery) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. 'sQuery' property not found.", "Error");
                        }

                        return (false);
                    }

                    if (DataType.isValidObject(objTransactionSet.bQuery) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. 'bQuery' property not found.", "Error");
                        }

                        return (false);
                    }

                    if (FCommon.String.isNullOrEmpty(objTransactionSet.sQuery) == true) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'sQuery' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.bQuery === false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'bQuery' property cannot be false.", "Error");
                        }

                        return (false);
                    }
                }
                else if (objTransactionSet.iDataSourceType == eDataSourceType.View) {
                    if (DataType.isValidObject(objTransactionSet.sView) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. 'sView' property not found.", "Error");
                        }

                        return (false);
                    }

                    if (DataType.isValidObject(objTransactionSet.bQuery) == false) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("Invalid transaction set object. 'bQuery' property not found.", "Error");
                        }

                        return (false);
                    }

                    if (FCommon.String.isNullOrEmpty(objTransactionSet.sView) == true) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'sView' property cannot be empty.", "Error");
                        }

                        return (false);
                    }

                    if (objTransactionSet.bQuery === true) {
                        if (DataType.isValidObject(bError) == false || bError === true) {
                            COMMON.prototype.showMessage("'bQuery' property cannot be true.", "Error");
                        }

                        return (false);
                    }
                }

                bResult = true;
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.isValidTransactionSet} " + err.message, "Exception");
                bResult = false;
            }

            return (bResult);
        },

