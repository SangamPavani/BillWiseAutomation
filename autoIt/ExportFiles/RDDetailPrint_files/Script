                                            productIds = VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.filter((p) => p.Sales.Product);

                                        if (productIds != null && productIds != undefined && productIds.length > 0) {
                                            let ProdId = productIds[vStatus.BodyIds[i]];
                                            if (VOUCHERPOSTING.VARIABLES.ListOfItems != null && VOUCHERPOSTING.VARIABLES.ListOfItems != undefined && VOUCHERPOSTING.VARIABLES.ListOfItems.length > 0) {
                                                for (let PC = 0; PC < VOUCHERPOSTING.VARIABLES.ListOfItems.length; PC++) {
                                                    if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("PRODUCT") || VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("KIT")) {
                                                        if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue1 == ProdId) {
                                                            ProdName = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                    else if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("SET")) {
                                                        let setItem = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RetailSetsDetails.filter(p => p.DefaultValue1 == ProdId);
                                                        if (setItem != null && setItem != undefined) {
                                                            ProdName = setItem.DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VoucherErrorMsg = VoucherErrorMsg + ProdName;
                                }
                                VoucherErrorMsg = VoucherErrorMsg + msgsomeitems;
                            }
                        }
                    }

                    if (VoucherErrorMsg == null || VoucherErrorMsg == undefined || VoucherErrorMsg.length <= 0)
                        VoucherErrorMsg = "Exception while posting voucher. Please check the log for more details.";

                    toastr.error(VoucherErrorMsg, "POS Exception");
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.postPOSTransaction :: Catch Block :: Exception :: " + JSON.stringify(Ex));
        }
    },
    salesInvoiceVoucher: function () {
        try {
            let msgPaidAmtNetAmtMismatch = $("#msgPaidAmtNetAmtMismatch").val();
            let errWhileCalculatingMemberPointsCheckLogs = $("#errWhileCalculatingMemberPointsCheckLogs").val();
            let errWhileAssigningMemberPointsDetCheckLogs = $("#errWhileAssigningMemberPointsDetCheckLogs").val();
            // Checking 'Total Paid Amount' & 'Total Net Amount' if donot match stoping the transaction
            if (FConvert.toDecimal((VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalPaidAmt - VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalChangeAmount), POSCommon.numberOfDecimal) != FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.NetAmt, POSCommon.numberOfDecimal))
                return [false, msgPaidAmtNetAmtMismatch];

            // Getting MemberPoints when Member is present and will be saved in SaveBillSettlementDetails
            if (VOUCHERPOSTING.VARIABLES.MemberData != null && VOUCHERPOSTING.VARIABLES.MemberData != undefined &&
                VOUCHERPOSTING.VARIABLES.MemberData.ID > 0) {
                let memberPointCalculationResult = VOUCHERPOSTING.MEMBER.getCalculatedMemberPoint();
                if (memberPointCalculationResult == null || memberPointCalculationResult == undefined)
                    return [false, errWhileCalculatingMemberPointsCheckLogs];
            }

            let arrSalesInvoiceTransaction = VOUCHERPOSTING.salesInvoiceTransaction();
            let arrJournalVoucherTransaction = VOUCHERPOSTING.journalVoucherTransaction();
            let arrCreditNotesExchangeRefundCreditNote = VOUCHERPOSTING.postCreditNotesExchangeRefundCreditNoteAmount();

            let arrBillSettlementDetails = [];
            arrBillSettlementDetails[SaveVoucherIndex.TypeOfPosting] = 1;
            arrBillSettlementDetails[SaveVoucherIndex.Revert] = false;
            if (ApplicationNew.RetailTransFooter.IsTourist == true)
                VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.IsTourist = ApplicationNew.RetailTransFooter.IsTourist;

            arrBillSettlementDetails[SaveVoucherIndex.VoucherType] = (VOUCHERPOSTING.VARIABLES.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ? PreferenceSetting.PrefPostingTab.DeliveryNoteVoucher : PreferenceSetting.PrefPostingTab.POSVoucher);
            arrBillSettlementDetails[SaveVoucherIndex.SalesInvoiceTransaction] = arrSalesInvoiceTransaction;
            VOUCHERPOSTING.VARIABLES.PosSalesTransaction = arrSalesInvoiceTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.JournalVoucherTransaction] = arrJournalVoucherTransaction;
            arrBillSettlementDetails[SaveVoucherIndex.BillSettlementPaymentDetails] = VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails;
            arrBillSettlementDetails[SaveVoucherIndex.HeaderExtraFieldsData] = VOUCHERPOSTING.VARIABLES.HeaderExtraFieldsData;
            if (arrCreditNotesExchangeRefundCreditNote == null || arrCreditNotesExchangeRefundCreditNote == undefined || arrCreditNotesExchangeRefundCreditNote.length <= 0)
                arrBillSettlementDetails[SaveVoucherIndex.CreditNoteRefundTransaction] = null;
            else
                arrBillSettlementDetails[SaveVoucherIndex.CreditNoteRefundTransaction] = arrCreditNotesExchangeRefundCreditNote;

            let paymentRelatedExtraDetails = VOUCHERPOSTING.getPaymentRelatedExtraDetails();
            if (paymentRelatedExtraDetails != null && paymentRelatedExtraDetails != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.PaymentRelatedExtraField] = paymentRelatedExtraDetails;
            if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined) {
                if (ApplicationNew.TotalSchemesInfo.DVToSaveList != null && ApplicationNew.TotalSchemesInfo.DVToSaveList != undefined && ApplicationNew.TotalSchemesInfo.DVToSaveList.length > 0) {
                    for (let i = 0; i < ApplicationNew.TotalSchemesInfo.DVToSaveList.length; i++) {
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].LocationId = POSCommon.locationId;
                        ApplicationNew.TotalSchemesInfo.DVToSaveList[i].UserId = POSCommon.userId;
                    }
                    arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = ApplicationNew.TotalSchemesInfo.DVToSaveList;
                }
            }
            else
                arrBillSettlementDetails[SaveVoucherIndex.DiscountVoucherSaleDetails] = null;

            //BillSetmntDtls.GvCreditNotePoints = VOUCHERPOSTING.getPaymentRelatedExtraDetails();
            let transactionSchemesApplied = VOUCHERPOSTING.getTransSchemesApplied();
            if (transactionSchemesApplied != null && transactionSchemesApplied != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = transactionSchemesApplied;
            else
                arrBillSettlementDetails[SaveVoucherIndex.TransSchemesApplied] = null;

            if (ApplicationNew.HomeDelivery != null && ApplicationNew.HomeDelivery != undefined) {
                ApplicationNew.HomeDelivery.CreatedBy = POSCommon.userId;
                ApplicationNew.HomeDelivery.ModifiedBy = POSCommon.userId;
                ApplicationNew.HomeDelivery.LocationId = POSCommon.locationId;

                arrBillSettlementDetails[SaveVoucherIndex.HomeDeliveryDetails] = ApplicationNew.HomeDelivery;
            }

            if (ApplicationNew.MemberData != null && ApplicationNew.MemberData != undefined && ApplicationNew.MemberData.ID > 0 && ApplicationNew.MemberData.PointsAccumulateOnBill > 0) {
                let memberPointDetails = VOUCHERPOSTING.MEMBER.getMemberPointsDetails();
                if (memberPointDetails != null && memberPointDetails != undefined)
                    arrBillSettlementDetails[SaveVoucherIndex.MemberPointsDetails] = memberPointDetails;
                else if (memberPointDetails == null || memberPointDetails == undefined)
                    return [false, errWhileAssigningMemberPointsDetCheckLogs];
            }

            let memberLastTransactionDetails = VOUCHERPOSTING.MEMBER.fillMemberLastTransactionDetails(VOUCHERPOSTING.VARIABLES.MemberData);
            if (memberLastTransactionDetails != null && memberLastTransactionDetails != undefined)
                arrBillSettlementDetails[SaveVoucherIndex.MemberDetails] = memberLastTransactionDetails;
            else
                arrBillSettlementDetails[SaveVoucherIndex.MemberDetails] = null;

            //debugger;
            if (ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers != null && ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers != undefined && ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers.length > 0) {
                let arrEstimatedVoucherNumber = [];
                for (let i = 0; i < ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers.length; i++)
                    arrEstimatedVoucherNumber.push(ESTIMATIONBILL.VARIABLES.SelectedEstimatedBillVouchers[i].VoucherNumber);

                arrBillSettlementDetails[SaveVoucherIndex.LodedEstimatedVoucher] = arrEstimatedVoucherNumber;
            }
            else
                arrBillSettlementDetails[SaveVoucherIndex.LodedEstimatedVoucher] = null;

            VOUCHERPOSTING.BILLSETTLEMENT.saveBillSettlementDetails(arrBillSettlementDetails);

            let posTransaction = new Object();
            posTransaction.BillSettlementDetails = [];
            posTransaction.BillSettlementDetails = arrBillSettlementDetails;
            let SalesInvoiceTransactionHeader = arrSalesInvoiceTransaction[TransactionIndex.HEADER];
            posTransaction.HeaderExtra = SalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra];

            let rtnValuesBillSettlement = VOUCHERPOSTING.SERVER.saveAllDetailsAfterBillSettlement(posTransaction);
            return rtnValuesBillSettlement;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.salesInvoiceVoucher :: Catch Block :: Exception :: " + JSON.stringify(Ex));
        }
    },
    salesInvoiceTransaction: function () {
        try {
            ////debugger;
            let arrSalesInvoiceTransaction = [], arrSalesInvoiceTransactionHeader = [], arrSalesInvoiceTransactionBody = [];
            let exchangeRate = 1;
            let posVoucherExtraFields = VOUCHERPOSTING.SINGLTONVARIABLES.VoucherExtraFieldsInfo.filter((p) => p.VoucherType == PreferenceSetting.PrefPostingTab.POSVoucher);
            if (posVoucherExtraFields != null && posVoucherExtraFields != undefined && posVoucherExtraFields.length > 0)
                posVoucherExtraFields = posVoucherExtraFields[0];

            // Transaction Header
            arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType] = (ApplicationNew.PresentTransactionMode == TransactionModes.get("HOMEDELIVERY") ? PreferenceSetting.PrefPostingTab.DeliveryNoteVoucher : PreferenceSetting.PrefPostingTab.POSVoucher);

            if (ApplicationNew.PreviousTransaction == null || ApplicationNew.PreviousTransaction == undefined || (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined
                && (ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == null || ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction == undefined))) {
                VOUCHERPOSTING.TRANSACTION.fillTransactionHeaderDateAndTime(arrSalesInvoiceTransactionHeader);
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.EnteredBy] = POSCommon.userId;

                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.DocNo] = "";
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderId] = 0;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType] = PreferenceSetting.PrefPostingTab.POSVoucher;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.CreatedByUser] = POSCommon.userId;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsEditing] = false;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedBy] = POSCommon.userId;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedDate] = POSCommon.transactionDate;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedTime] = FTime.getCurrentTime();
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsSuspended] = false;

            }
            else {
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.DocNo] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.DocNo;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderId] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.HeaderId;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType] = PreferenceSetting.PrefPostingTab.POSVoucher;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.CreatedByUser] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.CreatedByUser;

                if (ApplicationNew.IsRecallTransaction == false)
                    arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.Date] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.Date;
                else
                    VOUCHERPOSTING.TRANSACTION.fillTransactionHeaderDateAndTime(arrSalesInvoiceTransactionHeader);

                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsEditing] = true;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedBy] = POSCommon.userId;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedDate] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.ModifiedDate;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.ModifiedTime] = ApplicationNew.PreviousTransaction.LoadedPosSalesTransaction.Header.ModifiedTime;
            }

            arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateInv] = true;
            arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = true;
            arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.NoBatchCheck] = true;

            if (ApplicationNew.IsRecallTransaction == true)
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.NoBatchCheck] = false;

            if (PreferenceSetting.PrefOutletTab.OutletGeneralTab.CheckNegStock == false)
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagCheckNegativeStock] = false;
            else
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagCheckNegativeStock] = true;

            // Hold Transaction
            if (ApplicationNew.IsHoldTransaction == true)
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsSuspended] = true;
            else
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsSuspended] = false;

            // Transaction Header Extra Fields
            let headerExtraField = VOUCHERPOSTING.HEADEREXTRAFIELD.addHeaderExtraFieldInSalesInvoiceTransaction([arrSalesInvoiceTransactionHeader]);
            if (headerExtraField != null && headerExtraField != undefined && headerExtraField.length > 0) {
                if (Boolean(headerExtraField[0]) == true) {
                    arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = headerExtraField[1];
                    arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.QRCodeHeaderExtra] = headerExtraField[2];
                }
                else {
                    arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = null;
                    arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.QRCodeHeaderExtra] = null;
                }
            }
            else if (headerExtraField == null || headerExtraField == undefined || headerExtraField.length <= 0) {
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.HeaderExtra] = null;
                arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.QRCodeHeaderExtra] = null;
            }
            ////debugger;
            arrSalesInvoiceTransaction[TransactionIndex.HEADER] = arrSalesInvoiceTransactionHeader;

            // Transaction Body
            let bodyColMap = VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields.filter((f) => f.ID > 0 && f.TemplateID > 0 && f.TypeID == 1);
            if (bodyColMap == null || bodyColMap == undefined || bodyColMap.length <= 0)
                bodyColMap = [];

            let bodyColMapERP = VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields.filter((f) => f.ID == 0 && f.TemplateID == 0 && f.TypeID == 1);
            if (bodyColMapERP != null && bodyColMapERP != undefined && bodyColMapERP.length > 0) {
                for (let i = 0; i < bodyColMapERP.length; i++)
                    bodyColMap.push(bodyColMapERP[i]);
            }
            let loadedPOSSaleBodyIds = [], loadedPOSSaleTransIds = [];
            if (ApplicationNew.PreviousTransaction != null && ApplicationNew.PreviousTransaction != undefined) {
                loadedPOSSaleBodyIds = ApplicationNew.PreviousTransaction.LoadedPOSSaleBodyIds;
                loadedPOSSaleTransIds = ApplicationNew.PreviousTransaction.LoadedPOSSaleTransIds;
            }

            arrSalesInvoiceTransactionBody = VOUCHERPOSTING.TRANSACTION.fillTransactionBody([arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType], loadedPOSSaleBodyIds, loadedPOSSaleTransIds, exchangeRate, bodyColMap]);
            // if (rtnValues?.Length > 0 && Boolean(rtnValues[0]) == true)
            arrSalesInvoiceTransaction[TransactionIndex.BODY] = arrSalesInvoiceTransactionBody;

            // Transaction Footer
            let rtnValues = VOUCHERPOSTING.TRANSACTION.fillTransactionFooter([arrSalesInvoiceTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType], VOUCHERPOSTING.SINGLTONVARIABLES.BodyAndFooterCustAndERPFields]);
            if (rtnValues != null && rtnValues != undefined && rtnValues.length > 0) {
                if (rtnValues[0] == true && rtnValues[1] != null && rtnValues[1] != undefined && rtnValues[1].length > 0)
                    arrSalesInvoiceTransaction[TransactionIndex.FOOTER] = rtnValues[1];
                else
                    arrSalesInvoiceTransaction[TransactionIndex.FOOTER] = null;
            }

            return arrSalesInvoiceTransaction;
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.salesInvoiceTransaction :: Catch Block :: Exception :: " + JSON.stringify(Ex));
            return null;
        }
    },
