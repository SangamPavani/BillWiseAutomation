            var result = null;
            var iCounter = 0;

            try {
                result = COMMON.prototype.getEmptyResultObject();
                result.lValue = 0;
                result.sValue = "";

                for (iCounter = 0; iCounter < RD_ENTRY.m_arrTreeData.length; iCounter++) {
                    if (RD_ENTRY.m_arrTreeData[iCounter].iFieldId == iFieldId) {
                        result.lValue = 1;

                        result.data = {};
                        result.data.object = RD_ENTRY.m_arrTreeData[iCounter];
                        result.data.parent = null;

                        for (iCounter = 0; iCounter < RD_ENTRY.m_arrTreeData.length; iCounter++) {
                            if (RD_ENTRY.m_arrTreeData[iCounter].iFieldId == iSubParentId) {
                                result.data.parent = RD_ENTRY.m_arrTreeData[iCounter];
                                break;
                            }
                        }
                        break;
                    }
                }
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = "{RD_ENTRY.DATA.getTreeDataDetail} " + err.message;
            }

            return (result);
        }

