    setFont: function (ele, objFont) {
        let clrRed = undefined;
        let clrGreen = undefined;
        let clrBlue = undefined;

        try {
            ele = FUIElement.getValidElement(ele);
            if (DataType.isValidObject(ele) == false) {
                return;
            }

            ele.style.fontFamily = objFont.FontFamily;
            ele.style.fontSize = objFont.FontSize + "px";

            if (objFont.FontWeight == 1) {
                ele.style.fontWeight = "bold";
            }

            if (objFont.OverLine == true) {
                ele.style.textDecoration = "overline";
            }

            if (objFont.StrikeThrough == true) {
                ele.style.textDecoration = "line-through";
            }

            if (objFont.BaseLine == true) {
                ele.style.textDecoration = "underline";
            }

            if (objFont.UnderLine == true) {
                ele.style.textDecoration = "underline; text-underline-position: under;";
            }

            switch (objFont.FontStyle) {
                case 1:
                    ele.style.fontStyle = "italic";
                    break;
                case 2:
                    ele.style.fontStyle = "oblique";
                    break;
                default:
                    ele.style.fontStyle = "normal";
                    break;
            }

            clrRed = ((objFont.Background & 0xff0000) >> 16);
            clrGreen = ((objFont.Background & 0xff00) >> 8);
            clrBlue = (objFont.Background & 0xff);

            if (ele.style.setProperty) {
                ele.style.setProperty("background-color", "rgb(" + clrRed + "," + clrGreen + "," + clrBlue + ")", "important")
            }
            else {
                ele.style.backgroundColor = "rgb(" + clrRed + "," + clrGreen + "," + clrBlue + ") !important";
            }

            clrRed = ((objFont.Foreground & 0xff0000) >> 16);
            clrGreen = ((objFont.Foreground & 0xff00) >> 8);
            clrBlue = (objFont.Foreground & 0xff);

            if (ele.style.setProperty) {
                ele.style.setProperty("color", "rgb(" + clrRed + "," + clrGreen + "," + clrBlue + ")", "important")
            }
            else {
                ele.style.color = "rgb(" + clrRed + "," + clrGreen + "," + clrBlue + ") !important";
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FUIElement.setFont} " + err.message, true);
        }
    },

    calculateFixedLeftPosition: function (ele) {
        let sPosition = "";
        let iValue = 0;
        let rect = null;
        let rectParent = null;
        let arrTemp = undefined;

        try {
            ele = FUIElement.getValidElement(ele);
            while (DataType.isValidObject(ele) == true) {
                rect = ele.getBoundingClientRect();

                ele = ele.parentElement;
                if (DataType.isValidObject(ele) == true) {
                    rectParent = ele.getBoundingClientRect();

                    sPosition = FUIElement.getStyleValue(ele, "position");
                    if (sPosition == "fixed") {
                        arrTemp = FUIElement.getStyleValue(ele, "margin-left").split("px");
                        if (DataType.arrayLength(arrTemp) == 2) {
                            iValue = DataType.add(iValue, arrTemp[0]);
                            iValue = Number.parseFloat(iValue);
                        }

                        break;
                    }

                    iValue += (rect.left - rectParent.left);
                }
                else {
                    iValue += rect.left;
                    break;
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FUIElement.calculateFixedLeftPosition} " + err.message, true);
        }

        return (iValue);
    },

