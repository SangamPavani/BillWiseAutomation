        this.delay = function (ms) {
            let dtCurrent = null;
            let dtTemp = null;
            let cur_ticks = 0;
            let ms_passed = 0;
            let ticks = 0;

            try {
                dtCurrent = new Date();
                cur_ticks = dtCurrent.getTime();
                ms_passed = 0;

                while (ms_passed < ms) {
                    dtTemp = new Date();
                    ticks = dtTemp.getTime();
                    ms_passed = ticks - cur_ticks;
                    dtTemp = null;
                }

                dtCurrent = null;
            }
            catch (err) { }
