            if (OPTIONCONTROL_HELPER.isValidObject(value) == true) {
                element.setAttribute(DataType.stringGetValidDataAttribute(key), value);
            }
            else {
                if (OPTIONCONTROL_HELPER.isValidObject(key) == true && Array.isArray(key) == true) {
                    OPTIONCONTROL_HELPER.createAttributesFromArray(element, key);
