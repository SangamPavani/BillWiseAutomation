        unselectSelectedRowsInDiv: function (sParentId, bButton, event) {
            var iCounter = 0;
            var result = null;

            try {

                result = RD_ENTRY.CUSTOMIZATION.getSelectedRowsInDiv(sParentId);
                if (result.lValue < 1) {
                    if (result.lValue < 0) {
                        COMMON.prototype.showMessage(result.sValue, "Exception");
                    }
                    else if (FCommon.String.isNullOrEmpty(result.sValue) == false) {
                        COMMON.prototype.showMessage(result.sValue, "Error");
                    }

                    return;
                }

                for (iCounter = 0; iCounter < result.lValue; iCounter++) {
                    RD_ENTRY.CUSTOMIZATION.unselectDivRow(result.data[iCounter], bButton);
                }

                if (DataType.isValidObject(event) == true) {
                    event.stopImmediatePropagation();
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.unselectSelectedRowsInDiv}" + err.message, "Exception");
                return (false);
            }

            return (true);
        },

        selectRowInDiv: function (sParentId, clickedElement, bButton, event) {
            var result = null;

            try {

                if (FCommon.String.isNullOrEmpty(sParentId) == true) {
                    COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.selectRowInDiv} Parent id is mandatory.", "Error");
                    return (false);
                }

                result = RD_ENTRY.CUSTOMIZATION.getSelectedRowsInDiv(sParentId);
                if (result.lValue < 1 && FCommon.String.isNullOrEmpty(result.sValue) == false) {
                    if (result.lValue < 0) {
                        COMMON.prototype.showMessage(result.sValue, "Exception");
                    }
                    else {
                        COMMON.prototype.showMessage(result.sValue, "Error");
                    }

                    return;
                }

                if (result.lValue == 1 && result.data[0] == clickedElement) {
                    RD_ENTRY.CUSTOMIZATION.unselectDivRow(clickedElement, bButton);

                    return;
                }

                // Unselect selected one
                RD_ENTRY.CUSTOMIZATION.unselectSelectedRowsInDiv(sParentId, bButton, event);

                if (DataType.isValidObject(event) == true) {
                    event.stopImmediatePropagation();
                }

                // Select
                RD_ENTRY.CUSTOMIZATION.selectDivRow(clickedElement, bButton);
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.selectRowInDiv}" + err.message, "Exception");
                return (false);
            }

            return (true);
        },

