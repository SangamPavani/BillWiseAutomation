        onMouseDown: function (eleTh, sGridId, evt) {
            let sId = "";

            try {
                sId = FGRIDCONTROL.RESIZE.getCurrentColumnVariableName(sGridId);
                window[sId] = eleTh;

                sId = FGRIDCONTROL.RESIZE.getStartOffsetVariableName(sGridId);
                window[sId] = evt.clientX;
            }
