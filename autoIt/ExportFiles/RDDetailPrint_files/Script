    toInt: function (value, bFlag, NumericSeparator) {
        let sType = undefined;
        let bScientific = false;

        sType = (typeof value).toLowerCase();
        if (sType == "undefined" || value == null) {
            return (0);
        }

        if (DataType.isScientificNotation(value) == true) {
            value = FNumberOperation.toFixed(value);

            bScientific = true;
        }

        if (bScientific == false && sType == "string") {
            if (DataType.isValidObject(NumericSeparator) == false) {
                NumericSeparator = 44; // Comma value
            }
            else {
                NumericSeparator = DataType.toString(NumericSeparator);
                if (NumericSeparator.length > 1) {
                    NumericSeparator = 0;
                }
                else {
                    NumericSeparator = NumericSeparator.charCodeAt(0);
                }
            }

            value = DataType.stringGetNumber(value, NumericSeparator, true);
            if(value == "") {
                value = 0;
            }

            if (bFlag === true) {
                if (value != "") {
                    return (value);
                }

                return (0);
            }
        }

        value = parseInt(value);
        if (isNaN(value) == true) {
            return (0);
        }

        return (value);
    },

    toInt64: function (value, NumericSeparator) {
        let bScientific = false;

        if (DataType.isValidObject(value) == false) {
            return (0);
        }

        if (DataType.isScientificNotation(value) == true) {
            value = FNumberOperation.toFixed(value);

            bScientific = true;
        }
        else if ((typeof value).toLowerCase() == "number") {
            value = DataType.toString(value);
        }

        if (bScientific == false && (typeof value).toLowerCase() == "string") {
            if (DataType.isValidObject(NumericSeparator) == false) {
                NumericSeparator = 44; // Comma value
            }
            else {
                NumericSeparator = DataType.toString(NumericSeparator);
                if (NumericSeparator.length > 1) {
                    NumericSeparator = 0;
                }
                else {
                    NumericSeparator = NumericSeparator.charCodeAt(0);
                }
            }

            value = DataType.stringGetNumber(value, NumericSeparator, true);
            if (value == "") {
                value = 0;
            }
            else {
                while (value.length > 0) {
                    if (DataType.stringStartsWith(value, "0") == true) {
                        value = value.substr(1);
                    }
                    else {
                        break;
                    }
                }

                if (value == "") {
                    value = 0;
                }
            }
        }
        else if (bScientific == false) {
            value = 0;
        }

        if (value == "") {
            value = 0;
        }

        if (bScientific == false
            && (typeof value).toLowerCase() == "string"
            && DataType.lte(value, Number.MAX_SAFE_INTEGER) == true) {
            value = Number(value);
        }

        return (value);
    },

    toBoolean: function (value) {
        let sType = undefined;

        sType = (typeof value).toLowerCase();
        if (sType == "undefined" || value == null) {
            return (false);
        }

        if (sType == "string") {
            if (value.length <= 0) {
                return (false);
            }

            if (value == "1" || value.toLowerCase().trim() == "true") {
                return (true);
            }
        }
        else if (sType == "boolean") {
            return (eval(value));
        }
        else if (sType == "number") {
            if (DataType.toInt(value) > 0) {
                return (true);
            }
        }

        return (false);
    },

