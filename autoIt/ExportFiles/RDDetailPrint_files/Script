            obj.DecimalPoint = obj.Number.indexOf('.');
            if (obj.DecimalPoint >= 0) {
                obj.ScaleValue = obj.Number.substr(obj.DecimalPoint + 1);
                obj.Scale = obj.ScaleValue.length;

                obj.Precision = obj.DecimalPoint + obj.Scale;
                if (bSign == true) {
                    obj.Precision--;
                }

                if (obj.DecimalPoint > 0) {
                    obj.IntegerValue = obj.Number.substr(0, obj.DecimalPoint);
                    if (bSign == true) {
