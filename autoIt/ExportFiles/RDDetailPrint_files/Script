        getNewElementId: function (ExistingElements, sPrefix) {
            var sId = "";
            var iMaxId = 0;
            var iValue = 0;
            var iCounter = 0;

            try {
                if (DataType.isValidObject(sPrefix) == false || FCommon.String.isNullOrEmpty(sPrefix) == true) {
                    return ("");
                }

                for (iCounter = 0; iCounter < ExistingElements.length; iCounter++) {
                    sId = ExistingElements[iCounter].id;
                    iValue = parseInt(sId.substr(sPrefix.length));
                    if (iValue > iMaxId) {
                        iMaxId = iValue;
                    }
                }

                iValue++;
                sId = sPrefix + iValue;
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.getNewElementId}" + err.message, "Exception");
                sId = "";
            }

            return (sId);
