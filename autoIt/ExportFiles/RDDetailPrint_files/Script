    setParent: function (ctrl, newParent, bFocus) {
        let bResult = false;
        let child = null;

        try {
            ctrl = FUIElement.getValidElement(ctrl);
            if (DataType.isValidObject(ctrl) == false) {
                FUIElement.showAlert("Error: {FATTACHMENTCONTROL.setParent} Control id cannot be blank");
                return (false);
            }

            if (DataType.isValidObject(newParent) == false) {
                FUIElement.showAlert("Error: {FATTACHMENTCONTROL.setParent} New parent object required");
                return (false);
            }

            newParent = FUIElement.getValidElement(newParent)
            if (DataType.isValidObject(newParent) == false) {
                FUIElement.showAlert("Error: {FATTACHMENTCONTROL.setParent} New parent id cannot be blank");
                return (false);
            }

            child = document.getElementById(ctrl.id + "_container");
            if (DataType.isValidObject(child) == true) {
                newParent.appendChild(child);
            }

            bFocus = DataType.toBoolean(bFocus);
            if (ctrl.getBoundingClientRect().left != 0 && bFocus == true) {
                ctrl.focus();
            }

            bResult = true;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FATTACHMENTCONTROL.setParent} " + newParent.id + ", " + err.message);
            bResult = false;
        }

        return (bResult);
    }
