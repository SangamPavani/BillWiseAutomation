        execute: function (lastResult) {
            let obj = null;
            let OnEvent = null;
            let objInput = null;

            try {
                if (this.getEventCount() > 0) {
                    obj = this.getEventObject(0);

                    if (DataType.isNullOrEmpty(this.m_ModuleFunctionName, true) == false) {
                        objInput = {};
                        objInput.ModuleName = obj.ExternalModule.ModuleName;
                        objInput.FunctionName = obj.ExternalModule.FunctionName;
                        objInput.ModuleType = obj.ExternalModule.ModuleType;
                        objInput.Row = 0;
                        objInput.Column = 0;

                        if(DataType.isValidObject(lastResult) == true) {
                            objInput.LastResult = lastResult;
                        }

                        if (DataType.isValidObject(obj.CustomData) == true) {
                            OnEvent = obj.CustomData.OnEvent;

                            switch (obj.CustomData.OnEvent) {
                                case eVoucherExternalModuleEvents.BeforeSave:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
                                    }
                                    break;
                                case eVoucherExternalModuleEvents.AfterSave:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
                                    }
                                    break;
                                case eVoucherExternalModuleEvents.BeforeDelete:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
                                    }
                                    break;
                                case eVoucherExternalModuleEvents.AfterDelete:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
                                    }
                                    break
                                case eVoucherExternalModuleEvents.BeforePrint:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
                                    }
                                    break;
                                case eVoucherExternalModuleEvents.OnAuthorize:
                                    if (DataType.isValidObject(obj.CustomData.Data) == true) {
                                        objInput.Data = DataType.createDuplicateObject(obj.CustomData.Data);
