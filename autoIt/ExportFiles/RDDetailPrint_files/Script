    Assending: function (rows, val) {
        ////debugger;
        var i = 1, count = 0;
        try {
            for (; i < (rows.length - 2) ; i++) {
                if (rows[i + 1].getElementsByTagName('td')[1].innerHTML == "")
                    continue;
                var x = rows[i].getElementsByTagName('td')[val];
                var y = rows[i + 1].getElementsByTagName('td')[val];
                switch (val) {
                    case 1:
                        if (x.innerHTML.toUpperCase() > y.innerHTML.toUpperCase()) {
                            rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                            i = 0;
                        }
                        break;
                    case 2:
                        if (parseInt(x.innerHTML) > parseInt(y.innerHTML)) {
                            rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                            i = 0;
                        }
                        break;
                }
            }
        } catch (e) {
            COMMON.prototype.showMessage(e.message, "EXCEPTION");
        }
