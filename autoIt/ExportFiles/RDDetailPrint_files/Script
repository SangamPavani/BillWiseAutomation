                        var iDay = DATE.prototype.getDayFromFocusDate(parseInt(accDate));
                        var iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(accDate));
                        var iYear = DATE.prototype.getYearFromFocusDate(parseInt(accDate));
                        // var cYear = iYear - 1;
                        if (today.getFullYear() - iYear >= 2) {
                            iYear = today.getFullYear() - 2;
                            lastfinstartdate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                        } else {
                            iYear = today.getFullYear() - 1;
                            lastfinstartdate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear);
                        }
                        //var lastfinstartdate = DATE.prototype.convertIntoFocusDate(iDay, iMonth, cYear);
