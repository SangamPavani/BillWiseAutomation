    // Deletes cube row grouping column from tree(div)
    deleteDataFromTree: function (ele) {
        var iCounter = 0;
        var result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            for (iCounter = 0; iCounter < RD_ENTRY.m_arrRowGrouping.length; iCounter++) {
                if (RD_ENTRY.m_arrRowGrouping[iCounter].element == ele
                    && RD_ENTRY.m_arrRowGrouping[iCounter].element.id == ele.id) {
                    RD_ENTRY.m_arrRowGrouping.splice(iCounter, 1);
                    ele.parentNode.removeChild(ele);
                    result.lValue = 1;
                    result.data = iCounter;
                    break;
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.deleteDataFromTree}" + err.message;
            result.data = null;
        }

        return (result);
    },

    onRemove_Click: function (ele, evt) {
        var sValue = "";
        var iCounter = 0;
        var result = null;

        try {
            evt.stopImmediatePropagation();

            result = RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.deleteDataFromTree(ele.parentElement);

            if (result.lValue < 1) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.onRemove_Click} Cannot delete cube column 'Row Grouping'.", "Error");
            }
            else {
                for (iCounter = result.data; iCounter < RD_ENTRY.m_arrRowGrouping.length; iCounter++) {
                    sValue = FUIElement.getElementText(RD_ENTRY.m_arrRowGrouping[iCounter].element.children[0]);
                    sValue = sValue.substr(2); // 2 spaces are added for showing hierarchy. So removing first 2 character.
                    FUIElement.setElementText(RD_ENTRY.m_arrRowGrouping[iCounter].element.children[0], sValue);
                }
            }

            if (RD_ENTRY.m_arrRowGrouping.length == 0) {
                result = RD_ENTRY.CUSTOMIZATION.isReportColumnExist(eRDFIELDID.PARTICULAR);
                if (result.lValue > 0) {
                    RD_ENTRY.CUSTOMIZATION.deleteReportColumn(RD_ENTRY.m_arrCustomizeColumn[result.data].element);
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.onRemove_Click}" + err.message, "Exception");
        }
    }
};

