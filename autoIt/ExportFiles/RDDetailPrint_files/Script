    getParent: function (id) {
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";

            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == false) {
                result.lValue = 0;
                result.sValue = "{FTIMECONTROL.getParent} Control id cannot be blank.";

                return (result);
            }

            result.data = id.parentElement;
            if (DataType.isValidObject(result.data) == false) {
                result.lValue = 0;
                result.sValue = "{FTIMECONTROL.getParent} Parent not found.";

                return (result);
            }

            result.lValue = 1;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{FTIMECONTROL.getParent} " + err.message;
            bResult = false;
        }

        return (result);
