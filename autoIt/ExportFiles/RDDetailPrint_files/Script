    setPrTableDebitCreditSum: function (eleType) {
        var debitSumEle = null;
        var creditSumEle = null;
        var creditSum = 0;
        var debitSum = 0;
        var manualPrEntryTable = document.getElementById("id_report_provisionalentries_grid");
        var rowslength = FGRIDCONTROL.getTotalRows(manualPrEntryTable);
        var currentRow = null;
        var currentcell = null;
        var i = 1;
        try {
            debitSumEle = document.getElementById("txtmanualdebit_sum");
            creditSumEle = document.getElementById("txtmanualcredit_sum");
            if (eleType == 0) { //for debit column 
                for (i = 1; i < rowslength ; i++) {
                    currentcell = FGRIDCONTROL.getCellObject(manualPrEntryTable, i, 3);
                    currentcellvalue = currentcell.getCellText();
                    if (currentcell.cell != undefined && currentcellvalue.trim()) {
                        debitSum = debitSum + parseFloat(currentcell.getCellText());
                    }
                }
                debitSumEle.setAttribute("disabled", "false");
                if (debitSum == 0) {
                    $(debitSumEle).html(0);
                }
                else {
                    $(debitSumEle).html(debitSum);
                }
            }
            if (eleType == 1) { //for credit column
                for (i = 1; i < rowslength ; i++) {
                    currentcell = FGRIDCONTROL.getCellObject(manualPrEntryTable, i, 4);
                    currentcellvalue = currentcell.getCellText();
                    if (currentcell.cell != undefined && currentcellvalue.trim()) {
                        creditSum = creditSum + parseFloat(currentcell.getCellText());
