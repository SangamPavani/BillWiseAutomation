                FUIElement.showAlert("Exception: {FGRIDCONTROL.RESIZE.onMouseDown} " + err.message);
            }
        },

        onMouseMove: function (sGridId, evt) {
            let sId = "";
            let arrWidth = null;
            let iOldWidth = 0;
            let iNewWidth = 0;
            let iResizeColumn = 0;
            let eleTh = null;

            try {
                sId = FGRIDCONTROL.RESIZE.getCurrentColumnVariableName(sGridId);
                eleTh = window[sId];
                if (DataType.isValidObject(eleTh) == true) {
                    FUIElement.stopKeyProcess(evt);

                    iResizeColumn = FUIElement.getPosition(eleTh.parentElement) - 1;

                    arrWidth = eleTh.parentElement.style.minWidth.split("px");
                    iOldWidth = DataType.toInt(arrWidth[0]);

                    sId = FGRIDCONTROL.RESIZE.getStartOffsetVariableName(sGridId);
                    iNewWidth = iOldWidth + (evt.clientX - DataType.toInt(window[sId]));
                    if (iNewWidth < 30) {
                        return;
                    }

                    eleTh.parentElement.style.minWidth = iNewWidth + "px";
                    eleTh.parentElement.style.maxWidth = eleTh.style.minWidth;
                    window[sId] = evt.clientX;

                    if (iResizeColumn < 1 || iResizeColumn > FGRIDCONTROL.getTotalColumns(sGridId)) {
                        return;
                    }

                    FGRIDCONTROL.update(sGridId);
                    FGRIDCONTROL.changeColumnWidth(sGridId, iResizeColumn, iNewWidth);
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.RESIZE.onMouseMove} " + err.message);
            }
        },

