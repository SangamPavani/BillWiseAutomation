var RESIZE_REPORT = {
    getHeaderColumnWidth: function () {
        var iCounter = 0;
        var iCount = 0;
        var iIndex = 0;
        var iStartColNo = 0;
        var iEndColNo = 0;
        var eleTr1 = null;
        var eleTr2 = null;
        var eleTdGroup = null;
        var eleTd = null;
        var rect = null;
        var arrWidth = [];

        try {
            eleTr1 = document.getElementById("tblHeaderReportRender");
            eleTr2 = eleTr1.nextElementSibling;

            for (iCounter = 0; iCounter < eleTr1.children.length; iCounter++) {
                eleTd = eleTr1.children[iCounter];
                if (FCommon.String.isNullOrEmpty(eleTd.getAttribute("data-sgroupname")) == true) { // No Group
                    rect = eleTd.getBoundingClientRect();
                    arrWidth.push({ Element: eleTd, Width: rect.width });

                    iStartColNo = -1;
                    iEndColNo = -1;
                }
                else { // Group
                    eleTdGroup = eleTd;
                    iStartColNo = FConvert.toInt(eleTdGroup.getAttribute("data-icolnumber"));

                    iEndColNo = -1;
                    if (FCommon.UI.isValidObject(eleTdGroup.nextElementSibling) == true) {
                        iEndColNo = FConvert.toInt(eleTdGroup.nextElementSibling.getAttribute("data-icolnumber"));
                    }

                    if (iEndColNo > -1) {
                        iCount = iEndColNo - iStartColNo;
                        while (iCount > 0) {
                            eleTd = eleTr2.children[iIndex];

                            rect = eleTd.getBoundingClientRect();
                            arrWidth.push({ Group: eleTdGroup, Element: eleTd, Width: rect.width, ColNo: iStartColNo });

                            iCount--;
                            iIndex++;
                        }
                    }
                    else {
                        for (; iIndex < eleTr2.children.length; iIndex++) {
                            eleTd = eleTr2.children[iIndex];

                            rect = eleTd.getBoundingClientRect();
                            arrWidth.push({ Group: eleTdGroup, Element: eleTd, Width: rect.width, ColNo: iStartColNo });
                        }
                    }

                }
            }
        }
        catch (err) {
            alert("Exception: {RESIZE_REPORT.getHeaderColumnWidth} " + err.message);
        }

        return (arrWidth);
    },

    getBodyColumnWidth: function () {
        var iCounter = 0;
        var eleBody = null;
        var eleTr = null;
        var rect = null;
        var arrWidth = [];

        try {
            eleBody = RESIZE_REPORT.getDataBodyElement();
            if (FCommon.UI.isValidObject(eleBody) == false) {
                return ([]);
            }

            eleTr = eleBody.children[0];
            if (FCommon.UI.isValidObject(eleTr) == false) {
                return ([]);
            }


            for (iCounter = 0; iCounter < eleTr.children.length; iCounter++) {
                rect = eleTr.children[iCounter].getBoundingClientRect();
                arrWidth.push({ Width: rect.width, ColNo: -1 });
            }
        }
        catch (err) {
            alert("Exception: {RESIZE_REPORT.getBodyColumnWidth} " + err.message);
        }

        return (arrWidth);
    },

    getRequiredWidth: function () {
        var obj = null;

        try {
            obj = {};
            obj.arrHeadingWidth = [];
            obj.arrBodyWidth = [];

            obj.arrHeadingWidth = RESIZE_REPORT.getHeaderColumnWidth();
            obj.arrBodyWidth = RESIZE_REPORT.getBodyColumnWidth();

        }
        catch (err) {
            alert("Exception: {RESIZE_REPORT.getRequiredWidth} " + err.message);
        }

        return (obj);
    },

    resizeReportColumns: function (obj) {
        var iCounter = 0;
        var iFlag = 0;
        var iRow = 0;
        var iIndex = -1;
        var arrHeadingWidth = null;
        var arrBodyWidth = null;
        var eleBody = null;
        var bResizeAll = false;
        var objWidth = null;
        var arrColGroup = [];
        try {
            if (FCommon.UI.isValidObject(obj) == false) {
                obj = RESIZE_REPORT.getRequiredWidth();
                bResizeAll = false;
            }
            else {
                bResizeAll = true;
            }

            if (obj.arrHeadingWidth.length != obj.arrBodyWidth.length) {
                return;
            }

            for (iCounter = 0; iCounter < obj.arrHeadingWidth.length; iCounter++) {
                iFlag = 0;
                if (obj.arrHeadingWidth[iCounter].Width > obj.arrBodyWidth[iCounter].Width) { // Resize body
                    objWidth = obj.arrHeadingWidth[iCounter];
                    iFlag = 1;
                }
                else if (obj.arrHeadingWidth[iCounter].Width < obj.arrBodyWidth[iCounter].Width) { // Resize Heading
                    objWidth = obj.arrBodyWidth[iCounter];
                    iFlag = 2;
                }
                else {
                    objWidth = obj.arrHeadingWidth[iCounter];
                }


                if (bResizeAll == true) {
                    if (objWidth.ColNo > -1) {
                        for (iIndex = 0; iIndex < arrColGroup.length; iIndex++) {
                            if (arrColGroup[iIndex].ColNo == objWidth.ColNo) {
                                arrColGroup[iIndex].Width += objWidth.Width;
                                break;
                            }
                        }

                        if (iIndex >= arrColGroup.length) {
                            arrColGroup.push({ ColNo: objWidth.ColNo, Width: objWidth.Width, Group: objWidth.Group });
                        }
                    }

                    if (iFlag == 1) { // Heading Bigger
                        obj.arrHeadingWidth[iCounter].Element.style.width = objWidth.Width + "px";
                        RESIZE_REPORT.resizeDataColumn(iCounter, objWidth.Width);
                    }
                    else if (iFlag == 2) { // Body Bigger
                        obj.arrHeadingWidth[iCounter].Element.style.width = objWidth.Width + "px";
                        RESIZE_REPORT.resizeDataColumn(iCounter, objWidth.Width);
                    }
                }
                else {
                    if (iFlag == 1) { // Resize body
                        RESIZE_REPORT.resizeDataColumn(iCounter, objWidth.Width);
                    }
                    else if (iFlag == 2) { // Resize heading
                        obj.arrHeadingWidth[iCounter].Element.style.width = objWidth.Width + "px";
                    }
                }
            }

            for (iCounter = 0; iCounter < arrColGroup.length; iCounter++) {
                arrColGroup[iCounter].Group.style.width = arrColGroup[iCounter].Width + "px";
            }
        }
        catch (err) {
            alert("Exception: {RESIZE_REPORT.resizeReportColumns} " + err.message);
        }
    },

    resizeDataColumn: function (iColumn, iWidth) {
        var iRow = 0;
        var eleBody = null;

        try {
            eleBody = RESIZE_REPORT.getDataBodyElement();
            if (FCommon.UI.isValidObject(eleBody) == false) {
                return;
            }

            for (iRow = 0; iRow < eleBody.children.length; iRow++) {
                eleBody.children[iRow].children[iColumn].style.width = iWidth + "px";
            }
        }
        catch (err) {
            alert("Exception: {RESIZE_REPORT.resizeDataColumn} " + err.message);
        }
    },

    getDataBodyElement: function () {
        var ele = null;

        ele = document.getElementById("tblBodyReportRender");

        return (ele);
    }
};

