            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.VoucherType] = PreferenceSetting.PrefPostingTab.PreOrderVoucher;
            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateInv] = false;
            arrPreOrderVoucherTransactionHeader[SalesInvoiceTransactionHeaderIndex.FlagsUpdateFA] = true;
