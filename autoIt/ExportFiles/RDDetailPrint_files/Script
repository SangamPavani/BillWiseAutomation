                                let transactionPaymentRecordBodyExtra = transactionPaymentRecord[JournalVoucherTransactionBodyIndex.BodyExtra];
                                if (transactionPaymentRecordBodyExtra != null && transactionPaymentRecordBodyExtra != undefined && transactionPaymentRecordBodyExtra.length > 0) {

                                    for (let j = 0; j < transactionPaymentRecordBodyExtra.length; j++) {
                                        if (transactionPaymentRecordBodyExtra[j].Name == PosBodyExtraFieldNames.iPaymentType && transactionPaymentRecordBodyExtra[j].Tag == paymentType) {
