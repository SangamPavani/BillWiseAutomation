    IsCapsLockOn: function (evt) {
        var kc = evt.keyCode ? evt.keyCode : evt.which;
        var sk = evt.shiftKey ? evt.shiftKey : ((kc == 16) ? true : false);
        if (((kc >= 65 && kc <= 90) && !sk) || ((kc >= 97 && kc <= 122) && sk))
            document.getElementById('msgCapsLockState').style.display = 'block';
        else
            document.getElementById('msgCapsLockState').style.display = 'none';
    },

    HideErrorMessage: function (evt) {

        if (evt != null && evt != undefined) {
            var kc = evt.keyCode ? evt.keyCode : evt.which;

            if (kc == 20) {
                if ((evt.getModifierState && evt.getModifierState('CapsLock')) == true)
                    document.getElementById('msgCapsLockState').style.display = 'block';
                else
                    document.getElementById('msgCapsLockState').style.display = 'none';
            }
        }
        if (kc != 13) {
            $("#errmsgDiv").html("");
        }
    },

