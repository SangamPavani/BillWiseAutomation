        getSelectedTransactionSetData: function () {
            //debugger
            var sTabId = "";
            var iTotalTranSet = 0;
            var iCounter = 0;
            var value = null;
            var voucher = null;
            var iDocumentOption = 0;
            var sQuery = "";
            var sView = "";
            var bResult = false;
            var result = null;
            var selected = null;
            var eleTemp = null;

            try {
                result = COMMON.prototype.getEmptyResultObject();
                result.lValue = 0;
                result.sValue = "";

                result.data = RD_ENTRY.TRANSACTIONSET.getEmptyTransactionSetObject();

                result.data.iDataSourceType = RDEntryDef.DataSourceType;
                //result.data.sURL = RD_ENTRY.SCREEN.getTreeDataURL(result.data.iDataSourceType);

                if (result.data.iDataSourceType == eDataSourceType.Default) {
                    iTotalTranSet = RD_ENTRY.TRANSACTIONSET.getTotalTransactionSetTab();
                    if (iTotalTranSet <= 0) {
                        return (false);
                    }

                    for (iCounter = 0; iCounter < iTotalTranSet; iCounter++) {
                        sTabId = "id_rd_transet" + iCounter;
                        selected = RD_ENTRY.TRANSACTIONSET.getSelectedTransactionSetElement(sTabId);
                        if (selected.lValue < 1) {
                            if (selected.lValue < 0) {
                                COMMON.prototype.showMessage(selected.sValue, "Exception");
                            }
                            continue;
                        }

                        value = RD_ENTRY.TRANSACTIONSET.getTransactionSetElementValue(selected.data[0]);
                        if (value == 0) {
                            continue;
                        }

                        if (value == TransactionSetType.get("AccountingTransactionsOfaTag")) { // Accounting transactions of a tag
                            eleTemp = document.getElementById(sTabId + "_select_tagmasters");
                            if (DataType.isValidObject(eleTemp) == false) {
                                continue;
                            }
                            voucher = eleTemp.options[eleTemp.selectedIndex].value;
                            if (voucher == null || voucher == 'undefinided' || voucher == '' || voucher == 0) {
                                continue;
                            }
                        }
                        else if (value == TransactionSetType.get("InventoryTransactionsOfaTag")) { // Inventory transactions of a tag
                            eleTemp = document.getElementById(sTabId + "_select_tagmasters");
                            if (DataType.isValidObject(eleTemp) == false) {
                                continue;
                            }
                            voucher = eleTemp.options[eleTemp.selectedIndex].value;
                            if (voucher == null || voucher == 'undefinided' || voucher == '' || voucher == 0) {
                                continue;
                            }
                        }
                        else if (value == TransactionSetType.get("AllTransactionsOfDocumentClass")) // All transactions of document class
                        {
                            eleTemp = document.getElementById(sTabId + "_select_documentclass");
                            if (DataType.isValidObject(eleTemp) == false) {
                                continue;
                            }
                            voucher = eleTemp.options[eleTemp.selectedIndex].value;
                            if (voucher == null || voucher == 'undefinided' || voucher == '' || voucher == 0) {
                                continue;
                            }
                        }
                        else if (value == TransactionSetType.get("AllTransactionsOfDocumentType")) // All transactions of document type
                        {
                            eleTemp = document.getElementById(sTabId + "_select_documenttype");
                            if (DataType.isValidObject(eleTemp) == false) {
                                continue;
                            }
                            voucher = eleTemp.options[eleTemp.selectedIndex].value;
                            if (voucher == null || voucher == 'undefinided' || voucher == '' || voucher == 0) {
                                continue;
                            }
                        }
                        else if (value == TransactionSetType.get("PendingLinks")) { // Pending links
                            voucher = 0;
                            eleTemp = document.getElementById(sTabId + "_select_workflow");
                            if (DataType.isValidObject(eleTemp) == true && eleTemp.selectedIndex > -1) {
                                voucher = eleTemp.options[eleTemp.selectedIndex].value;
                            }
                        }
                        else {
                            voucher = 0;
                        }

                        result.data.arrTranSetIds.push(value);
                        result.data.arrVoucher.push(parseInt(voucher));

                        result.data.arrBRS.push(RD_ENTRY.TRANSACTIONSET.getBRSData(sTabId));

                        iDocumentOption = RD_ENTRY.TRANSACTIONSET.getDocumentData(sTabId);
                        result.data.arrDocumentOption.push(iDocumentOption);
                    }

                    if (result.data.arrTranSetIds.length > 0) {
                        result.lValue = 1;
                    }
                }
                else if (result.data.iDataSourceType == eDataSourceType.Query) {
                    sQuery = RD_ENTRY.DATASET.getQueryValue();
                    if (FCommon.String.isNullOrEmpty(sQuery) == false) {
                        result.data.sQuery = sQuery;
                        result.data.sServerName = $('#id_rd_servername').find(":selected").text();
                        result.data.sLogin = document.getElementById('id_rd_login').value;
                        result.data.sPassword = document.getElementById('id_rd_password').value;
                        result.data.sDatabaseName = $('#id_rd_databasename').find(":selected").text();
                        result.data.bQuery = true;
                        result.lValue = 1;
                    }
                }
                else if (result.data.iDataSourceType == eDataSourceType.View) {
                    sView = RD_ENTRY.DATASET.getSelectedViewName();
                    if (FCommon.String.isNullOrEmpty(sView) == false) {
                        result.data.sView = sView;
                        result.data.sServerName = $('#id_rd_servername').find(":selected").text();
                        result.data.sLogin = document.getElementById('id_rd_login').value;
                        result.data.sPassword = document.getElementById('id_rd_password').value;
                        result.data.sDatabaseName = $('#id_rd_databasename').find(":selected").text();
                        result.data.bQuery = false;
                        result.lValue = 1;
                    }
                }
                else if (result.data.iDataSourceType == eDataSourceType.Excel) {
                    result.data.objExcelFile = document.getElementById("id_rd_customization_excelfilename_data").files;
                    if (result.data.objExcelFile != null && result.data.objExcelFile.length > 0) {
                        result.lValue = 1;
                    }
                }
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = "{RD_ENTRY.TRANSACTIONSET.getSelectedTransactionSetData} " + err.message;
            }

            return (result);
        },

        isTransactionSetChanged: function (objOldData, objNewData) {
            var iCounter = 0;
            var bResult = false;

            try {
                if (DataType.isValidObject(objOldData) == false || objOldData.iDataSourceType != objNewData.iDataSourceType) {
                    return (true);
                }

                if (objOldData.iDataSourceType == eDataSourceType.Default) {
                    if (DataType.isValidObject(objNewData.iDataSourceType) == false) {
                        bResult = true;
                    }
                    else if (objNewData.iDataSourceType != objOldData.iDataSourceType) {
                        bResult = true;
                    }
                    else if (objOldData.arrTranSetIds.length < 1) {
                        bResult = true;
                    }
                    else if (objOldData.arrTranSetIds.length != objNewData.arrTranSetIds.length) {
                        bResult = true;
                    }
                    else if (objOldData.arrVoucher.length < 1) {
                        bResult = true;
                    }
