    fetchDataFromServer: function (obj, parameter, sContentType, sType) {
        let objInput = null;

        if (obj.bAsync == null) {
            obj.bAsync = false;
        }

        sType = "POST";

        try {
            if (DataType.stringRight(obj.sURL, "ServeRequest".length) == "ServeRequest") {
                parameter = NETWORK.createCompressedParam(eAPIRequestType.GetOptionControlData, parameter, undefined, OPTIONCONTROL.m_bDisableClientLog);
            }

            OPTIONCONTROL_INTERNAL.displayLoading(obj.id, true);


            objInput = {
                url: obj.sURL,
                data: parameter,
                type: sType,
                traditional: true,
                async: obj.bAsync,
                beforeSend: function (jqXHR, settings) {
                    let objGlobal = undefined;
                    let objInfo = undefined; 

                    try {
                        if (OPTIONCONTROL_HELPER.isValidObject(window.GlobalPref) == true) {
                            objGlobal = window.GlobalPref.Clone;

                            objInfo = {};
                            objInfo.SessionId = objGlobal.SessionId;
                            objInfo.CompanyId = objGlobal.CompanyId;
                            objInfo.LoginId = objGlobal.LoginId;
                            objInfo.LanguageId = objGlobal.LanguageId;
                            objInfo.AltLanguageId = objGlobal.AltLanguageId;
                            objInfo.AccountingDate = objGlobal.AccountingDate;
                            objInfo.OutletId = objGlobal.OutletId;
                            objInfo.CounterId = objGlobal.CounterId;
                            objInfo.UserName = objGlobal.UserName;
                            objInfo.AFToken = "";
                            objInfo.CompanyKey = 0;

                            if (DataType.isNullOrEmpty(GlobalPref.AFToken, true) == false) {
                                objInfo.AFToken = GlobalPref.AFToken;
                            }

                            if (DataType.isValidObject(objGlobal.License) == true) {
                                objInfo.CompanyKey = objGlobal.License.CompanyKey;
                            }

                            objInfo = DataType.compress(objInfo, true);
                            jqXHR.setRequestHeader("FOCUS", objInfo);
                            jqXHR.setRequestHeader("Accept-Language", "en-US,en");
                        }
                    }
                    catch (err) { }
                },
                success: function (data, textStatus, jqXHR) {
                    OPTIONCONTROL_SERVER.success(data, textStatus, jqXHR, obj);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    try {
                        if (OPTIONCONTROL.m_bDisableLog !== true) {
                            FUIElement.writeConsoleLog("Error: {OPTIONCONTROL_SERVER::fetchDataFromServer} [ControlId='" + obj.id.id + "'][textStatus='" + textStatus + "'][errorThrown='" + errorThrown + "']");
                        }

                        OPTIONCONTROL_INTERNAL.displayLoading(obj.id, false);
                        OPTIONCONTROL_INTERNAL.setDataLoadingFlag(obj.id, false);
                    }
                    catch (err) {
                        FUIElement.writeConsoleLog("Exception: {OPTIONCONTROL_SERVER::fetchDataFromServer:error} [ControlId='" + obj.id.id + "'][Message='" + err.message + "']");
                    }
                }
            };

            if (DataType.isNullOrEmpty(sContentType) == false) {
                objInput.contentType = sContentType;
            }

            if (OPTIONCONTROL.debugServerCall == true) {
                debugger
            }

            OPTIONCONTROL.RequestId = $.ajax(objInput);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_SERVER.fetchDataFromServer} " + err.message);
        }
    },

    success: function (data, textStatus, jqXHR, obj) {
        let iCounter = 0;
        let objResponse = undefined;
        let arrLog = null;
        let value = null;

        try {
            if (OPTIONCONTROL.m_bDisableLog !== true) {
                FUIElement.writeConsoleLog("Success: {OPTIONCONTROL_SERVER::success} [ControlId='" + obj.id.id + "'][textStatus='" + textStatus + "']");
            }

            value = jqXHR.getResponseHeader("FOCUS_CLIENTLOG");
            if (OPTIONCONTROL_HELPER.isValidObject(value) == true && OPTIONCONTROL.m_bDisableLog !== true) {
                arrLog = value.split(", ");
                for (iCounter = 0; iCounter < arrLog.length; iCounter++) {
                    FUIElement.writeConsoleLog(arrLog[iCounter], "#0073AA");
                }
            }

            value = jqXHR.getResponseHeader("SESSION_EXPIRE");
            if (OPTIONCONTROL_HELPER.isValidObject(value) == true && value == 1) {
                if (OPTIONCONTROL_HELPER.isValidObject(window.GLOBAL) == true) {
                    window.GLOBAL.pageRefresh();
                }

                return;
            }

            value = jqXHR.getResponseHeader("FOCUS_MESSAGE");
            if (OPTIONCONTROL_HELPER.toInt(value) > 0) {
                if ((typeof data).toLowerCase() == "object") {
                    COMMON.prototype.showMessage(data.sValue, data.lValue < 0 ? document.getElementById("id_resource_message_exception").value : document.getElementById("id_resource_message_error").value);
                }
                else {
                    data = DataType.stringToObject(data);
                    if (data.lValue > 0) {
                        data = data.data;
                        COMMON.prototype.showMessage(data.sValue, data.lValue < 0 ? document.getElementById("id_resource_message_exception").value : document.getElementById("id_resource_message_error").value);
                    }
                }

                return;
            }

            objResponse = {};
            objResponse.id = obj.id;
            objResponse.data = data;
            objResponse.sKey = obj.sSearch;
            objResponse.bAsync = obj.bAsync;
            objResponse.objSelectedData = obj.SelectedData;
            objResponse.bIgnoreChangeCallback = obj.bIgnoreChangeCallback;
            objResponse.bFromKeyboard = obj.bFromKeyboard;
            objResponse.sURL = obj.sURL;
            objResponse.iSearchBy = obj.iSearchBy;
            objResponse.bDoNotShowPopup = obj.bDoNotShowPopup;
            objResponse.sDataLoadedCallback = obj.sDataLoadedCallback;
            objResponse.bGridSetMasterValue = obj.bGridSetMasterValue;

            if (obj.LoadBalance != undefined && obj.LoadBalance != null) {
                objResponse.LoadBalance = obj.LoadBalance;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(obj.tag) == true) {
                objResponse.tag = obj.tag;
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(obj.sfnResponse) == true) {
                OPTIONCONTROL_INTERNAL.serverResponse(objResponse, false);
            }
            else {
                eval(obj.sfnResponse)(objResponse);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {OPTIONCONTROL_SERVER::success} [ControlId='" + obj.id.id + "'][Message='" + err.message + "']");
        }
    },

    cancelRequest: function () {
