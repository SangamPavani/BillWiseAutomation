                    messageInfoPopup.CancelMethod = "VOUCHERPOSTING.EMAILMETHODS.closePopup()";
                    messageInfoPopup.CloseMarkMethod = "VOUCHERPOSTING.EMAILMETHODS.closePopup()";

                    const arrValue = [];
                    arrValue.push(messageInfoPopup);
                    arrValue.push("divMessageInfo");
                    COMMONMETHODS.UTILITYMETHODS.createMessagePopup(arrValue);
                    return;
                }

                debugger;
                VOUCHERPOSTING.PRINTMETHODS.printPreOrder();
            }
            else if (rtnValuesBillSettlement.bSuccess == false) {
                let VoucherErrorMsg = "";
                let productIndex = -1;
                if (rtnValuesBillSettlement.result.length == 3)
                    toastr.info(msgCannotposttransactionpleasecheckthelogformoredetails, msgPOSInformation);
                else {
                    if (rtnValuesBillSettlement.result[13] != null && rtnValuesBillSettlement.result[13] != undefined)
                        toastr.info(rtnValuesBillSettlement.result[13], msgPOSInformation);
                }
                if (rtnValuesBillSettlement.result != null && rtnValuesBillSettlement.result != undefined) {
                    if (rtnValuesBillSettlement.result[12] == null || rtnValuesBillSettlement.result[12] == undefined) {
                        VoucherErrorMsg = rtnValuesBillSettlement.result[4];
                        toastr.info(VoucherErrorMsg, msgPOSInformation);
                    }
                }
                let vStatus = rtnValuesBillSettlement.result[2];
                if (vStatus != null && vStatus != undefined) {
                    if (vStatus.Messages != null && vStatus.Messages != undefined) {
                        if (VoucherErrorMsg != null && VoucherErrorMsg != undefined && VoucherErrorMsg.length > 0)
                            VoucherErrorMsg = "";

                        for (let i = 0; i < vStatus.Messages.length; i++) {
                            if (vStatus.Messages[i] == 46 || vStatus.Messages[i] == 35 || vStatus.Messages[i] == 19 || vStatus.Messages[i] == 1
                                || vStatus.Messages[i] == 2 || vStatus.Messages[i] == 47 || vStatus.Messages[i] == 40) {

                                switch (vStatus.Messages[i]) {
                                    case 46:
                                    case 35:
                                    case 19:
                                        VoucherErrorMsg = msgBatchnotavailableforthisItem;
                                        break;
                                    case 1:
                                    case 2:
                                        VoucherErrorMsg = msgStockisnegativefor;
                                        break;
                                    case 47:
                                        VoucherErrorMsg = msgRMANotAvailableForProds;
                                        break;
                                    case 40:
                                        VoucherErrorMsg = msgUnitconversionnotdefinedfor;
                                        break;
                                }
                                if (vStatus.BodyIds != null && vStatus.BodyIds != undefined && vStatus.BodyIds.length > 0 && vStatus.BodyIds[i] != null && vStatus.BodyIds[i] != undefined && vStatus.BodyIds[i] >= 0) {
                                    let ProdName = "";
                                    if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction != undefined) {

                                        let productIds = [];
                                        if (VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != null && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData != undefined && VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.length > 0)
                                            productIds = VOUCHERPOSTING.VARIABLES.PosSalesTransaction.BodyData.filter((p) => p.Sales.Product);

                                        if (productIds != null && productIds != undefined && productIds.length > 0) {
                                            let ProdId = productIds[vStatus.BodyIds[i]];
                                            if (VOUCHERPOSTING.VARIABLES.ListOfItems != null && VOUCHERPOSTING.VARIABLES.ListOfItems != undefined && VOUCHERPOSTING.VARIABLES.ListOfItems.length > 0) {
                                                for (let PC = 0; PC < VOUCHERPOSTING.VARIABLES.ListOfItems.length; PC++) {
                                                    if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("PRODUCT") || VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("KIT")) {
                                                        if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue1 == ProdId) {
                                                            ProdName = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                    else if (VOUCHERPOSTING.VARIABLES.ListOfItems[PC].PosProductMake == PosProductMake.get("SET")) {
                                                        let setItem = VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RetailSetsDetails.filter(p => p.DefaultValue1 == ProdId);
                                                        if (setItem != null && setItem != undefined) {
                                                            ProdName = setItem.DefaultValue2;
                                                            productIndex = PC;
                                                            VOUCHERPOSTING.VARIABLES.ListOfItems[PC].RowIndicatorVisibile = true;
                                                            break;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    VoucherErrorMsg = VoucherErrorMsg + ProdName;
                                }
                                VoucherErrorMsg = VoucherErrorMsg + msgsomeitems;
                            }
                        }

                        if (VoucherErrorMsg == null || VoucherErrorMsg == undefined || VoucherErrorMsg.length <= 0)
                            VoucherErrorMsg = "Exception while posting voucher. Please check the log.";

                        toastr.error(VoucherErrorMsg, "POS Exception");
                    }
                }
            }
        }
        catch (Ex) {
            GLOBAL.LoadingEnd();
            toastr.error(Ex.message, "POS Exception");
            console.log("DateTime :: " + new Date() + " :: JavaScript File :: retailMainVoucherPosting.js :: JavaScript Function :: VOUCHERPOSTING.postPOSPreOrderTransaction :: Catch Block :: Exception :: " + JSON.stringify(Ex));
        }
    },
