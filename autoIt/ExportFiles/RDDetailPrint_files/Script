        let objLeaveData = null;

        try {
            if (DataType.isValidObject(objCustomData) == true
                && (typeof objCustomData).toLowerCase() == "object"
                && DataType.isValidObject(objCustomData.LeaveData) == true) {
                objLeaveData = {};
                objLeaveData.LeaveData = objCustomData.LeaveData;
