        }
        else {
            iCompressionMethod = DataType.toInt(iCompressionMethod);
        }

        objParam = {};
        objParam.Type = iType;
        objParam.Method = iCompressionMethod;
        objParam.Param = "";
        objParam.SessionId = GlobalPref.SessionId;
        objParam.DisableClientLog = DataType.toBoolean(bDisableClientLog);

        if (DataType.isValidObject(obj) == true) {
            sValue = DataType.toString(obj);
            switch (iCompressionMethod) {
                case 0:
                    objParam.Param = sValue;
                    break;
                case 1:
                    objParam.Param = DataType.compress(sValue);
                    break;
            }
        }

