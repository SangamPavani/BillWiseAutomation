    processForBarcode: function (id, evt) {
        let sHandler = "";
        let sBarcodeProductURL = "";
        let iMasterTypeId = 0;
        let data = null;
        let obj = null;

        try {
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(id.value, true) == true) {
                return (false);
            }

            iMasterTypeId = OPTIONCONTROL.getMasterTypeId(id);
            if (iMasterTypeId != 2) {
                return (false);
            }

            data = OPTIONCONTROL_INTERNAL.getSelectedRowValue(id);
            if (OPTIONCONTROL_HELPER.isValidObject(data) == true) {
                return (false);
            }

            sBarcodeProductURL = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.BarcodeProductURL, eMasterDataType.Text);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sBarcodeProductURL) == true) {
                return (false);
            }

            sHandler = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.BarcodeInputCallback, eMasterDataType.Text);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sHandler, true) == false) {
                obj = eval(sHandler)(id);

                obj.sBarCode = id.value;
            }
            else {
                obj = {};
                obj.sBarCode = id.value;
                obj.iInvTagId = 0;
                obj.iVoucherDate = 0;
                obj.iVoucherType = 0;
                obj.sVoucherNo = "";
            }

            obj = NETWORK.createCompressedParam(eAPIRequestType.GetBarCodeProductId, obj, undefined, OPTIONCONTROL.m_bDisableClientLog);
            data = OPTIONCONTROL_SERVER.executeServerMethod(sBarcodeProductURL, false, obj, "json", false);
            if (data.lValue > 0) {
                data = data.data;
                if (data.lValue > 0) {
                    obj = data.data;
                    if (obj.ItemId > 0) {
                        OPTIONCONTROL.setValue(id, obj.ItemId);
                        OPTIONCONTROL.setScanFlag(id, true);
                        OPTIONCONTROL_TIMER.stopInputProcessTimer(id);
                    }

                    sHandler = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.BarcodeDataLoadedCallback, eMasterDataType.Text);
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sHandler, true) == false) {
                        eval(sHandler)(id, obj);
                    }
                }
                else if (OPTIONCONTROL_HELPER.isNullOrEmpty(data.sValue, true) == false) {
                    FUIElement.showAlert("Error: {OPTIONCONTROL_INTERNAL.processForBarcode)} " + data.sValue);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processForBarcode)} " + err.message);
        }

        return (true);
    },

    processRowClick: function (row, id, event) {
        let sCallback = "";
        let obj = null;
        let element = null;
        let retValue = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            element = OPTIONCONTROL_UI.getSelectedRow(id).Row;
            if (element != null) {
                OPTIONCONTROL_UI.unselectRow(element);
            }

            OPTIONCONTROL_UI.selectRow(row, id);
            OPTIONCONTROL_INTERNAL.setSelectedValue(id);

            obj = OPTIONCONTROL_DATA.hasPartialData(row, id);
            if (obj.iMasterId > 0) {
                OPTIONCONTROL_INTERNAL.startLoadingPartialData(id, row, obj);
                OPTIONCONTROL_INTERNAL.setSelectedValue(id);
            }

            obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, null, false);
            obj.OldValue = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL_HELPER.getAttributeData(id, "data-lastvalue"));

            obj.Data = OPTIONCONTROL.getControlData(id);
            if (OPTIONCONTROL_HELPER.isValidObject(obj.Data) == true) {
                obj.Value = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL_HELPER.getFirstPropertyValue(obj.Data[0]));
            }

            if (obj.OldValue == obj.Value) {
                return;
            }
            OPTIONCONTROL.setLastValue(id, obj.Value);

            sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.DataChangeCallback, eMasterDataType.Text);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                obj.Event = event;
                obj.Flag.bLeave = false;
                obj.Flag.bDataLoad = false;
                obj.Flag.bDataChange = true;
                retValue = eval(sCallback)(obj.Control, obj.Data, obj);
                if (COMMON.prototype.isBoolean(retValue) == true && OPTIONCONTROL_HELPER.toBoolean(retValue) == false) {
                    if (DataType.neq(obj.OldValue, 0) == true) {
                        OPTIONCONTROL.setLastValue(id, obj.OldValue);
                        OPTIONCONTROL.setFocusValue(id, obj.OldValue);
                    }
                    return;
                }
            }

            OPTIONCONTROL.setFocusValue(id, obj.Value);
            OPTIONCONTROL.focusText(id, id.value);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processRowClick} " + err.message);
        }
    },

    serverResponse: function (objResponse, bHideLog) {
        if (OPTIONCONTROL_HELPER.toBoolean(bHideLog) == false && OPTIONCONTROL.m_bDisableLog !== true) {
            FUIElement.writeConsoleLog("Enter: {OPTIONCONTROL_INTERNAL::serverResponse} [ControlId='" + objResponse.id.id + "'][Text='" + OPTIONCONTROL_HELPER.toString(objResponse.sKey) + "']");
        }

        let sNewInput = "";
        let sCallback = "";
        let sFieldName = "";
        let sError = "";
        let bRowSelected = false;
        let bShowPopup = false;
        let arrIndex = null;
        let row = null;
        let obj = undefined;

        try {
            OPTIONCONTROL_INTERNAL.displayLoading(objResponse.id, false);
            OPTIONCONTROL_INTERNAL.setDataLoadingFlag(objResponse.id, false);

            sCallback = OPTIONCONTROL.getAttributeData(objResponse.id, eOptionControlDataAttribute.DataLoadedCallback, eMasterDataType.Text);

            obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(objResponse.id, objResponse.tag, false);
            //obj.OldData = OPTIONCONTROL_INTERNAL.getSelectedRowValue(objResponse.id);

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(objResponse.data.Error) == false) {
                sFieldName = OPTIONCONTROL_INTERNAL.getFieldName(objResponse.id);
                sError = "{OPTIONCONTROL_INTERNAL.serverResponse} [id=" + objResponse.id.id + "]";
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sFieldName, true) == false) {
                    sError += "[Name='" + sFieldName + "']";
                }

                COMMON.prototype.showMessage(sError + " " + objResponse.data.Error, document.getElementById("id_resource_message_error").value);
                return;
            }

            if (OPTIONCONTROL_INTERNAL.getFirstField(objResponse.id) == -1) {
                OPTIONCONTROL_INTERNAL.setSearchBy(objResponse.id, objResponse.data.FirstField);
                OPTIONCONTROL_INTERNAL.setFirstField(objResponse.id, objResponse.data.FirstField);
            }

            if (objResponse.data.FirstField >= 0) {
                if (objResponse.iSearchBy == -1) {
                    OPTIONCONTROL_INTERNAL.setSearchBy(objResponse.id, objResponse.data.FirstField);
                }
                else {
                    OPTIONCONTROL_INTERNAL.setSearchBy(objResponse.id, objResponse.iSearchBy);
                }

                OPTIONCONTROL_INTERNAL.setFirstField(objResponse.id, objResponse.data.FirstField);
            }

            if (objResponse.data.OriginalFirstField >= 0) {
                OPTIONCONTROL_INTERNAL.setOriginalFirstField(objResponse.id, objResponse.data.OriginalFirstField);
            }

            OPTIONCONTROL_INTERNAL.setCompareValueIndex(objResponse.id, objResponse.data.CompareValueIndex);
            OPTIONCONTROL_INTERNAL.setStoreValueIndex(objResponse.id, objResponse.data.StoreValueIndex);

            if (OPTIONCONTROL.getControlType(objResponse.id) == eWebOptionControlType.Bins) {
                OPTIONCONTROL_INTERNAL.setGUID(objResponse.id, objResponse.data.Key);
            }

            if (OPTIONCONTROL_DATA.getMetaData(objResponse.id).length == 0) {
                OPTIONCONTROL_UI.createHeading(objResponse.id, objResponse.data.ColumnMetaData);
            }

            if (objResponse.bAsync == true && OPTIONCONTROL_INTERNAL.isPopupVisible(objResponse.id) == false && OPTIONCONTROL_HELPER.toBoolean(objResponse.bDoNotShowPopup) == false) {
                if (OPTIONCONTROL_DATA.getMetaData(objResponse.id).length > 0) {
                    OPTIONCONTROL_INTERNAL.showPopup(objResponse.id);
                }
            }


            OPTIONCONTROL_DATA.storeDataArrayInMemory(objResponse.id, objResponse.data.ColumnValue, objResponse.LoadBalance);

            sNewInput = OPTIONCONTROL_INTERNAL.getInputText(objResponse.id);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sNewInput) == false && objResponse.sKey != sNewInput) {
                //objResponse.id.value = sNewInput;
                OPTIONCONTROL_INTERNAL.processInputs(objResponse.id,
                                            sNewInput,
                                            objResponse.sURL,
                                            null,
                                            true);
                return;

            }

            if(OPTIONCONTROL_HELPER.isNullOrEmpty(objResponse.sDataLoadedCallback) == false) {
                bShowPopup = eval(objResponse.sDataLoadedCallback)(objResponse.id, 
                                                            objResponse.data.ColumnValue, 
                                                            {
                                                                Control: objResponse.id,
                                                                bDataArray: true,
                                                                OldData: null,
                                                                CustomData: objResponse.tag,
                                                                UserData: OPTIONCONTROL.getUserData(objResponse.id),
                                                                Data: objResponse.data.ColumnValue,
                                                                Value: 0,
                                                                Flag: {
                                                                    bLeave: false,
                                                                    bDataLoad: true,
                                                                    bDataChange: false
                                                                }
                    });

                if (bShowPopup == false && OPTIONCONTROL_INTERNAL.isPopupVisible(objResponse.id) == false) {
                    OPTIONCONTROL_INTERNAL.showPopup(objResponse.id);
                }
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(objResponse.sKey) == false) // If any key typed or spacebar is pressed
            {
                arrIndex = OPTIONCONTROL_DATA.getKeyDataIndexArray(objResponse.id, objResponse.sKey, 0);
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(objResponse.sKey.trim()) == true) {
                    OPTIONCONTROL_HELPER.getValidElement(objResponse.id).value = "";
                }

                OPTIONCONTROL_INTERNAL.fillDataFromIndex(objResponse.id,
                                                            OPTIONCONTROL_DATA.getMetaData(objResponse.id),
                                                            arrIndex);

                if (OPTIONCONTROL_HELPER.isStartsWith(objResponse.sKey, "#") == true
                    || OPTIONCONTROL_HELPER.isStartsWith(objResponse.sKey, "+") == true
                    || objResponse.bGridSetMasterValue == true) {
                    return;
                }

                bRowSelected = false;
                if (OPTIONCONTROL_HELPER.isValidObject(objResponse.objSelectedData) == true) {
                    row = OPTIONCONTROL_INTERNAL.getRowFromObject(objResponse.id, objResponse.objSelectedData);
                    if (OPTIONCONTROL_HELPER.isValidObject(row) == true) {
                        OPTIONCONTROL_UI.selectRow(row, objResponse.id);
                        bRowSelected = true;
                    }
                }
                else {
                    OPTIONCONTROL_UI.selectFirstRow(objResponse.id);
                    bRowSelected = true;
                }

                if (bRowSelected == true && OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                    obj.Data = OPTIONCONTROL_INTERNAL.getSelectedRowValue(objResponse.id);
                    obj.Flag.bLeave = false;
                    obj.Flag.bDataLoad = true;
                    obj.Flag.bDataChange = false;
                    eval(sCallback)(objResponse.id, obj.Data, obj);
                }
            }
            else if (OPTIONCONTROL_HELPER.isValidObject(objResponse.objSelectedData) == true) {
                if (OPTIONCONTROL_INTERNAL.selectValueInControl(objResponse.id, objResponse.objSelectedData, objResponse.tag, objResponse.bIgnoreChangeCallback) == true) { // Called indirectly from setControlValue
                }
                else {
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback) == false) {
                        obj.Data = null;
                        obj.Flag.bLeave = false;
                        obj.Flag.bDataLoad = true;
                        obj.Flag.bDataChange = false;
                        eval(sCallback)(objResponse.id, null, obj);
                    }
                }
            }
            else {
                arrIndex = OPTIONCONTROL_DATA.getKeyDataIndexArray(objResponse.id, " ", 0);
                OPTIONCONTROL_INTERNAL.fillDataFromIndex(objResponse.id,
                                                            OPTIONCONTROL_DATA.getMetaData(objResponse.id),
                                                            arrIndex);
                OPTIONCONTROL_UI.selectFirstRow(objResponse.id);

                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                    obj.bDataArray = true;
                    obj.Data = objResponse.data.ColumnValue;
                    obj.Flag.bLeave = false;
                    obj.Flag.bDataLoad = true;
                    obj.Flag.bDataChange = false;
                    eval(sCallback)(objResponse.id, obj.Data, obj);
                }
            }

            if (objResponse.bFromKeyboard == true && OPTIONCONTROL_INTERNAL.isPopupVisible(objResponse.id) == false) {
                if (OPTIONCONTROL_DATA.getMetaData(objResponse.id).length > 0) {
                    OPTIONCONTROL_INTERNAL.showPopup(objResponse.id);
                }
            }
        }
        catch (err) {
            if (OPTIONCONTROL_HELPER.toBoolean(bHideLog) == false) {
                FUIElement.writeConsoleLog("Exception: {OPTIONCONTROL_INTERNAL::serverResponse} " + err.message);
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                obj.Data = null;
                obj.Flag.bLeave = false;
                obj.Flag.bDataLoad = false;
                obj.Flag.bDataChange = false;
                eval(sCallback)(objResponse.id, null, obj);
            }

            COMMON.prototype.showMessage("{OPTIONCONTROL_INTERNAL.serverResponse} " + err.message, document.getElementById("id_resource_message_error").value);
        }
    }
};

var OPTIONCONTROL_RESIZE = {
    changeColumnWidth: function (id, iColumn, iNewWidth) {
        let iCounter = 0;
        let iTotalRows = 0;
        let eleRow = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
            if (OPTIONCONTROL_HELPER.isValidObject(id) == false) {
                return (false);
            }

            eleRow = OPTIONCONTROL_UI.getHeadingRow(id);
            OPTIONCONTROL_RESIZE.changeRowColumnWidth(eleRow, iColumn, iNewWidth);

            iTotalRows = OPTIONCONTROL_INTERNAL.getTotalRows(id);
            for (iCounter = 1; iCounter <= iTotalRows; iCounter++) {
                eleRow = OPTIONCONTROL_UI.getRowElement(id, iCounter);
                OPTIONCONTROL_RESIZE.changeRowColumnWidth(eleRow, iColumn, iNewWidth);
            }

            eleRow = OPTIONCONTROL_UI.getHiddenRow(id);
            if (DataType.isValidObject(eleRow) == true) {
                OPTIONCONTROL_RESIZE.changeRowColumnWidth(eleRow, iColumn, iNewWidth);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_RESIZE.changeColumnWidth} " + err.message);
        }
    },

    // Changes single column width
    changeRowColumnWidth: function (eleRow, iColumn, iWidth) {
        let eleColumn = null;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(eleRow) == false) {
                return;
            }

            if (iColumn < 0 || iColumn >= eleRow.children.length) {
                return;
            }

            eleColumn = eleRow.children[iColumn];
            eleColumn.style.minWidth = iWidth + "px";
            eleColumn.style.maxWidth = eleColumn.style.minWidth;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_RESIZE.changeRowColumnWidth} " + err.message);
        }
    },

