        ev.preventDefault();
    },

    onDrop_Handler: function (ev) {  
        //debugger
        var element = null;
        var sSourceId = "";
        var sTargetId = "";

        try {
            ev.preventDefault();
            ev.stopImmediatePropagation();

            sSourceId = ev.dataTransfer.getData("text");
            sTargetId = ev.target.id;
            if (FCommon.String.isNullOrEmpty(sTargetId)) {
                sTargetId = ev.currentTarget.id
            }
            if (RD_ENTRY.CUSTOMIZATION.isReportColumnId(sSourceId) === true) { // If source is table column
                if (FCommon.String.isNullOrEmpty(sTargetId) == true) {
                    sTargetId = ev.target.parentElement.id;
                }

                if (sSourceId === sTargetId) { // If source and target are same
                    // Cannot create
                    return;
                }

                if (RD_ENTRY.CUSTOMIZATION.isReportColumnId(sTargetId) === true) { // If target is table column, change table column position
                    RD_ENTRY.CUSTOMIZATION.onDropReportColumnDragReportColumn(sSourceId, sTargetId);
                }
            }
            else if (sTargetId == RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.getCubeRowGroupingContainerId()) { // Cube Row Grouping
                RD_ENTRY.CUSTOMIZATION.ROW_GROUPING.onDrop(sSourceId, sTargetId);
            }
            else if (sTargetId == RD_ENTRY.CUSTOMIZATION.getCubeColumnGroupByContainerId()) { // Cube Column Group By
                RD_ENTRY.CUSTOMIZATION.onDropCubeColumnGroupByDragTree(sSourceId, sTargetId);
            }
            else if (sTargetId == RD_ENTRY.CUSTOMIZATION.getCubeColumnMeasuresContainerId()) { // Cube Column Measures
                RD_ENTRY.CUSTOMIZATION.onDropColumnMeasuresDragTree(sSourceId, sTargetId);
            }
            else { // Report Column
                RD_ENTRY.CUSTOMIZATION.onDropReportColumnDragTree(sSourceId);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.onDrop_Handler}" + err.message, "Exception");
        }
    },

