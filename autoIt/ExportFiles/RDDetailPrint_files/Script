function ElementObserver(ele, sCallback, bAttribute, bChildList, bSubTree) {
    ele = FUIElement.getValidElement(ele);
    if (DataType.isValidObject(ele) == false) {
        return (null);
    }

    bAttribute = DataType.toBoolean(bAttribute);
    bChildList = DataType.toBoolean(bChildList);
    bSubTree = DataType.toBoolean(bSubTree);

    var attr = {};
    
    if (bAttribute == false && bChildList == false && bSubTree == false) {
        bAttribute = true;
        bChildList = true;
        bSubTree = true;
    }

    if (bAttribute == true) {
        attr.attributes = true;
    }

    if (bChildList == true) {
        attr.childList = true;
    }

    if (bSubTree == true) {
        attr.subtree = true;
    }

    var obj = {
        m_Observer: null,
        m_Callback: sCallback,
        m_Element: ele,
        m_Attr: attr,

        start: function () {
            obj.m_Observer = new MutationObserver(function (mutationsList, observer) {
                for(var mutation of mutationsList) {
                    if (FCommon.String.isNullOrEmpty(obj.m_Callback) == false) {
                        eval(obj.m_Callback)(mutation.type, obj.m_Element, mutation);
                    }
                }
            });

            obj.m_Observer.observe(obj.m_Element, obj.m_Attr);
        },

        stop: function () {
            obj.m_Observer.disconnect();
        }
    };

    obj.start();

    return (obj);
}
