                && DataType.isValidObject(objCustomData.InBetweenData) == true
                && DataType.isNullOrEmpty(objCustomData.InBetweenData.sCallback, true) == false) {
                eval(objCustomData.InBetweenData.sCallback)(objCustomData.InBetweenData);
            }

            sHandler = FGRIDCONTROL.PRIVATE.getAfterLeaveHandler(gridElement);
            if (DataType.isNullOrEmpty(sHandler, true) == false) {
                eval(sHandler)({ gridElement: gridElement, iRow : obj.iRow, iColumn : obj.iColumn - 1, bNext: true}, event);
            }

            bResult = FGRIDCONTROL.gotoNextCellFocus(obj, objCustomData);
