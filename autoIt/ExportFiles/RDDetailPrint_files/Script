    applyDateSetting: function (element, id_startDate, id_endDate, acctountingDate, currentDate, dayOfWeek, calType, fiscalDate) {
        //debugger
        try {
            if (FCommon.UI.isValidObject(fiscalDate) == false) {
                fiscalDate = acctountingDate;
            }
            var startdate = document.getElementById(id_startDate);
            var enddate = document.getElementById(id_endDate);
            var iYear = DATE.prototype.getYearFromFocusDate(parseInt(currentDate));
            var iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(currentDate));
            var iDay = DATE.prototype.getDayFromFocusDate(parseInt(currentDate));
            var iTempCalc = 0;
            var iDiff = 0;

            if (FCommon.UI.isValidObject(startdate) && FCommon.UI.isValidObject(enddate)) {
                DATEPICKER.disableControl(startdate, true);
                DATEPICKER.disableControl(enddate, true);

                switch (parseInt(element.value)) {
                    case DateOptions.DateRange:
                        DATEPICKER.disableControl(startdate, false);
                        DATEPICKER.disableControl(enddate, false);
                        break;
                    case DateOptions.AsOnDate:
                        DATEPICKER.setDate(startdate, acctountingDate);
                        DATEPICKER.clear(enddate);
                        DATEPICKER.disableControl(enddate, false);
                        break;
                    case DateOptions.ForThisYear:
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, 1, iYear));
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(FDate.maxDays(12, iYear, calType), 12, iYear));
                        break;
                    case DateOptions.LastYear:
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, 1, iYear - 1));
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(FDate.maxDays(12, iYear, calType), 12, iYear - 1));
                        break;
                    case DateOptions.ForThisMonth:
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, iMonth, iYear));
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(FDate.maxDays(iMonth, iYear, calType), iMonth, iYear));
                        break;
                    case DateOptions.ForLastMonth:
                        iYear = iMonth == 1 ? iYear - 1 : iYear;
                        iMonth = iMonth == 1 ? 12 : iMonth - 1;
                        iDay = FDate.maxDays(iMonth, iYear, calType);

                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, iMonth, iYear));
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear));
                        break;
                    case DateOptions.ForThisWeek:
                        iDiff = -dayOfWeek;
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate((iDiff + iDay) < 1 ? FDate.maxDays((iDiff + iDay) < 1 && iMonth == 1 ? 12 : (iDiff + iDay) < 1 ? iMonth - 1 : iMonth, iYear, calType) + iDay + iDiff : iDay + iDiff,
                            (iDiff + iDay) < 1 && iMonth == 1 ? 12 : (iDiff + iDay) < 1 ? iMonth - 1 : iMonth,
                            (iDiff + iDay) < 1 && iMonth == 1 ? iYear - 1 : iYear));

                        iDiff = 6 - dayOfWeek;
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate((iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) ? iDiff + iDay - FDate.maxDays(iMonth, iYear, calType) : iDiff + iDay,
                            (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) && iMonth == 12 ? 1 : (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) ? iMonth + 1 : iMonth,
                            (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) && iMonth == 12 ? iYear - 1 : iYear));
                        break;
                    case DateOptions.ForLastWeek:
                        iDiff = -(parseInt(dayOfWeek) + 7);
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate((iDiff + iDay) < 1 ? FDate.maxDays((iDiff + iDay) < 1 && iMonth == 1 ? 12 : (iDiff + iDay) < 1 ? iMonth - 1 : iMonth, iYear, calType) + iDay + iDiff : iDay + iDiff,
                            (iDiff + iDay) < 1 && iMonth == 1 ? 12 : (iDiff + iDay) < 1 ? iMonth - 1 : iMonth,
                            (iDiff + iDay) < 1 && iMonth == 1 ? iYear - 1 : iYear));

                        iDiff += 6;
                        iTempCalc = (iDiff + iDay) < 1 && iMonth == 1 ? 12 : iMonth - 1;
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(
                            (iDiff + iDay) < 1 ? FDate.maxDays(iTempCalc, iYear, calType) + (iDiff + iDay) : (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) ? iDiff : iDiff + iDay,
                            (iDiff + iDay) < 1 ? iTempCalc : (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) && iMonth == 12 ? 1 : (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) ? iMonth + 1 : iMonth,
                            (iDiff + iDay) > FDate.maxDays(iMonth, iYear, calType) && iMonth == 12 ? iYear - 1 : iYear));
                        break;
                    case DateOptions.ForToday:
                        DATEPICKER.setDate(startdate, currentDate);
                        DATEPICKER.setDate(enddate, currentDate);
                        break;
                    case DateOptions.Yesterday:
                        iYear = iMonth == 1 && iDay == 1 ? iYear - 1 : iYear;
                        iMonth = iMonth == 1 && iDay == 1 ? 12 : iDay == 1 ? iMonth - 1 : iMonth;
                        iDay = iDay == 1 ? FDate.maxDays(iMonth, iYear, calType) : iDay - 1;

                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear));
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear));
                        break;
                    case DateOptions.CurrentFinancialYear:
                        //if (iMonth >= 4) {
                        iYear = iMonth < DATE.prototype.getMonthFromFocusDate(parseInt(fiscalDate)) ? iYear - 1 : iYear;
                        iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(fiscalDate));
                        iDay = DATE.prototype.getDayFromFocusDate(parseInt(fiscalDate));
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear));
                        //}
                        //else {
                        //    DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(DATE.prototype.getDayFromFocusDate(parseInt(acctountingDate)),
                        //    DATE.prototype.getMonthFromFocusDate(parseInt(acctountingDate)),
                        //    iYear));
                        //    //DATEPICKER.setDate(startdate, acctountingDate);
                        //}
                        DATEPICKER.setDate(enddate, currentDate);
                        break;
                    case DateOptions.LastFinancialYear:
                        iYear = iMonth < DATE.prototype.getMonthFromFocusDate(parseInt(fiscalDate)) ? iYear - 1 : iYear;
                        iMonth = DATE.prototype.getMonthFromFocusDate(parseInt(fiscalDate));
                        iDay = DATE.prototype.getDayFromFocusDate(parseInt(fiscalDate));

                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear - 1));

                        iYear = iMonth == 1 && iDay == 1 ? iYear - 1 : iYear;
                        iMonth = iMonth == 1 && iDay == 1 ? 12 : iMonth > 1 ? iMonth - 1 : iMonth;
                        iDay = iDay == 1 ? FDate.maxDays(iMonth, iYear, calType) : iDay - 1;

                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(iDay, iMonth, iYear));
                        break;
                    case DateOptions.CurrentQuarter:
                        iDiff = iMonth >= 4 && iMonth <= 6 ? 4 : iMonth >= 6 && iMonth <= 9 ? 7 : iMonth >= 9 && iMonth <= 12 ? 10 : iMonth >= 1 && iMonth <= 3 ? 1 : iMonth;
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, iDiff, iYear));

                        iDiff = iMonth >= 4 && iMonth <= 6 ? 6 : iMonth >= 6 && iMonth <= 9 ? 9 : iMonth >= 9 && iMonth <= 12 ? 12 : iMonth >= 1 && iMonth <= 3 ? 3 : iMonth;
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iYear));
                        break;
                    case DateOptions.PreviousQuarter:
                        iTempCalc = iMonth < 4 ? iYear - 1 : iYear;
                        iDiff = iMonth >= 4 && iMonth <= 6 ? 1 : iMonth >= 6 && iMonth <= 9 ? 4 : iMonth >= 9 && iMonth <= 12 ? 7 : iMonth >= 1 && iMonth <= 3 ? 10 : iMonth;
                        DATEPICKER.setDate(startdate, DATE.prototype.convertIntoFocusDate(1, iDiff, iTempCalc));

                        iDiff = iMonth >= 4 && iMonth <= 6 ? 3 : iMonth >= 6 && iMonth <= 9 ? 6 : iMonth >= 9 && iMonth <= 12 ? 9 : iMonth >= 1 && iMonth <= 3 ? 12 : iMonth;
                        DATEPICKER.setDate(enddate, DATE.prototype.convertIntoFocusDate(REPORTVIEW.getLastDayoftheMonth(iDiff), iDiff, iTempCalc));
                        break;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{REPORTVIEW.applyDateSetting}" + err.message, "Exception");
        }
    },

