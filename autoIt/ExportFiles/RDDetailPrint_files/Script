    processInputs: function (id, sKey, sURL, objData, bFromKeyboard) {        
        try {
            objData = null;
            if (OPTIONCONTROL_HELPER.isStartsWith(sKey, "#") == true 
                || OPTIONCONTROL_HELPER.isStartsWith(sKey, "*") == true 
                || OPTIONCONTROL_HELPER.isStartsWith(sKey, "+") == true) {
                // + for search in customized columns
                OPTIONCONTROL_UI.resetDataElement(id, true);

                if (sKey == "#") {
                    return;
                }

                OPTIONCONTROL_TIMER.stopInputProcessTimer(id);
                OPTIONCONTROL_SERVER.cancelRequest();
            }

            if (OPTIONCONTROL_INTERNAL.isKeepUnmatchedData(id) == true) {
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sKey) == true) {
                    OPTIONCONTROL_UI.resetDataElement(id, false);
                }
            }
            else {
                if (sKey == " " && OPTIONCONTROL.isValidStoredData(id, sKey) == false) {
                    OPTIONCONTROL.clear(id, true);

                    if (OPTIONCONTROL_HELPER.isValidObject(objData) == true) {
                        objData = null;
                    }
                }
            }

            if (OPTIONCONTROL.isInputBarcodeEnabled(id) == true) {
                return;
            }

            if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Bins) {
                OPTIONCONTROL_BINS.processInputs(id, sKey, objData, bFromKeyboard, 0);
                return;
            }

            OPTIONCONTROL_TIMER.processInputs(id, sKey, sURL, objData, bFromKeyboard);

            if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false) {
                if (OPTIONCONTROL_DATA.getMetaData(id).length > 0) {
                    objData = OPTIONCONTROL_INTERNAL.getElementData(OPTIONCONTROL_UI.getSelectedRow(id).Row, id);

                    if (OPTIONCONTROL_HELPER.toBoolean(bFromKeyboard) == true) {
                        OPTIONCONTROL_INTERNAL.showPopup(id);
                    }
                    else {
                        OPTIONCONTROL_INTERNAL.setControlData(id, objData);
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processInputs} " + err.message);
        }
    },

    processInputData: function (id, sKey, sURL, objData, bFromKeyboard) {
        let arrIndex = null;
        let objParam = null;

        try {
            arrIndex = OPTIONCONTROL_DATA.getKeyDataIndexArray(id, sKey, 0);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sURL) == false && (arrIndex == null || arrIndex.length <= 0)) {
                objParam = OPTIONCONTROL_SERVER.getCommunicationParameterObject(id, sURL);
                objParam.sSearch = sKey;
                objParam.bFromKeyboard = bFromKeyboard;

                OPTIONCONTROL_UI.resetDataElement(id, true);
                OPTIONCONTROL_SERVER.getDataFromServer(objParam);

                if (bFromKeyboard == true) {
                    OPTIONCONTROL_INTERNAL.setBufferedInputText(id, sKey);
                }
            }
            else {
                OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, false);
                OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

                OPTIONCONTROL_INTERNAL.fillDataFromIndex(id, OPTIONCONTROL_DATA.getMetaData(id), arrIndex);
                if (OPTIONCONTROL_HELPER.isValidObject(objData) == true) {
                    row = OPTIONCONTROL_INTERNAL.getRowFromObject(id, objData);
                    if (row != null) {
                        OPTIONCONTROL_UI.selectRow(row, id);
                    }
                    else {
                        OPTIONCONTROL_UI.selectFirstRow(id);
                    }
                }
                else {
                    OPTIONCONTROL_UI.selectFirstRow(id);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processInputData} " + err.message);
        }
    },

    processUpKey: function (id, evt) {
        let row = null;

        try {
            OPTIONCONTROL_HELPER.stopKeyProcess(evt);

            if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false && OPTIONCONTROL_DATA.getMetaData(id).length > 0) {
                OPTIONCONTROL_INTERNAL.showPopup(id);
