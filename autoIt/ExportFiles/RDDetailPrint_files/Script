            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                iValue = DataType.toInt(FUIElement.getAttribute(id, "totalpages"));
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FPAGECONTROL.getTotalPages} " + err.message);
        }
        if (iValue < 1) {
            iValue = 1;
        }

        return (iValue);
    },

    setTotalPages: function(id, iTotalPages) {
        try {
            iTotalPages = DataType.toInt(iTotalPages);
            if (iTotalPages < 1) {
                iTotalPages = 1;
            }

            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                FUIElement.setAttribute(id, "totalpages", iTotalPages);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FPAGECONTROL.setTotalPages} " + err.message);
        }
    },

