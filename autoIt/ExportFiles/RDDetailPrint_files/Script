    GetInputReportsSuccess: function (bSuccess, html, tag) {

        if (bSuccess == false) {
            return;
        }
        //if (html.lValue == undefined) {
        //    if (html.indexOf("C:", 0) != 0) {
        //        if (html.indexOf('<div class=', 0) == -1) {
        //            COMMON.prototype.showMessage(html);
        //            return;
        //        }
        //    }
        //}
        //else {
        //    COMMON.prototype.showMessage(html.data);
        //    return;
        //}
        if (html.lValue != undefined) {
            COMMON.prototype.showMessage(html.data);
            return;
        }
        ////debugger;
        var RITOutputValue = 0;
        if (tag[2] != undefined && tag[2] != null) {
            DashletId = tag[2];
        }
        try {
            var fromCrossReference = tag[0];
            if (document.getElementById("RITOutput_" + DashletId) != null) {
                RITOutputValue = parseInt(document.getElementById("RITOutput_" + DashletId).value);
            }
            if (bSuccess == true) {
                var ele = document.getElementById("id_starting_date_" + DashletId);
                if (FCommon.UI.isValidObject(ele)) {
                    objReport_StartDate = DATEPICKER.getDate("id_starting_date_" + DashletId);
                }

                var RITReportId = 0;
                var eleReportId = null;
                if (fromCrossReference == true) {
                    eleReportId = document.getElementById("getReportId_CrossReference" + DashletId);
                }
                else {
                    eleReportId = document.getElementById("getReportId_" + DashletId);
                }
                if (FCommon.UI.isValidObject(eleReportId)) {
                    RITReportId = parseInt(eleReportId.value);
                }

                if (FCommon.UI.isValidObject(document.getElementById("id_ending_date_" + DashletId))) {
                    ele = document.getElementById("id_ending_date_" + DashletId);
                    objReport_DateOption = document.getElementById("DateOptions_" + DashletId).value;
                    objReport_EndDate = DATEPICKER.getDate("id_ending_date_" + DashletId);
                }

                if (fromCrossReference != undefined && fromCrossReference == true) {
                    REPORTRENDER.openCrossReferenceReportSuccess(bSuccess, html, tag);
                    return;
                }

                if (RITOutputValue != 0 && RITOutputValue != 9) {
                    if (RITOutputValue == 11 || RITOutputValue == 6) {
                        EMAIL.emailSettings(bSuccess, html);
                    }
                    else if (RITOutputValue == 1) {
                        if (html == "") {
                            COMMON.prototype.showMessage(msgs.msgNodatatoPrint, msgs.Error);
                            return;
                        }
                        //for (var i = 0; i < html.length; i++) {
                        var w = window.open("", "_blank");
                        if (FCommon.UI.isValidObject(w)) {
                            w.location = GLOBAL.getContextPath("GetDocumentToPrint", "TransHome", "Transactions") + '?fileName=' + html;
                        }
                        //}
                        //else {
                        //    var msg = document.getElementById("msgPopupBlocked") != null ? document.getElementById("msgPopupBlocked").getAttribute("data-value") : "";
                        //    COMMON.prototype.showMessage(msg);
                        //}
                        //isPrintFromReportRender = false;
                    }
                    else {
                        REPORTRENDER.successGetOutputScreen(true, html, [RITOutputValue, false]);
                    }
                }
                if (RITOutputValue == OUTPUT.Graph) {
                    REPORTRENDER.showScreen("ReportGraphOptions");
                    $("#ReportGraphOptions").html(html);
                }
                else if (RITOutputValue == OUTPUT.Screen) {
                    REPORTRENDER.showScreen("ReportRender");
                    $("#ReportRender").html(html);
                    if (DashletId != "MasterReport") {
                        if (FCommon.UI.isValidObject(document.getElementById("id_report_close_callback"))) {
                            document.getElementById("id_report_close_callback").value = "EntryMainCallback.closeReport";
                        }
                    }
                }
                if (tag[1] != true) {
                    filterValueFromReport = filterValue;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{REPORTVIEW.GetInputReportsSuccess}" + err.message, "Exception");
        }
    },

