    setColumnAlignment: function (iValue, objContainer) {
        let iHorizontalAlign = 0;
        let iDecimalInColumn = 0;
        let iRowSpan = 0;
        let iSign = 0;

        try {
            iValue = FConvert.toInt(iValue);

            iHorizontalAlign = ((iValue >> 3) & 3);
            iSign = ((iValue >> 5) & 3);
            iRowSpan = ((iValue >> 7) & 7);
            iDecimalInColumn = (iValue & 7);

            RD_ENTRY.setColumnHorizontalAlignment(objContainer, iHorizontalAlign);
            RD_ENTRY.setColumnDecimals(objContainer, iDecimalInColumn);
            RD_ENTRY.setColumnSign(objContainer, iSign);
            RD_ENTRY.setColumnRowSpan(objContainer, iRowSpan);
        }
        catch (err) { }
    },

