    GotoLineOrPageNo:function(iValue){
        //debugger;
        var iRowPerPage = parseInt( document.getElementById("rowsPerPage_"+sUniqueId).getAttribute("data-value"));
        var iLineno = -1;
        var iCurrentPage = 0;
       
        if(iValue == 0){
            iLineno = parseInt(document.getElementById("Lineno").value);
            iCurrentPage = parseInt(iLineno / iRowPerPage) - 1;//pageno starting with zero
            if((iLineno%iRowPerPage) > 0){
                iCurrentPage++;
            }
        }
        else{
            iCurrentPage = parseInt(document.getElementById("Pageno").value);
            iCurrentPage--;//pageno starting with zero
        }
        if (iCurrentPage >= 0) {
               
            REPORTRENDERNEW.getReportPageData(iCurrentPage, iCurrentPage + 1, sUniqueId);

            let element = document.getElementById('tblBodyReportRender_'+ sUniqueId);     
            iLineno = iValue == 0 ? (iLineno % iRowPerPage) - 1 : 0; 

            for(var iIndex = 0; iIndex < element.children.length; iIndex++)
            {
                if(iIndex == iLineno)
                {
                    $(element.children[iIndex]).addClass("CommonReportselectrow");
                }
                else{
                    $(element.children[iIndex]).removeClass("CommonReportselectrow");
                }
            }
        }
        else{
            if(iValue == 0){
                COMMON.prototype.showMessage("Please provide valid line no.", "Goto line no");
            }
            else{
                COMMON.prototype.showMessage("Please provide valid page no.", "Goto page no");
            }
        }        
    },

