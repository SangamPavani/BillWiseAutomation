    fillDataFromIndex: function (id, arrMetaData, arrIndex, iDisplayRows) {
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;
        let arrData = null;
        let objArr = null;
        let eleBody = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            OPTIONCONTROL_UI.createHeading(id, arrMetaData);

            eleBody = OPTIONCONTROL_UI.resetBodyElement(id);
            if (OPTIONCONTROL_HELPER.isValidObject(eleBody) == false) {
                OPTIONCONTROL_EVENTS.afterFillData(id, true);

                return (false);
            }

            arrData = OPTIONCONTROL_DATA.getMemoryData(id);
            if (arrData.length == 0 || OPTIONCONTROL_HELPER.getArrayLength(arrIndex) == 0) {
                OPTIONCONTROL_EVENTS.afterFillData(id, true);

                return;
            }

            iTotal = DataType.toInt(iDisplayRows);
            if (iTotal == 0 || iTotal > arrIndex.length) {
                iTotal = arrIndex.length;
            }

            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                iIndex = arrIndex[iCounter];
                if (iIndex >= arrData.length) {
                    continue;
                }

                objArr = arrData[iIndex];
                OPTIONCONTROL_UI.createDataRow(id, objArr, arrMetaData, iIndex, eleBody);
            }

            OPTIONCONTROL_EVENTS.afterFillData(id, false);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.fillDataFromIndex} " + err.message);

            OPTIONCONTROL_EVENTS.afterFillData(id, true);
        }
    },

    // Match store key index value in stored data with passed value and select it in control
    selectValueInControl: function (id, value, tag, bIgnoreChangeCallback, sDataLoadedCallback) {
        let sCallback = "";
        let iStoreValueIndex = 0;
        let row = null;
        let result = null;
        let arrIndex = [];
        let obj = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);

            obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, tag, false);
            obj.OldData = OPTIONCONTROL_INTERNAL.getSelectedRowValue(id);

            row = OPTIONCONTROL_UI.getSelectedRow(id).Row;
            OPTIONCONTROL_UI.unselectRow(row);

            result = OPTIONCONTROL_DATA.getValueFromMemory(id, value, iStoreValueIndex);
            if (OPTIONCONTROL_HELPER.isValidObject(result) == true && result.length > 0) {
                row = OPTIONCONTROL_INTERNAL.getRowFromObject(id, result[1]);
                if (row == null) {
                    arrIndex.push(result[0]);
                    OPTIONCONTROL_INTERNAL.fillDataFromIndex(id, OPTIONCONTROL_DATA.getMetaData(id), arrIndex);
                }

                if (row == null) {
                    row = OPTIONCONTROL_INTERNAL.getRowFromObject(id, result[1]);
                }

                if (row != null) {
                    OPTIONCONTROL_UI.selectRow(row, id);
                    OPTIONCONTROL_INTERNAL.setControlData(id, result[1]);
                }

                obj.Data = OPTIONCONTROL_INTERNAL.getSelectedRowValue(id);
                if (OPTIONCONTROL_HELPER.isValidObject(obj.Data) == true) {
                    obj.Value = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL_HELPER.getFirstPropertyValue(obj.Data[0]));
                }

                if(OPTIONCONTROL_HELPER.isNullOrEmpty(sDataLoadedCallback, true) == false) {
                    eval(sDataLoadedCallback)(obj.Control, 
                                                obj.Data, 
                                                {
                                                    Control: obj.Control,
                                                    bDataArray: true,
                                                    OldData: obj.OldData,
                                                    CustomData: tag,
                                                    UserData: OPTIONCONTROL.getUserData(obj.Control),
                                                    Data: obj.Data,
                                                    Value: obj.Value,
                                                    Flag: {
                                                        bLeave: false,
                                                        bDataLoad: true,
                                                        bDataChange: false
                                                    }
                                                });
                }

                sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.DataLoadedCallback, eMasterDataType.Text);
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                    obj.Flag.bLeave = false;
                    obj.Flag.bDataLoad = true;
                    obj.Flag.bDataChange = false;
                    eval(sCallback)(obj.Control, obj.Data, obj);
                }

                sCallback = OPTIONCONTROL.getCallback(id, eOptionControlDataAttribute.DataChangeCallback);
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false && obj.OldValue != obj.Value) {
                    OPTIONCONTROL.setFocusValue(id, obj.Value);
                    OPTIONCONTROL.focusText(id, id.value);
                    OPTIONCONTROL.setLastValue(id, obj.Value);

                    obj.Flag.bLeave = false;
                    obj.Flag.bDataLoad = false;
                    obj.Flag.bDataChange = true;

                    bIgnoreChangeCallback = OPTIONCONTROL_HELPER.toBoolean(bIgnoreChangeCallback);
                    if (bIgnoreChangeCallback == false) {
                        eval(sCallback)(obj.Control, obj.Data, obj);
                    }
                }

                return (true);
            }
            else {
                OPTIONCONTROL_INTERNAL.setControlData(id, null);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.selectValueInControl} " + err.message);
        }

        return (false);
    },

    // Returns data attribute value array of given element
    getElementData: function (element, id) {
        let sProperty = "";
        let data = [];
        let iCounter = 0;
        let arrMetaData = null;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(element) == false) {
                return (null);
            }

            if (OPTIONCONTROL_HELPER.isValidObject(id) == false) {
                for (iCounter = 0; iCounter < element.attributes.length; iCounter++) {
                    if (DataType.hasDataPrefix(element.attributes[iCounter].name) == true) {
                        data.push({ "sValue": element.attributes[iCounter].value });
                    }
                }
            }
            else {
                arrMetaData = OPTIONCONTROL_DATA.getMetaData(id);
                for (iCounter = 0; iCounter < arrMetaData.length; iCounter++) {
                    sProperty = arrMetaData[iCounter].Name;
                    if (OPTIONCONTROL_HELPER.stringIncludes(sProperty, " ") == true) {
                        FUIElement.writeConsoleLog("Error: {OPTIONCONTROL_INTERNAL.getElementData} [id=" + id.id + "][Property=" + sProperty + "] Property cannot have space.");
                    }

                    data.push({ "sValue": element.getAttribute(DataType.stringGetValidDataAttribute(sProperty)) });
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.getElementData} " + err.message);
        }

        return (data);
    },

    getRowFromObject: function (id, objData, bValueIndexOnly) {
        let iCompareValueIndex = 0;
        let row = null;
        let obj = null;

        try {
            bValueIndexOnly = OPTIONCONTROL_HELPER.toBoolean(bValueIndexOnly);

            iCompareValueIndex = OPTIONCONTROL_INTERNAL.getCompareValueIndex(id);
            for (row = OPTIONCONTROL_UI.getFirstDataRow(id) ; row != null; row = OPTIONCONTROL_UI.getNextDataRow(row)) {
