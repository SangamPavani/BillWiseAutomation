                                    return;
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("SIGNEDNUMBER"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == true) {
                                    obj.setControl(eleCtrl, obj.getCellText());
                                    return;
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("UNSIGNEDNUMBER"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == true) {
                                    obj.setControl(eleCtrl, obj.getCellText());
                                    return;
                                }
                                break;
                            case FGRIDCOLUMNTYPE.get("SIGNEDFRACTION"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == true) {
                                    obj.setControl(eleCtrl, obj.getCellText());
