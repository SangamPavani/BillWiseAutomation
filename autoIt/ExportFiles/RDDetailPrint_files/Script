                        }
                    }
                }
            }
            else {
                for (var i = 0; i < arrColumnFilterValues.length; i++) {
                    if (arrColumnFilterValues[i].CellData[idx + 1] != null) {
                        if ((arrColumnFilterValues[i].CellData[idx + 1].toString().toLowerCase()).indexOf(matchValue.toLowerCase()) > -1) {
