                        DATEPICKER.hidePopup(id);
                        break;
                    case eKeyCode.Left: // Left Arrow key
                        iIndex = FUIElement.getCursorIndexInInput(id);
                        if (iIndex <= 0) {
                            return;
                        }

                        sValue = id.value;
                        if (DATEPICKER.isValidInput(sValue.substr(iIndex - 1, 1)) == false) {
                            FUIElement.stopKeyProcess(evt);
                            iNewIndex = DATEPICKER.getPreviousValidInputIndex(id, iIndex);
                            if (iNewIndex != iIndex) {
                                FUIElement.selectText(id, iNewIndex - 1, iNewIndex - 1);
                            }
                            else {
                                FUIElement.selectText(id, iIndex, iIndex);
                            }
                        }
                        break;
                    case eKeyCode.Up: // Up Arrow Key
                        FUIElement.stopKeyProcess(evt);
                        DATEPICKER.changeDateFromArrowKey(id, eKeyCode.Up);
                        break;
                    case eKeyCode.Right: // Right Arrow Key
                        //iIndex = FUIElement.getCursorIndexInInput(id);
                        //sValue = id.value;
                        break;
                    case eKeyCode.Down: // Down Arrow Key
                        FUIElement.stopKeyProcess(evt);
                        DATEPICKER.changeDateFromArrowKey(id, eKeyCode.Down);
                        //DATEPICKER.showPopup(id, true);
                        break;
                    case eKeyCode.Del: // Del Key
                        if (evt.ctrlKey == true && evt.shiftKey == true) {
                        }
                        else {
                            FUIElement.stopKeyProcess(evt);
                        }                        
                        break;
                    case eKeyCode.F4: // F4
                        FUIElement.stopKeyProcess(evt);
                        DATEPICKER.togglePopup(id, evt);
                        break;
                    case eKeyCode.X:
                    //case eKeyCode.V:
                        FUIElement.stopKeyProcess(evt);
                        break;
                    case eKeyCode.Space:
                        FUIElement.stopKeyProcess(evt);
                        if (id != undefined && id != null && id.value != undefined && id.value != null) {
                            if (id.value.length == 0) {
                                DATEPICKER.onToday_Click(id, evt);
                            }
                            else {
