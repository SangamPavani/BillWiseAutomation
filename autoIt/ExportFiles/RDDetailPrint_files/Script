        this.setFocusDropdownPopupPosition = function (eleInput, elePopup, iRequiredPopupWidth) {
            let iValue = 0;
            let iInputTop = 0;
            let iPopupWidth = 0;
            let iInputWidth = 0;
            let rectPopup = null;
            let rectInput = null;
            let obj = null;

            try {
                if (DataType.isValidObject(eleInput) == false || DataType.isValidObject(elePopup) == false) {
                    return;
                }

                elePopup.style.position = "fixed";

                rectPopup = elePopup.getBoundingClientRect();
                iPopupWidth = (rectPopup.right - rectPopup.left);

                rectInput = eleInput.getBoundingClientRect();
                iInputWidth = rectInput.right - rectInput.left;

                iInputTop = FUIElement.calculateFixedTopPosition(eleInput);
                if ((iInputTop + rectInput.height + rectPopup.height) >= window.innerHeight) {
                    iValue = iInputTop - rectPopup.height;
                }
                else {
                    iValue = iInputTop + rectInput.height;
                }

                elePopup.style.top = iValue + "px";

                iValue = FUIElement.calculateFixedLeftPosition(eleInput);
                if (FUIElement.getStyleValue(eleInput, "direction").toLowerCase() == "rtl") {
                    iInputWidth = rectInput.right - rectInput.left;
                    if (iRequiredPopupWidth > 0) {
                        iRequiredPopupWidth -= 5;
                        obj = FCommon.UI.getCalculatedLeft(iRequiredPopupWidth, iValue, iInputWidth);
                        iValue = obj.iLeft;

                        elePopup.style.maxWidth = obj.iWidth + "px";
                    }
                    else {
                        if (iPopupWidth >= iInputWidth) {
                            iValue -= (iPopupWidth - iInputWidth);
                        }
                        else {
                            iValue += (iInputWidth - iPopupWidth);
                        }

                        if ((iValue + iPopupWidth) < iPopupWidth) {
                            iValue += (iPopupWidth - iInputWidth);
                        }
                    }
                }
                else {
                    if (iRequiredPopupWidth > 0) {
                        obj = FCommon.UI.getCalculatedLeft(iRequiredPopupWidth, iValue, iInputWidth);
                        iValue = obj.iLeft;

                        elePopup.style.maxWidth = obj.iWidth + "px";
                    }
                    else {
                        if ((iValue + iPopupWidth) > (window.innerWidth - 25)) {
                            iValue -= (iPopupWidth - iInputWidth);
                        }
                    }
                }

                elePopup.style.left = iValue + "px";
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FCommon.UI.setFocusDropdownPopupPosition} " + err.message);
            }
        },

        this.getCalculatedLeft = function (iRequiredWidth, iInputLeft, iInputWidth) {
            let obj = null;

            try {
                obj = {};
                obj.iLeft = 0;
                obj.iWidth = 0;

                iRequiredWidth += 5 + 10;
                if ((iInputLeft + iRequiredWidth) > (window.innerWidth - 25)) {
                    if ((iRequiredWidth - iInputWidth) <= iInputLeft) {
                        obj.iLeft = iInputLeft - (iRequiredWidth - iInputWidth);
                        obj.iWidth = iRequiredWidth;
                    }
                    else {
                        obj.iLeft = 1;
                        obj.iWidth = (window.innerWidth - 25);
                    }
                }
                else {
                    obj.iLeft = iInputLeft;
                    obj.iWidth = iRequiredWidth;
                }
            }
            catch (err) {
                ("Exception: {FCommon.UI.getCalculatedLeft} " + err.message);
            }

            return (obj);
        },

        this.findAncestorElementsUsingClass = function (ele, sClassName, bAllAncestors) {
