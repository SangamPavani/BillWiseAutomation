            }
        }
        else {
            var bFromCrossReference = false;
            var elereportId = "";
            var reportId = "";
            var sFilterText = '';
            var _outputScreen = 0;

            var id = document.getElementById("hdnExportOption").children[0];
            var fromAnalyze = document.getElementById("hdnFromAnalyze").value;
            var fromReport = document.getElementById("hdnFromReport").value;
            var iReportLite = FConvert.toBoolean(document.getElementById("hdnReportLite").value);
            var sUniqueId = document.getElementById("hdnUniqueId").value;
            _outputScreen = document.getElementById("hdnOutputScreen").value;

            if (id == "") {
                DashletId = reportdashletid;
            } else {
                bFromCrossReference = id.dataset.bfromcrossreference;
            }
            if (FCommon.UI.isValidObject(document.getElementById("getReportId_" + DashletId))) {
                elereportId = document.getElementById("getReportId_" + DashletId);
            }
            else {
                if (FCommon.UI.isValidObject(document.getElementById("getReportId_CrossReference" + DashletId))) {
                    elereportId = document.getElementById("getReportId_CrossReference" + DashletId);
                }
            }
            reportId = elereportId.value;

            if (reportdashletid != "") {
                for (var i = 0; i < ReportLineDataModelInDashboard.length; i++) {
                    if (ReportLineDataModelInDashboard[i].DashletId == reportdashletid) {
                        RepRecord = ReportLineDataModelInDashboard[i].RepRec;
                        reportId = RepRecord.ReportId;
                        break;
                    }
                }
            }

            if (fromAnalyze == true) {
                var Params = ANALYZE.getGroupingParams(false);
            }

            if (DashletId == undefined) {
                DashletId = '';
            }
            if (FCommon.UI.isValidObject(document.getElementById('hdnReportFilterText_' + DashletId))) {
                sFilterText = document.getElementById('hdnReportFilterText_' + DashletId).value;
            }
            if (DashletId == "" || DashletId == "MasterReport") {
                if (RepRecord == undefined || RepRecord == '' && reportLineModel != undefined) {
                    RepRecord = reportLineModel.RepRec;
                }
            }

            if (_outputScreen == OUTPUT.EMail) {
                if (iReportLite == 1) {
                    NETWORK.executeServerMethod
                    (
                        GLOBAL.getContextPath("emailSettingsModalLite", "RD", "RD"),
                        true,
                        {
                            objOutput: _outputScreen,
                            bFromAnalyze: fromAnalyze,
                            sDashletId: DashletId,
                            bFromCrossReference: bFromCrossReference == "True" ? true : false,
                            objReportLineDataModel: objReportLineDataModel,
                            iReportLite: 0,
                            sUniqueId: sUniqueId,
                            filterdata: filterValueFromReport
                        },
                        "",
                        true,
                        "EMAIL.emailSettings",
                        "GLOBAL.LoadingStart",
                        "GLOBAL.LoadingEnd",
                        [_outputScreen, false]
                    );
                }
                else {
                    NETWORK.executeServerMethod
                    (
                        GLOBAL.getContextPath("emailSettingsModal", "RD", "RD"),
                        true,
                        {
                            objOutput: _outputScreen,
                            bFromAnalyze: fromAnalyze,
                            sDashletId: DashletId,
                            bFromCrossReference: bFromCrossReference == "True" ? true : false,
                            objRec: RepRecord,
                            sUniqueId: sUniqueId,
                            filterdata: filterValueFromReport
                        },
                        "",
                        true,
                        "EMAIL.emailSettings",
                        "GLOBAL.LoadingStart",
                        "GLOBAL.LoadingEnd",
                        [_outputScreen, false]
                    );
                }
                return
            }
            else {
                if (id == "") {
                    var bNewTab = true;
                } else {
                    var bNewTab = id.dataset.isprintfromreportrender == "true" ? true : false;
                }

                var result = null;
                if (fromReport == true) {
                    var iFieldIdforSorting = 0;
                    var iSortingOrder = 0;
                    if (FCommon.UI.isValidObject(document.getElementById('id_report_iFieldIdforSorting'))) {
                        iFieldIdforSorting = document.getElementById('id_report_iFieldIdforSorting').value;
                    }
                    if (FCommon.UI.isValidObject(document.getElementById('id_report_iSortingOrder'))) {
                        iSortingOrder = document.getElementById('id_report_iSortingOrder').value;
                    }
                    result = REPORT.exportReport
                        (
                            {
                                _outputScreen: _outputScreen, filterdata: filterValueFromReport, bFromAnalyze: fromAnalyze,
                                bFromCrossReference: bFromCrossReference == "True" ? true : false, Parameter: Params,
                                sReportFilterText: sFilterText, sDashletId: DashletId, ExportColumn: ExportColumns, RemovedAnalyzeColumnIds: RemovedAnalyzeColumnIds,
                                objRec: bFromCrossReference == "True" ? RepRecordforCrossRef : RepRecord, ReportLevel: ReportLevel, iReportLite: iReportLite, iLevel: LevelId,
                                iFieldId: iFieldIdforSorting, iAscending: iSortingOrder, objLayout: objLayoutInformation, sUniqueId: sUniqueId
                            },
                            "REPORTRENDER.successGetOutputScreen",
                            "GLOBAL.LoadingStart",
                            "GLOBAL.LoadingEnd",
                            [_outputScreen, bNewTab]
                        );
                }
                else {
                    filterValue = FILTER.getFilterValue(reportId, 0, '', DashletId);
                    result = REPORT.exportReport
                    (
                        {
                            _outputScreen: _outputScreen, filterdata: filterValue, bFromAnalyze: fromAnalyze,
                            bFromCrossReference: bFromCrossReference == "True" ? true : false, Parameter: Params,
                            sReportFilterText: sFilterText, sDashletId: DashletId, ExportColumn: ExportColumns,
                            RemovedAnalyzeColumnIds: RemovedAnalyzeColumnIds,
                            objRec: RepRecord, iReportLite: iReportLite, objLayout: objLayoutInformation, sUniqueId: sUniqueId
                        },
                        "REPORTRENDER.successGetOutputScreen",
                        "GLOBAL.LoadingStart",
                        "GLOBAL.LoadingEnd",
                        [_outputScreen, bNewTab]
                   );
                }
            }
        }
    },
    
    
