    dropdownClick: function (id, evt) {
        let arrMetaData = null;
        let sValue = "";
        let iStoreValueIndex = 0;
        let objCurrentData = null;
        let objExtra = undefined;
        let result = null;

        try {
            OPTIONCONTROL_HELPER.stopKeyProcess(evt);
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            if (id.readOnly == true || id.disabled == true) {
                return;
            }

            if (OPTIONCONTROL.getOnlyCustomize(id) == true) {
                return;
            }

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.showPopup(id);

                return;
            }

            sValue = id.value;

            arrMetaData = OPTIONCONTROL_DATA.getMetaData(id);
            if (arrMetaData.length == 0) {
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue, true) == true) {
                    OPTIONCONTROL_INTERNAL.loadAndDisplayDropdownWithData(id);
                }

                return;
            }

            if (OPTIONCONTROL.getMasterTypeId(id) < 1 && OPTIONCONTROL_HELPER.isNullOrEmpty(OPTIONCONTROL.getTableName(id), true) == false) {
                objCurrentData = {};
                objCurrentData.Id = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL.getControlValue(id));
                objCurrentData.Value = id.value;

                OPTIONCONTROL.resetControl(id);


                OPTIONCONTROL_INTERNAL.processInputs(id, " ", eOptionControlDataAttribute.getURL(id), null, false);

                if (objCurrentData.Id > 0) {
                    iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);
                    result = OPTIONCONTROL_DATA.getValueFromMemory(id, objCurrentData.Id, iStoreValueIndex);

                    if (OPTIONCONTROL_HELPER.getArrayLength(result) == 0) {
                        result = [];
                        result.push({ sValue: OPTIONCONTROL_HELPER.toString(objCurrentData.Id) });
                        result.push({ sValue: objCurrentData.Value });
                        OPTIONCONTROL_DATA.storeDataInMemory(id, result, 0)

                        OPTIONCONTROL_UI.createDataRow(id, result, OPTIONCONTROL_DATA.getMetaData(id), 0);
                    }

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(id, objCurrentData.Id, null, objExtra);
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue, true) == false) {
                        OPTIONCONTROL_INTERNAL.showPopup(id);
                    }
                    return;
                }

                id.value = sValue;
                OPTIONCONTROL_UI.unselectAllRows(id);
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue, true) == true) {
                    OPTIONCONTROL_UI.selectFirstRow(id);
                }
                OPTIONCONTROL_INTERNAL.showPopup(id);
                return;
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValue, true) == true && OPTIONCONTROL_DATA.getMemoryData().length == 0) {
                OPTIONCONTROL_INTERNAL.processInputs(id, " ", eOptionControlDataAttribute.getURL(id), null, false);
            }

            OPTIONCONTROL_INTERNAL.showPopup(id);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_EVENTS.dropdownClick} " + err.message);
        }
    },

    settingsClick: function (id, evt) {
        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
