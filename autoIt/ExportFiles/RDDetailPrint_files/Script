            }
            for (iCounter = 0; iCounter < prEntryBodyObjArr.length; iCounter++) {
                currentRow = prEntryManualTable.rows.item(iCounter).cells;
                currentRow.item(1).setAttribute('data-id', prEntryBodyObjArr[iCounter].Account)
                currentRow.item(1).innerText = prEntryBodyObjArr[iCounter].AccountName;
               
                currentRow.item(3).children[0].value = prEntryBodyObjArr[iCounter].Amount;
                currentRow.item(4).children[0].value = prEntryBodyObjArr[iCounter].FATag;

            }
            PROVISIONALENTRIES.setPrTableDebitCreditSum(0);
