    getCursorPosition: function (id) {
        let sFormat = "";
        let iIndex = 0;
        let arrPos = null;
        let result = {};

        try {
            result.Type = 0;
            result.arrPos = [];

            iIndex = FUIElement.getCursorIndexInInput(id);

            sFormat = DATEPICKER.getFormat(id);

            arrPos = FDate.getYearIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length == 2) {
                if (iIndex >= arrPos[0] && iIndex <= arrPos[1]) {
                    result.Type = 2; // Year
                    result.arrPos = arrPos;
                    return (result);
                }
            }

            arrPos = FDate.getMonthIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length == 2) {
                if (iIndex >= arrPos[0] && iIndex <= arrPos[1]) {
                    result.Type = 1; // Month
                    result.arrPos = arrPos;
                    return (result);
                }
            }

            arrPos = FDate.getDayIndex(sFormat);
            if (DataType.isValidObject(arrPos) == true && arrPos.length == 2) {
                if (iIndex >= arrPos[0] && iIndex <= arrPos[1]) {
                    result.Type = 0; // Day
                    result.arrPos = arrPos;
                    return (result);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DATEPICKER::getCursorPosition} " + err.message);
        }

        return (result);
    },

    changeDateFromArrowKey: function (id, keyCode) {
        let result = null;
        let iValue = 0;

        try {
            result = DATEPICKER.getCursorPosition(id);
            if (result.arrPos.length == 0) {
                return;
            }

            FUIElement.selectText(id, result.arrPos[0], result.arrPos[1]);
            switch (keyCode) {
                case eKeyCode.Up: // Up Arrow (Increase)
                    switch (result.Type) {
                        case 0: // Day
                            break;
                        case 1: // Month
                            break;
                        case 2: // Year
                            DATEPICKER.getInputYearText(id);
                            iValue = DataType.toInt(iValue);

                            break;
                    }
                    break;
                case eKeyCode.Down: // Down Arrow (Decrease)
                    switch (result.Type) {
                        case 0: // Day
                            break;
                        case 1: // Month
                            break;
                        case 2: // Year
                            break;
                    }

                    break;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {DATEPICKER.changeDateFromArrowKey} " + err.message);
        }
    },

