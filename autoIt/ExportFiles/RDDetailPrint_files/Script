            FUIElement.showAlert("Exception: {OPTIONCONTROL_EVENTS.onMouseDown} " + err.message);
        }
    },

    onMouseMove: function (sTableId, evt) {
        let sId = "";
        let sCtrlId = "";
        let arrWidth = null;
        let iOldWidth = 0;
        let iNewWidth = 0;
        let iResizeColumn = 0;
        let eleTh = null;

        try {
            sId = OPTIONCONTROL_RESIZE.getResizeColumnVariableName(sTableId);
            eleTh = window[sId];
            if (OPTIONCONTROL_HELPER.isValidObject(eleTh) == true) {

                OPTIONCONTROL_HELPER.stopKeyProcess(evt);

                iResizeColumn = FUIElement.getPosition(eleTh.parentElement) - 1;

                arrWidth = eleTh.parentElement.style.minWidth.split("px");
                iOldWidth = OPTIONCONTROL_HELPER.toInt(arrWidth[0]);

                sId = OPTIONCONTROL_RESIZE.getResizeOffsetVariableName(sTableId);
                iNewWidth = iOldWidth + (evt.clientX - DataType.toInt(window[sId]));
                if (iNewWidth < 30) {
                    return;
                }

                eleTh.parentElement.style.minWidth = iNewWidth + "px";
                eleTh.parentElement.style.maxWidth = eleTh.style.minWidth;
                window[sId] = evt.clientX;

                sCtrlId = sTableId.substr(0, sTableId.length - "_table_data".length);
                if (iResizeColumn < 1 || iResizeColumn > OPTIONCONTROL_DATA.getMetaData(sCtrlId).length) {
                    return;
                }

                OPTIONCONTROL_RESIZE.changeColumnWidth(sTableId, iResizeColumn, iNewWidth);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_EVENTS.onMouseMove} " + err.message);
        }
