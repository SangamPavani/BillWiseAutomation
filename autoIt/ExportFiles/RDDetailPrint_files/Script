                $("#dvReportRenderBacktracking0" + DashletId).hide();
                $("#dvReportRenderBacktracking1" + DashletId).hide();
                $("#" + div.id).html(data);
            }
            arrbacktracking.push(div.id);
        }
        catch (err) {
