                    if (rtnValuesBillSettlement.externalModuleData != null && rtnValuesBillSettlement.externalModuleData != undefined && rtnValuesBillSettlement.externalModuleData.Data != null && rtnValuesBillSettlement.externalModuleData.Data != undefined && rtnValuesBillSettlement.externalModuleData.Data.length > 0)
