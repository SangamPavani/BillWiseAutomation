                let billSettlementPaymentDetails = new Object();

                billSettlementPaymentDetails.DummyBillFromBS = dummyList;
                if (ApplicationNew.TotalSchemesInfo != null && ApplicationNew.TotalSchemesInfo != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts != null && ApplicationNew.TotalSchemesInfo.LinePrompts != undefined && ApplicationNew.TotalSchemesInfo.LinePrompts.length > 0)
                    billSettlementPaymentDetails.SchemesAppliedList = ApplicationNew.TotalSchemesInfo.LinePrompts;

                ApplicationNew.BillSettlementPaymentDetails = billSettlementPaymentDetails;
