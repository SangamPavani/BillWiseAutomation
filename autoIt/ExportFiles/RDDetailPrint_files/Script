                            case FGRIDCOLUMNTYPE.get("STRINGLIST"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == false) {
                                    break;
                                }

                                if (DataType.isNullOrEmpty(obj.getCellData()) == true) {
                                    eleCtrl.selectedIndex = -1;
                                }
                                else {
                                    value = obj.getCellData();
                                    eleCtrl.value = value;
                                }
                                obj.setControl(eleCtrl, value);
                                return;
                            case FGRIDCOLUMNTYPE.get("NUMBERLIST"):
                                eleCtrl = FGRIDCONTROL.getBindControl(obj.Grid, obj.iColumn);
                                if (DataType.isValidObject(eleCtrl) == false) {
                                    break;
                                }

                                if (DataType.isNullOrEmpty(obj.getCellData()) == true) {
                                    eleCtrl.selectedIndex = -1;
                                }
                                else {
                                    value = obj.getCellData();
                                    eleCtrl.value = value;
                                }
                                obj.setControl(eleCtrl, value);
                                return;
                        }
                    }
                }

                bChangeRow = DataType.toBoolean(bChangeRow);
                if (DataType.isValidObject(event) == true) {
                    if (event.shiftKey == true) {
                        if (bAsync == true && window.Promise) {
                            myPromise = new Promise(function (myResolve, myReject) {
                                myResolve({ cell: obj.cell, event: event });
                            });

                            myPromise.then(function (objInput) {
                                FGRIDCONTROL.PRIVATE.moveToPreviousCell(objInput.cell, objInput.event);
                            },
                            function (error) {
                                FUIElement.writeErrorLog("Exception: {FGRIDCONTROL.PRIVATE.processDefault.moveToPreviousCell} " + error);
