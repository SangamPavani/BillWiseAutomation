    this.batchRoundOff = function (dQty, dUnitConversion, iNumPlaces) {
        let sQty = "";
        let iIndex = 0;
        let dTrunc = 0;
        let dRound = 0;

        try {
            if (dUnitConversion == 1) {
                return dQty;
            }
            else {
                dQty = FNumberOperation.div(dQty, dUnitConversion);
            }

            if (FNumberOperation.isEqualTo(dQty == DataType.toInt(dQty)) == true) {
                return (dQty);
            }

            if (iNumPlaces == 0) {
                return DataType.toInt(dQty);
            }

            sQty = FConvert.toString(FNumberOperation.convert(dQty));
            iIndex = sQty.indexOf(".");

            if (iIndex < 0) {
                return (dQty);
            }

            if ((iIndex + iNumPlaces + 1) > sQty.Length) {
                return (dQty);
            }

            dTrunc = FNumberOperation.convert(sQty.substr(0, iIndex + iNumPlaces + 1));
            dRound = FConvert.roundOffToDecimalPlaces(dQty, iNumPlaces, eRoundingType.Nearest);

            if (FNumberOperation.isGreaterThan(dRound, dTrunc) == true) {
                return (dTrunc);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FConvert.batchRoundOff} " + err.message);
        }

        return (dRound);
    },

