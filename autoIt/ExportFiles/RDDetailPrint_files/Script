    GoBackToSignIn: function () {
        if (document.getElementById("idGreeting") != null) {
            var windowUrl = window.location;
            if (windowUrl.href.split('?').length > 1) {
                if (windowUrl.href.split('?')[1].includes('productid')) {
                    var params = windowUrl.href.split('?')[1].split('&');
                    if (params != null) {
                        if (params.length > 0) {
                            for (var i = 0; i < params.length; i++) {
                                if (params[i].toLowerCase().includes('productid')) {
                                    var param = params[i].split("=");
                                    if (param != null) {
                                        iFocusProductId = param[1];
                                    }
                                    else {
                                        iFocusProductId = 0;
                                    }
                                }
                            }
                        }
                    }
                    windowUrl = windowUrl.href.split('?')[0] + "?productid=" + iFocusProductId;
                } else {
                    windowUrl = windowUrl.href.split('?')[0];
                }
            }
            if (windowUrl.href != undefined) {
                if (windowUrl.href.split('#').length > 0) {
                    windowUrl = windowUrl.href.split('#')[0];
                }
            }
            else {
                if (windowUrl.split('#').length > 0) {
                    windowUrl = windowUrl.split('#')[0];
                }
            }
            window.location.href = windowUrl;
        }
    },

