    createDataRow: function (id, objArr, arrMetaData, iIndex, eleBody) {
        let sText = "";
        let iCounter = 0;
        let iCount = 0;
        let objColumnMetaData = null;
        let objData = null;
        let eleRow = null;
        let arrRow = null;

        try {
            arrRow = OPTIONCONTROL_UI.insertRows(id, 0, 1);
            if (arrRow.length < 1 || OPTIONCONTROL_HELPER.isValidObject(arrRow[0]) == false) {
                return;
            }

            eleRow = arrRow[0];
            eleRow.setAttribute("onmousedown", "OPTIONCONTROL_EVENTS.onDataRowMouseDown(this, '" + id.id + "',event);");

            iCount = 0;
            for (iCounter = 0; iCounter < objArr.length; iCounter++) {
                if (iCounter >= arrMetaData.length) {
                    continue;
                }

                iCount++;
                objData = objArr[iCounter];
                objColumnMetaData = arrMetaData[iCounter];

                OPTIONCONTROL_HELPER.setAttributeData(eleRow, objColumnMetaData.Name, objData.sValue);
                eleRow.children[iCounter].style.paddingLeft = "3px";
                eleRow.children[iCounter].style.paddingRight = "3px";

                if (OPTIONCONTROL_HELPER.isValidObject(objColumnMetaData.Align) == false) {
                    sText = "left";
                }
                else {
                    sText = objColumnMetaData.Align.toLowerCase();
                    if (sText != "center" && sText != "right") {
                        sText = "left";
                    }
                }

                eleRow.children[iCounter].style.textAlign = sText;

                OPTIONCONTROL_HELPER.setElementText(eleRow.children[iCounter], objData.sValue);
            }

            if (iCount > 0) {
                // Forcefully set masterid, and name because if it is used in mandatory fields and partial data loading is eneabled it will be set as blank
                OPTIONCONTROL_HELPER.setAttributeData(eleRow, arrMetaData[0].Name, objArr[0].sValue);

                if (iCount > 1) {
                    OPTIONCONTROL_HELPER.setAttributeData(eleRow, arrMetaData[1].Name, objArr[1].sValue);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_UI.createDataRow} " + err.message);
        }

        return (eleRow);
    },

    insertRows: function (id, iIndex, iCount) {
        let eleBody = null;
        let eleHiddenRow = null;
        let eleOrgColumn = null;
        let eleRow = null;
        let eleColumn = null;
        let eleChildColumn = null;
        let attributes = null;
        let iTotalRows = 0;
        let iColumn = 0;
        let iCounter = 0;
        let iChildCounter = 0;
        let iAttributeCounter = 0;
        let iStartIndex = 0;
        let bLast = false;
        let arrRow = null;

        try {
            arrRow = [];
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == false) {
                return (arrRow);
            }

            eleHiddenRow = OPTIONCONTROL_UI.getHiddenRow(id);
            if (DataType.isValidObject(eleHiddenRow) == false) {
                return (arrRow);
            }

            eleBody = OPTIONCONTROL_UI.getBodyElement(id);
            if (DataType.isValidObject(eleBody) == false) {
                return (arrRow);
            }

            iTotalRows = OPTIONCONTROL_INTERNAL.getTotalRows(id);

            bLast = false;
            if (OPTIONCONTROL_HELPER.isValidObject(iIndex) == true) {
                iIndex = OPTIONCONTROL_HELPER.toInt(iIndex);
                if (iIndex < 1 || iIndex > iTotalRows) {
                    bLast = true;
                    iStartIndex = iTotalRows;
                }
                else {
                    iStartIndex = (iIndex - 1);
                    bLast = false;
                }
            }
            else {
                bLast = true;
                iStartIndex = iTotalRows;
            }

            iCount = OPTIONCONTROL_HELPER.toInt(iCount);
            if (iCount <= 0) {
                iCount = 1;
            }

