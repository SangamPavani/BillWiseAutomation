    getDataFromBuffer: function (pageNo, uniqueId) {
        ////debugger
        var data = null;
        var iSkipRow = 0;
        var iCount = 0
        var bEndOfFile = false;
        var iMaxPage = -1
        var rowsPerPage = 0;
        var arrAllData = [];
        var arrPageData = [];

        if (m_reportData[uniqueId] != null && m_reportData[uniqueId].LineData != null) {
            arrAllData = m_reportData[uniqueId].LineData;
            bEndOfFile = m_reportData[uniqueId].EndOfFile;
            rowsPerPage = parseInt(document.getElementById("rowsPerPage_" + uniqueId).getAttribute("data-value"));
            iMaxPage = REPORTRENDERNEW.getMaxPage(sUniqueId, rowsPerPage);// document.getElementById("endoffile_" +sUniqueId) != null ? document.getElementById("endoffile_" +sUniqueId).getAttribute("data-maxPage"): null;
            lstColumns = m_reportData[uniqueId].Columns;
            arrHiddenColumns = m_reportData[uniqueId].HiddenColumns;
        }
        rowsPerPage = document.getElementById("rowsPerPage_" + uniqueId)!=null?parseInt(document.getElementById("rowsPerPage_" + uniqueId).getAttribute("data-value")):0;
        if (arrAllData != null && rowsPerPage > 0)
        {
            if(iSkipRow < arrAllData.length){
                iSkipRow = rowsPerPage * pageNo;
            }
            else if (bEndOfFile == true && iSkipRow > arrAllData.length) {
                iSkipRow -= rowsPerPage;
            }
            srnoIndex = iSkipRow + 1;
            for (iCount = 0; iSkipRow < arrAllData.length && iCount < rowsPerPage; iSkipRow++, iCount++) {
                arrPageData.push(arrAllData[iSkipRow]);
            }
            if (bEndOfFile == false && arrPageData.length < rowsPerPage && pageNo > 0) {
                arrPageData = [];
            }
            if (arrPageData.length > 0) {
                data = arrPageData;
            }
        }
        return data;
    },

