    DisplayList: function (ele) {
        var NavbarHeaderHeight = 59;
        // It closes the quick access menu
        //document.getElementsByClassName("quickaccess")[0].className = "dropdown quickaccess";
        if (ele.parentNode.children[1] != undefined) {
            $(ele).parent().parent().find("ul.showsubmenu").removeClass("showsubmenu");
            ele.parentNode.children[1].classList.add('showsubmenu');
            $(ele).parent().parent().find(".showsubmenu").css('right', '100%');
        }
        if (ele.parentNode.className != "treeview openMenu") {
            // Hide all other sub menus
            $(ele).parent().parent().find("li.openMenu").removeClass("openMenu");
            // Displays clicked menu detail
            ele.parentNode.className = ele.parentNode.className + " openMenu";
            if (ele.nextElementSibling.getBoundingClientRect().height > window.screen.height - 300) {
                // 150 Extra Taken due to Padding in Menu Items
                if (document.getElementById('id_left_mainmenu').style.width > "85px" || document.getElementById('id_left_mainmenu').style.width == '') {
                    if (((ele.nextElementSibling.getBoundingClientRect().height - 150) - ele.getBoundingClientRect().height) < ele.getBoundingClientRect().top - ele.parentNode.parentNode.getBoundingClientRect().top + NavbarHeaderHeight) {
                        ele.nextElementSibling.style.top = (-1) * (ele.getBoundingClientRect().top - ele.getBoundingClientRect().height - ele.parentNode.parentNode.getBoundingClientRect().top) + "px";
                    }
                } else {
                    ele.nextElementSibling.style.top = (-1) * (ele.getBoundingClientRect().top - ele.getBoundingClientRect().height - ele.parentNode.parentNode.getBoundingClientRect().top) + "px";
                }
            }
        }
        else {
            // Hides other main menu which is opened
            ele.parentNode.className = "treeview";
        }

    },

