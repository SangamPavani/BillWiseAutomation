        processCellClick: function (cell, evt) {
            let sHandler = "";
            let iRow = 0;
            let iColumn = 0;
            let bResult = false;
            let gridElement = undefined;
            let result = undefined;

            try {
                gridElement = FGRIDCONTROL.getGridElementFromCell(cell);
                if (DataType.isValidObject(gridElement) == true) {
                    iRow = FGRIDCONTROL.getCurrentRow(gridElement);
                    iColumn = FGRIDCONTROL.getCurrentColumn(gridElement);

                    bResult = FGRIDCONTROL.PRIVATE.onLeaveCell(gridElement, evt); // Calling leave cell

                    if (bResult == false) {
                        cell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iRow, iColumn);
                    }
                    else // if (iRow > 0)
                    { // If last row is valid
                        sHandler = FGRIDCONTROL.PRIVATE.getAfterLeaveHandler(gridElement);
                        if (DataType.isNullOrEmpty(sHandler, true) == false) {
                            eval(sHandler)({ gridElement: gridElement, iRow: iRow, iColumn: iColumn, bCellClick: true }, evt);
                        }

                        result = FGRIDCONTROL.getRowColumnFromElement(gridElement, cell);
                        if (DataType.isValidObject(result) == true
                            && FGRIDCONTROL.isValidRowIndex(gridElement, result.iRow) == true
                            && FGRIDCONTROL.isValidColumnIndex(gridElement, result.iColumn) == true
                            && iRow !== result.iRow) {
                            bResult = FGRIDCONTROL.onRowChange(FGRIDCONTROL.PRIVATE.getChangeRowObject(gridElement, iRow, result.iRow), evt);
                            if (iRow > 0 && (DataType.isValidObject(bResult) == false || eval(bResult) == false)) {
                                cell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iRow, iColumn);
                            }
                        }
                    }

                    FGRIDCONTROL.PRIVATE.onEnterCell(gridElement, cell, evt, true); // Calling Enter cell
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.processCellClick} " + err.message);
            }
        },

