            if (rtnValuesBillSettlement.bSuccess == true) {
                RETAILMAIN.closePopup('#divBillSettlementModal');

                if (rtnValuesBillSettlement.result[5] != null && rtnValuesBillSettlement.result[5] != undefined)
                    VOUCHERPOSTING.VARIABLES.TransactionStatus = rtnValuesBillSettlement.result[5];

                VOUCHERPOSTING.VARIABLES.MasterFieldData = rtnValuesBillSettlement.result[9];
                VOUCHERPOSTING.VARIABLES.LocalPOSDate = ApplicationNew.LocalPosDate;
                VOUCHERPOSTING.VARIABLES.LocalPOSTime = ApplicationNew.LocalPosTime;
                VOUCHERPOSTING.VARIABLES.IsFromJS = true;
                ApplicationNew.RetailTransFooter.ExternalHeaderExtraFieldsResponse = [];
                addProductToGridObject.printObject = ApplicationNew;

                toastr.success(voucherPostedSuccesfully, msgPOSInformation);

                // PRE ORDER LOCAL STORAGE
                debugger;
                RETAILMAIN.setLocalStorgaePOSSchemesData(POSCommon.companyId, POSCommon.outletId, true);
                RETAILMAIN.clearPreValidSchemes();
                RETAILMAIN.getLocalStoragePOSSchemesData([POSCommon.companyId, POSCommon.outletId, false]);

                if (PRINTERDIALOG.VARIABLE.isCustomPrinting == false && PreferenceSetting.PrefOutletTab.OutletGeneralTab.AskForConfirmationBeforePrinting == true)
                {
                    const messageInfoPopup = POSDATASTRUCTURE.getEmptyMessageInfoPopup();
