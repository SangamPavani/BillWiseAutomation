        calculateExtraVerticalHeight: function (ele) {
            var sComputedStyle = "";
            var sValue = "";
            var iMarginTop = 0;
            var iMarginBottom = 0;
            var iPaddingTop = 0;
            var iPaddingBottom = 0;
            var iValue = 0;

            try {

                if (DataType.isValidObject(ele) == true) {
                    if (window.getComputedStyle) {
                        sComputedStyle = window.getComputedStyle(ele, null).marginTop;
                    }
                    else {
                        sComputedStyle = ele.currentStyle;
                    }
                    sValue = sComputedStyle.toLowerCase().replace("px", "");
                    if (COMMON.prototype.isInteger(sValue) == true) {
                        iValue = parseInt(sValue);
                    }

                    ele = ele.parentElement;
                }

                while (DataType.isValidObject(ele) == true) {
                    iMarginTop = 0;
                    iMarginBottom = 0;
                    iPaddingTop = 0;
                    iPaddingBottom = 0;

                    if (window.getComputedStyle) {
                        sComputedStyle = window.getComputedStyle(ele, null).marginTop;
                    }
                    else {
                        sComputedStyle = ele.currentStyle;
                    }
                    sValue = sComputedStyle.toLowerCase().replace("px", "");
                    if (COMMON.prototype.isInteger(sValue) == true) {
                        iMarginTop = parseInt(sValue);
                    }

                    if (window.getComputedStyle) {
                        sComputedStyle = window.getComputedStyle(ele, null).marginBottom;
                    }
                    else {
                        sComputedStyle = ele.currentStyle;
                    }
                    sValue = sComputedStyle.toLowerCase().replace("px", "");
                    if (COMMON.prototype.isInteger(sValue) == true) {
                        iMarginBottom = parseInt(sValue);
                    }


                    if (window.getComputedStyle) {
                        sComputedStyle = window.getComputedStyle(ele, null).paddingTop;
                    }
                    else {
                        sComputedStyle = ele.currentStyle;
                    }
                    sValue = sComputedStyle.toLowerCase().replace("px", "");
                    if (COMMON.prototype.isInteger(sValue) == true) {
                        iPaddingTop = parseInt(sValue);
                    }

                    if (window.getComputedStyle) {
                        sComputedStyle = window.getComputedStyle(ele, null).paddingBottom;
                    }
                    else {
                        sComputedStyle = ele.currentStyle;
                    }
                    sValue = sComputedStyle.toLowerCase().replace("px", "");
                    if (COMMON.prototype.isInteger(sValue) == true) {
                        iPaddingBottom = parseInt(sValue);
                    }

                    var sClassName = ele.className;
                    iValue += iMarginTop + iMarginBottom + iPaddingTop + iPaddingBottom;

                    ele = ele.parentElement;
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.UI.calculateExtraVerticalHeight} " + err.message, "Exception");
            }

            return (iValue);
        },

