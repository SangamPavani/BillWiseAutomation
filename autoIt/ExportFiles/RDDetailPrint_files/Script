                        var lastfinenddate = 0;

                        if (iDay1 == 1) {
                            if (iMonth1 == 1) {
                                iMonth1 = 12;
                                cYear = iYear1 - 1;
                            }
                            else {
                                iMonth1 = iMonth1 - 1;
                            }
                            iDay1 = REPORTVIEW.getLastDayoftheMonth(iMonth1);
                        }
                        else {
                            iDay1 = iDay1 - 1;
                        }

                        if (today.getFullYear() - iYear >= 2) {
                            cYear = today.getFullYear() - 1;
                            lastfinenddate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, cYear);
                        } else {
