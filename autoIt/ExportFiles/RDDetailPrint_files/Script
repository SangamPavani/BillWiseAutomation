    setAttributeData: function (id, key, value) {
        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
            if (OPTIONCONTROL_HELPER.isValidObject(id) == false) {
                return;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(key) == false) {
                return;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(value) == true) {
                key = key.replace(/\s+/g, ''); // Remove space
                id.setAttribute(key, value);
            }
            else {
                if (OPTIONCONTROL_HELPER.isValidObject(key) == true && Array.isArray(key) == true) {
                    OPTIONCONTROL_HELPER.createAttributesFromArray(id, key);
                }
                else if ((typeof key).toLowerCase() == "object" && key != null) {
                    OPTIONCONTROL_HELPER.createAttributesFromObject(id, key);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL.setAttributeData} " + err.message);
        }
    },

    getAttributeData: function (id, key, iDataTypeId) {
        let value;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
            if (OPTIONCONTROL_HELPER.isValidObject(id) == true && OPTIONCONTROL_HELPER.hasDataAttribute(id, key, false) == true) {
                value = id.getAttribute(key);
            }

            if (OPTIONCONTROL_HELPER.isValidObject(iDataTypeId) == false) {
                return (value);
            }

            switch(iDataTypeId)
            {
                case eMasterDataType.Text:
                    value = OPTIONCONTROL_HELPER.toString(value);
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                case eMasterDataType.BigNumber:
                    value = OPTIONCONTROL_HELPER.toInt(value);
                    break;
                case eMasterDataType.Boolean:
                    value = OPTIONCONTROL_HELPER.toBoolean(value);
                    break;
                default:
                    value = OPTIONCONTROL_HELPER.toString(value);
                    break;
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {OPTIONCONTROL.getAttributeData} " + err.message);
        }

        return (value);
    },

    isValidStoredData: function (id, key) {
        let iCompareValueIndex = 0;
        let arrData = null;
        let obj = null;

        try {
            arrData = OPTIONCONTROL_DATA.getMemoryData(id);
            if (arrData.length == 0) {
                return (true);
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(key) == true) {
                return (false);
            }

            iCompareValueIndex = OPTIONCONTROL_INTERNAL.getCompareValueIndex(id);
            obj = arrData[0];
            if (OPTIONCONTROL_HELPER.isValidObject(obj) == false || obj.length <= iCompareValueIndex) {
                return (false);
            }

            if (OPTIONCONTROL_HELPER.isNullOrEmpty(obj[iCompareValueIndex].sValue) == true) {
                return (false);
            }

            if (OPTIONCONTROL_HELPER.compareValue(key, obj[iCompareValueIndex].sValue, true, 1) == 0) {
                return (true);
            }
        }
        catch (err) {
            err.message = "Exception: {isValidStoredData} " + err.message;
            throw err;
        }

        return (false);
    },

