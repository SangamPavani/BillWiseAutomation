                            element.setAttribute("data-ascending", "true");
                            break;
                    }
                }
                iDataSource = parseInt(element.getAttribute("data-source"));
                iFieldId = parseInt(element.getAttribute("data-fieldid"));
                iParentId = parseInt(element.getAttribute("data-parentid"));
                iSubParentId = parseInt(element.getAttribute("data-subparentid"));
                iDataTypeId = parseInt(element.getAttribute("data-datatypeid"));
                bAscending = eval(element.getAttribute("data-ascending"));

                switch (iDataSource) {
                    case 1: // Cube Row Grouping Fields
                        for (iIndex = 0; iIndex < RD_ENTRY.m_arrRowGrouping.length; iIndex++) {
                            obj = RD_ENTRY.m_arrRowGrouping[iIndex];
                            if (obj.iFieldId == iFieldId
                                && obj.iParentId == iParentId
                                && obj.iSubParentId == iSubParentId
                                && obj.iDataTypeId == iDataTypeId) {
                                if (bClear == true) {
                                    obj.ColumnOrder = null;
                                }
                                else {
                                    obj.ColumnOrder = RD_ENTRY.DATA.getEmptyColumnOrderObject();
                                    obj.ColumnOrder.IsAscending = bAscending;
                                    obj.ColumnOrder.OrderBy = 0;
                                    obj.ColumnOrder.OrderId = iCounter;
                                }

                                RD_ENTRY.m_arrRowGrouping[iIndex] = obj;
                                break;
                            }
                        }
                        break;
                    case 2: // Cube column group by
                        for (iIndex = 0; iIndex < RD_ENTRY.m_arrColumnGroupBy.length; iIndex++) {
                            obj = RD_ENTRY.m_arrColumnGroupBy[iIndex];
                            if (obj.iFieldId == iFieldId
                                && obj.iParentId == iParentId
                                && obj.iSubParentId == iSubParentId
                                && obj.iDataTypeId == iDataTypeId) {
                                if (bClear == true) {
                                    obj.ColumnOrder = null;
                                }
                                else {
                                    obj.ColumnOrder = RD_ENTRY.DATA.getEmptyColumnOrderObject();
                                    obj.ColumnOrder.IsAscending = bAscending;
                                    obj.ColumnOrder.OrderBy = 0;
                                    obj.ColumnOrder.OrderId = iCounter;
                                }
                                RD_ENTRY.m_arrColumnGroupBy[iIndex] = obj;
                                break;
                            }
                        }
                        break;
                    case 3: // Cube column measure
                        for (iIndex = 0; iIndex < RD_ENTRY.m_arrColumnMeasure.length; iIndex++) {
                            obj = RD_ENTRY.m_arrColumnMeasure[iIndex];
                            if (obj.iFieldId == iFieldId
                                && obj.iParentId == iParentId
                                && obj.iSubParentId == iSubParentId
                                && obj.iDataTypeId == iDataTypeId) {
                                if (bClear == true) {
                                    obj.Column.ColumnOrder = null;
                                }
                                else {
                                    obj.Column.ColumnOrder = RD_ENTRY.DATA.getEmptyColumnOrderObject();
                                    obj.Column.ColumnOrder.IsAscending = bAscending;
                                    obj.Column.ColumnOrder.OrderBy = 0;
                                    obj.Column.ColumnOrder.OrderId = iCounter;
                                }
                                RD_ENTRY.m_arrColumnMeasure[iIndex] = obj;
                                break;
                            }
                        }
                        break;
                    default:
                        for (iIndex = 0; iIndex < RD_ENTRY.m_arrCustomizeColumn.length; iIndex++) {
                            obj = RD_ENTRY.m_arrCustomizeColumn[iIndex];
                            if (obj.iFieldId == iFieldId
                                && obj.iParentId == iParentId
                                && obj.iSubParentId == iSubParentId
                                && obj.iDataTypeId == iDataTypeId) {
                                if (bClear == true) {
                                    obj.Column.ColumnOrder = null;
                                }
                                else {
                                    obj.Column.ColumnOrder = RD_ENTRY.DATA.getEmptyColumnOrderObject();
                                    obj.Column.ColumnOrder.IsAscending = bAscending;
                                    obj.Column.ColumnOrder.OrderBy = 0;
                                    obj.Column.ColumnOrder.OrderId = iCounter;
                                }
                                RD_ENTRY.m_arrCustomizeColumn[iIndex] = obj;
                                break;
                            }
                        }
                        break;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.SORTING.updateSortingData} " + err.message, "Exception");
        }

    },

    moveSortingElement: function (eleLi) {

        try {
            if (eleLi.parentElement.id == RD_ENTRY.CUSTOMIZATION.SORTING.getSortingSourceListElement().id) {
                RD_ENTRY.CUSTOMIZATION.SORTING.getSortingTargetListElement().appendChild(eleLi);
            }
            else {
                eleLi.setAttribute("data-ascending", true);
                FUIElement.setElementText(eleLi, eleLi.getAttribute("data-name"));
                RD_ENTRY.CUSTOMIZATION.SORTING.getSortingSourceListElement().appendChild(eleLi);
            }
