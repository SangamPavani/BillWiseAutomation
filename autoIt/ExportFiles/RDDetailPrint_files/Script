    createGraph: function (sId, objData, sChartType) {

        try {
            var obj = {};
            var iCounter = 0;
            var result = null;
            var arr = null;
            var prop = [];
            var val = [];

            obj.bindto = sId;
            //obj.color= {pattern: ['#34c4f9']};
            obj.bar = { width: { ratio: 1 } };
            obj.tooltip = { show: true };
            obj.axis = {
                x: {
                    label: { // ADD
                        text: 'Particulars',
                        position: 'outer-center'
                    }
                }
            }
            obj.data = {};
            obj.data.columns = [];
            obj.data.type = sChartType;
            if (objData) {
                for (var i = 0; i < objData.length; i++) {
                    result = COMMON.prototype.getObjectPropertyValueArray(objData[i], true);
                    for (var j = 0; j < result.property.length; j++) {
                        for (var k = 0; k < prop.length; k++) {
                            if (prop[k] == result.property[j]) {
                                val[k] = val[k] + "," + result.value[j];
                                break;
                            }
                        }
                        if (k >= prop.length) {
                            prop.push(result.property[j]);
                            val.push(result.value[j].toString());
                        }
                    }
                }
            }

            for (iCounter = 0; iCounter < prop.length; iCounter++) {
                arr = [];
                var arrValues = val[iCounter].split(",");
                obj.data.columns.push(arr);
                obj.data.columns[iCounter].push(prop[iCounter]);
                for (var i = 0; i < arrValues.length; i++) {
                    obj.data.columns[iCounter].push(parseInt(arrValues[i]));
                }
            }
            if ((sChartType.toLowerCase() == 'line' || sChartType.toLowerCase() == 'area') && obj.data.columns.length > 1) {
                var Columns = obj.data.columns;
                for (var i = 0; i < Columns.length; i++) {
                    var tempArr = new Array(Columns.length + 1);
                    for (var j = 0; j < tempArr.length; j++) {
                        tempArr[j] = 0;
                    }
                    tempArr.splice(0, 1, Columns[i][0]);
                    tempArr.splice((i + 1), 1, Columns[i][1]);
                    Columns[i] = tempArr;
                }
                obj.data.columns = Columns;
            }


            if (obj.data.columns.length > 50) {
                var chart = c3.generate(obj);
                $(".c3-chart-arc path, .c3 path, .c3 line").css("stroke", "transparent");
                setTimeout(function () {
                    chart.resize({ height: 400, width: 1000 })
                }, 10);
                chart.legend.hide();
            }
            else {
                c3.generate(obj);
            }
            if (sId == "#analyzeGraph") {
                var button = document.createElement("button");
                if (bGraphMaximized) {
                    button.innerHTML = "Minimize";
                }
                else {
                    button.innerHTML = "Maximize";
                }
                bGraphMaximized = false;
                button.setAttribute("onclick", "ANALYZE.openGraphView(this)");
                button.setAttribute("id", "btnMax");
                button.style.marginLeft = "40%";
                document.getElementById("analyzeGraph").appendChild(button);
            }
            //c3.generate(obj);
        }
        catch (err) {
            alert("Exception: {ANALYZE.createGraph} " + err.message);
        }
    },

