var UIContainer = {
    getContainer: function (pageContainerType) {
        var eleContainer = null;

        try {
            if (FCommon.UI.isValidObject(pageContainerType) == true) {
                switch (pageContainerType) {
                    case ePageContainerType.Default:
                        eleContainer = UIContainer.getDefaultContainer();
                        break;
