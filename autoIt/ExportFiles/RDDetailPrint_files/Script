    onLoadToDocument_Click: function (id, evt) {
        let sCallback = "";
        let iTotalRows = 0;
        let iRow = 0;
        let iMasterId = 0;
        let dQty = 0;
        let dMaxQty = 0;
        let arrSelectedMasterId = null;
        let arrQty = null;
        let objModelData = null;
        let eleGrid = null;
        let objExtra = undefined;
        let cell = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            objModelData = OPTIONCONTROL_ADVSEARCH.getModelData(id);
            if (DataType.isValidObject(objModelData) == false) {
                return;
            }

            eleGrid = document.getElementById(id.id + "_grid");
            if (OPTIONCONTROL_HELPER.isValidObject(eleGrid) == false) {
                return;
            }

            FGRIDCONTROL.update(eleGrid);

            arrSelectedMasterId = [];
            arrQty = [];
            iTotalRows = FGRIDCONTROL.getTotalRows(eleGrid);
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 1);
                if (cell.cell.children[0].checked == true) {
                    cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 2);
                    iMasterId = OPTIONCONTROL_HELPER.toInt(cell.getCellData());

                    cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 7);
                    dQty = DataType.toDecimal(cell.getCellData());

                    if (DataType.gt(dQty, 0) == false) {
                        continue;
                    }

                    if (objModelData.LoadItemsWithNoSotck == false && objModelData.bOutward == true) {
                        if (objModelData.bCheckOverallQty == true) {
                            cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 6); // Bal Qty OverAll
                            dMaxQty = DataType.toDecimal(cell.getCellData());
                        }
                        else { // Warehousewise balance qty
                            cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 5); // Bal Qty By Warehouse
                            dMaxQty = DataType.toDecimal(cell.getCellData());
                        }

                        if (dMaxQty == 0 || dQty > dMaxQty) {
                            continue;
                        }
                    }

                    arrSelectedMasterId.push(iMasterId);
                    arrQty.push(dQty);
                }
            }

            if (arrSelectedMasterId.length > 0) {
                objExtra = OPTIONCONTROL.createSetValueExtraObject();
                objExtra.bIgnoreChangeCallback = (arrSelectedMasterId.length > 1);
                OPTIONCONTROL.setValue(objModelData.Id, arrSelectedMasterId[0], { AdvanceSearchQty: [arrQty[0]] }, objExtra);
                OPTIONCONTROL_ADVSEARCH.onClose_Click(objModelData.Id, evt);

                arrSelectedMasterId.splice(0, 1); // Remove first id it is already processed above
                arrQty.splice(0, 1); // Remove first id it is already processed above
                if (arrSelectedMasterId.length > 0) {
                    sCallback = OPTIONCONTROL.getAttributeData(objModelData.Id, eOptionControlDataAttribute.MultipleSelectedSearchCallback, eMasterDataType.Text);
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                        eval(sCallback)(objModelData.Id, arrSelectedMasterId, evt, arrQty);
                    }
                }
            }
            else {
                COMMON.prototype.showMessage("Either no item is selected or input qty is zero for selected row or input qty is less than available qty.", document.getElementById("id_resource_message_error").value);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_ADVSEARCH.onLoadToDocument_Click} " + err.message)
        }
    },

