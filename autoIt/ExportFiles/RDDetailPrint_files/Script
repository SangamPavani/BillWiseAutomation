    //Code added by Lalitha  on 21st Aug  2019..Changing SubTotal and GrandTotal Values in Persian Language..
    ConvertEnglishDigitsToPersian: function (ele) {
        //////debugger
        var text = undefined;
        var data = [];
        var persianData = [];
        var data2 = undefined;
        var returndata = "", symbolMap = { '1': '۱', '2': '۲', '3': '۳', '4': '۴', '5': '۵', '6': '۶', '7': '۷', '8': '۸', '9': '۹', '0': '۰' };

        if (ele.innerText != undefined) {
            text = ele.innerText;
            data.push(text);
        }
        for (var j = 0; j < data.length; j++)
            if (data[j] != "") {
                returndata = '';
                for (var k = 0; k < data[j].length; k++) {
                    var str = data[j].charAt(k);
                    if (symbolMap[str]) {
                        for (var n = 0; n < data[j].length; n++) {
                            var str2 = data[j].charAt(n);
                            if (str2 == ',' || str2 == '.') {
                                returndata += str2;
                            }
                            else {
                                returndata += symbolMap[str2];
                            }
                        }
                        persianData.push(returndata)
                        break;
                    }
                    else {
                        data2 = data[j];
                        persianData.push(data2);
                        break;
                    }
                }
            }
            else {
                persianData.push(data[j]);
            }
        return persianData;
    },

