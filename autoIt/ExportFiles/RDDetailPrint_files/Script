            if (DataType.isValidObject(eleSelected) == true) {
                RD_ENTRY.CUSTOMIZATION.SORTING.moveSortingElement(eleSelected);
                RD_ENTRY.CUSTOMIZATION.SORTING.unselectSortingDataElement(eleSelected);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.SORTING.onMoveElement_Click} " + err.message, "Exception");
        }
    }
