        getCellObject: function (eleFragment, iRow, iColumn, eleGrid) {
            let obj = null;
            let ele = null;

            try {
                ele = FGRIDCONTROL.FRAGMENT.getCellElement(eleFragment, iRow, iColumn);
                if (DataType.isValidObject(ele) == false) {
                    return;
                }


                obj = {};
                obj.Grid = FUIElement.getValidElement(eleGrid);
                obj.cell = ele;
                obj.iRow = iRow;
                obj.iColumn = iColumn;
                obj.bHidden = false;
                if (DataType.isNullOrEmpty(ele.style.display) == false) {
                    if (ele.style.display.toLowerCase() == "none") {
                        obj.bHidden = true;
                    }
                }
                obj.sText = $(ele).text();
                obj.ColumnAttribute = FGRIDCONTROL.getHeadingDataObject(obj.Grid, iColumn);
                obj.ContainerAttribute = FGRIDCONTROL.getContainerDataObject(obj.Grid, iColumn);
                obj.bMultiline = obj.ContainerAttribute.bMultiline;
                obj.iMaxHeight = obj.ContainerAttribute.iMaxHeight;
                obj.CellData = FUIElement.getObjectFromDataAttribute(ele);
                obj.setCellText = function (sText, data, bIgnoreCallback) {
                    let obj = null;

                    bIgnoreCallback = DataType.toBoolean(bIgnoreCallback);
                    obj = FGRIDCONTROL.setCellText(this.cell,
                                                    sText,
                                                    bIgnoreCallback,
                                                    this.bMultiline,
                                                    this.iMaxHeight);
                    if (DataType.isValidObject(data) == true) {
                        this.setCellData(data, undefined, bIgnoreCallback);
                    }

                    return (obj.OldText);
                };
                obj.setCellHtml = function(sHtml) {
                    FGRIDCONTROL.setCellHtml(this.cell, sHtml);
                };
                obj.getCellText = function () {
                    return (FGRIDCONTROL.getCellText(this.cell));
                };
                obj.setCellData = function (key, sValue, bIgnoreCallback) {
                    if (DataType.isValidObject(key) == false) {
                        this.resetCellData();
                        return;
                    }

                    bIgnoreCallback = DataType.toBoolean(bIgnoreCallback);
                    if (DataType.isValidObject(sValue) == false) {
                        if (DataType.isArray(key) == true) {
                            this.resetCellData();
                            FCommon.UI.createAttributesFromArray(this.cell, key);
                        }
                        else if (DataType.isObject(key) == true) {
                            this.resetCellData();
                            FCommon.UI.createAttributesFromObject(this.cell, key);
                        }
                        else {
                            return (FGRIDCONTROL.setCellData(this.cell, "value", key, bIgnoreCallback));
                        }
                    }
                    else {
                        return (FGRIDCONTROL.setCellData(this.cell, key, sValue, bIgnoreCallback));
                    }
                };
                obj.hasDataAttribute = function (sKey) {
                    return (FUIElement.hasDataAttribute(this.cell, sKey));
                };
                obj.getCellData = function (sKey) {
                    if (DataType.isNullOrEmpty(sKey) == true) {
                        return (FGRIDCONTROL.getCellData(this.cell, "value"));
                    }

                    return (FGRIDCONTROL.getCellData(this.cell, sKey));
                };
                obj.resetCellData = function (key) {
                    FGRIDCONTROL.resetCellData(this.cell, key);
                };
                obj.clear = function () {
                    try {
                        FGRIDCONTROL.setCellText(this.cell, "", false, this.bMultiline, this.iMaxHeight);
                        this.resetCellData();
                    }
                    catch (err) {
                        FUIElement.showAlert("Exception:  {FGRIDCONTROL::cellobj.clear} " + err.message);
                    }
                };
                obj.hasControl = function () {
                    let bResult = false;

                    if (DataType.isValidObject(this.cell) == true && this.cell.children.length > 0) {
                        bResult = true;
                    }

                    return (bResult);
                };
                obj.getControl = function () {
                    let ele = null;

                    if (DataType.isValidObject(this.cell) == true && this.cell.children.length > 0) {
                        ele = this.cell.children[0];
                    }

                    return (ele);
                };
                obj.setControl = function (element, value, data) {
                    let bFlag = false;

                    this.setCellText("", undefined, true);

                    element = FUIElement.getValidElement(element);
                    if (DataType.isValidObject(element) == false) {
                        return;
                    }

                    if ($(element).hasClass(OPTIONCONTROL.getClassName()) == true) {
                        OPTIONCONTROL.setParent(element, this.cell, true);
                        if (DataType.isValidObject(value) == true) {
                            if (value > 0) {
                                OPTIONCONTROL.setControlValue(element, value, null, null, true);
                                bFlag = true;
                            }
                        }

                        if (bFlag == false) {
