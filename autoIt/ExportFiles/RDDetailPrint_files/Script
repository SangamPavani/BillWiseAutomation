        return (sId);
    }
};

var OPTIONCONTROL_SEARCH = {
    processSearch: function (id, sInputText, evt) {
        let sURL = "";
        let iMasterTypeId = 0;
        let objInput = null;
        let obj = null;

        try {
            if (OPTIONCONTROL.getControlType(id) != eWebOptionControlType.Masters) {
                return;
            }

            obj = {};
            obj.id = id;

            iMasterTypeId = OPTIONCONTROL.getMasterTypeId(id);
            if (iMasterTypeId == eMasterTypeId.Product && evt.shiftKey == true) {
                OPTIONCONTROL_ADVSEARCH.processSearch(id, iMasterTypeId, sInputText);
                return;
            }

            sURL = eOptionControlDataAttribute.getSearchUIURL(id);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sURL, true) == true) {
                return;
            }

            objInput = {};
            objInput.sId = id.id;
            objInput.iMasterTypeId = iMasterTypeId;
            objInput.sInputText = sInputText;
            objInput.bMultipleSelectSearch = eOptionControlDataAttribute.isMultipleSelectSearch(id);

            OPTIONCONTROL_SERVER.executeServerMethod(sURL,
                                                        true,
                                                        objInput,
                                                        "html",
                                                        true,
                                                        "OPTIONCONTROL_SEARCH.PRIVATE.callbackShowPopup",
                                                        "GLOBAL.LoadingStart",
                                                        "GLOBAL.LoadingEnd",
                                                        obj);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_SEARCH.processSearch} " + err.message);
        }
