    setCellText: function (cell, sText, bIgnoreCallback, bMultiline, iMaxHeight, bIgnoreDelay) {
        let sHandler = "";
        let ele = null;
        let arrEle = null;
        let obj = null;
        let objResult = null;

        try {
            objResult = {};
            objResult.OldText = FGRIDCONTROL.getCellText(cell);
            objResult.eleChild = null;

            bIgnoreCallback = DataType.toBoolean(bIgnoreCallback);
            bMultiline = DataType.toBoolean(bMultiline);
            iMaxHeight = DataType.toInt(iMaxHeight);

            if (cell.children.length == 0) {  // If cell does not has any child element
                if (DataType.isNullOrEmpty(sText) == false && bMultiline == true) {
                    FUIElement.setText(cell, "");
                    ele = FGRIDCONTROL.PRIVATE.createMultilineElement(iMaxHeight);
                    cell.appendChild(ele);
                    $(ele).text(sText);
                }
                else {
                    $(cell).text(sText);
                }                
            }
            else if (cell.children[0].children.length == 0) {
                objResult.eleChild = cell.children[0];

                if (DataType.isNullOrEmpty(sText) == false && bMultiline == true) {
                    FUIElement.setText(cell.children[0], "");
                    ele = cell.children[0];
                    FUIElement.setText(ele, sText);
                }
                else {
                    FUIElement.setText(cell.children[0], sText);
                }                
            }
            else {                
                arrEle = cell.children[0].getElementsByClassName(OPTIONCONTROL.getClassName());
                if (arrEle.length > 0) {
                    FUIElement.setDelayText(arrEle[0], sText, bIgnoreDelay);
                }
                else {
                    arrEle = cell.children[0].getElementsByClassName(FHyperLink.getClassName());
                    if (arrEle.length > 0) {
                        FUIElement.setDelayText(arrEle[0], sText, bIgnoreDelay);
                    }
                }
            }


            if (bIgnoreCallback == false) {
                sHandler = FGRIDCONTROL.PRIVATE.getCellTextSetHandler(FGRIDCONTROL.getGridElementFromCell(cell));
                if (DataType.isNullOrEmpty(sHandler, true) == false) {
                    obj = {};
                    obj.OldValue = objResult.OldText;
                    obj.Value = sText;
                    obj.iRow = FGRIDCONTROL.getRowNoFromRowElement(cell.parentElement);
                    obj.iColumn = FUIElement.getPosition(cell) - 1;
                    obj.Cell = FGRIDCONTROL.PRIVATE.getCellObjectInternal(cell, obj.iRow, obj.iColumn, false);
                    obj.ChangeType = "text";

                    eval(sHandler)(obj);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.setCellText} " + err.message);
        }

        return (objResult);
    },

