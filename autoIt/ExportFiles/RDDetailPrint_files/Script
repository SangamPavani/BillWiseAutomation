    getLastDayoftheMonth: function (iMonth, iYear) {
        var iDay1 = 0;
        switch (iMonth) {
            case 1:
                iDay1 = 31;
                break;
            case 2:
                if ((iYear % 4) == 0) {
                    iDay1 = 29;
                }
                else {
                    iDay1 = 28;
                }
                break;
            case 3:
                iDay1 = 31;
                break;
            case 4:
                iDay1 = 30;
                break;
            case 5:
                iDay1 = 31;
                break;
            case 6:
                iDay1 = 30;
                break;
            case 7:
                iDay1 = 31;
                break;
            case 8:
                iDay1 = 31;
                break;
            case 9:
                iDay1 = 30;
                break;
            case 10:
                iDay1 = 31;
                break;
            case 11:
                iDay1 = 30;
                break;
            case 12:
                iDay1 = 31;
                break;
        }
        return iDay1;
    },

