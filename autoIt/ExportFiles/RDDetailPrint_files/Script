        }

        if ((typeof value).toLowerCase() == "string") {
            temp = "";
            for (iCounter = 0; iCounter < value.length; iCounter++) {
                iAscValue = value.charCodeAt(iCounter);
                if (iAscValue >= 48 && iAscValue <= 57) {
