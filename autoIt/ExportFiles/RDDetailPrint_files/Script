    hasMandatoryField: function (id, sFieldName) {
        let sMandatoryFields = "";
        let iCounter = 0;
        let arrFields = null;

        try {
            sMandatoryFields = OPTIONCONTROL.getMandatoryFields(id);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sMandatoryFields, true) == true) {
