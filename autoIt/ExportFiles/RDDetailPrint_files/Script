    close: function (id) {
        let eleContainer = null;
        let elePopup = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
            if (DataType.isValidObject(id) == false) {
                return;
            }

            elePopup = OPTIONCONTROL_SEARCH.PRIVATE.getPopupElement(id.id);
