            try {
                id = FUIElement.getValidElement(id);
                if (DataType.isValidObject(id) == false) {
                    return;
                }

                iTotalPages = FPAGECONTROL.getTotalPages(id);
                if (iTotalPages < 1) {
                    return;
                }

                iPage = DataType.toInt(iPage);
                if (iPage < 1) {
                    return;
                }

                if (iPage > iTotalPages) {
                    return;
                }

                FUIElement.setAttribute(id, "currentpage", iPage);
                id.value = iPage;
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FPAGECONTROL.PRIVATE.setSelectedPage} " + err.message);
            }
        }
