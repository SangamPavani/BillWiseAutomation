                                REPORTRENDERNEW.firstPageData(null, sUniqueId);
                                break;
                        }
                    }
                    break;
                case eAIResultType.ReportCrossreference:
                    ////debugger
                    if (obj.report != undefined) {
                        var iParentReportID = 0;
