    disableControl: function (id, bDisable) {
        try {
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == false) {
                return;
            }

            bDisable = DataType.toBoolean(bDisable);
            id.disabled = bDisable;

            if(DataType.isValidObject(id.parentElement.nextElementSibling) == true) {
                id.parentElement.nextElementSibling.style.pointerEvents = bDisable == true ? "none" : "";
            }
            
            //id.parentElement.nextElementSibling.style.cursor = bDisable == true ? "" : "pointer";
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FATTACHMENTCONTROL.disableControl} " + err.message);
        }
    },

