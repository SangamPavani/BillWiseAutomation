        // Fill all views received from server
        fillViewsList: function (data) {
            var iCounter = 0;
            var eleSelect = null;
            var eleOption = null;
            var obj = null;

            try {
                eleSelect = RD_ENTRY.DATASET.getViewsListElement();

                FCommon.UI.removeChildren(eleSelect);
                for (iCounter = 0; iCounter < data.data.length; iCounter++) {
