    resizeBodyColumn(ele, sUniqueId) {
        try {
            var eleTHeadCol = ele;
            var sGroupName = null;
            var iHeadColNumber = 0;
            var iNextHeadColNumber = 0;
            var iColNumber = 0;
            var eleBodyTable = null;
            var eleBodyRow = null;
            var eleBodyCol = null;
            var eleBodyTable = document.getElementById("tblRDRender_" + sUniqueId).children[1];  //eleTHeadCol.parentElement.parentElement.parentElement.parentElement.parentElement.children[0].children[0].children[1];
            var n = 0;
            return;
            sGroupName = eleTHeadCol.getAttribute('data-sgroupname');
            if (sGroupName == null) {
                iHeadColNumber = eleTHeadCol.getAttribute('data-icolnumber');
                if (FCommon.UI.isValidObject(eleBodyTable) && eleBodyTable.children.length > 0) {
                    for (var i = 0; i < eleBodyTable.children.length; i++) {
                        eleBodyRow = eleBodyTable.children[i];
                        if (eleBodyRow.children.length > 0) {
                            eleBodyCol = eleBodyRow.children[iHeadColNumber - 1];
                            eleBodyCol.style.width = eleTHeadCol.getBoundingClientRect().width + "px";
                            eleBodyCol.style.left = eleTHeadCol.getBoundingClientRect().left + "px";
                        }
                    }
                }
            }
            else {
                var eleTHeadSubCol = eleTHeadCol.parentElement.parentElement.children[1];
                var eleTHeadNextCol = eleTHeadCol.nextElementSibling;
                iHeadColNumber = eleTHeadCol.getAttribute('data-icolnumber');
                iColNumber = iHeadColNumber - 1;
                var widthofEachColumn = 0;
                if (FCommon.UI.isValidObject(eleTHeadNextCol)) {
                    iNextHeadColNumber = eleTHeadNextCol.getAttribute('data-icolnumber');
                    widthofEachColumn = (eleTHeadCol.getBoundingClientRect().width / (iNextHeadColNumber - iHeadColNumber));
                    for (var i = 0; i < iNextHeadColNumber - iHeadColNumber; i++) {
                        for (var j = 0; j < eleBodyTable.children.length; j++) {
                            eleBodyRow = eleBodyTable.children[j];
                            if (eleBodyRow.children.length > 0) {
                                eleBodyCol = eleBodyRow.children[iColNumber];
                                eleBodyCol.style.width = widthofEachColumn + "px";
                                eleBodyCol.style.left = eleTHeadSubCol.children[i].getBoundingClientRect().left + "px";
                            }
                        }
                        iColNumber = iColNumber + 1;
                    }
                }
                else {
                    var iHeadSubColNumber = 0;
                    for (var i = 0; i < eleTHeadSubCol.children.length; i++) {
                        iHeadSubColNumber = eleTHeadSubCol.children[i].getAttribute('data-icolnumber');
                        if (iHeadSubColNumber == iHeadColNumber) {
                            iHeadColNumber = i;
                            break;
                        }
                    }
                    widthofEachColumn = (eleTHeadCol.getBoundingClientRect().width / (eleTHeadSubCol.children.length - iHeadColNumber));
                    for (var i = iHeadColNumber; i < eleTHeadSubCol.children.length; i++) {
                        for (var j = 0; j < eleBodyTable.children.length; j++) {
                            eleBodyRow = eleBodyTable.children[j];
                            if (eleBodyRow.children.length > 0) {
                                eleBodyCol = eleBodyRow.children[iColNumber];
                                eleBodyCol.style.width = widthofEachColumn + "px";
                                eleBodyCol.style.left = eleTHeadSubCol.children[i].getBoundingClientRect().left + "px";
                            }
                        }
                        iColNumber = iColNumber + 1;
                    }
                }
            }
        }
        catch (exception) {

        }
    },

