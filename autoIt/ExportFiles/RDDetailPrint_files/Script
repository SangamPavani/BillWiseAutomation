            iSourceRow = DataType.toInt(iSourceRow);
            iSourceColumn = DataType.toInt(iSourceColumn);
            iTargetRow = DataType.toInt(iTargetRow);
            iTargetColumn = DataType.toInt(iTargetColumn);

            iTotalRows = FGRIDCONTROL.getTotalRows(gridElement);
            iTotalColumns = FGRIDCONTROL.getTotalColumns(gridElement);

            if (iSourceRow < 1 || iSourceRow > iTotalRows || iTargetRow < 1 || iTargetRow > iTotalRows) {
                return (false);
            }

            if (iSourceColumn < 1 || iSourceColumn > iTotalColumns || iTargetColumn < 1 || iTargetColumn > iTotalColumns) {
                return (false);
            }

            if (iSourceRow == iTargetRow && iSourceColumn == iTargetColumn) {
                return (false);
            }

            objSourceCell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iSourceRow, iSourceColumn);
            if (DataType.isValidObject(objSourceCell) == false) {
                return (false);
            }

            objTargetCell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iTargetRow, iTargetColumn);
            if (DataType.isValidObject(objTargetCell) == false) {
                return (false);
            }


            bUpdateTarget = DataType.toBoolean(bUpdateTarget);
            if (bUpdateTarget == false) {
                FUIElement.removeDataAttributes(objTargetCell);
                FUIElement.setText(objTargetCell, "");
            }

            FUIElement.copyDataAttribute(objSourceCell, objTargetCell);
            sText = FUIElement.getText(objSourceCell);
            FUIElement.setText(objTargetCell, sText);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.copyColumnData} " + err.message);

            return (false);
        }

        return (true);
    },

    copyColumnsData: function (gridElement, iSourceRow, arrSourceColumn, iTargetRow, arrTargetColumn, bUpdateTarget) {
        let sText = "";
        let iCounter = 0;
        let iTotalRows = 0;
        let iTotalColumns = 0;
        let objSourceCell = null;
        let objTargetCell = null;

        try {
            gridElement = FUIElement.getValidElement(gridElement);
            if (DataType.isValidObject(gridElement) == false) {
                return (false);
            }

            iSourceRow = DataType.toInt(iSourceRow);
            iTargetRow = DataType.toInt(iTargetRow);

            iTotalRows = FGRIDCONTROL.getTotalRows(gridElement);
            iTotalColumns = FGRIDCONTROL.getTotalColumns(gridElement);

            if (iSourceRow < 1 || iSourceRow > iTotalRows || iTargetRow < 1 || iTargetRow > iTotalRows) {
                return (false);
            }

            for(iCounter = 0; iCounter < arrSourceColumn.length && iCounter < arrTargetColumn.length; iCounter++) {
                if (arrSourceColumn[iCounter] < 1 || arrSourceColumn[iCounter] > iTotalColumns || arrTargetColumn[iCounter] < 1 || arrTargetColumn[iCounter] > iTotalColumns) {
                    continue;
                }

                objSourceCell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iSourceRow, arrSourceColumn[iCounter]);
                if (DataType.isValidObject(objSourceCell) == false) {
                    continue;
                }

                objTargetCell = FGRIDCONTROL.PRIVATE.getCellElementOfRowColumn(gridElement, iTargetRow, arrTargetColumn[iCounter]);
                if (DataType.isValidObject(objTargetCell) == false) {
                    continue;
                }

                if (bUpdateTarget !== true) {
                    FUIElement.removeDataAttributes(objTargetCell);
                    FUIElement.setText(objTargetCell, "");
                }

                FUIElement.copyDataAttribute(objSourceCell, objTargetCell);
                sText = FUIElement.getText(objSourceCell);
                FUIElement.setText(objTargetCell, sText);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.copyColumnsData} " + err.message);

            return (false);
        }

        return (true);
    },

    enableFreezeColumn: function (gridElement, iColumn, bEnable) {
        let iRow = 0;
        let iTotalRows = 0;
        let eleHRow = null;
        let eleRow = null;
        let eleColumn = null;

        try {
            gridElement = FUIElement.getValidElement(gridElement);
            if (DataType.isValidObject(gridElement) == false) {
                return (-1);
            }

            if (FGRIDCONTROL.isFreezeColumnEnabled(gridElement) == false) {
                return (0);
            }

            eleHRow = FGRIDCONTROL.getRowElement(gridElement, 0);

            iTotalRows = FGRIDCONTROL.getTotalRows(gridElement);
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                eleRow = FGRIDCONTROL.getRowElement(gridElement, iRow);

                eleColumn = eleRow.children[iColumn];

                if (FGRIDCONTROL.FREEZE.isFreezeColumn(eleColumn, false) == false) {
                    return (0);
                }

                if (bEnable == true) {
                    FUIElement.addClass(eleColumn, "freeze-column");
                    if (DataType.isValidObject(eleHRow) == true && eleHRow.children.length > iColumn) {
                        eleHRow.children[iColumn].style.left = FUIElement.getAttribute(eleHRow.children[iColumn], "data-left", true);
                        eleHRow.children[iColumn].style.right = FUIElement.getAttribute(eleHRow.children[iColumn], "data-right", true);
                        eleHRow.children[iColumn].style.top = "";
                        eleHRow.children[iColumn].style.position = "";
                        eleHRow.children[iColumn].style.zIndex = "";

                        FUIElement.addClass(eleHRow.children[iColumn], "freeze-column-heading");

                        eleColumn.style.left = eleHRow.children[iColumn].style.left;
                        eleColumn.style.right = eleHRow.children[iColumn].style.right;
                    }
                }
                else {
                    FUIElement.removeClass(eleColumn, "freeze-column");
                    eleColumn.style.left = "";
                    eleColumn.style.right = "";

                    if (DataType.isValidObject(eleHRow) == true && eleHRow.children.length > iColumn) {
                        FUIElement.removeClass(eleHRow.children[iColumn], "freeze-column-heading");

                        eleHRow.children[iColumn].style.left = "";
                        eleHRow.children[iColumn].style.right = "";
                        eleHRow.children[iColumn].style.top = 0;
                        eleHRow.children[iColumn].style.position = "sticky";
                        eleHRow.children[iColumn].style.zIndex = "1";
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.enableFreezeColumn} " + err.message);
        }

        return (iTotalRows);
    }
};

