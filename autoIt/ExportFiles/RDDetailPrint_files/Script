                return (false);
            }

            child = document.getElementById(ctrl.id + "_container");
            if (DataType.isValidObject(child) == true) {
                child.style.display = (bHide === true) ? "none" : "";
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FATTACHMENTCONTROL.hideControl} " + err.message);
        }
