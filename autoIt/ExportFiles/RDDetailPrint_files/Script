    selectText: function (control, iStart, iEnd, bIgnoreFocus) {
        let sNodeName = "";
        let bNumber = true;
        let range = null;

        try {
            control = FUIElement.getValidElement(control);
            if (DataType.isValidObject(control) == false) {
                return;
            }

            sNodeName = control.nodeName.toLowerCase();
            if (sNodeName === "input" || sNodeName === "textarea") {
                if (control.setSelectionRange) {
                    if (bIgnoreFocus !== true) {
                        control.focus();
                    }

                    control.setSelectionRange(iStart, iEnd);
                }
                else if (control.createTextRange) {
                    range = control.createTextRange();
                    range.collapse(true);
                    range.moveEnd('character', iEnd);
                    range.moveStart('character', iStart);
                    range.select();
                }
            }
            else if (sNodeName === "select") {
                if (DataType.isValidObject(iStart) == false) {
                    return;
                }

                if ((typeof iStart).toLowerCase() == "number") {
                    bNumber = true; // number list
                }
                else if ((typeof iStart).toLowerCase() == "string") {
                    bNumber = false; // string list
                }
                else {
                    return;
                }

                FUIElement.setDropdownValue(control, iStart, bNumber != true);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FUIElement.selectText} " + err.message);
        }
