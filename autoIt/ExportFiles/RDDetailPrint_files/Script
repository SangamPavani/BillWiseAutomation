                                break;
                            case "last page":
                                //REPORTRENDER.lastPageDataLite(DashletId, (reportLineModel.CrossReference == false ? '' : 'CrossReference'));
                                REPORTRENDERNEW.lastPagedata(null, sUniqueId);
                                break;
                            case "first page":
