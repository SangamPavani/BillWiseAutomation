    this.companyIdFromCode = function (sCode) {
        let iCode = 0;
        let iValue = 0;
        let iValue1 = 0;
        let iCounter = 0;

        try {

            sCode = DataType.toString(sCode).trim();
            if (DataType.isNullOrEmpty(sCode) == true) {
                return (0);
            }

            sCode = sCode.toUpperCase();

            for (iCounter = 0; iCounter < sCode.length; iCounter++) {
                iValue = (sCode[iCounter] >= 'A' ? sCode.charCodeAt(iCounter) - 55 : sCode.charCodeAt(iCounter) - 48);
                iValue1 = DataType.pow(36, sCode.length - 1 - iCounter);
                iValue = DataType.mul(iValue, iValue1);
                iCode = DataType.add(iCode, iValue);
            }

            iCode = DataType.toInt(iCode);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FConvert.companyIdFromCode} " + err.message);
        }

        return (iCode);
    },

    this.companyCodeFromId = function (iValue) {
        let base36Chars = "";
        let sReturnValue = "";
        let iRemainder = 0;        

        try {
            if (iValue == null || iValue == undefined || iValue == 0) {
                return ("");
            }

            if (iValue < 0) {
                iValue *= -1;
            }

            base36Chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";

            do {
                iRemainder = DataType.mod(iValue, 36);
                sReturnValue = base36Chars[iRemainder] + sReturnValue;
                iValue = DataType.divInt(iValue, 36);
            } while (iValue != 0);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FConvert.companyCodeFromId} " + err.message);
        }

        return (sReturnValue);
    },

