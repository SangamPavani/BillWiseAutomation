    // {Public} Deletes row from specific position
    deleteRows: function (gridElement, iIndex, iCount) {
        let eleBody = null;
        let iTotalRows = 0;
        let iCounter = 0;

        try {
            gridElement = FUIElement.getValidElement(gridElement);
            if (DataType.isValidObject(gridElement) == false) {
                return (false);
            }

            eleBody = FGRIDCONTROL.PRIVATE.getBodyElement(gridElement);
            if (DataType.isValidObject(eleBody) == false) {
                return (false);
            }

            iTotalRows = FGRIDCONTROL.getTotalRows(gridElement);

            if (DataType.isValidObject(iIndex) == true) {
                iIndex = DataType.toInt(iIndex);
                if (iIndex < 1 || iIndex > iTotalRows) {
                    return (false);
                }

                iIndex--;
            }
            else {
                return (false);
            }

            iCount = DataType.toInt(iCount);
            if (iCount <= 0) {
                iCount = 1;
            }

            for (iCounter = 0; iCounter < iCount; iCounter++) {
                if (iIndex < eleBody.children.length) {
                    eleBody.removeChild(eleBody.children[iIndex]);
                }
            }

            for (iCounter = iIndex; iCounter < eleBody.children.length; iCounter++) {
                FGRIDCONTROL.setSerialNo(eleBody.children[iCounter].children[0], iCounter + 1);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FGRIDCONTROL.deleteRows} " + err.message);

            return (false);
        }

        return (true);
    },

