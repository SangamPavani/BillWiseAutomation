                row = OPTIONCONTROL_UI.getPreviousDataRow(row);
            }

            if (row == null) {
                row = OPTIONCONTROL_UI.getFirstDataRow(id);
            }

            if (row != null) {
                OPTIONCONTROL_UI.selectRow(row, id);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processUpKey} " + err.message);
        }
    },

    processDownKey: function (id, evt, sURL) {
        let row = null;
        let selectedrow = null;
        let bFlag = false;
        let value = 0;
        let iPosition = 0;
        let obj = null;

        try {
            OPTIONCONTROL_HELPER.stopKeyProcess(evt);

            if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false && OPTIONCONTROL_DATA.getMetaData(id).length > 0) {
                value = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL.getControlValue(id));
                if (value != 0) {
                    OPTIONCONTROL_INTERNAL.showPopup(id);
                    OPTIONCONTROL.setValue(id, value);
                }
                else {
                    OPTIONCONTROL_EVENTS.dropdownClick(id, evt);
                }
                return;
            }
            else if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false && OPTIONCONTROL_DATA.getMetaData(id).length == 0) {
                OPTIONCONTROL_INTERNAL.loadAndDisplayDropdownWithData(id);
                return;
            }

            selectedrow = OPTIONCONTROL_UI.getSelectedRow(id);
            iPosition = selectedrow.Position;
            selectedrow = selectedrow.Row;
            if (OPTIONCONTROL_HELPER.isValidObject(selectedrow) == false) {
                OPTIONCONTROL_UI.selectFirstRow(id);
                return;
            }

            bFlag = true;
            OPTIONCONTROL_UI.unselectRow(selectedrow);
            row = OPTIONCONTROL_UI.getNextDataRow(selectedrow);

            if (row != null) {
                OPTIONCONTROL_UI.selectRow(row, id);
            }
            else if (bFlag == true) {
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sURL, true) == true) {
                    OPTIONCONTROL_UI.selectRow(selectedrow, id);
                }
                else if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Bins) {
                }
                else {
                    obj = OPTIONCONTROL_SERVER.getCommunicationParameterObject(id, sURL);
                    obj.sSearch = id.value;
                    obj.iExistingDataCount = OPTIONCONTROL_INTERNAL.getTotalRows(id);
                    obj.SelectedData = null;
                    OPTIONCONTROL_SERVER.getDataFromServer(obj);

                    row = OPTIONCONTROL_UI.getDataRow(id, iPosition + 1);
                    if (row != null) {
                        OPTIONCONTROL_UI.unselectAllRows(id);
                        OPTIONCONTROL_UI.selectRow(row, id);
                    }
                    else {
                        OPTIONCONTROL_UI.selectFirstRow(id);
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.processDownKey} " + err.message);
        }
    },

