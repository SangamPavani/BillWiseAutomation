                arrData = ["مُحَرَّم", "صَفَر", "رَبيع الأوّل", "رَبيع الثاني", "جُمادى الأولى", "جُمادى الثانية", "رَجَب", "شَعْبان", "رَمَضان", "شَوّال", "ذو القَعْدة", "ذو الحِجّة"];
