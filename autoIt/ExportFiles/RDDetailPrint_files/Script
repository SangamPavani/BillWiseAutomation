    postPOSPreOrderTransaction: function () {
        debugger;
        let voucherPostedSuccesfully = $("#msgPostedSuccessfully").val();
        let msgPOSInformation = $("#msgPOSInformation").val();
        let pointOfConfirmation = $("#msgPointOfSaleConfirmation").val();
        let msgDoyouwanttoprintBillorEmail = $("#msgDoyouwanttoprintBillorEmail").val();
        let msgDoyouwanttoprintBill = $("#msgDoyouwanttoprintBill").val();
        let msgCannotposttransactionpleasecheckthelogformoredetails = $("#msgCannotposttransactionpleasecheckthelogformoredetails").val();
