    // Stores array of data objects in memory
    storeDataArrayInMemory: function (id, arrData, bLoadBalance) {
        let iCounter = 0;
        let iBalanceIndex = undefined;
        let arrMetaData = undefined;
        let objArr = null;
        let controltype = 0;

        try {
            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.storeDataArrayInMemory(id, arrData);

                return;
            }

            if (OPTIONCONTROL_HELPER.isValidObject(arrData) == false) {
                return;
            }


            controltype = OPTIONCONTROL.getControlType(id);
            if (controltype == eWebOptionControlType.Bins) {
                OPTIONCONTROL_DATA.setMemoryData(id, arrData);
                return;
            }

            if (bLoadBalance == false) {
                arrMetaData = OPTIONCONTROL_DATA.getMetaData(id);
                for (iCounter = 0; iCounter < arrMetaData.length; iCounter++) {
                    if (arrMetaData[iCounter].Name == "fBalance") {
                        iBalanceIndex = iCounter;
                        break;
                    }
                }
            }
            

            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                objArr = arrData[iCounter];

                if (iBalanceIndex != undefined && iBalanceIndex < objArr.length) {
                    objArr[iBalanceIndex].sValue = "";
                    objArr[iBalanceIndex].bHasData = false;
                }

                OPTIONCONTROL_DATA.storeDataInMemory(id, objArr, 0);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.storeDataArrayInMemory} " + err.message);
        }
    },

    // Stores data object in memory
    storeDataInMemory: function (id, objData, iInsertAfter) {
        let iIndex = 0;
        let iCompareValueIndex = 0;
        let iResult = 0;
        let iPosition = 0;
        let arrData = null;
        let objExistingData = null;

        try {
            iCompareValueIndex = OPTIONCONTROL_INTERNAL.getCompareValueIndex(id);

            if (DataType.isArray(objData) == false
                || objData.length <= iCompareValueIndex
                || OPTIONCONTROL_HELPER.isNullOrEmpty(objData[iCompareValueIndex].sValue) == true
                || iCompareValueIndex < 0) {

                return (0);
            }

            if (OPTIONCONTROL_DATA.isDataExist(id, objData) >= 0) {
                return (0);
            }

            iPosition = OPTIONCONTROL_DATA.getDataPositionInMemory(id, objData, iCompareValueIndex);
            if (iPosition >= 0) { // Data already stored in memory
                return (iPosition);
            }

            arrData = OPTIONCONTROL_DATA.getMemoryData(id);
            for (iIndex = iInsertAfter; iIndex < arrData.length; iIndex++) {
                objExistingData = arrData[iIndex];
                iResult = OPTIONCONTROL_HELPER.compareValue(objExistingData[iCompareValueIndex].sValue, objData[iCompareValueIndex].sValue, false);
                if (iResult < 0) {
                    continue;
                }

                arrData.splice(iIndex, 0, objData);
                OPTIONCONTROL_DATA.setMemoryData(id, arrData);

                return (iIndex);
            }

            arrData.splice(iIndex, 0, objData);
            OPTIONCONTROL_DATA.setMemoryData(id, arrData);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.storeDataInMemory} " + err.message);
        }

        return (iIndex);
    },

    // Returns array of data index of memory data that matched from given key value
    getKeyDataIndexArray: function (id, sSearchKey, iStartArrayIndex) {
        let iCompreValueIndex = 0;
        let iMaxRows = 0;
        let sValue = "";
        let arrIndex = [];
        let iCounter = 0;
        let arrData = null;
        let objData = null;
        let bShowAll = false;

        try {
            sSearchKey = DataType.toString(sSearchKey);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sSearchKey) == false) {
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sSearchKey.trim()) == true) {
                    bShowAll = true;
                }
                else if (OPTIONCONTROL_HELPER.isStartsWith(sSearchKey, "#") == true 
                        || OPTIONCONTROL_HELPER.isStartsWith(sSearchKey, "*") == true 
                        || OPTIONCONTROL_HELPER.isStartsWith(sSearchKey, "+") == true) {
                    // + for search in customized columns
                    bShowAll = true;
                }

                iCompreValueIndex = OPTIONCONTROL_INTERNAL.getCompareValueIndex(id);

                //if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Bins) {
                //    iMaxRows = 50;
                //}

                arrData = OPTIONCONTROL_DATA.getMemoryData(id);
                for (iCounter = iStartArrayIndex; iCounter < arrData.length; iCounter++) {
                    if (iMaxRows != 0 && iMaxRows <= arrIndex.length) {
                        break;
                    }

                    objData = arrData[iCounter];
                    if (objData == null || iCompreValueIndex >= objData.length) {
                        continue;
                    }

                    sValue = objData[iCompreValueIndex].sValue;
                    if (sValue.length <= 0 || sSearchKey.length <= 0) {
                        continue;
                    }

                    if (bShowAll == true) {
                        arrIndex.push(iCounter);
                        continue;
                    }
                    else if (sSearchKey.length > sValue.length) {
                        if (OPTIONCONTROL_HELPER.compareValue(sValue, sSearchKey, true, 0) == 0) {
                            arrIndex.push(iCounter);
                        }
                    }
                    else {
                        if (OPTIONCONTROL_HELPER.compareValue(sValue, sSearchKey, true, Math.min(sValue.length, sSearchKey.length)) == 0) {
                            arrIndex.push(iCounter);
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert(err.message = "Exception: {OPTIONCONTROL_DATA.getKeyDataIndexArray} " + err.message);
        }

        return (arrIndex);
    },

    // Compare objects
    compareObject: function (objData, objData1, iCompareValueIndex, bValueIndexOnly) {
        let iIndex = 0;
        let iTotal = 0;

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(objData) == false
                || OPTIONCONTROL_HELPER.isValidObject(objData1) == false
                || objData.length <= iCompareValueIndex
                || objData1.length <= iCompareValueIndex) {
                return (false);
            }

            bValueIndexOnly = OPTIONCONTROL_HELPER.toBoolean(bValueIndexOnly);
            if (OPTIONCONTROL_HELPER.compareValue(objData[iCompareValueIndex].sValue, objData1[iCompareValueIndex].sValue, false) == 0) {
                if (bValueIndexOnly == true) {
                    return (true);
                }

                iTotal = objData.length;
                iTotal = Math.min(objData.length, objData1.length); // Added for length mismatch 30/May/2017
                for (iIndex = 0; iIndex < iTotal; iIndex++) {
                    if (objData[iIndex].sValue != objData1[iIndex].sValue) {
                        break;
                    }
                }

                if (iIndex >= iTotal) {
                    return (true);
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.compareObject} " + err.message);
        }

        return (false);
    },

    // Returns object from memory data where given value match with store value
    getValueFromMemory: function (id, value, iStoreValueIndex) {
        let iCounter = 0;
        let objExisting = null;
        let arrData = null;
        let result = [];

        try {
            if (OPTIONCONTROL_HELPER.isValidObject(iStoreValueIndex) == false) {
                iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);
            }

            arrData = OPTIONCONTROL_DATA.getMemoryData(id);
            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                objExisting = arrData[iCounter];
                if (OPTIONCONTROL_HELPER.isValidObject(objExisting) == true
                    && OPTIONCONTROL_HELPER.compareValue(objExisting[iStoreValueIndex].sValue, value, false) == 0) {
                    result.push(iCounter);
                    result.push(objExisting);

                    return (result);
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {OPTIONCONTROL_DATA.getValueFromMemory} [id=" + id.id + "][Exception=" + err.message + "]");
            err.message = "Exception: {OPTIONCONTROL_DATA.getValueFromMemory} " + err.message;
            throw err;
        }

        return (result);
    },

    // Fetches multiple value from server at one go
    fillValueInMemory: function (id, arrValue, tag, bLoadAll, bIgnoreChangeCallback, sDataLoadedCallback, bLoadBalance) {
        let sURL = "";
        let sValueFilter = "";
        let iStoreValueIndex = 0;
        let iCounter = 0;
        let result = null;
        let arr = [];
        let arrLoadedData = [];
        let objParam = null;

        try {
            iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);

            for (iCounter = 0; iCounter < arrValue.length; iCounter++) {
                result = OPTIONCONTROL_DATA.getValueFromMemory(id, arrValue[iCounter], iStoreValueIndex);
                if (OPTIONCONTROL_HELPER.isValidObject(result) == false || result.length == 0) {
                    arr.push(arrValue[iCounter]);
                }
                else if (result.length >= 2) {
                    arrLoadedData.push(result[1]);
                }
            }

            if (arr.length > 0) {
                sURL = eOptionControlDataAttribute.getURL(id);
                sValueFilter = OPTIONCONTROL_HELPER.getAttributeData(id, "data-valuefilterfield");
                if (OPTIONCONTROL_HELPER.isNullOrEmpty(sValueFilter) == true) {
                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(OPTIONCONTROL.getTableName(id)) == true) {
                        sValueFilter = "a.iMasterId IN(";
                    }
                    else {
                        sValueFilter = OPTIONCONTROL.getPrimaryField(id) + " IN(";
                    }
                }
                else {
                    sValueFilter += " IN(";
                }

                for (iCounter = 0; iCounter < arr.length; iCounter++) {
                    if (iCounter > 0) {
                        sValueFilter += ",";
                    }

                    sValueFilter += '\'' + arr[iCounter] + '\'';
                }

                sValueFilter += ")";

                objParam = OPTIONCONTROL_SERVER.getCommunicationParameterObject(id, sURL);

                objParam.sFilter = sValueFilter;
                objParam.bLoadAll = OPTIONCONTROL_HELPER.toBoolean(bLoadAll);
                objParam.bIgnoreChangeCallback = OPTIONCONTROL_HELPER.toBoolean(bIgnoreChangeCallback);
                if (OPTIONCONTROL_HELPER.isValidObject(tag) == true) {
                    objParam.tag = tag;
                }

                if(OPTIONCONTROL_HELPER.isNullOrEmpty(sDataLoadedCallback, true) == false) {
                    objParam.sDataLoadedCallback = sDataLoadedCallback;
                }

                if (bLoadBalance != undefined && bLoadBalance != null) {
                    objParam.LoadBalance = bLoadBalance;
                }


                OPTIONCONTROL_UI.resetDataElement(id, true);
                OPTIONCONTROL_SERVER.getDataFromServer(objParam);
            }
            else if(arrLoadedData.length > 0 && OPTIONCONTROL_HELPER.isNullOrEmpty(sDataLoadedCallback, true) == false) {
                eval(sDataLoadedCallback)(id, 
                                            arrLoadedData, 
                                            {
                                                Control: id,
                                                bDataArray: true,
                                                OldData: null,
                                                CustomData: tag,
                                                UserData: OPTIONCONTROL.getUserData(id),
                                                Data: arrLoadedData,
                                                Value: 0,
                                                Flag: {
                                                    bLeave: false,
                                                    bDataLoad: true,
                                                    bDataChange: false
                                                }
                                            });
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.fillValueInMemory} " + err.message);
        }

        return (arrLoadedData);
    },

    hasPartialData: function (row, id) {
        let iMasterId = 0;
        let iCounter = 0;
        let iMasterTypeId = 0;
        let iCompareValueIndex = 0;
        let iStoreValueIndex = 0;
        let data = null;
        let result = null;
        let obj = null;

        try {
            obj = {};
            obj.iMasterId = 0;
            obj.iMemoryIndex = -1;

            iMasterTypeId = OPTIONCONTROL.getMasterTypeId(id);
            if (iMasterTypeId < 1) {
                return (obj);
            }

            iCompareValueIndex = OPTIONCONTROL_INTERNAL.getCompareValueIndex(id);

            data = OPTIONCONTROL_INTERNAL.getElementData(row, id);
            if (OPTIONCONTROL_HELPER.isValidObject(data) == true && data.length > iCompareValueIndex) {

                iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);

                iMasterId = OPTIONCONTROL_HELPER.toInt(data[0].sValue);
                result = OPTIONCONTROL_DATA.getValueFromMemory(id, iMasterId, iStoreValueIndex);
                if (OPTIONCONTROL_HELPER.isValidObject(result) == false || result.length == 0) {
                    return (obj);
                }
                else if (result.length == 2) {
                    data = result[1];

                    for (iCounter = 0; iCounter < data.length; iCounter++) {
                        if (data[iCounter].bHasData == false) {
                            obj.iMasterId = iMasterId;
                            obj.iMemoryIndex = result[0];

                            return (obj);
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.hasPartialData} " + err.message);
        }

        return (obj);
    },

    removePartialData: function (id) {
        let iCounter = 0;
        let iIndex = 0;
        let arrData = null;
        let objData = null;
        let row = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);
            row = OPTIONCONTROL_UI.getSelectedRow(id).Row;
            OPTIONCONTROL_UI.unselectRow(row);

            iStoreValueIndex = OPTIONCONTROL_INTERNAL.getStoreValueIndex(id);

            arrData = OPTIONCONTROL_DATA.getMemoryData(id);

            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                objData = arrData[iCounter];
                if (OPTIONCONTROL_HELPER.isValidObject(objData) == false) {
                    continue;
                }

                for (iIndex = 0; iIndex < objData.length; iIndex++) {
                    if (objData[iIndex].bHasData == false) {
                        break;
                    }
                }

                if (iIndex >= objData.length) {
                    continue;
                }

                row = OPTIONCONTROL_INTERNAL.getRowFromObject(id, objData, true);
                if (row == null) {
                    OPTIONCONTROL_HELPER.removeElement(row);
                }
                arrData.splice(iCounter, 1);
                iCounter--;
            }

            OPTIONCONTROL_DATA.setMemoryData(id, arrData);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_DATA.removePartialData} " + err.message);
        }
    }
};

var OPTIONCONTROL_EVENTS = {
    onFocus: function (id, evt) {
        let sCallback = "";
        let iSearchBy = 0;
        let iFirstField = 0;
        let iOriginalFirstField = 0;
        let value = null;
        let obj = null;

        try {
            if (id == null) {
                FUIElement.showAlert("Error: {OPTIONCONTROL_INTERNAL.onFocus} Invalid control id.");

                return (false);
            }

            id = OPTIONCONTROL_HELPER.getValidElement(id);
            setTimeout(function (id) {
                if (id) {
                    FUIElement.selectText(id, 0, -1, true);
                }
            }, 0, id);

            if (id) {
                FUIElement.selectText(id, 0, -1);
            }

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.onFocus(id, evt);

                return (true);
            }

            OPTIONCONTROL_INTERNAL.setInputText(id, "");
            value = OPTIONCONTROL_UI.getDataElement(id).value;

            OPTIONCONTROL.setScanFlag(id, false);
            OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, false);
            OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

            OPTIONCONTROL.resetItemSetOptions(id);

            if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Masters) {
                iSearchBy = OPTIONCONTROL_INTERNAL.getSearchBy(id);
                iFirstField = OPTIONCONTROL_INTERNAL.getFirstField(id);
                iOriginalFirstField = OPTIONCONTROL_INTERNAL.getOriginalFirstField(id);

                if (iSearchBy != -1 && iSearchBy != iOriginalFirstField) {
                    ////debugger
                    //OPTIONCONTROL.resetControl(id, value);
                    OPTIONCONTROL.resetControl(id, value, iSearchBy);
                    OPTIONCONTROL_HELPER.selectTextInInput(id, 0, OPTIONCONTROL_HELPER.toString(id.value).length);
                }
                else {
                    OPTIONCONTROL_INTERNAL.setSearchBy(id, iFirstField);
                }
            }

            OPTIONCONTROL.setFocusValue(id, value);
            OPTIONCONTROL.focusText(id, id.value);
            OPTIONCONTROL.setLastValue(id, value);
            obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, null, false);
            obj.Event = evt;

            sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.Focus, eMasterDataType.Text);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                obj.Flag.bLeave = false;
                obj.Flag.bDataLoad = false;
                obj.Flag.bDataChange = false;
                eval(sCallback)(obj);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.onFocus} " + err.message);
        }

        return (true);
    },

    leaveFocus: function (id, evt) {
        let sCallback = "";
        let iSearchBy = 0;
        let iOriginalFirstField = 0;
        let obj = null;
        let value = null;
        let row = null;
        let objPartialFlag = null;

        try {
            id = OPTIONCONTROL_HELPER.getValidElement(id);

            OPTIONCONTROL_TIMER.stopInputProcessTimer(id);

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.onLeave(id, evt);

                return;
            }

            OPTIONCONTROL.resetItemSetOptions(id);

            OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, false);
            OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

            obj = OPTIONCONTROL_INTERNAL.getCallbackDataObject(id, null, true);
            obj.Event = evt;

            OPTIONCONTROL_INTERNAL.setSelectedValue(id);



            value = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL.getControlValue(id));

            if (OPTIONCONTROL.getControlType(id) == eWebOptionControlType.Masters) {
                iSearchBy = OPTIONCONTROL_INTERNAL.getSearchBy(id);
                iOriginalFirstField = OPTIONCONTROL_INTERNAL.getOriginalFirstField(id);

                if (iSearchBy != -1 && iSearchBy != iOriginalFirstField) {
                    OPTIONCONTROL.resetControl(id, value);
                }
            }


            // Load partial data before leave
            if (OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL.getControlValue(id)) != 0) {
                row = OPTIONCONTROL_UI.getSelectedRow(id).Row;
                objPartialFlag = OPTIONCONTROL_DATA.hasPartialData(row, id);
                if (objPartialFlag.iMasterId > 0) {
                    OPTIONCONTROL_INTERNAL.startLoadingPartialData(id, row, objPartialFlag);
                    OPTIONCONTROL_INTERNAL.setSelectedValue(id);
                }
            }

            obj.Data = OPTIONCONTROL.getControlData(id);
            if (OPTIONCONTROL_HELPER.isValidObject(obj.Data) == true) {
                obj.Value = OPTIONCONTROL_HELPER.toInt(OPTIONCONTROL_HELPER.getFirstPropertyValue(obj.Data[0]));
                OPTIONCONTROL_INTERNAL.validateValue(id, obj);
            }


            OPTIONCONTROL_INTERNAL.hidePopup(id);

            sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.DataChangeCallback, eMasterDataType.Text);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false && obj.OldValue != obj.Value) {
                obj.Flag.bLeave = false;
                obj.Flag.bDataLoad = false;
                obj.Flag.bDataChange = true;
                eval(sCallback)(obj.Control, obj.Data, obj);
                obj.OldValue = obj.Value // 14/Nov/2017
            }

            sCallback = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.Leave, eMasterDataType.Text);;
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                obj.Flag.bLeave = true;
                obj.Flag.bDataLoad = false;
                obj.Flag.bDataChange = false;

                eval(sCallback)(id, obj.Data, obj);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_EVENTS.leaveFocus} " + err.message);
        }
    },

    keydown: function (id, evt, sURL) {
        let sInputText = "";
        let sCallback = "";
        let bResult = false;

        try {
            if (OPTIONCONTROL.getOnlyCustomize(id) == true) {
                if (evt.keyCode != eKeyCode.Tab && evt.keyCode != eKeyCode.CR) {
                    FUIElement.stopKeyProcess(evt);
                }

                return;
            }

            if (OPTIONCONTROL_COMBO.isWorkAsComboBox(id) == true) {
                OPTIONCONTROL_COMBO.keydown(id, evt);
                return;
            }

            sCallback = OPTIONCONTROL.getCallback(id, eOptionControlDataAttribute.KeyDown);
            if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                bResult = OPTIONCONTROL_HELPER.toBoolean(eval(sCallback)(id, evt));
                if (bResult == true) {
                    return;
                }
            }

            switch (evt.keyCode) {
                case eKeyCode.Tab:
                    if (OPTIONCONTROL_INTERNAL.getDataLoadingFlag(id) == true) {
                        FUIElement.stopKeyProcess(evt);
                        break;
                    }
                    sInputText = id.value;
                    objCtrl = OPTIONCONTROL_UI.getSelectedRow(id).Row;
                    OPTIONCONTROL_INTERNAL.setSelectedValue(id);

                    if (OPTIONCONTROL_HELPER.isNullOrEmpty(id.value) == true && OPTIONCONTROL_HELPER.isNullOrEmpty(sInputText) == false) {
                        if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == true) {
                            OPTIONCONTROL_INTERNAL.hidePopup(id);
                        }

                        sCallback = OPTIONCONTROL.getCallback(id, eOptionControlDataAttribute.DataNotFound);
                        if (OPTIONCONTROL_HELPER.isNullOrEmpty(sCallback, true) == false) {
                            bResult = eval(sCallback)(id, { InputText: sInputText, Event: evt });
                            if (bResult == true) {
                                return;
                            }
                        }
                    }

                    if (navigator.userAgent.indexOf("Firefox") != -1) {
                        if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == true) {
                            OPTIONCONTROL_HELPER.stopKeyProcess(evt);
                            OPTIONCONTROL_INTERNAL.hidePopup(id);
                        }
                    }
                    break;
                case eKeyCode.LF:
                    break;
                case eKeyCode.CR:
                    if (OPTIONCONTROL_INTERNAL.getDataLoadingFlag(id) == true) {
                        NETWORK.cancelRequest();
                        FUIElement.stopKeyProcess(evt);
                        //break;
                    }
                    
                    OPTIONCONTROL_INTERNAL.processForBarcode(id, evt);
                    break;
                case eKeyCode.Esc: // Esc key
                    if (OPTIONCONTROL_INTERNAL.getDataLoadingFlag(id) == true) {
                        FUIElement.stopKeyProcess(evt);
                        break;
                    }

                    OPTIONCONTROL_HELPER.stopKeyProcess(evt);
                    OPTIONCONTROL_UI.unselectRow(OPTIONCONTROL_UI.getSelectedRow(id).Row);

                    if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false) {
                        OPTIONCONTROL.clear(id, false);
                    }
                    return;
                case eKeyCode.End: // End key
                    if (OPTIONCONTROL_INTERNAL.getDataLoadingFlag(id) == true) {
                        FUIElement.stopKeyProcess(evt);
                        break;
                    }

                    break;
                case eKeyCode.Home: // Home key
                    break;
                case eKeyCode.Up: // up arrow
                    if (evt.ctrlKey == false) {
                        OPTIONCONTROL_INTERNAL.processUpKey(id, evt);
                    }
                    break;
                case eKeyCode.Down: // down arrow
                    if (OPTIONCONTROL_INTERNAL.getDataLoadingFlag(id) == true) {
                        FUIElement.stopKeyProcess(evt);
                        break;
                    }

                    if (evt.ctrlKey == false) {
                        OPTIONCONTROL_INTERNAL.processDownKey(id, evt, sURL);
                    }

                    break;
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_INTERNAL.keydown} " + err.message);
        }
    },

