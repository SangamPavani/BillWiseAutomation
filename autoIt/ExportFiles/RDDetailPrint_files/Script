const FAttributeEntry = {
    getControl: function (iMasterId, sCustomData, sFilter) {
        let result = null;

        try {
            sCustomData = DataType.toString(sCustomData);

            FUIElement.setAttribute(FAttributeEntry.m_CtrlId, "customdata", sCustomData);
            OPTIONCONTROL.clear(FAttributeEntry.getItemControlId());

            OPTIONCONTROL.setFilter(FAttributeEntry.getItemControlId(), DataType.toString(sFilter));

            if (iMasterId > 0) {
                result = transEntryServer.execute(eTransServerRequest.GetAttributeBaseProductId, { iProductId: iMasterId });
                result = result.data;
                if (result.lValue > 0 && result.data > 0) {
                    OPTIONCONTROL.setControlValue(FAttributeEntry.getItemControlId(), result.data);
                }
            }

            FAttributeEntry.show();
        }
        catch(err) {}
    },

    onItemLeave: function (id, data) {
        let result = null;

        try {
            if (DataType.arrayLength(data) < 1) {
                return;
            }

            FAttributeEntry.deleteAttributeElement();
            result = transEntryServer.execute(eTransServerRequest.GetAttributeEntryData, { iMasterId: DataType.toInt(data[0].iMasterId) });
            result = result.data;
            if (result.lValue < 1 || DataType.arrayLength(result.data) < 1) {
                return;
            }

            FAttributeEntry.createAttributeElement(result.data);
            FAttributeEntry.updateBalance();
        }
        catch (err) {
            COMMON.prototype.showMessage("{FAttributeEntry.onItemLeave}" + err.message, "Exception");
        }
    },

    onOk: function (evt) {
        let sCallback = "";
        let iCounter = 0;
        let arrAttributes = [];
        let iMasterId = 0;
        let properties = null;
        let result = null;

        try {
            iMasterId = DataType.toInt(OPTIONCONTROL.getControlValue(FAttributeEntry.getItemControlId()));
            if (iMasterId < 1) {
                COMMON.prototype.showMessage("Selecting item is mandatory.", "Error");
                return;
            }

            sCallback = FAttributeEntry.getCallback();


            FAttributeEntry.hide();
            
            properties = document.getElementsByName(FAttributeEntry.m_CtrlId + "_Combobox");
            for (iCounter = 0; iCounter < properties.length; iCounter++) {
                arrAttributes.push(properties[iCounter].selectedOptions[0].textContent);
            }

            if (arrAttributes != null && arrAttributes.length > 0) {
                result = transEntryServer.execute(eTransServerRequest.GetAttributeValue,
                                            { iMasterId: iMasterId, arrAttributes: arrAttributes });
                result = result.data;
                if (result.lValue > 0) {
                    document.getElementById(FAttributeEntry.m_CtrlId).dataset.value = result.data;
                }
                else {
                    document.getElementById(FAttributeEntry.m_CtrlId).dataset.value = 0;
                }

                if (DataType.isNullOrEmpty(sCallback, true) == false) {
                    eval(sCallback)(result.data, FAttributeEntry.getCustomData(), evt);
                }
            }
            else {
                sCallback = FAttributeEntry.getCallback();
                if (DataType.isNullOrEmpty(sCallback, true) == false) {
                    eval(sCallback)(iMasterId, FAttributeEntry.getCustomData(), evt);
                }
            }
        }
        catch(err) {}
    },

    onCancel: function (evt) {
        let sCallback = "";

        try {
            FAttributeEntry.hide();

            sCallback = FAttributeEntry.getCallback();
            if (DataType.isNullOrEmpty(sCallback, true) == false) {
                eval(sCallback)(0, FAttributeEntry.getCustomData(), evt);
            }
        }
        catch(err) {}
    },

    updateBalance: function () {
        let iCounter = 0;
        let iProductId = 0;
        let dBalance = 0;
        let properties = null;
        let arrAttributes = null;
        let objCustomData = null;
        let eleBalance = null;
        let result = null;
        let obj = null;

        try {
            objCustomData = DataType.stringToObject(FAttributeEntry.getCustomData());
            if (objCustomData.lValue < 1) {
                return;
            }
            objCustomData = objCustomData.data;

            eleBalance = document.getElementById(FAttributeEntry.m_CtrlId + "_balance");
            if (DataType.isValidObject(eleBalance) == false) {
                return;
            }

            iProductId = DataType.toInt(OPTIONCONTROL.getControlValue(FAttributeEntry.getItemControlId()));
            if (iProductId <= 0) {
                FUIElement.setText(eleBalance, "");
                return;
            }

            arrAttributes = [];
            properties = document.getElementsByName(FAttributeEntry.m_CtrlId + "_Combobox");
            for (iCounter = 0; iCounter < properties.length; iCounter++) {
                arrAttributes.push(properties[iCounter].selectedOptions[0].textContent);
            }

            if (arrAttributes != null && arrAttributes.length > 0) {
                result = transEntryServer.execute(eTransServerRequest.GetAttributeValue,
                                            { iMasterId: iProductId, arrAttributes: arrAttributes });
                result = result.data;
                if (result.lValue > 0) {
                    iProductId = result.data;
                }
                else {
                    iProductId = 0;
                }
            }

            if (iProductId <= 0) {
                FUIElement.setText(eleBalance, "");
                return;
            }

            obj = {};
            obj.iProductId = iProductId;
            obj.iDate = objCustomData.iDate;
            obj.iWarehouseId = objCustomData.iWarehouse;
            obj.lTransactionId = objCustomData.lTransactionId;
            obj.lBatchId = objCustomData.lBatchId;

            result = transEntryServer.execute(eTransServerRequest.GetStockQty, obj);
            result = result.data;
            if (result.lValue > 0) {
                dBalance = result.data;
            }
            FUIElement.setText(eleBalance, dBalance);

        }
        catch (err) {
            COMMON.prototype.showMessage("{FAttributeEntry.updateBalance}" + err.message, "Exception");
        }
