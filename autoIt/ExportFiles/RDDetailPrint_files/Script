        getTextMatchedDataIndex: function (Data, value, bMasterId) {
            let iIndex = 0;
            let iTotal = 0;
            let CompareValue = 0;
            let bObject = false;

            try {
                if (DataType.isArray(Data[0]) == true) {
                    iTotal = Data.length;
                }
                else {
                    iTotal = 1;
                    bObject = true;
                }

                for (iIndex = 0; iIndex < iTotal; iIndex++) {
                    if (bMasterId == true) {
                        CompareValue = 0;

                        if (bObject == true) {
                            CompareValue = DataType.toInt(DataType.getObjectFirstValue(Data[0])); // MasterId
                        }
                        else {
                            CompareValue = DataType.toInt(DataType.getObjectFirstValue(Data[iIndex][0])); // MasterId
                        }

                        if (value == CompareValue) {
                            return (iIndex);
                        }
                    }
                    else {
                        if (bObject == true) {
                            CompareValue = DataType.toString(DataType.getObjectFirstValue(Data[1])); // Text
                        }
                        else {
                            CompareValue = DataType.toString(DataType.getObjectFirstValue(Data[iIndex][1])); // Text
                        }

                        if (value.toLowerCase() == CompareValue.toLowerCase()) {
                            return (iIndex);
                        }
                    }
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.getTextMatchedDataIndex} " + err.message);
            }

            return (-1);
        },

        onMasterLoaded: function(id, data, tag) {
            let iRow = 0;
            let iValue = 0;
            let iIndex = 0;
            let iMasterId = undefined;

            try {
                if(DataType.isValidObject(tag.CustomData) == false) {
                    return;
                }

                if (DataType.isValidObject(tag.CustomData.Value) == true) { // Text is pasted
                    iIndex = FGRIDCONTROL.PRIVATE.getTextMatchedDataIndex(tag.Data, tag.CustomData.Value, false);
                    if (iIndex > 0) {
                        tag.Data.splice(0, iIndex);
                    }
                    else if (iIndex < 0){
                        tag.Data = [];
                    }

                    iMasterId = FGRIDCONTROL.PRIVATE.setLoadedMaster(id, tag, 0);

                    if (DataType.isNullOrEmpty(tag.CustomData.sCallback, true) == false) {
                        tag.CustomData.iGridMasterId = iMasterId;
                        eval(tag.CustomData.sCallback)(id, data, tag.CustomData);
                    }

                    if (tag.Data.length == 0) {
                        return (false);
                    }
                }
                else {
                    for (iRow = 0; iRow < tag.CustomData.arrId.length; iRow++) {
                        iValue = tag.CustomData.arrId[iRow];

                        FGRIDCONTROL.PRIVATE.setLoadedMaster(id, tag, iRow, iValue);
                    }
                }
            }
            catch(err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.onMasterLoaded} " + err.message);
            }
        },

        setLoadedMaster: function(id, tag, iRow, iValue) {
            let sText = "";
            let iIndex = 0;
            let iTotal = 0;
            let iMasterId = 0;
            let iSetMaterId = undefined;
            let bFound = false;
            let bObject = false;
            let cell = null;
            let obj = null;

            try {
                bFound = false;
                cell = null;
                iTotal = 0;
                bObject = false;

                if(tag.Data.length > 0) {
                    if(DataType.isArray(tag.Data[0]) == true) {
                        iTotal = tag.Data.length;
                    }
                    else {
                        iTotal = 1;
                        bObject = true;
                    }
                }
                else if(DataType.isNullOrEmpty(tag.CustomData.Value, true) == false) {
                    cell = FGRIDCONTROL.getCellObject(tag.CustomData.Grid, tag.CustomData.iRow + iRow, tag.CustomData.iColumn);
                    if (DataType.isValidObject(cell) == true) {
                        cell.setCellText(tag.CustomData.Value, 0);
                    }

                    return;
                }

                for (iIndex = 0; iIndex < iTotal; iIndex++) {
                    if(bObject == true) {
                        iMasterId = DataType.toInt(DataType.getObjectFirstValue(tag.Data[0]));
                    }
                    else {
                        iMasterId = DataType.toInt(DataType.getObjectFirstValue(tag.Data[iIndex][0]));
                    }

                    if (DataType.isValidObject(iValue) == false || iValue == iMasterId) {
                        cell = FGRIDCONTROL.getCellObject(tag.CustomData.Grid, tag.CustomData.iRow + iRow, tag.CustomData.iColumn);
                        if (DataType.isValidObject(cell) == false
                            && tag.CustomData.bFragment
                            && tag.CustomData.eleFragment) {

                            cell = FGRIDCONTROL.FRAGMENT.getCellObject(tag.CustomData.eleFragment, tag.CustomData.iRow + iRow, tag.CustomData.iColumn);
                        }

                        if (DataType.isValidObject(cell) == true) {
                            if(bObject == true) {
                                obj = OPTIONCONTROL.convertRawDataIntoObject(id, tag.Data);
                                sText = DataType.getObjectFirstValue(tag.Data[1]);
                            }
                            else {
                                obj = OPTIONCONTROL.convertRawDataIntoObject(id, tag.Data[iIndex]);
                                sText = DataType.getObjectFirstValue(tag.Data[iIndex][1]);
                            }

                            cell.setCellData(obj);
                            cell.setCellText(sText, iMasterId);

                            iSetMaterId = iMasterId;
                            bFound = true;
                        }

                        break;
                    }                    
                }

                if(bFound == false) {
                    cell = FGRIDCONTROL.getCellObject(tag.CustomData.Grid, tag.CustomData.iRow + iRow, tag.CustomData.iColumn);
                    if (DataType.isValidObject(cell) == true) {
                        cell.clear();
                    }
                }
            }
            catch(err) {
                FUIElement.showAlert("Exception: {FGRIDCONTROL.PRIVATE.setLoadedMaster} " + err.message);
            }

            return (iSetMaterId);
        }
    },

