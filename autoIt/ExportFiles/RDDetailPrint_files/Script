    this.roundOff = function (dActualNumber, dRoundOffTo, iRoundingType) {
        let dValue = 0;
        let iSign = 0;
        let intv = 0;
        let dVal = 0;
        let valIntvRatio = 0;
        let k = 0;
        let m = 0;
        let bGreaterThanMidPoint = false;
        let bInMidpoint = false;

        try {
            dValue = dActualNumber;

            if (GlobalPref.isSupportBigNumber) {
                switch (iRoundingType) {
                    case eRoundingType.Up:
                        if (dRoundOffTo == 0.00) {
                            dValue = dActualNumber;
                        }
                        else {
                            dValue = new BigNumber(dActualNumber).dividedBy(dRoundOffTo).integerValue(BigNumber.ROUND_CEIL).multipliedBy(dRoundOffTo).valueOf();
                        }
                        break;
                    case eRoundingType.Down:
                        if (dRoundOffTo == 0) {
                            dValue = dActualNumber;
                        }
                        else {
                            dValue = new BigNumber(dActualNumber).dividedBy(dRoundOffTo).integerValue(BigNumber.ROUND_FLOOR).multipliedBy(dRoundOffTo).valueOf();
                        }
                        break;
                    case eRoundingType.Nearest:
                        if (dRoundOffTo == 0) {
                            dValue = dActualNumber;
                        }
                        else {
                            intv = FConvert.toDecimal(Math.abs(dRoundOffTo));
                            iSign = DataType.sign(dActualNumber);

                            dVal = new BigNumber(dActualNumber);
                            dVal = dVal.abs();

                            valIntvRatio = dVal.dividedBy(intv);
                            k = valIntvRatio.integerValue(BigNumber.ROUND_FLOOR);
                            m = valIntvRatio.minus(k);

                            if (m.minus(0.5).isGreaterThanOrEqualTo(1e-14) == true) {
                                bGreaterThanMidPoint = true;
                            }
                            else {
                                bGreaterThanMidPoint = false;
                            }

                            if (m.minus(0.5).abs().isLessThan(1e-14) == true) {
                                bInMidpoint = true;
                            }
                            else {
                                bInMidpoint = false;
                            }

                            if (bGreaterThanMidPoint == true || bInMidpoint == true) {
                                dValue = new BigNumber(iSign).multipliedBy(k.plus(1).multipliedBy(intv)).valueOf();
                            }
                            else {
                                dValue = new BigNumber(iSign).multipliedBy(k.multipliedBy(intv)).valueOf();
                            }
                        }
                        break;
                }
            }
            else {
                switch (iRoundingType) {
                    case eRoundingType.Up:
                        if (dRoundOffTo == 0.00) {
                            dValue = dActualNumber;
                        }
                        else {
                            dValue = Math.ceil(dActualNumber / dRoundOffTo) * dRoundOffTo;
                        }
                        break;
                    case eRoundingType.Down:
                        if (dRoundOffTo == 0) {
                            dValue = dActualNumber;
                        }
                        else {
                            dValue = Math.floor(dActualNumber / dRoundOffTo) * dRoundOffTo;
                        }
                        break;
                    case eRoundingType.Nearest:
                        if (dRoundOffTo == 0) {
                            dValue = dActualNumber;
                        }
                        else {
                            intv = FConvert.toDecimal(Math.abs(dRoundOffTo));
                            iSign = DataType.sign(dActualNumber);
                            dVal = FConvert.toDecimal(Math.abs(dActualNumber));

                            valIntvRatio = Number(dVal / intv);
                            valIntvRatio = FConvert.toDecimal(valIntvRatio, 7, true);
                            k = Math.floor(valIntvRatio);
                            m = Number(valIntvRatio) - Number(k);

                            m = FConvert.toDecimal(m, 7, true);

                            bGreaterThanMidPoint = ((m - Number(0.5)) >= Number(1e-14)) ? true : false;
                            bInMidpoint = (Math.abs(m - 0.5) < Number(1e-14)) ? true : false;
                            dValue = ((bGreaterThanMidPoint == true || bInMidpoint == true) ? iSign * ((k + 1) * intv) : iSign * (k * intv));
                        }
                        break;
                }
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FConvert.roundOff} " + err.message);
        }

        return (dValue);
    },

