                else if (objOldData.iDataSourceType == eDataSourceType.Excel) {
                    if (DataType.isValidObject(objNewData.iDataSourceType) == false) {
                        bResult = true;
                    }
                    else if (objNewData.iDataSourceType != objOldData.iDataSourceType) {
                        bResult = true;
