            else {
                if (VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != null && VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails != undefined)
                    CALCULATION.setFooterFieldValues(VOUCHERPOSTING.VARIABLES.BillSettlementPaymentDetails.TotalSchemeAmount, VOUCHERPOSTING.VARIABLES.RoundOff, FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.CreditCardCharges, POSCommon.numberOfDecimal, true) + FConvert.toDecimal(VOUCHERPOSTING.VARIABLES.DebitCardCharges, POSCommon.numberOfDecimal, true), VOUCHERPOSTING.VARIABLES.EPaymentCharges);

                CALCULATION.calculateFooter(ApplicationNew);
            }

            debugger;
            if (ApplicationNew.PreOrderInfo.IsFromPreOrderSearch == false)
                rtnValuesBillSettlement = VOUCHERPOSTING.raiseNewPreOrder();
            else if (ApplicationNew.PreOrderInfo.IsFromPreOrderSearch == true)
                rtnValuesBillSettlement = VOUCHERPOSTING.updatePreOrder();

            if (rtnValuesBillSettlement == null || rtnValuesBillSettlement == undefined) {
                toastr.error("Exception while posting voucher.", "POS Exception");
                return;
