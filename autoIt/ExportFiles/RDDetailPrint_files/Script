var FInputTimer = {
    onInput: function (id, sCallback, iInterval, tag) {
        FInputTimer.PRIVATE.startTimer(id, sCallback, iInterval, tag);
    },

    PRIVATE: {
        startTimer: function (id, sCallback, iInterval, tag) {
            let timer = null;

            try {
                FInputTimer.PRIVATE.clearTimer(id);

                iInterval = DataType.toInt(iInterval);
                if (iInterval == 0) {
                    iInterval = 500;
                }

                timer = window.setInterval(function (id, sCallback, tag) {
                    try {
                        FInputTimer.PRIVATE.clearTimer(id);

                        GLOBAL.LoadingStart();

                        if (DataType.stringIncludes(sCallback, "(") == true) {
                            eval(sCallback);
                        }
                        else {
                            eval(sCallback)(id, tag);
                        }

                        GLOBAL.LoadingEnd();
                    }
                    catch (err) {
                        FUIElement.writeErrorLog("Exception: {FInputTimer.PRIVATE.timerMethod} ", err.message);
                    }
                }, iInterval, id, sCallback, tag);

                FUIElement.setAttribute(id, "input_timerid", timer);
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FInputTimer.PRIVATE.startTimer} " + err.message);
            }
        },

        clearTimer: function (id) {
            let timer = null;

            try {
                timer = FUIElement.getAttribute(id, "input_timerid");
                if (DataType.isNullOrEmpty(timer) == false) {
                    window.clearInterval(timer);
                    FUIElement.setAttribute(id, "input_timerid", "");
                }
            }
            catch (err) {
                FUIElement.showAlert("Exception: {FInputTimer.PRIVATE.clearTimer} " + err.message);
            }
        }
    }
