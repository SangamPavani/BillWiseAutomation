        getDocumentData: function (sTabId) {
            var iValue = 0;
            var iDocumentStatus = 0;
            var iVerificationStatus = 0;
            var iAuthorizationStatus = 0;


            //objTranSet.DocumentOption |= (chkSuspendedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkSuspendedDoc.Tag)
            //                          | (chkNotSuspendedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkNotSuspendedDoc.Tag)
            //                          | (chkCheckedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkCheckedDoc.Tag)
            //                          | (chkUnCheckedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkUnCheckedDoc.Tag)
            //                          | (chkAuthorizedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkAuthorizedDoc.Tag)
            //                          | (chkUnAuthorizedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkUnAuthorizedDoc.Tag);

            try {
                iDocumentStatus = RD_ENTRY.SCREEN.getDocumentStatusValue(sTabId);
                iVerificationStatus = RD_ENTRY.SCREEN.getVerificationStatusValue(sTabId);
                iAuthorizationStatus = RD_ENTRY.SCREEN.getAuthorizationStatusValue(sTabId);

                iValue = (((iDocumentStatus == 1 || iDocumentStatus == 3) ? 1 : 0) << 0)
                    | (((iDocumentStatus == 2 || iDocumentStatus == 3) ? 1 : 0) << 1)
                    | (((iVerificationStatus == 1 || iVerificationStatus == 3) ? 1 : 0) << 2)
                    | (((iVerificationStatus == 2 || iVerificationStatus == 3) ? 1 : 0) << 3)
                    | (((iAuthorizationStatus == 1 || iAuthorizationStatus == 3) ? 1 : 0) << 4)
                    | (((iAuthorizationStatus == 2 || iAuthorizationStatus == 3) ? 1 : 0) << 5);
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.TRANSACTIONSET.getDocumentData}" + err.message, "Exception");
            }

            return (iValue);
        },

        setDocumentData: function (sTransetTabPageId, iDocumentOption) {
            var iValue = 0;

            //objTranSet.DocumentOption |= (chkSuspendedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkSuspendedDoc.Tag)
            //                          | (chkNotSuspendedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkNotSuspendedDoc.Tag)
            //                          | (chkCheckedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkCheckedDoc.Tag)
            //                          | (chkUnCheckedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkUnCheckedDoc.Tag)
            //                          | (chkAuthorizedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkAuthorizedDoc.Tag)
            //                          | (chkUnAuthorizedDoc.IsChecked == true ? 1 : 0) << Convert.ToInt32(chkUnAuthorizedDoc.Tag);

            try {
                // Document Status
                iValue = (iDocumentOption & 3);
                switch (iValue) {
                    case 0:
                        break;
                    case 1: // Suspended Document
                        iValue = 1;
                        break;
                    case 2: // Not Suspended Document
                        iValue = 2;
                        break;
                    case 3: // All
                        iValue = 3;
                        break;
                }
                document.getElementById(sTransetTabPageId + "_documentstatus").value = iValue;


                // Verification Status
                iDocumentOption >>= 2;
                iValue = (iDocumentOption & 3);
                switch (iValue) {
                    case 0:
                        break;
                    case 1: // Checked Documents
                        iValue = 1;
                        break;
                    case 2: // Unchecked Documents
                        iValue = 2;
                        break;
                    case 3: // All
                        iValue = 3;
                        break;
                }
                document.getElementById(sTransetTabPageId + "_verificationstatus").value = iValue;


                // Authorization Status
                iDocumentOption >>= 2;
                iValue = (iDocumentOption & 3);
                switch (iValue) {
                    case 0:
                        break;
                    case 1: // Authorized Documents
                        iValue = 1;
                        break;
                    case 2: // Unauthorized Documents
                        iValue = 2;
                        break;
                    case 3: // All
                        iValue = 3;
                        break;
                }
                document.getElementById(sTransetTabPageId + "_authorizationstatus").value = iValue;
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.TRANSACTIONSET.setDocumentData}" + err.message, "Exception");
            }
        },

