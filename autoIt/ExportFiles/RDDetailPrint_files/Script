                            REPORTRENDER.sortReport(0, 1, iSortonFieldId);
                        }
                        else {
                            REPORTRENDER.sortReport(1, 1, iSortonFieldId);
                        }
                    }
                    break;
                case eAIResultType.ReportFilter:
                    debugger
                    data = {};
                    data = COMMON.prototype.getObjectPropertyValueArray(obj, true);
                    //Write a controller method to get the filter structure.
                    var sURL = GLOBAL.getContextPath("AIFilterValue", "RD", "RD");
