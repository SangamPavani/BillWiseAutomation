var OPTIONCONTROL_BINS = {
    processInputs: function (id, sKey, objData, bFromKeyboard, iBinId) {
        let sVariable = "";
        let timer = null;

        try {
            sVariable = OPTIONCONTROL_TIMER.stopInputProcessTimer(id);

            bFromKeyboard = OPTIONCONTROL_HELPER.toBoolean(bFromKeyboard);

            if (sKey == " " || bFromKeyboard == false) {
                OPTIONCONTROL_BINS.getBinsData(id, sKey, objData, bFromKeyboard, iBinId);

                return;
            }

            OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, true);
            timer = window.setInterval(function (id, sKey, objData, bFromKeyboard, iBinId) {
                OPTIONCONTROL_TIMER.stopInputProcessTimer(id);
                OPTIONCONTROL_BINS.getBinsData(id, sKey, objData, bFromKeyboard, iBinId);
            }, 350, id, sKey, objData, bFromKeyboard, iBinId);

            window[sVariable] = timer;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL_BINS.processInputs} " + err.message);
        }
    },

    getBinsData: function (id, sKey, objData, bFromKeyboard, iBinId) {
        let sBinsInputHandler = "";
        let arrIndex = null;
        let objInput = null;
        let row = null;

        try {
            if (sKey == " ") {
                sBinsInputHandler = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.BinsInputHandler, eMasterDataType.Text);
                if (DataType.isNullOrEmpty(sBinsInputHandler, true) == false) {
                    objInput = eval(sBinsInputHandler)();
                }

                OPTIONCONTROL_BINS.getDataFromServer(id, objInput, DataType.toInt(iBinId));

                return;
            }
            else {
                arrIndex = OPTIONCONTROL_DATA.getKeyDataIndexArray(id, sKey, 0);
                if (arrIndex != null && arrIndex.length > 0) {
                    OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, false);
                    OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

                    OPTIONCONTROL_INTERNAL.fillDataFromIndex(id, OPTIONCONTROL_DATA.getMetaData(id), arrIndex);
                    if (OPTIONCONTROL_HELPER.isValidObject(objData) == true) {
                        row = OPTIONCONTROL_INTERNAL.getRowFromObject(id, objData);
                        if (row != null) {
                            OPTIONCONTROL_UI.selectRow(row, id);
                        }
                        else {
                            OPTIONCONTROL_UI.selectFirstRow(id);
                        }
                    }
                    else {
                        OPTIONCONTROL_UI.selectFirstRow(id);
                    }
                }
                else if (sKey != "") {
                    sBinsInputHandler = OPTIONCONTROL.getAttributeData(id, eOptionControlDataAttribute.BinsInputHandler, eMasterDataType.Text);
                    if (DataType.isNullOrEmpty(sBinsInputHandler, true) == false) {
                        objInput = eval(sBinsInputHandler)();
                    }

                    OPTIONCONTROL_BINS.getDataFromServer(id, objInput, DataType.toInt(iBinId), sKey);

                    return;
                }
                else if (OPTIONCONTROL_DATA.getMemoryData(id).length > 0) {
                    if (sKey == "") {
                        arrIndex = OPTIONCONTROL_DATA.getKeyDataIndexArray(id, " ", 0);
                        OPTIONCONTROL_INTERNAL.fillDataFromIndex(id, OPTIONCONTROL_DATA.getMetaData(id), arrIndex);
                    }
                    else {
                        OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, false);
                        OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

                        OPTIONCONTROL_INTERNAL.fillDataFromIndex(id, OPTIONCONTROL_DATA.getMetaData(id), []);
                    }

                }

                if (OPTIONCONTROL_INTERNAL.isPopupVisible(id) == false) {
                    if (OPTIONCONTROL_DATA.getMetaData(id).length > 0) {
                        objData = OPTIONCONTROL_INTERNAL.getElementData(OPTIONCONTROL_UI.getSelectedRow(id).Row, id);

                        if (OPTIONCONTROL_HELPER.toBoolean(bFromKeyboard) == true) {
                            OPTIONCONTROL_INTERNAL.showPopup(id);
                        }
                        else {
                            OPTIONCONTROL_INTERNAL.setControlData(id, objData);
                        }
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {OPTIONCONTROL_BINS.getBinsData} " + err.message);
        }
    },

    getDataFromServer: function (id, objData, iBinId, sKey) {
        let objBinsParam = null;
        let objInput = null;
        let obj = null;

        try {
            if (DataType.isValidObject(objData) == false) {
                return;
            }

            iBinId = DataType.toInt(iBinId);

            objBinsParam = {};
            objBinsParam.Inward = objData.Input.InwardBin;
            objBinsParam.HeaderId = objData.Input.HeaderId;
            objBinsParam.VoucherType = objData.Input.VoucherType;

            objBinsParam.ProductId = objData.Input.ProductId;
            objBinsParam.BinGroupId = objData.Input.BingroupId;

            objBinsParam.WarehouseId = objData.Input.WarehouseId;
            if (objData.Input.Batch.trim() == "") {
                objBinsParam.Batch = "";
            }
            else {
                objBinsParam.Batch = objData.Input.Batch;
            }

            objBinsParam.BatchId = objData.Input.BatchId;

            if (DataType.isArray(objData.Input.WMSReqTransId) == true) {
                objBinsParam.WMSReqTransId = objData.Input.WMSReqTransId;
            }
            else {
                objBinsParam.WMSReqTransId = [objData.Input.WMSReqTransId];
            }

            if (objData.Input.DefaultBinId != null && objData.Input.DefaultBinId.length > 0 && objData.Input.DefaultBinId[0] > 0) {
                objBinsParam.DefaultBinId = objData.Input.DefaultBinId;
            }
            else {
                objBinsParam.DefaultBinId = null;
            }

            objBinsParam.WMS = objData.Input.WMS;
            objBinsParam.UnitId = objData.Input.UnitId;
            objBinsParam.AllocationTag = objData.Input.AllocationTag;

            if (DataType.isArray(objData.Input.TransactionId) == true) {
                objBinsParam.TransactionId = objData.Input.TransactionId;
            }
            else {
                objBinsParam.TransactionId = [objData.Input.TransactionId];
            }

            //Preferences
            if (objData.Preference.Bins.iBinsAllocationRestriction == 1) {
                objBinsParam.CategoryCheck = true;
            }

            objBinsParam.CategoryCheck = DataType.toBoolean(objData.Preference.Bins.iBinsAllocationRestriction);

            objBinsParam.DiffBatches = DataType.toBoolean(objData.Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin);
            objBinsParam.DifferentAttribute = objData.Preference.Bins.bItemWithTwoDifferentAttributeCannotbePlacedinSameBin;
            objBinsParam.DiffItemSameBin = DataType.toBoolean(objData.Preference.Bins.bCannotBePlacedInSameBin);
            objBinsParam.DirectAllocate = false;
            objBinsParam.isUnit = objData.Preference.Bins.bConsiderUnitsWhenCheckingTheItems;
            objBinsParam.PlaceItemInward = (objData.Preference.Bins.iPalceItemInward == 1) ? true : false;
            objBinsParam.PlaceItemOutward = (objData.Preference.Bins.iPalceItemOutward == 1) ? true : false;
            objBinsParam.PickExpiryDate = objData.Preference.Bins.iPickExpiryDate;
            objBinsParam.PickManufacturingDate = objData.Preference.Bins.iPickManufacturingDate;
            objBinsParam.WithinExpiryDate = objData.Preference.Bins.iWithinExpiryDate;

            if (DataType.isArray(objData.Input.RefId) == true) {
                objBinsParam.RefId = objData.Input.RefId;
            }
            else {
                objBinsParam.RefId = [objData.Input.RefId];
            }

            OPTIONCONTROL_INTERNAL.setDataLoadingFlag(id, true);
            OPTIONCONTROL_INTERNAL.setBufferedInputText(id, "");

            obj = {};
            obj.id = id;
            obj.sURL = GLOBAL.getContextPath("GetBinsData", "TransHome", "Transactions");
            obj.bAsync = true;
            //obj.sSearch = " ";
            obj.sSearch = DataType.toString(sKey) == "" ? " " : sKey;
            obj.sFilter = "";
            obj.SelectedData = null;
            obj.bIgnoreChangeCallback = true;
            obj.bFromKeyboard = true;
            obj.iSearchBy = -1;
            obj.bDoNotShowPopup = false;

            if (iBinId > 0) {
                obj.bAsync = false;
            }

            objInput = {};
            objInput.objBinsParam = objBinsParam;
            objInput.sUnitName = objData.Input.sUnitName;
            objInput.iDecimalsInQty = DataType.toInt(objData.Input.DecimalsInQty);
            objInput.dUnitConv = DataType.toDecimal(objData.Input.UnitConv);
            objInput.dProductBinCapicity = DataType.toDecimal(objData.Input.ProductCapacity);
            objInput.arrExcludedBins = DataType.arrayLength(objData.Input.ExcludedBins) > 0 ? objData.Input.ExcludedBins : [];
            objInput.iBinId = iBinId;
            objInput.sSearchKey = DataType.toString(sKey);
            objInput.sGUID = OPTIONCONTROL_INTERNAL.getGUID(id);
            objInput.bLinkOnTransactionQty = objData.bLinkOnTransactionQty;

            OPTIONCONTROL_SERVER.fetchDataFromServer(obj, JSON.stringify(objInput), "application/json; charset=UTF-8", "POST");
        }
        catch (err) {
            console.log("Exception: {OPTIONCONTROL_BINS.getDataFromServer} " + err.message);
        }
    }
};

