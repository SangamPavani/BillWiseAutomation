    getParent: function (ctrl) {
        let result = null;
        let element = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";

            if (OPTIONCONTROL_HELPER.isValidObject(ctrl) == false) {
                result.lValue = 0;
                result.sValue = "{OPTIONCONTROL::getParent} Option control id required.";

                return (result);
            }

            ctrl = OPTIONCONTROL_HELPER.getValidElement(ctrl);
            if (OPTIONCONTROL_HELPER.isValidObject(ctrl) == false) {
                result.lValue = 0;
                result.sValue = "{OPTIONCONTROL::getParent} Option control id cannot be blank.";

                return (result);
            }

            element = document.getElementById(ctrl.id + "_input_container");
            if (OPTIONCONTROL_HELPER.isValidObject(element) == false) {
                result.lValue = 0;
                result.sValue = "{OPTIONCONTROL::getParent} Invalid control(corrupted).";

                return (result);
            }

            result.data = element.parentElement;
            if (OPTIONCONTROL_HELPER.isValidObject(result.data) == false) {
                result.lValue = 0;
                result.sValue = "{OPTIONCONTROL::getParent} Parent not found.";

                return (result);
            }

            result.lValue = 1;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{OPTIONCONTROL::getParent} " + err.message;
            bResult = false;
        }

        return (result);
    },
    
    setParent: function (ctrl, newParent, bFocus) {
        let bResult = false;
        let child = null;

        try {
            ctrl = OPTIONCONTROL_HELPER.getValidElement(ctrl);
            if (OPTIONCONTROL_HELPER.isValidObject(ctrl) == false) {
                FUIElement.showAlert("Error: {OPTIONCONTROL::setParent} Option control id cannot be blank");
                return (false);
            }

            if (OPTIONCONTROL_HELPER.isValidObject(newParent) == false) {
                FUIElement.showAlert("Error: {OPTIONCONTROL::setParent} New parent object required");
                return (false);
            }

            newParent = OPTIONCONTROL_HELPER.getValidElement(newParent)
            if (OPTIONCONTROL_HELPER.isValidObject(newParent) == false) {
                FUIElement.showAlert("Error: {OPTIONCONTROL::setParent} New parent id cannot be blank");
                return (false);
            }

            child = document.getElementById(ctrl.id + "_input_container");
            if (OPTIONCONTROL_HELPER.isValidObject(child) == true) {
                newParent.appendChild(child);
            }

            bFocus = OPTIONCONTROL_HELPER.toBoolean(bFocus);
            if (ctrl.getBoundingClientRect().left != 0 && bFocus == true) {
                ctrl.focus();
            }

            bResult = true;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {OPTIONCONTROL::setParent} " + newParent.id + ", " + err.message);
            bResult = false;
        }

        return (bResult);
    },

