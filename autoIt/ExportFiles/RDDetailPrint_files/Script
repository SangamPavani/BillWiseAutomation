        // Returns selected rows array
        getSelectedRowsInDiv: function (sParentId) {
            var parent = null;
            var result = null;

            try {
                result = COMMON.prototype.getEmptyResultObject();
                result.lValue = 0;
                result.sValue = "";
                result.data = [];

                if (DataType.isValidObject(sParentId) == false) {
                    result.lValue = 0;
                    result.sValue = "{RD_ENTRY.CUSTOMIZATION.unselectRowInDiv} Parent id is mandatory";

                    return (result);
                }

                parent = FUIElement.getValidElement(sParentId);
                if (DataType.isValidObject(parent) == false) {
                    result.lValue = 0;
                    result.sValue = "{RD_ENTRY.CUSTOMIZATION.unselectRowInDiv} Parent id is mandatory";

                    return (result);
                }

                for (iCounter = 0; iCounter < parent.children.length; iCounter++) {
                    element = parent.children[iCounter];
                    if ($(element).hasClass("rd_selected") == true) {
                        result.data.push(element);
                    }
                }

                result.lValue = result.data.length;
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = "{RD_ENTRY.CUSTOMIZATION.getSelectedRowsInDiv} " + err.message;
            }

            return (result);
        },

