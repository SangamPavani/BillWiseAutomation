    LoadTemplateDataSuccess: function (bSuccess, data) {
        if (bSuccess) {
            objCalRecord = data.data;
            var arrbChk = data.bChkBoxes;
            var row = 1;
            DATEPICKER.setDate('idstartingdate', objCalRecord.StartDate);
            DATEPICKER.setDate('idendingdate', objCalRecord.EndDate);
            FGRIDCONTROL.update("gProjectedDate");
            FGRIDCONTROL.update("gPickedData");
            for (var i = 0 ; i < arrbChk.length; i++) {
                if (i == 0) {
                    document.getElementById("chkAccReceivable").checked = arrbChk[i];
                }
                else if (i == 1) {
                    document.getElementById("chkAccPayable").checked = arrbChk[i];
                }
                else if (i == 2) {
                    document.getElementById("chkChqReceive").checked = arrbChk[i];
                }
                else if (i == 3) {
                    document.getElementById("chkChqIssues").checked = arrbChk[i];
                }
                else if (i == 4) {
                    document.getElementById("chkRecJournal").checked = arrbChk[i];
                }
                else if (i == 5) {
                    document.getElementById("chkSales").checked = arrbChk[i];
                }
                else if (i == 6) {
                    document.getElementById("chkPurchase").checked = arrbChk[i];
                }
                else {
                    document.getElementById("chkJournal").checked = arrbChk[i];
                }
            }
            if (objCalRecord.ProjectedData != null) {
                for (var irow = 1 ; irow <= objCalRecord.ProjectedData.length ; irow++) {
                    if (objCalRecord.ProjectedData[irow - 1].IsBudget == false) {
                        cellObj1 = FGRIDCONTROL.getCellObject("gProjectedDate", irow, 1);
                        cellObj2 = FGRIDCONTROL.getCellObject("gProjectedDate", irow, 2);
                        cellObj3 = FGRIDCONTROL.getCellObject("gProjectedDate", irow, 3);
                        DATEPICKER.setDate(cellObj1.ColumnAttribute.ctrlid, objCalRecord.ProjectedData[irow - 1].PostingDate);
                        cellObj1.setCellText(DATEPICKER.getText(cellObj1.ColumnAttribute.ctrlid));
                        cellObj1.setCellData("value", objCalRecord.ProjectedData[irow - 1].PostingDate);
                        OPTIONCONTROL.setControlValue(cellObj2.ColumnAttribute.ctrlid, objCalRecord.ProjectedData[irow - 1].AccountId);
                        cellObj2.setCellText(OPTIONCONTROL.getControlText(cellObj2.ColumnAttribute.ctrlid));
                        cellObj2.setCellData("value", objCalRecord.ProjectedData[irow - 1].AccountId);
                        cellObj3.setCellText(objCalRecord.ProjectedData[irow - 1].Formula);
                        cellObj3.setCellData(objCalRecord.ProjectedData[irow - 1].Formula);
                    }
                    if (objCalRecord.ProjectedData[irow - 1].IsBudget == true) {
                        cellObj1 = FGRIDCONTROL.getCellObject("gPickedData", row, 1);
                        cellObj2 = FGRIDCONTROL.getCellObject("gPickedData", row, 2);
                        DATEPICKER.setDate(cellObj1.ColumnAttribute.ctrlid, objCalRecord.ProjectedData[irow - 1].PostingDate);
                        cellObj1.setCellText(DATEPICKER.getText(cellObj1.ColumnAttribute.ctrlid));
                        cellObj1.setCellData("value", objCalRecord.ProjectedData[irow - 1].PostingDate);
                        OPTIONCONTROL.setControlValue(cellObj2.ColumnAttribute.ctrlid, objCalRecord.ProjectedData[irow - 1].AccountId);
                        cellObj2.setCellText(OPTIONCONTROL.getControlText(cellObj2.ColumnAttribute.ctrlid));
                        cellObj2.setCellData("value", objCalRecord.ProjectedData[irow - 1].AccountId);
                        row++;
                    }
                }
            }
            else {
                FGRIDCONTROL.clearData("gProjectedDate", true);//cleare projected data
            }

            //cleare existing checked master
            var masters = document.getElementById("Chkboxes");
            for (var i = 0; i < masters.children.length; i++) {
                masters.children[i].children[0].children[0].checked = false;
            }
            if (objCalRecord.SelectedMasters != null) {
                var masters = document.getElementById("Chkboxes");
                var length = masters.children.length;
                for (var i = 0; i < length; i++) {
                    for (j = 0; j < objCalRecord.SelectedMasters.length; j++) {
                        if (parseInt(masters.children[i].children[0].children[0].id) == objCalRecord.SelectedMasters[j]) {
                            masters.children[i].children[0].children[0].checked = true;
                        }
                    }
                }
            }
        }
    },

