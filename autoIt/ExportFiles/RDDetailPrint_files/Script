    setSearchTree: function (arrData, iSearchType, sSearchText) {
        var arrGroupedData = [], arrChildData = [];
        var param = {};
        try {
            var arrFormattedData = TREESEARCH.getFormatedTreeData(arrData, iSearchType, sSearchText);

            result = $.grep(arrFormattedData, function (x) {
                if (x.iLevel == 0) x.iLevel = 1;
                return (x.bGroup == true && x.iLevel >= 1);
            })

            if (result != null && result.length > 0) {
                //eliminate all non-group elements
                //for each group element , add its child elements
                arrGroupedData.push({
                    iFieldId: -1,
                    sName: "Groups",
                    bGroup: true,
                    iLevel: 0,
                    iMasterLink: 0,
                    iParentId: -2,
                    iDataTypeId: 12,
                    iSequenceId: 12
                })
                for (var i = 1; i < result.length; i++) {
                    result[i].iLevel = 1; // keep all levels as 1
                    arrGroupedData.push(result[i]);
                    arrChildData = $.grep(arrData, function (x) {
                        if (x.subparentid == result[i].iFieldId && x.bGroup == false) {
                            x.iLevel = 2; // keep all child levels as 2
                            return x;
                        }
                    });
                    if (arrChildData.length > 0) {
                        arrGroupedData.push(...arrChildData);// ... is spread operator in javascript
                    }
                    else {
                        arrChildData = $.grep(arrData, function (x) {
                            if (x.iParentId == result[i].iFieldId && x.bGroup == false) {
                                x.iLevel = 2;  // keep all child levels as 2
                                return x;
                            }

                        });
                        if (arrChildData.length > 0)
                        {
                            if ((result[i].iDataTypeId == 4 || result[i].iDataTypeId == 3 || result[i].iDataTypeId == 5) && result[i].bGroup == true) {
                                arrChildData.push({
                                    iFieldId: result[i].iFieldId,
                                    sName: result[i].sName,
                                    bGroup: false,
                                    iLevel: 2,
                                    iParentId: result[i].iFieldId,
                                    iDataTypeId: result[i].iDataTypeId,
                                    iSequenceId: 0,
                                    iSubParentId: result[i].iSubParentId
                                });
                            }
                            //sorting
                            let childfieldlist = arrChildData.sort((p1, p2) => (p1.iSequenceId > p2.iSequenceId) ? 1 : (p1.iSequenceId < p2.iSequenceId) ? -1 : 0);
                            arrGroupedData.push(...childfieldlist);// ... is spread operator in javascript
                        }
                    }
                }
                //geting non-group fields
                if (result != null && result.length > 1) {
                    result = $.grep(arrFormattedData, function (x) {
                        if (x.iLevel == 0) x.iLevel = 1;
                        return (x.bGroup == false && x.iLevel >= 1);
                    })
                    if (result != null && result.length > 0) {

                        arrGroupedData.push({
                            iFieldId: 0,
                            sName: "Fields",
                            bGroup: true,
                            iLevel: 1,
                            iParentId: 0,
                            iDataTypeId: 0,
                            iSequenceId: 0
                        })
                        for (var i = 0; i < result.length; i++) {
                            result[i].iLevel = 2; // keep all levels as 2
                            arrGroupedData.push(result[i]);
                        }
                    }
                }
            }
            if (arrGroupedData.length > 1) {
                param.arrTreeData = arrGroupedData;
            }
            else {
                param.arrTreeData = arrFormattedData;
            }
            param.Parent = document.getElementById("id_rc_search_tree_container"),
            param.bCollapsed = false;
            param.bRootNodeSeparator = false;
            param.sElementIdPrefix = 'rc_customization_tree';
            param.fnDragStart = 'REPORTCUSTOMIZE.getSelectedId';
            param.fnDblClick = 'REPORTCUSTOMIZE.addColumnByDbClick';

            TREESEARCH.createTreeNew(param);
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.setSearchTree}" + err.message, "EXCEPTION");
        }
    },

    getFormatedTreeData: function (objRawData, iSearchType, sSearchText) {
        var iCounter = 0, iSequenceId = 0;
        var value = null, result = null;
        var arrData = [];
        var bPatternFound = false;
        try {
            switch (iSearchType) {
                case 1: // Numeric
                case 2: // String
                    bPatternFound = true;
                    arrData.push({
                        iFieldId: 0,
                        sName: "Fields",
                        bGroup: true,
                        iLevel: 0,
                        iParentId: 0,
                        iDataTypeId: 0,
                        iSequenceId: 0
                    });
                    iSequenceId++;
                    break;
                case 0: // All
                default:
                    if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                        bPatternFound = true;
                        arrData.push({
                            iFieldId: 0,
                            sName: "Fields",
                            bGroup: true,
                            iLevel: 0,
                            iParentId: 0,
                            iDataTypeId: 0,
                            iSequenceId: 0
                        });
                    }
                    break;
            }
            for (iCounter = 0; iCounter < objRawData.length; iCounter++) {
                value = objRawData[iCounter];
                result = null;
                if (bPatternFound == true) {
                    if (value.iFieldId == 0) {
                        continue;
                    }
                    if (TREESEARCH.isObjectValidForSearchTree(value, iSearchType, sSearchText) == true
                        && TREESEARCH.isSearchTreeUniqueId(arrData, value.iFieldId) == true) {
                        arrData.push({
                            iFieldId: value.iFieldId,
                            sName: value.sName,
                            bGroup: value.bGroup,
                            iLevel: value.iLevel,
                            iParentId: value.iParentId,
                            iDataTypeId: value.iDataTypeId,
                            iSequenceId: value.iSequenceId,
                            iSubParentId: value.iSubParentId
                        });
                        if (value.bGroup == false) {
                            //add its master name along with it 
                            result = $.grep(objRawData, function (x) {
                                if (x.iFieldId == value.iParentId && (x.iParentId == value.iSubParentId || x.iSubParentId == value.iSubParentId)) {
                                    return x;
                                }
                            });
                            if (result && result.length > 0) {
                                arrData[arrData.length - 1].sMasterName = result[0].sName;
                            }
                        }
                    }
                }
                else {
                    arrData.push(value);
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.getFormatedTreeData} " + err.message, "Exception");
        }
        return (arrData);
    },

    isObjectValidForSearchTree: function (obj, iSearchType, sSearchText) {
        var bValid = false;
        var pattern = null;
        var indices = [];
        try {
            //if (obj.bGroup == true) {
            //    return (false);
            //}
            switch (iSearchType) {
                case 1: // Numeric
                    if (obj.iDataTypeId == MasterDataType.get('NUMBER') || obj.iDataTypeId == MasterDataType.get('FRACTION')) {
                        bValid = true;
                        if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                            pattern = new RegExp(sSearchText, "i");
                            bValid = pattern.test(obj.sName);
                        }
                    }
                    break;
                case 2: // String
                    if (obj.iDataTypeId == MasterDataType.get('TEXT') || obj.iDataTypeId == MasterDataType.get('DATE') || obj.iDataTypeId == MasterDataType.get('TIME')) {
                        bValid = true;
                        if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                            pattern = new RegExp(sSearchText, "i");
                            bValid = pattern.test(obj.sName);
                        }
                    }
                    break;
                case 1: // All
                default:
                    if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                        if (sSearchText.includes('*') == true || sSearchText.includes("\\") == true || sSearchText.includes("(") == true || sSearchText.includes("?") == true
                            || sSearchText.includes(")") == true || sSearchText.includes("+") == true || sSearchText.includes("[") == true || sSearchText.includes("]") == true) {
                            for (var i = 0; i < sSearchText.length; i++) {
                                if (sSearchText[i] === "(" || sSearchText[i] === "[") indices.push(i);
                            }
                            for (var j = 0; j < indices.length; j++) {
                                sSearchText = sSearchText.substr(0, indices[j] + j) + "\\" + sSearchText.substr(indices[j] + j);//+j because after inserting '\' one index is incremented
                            }
                            return bValid;
                        }
                        pattern = new RegExp(sSearchText, "i");
                        bValid = pattern.test(obj.sName);
                    }
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.isObjectValidForSearchTree} " + err.message, "Exception");
            bValid = false;
        }
        return (bValid);
    },

    isSearchTreeUniqueId: function (arrData, iFieldId) {
        var bValid = true;
        var value = null;
        var iCounter = 0;
        try {
            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                value = arrData[iCounter];
                if (value.iFieldId === iFieldId) {
                    return (false);
                }
            }

            bValid = true;
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.isSearchTreeUniqueId} " + err.message, "Exception");
            bValid = false;
        }
        return (bValid);
    },

    createTreeNew: function (obj) {
        var sToolTipText = "", sPrefix = "", sDblClickCallback = "", sParentName = "";
        var parent = null, value = null, currentUL = null, rootUL = null;
        var iCounter = 0, iLevel = 0;
        var li = null, a = null, i = null, span = null, hr = null;
        var bResult = false;
        var arrUL = [];
        var parentNameResult = null;
        try {
            if (FCommon.UI.isValidObject(obj) == false) {
                return (false);
            }
            if (FCommon.UI.isValidObject(obj.arrTreeData) == false) {
                return (false);
            }
            if (FCommon.UI.isValidObject(obj.Parent) == false) {
                return (false);
            }
            parent = FCommon.UI.getValidElement(obj.Parent);
            if (FCommon.UI.isValidObject(obj.Parent) == false) {
                return (false);
            }
            if (FCommon.UI.isValidObject(obj.sElementIdPrefix) == true
                && FCommon.String.isNullOrEmpty(obj.sElementIdPrefix) == false) {
                sPrefix = obj.sElementIdPrefix;
            }
            if (FCommon.UI.isValidObject(obj.fnDblClick) == true) {
                if (FCommon.String.isNullOrEmpty(obj.fnDblClick) == false) {
                    sDblClickCallback = obj.fnDblClick;
                }
            }
            iLevel = 0;
            currentUL = document.createElement('ul');
            currentUL.setAttribute("data-fieldid", 0);
            currentUL.setAttribute("data-parentid", 0);
            currentUL.setAttribute("data-subparentid", -1);
            currentUL.setAttribute("class", "customizationTreeMenu")
            currentUL.style.paddingLeft = "0";
            rootUL = currentUL;
            for (iCounter = 0; iCounter < obj.arrTreeData.length; iCounter++) {
                value = obj.arrTreeData[iCounter];

                if (value.iLevel > iLevel) {
                    iLevel = value.iLevel;
                }
                else if (value.iLevel <= iLevel) {
                    iLevel = value.iLevel;
                    if (iLevel < arrUL.length) {
                        currentUL = arrUL[iLevel];
                        arrUL.splice(iLevel, arrUL.length - iLevel);
                    }
                }
                li = document.createElement('li');
                if (obj.bRootNodeSeparator == true) {
                    hr = document.createElement('hr');
                    hr.style.margin = "2px";
                    hr.style.marginTop = "8px";
                    hr.style.height = "1px";
                    hr.style.border = "none";
                    hr.style.color = "#9f9f9f";
                    hr.style.backgroundColor = "#9f9f9f";
                }
                a = document.createElement("a");
                i = document.createElement("i");
                span = document.createElement("span");
                a.style.textDecoration = "none";
                a.style.color = "#7d7d7d";
                //$(span).text(value.sName);
                li.setAttribute("id", sPrefix + iCounter);
                li.setAttribute("data-id", value.iSequenceId);
                li.setAttribute("data-fieldid", value.iFieldId);
                li.setAttribute("data-group", value.bGroup);
                li.setAttribute("data-level", value.iLevel);
                li.setAttribute("data-parentid", value.iParentId);
                li.setAttribute("data-subparentid", value.iSubParentId);
                li.setAttribute("data-datatypeid", value.iDataTypeId);
                li.setAttribute("data-masterlink", value.iMasterLink);
                li.setAttribute("data-fieldname", value.sName);
                li.setAttribute("data-sortasc", true);

                if (value.iLevel > 0) {
                    parentNameResult = $.grep(obj.arrTreeData, function (x) {
                        return x.iFieldId == value.iParentId;
                    });
                    if (parentNameResult.length > 0) {
                        var sParentName = parentNameResult[0].sName;
                        if (sParentName == "Fields")
                            sParentName = "";
                    }

                    sToolTipText = TREESEARCH.getTreeTooltipText(value.sName, sParentName);
                    if (FCommon.String.isNullOrEmpty(sToolTipText) == false) {
                        li.setAttribute("data-toggle", "tooltip");
                        li.setAttribute("title", sToolTipText);
                        if (sParentName != value.sName) {
                            li.setAttribute("data-groupheading", sParentName);
                        }
                    }
                }

                if (value.bGroup == false) {
                    sToolTipText = value.sName;
                    li.style.cursor = "pointer";
                    if (FCommon.UI.isValidObject(obj.fnDragStart) == true
                        && FCommon.String.isNullOrEmpty(obj.fnDragStart) == false) {
                        li.setAttribute("draggable", "true");
                        li.setAttribute("ondragstart", obj.fnDragStart + "(this,event)");
                        li.setAttribute("ondblclick", sDblClickCallback + "(this,event)");
                    }
                    if (value.sMasterName) {
                        sToolTipText = TREESEARCH.getTreeTooltipText(value.sName, value.sMasterName);
                        if (FCommon.String.isNullOrEmpty(sToolTipText) == false) {
                            li.setAttribute("data-toggle", "tooltip");
                            li.setAttribute("title", sToolTipText);
                        }
                    }
                    if (sToolTipText.startsWith(".") == true) {
                        sToolTipText = sToolTipText.replace('.', '');
                    }
                    $(span).text(sToolTipText);
                }
                else {
                    li.style.cursor = "default";
                    $(span).text(value.sName);
                }
                li.style.whiteSpace = "nowrap";
                li.style.display = "block";
                currentUL.appendChild(li);
                if (value.bGroup == true) {
                    arrUL.push(currentUL);
                    if (FCommon.UI.isValidObject(obj.bCollapsed) == true && obj.bCollapsed == true) {
                        i.setAttribute("class", "icon-expand");
                    }
                    else {
                        i.setAttribute("class", "icon-collepse");
                    }
                    span.style.paddingLeft = "10px";
                    currentUL = document.createElement('ul');
                    currentUL.style.marginLeft = "10px";
                    currentUL.setAttribute("data-fieldid", li.getAttribute("data-fieldid"));
                    currentUL.setAttribute("data-subparentid", li.getAttribute("data-parentid"));
                    if (FCommon.UI.isValidObject(li.parentElement) == true) {
                        currentUL.setAttribute("data-parentid", li.parentElement.getAttribute("data-subparentid"));
                    }
                    else {
                        currentUL.setAttribute("data-parentid", "0");
                    }

                    a.setAttribute("onclick", "TREESEARCH.slideToggleChildren(this,event);");
                    a.setAttribute("class", "icon-collepse");
                    a.appendChild(span);
                    li.appendChild(a);
                    li.appendChild(currentUL);

                    if (obj.bRootNodeSeparator == true && iLevel == 0) {
                        li.appendChild(hr);
                    }
                }
                else {
                    li.style.fontWeight = "normal";
                    span.style.paddingLeft = "8px";
                    span.style.verticalAlign = "middle";
                    a.appendChild(span);
                    li.appendChild(a);
                }
            }
            $(parent).empty();
            parent.appendChild(rootUL);
            $(parent).disableSelection(); // http://stackoverflow.com/questions/2700000/how-to-disable-text-selection-using-jquery

            $(rootUL).find('li').each(function (event) {
                var parent = null;
                try {
                    parent = this.parentElement;

                    if (parseInt(this.getAttribute("data-parentid")) > 0) {
                        this.setAttribute("data-subparentid", parent.getAttribute("data-fieldid"));
                    }
                    this.setAttribute("data-parentid", parent.getAttribute("data-subparentid"));
                }
                catch (err) {
                    console.log("Exception: {TREESEARCH.createTreeNew.each.li} " + err.message);
                }
            });

            if (FCommon.UI.isValidObject(obj.bCollapsed) == true && obj.bCollapsed == true) {
                $(rootUL).find("ul").slideToggle();
            }
            bResult = true;
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.createTreeNew}" + err.message, "Exception");
            bResult = false;
        }
        return (bResult);
    },

    slideToggleChildren: function (liele, event) {
        if (liele.nextElementSibling.style.display == "none") {
            $(liele).removeClass("icon-expand").addClass("icon-collepse");
            liele.nextElementSibling.style.display = "block";
        }
        else {
            $(liele).addClass("icon-expand").removeClass("icon-collepse");
            liele.nextElementSibling.style.display = "none";
        }
    },

    getTreeTooltipText: function (sFieldName, sMasterName) {
        var sValue = "";
        try {
            sValue = sFieldName;
            if (sMasterName != null && sMasterName != "Transaction" && sMasterName != "Transaction Fields" && sMasterName != "Extra Fields"
                    && sMasterName != "Fields" && sMasterName != "Date" && sMasterName != "Time" && sMasterName != sFieldName) {
                sValue = sMasterName + "." + sValue;
            }
            return (sValue);
        }
        catch (err) {
            COMMON.prototype.showMessage("{TREESEARCH.getTreeTooltipText}" + err.message, "EXCEPTION")
        }
    }
};

