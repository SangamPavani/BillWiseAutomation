    validateValue: function (id, obj) {
        let sInputValue = "";
        let sSelectedValue = "";

        try {
            sInputValue = OPTIONCONTROL_INTERNAL.getInputText(id).toLowerCase();
            if (sInputValue.trim() == "" || obj.Data.length <= 1) {
                return;
            }

            sSelectedValue = OPTIONCONTROL_HELPER.getFirstPropertyValue(obj.Data[1]).toLowerCase();
