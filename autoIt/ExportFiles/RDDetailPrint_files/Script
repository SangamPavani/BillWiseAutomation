        // Deletes report column from table
        deleteReportColumn: function (element) {
            var iCounter = 0;
            var result = null;

            try {
                result = RD_ENTRY.CUSTOMIZATION.getReportColumnIndex(element);
                if (result.lValue > 0) {
                    if (RD_ENTRY.m_arrCustomizeColumn[result.data].iFieldId == eRDFIELDID.PARTICULAR) {
                        if (RD_ENTRY.m_arrRowGrouping.length > 0) {
                            result.lValue = 0;
                            result.sValue = ""
                            result.data = "";

                            return (result);
                        }
                    }

                    RD_ENTRY.m_arrCustomizeColumn.splice(result.data, 1);
                    element.parentElement.removeChild(element);

                    result.lValue = 1;
                    result.sValue = "";
                    result.data = result.data;
                }
            }
            catch (err) {
                result.lValue = -1;
                result.sValue = "{RD_ENTRY.CUSTOMIZATION.deleteReportColumn}" + err.message;
                result.data = null;
