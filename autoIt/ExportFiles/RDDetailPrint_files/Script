const FTime = {
    getCurrentTime: function () {
        let d = new Date();
        let value = 0;

        value = FTime.convertIntoFocusTime(d.getHours(), d.getMinutes(), d.getSeconds());

        return (value);
    },

    convertIntoFocusTime: function (iHour, iMinute, iSecond) {
        let iValue = 0;

        try {
            if (iHour < 0 || iHour > 23) {
                return (0);
            }

            if (iMinute < 0 || iMinute > 59) {
                return (0);
            }

            if (iSecond < 0 || iSecond > 59) {
                return (0);
            }

            iValue = iHour << 16 | iMinute << 8 | iSecond;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.convertIntoFocusTime} " + err.message);
        }

        return (iValue);
    },

    getTimeParts: function (iFocusTime) {
        let data = [];

        try {
            data.push(FTime.getHourFromFocusTime(iFocusTime)); // Hour
            data.push(FTime.getMinuteFromFocusTime(iFocusTime)); // Minute
            data.push(FTime.getSecondFromFocusTime(iFocusTime)); // Second
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.getTimeParts} " + err.message);
        }

        return (data);
    },

    getHourFromFocusTime: function (iFocusTime) {
        let value = 0;

        try {
            value = ((iFocusTime & 0xFF0000) >> 16);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.getHourFromFocusTime} " + err.message);
        }

        return (value);
    },

    getMinuteFromFocusTime: function (iFocusTime) {
        let value = 0;

        try {
            value = ((iFocusTime & 0xFF00) >> 8);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.getMinuteFromFocusTime} " + err.message);
        }

        return (value);
    },

    getSecondFromFocusTime: function (iFocusTime) {
        let value = 0;

        try {
            value = (iFocusTime & 0xFF);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.getSecondFromFocusTime} " + err.message);
        }

        return (value);
    },

    addSeconds: function (iFocusTime, iSeconds) {
        let iHour = 0;
        let iMinute = 0;
        let iValue = 0;
        let obj = null;

        try {
            obj = {};
            obj.iDays = 0;
            obj.iTime = 0;

            iValue = FTime.getHourFromFocusTime(iFocusTime);
            if(iValue > 0) { // Hour > 0
                iSeconds += (iValue * (60 * 60));
            }

            iValue = FTime.getMinuteFromFocusTime(iFocusTime);
            if (iValue > 0) { // Minute > 0
                iSeconds += (iValue * 60);
            }

            iSeconds += FTime.getSecondFromFocusTime(iFocusTime);

            iValue = (24 * 60 * 60); // Seconds per day
            if (iSeconds >= iValue) {
                obj.iDays = Math.floor(iSeconds / iValue);
                iSeconds -= (iValue * obj.iDays);
            }

            iHour = 0;
            iValue = (60 * 60); // Seconds per hour
            if (iSeconds >= iValue) {
                iHour = Math.floor(iSeconds / iValue);
                iSeconds -= (iValue * iHour);
            }

            iMinute = 0;
            iValue = 60; // Seconds per minute
            if (iSeconds >= iValue) {
                iMinute = Math.floor(iSeconds / iValue);
                iSeconds -= (iValue * iMinute);
            }

            obj.iTime = FTime.convertIntoFocusTime(iHour, iMinute, iSeconds);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.addSeconds} " + err.message);
        }

        return (obj);
    },

    convertFocusTimeIntoSeconds: function (iFocusTime) {
        let iSeconds = 0;
        let iValue = 0;

        try {
            iSeconds = FTime.getSecondFromFocusTime(iFocusTime);

            iValue = FTime.getHourFromFocusTime(iFocusTime);
            if (iValue > 0) { // Hour > 0
                iSeconds += (iValue * (60 * 60));
            }

            iValue = FTime.getMinuteFromFocusTime(iFocusTime);
            if (iValue > 0) { // Minute > 0
                iSeconds += (iValue * 60);
            }
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.convertFocusTimeIntoSeconds} " + err.message);
        }

        return (iSeconds);
    },

    convertSecondIntoFocusTime: function (iSeconds) {
        let iHour = 0;
        let iMinute = 0;
        let iValue = 0;
        let iTime = 0;

        try {
            iValue = (60 * 60); // Seconds per hour
            if (iSeconds >= iValue) {
                iHour = Math.floor(iSeconds / iValue);
                iSeconds -= (iValue * iHour);
            }

            iValue = 60; // Seconds per minute
            if (iSeconds >= iValue) {
                iMinute = Math.floor(iSeconds / iValue);
                iSeconds -= (iValue * iMinute);
            }

            iTime = FTime.convertIntoFocusTime(iHour, iMinute, iSeconds);
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.convertSecondIntoFocusTime} " + err.message);
        }

        return (iTime);
    },

    convertTimeIntoString: function(iTime, bShowSecond) {
        let sText = "";
        let iHour = 0;
        let iMinute = 0;
        let iSecond = 0;

        try {
            iHour = FTIMECONTROL.getHourFromFocusTime(iTime);
            iMinute = FTIMECONTROL.getMinuteFromFocusTime(iTime);
            iSecond = FTIMECONTROL.getSecondFromFocusTime(iTime);

            sText = DataType.stringPadding(iHour, "00") + ":" + DataType.stringPadding(iMinute, "00");
            if (bShowSecond == true || iSecond > 0) {
                sText += ":" + DataType.stringPadding(iSecond, "00");
            }
        }
        catch(err) {
            FUIElement.showAlert("Exception: {FTime.convertTimeIntoString} " + err.message);
        }

        return (sText);
    },

    diff: function (iTime1, iTime2) {
        let value = 0;

        try {
            iTime1 = FTime.convertFocusTimeIntoSeconds(iTime1);
            iTime2 = FTime.convertFocusTimeIntoSeconds(iTime2);

            value = iTime1 - iTime2;
        }
        catch (err) {
            FUIElement.showAlert("Exception: {FTime.diff} " + err.message);
        }

        return (value);
    }
