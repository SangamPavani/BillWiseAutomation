                            cYear = today.getFullYear() - 1;
                            lastfinenddate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, cYear);
                        } else {
                            cYear = today.getFullYear();
                            lastfinenddate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, cYear);
                        }

                        DATEPICKER.setDate("id_ending_date_" + DashletId, lastfinenddate);
                        DATEPICKER.disableControl("id_starting_date_" + DashletId, true);
                        DATEPICKER.disableControl("id_ending_date_" + DashletId, true);
                        previousStartDate = accDate;
                        previousEndDate = lastfinenddate;
                    }
                    break;
                case 11:
                    if (startdate != null && enddate != null) {
                        var iDay1 = DATE.prototype.getDayFromFocusDate(parseInt(iYesterdayDate));
                        var iMonth1 = DATE.prototype.getMonthFromFocusDate(parseInt(iYesterdayDate));
                        var iYear1 = DATE.prototype.getYearFromFocusDate(parseInt(iYesterdayDate));

                        var Yesterdaydate = DATE.prototype.convertIntoFocusDate(iDay1, iMonth1, iYear1);
                        DATEPICKER.setDate("id_ending_date_" + DashletId, Yesterdaydate);
                        DATEPICKER.setDate("id_starting_date_" + DashletId, Yesterdaydate);

                        DATEPICKER.disableControl("id_starting_date_" + DashletId, true);
                        DATEPICKER.disableControl("id_ending_date_" + DashletId, true);
                        previousStartDate = Yesterdaydate;
                        previousEndDate = Yesterdaydate;
                    }
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{CommonInputView.changeDate}" + err.message, "Exception");
        }
    },

    getLastDayoftheMonth: function (iMonth, iYear) {
        switch (iMonth) {
            case 1:
                iDay1 = 31;
                break;
            case 2:
                if ((iYear % 4) == 0) {
                    iDay1 = 29;
                }
                else {
                    iDay1 = 28;
                }
                break;
            case 3:
                iDay1 = 31;
                break;
            case 4:
                iDay1 = 30;
                break;
            case 5:
                iDay1 = 31;
                break;
            case 6:
                iDay1 = 30;
                break;
            case 7:
                iDay1 = 31;
                break;
            case 8:
                iDay1 = 31;
                break;
            case 9:
                iDay1 = 30;
                break;
            case 10:
                iDay1 = 31;
                break;
            case 11:
