    HasCompanyYears: function (companyId) {
        //;
        var hasCompanyYears = false;
        try {
            if (companyId > 0) {
                var option = null;
                var allYearsTemp = document.getElementById("hdnddlCompanyYearCopy").options;
                var allYears = [];
                if (allYearsTemp.length > 0) {
                    for (var i = 0; i < allYearsTemp.length; i++) {
                        if (i != 0) {
                            if (allYearsTemp[i].value == companyId || allYearsTemp[i].dataset.parentid == companyId) {
                                allYears.push(allYearsTemp[i]);
                            }
                        }
                        else {
                            allYears.push(allYearsTemp[i]);
                        }

                    }
                }
                if (allYears.length > 2) {
                    document.getElementById("ddlCompanyYear").style.display = "block";
                    $("#ddlCompanyYear").empty();
                    option = document.createElement("option");
                    option.className = "options";
                    option.text = "Select Year";
                    document.getElementById("ddlCompanyYear").add(option);
                    for (var i = 0; i < allYears.length; i++) {
                        if (allYears[i].value == companyId || allYears[i].dataset.parentid == companyId) {
                            option = document.createElement("option");
                            option.className = "options";
                            option.value = allYears[i].value;
                            option.setAttribute('data-fiscaldate', allYears[i].getAttribute('data-fiscaldate'));
                            option.setAttribute('data-languageids', allYears[i].getAttribute('data-languageids'));
                            option.setAttribute('data-parentid', allYears[i].getAttribute('data-parentid'));
                            option.text = allYears[i].text;
                            document.getElementById("ddlCompanyYear").add(option);
                            hasCompanyYears = true;
                        }
                    }
                }
                else {
                    document.getElementById("ddlCompanyYear").style.display = "none";
                }
            }
        }
        catch (e) {
            hasCompanyYears = false
        }
        return hasCompanyYears;

