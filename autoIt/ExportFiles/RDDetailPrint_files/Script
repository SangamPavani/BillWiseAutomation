                }
                else {
                    sNumber = DataType.toInt64(sSeries);
                    sNumber = DataType.add(sNumber, 1);
                    sNumber = DataType.toString(sNumber);
                }
            }
            else {
                //get next number; if blank text then 1 else increased by 1
                if (sSeries.length == 0) {
                    sNumber = "1";
                }
                else {
                    sNumber = DataType.toInt64(sSeries);
                    sNumber = DataType.add(sNumber, 1);
                    sNumber = DataType.toString(sNumber);
                }
            }

            // Append alpha value with exra prefix zero with number part
            iLength = sSeries.length;
            for (iCounter = 0; iCounter < iLength; iCounter++) {
                iTemp = sSeries.charCodeAt(iCounter);
                if (iTemp == 48) {
                    sAlpha += String.fromCharCode(iTemp);
                }
                else {
                    break;
                }
            }

            sAlpha += sNumber;
        }
