    getDayofWeekofFirstDay: function (iCurrentDay, iDayOfWeek, iCalendarType) {
        // English - Sun 0, Mon 1, Tue 2, Wed 3, Thu 4, Fri 5, Sat 6
        // Persian - Sun 2, Mon 3, Tue 4, Wed 5, Thu 6, Fri 7, Sat 1 
        try {
            if (iCalendarType == eCalendarType.Shamsi) {
                iDayOfWeek = PERSIAN.getDayofWeekofFirstDay(iCurrentDay, iDayOfWeek);
                iDayOfWeek = PERSIAN.convertDOWIndexFromPersianToEnglish(iDayOfWeek);
            }
            else {
                while (iCurrentDay > 7) {
                    iCurrentDay -= 7;
                }

                while (iCurrentDay > 1) {
                    iCurrentDay--;
                    if (iDayOfWeek > 0) {
                        iDayOfWeek--;
                    }
                    else {
                        iDayOfWeek = 6;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FDate.getDayofWeekofFirstDay} " + err.message);
        }

        return (iDayOfWeek);
    },

