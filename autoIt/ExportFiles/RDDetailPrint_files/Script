                FUIElement.setFocus(RD_ENTRY.PARAMETER.getFieldNameElement());
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.PARAMETER.onOK_Click}" + err.message, "Exception");
            }
        },

