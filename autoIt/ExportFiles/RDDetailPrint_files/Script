                    sURL = DataType.arrayToString(result.data.data);
                    if (DataType.isNullOrEmpty(sURL, true) == false && (DataType.stringStartsWith(sURL, "http://", true) == true
                        || DataType.stringStartsWith(sURL, "https://", true) == true)) {

                        window.open(sURL);
