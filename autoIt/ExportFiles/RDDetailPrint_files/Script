        //isObjectValidForSearchTree: function (obj, iSearchType, sSearchText,level) {
        isObjectValidForSearchTree: function (obj, iSearchType, sSearchText) {
            var bValid = false;
            var pattern = null;

            try {
                if (obj.bGroup == true) {
                    return (false);
                }

                switch (iSearchType) {
                    case 1: // Numeric
                        if (obj.iDataTypeId == eMasterDataType.Number || obj.iDataTypeId == eMasterDataType.Fraction) {
                            bValid = true;
                            if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                                pattern = new RegExp(sSearchText, "i");
                                bValid = pattern.test(obj.sName);
                            }
                        }
                        break;
                    case 2: // String
                        if (obj.iDataTypeId == eMasterDataType.Text) {
                            bValid = true;
                            if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                                pattern = new RegExp(sSearchText, "i");
                                bValid = pattern.test(obj.sName);
                            }
                        }
                        break;
                    case 1: // All
                    default:
                        if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                            if (FCommon.String.isNullOrEmpty(sSearchText) == false) {
                                pattern = new RegExp(sSearchText, "i");
                                bValid = pattern.test(obj.sName);
                                //if (bValid == false && obj.iLevel-1 == level  && obj.bGroup == false) {
                                //    bValid = true;
                                //}
                            }
                        }
                        break;
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{RD_ENTRY.CUSTOMIZATION.isObjectValidForSearchTree} " + err.message, "Exception");
                bValid = false;
            }

            return (bValid);
        },

