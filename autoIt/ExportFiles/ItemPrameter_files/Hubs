             },

            weighingScaleAfterAddProductResult: function (arrFields) {
                return proxies['signalRHub'].invoke.apply(proxies['signalRHub'], $.merge(["WeighingScaleAfterAddProductResult"], $.makeArray(arguments)));
             },

            weighingScaleWhileAddProductResult: function (arrFields) {
                return proxies['signalRHub'].invoke.apply(proxies['signalRHub'], $.merge(["WeighingScaleWhileAddProductResult"], $.makeArray(arguments)));
             },

            weighingScannerResult: function (arrFields) {
                return proxies['signalRHub'].invoke.apply(proxies['signalRHub'], $.merge(["WeighingScannerResult"], $.makeArray(arguments)));
             }
        };

        return proxies;
    };

    signalR.hub = $.hubConnection("/FocusXLR/signalr", { useDefaultPath: false });
    $.extend(signalR, signalR.hub.createHubProxies());

}(window.jQuery, window));
