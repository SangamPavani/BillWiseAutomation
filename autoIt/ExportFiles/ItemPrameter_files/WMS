    FetchLPNCodeGenerationData_Success: function (flag, data) {
        if (flag) {
            var LPNGridData = data;
            var totalrows = FGRIDCONTROL.getTotalRows("LPNCodeGeneration_Table");
             FGRIDCONTROL.deleteRows("LPNCodeGeneration_Table", 1, totalrows);
            FGRIDCONTROL.insertRows("LPNCodeGeneration_Table", 1, totalrows);
            if (LPNGridData != null && LPNGridData != undefined && LPNGridData.length > 0) {
                if (LPNGridData.length > 15) {
                    FGRIDCONTROL.deleteRows("LPNCodeGeneration_Table", 1, totalrows);
                    FGRIDCONTROL.insertRows("LPNCodeGeneration_Table", 1, LPNGridData.length);
                }
                for (var rowCount = 0; rowCount < LPNGridData.length; rowCount++) {

                    if (LPNGridData[rowCount].Type == -1) continue;
                    for (var colCount = 0; colCount < 4; colCount++) {
                        var cellObj = FGRIDCONTROL.getCellObject("LPNCodeGeneration_Table", rowCount + 1, colCount + 1);
                        if (COMMON.prototype.isValidObject(cellObj) == true) {
                            switch (colCount) {
                                case 0:
                                    var LPNCode_TypeDropDown = document.getElementById("LPNCode_TypeDropDown");
                                    LPNCode_TypeDropDown.value = LPNGridData[rowCount].Type;
                                    if (LPNCode_TypeDropDown.selectedOptions.length > 0) {
                                        cellObj.setCellText(LPNCode_TypeDropDown.selectedOptions[0].textContent);
                                        cellObj.setCellData("value", LPNCode_TypeDropDown.value);
                                    }
                                    else {
                                        cellObj.clear();
                                    }
                                    break;
                                case 1:
                                    cell = FGRIDCONTROL.getCellObject("LPNCodeGeneration_Table", rowCount + 1, colCount);
                                    element = LPNCodeGeneration.LPNCodeGenerationElementBasedOnGriValue(parseInt(cell.getCellData()), "LPNCodeGeneration_FieldORValueDropDown");
                                    element.value = LPNGridData[rowCount].FieldValue;
                                    if (element.nodeName.toLowerCase() == "select") {
                                        if (element.selectedOptions.length > 0) {
                                            cellObj.setCellText(element.selectedOptions[0].textContent);
                                            cellObj.setCellData("value", LPNGridData[rowCount].FieldValue);
                                        }
                                        else {
                                            cellObj.clear();
                                        }

                                    }
                                    else {
                                        cellObj.setCellText(element.value, element.value);
                                    }
                                    break;
                                case 2:
                                    cellObj.setCellText(LPNGridData[rowCount].StartPosition);
                                    cellObj.setCellData("value", LPNGridData[rowCount].StartPosition);
                                    break;
                                case 3:
                                    cellObj.setCellText(LPNGridData[rowCount].NumberOfChars);
                                    cellObj.setCellData("value", LPNGridData[rowCount].NumberOfChars);
                                    break;
                            }
                        }
                    }
                }
                LPNCodeGeneration.LPNCodeGenerationScreenNmGridrowChange("LPNCodeGeneration_Table");
            }
        }
    },
