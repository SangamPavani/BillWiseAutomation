    getLPNCodegenerationTabData: function () {
        //debugger
        var iCounter = 0;
        var iTotalRows = 0;
        var lpncodeNum = [];
        var rowData = null;
        var cell = null;
        var obj = null;
        var Sequence = 0;
        var Increament = []

        try {
            FGRIDCONTROL.update("LPNCodeGeneration_Table", null);
            iTotalRows = FGRIDCONTROL.getTotalRows("LPNCodeGeneration_Table");
            for (iCounter = 0; iCounter < iTotalRows; iCounter++) {
                rowData = FGRIDCONTROL.getRowValue("LPNCodeGeneration_Table", iCounter + 1);
                if (rowData[0].Value == "") {
                    continue;
                }
                Increament.push(rowData[0].Value);
                obj = {};

                cell = FGRIDCONTROL.getCellObject("LPNCodeGeneration_Table", iCounter + 1, 1);
                element = LPNCodeGeneration.LPNCodeGenerationElementBasedOnGriValue(parseInt(cell.getCellData()), "LPNCodeGeneration_FieldORValueDropDown");
                if (element.nodeName.toLowerCase() == "select") {
                    obj.FieldValue = rowData[1].Value;
                }
                else {
                    obj.FieldValue = rowData[1].Text;
                }

                obj.NumberOfChars = rowData[3].Text;
                obj.StartPosition = rowData[2].Text;
                obj.Type = rowData[0].Value;
                obj.Sequence = Sequence;
                lpncodeNum.push(obj);
                for (var i = 0; i < lpncodeNum.length; i++) {
                    if (lpncodeNum[i].StartPosition.trim() == "" || lpncodeNum[i].NumberOfChars.trim() == "") {
                        lpncodeNum = "";
                        return;
                    }
                }
                Sequence++;
            }
            var bIncreament = Increament.includes("6");
            if (!bIncreament) {
                COMMON.prototype.showMessage(LPNCodeGeneration.getResourceValue("msgIncreamentisMandatory", GetResourceMessages));
                lpncodeNum = "Increament";
                return (lpncodeNum);
            }
            return (lpncodeNum);
        }
        catch (err) {

        }

        return (null);
    },
