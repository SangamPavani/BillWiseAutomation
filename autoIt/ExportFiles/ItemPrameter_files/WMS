    loadSelected_PageData: function (filterData) {
        //debugger;

        var start;
        var end;
        var totalDataLength = 0;
        var Pages = 0;
        //var dataPerPage = 5;
        var dataPerPage = 100;
        var arrDataPerPage = [];


        //for pagination ----
        if (filterData.length != 0) {
            totalDataLength = filterData.length;
            if (totalDataLength > dataPerPage) {
                $("#myPager").show();
                //$("#myPager").empty();
                if (currentPage == 0) {
                    currentPage = currentPage + 1;
                }
                Pages = totalDataLength / dataPerPage;
                totalNoOfPages = Math.ceil(Pages);
                start = dataPerPage * (currentPage - 1);
                end = dataPerPage * currentPage;

                for (var j = start; j < end; j++) {
                    if (filterData[j] != undefined) {
                        arrDataPerPage.push(filterData[j]);
                    }
                }
            }
            else {
                arrDataPerPage = filterData;
            }

            if ($('#myPager button').length == 0) {
                //if (totalDataLength > 5) {
