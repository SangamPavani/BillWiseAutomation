            content: sContent
        });
    };

    this.getLinksContent = function(objResponse)
    {
        var sImageUrl = objResponse.imageUrl;
        var sTitle = objResponse.text;
        var arrLinks = objResponse.links;
        var iLinksDisplayType = objResponse.displayType;

        var sContent = "";
        sContent += "<div>";
        sContent += "<div><img class='bot-custom-img' width='100%' src='"+sImageUrl+"'/></div>";
        if(sTitle != null)
            sContent += "<div class='bot-img-info'><div class='bot-media-title'>"+sTitle+"</div>";
        if(iLinksDisplayType == 2) {
            sContent += "<div class='bot-relart-container'>";
            sContent += "<table width='100%' cellpadding='2' cellspacing='3'><colgroup width='5%,95%'></colgroup>"
            for (var i = 0; i < arrLinks.length; i++) {
                var sUrl = arrLinks[i].url;
                var sIconUrl = arrLinks[i].icon;
                var sLinkText = arrLinks[i].text;
                sContent += "<tr>";
                if (sIconUrl != null)
                    sContent += "<td><span class='bot-span-link-img'><img width='20' height='20' src='" + sIconUrl + "'/></span></td>";
                else
                    sContent += "<td><span class='bot-span-link-img'><span class='crmbot crmbot-default-file' style='font-size: 13px'></span></span></td>";
                sContent += "<td><span class='bot-span-link'><a target='_blank' href='" + sUrl + "' class='bot-link-url'>" + sLinkText + "</a></span></td></tr>";
            }
            sContent += "</table></div>";
        }else{
            sContent += "<div class='botui-actions-buttons'>";
            for(var j=0; j< arrLinks.length; j++)
            {
                var sUrl = arrLinks[j].url;
                var sLinkText = arrLinks[j].text;
                sContent += "<button type='button' name='btnBotCustomForm' class='botui-custom-button botui-actions-buttons-button' onclick='window.open(\""+sUrl+"\")'>"+sLinkText+"</button>";
            }
            sContent += "</div>";
        }
        sContent += "</div></div>";
        return sContent;
    };

    this.sendSingleCardReply = function(sContextId,sFieldName,sResult,sResult_Name)
    {
        var clRequest = new Object();
        var sEventType = "message";
        if(sContextId != null && sContextId.trim().length >0)
        {
            sEventType = "context";
            clRequest.context_id = sContextId;
        }
        clRequest.eventType = sEventType;
        //clRequest.org_id = me.sCompanyCode;

        if(sFieldName != null && sFieldName.trim().length > 0)
        {
            var clParams = {};
            clParams[sFieldName] =  sResult;
            clParams[sFieldName+"_name"] =  sResult_Name;
            clRequest.parameters = clParams;

        }else {
            var clMessage = new Object();
            clMessage.text = sResult;
            clRequest.message = clMessage;
        }
        clRequest.operation = "message";
        clRequest.botViewMsg = me.botViewMsg;
        clRequest.humanViewMsg = me.humanViewMsg;
        me.botViewMsg = null;
        me.humanViewMsg = null;
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.sendMultipleCardsReply = function(arrReply,sContextId)
    {
        var clRequest = new Object();
        var sEventType = "message";
        if(sContextId != null && sContextId.trim().length >0)
        {
            sEventType = "context";
            clRequest.context_id = sContextId;
            if(sContextId == "bot_feedback")
            {
                clBotChat.closeBot(arrReply);
                return;
            }
        }
        clRequest.eventType = sEventType;
        //clRequest.org_id = me.sCompanyCode;
        clRequest.message = arrReply[0];
        clRequest.parameters = arrReply[1];
        clRequest.operation = "message";
        clRequest.botViewMsg = me.botViewMsg;
        clRequest.humanViewMsg = me.humanViewMsg;
        me.botViewMsg = null;
        me.humanViewMsg = null;
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.handleCustomForm = function(objResponse)
    {
        var isLoading = true;
        var isFeedbackForm = me.getFormType(objResponse);
        var objReplies = objResponse.replies;
        var objInputs = objReplies.inputs;

        var iDelay = parseInt(objResponse.delay);
        if(iDelay == 0)
            iDelay = 1000;
        var sText = objResponse.text;
        var iIndex = -1;

        if(me.getMultiCardCondition())
            isLoading = false;

        if(sText != null && sText.trim().length > 0)
        {
            //sText = me.getBotMessageContent(sText, objResponse,false,true);
            var sMsg = me.getBotMessageContent(sText, objResponse,false,false);
            clBot.message.bot({
                delay: iDelay,
                loading: isLoading,
                type: 'html',
                content: sMsg
            }).then(function(index){
                iIndex = index;
            });
            iDelay += 1000;
        }

        var sContextId = objResponse.context_Id;
        var sFormName = "botForm";
        if(sContextId != null)
            sFormName = sContextId;
        sFormName = sFormName+"_"+clBotUtilities.getCurrentDateTimeAsLong();

        var sContent = me.getFormContent(objResponse,sFormName);
        if(me.getMultiCardCondition())
            isLoading = false;

        var iFormIndex = -1;
        var botForm = new Promise(function (resolve)
        {
            clBot.message.add({
                type: 'html',
                delay: iDelay,
                content: sContent
            }).then(function(index){
                iFormIndex = index;
            });

            onClkClear = function()
            {
                clSimpleConnection.clearControls(document.forms[sFormName]);
                if(isFeedbackForm)
                {
                    for(var k=0; k<objInputs.length; k++) {
                        var iDefaultLevel = 5;
                        if(objInputs[k].level)
                            iDefaultLevel = objInputs[k].level;
                        me.onClkFeedback(-1,objInputs[k].type,null,iDefaultLevel)
                    }
                }
            };

            onClkSubmit = function()
            {
                var arrBtns = document.getElementsByName("btnBotCustomForm");
                arrBtns[0].disabled = true;
                var docForm = document.forms[sFormName];
                var arrElements = docForm.elements;
                var clParams = {};
                var sFieldName = null;
                var sValue= null;
                var sValues = "";
                var isSubmit = false;
                var isUploadExists = false;
                var iUploadSize = 0;
                for(var i=0; i<arrElements.length; i++)
                {
                    sFieldName = arrElements[i].getAttribute("name");
                    if(sFieldName)
                    {
                        if(arrElements[i].type == "radio")
                        {
                            if(arrElements[i].checked)
                            {
                                isSubmit = true;
                                sValue = arrElements[i].value;
                                clParams[sFieldName] = sValue;
                                if(i>0 && sValues.trim().length >0)
                                    sValues += "</br>";
                                sValues += arrElements[i].getAttribute("labelText");
                            }
                        }
                        else if(arrElements[i].type == "file" && arrElements[i].files.length> 0)
                        {
                            var sFileName = arrElements[i].files[0].name;
                            if(sFileName != null && sFileName.trim().length > 0)
                            {
                                isSubmit = true;
                                isUploadExists = true;
                                /*var isValidFile = me.isValidFile(arrElements[i]);
                                if(!isValidFile) {
                                    isSubmit = false;
                                    break;
                                }*/
                                iUploadSize = arrElements[i].files[0].size;
                                me.handleFileUpload(arrElements[i]);
                                sValue = sFileName;
                                clParams[sFieldName] = sFileName;
                                if (i > 0 && sValues.trim().length > 0)
                                    sValues += "</br>";
                                sValues += sFileName;
                            }
                        }
                        else {
                            sValue = arrElements[i].value;
                            if(sFieldName == "sTicketName" && sValues.trim().length > 0)//todo
                                break;
                            if(sValue != null && sValue.trim().length > 0)
                            {
                                isSubmit = true;
                                clParams[sFieldName] = sValue;
                                if (i > 0 && sValues.trim().length > 0 && sValue != null && sValue.trim().length > 0)
                                    sValues += "</br>";
                                if (sValue != null)
                                    sValues += sValue;
                            }
                        }
                    }
                }

                if(!isSubmit) {
                    arrBtns[0].disabled = false;
                    return;
                }
                clBot.message.remove(iFormIndex);
                if(iIndex >= 0) {
                    me.updateBotMessage(sText, objResponse, iDelay, false, iIndex);
                    me.botViewMsg = sText;
                }
                //clBot.message.remove(iFormIndex);
                if(!isFeedbackForm)
                {
                    me.createHumanMessage(sValues);
                    me.humanViewMsg = sValues;

                }else {
                    me.createHumanMessage("Thank you for your feedback.");
                    me.humanViewMsg = "Thank you for your feedback.";
                }
                var iWait = 0;
                if(isUploadExists)
                {
                    me.showLoadingAction();
                    iWait = me.getWaitingTime(iUploadSize);
                }
                setTimeout( function()
                {
                    if(isUploadExists)
                        me.hideLoadingAction();
                    resolve(clParams);
                },iWait);

            }
        }).then(function(result)
        {
            me.sendMultipleCardsReply([null,result],sContextId);
        });
    };

    this.getWaitingTime = function(iUploadSize)
    {
        if(iUploadSize <= 10240)
            return 1500;
        else if(iUploadSize <= (2*10240))
            return 4000;
        else if(iUploadSize <= (3*10240))
            return 6000;
        else if(iUploadSize <= (4*10240))
            return 8000;
        else if(iUploadSize <= (5*10240))
            return 10000;
        else
            return 12000;
    };

    this.getFormContent = function(objResponse,sFormName)
    {
        var objReplies = objResponse.replies;
        var objActions = objReplies.actions;
        var objInputs = objReplies.inputs;

        var sContent = "";
        //sContent += "<div class='bot-msg-tooltip'>";
        sContent += "<div>";
        //sContent += "<div align='left' class='botui-Label'><span class='bot-custom-label'>"+me.botName+"</span></div>";
        sContent += "<div class='botui-custom-msg' align='right'>";
        sContent += "<form name='"+sFormName+"' onsubmit='return false'>";
        sContent += "<table cellspacing='2' cellpadding='2'>";
        for(var i=0; i< objInputs.length; i++)
        {

            var sInputType = objInputs[i].type;
            if(sInputType == clBotChatHandler.TYPE_HAPPINESS_RATING ||
                sInputType == clBotChatHandler.TYPE_STAR_RATING ||
                sInputType == clBotChatHandler.TYPE_LIKE)
            {
                if(objInputs[i].text != null)
                    sContent += "<tr><td><span class='bot-form-label'>"+objInputs[i].text+"</span></td></tr>";
                var iDefaultLevel = 5;
                if(objInputs[i].level != null && objInputs[i].level.trim().length >0 )
                    iDefaultLevel = objInputs[i].level;
                var sId = null;
                var sSubContent = "";

                if(sInputType == clBotChatHandler.TYPE_STAR_RATING)
                {
                    sId = sFormName+"_botFBStar"+i;
                    for(var j=0; j<iDefaultLevel; j++)
                        sSubContent += "<span id='"+sFormName+"_feedbackStar" + j + "' class='bot-FBStar crmbot crmbot-star' " +
                            "onclick='clBotChat.onClkFeedback(" + j + ",\""+sInputType+"\",\""+sId+"\","+iDefaultLevel+",\""+sFormName+"\""+")'></span>";
                        /*sSubContent += "<span id='"+sFormName+"_feedbackStar" + j + "' class='bot-FBStar crmbot icon-star' " +
                            "onclick='clBotChat.onClkFeedback(" + j + ",\""+sInputType+"\",\""+sId+"\","+iDefaultLevel+",\""+sFormName+"\""+")'></span>";*/
                }else if(sInputType == clBotChatHandler.TYPE_HAPPINESS_RATING)
                {
                    sId = sFormName+"_botFBHappiness"+i;
                    for(var j=0; j<iDefaultLevel; j++)
                    {
                        var sClass = me.getHappinessStyleClass(j);
                        sSubContent += "<span id='"+sFormName+"_feedbackHappiness" + j + "' class='"+sClass+"' " +
                            "onclick='clBotChat.onClkFeedback(" + j + ",\"" + sInputType + "\",\"" + sId + "\"," + iDefaultLevel + ",\""+sFormName+"\""+")'></span>";
                    }
                }else
                {
                    sId = sFormName+"_botFBLike"+i;
                    for(var j=0; j<2; j++)
                    {
                        var sClass = "bot-FBLike crmbot crmbot-thumbs-dwn";
                        //var sClass = "bot-FBLike crmbot icon-thumbs-dwn";
                        if(j==1)
                            sClass = "bot-FBLike crmbot crmbot-thumbs-up";
                            //sClass = "bot-FBLike crmbot icon-thumbs-up";
                        sSubContent += "<span id='"+sFormName+"_feedbackLike" + j + "' class='"+sClass+"' " +
                            "onclick='clBotChat.onClkFeedback(" + j + ",\"" + sInputType + "\",\"" + sId + "\""+",2,\""+sFormName+"\""+")'></span>";

                    }
                }
                sContent += "<tr><td><input id='"+sId+"' type='hidden' name='" + objInputs[i].fieldName + "'>";
                sContent += sSubContent;
                sContent += "</td></tr>";
                sContent += "<tr><td>&nbsp;</td></tr>";
            }else if(sInputType == clBotChatHandler.TYPE_RADIO)
            {
                sContent += "<tr><td><div style='padding:10px;'><label style='float: inherit'><input style='height: inherit' labelText='"+objInputs[i].text+"' value='"+objInputs[i].value+"' type='radio' name='" + objInputs[i].fieldName + "'>";
                sContent += "<span style='padding:10px;'>"+objInputs[i].text+"</span></label></div></td></tr>";
            }else if(sInputType == clBotChatHandler.TYPE_FILE)
            {
                if(objInputs[i].text != null)
                    sContent += "<tr><td><span class='bot-form-label'>"+objInputs[i].text+"</span></td></tr>";
                sContent += "<tr><td><input onchange='clBotChat.isValidFile(this)' type='file' filesize='"+objInputs[i].filesize+"' placeholder='Email address.' class='botui-actions-text-input' name='" + objInputs[i].fieldName + "'/>";
                sContent += "<span style='font-size: 10px'>(Max: "+me.getFileSize(objInputs[i].filesize)+")</span></td></tr>";
                //sContent += "<tr><td align='left'><span style='font-size: 11px'>(Max: "+me.getFileSize(objInputs[i].filesize)+")</span></td></tr>";
                sContent += "<tr><td align='center'><span style='font-size: 11px'>------(OR)------</span></td></tr>";
                sContent += "<tr><td align='left'>click here to <button onclick='clScreenRecord.onClkRecord(event)' type='button' id='screenRecordLink' name='btnBotCustomForm' class='botui-custom-button botui-actions-buttons-button' style='border: none;background: none;'>Start Recording</button></td></tr>";
                sContent += "<tr><td align='center'><p style='display: none;color: #03a9f4;font-weight: 500;' id='recordingInstruction'>Recording in progess..stop screen sharing to end and download</p></td></tr>";
            }else if(sInputType == clBotChatHandler.TYPE_INPUT_TEXT_AREA)
            {
                if(objInputs[i].text != null)
                    sContent += "<tr><td><span class='bot-form-label'>"+objInputs[i].text+"</span></td></tr>";
                sContent += "<tr><td><textarea rows='2' cols='0' maxlength='150' class='botui-actions-text-input' name='" + objInputs[i].fieldName + "'></textarea></td></tr>";
                sContent += "<tr><td>&nbsp;</td></tr>";
            }else
            {
                if(objInputs[i].text != null)
                    sContent += "<tr><td><span class='bot-form-label'>"+objInputs[i].text+"</span></td></tr>";
                sContent += "<tr><td><input class='botui-actions-text-input' type='text' ";
                if(objInputs[i].placeHolder != null)
                    sContent += "placeholder='" + objInputs[i].placeHolder + "'";
                sContent += "name='" + objInputs[i].fieldName + "'></td></tr>";
                sContent += "<tr><td>&nbsp;</td></tr>";
            }
        }
        //sContent += "<tr><td>&nbsp;</td></tr>";
        sContent += "<tr><td align='right'><div class='botui-actions-buttons'>";
        for(var j=0; j< objActions.length; j++)
        {
            var sOnClk = null;
            var sType = objActions[j].type;
            if(sType == clBotChatHandler.TYPE_SUBMIT)
                sOnClk = "onClkSubmit()";
            else if(sType == clBotChatHandler.TYPE_CLEAR)
                sOnClk = "onClkClear()";
            sContent += "<button type='button' name='btnBotCustomForm' class='botui-custom-button botui-actions-buttons-button' onclick="+sOnClk+">"+objActions[j].text+"</button>";
        }
        sContent += "</div></td></tr>";
        sContent += "</table>";
        sContent += "</form>";
        sContent += "</div>";
        //if(me.isShowTimeLabel)
        //    sContent += me.updateWithTime(true);
        sContent += "</div>";
        return sContent;
    };

    this.getHappinessStyleClass = function(iIndex)
    {
        var sClass = "bot-FBHappiness crmbot ";
        if (iIndex == 0)
            sClass += "crmbot-g5";//sClass += "icon-g5";
        else if (iIndex == 1)
            sClass += "crmbot-g4";//sClass += "icon-g4";
        else if (iIndex == 2)
            sClass += "crmbot-g3";//sClass += "icon-g3";
        else if (iIndex == 3)
            sClass += "crmbot-g2";//sClass += "icon-g2";
        else if (iIndex == 4)
            sClass += "crmbot-g1";//sClass += "icon-g1";
        return sClass;
    };

    this.getFormType = function(objResponse)
    {
        var objReplies = objResponse.replies;
        var objInputs = objReplies.inputs;
        for(var i=0; i<objInputs.length; i++)
        {
            var sInputType = objInputs[i].type;
            if(sInputType == clBotChatHandler.TYPE_LIKE ||
                sInputType == clBotChatHandler.TYPE_HAPPINESS_RATING ||
                sInputType == clBotChatHandler.TYPE_STAR_RATING)
            {
                return true;
            }
        }
        return false;
    };

    this.onClkFeedback = function (iIndex, sInputType, sId, iDefaultLevel,sFormName)
    {
        if(iIndex >= 0 && sId != null)
            document.getElementById(sId).value = iIndex+1;
        var sIconId = null;
        if(sInputType == clBotChatHandler.TYPE_STAR_RATING)
            sIconId = sFormName+"_feedbackStar";
        else if(sInputType == clBotChatHandler.TYPE_HAPPINESS_RATING)
            sIconId = sFormName+"_feedbackHappiness";
        else if(sInputType == clBotChatHandler.TYPE_LIKE)
        {
            sIconId = sFormName+"_feedbackLike";
            iDefaultLevel = 2;
        }

        var objSpan = null;
        for(var i=0; i<iDefaultLevel; i++)
        {
            objSpan = document.getElementById(sIconId+i);
            objSpan.style.color = "";
            if(sInputType == clBotChatHandler.TYPE_STAR_RATING)
            {
                clBotUtilities.removeClass(objSpan, "crmbot-goldstar");
                //clBotUtilities.removeClass(objSpan, "icon-goldstar");
                clBotUtilities.addClass(objSpan, "crmbot-star");
                //clBotUtilities.addClass(objSpan, "icon-star");
            }
        }
        if(iIndex >= 0)
        {
            var sColor = "green";
            if(iIndex <= 1)
                sColor = "red";
            else if(iIndex == 2)
                sColor = "orange";

            if(sInputType == clBotChatHandler.TYPE_STAR_RATING)
            {
                for (var i = 0; i <= iIndex; i++)
                {
                    objSpan = document.getElementById(sIconId + i);
                    //clBotUtilities.removeClass(objSpan,"icon-star");
                    clBotUtilities.removeClass(objSpan,"crmbot-star");
                    //clBotUtilities.addClass(objSpan,"icon-goldstar");
                    clBotUtilities.addClass(objSpan,"crmbot-goldstar");
                    objSpan.style.color = sColor;
                }
            }else if(sInputType == clBotChatHandler.TYPE_HAPPINESS_RATING)
            {
                objSpan = document.getElementById(sIconId + iIndex);
                objSpan.style.color = sColor;
            }else if(sInputType == clBotChatHandler.TYPE_LIKE){
                sColor = "green";
                if(iIndex < 1)
                    sColor = "red";
                objSpan = document.getElementById(sIconId + iIndex);
                objSpan.style.color = sColor;
            }
        }

    };

    this.getStyleClasses = function(objResponse)
    {

        var sCss = "";
        if (objResponse.color != null)
            sCss += " bot-" + objResponse.color;
        if (objResponse.size != null)
            sCss += " bot-" + objResponse.size;
        if (objResponse.weight != null)
            sCss += " bot-" + objResponse.weight;
        if (objResponse.fontType != null)
            sCss += " bot-" + objResponse.fontType;
        return sCss;

    };

    this.createBotMessage = function (sText, objResponse, iDelay,isSurvey,isHistory,sTime)
    {
        var isLoading = true;
        var isCreateTimeLabel = false;
        if(isHistory) {
            isLoading = false;
            isCreateTimeLabel = true;
        }
        var iIndex = -1;
        sText = me.getBotMessageContent(sText, objResponse,isSurvey,isCreateTimeLabel,sTime);
        clBot.message.bot({
            delay: iDelay,
            loading: isLoading,
            type: 'html',
            content: sText
        }).then(function(index){
            iIndex = index;
        });
        return iIndex;

    };

    this.updateBotMessage = function (sText, objResponse, iDelay,isSurvey,iIndex)
    {
        sText = me.getBotMessageContent(sText, objResponse,isSurvey,true);
        clBot.message.update(iIndex,{
            content: sText
        });

    };

    this.getBotMessageContent_ = function(sText,objResponse,isSurvey,isCreateTimeLabel)
    {
        var sWrapText = sText;
        var sCustomCls = "botui-custom-msg";
        var  sType = objResponse.type;
        if(sType == clBotChatHandler.TYPE_ARTICLES ||
           sType == clBotChatHandler.TYPE_IMAGE ||
           sType == clBotChatHandler.TYPE_LINKS)
        {
            sCustomCls = "botui-custom-msg bot-custom-img-card";
        }
        var sReturn = "";
        if(objResponse.wrap)
            sWrapText = sWrapText.substring(0,30)+"...";
        sReturn += "<div>";
        if(!isSurvey)
            sReturn += "<div align='left' class='botui-Label'><span class='bot-custom-label'>Bot</span></div>";
        if(objResponse.wrap)
        {
            sReturn += "<div class='"+sCustomCls+" bot-tooltip'>";
            sReturn += "<span class='" + me.getStyleClasses(objResponse) + "'>" + sWrapText;
            sReturn += "</span><span class='bot-tooltip-text bot-tooltip-bottom'>"+sText+"</span></div>";
        }else
            sReturn += "<div class='"+sCustomCls+"'><span class='"+me.getStyleClasses(objResponse)+"'>"+sWrapText+"</span></div>";

        if(isCreateTimeLabel)
            sReturn += "<div align='right' class='botui-TimeLabel'><span class='bot-custom-label'>"+new Date().toLocaleTimeString()+"</span></div>";
        sReturn += "</div>";
        return sReturn;

    };

    this.getBotMessageContent = function(sText,objResponse,isSurvey,isCreateTimeLabel,sTime)
    {
        var sWrapText = sText;
        var sCustomCls = "botui-custom-msg";
        if(objResponse != null)
        {
            var sType = objResponse.type;
            if (sType == clBotChatHandler.TYPE_ARTICLES ||
                sType == clBotChatHandler.TYPE_IMAGE ||
                sType == clBotChatHandler.TYPE_LINKS) {
                sCustomCls = "botui-custom-msg bot-custom-img-card";
            }
        }
        var sReturn = "";
        if(objResponse != null && objResponse.wrap)
            sWrapText = sWrapText.substring(0,30)+"...";
        sReturn += "<div  class='bot-msg-tooltip'>";
        if(!isSurvey && (!me.isMultiCard || (me.isMultiCard && me.iMultiCardIndex ==0)))
            sReturn += "<div align='left' class='botui-Label'><span class='bot-custom-label'>"+me.botName+"</span></div>";
        if(objResponse != null) {
            if (objResponse.wrap) {
                sReturn += "<div class='" + sCustomCls + " bot-tooltip'>";
                sReturn += "<span class='" + me.getStyleClasses(objResponse) + "'>" + sWrapText;
                sReturn += "</span><span class='bot-tooltip-text bot-tooltip-bottom'>" + sText + "</span></div>";
            } else
                sReturn += "<div class='" + sCustomCls + "'><span class='" + me.getStyleClasses(objResponse) + "'>" + sWrapText + "</span></div>";
        }else{
            sReturn += "<div class='" + sCustomCls + "'><span>" + sWrapText + "</span></div>";

        }
        if(me.isShowTimeLabel && isCreateTimeLabel && (!me.isMultiCard || (me.isMultiCard && me.iMultiCardIndex == me.iMultiCardCount)))
            sReturn += me.updateWithTime(true,sTime);
        sReturn += "</div>";
        return sReturn;

    };

    this.updateWithTime = function(isBot,sTime)
    {
        var sReturn = "";
        var sDate = null;
        if(!sTime) {
            sDate = new Date().toLocaleTimeString();
            if (!me.isShowSeconds)
                sDate = clBotUtilities.getTimeStringFromDateObject(new Date());
        }else{
            sDate = sTime;
        }
        if(me.isShowTooltip)
        {
            sReturn += "<span class='bot-msg-tooltip-text bot-msg-tooltip-down'>" + sDate + "</span>";
        }else
        {
            var sLabelClass = "botui-userTimeLabel";
            if(isBot)
                sLabelClass = "botui-TimeLabe";
            sReturn += "<div align='left' class='"+sLabelClass+"'><span class='bot-custom-label'>" + sDate + "</span></div>";
        }
        return sReturn;
    };

    this.createHumanMessage = function (sText,sTime)
    {
        sText = me.updateHumanMessage(sText,sTime);
        clBot.message.bot({
            type: 'html',
            content: sText,
            human:true
        });
    };

    this.updateHumanMessage = function(sText,sTime)
    {
        var sReturn = "";
        sReturn += "<div class='bot-msg-tooltip'>";
        sReturn += "<div align='right' class='botui-userLabel'><span class='bot-custom-label'>"+me.humanName+"</span></div>";
        sReturn += "<div class='botui-custom-msg human'>"+sText+"</div>";
        if(me.isShowTimeLabel)
            sReturn += me.updateWithTime(false,sTime);

        sReturn += "</div>";
        return sReturn;

    };

    this.showLoadingAction = function()
    {
        me.toggleBotMainActions(false);
        clBot.message.bot({
            loading: true,
            type: 'text',
            content: "Loading.."
        }).then(function(index){
            me.iMsgIndex = index;
        });
    };

    this.hideLoadingAction = function()
    {
        clBot.message.remove(me.iMsgIndex);
    };

    this.updateLoadIndex = function()
    {
        if(!me.isChatDone)
        {
            me.iMsgIndex = -1;
            me.toggleBotMainActions(true);
        }
    };

    this.handleScroll = function()
    {
        var dvContainer = document.getElementById("botChatContainer").children[0];
        dvContainer.scrollTop = dvContainer.scrollHeight;
        //var arrElems = document.getElementsByClassName("custom-data-form");
        //var elem = arrElems[arrElems.length-1];
        //elem.scrollIntoView(true);
    };

    this.toggleBotMainActions = function(isEnable)
    {
        var objEnd = document.getElementById("spEnd");
        var objHome = document.getElementById("spHome");
        var objSend = document.getElementById("spGo");
        var objTextBox = document.getElementById("user-input");
        if(isEnable)
        {
            objEnd.disabled = false;
            objHome.disabled = false;
            objSend.disabled = false;
            objTextBox.disabled = false;
        }else{
            objEnd.disabled = true;
            objHome.disabled = true;
            objSend.disabled = true;
            objTextBox.disabled = true;
        }
    };

