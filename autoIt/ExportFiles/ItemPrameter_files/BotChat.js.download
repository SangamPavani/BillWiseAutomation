var clBotChat = new function ()
{
    var me = this;
    me.iCompanyCode=null;
    me.iUserId=0;
    me.sUserName=null;
    me.dvChatContainerId=null;
    me.sIconDiv = null;
    me.sChatDivId = null;

    me.iMsgIndex = -1;
    me.isShowSeconds =  true;
    me.isShowTooltip =  true;
    me.isShowTimeLabel =  true;
    me.botName =  "Bot";
    me.humanName =  "You";

    me.isChatDone = false;

    //me.server_URL =  "http://192.168.2.53:8181/centrabot/";
    //me.server_URL =  "http://192.168.3.22:8383/centrabot/";
    me.server_URL =  "https://crm.centrahub.com/centrabot/";
    //me.server_URL =  null;

    me.botViewMsg = null;
    me.humanViewMsg = null;

    var clBot;
    //app.registerInstance("botChat",clBotChat)

    this.loadBot = function(dvChatContainerId,sServerUrl,options,isLoadBotOnRequest,isAlignRight)
    {
        setTimeout( function(){
            me.initBotSources(dvChatContainerId,sServerUrl);
        },500);

        setTimeout( function(){
            me.init(dvChatContainerId,options,isLoadBotOnRequest,isAlignRight);
        },1000);
    };

    this.initBotSources = function(dvChatContainerId,sServerUrl,sDomainUrl)
    {
        if(!document.getElementById(dvChatContainerId))
        {
            me.server_URL = sServerUrl;
            var objDiv = document.createElement("div");
            objDiv.id = dvChatContainerId;
            document.body.appendChild(objDiv);


            var sArr = new Array();
            sArr[0] = me.server_URL+"res/scripts/simpleConnection.js";
            sArr[1] = me.server_URL+"res/scripts/utilities.js";
            sArr[2] = me.server_URL+"res/scripts/DynamicIncResources.js";
            sArr[3] = me.server_URL+"res/scripts/BotChatHandler.js";
            sArr[4] = me.server_URL+"res/scripts/vue.js";
            sArr[5] = me.server_URL+"res/scripts/botui.min.js";
            sArr[6] = me.server_URL+"res/scripts/ScreenRecorder.js";

            for (var i = 0; i < sArr.length; i++) {
                var Addscript = document.createElement('script');
                Addscript.setAttribute('type', 'text/javascript');
                Addscript.setAttribute('src', sArr[i]);
                document.head.appendChild(Addscript);
            }


            sArr = new Array();
            sArr[0] = me.server_URL+"res/styles/BotChatFrame.css";
            sArr[1] = me.server_URL+"res/styles/chatbot.css";
            //sArr[2] = me.server_URL+"res/styles/FontCRM.css";
            sArr[2] = me.server_URL+"res/styles/BotChat.css";
            sArr[3] = me.server_URL+"res/styles/chatbot.css";
            sArr[4] = me.server_URL+"res/styles/botui.min.css";
            sArr[5] = me.server_URL+"res/styles/botui-theme-blue.css";

            for (var i = 0; i < sArr.length; i++) {
                var Addstyle = document.createElement('link');
                Addstyle.setAttribute('type', 'text/css');
                Addstyle.setAttribute('rel', 'stylesheet');
                Addstyle.setAttribute('href', sArr[i]);
                document.head.appendChild(Addstyle);
            }
        }

    };

    // cacheStore{global:{gbName:"pp",gbMobile:"1212121"},session{ssName:"ddd"}});
    /**
     *
     * @param dvChatContainerId
     * @param options ll be associate array for other options like
     * @param isLoadBotOnDemand show bot on demand
     * {floatButtonImg:,
     * floatButtonWidth:,
     * floatButtonHeight:,
     * }
     */
    this.init = function(dvChatContainerId,options,isLoadBotOnRequest,isAlignRight)
    {
        if(!me.sIconDiv)
        {
            me.gb_Store = options.global;
            me.ss_Store = options.session;
            me.initContainers(dvChatContainerId,isLoadBotOnRequest,isAlignRight);
            me.humanName =  options.session.ssName;
        }
    };

    this.initContainers = function(dvChatContainerId,isLoadBotOnRequest,isAlignRight)
    {
        me.dvChatContainerId=dvChatContainerId;

        var dvChatContainer = document.getElementById(dvChatContainerId);
        dvChatContainer.innerHTML = "";
        //clBotUtilities.addClass(dvChatContainer,"bot-chat-container");
        var sClass = "bot-chat-left-container";
        if(isAlignRight)
            sClass = "bot-chat-container";
        clBotUtilities.addClass(dvChatContainer,sClass);

        var dvIconContainer = document.createElement("div");
        dvIconContainer.id = "dvBotIconContainer";

        var dvIconOpenContainer = document.createElement("div");
        dvIconOpenContainer.setAttribute("onclick","clBotChat.openBot()");
        clBotUtilities.addClass(dvIconOpenContainer,"bot-chat-dv-icon bot-tooltip");
        if(isLoadBotOnRequest)
            dvIconContainer.style.display = "none";

        var dvHideBotIconContainer = document.createElement("div");
        dvHideBotIconContainer.setAttribute("onclick","clBotChat.setVisible(false)");
        dvHideBotIconContainer.setAttribute("align","right");
        if(isLoadBotOnRequest)
            dvHideBotIconContainer.style.display = "none";

        var dvIconCloseContainer = document.createElement("div");
        dvIconCloseContainer.setAttribute("onclick","clBotChat.openBot()");
        dvIconCloseContainer.style.display = "none";
        dvIconCloseContainer.setAttribute("align","right");

        var spOpenIcon = document.createElement("span");
        //clBotUtilities.addClass(spOpenIcon,"crmbot icon-chating bot-chat-freeze-icon");
        clBotUtilities.addClass(spOpenIcon,"crmbot crmbot-chating bot-chat-freeze-icon");

        var spCloseIcon = document.createElement("span");
        //clBotUtilities.addClass(spCloseIcon,"crmbot icon-down-arrow bot-chat-freeze-icon");
        clBotUtilities.addClass(spCloseIcon,"crmbot crmbot-down-arrow bot-chat-freeze-icon");

        var spTooltip = document.createElement("span");
        spTooltip.innerHTML = "<b>We're Online! </b></br> Chat with us now.";
        //clBotUtilities.addClass(spTooltip,"bot-tooltip-text bot-tooltip-left");
        if(isAlignRight)
            clBotUtilities.addClass(spTooltip,"bot-tooltip-text bot-tooltip-left");
        else
            clBotUtilities.addClass(spTooltip,"bot-tooltip-text bot-tooltip-right");

        var spHideIcon = document.createElement("span");
        //clBotUtilities.addClass(spCloseIcon,"crmbot icon-down-arrow bot-chat-freeze-icon");
        clBotUtilities.addClass(spHideIcon,"crmbot crmbot-close bot-chat-hide-icon");

        var dvBotChatContainer = document.createElement("div");
        dvBotChatContainer.id = "dvBotChatContainer";
        dvBotChatContainer.style.display = "none";
        clBotUtilities.addClass(dvBotChatContainer,"bot-chat-conversation");
        dvBotChatContainer.setAttribute("haschat",false);

        dvIconOpenContainer.appendChild(spOpenIcon);
        dvIconOpenContainer.appendChild(spTooltip);
        dvIconCloseContainer.appendChild(spCloseIcon);
        dvHideBotIconContainer.appendChild(spHideIcon);

        dvIconContainer.appendChild(dvHideBotIconContainer);
        dvIconContainer.appendChild(dvIconOpenContainer);
        dvIconContainer.appendChild(dvIconCloseContainer);

        dvChatContainer.appendChild(dvIconContainer);
        dvChatContainer.appendChild(dvBotChatContainer);

        clBotChat.setIconContainer("dvBotIconContainer");
        clBotChat.setChatContainer("dvBotChatContainer");
    };

    this.setVisible = function(isShow)
    {
        //me.toggleChat();
        if(isShow)
            document.getElementById("dvBotIconContainer").style.display = "block";
        else
            document.getElementById("dvBotIconContainer").style.display = "none";
    };

    this.setBotProperties = function(botName,isShowTimeLabel,isShowSeconds,isShowTooltip)
    {
        me.botName =  botName;
        //me.humanName =  humanName;
        me.isShowTimeLabel = isShowTimeLabel;
        me.isShowSeconds = isShowSeconds;
        me.isShowTooltip = isShowTooltip;
    };

    this.setCompanyInfo = function(sCompanyCode)
    {
        me.sCompanyCode = sCompanyCode;
    };

    this.setUserInfo = function(userId, userName)
    {
        me.iUserId = userId;
        me.sUserName = userName;
    };

    this.setIconContainer = function(sIconDivId)
    {
        me.sIconDiv = sIconDivId;
    };

    this.getCacheData = function()
    {
        var clVisitor = new Object();
        clVisitor.global_Store = me.gb_Store;
        clVisitor.session_Store = me.ss_Store;

        return clVisitor;
    };


    this.setChatContainer = function(sChatDivId)
    {
        me.sChatDivId = sChatDivId;
    };

    this.onClkOpenBotChat = function(sUrl)
    {
        var dvBotChatContainer = document.getElementById(me.sChatDivId);
        var dvBotIconContainer = document.getElementById(me.sIconDiv);
        var isHasChatHistory = dvBotChatContainer.getAttribute("hasChat");
        if(isHasChatHistory == "false" || me.isChatDone)
        {
            if(!sUrl)
            {
                sUrl = me.server_URL+"botChat!getBotChat.do";
                //sUrl = clSimpleConnection.getContextPath()+"/botChat!getBotChat.do";
            }
            me.isChatDone = false;
            clBotChatHandler.sessionId = null;
            clSimpleConnection.makePostRequest(sUrl,null,null,clBotChat.handleOpenChatResponse);

        }else{
            me.toggleChat();
        }
    };

    this.handleOpenChatResponse = function(sResponse,iStatusCode,sMessage,appValue)
    {
        var dvBotChatContainer = document.getElementById(me.sChatDivId);
        var dvBotIconContainer = document.getElementById(me.sIconDiv);
        document.getElementById('dvBotChatContainer').innerHTML = sResponse;
        dvBotChatContainer.setAttribute("hasChat","true");
        dvBotChatContainer.style.display ="block";
        //dvBotIconContainer.style.display ="none";
        var dvHideIcon = dvBotIconContainer.children[0];
        var dvOpenIcon = dvBotIconContainer.children[1];
        var dvCloseIcon = dvBotIconContainer.children[2];
        dvCloseIcon.style.display = "block";
        dvOpenIcon.style.display = "none";
        dvHideIcon.style.display = "none";
        if (typeof window["initAllCombos"] == "function")
            initAllCombos=null;
        loadResources(dvBotChatContainer, clSimpleConnection.onScriptsLoad);
        me.onBotLoad();
        //var arrNames = appValue.split(",");
        //var arrTimeProps = sMessage.split(",");
        //me.setBotProperties(appValue,arrTimeProps[0]=="true",arrTimeProps[1]=="true",arrTimeProps[2]=="true");

    };

    this.onClkEndChat = function()
    {
        if(me.iMsgIndex >= 0)
            return;
        clBot.action.hide();
        var arrBtns = document.getElementsByName("btnBotCustomForm");
        if(arrBtns != null)
        {
            for (var i = 0; i < arrBtns.length; i++)
                arrBtns[i].style.display = "none";
        }
        me.createHumanMessage("End");
        me.humanViewMsg = "End";
        var clRequest = new Object();
        clRequest.eventType = "message";
        var clMessage = new Object();
        clMessage.text = "take_bot_feedback";
        clRequest.message = clMessage;
        clRequest.operation = "message";
        clRequest.humanViewMsg = me.humanViewMsg;
        clRequest.botViewMsg = me.botViewMsg;
        me.humanViewMsg = null;
        me.botViewMsg = null;
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.onClkGotoHome = function(isCreateHumaMsg)
    {
        if(me.iMsgIndex >= 0)
            return;
        clBot.action.hide();
        var arrBtns = document.getElementsByName("btnBotCustomForm");
        if(arrBtns != null)
        {
            for (var i = 0; i < arrBtns.length; i++)
                arrBtns[i].style.display = "none";
        }
        if(isCreateHumaMsg) {
            me.createHumanMessage("Back to home");
            me.humanViewMsg = "Back to home";
        }
        var clRequest = new Object();
        clRequest.eventType = "message";
        var clMessage = new Object();
        clMessage.text = "back_to_main_menu";
        clRequest.message = clMessage;
        clRequest.operation = "message";
        clRequest.humanViewMsg = me.humanViewMsg;
        clRequest.botViewMsg = me.botViewMsg;
        me.humanViewMsg = null;
        me.botViewMsg = null;
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.toggleChat = function()
    {
        var dvBotChatContainer = document.getElementById(me.sChatDivId);
        var dvBotIconContainer = document.getElementById(me.sIconDiv);
        var dvHideIcon = dvBotIconContainer.children[0];
        var dvOpenIcon = dvBotIconContainer.children[1];
        var dvCloseIcon = dvBotIconContainer.children[2];
        if(dvBotChatContainer.style.display == "block") {
            //clBotChat.closeBot();
            dvBotChatContainer.style.display = "none";
            //dvBotIconContainer.style.display = "block";
            dvCloseIcon.style.display = "none";
            dvOpenIcon.style.display = "block";
            dvHideIcon.style.display = "block";
        }
        else {
            dvBotChatContainer.style.display = "block";
            //dvBotIconContainer.style.display = "none";
            dvCloseIcon.style.display = "block";
            dvOpenIcon.style.display = "none";
            dvHideIcon.style.display = "none";
        }
    };

    this.openBot = function()
    {
        var sUrl = me.server_URL+"botChat!getBotChat.do";
        //var sUrl = clSimpleConnection.getContextPath()+"/botChat!getBotChat.do";
        me.onClkOpenBotChat(sUrl);
    };

    this.closeBot = function(arrReply)
    {
        var clRequest = new Object();
        clRequest.eventType = "end";
        //clRequest.org_id =me.sCompanyCode;
        clRequest.operation = "message";
        if(arrReply)
        {
            clRequest.message = arrReply[0];
            clRequest.parameters = arrReply[1];
        }
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.onBotLoad = function()
    {
        clBot = new BotUI('botChatContainer');
        me.handleStartEvent();
    };

    this.handleStartEvent = function()
    {
        var clRequest = new Object();
        clRequest.eventType = "start";
        //clRequest.org_id = me.sCompanyCode;
        clRequest.operation = "message";

        var clVisitor = me.getCacheData();
        clRequest.visitor = clVisitor;

        //if(clBotUtilities.readCookie("CCRSESSIONID") != null)
        //    util.setCookie("CCRSESSIONID",clBotUtilities.readCookie("CCRSESSIONID"),2);

        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.handleMessageEvent = function(sMessage)
    {
        clBot.action.hide();
        var clRequest = new Object();
        clRequest.eventType = "message";
        //clRequest.org_id = me.sCompanyCode;
        clRequest.query = sMessage;
        clRequest.operation = "chat";
        clBotChatHandler.handleRequest(JSON.stringify(clRequest));
    };

    this.onClkGo = function()
    {
        if(me.iMsgIndex >= 0)
            return;
        var sMessage = document.getElementById("user-input").value;
        if(sMessage != null && sMessage.trim().length > 0)
        {
            clBot.action.hide();
            var arrBtns = document.getElementsByName("btnBotCustomForm");
            if (arrBtns != null) {
                for (var i = 0; i < arrBtns.length; i++)
                    arrBtns[i].style.display = "none";
            }
            me.handleUserMessage(sMessage);
        }

    };

    this.onKeyUp = function(e)
    {
        if(me.iMsgIndex >= 0)
            return;
        var  key = e.keyCode;
        if(key == 13)
        {
            e.preventDefault();
            var sMessage = document.getElementById("user-input").value;
            if(sMessage != null && sMessage.trim().length > 0)
            {
                clBot.action.hide();
                var arrBtns = document.getElementsByName("btnBotCustomForm");
                if(arrBtns != null)
                {
                    for (var i = 0; i < arrBtns.length; i++)
                        arrBtns[i].style.display = "none";
                }
                me.handleUserMessage(sMessage);
            }
        }

    };

    this.handleUserMessage = function(sMessage)
    {
        //var  key = e.keyCode;
        //if(key == 13)
        {
            //e.preventDefault();
            //var message = document.getElementById("user-input").value;

            clBot.message.bot({
                type: 'html',
                content: me.updateHumanMessage(sMessage),
                cssClass: "msgDiv",
                human: true
            }).then(function () {
                document.getElementById("user-input").value = "";
                me.handleMessageEvent(sMessage);
            });
        }

    };

    this.onBeforeBotAction = function(objResponse,iCount,isContainer,isSurvey)
    {
        var objCard = null;
        var arrItems = null;
        if(isContainer)
        {
            var objReplies = objResponse.replies;
            if(isSurvey)
            {
                arrItems = objReplies.questions;
                objCard = arrItems[iCount].input;
            }else
            {
                arrItems = objReplies.items;
                objCard = arrItems[iCount];
            }
        }
        else
            objCard = objResponse;

        return objCard;
    };

    this.isDisplayType = function(sType)
    {
        if(sType == clBotChatHandler.TYPE_TEXT || sType == clBotChatHandler.TYPE_LINKS ||
            sType == clBotChatHandler.TYPE_URL || sType == clBotChatHandler.TYPE_VIDEO ||
            sType == clBotChatHandler.TYPE_IMAGE || sType == clBotChatHandler.TYPE_ARTICLES)
        {
            return true;
        }else{
            return false;
        }
    };

    this.getMultiCardCondition = function()
    {
        return me.isMultiCard && me.iMultiCardIndex > 0;
    };

    this.handleComboSelectAction = function(objResponse,isContainer,iCount,arrReply,isSurvey)
    {
        var isLoading = true;
        var objCard = me.onBeforeBotAction(objResponse,iCount,isContainer,isSurvey);
        var iDelay = parseInt(objCard.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sText = objCard.text;
        var iIndex = -1;
        if(isContainer && isSurvey) {
            var objReplies = objResponse.replies;
            var arrItems = objReplies.questions;
            sText = arrItems[iCount].question;
        }

        if(me.getMultiCardCondition())
            isLoading = false;

        if(sText != null && sText.trim().length > 0)
        {
            var sContent = me.getBotMessageContent(sText, objCard,isSurvey,false);
            clBot.message.bot({
                delay: iDelay,
                loading: isLoading,
                type: 'html',
                content: sContent
            }).then(function(index){
                iIndex = index;
            });
            iDelay += 1000;
        }

        var arrObjActions = [];
        var objValues = objCard.values;
        var objKeys = objCard.options;
        for(var i=0; i<objValues.length; i++)
            arrObjActions[i] = { value: objValues[i],text: objKeys[i]};

        clBot.action.select({
            addMessage:false,
            action: {
                //placeholder : objReplies.placeHolder,
                //multipleselect : objReplies.type == clBotChatHandler.TYPE_MULTISELECTION,
                options : arrObjActions,
                button: {
                    icon: 'check',
                    label: 'OK'
                }
            },
            delay:iDelay,
            loading:isLoading
        }).then(function (result)
        {
            me.handleActionResponse(iIndex,iDelay,iCount,sText,objCard,result.text,result,arrReply,objResponse,isSurvey,isContainer);
        });
    };

    this.handleButtonSelectAction = function(objResponse,isContainer,iCount,arrReply,isSurvey)
    {
        var isLoading = true;
        var objCard = me.onBeforeBotAction(objResponse,iCount,isContainer,isSurvey);
        var iDelay = parseInt(objCard.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sText = objCard.text;
        var iIndex = -1;
        if(isContainer && isSurvey) {
            var objReplies = objResponse.replies;
            var arrItems = objReplies.questions;
            sText = arrItems[iCount].question;
        }
        if(me.getMultiCardCondition())
            isLoading = false;

        if(sText != null && sText.trim().length > 0)
        {
            var sContent = me.getBotMessageContent(sText, objCard,isSurvey,false);
            clBot.message.bot({
                delay: iDelay,
                loading: isLoading,
                type: 'html',
                content: sContent
            }).then(function(index){
                iIndex = index;
            });
            iDelay += 1000;
        }

        var arrObjActions = [];
        var objValues = objCard.values;
        var objKeys = objCard.options;
        for(var i=0; i<objValues.length; i++)
            arrObjActions[i] = {text: objKeys[i],value: objValues[i]};

        clBot.action.button({
            addMessage:false,
            delay: iDelay,
            loading:isLoading,
            action: arrObjActions
        }).then(function(result)
        {
            me.handleActionResponse(iIndex,iDelay,iCount,sText,objCard,result.text,result,arrReply,objResponse,isSurvey,isContainer);
        });
    };

    this.handleButtonAction = function(objResponse,isContainer,iCount,arrReply,isSurvey)
    {
        var isLoading = true;
        var objCard = me.onBeforeBotAction(objResponse,iCount,isContainer,isSurvey);
        var iDelay = parseInt(objCard.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sText = objCard.text;
        var iIndex = -1;
        if(isContainer && isSurvey) {
            var objReplies = objResponse.replies;
            var arrItems = objReplies.questions;
            sText = arrItems[iCount].question;
        }

        if(me.getMultiCardCondition())
            isLoading = false;

        if(sText != null && sText.trim().length > 0)
        {
            var sContent = me.getBotMessageContent(sText, objCard,isSurvey,false);
            clBot.message.bot({
                delay: iDelay,
                loading: isLoading,
                type: 'html',
                content: sContent
            }).then(function(index){
                iIndex = index;
            });
            iDelay += 1000;
        }

        var arrObjActions = [];

        clBot.action.button({
            addMessage:false,
            delay: iDelay,
            loading:isLoading,
            action: arrObjActions
        }).then(function(result)
        {
            me.handleActionResponse(iIndex,iDelay,iCount,sText,objCard,result.text,result,arrReply,objResponse,isSurvey,isContainer);
        });
    };

    this.handleInputAction = function(objResponse,isContainer,iCount,arrReply, isSurvey)
    {
        var isLoading = true;
        var objCard = me.onBeforeBotAction(objResponse,iCount,isContainer,isSurvey);
        var iDelay = parseInt(objCard.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sText = objCard.text;
        var iIndex = -1;
        if(isContainer && isSurvey) {
            var objReplies = objResponse.replies;
            var arrItems = objReplies.questions;
            sText = arrItems[iCount].question;
        }

        if(me.getMultiCardCondition())
            isLoading = false;

        if(sText != null && sText.trim().length > 0)
        {
            var sContent = me.getBotMessageContent(sText, objCard,isSurvey,false);
            clBot.message.bot({
                delay: iDelay,
                loading: isLoading,
                type: 'html',
                content: sContent
            }).then(function(index){
                iIndex = index;
            });
            iDelay += 1000;
        }

        var sSubType = "text";
        var iReplyType = objCard.type;
        if(iReplyType == clBotChatHandler.TYPE_EMAIL)
            sSubType = "email";
        else if(iReplyType == clBotChatHandler.TYPE_PHONE)
            sSubType = "tel";
        else if(iReplyType == clBotChatHandler.TYPE_FILE)
            sSubType = "file";
        else if(iReplyType == clBotChatHandler.TYPE_URL)
            sSubType = "url";

        if(iReplyType == clBotChatHandler.TYPE_FILE)
        {
            clBot.action.text({
                addMessage:false,
                delay:iDelay,
                loading:isLoading,
                action: {
                    sub_type: sSubType,
                    placeholder: objCard.placeHolder,
                    button: {
                        label: 'Upload'
                    }
                }
            }).then(function(result)
            {
                var fileInput = document.getElementsByClassName("botui-actions-text-input")[0];
                var sFileName = fileInput.files[0].name;
                me.handleFileUpload(fileInput);
                me.handleActionResponse(iIndex,iDelay,iCount,sText,objCard,sFileName,result,arrReply,objResponse,isSurvey,isContainer);
            });
        }else{
            clBot.action.text({
                addMessage:false,
                delay:iDelay,
                loading:isLoading,
                action: {
                    sub_type: sSubType,
                    placeholder: objCard.placeHolder
                }
            }).then(function(result)
            {
                me.handleActionResponse(iIndex,iDelay,iCount,sText,objCard,result.value,result,arrReply,objResponse,isSurvey,isContainer);
            });
        }

    };

    this.isValidFile = function(fileInput)
    {
        var iFileLimit = fileInput.getAttribute("filesize");
        var objFile = fileInput.files[0];
        if ((objFile.size/1024) > iFileLimit)
        {
            alert("File size should be less than "+me.getFileSize(iFileLimit));
            fileInput.value="";
            return false;
        }
        return true;
    };

    this.getFileSize = function(iFileLimit)
    {
        var sSize;
        if(iFileLimit < 1024)
            sSize=iFileLimit+" KB";
        else if(iFileLimit < (1024*1024))
            sSize=iFileLimit/1024+" MB";
        else
            sSize=(iFileLimit/(1024*1024))+" GB";

        return sSize;
    };

    this.handleFileUpload = function(fileInput)
    {
        var vFD =null;
        if(!fileInput)
            fileInput = document.getElementsByClassName("botui-actions-text-input")[0];
        var objFile = fileInput.files[0];
        vFD = new FormData();
        vFD.append('upload', objFile);
        var sUrl = "botChat!saveFile.do";
        sUrl += "?fileName="+objFile.name;
        var oXHR = new XMLHttpRequest();
        oXHR.onreadystatechange = function (e)
        {
            if (oXHR.readyState == 4)
            {
                if(oXHR.status == 200)
                    console.log("file upload succesfully");
                else
                    console.log("file upload failed");
            }
        };
        sUrl = me.server_URL+"botChat!saveFile.do";
        sUrl += "?fileName="+objFile.name;
        oXHR.open('POST', sUrl);
        //oXHR.open('POST', clSimpleConnection.getContextPath()+"/"+sUrl);
        oXHR.send(vFD);

    };

    this.handleActionResponse = function(iIndex,iDelay,iCount,sText,objCard,sHumanMsg,
                                         result,arrReply,objResponse,isSurvey,isContainer)
    {
        if(iIndex >= 0)
        {
            me.updateBotMessage(sText, objCard, iDelay, isSurvey, iIndex);
            me.botViewMsg = sText;
        }
        me.createHumanMessage(sHumanMsg);
        me.humanViewMsg = sHumanMsg;

        if(isContainer)
        {
            iCount += 1;
            var sFieldName = objCard.fieldName;
            if(sFieldName!= null && sFieldName.trim().length > 0)
                arrReply[1][sFieldName] = result.value;
            else
                arrReply[0]["text"] = result.value;
            if(isSurvey)
                me.showSurveyActions(arrReply, iCount, objResponse);
            else
                me.showMultipleCards(arrReply, iCount, objResponse);
        }
        else
            me.sendSingleCardReply(objResponse.context_Id,objResponse.fieldName,result.value,sHumanMsg);
    };

    this.addTextMessage = function(objResponse,isContainer,iCount,arrReply,isSurvey)
    {
        var objCard = null;
        var arrItems = null;
        var isLoading = true;
        if(isContainer)
        {
            var objReplies = objResponse.replies;
            if(isSurvey)
            {
                arrItems = objReplies.questions;
                objCard = arrItems[iCount].input;
            }else
            {
                arrItems = objReplies.items;
                objCard = arrItems[iCount];
            }
        }
        else
            objCard = objResponse;

        var iDelay = parseInt(objCard.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sText = objCard.text;
        if(isContainer && isSurvey)
            sText = arrItems[iCount].question;
        sText = me.getBotMessageContent(sText,objCard,false,true);

        if(me.getMultiCardCondition())
            isLoading = false;

        clBot.message.bot({
            delay: iDelay,
            loading: isLoading,
            type: 'html',
            content: sText
        }).then(function(){
            if(isContainer)
            {
                iCount += 1;
                if(isSurvey)
                    me.showSurveyActions(arrReply, iCount, objResponse);
                else
                    me.showMultipleCards(arrReply, iCount, objResponse);
            }
            if(objResponse.context_Id == "after_bot_end")
            {
                if(dvBotChatContainer.style.display == "block")
                    me.toggleChat();
                me.isChatDone = true;
            }
            if(objResponse.context_Id == "bot_end_message")
            {
                if(dvBotChatContainer.style.display == "block")
                    me.toggleChat();
                clBotChat.closeBot(arrReply);
            }

        });
    };

    this.handleMultiCards = function(objResponse)
    {
        me.isMultiCard = true;
        me.iMultiCardCount = 0;
        me.iMultiCardIndex = 0;

        var objReplies = objResponse.replies;
        var arrItems = objReplies.items;
        me.iMultiCardCount = arrItems.length;

        var arrReply = [];
        var arrMsgReply = {};
        var arrParamReply = {};
        arrReply[0] = arrMsgReply;
        arrReply[1] = arrParamReply;

        var iCount = 0;

        var iDelay = parseInt(objResponse.delay);
        if(iDelay == 0)
            iDelay = 1000;
        var sText = objResponse.text;
        var iIndex = -1;
        if(sText != null && sText.trim().length > 0)
        {
            sText = me.getBotMessageContent(sText, objResponse,false,false);

            me.iMultiCardIndex++;

            clBot.message.bot({
                delay: iDelay,
                loading: true,
                type: 'html',
                content: sText
            }).then(function(index){
                iIndex = index;
            });
        }

        me.showMultipleCards(arrReply,iCount,objResponse,iIndex);
    };


    this.showMultipleCards = function(arrReply,iCount,objMultiCardResponse,iIndex)
    {
        var objReplies = objMultiCardResponse.replies;
        var arrItems = objReplies.items;

        if(iCount <  arrItems.length)
        {
            for(var i=iCount; i<arrItems.length;i++)
            {
                var sType = arrItems[i].type;
                if(me.isDisplayType(sType))
                {
                    var objCard = arrItems[i];
                    clBotChatHandler.showCardByType(objCard, false);

                    me.iMultiCardIndex++;
                }else{
                    clBotChatHandler.showCardByType(objMultiCardResponse, true, i, arrReply);

                    me.iMultiCardIndex++;
                    break;
                }
            }
        }else{
            me.isMultiCard = false;
            me.sendMultipleCardsReply(arrReply,objMultiCardResponse.context_Id)
        }

    };

    this.handleSurvey = function(objResponse)
    {
        var arrReply = [];
        var arrMsgReply = {};
        var arrParamReply = {};
        arrReply[0] = arrMsgReply;
        arrReply[1] = arrParamReply;

        var iCount = 0;

        var iDelay = parseInt(objResponse.delay);
        if(iDelay == 0)
            iDelay = 1000;
        var sText = objResponse.text;
        if(sText != null && sText.trim().length > 0){
            sText = me.getBotMessageContent(sText, objResponse,true,false);
            clBot.message.bot({
                delay: iDelay,
                loading: true,
                type: 'html',
                content: sText
            });
        }
        me.showSurveyActions(arrReply,iCount,objResponse);
    };

    this.showSurveyActions = function(arrReply,iCount,objSurveyResponse)
    {
        var objReplies = objSurveyResponse.replies;
        var arrItems = objReplies.questions;
        if(iCount <  arrItems.length)
            clBotChatHandler.showCardByType(objSurveyResponse, true, iCount, arrReply,true);
        else
            me.sendMultipleCardsReply(arrReply,objSurveyResponse.context_Id)

    };

    this.handleImage = function(objResponse)
    {
        var isLoading = true;
        var iDelay = parseInt(objResponse.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sVideoContent = me.getImageContent(objResponse);
        var sContent = me.getBotMessageContent(sVideoContent, objResponse,false,true);

        if(me.getMultiCardCondition())
            isLoading = false;

        clBot.message.add({
            delay: iDelay,
            loading: isLoading,
            type: 'html',
            content: sContent
        });
    };

