            content: sContent
        });
    };

    this.getArticleContent = function(objResponse)
    {
        var sImageUrl = objResponse.imageUrl;
        var sTitle = objResponse.text;
        var sDescription = objResponse.desc;
        var arrLinks = objResponse.links;

        var sContent = "";
        sContent += "<div>";
        sContent += "<div><img class='bot-custom-img' width='100%' src='"+sImageUrl+"'/></div>";
        if(sTitle != null)
            sContent += "<div class='bot-img-info'><div class='bot-media-title'>"+sTitle+"</div>";
        sContent += "<div class='bot-media-desc'>"+sDescription+"</div>";
        sContent += "<div class='bot-relart-container'>";
        sContent += "<div class='bot-media-sub-title'>Related Articles</div>";
        sContent += "<table width='100%' cellpadding='2' cellspacing='3'><colgroup width='5%,95%'></colgroup>"
        for(var i=0; i<arrLinks.length; i++)
        {
            var sUrl = arrLinks[i].url;
            var sIconUrl = arrLinks[i].icon;
            var sLinkText = arrLinks[i].text;
            sContent += "<tr>";
            if(sIconUrl != null)
                sContent += "<td><span class='bot-span-link-img'><img width='20' height='20' src='"+sIconUrl+"'/></span></td>";
            else
                sContent += "<td><span class='bot-span-link-img'><span class='crmbot crmbot-default-file' style='font-size: 13px;color: #6C6A6A'></span></span></td>";
                //sContent += "<td><span class='bot-span-link-img'><span class='crmbot icon-default-file' style='font-size: 13px;color: #6C6A6A'></span></span></td>";
                //sContent += "<td><span class='bot-span-link-img'><span class='crm crm-default-file' style='font-size: 13px;color: #6C6A6A'></span></span></td>";

            sContent += "<td><span class='bot-span-link'><a target='_blank'  href='"+sUrl+"' class='bot-link-url'>"+sLinkText+"</a></span></td></tr>";
        }
        sContent += "</table></div></div></div>";
        return sContent;

    };

    this.handleLinks = function(objResponse)
    {
        var isLoading = true;
        var iDelay = parseInt(objResponse.delay);
        if(iDelay == 0)
            iDelay = 1000;

        var sLinksContent = me.getLinksContent(objResponse);
