    {
        var sSubmitData = "sessionId="+1647944053391+"&isGetHistory=true";
        clBotChat.showLoadingAction();
        var sUrl = clSimpleConnection.getContextPath()+"/botChat/getChatData";
        clSimpleConnection.makePostRequest(sUrl,sSubmitData,null,clBotChat.handleHistoryResponse,null,null,false,"application/x-www-form-urlencoded;charset=UTF-8",me.sessionId);

    };

    this.handleHistoryResponse =function(arrResponse,iStatusCode,sMessage,appValue)
    {
        if(iStatusCode == 1) {
            me.sessionId = appValue;
            var objResponse = JSON.parse(arrResponse);
            me.hideLoadingAction();
            me.showHistory(objResponse);
        }else{
        }
    };*/

    this.showHistory = function(arrResponse)
    {
        for(var i=0; i<arrResponse.length;i++)
        {
            var arrMessage = arrResponse[i];
            var iMsgBy = arrMessage.msgBy;
            var baseCardDTO = arrMessage.baseCardDTO;
            var text = baseCardDTO.text;
            var sTime = arrMessage.time;
            if(iMsgBy == 1)
                me.createBotMessage(text,null,0,false,true,sTime);
            else
                me.createHumanMessage(text,sTime);
        }
        me.updateLoadIndex();
        me.onClkGotoHome(false);
    };




};



