    getValueFromStructure: function (sId, iRow) {
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (DataType.isValidObject(EntryMain.m_FinalData) == true) {
                if (DataType.isValidObject(iRow) == false) { // Footer
                    if (DataType.isValidObject(EntryMain.m_FinalData.Footer) == true) {
                        result.data = {};
                        result.data.FieldText = EntryMain.m_FinalData.Footer[sId];
                        result.data.FieldValue = EntryMain.m_FinalData.Footer[sId];

                        if (DataType.isValidObject(result.data.FieldValue) == true) {
                            result.lValue = 1;
                        }
                    }
                    else {
                        result.sValue = "Footer data not found";
                    }
                }
                else if (iRow == 0) { // Header
                    result.data = {};
                    result.data.FieldText = EntryMain.m_FinalData.Header[sId];
                    result.data.FieldValue = EntryMain.m_FinalData.Header[sId];

                    if (DataType.isValidObject(result.data.FieldValue) == true) {
                        result.lValue = 1;
                    }
                }
                else { // Body
                    if (DataType.isValidObject(EntryMain.m_FinalData) == true) {
                        if (iRow < 0 || iRow > DataType.arrayLength(EntryMain.m_FinalData.Body)) {
                            result.sValue = "Invalid row index";
                        }
                        else {
                            result.data = {};
                            result.data.FieldText = EntryMain.m_FinalData.Body[iRow - 1][sId];
                            result.data.FieldValue = EntryMain.m_FinalData.Body[iRow - 1][sId];
                        }
                    }
                    else {
                        result.sValue = "Data not found";
                    }
                }
            }
            else {
                result.sValue = "Data not found";
            }

            if (DataType.isValidObject(result.data) == true
                && DataType.isValidObject(result.data.FieldValue) == true) {
                result.lValue = 1;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.getValueFromStructure}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    setValueToStruct: function (sId, value, iRow) {
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (DataType.isValidObject(EntryMain.m_FinalData) == true) {
                if (DataType.isValidObject(iRow) == false) { // Footer
                    if (DataType.isValidObject(EntryMain.m_FinalData.Footer) == true) {
                        EntryMain.m_FinalData.Footer[sId] = value;
                        result.lValue = 1;
                    }
                }
                else if (iRow == 0) { // Header
                    EntryMain.m_FinalData.Header[sId] = value;
                    result.lValue = 1;
                }
                else { // Body
                    if (iRow > 0) { // Existing row
                        if (iRow <= DataType.arrayLength(EntryMain.m_FinalData.Body)) {
                            if (sId == "*") {
                                EntryMain.m_FinalData.Body[iRow - 1] = value;
                            }
                            else {
                                EntryMain.m_FinalData.Body[iRow - 1][sId] = value;
                            }

                            result.lValue = 1;
                        }
                        else {
                            result.sValue = "Invalid row index";
                        }
                    }
                    else { // New Row
                        EntryMain.m_FinalData.Body.push(value);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.setValueToStruct}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

