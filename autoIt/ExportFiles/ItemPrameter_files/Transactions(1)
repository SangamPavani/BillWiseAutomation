    calculateDueDate: function (dtVoucher, iDueDateType, iDueDateValue) {
        let iDay = 0;
        let iMonth = 0;
        let iYear = 0;
        let iLastDay = 0;

        switch (iDueDateType) {
            case 0: // Day;
                dtVoucher = FDate.addDays(dtVoucher, iDueDateValue, transEntryInfo.CalendarType);
                break;
            case 1: // Week
                dtVoucher = FDate.addDays(dtVoucher, iDueDateValue * 7, transEntryInfo.CalendarType);
                break;
            case 2: // Month
                dtVoucher = FDate.addMonths(dtVoucher, iDueDateValue, transEntryInfo.CalendarType);
                break;
            case 3: // Day of week
                iDay = FDate.getDayOfWeek(dtVoucher, transEntryInfo.CalendarType);
                if (iDueDateValue > iDay) {
                    dtVoucher = FDate.addDays(dtVoucher, (iDueDateValue - iDay), transEntryInfo.CalendarType);
                }
                else if (iDueDateValue == iDay) {
                    dtVoucher = FDate.addDays(dtVoucher, 7, transEntryInfo.CalendarType);
                }
                else {
                    dtVoucher = FDate.addDays(dtVoucher, (7 - (iDay - iDueDateValue)), transEntryInfo.CalendarType);
                }
                break;
            case 4: // Day of month                
                iDay = FDate.getDayFromInt(dtVoucher);
                iMonth = FDate.getMonthFromInt(dtVoucher);
                iYear = FDate.getYearFromInt(dtVoucher);
                iLastDay = FDate.maxDays(iMonth, iYear, transEntryInfo.CalendarType);
                if (iDay < iDueDateValue) {
                    if (iDueDateValue <= iLastDay) {
                        iDay += (iDueDateValue - iDay);
                    }
                    else {
                        iDay += (iLastDay - iDay);
                    }

                    dtVoucher = FDate.convertToInt(iDay, iMonth, iYear);
                }
                else if (iDay == iDueDateValue) {
                    dtVoucher = FDate.addMonths(dtVoucher, 1, transEntryInfo.CalendarType);
                }
                else {
                    dtVoucher = FDate.addMonths(dtVoucher, 1, transEntryInfo.CalendarType);                    

                    iMonth = FDate.getMonthFromInt(dtVoucher);
                    iYear = FDate.getYearFromInt(dtVoucher);
                    iLastDay = FDate.maxDays(iMonth, iYear, transEntryInfo.CalendarType);

                    dtVoucher = FDate.convertToInt(iDueDateValue <= iLastDay ? iDueDateValue : iLastDay,
                        iMonth,
                        iYear);
                }
                break;
            case 5: // End of month                
                iMonth = FDate.getMonthFromInt(dtVoucher);
                iYear = FDate.getYearFromInt(dtVoucher);
                iLastDay = FDate.maxDays(iMonth, iYear, transEntryInfo.CalendarType);
                dtVoucher = FDate.convertToInt(iLastDay, iMonth, iYear);
                break;
            case 6: // End of next month
                dtVoucher = FDate.addMonths(dtVoucher, 1, transEntryInfo.CalendarType);
                iMonth = FDate.getMonthFromInt(dtVoucher);
                iLastDay = FDate.maxDays(iMonth, transEntryInfo.CalendarType);
                iMonth = FDate.getMonthFromInt(dtVoucher);
                iYear = FDate.getYearFromInt(dtVoucher);
                dtVoucher = FDate.convertToInt(iLastDay, iMonth, iYear);
                
                break;
        }

        return (dtVoucher);
    },

