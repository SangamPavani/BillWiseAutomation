    loadVoucher: function (objData) {
        let iCounter = 0;
        let iLoadSource = 0;
        let iSchemeId = 0;
        let sWatchValue = "";
        let objSchemeApplied = null;
        let objFlags = null;
        let data = null;
        let tag = null;
        let obj = null;

        try {
            if (FCommon.isFirefox() == true) {
                GLOBAL.LoadingStart();
            }

            data = objData.Data;
            tag = objData.Tag;


            if (DataType.isValidObject(tag) == false) {
                tag = {};
            }

            iLoadSource = eTranEntryLoadSource.None;
            if (DataType.isValidObject(tag.iLoadSource) == true) {
                iLoadSource = tag.iLoadSource;
            }

            EntryMainUI.resetScreen(false, true, (iLoadSource & eTranEntryLoadSource.Version) > 0, false, false, data.lValue > 0);
            if (data.lValue < 0) {
                transEntryGlobal.showAlert(data.sValue, EntryMainUI.getErrorTitle(data.lValue));

                return;
            }
            else if (data.lValue == 0) {
                if (DataType.isNullOrEmpty(data.sValue) == false) {
                    transEntryGlobal.showAlert(data.sValue, GlobalPref.getResourceValue("Error"));

                    EntryMainToolbar.onNew_Click();

                    return;
                }

                transEntryDocumentNo.setText(data.data, false);

                return;
            }

            transEntryGlobal.EntryModel.Data = data.data;

            if (tag.bIgnoreAlreadyLoadedFlag === true) {
                transEntryGlobal.EntryModel.Data.Flags.AlreadyLoaded = false;
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.Data.Header.length; iCounter++) {
                    if (transEntryGlobal.EntryModel.Data.Header[iCounter].Key == "Flags") {
                        transEntryGlobal.EntryModel.Data.Header[iCounter].Value.AlreadyLoaded = false;
                        break;
                    }
                }
            }

            if ((iLoadSource & eTranEntryLoadSource.Version) > 0) {
                transEntryGlobal.EntryModel.Data.Versions = tag.Versions;
            }

            EntryMain.setEditMode(tag.bEdit);
            EntryMainToolbar.updateAuthorizationButton(transEntryGlobal.EntryModel.Data.AuthData);

            transEntryInfo.HomePageViewId = 0;
            if (DataType.toInt(tag.iHomePageViewId) != 0) {
                transEntryInfo.HomePageViewId = tag.iHomePageViewId;
            }

            if (tag.bEdit == true) {
                transEntryInfo.AuthData = transEntryGlobal.EntryModel.Data.AuthData;
            }

            obj = {};
            obj.bLoadingFromVersion = (iLoadSource & eTranEntryLoadSource.Version) > 0;
            obj.bNew = false;
            obj.bResetFocus = false;
            obj.bVoucherLoading = tag.bEdit;
            obj.bFromPendingView = transEntryInfo.HomePageViewId > 0;
            obj.iLoadedDataSource = eLoadedDataSource.LoadVoucher;
            EntryMainUI.setLoadedData(obj);

            objSchemeApplied = transEntryInfo.SchemeApplied;
            if (DataType.isValidObject(objSchemeApplied) == true) {
                iSchemeId = 0;
                if (transEntryInfo.TagsPref.iSchemes == transEntryInfo.TagsPref.iInventory) {
                    iSchemeId = transEntryInvTag.getValue(1);
                }
                else if (transEntryInfo.TagsPref.iSchemes == transEntryInfo.TagsPref.iAccounting) {
                    iSchemeId = EntryMain.m_objTrans.BodyData[0].FATag;
                }
                else {
                    iSchemeId = transEntryGrid.getMasterValue(0, transEntryInfo.TagsPref.iSchemes);
                }

                if (DataType.isValidObject(transEntryInfo.Settings.VoucherScheme) == true && transEntryInfo.Settings.VoucherScheme.bEnableScheme == true && EntryMainScheme.isSchemeClassExist() == true) {
                    ERPSCHEMEIMPLEMENTATION.LoadTransSchemesApplied(objSchemeApplied,
                        iSchemeId,
                        EntryMain.m_objTrans.BodyData[0].Book,
                        EntryMain.m_objTrans.Header.Date);
                }
            }

            if (tag.bEdit == true) {
                if (transEntryInfo.Settings.Misc.PostVAT == true) {
                    transEntryVat.getVATPercent(0);
                }

                transEntryInfo.HeaderFlags = transEntryGlobal.EntryModel.Data.Flags;
                EntryMain.m_bPrevSuspended = transEntryInfo.HeaderFlags.Suspended;

                EntryMainRules.applyEdit(true);

                EntryMainToolbar.showAmendButton(true);
                EntryMain.clearDirty();

                if (EntryMainInfoSidebar.hasTransWorkflow() == true) {
                    EntryMainInfoSidebar.updateLinkVoucherId();
                }

                transEntryGlobal.stopWatch();

                sWatchValue = transEntryGlobal.getWatchValue();
                if (DataType.isNullOrEmpty(sWatchValue, true) == false) {
                    sWatchValue = "(" + sWatchValue + ").";
                }
                else {
                    sWatchValue = ".";
                }

                transEntryGlobal.showAlert("Voucher loaded successfully" + sWatchValue);

                if (transEntryInfo.isStockRevaluation == true) {
                    EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BALANCESTKVAL);
                    EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_NEWSTKVAL);
                }

                if (FConvert.isItWMSConfirm(transEntryInfo.VoucherType) == true && transEntryInfo.VoucherType != eVTTYPE.WMSDISPCONF) {
                    if (transEntryInfo.BaseVoucherType != eVTTYPE.WMSPICKCONF && transEntryInfo.BaseVoucherType != eVTTYPE.WMSMOVECONF) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    }
                    else {
                        EntryMainUI.applyUIRestriction(eTranEntryUIRestriction.PickConfirmation, true);
                    }

                    EntryMain.afterVoucherLoad();

                    return;
                }
                else if (transEntryInfo.isStockRevaluation == true && transEntryInfo.isEditing == true && transEntryInfo.isSavingAllowed == false) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.PostingDetails, false);

                    EntryMain.afterVoucherLoad();

                    return;
                }

                EntryMain.afterVoucherLoad();
            }

            if ((tag.iLoadSource & eTranEntryLoadSource.Authorize) > 0) {
                EntryMainToolbar.onAuthorization_Click();
            }
            else if (tag.bEdit == true) {
                if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                    objFlags = transEntryInfo.HeaderFlags;

                    objFlags.CheckNegativeStock = false;

                    if (transEntryInfo.isInwardVoucher == true) {
                        objFlags.NoBarcodeCheck = true;
                        objFlags.NoLinkCheck = true;
                        objFlags.NoBatchCheck = true;
                    }
                    else if (transEntryInfo.Settings.Misc.UpdateInventory == false
                        && FConvert.isItWMSBatch(transEntryInfo.VoucherType) == true) {

                        objFlags.NoBarcodeCheck = true;
                        objFlags.NoBatchCheck = true;
                        objFlags.NoLinkCheck = true;
                    }
                    else {
                        objFlags.NoLinkCheck = true;
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.loadVoucher} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
        finally {
            if (FCommon.isFirefox() == true) {
                GLOBAL.LoadingEnd();
            }
        }

        if (transEntryGlobal.Version == eVersion.Version10) {
            transEntryWorkflowDashlet.updateUI();
        }
    },

    updateToolbarButtonBasedOnLoadedData: function () {
        let iMaskedVoucherType = 0;
        let iVoucherType = 0;
        let iVoucherDate = 0;
        let iToday = 0;
        let iPrintCount = 0;
        let bSaveDisabled = false;
        let bEdit = false;
        let bCanPrint = false;
        let bEnable = false;
        let arrRowFlag = null;
        let objFlags = null;
        let objRights = false;
        let objAlreadyLoadedInfo = null;

        try {
            bSaveDisabled = false;

            objFlags = transEntryInfo.getHeaderFlags();
            if (DataType.isValidObject(objFlags) == false) {
                return;
            }

            iVoucherType = transEntryInfo.VoucherType;
            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            iVoucherDate = EntryMain.m_objTrans.Header.Date;
            objRights = transEntryGlobal.EntryModel.Rights;
            iToday = transEntryInfo.Today;


            if (EntryMain.checkPermission(SecurityActions.Print) == true) {
                bCanPrint = true;
            }

            iPrintCount = transEntryData.getPrintCount();

            if (objFlags.Editing == true) {
                if (objFlags.Suspended == true) {
                    bEdit = EntryMain.checkPermission(SecurityActions.EditSuspendedDocs) == true;
                }
                else {
                    bEdit = EntryMain.checkPermission(SecurityActions.Edit) == true;
                }

                if (EntryMainUI.isSaudiRestrictionApplied(true) == true) {
                    if (transEntryInfo.MiscellaneousPref.bApplyRestrictionBasedonSaudiLaw == true) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                        bSaveDisabled = true;
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgSauPrintedCantModify"), GlobalPref.getResourceValue("msgSauPrintedCantModify"));
                    }
                }

                if (EntryMainUI.isChequeReturnRestrictionApplied() == true) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    bSaveDisabled = true;
                    transEntryGlobal.showAlert("This voucher cannot be edited because of cheque return.");

                    EntryMainUI.applyUIRestriction(eTranEntryUIRestriction.ChequeReturn, true);
                }

                if (bEdit == false || objFlags.CantEdit == true || FConvert.isItWMSConfirm(iVoucherType)) {
                    if (FConvert.isItWMSConfirm(iVoucherType) == false) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    }
                    else if (transEntryInfo.BaseVoucherType != eVTTYPE.WMSPICKCONF || transEntryInfo.BaseVoucherType != eVTTYPE.WMSMOVECONF) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    }

                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    if (EntryMain.checkPermission(SecurityActions.PermanentSuspendCancel) == true) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, true);
                    }


                    bSaveDisabled = true;
                    if (transEntryInfo.BaseVoucherType == eVTTYPE.WMSPICKCONF || transEntryInfo.BaseVoucherType == eVTTYPE.WMSMOVECONF) {
                        bSaveDisabled = false;
                    }

                    if (iMaskedVoucherType == eVTTYPE.CASHP || iMaskedVoucherType == eVTTYPE.CASHR) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgConvertedFromPDC"), GlobalPref.getResourceValue("msgDocCantModified"));
                    }
                    else if (objFlags.Suspended == true && EntryMain.checkPermission(SecurityActions.EditSuspendedDocs) == false) {
                        transEntryGlobal.showAlert("You do not have editing rights for suspended documents.", GlobalPref.getResourceValue("msgDocCantModified"));
                    }
                    else if (objFlags.Suspended == false && EntryMain.checkPermission(SecurityActions.Edit) == false) {
                        transEntryGlobal.showAlert("You do not have editing rights.", GlobalPref.getResourceValue("msgDocCantModified"));
                    }
                    else {
                        if (bSaveDisabled == true) {
                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgSyncedCannotEdit"), GlobalPref.getResourceValue("msgDocCantModified"));
                        }
                    }
                }

                if (EntryMainPDC.checkBodyPDCFlag(objFlags) == true) {
                    EntryMainPDC.disableControlBasedOnBodyFlag();
                }

                if (bSaveDisabled == false && objFlags.FromPDC == true && (iMaskedVoucherType == eVTTYPE.MEMOP || iMaskedVoucherType == eVTTYPE.MEMOR)) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                }


                if (objFlags.AlreadyLoaded) {
                    if (objFlags.AlreadyLoaded == true) {
                        objAlreadyLoadedInfo = transEntryGlobal.EntryModel.Data.AlreadyLoadedInfo;
                        if (DataType.isValidObject(objAlreadyLoadedInfo) == true
                            && DataType.isNullOrEmpty(objAlreadyLoadedInfo.UserName, true) == false) {

                            transEntryGlobal.showAlert("This document is already loaded by '" + objAlreadyLoadedInfo.UserName + "'");

                            transEntryGlobal.writeInfoLog("Already Loaded Info - HeaderId=" + objAlreadyLoadedInfo.HeaderId + ", LoginName='" + objAlreadyLoadedInfo.UserName + "', LoginId=" + objAlreadyLoadedInfo.LoginId + ", SessionId='" + objAlreadyLoadedInfo.SessionId + "'");
                        }
                        else {
                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgAlreadyLoaded"));
                        }
                    }

                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                    bSaveDisabled = true;
                }

                if (objFlags.WMSAllocated == true && transEntryInfo.BaseVoucherType != eVTTYPE.WMSASN) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                    bSaveDisabled = true;

                    transEntryGlobal.showAlert("Allocation has been made for this document.", GlobalPref.getResourceValue("msgDocCantModified"));
                }

                if (bSaveDisabled == false && objFlags.AuthByHigherUps == true) {
                    if (EntryMain.checkPermission(SecurityActions.EditDocsAuthByHigherUps) == false) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                        bSaveDisabled = true;

                        transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend, Delete buttons disabled due to 'Edit documents authorization by higher ups' right.", 1);
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgAuthHighUps"), GlobalPref.getResourceValue("msgDocCantModified"));
                    }
                }

                if (bSaveDisabled == false
                    && objFlags.RejByHigherUps == true
                    && transEntryGlobal.EntryModel.Data.AuthorizationStatus === GlobalPref.getResourceValue("Rejected")
                    && EntryMain.checkPermission(SecurityActions.EditDocsRejByHigherUps) == false) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                    bSaveDisabled = true;

                    transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend, Delete buttons disabled due to 'Edit documents rejected by higher ups' right.", 1);
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgRejHighUps"), GlobalPref.getResourceValue("msgDocCantModified"));
                }

                if ((iMaskedVoucherType == eVTTYPE.CASHP || iMaskedVoucherType == eVTTYPE.CASHR)
                    && bSaveDisabled == false
                    && EntryMain.checkPermission(SecurityActions.EditDocsReconciled) == false) {

                    // Edit docs that are reconciled
                    arrRowFlag = EntryMainUI.getBodyFlag(0, "BRS", true);
                    if (DataType.arrayFilterDataIndex(arrRowFlag, "", true, "===").length > 0) {

                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                        bSaveDisabled = true;

                        transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend buttons disabled due to 'Edit Reconciled documents' right.", 1);
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgReconciledDoc"), GlobalPref.getResourceValue("msgDocCantModified"));
                    }
                }


                if (transEntryData.getEnteredBy() != transEntryInfo.UserId &&
                    EntryMain.checkPermission(SecurityActions.EditDocsByOther) == false) {

                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false); // Implement Edit Docs Entered By Others
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    bSaveDisabled = true;

                    transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend buttons disabled due to 'Edit documents entered by other' right.", 1);
                }

                if (iPrintCount > 0
                    && EntryMain.checkPermission(SecurityActions.EditDocsRePrinted) == false
                    && bSaveDisabled == false) {

                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    bSaveDisabled = true;

                    transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend buttons disabled due to 'Edit documents that are Printed' right.", 1);
                }

                if (transEntryInfo.Settings.Misc.NoEditing == true) {
                    if (bSaveDisabled == false) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    }

                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    if (EntryMain.checkPermission(SecurityActions.PermanentSuspendCancel) == true) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, true);
                    }

                    EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                }

                if (bSaveDisabled == false && EntryMain.checkPermission(SecurityActions.DontAllowToEditRejectedDocuments) == true
                    && transEntryGlobal.EntryModel.Data.AuthStatus == eVoucherMode.Rejected) {

                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    bSaveDisabled = true;

                    transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend buttons disabled due to 'Dont allow to edit rejected documents' right.", 1);
                }
            }

            arrRowFlag = EntryMainUI.getBodyFlag(1, "ForexFlux");
            if (DataType.arrayLength(transEntryGlobal.EntryModel.Data.Body) > 0 && arrRowFlag.length > 0 && arrRowFlag[0] == true) {
                EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);

                transEntryGlobal.showAlert("This document is posted to update foreign exchange differences and cannot be edited.");
            }

            if (objFlags.Suspended == true) {
                if (bCanPrint == true && objFlags.Draft == false) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Print, false);
                }
            }
            else if (objFlags.Approved == false) // Unauthorized Doc
            {
                if (bCanPrint == true) {
                    bEnable = false;
                    if (EntryMain.checkPermission(SecurityActions.PrintUnauthorizedDocuments) == true) {
                        bEnable = true;
                    }
                    EntryMainToolbar.enableButton(eEntryMainButton.Print, bEnable);
                }
            }
            else  // Authorized doc
            {
                if (iPrintCount > 0) { // Already printed document
                    if (bCanPrint == true) {
                        bEnable = false;
                        if (EntryMain.checkPermission(SecurityActions.RePrint) == true) {
                            bEnable = true;
                        }
                        EntryMainToolbar.enableButton(eEntryMainButton.Print, bEnable);
                    }

                    if (EntryMain.checkPermission(SecurityActions.EditDocsRePrinted) == false
                        && bSaveDisabled == false
                        && iPrintCount > 0) {

                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);

                        transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend buttons disabled due to 'Edit documents that are Printed' right.", 1);
                    }
                }
            }

            if (transEntryInfo.UserId != GlobalPref.SUPER_USER && objFlags.Editing == false) // Not SU
            {
                if (objRights.CantEditAfterDaysOfMon > 0
                    && iVoucherDate < iToday) {
                    if ((FDate.getMonthFromInt(iVoucherDate) < FDate.getMonthFromInt(iToday)
                        || FDate.getYearFromInt(iVoucherDate) < FDate.getYearFromInt(iToday))
                        && FDate.getDayFromInt(iVoucherDate) > objRights.CantEditAfterDaysOfMon) {
                        EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                        EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                    }
                }

                if (objRights.CantEditAfter > 0 && (iToday - iVoucherDate > objRights.CantEditAfter)) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                }
            }

            if (objFlags.Editing == false && objFlags.Cancelled == true) {
                EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);

                if (EntryMain.checkPermission(SecurityActions.PermanentSuspendCancel) == true) {
                    EntryMainToolbar.enableButton(eEntryMainButton.Suspend, true);
                }

                EntryMainToolbar.enableButton(eEntryMainButton.Print, false);
            }

            if (transEntryGlobal.EntryModel.bView == true && transEntryGlobal.EntryModel.bAuthorizeOnly == true) {
                EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Print, false);

                EntryMainToolbar.enableButton(eEntryMainButton.PasteFromClipboard, false);
                EntryMainToolbar.enableButton(eEntryMainButton.RaiseChequeReturn, false);
                EntryMainToolbar.enableButton(eEntryMainButton.CopyDocument, false);
                EntryMainToolbar.enableButton(eEntryMainButton.AddToStock, false);
            }

            if (bCanPrint == true && objFlags.CantPrint == true) {
                EntryMainToolbar.enableButton(eEntryMainButton.Print, false);
            }

            if (objFlags.ChequeReturn == true) {
                EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                EntryMainToolbar.enableButton(eEntryMainButton.RaiseChequeReturn, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);

                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgChequeReturnVoucherLoading"));

                bSaveDisabled = true;
                EntryMainPDC.disableControlBasedOnHeaderFlag();
            }

            if (objFlags.TriggerRaised == true && transEntryInfo.MiscellaneousPref.iDonotModifiedDocumentIfTriggerIsRaised > 0) {
                EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                EntryMainToolbar.enableButton(eEntryMainButton.SaveVersion, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Delete, false);
                EntryMainToolbar.enableButton(eEntryMainButton.Suspend, false);

                transEntryGlobal.writeInfoLog("Info: Save, Version, Suspend, Delete buttons disabled due to 'Dont modify document if trigger is raised' settings.", 1);
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDonotModifiedDocumentIfTriggerIsRaised"));

                bSaveDisabled = true;
            }

            EntryMainAuthorization.enableAuthorizationButton();
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.updateToolbarButtonBasedOnLoadedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    applyRestrictionForSaudi: function () {
        let iCounter = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let arrFooterFields = undefined;
        let objElement = undefined;
        let objMetaData = null;

        try {
            EntryMainUI.m_SaudiRestriction = [];

            if (EntryMainUI.isSaudiRestrictionApplied(false) == false) {
                return;
            }

            if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header
                && transEntryFieldInfo.Book.MetaData.bReadOnly == false) {
                objElement = EntryMainUI.getElement(transEntryFieldInfo.Book, 0).Value;
                OPTIONCONTROL.disableControl(objElement, false);
            }

            if (transEntryFieldInfo.Date.MetaData.bReadOnly == false) {
                objElement = EntryMainUI.getElement(transEntryFieldInfo.Date, 0).Value;
                DATEPICKER.disableControl(objElement, false)
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < arrFooterFields.length; iCounter++) {
                objMetaData = arrFooterFields[iCounter];
                if (objMetaData.iDataTypeId == eMasterDataType.Fraction && objMetaData.iAddToNet != 2) {
                    transEntryFooter.disableControl(objMetaData.iFieldId, false);
                }
            }

            if (DataType.lt(transEntryData.getPrintCount(), 1) == true) {
                return;
            }

            if (transEntryInfo.HeaderId == 0) {
                return;
            }

            if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header
                && transEntryFieldInfo.Book.MetaData.bReadOnly == false) {
                OPTIONCONTROL.disableControl(EntryMainUI.getElement(transEntryFieldInfo.Book, 0).Value, true);
            }

            if (transEntryFieldInfo.Date.MetaData.bReadOnly == false) {
                objElement = EntryMainUI.getElement(transEntryFieldInfo.Date, 0).Value;
                DATEPICKER.disableControl(objElement, true)
            }

            if (transEntryFieldInfo.Item.FieldId > 0) {
                EntryMainUI.m_SaudiRestriction.push(transEntryFieldInfo.Item.FieldId);
            }

            if (transEntryFieldInfo.Qty.FieldId > 0) {
                EntryMainUI.m_SaudiRestriction.push(transEntryFieldInfo.Qty.FieldId);
            }

            if (transEntryFieldInfo.Rate.FieldId > 0) {
                EntryMainUI.m_SaudiRestriction.push(transEntryFieldInfo.Rate.FieldId);
            }

            if (transEntryFieldInfo.Gross.FieldId > 0) {
                EntryMainUI.m_SaudiRestriction.push(transEntryFieldInfo.Gross.FieldId);
            }

            if (transEntryFieldInfo.TaxCode.FieldId > 0) {
                EntryMainUI.m_SaudiRestriction.push(transEntryFieldInfo.TaxCode.FieldId);
            }

            arrFields = transEntryFieldInfo.getScreenFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (objMetaData.iAddToNet != 2) { // 0, Add to Net, 1, Deduct From Next
                    EntryMainUI.m_SaudiRestriction.push(objMetaData.iFieldId);
                }
            }

            for (iCounter = 0; iCounter < arrFooterFields.length; iCounter++) {
                objMetaData = arrFooterFields[iCounter];
                if (objMetaData.iDataTypeId == eMasterDataType.Fraction && objMetaData.iAddToNet != 2) {
                    EntryMainUI.m_SaudiRestriction.push(objMetaData.iFieldId);
                    transEntryFooter.disableControl(objMetaData.iFieldId, true);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.applyRestrictionForSaudi} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

