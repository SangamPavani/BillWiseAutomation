                objMetaData = arrFields[iCounter].MetaData;
                if (objMetaData.iDataTypeId == eMasterDataType.Date && objMetaData.iFieldId == eVTFIELDID.FDF_DATE) {
                    sId = EntryMainUI.getElement(transEntryFieldInfo.Date, 0).Value;

