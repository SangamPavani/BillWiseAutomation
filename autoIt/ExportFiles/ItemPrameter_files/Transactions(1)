            arrFixedValue = transEntryWorkflowInfo.HiddenData;
            for (iCounter = 0; iCounter < arrFixedValue.length; iCounter++) {
                sVoucherNo = arrFixedValue[iCounter].sVoucherNo;

                for (iIndex = 0; iIndex < transEntryWorkflow.m_Workflow.arrConsolidatedData.length; iIndex++) {
                    objRowInfo = transEntryWorkflow.m_Workflow.arrConsolidatedData[iIndex];
                    if (objRowInfo.sVoucherNo === sVoucherNo) {
                        break;
                    }
                }

                if (iIndex < transEntryWorkflow.m_Workflow.arrConsolidatedData.length) {
                    objRowInfo.arrRows.push(iCounter);

                    transEntryWorkflow.m_Workflow.arrConsolidatedData[iIndex] = objRowInfo;
                }
                else {
                    objRowInfo = {};
                    objRowInfo.sVoucherNo = sVoucherNo;
                    objRowInfo.arrRows = [];
                    objRowInfo.arrRows.push(iCounter);

                    transEntryWorkflow.m_Workflow.arrConsolidatedData.push(objRowInfo);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Data.consolidateData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    hasPendingValue: function (lRefId) {
        let sVoucherNo = "";
        let iCounter = 0;
        let iIndex = 0;
        let iRow = 0;
        let arrData = null;
        let arrConData = null;
        let value = 0;

        try {
            lRefId = DataType.toString(lRefId);
            arrData = transEntryWorkflowInfo.HiddenData;
            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                if (DataType.toString(arrData[iCounter].lRefIds) === lRefId) {
                    if (transEntryWorkflowInfo.isConsolidatedDisplay == true) {
                        sVoucherNo = arrData[iCounter].sVoucherNo;
                    }
                    else {
                        value = FNumberOperation.sub(arrData[iCounter].dPendingValue, arrData[iCounter].dUsedValue);

                        return (FNumberOperation.isGreaterThan(value, 0));
                    }

                    break;
                }
            }

            if (DataType.isNullOrEmpty(sVoucherNo, true) == true
                || transEntryWorkflowInfo.isConsolidatedDisplay == false) {

                return (false);
            }

            arrConData = transEntryWorkflowInfo.ConsolidatedData;
            for (iIndex = 0; iIndex < arrConData.length; iIndex++) {
                if (arrConData[iIndex].sVoucherNo === sVoucherNo) {
                    break;
                }
            }

            if (iIndex >= arrConData.length) {
                return (false);
            }

            for (iCounter = 0; iCounter < arrConData[iIndex].arrRows.length; iCounter++) {
                iRow = arrConData[iIndex].arrRows[iCounter];
                value = FNumberOperation.sub(arrData[iRow].dPendingValue, arrData[iRow].dUsedValue);

                if (FNumberOperation.isGreaterThan(value, 0) == true) {
                    return (true);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Data.hasPendingValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

