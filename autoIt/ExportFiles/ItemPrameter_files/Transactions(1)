                }
            }
            else {
                BinsUI.addSelectedBins(null, true);
                arrData = BinsUI.outwardAutoAllocation(arrBinDetails);
            }

            if (arrData != null && arrData.length > 0){
                for (i = 0; i < arrData.length; i++){
                    for (r = 0; r < arrBinDetails.length; r++) {
                        if (BinsUI.m_BinsParam.Inward) {
