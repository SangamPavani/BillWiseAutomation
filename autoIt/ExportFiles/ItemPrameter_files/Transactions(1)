    grdBin_CellLeave: function (RowIndex, iBinId, iSkidId) {
        let dValue = 0;

        if (RowIndex < 0)
            return;

        var dfreespace = 0, dToBeAllocated = 0, dLoad = 0, dQuant = 0;
        var txtBalance = document.getElementById("id_bins_balance");
        var objColumn = {};
        var gridElement = transBinsPopup.getGridElement();
        var totalRows = FGRIDCONTROL.getTotalRows(gridElement);
        var currentcell = BinsUI.getAutoAllocateCellObject(RowIndex);
        var freespacecell = BinsUI.getFreeSpaceCellObject(RowIndex);
       
        var arrIndex = (BinsUI.m_objBinsData.BinDetails).map(function (x) { return x.Id; }).indexOf(iBinId);

        var binsvalidatemsg = document.getElementById("id_hidden_binsvalidation");
        var diffunitnotinsameproductmsg = document.getElementById("id_hidden_diffunitnotsameproduct");
        var diffproductnotsamebinmsg = document.getElementById("id_hidden_diffproductnotsamebin");
        var itemsbasedoncategorymsg = document.getElementById("id_hidden_itemsbasedoncategory");
        var isConsiderWeight = BinsUI.isConsiderWeight(RowIndex);
        var dTotalWeight = 0, dAvailWeight = 0;
        var cell = null;

        try { 
            if (BinsUI.m_objBinsData.BinDetails != null) {
                var result = null;
                result = ($.grep(BinsUI.m_objBinsData.BinDetails, function (e) {
                    return (e.Id == iBinId && e.SkidId == iSkidId);
                }));
                if (result != null && result.length > 0) {
                    objColumn = result[0];
                }
            }
            if (objColumn.Group) {
                BinsUI.disableOK(true);
                currentcell.setCellText(BinsUI.AddDecimalInColumn(0));
                return;
            }
            if (objColumn.Type == eBinsType.Floor || objColumn.Type == eBinsType.Stage) { // For Floor/Stage
                var tobeallocatedcell = null;
                for (var iCounter = 1; iCounter <= totalRows; iCounter++) {
                    tobeallocatedcell = BinsUI.getAutoAllocateCellObject(iCounter);
                    dToBeAllocated += parseFloat(tobeallocatedcell.getCellText());
                }
                dQuant = parseFloat(BinsUI.getTotalQty());
                var dCurrentValue = parseFloat(currentcell.getCellText());
                if (dToBeAllocated == dQuant){
                    BinsUI.disableOK(false);
                    return dCurrentValue;
                }
                if (dToBeAllocated < dQuant){
                    BinsUI.disableOK(true);
                }
                else if (dToBeAllocated > dQuant){
                    if (dCurrentValue == dQuant) {
                        //check weight
                        if (isConsiderWeight) {
                            //check if totalweight <= availableweigt 
                            dTotalWeight = BinsUI.m_dProductWeight * BinsUI.m_dQuantity;
                            cell = BinsUI.getWeightAvailableCellObject(RowIndex);
                            dAvailWeight = parseFloat(cell.getCellText().replace(/,/g, ''));
                            if (dTotalWeight > dAvailWeight) {
                                //show error message
                                BinsUI.disableOK(true);
                                objColumn.ToBeAllocated = 0;
                                currentcell.setCellText(BinsUI.AddDecimalInColumn(0));
                                COMMON.prototype.showMessage("Total weight is more than the available weight");
                                return;
                            }
                        }
                        totalRows = FGRIDCONTROL.getTotalRows(transBinsPopup.getGridElement());
                        for (var j = 1; j <= totalRows; j++) {
                            tobeallocatedcell = BinsUI.getAutoAllocateCellObject(j);
                            tobeallocatedcell.setCellText(BinsUI.AddDecimalInColumn(0));
                        }
                        currentcell.setCellText(dQuant);
                        // BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = dQuant;
                        BinsUI.disableOK(false);
                        return;
                    }
                    else {
                        var dRemValue = dToBeAllocated - dCurrentValue;
                        dRemValue = dQuant - dRemValue;
                        //validate weight
                        if (isConsiderWeight) {
                            //check if totalweight <= availableweigt 
                            dTotalWeight = dRemValue * BinsUI.m_dProductWeight;
                            cell = BinsUI.getWeightAvailableCellObject(RowIndex);
                            dAvailWeight = parseFloat(cell.getCellText().replace(/,/g, ''));
                            if (dTotalWeight > dAvailWeight) {
                                //show error message
                                BinsUI.disableOK(true);
                                objColumn.ToBeAllocated = 0;
                                currentcell.setCellText(BinsUI.AddDecimalInColumn(0));
                                COMMON.prototype.showMessage("Total weight is more than the available weight");
                                return;
                            }
                        }
                        currentcell.setCellText(dRemValue);
                        BinsUI.disableOK(false);
                    }
                }
            }
            else {
                var loadcell=null;
                if (BinsUI.m_bSingleSelection == false) {
                    loadcell = BinsUI.getStockCellObject(RowIndex);//Load column
                    dLoad = DataType.toDecimal(loadcell.getCellText().replace(/\,/g, ''));

                    totalRows = FGRIDCONTROL.getTotalRows(gridElement);//total rows getting updated after search
                    for (var iCounter = 1; iCounter <= totalRows; iCounter++) {
                        tobeallocatedcell = BinsUI.getAutoAllocateCellObject(iCounter);
                        dValue = DataType.toDecimal(tobeallocatedcell.getCellText());
                        dToBeAllocated = DataType.add(dToBeAllocated, dValue);
                    }

                    dQuant = DataType.toDecimal(BinsUI.getTotalQty());
                    if (BinsUI.m_BinsParam.Inward){
                        dfreespace = DataType.toDecimal(freespacecell.getCellText().replace(/\,/g, ''));
                        //if (BinsUI.m_iProdCapacity > 1) {
                        if (BinsUI.m_iProdCapacity > 0) {
                            // If Product Category exits
                            var freequantitycell = BinsUI.getFreeQuantityCellObject(RowIndex);
                            dfreespace = DataType.toDecimal(freequantitycell.getCellText());
                        }
                    }
                    else{
                        dfreespace = DataType.toDecimal(loadcell.getCellText().replace(/\,/g, ''));
                    }
                    var iSameBin = BinsUI.m_Preference.Bins.bCannotBePlacedInSameBin;
                    var iBasedOnCategory = BinsUI.m_Preference.Bins.iBinsAllocationRestriction;
                    var iSameBatch = BinsUI.m_Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin;

                    // Validate bins
                    if (BinsUI.m_BinsParam.Inward == true && iSameBin == Boolean(1)) {  // If Same bin and Inward  
                        if (BinsUI.validateBinsManual(iBinId)) {
                            if (BinsUI.m_bUnitCheck) {
                                if (BinsUI.validateUnitBin(iBinId) == false) {
                                    COMMON.prototype.showMessage(diffunitnotinsameproductmsg.value, binsvalidatemsg.value);
                                    currentcell.setCellText(BinsUI.AddDecimalInColumn(0));
                                    BinsUI.disableOK(true);
                                    return;
                                }
                            }
                            if (parseFloat(currentcell.getCellText()) <= dfreespace) {
