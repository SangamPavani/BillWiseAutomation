    createBodyHelperObject: function () {
        let iCounter = 0;
        let arrFields = undefined;
        let objMetaData = undefined;
        let objIdNamePair = undefined;
        let obj = undefined

        try {
            arrFields = transEntryFieldInfo.getBodyFields();

            if (EntryMainMemoryObject.arrTags == undefined) {
                EntryMainMemoryObject.arrTags = [];
                EntryMainMemoryObject.arrHeaderTags = [];
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];

                    if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0) {
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.InvTag) {
                            continue;
                        }
                        else if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                            continue;
                        }
                        else {
                            if (EntryMainMaster.isInfoField(objMetaData.iFieldId, true) == true) {
                                // Ignore info fields
                                continue;
                            }

                            objIdNamePair = FocusDataStructs.getIdNamePairObject();
                            objIdNamePair.ID = objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID;
                            objIdNamePair.Name = objMetaData.sFieldName;
                            objIdNamePair.Tag = undefined;
                            EntryMainMemoryObject.arrTags.push(objIdNamePair);

                            obj = {};
                            obj.FieldId = objMetaData.iFieldId;
                            obj.ID = objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID;
                            obj.Name = objMetaData.sFieldName;
                            EntryMainMemoryObject.arrHeaderTags.push(obj);
                        }
                    }
                }
                
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;

                    if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.InvTag) {
                            continue;
                        }
                        else if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                            continue;
                        }
                        else {
                            if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                                // Ignore info columns
                                continue;
                            }

                            objIdNamePair = FocusDataStructs.getIdNamePairObject();
                            objIdNamePair.ID = objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID;
                            objIdNamePair.Name = objMetaData.sFieldName;
                            objIdNamePair.Tag = undefined;
                            EntryMainMemoryObject.arrTags.push(objIdNamePair);
                        }
                    }
                }
            }

            if (EntryMainMemoryObject.arrBodyExtra == undefined) {
                EntryMainMemoryObject.arrBodyExtra = [];

                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;

                    if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Text:
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                            case eMasterDataType.Fraction:
                            case eMasterDataType.Boolean:
                            case eMasterDataType.Date:
                            case eMasterDataType.Time:
                            case eMasterDataType.StringList:
                            case eMasterDataType.NumberList:
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                            case eMasterDataType.HyperLink:
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = undefined;
                                EntryMainMemoryObject.arrBodyExtra.push(objIdNamePair);
                                break;
                            case eMasterDataType.Picture:
                            case eMasterDataType.DocumentViewer:
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = undefined;
                                EntryMainMemoryObject.arrBodyExtra.push(objIdNamePair);
                                break;
                        }
                    }
                }
            }

            if (EntryMainMemoryObject.arrScreenData == undefined) {
                EntryMainMemoryObject.arrScreenData = [];

                arrFields = transEntryFieldInfo.getScreenFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;

                    obj = transEntryScreenData.prepareBodyObject(objMetaData.iColMap,
                        objMetaData.iFieldId,
                        objMetaData.sFieldName,
                        0,
                        0);

                    if (objMetaData.bMandatory == true) {
                        obj.Input = undefined;
                        obj.Value = undefined;
                    }

                    EntryMainMemoryObject.arrScreenData.push(obj);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainMemoryObject.createBodyHelperObject} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

