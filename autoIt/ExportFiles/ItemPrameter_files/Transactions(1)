                    if (arrHeader[iCounter].iMasterTypeId == iMasterTypeId) {
                        iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if ((arrHeader[iCounter].iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0) {
                            return (iValue);
                        }
                    }
                }

                arrFields = transEntryFieldInfo.getTags(false);
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
