                    obj.FieldId = objMetaData.iFieldId;
                    arrFilter.push(obj);
                }


                if (objMetaData.iDataTypeId != eMasterDataType.Master) {
                    continue;
                }

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                switch (objMetaData.iMasterTypeId) {
                    case 1: // Account
                        switch (objMetaData.iFieldId) {
                            case eVTFIELDID.FDF_CODE:
                                obj = EntryMainInfoSidebar.getTransDashletFilterObject();
                                obj.iMasterTypeId = 0;
                                obj.iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                                obj.sName = OPTIONCONTROL.getControlText(sId);
                                obj.FieldId = objMetaData.iFieldId;
                                arrFilter.push(obj);
                                break;
                            case eVTFIELDID.FDF_BOOKNO:
                                obj = EntryMainInfoSidebar.getTransDashletFilterObject();
                                obj.iMasterTypeId = objMetaData.iMasterTypeId;
                                obj.iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                                obj.sName = OPTIONCONTROL.getControlText(sId);
                                obj.FieldId = objMetaData.iFieldId;
                                arrFilter.push(obj);
                                break;
                        }
                        break;
                    default:
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                            continue;
                        }

                        if (objMetaData.iMasterTypeId > 0) {
                            obj = EntryMainInfoSidebar.getTransDashletFilterObject();
