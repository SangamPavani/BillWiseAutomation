    ConditionOnVType: function (iVoucherType,bPhantom) {
        let objGlobal = GLOBAL.getGlobalValue();
        let objMRPPref = transEntryInfo.MRPPref;
        if ((objGlobal.ModulesImplemented & eModulesImplemented.MRP1) > 0 && objMRPPref.AllowUserToRaiseBasicProductionOrder ==false)
        {
            if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS)
            {
                return " Isnull(bOutSource,0) = 0 And iOrderStatus BETWEEN 2 AND 3 ";
            }
            else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC) {
                if (!transEntryInfo.isEditing) {
                    if(bPhantom)
                        return " Isnull(bOutSource,0) = 0 And iOrderStatus BETWEEN 2 AND 3 ";
                    else
                        return " Isnull(bOutSource,0) = 0 And iOrderStatus = 3 ";
                }
                else
                    return " Isnull(bOutSource,0) = 0 And iOrderStatus BETWEEN 3 AND 4  ";
            }
            else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS) {
                return " Isnull(bOutSource,0) = 1 And iOrderStatus BETWEEN 2 AND 3 ";
            }
            else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC) {
                if (!transEntryInfo.isEditing) {
                    if (bPhantom)
                        return " Isnull(bOutSource,0) = 1 And iOrderStatus BETWEEN 2 AND 3 ";
                    else
                        return " Isnull(bOutSource,0) = 1 And iOrderStatus = 3 ";
                }
            }
            else {
                return " iOrderStatus BETWEEN 2 AND 3 ";
            }
        }
        else {
            if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS
            ) {
                return " iOrderStatus BETWEEN 2 AND 3 ";
            }
            else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC) {
                if (!transEntryInfo.isEditing)
                    if (bPhantom)
                        return " iOrderStatus BETWEEN 2 and 3 ";
