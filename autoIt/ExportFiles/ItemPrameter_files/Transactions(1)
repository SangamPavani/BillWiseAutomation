    updateLink: function (value, iRow) {
        let iCounter = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let objLinkDef = undefined;
        let objBody = undefined;
        let obj = undefined;

        if (EntryMain.m_objTrans
            && EntryMain.m_objTrans.BodyData
            && EntryMain.m_objTrans.BodyData.length >= iRow) {

            objBody = EntryMain.m_objTrans.BodyData[iRow - 1];
            if (DataType.isNullOrEmpty(value) == true) {
                objBody.Links = value;
                return;
            }

            if (DataType.isArray(objBody.Links) == false) {
                objBody.Links = [];
            }

            if (DataType.isObject(value) == true) {
                if (DataType.isArray(value) == false) {
                    value = [value];
                }
            }
            else {
                obj = DataType.stringToObject(value);
                if (DataType.isValidObject(obj.data) == true) {
                    value = obj.data;
                    if (DataType.isArray(value) == false) {
                        value = [value];
                    }
                }
            }

            if (DataType.isValidObject(value) == false) {
                objBody.Links = value;
                return;
            }

            for (iIndex = 0; iIndex < value.length; iIndex++) {
                obj = value[iIndex];

                arrFields = transEntryFieldInfo.getLinkFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objLinkDef = arrFields[iCounter].MetaData.Tag;
                    if (DataType.isValidObject(objLinkDef) == false) {
                        continue;
                    }

                    if (objLinkDef.LinkId == obj.LinkId) {
                        break;
                    }
                }

                if (iCounter < arrFields.length) {
                    for (iCounter = 0; iCounter < objBody.Links.length; iCounter++) {
                        if (objBody.Links[iCounter].LinkId == obj.LinkId) {
                            objBody.Links[iCounter] = obj;
                            break;
                        }
                    }

                    if (iCounter >= objBody.Links.length) {
                        objBody.Links.push(obj);
                    }
                }
            }
        }
    },

