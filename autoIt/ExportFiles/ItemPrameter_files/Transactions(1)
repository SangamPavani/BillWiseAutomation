        this.getFromFieldName = function (name, iArea) {
            let iCounter = 0;
            let arrFields = undefined;
            let objMetaData = undefined;
            let value = undefined;

            try {
                value = {};
                value.Area = eTranEntryFieldArea.None;
                value.MetaDataIndex = -1;
                value.ColumnIndex = -1;
                value.FieldId = 0;
                value.MetaData = undefined;

                if (DataType.isNullOrEmpty(name, true) == true
                    || transEntryGlobal == undefined || transEntryGlobal == null
                    || transEntryGlobal.EntryModel == undefined || transEntryGlobal.EntryModel == null) {
                    return (value);
                }

                iArea = DataType.toInt(iArea);
                if (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Header) {
                    for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                        objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                        if (objMetaData.sFieldName === name) {
                            value.Area = eTranEntryFieldArea.Header;
                            value.MetaDataIndex = iCounter;
                            value.FieldId = objMetaData.iFieldId;
                            value.MetaData = objMetaData;

                            return (value);
                        }
                    }
                }

                if (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Body) {
                    arrFields = transEntryFieldInfo.getBodyFields({ sFieldName: name, bName: true });
                    if (arrFields.length > 0) {
                        value.Area = eTranEntryFieldArea.Body;
                        value.MetaDataIndex = arrFields[0].MetaDataIndex;
                        value.FieldId = arrFields[0].FieldId;
                        value.MetaData = arrFields[0].MetaData;
                        value.ColumnIndex = arrFields[0].ColumnIndex;

                        return (value);
                    }
                }

                if (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Footer) {
                    if (transEntryGlobal.EntryModel.MetaData.Footer) {
                        for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Footer.length; iCounter++) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iCounter];
                            if (objMetaData.sFieldName === name) {
                                value.Area = eTranEntryFieldArea.Footer;
                                value.MetaDataIndex = iCounter;
                                value.FieldId = objMetaData.iFieldId;
                                value.MetaData = objMetaData;
                                break;
                            }
                        }
                    }
                }
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("{transEntryFieldInfo.getFromFieldName} " + err.message, GlobalPref.getResourceValue("Exception"));
            }

            return (value);
        }

