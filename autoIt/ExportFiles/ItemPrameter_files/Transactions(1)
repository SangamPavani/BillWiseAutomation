            DATEPICKER.setDate("dtDueDate", g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrBreakupByTag[0].dDueDate);
        if (g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments != null && g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments.length > 1) {
            let dDate = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments[0].dDueDate;
            let dFromDate = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments[1].dDueDate;
            let dToDate = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments[0].dDueDate;
            days = FNumberOperation.abs(DATE.prototype.getDateDiffInDays(dFromDate, dToDate));
        }
        else {
            days = 30;
        }
        if (days >= 7 && days <= 14) {
            document.getElementById("cmbRecFrequency").value = 0;
        }
        else if (days >= 15 && days <= 21) {
            document.getElementById("cmbRecFrequency").value = 1;
        }
        else if (days >= 21 && days <= 31) {
            document.getElementById("cmbRecFrequency").value = 2;
        }
        else if (days >= 31 && days <= 92) {
            document.getElementById("cmbRecFrequency").value = 3;
        }
        else if (days >= 92 && days <= 183) {
            document.getElementById("cmbRecFrequency").value = 4;
        }
        else if (days >= 183) {
            document.getElementById("cmbRecFrequency").value = 5;
        }


        //txtNoInstallment.Tag = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrInstallments.length;
        //fgInstallment.DataSource = m_arrInstallments;
    },
};

