    updateRowPosition: function (cellobj, objMetaData) {
        let iCurrentRow = 0;
        let iDeleteCount = 0;
        let iRow = 0;
        let bFlag = false;

        try {
            if(objMetaData.iDataTypeId == eMasterDataType.Master) {
                bFlag = (DataType.toInt(cellobj.getCellData()) > 0);
            }
            else if(objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                bFlag = true;
            }

            if (cellobj.iRow > 1 && bFlag) {
                iCurrentRow = cellobj.iRow;
                for (iRow = cellobj.iRow - 1; iRow > 0; iRow--) {
                    if (EntryMainBody.isMasterDataExistInRow(iRow) == true) {
                        continue;
                    }
                    else {
                        transEntryGrid.deleteRows(iRow, 1);
                        EntryMainMemoryObject.deleteRowData(iRow, 1);
                        iCurrentRow--;
                        transEntryGrid.insertRows(0, 1, true);

                        iDeleteCount++;
                    }
                }

                if (iCurrentRow != cellobj.iRow) {
                    transEntryGrid.setRowFlag(iCurrentRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body updateRowPosition method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.updateRowPosition} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(iDeleteCount);
    },

    updateColumnValue: function (iRow, iColumn, objMetaData, rawValue) {
        let sId = "";
        let sText = "";
        let iCounter = 0;
        let arrLink = null;
        let objBatchInfo = null;
        let objBinInfo = null;
        let objStockToRelease = null;
        let eleControl = null;
        let objValue = null;
        let obj = null;
        let cell = null;

        try {
            if (transEntryInfo.BodySectionNotRequired == false) {
                cell = transEntryGrid.getCellObject(iRow, iColumn);
                if (DataType.isValidObject(cell) == false) {
                    return (false);
                }
            }

            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.Text:
                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_LINK) {
                        if (DataType.isNullOrEmpty(rawValue) == true) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, iRow);
                            break;
                        }

                        arrLink = DataType.stringToObject(rawValue).data;
                        if (DataType.isValidObject(arrLink) == false) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, iRow);
                            break;
                        }

                        if (transEntryInfo.BodySectionNotRequired == true) {

                        }
                        else {
                            EntryMainBody.setLinkColumnValue(arrLink, iRow);
                            EntryMain.m_arrLoadedLinkData = transEntryLinks.getLoadedLinkData();
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, arrLink, iRow);
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                        objBatchInfo = DataType.stringToObject(rawValue);
                        if (objBatchInfo.lValue > 0) {
                            objBatchInfo = objBatchInfo.data;
                            objBatchInfo.MfgDate = objBatchInfo.MfgDate.Value;
                            objBatchInfo.ExpDate = objBatchInfo.ExpDate.Value;

                            EntryMainMemoryObject.update(objMetaData.iFieldId, objBatchInfo, iRow, objMetaData);

                            if (transEntryInfo.BodySectionNotRequired == true) {
                            }
                            else {
                                if (transEntryInfo.isInwardVoucher == true) {
                                    cell.setCellData(objBatchInfo);
                                    cell.setCellText(objBatchInfo.BatchNo, objBatchInfo.BatchNo);
                                }
                                else {
                                    cell.setCellText(objBatchInfo.BatchNo, objBatchInfo);
                                }
                            }
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS) {
                        objBinInfo = DataType.stringToObject(rawValue);
                        if (objBinInfo.lValue > 0) {
                            sText = "";
                            for (iCounter = 0; iCounter < objBinInfo.data.length; iCounter++) {
                                if (DataType.isNullOrEmpty(sText, true) == false) {
                                    sText += ",";
                                }

                                sText += objBinInfo.data[iCounter].BinName;
                            }
                            if (transEntryInfo.BodySectionNotRequired == true) {
                                eleControl = document.getElementById(sId);
                                if (DataType.isValidObject(eleControl) == true) {
                                    eleControl.value = sText;
                                }

                                eleControl = document.getElementById("id_transactionentry_value_bins");
                                eleControl.value = DataType.toString(rawValue);
                            }
                            else {
                                cell.setCellText(sText, rawValue);
                            }
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                        if (DataType.isNullOrEmpty(rawValue, true) == false) {
                            transEntryReservation.setText(iRow, "Reserved", rawValue);
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_RESERVEQUANTITY, rawValue, iRow);
                        }
                        else {
                            EntryMainUI.clear(transEntryFieldInfo.Reservation, iRow);
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_DEPTAPPROP) {
                        cell.setCellText("", rawValue);
                    }
                    else {
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            eleControl = document.getElementById(sId);
                            if (DataType.isValidObject(eleControl) == true) {
                                eleControl.value = rawValue;
                            }
                        }
                        else {
                            if ((typeof rawValue).toLowerCase() == "object") {
                                cell.setCellText(rawValue.data, rawValue.data);

                                EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue.data, iRow, objMetaData);
                            }
                            else {
                                cell.setCellText(rawValue, rawValue);

                                EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);
                            }                            
                        }
                    }
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    rawValue = DataType.toInt(rawValue);

                    EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);
                    if (DataType.toInt(cell.getCellData()) == rawValue) { // Value already set
                        break;
                    }

                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    OPTIONCONTROL.setValue(sId, rawValue);

                    if (transEntryInfo.BodySectionNotRequired == false) {
                        obj = OPTIONCONTROL.getControlData(sId);
                        EntryMainBody.updateMasterValue(transEntryGrid.getCellObject(iRow, iColumn), obj, objMetaData.iFieldId, false);
                    }
                    break;
                case eMasterDataType.Date:
                    rawValue = DataType.toInt(rawValue);

                    EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);
                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        DATEPICKER.setDate(sId, rawValue);
                    }
                    else {
                        cell.setCellText(DATEPICKER.convertDateIntoString(sId, rawValue), rawValue);
                    }
                    break;
                case eMasterDataType.Time:
                    rawValue = DataType.toInt(rawValue);

                    EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);
                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                    if (transEntryInfo.BodySectionNotRequired == true) {
                        FTIMECONTROL.setTime(sId, rawValue);
                    }
                    else {
                        cell.setCellText(FTIMECONTROL.convertTimeIntoString(sId, rawValue), rawValue);
                    }
                    break;
                case eMasterDataType.Fraction:
                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                    if (transEntryInfo.BodySectionNotRequired == true) {
                        eleControl = document.getElementById(sId);
                        if (DataType.isValidObject(eleControl) == true) {
                            eleControl.value = rawValue;
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);
                    }
                    else {
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_MAXQTYRELEASE) {
                            if (DataType.isNullOrEmpty(rawValue) == true) {
                                break;
                            }

                            objStockToRelease = DataType.stringToObject(rawValue).data;
                            if (DataType.isValidObject(objStockToRelease) == false) {
                                break;
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, objStockToRelease, iRow, objMetaData);

                            transEntryMaxQtyRelease.setReservingId(iRow, objStockToRelease.BaseTransactionId);
                            transEntryMaxQtyRelease.setMaxRelease(iRow, objStockToRelease.Quantity);

                            objValue = DataType.toDecimal(objStockToRelease.Quantity, transEntryQuantity.getDecimals());
                            cell.setCellText(objValue, objStockToRelease.Quantity);

                            transEntryGlobal.arrLoadedReleaseData.push({ iRow: iRow, lReservingId: objStockToRelease.BaseTransactionId, lRefId: 0, dMaxReleaseValue: objStockToRelease.Quantity });
                        }
                        else {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);

                            objValue = EntryMain.formatFractionNumber(objMetaData.iFieldId, rawValue, objMetaData.iNoDecimal, iRow);
                            cell.setCellText(objValue, rawValue);
                        }
                    }
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    EntryMainMemoryObject.update(objMetaData.iFieldId, rawValue, iRow, objMetaData);

                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        eleControl = document.getElementById(sId);
                        if (DataType.isValidObject(eleControl) == true) {
                            eleControl.value = rawValue;
                        }
                    }
                    else {
                        cell.setCellText(rawValue, rawValue);
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body updateColumnValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.updateColumnValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateViewInfoFields: function (iFieldId, cellMaster) {
        let iCounter = 0;
        let iCounter1 = 0;
        let iIndex = 0;
        let value = null;
        let objInfoField = null;
        let objViewLinkedInfoField = null;
        let cell = null;

        try {
            if (transEntryGlobal.EntryModel.bView == false || DataType.isValidObject(transEntryGlobal.EntryModel.MetaData.ViewInfoColumns) == false) {
                return;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.ViewInfoColumns.length; iCounter++) {
                objInfoField = transEntryGlobal.EntryModel.MetaData.ViewInfoColumns[iCounter];
                if (iFieldId != objInfoField.iFieldId) {
                    continue;
                }

                for (iCounter1 = 0; iCounter1 < objInfoField.arrViewLinkedInfoField.length; iCounter1++) {
                    objViewLinkedInfoField = objInfoField.arrViewLinkedInfoField[iCounter1];
                    iIndex = transEntryGrid.getGridColumnIndexFromFieldId(objViewLinkedInfoField.iLinkedFieldId);
                    if (iIndex < 0) {
                        continue;
                    }

                    cell = transEntryGrid.getCellObject(cellMaster.iRow, iIndex);
                    if (DataType.isValidObject(cell) == false) {
                        continue;
                    }

                    value = cellMaster.getCellData(objViewLinkedInfoField.sMandatoryField.toLowerCase());

                    switch (objViewLinkedInfoField.iLinkedFieldDataTypeId) {
                        case eMasterDataType.Text:
                        case eMasterDataType.Number:
                        case eMasterDataType.Fraction:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            cell.setCellText(value, value);
                            break;
                        case eMasterDataType.StringList:
                        case eMasterDataType.NumberList:
                            cell.setCellText(value, value);
                            break;
                        case eMasterDataType.Boolean:
                            EntryMainBody.initBooleanColumn(cell, value, true);
                            break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body updateViewInfoFields method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.updateViewInfoFields} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
