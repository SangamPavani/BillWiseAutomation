                            value = objControl.Value.options[objControl.Value.selectedIndex].value;
                        }
                    }
                    else {
                        objFieldInfo.Error = eTransGetValueResult.NothingSelected;
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    if (text == true) {
                        value = $(objControl.Value).text();
                    }
                    else {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }
                }
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Text) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    value = objControl.Value.value;
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    value = objControl.Value.getAttribute(CELL_VALUE);
                }

                value = DataType.toString(value);
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Fraction) {
                if ((objFieldInfo.FieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                    if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                        value = {};
                        value.Value = objControl.Value.getAttribute(CELL_VALUE);
                        value.Output = objControl.Value.getAttribute(CELL_OUTPUT);

                        if (EntryMain.m_bRoundOff == false) {
                            value.RawOutput = objControl.Value.getAttribute(CELL_RAWOUTPUT);
                        }

                        value.Value = FNumberOperation.convert(value.Value);
                        value.Output = FNumberOperation.convert(value.Output);
                        if (objResult.RawOutput) {
                            value.RawOutput = FNumberOperation.convert(value.RawOutput);
                        }
                    }
                }
                else {
                    if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                        value = objControl.Value.value;
                    }
                    else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }

                    if (DataType.isNumeric(value) == false) {
                        value = FNumberOperation.convert(value);
                    }
                }
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Number
                || objFieldInfo.MetaData.iDataTypeId == eMasterDataType.SmallNumber
                || objFieldInfo.MetaData.iDataTypeId == eMasterDataType.TinyNumber
                || objFieldInfo.MetaData.iDataTypeId == eMasterDataType.BigNumber) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    value = objControl.Value.value;
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    value = objControl.Value.getAttribute(CELL_VALUE);
                }

                if (DataType.isNumeric(value) == false) {
                    value = FNumberOperation.convert(value);
                }
            }

        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    getValueFromFieldId: function (iFieldId, iRow, bFromMemory, eDataType) {
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let objLinkDef = false;
        let temp = undefined;
        let ctrl = undefined;
        let objFieldInfo = undefined;
        let objControl = undefined;
        let objResult = undefined;

        try {
            objResult = {};
            objResult.Value = undefined;
            objResult.Error = eTransGetValueResult.None;

            if (iFieldId <= 0) {
                objResult.Error = eTransGetValueResult.WrongFieldId;

                switch (eDataType) {
                    case eMasterDataType.Text:
                    case eMasterDataType.StringList:
                        objResult.Value = "";
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                    case eMasterDataType.Fraction:
                    case eMasterDataType.Date:
                    case eMasterDataType.Time:
                    case eMasterDataType.Master:
                    case eMasterDataType.ExternalTable:
                        objResult.Value = 0;
                        break;
                    case eMasterDataType.NumberList:
                        objResult.Value = -1;
                        break;
                    case eMasterDataType.Boolean:
                        objResult.Value = false;
                }

                return (objResult);
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_DOCUMENTNO:
                    if (bFromMemory == true) {
                        if (EntryMain.m_objTrans
                            && EntryMain.m_objTrans.Header) {
                            if (eDataType == eMasterDataType.Text) {
                                objResult.Value = EntryMain.m_objTrans.Header.DocNo;
                            }
                            else {
                                objResult.Value = EntryMain.m_objTrans.Header.HeaderId;
                            }
                        }
                        else {
                            objResult.Error = eTransGetValueResult.InvalidMemory;
                        }
                    }
                    else {
                        objFieldInfo = transEntryFieldInfo.DocNo;
                        objResult.Value = EntryMainUI.getValue(objFieldInfo, 0, eDataType == eMasterDataType.Text);
                        objResult.Error = objFieldInfo.Error;
                    }

                    switch (eDataType) {
                        case eMasterDataType.Number:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                        case eMasterDataType.Master:
                        case eMasterDataType.ExternalTable:
                            objResult.Value = DataType.toInt(objResult.Value);
                            break;
                        case eMasterDataType.Text:
                            objResult.Value = DataType.toString(objResult.Value);
                            break;
                    }
                    
                    return (objResult);
                case eVTFIELDID.FDF_DATE:
                    if (bFromMemory == true) {
                        objResult.Value = EntryMain.m_objTrans.Header.Date;
                    }
