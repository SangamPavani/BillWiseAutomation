    clear: function (iRow, iColumn) {
        let iCounter = 0;
        let bFlag = false;
        let cell = null;

        try {
            if (iColumn < 0) {
                return (false);
            }

            iRow = DataType.toInt(iRow);
            if (iRow > 0) {
                if(iColumn > 0) {
                    cell = transEntryGrid.getCellObject(iRow, iColumn);
                    if (DataType.isValidObject(cell) == true) {
                        cell.clear();

                        return (true);
                    }
                }
                else {
                    for(iColumn = 0; iColumn < transEntryGrid.getTotalColumns(); iColumn++) {
                        cell = transEntryGrid.getCellObject(iRow, iColumn);
                        if (DataType.isValidObject(cell) == true) {
                            cell.clear();
                        }
                    }
                }
            }
            else {
                iRow = Math.abs(iRow);
                for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows() ; iCounter++) {
                    if (iCounter == iRow) {
                        continue;
                    }

                    cell = transEntryGrid.getCellObject(iCounter, iColumn);
                    if (DataType.isValidObject(cell) == true) {
                        cell.clear();
                        bFlag = true;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.clear} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bFlag);
    },

