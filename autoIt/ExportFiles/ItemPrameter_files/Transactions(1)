                //    AdjustBills_Screen.Footer.SetAmtTobeAdjust(_ObjAdj.dFooterAmtToBeAdjInBaseCurr);
                //}
            }

            for (i = 1; i <= TotalRows; i++) {
                var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, AdjCol.get("OriginalAmount"));
                var cellAdj = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, EntryColNo);
                var cellSelect = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, 1);
                var cellNative = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, AdjCol.get("mNativeCurrency"));
                if (_ObjAdj.AdvanceOrAgainstRefAdj == false) {
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDBaseCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDInvoiceCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDLocalCurrency = 0;
                }
                else {
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDBaseCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDInvoiceCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDLocalCurrency = 0;
                }
                _ObjAdj.m_lstPendingBills[i - 1].mNativeCurrency = 0;
                _ObjAdj.m_lstPendingBills[i - 1].dDiscountAmount = 0;
                _ObjAdj.m_lstPendingBills[i - 1].dDiscountAmountTC = 0;
                _ObjAdj.m_lstPendingBills[i - 1].mLocalExchangeDiff = 0;
                _ObjAdj.m_lstPendingBills[i - 1].mExchangeDifference = 0;
