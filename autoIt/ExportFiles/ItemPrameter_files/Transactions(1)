            }
        },

        loadData: function(bSuccess, data, objParameter) {
            let sDateFormat = "";
            let iCounter = 0;
            let iCalendarType = 0;
            let elePopup = null;
            let eleGrid = null;
            let cell = null;

            try {
                if (bSuccess == false) {
                    return;
                }

                if(data.lValue < 0) {
                    transEntryGlobal.showAlert("{DOCUMENTHISTORY.PRIVATE.loadData} " + data.sValue, GlobalPref.getResourceValue("Exception"));
                    return;
                } 

                eleGrid = DOCUMENTHISTORY.PRIVATE.getPopupGridElement();
                FUIElement.setAttribute(eleGrid, "data-vouchertype", objParameter.iVoucherType, true);
                FUIElement.setAttribute(eleGrid, "data-docno", objParameter.sDocNo, true);

                iCalendarType = DataType.toInt(FUIElement.getAttribute(eleGrid, "data-caltype", true));
                sDateFormat = DataType.toString(FUIElement.getAttribute(eleGrid, "data-dateformat", true));

                FGRIDCONTROL.deleteRows(eleGrid, 1, FGRIDCONTROL.getTotalRows(eleGrid));
                if(data.data.length > 0) {
                    FGRIDCONTROL.insertRows(eleGrid, 0, data.data.length);
                    for(iCounter = 0; iCounter < data.data.length; iCounter++) {
                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 2); // Audit id
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(data.data[iCounter].AuditId, data.data[iCounter].AuditId);
                        }

                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 3); // Modified By
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(data.data[iCounter].ModifiedBy, data.data[iCounter].ModifiedBy);
                        }

                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 4); // Created By
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(data.data[iCounter].CreatedBy, data.data[iCounter].CreatedBy);
                        }

                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 5); // Date
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(FDate.convertDateIntoString(data.data[iCounter].Date, sDateFormat, iCalendarType, objParameter.iLanguageId), data.data[iCounter].Date);
                        }

                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 6); // Time
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(FTime.convertTimeIntoString(data.data[iCounter].Time), data.data[iCounter].Time);
                        }

                        cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 7); // HeaderId
                        if(DataType.isValidObject(cell) == true) {
                            cell.setCellText(data.data[iCounter].HeaderId, data.data[iCounter].HeaderId);
                        }
                    }
                }
                else {
                    transEntryGlobal.showAlert("No document history found.");
                    return;
                }

                DOCUMENTHISTORY.PRIVATE.setCallback(objParameter.sCallback);

                elePopup = DOCUMENTHISTORY.PRIVATE.getPopupElement();
                $(elePopup).modal("show");
            }
            catch (err) {
                transEntryGlobal.showAlert("{DOCUMENTHISTORY.PRIVATE.loadData} " + err.message, GlobalPref.getResourceValue("Exception"));
            }
        },

        getPopupElement: function () {
            let elePopup = null;

            elePopup = document.getElementById("id_transactionentry_documenthistory");

            return (elePopup);
        },

        getPopupGridElement: function () {
