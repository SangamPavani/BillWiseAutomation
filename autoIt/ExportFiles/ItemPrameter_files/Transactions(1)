    generateFromSeries: function (iRow, arrLPNSeries) {
        let sId = "";
        let sTemp = "";
        let iCounter = 0;
        let arrSeriesData = [];
        let objIdNamePair = undefined;
        let objLPNSeries = undefined;
        let cell = undefined;
        let result = undefined;
        let objMaster = undefined;
        let objResult = undefined;
        let obj = undefined;

        try {
            objResult = FocusDataStructs.getIdNamePairObject();

            sTemp = "";
            arrSeriesData = [];
            for (iCounter = 0; iCounter < arrLPNSeries.length; iCounter++) {
                objLPNSeries = arrLPNSeries[iCounter];
                sTemp = "";
                switch (objLPNSeries.Type) {
                    case 0: // Login
                        if (DataType.toInt(objLPNSeries.FieldValue) == 0) {
                            sTemp = GlobalPref.UserName;
                        }
                        else {
                            sTemp = GlobalPref.UserName; // GlobalPref.LoginAbbr;
                        }
                        break;
                    case 1: // Vendor
                        if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                            sTemp = EntryMainMaster.getNameCodeFromControl(EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BOOKNO), DataType.toInt(objLPNSeries.FieldValue) == 0);
                        }
                        break;
                    case 2: // Product
                        cell = EntryMainUI.getElement(transEntryFieldInfo.Item, iRow).Value;
                        switch (DataType.toInt(objLPNSeries.FieldValue)) {
                            case 0: // Name
                                sTemp = EntryMainMaster.getNameCode(cell, true);
                                break;
                            case 1: // Code
                                sTemp = EntryMainMaster.getNameCode(cell, false);
                                break;
                            default:
                                obj = {};
                                obj.iFieldId = DataType.toInt(objLPNSeries.FieldValue);
                                obj.iSubParentId = 2;
                                obj.sFilter = EntryMainMemoryObject.getProductValue(iRow).toString();
                                result = transEntryServer.execute(eTransServerRequest.GetMasterValueFromField, obj);
                                if (result.lValue > 0) {
                                    result = result.data;
                                }

                                if (result.lValue > 0) {
                                    sTemp = result.data;
                                }
                                break;
                        }
                        break;
                    case 3: // Char Input
                        switch (DataType.toInt(objLPNSeries.FieldValue)) {
                            case 0:
                                sTemp = "/";
                                break;
                            case 1:
                                sTemp = "-";
                                break;
                            case 2:
                                sTemp = "*";
                                break;
                            case 3:
                                sTemp = "_";
                                break;
                            default:
                                sTemp = " ";
                                break;
                        }
                        break;
                    case 5: // Input
                        sTemp = objLPNSeries.FieldValue;
                        break;
                    case 4: // Date
                        switch (DataType.toInt(objLPNSeries.FieldValue)) {
                            case 0: // Day
                                sTemp = DataType.toString(transEntryDate.getDay());
                                if (sTemp.length == 1) {
                                    sTemp = "0" + sTemp;
                                }
                                break;
                            case 1: // Month Name
                                sTemp = transEntryDate.getMonthName();
                                break;
                            case 2: // Year
                                sTemp = DataType.toString(transEntryDate.getYear());
                                break;
                            case 3: // Month
                                sTemp = DataType.toString(transEntryDate.getMonth());
                                if (sTemp.length == 1) {
                                    sTemp = "0" + sTemp;
                                }
                                break;
                        }
                        break;
                    case 7: // Doc No
                        sTemp = EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true);
                        break;
                    case 8: // Time
                        sTemp = "";
                        switch (DataType.toInt(objLPNSeries.FieldValue)) {
                            case 0: // Hour
                                sTemp = DataType.toString(FTime.getHourFromFocusTime(FTime.getCurrentTime()));
                                break;
                            case 1: // Minute
                                sTemp = DataType.toString(FTime.getMinuteFromFocusTime(FTime.getCurrentTime()));
                                break;
                            case 2: // Second
                                sTemp = DataType.toString(FTime.getSecondFromFocusTime(FTime.getCurrentTime()));
                                break;
                        }

                        if (sTemp.length == 1) {
                            sTemp = "0" + sTemp;
                        }
                        break;
                    case 9: // Voucher abbr
                        sTemp = transEntryInfo.Settings.Misc.Abbr;
                        break;
                    case 10: // MRP
                        break;
                    case 11: // Row Id
                        sTemp += DataType.toString(iRow);
                        break;
                    case 12: // Production Order
                        sTemp = "";
                        if (transEntryFieldInfo.ProdBatch.FieldId > 0) {
                            sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_PRODBATCH);
                            sTemp = DataType.toString(OPTIONCONTROL.getControlText(sId));
                        }
                        break;
                    case 13: // Storer
                        sTemp = "";
                        break;
                    case 14: // ASNNo
                        sTemp = "";
                        break;
                    default: // Masters
                        if (objLPNSeries.Type > 20) {
                            objMaster = transEntryGrid.getMasterNameCode(iRow, objLPNSeries.Type - 20, DataType.toInt(objLPNSeries.FieldValue) == 0);
                            sTemp = objMaster.Value;
                        }
                        break;
                }

                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = objLPNSeries.Type;
                objIdNamePair.Name = sTemp;
                objIdNamePair.Tag = objLPNSeries.FieldValue;
                arrSeriesData.push(objIdNamePair);
            }
            
            obj = {};
            obj.arrSeriesDef = arrLPNSeries;
            obj.arrLPNData = arrSeriesData;
            obj.iLPTypeId = 0;

            if (transEntryFieldInfo.LPMaster.FieldId > 0) {
                obj.iLPTypeId = EntryMainUI.getValue(transEntryFieldInfo.LPMaster, iRow);
            }

            result = transEntryServer.execute(eTransServerRequest.GetNewLPNo, obj, false);
            if (result.lValue > 0) {
                result = result.data;
                if (result.lValue > 0) {
                    objResult = result.data;
                }
                else {
                    objResult.ID = result.lValue;
                    objResult.Name = result.sValue;
                }
            }
            else {
                objResult.ID = result.lValue;
                objResult.Name = result.sValue;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntrySkid.generateFromSeries} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

