    changeSubLedgerH: function (tag) {
        let sId = "";
        let iValue = 0;
        let iPmtTerm = 0;
        let iAccountTypeId = 0;
        let iDefaultBankCurrency = 0;
        let bFlag = false;
        let result = null;

        try {
            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control));

            if (transEntryFieldInfo.PmtTerms.Area != eTranEntryFieldArea.None && iValue > 0
                && transEntryFieldInfo.SubLedger.FieldId == 0) {
                iPmtTerm = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iPaymentTerms"));
                transEntryFields.setPmtTerms(iPmtTerm);
            }

            if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header) {
                bFlag = true;
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iAccountTypeId = EntryMainMemoryObject.getBookTypeId(0);
                    if (EntryMainCommon.isPartyType(iAccountTypeId) == false) {
                        bFlag = false;
                    }
                }

                if (bFlag == true) {
                    iDefaultBankCurrency = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iDefaultCurrency"));
                    if (iDefaultBankCurrency > 0) {
                        transEntryFields.setCurrency(iDefaultBankCurrency);
                    }

                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    OPTIONCONTROL.disableControl(sId, transEntryFieldInfo.Currency.MetaData.bReadOnly);
                }
            }

            if (transEntryInfo.ARAPPref.iPickCreditDaysFrom == 0) // if credit days to be picked from Customer vendor a/c
            {
                bFlag = true;
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iAccountTypeId = EntryMainMemoryObject.getBookTypeId(0);
                    if (EntryMainCommon.isPartyType(iAccountTypeId) == false) {
                        bFlag = false;
                    }
