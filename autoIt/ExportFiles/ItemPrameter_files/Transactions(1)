    PickQuantity: function (ele) {      
        try {
          //var iPickNoOfDecimals = parseInt($("#hdnNoofDecimalInDiscount").val());
          if (RESERVATION.iSelectedProductType == RESERVATION.GetSelectedProductType()) {
            var sGridCtrlId = '';
            var trId = $("#Id_Reservation_FGrid .clsSelecteProductType");
            if (trId.length > 0) {
                sGridCtrlId = trId[0].children[1].dataset.product_datagrid_id;
                var iCellNo = RESERVATION.GridWiseCell(sGridCtrlId);
                if (sGridCtrlId != "Id_RMAReservation_FGrid") {
                    var iRowNo = $("#" + sGridCtrlId + "_body").find(".highlightRow")[0].sectionRowIndex + 1;
                    ele = document.getElementById(ele);
                    // var sGridCtrlId = FGRIDCONTROL.getGridIdFromCell(ele.parentElement);
                    // var cellId = ele.parentElement.id;
                    //var iCellNo = cellId.substring(cellId.length, (cellId.indexOf('-') + 1));
                    //var iRowNo = cellId.substring(cellId.length, cellId.indexOf('-') - 1);


                    // iRowNo = iRowNo.substring(0, iRowNo.indexOf('-'));

                    var prodQty = RESERVATION.bMaintainInvByUnit == false ? RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].Quantity : RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].TQuantity;
                    if (sGridCtrlId == "Id_BatchReservation_FGrid" || sGridCtrlId == "Id_BinReservation_FGrid" || sGridCtrlId == "Id_StockReservation_FGrid" || sGridCtrlId == "Id_BatchBinReservation_FGrid") {
                        var availQty = 0;
                        var cell = FGRIDCONTROL.getCellObject(sGridCtrlId, iRowNo, iCellNo);
                        if (cell != null && cell != undefined) {
                            if (cell.CellData.remainavailableqty != null && cell.CellData.remainavailableqty != undefined) {
                                if (cell.CellData.remainavailableqty == "")
                                    cell.CellData.remainavailableqty = 0;
                                availQty = parseFloat(cell.CellData.remainavailableqty);
                            }
                            //Edge Browser 
                            if (cell.CellData.RemainAvailableQty != null && cell.CellData.RemainAvailableQty != undefined) {
                                if (cell.CellData.RemainAvailableQty == "")
                                    cell.CellData.RemainAvailableQty = 0;
                                availQty = parseFloat(cell.CellData.RemainAvailableQty);
                            }

                            if (availQty > 0) {
                                var iRowCount = FGRIDCONTROL.getTotalRows(sGridCtrlId);
                                var totalQty = 0;
                                for (var i = 0; i < iRowCount; i++) {
                                    var cell = FGRIDCONTROL.getCellObject(sGridCtrlId, (i + 1), iCellNo);
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        if ((i + 1) != iRowNo) {
                                            if (cell.CellData.value == "")
                                                cell.CellData.value = 0;
                                            totalQty = parseFloat(totalQty) + parseFloat(cell.CellData.value);
                                        }
                                    }
                                }
                                var globalEle;
                                var currentRow;
                                if (totalQty < prodQty) {
                                    var pickVal = prodQty - totalQty;
                                    if (pickVal > availQty) {
                                        //$('.highlightRow')[0].childNodes[2].innerText = availQty;
                                        globalEle = availQty;
                                        var indvalue = $('.highlightRow')[0].id;
                                        currentRow = parseInt(indvalue.substr(indvalue.length - 1, indvalue.length));
                                        var cellobj = FGRIDCONTROL.getCellObject(sGridCtrlId, currentRow, iCellNo);
                                        cellobj.setCellData("value", availQty);
                                        cellobj.setCellText(availQty);
                                        //cellobj.setControl("value", availQty);
                                        //ele.value = availQty;
                                    }
                                    else {
                                        //$('.highlightRow')[0].childNodes[2].innerText = pickVal;
                                        globalEle = Number(pickVal).toFixed(RESERVATION.iNoOfDecimals);
                                        var indvalue = $('.highlightRow')[0].id;
                                        currentRow = $("#" + sGridCtrlId + "_body").find(".highlightRow")[0].sectionRowIndex + 1;
                                        // currentRow = parseInt(indvalue.substr(indvalue.length - 1, indvalue.length));
                                        var cellobj = FGRIDCONTROL.getCellObject(sGridCtrlId, currentRow, iCellNo);
                                        cellobj.setCellData("value", pickVal);
                                        cellobj.setCellText(pickVal);
                                        if (RESERVATION.bMaintainInvByUnit == true) {
                                            var cellobj1 = FGRIDCONTROL.getCellObject(sGridCtrlId, currentRow, iCellNo + 1);
                                            cellobj1.setCellData("value", parseFloat(pickVal * RESERVATION.xFactor));
                                            cellobj1.setCellText(parseFloat(pickVal * RESERVATION.xFactor));
                                        } else {
                                            var cellobj1 = FGRIDCONTROL.getCellObject(sGridCtrlId, currentRow, iCellNo - 1);
                                            cellobj1.setCellData("value", parseFloat(pickVal / RESERVATION.xFactor));
                                            cellobj1.setCellText(parseFloat(pickVal / RESERVATION.xFactor));
                                        }
                                        //cellobj.setControl("value", pickVal);
                                        // ele.value = pickVal;
                                    }
                                    RESERVATION.SetCellValueOnKeyUp(globalEle, sGridCtrlId, currentRow, iCellNo);
                                }
                            }
                            else {
                                //COMMON.prototype.showMessage("Select Row to pick data");
                            }

                        }
                        else {
                            COMMON.prototype.showMessage(RESERVATION.getResourceValue("msgSelectQtycelltoPickData", ValidationMessages));
                        }
                    }
                }
                else {
                    var count = 0;
                    var iTotalQty = 0;
                    var Qty = RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].Quantity;
                    var iTotalRows = FGRIDCONTROL.getTotalRows(sGridCtrlId);
                    for (var i = 0; i < iTotalRows; i++) {
                        var LastCell = FGRIDCONTROL.getCellObject(sGridCtrlId, (i + 1), 5).cell;
                        if (LastCell.children[0] != null && LastCell.children[0] != undefined) {
                            if (LastCell.children[0].checked) {
                                count++;
                            }
                        }
                    }
                    for (var i = 0; i < iTotalRows; i++) {
                        var LastCell = FGRIDCONTROL.getCellObject(sGridCtrlId, (i + 1), 5).cell;
                        if (LastCell.children[0] != null && LastCell.children[0] != undefined) {
                            if (parseFloat(count) < parseFloat(Qty)) {
                                if (!LastCell.children[0].checked) {
                                    LastCell.children[0].checked = true;
                                    LastCell.children[0].parentElement.dataset.value = true;
                                    count++;
                                    iTotalQty = iTotalQty + 1;
                                }
                            }
                        }
                    }
                    $("#lblTotalQty").val(iTotalQty);
                }
            }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.PickQuantity} " + err.message, "Exception")
        }
    },
    CheckProductQty: function (ele, ProdQty) {
        try {
            var sGridCtrlId = FGRIDCONTROL.getGridIdFromCell(ele.parentElement);
            var cellId = ele.parentElement.id;
            var iCellNo = cellId.substring(cellId.length, (cellId.indexOf('-') + 1));
            var iRowNo = cellId.substring(cellId.length, cellId.indexOf('-') - 1);
            iRowNo = iRowNo.substring(0, iRowNo.indexOf('-'));

            ProdQty = RESERVATION.bMaintainInvByUnit == false ? RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].Quantity : RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].TQuantity;
            if (parseFloat(ele.value.trim()) > parseFloat(ProdQty)) {
                ele.value = 0;
                RESERVATION.SetCellValueOnKeyUp(ele.value, sGridCtrlId, iRowNo, iCellNo);
                ele.blur();
                COMMON.prototype.showMessage(RESERVATION.getResourceValue("msgResQtycannotGrtrthanSelectedProdQty", ValidationMessages));
            }
            else {
                if (parseFloat(ele.value.trim()) > parseFloat(ele.parentElement.dataset.remainavailableqty)) {
                    ele.value = 0;
                    RESERVATION.SetCellValueOnKeyUp(ele.value, sGridCtrlId, iRowNo, iCellNo);
                    ele.blur();
                    COMMON.prototype.showMessage(RESERVATION.getResourceValue("msgResQtycantGrtrthanAvailbleQty", ValidationMessages));
                }
                else {
                    var iRowCount = FGRIDCONTROL.getTotalRows(sGridCtrlId);
                    var totalQty = 0;
                    for (var i = 0; i < iRowCount; i++) {
                        var cell = FGRIDCONTROL.getCellObject(sGridCtrlId, (i + 1), iCellNo);
                        if (cell.CellData.value != null && cell.CellData.value != undefined) {
                            if ((i + 1) == iRowNo) {
                                totalQty = parseFloat(totalQty) + parseFloat(ele.value.trim());
                            }
                            else {
                                totalQty = parseFloat(totalQty) + parseFloat(cell.CellData.value);
                            }
                        }
                    }
                    if (parseFloat(totalQty) > parseFloat(ProdQty)) {
                        ele.value = 0;
                        RESERVATION.SetCellValueOnKeyUp(ele.value, sGridCtrlId, iRowNo, iCellNo);
                        ele.blur();
                        COMMON.prototype.showMessage(RESERVATION.getResourceValue("msgResQtycannotGrtrthanSelectedProdQty", ValidationMessages));
                    }
                    else {
                        RESERVATION.SetCellValueOnKeyUp(ele.value, sGridCtrlId, iRowNo, iCellNo);
                    }
                }
                }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.CheckProductQty} " + err.message, "Exception")
        }
    },
    CheckAvailableMRA: function (ele, Qty) {
        try {
          if (RESERVATION.iSelectedProductType == RESERVATION.GetSelectedProductType()) {
            var count = 0;
            var iTotalRows = FGRIDCONTROL.getTotalRows("Id_RMAReservation_FGrid");
            for (var i = 0; i < iTotalRows; i++) {
                var LastCell = FGRIDCONTROL.getCellObject("Id_RMAReservation_FGrid", (i + 1), 5).cell;
                if (LastCell.children[0] != null && LastCell.children[0] != undefined) {
                    if (LastCell.children[0].checked) {
                        LastCell.dataset.valuerma = true
                        count++;
                    } else {
                        LastCell.dataset.valuerma = false;
                        LastCell.dataset.value = false;
                    }
                }
            }
            Qty = RESERVATION.arrProdReservations[RESERVATION.iSelectedRowIndex - 1].Quantity;
            if (parseFloat(count) > parseFloat(Qty)) {
                ele.checked = false;
                RESERVATION.iCheck = true;
                $("#lblTotalQty").val(count-1);
                COMMON.prototype.showMessage(RESERVATION.getResourceValue("msgResQtycannotGrtrthanSelectedProdQty", ValidationMessages));
            }
            else {
                ele.parentElement.dataset.value = true;
                $("#lblTotalQty").val(count);
            }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.CheckAvailableMRA} " + err.message, "Exception")
        }
    },
