                        }

                        //TRANSACTION_ENTRY.m_dReceiptGross = EntryMainMemoryObject.getGrossValue(1);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainProductionProcess.onProdProcess_Change}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

