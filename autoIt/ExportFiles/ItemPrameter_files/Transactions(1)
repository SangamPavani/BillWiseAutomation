    clubScanRow: function(objInput) {
        let iCounter = 0;
        let iIndex = 0;
        let iValue = 0;
        let iValue1 = 0;
        let iSourceRow = 0;
        let iUpdateRow = 0;
        let iRow = 0;
        let lBatchId = 0;
        let fConversionValue = 1;
        let dBaseValue = 0;
        let arrBodyTags = undefined;
        let arrMatchedRow = undefined;
        let obj = undefined;

        try {
            if(transEntryInfo.InventoryPref.bConsolidateQtyInBarcode == false) {
                return;
            }

            if(objInput.Data.ItemId == 0) {
                return;
            }

            arrMatchedRow = [];
            for(iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                if(objInput.iScanRow == iRow) {
                    continue;
                }

                iValue = EntryMainMemoryObject.getProductValue(iRow);
                if(iValue != objInput.Data.ItemId) {
                    continue;
                }

                if(transEntryInvTag.getArea() == eTranEntryFieldArea.Body) {
                    iValue = transEntryInvTag.getValue(iRow);
                    iValue1 = transEntryInvTag.getValue(objInput.iScanRow);
                    // If inv tag not match
                    if(iValue != iValue1) {
                        continue;
                    }
                }

                arrMatchedRow.push(iRow);
            }

            iIndex = 0;
            while(iIndex < arrMatchedRow.length) {
                iRow = arrMatchedRow[iIndex];

                if((EntryMain.m_ProductScanResultInfo & eProductScanResultInfo.Unit) > 0) {
                    iValue = EntryMainMemoryObject.getUnitValue(iRow);
                    iValue1 = EntryMainMemoryObject.getUnitValue(objInput.iScanRow);
                    // If unit not match
                    if(iValue != iValue1) {
                        transEntryGlobal.writeInfoLog("Club: Row " + arrMatchedRow[iIndex] + " excluded due to unit mismatch.");

                        arrMatchedRow.splice(iIndex, 1);
                        continue;
                    }
                }

                if((EntryMain.m_ProductScanResultInfo & eProductScanResultInfo.Rate) > 0) {
                    iValue = EntryMainMemoryObject.getRateValue(iRow);
                    iValue1 = EntryMainMemoryObject.getRateValue(objInput.iScanRow);
                    // If rate not match
                    if(iValue != iValue1) {
                        transEntryGlobal.writeInfoLog("Club: Row " + arrMatchedRow[iIndex] + " excluded due to rate mismatch.");

                        arrMatchedRow.splice(iIndex, 1);
                        continue;
                    }
                }

                if((EntryMain.m_ProductScanResultInfo & eProductScanResultInfo.Batch) > 0) {
                    lBatchId = transEntryBatch.getBatchId(iRow);
                    // If batch not match
                    if(DataType.isZero(lBatchId) == false && DataType.neq(lBatchId, objInput.BatchInfo.BatchId) == true) {
                        transEntryGlobal.writeInfoLog("Club: Row " + arrMatchedRow[iIndex] + " excluded due to batch mismatch.");

                        arrMatchedRow.splice(iIndex, 1);
                        continue;
                    }
                }

                iIndex++;
            }

            iIndex = 0;
            while(iIndex < arrMatchedRow.length) {
                iRow = arrMatchedRow[iIndex];

                arrBodyTags = transEntryFieldInfo.getTags(true);
                for (iCounter = 0; iCounter < arrBodyTags.length; iCounter++) {
                    obj = arrBodyTags[iCounter];

                    iValue = EntryMainMaster.getValue(obj.FieldId, iRow);
                    iValue1 = EntryMainMaster.getValue(obj.FieldId, objInput.iScanRow);

                    // If master not match
                    if(DataType.neq(iValue, iValue1) == true 
                        && DataType.arrayFilterDataIndex(transEntryInfo.Settings.Documents.ProductDepandencyMaster, "ID", obj.MetaData.iMasterTypeId, "==").length == 0) {
                        transEntryGlobal.writeInfoLog("Club: Row " + arrMatchedRow[iIndex] + " excluded due to " + obj.MetaData.sFieldName + " mismatch.");

                        arrMatchedRow.splice(iIndex, 1);
                        break;
                    }
                }

                if (iCounter >= arrBodyTags.length) {
                    iIndex++;
                }
            }

            if(arrMatchedRow.length > 0) {
                iValue = transEntryFields.getQty(arrMatchedRow[0]);
                iValue1 = transEntryFields.getQty(objInput.iScanRow);
                iValue = DataType.add(iValue, iValue1);

                if(DataType.isValidObject(objInput.BatchInfo) == true) {
                    fConversionValue = transEntryUnit.getConversionValue(objInput.iScanRow);
                    dBaseValue = DataType.mul(fConversionValue, iValue);
                    if(DataType.gt(dBaseValue, objInput.BatchInfo.Qty) == true) {
                        transEntryGlobal.showAlert("Batch scanned has no balance quantity.", GlobalPref.getResourceValue("Error"));

                        EntryMainUI.clear(transEntryFieldInfo.BatchNo, objInput.iScanRow);
                        return (-1);
                    }
                }

                if(objInput.iScanRow > arrMatchedRow[0]) {
                    iUpdateRow = arrMatchedRow[0];
                    iSourceRow = objInput.iScanRow;
                }
                else {
                    iUpdateRow = objInput.iScanRow;
                    iSourceRow = arrMatchedRow[0];
                }

                transEntryQuantity.setValue(iValue, iUpdateRow, { bUpdateMemoryObject: true });

                iValue1 = EntryMainMemoryObject.getBaseQuantityValue(iUpdateRow);
                transEntryBatch.updateQuantity(iUpdateRow, iValue1);

                transEntryGrid.update();
                transEntryGrid.clear(iSourceRow);

                transEntryGross.calculateAndUpdate({ dQuantity: iValue, iRow: iUpdateRow });

                transEntryGrid.gotoCell(iSourceRow, transEntryFieldInfo.Item.ColumnIndex);

                return (iSourceRow);
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("Some error in body clubScanRow method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.clubScanRow} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

