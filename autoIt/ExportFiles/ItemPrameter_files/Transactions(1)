    getData: function(ID, arrProperties, iVoucherMode, sUserName) {
        let sLabel = "";
        let sValue = "";
        let iCounter = 0;

        switch (ID)
        {
            case eVoucherInfo.CreatedBy:
                sLabel = GlobalPref.getResourceValue("lblCreatedby");
                break;
            case eVoucherInfo.CreatedTime:
                sLabel = GlobalPref.getResourceValue("lblCreatedtime");
                break;
            case eVoucherInfo.EditedBy:
                if (iVoucherMode == eVoucherMode.Suspended) {
                    if (transEntryInfo.HeaderFlags.Draft == true) {
                        sLabel = "Draft by";
                    }
                    else {
                        sLabel = GlobalPref.getResourceValue("lblSuspendedby");
                    }                    
                }
                else {
                    sLabel = GlobalPref.getResourceValue("lblEditedby");
                }
                break;
            case eVoucherInfo.EditedTime:
                if (iVoucherMode == eVoucherMode.Suspended) {
                    if (transEntryInfo.HeaderFlags.Draft == true) {
                        sLabel = "Draft time";
                    }
                    else {
                        sLabel = GlobalPref.getResourceValue("lblSuspendedtime");
                    }                    
                }
                else {
                    sLabel = GlobalPref.getResourceValue("lblEditedtime");
                }
                break;
            case eVoucherInfo.AuthorizationStatus:
                sLabel = GlobalPref.getResourceValue("lblStatus");
                break;
            case eVoucherInfo.NextToAuthorize:
                sLabel = GlobalPref.getResourceValue("lblNexttoAuth");
                break;
            case eVoucherInfo.PrintCount:
                sLabel = GlobalPref.getResourceValue("lblPrinted");
                break;
            case eVoucherInfo.EmailCount:
                sLabel = GlobalPref.getResourceValue("lblEmailCount");
                break;
            case eVoucherInfo.BillStatus:
                sLabel = GlobalPref.getResourceValue("lblBillStatus");
                break;
            case eVoucherInfo.PrevAuthorize:
                sLabel = GlobalPref.getResourceValue("lblAuthorizedBy");
                break;
            case eVoucherInfo.RejectedBy:
                sLabel = "Rejected by";
                break;
            case eVoucherInfo.SaveSource:
                sLabel = "Save Source";
                break;
            case eVoucherInfo.UpdateFA:
                sLabel = GlobalPref.getResourceValue("chkUpdateFA");
                break;
            case eVoucherInfo.UpdateInv:
                sLabel = GlobalPref.getResourceValue("chkUpdateStock");
                break;
            case eVoucherInfo.PDCLinkedVoucher:
                if (transEntryInfo.BaseVoucherType == eVTTYPE.MEMOP || transEntryInfo.BaseVoucherType == eVTTYPE.MEMOR) {
                    sLabel = "Converted To";
                }
                else {
                    sLabel = "Linked From";
                }
                break;
        }

        if (arrProperties != null && arrProperties.length > 0)
        {
            for (iCounter = 0; iCounter < arrProperties.length; iCounter++)
            {
                if (arrProperties[iCounter].ID == ID)
                {
                    if (ID == eVoucherInfo.AuthorizationStatus)
                    {
                        switch (iVoucherMode)
                        {
                            case eVoucherMode.Approved:
                                sValue = GlobalPref.getResourceValue("rdoApproval");
                                break;
                            case eVoucherMode.Pending:
                                sValue = GlobalPref.getResourceValue("BR_Pending");
                                break;
                            case eVoucherMode.Suspended:
                                if (transEntryInfo.HeaderFlags.Draft == true) {
                                    sValue = "Draft";
                                }
                                else {
                                    sValue = GlobalPref.getResourceValue("cmbSuspended");
                                }
                                break;
                            case eVoucherMode.Rejected:
                                sValue = GlobalPref.getResourceValue("rdoReject");
                                break;
                            case eVoucherMode.Stopped:
                                sValue = GlobalPref.getResourceValue("chkStopped");
                                break;
                            case eVoucherMode.Partial:
                                sValue = GlobalPref.getResourceValue("Partial");
                                break;
                            default:
                                sValue = "";
                                break;
                        }
                    }
                    else
                    {
                        sValue = DataType.toString(arrProperties[iCounter].Value);
                    }
                    break;
                }
            }
        }
        else
        {
            if (ID == eVoucherInfo.CreatedBy)
            {
                sValue = sUserName.toUpperCase();
            }
        }

        return ({ Label: sLabel, Value: sValue });
    }

