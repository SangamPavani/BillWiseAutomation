    PickRow:function(iRowIndex, iBinId, iSkidId){
        var i = 0, iSameBin = 0, iBasedOncategory = 0, iSameBatch = 0, DBalance = 0, dfreespace = 0, dLoad = 0, dQuant = 0, arrIndex = 0;
        var isConsiderWeight = false;
        var dTotalWeight = 0, dAvailWeight = 0;
        var grdBin = transBinsPopup.getGridElement();
        var n = parseInt(grdBin.getAttribute("selectedRowIndex"));
        var cell=null;
        var txtTotalQty=document.getElementById("id_bins_totalquantity");
        var txtBalance = document.getElementById("id_bins_balance");
        var cellobj = BinsUI.getAutoAllocateCellObject(iRowIndex);
        
        var binsvalidatemsg = document.getElementById("id_hidden_binsvalidation");
        var diffunitnotinsameproductmsg = document.getElementById("id_hidden_diffunitnotsameproduct");
        var quantgtbinscapacitymsg = document.getElementById("id_hidden_quantgtbincapacity");
        quantgtbinscapacitymsg = "Quantity is more than available quantity";
        var diffproductnotsamebinmsg = document.getElementById("id_hidden_diffproductnotsamebin");
        var itemsbasedoncategorymsg = document.getElementById("id_hidden_itemsbasedoncategory");

        try{
            isConsiderWeight = BinsUI.isConsiderWeight(iRowIndex);
            
            FGRIDCONTROL.update(transBinsPopup.getGridElement());
            //get the current object index in m_objBinsData
            arrIndex = (BinsUI.m_objBinsData.BinDetails).map(function (x) { return x.Id == iBinId && x.SkidId == iSkidId; }).indexOf(true);
            if (BinsUI.m_BinsParam.Inward){
                cell = BinsUI.getFreeSpaceCellObject(iRowIndex);
                dfreespace = parseFloat(cell.getCellText().replace(/,/g, ''));
                if (BinsUI.m_iProdCapacity > 0) { // If Product Category exits
                    cell = BinsUI.getFreeQuantityCellObject(iRowIndex);
                    dfreespace = parseFloat(cell.getCellText().replace(/,/g, ''));
                }
            }
            else{
                cell = BinsUI.getStockCellObject(iRowIndex);//Stock-iQuantity
                dfreespace = parseFloat(cell.getCellText().replace(/,/g, ''));
            }
            cell = BinsUI.getStockCellObject(iRowIndex);//Stock-Quantity
            dLoad = parseFloat(cell.getCellText().replace(/,/g, ''));
            dQuant = parseFloat(txtTotalQty.value.replace(/,/g, ''));

            //these values stored in BinsUI.m_Preference
            iSameBin = BinsUI.m_Preference.Bins.bCannotBePlacedInSameBin;
            iBasedOncategory = BinsUI.m_Preference.Bins.iBinsAllocationRestriction;
            iSameBatch = BinsUI.m_Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin;

            //Clear To Be Allocated Column data
            BinsUI.clearAllocatedValue(); // Set 0 to "To Be Allocated"     
            //Validation If Inward and same bin
            if (BinsUI.m_BinsParam.Inward == true && iSameBin == 1) {
                if (BinsUI.validateBinsManual(iBinId) == true) {
                    if (BinsUI.m_bUnitCheck) {
                        if (BinsUI.validateUnitBin(iBinId) == false) {
                            COMMON.prototype.showMessage(diffunitnotinsameproductmsg.value, binsvalidatemsg.value);
                            return;
                        }
                    }
                    if (dQuant <= dfreespace){
                        BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = dQuant;
                        //set cell value here itself ,instead of refilling the whole grid again
                        cellobj.setCellText(BinsUI.AddDecimalInColumn(dQuant));
                        DBalance = parseFloat(cellobj.getCellText().replace(/,/g, ''));
                        var dTemp = dQuant - DBalance;
                        txtBalance.value = BinsUI.AddDecimalInColumn(dTemp);
                        if (parseFloat(txtBalance.value) == 0) {
                            BinsUI.disableOK(false);
                        }
                        else {
                            BinsUI.disableOK(true);
                        }
                    }
                    else {
                        COMMON.prototype.showMessage(quantgtbinscapacitymsg, binsvalidatemsg.value);
                    }
                }
                else {
                    COMMON.prototype.showMessage(diffproductnotsamebinmsg.value, binsvalidatemsg.value);
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && iBasedOncategory == 1) {   // Validation Item based on category in Inward 
                for (i = 0; i < BinsUI.m_objBinsData.BinDetails.length; i++) {
                    if (BinsUI.m_objBinsData.BinDetails[i].Id == iBinId) {
                        if (BinsUI.m_objBinsData.BinDetails[i].Type == eBinsType.Bin) {
                            if (BinsUI.m_objBinsData.BinDetails[i].Category == BinsUI.m_objBinsData.ProductData.Category) {
                                BinsUI.m_objBinsData.BinDetails[i].ToBeAllocated = parseFloat(txtTotalQty.value);
                                if (dQuant <= dfreespace) {
                                    cell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                                    cell.setCellText(dQuant);
                                    DBalance = parseFloat(cell.getCellText().replace(/,/g, ''));
                                    txtBalance.value = parseFloat(BinsUI.AddDecimalInColumn(dQuant - DBalance));
                                    if (parseFloat(txtBalance.value) == 0) {
                                        BinsUI.disableOK(false);
                                        break;
                                    }
                                    else {
                                        BinsUI.disableOK(true);
                                    }
                                }
                                else {
                                    COMMON.prototype.showMessage(quantgtbinscapacitymsg, binsvalidatemsg.value);
                                }
                            }
                            else {
                                COMMON.prototype.showMessage(itemsbasedoncategorymsg.value, binsvalidatemsg.value)
                            }
                        }
                        else {
                            BinsUI.m_objBinsData.BinDetails[i].ToBeAllocated = parseFloat(txtTotalQty.value);
                            cell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                            cell.setCellText(dQuant);
                            DBalance = parseFloat(cell.getCellText().replace(/,/g, ''));
                            txtBalance.value = BinsUI.AddDecimalInColumn((dQuant - DBalance).toString());
                            if (parseFloat(txtBalance.value) == 0) {
                                BinsUI.disableOK(false);
                            }
                            else{
                                BinsUI.disableOK(true);
                            }
                        }
                    }
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && iSameBatch == true) {
                for (i = 0; i < BinsUI.m_objBinsData.BinDetails.length; i++) {// Item based on Batch
                    if (BinsUI.m_objBinsData.BinDetails[i].Id == iBinId) {
                        if (BinsUI.m_objBinsData.BinDetails[i].Type == eBinsType.Bin) {
                            if (FCommon.String.isNullOrEmpty(BinsUI.m_objBinsData.BinDetails[i].Batch) == true || BinsUI.m_objBinsData.BinDetails[i].Batch == BinsUI.m_sBatch) {
                                //if ((BinsUI.m_objBinsData.BinDetails[i].Batch == null || "") || (BinsUI.m_objBinsData.BinDetails[i].Batch == BinsUI.m_sBatch)) {
                                BinsUI.m_objBinsData.BinDetails[i].ToBeAllocated = parseFloat(txtTotalQty.value);
                                if (dQuant <= dfreespace){
                                    BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = dQuant;
                                    cellobj.setCellText(BinsUI.AddDecimalInColumn(dQuant));
                                    DBalance = parseFloat(cellobj.getCellText().replace(/,/g, ''));
                                    txtBalance.value = BinsUI.AddDecimalInColumn((dQuant - DBalance).toString());
                                    if (parseFloat(txtBalance.value) == 0) {
                                        BinsUI.disableOK(false);
                                    }
                                    else{
                                        BinsUI.disableOK(true);
                                    }
                                }
                                else{
                                    COMMON.prototype.showMessage(quantgtbinscapacitymsg, binsvalidatemsg.value);
                                }
                            }
                        }
                        else{
                            BinsUI.m_objBinsData.BinDetails[i].ToBeAllocated = parseFloat(txtTotalQty.value);
                            BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = dQuant;
                            cellobj.setCellText(BinsUI.AddDecimalInColumn(dQuant));//set cell value
                            DBalance = parseFloat(cellobj.getCellText().replace(/,/g, ''));
                            txtBalance.value = BinsUI.AddDecimalInColumn((dQuant - DBalance).toString());
                            if (parseFloat(txtBalance.value) == 0){
                                BinsUI.disableOK(false);
                            }
                            else{
                                BinsUI.disableOK(true);
                            }
                        }
                    }
                }
            }
            else{
                if (BinsUI.m_BinsParam.Inward == false ){   // if outward
                    if (dLoad == 0) {  // check if load == 0, the n return
                        BinsUI.disableOK(true);
                        BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = 0;
                        cellobj.setCellText(BinsUI.AddDecimalInColumn(0));
                        return;
                    }
                }
                if (isConsiderWeight == true) {
                    //check if totalweight <= availableweigt 
                    dTotalWeight = BinsUI.m_dProductWeight * BinsUI.m_dQuantity;
                    cell = BinsUI.getWeightAvailableCellObject(iRowIndex);
                    dAvailWeight = parseFloat(cell.getCellText().replace(/,/g, ''));
                    if (dTotalWeight > dAvailWeight) {
                        //show error message
                        BinsUI.disableOK(true);
                        BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = 0;
                        cellobj.setCellText(BinsUI.AddDecimalInColumn(0));
                        COMMON.prototype.showMessage("Total weight is more than the available weight");
                        return cellobj;
                    }
                }
                if (dQuant <= dfreespace){
                    BinsUI.m_objBinsData.BinDetails[arrIndex].ToBeAllocated = dQuant;
                    cellobj.setCellText(BinsUI.AddDecimalInColumn(dQuant));//set cell value
                    DBalance = parseFloat(cellobj.getCellText().replace(/,/g, ''));
                    var dTemp = dQuant - DBalance;
                    txtBalance.value = BinsUI.AddDecimalInColumn(dTemp);
                    if (parseFloat(txtBalance.value) == 0) {
                        BinsUI.disableOK(false);
                    }
                    else{
                        BinsUI.disableOK(false);
                    }
                }
                else {
                    COMMON.prototype.showMessage(quantgtbinscapacitymsg, binsvalidatemsg.value);
                }
            }
            return cellobj;
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.PickRow}" + err.message, "Exception")
        }
    },

