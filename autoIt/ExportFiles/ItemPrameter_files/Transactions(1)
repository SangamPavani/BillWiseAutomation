                        }
                    }
                    else {
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                        OPTIONCONTROL.disableControl(sId, transEntryFieldInfo.Currency.MetaData.bReadOnly);
                    }
                }
            }
            else {
                if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header) {
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    OPTIONCONTROL.disableControl(sId, transEntryFieldInfo.Currency.MetaData.bReadOnly);
                }
            }

            EntryMainHeader.updateVendorProductMap();

            if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.None) {
                EntryMainUI.resetLCFilter();
            }

            if (EntryMain.isDataLoading() == false) {
                EntryMainScheme.removeScheme();
                EntryMainScheme.applyScheme(0);
            }

            if (transEntryInfo.ARAPPref.iPickCreditDaysFrom == 0) // if credit days to be picked from Customer vendor a/c
            {
                bFlag = true;
                if (transEntryFieldInfo.SubLedger.Area != eTranEntryFieldArea.None) { // Sub ledger enabled
                    iAccountTypeId = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iAccountTypeId"));
                    if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                        bFlag = false;
                    }
                }

                if (bFlag == true) {
                    result = transEntryDueDate.getTypeAndValue(0);
                    if (DataType.isValidObject(result) == true) {
                        EntryMain.m_iDueDateType = result.iDueDateType;
                        EntryMain.m_iDueDateValue = result.iDueDateValue;
                        transEntryDueDate.calculateAndUpdate(EntryMain.m_iDueDateType, EntryMain.m_iDueDateValue);
                    }
                }
            }

            if (EntryMain.isDataLoading() == false) {
                EntryMainHeader.setDefaultChequeNo();
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (transEntryInfo.Settings.Misc.PostVAT == true && (iMaskedVoucherType == eVTTYPE.PURCH || iMaskedVoucherType == eVTTYPE.PURET || iMaskedVoucherType == eVTTYPE.MATRN || iMaskedVoucherType == eVTTYPE.PORDR)) {
                if (transEntryFieldInfo.TaxCode.ColumnIndex > -1) {

                    objMetaData = transEntryFieldInfo.TaxCode.MetaData;
