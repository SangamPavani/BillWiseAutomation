                            rowno = parseInt(FGRIDCONTROL.getCellData(rowEle, "irow"));
                            cell = BinsUI.getAutoAllocateCellObject(rowno);
                            cell.setCellText(BinsUI.AddDecimalInColumn(arrData[k].Quantity));
