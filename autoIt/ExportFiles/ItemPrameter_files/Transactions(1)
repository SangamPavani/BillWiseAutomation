                                                            EntryMainRaiseChequeReturn.setTitle("Reverse Entry");
                                                            EntryMainRaiseChequeReturn.setDropdownCaption("Voucher Type");
                                                        });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.onReverseEntry} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
