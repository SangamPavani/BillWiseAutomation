                    icount++;
                    dTotal = parseFloat(dTotal) + parseFloat(dValue);
                    dTotal = FConvert.toDecimal(dTotal, MRP_BATCH.iNoofDecimalQty);
                    MRP_BATCH.OBJLIST[i][MRP_BATCH.iAdjustedColumn] = FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty);

                    CellObj.setCellData("value", FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty));
                    CellObj.setCellText(FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty));
                }
                //document.getElementById('lblBalnceQty').innerText = parseFloat( document.getElementById('lblBalnceQty').innerText)+ parseFloat(dValue) ;
                //Note
                MRP_BATCH.GetSelectedBATCHDataRowwise(irow, i);
                // break;
                //}
            }
                
            //if(irow==300)
            //{
            //    //debugger;
            //}
        }
            
        elePopup = document.getElementById(MRP_BATCH.getPopupId());
        sData = elePopup.getAttribute("data-data");
        sCallback = elePopup.getAttribute("data-callback");
        var ele = document.getElementById('lblTotalQty');
        if (dTotal > parseFloat(FConvert.toDecimal(ele.innerText, MRP_BATCH.iNoofDecimalQty))) {
            //alert("Quantity entered is greater than available quantity", "Batches");
            if (!MRP_BATCH.bBeforeQuantity) {
                GLOBAL.LoadingEnd();
                COMMON.prototype.showMessage("Quantity entered is greater than available quantity.", "Batches");
                GLOBAL.LoadingEnd();
                return false;
            }
        }

        if (MRP_BATCH.OBJParam.iReserveTransId > 0 && MRP_BATCH.OBJParam.bReleaseReservation) {
            //if (MRP_BATCH.OBJParam.iReserveTransId > 0) {
            var strMessage = "You are trying to issues batch quantity which is not reserved against this link. \n\r Are you sure you want to continue?";
            var bDifferentBatch = true;
            for (var i = 0; i < GridTotalRows; i++) {
                if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_bReservedCol] && parseFloat(MRP_BATCH.arrIssuingList[i]) > 0) {
                    if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_ReservedQtyCol] == parseFloat(MRP_BATCH.arrIssuingList[i])) {
                        bDifferentBatch = false;
                        break;
                    }
                    if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_ReservedQtyCol] > parseFloat(MRP_BATCH.arrIssuingList[i])) {
                        strMessage = "You are trying to issues partial batch quantity which is reserved against this link. \n\r Are you sure you want to continue?";
                    }
                }
            }
            if (bDifferentBatch) {
                GLOBAL.LoadingEnd();
                if (!confirm(strMessage, "Batches"))
                    return;
            }
        }
        if (dTotal < parseFloat(FConvert.toDecimal(ele.innerText, MRP_BATCH.iNoofDecimalQty))) {
            GLOBAL.LoadingEnd();
            if (!confirm("Adjusted Quantity is less then Total Quantity, Do you want to continue with Adjusted Quantity", "Batches")) {
                if (FCommon.String.isNullOrEmpty(sCallback) == false) {
                    //eval(sCallback)(false, MRP_BATCH.GetSelectedBATCHData(), sData, evt);
                    GLOBAL.LoadingEnd();
                    return false;
                }
            }
        }
        if (icount > 0) {

            $(elePopup).modal('hide');

            //await MRP_BATCH.sleep(1);
            if (FCommon.String.isNullOrEmpty(sCallback) == false) {
                //debugger
                eval(sCallback)(true, MRP_BATCH.lstselectedBatch, sData, evt);
                //debugger
            }
        }
        else
            COMMON.prototype.showMessage("Select Batches Else Click Cancel.", "Batches");

    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.Click_OK} " + e.message, "Error Message");
    }
    GLOBAL.LoadingEnd();
},
