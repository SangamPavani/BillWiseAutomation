    GoToLast: function () {
        try {
            minRecordNo = tableLinkBodyData.length - (tableLinkBodyData.length % NoOfRCDisplay);
            maxRecordNo = tableLinkBodyData.length;
            pgNo = lstRcNo;
            if (maxRecordNo == tableLinkBodyData.length) {
                btnPrev.disabled = btnFirst.disabled = false;
                btnNext.disabled = btnLast.disabled = true;
            }
            PENDINGLINKSTATUS.createTableBodyLimit(minRecordNo, maxRecordNo);
            PENDINGLINKSTATUS.recordStateMaintain();
        } catch (err) {
            COMMON.prototype.showMessage("{PENDINGLINKSTATUS.GoToLast}" + err.message, "Exception");
        }
    },
    GoToNext: function () {
        try {
            minRecordNo = maxRecordNo;
            maxRecordNo += NoOfRCDisplay;
            maxRecordNo = maxRecordNo > tableLinkBodyData.length ? tableLinkBodyData.length : maxRecordNo;
            pgNo += 1;

            btnPrev.disabled = btnFirst.disabled = false;
            if (maxRecordNo == tableLinkBodyData.length) {
                btnNext.disabled = btnLast.disabled = true;
            }
            PENDINGLINKSTATUS.createTableBodyLimit(minRecordNo, maxRecordNo);
            PENDINGLINKSTATUS.recordStateMaintain();
        } catch (err) {
            COMMON.prototype.showMessage("{PENDINGLINKSTATUS.GoToNext}" + err.message, "Exception");
        }
    }
