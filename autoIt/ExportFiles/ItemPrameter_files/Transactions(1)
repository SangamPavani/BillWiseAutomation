                || (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERINVTAG && transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header)
                || (objMetaData.iFieldId == eVTFIELDID.FDF_BODYINVTAG && transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header)            ) {

