            pgNo -= 1;
            btnNext.disabled = btnLast.disabled = false;
            if (minRecordNo == 0) {
                btnPrev.disabled = btnFirst.disabled = true;
            }
            PENDINGLINKSTATUS.createTableBodyLimit(minRecordNo, maxRecordNo);
            PENDINGLINKSTATUS.recordStateMaintain();
        } catch (err) {
            COMMON.prototype.showMessage("{PENDINGLINKSTATUS.GoToPrev}" + err.message, "Exception");
        }
    },
    GoToFirst: function () {
        try {
            minRecordNo = 0;
            maxRecordNo = NoOfRCDisplay;
            pgNo = 1;
            if (minRecordNo == 0) {
                btnPrev.disabled = btnFirst.disabled = true;
                btnNext.disabled = btnLast.disabled = false;
            }
            PENDINGLINKSTATUS.createTableBodyLimit(minRecordNo, maxRecordNo);
            PENDINGLINKSTATUS.recordStateMaintain();
        } catch (err) {
            COMMON.prototype.showMessage("{PENDINGLINKSTATUS.GoToFirst}" + err.message, "Exception");
        }
