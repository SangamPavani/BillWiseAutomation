const EntryMainAuthorization = {
    isAuthorizationEnabled: function () {
        if (DataType.arrayLength(transEntryInfo.AuthData) > 0) {
            return (true);
        }

        return (false);
    },

    isOverallAuthorizationRequired: function () {
        let bFlag = false;

        try {
            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data.AuthData) == false ||
                transEntryGlobal.EntryModel.Data.AuthData.length == 0) {
                return (false);
            }

            bFlag = !transEntryGlobal.EntryModel.Data.AuthData[0].Linewise;
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.isOverallAuthorizationRequired} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bFlag);
    },

    isAuthorizationRequiredForBodyId: function (iBodyId, iMainBodyId) {
        let iCounter = 0;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = 0;

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data.AuthData) == true && iBodyId > 0) {
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.Data.AuthData.length; iCounter++) {
                    if (transEntryGlobal.EntryModel.Data.AuthData[iCounter].BodyId == iBodyId) {
                        result.lValue = 1;
                        result.data = iCounter;

                        break;
                    }
                    else if (iMainBodyId > 0 && transEntryGlobal.EntryModel.Data.AuthData[iCounter].BodyId == iMainBodyId) {
                        result.lValue = 1;
                        result.data = iCounter;

                        break;
                    }
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    enableAuthorizationButton: function () {
        EntryMainToolbar.updateAuthorizationButton(transEntryInfo.AuthData);
    },

    authorizeVoucher: function (iStatus, sRemark) {
        let iCounter = 0;
        let obj = null;

        try {
            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data.AuthData) == false ||
                transEntryGlobal.EntryModel.Data.AuthData.length == 0) {
                return (false);
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.Data.AuthData.length; iCounter++) {
                switch (iStatus) {
                    case _eAuthStatus.Authorized:
                        if (transEntryGlobal.EntryModel.Data.AuthData[iCounter].RemarksOnAuth == true) {
                            transEntryGlobal.EntryModel.Data.AuthData[iCounter].Remarks = sRemark;
                        }
                        break;
                    case _eAuthStatus.Rejected:
                        if (transEntryGlobal.EntryModel.Data.AuthData[iCounter].RemarksOnRej == true) {
                            transEntryGlobal.EntryModel.Data.AuthData[iCounter].Remarks = sRemark;
                        }
                        break;
                    case _eAuthStatus.Stopped:
                        if (transEntryGlobal.EntryModel.Data.AuthData[iCounter].RemarksOnStop == true) {
                            transEntryGlobal.EntryModel.Data.AuthData[iCounter].Remarks = sRemark;
                        }
                        break;
                }
            }

            transEntryGrid.update();

            obj = {};
            obj.status = iStatus;
            obj.arrAuthData = transEntryGlobal.EntryModel.Data.AuthData;
            obj.iVoucherType = transEntryInfo.VoucherType;
            obj.iViewId = transEntryInfo.ViewId;

            if (transEntryInfo.HeaderId == 0 || transEntryGlobal.EntryModel.iCompanySecurityLevel != 2) {
                transEntryServer.execute(eTransServerRequest.AuthorizeVoucher,
                    obj,
                    true,
                    "EntryMainCallback.authorizeTransaction",
                    {
                        iStatus: iStatus
                    });
            }
            else {
                TransLogin.open(undefined, { obj: obj, Source: eTransLoginSource.AuthorizeEntry });
            }

        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.authorizeVoucher} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    processAuthorization: function (iStatus) {
        let AuthData = null;
        let sCaption = "";
        let bMandatory = false;

        try {
            AuthData = transEntryGlobal.EntryModel.Data.AuthData[0];
            if (iStatus == _eAuthStatus.Authorized) {
                if (AuthData.RemarksOnAuth == true) {
                    sCaption = "Authorization Remark";
                    bMandatory = true;
                    if (AuthData.ApprovalRemarksMandatory == false) {
                        sCaption += " (Optional)";
                        bMandatory = false;
                    }
                }
            }
            else if (iStatus == _eAuthStatus.Rejected) {
                if (AuthData.RemarksOnRej == true) {
                    sCaption = "Reject Remark";
                    bMandatory = true;
                    if (AuthData.RejectionRemarksMandatory == false) {
                        sCaption += " (Optional)";
                        bMandatory = false;
                    }
                }
            }
            else if (iStatus == _eAuthStatus.Stopped) {
                if (AuthData.RemarksOnStop == true) {
                    sCaption = "Stop Remark";
                    bMandatory = true;
                    if (AuthData.StopRemarksMandatory == false) {
                        sCaption += " (Optional)";
                        bMandatory = false;
                    }
                }
            }

            if (DataType.isNullOrEmpty(sCaption) == true) {
                EntryMainAuthorization.authorizeVoucher(iStatus, "");
            }
            else {
                EntryMainAuthorization.showRemarkPopup(iStatus, sCaption, bMandatory);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.processAuthorization} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    /* Called for linewise authorization */
    openLinewiseAuthorization: function () {
        let result = null;
        let obj = null;

        result = EntryMainAuthorization.getAuthorizationRowData();
        if (result.lValue > 0) {
            TRANSACTION_ENTRY.UI.enableToolbarButtons(false);
            EntryMainUI.showBodyContainer(false);

            obj = {};
            obj.arrData = result.data;
            obj.bAuthorizeRight = EntryMain.checkPermission(SecurityActions.Authorize);
            obj.bRejectRight = EntryMain.checkPermission(SecurityActions.Reject);
            obj.bStopRight = EntryMain.checkPermission(SecurityActions.Stop);

            AUTHORIZE.openAuthorizationScreen(obj);
        }
    },

    /* Returns array of rows data which need authorization */
    getAuthorizationRowData: function () {
        let iRow = 0;
        let iBodyId = 0;
        let arrData = null;
        let arrRowInfo = undefined;
        let objRowInfo = undefined;        
        let result = null;

        try {
            arrRowInfo = [];
            arrData = EntryMainUI.getBodyDisplayData(arrRowInfo);
            for (iRow = 1; iRow < arrData.length;) { // 0 Row for heading
                objRowInfo = arrRowInfo[iRow];
                iBodyId = arrData[iRow][0];
                result = EntryMainAuthorization.isAuthorizationRequiredForBodyId(iBodyId, objRowInfo.MainBodyId);
                if (result.lValue > 0) {
                    arrData[iRow][0] = transEntryGlobal.EntryModel.Data.AuthData[result.data];
                    iRow++;
                    continue;
                }

                arrData.splice(iRow, 1);
                arrRowInfo.splice(iRow, 1);
            }

            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = arrData.length;
            result.data = arrData;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    showRemarkPopup: function (iStatus, sCaption, bMandatory) {
        let ele = null;
        let obj = null;

        try {
            FUIElement.setText("id_transactionentry_authorization_remark_label", sCaption);
            FUIElement.setText("id_transactionentry_authorization_remark", "");

            $('#id_transactionentry_authorization_remark_popup').modal('show');

            ele = document.getElementById("id_transactionentry_authorization_remark_popup_ok");
            if (DataType.isValidObject(ele) == true) {
                ele.setAttribute("data-istatus", iStatus);
                ele.setAttribute("data-bmandatory", bMandatory);
                ele.setAttribute("onclick", "EntryMainAuthorization.onPopupOK_Click(this, event);");
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.showRemarkPopup} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onPopupOK_Click: function(ele, evt) {
        let sRemark = "";
        let iStatus = 0;
        let bMandatory = false;

        try {
            iStatus = DataType.toInt(ele.getAttribute("data-istatus"));
            bMandatory = DataType.toBoolean(ele.getAttribute("data-bmandatory"));

            //FUIElement.stopKeyProcess(evt);

            sRemark = FUIElement.getText("id_transactionentry_authorization_remark");
            if (bMandatory == true && DataType.isNullOrEmpty(sRemark, true) == true) {
                transEntryGlobal.showAlert("Remark is mandatory.");

                return;
            }

            $('#id_transactionentry_authorization_remark_popup').modal('hide');
            EntryMainAuthorization.authorizeVoucher(iStatus, sRemark);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.onPopupOK_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    fireExternalModule: function () {
        try {
            if (transEntryGlobal.EntryModel.Data.AuthorizationStatus === GlobalPref.getResourceValue("Approved")) {
                transEntryExternalModule.callExternalModule(eVoucherExternalModuleEvents.OnAuthorize,
                                                                    0,
                                                                    "",
                                                                    0,
                                                                    0,
                                                                    "EntryMainCallback.externalModuleAuthorization");
            }
            else if (transEntryGlobal.EntryModel.Data.AuthorizationStatus === GlobalPref.getResourceValue("Rejected")) {
                transEntryExternalModule.callExternalModule(eVoucherExternalModuleEvents.OnReject,
                                                                    0,
                                                                    "",
                                                                    0,
                                                                    0,
                                                                    "EntryMainCallback.externalModuleAuthorization");
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAuthorization.fireExternalModule} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
};
