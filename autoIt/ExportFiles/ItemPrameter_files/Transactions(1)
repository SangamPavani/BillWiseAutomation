    processIfInvoiceNo: function (objMetaData, ele, evt) {
        let iCounter = 0;
        let arrTransaction = null;
        let result = null;
        let arrData = null;
        let objInput = null;

        try {
            if (transEntryInfo.BaseVoucherType != eVTTYPE.SARET && transEntryInfo.BaseVoucherType != eVTTYPE.PURET) {
                return (false);
            }

            if (objMetaData.sFieldName.toLowerCase() != "invoiceno") {
                return (false);
            }

            if (DataType.isNullOrEmpty(ele.value, true) == true) {
                return (false);
            }

            result = transEntryServer.execute(eTransServerRequest.LoadInvoicesFromReturns, 
                                                { 
                                                    sInvoiceNo: ele.value, 
                                                    iVoucherType: transEntryInfo.VoucherType 
                                                });

            if (result.lValue < 1 || DataType.isValidObject(result.data) == false) {
                return (false);
            }

            result = result.data;
            if (DataType.isNullOrEmpty(result.sValue, true) == false) {
                if (result.lValue < 0) {
                    transEntryGlobal.showAlert("{EntryMainHeader.processIfInvoiceNo} " + result.sValue);
                }
                else {
                    transEntryGlobal.showAlert(result.sValue);
                }
            }

            if (result.lValue < 1) {
                return (false);
            }

            arrTransaction = result.data;
            if (DataType.arrayLength(arrTransaction) < 1) {
                return (false);
            }

            if (arrTransaction.length == 1) {
                EntryMainBody.loadInvoiceNoData(arrTransaction[0]);
                return (true);
            }
            else if (arrTransaction.length > 1) {
                arrData = [];
                for (iCounter = 0; iCounter < arrTransaction.length; iCounter++) {
                    result = FocusDataStructs.getIdNamePairObject();
                    result.ID = 0;
                    result.Name = arrTransaction[iCounter].Header.DocNo;
                    result.Tag = arrTransaction[iCounter];

                    arrData.push(result);
                }

                objInput = {};
                objInput.arrData = arrData;
                objInput.sTitle = GlobalPref.getResourceValue("SelectInvoice");
                objInput.sCallback = "EntryMainCallback.salesReturnPopupResult";
                objInput.eleContainer = EntryMainUI.getBodyOthersContainer();

                LISTPOPUP.openPopup(objInput);

                return (true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.processIfInvoiceNo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

