    updateRate: function (iRow) {        
        let sId = "";
        let iCounter = 0;
        let iIssue = 0;
        let iProductId = 0;
        let iTotal = 0;
        let dQuantity = 0;
        let dValue = 0;
        let bCalc = false;
        let dTotalGross = 0;
        let ele = null;

        try {
            if (iRow <= 0 || transEntryInfo.BaseVoucherType != eVTTYPE.WDONE) {
                return;
            }

            if (EntryMain.m_arrReceiptGross.length > 0 && transEntryFieldInfo.Rate.ColumnIndex > -1) {
                bCalc = true;
                if (transEntryFieldInfo.RctIssue.ColumnIndex > -1) { // Production Process
                    iIssue = DataType.toInt(transEntryGrid.getValue(iRow, transEntryFieldInfo.RctIssue.ColumnIndex));
                    if (iIssue == 0) {
                        bCalc = false;
                    }
                }

                if (bCalc == true) {
                    if (EntryMain.m_arrReceiptGross.length >= iRow) {
                        dQuantity = transEntryFields.getQty(iRow);
                        dValue = EntryMain.m_arrReceiptGross[iRow - 1] / dQuantity;
                        transEntryRate.update(dValue, iRow);
                    }
                    else {
                        if (dValue == 0) {
                            dQuantity = transEntryFields.getQty(iRow);
                            dTotalGross = EntryMainProductionProcess.getTotalIssueGross();
                            dValue = dTotalGross / dQuantity;
                            transEntryRate.update(dValue, iRow);
                        }
                    }

                    //iProductId = EntryMainMemoryObject.getProductValue(iRow);
                    //dQuantity = transEntryFields.getQty(iRow);

                    //if(DataType.isValidObject(EntryMain.m_objProductionHeader) == true && DataType.isValidObject(EntryMain.m_objProductionHeader.ProductionBody) == true) {
                    //    iTotal = DataType.arrayLength(EntryMain.m_objProductionHeader.ProductionBody);
                    //}

                    //for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    //    if (iProductId == EntryMain.m_objProductionHeader.ProductionBody[iCounter].ProductId
                    //        && EntryMain.m_objProductionHeader.ProductionBody[iCounter].MainProduct) {
                    //        dValue = TRANSACTION_ENTRY.m_dReceiptGross / dQuantity;
                    //        transEntryRate.update(dValue, iRow);
                    //        break;
                    //    }
                    //    else if (iProductId == EntryMain.m_objProductionHeader.ProductionBody[iCounter].ProductId
                    //        && !EntryMain.m_objProductionHeader.ProductionBody[iCounter].MainProduct) {
                    //        break;
                    //    }
                    //}
                }
            }
            else if (transEntryFieldInfo.RctIssue.ColumnIndex > -1 && transEntryFieldInfo.Rate.ColumnIndex > -1) {
                if (EntryMainProductionProcess.isReceiptRow(iRow) == false) {
                    return;
                }

                dTotalGross = EntryMainProductionProcess.getTotalIssueGross();
                dQuantity = 0;

                if (transEntryFieldInfo.BomSize.FieldId > 0) {
                    sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.BomSize.FieldId);
                    ele = document.getElementById(sId);
                    if (DataType.isValidObject(ele) == true) {
                        dQuantity = DataType.toDecimal(ele.value);
                    }
                }

                if (dQuantity == 0) {
                    dQuantity = transEntryFields.getQty(iRow);
                }
                else {
                    let dRowQuantity = transEntryFields.getQty(iRow);
                    if (dQuantity < dRowQuantity) {
                        dQuantity = dRowQuantity;
                    }
                }
                dValue = dTotalGross / dQuantity;
                transEntryRate.update(dValue, iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainProductionProcess.updateRate}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

