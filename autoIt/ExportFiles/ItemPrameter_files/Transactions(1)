    seriallyFillGridData: function (arrBinsData) {
        let totalRows = 0;
        let searchedRows = arrBinsData.length;
        let RowEle = null;
        let rowno = 0;
        let remainingRows = 0;

        try {
            totalRows = transBinsPopup.getTotalRows();

            if (BinsUI.m_isPaging == true) {
                //enable paging 
                //keep full searched data in m_fullsearchdata
                BINS.m_fullSearchData = arrBinsData;
                if (searchedRows > totalRows) {
                    //show only first 500 data
                    arrBinsData = arrBinsData.slice(0, 500);
                }
                searchedRows = arrBinsData.length;
            }

            // delete previously searched rows
            if (BINS.lastRowNo < totalRows) {
                remainingRows = totalRows - searchedRows;
                transBinsPopup.deleteRows(searchedRows + 1, remainingRows);
            }

            // just add additional searched rows
            var additionalRows = searchedRows;

            totalRows = FGRIDCONTROL.getTotalRows(transBinsPopup.getGridElement());
            transBinsPopup.insertRows(BINS.lastRowNo +1, additionalRows);
            var cellobj = transBinsPopup.getCellObject(BINS.lastRowNo + 1, 0);
