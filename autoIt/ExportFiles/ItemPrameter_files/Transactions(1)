    updateLinkedToFooterValue: function (iRowIndex) {
        let iCounter = 0;
        let iIndex = 0;
        let iRow = 0;
        let iTotalRows = 0;
        let dFooterVal = 0;
        let dSum = 0;
        let dValue = 0;
        let arrScreenFields = undefined;
        let arrFooterFields = undefined;
        let objMetaData = null;
        let cell = null;

        try {
            if (EntryMain.isInSetLoadedData() == true) {
                return;
            }

            arrScreenFields = transEntryFieldInfo.getScreenFields();
            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                objMetaData = arrScreenFields[iCounter].MetaData;
                if (objMetaData.iLinkedToFooter == -1) {
                    continue;
                }

                for (iIndex = 0; iIndex < arrFooterFields.length; iIndex++) {
                    if (arrFooterFields[iIndex].iFieldOrder == objMetaData.iLinkedToFooter) {
                        dFooterVal = transEntryFooter.getInputValue(arrFooterFields[iIndex].iFieldId);
                        break;
                    }
                }

                dSum = 0;
                iTotalRows = transEntryGrid.getTotalRows();
                for (iRow = 1; iRow <= iTotalRows; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        break;
                    }

                    cell = transEntryGrid.getCellObject(iRow, arrScreenFields[iCounter].ColumnIndex);
                    if (DataType.isValidObject(cell) == true) {
                        dValue = FNumberOperation.convert(cell.getCellData());
                        dSum = FNumberOperation.add(dSum, dValue);
                    }
                }

                if (FNumberOperation.isNotEqualTo(dSum, dFooterVal) == true) { // Update last row value if mismatch
                    dValue = FNumberOperation.convert(cell.getCellData());

                    if (FNumberOperation.isLessThan(dSum, dFooterVal) == true) {
                        dValue = FNumberOperation.add(dValue, FNumberOperation.sub(dFooterVal, dSum));
                    }
                    else if (FNumberOperation.isGreaterThan(dSum, dFooterVal) == true) {
                        dValue = FNumberOperation.sub(dValue, FNumberOperation.sub(dSum, dFooterVal));
                    }

                    dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, eRoundingType.Nearest);
                    cell.setCellText(dValue, dValue);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dValue);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in updateLinkedToFooterValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.updateLinkedToFooterValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    calculateAndUpdateAddValue: function () {
        let sValue = "";
        let sId = "";
        let iRow = 0;
        let iTotalRows = 0;
        let dValue = 0;
        let element = null;
        let objMetaData = null;
        let iAppropriateOn = 0;
        let dAdditionalValue = 0;
        let dTotalValue = 0;
        let cell = null;
        let obj = null;

        try {
            if (transEntryInfo.isStockAdjustment == false) {
                return;
            }

            if (transEntryFieldInfo.AppropriateOn.MetaDataIndex < 0
                || transEntryFieldInfo.AdditionalValue.MetaDataIndex < 0
                || transEntryFieldInfo.MRNQty.MetaDataIndex < 0
                || transEntryFieldInfo.MRNGross.MetaDataIndex < 0
                || transEntryFieldInfo.AddValue.MetaDataIndex < 0) {
                return;
            }

            // Get Appropriation on value
            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.AppropriateOn.FieldId);
            element = document.getElementById(sId);
            if (DataType.isValidObject(element) == false) {
                return;
            }
            iAppropriateOn = -1;
            obj = transEntryControl.getValueFromNumberList(element);
            if(obj.iIndex > -1) {
                iAppropriateOn = DataType.toInt(obj.Value);
            }


            // Get Additional Value
            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.AdditionalValue.FieldId);
            element = document.getElementById(sId);
            if (DataType.isValidObject(element) == false) {
                return;
            }
            dAdditionalValue = DataType.toDecimal(element.value);


            if (dAdditionalValue != 0) {
                iTotalRows = transEntryGrid.getTotalRows();
                for (iRow = 1; iRow <= iTotalRows; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        continue;
                    }

                    cell = null;
                    switch (iAppropriateOn) {
                        case 0: // Quantity
                            dTotalValue += EntryMainStockAdjustment.getMRNQuantity(iRow);
                            break;
                        case 1: // Gross
                            dTotalValue += EntryMainStockAdjustment.getMRNGross(iRow);
                            break;
                        case 2: // Net Value
                            dTotalValue += transEntryGrid.getAmount1(iRow);
                            break;
                    }
                } // End of total value loop
            } // dAdditionalValue != 0

            objMetaData = transEntryFieldInfo.AddValue.MetaData;

            iTotalRows = transEntryGrid.getTotalRows();
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    continue;
                }


                if (dAdditionalValue == 0 || dTotalValue == 0) {
                    dValue = 0;
                }
                else {
                    dValue = 0;
                    switch (iAppropriateOn) {
                        case 0: // Quantity
                            dValue = EntryMainStockAdjustment.getMRNQuantity(iRow);
                            break;
                        case 1: // Gross
                            dValue = EntryMainStockAdjustment.getMRNGross(iRow);
                            break;
                        case 2: // Net Value
                            dValue = transEntryGrid.getAmount1(iRow);
                            break;
                    }

                    if (dValue > 0) {
                        dValue = (dAdditionalValue * dValue) / dTotalValue;
                    }
                }
                sValue = DataType.toDecimal(dValue, objMetaData.iNoDecimal);

                cell = EntryMainUI.getElement(transEntryFieldInfo.AddValue, iRow).Value;
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(sValue, sValue);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in calculateAndUpdateAddValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.calculateAndUpdateAddValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    checkOverDue: function (iBookNo, iFATagValue, lRefId) {
        let objFlags = null;
        let result = null;
        let obj = null;

        try {
            if (iBookNo > 0
                && ((transEntryInfo.ARAPPref.bDefineCreditDaysbyFATag == true && iFATagValue > 0) || transEntryInfo.ARAPPref.bDefineCreditDaysbyFATag == false)
                && (EntryMain.isDataLoading() == false || transEntryInfo.HeaderId == 0)
                && transEntryInfo.ARAPPref.bOverDueCheck == true
                && transEntryInfo.isItSales == true
                && transEntryInfo.isInwardVoucher == false
                && (EntryMain.m_Settings.Misc.UpdateFA == true || transEntryInfo.BaseVoucherType == eVTTYPE.SORDR)
                && EntryMain.m_Settings.Misc.DontCheckCreditDays == false) {

                obj = {};
                obj.iBookNo = iBookNo;
                obj.iVoucherDate = EntryMain.m_objTrans.Header.Date;
                obj.iFATagValue = iFATagValue;
                obj.lRefId = DataType.toInt64(lRefId);

                result = transEntryServer.execute(eTransServerRequest.CheckOverdueBills, obj);
                if (result.lValue > 0) {
                    result = result.data;
                    if (result.lValue < 1) {
                        transEntryGlobal.writeErrorLog("Error: {EntryMainCalculation.checkOverDue:Server} " +  result.sValue);
                        transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"));

                        if(DataType.arrayLength(result.data) > 0 && result.data[0].ID == eMessagesToUI.OverDueBillsStop) {
                            EntryMainUI.clear(transEntryFieldInfo.Book, 0);
                        }
                        
                        return (false);
                    }
                    else {
                        if (DataType.isNullOrEmpty(result.sValue) == false) {
                            if(result.lValue == 1) { // OverDueBillsWarn
                                transEntryGlobal.showAlert(result.sValue, "Warning");
                            }
                            else if(result.lValue == 2) { // OverDueBillsApproval
                                if(transEntryGlobal.confirmMessage(result.sValue)) {
                                    objFlags = transEntryInfo.HeaderFlags;
                                    objFlags.RequestCrDays = true;
                                    objFlags.Suspended = true;
                                    transEntryInfo.HeaderFlags = objFlags;
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in checkOverDue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.checkOverDue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

