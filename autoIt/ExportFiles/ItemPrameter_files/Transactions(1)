                    sCtrlId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    if (iDefaultBankCurrency > 0) {
                        OPTIONCONTROL.disableControl(sCtrlId, true);
                    }
                    else {
                        if (DataType.arrayContains(transEntryGlobal.arrPDCHeaderReadOnly, objCurrencyInfo.MetaDataIndex) == -1) {
                            OPTIONCONTROL.disableControl(sCtrlId, objCurrencyInfo.MetaData.bReadOnly);
                        }
                    }
                }
                else if (iDefaultBankCurrency > 0
                        && transEntryInfo.ARAPPref.bDependsOnMaintainBillwiseForARAP == true
                        && (transEntryInfo.ARAPPref.bMaintainARTransactionCurrencies == true
                            || transEntryInfo.ARAPPref.bMaintainAPTransactionCurrencies == true)
                        && EntryMainCommon.isPartyType(iAccountTypeId) == true) {

                    sCtrlId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    OPTIONCONTROL.disableControl(sCtrlId, true);
                }
                else {
                    if (DataType.arrayContains(transEntryGlobal.arrPDCHeaderReadOnly, objCurrencyInfo.MetaDataIndex) == -1) {
                        sCtrlId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                        OPTIONCONTROL.disableControl(sCtrlId, objCurrencyInfo.MetaData.bReadOnly);
                    }
                }
            }

            if (objInput.bVoucherLoading == false && bCurrencyInMappting == false) {
                if (objInput.iLoadedDataSource == eLoadedDataSource.PasteFromClipboard) {
                }
                else {
                    EntryMainHeader.checkAndSetCurrencyExtraFilter();
                }
            }
            else {
                if (EntryMain.checkPermission(SecurityActions.RePrint) == false && transEntryData.getPrintCount() > 0) {
                    // Reprint Premission is not given to the user.
                    EntryMainToolbar.enableButton(eEntryMainButton.Print, false);
                }
                else if (transEntryInfo.HeaderId > 0 && transEntryInfo.HeaderFlags.Approved == false && EntryMain.checkPermission(SecurityActions.PrintUnauthorizedDocuments) == false) {
                    // The Unauthorized document cannot be printed.
                    EntryMainToolbar.enableButton(eEntryMainButton.Print, false);
                }
            }

            if (objInput.bVoucherLoading == true && DataType.arrayLength(arrMissingData) > 0) {
                sCtrlId = " ";
                for (iCount = 0; iCount < arrMissingData.length; iCount++) {
                    if (iCount > 0) {
                        sCtrlId += ",";
                    }

                    sCtrlId += EntryMainUI.getHeaderControlLabelText(EntryMainUI.getHeaderControlId(arrMissingData[iCount].iFieldId));
                }

                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDateDataNotPresent") + sCtrlId);
            }

            if (EntryMainValidate.removeDuplicateItemIfRequired() == true) {
                EntryMainUI.setSummaryInfo(0);
            }            

            EntryMain.m_bInSetLoadedData = false;

            if (objCurrencyInfo.Area == eTranEntryFieldArea.Header
                && objExchangeRateInfo.Area == eTranEntryFieldArea.Header
                && EntryMainCommon.findKeyValue(EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY), transEntryData.getHeader()).lValue > 0
                && EntryMainCommon.findKeyValue(EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE), transEntryData.getHeader()).lValue < 1) {
                    transEntryExchangeRate.update();
            }

            transEntryGlobal.m_iCallingSource = eDisplayBodyDataSource.None;

            EntryMainUI.applyRestrictionForSaudi();
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.setLoadedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        EntryMain.m_bInSetLoadedData = false;

        transEntryGlobal.writeConsoleLog("Exit: {EntryMainUI.setLoadedData}", "royalblue", true);
    },

    setPassedData: function () { // Called From EntryMain.cshtml
        try {
            if (DataType.isValidObject(transEntryGlobal.EntryModel.PassedData) == false) {
                return;
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.PassedData.Header) == true) {
                EntryMain.m_bInSetLoadedData = true;
                EntryMainUI.displayHeader(transEntryGlobal.EntryModel.PassedData.Header,
                                            0,
                                            false,
                                            false,
                                            []);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.setPassedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        EntryMain.m_bInSetLoadedData = false;
    },

    displayHeader: function (arrData, iHeaderId, bDoNotSetEmptyData, bLoadingFromVersion, arrIgnoreFields, bVoucherLoading, arrMasterData, iCallingSource, bFromPendingView) {
        transEntryGlobal.writeConsoleLog("Enter: {EntryMainUI.displayHeader}[HeaderId='" + iHeaderId + "'][LoadingFromVersion='" + bLoadingFromVersion + "'][VoucherLoading='" + bVoucherLoading + "'][CallingSource='" + iCallingSource + "']", "royalblue", true);

        let eleControl = null;
        let sFilter = "";
        let iCounter = 0;
        let iIndex = 0;
        let iValue = 0;
        let sId = "";
        let sValue = "";
        let iFieldId = 0;
        let dExchangeRate = 0;
        let bIgnoreChangeCallback = false;
        let objAttachment = null;
        let objKeyValue = null;
        let arrMissingData = [];
        let arrTemp = null;
        let arrMasterPreftechInput = [];
        let objMasterPreftechInput = null;
        let objMasterData = null;
        let objCurrencyInfo = null;
        let objFieldInfo = undefined;
        let objWatch = undefined;
        let obj = null;

        try {
            if (transEntryGlobal.debugHeaderDisplay == true) {
                debugger
            }

            objWatch = new FStopWatch();
            objWatch.start();

            bDoNotSetEmptyData = DataType.toBoolean(bDoNotSetEmptyData);
            bLoadingFromVersion = DataType.toBoolean(bLoadingFromVersion);
            bVoucherLoading = DataType.toBoolean(bVoucherLoading);
            iCallingSource = DataType.toInt(iCallingSource);

            transEntryGlobal.m_arrLoadedHeaderMasters = [];

            if (DataType.isValidObject(arrMasterData) == false || DataType.arrayLength(arrMasterData) < 1) {
                arrMasterData = [];
            }

            if (transEntryInfo.HeaderId == 0) {
                transEntryInfo.HeaderId = iHeaderId;
            }

            objCurrencyInfo = {};
            objCurrencyInfo.Currency = null;
            objCurrencyInfo.ExchangeRate = null;

            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                sId = arrData[iCounter].Key;

                if (sId == "LinkStatus") {
                    transEntryLinks.setStatus(arrData[iCounter].Value);
                    continue
                }
                else if (sId == "Flags" && iHeaderId > 0) {
                    transEntryInfo.HeaderFlags = arrData[iCounter].Value;
                    EntryMainMemoryObject.updateHeaderFlags(arrData[iCounter].Value);
                    continue;
                }
                else if (sId == "Net") {
                    if (iHeaderId > 0) {
                        transEntryFields.setHeaderNet(arrData[iCounter].Value);
                    }
                    continue;
                }
                else if (sId == "SchemeApplied") {
                    transEntryInfo.SchemeApplied = arrData[iCounter].Value;
                    continue;
                }


                iFieldId = EntryMainUI.extractHeaderFieldId(sId);
                for (iIndex = 0; iIndex < arrIgnoreFields.length; iIndex++) {
                    if (arrIgnoreFields[iIndex] == iFieldId) {
                        break;
                    }
                }

                if (iIndex < arrIgnoreFields.length) {
                    continue;
                }

                objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId, eTranEntryFieldArea.Header);
                if (objFieldInfo.Area != eTranEntryFieldArea.Header) {
                    continue;
                }

                switch (objFieldInfo.MetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        if (objFieldInfo.MetaData.iFieldId == eVTFIELDID.FDF_DOCUMENTNO) {
                            if (iHeaderId > 0) {
                                EntryMain.m_objTrans.Header.HeaderId = iHeaderId;
                                if (bLoadingFromVersion == true && EntryMainVersion.getCurrentPage() < EntryMainVersion.getTotalPages()) {
                                    sFilter = OPTIONCONTROL.getFilter(sId);
                                    OPTIONCONTROL.setFilter(sId, "bVersion = 1 And iVoucherType = " + transEntryInfo.VoucherType);
                                }

                                objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, iHeaderId, arrMasterData);
                                if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                    OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, iHeaderId, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                    EntryMainHeader.updateViewInfoFields(objFieldInfo.FieldId, sId);
                                }

                                if (bLoadingFromVersion == true && EntryMainVersion.getCurrentPage() < EntryMainVersion.getTotalPages()) {
                                    OPTIONCONTROL.setFilter(sId, sFilter, true);
                                }
                                else if (bLoadingFromVersion == false && DataType.isValidObject(objMasterData.OrgData) == false) {
                                    obj = OPTIONCONTROL.createSetValueExtraObject();
                                    obj.bLoadAll = true;
                                    obj.bIgnoreChangeCallback = true;
                                    OPTIONCONTROL.setValue(sId, iHeaderId, null, obj);
                                }

                                EntryMain.m_objTrans.Header.DocNo = EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true);
                            }
                            else {
                                if (EntryMain.m_bVoucherSeriesApplied == false) {
                                    transEntryDocumentNo.setText(arrData[iCounter].Value, false);
                                    EntryMain.m_objTrans.Header.DocNo = arrData[iCounter].Value;
                                }
                            }
                        }
                        else {
                            if (objFieldInfo.MetaData.sFieldName == "sChequeNo") {
                                OPTIONCONTROL.clear(sId, false);
                                
                                if (EntryMainHeader.setDefaultChequeNo(arrData[iCounter].Value, iCallingSource) == false && DataType.isNullOrEmpty(arrData[iCounter].Value) == false) {
                                    arrTemp = [];

                                    obj = FocusDataStructs.getIdNamePairObject();
                                    obj.ID = 0;
                                    obj.Name = arrData[iCounter].Value;
                                    arrTemp.push(obj);
                                    OPTIONCONTROL_DATA.storeDataArrayInMemory(sId, arrTemp, true);
                                    OPTIONCONTROL.setControlText(sId, arrData[iCounter].Value);
                                    EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                                }                                
                            }
                            else {
                                eleControl = document.getElementById(sId);
                                if ((bDoNotSetEmptyData == false || DataType.toInt(eleControl.value) == 0) && eleControl != null) {
                                    eleControl.value = arrData[iCounter].Value;
                                    EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                                }
                            }
                        }
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        eleControl = document.getElementById(sId);
                        if ((bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) && eleControl != null) {
                            eleControl.value = arrData[iCounter].Value;
                            EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        }
                        break;
                    case eMasterDataType.Fraction:
                        if (bDoNotSetEmptyData == false || DataType.toDecimal(arrData[iCounter].Value) != 0) {
                            if (objFieldInfo.FieldId == eVTFIELDID.FDF_EXCHANGERATE) {
                                transEntryFields.setExchangeRate(arrData[iCounter].Value, 0);

                                objCurrencyInfo.ExchangeRate = arrData[iCounter].Value;
                            }
                            else {
                                eleControl = document.getElementById(sId);
                                if (eleControl != null) {
                                    eleControl.value = EntryMain.formatFractionNumber(objFieldInfo.FieldId, arrData[iCounter].Value, objFieldInfo.MetaData.iNoDecimal, 0);
                                    EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                                }
                            }
                        }
                        break;
                    case eMasterDataType.Master:
                        if (bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) {
                            if (bFromPendingView == true
                                && DataType.gt(arrData[iCounter].Value, 0) == true
                                && DataType.isZero(objFieldInfo.MetaData.iMasterTypeId) == false) {

                                transEntryGlobal.m_arrLoadedHeaderMasters.push(objFieldInfo.MetaData.iMasterTypeId);
                            }

                            if (objFieldInfo.FieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                                if (EntryMainUI.isCurrencyChangeRequired(0, undefined, undefined) == false
                                    && iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage) {

                                    break;
                                }
                                EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                sFilter = transEntryCurrency.getFilter();
                                OPTIONCONTROL.setFilter(sId, sFilter);

                                objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                    OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                    if (transEntryFieldInfo.ExchangeRate.FieldId == 0) {
                                        dExchangeRate = transEntryCurrency.getExchangeRate(0);
                                        EntryMainMemoryObject.update(eVTFIELDID.FDF_EXCHANGERATE, dExchangeRate, 0);
                                    }
                                }

                                if (objMasterData.iIndex < 0) {
                                    objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                    arrMasterPreftechInput.push(objMasterPreftechInput);

                                    objCurrencyInfo.Currency = arrData[iCounter].Value;
                                }
                            }
                            else if (objFieldInfo.FieldId == eVTFIELDID.FDF_LCNUMBER) {
                                EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                obj = OPTIONCONTROL.createSetValueExtraObject();
                                obj.bLoadAll = true;
                                OPTIONCONTROL.setValue(sId, 0, null, obj);
                                if (EntryMain.m_objTrans.BodyData[0].Book > 0) {
                                    if (EntryMain.isDataLoading() == true && arrData[iCounter].Value > 0) {
                                        if (transEntryInfo.isItSales == true) {
                                            sFilter = "iAccountId=" + EntryMain.m_objTrans.BodyData[0].Book + " AND iTransactionType=";
                                            sFilter += transEntryInfo.isInwardVoucher == true ? 1 : 0;
                                        }
                                        else {
                                            sFilter = "";
                                        }
                                    }
                                    else {
                                        sFilter = EntryMainUI.getLCFilter(EntryMain.m_objTrans.BodyData[0].Book, EntryMain.m_objTrans.Header.Date);
                                    }

                                    OPTIONCONTROL.setFilter(sId, sFilter);
                                }

                                objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                    OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                }

                                if (objMasterData.iIndex < 0) {
                                    objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                    arrMasterPreftechInput.push(objMasterPreftechInput);
                                }
                            }
                            else {
                                if (objFieldInfo.MetaData.iMasterTypeId > 0) {
                                    bIgnoreChangeCallback = false;
                                    iValue = OPTIONCONTROL.getControlValue(sId);
                                    if (iValue == arrData[iCounter].Value) {
                                        bIgnoreChangeCallback = true;
                                    }

                                    EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                    objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                    if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                        OPTIONCONTROL.setLoadedData(sId,
                                                                    objMasterData.OrgData,
                                                                    arrData[iCounter].Value,
                                                                    { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource },
                                                                    bIgnoreChangeCallback);
                                        if (DataType.toBoolean(OPTIONCONTROL.getControlValue(sId, "bgroup")) == true) {
                                            OPTIONCONTROL.clear(sId);
                                            OPTIONCONTROL.setGroupId(sId, arrData[iCounter].Value);
                                        }
                                        else if (DataType.arrayLength(objMasterData.OrgData.ColumnValue) < 1 && arrData[iCounter].Value > 0) {
                                            objMasterData.iIndex = -1;
                                        }

                                        EntryMainUI.updateMemoryMasterDependentData(objFieldInfo.FieldId, sId, 0);                                        
                                    }

                                    if (objMasterData.iIndex < 0) {
                                        objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);                                    
                                        arrMasterPreftechInput.push(objMasterPreftechInput);
                                    }

                                    if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) > 0) {
                                        EntryMainMemoryObject.updateExtraInfo(objFieldInfo.FieldId, OPTIONCONTROL.getControlDataObject(sId), 0);
                                    }

                                    if (objFieldInfo.FieldId == eVTFIELDID.FDF_BOOKNO) {
                                        EntryMainHeader.updateVendorProductMap();
                                        if (objMasterData.iIndex >= 0
                                            && DataType.arrayLength(transEntryInfo.Settings.Documents.AccountDepandencyMaster) > 0
                                            && transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Header) {
                                            for (iIndex = 0; iIndex < transEntryInfo.Settings.Documents.AccountDepandencyMaster.length; iIndex++) {
                                                obj = transEntryInfo.Settings.Documents.AccountDepandencyMaster[iIndex];
                                                if (obj.ID != eMasterTypeId.SubLedger || obj.Tag != eMasterTypeId.Account) {
                                                    continue;
                                                }

                                                iIndex = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, 0, "iSubLedger", eMasterDataType.Number);
                                                sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.SubLedger.FieldId);
                                                OPTIONCONTROL.setGroupId(sId, iIndex);
                                                break;
                                            }
                                        }
                                    }
                                }
                                else {
                                    if (objFieldInfo.FieldId == eVTFIELDID.FDF_PRODBATCH) {
                                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                        if (arrData[iCounter].Value > 0) {
                                            if (transEntryInfo.VoucherType == eVTTYPE.PRDRT) {
                                                OPTIONCONTROL.setFilter(sId, "iProdOrderId = " + arrData[iCounter].Value + " OR " + EntryMainProductionProcess.ConditionOnVType(transEntryInfo.VoucherType));
                                            }
                                            else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS
                                                || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS
                                                || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE
                                                || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC
                                                || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC
                                            ) {
                                                OPTIONCONTROL.setFilter(sId, "iProdOrderId = " + arrData[iCounter].Value + " OR " + EntryMainProductionProcess.ConditionOnVType(transEntryInfo.VoucherType));
                                            }
                                            else {
                                                OPTIONCONTROL.setFilter(sId, "");
                                            }

                                            objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                            if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                                OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                            }

                                            if (objMasterData.iIndex < 0) {
                                                objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                                arrMasterPreftechInput.push(objMasterPreftechInput);
                                            }
                                        }
                                        else {
                                            sFilter = OPTIONCONTROL.getFilter(sId);
                                            OPTIONCONTROL.setFilter(sId, "");

                                            objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                            if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                                OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                            }

                                            if (objMasterData.iIndex < 0) {
                                                objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);                                    
                                                arrMasterPreftechInput.push(objMasterPreftechInput);
                                            }

                                            OPTIONCONTROL.setFilter(sId, sFilter, true);
                                        }
                                    }
                                    else if (objFieldInfo.FieldId == eVTFIELDID.FDF_PROD_PROCESS) {
                                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                        objKeyValue = EntryMainCommon.findKeyValue(EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_PRODBATCH), arrData).data;
                                        if (DataType.isValidObject(objKeyValue) == true && objKeyValue.Value > 0) {
                                            OPTIONCONTROL.setFilter(sId, "iProdOrderId = " + objKeyValue.Value);

                                            objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                            if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                                OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                            }

                                            if (objMasterData.iIndex < 0) {
                                                objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                                arrMasterPreftechInput.push(objMasterPreftechInput);
                                            }
                                        }
                                        else {
                                            sFilter = OPTIONCONTROL.getFilter(sId);
                                            OPTIONCONTROL.setFilter(sId, "");

                                            objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                            if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                                OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                            }

                                            if (objMasterData.iIndex < 0) {
                                                objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                                arrMasterPreftechInput.push(objMasterPreftechInput);
                                            }

                                            OPTIONCONTROL.setFilter(sId, sFilter, true);
                                        }
                                    }
                                    else {
                                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);

                                        sFilter = OPTIONCONTROL.getFilter(sId);
                                        OPTIONCONTROL.setFilter(sId, "");

                                        objMasterData = EntryMainBody.getMasterData(objFieldInfo.FieldId, arrData[iCounter].Value, arrMasterData);
                                        if (DataType.isValidObject(objMasterData.OrgData) == true) {
                                            OPTIONCONTROL.setLoadedData(sId, objMasterData.OrgData, arrData[iCounter].Value, { MetaData: objFieldInfo.MetaData, CallingSource: iCallingSource });
                                        }

                                        if (objMasterData.iIndex < 0) {
                                            objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                                            arrMasterPreftechInput.push(objMasterPreftechInput);
                                        }

                                        OPTIONCONTROL.setFilter(sId, sFilter, true);
                                    }
                                }
                            }
                        }
                        break;
                    case eMasterDataType.ExternalTable:
                        if (bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) {
                            EntryMainMaster.updateOptionFilter(objFieldInfo.MetaData);

                            objMasterPreftechInput = EntryMainHeader.getPrefetchInputObject(objFieldInfo.MetaData, arrData[iCounter].Value);
                            arrMasterPreftechInput.push(objMasterPreftechInput);

                            EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        }
                        break;
                    case eMasterDataType.Boolean:
                        eleControl = document.getElementById(sId);
                        if(eleControl == null) {
                            break;
                        }

                        if (objFieldInfo.FieldId == eVTFIELDID.FDF_UPDATESTOCKS && eleControl.disabled == true) {
                            break;
                        }

                        eleControl.value = arrData[iCounter].Value;
                        eleControl.checked = arrData[iCounter].Value;

                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        break;
                    case eMasterDataType.Date:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        if ((objFieldInfo.FieldId & eVTFIELDFLAG.LAY_HDR) > 0 && DataType.toInt(arrData[iCounter].Value) == 0 && objFieldInfo.MetaData.bClearDate == false) {
                            arrMissingData.push(objFieldInfo.MetaData);
                        }

                        if (bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) {
                            DATEPICKER.setDate(sId, arrData[iCounter].Value, true);
                            if (objFieldInfo.FieldId == eVTFIELDID.FDF_DATE) {
                                EntryMainHeader.onDocumentDate_Change(sId, arrData[iCounter].Value, bVoucherLoading);
                            }
                        }
                        break;
                    case eMasterDataType.Time:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        if ((objFieldInfo.FieldId & eVTFIELDFLAG.LAY_HDR) > 0 && DataType.toInt(arrData[iCounter].Value) == 0 && objFieldInfo.MetaData.bClearDate == false) {
                            arrMissingData.push(objFieldInfo.MetaData);
                        }

                        if (bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) {
                            FTIMECONTROL.setTime(sId, arrData[iCounter].Value);
                        }
                        break;
                    case eMasterDataType.DateTime:
                        if ((objFieldInfo.FieldId & eVTFIELDFLAG.LAY_HDR) > 0 && DataType.toInt(arrData[iCounter].Value) == 0 && objFieldInfo.MetaData.bClearDate == false) {
                            arrMissingData.push(objFieldInfo.MetaData);
                        }

                        eleControl = document.getElementById(sId);
                        if ((bDoNotSetEmptyData == false || DataType.toInt(arrData[iCounter].Value) != 0) && eleControl != null) {
                            eleControl.value = arrData[iCounter].Value;
                        }
                        break;
                    case eMasterDataType.Picture:
                    case eMasterDataType.DocumentViewer:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        objAttachment = arrData[iCounter].Value;
                        if (DataType.isString(objAttachment) == true) {
                            objAttachment = DataType.stringToObject(objAttachment).data;
                        }

                        if (DataType.isValidObject(objAttachment) == true 
                            && DataType.isNullOrEmpty(objAttachment.sFileName) == false) {

                            if (DataType.isArray(objAttachment.arrData) == true) {
                                sValue = LZUTF8.decodeBase64(objAttachment.arrData);
                                //sValue = DataType.arrayToCSV(objAttachment.arrData);
                            }
                            else {
                                sValue = objAttachment.sData;
                            }
                            FATTACHMENTCONTROL.setData(sId,
                                                        objAttachment.sFileName,
                                                        "",
                                                        sValue,
                                                        true, 
                                                        objAttachment.iDataSource);
                            
                        }
                        break;
                    case eMasterDataType.NumberList:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        eleControl = document.getElementById(sId);
                        if (DataType.isInteger(arrData[iCounter].Value) == true && eleControl != null) {                            
                            eleControl.value = arrData[iCounter].Value;
                        }
                        break;
                    case eMasterDataType.StringList:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        FUIElement.setText(sId, arrData[iCounter].Value);
                        break;
                    case eMasterDataType.HyperLink:
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, arrData[iCounter].Value, 0, objFieldInfo.MetaData);
                        FHyperLink.setValue(sId, arrData[iCounter].Value);
                        break;
                }
            }

            if (arrMasterPreftechInput.length > 0) {
                obj = {};
                obj.arrInput = arrMasterPreftechInput;
                obj.bDoNotRestrictLoginAccount = (transEntryInfo.Settings.Misc.MiscFlag & 0x800) > 0;
                obj.bDoNotRestrictLoginTag = (transEntryInfo.Settings.Misc.MiscFlag & 0x1000) > 0;
                obj.LanguageId = EntryMain.m_LanguageId;
                obj.AltLanguageId = EntryMain.m_AltLanguageId;

                transEntryServer.execute(eTransServerRequest.PrefetchOptionControlData, 
                                            obj, 
                                            false, 
                                            "EntryMainCallback.prefetchOptionControlData", 
                                            { 
                                                arrInput: arrMasterPreftechInput, 
                                                CallingSource: iCallingSource 
                                            }, 
                                            true);

                if (DataType.isNumeric(objCurrencyInfo.Currency) == true && DataType.isNumeric(objCurrencyInfo.ExchangeRate) == true) {
                    transEntryFields.setExchangeRate(objCurrencyInfo.ExchangeRate, 0);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.displayHeader} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        objWatch.stop();
        transEntryGlobal.writeConsoleLog("Exit: {EntryMainUI.displayHeader}[Time=" + objWatch.getDifferenceString() + "]", "royalblue", true);

        return (arrMissingData);
