    getAutoSelectMasterValue: function (cellobj, iPreloadValue, objMetaData, evt) {
        let iValue = 0;
        let obj = undefined;

        try {
            if (objMetaData.iDataTypeId != eMasterDataType.Master
            || cellobj.iRow < 2 || iPreloadValue != 0) {
                return;
            }

            switch (objMetaData.iMasterTypeId) {
                case eMasterTypeId.Account:
                case eMasterTypeId.Product:
                case eMasterTypeId.LPMaster:
                    return;
                default:
                    if (objMetaData.iFieldId == transEntryFieldInfo.Skid.FieldId) { // LPN
                        return;
                    }
                    break;
            }

            iValue = DataType.toInt(cellobj.getCellData());
            if (iValue != 0) {
                return;
            }

            if (EntryMainBody.isRowEditable(cellobj.iRow - 1, true) == false) {
                return;
            }

            obj = EntryMainBody.hasVariable(objMetaData);
            if (obj.bResult == true) {
                return;
            }
            else {
                obj = EntryMainBody.hasFormula(objMetaData);
                if (obj.bResult == true) {
                    return;
                }
            }

            iValue = DataType.toInt(transEntryGrid.getCellData(cellobj.iRow - 1, cellobj.iColumn, "", true).value);
            if (iValue == 0) {
                return;
            }
        }
        catch (err) {
