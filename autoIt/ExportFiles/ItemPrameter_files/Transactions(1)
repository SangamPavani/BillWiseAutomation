    BatchCodeGenerationElementBasedOnGriValue: function (Index, id) {

        Index = isNaN(Index) ? 4 : Index;
        var element = document.getElementById(id);
        if (COMMON.prototype.isValidObject(element) == true) {
            element.remove();
        }

        switch (Index) {
            case 0:
                var select = document.createElement("select");
                var option1 = document.createElement("option");
                option1.value = 0;
                option1.textContent = "Login Name";
                var option2 = document.createElement("option");
                option2.value = 1;
                option2.textContent = "Login Abbriviation";
                select.appendChild(option1);
                select.appendChild(option2);
                select.className = "Fselect";
                select.id = id;
                return select;
            case 1:
                var select = document.createElement("select");
                var option1 = document.createElement("option");
                option1.value = 0;
                option1.textContent = "Name";

                var option2 = document.createElement("option");
                option2.value = 1;
                option2.textContent = "Code";

                select.appendChild(option1);
                select.appendChild(option2);

                select.className = "Fselect";
                select.id = id;
                return select;
