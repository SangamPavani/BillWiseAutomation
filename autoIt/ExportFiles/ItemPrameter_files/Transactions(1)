        let iRow = 0;
        let dUsedValue = 0;
        let dValue = 0;
        let lRowRefId = 0;

        try {
            if (transEntryFieldInfo.MaxQtyRelease.ColumnIndex < 0) {
                return (0);
            }

            iExcludingRow = DataType.toInt(iExcludingRow);

            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (iRow == iExcludingRow) {
                    continue;
                }

                if (EntryMainBody.isRowEditable(iRow) == false) {
                    break;
                }

                lRowRefId = transEntryMaxQtyRelease.getRefId(iRow);
                if (DataType.neq(lRowRefId, lRefId) == true) {
                    continue;
                }

                dValue = transEntryFields.getMaxQtyRelease(iRow);
                dUsedValue = DataType.add(dUsedValue, dValue);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryMaxQtyRelease.getUsedReleaseValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (dUsedValue);
    },

    updateQtyToReleaseColumn: function(iRow, bFromQuantity) {
        let sValue = "";
        let iIndex = 0;
        let dBaseQty = 0;
        let dMaxQtyToRelease = 0;
        let dInputQtyToRelease = 0;
        let element = null;
        let cell = null;

        try {
            iIndex = transEntryFieldInfo.MaxQtyRelease.ColumnIndex;
            if (iIndex < 0) {
                return;
            }

            cell = transEntryGrid.getCellObject(iRow, iIndex);
            if(DataType.isValidObject(cell) == false) {
                return;
            }

            dBaseQty = EntryMainMemoryObject.getBaseQuantityValue(iRow);

            dMaxQtyToRelease = transEntryMaxQtyRelease.getMaxRelease(iRow);

            if(DataType.toBoolean(bFromQuantity) == true) {
                if(DataType.gt(dBaseQty, dMaxQtyToRelease) == true) {
                    dInputQtyToRelease = dMaxQtyToRelease;
                }
                else {
                    dInputQtyToRelease = dBaseQty;
                }
            }
            else {
                element = document.getElementById(cell.ColumnAttribute.ctrlid);
                dInputQtyToRelease = DataType.toDecimal(element.value); // Inputted quantity to release value

                if(DataType.neq(dBaseQty, dInputQtyToRelease) == true) {
                    dInputQtyToRelease = dBaseQty;
                }

                if (DataType.gt(dInputQtyToRelease, dMaxQtyToRelease) == true) { // Quantity to release value cannot be greater than max quantity to release value
                    dInputQtyToRelease = dMaxQtyToRelease;
                }
            }

            sValue = DataType.toDecimal(dInputQtyToRelease, transEntryQuantity.getDecimals());
            cell.setCellText(sValue, dInputQtyToRelease);
        }
        catch(err) {
            transEntryGlobal.showAlert("{transEntryMaxQtyRelease.updateQtyToReleaseColumn} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave: function(cellobj) {
        transEntryMaxQtyRelease.updateQtyToReleaseColumn(cellobj.iRow, false);
    },

