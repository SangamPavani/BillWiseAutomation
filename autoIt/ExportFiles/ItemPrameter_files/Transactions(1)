    PnlInfoDetailscellChange: function (cellobj, event) {
        showInfoPenelDv = true;
        document.getElementById("dvstkSales").style.display = "block";
        document.getElementById("dvgrpFields").style.display = "block";
        CONFIGURETRANS.DisableDivision("dvstkSales");
        var element = null;
        if (cellobj.bLeave) {
            switch (cellobj.iColumn) {
                case 1:
                    element = document.getElementById("txtInfoDetails");
                    if (COMMON.prototype.isValidObject(element) == true) {
                        cellobj.setCellText(element.value);
                    }
                    break;
                case 2:

                    // element = document.getElementById("cmb_InfReportFileds");
                    element = m_cmb_InfReportFields
                    if (COMMON.prototype.isValidObject(element)) {
                        if (element.selectedOptions[0] != undefined) {
                            cellobj.setCellText(element.selectedOptions[0].text);
                            cellobj.setCellData("value", element.selectedOptions[0].value);
                            cellobj.setCellData("ArrVoucherPanelVoucherTypes", getCheckedVouchertypesForRow(element));

                        }
                    }
                    break;
            }
            return true;
        }
        switch (cellobj.iColumn) {
            case 1:
                element = document.getElementById("txtInfoDetails");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                }
                else {
                    cellobj.processDefault(event);
                }
                break;
            case 2:

                //element = document.getElementById("cmb_InfReportFileds");
                element = m_cmb_InfReportFields
                if (COMMON.prototype.isValidObject(element)) {
                    cellobj.setControl(element, cellobj.getCellText());
                    element.value = cellobj.getCellData("value");
                    cmbInfReportFiledsChanged(element);
                    if (cellobj.getCellData("ArrVoucherPanelVoucherTypes") != null && cellobj.getCellData("ArrVoucherPanelVoucherTypes") != undefined && cellobj.getCellData("ArrVoucherPanelVoucherTypes") != "") {
                        CheckSelectedVouchertypesForRow(cellobj.getCellData("ArrVoucherPanelVoucherTypes"));
                    }
                }
                else {
                    cellobj.processDefault(event);
                }
                break;
            default:
                cellobj.processDefault(event);
                break;
        }
    },

