        let bResult = false;

        try {
            if (cellobj.bLeave == true) {
                bResult = StockRevaluationBatch.onLeave(cellobj, evt);

                return (bResult);
            }
            else {
                StockRevaluationBatch.onEnter(cellobj, evt);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{StockRevaluationBatch.cellChange} ", err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave: function (cellobj, evt) {
        let dLastValue = 0;
        let dValue = 0;
        let dBalQty = 0;
        let cell = null;
        let ele = null;

        try {
            switch (cellobj.iColumn) {
                case 7: // New Average Rate
                    dLastValue = DataType.toDecimal(cellobj.getCellData());

                    ele = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    dValue = DataType.toDecimal(ele.value);

                    cellobj.setCellText(DataType.toDecimal(dValue, StockRevaluationBatch.DecimalsInAmts), dValue);

                    if (dLastValue != dValue) {
                        cell = StockRevaluationBatch.getBalanceQtyCell(cellobj.iRow);
                        if (DataType.isValidObject(cell) == true) {
                            dBalQty = DataType.toDecimal(cell.getCellData());
                        }

                        dValue = StockRevaluationBatch.calculateNewStockValue(dBalQty, dValue);

                        cell = StockRevaluationBatch.getNewStockValueCell(cellobj.iRow);
                        if (DataType.isValidObject(cell) == true) {
                            cell.setCellText(DataType.toDecimal(dValue, StockRevaluationBatch.DecimalsInAmts), dValue);
                        }
                    }
                    break;
                case 8: //New Stock Value:
                    dLastValue = DataType.toDecimal(cellobj.getCellData());

                    ele = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                    dValue = DataType.toDecimal(ele.value);

                    cellobj.setCellText(DataType.toDecimal(dValue, StockRevaluationBatch.DecimalsInAmts), dValue);
                    if (dLastValue != dValue) {
                        cell = StockRevaluationBatch.getBalanceQtyCell(cellobj.iRow);
                        if (DataType.isValidObject(cell) == true) {
                            dBalQty = DataType.toDecimal(cell.getCellData());
                        }

                        dValue = StockRevaluationBatch.calculateNewAvgRate(dBalQty, dValue);

                        cell = StockRevaluationBatch.getNewAvgRateCell(cellobj.iRow);
                        if (DataType.isValidObject(cell) == true) {
                            cell.setCellText(DataType.toDecimal(dValue, StockRevaluationBatch.DecimalsInAmts), dValue);
                        }
                    }

                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{StockRevaluationBatch.onLeave} ", err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    onEnter: function (cellobj, evt) {
        let oldValue = 0;

        try {
            switch (cellobj.iColumn) {
                case 7: // New Average Rate
                case 8: // New Stock Value
                    oldValue = DataType.toDecimal(cellobj.getCellData());
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, oldValue);
                    break;
                default:
                    cellobj.processDefault(evt);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{StockRevaluationBatch.onEnter} ", err.message, GlobalPref.getResourceValue("Exception"));
        }
