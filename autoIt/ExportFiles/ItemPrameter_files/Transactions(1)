    filterGridData: function () {
        let sFieldName = "";
        let iCounter = 0;
        let iRow = 0;
        let iTagIndex = 0;
        let iOrgIndex = 0;
        let iIndex = 0;
        let iMasterId = 0;
        let arrOrgIndex = [];

        //debugger
        tableBodyFieldWiseValue = [];
        for (iRow = 0; iRow < tableBodyData.length; iRow++) {
            if (tableBodyData[iRow].Sales != null) {
                arrOrgIndex.push(iRow);
                tableBodyFieldWiseValue.push([]);
            }
        }

        for (iRow = 0; iRow < tableBodyFieldWiseValue.length; iRow++) {
            for (iTagIndex = 0 ; iTagIndex < TagValues.length; iTagIndex++) {
                if (TagValues[iTagIndex].ID == eMasterTypeId.Account) {
                    for (iCounter = 0; iCounter < TagValues[iTagIndex].Tag.length; iCounter++) {
                        tableBodyFieldWiseValue[iRow].push({ Key: "PurchaseAC", Value: TagValues[iTagIndex].Tag[iCounter].Name });
                        break;
                    }
                }
                else if (TagValues[iTagIndex].ID == eMasterTypeId.Product) {
                    iOrgIndex = arrOrgIndex[iRow];
                    iMasterId = tableBodyData[iOrgIndex].Sales.Product;
                    for (iIndex = 0; iIndex < TagValues[iTagIndex].Tag.length; iIndex++) {
                        if (TagValues[iTagIndex].Tag[iIndex].ID == iMasterId) {
                            tableBodyFieldWiseValue[iRow].push({ Key: "Item", Value: TagValues[iTagIndex].Tag[iIndex].Name });
                            break;
                        }
                    }
                }
                else if (TagValues[iTagIndex].ID == eMasterTypeId.Units) {
                    iOrgIndex = arrOrgIndex[iRow];
                    iMasterId = tableBodyData[iOrgIndex].Sales.Unit;
                    for (iIndex = 0; iIndex < TagValues[iTagIndex].Tag.length; iIndex++) {
                        if (TagValues[iTagIndex].Tag[iIndex].ID == iMasterId) {
                            tableBodyFieldWiseValue[iRow].push({ Key: "Unit", Value: TagValues[iTagIndex].Tag[iIndex].Name });
                            break;
                        }
                    }
                }
                else {
                    //debugger
                    iOrgIndex = arrOrgIndex[iRow];
                    if (tableBodyData[iOrgIndex].Tags == null) {
                        continue;
                    }

                    for (iIndex = 0; iIndex < tableBodyData[iOrgIndex].Tags.length; iIndex++) {
                        if (tableBodyData[iOrgIndex].Tags[iIndex].ID == TagValues[iTagIndex].ID) {
                            iMasterId = tableBodyData[iOrgIndex].Tags[iIndex].Tag;

                            for (iIndex = 0; iIndex < TagValues[iTagIndex].Tag.length; iIndex++) {
                                if (TagValues[iTagIndex].Tag[iIndex].ID == iMasterId) {
                                    tableBodyFieldWiseValue[iRow].push({ Key: TagValues[iTagIndex].Name, Value: TagValues[iTagIndex].Tag[iIndex].Name });
                                    break;
                                }
                            }

                            break;
                        }
                    }

                    if (iIndex >= tableBodyData[iOrgIndex].Tags.length) {
                        if (TagValues[iTagIndex].ID == transEntryGlobal.EntryModel.Preference.Tags.iInventory) {
                            iMasterId = tableBodyData[iOrgIndex].InvTag;
                            for (iIndex = 0; iIndex < TagValues[iTagIndex].Tag.length; iIndex++) {
                                if (TagValues[iTagIndex].Tag[iIndex].ID == iMasterId) {
                                    tableBodyFieldWiseValue[iRow].push({ Key: TagValues[iTagIndex].Name, Value: TagValues[iTagIndex].Tag[iIndex].Name });
                                    break;
                                }
                            }
                        }
                    }
                }
            }
        }

        
        for (iRow = 0; iRow < tableBodyData.length; iRow++) {
            for (iCounter = 0; iCounter < tableHeader.length; iCounter++) {
                if (FCommon.UI.isValidObject(tableBodyData[iRow].Sales) == false) {
                    continue;
                }

                switch (tableHeader[iCounter]) {
                    case "Quantity":
                        tableBodyFieldWiseValue[iRow].push({ Key: "Quantity", Value: tableBodyData[iRow].Sales.Quantity });
                        break;
                    case "Rate":
                        tableBodyFieldWiseValue[iRow].push({ Key: "Rate", Value: tableBodyData[iRow].Sales.Rate });
                        break;
                    case "Gross":
                        tableBodyFieldWiseValue[iRow].push({ Key: "Gross", Value: tableBodyData[iRow].Sales.Gross });
                        break;
                    default:
                        if (tableBodyData[iRow].Sales.ScreenData != null) {
                            for (iIndex = 0; iIndex < tableBodyData[iRow].Sales.ScreenData.length; iIndex++) {
                                if (tableHeader[iCounter] == tableBodyData[iRow].Sales.ScreenData[iIndex].FieldName) {
                                    sFieldName = tableBodyData[iRow].Sales.ScreenData[iIndex].FieldName;
                                    tableBodyFieldWiseValue[iRow].push({ Key: sFieldName, Value: tableBodyData[iRow].Sales.ScreenData[iIndex].Input });
                                    break;
                                }
                            }
                        }
                }
            }
        }
    },

