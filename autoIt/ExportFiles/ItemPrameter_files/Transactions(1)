    roundOff: function(dAmt, dGeneralRoundOff, iRoundingType) {
        let iSign = 0;

        if (transEntryInfo.ROUNDOFF == false) { // Roundoff At Final Level
            return(dAmt);
        }

        iSign = FNumberOperation.isLessThan(dAmt, 0) ? -1 : 1;
        dAmt = FConvert.roundOff(FNumberOperation.abs(dAmt), dGeneralRoundOff, iRoundingType);        
        dAmt = FNumberOperation.mul(dAmt, iSign);

        return(dAmt);
    },

