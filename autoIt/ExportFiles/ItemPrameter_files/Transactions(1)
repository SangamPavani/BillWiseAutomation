    doQuantityLeaveAction: function (dQuantity, dOldQuantity, iRow) {
        let bChange = false;
        let obj = null;

        try {
            if (FNumberOperation.isNotEqualTo(dQuantity, dOldQuantity) == true) {
                EntryMainUI.clear(transEntryFieldInfo.Reservation, iRow);

                bChange = true;
                EntryMainWorkflow.checkForLinkValueChanges(eVTFIELDID.FDF_BODYQUANTITY, iRow, 0);

                EntryMainUI.valueChanged(transEntryFieldInfo.Qty.MetaData,
                                            iRow,
                                            transEntryFieldInfo.Qty.ColumnIndex + transEntryGrid.gridExtraColumn());
            }

            transEntryMaxQtyRelease.updateQtyToReleaseColumn(iRow, true);

            if (transEntryFieldInfo.Item.FieldId > 0
                && transEntryInfo.isInwardVoucher == false) {
                if (EntryMainMemoryObject.getProductValue(iRow) <= 0) { // No product is selected
                    EntryMainUI.clear(transEntryFieldInfo.Qty, iRow);

                    EntryMainBatch.changeQuantity(0, dOldQuantity, iRow);

                    return;
                }
            }

            EntryMainBatch.changeQuantity(dQuantity, dOldQuantity, iRow);

            if (dQuantity == 0) {
                transEntryGross.setValue(0, iRow, true);
            }

            if (transEntryFieldInfo.Qty.ColumnIndex > -1
                && transEntryFieldInfo.Rate.ColumnIndex > -1
                && transEntryFieldInfo.Gross.ColumnIndex > -1) {

                obj = {};
                obj.iRow = iRow;
                obj.bIgnoreGeneralRoundOffCheck = bChange;

                transEntryGross.calculateAndUpdate(obj);
            }

            if (FNumberOperation.isNotEqualTo(dQuantity, dOldQuantity) == true) {
                EntryMainUI.setSummaryInfo(iRow);
            }

            if (dQuantity > 0 && dQuantity != dOldQuantity && transEntryInfo.isInwardVoucher == false && transEntryInfo.InventoryPref.iCheckNegativeStock > 0 && DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction) == true) {
                if (transEntryGlobal.IntermediateData.objTransaction.Header.Flags.UpdateInv == true
                    || (transEntryInfo.InventoryPref.iCheckStockInOrders > 0 && transEntryInfo.BaseVoucherType == eVTTYPE.SORDR)) {
                    transEntryServer.checkStock(transEntryGlobal.IntermediateData.objTransaction, 
                                                iRow, 
                                                true, 
                                                "EntryMainCallback.checkStockResult");
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body doQuantityLeaveAction method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.doQuantityLeaveAction} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

