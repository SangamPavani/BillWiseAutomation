        this.getFromFieldOrder = function (iFieldOrder, bBody) {
            let iCounter = 0;
            let iIndex = 0;
            let value = undefined;
            let objMetaData = undefined;

            try {
                value = {};
                value.Area = eTranEntryFieldArea.None;
                value.MetaDataIndex = -1;
                value.ColumnIndex = -1;
                value.FieldId = 0;
                value.MetaData = undefined;

                if (bBody == true) {
                    arrFields = transEntryFieldInfo.getLayoutFields(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0 && objMetaData.iFieldOrder == iFieldOrder) {
                            value.Area = eTranEntryFieldArea.Body;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.ColumnIndex = arrFields[iCounter].ColumnIndex;
                            value.MetaData = objMetaData;
                            value.FieldId = objMetaData.iFieldId;
                            break;
                        }
                    }
                }
                else {
                    for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                        objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0
                            && objMetaData.iFieldOrder == iFieldOrder) {
                            value.Area = eTranEntryFieldArea.Header;
                            value.MetaDataIndex = iCounter;
                            value.MetaData = objMetaData;
                            value.FieldId = objMetaData.iFieldId;
                            break;
                        }
                    }
                }
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("{transEntryFieldInfo.getFromFieldOrder} " + err.message, GlobalPref.getResourceValue("Exception"));
            }

            return (value);
        }

        this.getFromFieldId = function (iFieldId, iArea) {
            let iCounter = 0;
            let arrFields = undefined;
            let value = undefined;
            let objMetaData = undefined;

            try {
                value = {};
                value.Area = eTranEntryFieldArea.None;
                value.MetaDataIndex = -1;
                value.ColumnIndex = -1;
                value.FieldId = 0;
                value.MetaData = undefined;

                if (iFieldId == undefined || iFieldId == null
                    || iFieldId <= 0 || transEntryGlobal == undefined || transEntryGlobal == null
                    || transEntryGlobal.FieldHelper == undefined || transEntryGlobal.FieldHelper == null) {
                    return (value);
                }

                if ((iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                    arrFields = transEntryFieldInfo.getScreenFields();
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        if (arrFields[iCounter].FieldId == iFieldId) {
                            value.Area = eTranEntryFieldArea.Body;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.ColumnIndex = arrFields[iCounter].ColumnIndex;
                            value.MetaData = arrFields[iCounter].MetaData;
                            value.FieldId = iFieldId;
                            break;
                        }
                    }
                }
                else if ((iFieldId & eVTFIELDFLAG.SCR_FTR) > 0) {
                    if (transEntryGlobal.EntryModel.MetaData.Footer != undefined && transEntryGlobal.EntryModel.MetaData.Footer != null) {
                        for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Footer.length; iCounter++) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iCounter];
                            if (objMetaData.iFieldId == iFieldId) {
                                value.Area = eTranEntryFieldArea.Footer;
                                value.MetaDataIndex = iCounter;
                                value.MetaData = objMetaData;
                                value.FieldId = objMetaData.iFieldId;
                                break;
                            }
                        }
                    }
                }
                else if ((iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                    arrFields = transEntryFieldInfo.getLayoutFields(false);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        if (arrFields[iCounter].FieldId == iFieldId) {
                            value.Area = eTranEntryFieldArea.Header;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.MetaData = arrFields[iCounter].MetaData;
                            value.FieldId = iFieldId;
                            break;
                        }
                    }
                }
                else if ((iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                    arrFields = transEntryFieldInfo.getLayoutFields(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        if (arrFields[iCounter].FieldId == iFieldId) {
                            value.Area = eTranEntryFieldArea.Body;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.ColumnIndex = arrFields[iCounter].ColumnIndex;
                            value.MetaData = arrFields[iCounter].MetaData;
                            value.FieldId = iFieldId;
                            break;
                        }
                    }
                }
                else if ((iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0) {
                    arrFields = transEntryFieldInfo.getTags(false);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        if (arrFields[iCounter].FieldId == iFieldId) {
                            value.Area = eTranEntryFieldArea.Header;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.MetaData = arrFields[iCounter].MetaData;
                            value.ColumnIndex = -1;
                            value.FieldId = iFieldId;
                            break;
                        }
                    }

                    if (transEntryGlobal.FieldHelper.Area.FATag == eTranEntryFieldArea.Header
                        && transEntryGlobal.EntryModel.MetaData.Header[transEntryGlobal.FieldHelper.MetaData.FATag].iFieldId == iFieldId) {

                        value.Area = eTranEntryFieldArea.Header;
                        value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.FATag;
                        value.MetaData = transEntryGlobal.EntryModel.MetaData.Header[value.MetaDataIndex];
                        value.FieldId = value.MetaData.iFieldId;
                    }
                    else if (transEntryGlobal.FieldHelper.Area.InvTag == eTranEntryFieldArea.Header
                        && transEntryGlobal.EntryModel.MetaData.Header[transEntryGlobal.FieldHelper.MetaData.InvTag].iFieldId == iFieldId) {

                        value.Area = eTranEntryFieldArea.Header;
                        value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.InvTag;
                        value.MetaData = transEntryGlobal.EntryModel.MetaData.Header[value.MetaDataIndex];
                        value.FieldId = value.MetaData.iFieldId;
                    }
                    else { // For Info Field
                        for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                            if (objMetaData.iFieldId == iFieldId) {
                                value.Area = eTranEntryFieldArea.Header;
                                value.MetaDataIndex = iCounter;
                                value.ColumnIndex = -1;
                                value.FieldId = objMetaData.iFieldId;
                                value.MetaData = objMetaData;
                                break;
                            }
                        }
                    }
                }
                else if ((iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.iFieldId == iFieldId) {
                            value.Area = eTranEntryFieldArea.Body;
                            value.MetaDataIndex = arrFields[iCounter].MetaDataIndex;
                            value.MetaData = objMetaData;
                            value.ColumnIndex = arrFields[iCounter].ColumnIndex;
                            value.FieldId = iFieldId;
                            break;
                        }
                    }

                    if (transEntryGlobal.FieldHelper.Area.FATag == eTranEntryFieldArea.Body
                        && transEntryGlobal.EntryModel.MetaData.Body[transEntryGlobal.FieldHelper.MetaData.FATag].iFieldId == iFieldId) {

                        value.Area = eTranEntryFieldArea.Body;
                        value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.FATag;
                        value.MetaData = transEntryGlobal.EntryModel.MetaData.Body[value.MetaDataIndex];
                        value.FieldId = value.MetaData.iFieldId;
                        value.ColumnIndex = transEntryGlobal.FieldHelper.Column.FATag;
                    }
                    else if (transEntryGlobal.FieldHelper.Area.InvTag == eTranEntryFieldArea.Body
                        && transEntryGlobal.EntryModel.MetaData.Header[transEntryGlobal.FieldHelper.MetaData.InvTag].iFieldId == iFieldId) {

                        value.Area = eTranEntryFieldArea.Body;
                        value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.InvTag;
                        value.MetaData = transEntryGlobal.EntryModel.MetaData.Body[value.MetaDataIndex];
                        value.FieldId = value.MetaData.iFieldId;
                        value.ColumnIndex = transEntryGlobal.FieldHelper.Column.InvTag;
                    }
                    else { // For Info Column
                        arrFields = transEntryFieldInfo.getBodyFields({ iFieldId: iFieldId });
                        if (arrFields.length > 0) {
                            value.Area = eTranEntryFieldArea.Body;
                            value.MetaDataIndex = arrFields[0].MetaDataIndex;
                            value.ColumnIndex = arrFields[0].ColumnIndex;
                            value.FieldId = arrFields[0].FieldId;
                            value.MetaData = arrFields[0].MetaData;
