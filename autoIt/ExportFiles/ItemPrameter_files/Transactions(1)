    loadVoucher: function (bSuccess, data, tag, bMessage) {
        transEntryGlobal.writeConsoleLog("Enter: {EntryMainCallback.loadVoucher}[Sucess='" + bSuccess + "']", "royalblue", true);

        let myPromise = undefined;

        myPromise = new Promise(function (myResolve, myReject) {
            EntryMain.setEditMode(false);

            if (bSuccess == false) {
                if (DataType.toBoolean(bMessage) == true) {
                    EntryMainUI.resetScreen(true, true, false, false, false);
                }

                myReject("Failed");

                return;
            }

            GLOBAL.LoadingEnd();

            myResolve({Data: data, Tag: tag});
        });

        myPromise.then(
            function (obj) {
                EntryMainUI.loadVoucher(obj);

                transEntryGlobal.writeConsoleLog("Exit: {EntryMainCallback.loadVoucher}", "royalblue", true);
            },
            function(error) {
                transEntryGlobal.writeConsoleLog("Exit: {EntryMainCallback.loadVoucher}", "royalblue", true);
            }
        );
