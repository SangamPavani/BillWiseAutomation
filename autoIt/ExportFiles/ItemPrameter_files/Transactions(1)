    onPaste: async function (ele, evt) {
        let iCounter = 0;
        let iPasteRow = 0;
        let iPasteColumn = 0;
        let items = null;
        let item = null;

        try {
            if($(evt.target).hasClass("FPopupChildren") == true) {
                return;
            }

            if ($(evt.target).hasClass("advance-item-search-text") == true) {
                FUIElement.stopKeyBubbling(evt);

                return;
            }

            if (DataType.isValidObject(evt.originalEvent) == true) {
                items = evt.originalEvent.clipboardData.items;
            }
            else {
                items = evt.clipboardData.items;
            }

            FUIElement.stopKeyProcess(evt);

            iPasteRow = transEntryGrid.getCurrentRow();
            iPasteColumn = transEntryGrid.getCurrentColumn();
            for (iCounter = 0; iCounter < items.length; iCounter++) {
                item = items[iCounter];
                if (item.type != "text/plain") {
                    continue;
                }
                item.getAsString(function (text) {
                    transEntryGrid.onPasteInternal(iPasteRow, iPasteColumn, text, evt);
                });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.onPaste} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onPasteInternal: async function (iPasteRow, iPasteColumn, text, evt) {
        let sTrimCharacter = "";
        let sNewValue = "";
        let iRow = 0;
        let iColumn = 0;
        let iCountColumn = 0;
        let iMetaDataIndex = 0;
        let bAppend = false;
        let dBalanceQty = undefined;
        let dNewAvgRate = undefined;
        let dNewStockValue = undefined;
        let arrRows = undefined;
        let arrFieldId = undefined;
        let arrRowData = undefined;
        let arrColumnData = undefined;
        let arrBodyMetaDataIndex = undefined;
        let objMetaData = undefined;
        let objFlags = undefined;
        let result = undefined;
        let cell = undefined;
        let eleActive = undefined;
        let eleCtrl = undefined;

        try {
            if (transEntryGlobal.debugPaste == true) {
                debugger
            }

            if (text.indexOf('\n') >= 0) {
                if (text.indexOf('\r') >= 0) {
                    sTrimCharacter = '\r\n';
                }
                else {
                    sTrimCharacter = '\n';
                }
            }
            else {
                sTrimCharacter = '\n';
            }

            text = text.trim(sTrimCharacter);

            arrFieldId = [];

            arrRowData = text.split(sTrimCharacter);
            // More than one row or more than one column
            if ((arrRowData.length > 1 || arrRowData[0].split('\t').length > 1)) {
                eleActive = document.activeElement;
                result = await transEntryGlobal.confirmPopup("Do you want to paste value in single cell ?", eFConfirmButton.YesNoCancel, eFConfirmDefaultButton.No);
                if (DataType.isValidObject(eleActive) == true) {
                    FUIElement.setFocus(eleActive);
                }

                if (result == eFConfirmResult.Cancel) {
                    return;
                }
                else if (result == eFConfirmResult.Yes) {
                    cell = transEntryGrid.getCellObject(iPasteRow, iPasteColumn, true);
                    if (DataType.isValidObject(cell) == true) {
                        text = DataType.toString(cell.getCellText()) + text;
                        cell.setCellText(text, text);
                    }

                    return;
                }
            }

            arrRows = [];
            arrBodyMetaDataIndex = [];
            iCountColumn = 0;
            for (iRow = 0; iRow < arrRowData.length; iRow++) {
                arrColumnData = arrRowData[iRow].split('\t');

                iCountColumn = Math.max(iCountColumn, arrColumnData.length);
                for (iColumn = 0; iColumn < arrColumnData.length; iColumn++) {
                    if ((iRow + iPasteRow) == (transEntryGrid.getTotalRows() + 1)) {
                        transEntryGrid.insertRows(0, 1, true);
                    }

                    cell = transEntryGrid.getCellObject(iRow + iPasteRow, iColumn + iPasteColumn, true);
                    if (DataType.isValidObject(cell) == false) {
                        continue;
                    }
                    text = arrColumnData[iColumn];

                    iMetaDataIndex = DataType.toInt(cell.ColumnAttribute.metadataindex);
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iMetaDataIndex];
                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    if (arrBodyMetaDataIndex.indexOf(iMetaDataIndex) == -1) {
                        arrBodyMetaDataIndex.push(iMetaDataIndex);
                    }

                    bAppend = false;
                    if (arrRowData.length == 1 && cell.hasControl() == true && objMetaData.iDataTypeId == eMasterDataType.Text) {
                        bAppend = true;
                        if (arrColumnData.length == 1) {
                            eleCtrl = cell.getControl()
                            if (eleCtrl && DataType.isValidObject(eleCtrl.selectionStart) == true) {
                                if (eleCtrl.selectionStart > 0) {
                                    sNewValue = DataType.stringLeft(eleCtrl.value, eleCtrl.selectionStart);
                                    sNewValue += text;

                                    if (eleCtrl.selectionEnd == eleCtrl.selectionStart) {
                                        sNewValue += eleCtrl.value.substr(eleCtrl.selectionStart);
                                    }
                                    else {
                                        sNewValue += eleCtrl.value.substr(eleCtrl.selectionEnd);
                                    }

                                    text = sNewValue;
                                    bAppend = false;
                                }
                                else if (eleCtrl.value.length > 0) {
                                    if (eleCtrl.selectionEnd == 0) {
                                        text += eleCtrl.value;
                                    }
                                    else {
                                        text += eleCtrl.value.substr(eleCtrl.selectionEnd);
                                    }

                                    bAppend = false;
                                }
                            }
                        }
                    }

                    if (arrFieldId.indexOf(objMetaData.iFieldId) == -1) {
                        arrFieldId.push(objMetaData.iFieldId);
                    }

                    if (arrRows.indexOf(cell.iRow) == -1) {
                        arrRows.push(cell.iRow);
                    }

                    transEntryGrid.setCellValueBasedOnDataType(cell,
                        text,
                        {
                            MetaData: objMetaData,
                            Data: null,
                            bAppend: bAppend,
                            bFromPaste: true,
                            bFromBatch: false
                        });

                    if (iRow == 0 && iColumn == 0) {
                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                                OPTIONCONTROL.setControlText(EntryMainUI.getBodyControlId(objMetaData.iFieldId), text, true);
                                break;
                        }
                    }
                }
            }

            if (transEntryInfo.HeaderId > 0 && arrFieldId.length > 0) {
                objFlags = transEntryInfo.HeaderFlags;

                objFlags.NoLinkCheck = false;
                if (transEntryInfo.isItSales == true) {
                    objFlags.NoBatchCheck = false;
                    objFlags.NoBinCheck = false;
                    objFlags.CheckNegativeStock = true;

                    EntryMain.m_bQtyModified = true;
                }

                transEntryInfo.HeaderFlags = objFlags;
            }

            if (iCountColumn > 1) {
                for (iRow = 0; iRow < arrRows.length; iRow++) {

                    dBalanceQty = undefined;
                    if (transEntryFieldInfo.BalanceQty.FieldId > 0) {
                        cell = EntryMainUI.getElement(transEntryFieldInfo.BalanceQty, arrRows[iRow]);
                        if (cell.Value) {
                            dBalanceQty = EntryMainStockRevaluation.processBalanceQty(cell.Value, evt);
                        }
                    }

                    if (transEntryFieldInfo.AvgRate.FieldId > 0) {
                        cell = EntryMainUI.getElement(transEntryFieldInfo.AvgRate, arrRows[iRow]);
                        if (cell.Value) {
                            EntryMainStockRevaluation.processAvgRate(cell.Value, evt);
                        }
                    }

                    if (transEntryFieldInfo.BalanceStockValue.FieldId > 0) {
                        cell = EntryMainUI.getElement(transEntryFieldInfo.BalanceStockValue, arrRows[iRow]);
                        if (cell.Value) {
                            EntryMainStockRevaluation.processBalanceStockValue(cell.Value, evt);
                        }
                    }

                    dNewAvgRate = EntryMainUI.getValue(transEntryFieldInfo.NewAvgRate, arrRows[iRow]);
                    if (transEntryFieldInfo.NewStockValue.FieldId > 0
                        && arrFieldId.indexOf(transEntryFieldInfo.NewStockValue.FieldId) == -1
                        && dBalanceQty != undefined) {

                        dNewStockValue = EntryMainStockRevaluation.calculateNewStockValue(dBalanceQty, dNewAvgRate);
                        EntryMainStockRevaluation.setNewStockValue(arrRows[iRow], dNewStockValue);
                    }
                }
            }

            if (arrRowData.length > 0
                && (DataType.isValidObject(objMetaData) == false || objMetaData.iDataTypeId != eMasterDataType.Master)) {

                iCountColumn = 0;
                for (iColumn = 0; iColumn < arrBodyMetaDataIndex.length; iColumn++) {
                    iMetaDataIndex = arrBodyMetaDataIndex[iColumn];
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iMetaDataIndex];
                    if (objMetaData.iDataTypeId != eMasterDataType.Master && objMetaData.iDataTypeId != eMasterDataType.Text) {
                        iCountColumn++;
                    }
                }

                if (arrBodyMetaDataIndex.length == 0 || iCountColumn > 0) {
                    EntryMainUI.setSummaryInfo();
                }

                //EntryMainUI.setSummaryInfo();

                if (arrRows.length > 0) {
                    transEntryGrid.makeRowVisible(arrRows[arrRows.length - 1]);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.onPasteInternal} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

