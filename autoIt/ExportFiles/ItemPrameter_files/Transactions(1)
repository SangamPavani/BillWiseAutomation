    // Called from qty cell leave 
    changeQuantity: function (dNewQuantity, dLastQuantity, iRow) {
        let dAvailableQty = 0;
        let objBatchInfo = null;

        try {
            if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) {
                return;
            }

            dLastQuantity = DataType.toDecimal(dLastQuantity);
            if (transEntryInfo.isInwardVoucher == true && EntryMainProductionProcess.isIssueRow(iRow) == false) {
                return;
            }

            if (DataType.lt(dNewQuantity, dLastQuantity) == true) { // Update batch quantity
                transEntryBatch.updateQuantity(iRow, EntryMainMemoryObject.getBaseQuantityValue(iRow));
            }
            else if (DataType.gt(dNewQuantity, dLastQuantity) == true) { // Delete batch info
                objBatchInfo = transEntryFields.getBatchInfo(iRow);
                if(transEntryInfo.isInwardVoucher == false 
                    && dLastQuantity == 0 
                    && transEntryFieldInfo.BatchNo.ColumnIndex < transEntryFieldInfo.Qty.ColumnIndex
                    && DataType.isValidObject(objBatchInfo) == true && DataType.toDecimal(objBatchInfo.Qty) == 0) {

                    transEntryBatch.updateQuantity(iRow, dNewQuantity);
                }
                else {
                    dAvailableQty = transEntryBatch.getAvailableQty(iRow);

                    if (FNumberOperation.isLessThanOrEqualTo(EntryMainMemoryObject.getBaseQuantityValue(iRow), dAvailableQty) == true) {
                        transEntryBatch.updateQuantity(iRow, EntryMainMemoryObject.getBaseQuantityValue(iRow));
                    }
                    else {
                        EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.changeQuantity} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    setBatchData: function (cellobj, objBatchData, objBatchBody, iSourceRow, bIgnoreSetSummaryInfo, iTotalBatchData, objInput) {
        let sValue = "";
        let dInputBaseQty = 0;
        let fConversion = 1;
        let iValuationMethod = 0;
        let dNewQty = 0;
        let dNewAltQty = 0;
        let dNewGross = 0;
        let dRate = 0;
        let dGross = 0;
        let dValue = 0;
        let dOldQty = 0;
        let dGeneralRoundOff = 0;
        let iKeyField = 0;
        let iCounter = 0;
        let iIndex = 0;
        let lLastBatchId = 0;
        let iRateDecimals = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objMetaData = undefined;
        let objFlags = undefined;
        let temp = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugBatch == true) {
                debugger
            }

            iTotalBatchData = DataType.toInt(iTotalBatchData);

            bIgnoreSetSummaryInfo = DataType.toBoolean(bIgnoreSetSummaryInfo);
            if (transEntrySettings.isLoadBatchesBeforeQuantity == true) {
                dInputBaseQty = objBatchData.Qty;
            }
            else {
                dInputBaseQty = EntryMainMemoryObject.getBaseQuantityValue(cellobj.iRow);
                dInputBaseQty = Math.abs(dInputBaseQty);
            }

            if (transEntryFieldInfo.Rate.ColumnIndex > -1) {
                objMetaData = transEntryFieldInfo.Rate.MetaData;
                if (DataType.stringIncludes(objMetaData.sPreload, "btrt") == true) {
                    objBatchData.BatchRate = transEntryRate.update(objBatchData.BatchRate, cellobj.iRow);
                }
            }

            if (transEntryGlobal.bPassTransQtyInBatchPopup == true) {
                fConversion = 1;
                dOldQty = EntryMainUI.getValue(transEntryFieldInfo.Qty, cellobj.iRow);
            }
            else {
                fConversion = transEntryUnit.getConversionValue(cellobj.iRow);
                dOldQty = EntryMainMemoryObject.getBaseQuantityValue(cellobj.iRow, true);
            }

            if (FNumberOperation.isEqualTo(dOldQty, objBatchData.Qty) == false) {
                //dNewQty = FConvert.batchRoundOff(objBatchData.Qty, fConversion, transEntryQuantity.getDecimals(cellobj.iRow));
                dNewQty = FConvert.batchRoundOff(objBatchData.Qty, fConversion, GlobalPref.DecimalsInQty);
            }
            else {
                dNewQty = transEntryFields.getQty(cellobj.iRow);
            }

            if (DataType.neq(dInputBaseQty, dNewQty) == true
                || (transEntrySettings.isLoadBatchesBeforeQuantity == true && DataType.neq(dOldQty, objBatchData.Qty) == true)) {

                if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                    transEntryBins.updateQuantity(cellobj.iRow, dNewQty, false); // Update Bins
                }

                if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                    transEntryBins.updateQuantity(cellobj.iRow, dNewQty, true); // Update Bins2
                }

                EntryMainUI.clear(transEntryFieldInfo.Reservation, cellobj.iRow); // Clear Reservation

                if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true && transEntryLinks.isDefinedOnQty() == true) {
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoLinkCheck = false;
                    objFlags.NoBatchCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                }
            }
            
            transEntryQuantity.setValue(dNewQty, cellobj.iRow, { bUpdateMemoryObject: true });

            if (transEntryFieldInfo.Gross.ColumnIndex > -1
                && transEntryFieldInfo.Rate.ColumnIndex > -1) {

                obj = {};
                obj.iRow = cellobj.iRow;
                obj.bIgnoreGeneralRoundOffCheck = false;

                if(iTotalBatchData > 1) {
                    obj.bIgnoreGeneralRoundOffCheck = true;
                }

                transEntryGross.calculateAndUpdate(obj);
            }

            iValuationMethod = 0;
            if (transEntryFieldInfo.Rate.ColumnIndex > -1) {
                temp = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, cellobj.iRow, "iValuationMethod");
                if (DataType.isValidObject(temp) == true) {
                    iValuationMethod = DataType.toInt(temp);
                }

                if (iValuationMethod == eValuationMethod.BatchRate) {

                    if(DataType.stringStartsWith(objMetaData.sPreload, "rtstk", true) == true 
                        || DataType.stringStartsWith(objMetaData.sPreload, "&rtstk", true) == true
                        || DataType.stringStartsWith(transEntryInfo.Settings.RateFormula, "rtstk", true) == true
                        || DataType.stringStartsWith(transEntryInfo.Settings.RateFormula, "&rtstk", true) == true) {

                        dValue = objBatchData.BatchRate;
                        transEntryRate.update(dValue, cellobj.iRow);
                        if (transEntryFieldInfo.Gross.ColumnIndex > -1) {
                            transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow });
                        }
                    }
                    else if(DataType.stringStartsWith(transEntryInfo.Settings.RateFormula, "&") == true) {

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(transEntryInfo.Settings.RateFormula, cellobj.iRow, null, cellobj.iColumn - 1);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dValue = objFormulaOutput.Value;
                        dValue = transEntryRate.update(dValue, cellobj.iRow);
                        if (transEntryFieldInfo.Gross.ColumnIndex > -1) {
                            transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow });
                        }
                    }
                }
                
                if (DataType.isValidObject(objInput) == true) {
                    if (transEntryFieldInfo.AltQty.FieldId > 0 && DataType.gt(objInput.dOrgAltQty, 0) == true) {
                        if (DataType.isBlankOrZero(objInput.dOrgQty) == false && DataType.isBlankOrZero(dNewQty) == false) {
                            // New Alt Qty = OrgAltQty*NewQty/OrgQty
                            dNewAltQty = DataType.mul(objInput.dOrgAltQty, dNewQty);
                            dNewAltQty = DataType.div(dNewAltQty, objInput.dOrgQty);

                            transEntryFields.setAltQty(dNewAltQty, cellobj.iRow);
                        }
                    }

                    // New Gross = OrigGross/OrigQty*NewQty
                    dNewGross = DataType.div(objInput.dOrgGross, objInput.dOrgQty);
                    dNewGross = DataType.mul(dNewGross, dNewQty);
                    transEntryGross.setValue(dNewGross, cellobj.iRow, true);

                    dNewGross = EntryMainMemoryObject.getGrossValue(cellobj.iRow);
                    // New Rate = New Gross/NewQty
                    dValue = DataType.div(dNewGross, dNewQty);

                    iRateDecimals = undefined;
                    if (DataType.gt(objInput.dOrgRate, 0) == true) {
                        iRateDecimals = DataType.getDecimalPlaces(objInput.dOrgRate);
                        if (iRateDecimals == 0) {
                            iRateDecimals = undefined;
                        }
                    }

                    transEntryRate.update(dValue, cellobj.iRow, undefined, iRateDecimals);
                    dRate = EntryMainMemoryObject.getRateValue(cellobj.iRow);
                    if (DataType.neq(dRate, objInput.dOrgRate) == true) {
                        dNewGross = DataType.mul(dNewQty, dRate);
                        dGross = DataType.mul(dNewQty, objInput.dOrgRate);
                        if (DataType.eq(dGross, dNewGross) == true) {
                            objInput.dOrgRate = transEntryRate.setValue(objInput.dOrgRate, cellobj.iRow);
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, objInput.dOrgRate, cellobj.iRow);
                        }
                        else {
                            dGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(cellobj.iRow);
                            dGross = FConvert.roundOff(dGross, dGeneralRoundOff, transEntryCurrency.getRoundingType(cellobj.iRow));
                            dNewGross = FConvert.roundOff(dNewGross, dGeneralRoundOff, transEntryCurrency.getRoundingType(cellobj.iRow));

                            if (DataType.eq(dGross, dNewGross) == true) {
                                objInput.dOrgRate = transEntryRate.setValue(objInput.dOrgRate, cellobj.iRow);
                                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, objInput.dOrgRate, cellobj.iRow);
                            }
                        }
                    }
                }
            }

            lLastBatchId = transEntryBatch.getBatchId(cellobj.iRow);

            transEntryBatch.setBatchInfo(cellobj, objBatchData);
            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, objBatchData, cellobj.iRow);

            if(DataType.isZero(lLastBatchId) == false && DataType.neq(lLastBatchId, objBatchData.BatchId) == true) { // Batch Changed
                EntryMainUI.clear(transEntryFieldInfo.Bins, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Bins2, cellobj.iRow);

                EntryMainUI.clear(transEntryFieldInfo.Reservation, cellobj.iRow); // Clear Reservation
            }

            if (transEntryInfo.BatchPref.bLoadAllDetailsRelatedToBatchInIssues == true) {
                EntryMainUI.updateBodyRowLayoutAndScreenData(objBatchBody, cellobj.iRow, true, bIgnoreSetSummaryInfo);
                EntryMainUI.updateBodyRowTags(objBatchBody, cellobj.iRow, true);
            }

            if (transEntryGlobal.FieldHelper.Column.Links > 0) { // Update usedvalue of link column
                for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.MetaData.Links.length; iCounter++) {
                    iIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter];
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
                    iKeyField = transEntryLinks.getLinkField(objMetaData.iMasterLink);
                    if (iKeyField != eTranEntryLinkValue.Quantity) {
                        continue;
                    }

                    transEntryGrid.copyColumnData(iSourceRow,
                                                transEntryGlobal.FieldHelper.Column.Links[iCounter],
                                                cellobj.iRow,
                                                transEntryGlobal.FieldHelper.Column.Links[iCounter]);

                }
            }

            if (transEntryFieldInfo.MaxQtyRelease.ColumnIndex > -1) {
                dValue = transEntryMaxQtyRelease.getMaxRelease(cellobj.iRow);
                if (DataType.gte(dValue, objBatchData.Qty) == true) {
                    sValue = DataType.toDecimal(objBatchData.Qty, transEntryQuantity.getDecimals());
                    transEntryMaxQtyRelease.setText(cellobj.iRow, sValue, objBatchData.Qty);
                    transEntryCache.m_dMaxQtyRelease -= objBatchData.Qty;
                    transEntryMaxQtyRelease.setMaxRelease(cellobj.iRow, objBatchData.Qty);
                }
                else {
                    sValue = DataType.toDecimal(dValue, transEntryQuantity.getDecimals());
                    transEntryMaxQtyRelease.setText(cellobj.iRow, sValue, dValue);
                    transEntryMaxQtyRelease.setMaxRelease(cellobj.iRow, dValue);
                    transEntryCache.m_dMaxQtyRelease = 0;
                }
            }

            EntryMainBody.doQuantityLeaveAction(objBatchData.Qty, objBatchData.Qty, cellobj.iRow);

            if (transEntryInfo.BatchPref.bInputBatchRetailPrice == true
                && transEntryFieldInfo.Rate.ColumnIndex > -1) {

                EntryMainBody.doRateLeaveAction(0, 0, cellobj.iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.setBatchData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onDocumentDate_Change: function () {
        let iDocumentDate = 0;
        let iRow = 0;
        let iCounter = 0;
        let objBatchInfo = null;
        let arrBatchId = [];
        let arrRow = [];
        let lstValidBatches = null;
            
        try {
            if (transEntryFieldInfo.BatchNo.ColumnIndex < 0 || transEntryInfo.isInwardVoucher == true) {
                return;
            }

            iDocumentDate = EntryMain.m_objTrans.Header.Date;
            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    continue;
                }

                objBatchInfo = transEntryBatch.getBatchInfo(iRow);
                if (DataType.isValidObject(objBatchInfo) == false) {
                    continue;
                }

                if (objBatchInfo.ExpDate.Value != 0 && objBatchInfo.ExpDate.Value < iDocumentDate) {
                    EntryMainBatch.clear(iRow);
                }
                else if (objBatchInfo.MfgDate.Value != 0 && objBatchInfo.MfgDate.Value > iDocumentDate) {
                    EntryMainBatch.clear(iRow);
                }
                else {
                    arrBatchId.push(objBatchInfo.BatchId);
                    arrRow.push(iRow);
                }
            }

            if (arrBatchId.length > 0) {
                lstValidBatches = transEntryServer.execute(eTransServerRequest.ValidateBatchProcureDate, {arrBatchId: arrBatchId, iDocDate: iDocumentDate});
                if (lstValidBatches.lValue > 0) {
                    lstValidBatches = lstValidBatches.data;
                }

                if (lstValidBatches.lValue > 0) {
                    lstValidBatches = lstValidBatches.data;
                    for (iRow = 0; iRow < lstValidBatches.length; iRow++) {
                        if (lstValidBatches[iRow].Tag == true) {
                            continue;
                        }

                        for (iCounter = 0; iCounter < arrBatchId.length; iCounter++) {
                            if (arrBatchId[iCounter] != lstValidBatches[iRow].ID) {
                                continue;
                            }

                            EntryMainBatch.clear(arrRow[iCounter]);
                        }
                    }
                }
            }            
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.onDocumentDate_Change} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    processBatchData: function (iRow, arrBatchList, arrBatchBody, evt, bIgnoreSetSummaryInfo, objLog) {
        let iCounter = 0;
        let iTotal = 0;
        let iIndex = 0;
        let dOrgBaseQuantity = 0;
        let dBaseQuantity = 0;
        let dDifference = 0;
        let objMetaData = null;
        let arrRecalculateScreenColumns = null;
        let arrTotalRecalculatedValue = null;
        let arrFields = undefined;
        let arrRows = null;
        let cell = null;
        let objInput = null;

        try {
            if (transEntryGlobal.debugBatch == true) {
                debugger
            }

            bIgnoreSetSummaryInfo = DataType.toBoolean(bIgnoreSetSummaryInfo);
            iTotal = DataType.arrayLength(arrBatchList);

            arrRecalculateScreenColumns = [];
            arrTotalRecalculatedValue = [];
            if (iTotal > 1) {
                objInput = {};
                objInput.dOrgQty = transEntryFields.getQty(iRow);
                objInput.dOrgGross = EntryMainMemoryObject.getGrossValue(iRow);
                objInput.dOrgRate = EntryMainMemoryObject.getRateValue(iRow);
                objInput.dOrgAltQty = transEntryFields.getAltQty(iRow);

                arrFields = transEntryFieldInfo.getScreenFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;
                    if (objMetaData.FormulaBehaviour == eTranEntryFormulaBehaviourBody.Value) {
                        cell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                        if (DataType.isValidObject(cell) == true && DataType.toDecimal(cell.getCellData()) != 0) {
                            arrRecalculateScreenColumns.push({
                                ScreenIndex: iCounter,
                                MetaDataIndex: arrFields[iCounter].MetaDataIndex,
                                ColumnIndex: arrFields[iCounter].ColumnIndex,
                                OrgValue: DataType.toDecimal(cell.getCellData())
                            });

                            arrTotalRecalculatedValue.push(0);
                        }
                    }
                }
            }

            dOrgBaseQuantity = 0;
            if (arrRecalculateScreenColumns.length > 0) {
                dOrgBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(iRow);
            }
            transEntryCache.m_dMaxQtyRelease = transEntryFields.getMaxQtyRelease(iRow);

            arrRows = [];
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                if (iCounter > 0) {
                    EntryMainBody.onDuplicateRow(iRow + iCounter - 1, [eVTFIELDID.FDF_LINK], evt, true);
                    transEntryMaxQtyRelease.setMaxRelease(iRow + iCounter, transEntryCache.m_dMaxQtyRelease);
                }

                arrRows.push(iRow + iCounter);
                cell = EntryMainUI.getElement(transEntryFieldInfo.BatchNo, iRow + iCounter).Value;
                if (DataType.isValidObject(cell) == true)
                {
                    if (objLog) {
                        objLog.add("Method-processBatchData::setBatchData(Row-" + (iRow + iCounter) + ") Start");
                    }
                    EntryMainBatch.setBatchData(cell, arrBatchList[iCounter], arrBatchBody[iCounter], iRow, bIgnoreSetSummaryInfo, iTotal, objInput);
                    if (objLog) {
                        objLog.add("Method-processBatchData::setBatchData(Row-" + (iRow + iCounter) + ") End");
                    }

                    if (transEntryFieldInfo.MaxQtyRelease.ColumnIndex > -1) {

                    }

                    if (DataType.toInt(arrBatchList[iCounter].MfgDate) > 0
                        && transEntryFieldInfo.MFGDate.ColumnIndex > -1) {

                        transEntryGrid.setCellDate(cell.iRow, transEntryFieldInfo.MFGDate.ColumnIndex, DataType.toInt(arrBatchList[iCounter].MfgDate));
                    }

                    if (DataType.toInt(arrBatchList[iCounter].ExpDate) > 0
                        && transEntryFieldInfo.EXPDate.ColumnIndex > -1) {

                        transEntryGrid.setCellDate(cell.iRow, transEntryFieldInfo.EXPDate.ColumnIndex, DataType.toInt(arrBatchList[iCounter].ExpDate));
                    }
                }

                if (dOrgBaseQuantity > 0) {
                    if (objLog) {
                        objLog.add("Method-processBatchData::RecalculateScreenColumns(" + (iRow + iCounter) + ") Start");
                    }

                    for (iIndex = 0; iIndex < arrRecalculateScreenColumns.length; iIndex++) {
                        dBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(iRow + iCounter);
                        if (dBaseQuantity != 0) {
                            //dValue = (arrRecalculateScreenColumns[iIndex].OrgValue * dBaseQuantity) / dOrgBaseQuantity;
                            dValue = FNumberOperation.calculate([arrRecalculateScreenColumns[iIndex].OrgValue, dBaseQuantity, dOrgBaseQuantity], ['*', '/']);

                            objMetaData = transEntryGlobal.getBodyMetaDataObject(arrRecalculateScreenColumns[iIndex].MetaDataIndex);
                            dValue = DataType.toDecimal(dValue, objMetaData.iNoDecimal, true);

                            arrTotalRecalculatedValue[iIndex] = FNumberOperation.add(arrTotalRecalculatedValue[iIndex], dValue);
                            if(iCounter == (iTotal - 1)) { // Last Row
                                if (FNumberOperation.isNotEqualTo(arrRecalculateScreenColumns[iIndex].OrgValue, arrTotalRecalculatedValue[iIndex]) == true) {
                                    dDifference = FNumberOperation.sub(arrRecalculateScreenColumns[iIndex].OrgValue, arrTotalRecalculatedValue[iIndex]);
                                    dValue = FNumberOperation.add(dValue, dDifference);
                                }
                            }

                            sValue = DataType.toDecimal(dValue, objMetaData.iNoDecimal);

                            

                            cell = transEntryGrid.getCellObject(iRow + iCounter, arrRecalculateScreenColumns[iIndex].ColumnIndex);
                            if (DataType.isValidObject(cell) == true) {
                                cell.setCellText(sValue, dValue);

                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                                dRawOutput = dValue;
                                dValue = DataType.toDecimal(dValue, objMetaData.iNoDecimal, true);
                                transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, dValue, cell.iRow, dValue);
                            }
                        }
                    }

                    if (objLog) {
                        objLog.add("Method-processBatchData::RecalculateScreenColumns(" + (iRow + iCounter) + ") Start");
                    }
                }
            }

            transEntryCache.m_dMaxQtyRelease = null;

            if (DataType.toBoolean(bIgnoreSetSummaryInfo) == false) {
                if (objLog) {
                    objLog.add("Method-processBatchData::setSummaryInfo() Start");
                }

                EntryMainUI.setSummaryInfo(0);

                if (objLog) {
                    objLog.add("Method-processBatchData::setSummaryInfo() End");
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainBatch.processBatchData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrRows);
    },

    calculateAndSetExpiryDateFromItem: function (iRow, bValueChanged) {
        let sText = "";
        let bCalcExp = false;
        let iProductId = 0;
        let iDate = 0;
        let iMFGDate = 0;
        let iProductAccount = 0;
        let objMFGDateInfo = undefined;
        let objEXPDateInfo = undefined;
        let objCell = undefined;

        try {
            if (bValueChanged == false) {
                return;
            }

            if (transEntryInfo.isInwardVoucher == false) {
                return;
            }

            if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, iRow) == false) {
                return;
            }

            objMFGDateInfo = transEntryFieldInfo.MFGDate;

            bCalcExp = false;
            if (objMFGDateInfo.MetaDataIndex > -1) {
                objCell = EntryMainUI.getElement(transEntryFieldInfo.MFGDate, iRow).Value;
                if (DataType.isValidObject(objCell) == false) {
                    return;
                }

                if (transEntryFields.isRequired(eVTFIELDID.FDF_MFGDATE, iRow) == false) {
                    objCell.clear();
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_MFGDATE, undefined, objCell.iRow);
                }
                else if (transEntryFields.getMFGDate(iRow) == 0
                    && objMFGDateInfo.MetaData.bClearDate == false) {
                    iMFGDate = EntryMain.m_objTrans.Header.Date;
                    sText = EntryMainUI.getValue(transEntryFieldInfo.Date, 0, true);
                    objCell.setCellText(sText, iMFGDate);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_MFGDATE, iMFGDate, objCell.iRow);
                }
            }

            if (transEntryFields.isRequired(eVTFIELDID.FDF_EXPDATE, iRow, true) == false) {
                transEntryBatch.setExpDate(iRow, 0);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_EXPDATE, undefined, iRow);

                return;
            }

            objEXPDateInfo = transEntryFieldInfo.EXPDate;

            if (objEXPDateInfo.MetaDataIndex > -1
                && transEntryInfo.BatchPref.bCalculateExpiryDateFromItem == true
                && objMFGDateInfo.MetaDataIndex > -1) {
                bCalcExp = true;

                if (iMFGDate == 0) {
                    iMFGDate = transEntryFields.getMFGDate(iRow);
                }
            }

            if (bCalcExp == true || (objMFGDateInfo.MetaDataIndex < 0 && objEXPDateInfo.MetaDataIndex > -1 && transEntryInfo.BatchPref.bCalculateExpiryDateFromItem == true)) {

                if (transEntryFieldInfo.Item.FieldId == 0) {
                    return;
                }

                iProductId = EntryMainMemoryObject.getProductValue(iRow);
                iProductAccount = EntryMainPreload.getProductAccount(iProductId, eProdAccountTypes.ExpiryDays);
                if (iMFGDate == 0) {
                    iMFGDate = EntryMain.m_objTrans.Header.Date;
                }

                iDate = FDate.addDays(iMFGDate, iProductAccount, transEntryInfo.CalendarType);
                transEntryBatch.setExpDate(iRow, iDate);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_EXPDATE, iDate, iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.calculateAndSetExpiryDateFromItem} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    generateBatchFromSeries: function (cellobj) {
