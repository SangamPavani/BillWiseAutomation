    setBodyDefaultValue: function (iRow) {
        let iCounter = 0;
        let value = 0;
        let arrFields = undefined;
        let objMetaData = null;
        let cell = null;

        try {
            arrFields = transEntryFieldInfo.getScreenFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == true) {
                    continue;
                }

                cell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                if (DataType.isValidObject(cell) == false) {
                    continue;
                }

                if (DataType.toDecimal(cell.getCellData()) == 0) {
                    if (objMetaData.bMandatory == true) { // Check For Mandatory
                        cell.clear();
                    }
                    else {
                        value = DataType.toDecimal(objMetaData.sDefaultValue, objMetaData.iNoDecimal);
                        cell.setCellText(value, value);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryScreenData.setBodyDefaultValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    findInObject: function (iFieldId, iRow, objTrans) {
        let iIndex = 0;
        let objScreenData = undefined;

        try {
            if (DataType.isValidObject(objTrans) == false) {
                return (objScreenData);
            }

            if (iRow > DataType.arrayLength(objTrans.BodyData)) {
                return (objScreenData);
            }

            if (DataType.isValidObject(objTrans.BodyData[iRow - 1].Sales) == false) {
                return (objScreenData);
            }

            if (DataType.arrayLength(objTrans.BodyData[iRow - 1].Sales.ScreenData) < 1) {
                return (objScreenData);
            }

            for (iIndex = 0; iIndex < objTrans.BodyData[iRow - 1].Sales.ScreenData.length; iIndex++) {
                if (objTrans.BodyData[iRow - 1].Sales.ScreenData[iIndex].FieldId == iFieldId) {
                    objScreenData = objTrans.BodyData[iRow - 1].Sales.ScreenData[iIndex];
                    break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryScreenData.findInObject} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objScreenData);
    },

