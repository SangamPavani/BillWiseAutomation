    processBinsData: function (arrBin, objCustomData) {
        let iCounter = 0;
        let iVoucherType = 0;
        let bUseAllocTag = false;
        let objBinColumn = null;
        let arrRows = null;
        let arrBin2 = null;
        let result = null;
        let lstTempBin = null;
        let obj = null;

        try {
            if (DataType.isValidObject(arrBin) == false) {
                return;
            }

            iVoucherType = transEntryInfo.VoucherType;
            if (transEntryFieldInfo.AllocationTag.Area != eTranEntryFieldArea.None 
                /*&& (FConvert.isItInwardVoucher(iVoucherType) || FConvert.isItTransfer(iVoucherType))*/) {
                bUseAllocTag = true;
            }

            if (transEntryFieldInfo.ToSkid.ColumnIndex < 0) {
                arrBin2 = [];

                if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                    objBinColumn = transEntryGrid.getCellObject(objCustomData.iRow, transEntryFieldInfo.Bins2.ColumnIndex);
                    result = DataType.stringToObject(objBinColumn.getCellData());
                    if (result.lValue > 0) {
                        arrBin2 = result.data; // BinsQuantity[] 
                    }
                }

                if (arrBin2.length > 0) {
                    if (arrBin.length > 1 && arrBin2.length == 1) {
                        lstTempBin = DataType.createDuplicateObject(arrBin2);
                        lstTempBin[0].Quantity = arrBin[0].Quantity;

                        for (iCounter = 1; iCounter < arrBin.length; iCounter++) {
                            obj = DataType.createDuplicateObject(arrBin[iCounter]);
                            lstTempBin.push(obj);
                            lstTempBin[lstTempBin.length - 1].BinId = lstTempBin[0].BinId;
                        }

                        objBinColumn.setCellData(DataType.toString(lstTempBin));
                    }
                    else if (arrBin.length == arrBin2.length) {
                        for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                            arrBin2[0].SkidId = arrBin[iCounter].SkidId;
                        }

                        objBinColumn.setCellData(DataType.toString(arrBin2));
                    }
                }
            }

            if (arrBin.length > 0 && transEntryFieldInfo.FromSkid.ColumnIndex > -1) {
                if (arrBin[0].SkidId > 0) {
                    transEntryGrid.setCellText(objCustomData.iRow,
                                                transEntryFieldInfo.FromSkid.ColumnIndex,
                                                arrBin[0].SkidId,
                                                arrBin[0].SkidId);
                }
            }


            for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                if (DataType.isValidObject(objCustomData.iBodyId) == true) {
                    arrBin[iCounter].BodyId = objCustomData.iBodyId;
                }

                if (DataType.isValidObject(objCustomData.iProductId) == true) {
                    arrBin[iCounter].Item = objCustomData.iProductId;
                }

                if (DataType.isValidObject(objCustomData.iUnitId) == true) {
                    arrBin[iCounter].UnitId = objCustomData.iUnitId;
                }

                if (DataType.isValidObject(objCustomData.sBatch) == true) {
                    arrBin[iCounter].Batch = objCustomData.sBatch;
                }
                
                if (DataType.isValidObject(objCustomData.BatchId) == true) {
                    arrBin[iCounter].BatchId = objCustomData.BatchId;
                }

                if (bUseAllocTag == true && DataType.isValidObject(objCustomData.AllocationTag) == true) {
                    arrBin[iCounter].AllocTag = objCustomData.AllocationTag;
                }
            }

            if (transEntryFieldInfo.Reservation.ColumnIndex > -1) {
                transEntryGrid.setCellText(objCustomData.iRow, objCustomData.iColumn, "", "");
            }

            arrRows = EntryMainBins.splitRowForBins(objCustomData.iRow, objCustomData.iColumn, arrBin, false);

            if (objCustomData.bFromAutoAllocate != true) {
                for (iCounter = 0; iCounter < arrRows.length; iCounter++) {
                    transEntryGrid.gotoCell(arrRows[iCounter], objCustomData.iColumn);
                    //transEntryGrid.moveToNextCell();
                    transEntryGrid.update();
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.processBinsData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    // Returns true if bins mandatory for row
    isBinsRequiredForRow: function (iRow) {
        let result = null;

        result = COMMON.prototype.getEmptyResultObject();
        result.lValue = 0;
        result.sValue = "";
        result.data = false;

        if (transEntryFieldInfo.Bins.ColumnIndex < 0
            && transEntryFieldInfo.Bins2.ColumnIndex < 0) {

            result.lValue = 0;
            result.sValue = "Bins column not found";
            result.data = false;

            return (result);
        }

        if (iRow < 1 || iRow > transEntryGrid.getTotalRows()) {
            result.lValue = 0;
            result.sValue = "Invalid row index";
            result.data = false;

            return (result);
        }

        if (transEntryFields.getInvTag(iRow) > 0) {
            if (DataType.toBoolean(transEntryInvTag.getDataValue(iRow, "bdontmaintainbin")) == true) {
                result.lValue = 1;
                result.sValue = "Selected warehouse does not support bin";
                result.data = false;

                return (result);
            }            
        }

        if (transEntryFieldInfo.Item.FieldId == 0) {
            result.lValue = 0;
            result.sValue = "Item column not found";
            result.data = false;

            return (result);

        }
        if (EntryMainMemoryObject.getProductValue(iRow) < 1) {
            result.lValue = 0;
            result.sValue = "No item selected";
            result.data = false;

            return (result);
        }

        result.lValue = 1;
        if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bDoNotInputBin", eMasterDataType.Boolean) == true) {
            result.sValue = "Selected item does not support bin";
            result.data = false;
        }
        else {
            result.data = true;
        }

        return (result);
    },

    onEnter: function (cellobj, evt, objCustomData, bBins2) {
        let sMessage = "";
        let bBinsRequired = false;
        let objTemp = null;

        try {
            if (transEntryGlobal.debugBins == true) {
                debugger
            }

            if (EntryMainAutoAllocate.m_bAutoAllocateBins == true && bBins2 == false) {
                cellobj.processDefault(evt, false, true);
                return;
            }
            else if (EntryMainAutoAllocate.m_bAutoAllocateBins2 == true && bBins2 == true) {
                cellobj.processDefault(evt, false, true);
                return;
            }

            //if (EntryMainAutoAllocate.m_bAutoAllocateBins == true || EntryMainAutoAllocate.m_bAutoAllocateBins2 == true) {
            //    cellobj.processDefault(evt, false, true);
            //}

            bBinsRequired = transEntryBins.isBinsRequired(cellobj.iRow, bBins2);
            if (bBinsRequired == true) {
                if (DataType.isBlankOrZero(transEntryFields.getQty(cellobj.iRow)) == true) {
                    if (bBins2 == true) {
                        sMessage = "Quantity must be non zero to select bins2.";
                    }
                    else {
                        sMessage = "Quantity must be non zero to select bins.";
                    }

                    transEntryGlobal.showAlert(sMessage);
                    bBinsRequired = false;
                }
            }

            if (bBinsRequired == true) {
                if (transEntryFieldInfo.IssueInvTag.FieldId > 0) {
                    if (bBins2 == true) {
                        if (EntryMainUI.getValue(transEntryFieldInfo.ReceiptInvTag, cellobj.iRow) == 0) {
                            transEntryGlobal.showAlert("Receipt inventory tag value must be selected for bins2 selection.");
                            cellobj.processDefault(evt, false, true);
                            return;
                        }
                    }
                    else {
                        if (EntryMainUI.getValue(transEntryFieldInfo.IssueInvTag, cellobj.iRow) == 0) {
                            transEntryGlobal.showAlert("Issue inventory tag value must be selected for bins selection.");
                            cellobj.processDefault(evt, false, true);
                            return;
                        }
                    }
                }
                else {
                    if (transEntryFields.getInvTag(cellobj.iRow) == 0) {
                        transEntryGlobal.showAlert("Inventory tag(" + transEntryInfo.InvTagName + ") must be selected for bins selection.");
                        cellobj.processDefault(evt, false, true);
                        return;
                    }
                }

                if (transEntryInfo.BinsPref.iShowBinsInDropDown > 0) {
                    OPTIONCONTROL_INTERNAL.setGUID(cellobj.ColumnAttribute.ctrlid, "");

                    if (bBins2 == true) {
                        objTemp = transEntryFields.getBins2(cellobj.iRow);
                    }
                    else {
                        objTemp = transEntryFields.getBins(cellobj.iRow);
                    }

                    if (DataType.arrayLength(objTemp) > 0) {
                        cellobj.setControl(cellobj.ColumnAttribute.ctrlid, objTemp[0].BinId);
                    }
                    else {
                        cellobj.setControl(cellobj.ColumnAttribute.ctrlid, 0);
                    }
                }
                else {
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, cellobj.getCellText());
                    EntryMainBins.processControlFocus(document.getElementById(cellobj.ColumnAttribute.ctrlid), 
                                                        evt, 
                                                        objCustomData);
                }
            }
            else {
                cellobj.processDefault(evt, false, true);
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainBins.onEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave: function (cellobj, objMetaData, objLeaveData, objLastValue, bBins2) {
