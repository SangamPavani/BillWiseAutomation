    calculateAndUpdateFormula: function (objRuleFormatting, iRow, bResultIsFooter, objControlMetaData, objControl) {
        let value = null;
        let bRefreshNet = false;
        let arrTemp = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;

        try {
            if (DataType.isValidObject(objControlMetaData) == false) { // Rule is in Body
                arrTemp = DataType.arrayFilterData(transEntryGlobal.EntryModel.MetaData.Body,
                                                    "iFieldId",
                                                    objRuleFormatting.FieldId,
                                                    "==");
                if (arrTemp.length == 0) {
                    return (false);
                }

                objControlMetaData = arrTemp[0];
                if (objControlMetaData.iDataTypeId == eMasterDataType.Fraction) {
                    if (DataType.isNullOrEmpty(objRuleFormatting.Value) == false) {
                        value = EntryMainFormula.evaluateFormulaValue(objRuleFormatting.Value, iRow, -1);
                        transEntryGrid.setRowValueBasedOnDataType(iRow,
                                                                    value.data.toString(),
                                                                    {
                                                                        MetaData: objControlMetaData,
                                                                        Data: null,
                                                                        bFromBatch: false
                                                                    });
                    }
                }
                else if (objControlMetaData.iDataTypeId == eMasterDataType.Master
                    || objControlMetaData.iDataTypeId == eMasterDataType.ExternalTable
                    || objControlMetaData.iBehaviour == 2) {

                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(objRuleFormatting.Value, iRow, 0, -1);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);

                    value = DataType.toInt(objFormulaOutput.Value);
                    transEntryGrid.setRowValueBasedOnDataType(iRow,
                                                                value,
                                                                {
                                                                    MetaData: objControlMetaData,
                                                                    Data: null,
                                                                    bFromBatch: false
                                                                });
                }
                else if (objControlMetaData.iDataTypeId == eMasterDataType.Text) {
                    value = EntryMainFormula.evaluateFormulaValue(objRuleFormatting.Value, iRow, transEntryGrid.getGridColumnIndexFromFieldId(objRuleFormatting.FieldId));
                    if (value.lValue > 0) {
                        value = value.data;
                    }
                    else {
                        value = "";
                    }
                    transEntryGrid.setRowValueBasedOnDataType(iRow,
                                                                value,
                                                                {
                                                                    MetaData: objControlMetaData,
                                                                    Data: null,
                                                                    bFromBatch: false
                                                                });
                }

                return (false);
            }

            if (objControlMetaData.iDataTypeId == eMasterDataType.Fraction) {
                if (bResultIsFooter == true) {
                    bRefreshNet = true;
                }

                if (DataType.isNullOrEmpty(objRuleFormatting.Value) == false) {
                    value = EntryMainFormula.evaluateFormulaValue(objRuleFormatting.Value, -1, -1);
                    EntryMainUI.setControlValueBasedOnDataType(objControl, value.data.toString(), objControlMetaData.iDataTypeId, objControlMetaData.iBehaviour);
                }
            }
            else if (objControlMetaData.iDataTypeId == eMasterDataType.Master
                || objControlMetaData.iDataTypeId == eMasterDataType.ExternalTable
                || objControlMetaData.iBehaviour == 2) {

                value = EntryMainFormula.evaluateFormulaValue(objRuleFormatting.Value, -1, -1);

                EntryMainUI.setControlValueBasedOnDataType(objControl,
                                                                    value.data.toString(),
                                                                    eMasterDataType.Master,
                                                                    objControlMetaData.iBehaviour);
            }
            else {
                value = EntryMainFormula.evaluateFormulaValue(objRuleFormatting.Value, -1, -1);

                EntryMainUI.setControlValueBasedOnDataType(objControl, value.data.toString(), objControlMetaData.iDataTypeId, objControlMetaData.iBehaviour);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.calculateAndUpdateFormula} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bRefreshNet);
    },

    filterFieldRules: function (arrRules, iFieldId, objMatched) {
        let iCounter = 0;
        let iTotal = 0;
        let lstFilteredRules = null;
        let lstMatchedData = [];

        try {
            lstFilteredRules = [];

            if (DataType.isValidObject(objMatched) == false) {
