    onInput_KillFocus: function (eleFooter) {
        let sOldValue = "";
        let iCounter = 0;
        let iIndex = 0;
        let bValueChanged = null;
        let arrFooterFields = undefined;
        let objMetaData = undefined;
        let validate = null;

        try {
            if (transEntryGlobal.debugFooterOutput == true) {
                debugger
            }

            if (EntryMain.isDataLoading() == false) {
                bValueChanged = false;
                sOldValue = EntryMainUI.getOldValue(eleFooter);
                if (DataType.toDecimal(sOldValue) != DataType.toDecimal(eleFooter.value)) {
                    EntryMain.setDirty();
                    bValueChanged = true;
                }
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter++) {
                if (transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId == eleFooter.id) {
                    iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                    objMetaData = arrFooterFields[iIndex];
                }
            }

            if(DataType.isValidObject(objMetaData) == true) {
                if(bValueChanged == true) {                
                    if (objMetaData.bMandatory == false || DataType.toString(eleFooter.value) != "") {
                        validate = EntryMainValidate.checkMinMaxRange(DataType.toDecimal(eleFooter.value), DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                        if(validate.bInvalid == true) {
                            transEntryFooter.setInputValue(eleFooter, validate.dValue, objMetaData);
                        }

                        transEntryFooter.setInputValue(eleFooter, eleFooter.value, objMetaData);
                    }

                    if (EntryMainCommon.checkRegularExpression(objMetaData, transEntryControl.getControlValue(eleFooter, objMetaData)) == false) {
                        transEntryControl.clearControlValue(eleFooter, objMetaData);
                    }

                    EntryMainCommon.checkEntryValidation(objMetaData, 0);

                    EntryMainFooter.checkRule(transEntryControl.getControlValue(eleFooter, objMetaData), objMetaData, true);
                }
                else if(DataType.isNullOrEmpty(objMetaData.sPreload, true) == false && DataType.stringStartsWith(objMetaData.sPreload, "&") == true) {
                    EntryMainFooter.checkRule(transEntryControl.getControlValue(eleFooter, objMetaData), objMetaData, true);
                }
            }

            if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                && DataType.isValidObject(objMetaData) == true
                && DataType.arrayLength(objMetaData.ArrExternalModules) > 0) {
                transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnLeave, objMetaData.iFieldId, objMetaData.sFieldName, -1);
            }

            if(bValueChanged == true) {
                EntryMainUI.setSummaryInfo(0);
            }            
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFooter.onInput_KillFocus} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
