    setNewDocGridData: function (arrFieldMap) {
        let sGridId = "";
        let iCounter = 0;
        let iIndex = 0;
        let iMax = 0;
        let iTotal = 0;
        let iRow = 0;
        let iDataType = 0;
        let iMasterType = 0;
        let arrMasterData = null;
        let arrMasterIds = null;
        let ele = null;
        let eleMapDropDown = null;
        let cell = null;
        let obj = null;

        try {
            sGridId = DocCustomization.Triggers.getNewDocGridId();
            eleMapDropDown = DocCustomization.Triggers.getMapDropDownElement();

            FGRIDCONTROL.clearData(sGridId, true);

            iMax = Math.max(20, FCommon.Array.getLength(arrFieldMap));

            iTotal = FGRIDCONTROL.getTotalRows(sGridId);

            if (iMax > iTotal) {
                FGRIDCONTROL.insertRows(sGridId, 0, (iMax - iTotal));
            }

            arrMasterData = [];

            iTotal = FCommon.Array.getLength(arrFieldMap);
            for (iRow = 1; iRow <= iTotal; iRow++) {
                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 1);
                if (FCommon.UI.isValidObject(cell) == false) {
                    continue;
                }

                if (arrFieldMap[iRow - 1].MapType == 1) {
                    ele = document.getElementById("triggers_docTableFieldDropDown");
                    ele.value = arrFieldMap[iRow - 1].iCurrDocFieldId;
                    if (ele.selectedIndex >= 0) {
                        cell.setCellText(ele.options[ele.selectedIndex].text, arrFieldMap[iRow - 1].iCurrDocFieldId);

                        eleMapDropDown.value = arrFieldMap[iRow - 1].iNewDocFieldId;
                        if (eleMapDropDown.selectedIndex >= 0) {
                            cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 2); // Map Field
                            cell.setCellText(eleMapDropDown.options[eleMapDropDown.selectedIndex].text, arrFieldMap[iRow - 1].iNewDocFieldId);
                            cell.setCellData("type", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-type"));
                            cell.setCellData("mastertype", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-mastertype"));
                        }
                    }
                }
                else if (arrFieldMap[iRow - 1].MapType == 2) { // Formula
                    eleMapDropDown.value = arrFieldMap[iRow - 1].iNewDocFieldId;
                    if (eleMapDropDown.selectedIndex >= 0) {
                        cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 2); // Map Field
                        cell.setCellText(eleMapDropDown.options[eleMapDropDown.selectedIndex].text, arrFieldMap[iRow - 1].iNewDocFieldId);
                        cell.setCellData("type", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-type"));
                        cell.setCellData("mastertype", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-mastertype"));


                        cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 3); // Formula
                        cell.setCellText(arrFieldMap[iRow - 1].sValue);
                    }
                }
                else if (arrFieldMap[iRow - 1].MapType == 3) { // Value
                    eleMapDropDown.value = arrFieldMap[iRow - 1].iNewDocFieldId;
                    if (eleMapDropDown.selectedIndex >= 0) {
                        cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 2); // Map Field
                        cell.setCellText(eleMapDropDown.options[eleMapDropDown.selectedIndex].text, arrFieldMap[iRow - 1].iNewDocFieldId);
                        cell.setCellData("type", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-type"));
                        cell.setCellData("mastertype", eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-mastertype"));

                        iDataType = FConvert.toInt(eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-type"));
                        iMasterType = FConvert.toInt(eleMapDropDown.options[eleMapDropDown.selectedIndex].getAttribute("data-mastertype"));
                        switch (iDataType) {
                            case eMasterDataType.Master:
                                for (iCounter == 0; iCounter < arrMasterData.length; iCounter++) {
                                    if (arrMasterData[iCounter].iMasterType == iMasterType) {
                                        break;
                                    }
                                }

                                if (iCounter < arrMasterData.length) {
                                    obj = arrMasterData[iCounter];

                                    obj.arrData.push({ Row: iRow, Value: FConvert.toInt(arrFieldMap[iRow - 1].sValue) });
                                    arrMasterData[iCounter] = obj;
                                }
                                else {
                                    obj = {};
                                    obj.iMasterType = iMasterType;
                                    obj.arrData = [];
                                    obj.arrData.push({ Row: iRow, Value: FConvert.toInt(arrFieldMap[iRow - 1].sValue) });
                                    arrMasterData.push(obj);
                                }
                                break;
                            case eMasterDataType.Date:
                                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 4); // Value
                                cell.setCellText(DATEPICKER.convertDateIntoString(DocCustomization.Triggers.getNewDocTableDateCtrl(), FConvert.toInt(arrFieldMap[iRow - 1].sValue)), FConvert.toInt(arrFieldMap[iRow - 1].sValue));
                                break;
                            default:
                                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 4); // Value
                                cell.setCellText(arrFieldMap[iRow - 1].sValue, arrFieldMap[iRow - 1].sValue);
                                break;
                        }
                    }
                }
            }

            for (iCounter = 0; iCounter < arrMasterData.length; iCounter++) {
                obj = arrMasterData[iCounter];

                arrMasterIds = [];
                for (iIndex = 0; iIndex < obj.arrData.length; iIndex++) {
                    arrMasterIds.push(obj.arrData[iIndex].Value);
                }

                if (arrMasterIds.length > 0) {
                    OPTIONCONTROL.setMasterTypeId(DocCustomization.Triggers.getNewDocTableOptionCtrl(), obj.iMasterType);
                    OPTIONCONTROL.setControlValue(DocCustomization.Triggers.getNewDocTableOptionCtrl(),
                                                    arrMasterIds,
                                                    obj.arrData,
                                                    true);
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Triggers.setNewDocGridData} " + err.message, "Exception");
        }
    },
