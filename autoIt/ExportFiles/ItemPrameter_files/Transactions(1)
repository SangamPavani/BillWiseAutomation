                    result.sValue = GlobalPref.getResourceValue("msgProvideMandatoryData") + " " + EntryMainUI.getBodyColumnHeading(iRowCounter, eVTFIELDID.FDF_EXPDATE);
                    result.iRowNo = iRowCounter;

                    return (result);
                }
