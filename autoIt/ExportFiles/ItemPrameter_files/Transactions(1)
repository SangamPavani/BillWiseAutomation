    editLayout_FieldsCustomization_IncCondGridcellChange: function (cellobj, event) {
        var element = null;
        var cell = null;


        if (cellobj.bLeave == true) {
            switch (cellobj.iColumn) {
                case 1:
                    element = document.getElementById("editLayout_FieldsCustomization_IncCondTypeDropDown");
                    if (COMMON.prototype.isValidObject(element) == true) {

                        if (element.selectedIndex == -1) {
                            return (false);
                        }
                        if (cellobj.getCellData() != parseInt(element.value)) {
                            cell = FGRIDCONTROL.getCellObject("editLayout_FieldsCustomization_IncCondTable", cellobj.iRow, cellobj.iColumn + 1);
                            cell.clear();
                        }
                        if (element.selectedOptions[0] != undefined) {
                            cellobj.setCellText(element.selectedOptions[0].text, element.selectedOptions[0].value);
                        }
                        else {
                            cellobj.setCellText("", "");
                        }
                    }
                    break;
                case 2:
                    element = document.getElementById("editLayout_FieldsCustomization_IncCondFieldTxtbox");
                    if (COMMON.prototype.isValidObject(element) == true) {
                        if (element.nodeName.toLowerCase() == "select")
                            cellobj.setCellText(element.selectedOptions[0].text, element.selectedOptions[0].value)
                        else
                            cellobj.setCellText(element.value, element.value);
                    }
                    break;
                case 3:
                    element = document.getElementById("editLayout_FieldsCustomization_IncCondStartingTxtbox");
                    if (COMMON.prototype.isValidObject(element) == true) {
                        cellobj.setCellText(element.value, element.value);
                    }
                    break;
                case 4:
                    element = document.getElementById("editLayout_FieldsCustomization_IncCondNoofCharTxtbox");
                    if (COMMON.prototype.isValidObject(element) == true) {
                        //if (COMMON.prototype.isNullOrEmpty(element.value) == true) {
                        //    return (false);
                        //}
                        cellobj.setCellText(element.value, element.value);
                        //cellobj.dataset.value = element.selectedOptions[0].value;
                    }
                    break;
            }

            return (true);
        }
        switch (cellobj.iColumn) {
            case 1:
                element = document.getElementById("editLayout_FieldsCustomization_IncCondTypeDropDown");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                    //element.value = cellobj.dataset.value;
                    element.value = cellobj.getCellData("value");
                }
                else {
                    cellobj.processDefault(event);
                }
                break;
            case 2:
                cell = FGRIDCONTROL.getCellObject("editLayout_FieldsCustomization_IncCondTable", cellobj.iRow, cellobj.iColumn - 1);

                element = CONFIGURETRANS.ElementBasedOnGriValue(parseInt(cell.getCellData()), "editLayout_FieldsCustomization_IncCondFieldTxtbox")
                cellobj.setControl(element, cellobj.getCellData());
                //if (element.nodeName.toLowerCase() == "select") {
                //    cellobj.setControl(element, FConvert.toInt(cellobj.getCellData()));
                //}
                //else {
                //    cellobj.setControl(element, cellobj.getCellData());
                //}
                break;
            case 3:
                element = document.getElementById("editLayout_FieldsCustomization_IncCondStartingTxtbox");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                    //element.value = cellobj.dataset.value;
                    element.value = cellobj.getCellData("value");
                }
                else {
                    cellobj.processDefault(event);
                }
                break;
            case 4:
                element = document.getElementById("editLayout_FieldsCustomization_IncCondNoofCharTxtbox");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                }
                else {
                    cellobj.processDefault(event);
                }
                break;
            default:
                cellobj.processDefault(event);
                break;
        }
