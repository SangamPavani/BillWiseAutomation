                    if (iCode == iValue) {
                        OPTIONCONTROL.clear(tag.Control);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BOOKNO, 0, 0);

                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));

                        return;
                    }
                }
                else if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    iTotalRows = transEntryGrid.getTotalRows();
                    for (iCounter = 1; iCounter <= iTotalRows; iCounter++) {
                        iCode = EntryMainMemoryObject.getCodeValue(iCounter);
                        if (iCode == iValue) {
                            OPTIONCONTROL.clear(tag.Control);
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BOOKNO, 0, 0);

                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));

                            return;
                        }
                    }
                }

                objBookData = OPTIONCONTROL.getControlDataObject(tag.Control);
                iAccountTypeId = OPTIONCONTROL.getControlValue(tag.Control, "iAccountTypeId");
                iAccountTypeId = DataType.toInt(iAccountTypeId);
                EntryMainMemoryObject.updateBookAccountType(iAccountTypeId, 0);
                EntryMainMemoryObject.updateExtraInfo(transEntryFieldInfo.Book.FieldId, objBookData, 0);

                if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header) {
                    bFlag = false;
                    if (transEntryFieldInfo.SubLedger.Area != eTranEntryFieldArea.None) { // Sub ledger enabled
                        if (iAccountTypeId == eAccountTypes.Bank || iAccountTypeId == eAccountTypes.Cash) {
                            bFlag = true;
                        }
                    }
                    else {
                        if (iAccountTypeId == eAccountTypes.Bank || EntryMainCommon.isPartyType(iAccountTypeId) == true || iAccountTypeId == eAccountTypes.Cash) {
                            bFlag = true;
                        }
                    }

                    if (bFlag == true) {
                        //if (EntryMain.isLinkLoading() == false)
                        {
                            iDefaultBankCurrency = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iDefaultCurrency"));
                            if (iDefaultBankCurrency > 0) {
                                transEntryFields.setCurrency(iDefaultBankCurrency);
                            }

                            sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);

                            if (EntryMainUI.isCurrencyChangeRequired(0, iDefaultBankCurrency, iAccountTypeId) == false) {
                                OPTIONCONTROL.disableControl(sId, true);
                            }
                            else if ((iAccountTypeId == eAccountTypes.Bank || iAccountTypeId == eAccountTypes.Cash) && iDefaultBankCurrency > 0) {
                                OPTIONCONTROL.disableControl(sId, true);
                            }
                            else {
                                OPTIONCONTROL.disableControl(sId, transEntryFieldInfo.Currency.MetaData.bReadOnly);
