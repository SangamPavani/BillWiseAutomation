    processSelectedData: function (bUpdate, arrReservations, objCustomData, dTotalQty) {
        let sResult = "";

        try {
            transEntryGrid.moveToNextCell();

            if (bUpdate == true) {
                if (DataType.arrayLength(arrReservations) > 0) {
                    if (DataType.toDecimal(dTotalQty) != EntryMainMemoryObject.getBaseQuantityValue(objCustomData.iRow)
                        && transEntryInfo.InventoryPref.bDonotAllowPartialReservations == true) {
                        transEntryQuantity.setValue(dTotalQty, objCustomData.iRow, { bValueInBase: true });
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYQUANTITY, dTotalQty, objCustomData.iRow);

                        if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) {
                            transEntryBatch.updateQuantity(objCustomData.iRow, dTotalQty);
                        }

                        if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                            transEntryBins.updateQuantity(objCustomData.iRow, dTotalQty, false);
                        }

                        if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                            transEntryBins.updateQuantity(objCustomData.iRow, dTotalQty, true);
                        }
                    }


                    if (arrReservations[0].ReserveType == eReserveType.Quantity) {
                        sResult = DataType.toString(arrReservations[0]);
                        transEntryReservation.setText(objCustomData.iRow, "Reserved", sResult);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_RESERVEQUANTITY, sResult, objCustomData.iRow);
                    }
