    getServiceProductData: function () {
        let iRow = 0;
        let iTotal = 0;
        let iIndex = 0;
        let iProductId = 0;
        let iSkidId = 0;
        let arrRawData = [];
        let arrBinsData = null;
        let arrData = null;
        let obj = null;

        try {
            arrRawData = [];

            iTotal = transEntryGrid.getTotalRows();

            for (iRow = 1; iRow <= iTotal; iRow++) {
                iProductId = EntryMainMemoryObject.getProductValue(iRow);
                if (iProductId <= 0) {
                    continue;
                }

                iSkidId = 0;
                iIndex = DataType.arrayContains(arrRawData, iProductId, "ProductId", false);
                if (iIndex == -1) {
                    obj = {};
                    obj.ProductId = iProductId;
                    obj.Qty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                    obj.arrSkid = [];

                    if (transEntryFieldInfo.Skid.ColumnIndex > -1) {
                        iSkidId = transEntryFields.getSkid(iRow);
                    }
                    else if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                        arrBinsData = transEntryFields.getBins(iRow);
                        if (DataType.arrayLength(arrBinsData) > 0) {
                            iSkidId = arrBinsData[0].SkidId;
                        }
                    }

                    if (iSkidId > 0) {
                        obj.arrSkid.push(iSkidId);
                    }


                    arrRawData.push(obj);
                }
                else {
                    obj = arrRawData[iIndex];

                    obj.Qty = FNumberOperation.add(obj.Qty, EntryMainMemoryObject.getBaseQuantityValue(iRow));


                    if (transEntryFieldInfo.Skid.ColumnIndex > -1) {
                        iSkidId = transEntryFields.getSkid(iRow);
                    }
                    else if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                        arrBinsData = transEntryFields.getBins(iRow);
                        if (DataType.arrayLength(arrBinsData) > 0) {
                            iSkidId = arrBinsData[0].SkidId;
                        }
                    }

                    if (iSkidId > 0 && DataType.arrayContains(obj.arrSkid, iSkidId) == -1) {
                        obj.arrSkid.push(iSkidId);
                    }

                    arrRawData[iIndex] = obj;
                }
            }

            arrData = [];
            for (iRow = 0; iRow < arrRawData.length; iRow++) {
                obj = arrRawData[iRow];

                arrData.push({ ProductId: obj.ProductId, ProductCode: "", PalletQty: obj.arrSkid.length, Qty: obj.Qty });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.getServiceProductData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

    getRowInfo: function(iRow) {
        let iCounter = 0;
        let iBodyId = 0;
        let lTransactionId = 0;
        let arrData = null;
        let obj = null;
        let result = null;

        try {
            arrData = [];

            obj = {};
            obj.Key = "VoucherType";
            obj.Value = transEntryInfo.VoucherType;
            arrData.push(obj);

            if (transEntryInfo.HeaderId > 0) {
                obj = {};
                obj.Key = "HeaderID";
                obj.Value = transEntryInfo.HeaderId;
                arrData.push(obj);
            }

            result = transEntryFields.getAuthStatus(iRow, true)
            if (DataType.isNullOrEmpty(result) == false) {
                obj = {};
                obj.Key = "AuthStatus";
                obj.Value = result;
                arrData.push(obj);
            }

            iBodyId = transEntryFields.getBodyId(iRow);
            if(iBodyId > 0) {
                obj = {};
                obj.Key = "BodyID";
                obj.Value = iBodyId;
                arrData.push(obj);
            }

            lTransactionId = transEntryFields.getTransactionId(iRow);
            if(DataType.gt(lTransactionId, 0) == true) {
                obj = {};
                obj.Key = "TransactionID";
                obj.Value = lTransactionId;
                arrData.push(obj);

                result = transEntryServer.execute(eTransServerRequest.GetLineinfo, { lTransactionId: lTransactionId });
