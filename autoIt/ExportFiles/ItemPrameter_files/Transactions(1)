    isRequiredColumnEditable: function () {
        let iCounter = 0;
        let bEditable = false;
        let bItemVisible = false;
        let bCodeVisible = false;
        let bNextCheck = false;
        let arrFields = undefined;
        let objMetaData = undefined;

        try {
            bEditable = false;
            bNextCheck = false;
            if (transEntryInfo.isItSales == true) {
                bItemVisible = false;

                if (transEntryFieldInfo.Item.FieldId > 0) {
                    objMetaData = transEntryFieldInfo.Item.MetaData;
                    if (objMetaData.bHidden == false) {
                        bItemVisible = true;
                        if (objMetaData.bReadOnly == false) {
                            bEditable = true;
                        }
                    }
                }

                if (bEditable == false && bItemVisible == false) {
                    bNextCheck = true;
                }
            }
            else {
                bCodeVisible = false;

                if (transEntryFieldInfo.Code.ColumnIndex > -1) {
                    objMetaData = transEntryFieldInfo.Code.MetaData;
                    if (objMetaData.bHidden == false) { // Code is visible
                        bCodeVisible = true;
                        if (objMetaData.bReadOnly == false) {
                            bEditable = true;
                        }
                    }
                }

                if (bEditable == false && transEntryFieldInfo.Book.ColumnIndex > -1) {
                    objMetaData = transEntryFieldInfo.Book.MetaData;
                    if (objMetaData.bHidden == true) { // Book is not visible
                        if (bCodeVisible == true) { // Code is visible
                            return (false);
                        }
                    }
                    else if (objMetaData.bReadOnly == true) { // Book is visible but not editable
                        return (false);
                    }
                    else {
                        bEditable = true;
                    }
                }

                if (bEditable == false && bCodeVisible == false) {
                    bNextCheck = true;
                }
            }

            if (bNextCheck == true) {
                arrFields = transEntryFieldInfo.getBodyFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;
                    if (objMetaData.bHidden == true || objMetaData.bReadOnly == true) {
                        continue;
                    }

                    if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                        continue;
                    }

                    if (objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                        continue;
                    }

                    bEditable = true;
                    break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body isRequiredColumnEditable method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.isRequiredColumnEditable} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bEditable);
    },

