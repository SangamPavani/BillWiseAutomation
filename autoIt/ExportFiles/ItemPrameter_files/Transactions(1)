    onFocus_Masters: function (obj) {
        let sCtrlId = "";
        let iFieldId = 0;
        let iInvTagValue = 0;
        let iTagValue = 0;
        let iValue = 0;
        let iRow = 0;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objMetaData = undefined;
        let objFieldInfo = undefined;
        let objExtra = undefined;
        let result = undefined;

        try {
            if (transEntryGlobal.debugHeader == true) {
                debugger
            }

            iFieldId = EntryMainUI.extractHeaderFieldId(obj.Control.id);
            objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId, eTranEntryFieldArea.Header);
            if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                objMetaData = objFieldInfo.MetaData;

                if (objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH
                    && transEntryFields.getArea(eTransEntryField.InvTag) == eTranEntryFieldArea.Header) {

                    iInvTagValue = transEntryInvTag.getValue(0);

                    EntryMainProductionProcess.onFocus_ProdBatch(obj.Control, iInvTagValue);
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH) {                    
                    EntryMainProductionProcess.onFocus_ProdBatchInvINBody(obj.Control, iInvTagValue);
                }
                else if(objMetaData.iFieldId == eVTFIELDID.FDF_PROD_PROCESS) {
                    EntryMainProductionProcess.onProdProcessFocus(obj.Control);
                }

                result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);
                if (result != null && result.lValue > 0) {
                    if ((objMetaData.iDataTypeId == eMasterDataType.Master || objMetaData.iDataTypeId == eMasterDataType.ExternalTable)
                        && (result.bRefresh == true || DataType.toInt(OPTIONCONTROL.getControlValue(obj.Control)) <= 0)) {

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(result.data, -1, null, -1);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        result = DataType.toInt(objFormulaOutput.Value);
                        OPTIONCONTROL.setValue(obj.Control, result);
                    }
                }

                if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0 && DataType.isValidObject(transEntryInfo.Settings.Documents.VoucherMasters) == true) {
                    arr = DataType.arrayFilterData(transEntryInfo.Settings.Documents.VoucherMasters, "MasterType", objMetaData.iMasterTypeId, "===");
                    if (arr.length > 0 && arr[0].DependentMaster > 0) {
                        iRow = 0;
                        iRow = transEntryGrid.getCurrentRow();
                        if (iRow < 1 || iRow > transEntryGrid.getTotalRows()) {
                            iRow = 1;
                        }

                        sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                        iTagValue = transEntryGrid.getMasterValue(iRow, arr[0].DependentMaster);
                        if (iTagValue > 0) {
                            iValue = OPTIONCONTROL.getControlValue(sCtrlId);
                            OPTIONCONTROL.setExtraFilter(sCtrlId, arr[0].FieldName + "=" + iTagValue);
                            if (DataType.gt(iValue, 0) == true) {
                                OPTIONCONTROL.clear(sCtrlId);
                                objExtra = OPTIONCONTROL.createSetValueExtraObject();
                                objExtra.bIgnoreChangeCallback = true;
                                OPTIONCONTROL.setValue(sCtrlId, iValue, null, objExtra);
                            }
                        }
                        else {
                            OPTIONCONTROL.setExtraFilter(sCtrlId, "");
                        }
                    }
                }

                EntryMainMaster.updateOptionFilter(objMetaData);

                EntryMainMaster.applyAccountOrItemFilter(iFieldId, 0);
            }

            if (result != null && result.lValue > 0) {
            }

            EntryMainHeader.applyRuleOnFocus(iFieldId);

            if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                && DataType.isValidObject(objMetaData) == true
                && DataType.arrayLength(objMetaData.ArrExternalModules) > 0) {

                transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnEnter, objMetaData.iFieldId, objMetaData.sFieldName, 0);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onFocus_Masters} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave_Masters: function (id, data, tag) {
        let iFieldId = 0;
        let objMetaData = null;
        let objFieldInfo = null;
        let objTemp = null;

        try {
            if (transEntryGlobal.debugHeader == true) {
                debugger
            }

            EntryMain.m_DocDate = EntryMain.m_objTrans.Header.Date;

            iFieldId = EntryMainUI.extractHeaderFieldId(id.id);
            if (iFieldId == eVTFIELDID.FDF_BOOKNO && tag.OldValue != tag.Value) {
                EntryMainHeader.setDefaultChequeNo();
            }
            else if (iFieldId == transEntryFieldInfo.FATag.FieldId && tag.OldValue != tag.Value) {
                EntryMainHeader.setDefaultChequeNo();
            }

            if (transEntryInfo.isItTransfer == true) {
                switch (iFieldId) {
                    case eVTFIELDID.FDF_HEADERINVTAG:
                        break;
                    case eVTFIELDID.FDF_BODYINVTAG:
                        objTemp = EntryMainValidate.isValidStockTransferInvTag(iFieldId, tag.Value, 0);
                        if (objTemp.lValue < 1) {
                            transEntryGlobal.showAlert(objTemp.sValue, GlobalPref.getResourceValue("Error"));
                            OPTIONCONTROL.clear(id.id);
                            EntryMainMemoryObject.update(iFieldId, 0, 0);
                        }
                        break;
                }
            }

            objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId, eTranEntryFieldArea.Header);
            if (objFieldInfo.FieldId <= 0) {
                return;
            }
            objMetaData = objFieldInfo.MetaData;

            EntryMainCommon.checkEntryValidation(objMetaData);

            EntryMainHeader.updateViewInfoFields(objMetaData.iFieldId, tag.Control);

            if(objMetaData.iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                EntryMainMaster.onCurrency_Leave(id, objMetaData.iFieldId);
            }

            EntryMainHeader.applyRuleOnLostFocus(iFieldId);
            //setTimeout(function(opt, iFieldId) {
            //            EntryMainHeader.applyRuleOnLostFocus(iFieldId);
            //}, 100, 0, iFieldId);

            if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                && DataType.isValidObject(objMetaData) == true
                && DataType.arrayLength(objMetaData.ArrExternalModules) > 0) {
                transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnLeave, objMetaData.iFieldId, objMetaData.sFieldName, 0);
            }

            if (transEntryInfo.BodySectionNotRequired == false) {
                EntryMainHeader.processIfLastField(tag.Control, tag.Event);
            }

            EntryMainInfoSidebar.loadDashboard(0, false, { iMasterTypeId: objMetaData.iMasterTypeId, FieldId: objMetaData.iFieldId });

            if (EntryMain.isDataLoading() == false && objMetaData.bReadOnly == false) {
                EntryMainHeader.recalculateHeaderReadonlyMasterFormulaValues();
            }

            EntryMainMemoryObject.update(objMetaData.iFieldId, tag.Value, 0, objMetaData);

            objTemp = undefined;
            if (DataType.toInt(OPTIONCONTROL.getControlValue(id)) > 0) {
                objTemp =  OPTIONCONTROL.getControlDataObject(id);
            }
            EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objTemp, 0);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onLeave_Masters} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

