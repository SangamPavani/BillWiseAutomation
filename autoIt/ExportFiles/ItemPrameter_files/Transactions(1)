    processRMASelectedData: function (iRow, arrRMA, bFromPopup, iColumn) {
        let iCounter = 0;
        let sResult = "";
        let dOldQty = 0;
        let dLinkMinQty = undefined;
        let objFlags = null;
        let cell = null;
        let validate = undefined;

        try {
            bFromPopup = DataType.toBoolean(bFromPopup);

            if (DataType.isValidObject(arrRMA) == true) {
                validate = EntryMainUI.getLinkMinQuantity(iRow, eTranEntryLinkValue.Quantity);
                if (validate.lValue > 0) {
                    dLinkMinQty = validate.data.Value;
                }

                if (bFromPopup == true) {
                    if((typeof arrRMA[0]).toLowerCase() == "object") {
                        for(iCounter = 0; iCounter < arrRMA.length; iCounter++) {
                            if(iCounter > 0) {
                                sResult += GlobalPref.RMASeparator;
                            }

                            sResult += arrRMA[iCounter].sRmaNo;
                        }
                    }
                    else {
                        sResult = DataType.arrayToCSV(arrRMA, GlobalPref.RMASeparator);
                    }

                    if (dLinkMinQty != undefined && DataType.lt(arrRMA.length, dLinkMinQty) == true) {
                        transEntryGlobal.showAlert("Quantity cannot be less than " + dLinkMinQty + " as it is consumed in link voucher.");

                        if (bFromPopup == true && DataType.isValidObject(iColumn) == false) {
                            transEntryGrid.gotoCell(iRow, transEntryFieldInfo.RMA.ColumnIndex);
                        }

                        return;
                    }

                    if (DataType.isValidObject(iColumn) == true) {
                        transEntryFields.setRMA(sResult, iRow, DataType.toString(arrRMA));
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_RMANO, arrRMA, iRow);
                    }
                    else {
                        cell = EntryMainUI.getElement(transEntryFieldInfo.RMA, iRow).Value;
                        FPOPUPCONTROL.setControlText(cell.ColumnAttribute.ctrlid, sResult, arrRMA);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_RMANO, arrRMA, iRow);
                    }
                }
                else {
                    transEntryFields.setRMA(arrRMA, iRow);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_RMANO, arrRMA, iRow);
                }


                if (transEntryGlobal.EntryModel.Preference.RMA.bRMABasedAlternateQuantity == true
                    && transEntryFieldInfo.AltQty.ColumnIndex > -1) {

                    cell = EntryMainUI.getElement(transEntryFieldInfo.AltQty, iRow).Value;
                }
                else {
                    cell = EntryMainUI.getElement(transEntryFieldInfo.Qty, iRow).Value;
                }

                if (DataType.isValidObject(cell) == true) {
                    dOldQty = DataType.toInt(cell.getCellData());
                    cell.setCellText(DataType.toDecimal(arrRMA.length, transEntryQuantity.getDecimals(iRow)), arrRMA.length);
                    if (dOldQty != arrRMA.length) {
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYQUANTITY, arrRMA.length, cell.iRow);

                        EntryMainBatch.changeQuantity(arrRMA.length, dOldQty, iRow);
                        transEntryBins.updateQuantity(iRow, arrRMA.length, false);
                        transEntryBins.updateQuantity(iRow, arrRMA.length, true);

                        if (transEntryInfo.HeaderId > 0) {
                            objFlags = transEntryInfo.HeaderFlags;
                            objFlags.NoLinkCheck = false;
                            objFlags.NoBatchCheck = false;
                            objFlags.NoBinCheck = false;
                            transEntryInfo.HeaderFlags = objFlags;
                        }

                        transEntryGross.calculateAndUpdate({ iRow: iRow });
                        EntryMainUI.setSummaryInfo(iRow);
                    }

                    if (bFromPopup == true && DataType.isValidObject(iColumn) == false) {
                        transEntryGrid.gotoCell(iRow, transEntryFieldInfo.RMA.ColumnIndex);
                    }
                }
            }
            else {
                transEntryGrid.moveToNextCell();
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRMA.processRMASelectedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
};
