                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                dInput = objFormulaOutput.Value;
                sValue = FNumberOperation.toFixed(dInput, objMetaData.iNoDecimal);

                if (transEntryInfo.isFormatInputValueToDecimal == true) {
                    dInput = FNumberOperation.convert(sValue);
                }
                else {
                    if (EntryMain.m_bSupportBigNumber == false) {
                        dInput = transEntry.rectifyScreenOutputValue(dInput);
