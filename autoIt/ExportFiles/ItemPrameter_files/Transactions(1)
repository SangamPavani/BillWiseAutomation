                        }
                        else {
                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                        }

                        EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);

                        if (iRow > 0) {
                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                            EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);
                        }
                        else {
                            for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                                if (EntryMainBody.isRowEditable(iRow) == false) {
                                    break;
                                }

                                transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                                EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);
                            }
                        }

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_MAXQTYRELEASE:
                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);

                        if (iRow > 0) {
                            objControl = EntryMainUI.getElement(objFieldInfo, iRow);
                            if (objControl.Value) {
                                objControl.Value.clear();

                                bFlag = true;
                            }
                        }
                        else {
                            if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                                debugger
                            }

                            transEntryGrid.clearColumn(objFieldInfo.ColumnIndex);
                            bFlag = true;
                        }
                    }
                    break;
                case eVTFIELDID.FDF_LINK:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        if (iRow == undefined || iRow == null || iRow == 0) {
                            iRow = 0;
                            arrData = transEntryGrid.clearColumn(objFieldInfo.ColumnIndex);
                        }
                        else {
                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                        }

                        if (transEntryInfo.HeaderId > 0) {
                            objFlags = transEntryInfo.HeaderFlags;
                            objFlags.NoLinkCheck = false;
                            transEntryInfo.HeaderFlags = objFlags;
                        }

                        if (DataType.isValidObject(EntryMain.m_objTrans) == true
                            && DataType.arrayLength(EntryMain.m_objTrans.BodyData) > 0) {

                            if (iRow == 0) { // ClearAllRows
                                for (iRow = 0; iRow < EntryMain.m_objTrans.BodyData.length; iRow++) {
                                    if (DataType.arrayLength(EntryMain.m_objTrans.BodyData[iRow].Links) > 0) {
                                        iIndex = EntryMain.m_objTrans.BodyData[iRow].Links.length - 1;
                                        while (iIndex >= 0) {
                                            if (EntryMain.m_objTrans.BodyData[iRow].Links[iIndex].LinkId == objFieldInfo.MetaData.Tag.LinkId) {
                                                EntryMain.m_objTrans.BodyData[iRow].Links.splice(iIndex, 1);
                                            }

                                            iIndex--;
                                        }
                                    }
                                }
                            }
                            else if (iRow <= EntryMain.m_objTrans.BodyData.length
                                && DataType.arrayLength(EntryMain.m_objTrans.BodyData[iRow - 1].Links) > 0) {

                                iIndex = EntryMain.m_objTrans.BodyData[iRow - 1].Links.length - 1;
                                while (iIndex >= 0) {
                                    if (EntryMain.m_objTrans.BodyData[iRow - 1].Links[iIndex].LinkId == objFieldInfo.MetaData.Tag.LinkId) {
                                        EntryMain.m_objTrans.BodyData[iRow - 1].Links.splice(iIndex, 1);
                                    }

                                    iIndex--;
                                }
                            }
                        }
                    }

                    return (arrData);
                case eVTFIELDID.FDF_REFERENCE:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                        transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, "");

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_SKID:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId || transEntryGlobal.debugLPN == true) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);

                        bFlag = true;
                    }
                    break;
                default:
                    if (objFieldInfo.FieldId == transEntryFieldInfo.VATLayout.FieldId) {
                        if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                            debugger
                        }

                        if (objFieldInfo.ColumnIndex > -1) {
                            iRow = DataType.toInt(iRow);
                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);

                            bFlag = true;
                        }
                    }
                    else if (objFieldInfo.FieldId == transEntryFieldInfo.SetName.FieldId) {
                        if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                            debugger
                        }

                        if (objFieldInfo.ColumnIndex > -1) {
                            iRow = DataType.toInt(iRow);
                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);

                            bFlag = true;
                        }
                    }
                    else if (objFieldInfo.FieldId == transEntryFieldInfo.LPMaster.FieldId) {
                        if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                            debugger
                        }

                        if (objFieldInfo.ColumnIndex > -1) {
                            iRow = DataType.toInt(iRow);

                            if (iRow > 0) {
                                transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                                EntryMainMemoryObject.update(objFieldInfo.FieldId, 0, iRow);
                            }
                            else {
                                for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                                    if (EntryMainBody.isRowEditable(iRow) == false) {
                                        break;
                                    }

                                    transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                                    EntryMainMemoryObject.update(objFieldInfo.FieldId, 0, iRow);
                                }
                            }

                            bFlag = true;
                        }
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.clear} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bFlag);
    },

    getBodyFieldInfo: function (field, bName, LinkValue, bLinkIndex) {
        let iCounter = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let objLinkDef = undefined;
        let value = undefined;

        try {
            value = {};
            value.Area = eTranEntryFieldArea.None;
            value.MetaDataIndex = -1;
            value.ColumnIndex = -1;
            value.FieldId = 0;
            value.MetaData = undefined;

            if (field == undefined || field == null) {
                return (value);
            }

            if (bName == true) {
                if (DataType.isNullOrEmpty(field, true) == true) {
                    return (value);
                }
            }
            else {
                if (field <= 0) {
                    return (value);
                }
            }

            if (bName != true && field == eVTFIELDID.FDF_LINK
                && LinkValue != undefined && LinkValue != null
                && transEntryGlobal && transEntryGlobal.FieldHelper) {

                for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.Column.Links.length; iCounter++) {
                    iIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter];
                    objLinkDef = transEntryGlobal.EntryModel.MetaData.Body[iIndex].Tag;
                    if (objLinkDef == undefined || objLinkDef == null) {
                        continue;
                    }

                    if (bLinkIndex == true) {
                        if (iCounter != LinkValue) {
                            continue;
                        }
                    }
                    else if (LinkValue <= 2000) { // Column
                        if (transEntryGlobal.FieldHelper.Column.Links[iCounter] != LinkValue) {
                            continue;
                        }
                    }
                    else { // LinkId
                        if (objLinkDef.LinkId != LinkValue) {
                            continue;
                        }
                    }

                    value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter];
                    value.ColumnIndex = transEntryGlobal.FieldHelper.Column.Links[iCounter];
                    value.Area = eTranEntryFieldArea.Body;
                    value.MetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
                    value.FieldId = value.MetaData.iFieldId;
                    break;
                }

                return (value);
            }

            if (bName == true) {
                arrFields = transEntryFieldInfo.getBodyFields({ sFieldName: field, bName: true });
            }
            else {
                arrFields = transEntryFieldInfo.getBodyFields({ iFieldId: field, bName: false });
            }

            if (arrFields.length > 0) {
                value = arrFields[0];
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getBodyFieldInfo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    getFieldInfo: function (iFieldId, LinkValue, bLinkIndex) {
        let value = undefined;

        try {
            value = {};
            value.Area = eTranEntryFieldArea.None;
            value.MetaDataIndex = -1;
            value.ColumnIndex = -1;
            value.FieldId = 0;
            value.MetaData = undefined;

            if (iFieldId <= 0) {
                return (value);
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_TIME:
                    break;
                case eVTFIELDID.FDF_UPDATEFA:
                    break;
                case eVTFIELDID.FDF_LINK:
                    if (LinkValue != undefined && LinkValue != null && transEntryGlobal && transEntryGlobal.FieldHelper) {
                        value = EntryMainUI.getBodyFieldInfo(iFieldId, false, LinkValue, bLinkIndex);
                    }
                    break;
                default:
                    value = transEntryFieldInfo.getFromFieldId(iFieldId);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getFieldInfo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    getColumnFieldInfo: function (iColumn) {
        let arrFields = undefined;
        let value = undefined;

        try {
            value = {};
            value.Area = eTranEntryFieldArea.None;
            value.MetaDataIndex = -1;
            value.ColumnIndex = -1;
            value.FieldId = 0;
            value.MetaData = undefined;

            if (iColumn != undefined && iColumn != null && DataType.isInteger(iColumn) == true) {
                arrFields = transEntryFieldInfo.getBodyFields();

                iColumn -= transEntryGrid.gridExtraColumn();
                if (iColumn >= 0 && iColumn < arrFields.length) {
                    value.Area = eTranEntryFieldArea.Body;
                    value.ColumnIndex = iColumn;
                    value.MetaDataIndex = arrFields[iColumn].MetaDataIndex;
                    value.MetaData = arrFields[iColumn].MetaData;
                    if (value.MetaData) {
                        value.FieldId = value.MetaData.iFieldId;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getColumnFieldInfo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    // Fills loaded data structure array when document is loaded
    initLoadedDataObjectArray: function () {
        let sId = "";
        let iRowCounter = 0;
        let iColCounter = 0;
        let arrColData = null;
        let arrBodyData = null;
        let objLoadedData = null;
        let objFindReult = undefined;
        let objData = null;
        let temp = null;

        try {
            transEntryGlobal.arrLoadedData = [];
            EntryMain.m_arrLoadedLinkData = [];
            transEntryGlobal.arrLoadedReleaseData = [];
            transEntryGlobal.objLoadedFlags = undefined;

            objFindReult = EntryMainCommon.findKeyValue("Flags", transEntryGlobal.EntryModel.Data.Header);
            if (objFindReult.lValue > 0) {
                transEntryGlobal.objLoadedFlags = objFindReult.data.Value;
            }

            arrBodyData = DataType.createDuplicateObject(transEntryGlobal.EntryModel.Data.Body);

            for (iRowCounter = 0; iRowCounter < arrBodyData.length; iRowCounter++) {
                arrColData = arrBodyData[iRowCounter];

                objLoadedData = {};
                objLoadedData.BodyId = 0;
                objLoadedData.TransactionId = 0;
                objLoadedData.Flags = null;
                objLoadedData.LocalCurrencyData = 0;
                objLoadedData.AuthStatus = _eAuthStatus.Authorized;
                objLoadedData.BaseQuantity = 0;
                objLoadedData.Product = 0;
                objLoadedData.SetId = 0;
                objLoadedData.POSData = null;
                objLoadedData.QCStatus = null;
                objLoadedData.arrLink = [];

                for (iColCounter = 0; iColCounter < arrColData.length; iColCounter++) {
                    // Iterate all data column
                    objData = arrColData[iColCounter];
                    sId = objData.Key;
                    if (sId == eTranEntryBodyDataConstKey.BodyId) {
                        objLoadedData.BodyId = objData.Value;
                        continue
                    }
                    else if (sId == eTranEntryBodyDataConstKey.TransactionId) {
                        objLoadedData.TransactionId = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.Flags) {
                        objLoadedData.Flags = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.AuthStatus) {
                        objLoadedData.AuthStatus = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.BillwiseData) {
                        if (DataType.isString(objData.Value) == true && DataType.isNullOrEmpty(objData.Value, true) == false) {
                            //objData.Value = DataType.replaceNumberToStringInJson(objData.Value);
                            objData.Value = DataType.stringToObject(objData.Value).data;
                        }

                        objLoadedData.BillwiseData = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.LocalCurrencyData) {
                        objLoadedData.LocalCurrencyData = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.BaseQuantity) {
                        objLoadedData.BaseQuantity = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.Product) {
                        objLoadedData.Product = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.SetId) {
                        objLoadedData.SetId = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.POSData) {
                        objLoadedData.POSData = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.QCStatus) {
                        objLoadedData.QCStatus = objData.Value;
                        continue;
                    }
                    else if (sId == eTranEntryBodyDataConstKey.BinsData) {
                        objLoadedData.BinsData = DataType.stringToObject(objData.Value).data;
                        continue;
                    }
                    else if (sId == EntryMainUI.getBodyControlId(eVTFIELDID.FDF_LINK)) {
                        if (DataType.isNullOrEmpty(objData.Value, true) == false) {
                            temp = DataType.stringToObject(objData.Value);
                            if (temp.lValue > 0) {
                                objLoadedData.arrLink = temp.data;
                            }
                        }
                    }
                }

                if (objLoadedData.BodyId > 0) {
                    transEntryGlobal.arrLoadedData.push(objLoadedData);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.initLoadedDataObjectArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getBodyDataFromLoadedBodyId: function (iBodyId) {
        let iRow = 0;
        let result = null;
        let objColData = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = 0;

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == true && DataType.isValidObject(transEntryGlobal.EntryModel.Data.Body) == true) {
                for (iRow = 0; iRow < transEntryGlobal.EntryModel.Data.Body.length; iRow++) {
                    objColData = EntryMainCommon.convertKeyValueArrayToObject(transEntryGlobal.EntryModel.Data.Body[iRow]);
                    if (objColData.length > 0) {
                        if (DataType.toInt(objColData.data.BodyId) == iBodyId) {
                            result.lValue = iRow + 1;
                            result.data = objColData.data;
                        }
                    }
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    // Returns difference(load qty, and current qty) qty,refid object array
    getLinkUsedExtraQuantity: function (iColumn, iExcludeBodyId, iRefId) {
        let iRow = 0;
        let iCounter = 0;
        let result = null;
        let objLoadedData = null;
        let objUsedLink = null;
        let obj = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 1;
            result.sValue = "";
            result.data = [];

            for (iRow = 0; iRow < transEntryGlobal.arrLoadedData.length; iRow++) {
                objLoadedData = transEntryGlobal.arrLoadedData[iRow];
                if (objLoadedData.BodyId == iExcludeBodyId) {
                    continue;
                }

                for (iCounter = 0; iCounter < objLoadedData.arrLink.length; iCounter++) {
                    objUsedLink = objLoadedData.arrLink[iCounter];
                    if (objUsedLink.iColumn != iColumn) {
                        continue;
                    }

                    if (iRefId == 0 || (objUsedLink.iRefId == iRefId && objUsedLink.dUsedExtraQty != 0)) {
                        obj = {};
                        obj.iRefId = objUsedLink.iRefId;
                        obj.dUsedExtraQty = objUsedLink.dUsedExtraQty;
                        result.data.push(obj);
                    }
                }

                result.lValue = result.data.length;
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    getLoadedData: function (iFieldId, iRow) {
        let sId = "";
        let objFindResult = null;
        let objKeyValue = null;
        let objResult = null;

        try {
            objResult = {};
            objResult.Found = false;
            objResult.Area = eTranEntryFieldArea.None;
            objResult.Value = undefined;
            
            if (DataType.isValidObject(transEntryGlobal.EntryModel) == false) {
                return (objResult);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == false) {
                return (objResult);
            }

            sId = EntryMainUI.getHeaderControlId(iFieldId);
            objFindResult = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Header);
            objKeyValue = objFindResult.data;
            if (DataType.isValidObject(objKeyValue) == true) {
                objResult.Found = true;
                objResult.Area = eTranEntryFieldArea.Header;
                objResult.Value = objKeyValue.Value;

                return (objResult);
            }

            if (DataType.isValidObject(iRow) == true) {
                if (iRow < 1 || DataType.arrayLength(transEntryGlobal.EntryModel.Data.Body) > iRow) {
                    return (objResult);
                }

                sId = EntryMainUI.getBodyControlId(iFieldId)
                objFindResult = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Body[iRow - 1]);
                objKeyValue = objFindResult.data;
                if (DataType.isValidObject(objKeyValue) == true) {
                    objResult.Found = true;
                    objResult.Area = eTranEntryFieldArea.Body;
                    objResult.Value = objKeyValue.Value;

                    return (objResult);
                }
            }
            
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getLoadedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

