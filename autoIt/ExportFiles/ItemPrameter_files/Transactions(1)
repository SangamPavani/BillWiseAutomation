        let iIndex = 0;
        let obj = null;

        try {
            iIndex = transEntryGlobal.isMethodExecuting(iMethodExecuting, value);

            if (DataType.toBoolean(bAdd) == true) {
                if (iIndex < 0) {
                    obj = {};
                    obj.iMethodExecuting = iMethodExecuting;
                    obj.Value = value;

                    transEntryGlobal.m_arrMethodExecuting.push(obj);
                }
            }
            else {
                if (iIndex > -1) {
                    transEntryGlobal.m_arrMethodExecuting.splice(iIndex, 1);
