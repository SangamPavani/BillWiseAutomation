    LoadDependentMaster: function () {

        CONFIGURETRANS.DOCUMENTS.closeLoadMastersPopup();
        var selectedVoucher = document.getElementById("doc_voucherDropDown").value;
        var iCurrentVT = parseInt(document.getElementById("id_doccustomization_selectedvouchertype").value);
        var arrDependentMaster = [];
        var fields = document.getElementById("doc_loadMastersOptMasters").children;
        var arrFields = [];
        if (iCurrentVT == selectedVoucher) {
            return;
        }
        for (var count = 0; count < fields.length; count++) {
            if (fields[count].children[0].children[0].checked == true) {
                arrFields.push({ ID: fields[count].children[0].children[0].value, Name: fields[count].children[0].children[1].textContent })
            }
        }
        if (arrPresentVoucherDepedentMasters != null)
            for (var count = 0; count < arrPresentVoucherDepedentMasters.length; count++) {
                for (var count1 = 0; count1 < arrFields.length; count1++) {
                    if (arrPresentVoucherDepedentMasters[count].MasterType == arrFields[count1].ID) {
                        arrFields.splice(count1, 1);
                        count1--;
                    }
                }
            }
        if (arrFields.length > 0) {
            //var selectedVoucher = document.getElementById("doc_voucherDropDown").value;
            for (var count = 0; count < arrVoucherDependentMasters.length; count++) {
                if (selectedVoucher == arrVoucherDependentMasters[count].ID) {
                    for (var count1 = 0; count1 < arrVoucherDependentMasters[count].Tag.length; count1++) {
                        for (var count2 = 0; count2 < arrFields.length; count2++) {
                            if (arrVoucherDependentMasters[count].Tag[count1].MasterType == arrFields[count2].ID) {
                                arrDependentMaster.push(arrVoucherDependentMasters[count].Tag[count1]);
                            }
                        }
                    }
                }
            }

            if (arrPresentVoucherDepedentMasters == null) {
                arrPresentVoucherDepedentMasters = arrDependentMaster;
            }
            else {
                for (var i = 0; i < arrPresentVoucherDepedentMasters.length; i++) {
                    arrDependentMaster.splice(i, 0, arrPresentVoucherDepedentMasters[i]);
                }
                arrPresentVoucherDepedentMasters = arrDependentMaster;
            }
        }
        CONFIGURETRANS.DocumentUpdateMasterGridData(arrDependentMaster);
    },

