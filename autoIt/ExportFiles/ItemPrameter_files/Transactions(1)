            }

            sValue = element.value;
            if (objMetaData.bMandatory == true) {
                if (FCommon.String.isNullOrEmpty(sValue) == true) {
                    dCurrentValue = "";
                }
                else {
                    dCurrentValue = FConvert.toDecimal(sValue);
                }
            }
            else {
                dCurrentValue = FConvert.toDecimal(sValue);
            }

            if (dCurrentValue === "") {
                element.value = "";
            }
            else {
                dCurrentValue = transEntryRate.update(dCurrentValue, iRow);
            }

            EntryMainBody.doRateLeaveAction(dCurrentValue, dLastValue, iRow);
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryDetailPopup.onRate_Leave} " + err.message);
        }
