            cellobj.cell.setAttribute("data-colname", "sno");
            cellobj.cell.style.minWidth = "25px";
            cellobj.cell.style.maxWidth = "25px";

            if (arrBinsData != null) {
                rowno = BINS.lastRowNo;
                for (var i = 0; i <  arrBinsData.length; i++) {
                    rowno = rowno + 1;
                    RowEle = transBinsPopup.getRowElement(rowno);
                    BinsUI.setRowData(arrBinsData[i], rowno);
                }
            }
        }
        catch (err) {
