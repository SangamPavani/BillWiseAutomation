                            }
                        }
                        AdjustBills_Screen.UI.SetNewRefAmt(FNumberOperation.toFixed(_objAdj.m_NewRefTransCurr, _objAdj.m_arrBreakupByTag[0].iNoOfDecimals));
                        if (_objAdj.m_objReferenceType == 2) {
                            AdjustBills_ScreenNew.CalculateInstallments();
                        }
                    }
                }
            }
            else {
                if (FNumberOperation.isGreaterThanOrEqualTo(DataType.toDecimal(_objAdj.m_dTransactionCurrencyAmount), DataType.toDecimal(0))) {
                    if (FNumberOperation.isGreaterThanOrEqualTo(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, (FNumberOperation.add(FNumberOperation.add(AdjustedAmt, AdjustBills_Screen.UI.GetNewRefAmt()), _objAdj.m_dMisAdjAmountTranCurr))), 0)) {
                        if (FCommon.UI.isValidObject(_objAdj.m_objBillFilter) == false) {
