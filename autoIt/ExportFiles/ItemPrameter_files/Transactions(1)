    getItemTaxCategory: function (iRow) {
        let value = null;
        let result = null;
        let obj = null;

        try {

            if (transEntryInfo.VATPref.bEnableMultiEntity == true) {
                obj = {};
                obj.iProductId = EntryMainMemoryObject.getProductValue(iRow);
                obj.iCountryId = 0;

                if (obj.iProductId <= 0) {
                    return (value);
                }

                if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Header) {
                    obj.iCountryId = transEntryFields.getMandatoryValue(transEntryFieldInfo.FATag, 0, "iCountry", eMasterDataType.Number);
                }
                else if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Body) {
                    obj.iCountryId = transEntryFields.getMandatoryValue(transEntryFieldInfo.FATag, iRow, "iCountry", eMasterDataType.Number);
                }

                if (obj.iCountryId > 0) {
                    result = transEntryServer.execute(eTransServerRequest.GetItemTaxCategory, obj);
                    if (result.lValue > 0) {
                        result = result.data;
                        if (result.lValue > 0) {
                            value = DataType.toString(result.data);
                            if (DataType.isNullOrEmpty(value) == true) {
                                value = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "TaxCategory");
                            }
