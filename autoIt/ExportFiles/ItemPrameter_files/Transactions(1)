    calculateUnmappedFields: function (arrRowIndex, iBaseVoucherType) {
        let iCounter = 0;
        let dValue = 0;
        let arrFields = undefined;
        let objMetaData = undefined;
        let objLinkDef = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;

        try {
            if (transEntryFieldInfo.Rate.ColumnIndex < 0) {
                return (false);
            }

            objMetaData = transEntryFieldInfo.Rate.MetaData;
            if (DataType.isNullOrEmpty(objMetaData.sPreload, true) == true) {
                return (false);
            }

            if (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true) {
                return (false);
            }

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (objMetaData.iFieldId != eVTFIELDID.FDF_LINK) {
                    continue;
                }

                if (transEntryLinks.getBaseVoucherType(objMetaData.iMasterLink) == iBaseVoucherType) {
                    break;
                }
            }

            if (iCounter >= arrFields.length) {
                return (false);
            }

            objLinkDef = objMetaData.Tag;
            for (iCounter = 0; iCounter < objLinkDef.Mappings.length; iCounter++) {
                if (objLinkDef.Mappings[iCounter].Tag == eVTFIELDID.FDF_BODYRATE) {
                    break;
                }
            }

            if (iCounter < objLinkDef.Mappings.length) {
                return (false);
            }

            objMetaData = transEntryFieldInfo.Rate.MetaData;
            for (iCounter = 0; iCounter < arrRowIndex.length; iCounter++) {
                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload,
                                                        arrRowIndex[iCounter],
                                                        null,
                                                        transEntryFieldInfo.Rate.ColumnIndex,
                                                        objMetaData.sFieldName);
                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                dValue = DataType.toDecimal(objFormulaOutput.Value);
                dValue = transEntryRate.update(dValue, arrRowIndex[iCounter]);
                transEntryGross.calculateAndUpdate({ iRow: arrRowIndex[iCounter], dRate: dValue });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body calculateUnmappedFields method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.calculateUnmappedFields} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

