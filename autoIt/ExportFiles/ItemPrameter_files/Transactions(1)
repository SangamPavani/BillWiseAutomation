transEntryWorkflow.Sort = {
    onSort: function (obj, evt) {
        let iMetaDataIndex = 0;
        let objMetaData = null;

        try {
            iMetaDataIndex = DataType.toInt(obj.Cell.getAttribute("data-metadataindex"));
            objMetaData = transEntryWorkflowInfo.Columns[iMetaDataIndex].Tag;
            if (DataType.isValidObject(objMetaData) == false) {
                return;
            }

            objMetaData.iMetaDataIndex = iMetaDataIndex;
            objMetaData.iDataIndex = iMetaDataIndex + transEntryWorkflowInfo.DisplayStartColIndex;

            switch (objMetaData.DataTypeId) {
                case eMasterDataType.Fraction:
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    transEntryWorkflow.Sort.sortOnNumber(objMetaData, obj.bAscending);

                    transEntryWorkflow.Data.consolidateData();
                    transEntryWorkflow.fillData(obj.Grid, 1, true, true);
                    break;
                case eMasterDataType.Text:
                    if (objMetaData.FieldId == eVTFIELDID.FDF_DOCUMENTNO) {
                        transEntryWorkflow.Sort.sortOnVoucherNo(objMetaData, obj.bAscending);
                    }
                    else {
                        transEntryWorkflow.Sort.sortOnText(objMetaData, obj.bAscending, 0, transEntryWorkflowInfo.RawData.length);
                    }

                    transEntryWorkflow.Data.consolidateData();
                    transEntryWorkflow.fillData(obj.Grid, 1, true, true);
                    break;
                case eMasterDataType.Date:
                case eMasterDataType.NumberList:
                    transEntryWorkflow.Sort.sortOnText(objMetaData, obj.bAscending, 0, transEntryWorkflowInfo.RawData.length);

                    transEntryWorkflow.Data.consolidateData();
                    transEntryWorkflow.fillData(obj.Grid, 1, true, true);
                    break;
            }

        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.onSort} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    sortOnNumber: function (objMetaData, bAscending) {
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;
        let bChangeRequired = false;
        let objOuterValue = null;
        let objInnerValue = null;

        try {
            iTotal = transEntryWorkflowInfo.RawData.length;
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                    objOuterValue = transEntryWorkflow.m_Workflow.Data[iCounter].CellData[objMetaData.iDataIndex];
                    objInnerValue = transEntryWorkflow.m_Workflow.Data[iIndex].CellData[objMetaData.iDataIndex];

                    if (objMetaData.DataTypeId == eMasterDataType.Fraction) {
                        objOuterValue = DataType.toDecimal(objOuterValue);
                        objInnerValue = DataType.toDecimal(objInnerValue);
                    }
                    else {
                        objOuterValue = DataType.toInt(objOuterValue);
                        objInnerValue = DataType.toInt(objInnerValue);
                    }


                    bChangeRequired = false;

                    if (bAscending == true &&  FNumberOperation.isGreaterThan(objOuterValue, objInnerValue) == true) {
                        bChangeRequired = true;
                    }
                    else if (bAscending == false && FNumberOperation.isLessThan(objOuterValue, objInnerValue) == true) {
                        bChangeRequired = true;
                    }

                    if (bChangeRequired == true) {
                        transEntryWorkflow.Sort.swapData(iCounter, iIndex);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.sortOnNumber} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    sortOnVoucherNo: function (objMetaData, bAscending) {
        let iCounter = 0;
        let arrDataIndex = null;
        let objCellData = null;

        try {
            transEntryWorkflow.Sort.sortOnLength(objMetaData, bAscending);

            arrDataIndex = [];
            for (iCounter = 0; iCounter < transEntryWorkflow.m_Workflow.Data.length; iCounter++) {
                objCellData = transEntryWorkflow.m_Workflow.Data[iCounter];
                if (iCounter == 0) {
                    arrDataIndex.push({ Index: iCounter, Length: objCellData.CellData[objMetaData.iDataIndex].length, Count: 1 });
                }
                else if (objCellData.CellData[objMetaData.iDataIndex].length != arrDataIndex[arrDataIndex.length - 1].Length) {
                    arrDataIndex.push({ Index: iCounter, Length: objCellData.CellData[objMetaData.iDataIndex].length, Count: 1 });
                }
                else {
                    arrDataIndex[arrDataIndex.length - 1].Count++;
                }
            }

            for (iCounter = 0; iCounter < arrDataIndex.length; iCounter++) {
                transEntryWorkflow.Sort.sortOnText(objMetaData, bAscending, arrDataIndex[iCounter].Index, arrDataIndex[iCounter].Count);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.sortOnVoucherNo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    sortOnText: function (objMetaData, bAscending, iStartIndex, iCount) {
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;
        let iCompareValue = 0;
        let bChangeRequired = false;
        let objOuterValue = null;
        let objInnerValue = null;

        try {
            iTotal = iStartIndex + iCount;
            for (iCounter = iStartIndex; iCounter < iTotal; iCounter++) {
                for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                    objOuterValue = transEntryWorkflow.m_Workflow.Data[iCounter].CellData[objMetaData.iDataIndex];
                    objInnerValue = transEntryWorkflow.m_Workflow.Data[iIndex].CellData[objMetaData.iDataIndex];

                    bChangeRequired = false;

                    iCompareValue = objOuterValue.localeCompare(objInnerValue);
                    if (bAscending == true && iCompareValue > 0) {
                        bChangeRequired = true;
                    }
                    else if (bAscending == false && iCompareValue < 0) {
                        bChangeRequired = true;
                    }

                    if (bChangeRequired == true) {
                        transEntryWorkflow.Sort.swapData(iCounter, iIndex);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.sortOnText} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    sortOnLength: function (objMetaData, bAscending) {
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;
        let bChangeRequired = false;
        let objOuterValue = null;
        let objInnerValue = null;

        try {
            iTotal = transEntryWorkflowInfo.RawData.length;
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                    objOuterValue = transEntryWorkflow.m_Workflow.Data[iCounter].CellData[objMetaData.iDataIndex];
                    objInnerValue = transEntryWorkflow.m_Workflow.Data[iIndex].CellData[objMetaData.iDataIndex];

                    bChangeRequired = false;

                    if (bAscending == true && objOuterValue.length > objInnerValue.length) {
                        bChangeRequired = true;
                    }
                    else if (bAscending == false && objOuterValue.length < objInnerValue.length) {
                        bChangeRequired = true;
                    }

                    if (bChangeRequired == true) {
                        transEntryWorkflow.Sort.swapData(iCounter, iIndex);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.sortOnLength} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    swapData: function (iOuterCounter, iInnerCounter, iTotal, eleBody) {
        let objOuterCellData = null;
        let objInnerCellData = null;

        try {
            objOuterCellData = transEntryWorkflow.m_Workflow.Data[iOuterCounter];
            objInnerCellData = transEntryWorkflow.m_Workflow.Data[iInnerCounter];

            transEntryWorkflow.m_Workflow.Data[iOuterCounter] = objInnerCellData;
            transEntryWorkflow.m_Workflow.Data[iInnerCounter] = objOuterCellData;

            objOuterCellData = transEntryWorkflow.m_Workflow.LinkFixedValue[iOuterCounter];
            objInnerCellData = transEntryWorkflow.m_Workflow.LinkFixedValue[iInnerCounter];

            transEntryWorkflow.m_Workflow.LinkFixedValue[iOuterCounter] = objInnerCellData;
            transEntryWorkflow.m_Workflow.LinkFixedValue[iInnerCounter] = objOuterCellData;
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.Sort.swapData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
