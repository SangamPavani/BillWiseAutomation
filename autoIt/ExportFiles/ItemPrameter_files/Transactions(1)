    updateTransactionLayoutObject: function (obj) {
        let sId = "";
        let iCounter = 0;
        let objMetaData = null;
        let objIdNamePair = null;
        let data = null;
        let ele = null;

        try {
            obj.HeaderDocs = [];
            obj.HeaderExtra = [];

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                    sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                    switch (objMetaData.iDataTypeId) {
                        case eMasterDataType.Text:
                        case eMasterDataType.Number:
                        case eMasterDataType.Fraction:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = ele.value;


                                obj.HeaderExtra.push(objIdNamePair);
                            }
                            break;
                        case eMasterDataType.Boolean:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = ele.checked;

                                obj.HeaderExtra.push(objIdNamePair);
                            }
                            break;
                        case eMasterDataType.Date:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = DATEPICKER.getDate(ele);

                                obj.HeaderExtra.push(objIdNamePair);
                            }
                            break;
                        case eMasterDataType.StringList:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true && ele.selectedIndex >= 0) {
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = ele.options[ele.selectedIndex].text;

                                obj.HeaderExtra.push(objIdNamePair);
                            }
                            break;
                        case eMasterDataType.NumberList:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true && ele.selectedIndex >= 0) {
                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = DataType.toInt(ele.options[ele.selectedIndex].value);

