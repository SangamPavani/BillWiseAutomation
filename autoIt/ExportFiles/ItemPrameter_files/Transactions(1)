    IsNumber: function (evt) {
        try {
            evt = (evt) ? evt : window.event;
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
                return true;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.IsNumber} " + err.message, "Exception")
        }
    },
    TwoDigitMinNum: function (num) {
        try {
            return num > 9 ? "" + num : "0" + num;
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.TwoDigitMinNum} " + err.message, "Exception")
        }
    },
    IsNumberWithDot: function (ele, evt) {
        try { 
            var charCode;
            if (evt.keyCode > 0) {
                charCode = evt.which || evt.keyCode;
            }
            else if (typeof (evt.charCode) != "undefined") {
                charCode = evt.which || evt.keyCode;
            }
            if (charCode == 46) {
                if (ele.value.trim().indexOf('.') > -1) {
                    return false;
                }
                return true
            }
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            else {
                var text = ele.value.trim();
                if ((text.indexOf('.') != -1) && (text.substring(text.indexOf('.')).length > 2) &&
                    (event.which != 0 && event.which != 8) && ($(ele)[0].selectionStart >= text.length - 2)) {
                    event.preventDefault();
                }
                else {
                    return true;
                }
                }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.IsNumberWithDot} " + err.message, "Exception")
        }
    },

