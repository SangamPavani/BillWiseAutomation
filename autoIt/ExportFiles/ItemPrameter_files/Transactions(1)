                if (DataType.isNullOrEmpty(sFormula, true) == true) {
                    return;
                }

                sFormula = DataType.stringRemoveSpace(sFormula);
                if (DataType.stringStartsWith(sFormula, "&") == true) {
                    sFormula = sFormula.substr(1);
                }

                if (DataType.stringStartsWith(sFormula, "#") == true) {
                    sFormula = sFormula.substr(1);
                }

                iRow = DataType.toInt(iRow);

                objFormula = new FFormula();
                objFormula.m_CalType = transEntryInfo.CalendarType;
                objFormula.setRowIndex(iRow);
                objFormula.setColumnIndex(-1);
                objFormula.fnValueNeeded = "EntryMainFormula.formula_ValueNeeded";

                objFormula.ResetVars();
                sResult = objFormula.Result(sFormula, true);
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("{transEntryInfo.getVariableValue} " + err.message, GlobalPref.getResourceValue("Exception"));
            }

            return (sResult);
        }

