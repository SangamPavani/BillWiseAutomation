    valueChanged: function (objMetaData, iRow, iColumn) {
        let objFlags = undefined;

        try {
            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_DATE:
                    break;
                case eVTFIELDID.FDF_HEADERCURRENCY:
                case eVTFIELDID.FDF_BODYCURRENCY:
                    break;
                case eVTFIELDID.FDF_EXCHANGERATE:
                    break;
                case eVTFIELDID.FDF_LINK:
                    break;
                case eVTFIELDID.FDF_BODYPRODUCT:
                    break;
                case eVTFIELDID.FDF_BODYUNITS:
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                        EntryMain.m_bQtyModified = true;
                    }
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    break;
                case eVTFIELDID.FDF_EXPDATE:
                    break;
                case eVTFIELDID.FDF_EXCHANGERATE:
                case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    transEntryExchangeRate.onChange(objMetaData.iFieldId);
                    break;
                default:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoLinkCheck = false;

                    if (transEntryInvTag.isInvTag(objMetaData.iFieldId) == true) {
                        objFlags.NoBatchCheck = false;

                        if (transEntryInfo.HeaderId > 0) {
                            objFlags.CheckNegativeStock = true;
                        }
                    }
                    else if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                        transEntryBodyLayout.notifyValueChange(iRow, iColumn, objMetaData);
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
            }

            EntryMainUI.updateFlag(objMetaData.iFieldId);
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainUI.valueChanged} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateFlag: function (iFieldId) {
        let objFlags = undefined;

        try {
            switch (iFieldId) {
                case eVTFIELDID.FDF_DATE:
                    break;
                case eVTFIELDID.FDF_HEADERCURRENCY:
                case eVTFIELDID.FDF_BODYCURRENCY:
                    if (transEntryInfo.HeaderId > 0) {
                        objFlags = transEntryInfo.HeaderFlags;
                        objFlags.NoLinkCheck = false;
                        transEntryInfo.HeaderFlags = objFlags;
                    }
                    break;
                case eVTFIELDID.FDF_EXCHANGERATE:
                case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    if (transEntryInfo.HeaderId > 0) {
                        objFlags = transEntryInfo.HeaderFlags;
                        objFlags.NoLinkCheck = false;
                        transEntryInfo.HeaderFlags = objFlags;
                    }
                    break;
                case eVTFIELDID.FDF_LINK:
                    if (transEntryInfo.HeaderId > 0) {
                        objFlags = transEntryInfo.HeaderFlags;
                        objFlags.NoLinkCheck = false;
                        transEntryInfo.HeaderFlags = objFlags;
                    }
                    break;
                case eVTFIELDID.FDF_BODYPRODUCT:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;
                    objFlags.CheckNegativeStock = true;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true && transEntryInfo.isInwardVoucher == true) {

                        objFlags.NoBarcodeCheck = false;

                        if (transEntryLinks.isDefinedOnQty() == true) {
                            objFlags.NoLinkCheck = false;
                        }
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
                case eVTFIELDID.FDF_BODYUNITS:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                        objFlags.CheckNegativeStock = true;

                        if (transEntryInfo.isInwardVoucher == true) {
                            objFlags.NoBarcodeCheck = false;

                            if (transEntryLinks.isDefinedOnQty() == true) {
                                objFlags.NoLinkCheck = false;
                            }
                        }
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    objFlags = transEntryInfo.HeaderFlags;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                        objFlags.NoLinkCheck = false;
                        objFlags.NoBinCheck = false;
                        objFlags.CheckNegativeStock = true;

                        EntryMain.m_bQtyModified = true;
                    }

                    objFlags.NoBatchCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    if (transEntryInfo.HeaderId > 0) {
                        objFlags = transEntryInfo.HeaderFlags;

                        objFlags.CheckNegativeStock = true;
                        transEntryInfo.HeaderFlags = objFlags;
                    }

                    if (transEntryInfo.isInwardVoucher == true) {
                        objFlags = transEntryInfo.HeaderFlags;

                        objFlags.NoBatchCheck = false;
                        transEntryInfo.HeaderFlags = objFlags;
                    }
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;

                    if (transEntryInfo.HeaderId > 0) {
                        objFlags.CheckNegativeStock = true;
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
                case eVTFIELDID.FDF_EXPDATE:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;

                    if (transEntryInfo.HeaderId > 0) {
                        objFlags.CheckNegativeStock = true;
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
                default:
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoLinkCheck = false;

                    if (transEntryInvTag.isInvTag(iFieldId) == true) {
                        objFlags.NoBatchCheck = false;

                        if (transEntryInfo.HeaderId > 0) {
                            objFlags.CheckNegativeStock = true;
                        }
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainUI.updateFlag} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

