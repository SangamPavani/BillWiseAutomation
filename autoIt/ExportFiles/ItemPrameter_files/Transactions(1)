                                                    tag.arrBatchId.length > 0 ? tag.arrBatchId[0] : 0,
                                                    tag.bRateOnly,
                                                    tag.bRoundOff,
                                                    objStock);

                dRate = objStock.Internal;
                dRate /= tag.arrExchangeRate[0];

                if (DataType.neq(dRate, 0) == true && tag.bUnitExist == true) {
                    fConversion = tag.arrUnitConversion[0];
                    dRate = DataType.mul(dRate, fConversion);
                }

                dRate = DataType.toDecimal(dRate, transEntrySettings.getDecimalsInAmount(), true);

                cellobj = tag.cell;
                if ((typeof cellobj).toLowerCase() == "string") {
                    dExistingRate = DataType.toDecimal(document.getElementById(cellobj).value);
