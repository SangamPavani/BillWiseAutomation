    getPriceBookRateValue: function (objVar, sAbbr, iRow) {
        let iProduct = 0;
        let iDate = 0;
        let iCustomer = 0;
        let iTag = 0;
        let iCounter = 0;
        let iIndex = 0;
        let arrVal = [];
        let bPurchase = false;
        let bChkGroup = false;
        let result = null;
        let obj = null;
        let objResult = null;
        let objWatch = null;

        try {
            objResult = {};
            objResult.Value = 0;
            objResult.TimeDiff = "";

            bPurchase = DataType.stringStartsWithRaw(objVar.Var, "p");

            switch (DataType.arrayLength(objVar.arrParams)) {
                case 5:
                    iProduct = DataType.toInt(objVar.arrParams[0]);
                    iDate = DataType.toInt(objVar.arrParams[1]);
                    iCustomer = DataType.toInt(objVar.arrParams[2]);
                    iTag = DataType.toInt(objVar.arrParams[3]);

                    iIndex = DataType.toInt(objVar.arrParams[4]);
                    arrVal = new Int32Array([iIndex]);

                    break;
                case 1:
                    iProduct = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Product;
                    iDate = EntryMain.m_objTrans.Header.Date;

                    if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                        iCustomer = transEntryFields.getSubLedger(iRow);
                    }
                    else {
                        iCustomer = EntryMain.m_objTrans.BodyData[iRow - 1].Book;
                    }

                    if (bPurchase == true) {
                        iTag = transEntryGrid.getMasterValue(iRow, transEntryInfo.BuyingRateTag);
                    }
                    else {
                        iTag = transEntryGrid.getMasterValue(iRow, transEntryInfo.SellingRateTag);
                    }

                    iIndex = DataType.toInt(objVar.arrParams[0]);
                    arrVal = new Int32Array([iIndex]);

                    break;
                default:
                    return (0);
            }

            for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.arrRateIndex.length; iCounter++) {
                if (transEntryGlobal.FieldHelper.arrRateIndex[iCounter] == iIndex) {
                    break;
                }
            }

            if (iCounter >= transEntryGlobal.FieldHelper.arrRateIndex.length) {
                transEntryGlobal.FieldHelper.arrRateIndex.push(iIndex);
            }

            bChkGroup = objVar.Var.length > 5 ? true : false;

            obj = {};
            obj.iCustomer = iCustomer;
            obj.iProduct = iProduct;
            obj.iTag = iTag;
            obj.iDate = iDate;
            obj.iCurrencyId = EntryMain.m_objTrans.BodyData[iRow - 1].CurrencyId;
            obj.iUnit = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Unit;
            obj.dQuantity = DataType.toDecimal(EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Quantity);
            obj.arrValue = arrVal;
            obj.bPurchase = bPurchase;
            obj.bChkInGroup = bChkGroup;
            obj.sAbbr = sAbbr;

            objResult.Value = transEntryCache.RATE.getValue(obj.iCustomer,
                                                    obj.iProduct,
                                                    obj.iTag,
                                                    obj.iDate,
                                                    obj.iCurrencyId,
                                                    obj.iUnit,
                                                    obj.dQuantity,
                                                    arrVal,
                                                    obj.bPurchase,
                                                    obj.bChkInGroup,
                                                    obj.sAbbr);
            if (objResult.Value != undefined && objResult.Value != null) {
                return (objResult);
            }

            objResult.Value = 0;
            
            if(transEntryGlobal.FieldHelper.arrRateIndex.length > 1) {
                arrVal = new Int32Array(transEntryGlobal.FieldHelper.arrRateIndex);
                obj.arrValue = arrVal;
            }

            objWatch = new FStopWatch();
            objWatch.start();

            result = transEntryServer.execute(eTransServerRequest.GetRates, obj, false);

            objWatch.stop();
            objResult.TimeDiff = "[Time=" + objWatch.getDifferenceString() + "]";

            transEntryGlobal.writeInfoLog("ServerCall::{GetRates} " + objResult.TimeDiff, 2, "royalblue");

            if (result.lValue > 0) {
                if (DataType.isNullOrEmpty(result.data.sValue) == false) {
                    transEntryGlobal.showAlert(result.data.sValue, GlobalPref.getResourceValue("Error"));

                    return (objResult);
                }

                if (DataType.isValidObject(result.data.data) == true) {
                    for(iCounter = 0; iCounter < result.data.data.length; iCounter++) {
                        if(iIndex == transEntryGlobal.FieldHelper.arrRateIndex[iCounter]) {
                            objResult.Value = result.data.data[iCounter];
                        }

                        arrVal = new Int32Array(1);
                        arrVal[0] = transEntryGlobal.FieldHelper.arrRateIndex[iCounter];

                        transEntryCache.RATE.setValue(obj.iCustomer,
                                                        obj.iProduct,
                                                        obj.iTag,
                                                        obj.iDate,
                                                        obj.iCurrencyId,
                                                        obj.iUnit,
                                                        obj.dQuantity,
                                                        arrVal,
                                                        obj.bPurchase,
                                                        obj.bChkInGroup,
                                                        obj.sAbbr,
                                                        result.data.data[iCounter]);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPreload.getPriceBookRateValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

