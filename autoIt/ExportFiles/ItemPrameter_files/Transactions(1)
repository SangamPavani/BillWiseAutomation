    isReservationRestrictd: function (iRow, iFieldId) {
        let lTransIds = 0;
        let arrFoundIndex = null;
        let objInvTagMetaData = null;

        try {
            if (transEntryInfo.HeaderId <= 0) {
                return (false);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel) == false
                || DataType.isValidObject(transEntryGlobal.EntryModel.Data) == false
                || DataType.arrayLength(transEntryGlobal.EntryModel.Data.arrTrnasIdUsedInLinkVoucher) < 1) {

                return (false);
            }

            if (transEntryGlobal.debugRestrictd == true) {
                debugger
            }

            objInvTagMetaData = transEntryInvTag.getMetaData();

            if (DataType.isValidObject(iRow) == false) {
                if (DataType.isValidObject(iFieldId) == true) {
                    if (iFieldId == eVTFIELDID.FDF_DATE) {
                        return (true);
                    }
                    else if (DataType.isValidObject(objInvTagMetaData) == true && objInvTagMetaData.iFieldId == iFieldId) {
                        return (true);
                    }

                    return (false);
                }

                return (true);
            }

            lTransIds = transEntryFields.getTransactionId(iRow);
            if (DataType.isZero(lTransIds) == true) {
                return (false);
            }

            arrFoundIndex = DataType.arrayFindDataIndex(transEntryGlobal.EntryModel.Data.arrTrnasIdUsedInLinkVoucher, lTransIds, "==");
            if (arrFoundIndex.length < 1) {
                return (false);
            }

            if (DataType.isValidObject(iFieldId) == false) {
                return (true);
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_BODYPRODUCT:
                case eVTFIELDID.FDF_BODYQUANTITY:
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                case eVTFIELDID.FDF_BODYBATCHNO:
                case eVTFIELDID.FDF_RMANO:
                case eVTFIELDID.FDF_BINS:
                    return (true);
                default:
                    if (DataType.isValidObject(objInvTagMetaData) == true && objInvTagMetaData.iFieldId == iFieldId) {
                        return (true);
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.isReservationRestrictd} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    isSavingTimeRestrictd: function () {
        let iCurTime = 0;

        try {
            if (GlobalPref.LoginId == GlobalPref.SUPER_USER) { // SU
                return (false);
            }

            if (DataType.isValidObject(GlobalPref.UserTimeRestriction) == false) {
                return (false);
            }

            if (GlobalPref.UserTimeRestriction.RestrictionStartTime == 0
                && GlobalPref.UserTimeRestriction.RestrictionEndTime == 0) {
