    isDuplicateStockTransferInvTag: function (iFieldId, iValue) {
        let sId = "";
        let iCounter = 0;
        let iHeaderInvTag = undefined;
        let iBodyInvTag = undefined;
        let objFieldInfo = undefined;
        let cell = undefined;
        let result = undefined;

        try {
            result = EntryMainValidate.getResultObject();

            result.lValue = 0;
            if (iValue == 0) {
                return (result);
            }

            if (transEntryFieldInfo.Bins.ColumnIndex > -1
                && transEntryFieldInfo.Bins2.ColumnIndex > -1) {

                if (iFieldId == eVTFIELDID.FDF_HEADERINVTAG) {
                    iHeaderInvTag = iValue;
                }
                else if (iFieldId == eVTFIELDID.FDF_BODYINVTAG) {
                    iBodyInvTag = iValue;
                }

                for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows(); iCounter++) {
                    result = EntryMainValidate.isRowItemValidForStockTransferWarehouse(iCounter, iHeaderInvTag, iBodyInvTag);
                    if (result.lValue <= 0) {
                        result.lValue = 1;

                        return (result);
                    }
                }

                result.lValue = 0;
                return (result);
            }

            if (iFieldId == eVTFIELDID.FDF_HEADERINVTAG) {
                objFieldInfo = transEntryFieldInfo.BodyInvTag;
            }
            else if (iFieldId == eVTFIELDID.FDF_BODYINVTAG) {
                objFieldInfo = transEntryFieldInfo.HeaderInvTag;
            }

            if (objFieldInfo == undefined || objFieldInfo.Area == eTranEntryFieldArea.None) {
                return (result);
            }

            if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(objFieldInfo.FieldId);
                if (OPTIONCONTROL.getControlValue(sId) == iValue) {
                    result.lValue = 1;
                    result.sValue = GlobalPref.getResourceValue("msgIssRcvCantBeSame");
                }
            }
            else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows(); iCounter++) {
                    cell = transEntryGrid.getCellObject(iCounter, objFieldInfo.ColumnIndex);
                    if (DataType.isValidObject(cell) == false) {
                        continue;
                    }

                    if (DataType.toInt(cell.getCellData()) == iValue) {
                        result.lValue = 1;
                        result.sValue = GlobalPref.getResourceValue("msgIssRcvCantBeSame");
                        break;
                    }
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    checkBothAccountIsPartyType: function(ctrl, bCode, iCurrentRow) {
        let iCodeAccountType = 0;
        let iBookAccountType = 0;
        let iRow = 0;

        try {
            iCurrentRow = DataType.toInt(iCurrentRow);
            if(bCode == true) {
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.None) { // Book does not exist
                    return (-1);
                }

                if(iCurrentRow == 0) { // Header
                    iCodeAccountType = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl, "iAccountTypeId"));
                }
                else {
                    iCodeAccountType = DataType.toInt(ctrl.getCellData("iAccountTypeId"));
                }

                if(EntryMainCommon.isPartyType(iCodeAccountType) == false) {
                    return (-1);
                }
            }
            else { // Book
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.None) { // Code does not exist
                    return (-1);
                }

                if(iCurrentRow == 0) { // Header
                    iBookAccountType = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl, "iAccountTypeId"));
                }
                else {
                    iBookAccountType = DataType.toInt(ctrl.getCellData("iAccountTypeId"));
                }

                if(EntryMainCommon.isPartyType(iBookAccountType) == false) {
                    return (-1);
                }
            }

            if(bCode == true) {
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iBookAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, 0, "iAccountTypeId", eMasterDataType.Number);
                    if(EntryMainCommon.isPartyType(iBookAccountType) == true) {
                        return (0);
                    }
                }
                else if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    for(iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                        iBookAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, iRow, "iAccountTypeId", eMasterDataType.Number);
                        if(EntryMainCommon.isPartyType(iBookAccountType) == true) {
                            return (iRow);
                        }
                    }
                }
            }
            else { // Book
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                    iCodeAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Code, 0, "iAccountTypeId", eMasterDataType.Number);
                    if(EntryMainCommon.isPartyType(iCodeAccountType) == true) {
                        return (0);
                    }
                }
                else if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    if (transEntryInfo.BaseVoucherType == eVTTYPE.NJOURN) {
                        if(iCurrentRow < 1 || iCurrentRow > transEntryGrid.getTotalRows()) {
                            return (-1);
                        }

