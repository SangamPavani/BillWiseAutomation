                        if (BinsUI.m_BinsParam.Inward == false || (BinsUI.m_BinsParam.Inward == true && BinsUI.m_bDontCheckCapacity != true)) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace = DataType.sub(BinsUI.m_objBinsData.BinDetails[iCounter].Capacity, BinsUI.m_objBinsData.BinDetails[iCounter].Load);
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeQuantity = DataType.div(DataType.sub(BinsUI.m_objBinsData.BinDetails[iCounter].Capacity, BinsUI.m_objBinsData.BinDetails[iCounter].Load), BinsUI.m_iProdCapacity);
                        }

                        //CHECK BINS PREFERENE SETTINGS
                        if (BinsUI.m_BinsParam.Inward &&
                            //SET FOR DIFF BATCH 
                            ((BinsUI.m_BinsParam.DiffBatches && BinsUI.m_sBatch && BinsUI.m_sBatch != arrPrevBins[iIndex].Batch) ||
                            //SET FOR DIFF ITEM 
                            ((BinsUI.m_BinsParam.DiffItemSameBin || BinsUI.m_BinsParam.DifferentAttribute) && BinsUI.m_objBinsData.BinDetails[iCounter].Products != null &&
                            BinsUI.m_objBinsData.BinDetails[iCounter].Products.length > 0 && arrPrevBins[iIndex].Item != BinsUI.m_BinsParam.ProductId)
                            )) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace = 0;
                        }
                    }
                }

                /////////// 08/08/2018 by Noor for Issue #F8W-9256
                // if BinsUI.m_arrCurrentRowBins[iRow].Quantity is different from m_dQuantity ,then it means the product quantity has been changed
                //so make it as 0 (reset it ) and update load as well 
                if (BinsUI.m_BinsParam.Inward && (DataType.arrayLength(BinsUI.m_arrCurrentRowBins) > 0 || DataType.arrayLength(BinsUI.m_arrOtherRowBins) > 0)) {
                    BinsUI.m_objBinsData.BinDetails[iCounter].Load = dCurrentLoad;
                }
            }

            //clear to be allocated values if the quantity of the product is changed
            if (dCurrentBalance != BinsUI.m_dQuantity) {
                for (iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                    BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = 0;
                }
            }

            lstBindetails = BinsUI.removeZeroStockBin(BinsUI.m_objBinsData.BinDetails, arrCurrentBinId, BinsUI.m_BinsParam.Inward);

            BinsUI.m_objBinsData.BinDetails = lstBindetails;
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.updateBinData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    fillGridData: function (objBinsData) {
        let iCounter = 0;
        let iTotalRows = 0;
        let iRowNo = 0;
        let iRowsToFill = 0;
        let iRemainingRows = 0;
        let iAdditionalRows = 0;
        let gridElement = null;
        let arrTree = null;
        let result = null;
        let cell = null;

        try {
            cell = transBinsPopup.getCellElement(0, 0);
            if(DataType.isValidObject(cell) == false) {
                return;
            }

            cell.style.minWidth = "25px";
            cell.style.maxWidth = "25px";

            if (objBinsData == null) {
                return;
            }

            iTotalRows = transBinsPopup.getTotalRows();
                
            if (objBinsData.length == BinsUI.m_objBinsData.BinDetails.length) {//if objBinsData contains complete tree data
                arrTree = BINS.arrayToTree(objBinsData);
            }
            else {
                var arrBinsDataCopy = (BinsUI.m_objBinsData.BinDetails).slice(0);//copy by value , not by reference

                for (iCounter = 0; iCounter < objBinsData.length; iCounter++) {
                    var elemIndex = arrBinsDataCopy.map(function (x) { return x.Id }).indexOf(objBinsData[iCounter].Id);
                    arrBinsDataCopy.splice(elemIndex, 1, objBinsData[iCounter]);//remove existing object at elemIndex and put new object
                }

                arrTree = BINS.arrayToTree(arrBinsDataCopy);
            }

            iRowsToFill = objBinsData.length;


            //if the overall data length > 500 , then enable paging
            if (objBinsData.length > 500) {
                var objIndexNodes = {};
                var rowsLimitIndex = 0;
                var pagesAndRecords = {};

                if (objBinsData.length == arrTree.length) {
                    BinsUI.m_isTree = false;
                    rowsLimitIndex = 499; // fixed in non tree
                    iRowsToFill = 500; // fixed in non tree
                    BinsUI.m_iTotalPages = objBinsData.length / 500;

                    if (objBinsData.length % 500 > 1) {
                        BinsUI.m_iTotalPages++;
                    }
                }
                else {
                    BinsUI.m_isTree = true;
                    objIndexNodes = BINS.getTreeIndexAndTotalNodes(arrTree);
                    rowsLimitIndex = objIndexNodes.treeindex;
                    iRowsToFill = objIndexNodes.totalnodes;
                    BINS.m_lastTreeIndexAndNodes = objIndexNodes;
                    pagesAndRecords = BINS.getTreePages_CountAndRecords(arrTree);
                    BinsUI.m_iTotalPages = pagesAndRecords.totalpages;
                    BINS.m_tree_pagesrecordsmap = pagesAndRecords.pagerecordsmap;
                    BINS.m_tree_pageindicesmap = pagesAndRecords.pageindicesmap;
                }

                BINS.iOrigRows = iRowsToFill;

                // take max 500 records and display 
                arrTree = arrTree.slice(0, rowsLimitIndex + 1);
                document.getElementById("binspopup_pager").style.display = "";
                document.getElementById("id_bins_currentpage").setAttribute("data-itotalpages", BinsUI.m_iTotalPages)
                BinsUI.m_isPaging = true;
            }
               
            //2 cases
            if (iRowsToFill < iTotalRows) {
                // Enter iRowsToFill, delete remaining rows
                iRemainingRows = iTotalRows - iRowsToFill;
                transBinsPopup.deleteRows(iRowsToFill + 1, iRemainingRows);
            }
            else if (iRowsToFill > iTotalRows) {
                // Add aditional rows, enter iRowsToFill
                iAdditionalRows = iRowsToFill - iTotalRows;
                transBinsPopup.insertRows(iTotalRows, iAdditionalRows);
            }

            BINS.iOrigRows = transBinsPopup.getTotalRows();

            var currentParentPadding = 0; var currentLevel = 0;
            currentLevel++;
            result = null;

            transBinsPopupFragment.initFragment(true);

            for (iCounter = 0; iCounter < arrTree.length; iCounter++) {
                iRowNo = iRowNo + 1;

                //check if the row is allocate a value in multiple pages 
                if (BinsUI.m_isPaging) {
                    if (BinsUI.m_MultiSelectedBins && BinsUI.m_MultiSelectedBins.length > 0) {
                        result = ($.grep(BinsUI.m_MultiSelectedBins, function (e) {
                            return e.Id == arrTree[iCounter].Id;
                        }));

                        if (result != null && result.length > 0) {
                            arrTree[iCounter].ToBeAllocated = result[0].ToBeAllocated;
                        }
                    }
                }

                BinsUI.setRowData(arrTree[iCounter], iRowNo, currentParentPadding, currentLevel);
                if (arrTree[iCounter].Group == true) {
                    iRowNo = BINS.fillTreeRecursive(arrTree[iCounter].children, iRowNo, currentParentPadding, currentLevel);
                }
            }

            transBinsPopupFragment.initFragment(false);

            gridElement = transBinsPopup.getGridElement();
            if (gridElement.lastElementChild.nodeName.toLowerCase() != "tfoot") {
                BINS.creategridfooter();
            }

            if (BinsUI.m_Preference.Bins.bBinsAllocationRestriction == true && BinsUI.m_BinsParam.Inward) {
                transBinsPopup.getAlternateCategoryElement().style.display = "";
            }

            if (!BinsUI.m_isPaging) {
                BinsUI.updateBalance();
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.fillGridData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateBalance: function() {
        let dTotalQty = 0;
        let dAllocated = 0;
        let dDifference = 0;

        try {
            dAllocated = BinsUI.getTotalAllocated();

            dTotalQty = BinsUI.getTotalQty();
            dDifference = FNumberOperation.sub(dTotalQty, dAllocated);

            BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dDifference));

