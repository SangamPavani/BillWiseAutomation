                        else if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0
                            && DataType.isValidObject(objBody.Sales) == true
                            && DataType.isValidObject(objBody.Sales.ScreenData) == true) {
                            for (iCounter1 = 0; iCounter1 < objBody.Sales.ScreenData.length; iCounter1++) {
                                objScreenData = objBody.Sales.ScreenData[iCounter1];

                                if (iConvertSource == eConvertTransactionObjectSource.CopyDocument || iConvertSource == eConvertTransactionObjectSource.PasteFromClipboard || iConvertSource == eConvertTransactionObjectSource.LoadInvoiceNoData) {
