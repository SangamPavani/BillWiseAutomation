    addToTabList: function (element) {

        var activateTab = document.getElementById("navigationtab" + element.dataset.tabid);
        activateTab.style.display = "block";
        var allTabs = document.getElementById("navigationTabs").children;
        for (var count = 0; count < allTabs.length; count++) {
            if (allTabs[count].style.display == "block" && allTabs[count] != activateTab) {
                var li = document.createElement("li");
                li.setAttribute("onclick", "CONFIGURETRANS.addToTabList(this)");
                li.dataset.tabid = allTabs[count].id.substring(13);
                li.id = "navHidetab" + allTabs[count].id.substring(13);
                var span1 = document.createElement("span");
                span1.classList = allTabs[count].children[0].children[0].className;
                // span1.classList = "theme_button_color";
                var span2 = document.createElement("span");
                span2.textContent = allTabs[count].children[0].children[1].textContent;
                //span2.className = "theme_button_color";
                li.className = "theme_button_color";
                li.appendChild(span1);
                li.innerHTML += '&nbsp;';
                li.appendChild(span2);
                element.parentNode.appendChild(li);
                element.parentNode.removeChild(element);
                allTabs[count].style.display = "none";
                break;
            }
        }
        activateTab.children[0].onclick();
        $(activateTab.children[0]).tab('show');
        $(activateTab).on('shown.bs.tab', function (e) {
            if (activateTab.id == "navigationtab7")
                CONFIGURETRANS.setTriggersHeight();
            if (activateTab.id == "navigationtab8")
                CONFIGURETRANS.setDocumentNumberingHeight();
            //if (activateTab.id == "navigationtab4")
            //    CONFIGURETRANS.setViewsgHeight();
        });
    },

    SetData: function (id, Type, value) {

        switch (Type) {
            case "Radio":
                var name = document.getElementById(id).dataset.fieldname;
                if (parseInt(value) > -1)
                    document.getElementById(name + "_" + value).checked = true;
                break;
            case "TextBox":
            case "Number":
                document.getElementById(id).value = value;
                break;
            case "CheckBox":
                if (value == 1) {
                    document.getElementById(id).checked = true;
                    break;
                }
                document.getElementById(id).checked = false;
                break;
            case "Combobox":
            case "TextValue":

                document.getElementById(id).value = value;
                if (id == "cmbSkidNomenclature") {
                    onNomenclatureChange(document.getElementById("cmbSkidNomenclature"))
                }
                break;
            case "OptionControl":
                if (isNaN(value) || (value == "" && value.length <= 0)) {
                    value = -1;
                }
                OPTIONCONTROL.setControlValue(document.getElementById(id).dataset.optid, value);
                break;
            case "DatePicker":
                DATEPICKER.setDate(document.getElementById(id).dataset.dateid, value, true);
                break;
            case "TimePicker":

                FTIMECONTROL.setTime(document.getElementById(id).dataset.timeid, value);
                break;
        }
    },
