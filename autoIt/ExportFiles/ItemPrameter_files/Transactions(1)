                    if (DataType.isNullOrEmpty(sTemp) == false && objBatchSeries.Type != 3
                        && objBatchSeries.Type != 5 && objBatchSeries.Type != 11) {
                        iMaxLength = sTemp.length - objBatchSeries.StartPosition;
                        if (objBatchSeries.NumberOfChars > iMaxLength) {
