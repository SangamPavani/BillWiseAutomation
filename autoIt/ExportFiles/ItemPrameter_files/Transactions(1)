    isFieldInRule: function (arrRules, iFieldId, lstMatchedIndex) {
        let iCounterRules = 0;
        let iCounterTwo = 0;
        let iCounterThree = 0;
        let iTotal = 0;
        let bMatchedList = false;
        let bFlag = false;
        let objRules = null;
        let objRuleBody = null;
        let objRuleCondition = null;

        try {
            if (DataType.isArray(lstMatchedIndex) == true) {
                bMatchedList = true;
            }

            iTotal = DataType.arrayLength(arrRules);
            for (iCounterRules = 0; iCounterRules < iTotal; iCounterRules++) {
                objRules = arrRules[iCounterRules];
                if(objRules.RuleBody.length == 1 && objRules.RuleBody[0].RuleCondition.length == 0) { // No Condition
                    for(iCounterTwo = 0; iCounterTwo < objRules.RuleBody[0].RuleFormatting.length; iCounterTwo++) {
                        if(objRules.RuleBody[0].RuleFormatting[iCounterTwo].FieldId == iFieldId) {
                            return (true);
                        }
                    }

                    continue;
                }

                for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody.length; iCounterTwo++) {
                    // Last index of RuleBody is for else

                    bFlag = false;
                    objRuleBody = objRules.RuleBody[iCounterTwo];
                    for (iCounterThree = 0; iCounterThree < objRuleBody.RuleCondition.length; iCounterThree++) {
                        // every row of the rule
                        objRuleCondition = objRuleBody.RuleCondition[iCounterThree];
                        if (iFieldId == objRuleCondition.FieldId) {
                            if (bMatchedList == true) {
                                lstMatchedIndex.push({ BodyIndex: iCounterTwo, ConditionIndex: iCounterThree, RuleCondition: objRuleCondition });
                                bFlag = true;
                                continue;
                            }
                            return (true);
                        }
                        else if (objRuleCondition.CompareWith == 2 && iFieldId == objRuleCondition.LinkID) { // Compare with field(2), value(1),field(2),formula(3)
                            if (bMatchedList == true) {
                                lstMatchedIndex.push({ BodyIndex: iCounterTwo, ConditionIndex: iCounterThree, RuleCondition: objRuleCondition });
                                bFlag = true;
                                continue;
                            }

                            return (true);
                        }
                    }

                    if (bFlag == true) {
                        return (true);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.isFieldInRule} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },


