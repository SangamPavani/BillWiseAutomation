    getObjectFromCell: function (objCell, objMetaData, iRow, bElement) {
        let iLinkField = 0;
        let iNoOfDecimals = 0;
        let iMaxDecimals = 0;
        let dExchangeRate = 0;
        let dValue = 0;
        let objLink = null;

        try {
            objLink = {};

            if (bElement == true) {
                objLink.LinkId = DataType.toInt(objCell.getAttribute("data-linkid"));
                objLink.RefId = DataType.toInt64(objCell.getAttribute("data-refid"));
                objLink.VoucherType = DataType.toInt(objCell.getAttribute("data-vouchertype"));
                objLink.VoucherNo = DataType.toString(objCell.getAttribute("data-voucherno"));
            }
            else {
                objLink.LinkId = DataType.toInt(objCell.getCellData("linkid"));
                objLink.RefId = DataType.toInt64(objCell.getCellData("refid"));
                objLink.VoucherType = DataType.toInt(objCell.getCellData("vouchertype"));
                objLink.VoucherNo = DataType.toString(objCell.getCellData("voucherno"));
            }

            objLink.BaseTransactionId = objLink.RefId;
            objLink.UsedValue = 0;

            if (objMetaData.Tag.UseLinkForLoading == false) {
                iLinkField = transEntryLinks.getLinkField(objMetaData.iMasterLink);
                switch(iLinkField) {
                    case eTranEntryLinkValue.Amount:
                        if (transEntryFieldInfo.Amount.FieldId > 0) {
                            dValue = EntryMainMemoryObject.getAmountValue(iRow);
                        }
                        else {
                            dValue = 0;
                            if (transEntryFieldInfo.Debit.FieldId > 0) {
                                dValue = transEntryFields.getDebit(iRow);
                            }

                            if (DataType.isZero(dValue) == true
                                && transEntryFieldInfo.Credit.FieldId > 0) {

                                dValue = transEntryFields.getCredit(iRow);
                            }
                        }

                        dExchangeRate = EntryMainMemoryObject.getExchangeRate(iRow);
                        dValue = DataType.mul(dValue, dExchangeRate);
                        objLink.UsedValue = dValue;
                        break;
                    case eTranEntryLinkValue.Gross:
                        dExchangeRate = EntryMainMemoryObject.getExchangeRate(iRow);
                        dValue = EntryMainMemoryObject.getGrossValue(iRow);

                        dValue = FNumberOperation.abs(FNumberOperation.mul(dValue, dExchangeRate));

                        iNoOfDecimals = transEntrySettings.getDecimalsInAmount(iRow);
                        objLink.UsedValue = FNumberOperation.toFixed(dValue, iNoOfDecimals);
                        break;
                    case eTranEntryLinkValue.Net:
                        dValue = transEntryNet.getValue(iRow);
                        objLink.UsedValue = FNumberOperation.abs(dValue);
                        break;
                    case eTranEntryLinkValue.Quantity:
                        iNoOfDecimals = transEntryQuantity.getDecimals(iRow);
                        if (EntryMain.m_DecimalsInQty != iNoOfDecimals) {
                            dValue = EntryMainMemoryObject.getBaseQuantityValue(iRow, false);

                            if (iNoOfDecimals > 0 && EntryMain.m_DecimalsInQty >= 10) { // Block added as per Javed suggestion
                                iNoOfDecimals = EntryMain.m_DecimalsInQty;
                            }

                            iMaxDecimals = iNoOfDecimals;
                            //iMaxDecimals = DataType.max(EntryMain.m_DecimalsInQty, iNoOfDecimals);
                            dValue = DataType.toFixed(dValue, iMaxDecimals);
                        }
                        else {
                            dValue = EntryMainMemoryObject.getBaseQuantityValue(iRow, true);
                        }
                        objLink.UsedValue = dValue;
                        break;
                    case eTranEntryLinkValue.TransactionQuantity:
                        dValue = transEntryFields.getQty(iRow);
                        objLink.UsedValue = FNumberOperation.abs(dValue);
                        break;
                    case eTranEntryLinkValue.TransactionAmount:
                        if (transEntryFieldInfo.Amount.FieldId > 0) {
                            dValue = EntryMainMemoryObject.getAmountValue(iRow);
                        }
                        else {
                            dValue = 0;
                            if (transEntryFieldInfo.Debit.FieldId > 0) {
                                dValue = transEntryFields.getDebit(iRow);
                            }

                            if (DataType.isZero(dValue) == true
                                && transEntryFieldInfo.Credit.FieldId > 0) {

                                dValue = transEntryFields.getCredit(iRow);
                            }
                        }
                        
                        objLink.UsedValue = dValue;
                        break;
                    case eTranEntryLinkValue.TransactionGross:
                        dValue = EntryMainMemoryObject.getGrossValue(iRow);
                        objLink.UsedValue = dValue;
                        break;
                    case eTranEntryLinkValue.AlternateQuantity:
                        dValue = EntryMainMemoryObject.getAltQuantityValue(iRow);
                        objLink.UsedValue = dValue;
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryLinks.getObjectFromCell} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objLink);
    },

    UpdateLoadedLinkInvTag: function (iBaseVoucherType, iLinkVoucherType, iLinkId, objData) {
        let sId = "";
        let iCounter = 0;
        let arrLinkMetaData = null;
        let arrMappings = null;
        let objFindResult = null;

        try {
            if (FConvert.isItTransfer(iBaseVoucherType) == false || FConvert.isItTransfer(iLinkVoucherType) == false) {
                return;
            }

            arrLinkMetaData = transEntryFieldInfo.getLinkFields({ LinkId: iLinkId });
            if (DataType.arrayLength(arrLinkMetaData) > 0) {
                arrMappings = arrLinkMetaData[0].MetaData.Tag.Mappings;
