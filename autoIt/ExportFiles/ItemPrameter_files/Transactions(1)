            if (FCommon.UI.isValidObject(eleList) == false) {
                return;
            }

            for (iCounter = 0; iCounter < eleList.children.length; iCounter++) {
                eleLi = eleList.children[iCounter];
                if (ele.value == "") {
                    eleLi.style.display = "";
                    continue;
                }

                sText = eleLi.getAttribute("data-text");
                sText = sText.toLowerCase();
                if (ele.value.length < sText.length) {
                    if (FCommon.String.startsWith(sText, ele.value.toLowerCase()) == true) {
                        eleLi.style.display = "";
                    }
                    else {
                        eleLi.style.display = "none";
                    }
                }
                else {
                    if (ele.value.toLowerCase() == sText) {
                        eleLi.style.display = "";
                    }
                    else {
                        eleLi.style.display = "none";
                    }
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Views.searchFromList} " + err.message, "Exception");
        }
    }
