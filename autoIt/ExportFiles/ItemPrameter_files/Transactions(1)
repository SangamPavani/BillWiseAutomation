            if (transEntryFieldInfo.Amount.ColumnIndex > -1) {
                result.iMetaData = transEntryFieldInfo.Amount.MetaDataIndex;
                result.iColumn = transEntryFieldInfo.Amount.ColumnIndex;
                result.iFieldId = transEntryFieldInfo.Amount.FieldId;

                if (result.iColumn > -1) {
                    if (iRow < 1 || iRow > transEntryGrid.getTotalRows()) {
                        result.sValue = "Invalid row index.";
                    }
                    else {
                        result.data = transEntryGrid.getCellObject(iRow, result.iColumn);
                        if (DataType.isValidObject(result.data) == true) {
                            result.lValue = 1;
                            result.iNoDecimal = transEntrySettings.getDecimalsInAmount(iRow);
                        }
                    }
                }
                else {
                    result.data = document.getElementById(EntryMainUI.getBodyControlId(result.iFieldId));
                    result.lValue = 1;
                    result.iNoDecimal = transEntrySettings.getDecimalsInAmount(iRow);
                }
            }
            else {
                result.sValue = "Field not found.";
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    getResultObject: function () {
        let obj = null;

        obj = COMMON.prototype.getEmptyResultObject();
        obj.lValue = 0;
        obj.sValue = "";
        obj.data = null;
        obj.iNoDecimal = 0;
        obj.iMetaData = -1;
        obj.iColumn = -1;
        obj.iFieldId = 0;

        obj.setText = function (sText, value) {
            let objMetaData = null;
            let sCtrlId = "";
            let eleCtrl = null;

            if (this.lValue > 0) {
                if (this.iColumn > -1) {
                    this.data.setCellText(sText, value);
                }
                else {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[this.iMetaData];
                    switch (objMetaData.iDataTypeId) {
                        case eMasterDataType.Text:
                        case eMasterDataType.Number:
                        case eMasterDataType.Fraction:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            if (DataType.isValidObject(eleCtrl) == true) {
                                eleCtrl.value = sText;
                            }
                            break;
                    }
                }
            }
        };

        return (obj);
    }
};

