    PressEnterOrSpace: function (e, li) {
        try {
        var keyCode = e.which ? e.which : e.keyCode
        var ret = (keyCode == 32 || keyCode == 13);
        if (ret) {
            if (li == "PickLi") {
              RESERVATION.PickQuantity('txtQtyToReserve');
            }
            if (li == "CancelLi") {
              RESERVATION.CancelReservation();
            }
            //if (li == "DisplayLi") {
            //    RESERVATION.DisplayFilter();
            //}
            if (li == "OkLi") {
              RESERVATION.GetReservationData();
            }
            if (li == "CloseLi") {
              RESERVATION.CloseReservation();
            }
            }
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.PressEnterOrSpace} " + err.message, "Exception")
        }
