        let objResult = undefined;
        let obj = undefined;

        try {
            objResult = COMMON.prototype.getEmptyResultObject();
            objResult.lValue = 0;
            objResult.sValue = "";
            objResult.data = {};
            objResult.data.Value = 0;
            objResult.data.bFound = false;

            if (iLinkValue != eTranEntryLinkValue.Quantity && iLinkValue != eTranEntryLinkValue.AlternateQuantity) {
                return (objResult);
            }

            if (transEntryInfo.HeaderId <= 0) {
                return (objResult);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel) == false
                || DataType.isValidObject(transEntryGlobal.EntryModel.Data) == false
                || DataType.arrayLength(transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue) < 1) {

                return (objResult);
            }

            if (transEntryInfo.NextLinkDef.length == 0) {
                return (objResult);
            }

            lTransIds = transEntryFields.getTransactionId(iRow);
            if (DataType.isZero(lTransIds) == true) {
                return (objResult);
            }

            arrFoundIndex = DataType.arrayFilterDataIndex(transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue, "lTransId", lTransIds, "==");
            if (arrFoundIndex.length < 1) {
                return (objResult);
            }

            arrFoundData = [];
            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                obj = {};
                obj.iIndex = arrFoundIndex[iCounter];
                obj.Data = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[obj.iIndex];

                obj.LinkInfo = null;
                arrLinkFound = DataType.arrayFilterDataIndex(transEntryInfo.NextLinkDef, "iLinkId", obj.Data.iLinkId, "==");
                if (arrLinkFound.length < 1) {
                    continue;
                }

                iIndex = arrLinkFound[0];
                obj.LinkInfo = transEntryInfo.NextLinkDef[iIndex];
                if (obj.LinkInfo.iLinkValue != iLinkValue) {
                    continue;
                }

                objResult.data.bFound = true;
                if (DataType.neq(obj.Data.dBase, obj.Data.dBalance) == true) { // Used
                    obj.Used = DataType.sub(obj.Data.dBase, obj.Data.dBalance);

                    arrFoundData.push(obj);
                }
            }

            if (arrFoundData.length > 1) {
                bDoNotClubCommonBase = true;
                dMaxUsed = undefined;
                for (iCounter = 0; iCounter < arrFoundData.length; iCounter++) {
                    if (arrFoundData[iCounter].LinkInfo.bDoNotClubCommonBase == false) {
                        bDoNotClubCommonBase = false;
                        break;
                    }

                    if (dMaxUsed == undefined) {
                        dMaxUsed = arrFoundData[iCounter].Used;
                    }
                    else if (DataType.gt(arrFoundData[iCounter].Used, dMaxUsed) == true) {
                        dMaxUsed = arrFoundData[iCounter].Used;
                    }
                }

                if (bDoNotClubCommonBase == true) {
                    objResult.data.bFound = true;
                    objResult.lValue = 1; // Mark Flag
                    objResult.data.Value = dMaxUsed;

                    return (objResult);
                }
            }

            for (iCounter = 0; iCounter < arrFoundData.length; iCounter++) {
                objResult.data.bFound = true;

                objResult.lValue = 1; // Mark Flag
                objResult.data.Value = DataType.add(objResult.data.Value, arrFoundData[iCounter].Used);

                if (arrFoundData[iCounter].LinkInfo.bDoNotClubCommonBase == false) {
                    break;
                }
            }
        }
        catch (err) {
            objResult.lValue = -1;
            objResult.sValue = err.message;
        }

        return (objResult);
    },

