    // Returns number of decimal places for specific fields
    getRequiredDecimalPlaces: function (iFieldId, iRow) {
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = 0;

            switch (iFieldId) {
                case eVTFIELDID.FDF_BODYQUANTITY:
                case eVTFIELDID.FDF_BODYALTQUANTITY:
                case eVTFIELDID.FDF_QUANTITY_IN_BASE:
                case eVTFIELDID.FDF_BATCH_QUANTITY:
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                    result.data = transEntryQuantity.getDecimals(iRow);
                    result.lValue = 1;
                    break;
                case eVTFIELDID.FDF_BODYRATE:
                case eVTFIELDID.FDF_BODYGROSS:
                case eVTFIELDID.FDF_BODYAMOUNT:
                case eVTFIELDID.FDF_BATCHRATE:
                case eVTFIELDID.FDF_BATCHRATE1:
                case eVTFIELDID.FDF_BATCHRATE2:
                case eVTFIELDID.FDF_SCREEN_AMOUNT:
                case eVTFIELDID.FDF_SCREEN_NET_AMOUNT:
                case eVTFIELDID.FDF_ORIGINAL_AMOUNT:
                case eVTFIELDID.FDF_ORIGINAL_GROSS:
                case eVTFIELDID.FDF_ORIGINAL_RATE:
                case eVTFIELDID.FDF_AMOUNT1:
                case eVTFIELDID.FDF_BODYNET:
                case eVTFIELDID.FDF_LOCAL_NETAMOUNT:
                case eVTFIELDID.FDF_LOCAL_GROSSAMOUNT:
                case eVTFIELDID.FDF_REFERENCE_AMOUNT:
                case eVTFIELDID.FDF_REFERENCE_BASE_AMOUNT:
                case eVTFIELDID.FDF_REFERENCE_LOCAL_AMOUNT:
                case eVTFIELDID.FDF_CREDITDAYSBASEDDISCOUNT:
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                    iRow = DataType.toInt(iRow);
                    result.data = transEntrySettings.getDecimalsInAmount(iRow);
                    result.lValue = 1;
                    break;
                case eVTFIELDID.FDF_EXCHANGERATE:
                case eVTFIELDID.FDF_BODYEXCHANGERATE:
                case eVTFIELDID.FDF_LOCAL_EXCHANGERATE:
                case eVTFIELDID.FDF_LOCEXCHANGERATE:
                    result.data = transEntryExchangeRate.getDecimals();
                    result.lValue = 1;
                    break;
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

    // Clears given control based on datatypeid
    clearControl: function (eleCtrl, iDataTypeId) {
        try {
            eleCtrl = FUIElement.getValidElement(eleCtrl);
            if (DataType.isValidObject(eleCtrl) == false) {
                return (false);
            }

            switch (iDataTypeId) {
                case eMasterDataType.Text:
                case eMasterDataType.Number:
                case eMasterDataType.Fraction:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    eleCtrl.value = "";
                    break;
                case eMasterDataType.Boolean:
                    eleCtrl.checked = false;
                    break;
                case eMasterDataType.DateTime:
                    eleCtrl.value = "";
                    break;
                case eMasterDataType.Date:
                    DATEPICKER.clear(eleCtrl);
                    break;
                case eMasterDataType.Time:
                    FTIMECONTROL.clear(eleCtrl);
                    break;
                case eMasterDataType.Picture:
                    eleCtrl.value = "";
                    break;
                case eMasterDataType.StringList:
                    eleCtrl.selectedIndex = 0;
                    break;
                case eMasterDataType.NumberList:
                    eleCtrl.selectedIndex = 0;
                    break;
                case eMasterDataType.DocumentViewer:
                    eleCtrl.value = "";
                    break;
                case eMasterDataType.UpdatedTime:
                    eleCtrl.value = "";
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    OPTIONCONTROL.clear(eleCtrl);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.clearControl} " + err.message, GlobalPref.getResourceValue("Exception"));
