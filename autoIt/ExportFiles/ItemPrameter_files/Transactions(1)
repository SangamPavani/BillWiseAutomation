    onDataChange_Master: function (id, data, tag) {
        let iFieldId = 0;
        let iAccountTypeId = 0;
        let iMasterTypeId = 0;
        let iLastValue = 0;
        let iCurrentValue = 0;
        let lRefId = 0;
        let result = null;
        let bResult = false;
        let arrData = undefined;
        let bLoadDependency = false;
        let objMetaData = null;
        let objWatch = undefined;
        let objExtra = undefined;

        try {
            if (transEntryGlobal.debugHeader == true) {
                debugger
            }

            if (DataType.isValidObject(tag.Data) == false) {
                return;
            }

            iFieldId = EntryMainUI.extractHeaderFieldId(id.id);

            if (EntryMain.isDataLoading() == true && EntryMain.isEditMode() == true) {
                if (iFieldId == eVTFIELDID.FDF_CODE) {
                    if (transEntryInfo.ARAPPref.iPickCreditDaysFrom == 2 && DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control)) > 0) // if credit days to be picked from Sales/Pur
                    {
                        result = transEntryDueDate.getTypeAndValue(0);
                        if(DataType.isValidObject(result) == true) {
                            EntryMain.m_iDueDateType = result.iDueDateType;
                            EntryMain.m_iDueDateValue = result.iDueDateValue;
                        }
                    }

                    bLoadDependency = true;
                }
                else if (iFieldId == eVTFIELDID.FDF_BOOKNO) {
                    if (transEntryInfo.ARAPPref.iPickCreditDaysFrom == 0) // if credit days to be picked from Customer vendor a/c
                    {
                        result = transEntryDueDate.getTypeAndValue(0);
                        if(DataType.isValidObject(result) == true) {
                            EntryMain.m_iDueDateType = result.iDueDateType;
                            EntryMain.m_iDueDateValue = result.iDueDateValue;
                        }
                    }

                    bLoadDependency = true;
                }
                else if (iFieldId == eVTFIELDID.FDF_PMTTERMS) {
                    if (transEntryInfo.ARAPPref.iPickCreditDaysFrom == 1 && DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control)) > 0) // if credit days to be picked from Pmt term
                    {
                        result = transEntryDueDate.getTypeAndValue(0);
                        if(DataType.isValidObject(result) == true) {
                            EntryMain.m_iDueDateType = result.iDueDateType;
                            EntryMain.m_iDueDateValue = result.iDueDateValue;
                        }
                    }
                }

                EntryMainHeader.updateViewInfoFields(EntryMainUI.extractHeaderFieldId(tag.Control.id), tag.Control);

                if (tag.CustomData
                    && tag.CustomData.CallingSource == eDisplayBodyDataSource.LoadVoucher
                    && bLoadDependency == true) {

                    EntryMainDependency.processAccountDependency(iFieldId, "", tag);
                }

                return;
            }

            iLastValue = DataType.toInt(tag.OldValue);
            iCurrentValue = DataType.toInt(tag.Value);

            if (DataType.isValidObject(tag.CustomData) == true && (typeof tag.CustomData).toLowerCase() == "object" && DataType.isValidObject(tag.CustomData.tagOldValue) == true) {
                iLastValue = DataType.toInt(tag.CustomData.tagOldValue);
            }            

            objMetaData = transEntryGlobal.EntryModel.MetaData.Header[DataType.toInt(tag.UserData)];
            iFieldId = EntryMainUI.extractHeaderFieldId(id.id);

            if (EntryMainUI.isBillStatusRestricted(0, iFieldId, objMetaData) == true) {
                objExtra = OPTIONCONTROL.createSetValueExtraObject();
                objExtra.bIgnoreChangeCallback = true;
                OPTIONCONTROL.setValue(id, iLastValue, null, objExtra);

                transEntryGlobal.showAlert("This document is already adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "' . Due to this field '" + objMetaData.sFieldName + "' cannot be changed.", GlobalPref.getResourceValue("Warning"));

                tag.Value = iLastValue;

                return (false);
            }

            if (EntryMainUI.isLinkRestrictd(0, iFieldId, true).Value == true) {
                objExtra = OPTIONCONTROL.createSetValueExtraObject();
                objExtra.bIgnoreChangeCallback = true;
                OPTIONCONTROL.setValue(id, iLastValue, null, objExtra);

                transEntryGlobal.showAlert("This document is already used in link voucher. Due to this field '" + objMetaData.sFieldName + "' cannot be changed.", GlobalPref.getResourceValue("Warning"));

                tag.Value = iLastValue;

                return (false);
            }

            if (transEntryInfo.isStockRevaluation == true
                && iFieldId == transEntryGlobal.FieldHelper.iInvTagFieldId
                && iLastValue != iCurrentValue
                && EntryMainBody.getEditableRowsIndex(true).length > 0) {
                if (transEntryGlobal.confirmMessage("Change value will cause reset value of some body columns. Are you sure you want to continue?") == false) {
                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(id, iLastValue, null, objExtra);
                    tag.Value = iLastValue;

                    return;
                }

                EntryMainUI.resetBodyColumns(-1, [transEntryFieldInfo.BatchNo.ColumnIndex, transEntryFieldInfo.BalanceQty.ColumnIndex, transEntryFieldInfo.AvgRate.ColumnIndex, transEntryFieldInfo.BalanceStockValue.ColumnIndex, transEntryFieldInfo.NewAvgRate.ColumnIndex, transEntryFieldInfo.NewStockValue.ColumnIndex]);
            }
            else if (EntryMainUI.isReservationRestrictd(null, transEntryGlobal.FieldHelper.iInvTagFieldId) == true) {
                result = EntryMainUI.getLoadedData(transEntryGlobal.FieldHelper.iInvTagFieldId);
                if (result.Found == true && result.Value != iCurrentValue) {
                    transEntryGlobal.showAlert("This document is already used in link voucher. Due to reservation date cannot be changed.", GlobalPref.getResourceValue("Warning"));

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(id, iLastValue, null, objExtra);
                    tag.Value = iLastValue;

                    return;
                }
            }


            iMasterTypeId = OPTIONCONTROL.getMasterTypeId(id);
            if (iMasterTypeId > 0) {
                if(iMasterTypeId == transEntryInfo.PricebookTag) {
                    EntryMainMaster.changePriceBookTag(iFieldId, null, iLastValue);
                }
            }


            objSettings = transEntryInfo.Settings;

            if (iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                bResult = EntryMainBody.confrimAndReloadAllRowsRate(eVTFIELDID.FDF_HEADERCURRENCY, iLastValue, eMasterDataType.Master);
                if (bResult == false) {
                    return (false);
                }

                EntryMainMemoryObject.update(iFieldId, iCurrentValue, 0);
                EntryMain.m_bReloadAllRates = true;

                if (iLastValue != iCurrentValue) {
                    EntryMainUI.updateFlag(iFieldId);
                }

                if (EntryMainMaster.changeCurrencyH(iLastValue != iCurrentValue) == false) {
                    return;
                }
            }
            else if (iFieldId == eVTFIELDID.FDF_BOOKNO) {
                iAccountTypeId = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iAccountTypeId"));
                if (transEntryFieldInfo.Billwise.ColumnIndex > -1
                    && EntryMainCommon.isPartyType(iAccountTypeId) == true) {

                    transEntryGlobal.showAlert("Party type cannot be selected in header.", GlobalPref.getResourceValue("Error"));

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(tag.Control, 0, null, objExtra);
                    return;
                }

                if (EntryMainValidate.checkBothAccountIsPartyType(tag.Control, false, 0) > -1) {
                    transEntryGlobal.showAlert("Other account is already selected as party type.", GlobalPref.getResourceValue("Error"));

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(tag.Control, 0, null, objExtra);
                    return;
                }

                if (DataType.isValidObject(tag.CustomData) == false || tag.CustomData.bFromSetHeaderFieldsDefaultValue != true) {
                    if (tag.CustomData && DataType.isValidObject(tag.CustomData.CallingSource) == true) {
                        if (tag.CustomData.CallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage
                            || tag.CustomData.CallingSource == eDisplayBodyDataSource.LoadLink) {

                            arrData = transEntryData.getBody();
                            if (DataType.arrayLength(arrData) > 0) {
                                result = EntryMainCommon.findKeyValue(EntryMainUI.getBodyControlId(eVTFIELDID.FDF_LINK), arrData[0]);
                                if (result.lValue > 0) {
                                    arrData = DataType.stringToObject(result.data.Value).data;
                                    if (DataType.arrayLength(arrData) > 0) {
                                        lRefId = arrData[0].RefId;
                                    }
                                }
                            }
                        }
                    }
                    bResult = EntryMainCalculation.checkOverDue(tag.Value, EntryMain.m_objTrans.BodyData[0].FATag, lRefId);
                    if (bResult == false) {
                        objExtra = OPTIONCONTROL.createSetValueExtraObject();
                        objExtra.bIgnoreChangeCallback = true;
                        OPTIONCONTROL.setValue(tag.Control, 0, null, objExtra);
                        return;
                    }

                    bResult = EntryMainBody.confrimAndReloadAllRowsRate(eVTFIELDID.FDF_BOOKNO, iLastValue, eMasterDataType.Master);
                    if (bResult == false) {
                        return (false);
                    }

                    EntryMain.m_bReloadAllRates = true;
                }

                EntryMainMemoryObject.update(objMetaData.iFieldId, tag.Value, 0, objMetaData);
                EntryMainMaster.changeBookH(tag);
            }
            else if (iFieldId == eVTFIELDID.FDF_PMTTERMS) {
                EntryMainMaster.changePmtTermsH(tag);
            }
            else if (iFieldId == eVTFIELDID.FDF_CODE) {
                iAccountTypeId = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control, "iAccountTypeId"));
                if (transEntryFieldInfo.Billwise.ColumnIndex > -1
                    && EntryMainCommon.isPartyType(iAccountTypeId) == true) {

                    transEntryGlobal.showAlert("Party type cannot be selected in header.", GlobalPref.getResourceValue("Error"));

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(tag.Control, 0, null, objExtra);
                    return;
                }

                if (EntryMainValidate.checkBothAccountIsPartyType(tag.Control, true, 0) > -1) {
                    transEntryGlobal.showAlert("Other account is already selected as party type.", GlobalPref.getResourceValue("Error"));

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(tag.Control, 0, null, objExtra);
                    return;
                }

                EntryMainMaster.changeCodeH(tag);
            }
            else if (iFieldId == eVTFIELDID.FDF_PRODBATCH && OPTIONCONTROL.getControlValueLong(id).length > 0) {
                objWatch = new FStopWatch();
                objWatch.start();

                EntryMainProductionProcess.onProdBatch_Change(tag);

                objWatch.stop();
                transEntryGlobal.writeInfoLog("EntryMainProductionProcess.onProdBatch_Change(" + objWatch.getDifferenceString() + ").");
                objWatch = null;
            }
            else if (iFieldId == eVTFIELDID.FDF_PROD_PROCESS && iCurrentValue > 0) {
                EntryMainProductionProcess.onProdProcess_Change(tag);
            }
            else if (iFieldId == transEntryFieldInfo.FATag.FieldId) {
                EntryMainMaster.changeFATagH(tag, objMetaData);
                if (iFieldId == transEntryGlobal.FieldHelper.iInvTagFieldId) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, tag.Value, 0, objMetaData);
                    EntryMainMaster.changeInvTag(0, iFieldId);
                    EntryMainUI.valueChanged(objMetaData, 0, 0);
                }
            }
            else if (iFieldId == transEntryGlobal.FieldHelper.iInvTagFieldId) {
                EntryMainMemoryObject.update(objMetaData.iFieldId, tag.Value, 0, objMetaData);
                EntryMainMaster.changeInvTag(0, iFieldId);
                EntryMainUI.valueChanged(objMetaData, 0, 0);
            }
            else if (transEntryFieldInfo.AllocationTag.Area == eTranEntryFieldArea.Header
                && transEntryFieldInfo.AllocationTag.FieldId == iFieldId) {
                EntryMainMaster.changeAllocTagH(tag, iLastValue);
            }
            else if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Header
                && transEntryFieldInfo.SubLedger.FieldId == iFieldId) {
                EntryMainMaster.changeSubLedgerH(tag);
            }
            else if (transEntryInfo.isItTransfer == true
                && iFieldId == eVTFIELDID.FDF_HEADERINVTAG
                && transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header) {

                if (EntryMain.isDataLoading() == false) {
                    result = EntryMainValidate.isDuplicateStockTransferInvTag(iFieldId, DataType.getObjectFirstValue(tag.Data[0]));
                    if (result.lValue != 0) {
                        transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"));
                        OPTIONCONTROL.clear(id.id);

                        EntryMainMemoryObject.update(iFieldId, 0);
                        tag.Value = 0;
                    }

                    EntryMainMaster.changeInvTag(0, iFieldId);
                    EntryMainUI.valueChanged(objMetaData, 0, 0);
                }
            }
            else if (transEntryInfo.isItTransfer == true
                && iFieldId == eVTFIELDID.FDF_BODYINVTAG
                && transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header) {

                if (EntryMain.isDataLoading() == false) {
                    result = EntryMainValidate.isDuplicateStockTransferInvTag(iFieldId, DataType.getObjectFirstValue(tag.Data[0]));
                    if (result.lValue != 0) {
                        transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"));
                        OPTIONCONTROL.clear(id.id);

                        EntryMainMemoryObject.update(iFieldId, 0);
                        tag.Value = 0;
                    }

                    EntryMainMaster.changeInvTag(0, iFieldId);
                    EntryMainUI.valueChanged(objMetaData, 0, 0);
                }
            }

            if (EntryMain.isDataLoading() == false
                && DataType.isValidObject(transEntryInfo.Settings.VoucherScheme) == true
                && transEntryInfo.Settings.VoucherScheme.bEnableScheme == true
                && iMasterTypeId > 0 && iMasterTypeId == transEntryInfo.TagsPref.iSchemes) {

                    EntryMainScheme.removeScheme();
                    EntryMainScheme.applyScheme(0);
            }

            if (iLastValue != iCurrentValue) {

                EntryMainMaster.onMasterChanged(iLastValue, iCurrentValue, iFieldId, 0, 0);
                EntryMainBatch.validateBatchForMasterChange(iMasterTypeId);
            }

            if (EntryMain.isDataLoading() == false && transEntryFieldInfo.Billwise.FieldId > 0
                && objMetaData.iMasterTypeId > 0) {

                if (objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iARTagId || objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iAPTagId) {
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
                    }
                    else {
                        EntryMainBillwise.updateDirtyRowFlag(0, objMetaData.iFieldId);
                    }
                }
            }

            //EntryMainBody.processDataChange(0, 1, 0, iFieldId);
            EntryMainBody.processDataChange(iLastValue, iCurrentValue, 0, iFieldId);

            bLoadDependency = true;
            if (DataType.isValidObject(tag.CustomData) == true) {
                bLoadDependency = EntryMainDependency.isLoadDependencyBasedOnCallingSource(DataType.toInt(tag.CustomData.CallingSource));
            }

            if (objMetaData.iMasterTypeId == eMasterTypeId.Account) {
                if (bLoadDependency == true) {
                    EntryMainDependency.processAccountDependency(iFieldId, objMetaData.sFieldName, tag);
                }
            }
            else {
                if (bLoadDependency == true) {
                    EntryMainDependency.processOtherDependency(objMetaData.iFieldId, objMetaData.sFieldName, objMetaData.iMasterTypeId, tag);
                }
            }

            EntryMainHeader.updateViewInfoFields(EntryMainUI.extractHeaderFieldId(tag.Control.id), tag.Control);
            EntryMainHeader.setNewVoucherNo(false, OPTIONCONTROL.getMasterTypeId(tag.Control));

            if(DataType.isValidObject(tag.CustomData) == false 
                || DataType.isValidObject(tag.CustomData.CallingSource) == false 
                || (tag.CustomData.CallingSource != eDisplayBodyDataSource.LoadVoucher 
                    && tag.CustomData.CallingSource != eDisplayBodyDataSource.LoadLink 
                    && tag.CustomData.CallingSource != eDisplayBodyDataSource.LoadLinkFromHomePage)) {
                EntryMainHeader.checkAllHeaderFieldsForFormula();
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onDataChange_Master} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        EntryMain.m_bReloadAllRates = false;
    },

