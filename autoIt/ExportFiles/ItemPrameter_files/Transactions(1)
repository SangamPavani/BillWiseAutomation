    onDrop: function (evt) {
        try {
            if (evt.dataTransfer.items) {
                [...evt.dataTransfer.items].forEach((item, i) => {
                    // If dropped items aren't files, reject them
                    if (item.kind === 'file') {
                        let file = item.getAsFile();
                        EntryMainUI.LoadFromFile(file);
                    }
                });

                evt.preventDefault();
            }
            else {
                // Use DataTransfer interface to access the file(s)
                [...evt.dataTransfer.files].forEach((file, i) => {
                    EntryMainUI.LoadFromFile(file);
                });

                evt.preventDefault();
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.onDrop} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

