    editLayoutgetFieldsCustomizationCaption: function (element, data, tag) {
        let iFieldId = 0;

        if (element.value != "" && !isNaN(element.value.replace(/\s/g, ''))) {
            DocLayoutField_Customization.FieldName = "";
            COMMON.prototype.showMessage("Field name should be start with alphabets or underscore !!!", "Alert");
            return;
        }

        if (data.length > 0 && !editLayout_isFromViews) {
            iFieldId = data[0].ifieldid == undefined ? data[0].iFieldId : data[0].ifieldid;
            if (iFieldId != "") {
                var valueProp = OPTIONCONTROL.convertRawDataIntoObject(element, tag.Data);
                var EditLayout_FieldsCustomization_FieldDetails_Name = document.getElementById("EditLayout_FieldsCustomization_FieldDetails_Name");
                EditLayout_FieldsCustomization_FieldDetails_Name.value = valueProp.sFieldName;
                EditLayout_FieldsCustomization_FieldDetails_Name.disabled = true;
                var EditLayout_FieldsCustomization_FieldDetails_DataType = document.getElementById("EditLayout_FieldsCustomization_FieldDetails_DataType");
                EditLayout_FieldsCustomization_FieldDetails_DataType.value = valueProp.iDataTypeId;
                EditLayout_FieldsCustomization_FieldDetails_DataType.disabled = true;
                CONFIGURETRANS.editLayout_FieldsCustomization_changeMasterDataType(valueProp.iDataTypeId);
                if ((valueProp.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0
                    || (valueProp.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {

                    DocCustomization.Layout.showFilterCriteria(false);
                }
            }
            else {
                if (DocLayoutField_Customization.FieldId <= 0) {
                    //DocLayoutField_Customization.FieldName = element.value.replace(/\s/g, '');
                    DocLayoutField_Customization.FieldName = DocCustomization.getValidFieldName(element.value);
                }
                //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_Name").value = element.value.replace(/\s/g, '');
                var EditLayout_FieldsCustomization_FieldDetails_DataType = document.getElementById("EditLayout_FieldsCustomization_FieldDetails_DataType");
                EditLayout_FieldsCustomization_FieldDetails_DataType.disabled = false;
            }
        }
    },

