        obj.arrRules = arrRules;
        obj.sValue = sValue;
        obj.bLocal = DataType.toBoolean(bLocal);
        obj.iRow = DataType.toInt(iRow);
        obj.iColumn = DataType.toInt(iColumn);
        obj.iEvaluateOn = DataType.toInt(iEvaluateOn);
        obj.iFieldId = DataType.toInt(iFieldId);
        obj.FieldArea = eTranEntryFieldArea.None;
        obj.bCalculateNetFromMemory = false;
        obj.bDisableSaving = false;
        obj.bCellChangeDueToRule = false;
        obj.Master = {};
        obj.Master.bMaster = false;
        obj.Master.iMasterId = 0;
        obj.Master.sName = "";
        obj.Master.sCode = "";

        return (obj);
    },

    applyNew: function () {
        let iRules = 0;
        let iRuleBody = 0;
        let iRuleCondition = 0;
        let arrTemp = null;
        let objRuleInput = null;
        let objRules = null;
        let objRuleBody = null;
        let objRuleCondition = null;
        let objInfo = undefined;

        try {
            EntryMainRules.restoreOriginal();

            arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["NewRecord", "IsRuleActive"], [true, true], "===");
            if (DataType.arrayLength(arrTemp) > 0) {
                objRuleInput = EntryMainRules.getRuleInputObject(arrTemp, "", false, 0, 0, eRuleEvaluateOn.New);

                for (iRules = 0; iRules < arrTemp.length; iRules++) {
                    objRules = arrTemp[iRules];

                    for (iRuleBody = 0; iRuleBody < objRules.RuleBody.length; iRuleBody++) {
                        // Last index of RuleBody is for else
                        if (iRuleBody == objRules.RuleBody.length - 1) {
                        }
                        else {
                            objRuleBody = objRules.RuleBody[iRuleBody];

                            for (iRuleCondition = 0; iRuleCondition < objRuleBody.RuleCondition.length; iRuleCondition++) {
                                objRuleCondition = objRuleBody.RuleCondition[iRuleCondition];
                                objInfo = transEntryFieldInfo.getFromFieldId(objRuleCondition.FieldId, eTranEntryFieldArea.Header);
                                if (objInfo.Area == eTranEntryFieldArea.Header) {
                                    objRuleInput.FieldArea = eTranEntryFieldArea.Header;
                                    break;
                                }

                                objInfo = EntryMainUI.getBodyFieldInfo(objRuleCondition.FieldId);
                                if (objInfo.Area == eTranEntryFieldArea.Body) {
                                    objRuleInput.FieldArea = eTranEntryFieldArea.Body;
                                    break;
                                }
                            }
                        }

                        if (objRuleInput.FieldArea == eTranEntryFieldArea.Header) {
                            break;
                        }
                    }

                    if (objRuleInput.FieldArea == eTranEntryFieldArea.Header) {
                        break;
                    }
                }
                
                EntryMainRules.applyRule(objRuleInput);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.applyNew} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    applyEdit: function (bLoadVoucher) {
        let iRow = 0;
        let iCounter = 0;
        let iEvaluateOn = 0;
        let arrTemp = null;
        let arrFields = undefined;
        let objRuleInput = null;
        let objMetaData = null;
        let cell = null;

        try {
            bLoadVoucher = DataType.toBoolean(bLoadVoucher);

            EntryMainRules.restoreOriginal();

            if (bLoadVoucher == true) {
                arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["Edit", "Load", "IsRuleActive"], [true, true, true], "===");
            }
            else {
                if (transEntryInfo.HeaderId > 0) {
                    arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["Edit", "IsRuleActive"], [true, true], "===");
                }
                else {
                    arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["NewRecord", "IsRuleActive"], [true, true], "===");
                }                
            }


            if (DataType.arrayLength(arrTemp) > 0) {
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                    EntryMainHeader.applyRuleOnLostFocus(objMetaData.iFieldId, bLoadVoucher);
                }

                if (bLoadVoucher == true) {
                    arrFields = transEntryFieldInfo.getBodyFields();
                    for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                        if (EntryMainBody.isRowEditable(iRow) == false) {
                            continue;
                        }

                        for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                            cell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                            if (DataType.isValidObject(cell) == false) {
                                return;
                            }

                            objMetaData = arrFields[iCounter].MetaData;
                            EntryMainRules.cellLeaveRule(cell, objMetaData, bLoadVoucher);
                        }
                    }
                }

                iEvaluateOn = eRuleEvaluateOn.None;
                if (bLoadVoucher == true) {
                    iEvaluateOn = eRuleEvaluateOn.Load;
                }

                for (iCounter = 0; iCounter < arrTemp.length; iCounter++) {
                    if (arrTemp[iCounter].RuleBody.length > 1) {
                        continue;
                    }

                     // No Condition
                    objRuleInput = EntryMainRules.getRuleInputObject([arrTemp[iCounter]], "", false, 0, 0, iEvaluateOn);
                    EntryMainRules.applyRule(objRuleInput);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.applyEdit} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    beforeDelete: function() {
        let iCounter = 0;
        let arrTemp = null;
        let objRuleInput = null;
        let bResult = false;

        try {
            arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["BeforeDelete", "IsRuleActive"], [true, true], "===");

            if (DataType.arrayLength(arrTemp) > 0) {
                for (iCounter = 0; iCounter < arrTemp.length; iCounter++) {
                    if (arrTemp[iCounter].RuleBody.length > 1) {
                        continue;
                    }

                    // No Condition
                    objRuleInput = EntryMainRules.getRuleInputObject([arrTemp[iCounter]], "", false, 0, 0, eRuleEvaluateOn.Delete, 0);
                    bResult = EntryMainRules.applyRule(objRuleInput);
                    if (bResult == false) {
                        return (false);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.beforeDelete} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(true);
    },

    applyRule: function (objRuleInput) {
        let sCtrlId = "";
        let sResult = "";
        let iCounter = 0;
        let iCounterRules = 0;
        let iCounterTwo = 0;
        let iColIndex = 0;
        let iIndex = 0;
        let iTotal = 0;
        let bResultIsHeader = true;
        let bResultIsFooter = true;
        let bNoCondition = false;
        let bRefreshNet = false;
        let bRefreshReadOnlyColumn = false;
        let bCodeGroup = false;
        let bBookGroup = false;
        let bItemGroup = false;
        let objMetaData = null;
        let objControlMetaData = null;
        let objRules = null;
        let objRuleBody = null;
        let objRuleFormatting = null;
        let objLabel = null;
        let objControl = null;
        let objRow = null;
        let objColumn = null;
        let arrTemp = null;
        let arrBodyFields = undefined;
        let arrColumnGroupFilter = null;
        let arrFooterFields = undefined;
        let arrStyle = null;
        let arrValue = null;
        let arrLogKey = null;
        let arrLogValue = null;
        let value = null;
        let cell = null;
        let eleCtrl = null;
        let result = null;
        let objInfo = null;
        let objFont = undefined;

        try {
            if (transEntryGlobal.debugRule == true) {
                debugger
            }

            if (transEntryGlobal.EntryModel.CompanyFeatures.bRules == false) {
                return (false);
            }

            if (objRuleInput.iRow > 0) {
                if (EntryMainBody.isRowEditable(objRuleInput.iRow) == false) {
                    if (objRuleInput.iColumn == 0 || EntryMainBody.isColumnEditable(objRuleInput.iRow, objRuleInput.iColumn) == false) {
                        return (false);
                    }
                }
            }

            arrBodyFields = transEntryFieldInfo.getBodyFields();

            arrLogKey = [];
            arrLogValue = [];

            iTotal = DataType.arrayLength(objRuleInput.arrRules);
            for (iCounterRules = 0; iCounterRules < iTotal; iCounterRules++) {
                sResult = "";

                objRules = objRuleInput.arrRules[iCounterRules];
                if (objRules.IsRuleActive == false) {
                    continue;
                }

                for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody.length; iCounterTwo++) {
                    // Last index of RuleBody is for else
                    if (iCounterTwo == objRules.RuleBody.length - 1) {
                        if (iCounterTwo == 0 && objRuleInput.iRow == 0) {
                            bNoCondition = true;
                        }
                        sResult = "1";
                    }
                    else {
                        objRuleBody = objRules.RuleBody[iCounterTwo];
                        result = EntryMainRules.evaluateRuleCondition(objRuleBody.RuleCondition,
                                        objRuleInput.iRow,
                                        objRuleInput.bLocal,
                                        objRuleInput.sValue,
                                        objRuleInput.Master,
                                        objRuleInput.iFieldId);
                        sResult = result.sResult;
                    }

                    if (sResult == "1") {
                        arrLogKey.push("RuleName");
                        arrLogValue.push(objRules.RuleName);

                        if (DataType.isNullOrEmpty(objRuleInput.sFieldName, true) == false) {
                            arrLogKey.push("FieldName");
                            arrLogValue.push(objRuleInput.sFieldName);
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.New) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("New");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Edit) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Edit");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Load) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Load");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Leave) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Leave");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Enter) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Enter");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Delete) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Delete");
                        }

                        if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Save) > 0) {
                            arrLogKey.push("EvaluateOn");
                            arrLogValue.push("Save");
                        }


                        break;
                    }
                }

                iIndex = iCounterTwo; // This is the index of the if/else tab which has evaluated to true
                objRuleBody = objRules.RuleBody[iIndex];
                if (DataType.isNullOrEmpty(objRuleBody.GeneralMessage) == false) {
                    switch (objRuleBody.MessageType) {
                        case 0: // Info
                            if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.New) > 0 && objRuleInput.arrRules[0].Load == false) {
                                break;
                            }

                            transEntryGlobal.showAlert(objRuleBody.GeneralMessage, GlobalPref.getResourceValue("Alert"));
                            break;
                        case 1: // Warn
                            if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.New) > 0 && objRuleInput.arrRules[0].Load == false) {
                                break;
                            }

                            if (transEntryGlobal.confirmMessage(objRuleBody.GeneralMessage) == false) {
                                if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Load) > 0) {
                                    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                                }

                                return (false);
                            }
                            break;
                        case 2: // Stop
                            if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.New) > 0) {
                                break;
                            }

                            transEntryGlobal.showAlert(objRuleBody.GeneralMessage, GlobalPref.getResourceValue("Alert"));

                            if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Enter) > 0
                                || (objRuleInput.iEvaluateOn & eRuleEvaluateOn.Leave) > 0) {

                                break;
                            }


                            //if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Load) > 0) {
                            //    EntryMainToolbar.enableButton(eEntryMainButton.Save, false);
                            //}

                            objRuleInput.bDisableSaving = true;

                            return (false);
                    }
                }

                if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Delete) > 0) {
                    return(true);
                }

                iColIndex = 0;
                for (iCounterTwo = 0; iCounterTwo < DataType.arrayLength(objRuleBody.RuleFormatting); iCounterTwo++) {
                    bResultIsFooter = false;
                    bResultIsHeader = false;

                    bCodeGroup = false;
                    bBookGroup = false;
                    bItemGroup = false;

                    objRuleFormatting = objRuleBody.RuleFormatting[iCounterTwo];

                    if (objRuleFormatting.FieldId == eVTFIELDID.FDF_DOCUMENTNO) { // Document No
                        arrTemp = DataType.arrayFilterData(transEntryGlobal.EntryModel.MetaData.Header, "iFieldId", eVTFIELDID.FDF_DOCUMENTNO, "==");
                        if (arrTemp.length > 0) {
                            objMetaData = arrTemp[0];
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            objLabel = EntryMainUI.getHeaderControlLabelElement(sCtrlId);
                            if (DataType.isValidObject(objLabel) == true) {
                                objControl = sCtrlId;
                                objControlMetaData = objMetaData;
                            }

                            bResultIsHeader = true;
                        }
                    }
                    else {
                        for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                            if (objMetaData.iFieldId == objRuleFormatting.FieldId) {
                                bResultIsHeader = true;
                                break;
                            }
                            else if (objRuleFormatting.FieldId == eVTFIELDID.FDF_CODEGROUP && (objMetaData.iFieldId == eVTFIELDID.FDF_CODE || objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE)) {
                                bResultIsHeader = true;
                                bCodeGroup = true;
                                break;
                            }
                            else if (objRuleFormatting.FieldId == eVTFIELDID.FDF_BOOKGROUP && (objMetaData.iFieldId == eVTFIELDID.FDF_BOOKNO || objMetaData.iFieldId == eVTFIELDID.FDF_BODYBOOKNO)) {
                                bResultIsHeader = true;
                                bBookGroup = true;
                                break;
                            }
                        }

                        if (iCounter == transEntryGlobal.EntryModel.MetaData.Header.length) {
                            objInfo = transEntryFieldInfo.getFromFieldId(objRuleFormatting.FieldId, eTranEntryFieldArea.Footer);
                            if (objInfo.Area == eTranEntryFieldArea.Footer) {
                                iCounter = objInfo.MetaDataIndex;
                                bResultIsFooter = true;
                                arrFooterFields = transEntryFieldInfo.getFooterFields();
                            }
                        }

                        if (bResultIsHeader == false && bResultIsFooter == false)   // Field not found in header, now check in body
                        {                            
                            for (iCounter = 0; iCounter < arrBodyFields.length; iCounter++) {
                                objMetaData = arrBodyFields[iCounter].MetaData;
                                if (objMetaData.iFieldId == objRuleFormatting.FieldId) {
                                    break;
                                }
                                else if (objRuleFormatting.FieldId == eVTFIELDID.FDF_ITEMGROUP && objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                                    bItemGroup = true;
                                    break;
                                }
                                else if (objRuleFormatting.FieldId == eVTFIELDID.FDF_CODEGROUP && (objMetaData.iFieldId == eVTFIELDID.FDF_CODE || objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE)) {
                                    bCodeGroup = true;
                                    break;
                                }
                                else if (objRuleFormatting.FieldId == eVTFIELDID.FDF_BOOKGROUP && (objMetaData.iFieldId == eVTFIELDID.FDF_BOOKNO || objMetaData.iFieldId == eVTFIELDID.FDF_BODYBOOKNO)) {
                                    bBookGroup = true;
                                    break;
                                }
                            }

                            if (iCounter == arrBodyFields.length) {
                                return (true);
                            }

                            iColIndex = iCounter;
                        }

                        if (bResultIsHeader == true) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                            objLabel = EntryMainUI.getHeaderControlLabelElement(sCtrlId);
                            if (DataType.isValidObject(objLabel) == true) {
                                objControl = sCtrlId;
                                objControlMetaData = objMetaData;
                            }
                        }
                        else if (bResultIsFooter == true) {
                            objMetaData = arrFooterFields[iCounter];
                            sCtrlId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);

                            objLabel = EntryMainUI.getHeaderControlLabelElement(sCtrlId);
                            if (DataType.isValidObject(objLabel) == true) {
                                objControl = sCtrlId;
                                objControlMetaData = objMetaData;
                            }
                        }
                    }

                    if (objRuleFormatting.Font != null) {
                        objFont = transEntryServer.byteArrayToObject(objRuleFormatting.Font);
                        if (DataType.isValidObject(objFont)) {
                            if (bResultIsHeader || bResultIsFooter) {
                                if (DataType.isValidObject(objLabel) == true) {
                                    FUIElement.setFont(objLabel, objFont);
                                }
                            }
                            else {
                                //if (objRuleInput.iRow > 0 && objRuleInput.iColumn > 0 && objRuleInput.iFieldId > 0) {
                                //    transEntryGrid.applyFontOnRowCell(objRuleInput.iRow, iCounter, objFont);
                                //}
                                //else {
                                //    if (bNoCondition == true || (objRuleInput.iEvaluateOn & eRuleEvaluateOn.Load) == 0) {
                                //        transEntryGlobal.m_RuleFontColumn = iCounter + transEntryGrid.ExtraColumn;
                                //        transEntryGrid.applyFontOnCell(iCounter, objFont);
                                //    }
                                //}

                                transEntryGlobal.m_RuleFontColumn = iCounter + transEntryGrid.ExtraColumn;
                                transEntryGrid.applyFontOnCell(iCounter, objFont, objRuleInput.FieldArea, objRuleInput.iRow);
                            }
                        }                        
                    }

                    if (bResultIsHeader == true || bResultIsFooter == true) {
                        if (DataType.isValidObject(objLabel) == true) {
                            switch (objRuleFormatting.Alignment) {
                                case 0: // None;
                                    break;
                                case 1: // Left
                                    objLabel.parentElement.style.textAlign = "left";
                                    break;
                                case 2:
                                    objLabel.parentElement.style.textAlign = "center";
                                    break;
                                case 3:
                                    objLabel.parentElement.style.textAlign = "right";
                                    break;
                            }
                        }

                        if (DataType.isNullOrEmpty(objRuleFormatting.Caption) == false) {
                            FUIElement.setText(objLabel, objRuleFormatting.Caption);
                        }

                        transEntryControl.hideLabel(objLabel, objRuleFormatting.Hidden);

                        arrStyle = [];
                        arrValue = [];

                        arrStyle.push("Visibility");
                        arrValue.push(objRuleFormatting.Hidden);

                        arrStyle.push("Enabled");
                        arrValue.push(!objRuleFormatting.Enabled); // Convert disabled to enabled before store in array

                        if (DataType.isNullOrEmpty(objRuleFormatting.RegularExpression, true) == false) {
                            eleCtrl = FUIElement.getValidElement(objControl);
                            if (DataType.isValidObject(eleCtrl) == true) {
                                value = null;
                                switch (objMetaData.iDataTypeId) {
                                    case eMasterDataType.Number:
                                    case eMasterDataType.BigNumber:
                                    case eMasterDataType.SmallNumber:
                                    case eMasterDataType.TinyNumber:
                                        value = DataType.toInt(eleCtrl.value);
                                        break;
                                    case eMasterDataType.Fraction:
                                        value = DataType.toDecimal(eleCtrl.value);
                                        break;
                                    case eMasterDataType.Text:
                                        value = eleCtrl.value;
                                        break;
                                    case eMasterDataType.Master:
                                    case eMasterDataType.ExternalTable:
                                        value = DataType.toString(OPTIONCONTROL.getControlText(eleCtrl));
                                        break;
                                    case eMasterDataType.StringList:
                                        value = "";
                                        if (eleCtrl.selectedIndex >= 0) {
                                            value = eleCtrl.options[eleCtrl.selectedIndex].text;
                                        }
                                        break;
                                    case eMasterDataType.NumberList:
                                        value = "";
                                        if (eleCtrl.selectedIndex >= 0) {
                                            value = DataType.toInt(eleCtrl.options[eleCtrl.selectedIndex].value);
                                        }
                                        break;
                                    case eMasterDataType.Date:
                                        value = DATEPICKER.getText(eleCtrl);
                                        break;
                                    case eMasterDataType.Time:
                                        value = FTIMECONTROL.getText(eleCtrl);
                                        break;

                                }

                                arrStyle.push("ErrorMessage");
                                if (value != null && EntryMainCommon.isMatch(objRuleFormatting.RegularExpression, value) == false) {
                                    arrValue.push(objRuleFormatting.ErrorMessage);
                                }
                                else {
                                    arrValue.push("");
                                }
                            }
                        }


                        arrStyle.push("CharacterCasing");
                        arrValue.push(objRuleFormatting.CharacterCasing);

                        arrStyle.push("BannerText");
                        arrValue.push(objRuleFormatting.BannerText);

                        arrStyle.push("ToolTip");
                        arrValue.push(objRuleFormatting.ToolTip);

                        arrStyle.push("Mandatory");
                        arrValue.push(objRuleFormatting.Mandatory);

                        objMetaData.bMandatory = objRuleFormatting.Mandatory;

                        objMetaData.bReadOnly = objRuleFormatting.Enabled;
                        if (bResultIsHeader == true) {
                            transEntryFieldInfo.updateHeaderMetaData(iCounter, objMetaData);
                        }
                        else if (bResultIsFooter == true) {
                            transEntryGlobal.EntryModel.MetaData.Footer[iCounter] = objMetaData;
                        }


                        EntryMainUI.setControlStyleBasedOnDataType(objControl, arrStyle, arrValue, { sFieldName: objControlMetaData.sFieldName, iDataTypeId: objControlMetaData.iDataTypeId, iBehaviour: objControlMetaData.iBehaviour });
                    }
                    else { // Body
                        if (DataType.isNullOrEmpty(objRuleFormatting.Caption) == false) {
                            cell = transEntryGrid.getCellObject(0, iCounter);
                            if (DataType.isValidObject(cell) == true) {
                                cell.setCellText(objRuleFormatting.Caption);
                            }
                        }

                        bRefreshReadOnlyColumn = false;
                        objMetaData = arrBodyFields[iColIndex].MetaData;
                        objMetaData.bHidden = objRuleFormatting.Hidden;

                        if (bNoCondition == true || (objRuleInput.iRow == 0 && objRuleInput.iColumn == 0)) {
                            objMetaData.bMandatory = objRuleFormatting.Mandatory;
                            objMetaData.bReadOnly = objRuleFormatting.Enabled;

                            transEntryGrid.markColumn(iColIndex, objMetaData.bReadOnly);
                            EntryMainRules.makeCellControlReadonly(objMetaData);
                        }

                        //objMetaData.bMandatory = objRuleFormatting.Mandatory;

                        if (objRuleInput.FieldArea == eTranEntryFieldArea.Header && objMetaData.bReadOnly != objRuleFormatting.Enabled) {
                            bRefreshReadOnlyColumn = true;
                            objMetaData.bReadOnly = objRuleFormatting.Enabled;
                        }

                        //objMetaData.bReadOnly = objRuleFormatting.Enabled;
                        transEntryGlobal.setBodyMetaDataObject(arrBodyFields[iColIndex].MetaDataIndex, objMetaData);

                        if (objRuleInput.iColumn == (iColIndex + transEntryGrid.gridExtraColumn())) {
                            objRuleInput.bCellChangeDueToRule = true;
                            transEntryGlobal.m_bCellChangeDueToRule = true;
                            transEntryGrid.update();
                            transEntryGlobal.m_bCellChangeDueToRule = false;
                        }
                        ////transEntryGrid.update();
                        FGRIDCONTROL.hideColumn(transEntryGrid.getGridId(), iColIndex + transEntryGrid.gridExtraColumn(), objMetaData.bHidden);

                        if (DataType.toInt(objRuleInput.iRow) > 0) {
                            cell = transEntryGrid.getCellObject(objRuleInput.iRow, iColIndex);
                            EntryMainRules.makeCellMandatory(cell, objRuleFormatting.Mandatory);
                            EntryMainRules.makeCellReadonly(cell, objRuleFormatting.Enabled == true);
                        }

                        if (bRefreshReadOnlyColumn == true) {
                            transEntryGrid.markColumn(iColIndex, objMetaData.bReadOnly);
                        }
                    }

                    if ((objRuleInput.iEvaluateOn & eRuleEvaluateOn.Save) == 0) {
                        switch (objRuleFormatting.ValueType) {
                            case eMasterCompareWith.None:
                                if (bResultIsHeader == true || bResultIsFooter == true) {
                                    if (DataType.isValidObject(objControl) == true) {
                                        if (bCodeGroup == true || bBookGroup == true || bItemGroup == true) {
                                            OPTIONCONTROL.setGroupId(objControl, 0);
                                        }
                                    }
                                }
                                else {
                                    objMetaData = arrBodyFields[iColIndex].MetaData;
                                    if (objRuleInput.iRow > 0 && objRuleInput.iRow <= transEntryGrid.getTotalRows()) {
                                        if (bCodeGroup == true || bBookGroup == true || bItemGroup == true) {
                                            arrColumnGroupFilter = transEntryGrid.getColumnGroupFilterObject(objRuleInput.iRow);
                                            if (arrColumnGroupFilter.length > 0) {
                                                transEntryGrid.removeColumnGroupFilter(arrColumnGroupFilter[0],
                                                                    iColIndex + transEntryGrid.gridExtraColumn());
                                            }
                                        }
                                    }
                                    else if(objRuleInput.iRow < 1) {
                                        if (bCodeGroup == true || bBookGroup == true || bItemGroup == true) {
                                            arrColumnGroupFilter = transEntryGrid.getColumnGroupFilterObject(-1);
                                            if (arrColumnGroupFilter.length > 0) {
