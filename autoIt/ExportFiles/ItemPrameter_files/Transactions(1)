    convertBodyLayoutToKeyValue: function(objIdNamePair, objMetaData, iConvertSource, sId) {
        let objTemp = null;
        let body = null;

        try {
            if (iConvertSource == eConvertTransactionObjectSource.CopyDocument 
                || iConvertSource == eConvertTransactionObjectSource.PasteFromClipboard 
                || iConvertSource == eConvertTransactionObjectSource.LoadInvoiceNoData) {

                if (objIdNamePair.Name == objMetaData.sFieldName) {
                    if(objMetaData.iDataTypeId == eMasterDataType.Picture 
                        || objMetaData.iDataTypeId == eMasterDataType.DocumentViewer) {

                        if(DataType.isValidObject(objIdNamePair.Tag) == true) {

                            if(DataType.isValidObject(objIdNamePair.Tag.arrData) == true) {
                                objTemp = objIdNamePair.Tag;
                            }
                            else {
                                objTemp = {};
                                objTemp.sFileName = objIdNamePair.Tag.FileName;

                                if (DataType.isNullOrEmpty(objTemp.sFileName) == true
                                    && DataType.isNullOrEmpty(objIdNamePair.Tag.sFileName) == false) {
                                    objTemp.sFileName = objIdNamePair.Tag.sFileName;
                                }

                                if (DataType.isValidObject(objIdNamePair.Tag.FileData) == false
                                    && DataType.isString(objIdNamePair.Tag.sData) == true
                                    && DataType.isNullOrEmpty(objIdNamePair.Tag.sData) == false) {

                                    objTemp.arrData = [objIdNamePair.Tag.sData];
                                }


                                if(DataType.isArray(objIdNamePair.Tag.FileData) == true) {
                                    objTemp.arrData = objIdNamePair.Tag.FileData;
                                }
                                else {
                                    if(DataType.isValidObject(objIdNamePair.Tag.FileData) == true) {
                                        // Byte array is converted into base 64 string when return from api, so reverse calculation.
                                        objTemp.arrData = LZUTF8.decodeBase64(objIdNamePair.Tag.FileData);
                                    }
                                    else if(DataType.isString(objIdNamePair.Tag) == true) {
                                        objIdNamePair.Tag = DataType.stringToObject(objIdNamePair.Tag).data;
                                        if(DataType.isValidObject(objIdNamePair.Tag) == true) {
                                            objTemp.sFileName = objIdNamePair.Tag.sFileName;

                                            objTemp.arrData = DataType.arrayFromCSV(objIdNamePair.Tag.sData);
                                        }
                                    }
                                }
                            }

                            if(DataType.isValidObject(objTemp) == true && DataType.isValidObject(objTemp.arrData) == true) {
                                if(DataType.isArray(objTemp.arrData) == false) {
                                    // Byte array is converted into base 64 string when return from api, so reverse calculation.
                                    objTemp.arrData = LZUTF8.decodeBase64(objTemp.arrData);
                                }
                            }

                            body = {};
                            body.Key = sId;
                            body.Value = objTemp;
                        }
                    }
                    else {
                        body = {};
                        body.Key = sId;
                        body.Value = objIdNamePair.Tag;
                    }
                }
            }
            else {
                if (objIdNamePair.ID == objMetaData.iFieldId) {
                    if(objMetaData.iDataTypeId == eMasterDataType.Picture 
                        || objMetaData.iDataTypeId == eMasterDataType.DocumentViewer) {

                        if(DataType.isValidObject(objIdNamePair.Tag) == true) {

                            if(DataType.isValidObject(objIdNamePair.Tag.arrData) == true) {
                                objTemp = objIdNamePair.Tag;
                            }
                            else {
                                objTemp = {};
                                objTemp.sFileName = objIdNamePair.Tag.FileName;
                                if (DataType.isNullOrEmpty(objTemp.sFileName, true) == true
                                    && DataType.isNullOrEmpty(objIdNamePair.Tag.sFileName, true) == false) {

                                    objTemp.sFileName = objIdNamePair.Tag.sFileName;
                                }

                                if(DataType.isArray(objIdNamePair.Tag.FileData) == true) {
                                    objTemp.arrData = objIdNamePair.Tag.FileData;
                                }
                                else {
                                    if (DataType.isValidObject(objIdNamePair.Tag.FileData) == true) {
                                        // Byte array is converted into base 64 string when return from api, so reverse calculation.
                                        objTemp.arrData = LZUTF8.decodeBase64(objIdNamePair.Tag.FileData);
                                    }
                                    else if (DataType.isNullOrEmpty(objIdNamePair.Tag.sData) == false) {
                                        objTemp.sData = objIdNamePair.Tag.sData;
                                    }
                                }
                            }

                            if(DataType.isValidObject(objTemp) == true && DataType.isValidObject(objTemp.arrData) == true) {
                                if(DataType.isArray(objTemp.arrData) == false) {
                                    // Byte array is converted into base 64 string when return from api, so reverse calculation.
                                    objTemp.arrData = LZUTF8.decodeBase64(objTemp.arrData);
                                }
                            }

                            body = {};
                            body.Key = sId;
                            body.Value = objTemp;
                        }
                    }
                    else {
                        body = {};
                        body.Key = sId;
                        body.Value = objIdNamePair.Tag;
                    }
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{transEntryData.convertBodyLayoutToKeyValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (body);
    },

    updateStockTransferInvTag: function(objData, arrInvTag) {
        let sId = "";
        let iCounter = 0;
        let objKeyValue = null;

        try {
            if(DataType.isValidObject(objData) == false) {
                return;
            }

            if(DataType.arrayLength(arrInvTag) < 1) {
                return;
            }

            if (transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.None
                || transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.None) {

                return;
            }

            if (transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERINVTAG);
                objKeyValue = EntryMainCommon.findKeyValue(sId, objData.Header);
                if (objKeyValue.lValue > 0) {
                    objKeyValue.data.Value = arrInvTag[arrInvTag.length - 1].InvTag;
                }
                else {
                    objKeyValue = {};
                    objKeyValue.Key = sId;
                    objKeyValue.Value = arrInvTag[arrInvTag.length - 1].InvTag;

                    objData.Header.push(objKeyValue);
                }
            }
            else {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_HEADERINVTAG);

                for(iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                    objKeyValue = EntryMainCommon.findKeyValue(sId, objData.Body[iCounter]);
                    if (objKeyValue.lValue > 0) {
                        objKeyValue.data.Value = arrInvTag[iCounter].InvTag;
                    }
                    else {
                        objKeyValue = {};
                        objKeyValue.Key = sId;
                        objKeyValue.Value = arrInvTag[iCounter].InvTag;

                        objData.Body[iCounter].push(objKeyValue);
                    }
                }
            }


            if (transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BODYINVTAG);
                objKeyValue = EntryMainCommon.findKeyValue(sId, objData.Header);
                if (objKeyValue.lValue > 0) {
                    objKeyValue.data.Value = arrInvTag[arrInvTag.length - 1].InvTag2;
                }
                else {
                    objKeyValue = {};
                    objKeyValue.Key = sId;
                    objKeyValue.Value = arrInvTag[arrInvTag.length - 1].InvTag2;

                    objData.Header.push(objKeyValue);
                }
            }
            else {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYINVTAG);

                for(iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                    objKeyValue = EntryMainCommon.findKeyValue(sId, objData.Body[iCounter]);
                    if (objKeyValue.lValue > 0) {
                        objKeyValue.data.Value = arrInvTag[iCounter].InvTag2;
                    }
                    else {
                        objKeyValue = {};
                        objKeyValue.Key = sId;
                        objKeyValue.Value = arrInvTag[iCounter].InvTag2;

                        objData.Body[iCounter].push(objKeyValue);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.updateStockTransferInvTag} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

