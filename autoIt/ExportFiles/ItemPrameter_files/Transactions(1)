        let cell = null;
        let obj = null;

        try {
            eleGrid = StockRevaluationBatch.getGridElement();
            iTotal = FGRIDCONTROL.getTotalRows(eleGrid);

            for (iRow = 1; iRow <= iTotal; iRow++) {
                cell = StockRevaluationBatch.getCheckBoxCell(iRow);
