                            COMMON.prototype.showMessage("Rejection remark is mandatory for row no " + iRow, "Error");
                            return;
                        }

                        obj.Remarks = sRemark;
                    }

                    arrReject.push(obj);
                }
            }

            if (arrAuthorize.length == 0 && arrStop.length == 0 && arrReject.length == 0) {
                return;
