    getBinOrderBySetting: function (arrBinDetails, BinDistance, bInward) {
        let iCounter = 0;
        let arrData = null;

        try {
            switch(BinDistance) {
                case eBinDistance.Closest:
                case eBinDistance.Farthest:
                case eBinDistance.ClosestfromTop:
                case eBinDistance.ClosestfromBtm:
                case eBinDistance.FarthestfromTop:
                case eBinDistance.FarthestfromBtm:
                    arrData = [];
                    for (iCounter = 0; iCounter < BinsUI.m_arrSortedBinIds.length; iCounter++) {
                        if (BinsUI.m_arrSortedBinIds[iCounter].ID == BinDistance) {
                            arrData.push(BinsUI.m_arrSortedBinIds[iCounter]);
                        }
                    }

                    if(arrData.length > 0) {
                        // Removes the elements that are not present in arrBinDetails , because some Bins can be remove from the list after filling
                        arrData = BinsUI.getSortedArray(arrData[0].Tag, arrBinDetails);
                        arrBinDetails = arrData.slice(0)
                    }
                break;
            }

            if (bInward) {
                if (BinsUI.m_Preference.Bins.iPartialBinInward == 1){
                    arrBinDetails.sort(BinsUI.compareValues('Quantity', 'desc'));
                }
            }
            else {
                if (BinsUI.m_Preference.Bins.iPartialBinOutward == 1) { // Partial Bin
                    arrBinDetails.sort(BinsUI.compareValues('FreeSpace', 'desc'));
                }

                if (BinsUI.m_Preference.Bins.bIssueFromBinBasedOnFIFO == true) { // Fifo
                    for (iCounter = 0; iCounter < arrBinDetails.length; iCounter++) {
                        if (arrBinDetails[iCounter].Manufacturedate > 0){
                            arrBinDetails.sort(BinsUI.compareValues('Manufacturedate', 'desc'));
                            break;
                        }
                    }
                }
            }

            arrBinDetails = BinsUI.validateBins(arrBinDetails);
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.getBinOrderBySetting} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrBinDetails);
    },

    compareValues: function (key, order) {
        return function(a, b) {
            let comparison = 0;

            if(!a.hasOwnProperty(key) || !b.hasOwnProperty(key)) {
                return 0;
            }

            const varA = (typeof a[key] === 'string') ? a[key].toUpperCase() : a[key];
            const varB = (typeof b[key] === 'string') ? b[key].toUpperCase() : b[key];

            if (varA > varB) {
                comparison = 1;
            }
            else if (varA < varB) {
                comparison = -1;
            }

            return ((order == 'desc') ? (comparison * -1) : comparison);
        };
    },

