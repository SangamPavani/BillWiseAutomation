        try {
            if (bSuccess == false) {
                return;
            }

            if (typeof html === 'string') {
                selectedVoucherType = undefined;
                COMMON.prototype.showMessage("Voucher deleted successfully", "Success");
                DocCustomization.callbackCreateVoucher(true, html, true);

