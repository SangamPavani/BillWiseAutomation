        let iIndex = 0;
        let iRow = 0;
        let iTotalRows = 0;
        let bValidRow = false;
        let objBody = null;
        let arrBodyIndex = undefined;
        let objMetaData = undefined;
        let obj = undefined;

        try {
            objTrans.BodyData = [];

            arrBodyIndex = [];
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataBodyIndex.length; iCounter++) {
                iIndex = transEntryGlobal.EntryModel.arrMetaDataBodyIndex[iCounter];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];

                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_CODE:
                    case eVTFIELDID.FDF_BODYCODE:
                    case eVTFIELDID.FDF_BOOKNO:
                    case eVTFIELDID.FDF_BODYBOOKNO:
                    case eVTFIELDID.FDF_DUEDATE:
                    case eVTFIELDID.FDF_BODYDUEDATE:
                    case eVTFIELDID.FDF_HEADERCURRENCY:
                    case eVTFIELDID.FDF_BODYCURRENCY:
                    case eVTFIELDID.FDF_EXCHANGERATE:
                    case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    case eVTFIELDID.FDF_LOCEXCHANGERATE:
                    case eVTFIELDID.FDF_FATAG:
                    case eVTFIELDID.FDF_INVTAG:
                    case eVTFIELDID.FDF_HEADERINVTAG:
                    case eVTFIELDID.FDF_BODYAMOUNT:
                    case eVTFIELDID.FDF_BODYPRODUCT:
                    case eVTFIELDID.FDF_BODYUNITS:
                    case eVTFIELDID.FDF_BODYQUANTITY:
                    case eVTFIELDID.FDF_BODYALTQUANTITY:
                    case eVTFIELDID.FDF_BALANCEQTY: // For Stock Revaluation Voucher
                    case eVTFIELDID.FDF_AVGRATE: // For Stock Revaluation Voucher
                    case eVTFIELDID.FDF_BALANCESTKVAL: // For Stock Revaluation Voucher
                    case eVTFIELDID.FDF_NEWAVGRATE: // For Stock Revaluation Voucher
                    case eVTFIELDID.FDF_NEWSTKVAL: // For Stock Revaluation Voucher
