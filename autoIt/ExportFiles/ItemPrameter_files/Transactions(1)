                arrAvlBatch = [];
            }

            EntryMainUI.afterLinkDataLoad(arrNewRowIndex, arrAvlBatch, arrLPNumber, objServerData.LinkId, tag.bFromWorkflow);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.loadLinkTransactionDocumentData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    deleteVoucher: function (bSuccess, data) {
        let iCount = 0;

        try {
            if (bSuccess == false) {
                return;
            }

            if (data.lValue < 1) {
                transEntryGlobal.showAlert(data.sValue, GlobalPref.getResourceValue("Error"));
                return;
            }
            else {
                transEntryGlobal.showAlert(data.sValue, "Message");

                data = data.data;

                if(DataType.isValidObject(data) == true && data.Deleted === false) {
                    return;
                }

                //transEntryGlobal.clear(true, false);
            }

            iCount = transEntryExternalModule.callExternalModule(eVoucherExternalModuleEvents.AfterDelete,
                                                            0,
                                                            "",
                                                            0,
                                                            0,
                                                            "EntryMainCallback.externalModuleAfterDelete");

            if (iCount == 0) { // If no external module found
                EntryMainCallback.externalModuleAfterDelete([]);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.deleteVoucher} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    saveVoucherInBackground: function(data) {
        let sMessage = "";
        let sKey = "";
        let iCounter = 0;
        let iTotal = 0;
        let arrData = undefined;
        let arrBody = undefined;
        let objTransData = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugCallback == true || transEntryGlobal.debugSave == true) {
                debugger
            }

            if(data.lValue > 0) {
                if(DataType.isNullOrEmpty(data.data.sTriggerMessage, true) == false) {
                    transEntryGlobal.showAlert(data.data.sTriggerMessage, "Error in trigger");
                }

                if (DataType.isNullOrEmpty(data.sValue) == false) {
                    transEntryGlobal.showAlert(data.sValue, "Warning");
                }

                sMessage = GlobalPref.getResourceValue("VoucherSavedSucessfully") + " : <strong>" + data.data.SavedVoucherNo + "</strong>";
                transEntryGlobal.showAlert(sMessage, "Message");         
            }
            else {
                objTransData = data.data.TransData;

                iTotal = objTransData.Body.length;
                if(transEntryInfo.isItTransfer == true) {
                    iTotal = DataType.div(iTotal, 2);
                }

                arrData = [];
                for (sKey in objTransData.Header) {
                    if (DataType.isNullOrEmpty(sKey) == true) {
                        continue;
                    }

                    obj = {};
                    obj.Key = sKey;
                    obj.Value = objTransData.Header[sKey];
                    arrData.push(obj);
                }

                objTransData.Header = arrData;

                arrBody = [];
                for(iCounter = 0; iCounter < iTotal; iCounter++) {
                    arrData = [];
                    for (sKey in objTransData.Body[iCounter]) {
                        if (DataType.isNullOrEmpty(sKey) == true) {
                            continue;
                        }

                        obj = {};
                        obj.Key = sKey;
                        obj.Value = objTransData.Body[iCounter][sKey];
                        arrData.push(obj);
                    }
                    arrBody.push(arrData);
                }
                objTransData.Body = arrBody;

                if(DataType.isValidObject(objTransData.Footer) == true) {
                    arrData = [];
                    for (sKey in objTransData.Footer) {
                        if (DataType.isNullOrEmpty(sKey) == true) {
                            continue;
                        }

                        obj = {};
