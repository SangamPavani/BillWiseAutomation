    onSubLedger_Leave: function (cellobj, iFieldId) {
        let iLastValue = 0;
        let iCurrentValue = 0;
        let iAccountTypeId = 0;
        let iDefaultCurrency = 0;
        let bMasterChanged = false;
        let data = null;

        try {
            iLastValue = DataType.toInt(cellobj.getCellData());

            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
            iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);

            bMasterChanged = iCurrentValue != iLastValue;

            EntryMainMemoryObject.update(iFieldId, iCurrentValue, cellobj.iRow);

            if (bMasterChanged == true && transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body
                && transEntryFieldInfo.Billwise.ColumnIndex > -1) {

                iAccountTypeId = EntryMainMemoryObject.getCodeTypeId(cellobj.iRow);
