                else if (objLocalExchangeRateInfo.Area == eTranEntryFieldArea.Body
                    && objMetaData.iFieldId == eVTFIELDID.FDF_LOCEXCHANGERATE) {

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PDCHeader:
                            transEntryGlobal.arrBodyReadOnly.push(obj.MetaDataIndex);
                            sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            if (DataType.isValidObject(eleCtrl) == true) {
                                eleCtrl.readOnly = true;
                            }

                            transEntryGrid.markColumn(objLocalExchangeRateInfo.ColumnIndex, true);
                            break;
                    }
                }
                else if (objChequeNoInfo.Area == eTranEntryFieldArea.Body
                    && objMetaData.iFieldId == objChequeNoInfo.FieldId) {
                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PDCHeader:
                            transEntryGlobal.arrBodyReadOnly.push(obj.MetaDataIndex);
                            transEntryChequeNo.disableControl(true);
                            transEntryGrid.markColumn(objChequeNoInfo.ColumnIndex, true);
                            break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.applyUIRestriction} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    removeUIRestriction: function () {
        let iCounter = 0;
        let iIndex = 0;
        let objMetaData = null;

        try {
            for (iCounter = 0; iCounter < transEntryGlobal.arrHeaderReadOnly.length; iCounter++) {
                iIndex = transEntryGlobal.arrHeaderReadOnly[iCounter];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iIndex];

                objMetaData.bReadOnly = false;
                transEntryFieldInfo.updateHeaderMetaData(iIndex, objMetaData);

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Master:
                        OPTIONCONTROL.disableControl(sId, false);
                        break;
                    case eMasterDataType.Date:
                        DATEPICKER.disableControl(sId, false);
                        break;
                    case eMasterDataType.Fraction:
                    case eMasterDataType.Number:
                    case eMasterDataType.Text:
                        eleCtrl = document.getElementById(sId);
                        if (DataType.isValidObject(eleCtrl) == true) {
                            eleCtrl.readOnly = false;
                            transEntryControl.setBackgroundColor(eleCtrl, "");
                        }
                        break;
                }
            }

            for (iCounter = 0; iCounter < transEntryGlobal.arrBodyReadOnly.length; iCounter++) {
                iIndex = transEntryGlobal.arrBodyReadOnly[iCounter];
                objMetaData = transEntryGlobal.getBodyMetaDataObject(iIndex);

                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Master:
                        OPTIONCONTROL.disableControl(sId, false);
                        break;
                    case eMasterDataType.Date:
                        DATEPICKER.disableControl(sId, false);
                        break;
                    case eMasterDataType.Fraction:
                    case eMasterDataType.Number:
                        eleCtrl = document.getElementById(sId);
                        if (DataType.isValidObject(eleCtrl) == true) {
                            eleCtrl.readOnly = false;
                            transEntryControl.setBackgroundColor(eleCtrl, "");
                        }
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.removeUIRestriction} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
        finally {
            transEntryGlobal.arrHeaderReadOnly = [];
            transEntryGlobal.arrBodyReadOnly = [];

            transEntryGlobal.m_iUIRestriction = eTranEntryUIRestriction.None;
        }
    },

