    resultBatch: function(bSuccess, arrBatchList, sCustomData) {
        let iCounter = 0;
        let iCounter1 = 0;
        let iTotal = 0;
        let iIndex = 0;
        let iAddedRow = 0;
        let arrTransactionIds = null;
        let arrBatchBody = null;
        let arrBatch = null;
        let arrBody = null;
        let arrIndex = null;
        let result = null;

        try {
            if (transEntryGlobal.debugBatch == true) {
                debugger
            }

            if(bSuccess == false) {
                return;
            }

            arrTransactionIds = [];

            iTotal = DataType.arrayLength(arrBatchList);
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                arrBatchList[iCounter].BatchId = DataType.toInt(arrBatchList[iCounter].BatchId);
                arrBatchList[iCounter].Qty = DataType.toDecimal(arrBatchList[iCounter].Qty);
                arrBatchList[iCounter].BatchRate = DataType.toDecimal(arrBatchList[iCounter].BatchRate);

                if (DataType.isValidObject(arrBatchList[iCounter].QtyAdjusted) == true) {
                    arrBatchList[iCounter].QtyAdjusted = DataType.toDecimal(arrBatchList[iCounter].QtyAdjusted);
                }
                else {
                    arrBatchList[iCounter].QtyAdjusted = arrBatchList[iCounter].Qty;
                }

                arrTransactionIds.push(arrBatchList[iCounter].BatchId);
            }

            arrIndex = [];
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                for(iIndex = 0; iIndex < arrIndex.length; iIndex++) {
                    if(arrIndex[iIndex].iRowNo == arrBatchList[iCounter].iRowNo) {
                        break;
                    }
                }

                if(iIndex == arrIndex.length) {
                    result = {};
                    result.iRowNo = arrBatchList[iCounter].iRowNo;
                    result.arrIndex = [];
                    result.arrIndex.push(iCounter);
                    arrIndex.push(result);
                }
                else {
                    arrIndex[iIndex].arrIndex.push(iCounter);
                }
            }

            result = transEntryServer.getBodyDataByBatchId(arrTransactionIds, false);
            if (result.lValue > 0) {
                arrBatchBody = [];
                if (result.data.lValue > 0) {
                    arrBatchBody = result.data.data;
                }

                if (DataType.isNullOrEmpty(result.data.sValue, true) == false) {
                    transEntryGlobal.writeErrorLog(result.data.sValue, "Error: {EntryMainAutoAllocate.resultBatch} ");
                }
            }
            else {
                arrBatchBody = [];
            }

            for(iIndex = 0; iIndex < arrIndex.length; iIndex++) {
                result = arrIndex[iIndex];

                arrBatch = [];
                arrBody = [];

                for(iCounter = 0; iCounter < result.arrIndex.length; iCounter++) {
                    arrBatch.push(arrBatchList[result.arrIndex[iCounter]]);

                    for (iCounter1 = 0; iCounter1 < arrBatchBody.length; iCounter1++) {
                        if(arrBatch[iCounter].BatchId == arrBatchBody[iCounter1].Sales.BatchNo.BatchId) {
                            arrBody.push(arrBatchBody[iCounter1]);
                            break;
                        }
                    }
                }

                EntryMainBatch.processBatchData(result.iRowNo + iAddedRow, arrBatch, arrBody, null, true);

                iAddedRow += (result.arrIndex.length - 1);
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainAutoAllocate.resultBatch} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

