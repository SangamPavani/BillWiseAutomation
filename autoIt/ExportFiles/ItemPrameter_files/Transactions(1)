                    dAmt1 = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[0], objTransaction.BodyData[iRow].ExchangeRate);
                    if (EntryMain.m_bSupportBigNumber == false) {
                        dAmt1 = transEntry.rectifyAmountValue(dAmt1);
                    }
                    objTransaction.BodyData[iRow].Amounts[0] = dAmt1;


                    dAmt2 = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[1], objTransaction.BodyData[iRow].ExchangeRate);
                    if (EntryMain.m_bSupportBigNumber == false) {
                        dAmt2 = transEntry.rectifyAmountValue(dAmt2);
                    }
                    objTransaction.BodyData[iRow].Amounts[1] = dAmt2;
                }


                objTransaction.BodyData[iRow].Amounts[0] = FNumberOperation.mul(EntryMain.FRoundOff(FNumberOperation.abs(objTransaction.BodyData[iRow].Amounts[0]), EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType), DataType.sign(objTransaction.BodyData[iRow].Amounts[0]));
                objTransaction.BodyData[iRow].Amounts[1] = FNumberOperation.mul(EntryMain.FRoundOff(FNumberOperation.abs(objTransaction.BodyData[iRow].Amounts[1]), EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType), DataType.sign(objTransaction.BodyData[iRow].Amounts[1]));

                if (DataType.toDecimal(objTransaction.BodyData[iRow].ExchangeRate) == 1) {
                    objTransaction.BodyData[iRow].OriginalAmounts[0] = objTransaction.BodyData[iRow].Amounts[0];
                    objTransaction.BodyData[iRow].OriginalAmounts[1] = objTransaction.BodyData[iRow].Amounts[1];
                }


                dAmt1 = FNumberOperation.sub(dAmt1, objTransaction.BodyData[iRow].Amounts[0]);
                dAmt2 = FNumberOperation.sub(dAmt2, objTransaction.BodyData[iRow].Amounts[1]);

                dAmt1 = EntryMainCalculation.validateMinDecimal(dAmt1);
                dAmt2 = EntryMainCalculation.validateMinDecimal(dAmt2);

                if (objTransaction.BodyData[iRow].Flags.TransferToPnL
                    || objTransaction.BodyData[iRow].RowType == _RowType.ExchangeDiff 
                    || objTransaction.BodyData[iRow].RowType == _RowType.PaymentTerms) {

                    dAmt1 = 0;
                    dAmt2 = 0;
                }


                lstIndexDone.push(iRow);

                if (iMaskedVoucherType == eVTTYPE.JOURN) {
                    dAmt1 = 0;
                    dAmt2 = 0;
                }

                for (iCounter = iRow + 1; iCounter < objTransaction.BodyData.length; iCounter++)
                {
                    if (objTransaction.BodyData[iCounter].Code != objTransaction.BodyData[iRow].Code
                        || objTransaction.BodyData[iCounter].Book != objTransaction.BodyData[iRow].Book) {
                        continue;
                    }

                    if (!objTransaction.BodyData[iCounter].Flags.TransferToPnL
                        && objTransaction.BodyData[iCounter].RowType != _RowType.ExchangeDiff
                        && objTransaction.BodyData[iCounter].RowType != _RowType.PaymentTerms) {

                        if (objTransaction.BodyData[iCounter].OriginalAmounts[0] == 0
                            && objTransaction.BodyData[iCounter].OriginalAmounts[1] == 0
                            && objTransaction.BodyData[iCounter].RowType != _RowType.Default)
                            continue;
                    }

                    if (!objTransaction.BodyData[iRow].Flags.TransferToPnL 
                        && objTransaction.BodyData[iRow].RowType != _RowType.ExchangeDiff 
                        && objTransaction.BodyData[iRow].RowType != _RowType.PaymentTerms) {

                        dAmt1 = FNumberOperation.add(FNumberOperation.mul(objTransaction.BodyData[iCounter].OriginalAmounts[0], objTransaction.BodyData[iCounter].ExchangeRate), dAmt1);
                        if(FNumberOperation.isNaN(dAmt1) == true) {
                            dAmt1 = 0;
                        }
                        objTransaction.BodyData[iCounter].Amounts[0] = dAmt1;

                        dAmt2 = FNumberOperation.add(FNumberOperation.mul(objTransaction.BodyData[iCounter].OriginalAmounts[1], objTransaction.BodyData[iCounter].ExchangeRate), dAmt2);
                        if(FNumberOperation.isNaN(dAmt2) == true) {
                            dAmt2 = 0;
                        }
                        objTransaction.BodyData[iCounter].Amounts[1] = dAmt2;
                    }

                    objTransaction.BodyData[iCounter].Amounts[0] = FNumberOperation.mul(EntryMain.FRoundOff(FNumberOperation.abs(objTransaction.BodyData[iCounter].Amounts[0]), EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType), DataType.sign(objTransaction.BodyData[iCounter].Amounts[0]));
                    objTransaction.BodyData[iCounter].Amounts[1] = FNumberOperation.mul(EntryMain.FRoundOff(FNumberOperation.abs(objTransaction.BodyData[iCounter].Amounts[1]), EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType), DataType.sign(objTransaction.BodyData[iCounter].Amounts[1]));

                    if (DataType.toDecimal(objTransaction.BodyData[iCounter].ExchangeRate) == 1) {
                        objTransaction.BodyData[iCounter].OriginalAmounts[0] = objTransaction.BodyData[iCounter].Amounts[0];
                        objTransaction.BodyData[iCounter].OriginalAmounts[1] = objTransaction.BodyData[iCounter].Amounts[1];
                    }


                    if (!objTransaction.BodyData[iRow].Flags.TransferToPnL 
                        && objTransaction.BodyData[iRow].RowType != _RowType.ExchangeDiff 
                        && objTransaction.BodyData[iRow].RowType != _RowType.PaymentTerms) {

                        dAmt1 = FNumberOperation.sub(dAmt1, objTransaction.BodyData[iCounter].Amounts[0]);
                        dAmt2 = FNumberOperation.sub(dAmt2, objTransaction.BodyData[iCounter].Amounts[1]);

                        dAmt1 = EntryMainCalculation.validateMinDecimal(dAmt1);
                        dAmt2 = EntryMainCalculation.validateMinDecimal(dAmt2);
                    }

                    lstIndexDone.push(iCounter);
                    if (iMaskedVoucherType == eVTTYPE.JOURN) {
                        dAmt1 = 0;
                        dAmt2 = 0;
                    }
                }
            }

            // region Set positive/negative signs
            for (iRow = 0; iRow < objTransaction.BodyData.length; iRow++) {
                if (transEntryInfo.isItSales == true) {
                    if (objTransaction.BodyData[iRow].Sales != null) {
                        if (transEntryInfo.isInwardVoucher == false
                            && iMaskedVoucherType != eVTTYPE.WDONE
                            && transEntryInfo.isItTransfer == false) {
                            objTransaction.BodyData[iRow].Sales.BaseQuantity = FNumberOperation.mul(objTransaction.BodyData[iRow].Sales.BaseQuantity, -1);
                            objTransaction.BodyData[iRow].Sales.AlternateQuantity = FNumberOperation.mul(objTransaction.BodyData[iRow].Sales.AlternateQuantity, -1);
                            objTransaction.BodyData[iRow].Sales.Quantity = FNumberOperation.mul(objTransaction.BodyData[iRow].Sales.Quantity, -1);
                        }
                    }

                    if (transEntryInfo.isItNegative == true
                        || (iMaskedVoucherType == eVTTYPE.WDONE
                            && DataType.isValidObject(objTransaction.BodyData[iRow].Sales) == true
                            && objTransaction.BodyData[iRow].Sales.BaseQuantity > 0)) { // This determines whether Amount[0] will be negative or not

                        objTransaction.BodyData[iRow].Amounts[0] = FNumberOperation.mul(objTransaction.BodyData[iRow].Amounts[0], -1);
                        objTransaction.BodyData[iRow].OriginalAmounts[0] = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[0], -1);
                        transEntryGrid.notifyOrgAmtChange(iRow, 0, objTransaction.BodyData[iRow].OriginalAmounts[0]);
                    }
                    else {
                        objTransaction.BodyData[iRow].Amounts[1] = FNumberOperation.mul(objTransaction.BodyData[iRow].Amounts[1], -1);
                        objTransaction.BodyData[iRow].OriginalAmounts[1] = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[1], -1);
                        transEntryGrid.notifyOrgAmtChange(iRow, 1, objTransaction.BodyData[iRow].OriginalAmounts[1]);
                    }
                }
                else if (objTransaction.BodyData[iRow].RowType == _RowType.AccountToPost) {
                    if (transEntryInfo.isItNegative == true) // This determines whether Amount[0] will be negative or not
                    {
                        objTransaction.BodyData[iRow].Amounts[0] = FNumberOperation.mul(objTransaction.BodyData[iRow].Amounts[0], -1);
                        objTransaction.BodyData[iRow].OriginalAmounts[0] = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[0], -1);
                        transEntryGrid.notifyOrgAmtChange(iRow, 0, objTransaction.BodyData[iRow].OriginalAmounts[0]);
                    }
                    else {
                        objTransaction.BodyData[iRow].Amounts[1] = FNumberOperation.mul(objTransaction.BodyData[iRow].Amounts[1], -1);
                        objTransaction.BodyData[iRow].OriginalAmounts[1] = FNumberOperation.mul(objTransaction.BodyData[iRow].OriginalAmounts[1], -1);
                        transEntryGrid.notifyOrgAmtChange(iRow, 1, objTransaction.BodyData[iRow].OriginalAmounts[1]);
                    }
                }
            }
            // End region Set positive/negative signs



            if (iMaskedVoucherType == eVTTYPE.JOURN || iMaskedVoucherType == eVTTYPE.OPBAL) {
                iDefaultBook = iMaskedVoucherType == eVTTYPE.JOURN ? 1 : 2;
                for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                    if (objTransaction.BodyData[iCounter].RowType == _RowType.Default || objTransaction.BodyData[iCounter].Book <= 0) {
                        objTransaction.BodyData[iCounter].Book = iDefaultBook;
                    }
                }
            }

            if (EntryMain.m_Settings.Misc.DetailedPosting == false) {
                arrTempBody = objTransaction.BodyData;

                for (iRow = arrTempBody.length - 1; iRow > 0; iRow--)
                {
                    if (arrTempBody[iRow].RowType == _RowType.COGS) {
                        continue;
                    }

                    for (iIndex = iRow - 1; iIndex >= 0; iIndex--) {
                        if (arrTempBody[iRow].Code == arrTempBody[iIndex].Code 
                            && arrTempBody[iRow].Book == arrTempBody[iIndex].Book 
                            && arrTempBody[iRow].FATag == arrTempBody[iIndex].FATag 
                            && arrTempBody[iRow].InvTag == arrTempBody[iIndex].InvTag) {

                            if (DataType.isValidObject(arrTempBody[iRow].Tags) == false 
                                || DataType.isValidObject(arrTempBody[iIndex].Tags) == false) {
                                continue;
                            }

                            if (arrTempBody[iRow].Tags.length != arrTempBody[iIndex].Tags.length) {
                                continue;
                            }

                            for (iCounter = 0; iCounter < arrTempBody[iIndex].Tags.length; iCounter++) {
                                if (DataType.toInt(arrTempBody[iRow].Tags[iCounter].Tag) != DataType.toInt(arrTempBody[iIndex].Tags[iCounter].Tag)) {
                                    break;
                                }
                            }

                            if (iCounter == arrTempBody[iIndex].Tags.length) { // got another matching row, add to this
                                arrTempBody[iIndex].OriginalAmounts[0] = FNumberOperation.add(arrTempBody[iIndex].OriginalAmounts[0], arrTempBody[iRow].OriginalAmounts[0]);
                                if (EntryMain.m_bSupportBigNumber == false) {
                                    arrTempBody[iIndex].OriginalAmounts[0] = transEntry.rectifyAmountValue(arrTempBody[iIndex].OriginalAmounts[0]);
                                }
                                transEntryGrid.notifyOrgAmtChange(iIndex, 0, arrTempBody[iIndex].OriginalAmounts[0]);

                                arrTempBody[iRow].OriginalAmounts[0] = 0;
                                transEntryGrid.notifyOrgAmtChange(iRow, 0, 0);

                                arrTempBody[iIndex].Amounts[0] = FNumberOperation.add(arrTempBody[iIndex].Amounts[0], arrTempBody[iRow].Amounts[0]);
                                if (EntryMain.m_bSupportBigNumber == false) {
                                    arrTempBody[iIndex].Amounts[0] = transEntry.rectifyAmountValue(arrTempBody[iIndex].Amounts[0]);
                                }
                                arrTempBody[iRow].Amounts[0] = 0;


                                arrTempBody[iIndex].OriginalAmounts[1] = FNumberOperation.add(arrTempBody[iIndex].OriginalAmounts[1], arrTempBody[iRow].OriginalAmounts[1]);
                                if (EntryMain.m_bSupportBigNumber == false) {
                                    arrTempBody[iIndex].OriginalAmounts[1] = transEntry.rectifyAmountValue(arrTempBody[iIndex].OriginalAmounts[1]);
                                }
                                transEntryGrid.notifyOrgAmtChange(iIndex, 1, arrTempBody[iIndex].OriginalAmounts[1]);

                                arrTempBody[iRow].OriginalAmounts[1] = 0;
                                transEntryGrid.notifyOrgAmtChange(iRow, 1, 0);

                                arrTempBody[iIndex].Amounts[1] = FNumberOperation.add(arrTempBody[iIndex].Amounts[1], arrTempBody[iRow].Amounts[1]);
                                arrTempBody[iRow].Amounts[1] = 0;

                                if (arrTempBody[iIndex].LocalCurrencyData != null && arrTempBody[iRow].LocalCurrencyData != null)
                                {
                                    arrTempBody[iIndex].LocalCurrencyData.Amounts[0] = FNumberOperation.add(arrTempBody[iIndex].LocalCurrencyData.Amounts[0], arrTempBody[iRow].LocalCurrencyData.Amounts[0]);
                                    arrTempBody[iRow].LocalCurrencyData.Amounts[0] = 0;

                                    arrTempBody[iIndex].LocalCurrencyData.Amounts[1] = FNumberOperation.add(arrTempBody[iIndex].LocalCurrencyData.Amounts[1], arrTempBody[iRow].LocalCurrencyData.Amounts[1]);
                                    arrTempBody[iRow].LocalCurrencyData.Amounts[1] = 0;
                                }
                                break;
                            }
                        }
                    }
                }

                objTransaction.BodyData = arrTempBody;
            }

            if (EntryMain.m_bRoundOff == false) { // Roundoff At Final Level Selected
                iGridRow = 0;
                iRowGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(1);
                iRowRoundingType = transEntryCurrency.getRoundingType(1);
                for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                    if (objTransaction.BodyData[iCounter].RowType == _RowType.Default) {
                        iGridRow++;

                        if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Body) {
                            if (EntryMain.m_objTrans.BodyData[iGridRow - 1].CurrencyId > 0) {
                                iRowGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(iGridRow);
                                iRowRoundingType = transEntryCurrency.getRoundingType(iGridRow);
                            }
                            else {
                                iRowGeneralRoundOff = EntryMain.m_dGeneralRoundOff;
                                iRowRoundingType = EntryMain.m_iRoundingType;
                            }
                        }
                    }

                    objTransaction.BodyData[iCounter].Amounts[0] = EntryMain.FRoundOff(objTransaction.BodyData[iCounter].Amounts[0], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                    objTransaction.BodyData[iCounter].Amounts[1] = EntryMain.FRoundOff(objTransaction.BodyData[iCounter].Amounts[1], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);

                    if (objTransaction.BodyData[iCounter].Sales) {
                        objTransaction.BodyData[iCounter].Sales.OrigGross = EntryMain.FRoundOff(objTransaction.BodyData[iCounter].Sales.OrigGross, EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                        objTransaction.BodyData[iCounter].Sales.Gross = EntryMain.FRoundOff(objTransaction.BodyData[iCounter].Sales.Gross, EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                    }
                    
                    dOrgAmount = objTransaction.BodyData[iCounter].OriginalAmounts[0];
                    dOrgAmount = EntryMain.FRoundOff(dOrgAmount, iRowGeneralRoundOff, iRowRoundingType);

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dOrgAmount = transEntry.rectifyAmountValue(dOrgAmount);
                    }

                    objTransaction.BodyData[iCounter].OriginalAmounts[0] = dOrgAmount;
                    transEntryGrid.notifyOrgAmtChange(iCounter, 0, dOrgAmount);

                    if (objTransaction.BodyData[iCounter].RowType == _RowType.Default) {
                        transEntryGrid.setRowData(iGridRow, eRowDataName.OriginalAmount0, dOrgAmount, true);
                    }


                    dOrgAmount = objTransaction.BodyData[iCounter].OriginalAmounts[1];
                    dOrgAmount = EntryMain.FRoundOff(dOrgAmount, iRowGeneralRoundOff, iRowRoundingType);

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dOrgAmount = transEntry.rectifyAmountValue(dOrgAmount);
                    }
                    objTransaction.BodyData[iCounter].OriginalAmounts[1] = dOrgAmount;
                    transEntryGrid.notifyOrgAmtChange(iCounter, 1, dOrgAmount);

                    if (objTransaction.BodyData[iCounter].RowType == _RowType.Default) {
                        transEntryGrid.setRowData(iGridRow, eRowDataName.OriginalAmount1, dOrgAmount, true);
                    }

                    if (DataType.isZero(objTransaction.BodyData[iCounter].OriginalAmounts[0]) == true) {
                        objTransaction.BodyData[iCounter].Amounts[0] = 0;
                    }

                    if (DataType.isZero(objTransaction.BodyData[iCounter].OriginalAmounts[1]) == true) {
                        objTransaction.BodyData[iCounter].Amounts[1] = 0;
                    }
                }
            }

            iRet = EntryMainCalculation.CalcNet(objTransaction, objInput.arrCodeTypes, objInput.arrBookTypes);
            if(iRet != 0) {
                if (iRet == 1) {
                    transEntryGlobal.showAlert("Exchange gain account not defined. Set it in preference to continue.", "Error");
                }
                else if (iRet == 2) {
                    transEntryGlobal.showAlert("Exchange loss account not defined. Set it in preference to continue.", "Error");
                }

                return(false);
            }

            for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                objBody = objTransaction.BodyData[iCounter];
                if (objBody.RowType != _RowType.Default) {
                    if (DataType.isZero(objBody.OriginalAmounts[0]) == true
                        && DataType.isZero(objBody.OriginalAmounts[1]) == true
                        && DataType.isZero(objBody.Amounts[0]) == true
                        && DataType.isZero(objBody.Amounts[1]) == true) {

                        objTransaction.BodyData.splice(iCounter, 1);
                        objInput.arrBookTypes.splice(iCounter, 1);
                        objInput.arrCodeTypes.splice(iCounter, 1);
                        iCounter--;
                    }
                }
            }

            objInput.objTrans = objTransaction;

            iGridRow = 0;
            for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                if (objTransaction.BodyData[iCounter].RowType == _RowType.Default) {
                    iGridRow++;

                    transEntryGrid.setRowData(iGridRow, eRowDataName.OriginalAmount0, objTransaction.BodyData[iCounter].OriginalAmounts[0], true);
                    transEntryGrid.setRowData(iGridRow, eRowDataName.OriginalAmount1, objTransaction.BodyData[iCounter].OriginalAmounts[1], true);

                    transEntryGrid.setRowData(iGridRow, eRowDataName.Amount0, objTransaction.BodyData[iCounter].Amounts[0], true);
                    transEntryGrid.setRowData(iGridRow, eRowDataName.Amount1, objTransaction.BodyData[iCounter].Amounts[1], true);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in fillFinal method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.fillFinal} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(true);
    },

    CalcNet: function (objTrans, arrCodeTypes, arrBookTypes) {
        let iCounter = 0;
        let iIndex = 0;
        let iAccountId = 0;
        let iDefaultCurrencyId = 0;
        let dBaseNet = 0;
        let dTransNet = 0;
        let dCalcBase = 0;
        let dDiff = 0;
        let dDr = 0;
        let dCr = 0;
        let bOutward = false;
        let objBody = null;
        let objIdNamePair = null;

        try {
            if (objTrans.BodyData.length == 0) {
                return (0);
            }

            iDefaultCurrencyId = GlobalPref.DefaultCurrency.CurrencyId;
            if (transEntryInfo.isItSales == true && transEntryInfo.isItTransfer == false) {

                for (iCounter = 0; iCounter < objTrans.BodyData.length; iCounter++) {
                    if (objTrans.BodyData[iCounter].Book == objTrans.BodyData[0].Book) {
                        if (objTrans.BodyData[iCounter].RowType != _RowType.ExchangeDiff) {
                            if (EntryMain.m_bSupportBigNumber == true) {
                                dBaseNet = FNumberOperation.add(dBaseNet, objTrans.BodyData[iCounter].Amounts[1]);
                            }
                            else {
                                dBaseNet += transEntry.rectifyAmountValue(objTrans.BodyData[iCounter].Amounts[1]);
                            }
                        }

                        if (EntryMain.m_bSupportBigNumber == true) {
                            dTransNet = FNumberOperation.add(dTransNet, objTrans.BodyData[iCounter].OriginalAmounts[1]);
                        }
                        else {
                            dTransNet += transEntry.rectifyAmountValue(objTrans.BodyData[iCounter].OriginalAmounts[1]);
                        }
                    }
                }

                if (transEntryInfo.isItSales == true) {
                    dCalcBase = 0;
                    if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                        dCalcBase = FConvert.roundOff(FNumberOperation.mul(dTransNet, objTrans.BodyData[0].ExchangeRate), EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                    }
                    else {
                        dCalcBase = FNumberOperation.mul(dTransNet, objTrans.BodyData[0].ExchangeRate);
                    }


                    if (dCalcBase != dBaseNet
                        && FNumberOperation.isGreaterThanOrEqualTo(FNumberOperation.abs(FNumberOperation.sub(dCalcBase, dBaseNet)), EntryMain.m_dGeneralRoundOff) == true) {
                        dDiff = FNumberOperation.sub(dCalcBase, dBaseNet);
                        dDiff = EntryMainCalculation.validateMinDecimal(dDiff);
                        bOutward = true;
                        if (DataType.gt(dCalcBase, 0) == true) {
                            bOutward = false;
                        }

                        iIndex = 0;

                        if (bOutward) {
                            if (DataType.gt(objTrans.BodyData[iIndex].Amounts[1], 0) == true) {
                                objTrans.BodyData[iIndex].Amounts[1] = FNumberOperation.sub(objTrans.BodyData[iIndex].Amounts[1], dDiff);
                            }
                            else {
                                objTrans.BodyData[iIndex].Amounts[1] = FNumberOperation.add(objTrans.BodyData[iIndex].Amounts[1], dDiff);
                            }
                        }
                        else {
                            if (FNumberOperation.isGreaterThan(objTrans.BodyData[iIndex].Amounts[1], 0) == true) {
                                objTrans.BodyData[iIndex].Amounts[1] = FNumberOperation.add(objTrans.BodyData[iIndex].Amounts[1], dDiff);
                            }
                            else {
                                objTrans.BodyData[iIndex].Amounts[1] = FNumberOperation.sub(objTrans.BodyData[iIndex].Amounts[1], dDiff);
                            }
                        }

                        objTrans.BodyData[iIndex].Amounts[1] = EntryMain.FRoundOff(objTrans.BodyData[iIndex].Amounts[1], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                        dBaseNet = dCalcBase;
                    }
                }

                dDr = 0;
                dCr = 0;
                for (iCounter = 0; iCounter < objTrans.BodyData.length; iCounter++) {
                    if (FNumberOperation.isGreaterThan(objTrans.BodyData[iCounter].Amounts[0], 0) == true) {
                        dCr = FNumberOperation.add(dCr, objTrans.BodyData[iCounter].Amounts[0]);
                    }

                    if (FNumberOperation.isGreaterThan(objTrans.BodyData[iCounter].Amounts[1], 0) == true) {
                        dCr = FNumberOperation.add(dCr, objTrans.BodyData[iCounter].Amounts[1]);
                    }

                    if (FNumberOperation.isLessThan(objTrans.BodyData[iCounter].Amounts[0], 0) == true) {
                        dDr = FNumberOperation.add(dDr, objTrans.BodyData[iCounter].Amounts[0]);
                    }

                    if (FNumberOperation.isLessThan(objTrans.BodyData[iCounter].Amounts[1], 0) == true) {
                        dDr = FNumberOperation.add(dDr, objTrans.BodyData[iCounter].Amounts[1]);
                    }
                }

                if (EntryMain.m_bSupportBigNumber == false) {
                    dDr = transEntry.rectifyAmountValue(dDr);
                    dCr = transEntry.rectifyAmountValue(dCr);

                }

                if (FNumberOperation.isNotEqualTo(dDr, dCr) == true
                    && FNumberOperation.isNotEqualTo(FNumberOperation.abs(FNumberOperation.add(dDr, dCr)), 0) == true) {

                    dDiff = FNumberOperation.abs(FNumberOperation.add(dDr, dCr));

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dDiff = transEntry.rectifyAmountValue(dDiff);
                    }

                    if (objTrans.BodyData[0].CurrencyId == 0 || objTrans.BodyData[0].CurrencyId == iDefaultCurrencyId) {
                        if (FNumberOperation.isGreaterThan(FNumberOperation.negated(dDr), dCr) == true) {
                            // Reduce -ve
                            if (FNumberOperation.isGreaterThan(objTrans.BodyData[0].Amounts[0], 0) == true) {
                                objTrans.BodyData[0].Amounts[0] = FNumberOperation.add(objTrans.BodyData[0].Amounts[0], dDiff);
                            }
                            else {
                                objTrans.BodyData[0].Amounts[0] = FNumberOperation.add(objTrans.BodyData[0].Amounts[0], dDiff);
                            }
                        }
                        else {
                            // Reduce +ve, incr -ve
                            if (FNumberOperation.isGreaterThan(objTrans.BodyData[0].Amounts[0], 0) == true) {
                                objTrans.BodyData[0].Amounts[0] = FNumberOperation.sub(objTrans.BodyData[0].Amounts[0], dDiff);
                            }
                            else {
                                objTrans.BodyData[0].Amounts[0] = FNumberOperation.sub(objTrans.BodyData[0].Amounts[0], dDiff);
                            }
                        }
                    }
                    else {
                        iAccountId = 0;

                        if (FNumberOperation.isGreaterThan(FNumberOperation.negated(dDr), dCr) == true) {
                            iAccountId = transEntryInfo.AccountPref.iForeignExchangeGainAccount;
                            if (iAccountId <= 0) {
                                return (1);
                            }
                        }
                        else {
                            iAccountId = transEntryInfo.AccountPref.iForeignExchangeLossAccount;
                            if (iAccountId <= 0) {
                                return (2);
                            }
                        }

                        if (iAccountId > 0) {
                            objBody = transactionDataStructure.getEmptyTransBodyObject();;
                            objBody.RowType = _RowType.ExchangeDiff;
                            objBody.MainBodyId = objTrans.BodyData[0].BodyId > 0 ? objTrans.BodyData[0].BodyId : -iCounter;

                            if (objBody.MainBodyId == 0) {
                                objBody.MainBodyId = -2147483648;
                            }


                            objBody.Code = objTrans.BodyData[0].Code;
                            objBody.Book = iAccountId;


                            if (FNumberOperation.isGreaterThan(FNumberOperation.negated(dDr), dCr) == true) {
                                objBody.Amounts[1] = dDiff;
                            }
                            else {
                                objBody.Amounts[1] = FNumberOperation.negated(dDiff);
                            }

                            objBody.FATag = objTrans.BodyData[0].FATag;
                            objBody.InvTag = objTrans.BodyData[0].InvTag;
                            objBody.Tags = objTrans.BodyData[0].Tags;
                            objBody.CurrencyId = objTrans.BodyData[0].CurrencyId;
                            objBody.ExchangeRate = objTrans.BodyData[0].ExchangeRate;
                            objBody.DueDate = objTrans.BodyData[0].DueDate;
                            objBody.Flags.SuspendFA = objTrans.BodyData[0].Flags.SuspendFA;
                            if (DataType.arrayLength(objTrans.BodyData[0].BodyExtra) > 0) {
                                objBody.BodyExtra = [];
                                for (iIndex = 0; iIndex < objBody.BodyExtra.length; iIndex++) {
                                    objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                    objIdNamePair.ID = objTrans.BodyData[0].BodyExtra[iIndex].ID;
                                    objIdNamePair.Name = objTrans.BodyData[0].BodyExtra[iIndex].Name;
                                    objIdNamePair.Tag = objTrans.BodyData[0].BodyExtra[iIndex].Tag;

                                    objBody.BodyExtra.push(objIdNamePair);
                                }
                            }

                            objTrans.BodyData.push(objBody);
                            arrCodeTypes.push(arrCodeTypes[0]);
                            arrBookTypes.push(eAccountTypes.AssetsLiabilities);
                        }
                    }
                }

                objTrans.Header.Net = dBaseNet;
                transEntryFields.setHeaderNet(dBaseNet);
                objTrans.Header.TransNet = dTransNet;
            }
            else if (transEntryInfo.BaseVoucherType == eVTTYPE.DEBNT || transEntryInfo.BaseVoucherType == eVTTYPE.CRDNT) {
                dBaseNet = 0;
                dTransNet = 0;

                for (iCounter = 0; iCounter < objTrans.BodyData.length; iCounter++) {
                    if (objTrans.BodyData[iCounter].Book == objTrans.BodyData[0].Book) {
                        if (objTrans.BodyData[iCounter].RowType != _RowType.ExchangeDiff) {
                            dBaseNet = DataType.add(dBaseNet, objTrans.BodyData[iCounter].Amounts[1]);
                        }

                        dTransNet = DataType.add(dTransNet, objTrans.BodyData[iCounter].OriginalAmounts[1]);
                    }
                }

                objTrans.Header.Net = dBaseNet;
                objTrans.Header.TransNet = dTransNet;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in CalcNet method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.CalcNet} " + err.message, GlobalPref.getResourceValue("Exception"));

            throw err;
        }

        return(0);
    },

    fillFinalFooterProcess: function (objTransaction, arrCodeTypes, arrBookTypes) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let iIndex = 0;
        let iAccount1 = 0;
        let iAccount2 = 0;
        let dFormulaValue = 0;
        let iSign = 0;
        let dTotalNet = 0;
        let dTotalNetSigned = 0;
        let dTotalQty = 0;
        let dTotalGross = 0;
        let dTempNet = 0;
        let dValue = 0;
        let dTotalValue = 0;
        let dLineValue = 0;
        let val = 0;
        let arrVal = [];
        let dOrigVal = 0;
        let bHandled = false;
        let bChanged = false;
        let bRefresh = false;
        let bSameCode = false;
        let bSameBook = false;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let arrTempBodyCodeTypes = undefined;
        let arrTempBodyBookTypes = undefined;
        let objBody = undefined;
        let objFooter = undefined;
        let eleCtrl = undefined;
        let objMetaData = undefined;

        try {
            // Filling Footer Data
            if (transEntryInfo.isItSales == true) {
                for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                    if (objTransaction.BodyData[iCounter].RowType != _RowType.Default) {
                        continue;
                    }

                    if (DataType.isValidObject(objTransaction.BodyData[iCounter].Sales) == true) {
                        if (!objTransaction.BodyData[iCounter].Flags.Void && !(objTransaction.BodyData[iCounter].Flags.SuspendFA && objTransaction.BodyData[iCounter].AuthStatus == _eAuthStatus.Authorized)) {
                            dTotalGross = FNumberOperation.add(dTotalGross, objTransaction.BodyData[iCounter].Sales.OrigGross, true);
                        }

                        dTotalQty = FNumberOperation.add(dTotalQty, objTransaction.BodyData[iCounter].Sales.Quantity, true);
                    }
                }

                if (EntryMain.m_bSupportBigNumber == false) {
                    dTotalGross = transEntry.rectifyAmountValue(dTotalGross);
                }

                dTotalNet = 0;
                for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                    if (objTransaction.BodyData[iCounter].RowType != _RowType.Default) {
                        continue;
                    }

                    if (objTransaction.BodyData[iCounter].Book == objTransaction.BodyData[0].Book && !objTransaction.BodyData[iCounter].Flags.SuspendFA) {
                        dTotalNet = FNumberOperation.add(dTotalNet, objTransaction.BodyData[iCounter].OriginalAmounts[1]);
                    }
                }

                if (EntryMain.m_bSupportBigNumber) {
                    dTotalNetSigned = dTotalNet;
                }
                else {
                    dTotalNetSigned = transEntry.rectifyAmountValue(dTotalNet);
                }

                dTotalNet = FNumberOperation.add(0, dTotalNetSigned, true);
                dTempNet = dTotalNet;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length && iCounter < objTransaction.Footer.length; iCounter++) {
                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iIndex];

                dValue = transEntryFooter.getInputValue(objMetaData.iFieldId);

                bChanged = false
                if (EntryMain.isDataLoading() == false
                    && DataType.isNullOrEmpty(objMetaData.sPreload) == false
                    && (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true || (EntryMain.m_bAutoLoad == true && dValue == 0))) {
                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId);

                    bRefresh = false;
                    if (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true) {
                        bRefresh = true;
                    }

                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload.substr(bRefresh == true ? 1 : 0), 0, null, 0, objMetaData.sFieldName);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                    dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                    dValue = FNumberOperation.toFixed(dFormulaValue, objMetaData.iNoDecimal);
                    dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }

                    eleCtrl = document.getElementById(sId);
                    if (DataType.isValidObject(eleCtrl) == true) {
                        transEntryFooter.setInputValue(eleCtrl, FNumberOperation.toFixed(dValue, objMetaData.iNoDecimal));
                        bChanged = true;
                    }
                }

                switch (objMetaData.FormulaBehaviour) {
                    case eTranEntryFormulaBehaviourFooter.Value:
                        if (bChanged == true) {
                            dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                            if (objMetaData.bValueInBaseCurrency == true) {
                                if (objTransaction.BodyData.length > 0) {
                                    dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                                }
                            }
                            else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                            }

                            transEntryFooter.setOutputValue(null, dValue, objMetaData);
                            objTransaction.Footer[iCounter].Value = dValue;
                        }
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGross:
                        if (bChanged == true) {
                            dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                            objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, null, 0);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                            if (EntryMain.m_bSupportBigNumber == true) {
                                dValue = BigNumber(dFormulaValue).multipliedBy(dValue).dividedBy(100).valueOf();
                            }
                            else {
                                dValue = dFormulaValue * dValue / 100;
                            }

                            if (objMetaData.bValueInBaseCurrency == true) {
                                if (objTransaction.BodyData.length > 0) {
                                    dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                                }
                            }
                            else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                            }

                            transEntryFooter.setOutputValue(null, dValue, objMetaData);
                            objTransaction.Footer[iCounter].Value = dValue;
                        }
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnNet:  // (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dTotalNetSigned).multipliedBy(dValue).dividedBy(100).valueOf();
                        }
                        else {
                            dValue = dTotalNetSigned * DataType.toDecimal(dValue) / 100;
                        }
                        
                        if (objMetaData.bValueInBaseCurrency == true) {
                            if (objTransaction.BodyData.length > 0) {
                                dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                            }
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        objTransaction.Footer[iCounter].Value = dValue;
                        break;
                    case eTranEntryFormulaBehaviourFooter.Formula:
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sFormula, 0, 0, 0, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dValue = FNumberOperation.convert(objFormulaOutput.Value);

                        if (objMetaData.bValueInBaseCurrency == true) {
                            if (objTransaction.BodyData.length > 0) {
                                dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                            }
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        objTransaction.Footer[iCounter].Value = dValue;
                        break;
                    case eTranEntryFormulaBehaviourFooter.NegativeValue:
                        if (bChanged == true) {
                            dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                            dValue = FNumberOperation.negated(dValue);
                            if (objMetaData.bValueInBaseCurrency == true) {
                                if (objTransaction.BodyData.length > 0) {
                                    dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                                }
                            }
                            else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                            }

                            transEntryFooter.setOutputValue(null, dValue, objMetaData);
                            objTransaction.Footer[iCounter].Value = dValue;
                        }
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGrossMinus:
                        if (bChanged == true) {
                            dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                            objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, null, 0);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            dFormulaValue = objFormulaOutput.Value;

                            if (EntryMain.m_bSupportBigNumber == true) {
                                dValue = BigNumber(dFormulaValue).multipliedBy(dValue).dividedBy(100).multipliedBy(-1).valueOf();
                            }
                            else {
                                dValue = (DataType.toDecimal(dFormulaValue) * dValue / 100) * -1;
                            }

                            if (objMetaData.bValueInBaseCurrency == true) {
                                if (objTransaction.BodyData.length > 0) {
                                    dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                                }
                            }
                            else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                            }

                            transEntryFooter.setOutputValue(null, dValue, objMetaData);
                            objTransaction.Footer[iCounter].Value = dValue;
                        }
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnNetMinus:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dTotalNet).multipliedBy(dValue).dividedBy(100).multipliedBy(-1).valueOf();
                        }
                        else {
                            dValue = (dTotalNet * DataType.toDecimal(dValue) / 100) * -1;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            if (objTransaction.BodyData.length > 0) {
                                dValue = FNumberOperation.div(dValue, objTransaction.BodyData[0].ExchangeRate);
                            }
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        objTransaction.Footer[iCounter].Value = dValue;
                        break;
                }

                if (objMetaData.iAddToNet == 0) {
                    dTotalNet = FNumberOperation.add(dTotalNet, transEntryFooter.getOutputValue(objMetaData.iFieldId));
                    dTotalNetSigned = FNumberOperation.add(dTotalNetSigned, transEntryFooter.getOutputValue(objMetaData.iFieldId));
                }
                else if (objMetaData.iAddToNet == 1) {
                    dTotalNet = FNumberOperation.sub(dTotalNet, transEntryFooter.getOutputValue(objMetaData.iFieldId));
                    dTotalNetSigned = FNumberOperation.sub(dTotalNetSigned, transEntryFooter.getOutputValue(objMetaData.iFieldId));
                }


                if (EntryMain.m_bSupportBigNumber == false) {
                    dTotalNet = transEntry.rectifyAmountValue(dTotalNet);
                    dTotalNetSigned = transEntry.rectifyAmountValue(dTotalNetSigned);
                }

                for (iCounter1 = iCounter + 1; iCounter1 < objTransaction.Footer.length; iCounter1++) {
                    objMetaData = transEntryScreenData.getFooterObjectFromColMap(objTransaction.Footer[iCounter1].ColMap);

                    if (DataType.isValidObject(objMetaData) == false) {
                        continue;
                    }

                    bSameCode = false;
                    bSameBook = false;

                    iAccount1 = objTransaction.Footer[iCounter1].Account1 > 0 ? objTransaction.Footer[iCounter1].Account1 : objMetaData.iDebitAccount;

                    iAccount2 = objTransaction.Footer[iCounter1].Account2 > 0 ? objTransaction.Footer[iCounter1].Account2 : objMetaData.iCreditAccount;

                    if (objMetaData.FormulaBehaviour == eTranEntryFormulaBehaviourBody.Formula) {
                        for (iIndex = 0; iIndex < objTransaction.BodyData.length; iIndex++) {
                            objTransaction.BodyData[iIndex].OriginalAmounts[0] = EntryMain.roundOff(objTransaction.BodyData[iIndex].OriginalAmounts[0], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                            objTransaction.BodyData[iIndex].OriginalAmounts[1] = EntryMain.roundOff(objTransaction.BodyData[iIndex].OriginalAmounts[1], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);

                            transEntryGrid.notifyOrgAmtChange(iIndex, 0, objTransaction.BodyData[iIndex].OriginalAmounts[0]);
                            transEntryGrid.notifyOrgAmtChange(iIndex, 1, objTransaction.BodyData[iIndex].OriginalAmounts[1]);

                            if ((objTransaction.BodyData[iIndex].RowType != _RowType.AccountToPost) || (objTransaction.BodyData[iIndex].RowType == _RowType.AccountToPost && objTransaction.BodyData[iIndex].Amounts[0] == 0)) {
                                objTransaction.BodyData[iIndex].Amounts[0] = FNumberOperation.mul(objTransaction.BodyData[iIndex].OriginalAmounts[0], objTransaction.BodyData[iIndex].ExchangeRate);
                            }

                            if ((objTransaction.BodyData[iIndex].RowType != _RowType.AccountToPost) || (objTransaction.BodyData[iIndex].RowType == _RowType.AccountToPost && objTransaction.BodyData[iIndex].Amounts[1] == 0)) {
                                objTransaction.BodyData[iIndex].Amounts[1] = FNumberOperation.mul(objTransaction.BodyData[iIndex].OriginalAmounts[1], objTransaction.BodyData[iIndex].ExchangeRate);
                            }

                            objTransaction.BodyData[iIndex].Amounts[0] = EntryMain.roundOff(objTransaction.BodyData[iIndex].Amounts[0], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                            objTransaction.BodyData[iIndex].Amounts[1] = EntryMain.roundOff(objTransaction.BodyData[iIndex].Amounts[1], EntryMain.m_dGeneralRoundOff, EntryMain.m_iRoundingType);
                        }

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sFormula, 0, 0, 0, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        objTransaction.Footer[iCounter1].Value = objFormulaOutput.Value;

                        if (objMetaData.bValueInBaseCurrency == true && objTransaction.BodyData.length > 0) {
                            objTransaction.Footer[iCounter1].Value = FNumberOperation.div(objTransaction.Footer[iCounter1].Value, objTransaction.BodyData[0].ExchangeRate);
                        }
                            
                        if (!objMetaData.bValueInBaseCurrency && EntryMain.m_bRoundOff) {
                            objTransaction.Footer[iCounter1].Value = FConvert.roundOff(objTransaction.Footer[iCounter].Value, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }
                    }
                }
            } // End Filling Footer Data

            // Footer data
            arrTempBodyCodeTypes = [];
            arrTempBodyBookTypes = [];

            if (objTransaction.BodyData.length > 0) {
                for (iCounter = 0; iCounter < objTransaction.Footer.length; iCounter++) {
                    objFooter = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter];
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[objFooter.arrMetaDataIndex[0]];

                    val = 0;
                    bSameCode = false;
                    bSameBook = false;

                    if (objMetaData.bPostToAccount == true) {
                        if (objMetaData.bAllowDebitAccount == false && DataType.isNullOrEmpty(objMetaData.sDrAccVariable) == false) {
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDrAccVariable, 0, null, 0, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            objTransaction.Footer[iCounter].Account1 = DataType.toInt(objFormulaOutput.Value);
                        }

                        if (objMetaData.bAllowCreditAccount == false && DataType.isNullOrEmpty(objMetaData.sCrAccVariable) == false) {
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sCrAccVariable, 0, null, 0, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            objTransaction.Footer[iCounter].Account2 = DataType.toInt(objFormulaOutput.Value);
                        }
                    }

                    iAccount1 = objTransaction.Footer[iCounter].Account1 > 0 ? objTransaction.Footer[iCounter].Account1 : objMetaData.iDebitAccount;
                    iAccount2 = objTransaction.Footer[iCounter].Account2 > 0 ? objTransaction.Footer[iCounter].Account2 : objMetaData.iCreditAccount;

                    if (objMetaData.iApportion <= 2) {
                        switch (objMetaData.iApportion) {
                            case 0: // Qty
                                dTotalValue = FNumberOperation.abs(dTotalQty);
                                break;
                            case 1: // Gross
                                dTotalValue = dTotalGross;
                                break;
                            case 2: // Net
                                dTotalValue = dTempNet;
                                break;
                        }
                    }
                    else {
                        for (iCounter1 = 0; iCounter1 < DataType.arrayLength(objTransaction.BodyData); iCounter1++) {
                            if (DataType.isValidObject(objTransaction.BodyData[iCounter1].Sales) == false || DataType.arrayLength(objTransaction.BodyData[iCounter1].Sales.ScreenData) < 1) {
                                continue;
                            }

                            for (iCounter2 = 0; iCounter2 < objTransaction.BodyData[iCounter1].Sales.ScreenData.length; iCounter2++) {
                                if ((objTransaction.BodyData[iCounter1].Sales.ScreenData[iCounter2].FieldId & eVTFIELDFLAG.TOFLDID) == (objMetaData.iApportion & eVTFIELDFLAG.TOFLDID)) {
                                    dTotalValue = FNumberOperation.add(dTotalValue, objTransaction.BodyData[iCounter1].Sales.ScreenData[iCounter2].Value, true);
                                    break;
                                }
                            }
                        }
                    }

                    bHandled = false;

                    iTransferIndex = -1;
                    if (FConvert.isItTransfer(transEntryInfo.BaseVoucherType)) {
                        iRow = DataType.arrayFilterData(objTransaction.BodyData, "RowType", _RowType.Default, "===").length / 2;
                        for (iCounter1 = 0; iCounter1 < DataType.arrayLength(objTransaction.BodyData); iCounter1++) {
                            if (objTransaction.BodyData[iCounter1].RowType == _RowType.Default) {
                                iTransferIndex++;
                            }

                            if (iTransferIndex == iRow) {
                                iTransferIndex = iCounter1;
                                break;
                            }
                        }
                    }

                    if (objMetaData.iCreditAccount > 0
                        && objMetaData.iCreditAccount != objTransaction.BodyData[0].Book) {

                        objMetaData.iAddToNet = 0;
                    }

                    switch (objMetaData.iAddToNet) {
                        case 0: // Add
                            if (objMetaData.iCreditAccount <= 0 || objMetaData.iCreditAccount == objTransaction.BodyData[0].Book) {
                                if (FNumberOperation.isNotEqualTo(dTotalValue, 0) == true) {
                                    dOrigVal = objTransaction.Footer[iCounter].Value;
                                    for (iCounter1 = 0; iCounter1 < objTransaction.BodyData.length; iCounter1++) {
                                        if (objTransaction.BodyData[iCounter1].Flags.Void == true) {
                                            continue;
                                        }

                                        if (objTransaction.BodyData[iCounter1].RowType != _RowType.Default) {
                                            continue;
                                        }

                                        if ((objTransaction.BodyData[iCounter1].Flags.SuspendFA && objTransaction.BodyData[iCounter1].AuthStatus == _eAuthStatus.Authorized) == true) {
                                            continue;
                                        }

                                        if (objMetaData.iApportion <= 2) {
                                            switch (objMetaData.iApportion) {
                                                case 0: // Qty
                                                    dLineValue = FNumberOperation.abs(objTransaction.BodyData[iCounter1].Sales.Quantity);
                                                    break;
                                                case 1: // Gross
                                                    dLineValue = objTransaction.BodyData[iCounter1].Sales.OrigGross;
                                                    break;
                                                case 2: // Net
                                                    dLineValue = FNumberOperation.abs(objTransaction.BodyData[iCounter1].OriginalAmounts[1]);
                                                    break;
                                            }
                                        }
                                        else {
                                            if (DataType.isValidObject(objTransaction.BodyData[iCounter1].Sales) == true
                                                && DataType.isValidObject(objTransaction.BodyData[iCounter1].Sales.ScreenData) == true) {
                                                for (iCounter2 = 0; iCounter2 < objTransaction.BodyData[iCounter1].Sales.ScreenData.length; iCounter2++) {
                                                    if ((objTransaction.BodyData[iCounter1].Sales.ScreenData[iCounter2].FieldId & eVTFIELDFLAG.TOFLDID) == (objMetaData.iApportion & eVTFIELDFLAG.TOFLDID)) {
                                                        dLineValue = FNumberOperation.abs(objTransaction.BodyData[iCounter1].Sales.ScreenData[iCounter2].Value);
                                                    }
                                                }
                                            }
                                        }

                                        val = 0;
                                        //if (EntryMain.m_bSupportBigNumber == true) {
                                        //    val = FNumberOperation.mul(FNumberOperation.div(objTransaction.Footer[iCounter].Value, dTotalValue), FNumberOperation.add(dLineValue, objTransaction.BodyData[iCounter1].Amount3));
                                        //    val = FNumberOperation.toFixed(val, 15);
                                        //}
                                        //else {
                                        //    val = (objTransaction.Footer[iCounter].Value / dTotalValue) * (dLineValue + objTransaction.BodyData[iCounter1].Amount3);
