    LoadClubData: function (bClubSameItem) { //returns a jagged array
        let iCounter = 0;
        let iCounter1 = 0;
        let iIndex = 0;
        let dTotalQty = 0;
        let dTotalGross = 0;
        let dAvgRate = 0;
        let arrReturnedData = [];
        let objRow = null;
        let arrRowData = null;
        let bRowsclubbed = true;
        let objFieldPos = null;
        let temp = null;

        try {
            if (bClubSameItem == true) {
                // Step 1: find indexes of product, qty, rate and gross columns
                objFieldPos = CopyDocUI.getFieldDataPosition();

                arrRowData = JSON.parse(JSON.stringify(CopyDocUI.m_objReturnData.arrRowData)); // copy by value not by reference

                // Step 2: Compare the product cols in arrRowData
                for (iCounter = 0; iCounter < arrRowData.length; iCounter++) {
                    objRow = arrRowData[iCounter];

                    if (objFieldPos.Quantity > -1) {
                        dTotalQty = DataType.toDecimal(objRow[objFieldPos.Quantity]);
                    }

                    if (objFieldPos.Gross > -1) {
                        dTotalGross = DataType.toDecimal(objRow[objFieldPos.Gross]);
                    }

                    if (objFieldPos.Rate > -1) {
                        dAvgRate = DataType.toDecimal(objRow[objFieldPos.Rate]);
                    }

                    if (DataType.gt(dTotalQty, 0) == true || DataType.gt(dTotalGross, 0) == true) {

                        iCounter1 = iCounter + 1;
                        while(iCounter1 < arrRowData.length) {
                            bRowsclubbed = true; // for resetting previous value
                            for (iIndex = 0; iIndex < objFieldPos.arrMastersIndex.length; iIndex++) {
                                if (JSON.stringify(objRow[objFieldPos.arrMastersIndex[iIndex]]) == JSON.stringify(arrRowData[iCounter1][objFieldPos.arrMastersIndex[iIndex]])) {
                                    bRowsclubbed = bRowsclubbed && true;
                                }
                                else {
                                    bRowsclubbed = false;
                                    break;
                                }
                            }

                            if (bRowsclubbed == true) {
                                dTotalQty = DataType.add(dTotalQty, DataType.toDecimal(arrRowData[iCounter1][objFieldPos.Quantity]));
                                dTotalGross = DataType.add(dTotalGross, DataType.toDecimal(arrRowData[iCounter1][objFieldPos.Gross]));
                                dAvgRate = DataType.div(dTotalGross, dTotalQty);
                                arrRowData.splice(iCounter1, 1);

                                CopyDocUI.m_arrRowHeaderIds.splice(iCounter1, 1);
                            }
                            else {
                                iCounter1++;
                            }
                        }

                        objRow[objFieldPos.Quantity] = dTotalQty;
                        objRow[objFieldPos.Gross] = dTotalGross;
                        objRow[objFieldPos.Rate] = dAvgRate;
                    }
                }

                CopyDocUI.m_arrClubRowData = arrRowData;

                // Set clubbed data in returning data - CopyDocUI.m_arrBodyData
                arrReturnedData = [];

                for (iCounter = 0; iCounter < CopyDocUI.m_arrRowHeaderIds.length; iCounter++) {
                    temp = $.grep(CopyDocUI.m_arrBodyData, function (x) {
                        if (x.ID == CopyDocUI.m_arrRowHeaderIds[iCounter]) {
                            return x;
                        }
                    });

                    if (temp != null && temp.length > 0) {
                        arrReturnedData.push(temp[0]);
                    }

                    if (arrReturnedData[iCounter]) {
                        //update quantity and Gross values ,
                        $.grep(arrReturnedData[iCounter].Tag, function (y) {
                            if (y.Sales && y.Sales.Product && y.Sales.Quantity && y.Sales.Gross) {
                                if (y.Sales.Product == CopyDocUI.m_arrClubRowData[iCounter][objFieldPos.Item].ID) {
                                    y.Sales.Quantity = CopyDocUI.m_arrClubRowData[iCounter][objFieldPos.Quantity];
                                    y.Sales.Gross = CopyDocUI.m_arrClubRowData[iCounter][objFieldPos.Gross];
                                }
                            }
                        });
                    }
                }

                CopyDocUI.m_arrBodyData = arrReturnedData.slice(0);
            }
            else {
                arrRowData = CopyDocUI.m_objReturnData.arrRowData;
            }

            return (arrRowData);
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.LoadClubData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

