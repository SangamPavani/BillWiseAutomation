            switch (objCurrencyInfo.Area) {
                case eTranEntryFieldArea.Header:
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    break;
                case eTranEntryFieldArea.Body:
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYCURRENCY);
                    bBody = true;
                    break;
            }

            if (DataType.isNullOrEmpty(sId, true) == false) {
                if(bBody == true) {
                    arrLastCurrencyId = [];
                    iTotalRows = transEntryGrid.getTotalRows();
                    for (iRow = 1; iRow <= iTotalRows; iRow++) {
                        iLastCurrencyId = transEntryFields.getCurrency(iRow);
                        if(DataType.isZero(iLastCurrencyId) == true) {
                            break;
                        }

                        arrLastCurrencyId.push(iLastCurrencyId);
                    }
                }
                else {
                    iLastCurrencyId = DataType.toInt(OPTIONCONTROL.getControlValue(sId));                    
                }

                OPTIONCONTROL.setFilter(sId, sFilter);

                if(bSetFilterOnly !== true) {
                    if(bBody == true) {
                        if(DataType.arrayLength(arrLastCurrencyId) > 0) {
                            transEntryGrid.setMasterValue(EntryMainUI.getElement(transEntryFieldInfo.Currency, 1).Value, arrLastCurrencyId, sId);

                            for(iRow = 0; iRow < arrLastCurrencyId.length; iRow++) {
                                transEntryExchangeRate.update(iRow + 1);
                            }
                        }
                    }
                    else {
                        OPTIONCONTROL.setValue(sId, iLastCurrencyId, {tagOldValue: iLastCurrencyId});
                        iCurrencyId = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if (iLastCurrencyId > 0 && iCurrencyId == 0) {
                            EntryMainUI.updateFlag(objCurrencyInfo.FieldId);
                            if (transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Header) {
                                EntryMainMaster.changeCurrencyH(iLastCurrencyId != iCurrencyId);
                            }
                        }
                    }
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainUI.resetCurrencyFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
