    onOptionDataLoaded: function (id, data, tag) {
        let iIndex = 0;
        let iCounter = 0;
        let iRowCounter = 0;
        let iCurrentRow = 0;
        let iMasterId = 0;
        let iFieldId = 0;
        let iItemId = 0;
        let iLength = 0;
        let iDefaultBaseUnit = 0;
        let bLoadDependency = false;
        let arrLoadedDataIds = [];
        let arrAdvanceSearchQty = null;
        let objUserData = null;
        let cell = null;
        let value = null;

        try {
            if (DataType.isValidObject(tag.CustomData) == false) { // Not called due to displayBodyData
                return;
            }
            else if (DataType.toBoolean(tag.CustomData.bFromRule) == true) {
                transEntryGrid.setRowValueBasedOnDataType(tag.CustomData.iCurrentRow, 
                                                            tag.CustomData.iValue, 
                                                            {
                                                                MetaData: tag.CustomData.objMetaData,
                                                                Data: DataType.isValidObject(tag.Data) == true ? tag.Data : [],
                                                                bFromBatch: false
                                                            });
                return;
            }

            if (DataType.arrayLength(tag.CustomData.AdvanceSearchQty) > 0) {
                arrAdvanceSearchQty = tag.CustomData.AdvanceSearchQty;

                value = DataType.stringToObject(tag.UserData);
                if (value.lValue > 0) {
                    value = value.data;

                    objUserData = {};
                    objUserData.iRow = value.iRow;
                    objUserData.iColumn = value.iColumn;
                }
            }
            else {
                arrAdvanceSearchQty = [];
            }

            iFieldId = EntryMainUI.extractBodyFieldId(tag.Control.id);
            if (DataType.isValidObject(tag.CustomData.bDependency) == true) {
                tag.CustomData.iCurrentRow = DataType.toInt(tag.CustomData.iCurrentRow);
                cell = transEntryGrid.getCellObject(tag.CustomData.iRow + tag.CustomData.iCurrentRow, tag.CustomData.iColumn);

                EntryMainBody.updateMasterValue(cell, tag.Data, iFieldId, true);

                return;
            }

            if (DataType.isValidObject(tag.Data) == true) {
                arrLoadedDataIds = [];

                //debugger
                for (iIndex = 0; iIndex < tag.Data.length; iIndex++) {
                    value = tag.Data[iIndex][0];
                    if (DataType.isValidObject(value) == true) {
                        iMasterId = DataType.toInt(DataType.getObjectFirstValue(value));
                        arrLoadedDataIds.push(iMasterId);
                    }
                    else {
                        value = tag.Data[iIndex];
                        if (DataType.isValidObject(value) == true) {
                            iMasterId = DataType.toInt(DataType.getObjectFirstValue(value));
                            arrLoadedDataIds.push(iMasterId);
                            break;
                        }
                    }
                }

                tag.CustomData.iCurrentRow = DataType.toInt(tag.CustomData.iCurrentRow);
                iLength = DataType.arrayLength(tag.CustomData.arrMasterIds);
                if (iLength == 0 && DataType.isValidObject(objUserData) == true) {
                    transEntryQuantity.setValue(arrAdvanceSearchQty[0], objUserData.iRow, { bUpdateMemoryObject: true });
                }

                for (iRowCounter = 0; iRowCounter < iLength; iRowCounter++) {
                    iIndex = arrLoadedDataIds.indexOf(tag.CustomData.arrMasterIds[iRowCounter]);
                    if (iIndex > -1) {
                        iCurrentRow = (iRowCounter + tag.CustomData.iCurrentRow + 1);
                        if (iCurrentRow > transEntryGrid.getTotalRows()) {
                            transEntryGrid.insertRows(0, 1);
                        }

                        cell = transEntryGrid.getCellObject(iCurrentRow, tag.CustomData.ColIndex);

                        if (tag.CustomData.MetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                            iMasterId = EntryMainBody.setProductDataInCell(cell,
                                                                tag.Data[iIndex], 
                                                                DataType.toBoolean(tag.CustomData.bPendingLinks), 
                                                                DataType.toBoolean(tag.CustomData.bDescriptionMappingExist),
                                                                true,
                                                                DataType.toInt(tag.CustomData.iCallingSource),
                                                                DataType.toInt(tag.CustomData.iLoadedDataSource));

                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, iMasterId, cell.iRow);
                            if (arrAdvanceSearchQty.length > 0) {
                                transEntryQuantity.setValue(arrAdvanceSearchQty[iIndex], cell.iRow, { bUpdateMemoryObject: true });
                            }
                        }
                        else {
                            iMasterId = EntryMainBody.updateMasterValue(cell, tag.Data[iIndex], tag.CustomData.MetaData.iFieldId, true);
                        }
                        //iMasterId = DataType.toInt(cell.getCellData());

                        if (tag.CustomData.MetaData.iFieldId == eVTFIELDID.FDF_BODYCODE) {
                            if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                                if (EntryMain.m_objTrans.BodyData[0].Book == iMasterId) {
                                    EntryMainUI.clear(transEntryFieldInfo.Book, 0);
                                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));
                                }
                            }
                        }

                        // Fill View Info Fields 
                        EntryMainBody.updateViewInfoFields(EntryMainUI.extractBodyFieldId(tag.Control.id), cell);

                        bLoadDependency = false;
                        if (tag.CustomData.iCallingSource != eDisplayBodyDataSource.LoadVoucher) {
                            bLoadDependency = EntryMainDependency.isLoadDependencyBasedOnCallingSource(tag.CustomData.iCallingSource);
                        }

                        if (bLoadDependency == true) {
                            if (tag.CustomData.MetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                                // Dependency call int EntryMainBody.setProductDataInCell
                            }
                            else if (tag.CustomData.MetaData.iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                            }
                            else if (tag.CustomData.MetaData.iFieldId == eVTFIELDID.FDF_BODYCODE) {
                                EntryMainDependency.processBodyAccountDependency(cell.iRow, cell.iColumn, tag.CustomData.MetaData.iFieldId);
                            }
                            else {
                                for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.arrDependentMasterColumn.length; iCounter++) {
                                    if (transEntryGlobal.FieldHelper.arrDependentMasterColumn[iCounter].SourceFieldId == tag.CustomData.MetaData.iFieldId) {
                                        EntryMainDependency.processBodyOtherDependency(cell);
                                        break;
                                    }
                                }
                            }
                        }

                        if (DataType.isValidObject(tag.CustomData.arrUnitIds) == true
                            && iRowCounter < tag.CustomData.arrUnitIds.length) {

                            iDefaultBaseUnit = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRowCounter + 1, "iDefaultBaseUnit", eMasterDataType.Number);
                            iItemId = EntryMainMemoryObject.getProductValue(iRowCounter + 1);

                            EntryMainBody.loadUnitData(tag.CustomData.arrUnitIds[iRowCounter],
                                                        iDefaultBaseUnit,
                                                        iItemId,
                                                        iRowCounter,
                                                        tag.CustomData.UnitColIndex,
                                                        tag.CustomData.UnitMetaData.iFieldId,
                                                        tag.CustomData.iCurrentRow);
                        }
                    }
                    else {
                    }

                    if (iCurrentRow >= transEntryGrid.getTotalRows()) {
                        transEntryGrid.insertRows(0, 1);
                    }


                    if (iIndex == -1 && tag.CustomData.arrMasterIds[iRowCounter] == 0
                        && EntryMain.isDataLoading() == true && transEntryInfo.isItSales == true
                        && iFieldId == eVTFIELDID.FDF_BODYCODE) {

                        cell = EntryMainUI.getElement(transEntryFieldInfo.Item, tag.CustomData.iCurrentRow + 1).Value;
                        if (DataType.isValidObject(cell) == true) {
                            EntryMainMaster.processForProductChange(DataType.toInt(cell.getCellData()), tag.CustomData.iCurrentRow + 1);
                        }
                    }
                }
            }

            if (DataType.isNullOrEmpty(tag.CustomData.sCallback, true) == false) {
                eval(tag.CustomData.sCallback)(tag);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onOptionDataLoaded method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onOptionDataLoaded} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onBarcodeDataLoaded: function (id, data) {
        let sUserData = "";
        let iCounter = 0;
        let iBinId = 0;
        let dQty = null;
        let bUnit = false;
        let objBatchInfo = null;
        let objUserData = null;
        let arrBinsData = null;
        let ClubResult = undefined;

        try {
            if (transEntryGlobal.debugBarcode == true) {
                debugger
            }

            sUserData = OPTIONCONTROL.getUserData(id);
            objUserData = DataType.stringToObject(sUserData).data;
            if (DataType.isValidObject(objUserData) == false) {
                return;
            }

            EntryMain.m_ProductScanResultInfo = eProductScanResultInfo.None;

            for (iCounter = 0; iCounter < data.BarCodeDetails.length; iCounter++) {
                switch(data.BarCodeDetails[iCounter].ID)
                {
                    case eBarCodeField.Batches:
                        if ((typeof data.BarCodeDetails[iCounter].Value).toLowerCase() == "object") {
                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.Batch;

                            objBatchInfo = data.BarCodeDetails[iCounter].Value;
                            transEntryBatch.setBatchInfo(objUserData.iRow, objBatchInfo);
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, objBatchInfo, objUserData.iRow);
                        }

                        break;
                    case eBarCodeField.Gross:
                        break;
                    case eBarCodeField.Quantity:
                        if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.Quantity;

                            transEntryQuantity.setValue(data.BarCodeDetails[iCounter].Value, objUserData.iRow, { bUpdateMemoryObject: true });

                            transEntryQuantity.processChange(0, data.BarCodeDetails[iCounter].Value, objUserData.iRow);

                            dQty = data.BarCodeDetails[iCounter].Value;
                        }

                        break;
                    case eBarCodeField.Rates:
                        if (transEntryFieldInfo.Rate.ColumnIndex > -1
                            && DataType.toDecimal(data.BarCodeDetails[iCounter].Value) != 0) {

                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.Rate;
                            data.BarCodeDetails[iCounter].Value = transEntryRate.setValue(data.BarCodeDetails[iCounter].Value, objUserData.iRow);
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, data.BarCodeDetails[iCounter].Value, objUserData.iRow);
                        }

                        break;
                    case eBarCodeField.Units:
                        if (transEntryFieldInfo.Unit.ColumnIndex > -1) {
                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.Unit;

                            iDefaultBaseUnit = DataType.toInt(OPTIONCONTROL.getControlValue(id, "iDefaultBaseUnit"));
                            EntryMainBody.loadUnitData(data.BarCodeDetails[iCounter].Value,
                                                        iDefaultBaseUnit,
                                                        data.ItemId,
                                                        objUserData.iRow - 1,
                                                        transEntryFieldInfo.Unit.ColumnIndex,
                                                        transEntryFieldInfo.Unit.FieldId,
                                                        0);

                            bUnit = true;
                        }
                        break;
                    case eBarCodeField.RMA:
                        if (transEntryFieldInfo.RMA.ColumnIndex > -1) {
                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.RMA;
                            transEntryFields.setRMA(data.BarCodeDetails[iCounter].Value, objUserData.iRow);
                        }
                        break;
                    case eBarCodeField.Bins:
                        if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                            EntryMain.m_ProductScanResultInfo |= eProductScanResultInfo.Bins;
                            iBinId = data.BarCodeDetails[iCounter].Value;
                        }
                        break;
                }
            }

            if(bUnit == true && DataType.isValidObject(dQty) == true) {
                transEntryQuantity.setValue(dQty, objUserData.iRow, { bValueInBase: true });
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYQUANTITY, dQty, objUserData.iRow);
            }

            if(transEntryInfo.InventoryPref.bConsolidateQtyInBarcode == true 
                && (EntryMain.m_ProductScanResultInfo & eProductScanResultInfo.Quantity) == 0) {
                dQty = 1;
                transEntryQuantity.setValue(dQty, objUserData.iRow, { bUpdateMemoryObject: true });
                transEntryQuantity.processChange(0, dQty, objUserData.iRow);
            }

            ClubResult = EntryMainBody.clubScanRow({ 
                                        iScanRow: objUserData.iRow, 
                                        iCurrentColumn: objUserData.iColumn, 
                                        dQty: dQty, 
                                        BatchInfo : objBatchInfo, 
                                        Data: data
            });

            if (data.ItemId != 0 /*&& transEntryInfo.InventoryPref.bConsolidateQtyInBarcode == false*/) {
                if (ClubResult == undefined) {
                    transEntryGrid.moveToNextCell();
                    if (iBinId > 0) {
                        if ((EntryMain.m_ProductScanResultInfo & eProductScanResultInfo.Quantity) == 0) {
                            dQty = 1;
                            transEntryQuantity.setValue(dQty, objUserData.iRow, { bUpdateMemoryObject: true });
                            transEntryQuantity.processChange(0, dQty, objUserData.iRow);
                        }
                        transEntryGrid.moveToSelf();
                        arrBinsData = transEntryServer.getBinsData(iBinId, dQty, objUserData.iRow);
                        if (DataType.arrayLength(arrBinsData) > 0) {
                            transEntryBins.setValue(objUserData.iRow, arrBinsData, false);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onBarcodeDataLoaded method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onBarcodeDataLoaded} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
