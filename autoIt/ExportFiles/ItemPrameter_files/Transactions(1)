    editLayout_FieldsCustomization_setVoucherFields: function (Details, bFromViews, arrfields) {

        if (bFromViews == 'False')
            editLayout_isFromViews = false;
        else
            editLayout_isFromViews = true;
        arrExternalField = arrfields;
        if (Details != null) {
            editlayout_fieldId = Details.iFieldId;
            OPTIONCONTROL.setControlText("EditLayout_FieldsCustomization_FieldDetails_Caption", Details.sCaption);
            //OPTIONCONTROL.setControlValue("EditLayout_FieldsCustomization_FieldDetails_Caption", Details.iFieldId);
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_Name").value = Details.sFieldName ? Details.sFieldName : Details.sCaption;
            document.getElementById("EditLayout_FieldsCustomization_FieldDetails_DataType").value = editLayout_isFromViews ? Details.iFieldBehaviour : Details.iDataTypeId;
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_DataType").onchange();
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_Maxsize").value = Details.iMaxSize;
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_defaultValue").value = Details.sDefaultValue;
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_controlType").value = Details.sDisplayCtrlType;
            document.getElementById("EditLayout_FieldsCustomization_FieldDetails_toolTip").value = Details.sToolTip;
            document.getElementById("editLayout_FieldsCustomization_FieldDetails_unique").value = Details.iUnique;
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_minimumValue").value = Details.dMinimumValue;
            //document.getElementById("EditLayout_FieldsCustomization_FieldDetails_maximumvalue").value = Details.dMaximumValue;
            if (Details.sExternalTableName != "" && Details.sExternalTableName != null) {
                document.getElementById("EditLayout_FieldsCustomization_FieldDetails_extTblName").onblur(this);
            }
            if (Details.iMasterLink >= 0) {
                DocLayoutField_Customization.MasterToLink = Details.iMasterLink;
            }

            CONFIGURETRANS.EDITLAYOUT.setFilterCriteria(Details.ArrFilterCriteria);

            document.getElementById("EditLayout_FieldsCustomization_FieldDetails_filterCrtFilterCond").value = Details.sFilterCondition;
            if (editLayout_isFromViews == false)
                document.getElementById("editLayout_FieldsCustomization_Properties_behavoir").value = Details.iBehaviour;

            if (bEditLayoutBody == false && editLayout_isFromViews == false) {
                if (Details.iDataTypeId == MasterDataType.get("TEXT") || Details.iDataTypeId == MasterDataType.get("NUMBER") || Details.iDataTypeId == MasterDataType.get("FRACTION") || Details.iDataTypeId == MasterDataType.get("BIGNUMBER")) {
                    if (Details.iBehaviour == 4) {
                        document.getElementById("editLayout_FieldsCustomization_Properties_chkwordWrap").checked = Details.bWordWrap;
                    }
                    if (Details.iBehaviour == 5) { // Incremental
                        DocLayoutField_Customization.setIncrementalGridValue(Details.IncrementalSeries);
                    }
                }
            }


            if (Details.biFont != null && Details.biFont.length > 0) {
                //Font values in Farmatting
                document.getElementById("editLayout_FieldsCustomization_Formatting_chkenableFont").checked == true;
            }
            if (Details.iCharacterCasing != null && Details.iCharacterCasing != "") {
                document.getElementById("editLayout_FieldsCustomization_Formatting_charCasing").value = Details.iCharacterCasing;
                document.getElementById("editLayout_FieldsCustomization_Formatting_textAlign").value = Details.iTextAlign;
            }
            var ddlEle = document.getElementById("ddlMasterFields_RULES_editLayoutRules");
            var i = 0;

            if (FCommon.UI.isValidObject(ddlEle) == true) {
                for (; i < ddlEle.length;) {
                    var sFieldName = voucherFields.sFieldName != null ? voucherFields.sFieldName : voucherFields.sCaption;
                    if (ddlEle.options[i].text.toLowerCase() != sFieldName.toLowerCase()) {
                        ddlEle.remove(i);
                        i = i;
                        continue;
                    }
                    i++;
                }
            }
            CONFIGURETRANS.editLayout_FieldsCustomization_changeMasterDataType(Details.iDataTypeId);
            if ((Details.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0
                || (Details.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {

                DocCustomization.Layout.showFilterCriteria(false);
            }
        }
        //Properties
        if (!editLayout_isFromViews) {
            if (Details.bMandatory) {
                CONFIGURETRANS.EditLayoutFieldsCustChkbxClick("editLayout_FieldsCustomization_Properties_chkmandatory");
            }
            else if (Details.bHidden) {
                CONFIGURETRANS.EditLayoutFieldsCustChkbxClick("editLayout_FieldsCustomization_Properties_chkhidden");
            }
            else if (Details.bReadOnly) {
                CONFIGURETRANS.EditLayoutFieldsCustChkbxClick("editLayout_FieldsCustomization_Properties_chkreadOnly");
            }
        }
        //Rules tab;
    },
    EditLayoutFieldsCustChkbxClick: function (id) {
        var ele = document.getElementById(id);
        switch (id) {
            case "editLayout_FieldsCustomization_Properties_chkmandatory":
                if (ele.checked) {
                    CONFIGURETRANS.DisableDivision("dvEditLayoutPropCantImport");
                    CONFIGURETRANS.DisableDivision("dvEditLayoutPropChkHidden");
                    CONFIGURETRANS.DisableDivision("dvEditLayoutPropChkReadOnly");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").checked = false;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").tabIndex = -1;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").checked = false;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").tabIndex = -1;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkcantImport").checked = false;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkcantImport").tabIndex = -1;
                }
                else {
                    CONFIGURETRANS.EnableDivision("dvEditLayoutPropCantImport");
                    CONFIGURETRANS.EnableDivision("dvEditLayoutPropChkHidden");
                    CONFIGURETRANS.EnableDivision("dvEditLayoutPropChkReadOnly");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").tabIndex = null;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").tabIndex = null;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkcantImport").tabIndex = null;
                }
                break;
            case "editLayout_FieldsCustomization_Properties_chkhidden":
                if (ele.checked) {
                    CONFIGURETRANS.DisableDivision("dvEditLayoutPropChkReadOnly");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").checked = false;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").tabIndex = -1;
                }
                else {
                    CONFIGURETRANS.EnableDivision("dvEditLayoutPropChkReadOnly");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkreadOnly").tabIndex = null;
                }
                break;
            case "editLayout_FieldsCustomization_Properties_chkreadOnly":
                if (ele.checked) {
                    CONFIGURETRANS.DisableDivision("dvEditLayoutPropChkHidden");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").checked = false;
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").tabIndex = -1;
                }
                else {
                    CONFIGURETRANS.EnableDivision("dvEditLayoutPropChkHidden");
                    document.getElementById("editLayout_FieldsCustomization_Properties_chkhidden").tabIndex = -1;
                }
                break;
        }
    },
