                            break;
                        }
                    }

                    //iarrIndex = $.grep(BinsUI.m_objBinsData.BinDetails, function (x) {
                    //    return (x.Id == arrData[k].BinId && x.SkidId == arrData[k].SkidId);
                    //});
                }

                //incase of multiple bins 
                if (BinsUI.m_isPaging == true) {
                    BinsUI.addSelectedBins(BinsUI.m_objFullBinsData.BinDetails[iarrIndex]);
                }
                for (var rowCounter = 1; rowCounter <= transBinsPopup.getTotalRows() ; rowCounter++) {
