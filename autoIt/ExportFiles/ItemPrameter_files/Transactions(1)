    createVoucher: function () {
        //debugger;
        try {
            if (FCommon.UI.isValidObject(DocCustomizationProp.SelectedVoucher) == false) {
                return;
            }

            NETWORK.executeServerMethod(GLOBAL.getContextPath("CreateDocVoucher", "ConfigureTrans", "TranSettings"),
