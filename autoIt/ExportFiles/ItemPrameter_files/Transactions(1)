    updateNodePosition: function () {
        let iCounter = 0;
        let iFromHeight = 0;
        let iMainHeight = 0;
        let iToHeight = 0;
        let iMaxHeight = 0;
        let eleFrom = null;
        let eleMain = null;
        let eleTo = null;
        let ele = null;

        try {
            if (FCommon.Array.getLength(transEntryInfo.Settings.PrevVouchers) == 0) {
                if (FCommon.Array.getLength(transEntryInfo.Settings.NextVouchers) <= 1) {
                    return;
                }
            }

            if (FCommon.Array.getLength(transEntryInfo.Settings.NextVouchers) == 0) {
                if (FCommon.Array.getLength(transEntryInfo.Settings.PrevVouchers) <= 1) {
                    return;
                }
            }

            eleFrom = document.getElementById("infopanel_workflow_from");
            eleMain = document.getElementById("infopanel_workflow_main");
            eleTo = document.getElementById("infopanel_workflow_to");

            if (FCommon.UI.isValidObject(eleFrom) == true) {
                eleFrom.style.marginTop = "";

                iFromHeight = 0;
                for (iCounter = 0; iCounter < eleFrom.children.length; iCounter++) {
                    iFromHeight += eleFrom.children[iCounter].getBoundingClientRect().height;
                }
            }

            if (FCommon.UI.isValidObject(eleMain) == true) {
                eleMain.style.marginTop = "";
                iMainHeight = eleMain.children[0].getBoundingClientRect().height;
            }

            if (FCommon.UI.isValidObject(eleTo) == true) {
                eleTo.style.marginTop = "";

                iToHeight = 0;
                for (iCounter = 0; iCounter < eleTo.children.length; iCounter++) {
                    iToHeight += eleTo.children[iCounter].getBoundingClientRect().height;
                }
            }

            if (iMainHeight == 0 || (iFromHeight == 0 && iToHeight == 0)) { // Not Visible
                return;
            }

            iMaxHeight = Math.max(iFromHeight, iToHeight);

            // From exist but not max
            if (iFromHeight > 0 && iFromHeight < iMaxHeight) {
                eleFrom.style.marginTop = ((iMaxHeight - iFromHeight) / 2) + "px";
            }

            if (iMainHeight < iMaxHeight) {
                eleMain.style.marginTop = ((iMaxHeight - iMainHeight) / 2) + "px";
            }

            if (iToHeight > 0 && iToHeight < iMaxHeight) {
                eleTo.style.marginTop = ((iMaxHeight - iToHeight) / 2) + "px";
            }

        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryWorkflowDashlet.updateNodePosition} " + err.message);
        }
    },

    adjustLinesPosition: function () {
        let iCounter = 0;
        let angleDeg = 0;
        let iWidth = 0;
        let ia = 0;
        let ib = 0;
        let eleLinkNodes = null;
        let eleMainNode = null;
        let eleLines = null;
        let rectMain = null;
        let rectNode = null;

        try {
            //debugger
            eleMainNode = document.getElementById("infopanel_workflow_main");
            if (FCommon.UI.isValidObject(eleMainNode) == false || eleMainNode.children.length != 1) {
                return;
            }

            eleMainNode = eleMainNode.children[0].children[0].children[0];

            eleLinkNodes = document.querySelectorAll(".link_node");
            eleLines = document.querySelectorAll(".infopanel_workflow_line");


            rectMain = eleMainNode.getBoundingClientRect();

            for (iCounter = 0; iCounter < eleLines.length; iCounter++) {
                rectNode = eleLinkNodes[iCounter].getBoundingClientRect();

                if (rectMain.left < rectNode.left) { // Node is next voucher
                    eleLines[iCounter].style.left = rectMain.right + "px";
                    eleLines[iCounter].style.top = rectMain.top + (rectMain.height / 2) + "px";

                    angleDeg = Math.atan2(rectNode.top - rectMain.top, rectNode.left - rectMain.left) * 180 / Math.PI;

                    ia = rectMain.right - rectNode.left;
                    ib = rectMain.top - rectNode.top;
                }
                else { // Node is previous voucher
                    eleLines[iCounter].style.left = rectNode.right + "px";
                    eleLines[iCounter].style.top = rectNode.top + (rectNode.height / 2) + "px";

                    angleDeg = Math.atan2(rectMain.top - rectNode.top, rectMain.left - rectNode.left) * 180 / Math.PI;

                    ia = rectNode.right - rectMain.left;
                    ib = rectNode.top - rectMain.top;
                }

                //eleLines[iCounter].style.left = rectMain.right + "px";
                //eleLines[iCounter].style.top = rectMain.top + (rectMain.height / 2) + "px";

                //angleDeg = Math.atan2(rectNode.top - rectMain.top, rectNode.left - rectMain.left) * 180 / Math.PI;

                //ia = rectMain.left - rectNode.left;
                //ib = rectMain.top - rectNode.top;

                iWidth = Math.sqrt(ia * ia + ib * ib);

                eleLines[iCounter].style.width = iWidth + "px";
                eleLines[iCounter].style.transform = "rotate(" + angleDeg + "deg)";

            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryWorkflowDashlet.adjustLinesPosition} " + err.message);
        }
    }
};
