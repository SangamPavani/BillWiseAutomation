    ToggleGroup: function (spanele) {
        let bingridId = transBinsPopup.getGridElement()
        let togglestate = spanele.getAttribute("data-toggle");
        let currentRow = spanele.parentElement.parentElement;
        let currentLevel = parseInt(currentRow.getAttribute("data-itreelevel"));
        let currentRowNo = parseInt(currentRow.getAttribute("data-irow"));
        let totalRows = FGRIDCONTROL.getTotalRows(bingridId);
        let nextRow = null;

        try{
            if (togglestate == "hide") { // expand the group childs
                //iterate through full rows , until the treelevel becomes equal to currentLevel or less
                for (var iCounter = currentRowNo + 1; iCounter <= totalRows; iCounter++) {
                    nextRow = transBinsPopup.getRowElement(iCounter);
                    if(parseInt(nextRow.getAttribute("data-itreelevel")) > currentLevel){
                        nextRow.style.display = "none";
                    }
                    else{
                        break;
                    }
                }
                //change icon to expand
                $(spanele).removeClass("icon-collepse");
                $(spanele).addClass("icon-expand").addClass("theme_color-inverse");

                //change the toggle state
                spanele.setAttribute("data-toggle", "expand");
            }
            else if (togglestate == "expand") { // hide the group childs
                //iterate through full rows , until the treelevel becomes equal to currentLevel or less
                for (var iCounter = currentRowNo + 1; iCounter <= totalRows; iCounter++) {
                    nextRow = transBinsPopup.getRowElement(iCounter);
                    if (parseInt(nextRow.getAttribute("data-itreelevel")) > currentLevel) {
                        nextRow.style.display = "";
                    }
                    else {
                        break;
                    }
                }
                //change icon to expand
                $(spanele).removeClass("icon-expand").addClass("icon-collepse");

                //change the toggle state
                spanele.setAttribute("data-toggle", "hide");
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.ToggleGroup}" + err.message, "EXCEPTION");
        }
    },

    ToggleChilds: function (parent,childGroup, rowCounter) {
        let gridEle = transBinsPopup.getGridElement();
        let totalRows = FGRIDCONTROL.getTotalRows(gridEle);
        let noOfChilds = 0;

        if ($(childGroup.children[1].children[0]).hasClass("icon-collepse")|| $(parent.children[1].children[0]).hasClass("icon-collepse")) {//for collapsing
            for (var childNo = rowCounter; childNo <= totalRows; childNo++) {
                noOfChilds++;
                nextChild = transBinsPopup.getRowElement(childNo);
                if (nextChild.getAttribute("data-iparentid") == FGRIDCONTROL.getCellData(childGroup, "ibinid")) {
                    if (nextChild.getAttribute("data-group") == "true") {
                        // continue;
                        BINS.ToggleChilds(nextChild, nextChild.nextElementSibling, childNo + 1);
                    }
                    else {
                        nextChild.style.display = "none";
                    }
                }
                else {
                    break;
                }
                $(childGroup.children[1].children[0]).removeClass("icon-collepse");
                $(childGroup.children[1].children[0]).addClass("icon-expand").addClass("theme_color-inverse");
            }
        }
        else if ($(childGroup.children[1].children[0]).hasClass("icon-expand") || $(parent.children[1].children[0]).hasClass("icon-expand")) {//for expanding
            for (var childNo = rowCounter; childNo <= totalRows; childNo++) {
                noOfChilds++;
                nextChild = transBinsPopup.getRowElement(childNo);
                if (nextChild.getAttribute("data-iparentid") == FGRIDCONTROL.getCellData(childGroup, "ibinid")) {
                    if (nextChild.getAttribute("data-group") == "true") {
                        continue;
                    }
                    else {
                        nextChild.style.display = "";
                    }
                }
                else {
                    break;
                }
                $(childGroup.children[1].children[0]).removeClass("icon-expand");
                $(childGroup.children[1].children[0]).addClass("icon-collepse").addClass("theme_color-inverse");
            }
        }
        return (noOfChilds - 1);
    },

