            "Net": {
                get: function () {
                    let iCounter = 0;
                    let value = "";
                    let objMetaData = undefined;

                    try {
                        for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Body.length; iCounter++) {
                            objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iCounter];
                            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYGROSS) {
                                value += objMetaData.sFieldName;
                            }
                            else if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                                if (objMetaData.iAddToNet == 0) { // Add To Net
                                    if (DataType.isNullOrEmpty(value, true) == false) {
                                        value += " + ";
                                    }

                                    value += objMetaData.sFieldName;
                                }
                                else if (objMetaData.iAddToNet == 1) { // Deduct From Net
                                    if (DataType.isNullOrEmpty(value, true) == false) {
                                        value += " - ";
                                    }

                                    value += objMetaData.sFieldName;
                                }
                            }
                        }

                        if (DataType.arrayLength(transEntryGlobal.EntryModel.MetaData.Footer) > 0) {
                            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Footer.length; iCounter++) {
                                objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iCounter];
                                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0 && objMetaData.iDataTypeId == eMasterDataType.Fraction) {
                                    if (objMetaData.iAddToNet == 0) { // Add To Net
                                        if (DataType.isNullOrEmpty(value, true) == false) {
                                            value += " + ";
                                        }

                                        value += objMetaData.sFieldName;
                                    }
                                    else if (objMetaData.iAddToNet == 1) { // Deduct From Net
                                        if (DataType.isNullOrEmpty(value, true) == false) {
                                            value += " - ";
                                        }

                                        value += objMetaData.sFieldName;
                                    }
                                }
                            }
                        }

                        if (DataType.isNullOrEmpty(value, true) == false) {
                            value = "Net = " + value;
                        }
                    }
                    catch (err) {
                        transEntryGlobal.writeErrorLog("{transEntryInfo.Net} " + err.message, GlobalPref.getResourceValue("Exception"));
                        value = false;
                    }

                    return (value);
                }
            },
            "isSavingAllowed": {
                get: function () {
                    try {
                        if (EntryMainToolbar.isButtonEnabled(transEntryToolbarId.Save) == false) {
                            return(false);
                        }

                        if (this.isEditing == true) {
                            if (EntryMain.checkPermission(SecurityActions.Edit) == false) {
                                return(false);
                            }

                            if (FConvert.isItWMSConfirm(transEntryInfo.VoucherType) == true && transEntryInfo.VoucherType != eVTTYPE.WMSDISPCONF) {
                                return(false);
                            }
                        }

                        if (EntryMain.checkPermission(SecurityActions.Add) == false) {
                            return(false);
                        }

                        if (this.isEditing == true && this.isStockRevaluation == true && this.HeaderFlags.Suspended == false) {
                            return (false);
                        }
                    }
                    catch (err) {
                        return(false);
                    }

                    return (true);
                }
