    afterLinkDataLoad: function (arrNewRowIndex, arrAvlBatch, arrLPNumber, iLinkId, bFromWorkflow) {
        let sRFID = "";
        let sId = "";
        let sMessage = "";
        let iCounter = 0;
        let iTotalRows = 0;
        let iReserveTransId = 0;
        let iRow = 0;
        let dBaseQty = 0;
        let objInput = undefined;
        let arrRFID = undefined;
        let arrRows = undefined;
        let arrRMA = undefined;
        let arrBinsData = undefined;
        let arrData = undefined;
        let arrMessage = [];
        let arrReserveTransId = undefined;
        let objMetaData = undefined;
        let result = undefined;
        let cell = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            if (DataType.isValidObject(arrNewRowIndex) == false) {
                arrNewRowIndex = [];
            }

            if (arrNewRowIndex.length == 0) {
                iTotalRows = transEntryGrid.getTotalRows();
                for (iCounter = 1; iCounter <= iTotalRows; iCounter++) {
                    if (EntryMainBody.isRowEditable(iCounter) == false) {
                        continue;
                    }

                    arrNewRowIndex.push(iCounter);
                }
            }

            if (transEntryFieldInfo.RFID.ColumnIndex > -1
                && transEntryFieldInfo.BatchNo.ColumnIndex > -1
                && transEntryInfo.RFIDPref.iBatch > 0) {

                arrRFID = [];
                arrRows = [];
                for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                    sRFID = EntryMainUI.getValueFromFieldId(transEntryFieldInfo.RFID.FieldId,
                                                            arrNewRowIndex[iCounter],
                                                            undefined,
                                                            eMasterDataType.Text).Value;
                    if (DataType.isNullOrEmpty(sRFID, true) == true || transEntryBatch.getBatchId(arrNewRowIndex[iCounter]) != 0) {
                        continue;
                    }

                    arrRFID.push(sRFID);
                    arrRows.push(arrNewRowIndex[iCounter]);
                }

                if (arrRFID.length > 0) {
                    transEntryServer.execute(eTransServerRequest.GetRFIDPartialData,
                        {
                            arrRFID: arrRFID
                        },
                        false,
                        "EntryMainCallback.setLinkRFIDData",
                        arrRows);
                }
            }

            if (transEntryFieldInfo.RMA.ColumnIndex > -1) {
                arrReserveTransId = [];
                for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                    iRow = arrNewRowIndex[iCounter];

                    if (transEntryFields.isRequired(eVTFIELDID.FDF_RMANO, iRow) == false) {
                        continue;
                    }

                    iReserveTransId = transEntryFields.getReserveTransId(iRow);
                    if (DataType.isZero(iReserveTransId) == true) {
                        continue;
                    }

                    //if (transEntryMaxQtyRelease.getReservingId(iRow) == 0) {
                    //    continue;
                    //}

                    objInput = {};
                    objInput.m_iProductId = EntryMainMemoryObject.getProductValue(iRow);
                    objInput.m_iInvTagId = transEntryInvTag.getValue(iRow);
                    objInput.m_iBodyId = 0;
                    objInput.m_iReserveTransId = iReserveTransId;


                    objInput.m_sOtherRowsBodyId = -1;
                    objInput.m_iBatchTransactionId = 0;

                    if (transEntryInfo.isInwardVoucher == false
                        && transEntryFieldInfo.BatchNo.ColumnIndex > -1) {

                        objInput.m_iBatchTransactionId = transEntryBatch.getBatchId(iRow);
                    } 

                    dBaseQty = transEntryFields.getQty(iRow);
                    //objInput.iSelectCount = dBaseQty;
                    objInput.iVoucherDate = EntryMain.m_objTrans.Header.Date;
                    objInput.iSelectCount = 0;

                    result = transEntryServer.execute(eTransServerRequest.GetRMAReservedData, objInput, false);

                    arrRMA = [];
                    if (result.lValue > 0 && DataType.arrayLength(result.data) > 0) {
                        for (iRow = 0; iRow < result.data.length; iRow++) {
                            arrRMA.push(result.data[iRow].SerialNo);
                        }

                        if (DataType.arrayFindDataIndex(arrReserveTransId, iReserveTransId, "==").length == 0) {
                            arrReserveTransId.push(iReserveTransId);
                        }
                        else {
                            // Remove previously used rma if any
                            for (iRow = 0; iRow < iCounter; iRow++) {
                                result = transEntryRMA.getValue(arrNewRowIndex[iRow]);
                                if (DataType.arrayLength(result) > 0) {
                                    DataType.arrayRemove(arrRMA, result);
                                }
                            }
                        }
                    }

                    while (dBaseQty < arrRMA.length) {
                        arrRMA.splice(arrRMA.length - 1, 1);
                    }

                    if (arrRMA.length > 0) {
                        iRow = arrNewRowIndex[iCounter];
                        EntryMainRMA.processRMASelectedData(iRow, arrRMA, false);
                    }
                }
            }

            if (DataType.arrayLength(arrAvlBatch) > 0
                && transEntryFieldInfo.BatchNo.ColumnIndex > -1) {

                for (iCounter = 0; iCounter < arrAvlBatch.length; iCounter++) {
                    iRow = arrAvlBatch[iCounter].iIndex;
                    iRow = arrNewRowIndex[iRow];

                    dBaseQty = EntryMainMemoryObject.getBaseQuantityValue(iRow, true);
                    if (FNumberOperation.isLessThan(arrAvlBatch[iCounter].AvlQty, dBaseQty) == true) {
                        EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                        EntryMainUI.clear(transEntryFieldInfo.MFGDate, iRow);
                        EntryMainUI.clear(transEntryFieldInfo.EXPDate, iRow);

                        sMessage = "Batch '" + arrAvlBatch[iCounter].BatchNo + "' cleared for row " + iRow + " because it has available qty " + arrAvlBatch[iCounter].AvlQty + " whereaas required qty is " + dBaseQty;
                        arrMessage.push(sMessage);

                        transEntryGlobal.writeErrorLog("Info: " + sMessage);
                    }
                }
            }

            if (DataType.arrayLength(arrLPNumber) > 0) {
                if (transEntryGlobal.debugLPN == true) {
                    debugger
                }

                for (iCounter = 0; iCounter < arrLPNumber.length && iCounter < arrNewRowIndex.length; iCounter++) {
                    iRow = arrNewRowIndex[iCounter];

                    if (DataType.isNullOrEmpty(arrLPNumber[iCounter], true) == false) {
                    //    obj = transEntrySkid.createLPNumber(arrLPNumber[iCounter], iRow);
                    //    if (obj.ID > 0) {
                    //        cell = EntryMainUI.getElement(transEntryFieldInfo.Skid, iRow).Value;
                    //        if (cell) {
                    //            cell.setCellText(obj.Name, obj.ID);
                    //            EntryMainMemoryObject.update(eVTFIELDID.FDF_SKID, obj.ID, iRow);
                    //        }
                    //    }
                    }                    
                }
            }

            result = transEntryFieldInfo.getLinkFields({ LinkId: iLinkId });
            if (result.length > 0) {
                objMetaData = result[0].MetaData;
            }

            if (transEntryInfo.isItSales == true && transEntryInfo.isInwardVoucher == false && DataType.isValidObject(objMetaData) == true) {

                if (DataType.arrayLength(arrAvlBatch) < 1
                    && transEntryFieldInfo.BatchNo.ColumnIndex > -1
                    && transEntryInfo.Settings.Inventory.BatchPick > 0
                    && transEntryLinks.isFieldExistInMappings(eVTFIELDID.FDF_BODYBATCHNO, objMetaData.Tag.Mappings) == false) {

                    arrData = [];
                    for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                        iRow = arrNewRowIndex[iCounter];

                        if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, iRow) == true) {
                            obj = EntryMainBatch.getBatchInputObject(iRow, true);
                            if (DataType.isValidObject(obj) == false) {
                                continue;
                            }

                            obj.iRowNo = iRow;

                            arrData.push(obj);
                        }
                    }

                    if (arrData.length > 0) {
                        sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYBATCHNO);

                        MRP_BATCH.GetAutoAllocateBATCH(arrData, sId, "EntryMainAutoAllocate.resultBatch", "", transEntryGlobal.bPassTransQtyInBatchPopup);
                    }
                }

                if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                    if (transEntryInfo.Settings.Inventory.BinsPick > 0 && transEntryLinks.isFieldExistInMappings(eVTFIELDID.FDF_BINS, objMetaData.Tag.Mappings) == false) {

                        arrData = [];
                        arrRows = [];
                        for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                            iRow = arrNewRowIndex[iCounter];
                            if (transEntryBins.isBinsRequired(iRow, false) == true) {
                                obj = transEntryBins.getBinsParamObject(iRow, false);
                                arrData.push(obj);
                                arrRows.push(iRow);
                            }
                        }

                        if (arrData.length > 0) {
                            result = transEntryServer.execute(eTransServerRequest.LoadMultipleBinDetails, { arrBinsParam: arrData });

                            if (result.lValue < 1) {
                            }
                            else {
                                arrBinsData = result.data.data;
                                for (iCounter = 0; iCounter < arrRows.length; iCounter++) {
                                    if (DataType.isValidObject(arrBinsData[iCounter]) == false) {
                                        continue;
                                    }

                                    iRow = arrRows[iCounter];
                                    EntryMainBins.openBinsPopup(iRow, transEntryFieldInfo.Bins.ColumnIndex, true, arrBinsData[iCounter]);
                                }
                            }
                        }
                    }
                    else if (transEntryInfo.Settings.Inventory.BinsPick == 0 && transEntryLinks.isFieldExistInMappings(eVTFIELDID.FDF_BINS, objMetaData.Tag.Mappings) == true) {
                        for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                            iRow = arrNewRowIndex[iCounter];
                            if (transEntryBins.isBinsRequired(iRow, false) == true) {
                                dBaseQty = EntryMainMemoryObject.getBaseQuantityValue(iRow, true);
                                dBaseQty = DataType.abs(dBaseQty);

                                arrBinsData = transEntryFields.getBins(iRow);
                                if (DataType.arrayLength(arrBinsData) < 1 || DataType.isZero(dBaseQty) == true) {
                                    continue;
                                }

                                if (arrBinsData.length == 1) {
                                    if (DataType.gt(dBaseQty, transEntryBins.sumQuantity(arrBinsData, true)) == true) {
                                        EntryMainUI.clear(transEntryFieldInfo.Bins, iRow);

                                        sMessage = "Bins cleared for row " + iRow + " because it has qty " + transEntryBins.sumQuantity(arrBinsData, true) + " whereaas required qty is " + dBaseQty;
                                        arrMessage.push(sMessage);

                                        transEntryGlobal.writeErrorLog("Info: " + sMessage);
                                    }
                                    else {
                                        transEntryBins.updateQuantity(iRow, dBaseQty, false);
                                    }
                                }
                                else if (arrBinsData.length > 1) {
                                    if (DataType.neq(dBaseQty, transEntryBins.sumQuantity(arrBinsData, true)) == true) {
                                        EntryMainUI.clear(transEntryFieldInfo.Bins, iRow);

                                        sMessage = "Bins cleared for row " + iRow + " because it has qty " + transEntryBins.sumQuantity(arrBinsData, true) + " whereaas required qty is " + dBaseQty;
                                        arrMessage.push(sMessage);

                                        transEntryGlobal.writeErrorLog("Info: " + sMessage);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            sMessage = "";
            for (iCounter = 0; iCounter < arrMessage.length; iCounter++) {
                if (iCounter > 0) {
                    sMessage += "<br>";
                }

                sMessage += arrMessage[iCounter];
            }

            if (DataType.isNullOrEmpty(sMessage) == false) {
                transEntryGlobal.showAlert(sMessage, "Info");
            }

            if (arrNewRowIndex.length > 0 && bFromWorkflow == true) {
                iRow = arrNewRowIndex[arrNewRowIndex.length - 1] + 1;
                transEntryGrid.gotoCell(iRow, 0);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainUI.afterLinkDataLoad} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

