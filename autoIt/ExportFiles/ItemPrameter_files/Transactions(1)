                else {
                    if (bCurrencyIdChanged == true) {
                        EntryMainBillwise.updateDirtyRowFlag(0, eVTFIELDID.FDF_HEADERCURRENCY);
                        if (transEntryFieldInfo.Billwise.ColumnIndex > -1) {
                            for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                                transEntryReference.updateRequiredFlag(iRow);
                            }
                        }
                    }
                }
            }

            iCurrencyId = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
            if (iCurrencyId > 0) {
                iNoOfDecimals = DataType.toInt(OPTIONCONTROL.getControlValue(sId, "iNoOfDecimals"));
                fGeneralRoundOff = DataType.toDecimal(OPTIONCONTROL.getControlValue(sId, "fGeneralRoundOff"));
                if (DataType.gt(iNoOfDecimals, 0) == true && DataType.eq(fGeneralRoundOff, 0) == true) {
                    transEntryGlobal.showAlert("Round off is 0 for selected currency.", "Warning");
                }
            }

            transEntryExchangeRate.update();

            if (transEntryFieldInfo.LocalExchangeRate.Area == eTranEntryFieldArea.Header) {
                obj = {};
                obj.iTransactionCurrencyId = EntryMainMemoryObject.getCurrencyId(0, true);
                if (obj.iTransactionCurrencyId > 0) {
                    obj.iDepartmentId = EntryMain.m_objTrans.BodyData[0].FATag;
                    if (DataType.toInt(obj.iDepartmentId) > 0) {
                        obj.iDate = EntryMain.m_objTrans.Header.Date;
                        obj.iTime = FTime.getCurrentTime();
                        obj.iLocalCurrencyId = transEntryInfo.MiscellaneousPref.iLocalCurrency;

                        transEntryServer.execute(eTransServerRequest.GetExchRateForLocalCurr,
                            obj,
                            false,
                            "EntryMainCallback.getExchangeRateForLocalCurrency");
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.changeCurrencyH} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

