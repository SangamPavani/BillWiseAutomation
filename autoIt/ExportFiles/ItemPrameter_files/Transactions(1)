const transEntryCurrency = {
    getDecimals: function (iRow, bGlobal) {
        let value = 0;
        let ctrl = null;

        try {
            if (DataType.toBoolean(bGlobal) == true) {
                return (transEntryInfo.DecimalsInAmount);
            }

            iRow = DataType.toInt(iRow);
            ctrl = EntryMainUI.getElement(transEntryFieldInfo.Currency, iRow).Value;

            if (DataType.isValidObject(ctrl) == false) {
                return (transEntryInfo.DecimalsInAmount);
            }

            if ((typeof ctrl).toLowerCase() == "string") {
                value = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl));
                if (value == 0) {
                    return (transEntryInfo.DecimalsInAmount);
                }

                value = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl, "inoofdecimals"));
            }
            else {
                value = DataType.toInt(ctrl.getCellData());
                if (value == 0) {
                    return (transEntryInfo.DecimalsInAmount);
                }

                value = DataType.toInt(ctrl.getCellData("inoofdecimals"));
            }
        }
        catch (err) {
        }

        return (value);
    },

    getNumericSeparator: function (iRow) {
        let iValue = 0;

        try {
            iRow = DataType.toInt(iRow);
            if (transEntryFields.getCurrency(iRow) == 0) {
                return (EntryMain.m_NumericSeparator);
            }
            else {
                // 0 (Default Global Preference)
                // 1 (##,##,###.00)
                // 2 (#,###,###.00)
                iValue = transEntryFields.getMandatoryValue(transEntryFieldInfo.Currency, iRow, "iNumericSeperator", eMasterDataType.Number);
