                                if (objControl.Value) {
                                    objResult.Value = objControl.Value.checked;
                                }
                                else {
                                    objResult.Error = eTransGetValueResult.InvalidControl;
                                }

                                objResult.Value = DataType.toBoolean(objResult.Value);
                                break;
                            case eMasterDataType.Date:
                                objResult.Value = DATEPICKER.getDate(objControl.Value);
                                break;
                            case eMasterDataType.Time:
                                objResult.Value = FTIMECONTROL.getTime(objControl.Value);
                                break;
                            case eMasterDataType.StringList:
                                if (objControl.Value == undefined || objControl.Value == null) {
                                    objResult.Error = eTransGetValueResult.InvalidControl;
                                }
                                else if (objControl.Value.selectedIndex < 0) {
                                    objResult.Error = eTransGetValueResult.NothingSelected;
                                }
                                else {
                                    objResult.Value = objControl.Value.options[objControl.Value.selectedIndex].text;
                                }
                                break;
                            case eMasterDataType.NumberList:
                                if (objControl.Value == undefined || objControl.Value == null) {
                                    objResult.Error = eTransGetValueResult.InvalidControl;
                                }
                                else if (objControl.Value.selectedIndex < 0) {
                                    objResult.Error = eTransGetValueResult.NothingSelected;
                                }
                                else {
                                    objResult.Value = objControl.Value.options[objControl.Value.selectedIndex].value;
                                }
                                break;
                            case eMasterDataType.HyperLink:
                                objResult.Value = FHyperLink.getValue(objControl.Value);
                                break;
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                                objResult.Value = DataType.toInt(OPTIONCONTROL.getControlValue(objControl.Value));
                                break;
                            case eMasterDataType.Picture:
                            case eMasterDataType.DocumentViewer:
                                objResult.Value = FATTACHMENTCONTROL.getData(objControl.Value).data;
                                break;
                        }

                        return (objResult);
                    }
                    else if ((iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                        objFieldInfo = EntryMainUI.getFieldInfo(iFieldId);
                        objControl = EntryMainUI.getElement(objFieldInfo, iRow, true);
                        if (objControl.Value) {
                            objResult.Value = objControl.Value.getAttribute(CELL_VALUE);
                        }

                        switch (objFieldInfo.MetaData.iDataTypeId) {
                            case eMasterDataType.Text:
                                objResult.Value = DataType.toString(objResult.Value);
                                break;
                            case eMasterDataType.TinyNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.Fraction:
                                objResult.Value = FNumberOperation.convert(objResult.Value);
                                break;
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                                objResult.Value = DataType.toInt(objResult.Value);
                                break;
                        }

                        objResult.Error = objControl.Error;

                        return (objResult);
                    }
                    break;

            }

            if (transEntryGlobal.EntryModel.MetaData.Footer != undefined && transEntryGlobal.EntryModel.MetaData.Footer != null) {
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Footer.length; iCounter++) {
                    if (transEntryGlobal.EntryModel.MetaData.Footer[iCounter].iFieldId != iFieldId) {
                        continue;
                    }

                    sId = EntryMainUI.getFooterControlId(iFieldId);
                    if (transEntryGlobal.EntryModel.MetaData.Footer[iCounter].iDataTypeId == eMasterDataType.Master) {
                        objResult.Value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                    }
                    else {
                        ctrl = document.getElementById(sId);
                        if (ctrl != undefined && ctrl != null) {
                            objResult.Value = ctrl.value;

                            ctrl = document.getElementById(EntryMainUI.getFooterControlId(iFieldId, true));
                            objResult.Output = ctrl.value;
                        }
                        else {
                            objResult.Error = eTransGetValueResult.InvalidControl;
                        }
                    }

                    switch (eDataType) {
                        case eMasterDataType.Fraction:
                            objResult.Value = FNumberOperation.convert(objResult.Value);
                            objResult.Output = FNumberOperation.convert(objResult.Output);
                            break;
                    }

                    return (objResult);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getValueFromFieldId} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

