    getTotalIssueGross: function () {
        let dTotalGross = 0;
        let iRow = 1;
        let iIssue = 0;

        try {
            if (transEntryFieldInfo.RctIssue.ColumnIndex < 0 || transEntryFieldInfo.Gross.ColumnIndex < 0) {
                return (0);
            }

            for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                iIssue = transEntryFields.getRctIssueValue(iRow);
                if (iIssue == 0) { // Issue
                    //dTotalGross += DataType.toDecimal(transEntryFields.getGross(iRow));
                    dTotalGross = FNumberOperation.add(dTotalGross, DataType.toDecimal(transEntryFields.getGross(iRow)));
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainProductionProcess.getTotalIssueGross}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (dTotalGross);
    },

    calculateReceivedRate: function (iRow, objLog) {       
        let iRctIndex = -1;
        let dValue = 0;
        let dTotalIssuedGross = 0;
        let iMaskedVoucherType = 0;

        try {
            if (iRow <= 0) {
                return;
            }

            iMaskedVoucherType = (transEntryInfo.VoucherType & eVTTYPE.VOUCHERMASK);
            if (iMaskedVoucherType == eVTTYPE.WDONE) {
                if (EntryMainProductionProcess.isIssueRow(iRow) == false) {
                    return;
                }

                dTotalIssuedGross = 0;
                for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        continue;
                    }

                    if (EntryMainProductionProcess.isIssueRow(iRow) == true) {
                        dTotalIssuedGross = FNumberOperation.add(dTotalIssuedGross, EntryMainMemoryObject.getGrossValue(iRow));
                        //dTotalIssuedGross += EntryMainMemoryObject.getGrossValue(iRow);
                    }
                    else if (EntryMainProductionProcess.isReceiptRow(iRow) == true) { // Receipts
                        iRctIndex = iRow;
                    }
                }


                if (DataType.isValidObject(EntryMain.m_objProductionHeader) == true
                    && DataType.isValidObject(EntryMain.m_objProductionHeader.ProductionBody) == true) {

                    let bodyData = EntryMain.m_objProductionHeader.ProductionBody;
                    for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                        if (EntryMainProductionProcess.isReceiptRow(iRow) == true) {
                            var iProductId = transEntryFields.getItem(iRow);
                            var dCostPercentage = parseFloat(bodyData.find(s => s.ProductId == iProductId).CostPercent);
                            var dProductGross = parseFloat(dTotalIssuedGross) * parseFloat(dCostPercentage) / 100;
                            var dProductRate = dProductGross / transEntryFields.getQty(iRow);
                            transEntryGross.setValue(dProductGross, iRow, true);
                            transEntryRate.update(dProductRate, iRow);
                        }
                    }
                }

                //if (iRctIndex != -1) {
                //    transEntryGross.setValue(dTotalIssuedGross, iRctIndex, true);
                //    dValue = dTotalIssuedGross / transEntryFields.getQty(iRctIndex);
                //    transEntryRate.update(dValue, iRctIndex);
                //}
            }

        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainProductionProcess.calculateReceivedRate}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

