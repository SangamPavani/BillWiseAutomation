    processSetSelection: function (iSetId, cellobj) {
        let sSetName = "";
        let iCounter = 0;
        let iRow = 0;
        let value = 0
        let iFAValue = 0;
        let iInvValue = 0;
        let bRowAdded = false;
        let arrSets = undefined;
        let objFAInfo = undefined;
        let objInvInfo = undefined;
        let result = undefined;
        let data = undefined;
        let cell = undefined;

        try {
            if (transEntryGlobal.debugSetSelection == true) {
                debugger
            }

            sSetName = cellobj.getCellData("sname");
            if (EntryMainUI.createSetQtyField() == true) {
                return;
            }

            result = transEntryServer.execute(eTransServerRequest.GetSetsDetails,
                {
                    iSetId: iSetId,
                    iInvTag: transEntryFields.getInvTag(cellobj.iRow),
                    iDate: EntryMain.m_objTrans.Header.Date,
                    iCurrencyId: 0
                });

            if (result.lValue < 1) {
                return;
            }

            arrSets = result.data.data;
            if (DataType.arrayLength(arrSets) < 1
                || DataType.isValidObject(arrSets[0].BodyHeader.BodyList) == false
                || DataType.arrayLength(arrSets[0].BodyHeader.BodyList) < 1) {
                return;
            }

            if (arrSets[0].BodyHeader.AllowModificationOfItemAfterLoading == false) {
                EntryMainSet.setRowInfo(cellobj.iRow, iSetId, arrSets[0].BodyHeader.BodyList.length, true);
                if (transEntryFieldInfo.SetQty.ColumnIndex > -1) {
                    EntryMainSet.setSetQty(cellobj.iRow, "1", 1);
                    transEntryQuantity.setValue(1, cellobj.iRow, { bUpdateMemoryObject: true });
                }
            }

            if (arrSets[0].BodyHeader.FixedAmt != 0) {
                arrSets[0].BodyHeader.FixedAmt = transEntryRate.update(arrSets[0].BodyHeader.FixedAmt, cellobj.iRow);
            }
            else {
                arrSets[0].BodyHeader.BodyList[0].Price = transEntryRate.update(arrSets[0].BodyHeader.BodyList[0].Price, cellobj.iRow);
            }

            if (transEntryFieldInfo.SetName.ColumnIndex > -1) {
                transEntryGrid.setCellText(cellobj.iRow, transEntryFieldInfo.SetName.ColumnIndex, sSetName, sSetName);
            }

            objFAInfo = transEntryFieldInfo.FATag;
            objInvInfo = transEntryFields.getInfo(eTransEntryField.InvTag, true);
            if (objFAInfo.Area == eTranEntryFieldArea.Body) {
                iFAValue = transEntryFields.getFATag(cellobj.iRow);
            }

            if (objInvInfo.Area == eTranEntryFieldArea.Body) {
                iInvValue = transEntryFields.getInvTag(cellobj.iRow);
            }


            bRowAdded = false;
            for (iCounter = 0; iCounter < arrSets[0].BodyHeader.BodyList.length; iCounter++) {
                if (arrSets[0].BodyHeader.AllowModificationOfItemAfterLoading == true) {
                    iRow = cellobj.iRow + iCounter;
                    if (iCounter > 0) {
                        transEntryGrid.insertRows(iRow, 1, true);
                        bRowAdded = true;
                    }
                }
                else {
                    iRow = cellobj.iRow + iCounter + 1;
                    transEntryGrid.insertRows(iRow, 1, true);

                    bRowAdded = true;
                }

                //iRow = cellobj.iRow + iCounter + 1;
                //transEntryGrid.insertRows(iRow, 1, true);

                if (iFAValue > 0 && bRowAdded == true) {
                    transEntryGrid.copyColumnData(iRow - 1, objFAInfo.ColumnIndex, iRow, objFAInfo.ColumnIndex);
                }

                if (iInvValue > 0 && bRowAdded == true) {
                    transEntryGrid.copyColumnData(iRow - 1, objInvInfo.ColumnIndex, iRow, objInvInfo.ColumnIndex);
                }

                if (arrSets[0].BodyHeader.AllowModificationOfItemAfterLoading == false) {
                    EntryMainSet.setRowInfo(iRow, iSetId, arrSets[0].BodyHeader.BodyList.length, false);
                }

                result = OPTIONCONTROL.createSetValueExtraObject();
                result.bLoadAll = false;
                result.bIgnoreChangeCallback = true;
                OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, arrSets[0].BodyHeader.BodyList[iCounter].Id, null, result);

                cell = EntryMainUI.getElement(transEntryFieldInfo.Item, iRow).Value;
                data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
                value = EntryMainBody.updateMasterValue(cell, data, 0, false);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, value, iRow);
                if (value > 0) {
                    EntryMainBody.setDefaultDescription(iRow);
                    if (transEntryGlobal.FieldHelper.arrDependentProductColumn.length > 0) {
                        EntryMainDependency.processBodyProductDependency(cell.iRow,
                            cell.iColumn,
                            {
                                MasterTypeId: eMasterTypeId.Product,
                                CallingSource: eDisplayBodyDataSource.None,
                                LoadedDataSource: eLoadedDataSource.None
                            });
                    }
                }


                if (arrSets[0].BodyHeader.FixedAmt == 0) {
                    transEntryRate.update(arrSets[0].BodyHeader.BodyList[iCounter].Price, cell.iRow);
                }

                transEntryQuantity.setValue(arrSets[0].BodyHeader.BodyList[iCounter].Quantity, cell.iRow, { bUpdateMemoryObject: true });

                transEntryQuantity.processChange(0, arrSets[0].BodyHeader.BodyList[iCounter].Quantity, cell.iRow);

                if (transEntryFieldInfo.SetName.ColumnIndex > -1) {
                    transEntryGrid.setCellText(cell.iRow, transEntryFieldInfo.SetName.ColumnIndex, sSetName, sSetName);
                }

                if (transEntryFieldInfo.Unit.ColumnIndex > -1
                    && arrSets[0].BodyHeader.BodyList[iCounter].UnitId > 0) {

                    transEntryFields.setUnit(arrSets[0].BodyHeader.BodyList[iCounter].UnitId, cell.iRow);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYUNITS, value, iRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainSet.processSetSelection} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    processChangeQuantity: function (dOldValue, dNewValue, iRow) {
        let objRowInfo = null;
        let dNewQty = 0;
        let dQty = 0;
        let dRate = 0;

        try {
            objRowInfo = EntryMainSet.getRowInfo(iRow);
            if (objRowInfo.iSetId < 1) {
                return;
            }

            transEntryQuantity.setValue(dNewValue, iRow, { bUpdateMemoryObject: true });

            dOldValue = DataType.toDecimal(dOldValue);
            dNewValue = DataType.toDecimal(dNewValue);
            for (iRow = objRowInfo.iStartRow + 1; iRow <= objRowInfo.iEndRow; iRow++) {
                dQty = transEntryFields.getQty(iRow);
                dRate = EntryMainMemoryObject.getRateValue(iRow);

                //dNewQty = (dQty / dOldValue) * dNewValue;

                dNewQty = DataType.div(dQty, dOldValue);
                dNewQty = DataType.mul(dNewQty, dNewValue);

                transEntryQuantity.setValue(dNewQty, iRow, { bUpdateMemoryObject: true });

                if (transEntryFieldInfo.Rate.ColumnIndex > -1
                    && transEntryFieldInfo.Gross.ColumnIndex > -1) {

                    transEntryGrid.setCellNumber(iRow,
                                                    transEntryFieldInfo.Gross.ColumnIndex, 
                                                    DataType.mul(dNewQty, dRate), 
                                                    transEntrySettings.getDecimalsInAmount(iRow));
                }
            }

            transEntryGross.calculateAndUpdate({ iRow: objRowInfo.iStartRow });
            EntryMainUI.setSummaryInfo(0);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainSet.processChangeQuantity} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
