    getReservedQtyRemaining: function (bSuccess, data, objCustomData) {
        let dMaxRelease = 0;
        let dUsedQty = 0;
        let dBaseQty = 0;
        let lReservingId = 0;

        try {
            if (bSuccess == false) {
                return;
            }

            if (DataType.isValidObject(EntryMainUI.getElement(transEntryFieldInfo.Qty, objCustomData.iRow).Value) == false
                || DataType.isValidObject(EntryMainUI.getElement(transEntryFieldInfo.MaxQtyRelease, objCustomData.iRow).Value) == false) {
                return;
            }

            if (data.lValue < 1 || data.data.lValue < 1) {
                return;
            }

            dMaxRelease = FConvert.toDecimal(data.data.Name);
            lReservingId = DataType.toInt(data.data.Tag);

            transEntryMaxQtyRelease.setReservingId(objCustomData.iRow, lReservingId);
            transEntryMaxQtyRelease.setMaxRelease(objCustomData.iRow, dMaxRelease);
            transEntryMaxQtyRelease.setRefId(objCustomData.iRow, objCustomData.lRefId);

            dUsedQty = transEntryMaxQtyRelease.getUsedReleaseValue(objCustomData.lRefId, objCustomData.iRow);
            dMaxRelease = DataType.sub(dMaxRelease, dUsedQty);
            if (DataType.lt(dMaxRelease, 0) == true) {
                dMaxRelease = 0;
            }

            dBaseQty = DataType.toDecimal(EntryMainMemoryObject.getBaseQuantityValue(objCustomData.iRow));
            if (DataType.lt(dBaseQty, dMaxRelease) == true) {
                dMaxRelease = dBaseQty;
            }

            transEntryMaxQtyRelease.setText(FConvert.toDecimal(dMaxRelease, transEntryQuantity.getDecimals()), dMaxRelease);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.getReservedQtyRemaining} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

