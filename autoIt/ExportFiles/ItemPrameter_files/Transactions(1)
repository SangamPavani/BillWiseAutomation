    getCellValue: function (cellobj, objMetaData) {
        let value;
        let temp;

        try {
            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    value = DataType.toInt(cellobj.getCellData());
                    break;
                case eMasterDataType.Date:
                case eMasterDataType.Time:
                    temp = DataType.toInt(cellobj.getCellData());
                    if (objMetaData.bMandatory == true) {
                        if (temp !== "") {
                            temp = DataType.toInt(temp);
                        }
                    }
                    else {
                        temp = DataType.toInt(temp);
                    }
                    value = temp;
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    temp = DataType.toString(cellobj.getCellData());
                    if (objMetaData.bMandatory == true) {
                        if (temp !== "") {
                            temp = DataType.toInt(temp);
                        }
                    }
                    else {
                        temp = DataType.toInt(temp);
                    }
                    value = temp;
                    break;
                case eMasterDataType.Fraction:
                    temp = DataType.toString(cellobj.getCellData());
                    if (objMetaData.bMandatory == true) {
                        if (temp !== "") {
                            temp = DataType.toDecimal(temp);
                        }
                    }
                    else {
                        temp = DataType.toDecimal(temp);
                    }
                    value = temp;
                    break;
                case eMasterDataType.Boolean:
                    if (cellobj.hasControl() == true) {
                        value = cellobj.getControl().checked == true ? 1 : 0;
                    }
                    else if (objMetaData.bMandatory == false) {
                        value = 0;
                    }
                    break;
                case eMasterDataType.StringList:
                    value = cellobj.getCellText();
                    break;
                case eMasterDataType.NumberList:
                    temp = DataType.toString(cellobj.getCellData());
                    if (temp !== "") {
                        temp = DataType.toInt(temp);
                    }
                    value = temp;
                    break;
                case eMasterDataType.Picture:
                case eMasterDataType.DocumentViewer:
                    temp = DataType.toString(cellobj.getCellText());
                    if (temp !== "") {
                        temp = {};
                        temp.iFieldId = objMetaData.iFieldId;
                        temp.sFileName = cellobj.getCellText();
                        objDocument.sData = cellobj.getCellData();
                    }
                    value = temp;
                    break;
                case eMasterDataType.Text:
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_LINK) {
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                        if (FConvert.isItInwardVoucher(transEntryInfo.VoucherType) == true) {
                            value = DataType.toString(cellobj.getCellData());
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_RMANO) {
                        value = DataType.toString(cellobj.getCellData());
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS || objMetaData.iFieldId == eVTFIELDID.FDF_BINS2) {
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_DEPTAPPROP) {
                    }
                    else {
                        value = DataType.toString(cellobj.getCellData());
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.getCellValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

