                                break;
                            }
                        }
                    }
                }
            }

            //instead of refilling the entire grid again ,just change the tobeallocate value in cell and in object
            //arrData has BinId, from BinId ,take out arrIndex and update in m_objBinsData ,and irow attr,and update tobeallocate cell.

            for (var k = 0; k < arrData.length; k++) {
                if (BinsUI.m_BinsParam.Inward) {
                    if (BinsUI.m_isPaging) {
                        iarrIndex = (BinsUI.m_objFullBinsData.BinDetails).map(function (x) { return x.Id; }).indexOf(arrData[k].BinId);
                        BinsUI.m_objFullBinsData.BinDetails[iarrIndex].ToBeAllocated = BinsUI.AddDecimalInColumn(arrData[k].Quantity);
                        BinsUI.setToBeAllocatedValue(arrData[k].Quantity, arrData[k].BinId, arrData[k].SkidId, arrData[k].Category, arrData[k].Batch, BinsUI.m_objBinsData.BinDetails);
