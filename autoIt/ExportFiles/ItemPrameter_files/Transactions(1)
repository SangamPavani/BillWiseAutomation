const transEntryUI = {
    calculateMainHeight: function () {
        let iHeight = 0;
        let value = "";
        let eleContainer = null;
        let ele = null;
        let rect = null;

        try {
            iHeight = window.innerHeight;

            ele = document.getElementById("id_footer");
            if (FCommon.UI.isValidObject(ele) == true) {
                iHeight -= ele.getBoundingClientRect().height;
            }

            eleContainer = UIContainer.getDefaultContainer();
            if (FCommon.UI.isValidObject(eleContainer) == false) {
                return(0);
            }

            rect = eleContainer.getBoundingClientRect();
            if (rect.height == 0) {
                return (0);
            }
            iHeight -= rect.top;

            value = window.getComputedStyle(eleContainer, null).getPropertyValue('padding-top');
            if (FCommon.String.isNullOrEmpty(value) == false) {
                value = value.toLowerCase();
                value = value.split("px");
                if (value.length > 0) {
                    iHeight -= FConvert.toInt(value[0]);
                }
            }

            value = window.getComputedStyle(eleContainer, null).getPropertyValue('padding-bottom');
            if (FCommon.String.isNullOrEmpty(value) == false) {
                value = value.toLowerCase();
                value = value.split("px");
                if (value.length > 0) {
                    iHeight -= FConvert.toInt(value[0]);
                }
            }
        }
        catch (err) {
            iHeight = 0;
            FUIElement.writeErrorLog("Exception: {transEntryUI.calculateMainHeight} " + err.message);
        }

        return (iHeight);
    },

    getSummaryBarHeight: function () {
        let iHeight = 0;
        let value = "";
        let ele = null;
        let rect = null;

        try {
            ele = document.getElementById("id_transactionentry_summary");
            if (FCommon.UI.isValidObject(ele) == true) {
                rect = ele.getBoundingClientRect();

                iHeight = rect.height;

                value = window.getComputedStyle(ele, null).getPropertyValue('margin-top');
                if (FCommon.String.isNullOrEmpty(value) == false) {
                    value = value.toLowerCase();
                    value = value.split("px");
                    if (value.length > 0) {
                        iHeight += FConvert.toInt(value[0]);
                    }
                }
            }
        }
        catch (err) {
            iHeight = 0;
            FUIElement.writeErrorLog("Exception: {transEntryUI.getSummaryBarHeight} " + err.message);
        }

        return (iHeight);
    },

    updateMainHeight: function () {
        let iHeight = 0;
        let ele = null;

        try {
            ele = transEntryElement.getEntryContainer();
            if (FCommon.UI.isValidObject(ele) == false) {
                return (0);
            }

            iHeight = this.calculateMainHeight();
            if (iHeight > 0) {
                ele.style.height = iHeight + "px";
            }
        }
        catch (err) {
            iHeight = 0;
            FUIElement.writeErrorLog("Exception: {transEntryUI.updateMainHeight} " + err.message);
        }

        return (iHeight);
    },

    updateHeight: function () {
        let iPageHeight = 0;
        let iFooterHeight = 0;
        let iContainerTop = 0;
        let ele = undefined;

        try {
            iPageHeight = transEntryUI.updateMainHeight();
            if (iPageHeight == 0) {
                return;
            }

            ele = UIContainer.getDefaultContainer();
            if (FCommon.UI.isValidObject(ele) == false) {
                return;
            }
            ele.scrollTop = 0;

            ele = transEntryElement.getEntryContainer();
            iContainerTop = ele.getBoundingClientRect().top;

            //ele = document.getElementById("id_transactionentry_container_body_entry");
            ele = EntryMainUI.getBodyEntryContainer();
            if (FCommon.UI.isValidObject(ele) == false) {
                return;
            }

            iFooterHeight = transEntryUI.getSummaryBarHeight();
            iPageHeight -= iFooterHeight;
            iPageHeight -= (ele.getBoundingClientRect().top - iContainerTop);

            ele.style.height = (iPageHeight - 10) + "px";

            transEntryUI.updateGridHeight();

            TRANSACTION_ENTRY.SCREENSIZE.adjustGridColumns();

            transEntryInfoSideBar.updateHeight();
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryUI.updateHeight} " + err.message);
        }
    },

    updateGridHeight: function () {
        let iHeight = 0;
        let iTotalRows = 0;
        let iDiffRows = 0;
        let iRowHeight = 0;
        let rect = undefined;
        let ele = undefined;

        ele = EntryMainUI.getBodyEntryContainer();
        if (DataType.isValidObject(ele) == false) {
            return;
        }
        rect = ele.getBoundingClientRect();
        iHeight = rect.top + rect.height;

        ele = document.getElementById("id_transactionentry_footer");
        if (DataType.isValidObject(ele) == true) {
            rect = ele.getBoundingClientRect();

            iHeight -= (rect.bottom - rect.top);
        }

        ele = transEntryGrid.getBodyElement();
        if (DataType.isValidObject(ele) == false) {
            return;
        }

        rect = ele.getBoundingClientRect();

        iHeight -= rect.top;
        iHeight -= 10;

        if (iHeight <= 250) {
            iHeight = 250;
        }

        ele.style.height = iHeight + "px"; // Set grid height

        ele = transEntryGrid.getRowElement(1);
        if (DataType.isValidObject(ele) == true) {
            iRowHeight = ele.getBoundingClientRect().height;
            if (iRowHeight < 1) {
                return;
            }

            iTotalRows = transEntryGrid.getTotalRows();
            if (iTotalRows < 1) {
                return;
            }

            while (iHeight > (iRowHeight * iTotalRows)) {
                iTotalRows++;
            }

            iTotalRows--;
            iDiffRows = iTotalRows - transEntryGrid.getTotalRows();
            if (iDiffRows > 0) {
                transEntryGrid.insertRows(0, iDiffRows, true);
            }
        }
    }
};
