                    TAmount = 0;
                    TNativeCurrency = 0;
                    for (i = 0; i < g_Adjustment.arrAdjustBills[0].objAdjustmentDetails.m_arrAdjustedReferences.length; i++) {
                        if (g_Adjustment.arrAdjustBills[0].objAdjustmentDetails.m_arrAdjustedReferences[i].iRefType == 2 && g_Adjustment.arrAdjustBills[0].objAdjustmentDetails.m_arrAdjustedReferences[i].CurrentRow == true) {
