            }

            obj = transEntryDetailPopup.getMetaData(id.id);
            if (obj.iColumn < 0) {
                return;
            }

            if (EntryMainMaster.isInfoField(obj.MetaData.iFieldId, false) == true || obj.MetaData.iFieldId == 0) {
                return;
            }

            switch (obj.MetaData.iDataTypeId) {
                case eMasterDataType.Fraction:
                case eMasterDataType.BigNumber:
                case eMasterDataType.Number:                
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    value = id.value;
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    value = OPTIONCONTROL.getControlValue(id);
                    break;
                case eMasterDataType.Date:
                    value = DATEPICKER.getDate(id);
                    break;
                case eMasterDataType.Time:
                    value = FTIMECONTROL.getTime(id);
                    break;
            }

            iRow = transEntryDetailPopup.getRow();
            iColumn = obj.iColumn + transEntryGrid.gridExtraColumn();
            PreloadValue = EntryMainFormula.evaluateCellFormula(id.id, objMetaData, objMetaData.bMandatory, iRow, iColumn, value);

            switch (obj.MetaData.iDataTypeId) {
                case eMasterDataType.Text:
