            for (iCounter = 0; iCounter < sTemp.length; iCounter++) {
                switch (sTemp.charAt(iCounter)) {
                    case '(':
                        iOpen++;
                        break;
                    case ')':
                        iClose++;
                        break;
                    default:
                        break;
                }
            }

            if (iOpen == iClose) {
                return true;
            }
        }
        catch (err) {
        }

        return (false);
