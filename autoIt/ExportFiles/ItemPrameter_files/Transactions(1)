                    continue;
                }

                iLPGenerationType = EntryMainUI.getLPGenerationType(iRow);
                if (iLPGenerationType < 1 || iLPGenerationType >= 4) { // Not between 1 to 3
                    arrLog.push("Row " + iRow + " LPGenerationType is " + iLPGenerationType);
