                                    result.sValue = GlobalPref.getResourceValue("msgProvideMandatoryData") + " " + objMetaData.sFieldName;
                                    result.data = null;

                                    return (result);
                                }
                                else {
                                    data = null;
                                    break;
                                }
                            }

                            data[sId] = objValue;
                            continue;
                        }
                        else if (transEntryFieldInfo.SubLedger.Area != eTranEntryFieldArea.None
                            && objMetaData.iFieldId == transEntryFieldInfo.SubLedger.FieldId) {

                            if (EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags) {
                                for (iIndex = 0; iIndex < EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags.length; iIndex++) {
                                    objIdNamePair = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags[iIndex];
                                    if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                        objValue = objIdNamePair.Tag;
                                        bFound = true;
                                        break;
                                    }
                                }
                            }

                            if (bCheckForMandatory == true && (objValue == undefined || FNumberOperation.isLessThan(objValue, 1) == true)) {
                                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                                    iAccountTypeId = EntryMainMemoryObject.getCodeTypeId(iCurrentRow);
                                    if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                        result.data = null;

                                        return (result);
                                    }
                                }

                                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                                    iAccountTypeId = EntryMainMemoryObject.getBookTypeId(iCurrentRow);
                                    if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                        result.data = null;

                                        return (result);
                                    }
                                }

                                data[sId] = objValue;
                                continue;
                            }
                        }
                        else {
                            switch (objMetaData.iFieldId) {
                                case eVTFIELDID.FDF_BODYBOOKNO:
                                    objValue = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Book;
                                    bFound = true;
                                    break;
                                case eVTFIELDID.FDF_BODYCURRENCY:
                                    objValue = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].CurrencyId;
                                    bFound = true;
                                    break;
                                default:
                                    if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                                            objValue = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].FATag;
                                            break;
                                        }

                                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.InvTag) {
                                            objValue = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].InvTag;
                                            break;
                                        }

                                        if (EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags) {
                                            for (iIndex = 0; iIndex < EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags.length; iIndex++) {
                                                objIdNamePair = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].Tags[iIndex];
                                                if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                                    objValue = objIdNamePair.Tag;
                                                    bFound = true;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                    break;
                            }
                        }
                    }

                    if (bFound == true) {
                        if (objValue == undefined || FNumberOperation.isLessThan(objValue, 1) == true) {
                            if (objMetaData.bMandatory == true) {
                                if (bCheckForMandatory == false || objMetaData.bHidden == true) {
                                    continue;
                                }

                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                result.data = null;

                                return (result);
                            }
                            else if (bCheckForMandatory == true) {
                                objCell = transEntryGrid.getCellElement(iCurrentRow, iCounter);
                                if (EntryMainRules.isRuleMandatoryColumn(objCell, true) == 1) {
                                    result.lValue = 0;
                                    result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                    result.data = null;

                                    return (result);
                                }
                            }
                        }

                        data[sId] = DataType.toInt(objValue);
                        continue;
                    }
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.Date) {
                    if (bLayout == false) {
                        objValue = undefined;
                        switch (objMetaData.iFieldId) {
                            case eVTFIELDID.FDF_BODYDUEDATE:
                                objValue = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].DueDate;
                                break;
                            case eVTFIELDID.FDF_MFGDATE:
                            case eVTFIELDID.FDF_EXPDATE:
                                break;
                        }
                    }

                    if (objValue) {
                        objValidateResult = EntryMainValidate.validateDate(objMetaData,
                                                                            objValue,
                                                                            iCurrentRow,
                                                                            transEntryGlobal.getHeading(objMetaData.iFieldId));

                        if (objValidateResult.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.lValue = 0;
                            result.sValue = objValidateResult.sValue;
                            result.data = null;

                            if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                            }

                            return (result);
                        }
                        else if (objValidateResult.bIgnore == false) {
                            data[sId] = objValue;
                        }
                        continue;
                    }
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.Time
                    || objMetaData.iDataTypeId == eMasterDataType.StringList
                    || objMetaData.iDataTypeId == eMasterDataType.NumberList) {

                    if (bFound == true) {
                        if (objValue == undefined && bCheckForMandatory == true && objMetaData.bMandatory == true) {
                            result.lValue = 0;
                            result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                            result.data = null;

                            return (result);
                        }

                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Time:
                            case eMasterDataType.NumberList:
                                data[sId] = DataType.toInt(objValue);
                                break;
                            case eMasterDataType.StringList:
                                data[sId] = DataType.toString(objValue);
                                break;
                        }
                    }

                    if (objMetaData.iFieldId == eVTFIELDID.FDF_DEFSTAT) {
                        objValue = transEntryFields.getDefStat(iCurrentRow);
                        if (objValue != undefined && objValue != null) {
                            data[sId] = DataType.toInt(objValue);
                            continue;
                        }
                    }
                    else if (objMetaData.iFieldId != eVTFIELDID.FDF_RCTISSUESELECTION) {
                        continue;
                    }
                    else {
                        objValue = EntryMainMemoryObject.getRctIssueValue(iCurrentRow);
                        if (objValue != undefined) {
                            data[sId] = DataType.toInt(objValue);
                            continue;
                        }
                    }
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.BigNumber
                    || objMetaData.iDataTypeId == eMasterDataType.Number
                    || objMetaData.iDataTypeId == eMasterDataType.SmallNumber
                    || objMetaData.iDataTypeId == eMasterDataType.TinyNumber) {

                    if (bFound == true) {
                        objValue = DataType.toString(objValue);
                        if (objMetaData.iDataTypeId == eMasterDataType.BigNumber) {
                            if (objValue.length < 10) {
                                objValue = DataType.toInt(objValue);
                                objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, iCurrentRow);
                                if (objValidateResult.lValue < 1) {
                                    if (bCheckForMandatory == false) {
                                        continue;
                                    }

                                    result.lValue = 0;
                                    result.sValue = objValidateResult.sValue;
                                    result.data = null;

                                    if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                        transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                    }

                                    return (result);
                                }
                            }

                            data[sId] = objValue;
                        }
                        else {
                            if (objMetaData.bMandatory == false || objValue != "") {
                                objValue = DataType.toInt(objValue);
                            }

                            objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, iCurrentRow);
                            if (objValidateResult.lValue < 1) {
                                if (bCheckForMandatory == false) {
                                    continue;
                                }

                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                    transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                }

                                return (result);
                            }

                            data[sId] = objValue;
                        }

                        continue;
                    }                    
                }


                objCell = transEntryGrid.getCellObject(iCurrentRow, iCounter);
                if (DataType.isValidObject(objCell) == false) {
                    data = null;
                    break;
                }

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_LINK) {
                            objValue = objCell.getCellText();

                            objValidateResult = EntryMainValidate.validateLink(objMetaData, objValue, iCurrentRow, iCounter);
                            if (objValidateResult.lValue < 1) {
                                if (bCheckForMandatory == false || EntryMainUI.isFreeRow(iCurrentRow) == true) {
                                    break;
                                }
                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                    transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                }
                                
                                return (result);
                            }

                            arrLink = data[sId];
                            if (objValidateResult.bIgnore == true) {
                                if (DataType.isValidObject(arrLink) == false) {
                                    arrLink = [];
                                }

                                data[sId] = DataType.toString(arrLink);
                                continue;
                            }


                            if (DataType.isValidObject(arrLink) == false) {
                                arrLink = [];
                            }
                            else {
                                arrLink = DataType.stringToObject(arrLink).data;
                            }

                            objLink = transEntryLinks.getObjectFromCell(objCell, objMetaData, iCurrentRow);
                            arrLink.push(objLink);
                            data[sId] = DataType.toString(arrLink);
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                            //if (bUpdateStock == false && transEntrySettings.isInputBatchEvenIfStockNotUpdated == false) {
                            //    break;
                            //}

                            objValue = transEntryFields.getBatchInfo(iCurrentRow);

                            if (bUpdateStock == true
                                || objMetaData.bMandatory == true
                                || FConvert.isItWMSBatch(transEntryInfo.VoucherType) == true) {

                                objValidateResult = EntryMainValidate.validateRowBatch(iCurrentRow, objValue);
                                if (objValidateResult.lValue > 0 && objValidateResult.bIgnore == true) {
                                    data[sId] = "";
                                    continue;
                                }

                                if (objValidateResult.lValue < 1) {
                                    if (bCheckForMandatory == false) {
                                        break;
                                    }

                                    result.lValue = 0;
                                    result.sValue = objValidateResult.sValue;
                                    result.data = null;

                                    if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                        transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                    }

                                    return (result);
                                }
                            }
                            
                            data[sId] = DataType.toString(objValue);
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_RMANO) {
                            if(bUpdateStock == false) {
                                break;
                            }

                            objValue = objCell.getCellText();
                            objValidateResult = EntryMainValidate.validateRowRMA(iCurrentRow, objValue);
                            if (objValidateResult.lValue < 1) {
                                if (bCheckForMandatory == false) {
                                    break;
                                }

                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                    transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                }

                                return (result);
                            }

                            data.objTempValues.bRMARequired = transEntryFields.isRequired(eVTFIELDID.FDF_RMANO, iCurrentRow)

                            if (objValidateResult.bIgnore == true) {
                                if (data.objTempValues.bRMARequired == false) {
                                    data[sId] = "";                                    
                                }
                                continue;
                            }

                            data[sId] = objValue;
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS || objMetaData.iFieldId == eVTFIELDID.FDF_BINS2) {
                            if (transEntryBins.isBinsRequired(iCurrentRow, objMetaData.iFieldId == eVTFIELDID.FDF_BINS2) == false) {
                                continue;
                            }

                            objValue = objCell.getCellData();

                            if (DataType.isNullOrEmpty(objValue, true) == true && bCheckForMandatory == true) {
                                result = EntryMainValidate.getResultObject();
                                result.lValue = 0;
                                result.sValue = "No BINS found for row no " + iCurrentRow;
                                result.data = null;

                                return (result);
                            }

                            data[sId] = objValue;
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                            objValue = objCell.getCellData();

                            iProductType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, objCell.iRow, "iProductType");
                            if(iProductType == eProductType.Service
                                || iProductType == eProductType.NonstockItem) {

                                data[sId] = DataType.toString(objValue);
                                break;
                            }

                            if (DataType.toBoolean(transEntryGlobal.m_bIgnoreAutoReservation) == false
                                && transEntryInfo.Settings.Inventory.ReserveFlags == 2
                                && transEntryFieldInfo.Reservation.ColumnIndex > -1
                                && DataType.isNullOrEmpty(objValue) == true) {
                                EntryMainReservation.openPopup(iCurrentRow, false, true);
                                objValue = objCell.getCellData();
                            }

                            if ((objMetaData.bMandatory == true || transEntryInfo.InventoryPref.bReservationIsMandatory == true)
                                && DataType.isNullOrEmpty(objValue) == true) {

                                result.lValue = 0;
                                result.sValue = objMetaData.sFieldName + " is mandatory.";
                                result.data = null;

                                transEntryGrid.showRowSymbol(iCurrentRow, true);

                                return (result);

                            }

                            data[sId] = DataType.toString(objValue);                            
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_DEPTAPPROP) {
                            objValue = objCell.getCellData();
                            data[sId] = objValue;
                        }
                        else {
                            objValue = objCell.getCellText();
                            if (DataType.isNullOrEmpty(objValue) == true) {
                                if (bCheckForMandatory == true && objMetaData.bMandatory == true) {
                                    result.lValue = 0;
                                    result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                    result.data = null;

                                    return (result);
                                }
                                else if(bCheckForMandatory == true && EntryMainRules.isRuleMandatoryColumn(objCell) == 1) {
                                    result.lValue = 0;
                                    result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                    result.data = null;

                                    return (result);
                                }
                            }

                            if (DataType.isNullOrEmpty(objValue) == false) {
                                objValue = objValue.replace("\r\n", "\n");
                                objValue = objValue.replace("\n", "\r\n");

                                if (objMetaData.iMaxSize > 0 && objValue.length > objMetaData.iMaxSize) {
                                    objValue = DataType.stringLeft(objValue, objMetaData.iMaxSize);
                                }
                            }

                            data[sId] = objValue;
                        }
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        objValue = DataType.toString(objCell.getCellData());
                        if (objMetaData.bMandatory == false || objValue != "") {
                            objValue = DataType.toInt(objValue);
                        }
                        
                        objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, iCurrentRow);
                        if (objValidateResult.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.lValue = 0;
                            result.sValue = objValidateResult.sValue;
                            result.data = null;

                            if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                            }

                            return (result);
                        }

                        data[sId] = objValue;
                        break;
                    case eMasterDataType.BigNumber: // Should not call
                        transEntryGlobal.showAlert("getBodyRowData: big number " + sId, "", true);
                        objValue = DataType.toString(objCell.getCellData());
                        if (objValue.length < 10) {
                            objValue = DataType.toInt(objValue);
                            objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, iCurrentRow);
                            if (objValidateResult.lValue < 1) {
                                if (bCheckForMandatory == false) {
                                    break;
                                }

                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                    transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                }

                                return (result);
                            }
                        }
                        data[sId] = objValue;
                        break;
                    case eMasterDataType.Fraction:
                        switch (objMetaData.iFieldId) {
                            case eVTFIELDID.FDF_BODYQUANTITY:
                                if (DataType.isValidObject(objSetRowInfo) == true && objSetRowInfo.bSetBegins == true) {
                                    objValue = EntryMainSet.getSetQty(iCurrentRow);
                                }
                                else {
                                    objValue = FNumberOperation.convert(objCell.getCellData());
                                    if (bCheckForMandatory == true && iVoucherType == eVTTYPE.PRREC && FNumberOperation.isEqualTo(objValue, 0) == true) { // For Receipts from production voucher Finished Good quantity cannot be zero
                                        result.lValue = 0;
                                        result.sValue = "Quantity cannnot be zero.";
                                        result.data = null;

                                        transEntryGrid.showRowSymbol(iCurrentRow, true);

                                        return (result);
                                    }

                                }
                                if (transEntryFieldInfo.RctIssue.ColumnIndex > -1) { // Production Process
                                    if (EntryMainProductionProcess.isIssueRow(iCurrentRow) == true) {
                                        objValue = Math.abs(objValue) * -1;
                                    }
                                    else {
                                        objValue = Math.abs(objValue);
                                    }

                                    objValue = DataType.toDecimal(objValue, transEntryQuantity.getDecimals(), true);
                                }

                                break;
                            case eVTFIELDID.FDF_BALANCESTKVAL:
                                objValue = objCell.getCellData();
                                break;
                            default:
                                objValue = objCell.getCellData();
                                break;
                        }

                        objValue = DataType.toString(objValue);
                        if (objMetaData.bMandatory == false || objValue != "") {
                            objValue = DataType.toDecimal(objValue);
                        }
                        
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_MAXQTYRELEASE) {
                            objTemp = FocusDataStructs.getStockToReleaseObject(transEntryMaxQtyRelease.getReservingId(objCell.iRow), objValue);
                            data[sId] = DataType.toString(objTemp);
                        }
                        else if(objMetaData.sFieldName == "fDiscount") {
                            objTemp = {};
                            objTemp.ID = objMetaData.iFieldId;
                            objTemp.Name = DataType.toString(objCell.getCellData("name"));
                            objTemp.Tag = DataType.toString(DataType.toDecimal(objValue));

                            if (DataType.neq(DataType.toDecimal(objTemp.Tag), 0) == true && DataType.eq(DataType.toInt(objTemp.Name), 0) == true && transEntryFields.isRequired(eVTFIELDID.FDF_REFERENCE, objCell.iRow) == true) {
                                objBillwise = EntryMainBillwise.getData(objCell.iRow);
                                if(DataType.arrayLength(objBillwise) > 0) {
                                    for(iIndex = 0; iIndex < objBillwise.length; iIndex++) {
                                        if(objBillwise[iIndex].iPayAccountId > 0) {
                                            objTemp.Name = DataType.toString(objBillwise[iIndex].iPayAccountId);
                                            break;
                                        }
                                    }
                                }
                            }

                            data[sId] = DataType.toString(objTemp);
                        }
                        else {
                            objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, iCurrentRow);
                            if (objValidateResult.lValue < 1) {
                                if (bCheckForMandatory == false) {
                                    break;
                                }

                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                    transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);
                                }

                                return (result);
                            }

                            if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                                objTemp = transEntryScreenData.getBodyObject(objCell, objMetaData);
                                data[sId] = DataType.toString(objTemp);
                            }
                            else {
                                data[sId] = objValue;
                            }
                        }
                        break;
                    case eMasterDataType.Boolean:
                        if (objCell.hasControl() == true) {
                            data[sId] = objCell.getControl().checked == true ? 1 : 0;
                        }
                        else {
                            data[sId] = DataType.toBoolean(objMetaData.sDefaultValue) == true ? 1 : 0;
                        }
                        break;
                    case eMasterDataType.DateTime:
                        data[sId] = objCell.getCellData();
                        break;
                    case eMasterDataType.Date:
                        objValue = DataType.toInt(objCell.getCellData());
                        objValidateResult = EntryMainValidate.validateDate(objMetaData, objValue, iCurrentRow, objCell.ColumnAttribute.heading);
                        if (objValidateResult.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.lValue = 0;
                            result.sValue = objValidateResult.sValue;
                            result.data = null;

                            if (DataType.toInt(objValidateResult.iRowNo) > 0) {
                                transEntryGrid.showRowSymbol(objValidateResult.iRowNo, true);                                
                            }

                            return (result);
                        }
                        else if (objValidateResult.bIgnore == false) {
                            data[sId] = objValue;
                        }
                        break;
                    case eMasterDataType.Time: // Should not call
                        transEntryGlobal.showAlert("getBodyRowData: time " + sId, "", true);
                        data[sId] = DataType.toInt(objCell.getCellData());
                        break;
                    case eMasterDataType.StringList: // Should not call
                        transEntryGlobal.showAlert("getBodyRowData: string list " + sId, "", true);
                        data[sId] = objCell.getCellText();
                        break;
                    case eMasterDataType.NumberList:
                        data[sId] = DataType.toInt(objCell.getCellData());
                        break;
                    case eMasterDataType.HyperLink: // Should not call
                        transEntryGlobal.showAlert("getBodyRowData: hyper link " + sId, "", true);
                        objValue = DataType.toString(objCell.getCellData());

                        if (DataType.isNullOrEmpty(objValue) == true) {
                            if (bCheckForMandatory == true && objMetaData.bMandatory == true) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                result.data = null;

                                return (result);
                            }
                        }
                        data[sId] = objValue;
                        break;
                    case eMasterDataType.Picture:
                    case eMasterDataType.DocumentViewer:
                        objDocument = {};
                        objDocument.iFieldId = objMetaData.iFieldId;
                        objDocument.sFileName = objCell.getCellText();
                        objDocument.sData = objCell.getCellData();
                        objDocument.iDataSource = DataType.toInt(objCell.getCellData("datasource"));
                        objDocument.bBase64Data = FATTACHMENTCONTROL.PRIVATE.isBase64Data(objCell.ColumnAttribute.ctrlid);

                        if (bCheckForMandatory == true && objMetaData.bMandatory == true && DataType.isNullOrEmpty(objDocument.sFileName, true) == true) {
                            result.lValue = 0;
                            result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                            result.data = null;

                            return (result);
                        }

                        data[sId]= DataType.toString(objDocument);
                        break;
                    case eMasterDataType.Master:
                        objValue = DataType.toInt(objCell.getCellData());
                        if (objValue < 1) {
                            switch (objMetaData.iFieldId) {
                                case eVTFIELDID.FDF_BODYPRODUCT: // Should not call
                                    transEntryGlobal.showAlert("getBodyRowData: product master.", "", true);
                                    data = null;
                                    break;
                                case eVTFIELDID.FDF_BODYCODE: // Should not call
                                    transEntryGlobal.showAlert("getBodyRowData: code master.", "", true);
                                    if (EntryMainBody.isRowEditable(iCurrentRow) == true) {
                                        if (bCheckForMandatory == false) {
                                            break;
                                        }

                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgProvideMandatoryData") + " " + objMetaData.sFieldName;
                                        result.data = null;

                                        return (result);
                                    }
                                    data = null;
                                    break;
                                case eVTFIELDID.FDF_SKID:
                                    if (objMetaData.bMandatory == true && transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, objCell.iRow, "iProductType", eMasterDataType.Number) != eProductType.Service) {
                                        if (bCheckForMandatory == false) {
                                            break;
                                        }

                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                        result.data = null;

                                        return (result);
                                    }

                                    data[sId] = objValue;
                                    break;
                                default:
                                    if (bCheckForMandatory == true 
                                        && transEntryFieldInfo.SubLedger.Area != eTranEntryFieldArea.None
                                        && objMetaData.iFieldId == transEntryFieldInfo.SubLedger.FieldId) {

                                        if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {

                                            iAccountTypeId = EntryMainMemoryObject.getCodeTypeId(iCurrentRow);
                                            if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                                                result.lValue = 0;
                                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                                result.data = null;

                                                return (result);
                                            }
                                        }

                                        if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                                            iAccountTypeId = EntryMainMemoryObject.getBookTypeId(iCurrentRow);
                                            if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                                                result.lValue = 0;
                                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                                result.data = null;

                                                return (result);
                                            }
                                        }

                                        data[sId] = objValue;
                                        break;
                                    } // End Subledger

                                    if (objMetaData.bMandatory == true) {
                                        if (bCheckForMandatory == false || objMetaData.bHidden == true) {
                                            break;
                                        }

                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                        result.data = null;

                                        return (result);
                                    }
                                    else if (bCheckForMandatory == true && EntryMainRules.isRuleMandatoryColumn(objCell) == 1) {
                                        result.lValue = 0;
                                        result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                        result.data = null;

                                        return (result);
                                    }

                                    data[sId] = objValue;
                                    break;
                            }
                        }
                        else {
                            data[sId] = objValue;
                        }
                        break;
                    case eMasterDataType.ExternalTable: // Should not call
                        transEntryGlobal.showAlert("getBodyRowData: external table " + sId, "", true);
                        objValue = objCell.getCellData();
                        if (DataType.isInteger(objValue) == false) {
                            objValue = '0';
                        }

                        if (FNumberOperation.isLessThan(objValue, 0) == true) {
                            if (bCheckForMandatory == true && objMetaData.bMandatory == true) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                result.data = null;

                                return (result);
                            }
                            else if (bCheckForMandatory == true && EntryMainRules.isRuleMandatoryColumn(objCell) == 1) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + objCell.ColumnAttribute.heading;
                                result.data = null;

                                return (result);
                            }
                        }
                        data[sId] = objValue;
                        break;
                }

                if (DataType.isValidObject(data) == false) {
                    break;
                }
            }

            if (DataType.isValidObject(data) == false) {
                result.lValue = 1;
                result.sValue = "";
                result.data = null;

                return (result);
            }

            if (transEntryInfo.isStockRevaluation == true) {
                let dBalanceStockValue = 0;
                let dNewStockValue = 0;

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BALANCESTKVAL);
                dBalanceStockValue = DataType.toDecimal(data[sId]);

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_NEWSTKVAL);
                dNewStockValue = DataType.toDecimal(data[sId]);


                if (bCheckForMandatory == true) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYCODE);
                    if (DataType.toInt(data[sId]) == 0) {
                        result.lValue = 0;
                        result.sValue = "No stock a/c selected for row no " + iCurrentRow;
                        result.data = null;

                        if (DataType.toInt(iCurrentRow) > 0) {
                            transEntryGrid.showRowSymbol(iCurrentRow, true);
                        }

                        return (result);
                    }


                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYBOOKNO);
                    if (DataType.toInt(data[sId]) == 0) {
                        result.lValue = 0;
                        result.sValue = "No stock adjustment a/c selected for row no " + iCurrentRow;
                        result.data = null;

                        if (DataType.toInt(iCurrentRow) > 0) {
                            transEntryGrid.showRowSymbol(iCurrentRow, true);
                        }

                        return (result);
                    }

                    if (dNewStockValue == dBalanceStockValue) {
                        result.lValue = 0;
                        result.sValue = "Invalid stock value for row no " + iCurrentRow;
                        result.data = null;

                        if (DataType.toInt(iCurrentRow) > 0) {
                            transEntryGrid.showRowSymbol(iCurrentRow, true);
                        }

                        return (result);
                    }
                }

                //if (dNewStockValue > dBalanceStockValue) {
                //    data[eTranEntryBodyDataConstKey.Amount0] = -(dNewStockValue - dBalanceStockValue);
                //    data[eTranEntryBodyDataConstKey.Amount1] = (dNewStockValue - dBalanceStockValue);
                //}
                //else {
                //    data[eTranEntryBodyDataConstKey.Amount0] = Math.abs(dNewStockValue - dBalanceStockValue);
                //    data[eTranEntryBodyDataConstKey.Amount1] = (dNewStockValue - dBalanceStockValue);
                //}

                dValue = DataType.sub(dNewStockValue, dBalanceStockValue);
                if (DataType.gt(dNewStockValue, dBalanceStockValue) == true) {
                    data[eTranEntryBodyDataConstKey.Amount0] = DataType.negated(dValue);
                    data[eTranEntryBodyDataConstKey.Amount1] = dValue;
                }
                else {
                    data[eTranEntryBodyDataConstKey.Amount0] = DataType.abs(dValue);
                    data[eTranEntryBodyDataConstKey.Amount1] = dValue;
                }


                //data[eTranEntryBodyDataConstKey.StockValue] = dNewStockValue - DataType.toDecimal(dBalanceStockValue, transEntryQuantity.getDecimals());
                
                dValue = DataType.toDecimal(dBalanceStockValue, transEntryCurrency.getDecimals(iCurrentRow));
                dValue = DataType.sub(dNewStockValue, dValue);
                data[eTranEntryBodyDataConstKey.StockValue] = dValue;
            }

            if (objHeaderInvTagValue != undefined) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYINVTAG);
                data[sId] = objHeaderInvTagValue;
            }

            if (iMaskedVoucherType == eVTTYPE.JOURN) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BOOKNO);
                data[sId] = 1; // Default JV account
            }
            else if (iMaskedVoucherType == eVTTYPE.OPBAL) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BOOKNO);
                data[sId] = 2; // Default Op bal control account
            }

            if (transEntryFieldInfo.Currency.ColumnIndex > -1) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYCURRENCY);
                if (DataType.toInt(data[sId]) < 1) {
                    data[sId] = transEntryInfo.DefaultCurrencyId;
                    data[EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYEXCHANGERATE)] = 1.0000000000;
                }
                else {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYEXCHANGERATE);
                    dExchangeRate = DataType.toDecimal(data[sId]);
                    if (dExchangeRate == 0) {
                        cell = transEntryGrid.getCellObject(iCurrentRow, transEntryFieldInfo.Currency.ColumnIndex);
                        data[sId] = FCommon.getObjectPropertyValue(cell.CellData, "fexchangerate");
                    }
                }
            }

            if (DataType.isValidObject(objSetRowInfo) == true && objSetRowInfo.bSetBegins == true) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_QUANTITY_IN_BASE);
                data[sId] = EntryMainSet.getSetQty(iCurrentRow);
            }
            else if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_QUANTITY_IN_BASE);

                dOrgBaseValue = EntryMainMemoryObject.getBaseQuantityValue(iCurrentRow);

                iDecimals = transEntryQuantity.getDecimals(iCurrentRow);

                if (iDecimals > 0 && EntryMain.m_DecimalsInQty >= 10) { // Block added as per Javed suggestion
                    iDecimals = EntryMain.m_DecimalsInQty;
                }

                /*if(DataType.getDecimalPlaces(dOrgBaseValue) > 0 && iDecimals > 0) {
                    dFormatedBaseValue = FNumberOperation.toFixed(dOrgBaseValue, iDecimals);
                    if(DataType.getLastDigit(dOrgBaseValue, true) == '3' && DataType.getLastDigit(dFormatedBaseValue, true) == '3') { // 0.8333333 equal to 0.83333
                        dOrgBaseValue = dFormatedBaseValue;
                    }
                }*/

                data[sId] = DataType.toDecimal(dOrgBaseValue, iDecimals);
                //data[sId] = dOrgBaseValue;
            }

            if (transEntryInfo.isItSales == true) {
                if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) {
                    data[EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYBATCHNO)] = null;
                }

                if (transEntryFieldInfo.RMA.ColumnIndex < 0) {
                    data[EntryMainUI.getBodyControlId(eVTFIELDID.FDF_RMANO)] = null;
                }

                if (transEntryFieldInfo.Bins.ColumnIndex < 0) {
                    data[EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BINS)] = null;
                }
            }

            result.lValue = 1;
            result.data = data;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{EntryMainUI.getBodyRowData} " + err.message;
        }

        return (result);
    },

    getTransactionData: function (bSuspend, bCheckForMandatory, bFromAutoSave) {
        let result = null;
        let objResult = null;
        let sError = "";
        let bIgnoreBillwiseData = true;
        let bInitFragment = false;
        let objFillDataInput = undefined;
        let objFillFinalInput = undefined;
        let obj = null;
        let objTrans = null;

        try {
            objResult = {};
            objResult.lValue = 0;
            objResult.sValue = "";
            objResult.TransactionData = null;
            objResult.objTran = null;

            bSuspend = DataType.toBoolean(bSuspend);
            bFromAutoSave = DataType.toBoolean(bFromAutoSave);

            if (transEntryInfo.isEditing == true && transEntryInfo.Settings.Misc.NoEditing == true && bFromAutoSave == false) {
                objResult.data = false;

                return (objResult);
            }

            if (bCheckForMandatory == true && bFromAutoSave == false) {
                obj = transEntryGrid.update();
                if (DataType.isValidObject(obj) == true && DataType.toBoolean(obj.bRestrictFormula) == true) {
                    return (objResult);
                }

                if (EntryMainUI.checkForSellBelowCostRestriction() == false) {
                    objResult.lValue = 0;
                    objResult.sValue = "";
                    objResult.TransactionData = null;
                    objResult.objTran = null;

                    return (objResult);
                }

                EntryMainBatch.validateBatchExpiryDate();

                if (transEntryGlobal.disablePrepareData == false
                    && transEntryGrid.getTotalValidRows().iValidRows >= transEntryInfo.RowCountForPrepareData
                    && EntryMainFormula.getBodyRefreshVariables().length > 0) {

                    if (transEntryGlobal.debugPrepareData == true) {
                        debugger
                    }

                    obj = {};
                    transEntryGridFragment.initFragment(true);

                    if (transEntryFieldInfo.Billwise.ColumnIndex > -1) {
                        bIgnoreBillwiseData = false;
                    }

                    obj.objTransaction = transEntryData.getFocusFormatData(true, bIgnoreBillwiseData, 0, true);

                    obj.objTransaction = DataType.toString(obj.objTransaction);

                    transEntryGridFragment.initFragment(false);
                    obj.iVoucherType = transEntryInfo.VoucherType;
                    obj.iViewId = transEntryInfo.ViewId;
                    obj.iLanguageId = EntryMain.m_LanguageId;
                    obj.iDefaultCurrencyId = transEntryInfo.MiscellaneousPref.iDefaultCurrency;

                    result = transEntryServer.execute(eTransServerRequest.PrepareData, obj);
                    if (result.lValue < 1) {
                        objResult.sValue = result.sValue;

                        return(objResult);
                    }

                    result = result.data;
                    if (result.lValue < 1) {
                        if (DataType.isNullOrEmpty(result.sValue, true) == false) {
                            transEntryGlobal.showAlert(result.sValue, EntryMainUI.getErrorTitle(result.lValue));
                        }                        

                        objResult.sValue = result.sValue;

                        return (objResult);
                    }


                    objTrans = result.data;
                    objTrans.BodyData = DataType.arrayFilterData(objTrans.BodyData, "RowType", _RowType.Default, "==");
                }

                if (transEntryGridFragment.isFragmented() == false) {
                    transEntryGridFragment.initFragment(true);
                    bInitFragment = true;
                }

                objFillDataInput = EntryMainCalculation.getFillDataInput(true, true, 0, objTrans);
                if (EntryMainCalculation.fillData(objFillDataInput) == false) {
                    return (objResult);
                }

                if (transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.SALES || transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.DLVCH || transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.SORDR) {
                    objResult.objTran = DataType.createDuplicateObject(objFillDataInput.Output.objOutputTrans); // For checking credit limit
                }

                result = EntryMainValidate.checkForHeaderWrongInputData();
                if (result.lValue < 1) {
                    transEntryGlobal.showAlert(result.sValue, EntryMainUI.getErrorTitle(result.lValue))
                    return (objResult);
                }                

                objFillFinalInput = EntryMainCalculation.getFillFinalInput(false, objFillDataInput.Output.objOutputTrans, objFillDataInput.Output.arrCodeTypes, objFillDataInput.Output.arrBookTypes);
                if (EntryMainCalculation.fillFinal(objFillFinalInput) == false) {
                    objResult.data = false;

                    return (objResult);
                }

                transEntryGlobal.updateIntermediateData(objFillFinalInput.objTrans, objFillFinalInput.arrCodeTypes, objFillFinalInput.arrBookTypes);
            }

            objResult.TransactionData = {};
            objResult.TransactionData.Header = null;
            objResult.TransactionData.Footer = null;
            objResult.TransactionData.Body = [];

            result = EntryMainUI.getHeaderData(bCheckForMandatory);
            if (result.lValue < 1) {
                if (result.arrError.length > 0) {
                    transEntryGlobal.showAlert(result.arrError[0].sValue, GlobalPref.getResourceValue("Error"), "TRANSACTION_ENTRY.CALLBACK.closeError", result.data);
                }
                else {
                    sError = EntryMainUI.getFormattedHeaderError(result.arrErrorMetaDataIndex);
                    if (DataType.isNullOrEmpty(sError) == false) {
                        transEntryGlobal.showAlert(sError, GlobalPref.getResourceValue("Error"), "TRANSACTION_ENTRY.CALLBACK.closeError", result.data);
                    }
                    else if (DataType.isNullOrEmpty(result.sValue) == false) {
                        transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"), "TRANSACTION_ENTRY.CALLBACK.closeError", result.data);
                    }

                    if (DataType.isValidObject(result.arrErrorMetaDataIndex) == true && result.arrErrorMetaDataIndex.length > 0) {
                        TRANSACTION_ENTRY.HEADER.selectTabUsingMetaData(result.arrErrorMetaDataIndex[0]);
                    }
                }

                objResult.data = false;

                return (objResult);
            }
            objResult.TransactionData.HeaderId = transEntryInfo.HeaderId;
            objResult.TransactionData.Header = result.data;

            if (DataType.isValidObject(objResult.objTran) == true
                && DataType.isValidObject(objResult.objTran.Header) == true
                && DataType.isValidObject(objResult.objTran.Header.Flags) == true) {

                objResult.TransactionData.Header.Flags.NoBinCheck = objResult.objTran.Header.Flags.NoBinCheck;
            }

            if (bSuspend == true) {
                objResult.TransactionData.Header.Flags.Suspended = true;
            }
            else {
                objResult.TransactionData.Header.Flags.Suspended = false;
            }

            if(bFromAutoSave != true) {
                objResult.TransactionData.Header.Flags.Draft = false;
            }
            else {
                objResult.TransactionData.Header.Flags.Draft = true;
            }

            if (DataType.isValidObject(objResult.objTran) == true) {
                objResult.objTran.Header.Flags = objResult.TransactionData.Header.Flags;
            }
            else if (objResult.TransactionData.Header.Flags.Editing == true
                    && DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction) == true
                    && DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.Header) == true
                    && DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.Header.Flags) == true) {
                objResult.TransactionData.Header.Flags.NoBinCheck = transEntryGlobal.IntermediateData.objTransaction.Header.Flags.NoBinCheck;
            }

            if (bCheckForMandatory == true && objResult.TransactionData.Header.Flags.PostCashEntry == true && transEntryGlobal.EntryModel.Preference.VAT.iVATCashAccountId < 1) {
                transEntryGlobal.showAlert("Cash account must be defined in Settings\\VAT in order to raise a receipt.", GlobalPref.getResourceValue("Error"));

                objResult.lValue = 0;

                return (objResult);
            }

            objResult.TransactionData.Header.Flags = DataType.toString(objResult.TransactionData.Header.Flags);


            result = EntryMainUI.getFooterData();
            if (result.lValue < 1) {
                transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Exception"));

                objResult.data = false;

                return (objResult);
            }

            objResult.TransactionData.Footer = result.data;

            result = EntryMainUI.getBodyData(false, bCheckForMandatory);
            if (result.lValue < 1) {
                transEntryGlobal.showAlert(result.sValue, EntryMainUI.getErrorTitle(result.lValue));

                objResult.data = false;

                return (objResult);
            }
            objResult.TransactionData.Body = result.data;

            if (bCheckForMandatory == true && EntryMainValidate.validateData(objResult.TransactionData) == true) {
                objResult.lValue = 1;
                objResult.data = true;
            }
            else if (bCheckForMandatory == false) {
                objResult.lValue = 1;
                objResult.data = true;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getTransactionData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
        finally
        {
            if (bInitFragment == true) {
                transEntryGridFragment.initFragment(false);
            }
        }

        return (objResult);
    },

    moveAttachmentDataBeforeSave: function(obj) {
        let sId = "";
        let iRow = 0;
        let iCounter = 0;
        let arrBodyDocFields = null;
        let objMetaData = null;
        let result = null;

        try {
            obj.objData.HeaderDocs = [];
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if(objMetaData.iDataTypeId != eMasterDataType.Picture && objMetaData.iDataTypeId != eMasterDataType.DocumentViewer) {
                    continue;
                }

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                if(obj.objData.Header.hasOwnProperty(sId) == true) {
                    result = DataType.stringToObject(obj.objData.Header[sId]).data;
                    if (DataType.isValidObject(result) == true) {
                        obj.objData.HeaderDocs.push(result);
                    }

                    delete obj.objData.Header[sId];
                }
            }

            obj.objData.BodyDocs = [];
            arrBodyDocFields = [];
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Body.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iCounter];
                if(objMetaData.iDataTypeId != eMasterDataType.Picture && objMetaData.iDataTypeId != eMasterDataType.DocumentViewer) {
                    continue;
                }

                arrBodyDocFields.push(objMetaData.iFieldId);
            }

            if(DataType.arrayLength(arrBodyDocFields) > 0) {
                for(iRow = 0; iRow < obj.objData.Body.length; iRow++) {
                    for(iCounter = 0; iCounter < arrBodyDocFields.length; iCounter++) {
                        sId = EntryMainUI.getBodyControlId(arrBodyDocFields[iCounter]);
                        if(obj.objData.Body[iRow].hasOwnProperty(sId) == true) {
                            result = DataType.stringToObject(obj.objData.Body[iRow][sId]).data;
                            if (DataType.isValidObject(result) == true) {
                                result.iRow = iRow;
                                obj.objData.BodyDocs.push(result);

                                obj.objData.Body[iRow][sId] = "";
                            }                            
                        }
                    }
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainUI.moveAttachmentDataBeforeSave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    autoSave: function(iRow, bDelete) {
        let iCounter = 0;
        let objResult = null;
        let result = null;
        let objFlags = null;
        let obj = null;

        try {
            if (transEntryGlobal.debugSave == true) {
                debugger
            }

            EntryMainHeader.checkAllHeaderFieldsForFormula();

            objResult = EntryMainUI.getTransactionData(false, false, true);
            if (objResult.lValue < 1) {
                return;
            }

            objFlags = DataType.stringToObject(objResult.TransactionData.Header.Flags).data;

            objFlags.SaveInThread = false;
            objFlags.Draft = true;
            objResult.TransactionData.Header.Flags = DataType.toString(objFlags);


            obj = {};
            obj.objData = objResult.TransactionData;
            obj.iVoucherType = transEntryInfo.VoucherType;
            obj.iViewId = transEntryInfo.ViewId;
            obj.SchemeApplied = "";

            EntryMainUI.moveAttachmentDataBeforeSave(obj);

            obj.bVersion = false;
            obj.bAmend = false;
            obj.bSendSms = false;

            if (bDelete == true) {
            }
            else {
                transEntryGlobal.showAlert("Saving row-" + iRow + ".");
            }
            
            result = transEntryServer.execute(eTransServerRequest.SaveVoucher, obj);
            if(result.lValue > 0) {
                result = result.data;
                if(result.lValue > 0) {
                    EntryMain.clearDirty();

                    if(transEntryInfo.HeaderId != result.data.SavedHeaderId) {
                        transEntryInfo.HeaderId = result.data.SavedHeaderId;
