    isSkidValid: function (iFieldId, cellobj) {
        let sText = "";
        let iLastValue = 0;
        let iValue = 0;
        let bMasterChanged = false;
        let obj = undefined;

        try {
            if (iFieldId != eVTFIELDID.FDF_SKID) {
                return (true);
            }

            iLastValue = DataType.toInt(cellobj.getCellData());
            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid));

            if (iValue == 0 && EntryMainUI.getLPGenerationType(cellobj.iRow) == 4) { // (Manually Generate LP)
                sText = OPTIONCONTROL.getControlText(cellobj.ColumnAttribute.ctrlid);
                if (DataType.isNullOrEmpty(sText, true) == false) {
                    if (transEntryGlobal.confirmMessage("Given LPN does not exist. Do you want to create a new one?") == true) {                        
                        obj = transEntrySkid.createLPNumber(sText, cellobj.iRow);
                        if (obj.ID > 0)
                        {
                            iValue = obj.ID;
                            OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, iValue);
                        }
                        else {
                            cellobj.clear();

                            transEntryGlobal.showAlert(obj.Name, GlobalPref.getResourceValue("Error"));

                            return (false);
                        }
                    }
                    else {
                        cellobj.clear();

                        return (false);
                    }
                }
            }


            if (iLastValue != iValue) {
                bMasterChanged = true;
            }

            if (bMasterChanged == false) {
                return (true);
            }

            if (bMasterChanged == true && transEntryInfo.isInwardVoucher == false) {
                EntryMainUI.clear(transEntryFieldInfo.Bins, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.BatchNo, cellobj.iRow);
            }
            else if (bMasterChanged == true && transEntryInfo.isInwardVoucher == true) {
                if (iValue > 0
                    && transEntryGlobal.EntryModel.Preference.Bins.iTwoDifferentItemsCannotbePlacedinSameskid > 0) {
                    if (EntryMainWMS.checkForTwoDifferentItemsCannotbePlacedinSameskid(iValue, EntryMainMemoryObject.getProductValue(cellobj.iRow), cellobj.iRow) == false) {
                        cellobj.clear();

                        return (false);
                    }
                }

                if (iValue > 0
                    && transEntryFieldInfo.BatchNo.ColumnIndex > -1
                    && transEntryGlobal.EntryModel.Preference.Bins.iTwoDifferentBatchesCannotbePlacedinSameSkid > 0) {
                    if (EntryMainWMS.checkForTwoDifferentBatchesCannotbePlacedinSameSkid(iValue, transEntryBatch.getBatchNo(cellobj.iRow), cellobj.iRow) == false) {
                        cellobj.clear();

                        return (false);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainValidate.isSkidValid} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    validateBatchForBin: function (iCurrentRow, bBatch) {
        let iRow = 0;
        let objCurrentBatch = null;
        let objCurrentRowBin = null;
        let objBatch = null;
        let objBin = null;

        try {
            if (iCurrentRow < 1 || iCurrentRow > transEntryGrid.getTotalRows()) { // Invalid Row
                return (true);
            }

            if (transEntryGlobal.EntryModel.Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin == false) {
                return (true);
            }

            if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) { // No Batch column
                return (true);
            }

            if (transEntryFieldInfo.Bins.ColumnIndex < 0) { // No Bins column
                return (true);
            }


            objCurrentBatch = transEntryFields.getBatchInfo(iCurrentRow);
            if (DataType.isValidObject(objCurrentBatch) == false || DataType.isNullOrEmpty(objCurrentBatch.BatchNo, true) == true) {
                return (true);
            }

            objCurrentRowBin = transEntryFields.getBins(iCurrentRow);
            if (DataType.isValidObject(objCurrentRowBin) == false) {
                return (true);
            }

            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false || iRow == iCurrentRow) {
                    continue;
                }

                objBatch = transEntryFields.getBatchInfo(iRow);
                if (DataType.isValidObject(objBatch) == false || DataType.isNullOrEmpty(objBatch.BatchNo, true) == true) {
                    continue;
                }

                objBin = transEntryFields.getBins(iRow);
                if (DataType.isValidObject(objBin) == false) {
                    continue;
                }

                if (bBatch == true) {
                    if (objBin[0].BinId == objCurrentRowBin[0].BinId) {
                        if (objBatch.BatchNo == objCurrentBatch.BatchNo) {
                            continue;
                        }
                        else {
                            return (false);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainValidate.validateBatchForBin} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    checkMinMaxRange: function (dInput, dMin, dMax) {
        let result = null;

        try {
            result = {};
            result.bInvalid = false;
            result.sMessage = "";
            result.dValue = dInput;

            if (DataType.neq(dMin, 0) == true || DataType.neq(dMax, 0) == true) {
                if (DataType.lt(dInput, dMin) == true) {
                    result.bInvalid = true;
                    result.sMessage = GlobalPref.getResourceValue("msgCantBeLessThan");
                    result.dValue = dMin;
                }
                else if (DataType.neq(dMax, 0) == true && DataType.gt(dInput, dMax) == true) {
                    result.bInvalid = true;
                    result.sMessage = GlobalPref.getResourceValue("msgCantBeMoreThan");
                    result.dValue = dMax;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainValidate.checkMinMaxRange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    isNumberOverflow: function (iDataTypeId, value) {
        let bOverflow = false;

        try {
            switch (iDataTypeId) {
                case eMasterDataType.Number:
                    //if (DataType.toInt(value) > MaxValue.get("INT32")) {
                    //    bOverflow = true;
                    //}
                    //else if (DataType.toInt(value) < MinValue.get("INT32")) {
                    //    bOverflow = true;
                    //}
                    if (DataType.gtType(value, eNumberType.Int32) == true) {
                        bOverflow = true;
                    }
                    else if (DataType.ltType(value, eNumberType.Int32) == true) {
                        bOverflow = true;
                    }
                    break;
                case eMasterDataType.SmallNumber:
                    //if (DataType.toInt(value) > MaxValue.get("INT16")) {
                    //    bOverflow = true;
                    //}
                    //else if (DataType.toInt(value) < MinValue.get("INT16")) {
                    //    bOverflow = true;
                    //}
                    if (DataType.gtType(value, eNumberType.Int16) == true) {
                        bOverflow = true;
                    }
                    else if (DataType.ltType(value, eNumberType.Int16) == true) {
                        bOverflow = true;
                    }
                    break;
                case eMasterDataType.TinyNumber:
                    //if (DataType.toInt(value) > MaxValue.get("UINT8")) {
                    //    bOverflow = true;
                    //}
                    //else if (DataType.toInt(value) < MinValue.get("UINT8")) {
                    //    bOverflow = true;
                    //}
                    if (DataType.gtType(value, eNumberType.UInt8) == true) {
                        bOverflow = true;
                    }
                    else if (DataType.ltType(value, eNumberType.UInt8) == true) {
                        bOverflow = true;
                    }
                    break;
                case eMasterDataType.BigNumber:
                    //if (DataType.toInt(value) > MaxValue.get("INT64")) {
                    //    bOverflow = true;
                    //}
                    //else if (DataType.toInt(value) < MinValue.get("INT64")) {
                    //    bOverflow = true;
                    //}
                    if (DataType.gtType(value, eNumberType.Int64) == true) {
                        bOverflow = true;
                    }
                    else if (DataType.ltType(value, eNumberType.Int64) == true) {
                        bOverflow = true;
                    }
                    break;
                case eMasterDataType.Fraction:
                    //if (DataType.toDecimal(value) > MaxValue.get("DECIMAL")) {
                    //    bOverflow = true;
                    //}
                    //else if (DataType.toDecimal(value) < MinValue.get("DECIMAL")) {
                    //    bOverflow = true;
                    //}
                    if (DataType.gtType(value, eNumberType.Decimal) == true) {
                        bOverflow = true;
                    }
                    else if (DataType.ltType(value, eNumberType.Decimal) == true) {
                        bOverflow = true;
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainValidate.isNumberOverflow}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bOverflow);
    },

    validateHeaderMaster: function (objMetaData, value) {
        let iAccountTypeId = 0;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 1;
            result.sValue = "";
            result.data = null;

            if (objMetaData.iDataTypeId == eMasterDataType.Master) {
                if (objMetaData.bMandatory == true && value == 0) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH && objMetaData.bHidden == true && transEntryInfo.BaseVoucherType == eVTTYPE.WDONE) {
                        // Do Nothing SI-43467(83722)
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_PROD_PROCESS && objMetaData.bHidden == true && transEntryInfo.BaseVoucherType == eVTTYPE.WDONE) {
                        // Do Nothing SI-55806(108907)
                    }
                    else {
                        result.lValue = 0;
                        result.sValue = "'" + objMetaData.sFieldName + "' field value cannot be empty.";
                    }
                }
                else if (objMetaData.bMandatory == true && value != 0 && transEntryInfo.isItTransfer == true) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERINVTAG
                        && transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header) {

                        result = EntryMainValidate.isDuplicateStockTransferInvTag(objMetaData.iFieldId, value);
                        if (result.lValue != 0) {
                            result.lValue = 0;
                        }
                        else {
                            result.lValue = 1;
                            result.sValue = "";
                            result.data = null;
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYINVTAG
                        && transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header) {

                        result = EntryMainValidate.isDuplicateStockTransferInvTag(objMetaData.iFieldId, value);
                        if (result.lValue != 0) {
                            result.lValue = 0;
                        }
                        else {
                            result.lValue = 1;
                            result.sValue = "";
                            result.data = null;
                        }
                    }
                }

                if (value == 0
                    && transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Header
                    && transEntryFieldInfo.SubLedger.FieldId == objMetaData.iFieldId
                    && transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
