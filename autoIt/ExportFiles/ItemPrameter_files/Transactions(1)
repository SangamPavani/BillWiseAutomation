    onPick: function(iRowIndex, iBinId, iSkidId, sCarton) {
        let iCounter = 0;
        let objBinDetails = null;
        let objCell = null;

        try {
            for(iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                if(BinsUI.m_objBinsData.BinDetails[iCounter].Id != iBinId) {
                    continue;
                }

                BinsUI.m_objBinsData.BinDetails[iCounter].Carton = DataType.toString(BinsUI.m_objBinsData.BinDetails[iCounter].Carton);
                if(BinsUI.m_bCartonCheck == true) {
                    if(BinsUI.m_objBinsData.BinDetails[iCounter].Carton != sCarton) {
                        continue;
                    }
                }

                if (BinsUI.m_BinsParam.Inward == true) {
                    objBinDetails = BinsUI.m_objBinsData.BinDetails[iCounter];
                    break;
                }

                if(BinsUI.m_objBinsData.BinDetails[iCounter].SkidId == iSkidId) {
                    objBinDetails = BinsUI.m_objBinsData.BinDetails[iCounter];
                    break;
                }
            }

            if(DataType.isValidObject(objBinDetails) == true && objBinDetails.Id > 0) {
                objCell = BinsUI.AutoPick(iRowIndex, objBinDetails.Id, objBinDetails.SkidId, objBinDetails.Carton);
                if (DataType.isValidObject(objCell) == true && BinsUI.toDecimal(objCell.getCellText()) > 0) {
                    BinsUI.addSelectedBins(objBinDetails, true);
                }
            }

            BINS.displayFooterSum();
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {BinsUI.onPick} " + err.message);
        }
    },

    AutoPick: function(iRowIndex, iBinId, iSkidId, sCarton){
        let iCounter = 0;
        let iTotal = 0;
        let objColumn = null;
        let cellobj = null;
        let cell = null;

        try {
            if(iRowIndex < 0) {
                return;
            }

            iTotal = DataType.arrayLength(BinsUI.m_objBinsData.BinDetails);
            for(iCounter = 0; iCounter < iTotal; iCounter++) {
                if (BinsUI.m_objBinsData.BinDetails[iCounter].Id == iBinId 
                    && BinsUI.m_objBinsData.BinDetails[iCounter].SkidId == iSkidId) {
                    ////////

                    if(BinsUI.m_bCartonCheck == true) {
                        if(BinsUI.m_objBinsData.BinDetails[iCounter].Carton != sCarton) {
                            continue;
                        }
                    }

                    objColumn = BinsUI.m_objBinsData.BinDetails[iCounter];
                    break;
                }

            }

            if (objColumn == null) {
                return;
            }

            cellobj = BinsUI.getAutoAllocateCellObject(iRowIndex);

            if (objColumn.Group == true){
                BinsUI.disableOK(true); //disable
                cellobj.setCellText(BinsUI.AddDecimalInColumn(0));

                return(cellobj);
            }
            else {
                if (BinsUI.m_BinsParam.Inward == false || objColumn.Type == eBinsType.Bin)//type 0 :bin
                {
                    cellobj = BinsUI.PickRow(iRowIndex, iBinId, iSkidId, sCarton);

                    return(cellobj);
                }
                else if (objColumn.Type == eBinsType.Floor || objColumn.Type == eBinsType.Stage)// Inward voucher and bin type Floor/Stage
                {
                    iTotal = transBinsPopup.getTotalRows();
                    for (iCounter = 0; iCounter < iTotal; iCounter++) {
                        cell = BinsUI.getAutoAllocateCellObject(iCounter + 1);
                        cell.setCellText(BinsUI.AddDecimalInColumn(0));

                        BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = 0;
                    }

                    cellobj.setCellText(BinsUI.getTotalQty());
                    objColumn.ToBeAllocated = BinsUI.getTotalQty();
                    BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(0));
                    BinsUI.disableOK(false);

                    return(cellobj);
                }
            }
        }
        catch(err) {
            FUIElement.writeErrorLog("Exception: {BinsUI.AutoPick} " + err.message);
        }
    },

    PickRow: function (iRowIndex, iBinId, iSkidId, sCarton) {
        let iCounter = 0;
        let iIndex = 0;
        let dFreespace = 0;
        let dLoad = 0;
        let dQuantity = 0;
        let dBalance = 0;
        let dTotalWeight = 0;
        let dAvailWeight = 0;
        let dValue = 0;        
        let objCell = null;

        try {            
            transBinsPopup.update();

            if (BinsUI.m_BinsParam.Inward == true) {
                objCell = BinsUI.getFreeSpaceCellObject(iRowIndex);
                dFreespace = BinsUI.toDecimal(objCell.getCellText());
                if (BinsUI.m_iProdCapacity > 0) { // If Product Category exits
                    objCell = BinsUI.getFreeQuantityCellObject(iRowIndex);
                    dFreespace = BinsUI.toDecimal(objCell.getCellText());
                }
            }
            else{
                objCell = BinsUI.getStockCellObject(iRowIndex);//Stock-iQuantity
                dFreespace = BinsUI.toDecimal(objCell.getCellText());
            }

            objCell = BinsUI.getStockCellObject(iRowIndex);//Stock-Quantity
            dLoad = BinsUI.toDecimal(objCell.getCellText());
            dQuantity = BinsUI.getTotalQty();

            //Clear To Be Allocated Column data
            BinsUI.clearAllocatedValue(); // Set 0 to "To Be Allocated" 

            //Get the current object index in m_objBinsData
            for(iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                if(BinsUI.m_objBinsData.BinDetails[iCounter].Id == iBinId 
                    && BinsUI.m_objBinsData.BinDetails[iCounter].SkidId == iSkidId) {
                    ////////////

                    if(BinsUI.m_bCartonCheck == true) {
                        if(BinsUI.m_objBinsData.BinDetails[iCounter].Carton != sCarton) {
                            continue;
                        }
                    }

                    iIndex = iCounter;
                    break;
                }
            }

            //Validation If Inward and same bin
            if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.bCannotBePlacedInSameBin == 1) {
                if (BinsUI.validateBinsManual(iBinId) == true) {
                    if (BinsUI.m_bUnitCheck) {
                        if (BinsUI.validateUnitBin(iBinId) == false) {
                            COMMON.prototype.showMessage(GlobalPref.getResourceValue("DifferentUnitCantConsiderForSameProduct"), GlobalPref.getResourceValue("BinsValidation"));
                            return;
                        }
                    }

                    if (DataType.lte(dQuantity, dFreespace) == true) {
                        BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = dQuantity;

                        //set cell value here itself ,instead of refilling the whole grid again
                        objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                        objCell.setCellText(BinsUI.AddDecimalInColumn(dQuantity));
                        dBalance = BinsUI.toDecimal(objCell.getCellText());
                        dValue = dQuantity - dBalance;
                        BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dValue));
                        if (BinsUI.toDecimal(dValue) == 0) {
                            BinsUI.disableOK(false);
                        }
                        else {
                            BinsUI.disableOK(true);
                        }
                    }
                    else {
                        COMMON.prototype.showMessage("Quantity is more than available quantity.", GlobalPref.getResourceValue("BinsValidation"));
                    }
                }
                else {
                    COMMON.prototype.showMessage(GlobalPref.getResourceValue("TwoDiffProductsNotInSameBin"), GlobalPref.getResourceValue("BinsValidation"));
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.iBinsAllocationRestriction == 1) {   // Validation Item based on category in Inward 
                for (iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Id != iBinId) {
                        continue;
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Type == eBinsType.Bin) {
                        if (BinsUI.m_objBinsData.BinDetails[iCounter].Category == BinsUI.m_objBinsData.ProductData.Category) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = BinsUI.getTotalQty();

                            if (DataType.lte(dQuantity, dFreespace) == true) {
                                objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                                objCell.setCellText(dQuantity);
                                dBalance = dQuantity;
                                BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dQuantity - dBalance));
                                if (BinsUI.getBalanceValue() == 0) {
                                    BinsUI.disableOK(false);
                                    break;
                                }
                                else {
                                    BinsUI.disableOK(true);
                                }
                            }
                            else {
                                COMMON.prototype.showMessage("Quantity is more than available quantity.", GlobalPref.getResourceValue("BinsValidation"));
                            }
                        }
                        else {
                            COMMON.prototype.showMessage(GlobalPref.getResourceValue("ItemsBasedOnCategory"), GlobalPref.getResourceValue("BinsValidation"))
                        }
                    }
                    else {
                        BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = parseFloat(BinsUI.getTotalQty());
                        objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                        objCell.setCellText(dQuantity);
                        dBalance = dQuantity;
                        BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dQuantity - dBalance));
                        if (BinsUI.getBalanceValue() == 0) {
                            BinsUI.disableOK(false);
                        }
                        else{
                            BinsUI.disableOK(true);
                        }
                    }
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin == true) {
                for (iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {// Item based on Batch
                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Id != iBinId) {
                        continue;
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Type == eBinsType.Bin) {
                        if (DataType.isNullOrEmpty(BinsUI.m_objBinsData.BinDetails[iCounter].Batch) == true || BinsUI.m_objBinsData.BinDetails[iCounter].Batch == BinsUI.m_sBatch) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = BinsUI.getTotalQty();

                            if (DataType.lte(dQuantity, dFreespace) == true) {
                                BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = dQuantity;

                                objCell =  BinsUI.getAutoAllocateCellObject(iRowIndex);
                                objCell.setCellText(BinsUI.AddDecimalInColumn(dQuantity));
                                dBalance = dQuantity;
                                BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dQuantity - dBalance));
                                if (BinsUI.getBalanceValue() == 0) {
                                    BinsUI.disableOK(false);
                                }
                                else{
                                    BinsUI.disableOK(true);
                                }
                            }
                            else{
                                COMMON.prototype.showMessage("Quantity is more than available quantity.", GlobalPref.getResourceValue("BinsValidation"));
                            }
                        }
                    }
                    else {
                        BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = parseFloat(BinsUI.getTotalQty());
                        BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = dQuantity;

                        objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                        objCell.setCellText(BinsUI.AddDecimalInColumn(dQuantity));
                        dBalance = dQuantity;
                        BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(dQuantity - dBalance));
                        if (BinsUI.getBalanceValue() == 0){
                            BinsUI.disableOK(false);
                        }
                        else{
                            BinsUI.disableOK(true);
                        }
                    }
                }
            }
            else {
                if (BinsUI.m_BinsParam.Inward == false) {   // if outward
                    if (dLoad == 0) {  // check if load == 0, the n return
                        BinsUI.disableOK(true);
                        BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = 0;

                        objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                        objCell.setCellText(BinsUI.AddDecimalInColumn(0));

                        return;
                    }
                }

                if (BinsUI.isConsiderWeight(iRowIndex) == true) {
                    //check if totalweight <= availableweigt 
                    dTotalWeight = BinsUI.m_dProductWeight * BinsUI.m_dQuantity;
                    objCell = BinsUI.getWeightAvailableCellObject(iRowIndex);
                    dAvailWeight = parseFloat(objCell.getCellText().replace(/,/g, ''));
                    if (dTotalWeight > dAvailWeight) {
                        BinsUI.disableOK(true);
                        BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = 0;

                        objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                        objCell.setCellText(BinsUI.AddDecimalInColumn(0));
                        COMMON.prototype.showMessage("Total weight is more than the available weight");

                        return(objCell);
                    }
                }

                if (DataType.lte(dQuantity, dFreespace) == true){
                    BinsUI.m_objBinsData.BinDetails[iIndex].ToBeAllocated = dQuantity;

                    objCell = BinsUI.getAutoAllocateCellObject(iRowIndex);
                    objCell.setCellText(BinsUI.AddDecimalInColumn(dQuantity));
                    BinsUI.setBalanceValue(BinsUI.AddDecimalInColumn(0));
                    BinsUI.disableOK(false);
                }
                else {
                    COMMON.prototype.showMessage("Quantity is more than available quantity.", GlobalPref.getResourceValue("BinsValidation"));
                }
            }

            return(BinsUI.getAutoAllocateCellObject(iRowIndex));
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.PickRow} " + err.message, GlobalPref.getResourceValue("Exception"))
        }
    },

