    getFlag: function (chkboxes, type)//CheckBox[]  chkboxes  type VoucherFlagType
    {


        if (type == 2) //VoucherFlagType.LONG
        {
            var i = 0;
            var ulTemp = 0;
            for (i = 0; i < chkboxes.length; i++) {
                ulTemp |= (chkboxes[i].IsChecked == true ? 1 : 0) << parseInt(chkboxes[i].Tag);
            }
            return ulTemp;
        }
        else if (type == 1)//VoucherFlagType.INT
        {
            var i = 0;
            var ulTemp = 0;
            for (i = 0; i < chkboxes.length; i++) {
                if (chkboxes[i].IsChecked)
                    ulTemp += Math.pow(2, i);
            }
            return ulTemp;
        }
        else //VoucherFlagType.BYTE
        {
            var i = 0;
            var ulTemp = 0;
            for (i = 0; i < chkboxes.length; i++) {
                ulTemp |= (chkboxes[i].IsChecked == true ? 1 : 0) << parseInt(chkboxes[i].Tag);
            }
            return ulTemp;
        }
    },

    setFlag: function (chkboxes, val) {

        try {
            for (var i = 0; i < chkboxes.length; i++) {
                chkboxes[i].chkBox.checked = false;
            }
            for (var i = 0; i < chkboxes.length; i++) {
                chkboxes[i].chkBox.checked = ((parseInt(val) & Math.pow(2, parseInt(chkboxes[i].Tag))) >> parseInt(chkboxes[i].Tag)) == 1;
            }
        } catch (e) {

        }
    },

