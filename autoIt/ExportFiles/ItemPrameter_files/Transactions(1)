    Validate: function (obj, event) {
        try {


            var TotalRows = FGRIDCONTROL.getTotalRows(AdjustBills_Screen.UI.getAdjustmentGridElement());

            if (obj.iColumn == AdjCol.get("mAAIDBaseCurrency") || obj.iColumn == AdjCol.get("mAAIDInvoiceCurrency") || obj.iColumn == AdjCol.get("mAAdIDBaseCurrency") || obj.iColumn == AdjCol.get("mAAdIDInvoiceCurrency")) {
                var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), obj.iRow, AdjCol.get("mBAIDInvoiceCurrency"));
                if (FConvert.toDecimal(cell.getCellData()) < FConvert.toDecimal(document.getElementById("id_limit").value)) {
                    document.getElementById("btnOk").style.pointerEvents = "none";
                    return false;
                }
            }
            if (TotalRows > 1) {
                var AdjustedAmt = 0;
                for (i = 1; i <= TotalRows; i++) {
                    var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, obj.iColumn);
                    AdjustedAmt = AdjustedAmt + FConvert.toDecimal(cell.getCellData());
                }
                AdjustedAmt = AdjustedAmt + AdjustBills_Screen.UI.GetOnAccountAmt();
                if (FConvert.toDecimal(AdjustedAmt) > Math.abs(FConvert.toDecimal(document.getElementById("tbAmountToAdjustInBaseCurrencyValue").textContent))) {
                    COMMON.prototype.showMessage("Adjusted Amount Should not be greater than Transaction Amount");
                    return false;
                }
            }
            if (document.getElementById("btnOk") != null)
                document.getElementById("btnOk").style.pointerEvents = "auto";
            return true;
        }
        catch (Ex) {
            alert("Exception: Validate " + Ex.message);
        }
