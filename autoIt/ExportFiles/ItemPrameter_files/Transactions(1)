        }
    },

    removeExistingHeaderIdData: function (iHeaderId) {
        let iCounter = 0;
        let iHeaderDataIndex = 0;

        try {
            iCounter = 0;
            while (iCounter < DataType.arrayLength(CopyDocUI.m_arrBodyData)) {
                if (CopyDocUI.m_arrBodyData[iCounter].ID == iHeaderId) {
                    CopyDocUI.m_arrBodyData.splice(iCounter, 1);
                }
                else {
                    iCounter++;
                }
            }

            iCounter = 0;
            while (iCounter < DataType.arrayLength(CopyDocUI.m_arrHeaderData)) {
                if (CopyDocUI.m_arrHeaderData[iCounter].HeaderId == iHeaderId) {
                    CopyDocUI.m_arrHeaderData.splice(iCounter, 1);
                    CopyDocUI.m_arrHeaderDocs.splice(iCounter, 1);
                }
                else {
                    iCounter++;
                }
            }

            if (DataType.isValidObject(CopyDocUI.m_objReturnData) == true) {
                iHeaderDataIndex = -1;
                for (iCounter = 0; iCounter < DataType.arrayLength(CopyDocUI.m_objReturnData.arrFieldInfo); iCounter++) {
                    if (CopyDocUI.m_objReturnData.arrFieldInfo[iCounter] == "HeaderId") {
                        iHeaderDataIndex = iCounter;
                        break;
                    }
                }

                if (iHeaderDataIndex >= 0) {
                    iCounter = 0;
                    while (iCounter < DataType.arrayLength(CopyDocUI.m_objReturnData.arrRowData)) {
                        if (CopyDocUI.m_objReturnData.arrRowData[iCounter][iHeaderDataIndex] == iHeaderId) {
                            CopyDocUI.m_objReturnData.arrRowData.splice(iCounter, 1);
                        }
                        else {
                            iCounter++;
                        }
                    }
                }

                CopyDocUI.removeHeaderId(iHeaderId);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.removeExistingHeaderIdData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

