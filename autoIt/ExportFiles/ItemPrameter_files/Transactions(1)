    onConvert_Click: async function (ele, evt) {
        let iRow = 0;
        let objFlags = undefined;
        let objInput = undefined;
        let arrNormal = undefined;
        let arrSuspendBase = undefined;
        let result = undefined;

        try {
            if (DataType.isValidObject(document.getElementById("id_transactionentry_convert")) == false) {
                return;
            }

            if (transEntryInfo.isEditing == false) {
                return;
            }

            if (DataType.arrayLength(transEntryInfo.Settings.NextVouchers) < 1) {
                return;
            }

            objFlags = transEntryInfo.getHeaderFlags();
            if (DataType.isValidObject(objFlags) == false) {
                return;
            }

            if (objFlags.Suspended == true) {
                transEntryGlobal.showAlert("Suspended voucher cannot be converted.", GlobalPref.getResourceValue("Error"));

                return;
            }

            arrNormal = [];
            arrSuspendBase = [];
            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (transEntryFields.getBodyId(iRow) > 0) {
                    objFlags = EntryMainUI.getBodyFlags(iRow);
                    if (objFlags.SuspendBase == true) { // Not authorized and 'Links Base' is selected in authorization definition under 'Keep unposted' group.
                        arrSuspendBase.push(iRow);
                    }
                    else {
                        arrNormal.push(iRow);
                    }
                }
            }

            if (arrNormal.length == 0 && arrSuspendBase.length > 0) {
                transEntryGlobal.showAlert("Voucher cannot be converted. It is not authorized.", GlobalPref.getResourceValue("Error"));

                return;
            }

            if (EntryMain.isDirty() == true) {
                result = await transEntryGlobal.confirmPopup(GlobalPref.getResourceValue("ContentChanged"), eFConfirmButton.YesNo, eFConfirmDefaultButton.No);
                if (result == eFConfirmResult.No) {
                    return;
                }

                EntryMain.clearDirty();
            }

            FUIElement.stopKeyProcess(evt);

            if (transEntryInfo.Settings.NextVouchers.length == 1) {
                transEntryServer.convertLink(transEntryInfo.Settings.NextVouchers[0].ID, transEntryInfo.HeaderId, evt.ctrlKey == true);
            }
            else {
                objInput = {};
                objInput.arrData = transEntryInfo.Settings.NextVouchers;
                objInput.sTitle = GlobalPref.getResourceValue("Convert");
                objInput.sCallback = "EntryMainCallback.convertPopupResult";
                objInput.eleContainer = EntryMainUI.getBodyOthersContainer();
                objInput.bInNewTab = evt.ctrlKey == true;

                LISTPOPUP.openPopup(objInput);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainToolbar.onConvert_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

