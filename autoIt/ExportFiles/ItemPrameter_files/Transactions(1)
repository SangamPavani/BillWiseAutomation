    PickAmount: function () {
        try {
            //debugger
            FGRIDCONTROL.update(AdjustBills_Screen.UI.getAdjustmentGridElement());
            let objPageInfo = null;
            iPageNo = AdjustBills_Screen.getCurrentPage();
            if (iPageNo < 1) {
                iPageNo = 1;
            }
            let index = 0;
            if (AdjustBills_Screen.m_BillWise.arrPageInfo.length > 0) {
                objPageInfo = AdjustBills_Screen.m_BillWise.arrPageInfo[iPageNo - 1];
                index = objPageInfo.StartIndex + m_AdjustRow;
            }
            var EntryColNo = 0;
            EntryColNo = billWiseInfo.EntryColNo;
            var iNoOfDecimal = g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals == 0 ? 2 : g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals;
            if (m_CursurPostion == 0) {
                AdjustBills_ScreenNew.PickNewRef();
                AdjustBills_Screen.AssignAdjustmentValues();
            }
            else if (m_CursurPostion == 1) {
                AdjustBills_ScreenNew.PickOnAccount();
                AdjustBills_Screen.AssignAdjustmentValues();
            }
            else if (m_CursurPostion == 2) {
                let iOrgIndex = 0;
                if (AdjBillGridFragment.IsFragmented() == true) {
                    var rowElement = FGRIDCONTROL.FRAGMENT.getRowElement(AdjBillGridFragment.m_elemFragment, m_AdjustRow);
                    iOrgIndex = FConvert.toInt(rowElement.getAttribute("data-OrgIndex", m_AdjustRow));
                }
                else {
                    var rowElement = FGRIDCONTROL.getRowElement(AdjustBills_Screen.UI.getAdjustmentGridElement(), m_AdjustRow);
                    iOrgIndex = FConvert.toInt(rowElement.getAttribute("data-OrgIndex", m_AdjustRow));
                }
                let bSearch = false;
                if (index - 1 != iOrgIndex) {
                    index = iOrgIndex + 1;
                    bSearch = true;
                }
                AdjustBills_ScreenNew.PickAdjustments(index - 1, iOrgIndex, false, bSearch);
                //AdjustBills_Screen.AssignAmtToPendingBills(AdjustBills_Screen.UI.getAdjustmentGridElement());
                AdjustBills_Screen.CalculateAdjustmentAmount();
                AdjustBills_Screen.AssignAdjustmentValues();
            }
            return (1);
        }
        catch (Ex) {
            alert("Exception: PickAmount " + Ex.message);
        }
    },

