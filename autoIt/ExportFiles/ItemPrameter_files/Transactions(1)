    reloadProductAccount: function(arrRows) {
        let iMaskedVoucher = 0;
        let iAccountId = 0;
        let iProductId= 0;
        let iType = 0;
        let iCounter = 0;
        let iRow = 0;
        let bValue = false;
        let arrInput = null;
        let obj = null;

        try {
            iMaskedVoucher = transEntryInfo.BaseVoucherType;

            bValue = false;
            if (iMaskedVoucher == eVTTYPE.IEXCE) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.ISHOR) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.IOPBA) {
                bValue = true;
            }
            else if (transEntryInfo.isItTransfer == true) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.REQSN) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.PRDIS) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.JWISS) {
                bValue = true;
            }

            arrInput = [];
            for(iCounter = 0; iCounter < arrRows.length; iCounter++) {
                iRow = arrRows[iCounter];

                iProductId = EntryMainMemoryObject.getProductValue(iRow);
                if(iProductId <= 0) {
                    continue;
                }

                iAccountId = 0;
                if ((transEntryInfo.isInwardVoucher == true || bValue == true || iMaskedVoucher == eVTTYPE.PURET)
                    && iMaskedVoucher != eVTTYPE.SARET) {
                    iAccountId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iStocksAccount");
                    iType = eProdAccountTypes.StockAccount;
                }
                else {
                    iAccountId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iSalesAccount");
                    iType = eProdAccountTypes.SalesAccount;
                }

                iAccountId = DataType.toInt(iAccountId);
                if (DataType.lte(iAccountId, 0) == true) {
                    obj = transEntryCache.PRODUCTACCOUNT.getValue(iProductId, iType);
                    if (obj != undefined) {
                        continue;
                    }

                    obj = {};
                    obj.iProductId = iProductId;
                    obj.Type = iType;
                    arrInput.push(obj);
                }
            }

            if(arrInput.length > 0) {
                transEntryCache.fetchProductAccount(arrInput);
            }
        }
        catch(err) {
            transEntryGlobal.writeErrorLog("Exception: {transEntryCacheLoadedData.reloadProductAccount} " + err.message);
        }
    },

