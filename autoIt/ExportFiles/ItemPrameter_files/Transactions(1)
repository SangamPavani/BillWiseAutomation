    recalculateHeaderReadonlyMasterFormulaValues: function () {
        let sId = "";
        let sVar = "";
        let iCounter = 0;
        let bRefresh = false;
        let objMetaData = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;

        try {
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if (objMetaData.bReadOnly == false) {
                    continue;
                }

                if (DataType.stringIncludes(objMetaData.sDefaultValue, "#") == false) {
                    continue;
                }

                if (objMetaData.iDataTypeId == eMasterDataType.Master
                    || objMetaData.iDataTypeId == eMasterDataType.ExternalTable
                    || (objMetaData.iDashboardId == eMasterDataType.Text && objMetaData.iBehaviour == 2)) {
                    bRefresh = DataType.stringStartsWith(objMetaData.sDefaultValue, "&");

                    if (bRefresh == true) {
                        sVar = objMetaData.sDefaultValue.substr(2);
                    }
                    else {
                        sVar = objMetaData.sDefaultValue.substr(1);
                    }

                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(sVar, -1, null, -1, objMetaData.sFieldName);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);

                    sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                    OPTIONCONTROL.setValue(sId, objFormulaOutput.Value);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, objFormulaOutput.Value, 0, objMetaData);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.recalculateHeaderReadonlyMasterFormulaValues} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
