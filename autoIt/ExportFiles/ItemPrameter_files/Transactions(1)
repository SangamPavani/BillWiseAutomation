    getFieldIdFromControlId: function (sId) {
        let obj = null;

        try {
            obj = {};
            obj.bHeader = false;
            obj.bBody = false;
            obj.bFooter = false;
            obj.iFieldId = 0;

            if (DataType.isNullOrEmpty(sId, true) == true) {
                return (obj);
            }

            if (EntryMUI.isHeaderControl(sId) == true) {
                obj.iFieldId = EntryMainUI.extractHeaderFieldId(sId);
                if (obj.iFieldId > 0) {
                    obj.bHeader = true;
                }
            }
            else if (EntryMainUI.isBodyControl(sId) == true) {
                obj.iFieldId = EntryMainUI.extractBodyFieldId(sId);
                if (obj.iFieldId > 0) {
                    obj.bBody = true;
                }
            }
            else if (EntryMainUI.isFooterControl(sId) == true) {
                obj.iFieldId = EntryMainUI.extractFooterFieldId(sId, false);
                if (obj.iFieldId > 0) {
                    obj.bFooter = true;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getFieldIdFromControlId} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (obj);
    },

    setControlValueBasedOnDataType: function (eleCtrl, value, iDataTypeId, iBehaviour) {
        let arrTemp = null;
        let objExtra = undefined;
        let temp = undefined;

        try {
            eleCtrl = FUIElement.getValidElement(eleCtrl);
            if (DataType.isValidObject(eleCtrl) == false) {
                return;
            }

            switch (iDataTypeId) {
                case eMasterDataType.Text:
                    if (iBehaviour == 2) {
                        if (DataType.isNullOrEmpty(value) == false) {
                            arrTemp = value.split(",");
                        }

                        if (arrTemp != null && arrTemp.length > 0) {
                            objExtra = OPTIONCONTROL.createSetValueExtraObject();
                            objExtra.bLoadAll = true;
                            OPTIONCONTROL.setValue(eleCtrl, DataType.toInt(arrTemp[0]), null, objExtra);
                        }
                    }
                    else {
                        eleCtrl.value = value;
                    }
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    eleCtrl.value = DataType.toInt(value);
                    break;
                case eMasterDataType.Fraction:
                    eleCtrl.value = value;
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    temp = DataType.toString(value);
                    if (DataType.stringIncludes(temp, ",") == true) {
                        temp = temp.split(",");
                        value = temp[0];
                    }

                    if(DataType.isString(value) == true && DataType.isNullOrEmpty(value, true) == true) {
                        value = 0;
                    }

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bLoadAll = true;
                    OPTIONCONTROL.setValue(eleCtrl, value, null, objExtra);
                    break;
                case eMasterDataType.Boolean:
                    eleCtrl.value = value;
                    eleCtrl.checked = value;
                    break;
                case eMasterDataType.Date:
                    if(DataType.isInteger(value) == true) {
                        if (DataType.toInt(value) != 0) {
                            DATEPICKER.setDate(eleCtrl, value, true);
                        }
                    }
                    break;
                case eMasterDataType.Time:
                    FTIMECONTROL.setTime(eleCtrl, value);
                    break;
                case eMasterDataType.DateTime:
                    eleCtrl.value = value;
                    break;
                case eMasterDataType.Picture:
                    eleCtrl.value = value;
                    break;
                case eMasterDataType.DocumentViewer:
                    break;
                case eMasterDataType.NumberList:
                    eleCtrl.value = value;
                    break;
                case eMasterDataType.StringList:
                    FUIElement.setText(eleCtrl, value);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.setControlValueBasedOnDataType} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

