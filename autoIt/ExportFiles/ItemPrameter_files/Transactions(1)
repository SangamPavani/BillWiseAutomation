    processForProductChange: function (iProductId, iRow) {
        let sId = "";
        let iMaskedVoucher = 0;
        let iAccountId = 0;
        let iType = 0;
        let bValue = false;
        let objMetaData = undefined;
        let result = null;

        try {
            iMaskedVoucher = transEntryInfo.BaseVoucherType;

            bValue = false;
            if (iMaskedVoucher == eVTTYPE.IEXCE) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.ISHOR) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.IOPBA) {
                bValue = true;
            }
            else if (transEntryInfo.isItTransfer == true) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.REQSN) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.PRDIS) {
                bValue = true;
            }
            else if (iMaskedVoucher == eVTTYPE.JWISS) {
                bValue = true;
            }

            if ((transEntryInfo.isInwardVoucher == true || bValue == true || iMaskedVoucher == eVTTYPE.PURET)
                && iMaskedVoucher != eVTTYPE.SARET) {
                iAccountId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iStocksAccount");
                iType = eProdAccountTypes.StockAccount;
            }
            else {
                iAccountId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iSalesAccount");
                iType = eProdAccountTypes.SalesAccount;
            }

            iAccountId = DataType.toInt(iAccountId);
            if (DataType.lte(iAccountId, 0) == true) {
                iAccountId = EntryMainPreload.getProductAccount(iProductId, iType);
            }
            iAccountId = DataType.toInt(iAccountId);

            if (DataType.lte(iAccountId, 0) == true) {
                if (transEntryInfo.Settings.Misc.DefaultAccount1 > 0) {
                    iAccountId = transEntryInfo.Settings.Misc.DefaultAccount1;
                }
            }

            iAccountId = DataType.toInt(iAccountId);
            if (iAccountId > 0) {
                objMetaData = transEntryFieldInfo.Code.MetaData;
                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                OPTIONCONTROL.setValue(sId, iAccountId);
                result = OPTIONCONTROL.getControlData(sId);
                EntryMainBody.updateMasterValue(transEntryGrid.getCellObject(iRow, transEntryFieldInfo.Code.ColumnIndex),
                                                result,
                                                objMetaData.iFieldId,
                                                false);

                EntryMainMemoryObject.update(eVTFIELDID.FDF_CODE, iAccountId, iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.processForProductChange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

