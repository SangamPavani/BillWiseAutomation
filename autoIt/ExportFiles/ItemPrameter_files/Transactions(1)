            return;
        }

        sBatch = DataType.toString(element.value);
        if (transEntryInfo.isInwardVoucher == true) {
            if (transEntryInfo.BatchPref.bDontAcceptDuplicatebatchInInwardDocuments == true) {

                arrBatch = transEntryBatch.getUsedBatchList();
                if(transEntryBatch.checkDuplicateBatchNo(arrBatch, sBatch, cellobj.iRow) > -1) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDuplicateBatch"), GlobalPref.getResourceValue("Error"));
                    cellobj.clear();

                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, undefined, cellobj.iRow);

                    return;
                }
            }

            if (objLastValue != sBatch
                && transEntryFieldInfo.Skid.ColumnIndex > -1
                && transEntryGlobal.EntryModel.Preference.Bins.iTwoDifferentBatchesCannotbePlacedinSameSkid > 0) {
                iSkid = transEntryFields.getSkid(cellobj.iRow);
                if (iSkid > 0 && DataType.isNullOrEmpty(sBatch) == false) {
                    if (EntryMainWMS.checkForTwoDifferentBatchesCannotbePlacedinSameSkid(iSkid, sBatch, cellobj.iRow) == false) {
                        cellobj.clear();
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, undefined, cellobj.iRow);

                        return;
                    }
                }
            }

            if (objLastValue != sBatch) {
                cellobj.clear();
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, undefined, cellobj.iRow);
            }

            EntryMainBatch.calculateAndSetExpiryDateFromItem(cellobj.iRow, objLastValue != sBatch);
        }

        cellobj.setCellText(sBatch, sBatch);
        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, sBatch, cellobj.iRow);

        if (EntryMainValidate.validateBatchForBin(cellobj.iRow, true) == false) {
            EntryMainUI.clear(transEntryFieldInfo.Bins, iRow);
            EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow);
        }

        return;
    },

