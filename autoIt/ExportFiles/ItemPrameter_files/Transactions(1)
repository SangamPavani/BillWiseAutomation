    calcualtePendingValue: function (arrUsedLinks, arrLoadedLinks) {
        let iCounter = 0;
        let iIndex = 0;
        let arrClubLoadedLinks = [];
        let arrClubUsedLinks = [];
        let arrPendingLinks = [];
        let obj = null;

        try {
            if(arrLoadedLinks.length == 0) {
                return([]);
            }

            for (iCounter = 0; iCounter < arrLoadedLinks.length; iCounter++) {
                for (iIndex = 0; iIndex < arrClubLoadedLinks.length; iIndex++) {
                    if (FNumberOperation.isEqualTo(arrClubLoadedLinks[iIndex].RefId, arrLoadedLinks[iCounter].RefId) == true) {
                        //arrClubLoadedLinks[iIndex].UsedValue += arrLoadedLinks[iCounter].UsedValue;
                        arrClubLoadedLinks[iIndex].UsedValue = FNumberOperation.add(arrClubLoadedLinks[iIndex].UsedValue, arrLoadedLinks[iCounter].UsedValue);
                        break;
                    }
                }

                if (iIndex == arrClubLoadedLinks.length) {
                    obj = {};
                    obj.BaseTransactionId = arrLoadedLinks[iCounter].BaseTransactionId;
                    obj.LinkId = arrLoadedLinks[iCounter].LinkId;
                    obj.RefId = arrLoadedLinks[iCounter].RefId;
                    obj.UsedValue = arrLoadedLinks[iCounter].UsedValue;
                    obj.VoucherNo = arrLoadedLinks[iCounter].VoucherNo;
                    obj.VoucherType = arrLoadedLinks[iCounter].VoucherType;

                    arrClubLoadedLinks.push(obj);
                }
            }

            for (iCounter = 0; iCounter < arrUsedLinks.length; iCounter++) {
                for (iIndex = 0; iIndex < arrClubUsedLinks.length; iIndex++) {
                    if (FNumberOperation.isEqualTo(arrClubUsedLinks[iIndex].RefId, arrUsedLinks[iCounter].RefId) == true) {
                        //arrClubUsedLinks[iIndex].UsedLinkValue += arrUsedLinks[iCounter].UsedLinkValue;
                        arrClubUsedLinks[iIndex].UsedLinkValue = FNumberOperation.add(arrClubUsedLinks[iIndex].UsedLinkValue, arrUsedLinks[iCounter].UsedLinkValue);
                        break;
                    }
                }

                if (iIndex == arrClubUsedLinks.length) {
                    obj = {};
                    obj.BaseTransactionId = arrUsedLinks[iCounter].BaseTransactionId;
                    obj.LinkId = arrUsedLinks[iCounter].LinkId;
                    obj.RefId = arrUsedLinks[iCounter].RefId;
                    obj.UsedLinkValue = arrUsedLinks[iCounter].UsedLinkValue;
                    obj.VoucherNo = arrUsedLinks[iCounter].VoucherNo;
                    obj.VoucherType = arrUsedLinks[iCounter].VoucherType;

                    arrClubUsedLinks.push(obj);
                }
            }

            for (iCounter = 0; iCounter < arrClubLoadedLinks.length; iCounter++) {
                for (iIndex = 0; iIndex < arrClubUsedLinks.length; iIndex++) {
                    if (FNumberOperation.isNotEqualTo(arrClubLoadedLinks[iCounter].RefId, arrClubUsedLinks[iIndex].RefId) == true) {
                        continue;
                    }

                    if (FNumberOperation.isGreaterThan(arrClubLoadedLinks[iCounter].UsedValue, arrClubUsedLinks[iIndex].UsedLinkValue) == true) {
                        obj = {};
                        obj.BaseTransactionId = arrClubLoadedLinks[iCounter].BaseTransactionId;
                        obj.LinkId = arrClubLoadedLinks[iCounter].LinkId;
                        obj.RefId = arrClubLoadedLinks[iCounter].RefId;
                        obj.ExtraValue = arrClubLoadedLinks[iCounter].UsedValue - arrClubUsedLinks[iIndex].UsedLinkValue;
                        obj.VoucherNo = arrClubLoadedLinks[iCounter].VoucherNo;
                        obj.VoucherType = arrClubLoadedLinks[iCounter].VoucherType;
                        arrPendingLinks.push(obj);
                    }

                    break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{WORKFLOW.calcualtePendingValue} " + err.message, "Exception");
        }

        return (arrPendingLinks);
    },

    updateWorkflowPanelValue: function (eleWorkflowGrid, arrUsedLinks, arrLoadedLinks, iLinkField, iCurrentRow, iCurrentColumn, objMetaData, iSelectedRowRefId) {
        let eleRow = null;
        let iTotalRows = 0;
        let iRow = 0;
        let iCounter = 0;
        let iIndex = 0;
        let iRefId = 0;
        let dAvailableValue = 0;
        let dUsedValue = 0;
        let bCalledFromWorkflow = false;
        let arrPendingLinks = null;
        let cell = null;
        let arrCheckedRefId = [];
        let arrGridMatchRefId = [];

        try {
            if (objMetaData.Tag.UseLinkForLoading == true) {
                return;
            }

            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            iCurrentRow = DataType.toInt(iCurrentRow);
            iCurrentColumn = DataType.toInt(iCurrentColumn);
            if (iCurrentColumn == 0) {
                bCalledFromWorkflow = true;
            }

            iSelectedRowRefId = FNumberOperation.convert(iSelectedRowRefId);

            arrPendingLinks = WORKFLOW.calcualtePendingValue(arrUsedLinks, arrLoadedLinks);

            if (arrPendingLinks.length > 0) {
                //WORKFLOW.updateOrAddValue(eleWorkflowGrid, arrPendingLinks, iCurrentRow, arrDataRowIndex, iSelectedRowRefId, iSelectedRowRefId);
            }

            iTotalRows = FGRIDCONTROL.getTotalRows(eleWorkflowGrid);

            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                eleRow = FGRIDCONTROL.getRowElement(eleWorkflowGrid, iRow);
                if (WORKFLOW.isRowDeleted(eleRow) == true) {
                    continue;
                }

                cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, WORKFLOW.getTransactionColumnIndex());
                iRefId = FNumberOperation.convert(cell.getCellData());

                cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, WORKFLOW.getPendingValueColumnIndex());
                dAvailableValue = DataType.toDecimal(cell.getCellData());

                for (iCounter = 0; iCounter < arrUsedLinks.length; iCounter++) {
                    if (arrUsedLinks[iCounter].RefId != iRefId) {
                        continue;
                    }

                    if (DataType.arrayContains(arrGridMatchRefId, iRefId) < 0) {
                        arrGridMatchRefId.push(iRefId);
                    }

                    if (arrUsedLinks[iCounter].lTransactionId != 0) {
                        dUsedValue = EntryMainWorkflow.getLoadedUsedLinkValue(arrUsedLinks[iCounter].RefId, arrUsedLinks[iCounter].lTransactionId)
                        if (DataType.gt(arrUsedLinks[iCounter].UsedLinkValue, dUsedValue) == true) {
                            // Find extra value
                            dUsedValue = DataType.sub(arrUsedLinks[iCounter].UsedLinkValue, dUsedValue);
                            dAvailableValue = DataType.sub(dAvailableValue, dUsedValue);
                        }

                        continue;
                    }

                    if (bCalledFromWorkflow == false
                        && arrUsedLinks[iCounter].iRow == iCurrentRow
                        && arrUsedLinks[iCounter].iColumn == iCurrentColumn) {

                        continue;
                    }

                    dAvailableValue = DataType.sub(dAvailableValue, arrUsedLinks[iCounter].UsedLinkValue);

                    arrCheckedRefId.push(iRefId);
                }

                WORKFLOW.updateDisplayLinkValue(eleWorkflowGrid, iRow, dAvailableValue, iLinkField);

                eleRow = FGRIDCONTROL.getRowElement(eleWorkflowGrid, iRow);

                eleRow.style.display = "";
                if ((dAvailableValue <= 0 && bCalledFromWorkflow == true) || dAvailableValue == 0) {
                    iRefId = transEntryWorkflow.getRowRefId(iRow, eleWorkflowGrid);
                    if (transEntryWorkflow.Data.hasPendingValue(iRefId) == false) {
                        WORKFLOW.deleteRow(eleRow);
                    }
                    //WORKFLOW.deleteRow(eleRow);
                }
            }

            for (iCounter = 0; iCounter < arrUsedLinks.length; iCounter++) {
                if (arrUsedLinks[iCounter].lTransactionId != 0) {
                    continue;
                }

                for (iRow = 0; iRow < arrGridMatchRefId.length; iRow++) {
                    if (arrUsedLinks[iCounter].RefId == arrGridMatchRefId[iRow]) {
                        break;
                    }
                }

                // if Used RefId not found in grid
                if (iRow >= arrGridMatchRefId.length) {
                    // Update pending value in data
                    if (FNumberOperation.isNotEqualTo(iSelectedRowRefId, arrUsedLinks[iCounter].RefId) == true) {
                        iIndex = transEntryWorkflow.Data.findRefIdDataIndex(arrUsedLinks[iCounter].RefId);
                        if (iIndex >= 0) {
                            transEntryWorkflow.Data.updatePendingValueInData(eleWorkflowGrid, iIndex, arrUsedLinks[iCounter].UsedLinkValue, iLinkField, true);
                        }
                    }
                }
                else {
                    // RefId found in grid
                    if (bCalledFromWorkflow == false
                        && arrUsedLinks[iCounter].iRow == iCurrentRow
                        && arrUsedLinks[iCounter].iColumn == iCurrentColumn) {
                        // Link Popup
                    }
                    else {
                        iIndex = transEntryWorkflow.Data.findRefIdDataIndex(arrUsedLinks[iCounter].RefId);
                        if(iIndex >= 0) {
                            transEntryWorkflow.Data.updatePendingValueInData(eleWorkflowGrid, iIndex, arrUsedLinks[iCounter].UsedLinkValue, iLinkField, true);
                        }
                    }                    
                }

                if (transEntryWorkflow.Data.hasPendingValue(arrUsedLinks[iCounter].RefId) == false) {
                    iIndex = transEntryWorkflow.findGridRowIndex(arrUsedLinks[iCounter].RefId, transEntryWorkflowInfo.HiddenTransIdColumn, eleWorkflowGrid);
                    if (iIndex > 0) {
                        eleRow = FGRIDCONTROL.getRowElement(eleWorkflowGrid, iIndex);
                        WORKFLOW.deleteRow(eleRow);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{WORKFLOW.updateWorkflowPanelValue} " + err.message, "Exception");
        }
    },

    updateLoadedValue: function (eleWorkflowGrid, arrUsedExtraQty, iLinkField) {
        let iRow = 0;
        let iTotalRows = 0;
        let iCounter = 0;
        let dNewValue = 0;
        let cell = null;
        let objUsedExtraQty = null;

        try {
            iTotalRows = FGRIDCONTROL.getTotalRows(eleWorkflowGrid);

            for (iCounter = 0; iCounter < arrUsedExtraQty.length; iCounter++) {
                objUsedExtraQty = arrUsedExtraQty[iCounter];

                for (iRow = 1; iRow <= iTotalRows; iRow++) {
                    cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, WORKFLOW.getTransactionColumnIndex());
                    if (DataType.toInt64(cell.getCellData()) == objUsedExtraQty.iRefId) {
                        cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, WORKFLOW.getPendingValueColumnIndex());
                        dNewValue = DataType.toDecimal(cell.getCellData());
                        dNewValue = DataType.sub(dNewValue, objUsedExtraQty.dUsedExtraQty);
                        cell.setCellText(dNewValue, dNewValue);

                        WORKFLOW.updateDisplayLinkValue(eleWorkflowGrid, iRow, dNewValue, iLinkField);

                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{WORKFLOW.updateLoadedValue} " + err.message, "Exception");
        }

        return (false);
    },

