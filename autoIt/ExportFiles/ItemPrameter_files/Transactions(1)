                && (iRowIndex == 0 || iRowIndex == iRow)
                && transEntryGlobal.isIgnoreServerCall() == false) {

                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload,
                                                    iRow,
                                                    dInput,
                                                    transEntryGlobal.FieldHelper.Column.Screen[iScreenColIndex],
