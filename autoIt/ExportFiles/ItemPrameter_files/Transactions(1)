        let iCounter = 0;
        let dValue = 0;

        try {
            if(DataType.arrayLength(arrBinsData) < 1) {
                return(0);
            }

            for(iCounter = 0; iCounter < arrBinsData.length; iCounter++) {
                if(bAbs == true) {
