    updateMasterValue: function (cell, arrData, iFieldId, bRawData) {
        let sCtrlId = "";
        let iMasterId = 0;
        let objData = undefined;

        try {
            if (DataType.isValidObject(cell) == false) {
                return (iMasterId);
            }

            cell.clear();
            if (DataType.arrayLength(arrData) >= 2) {
                bRawData = DataType.toBoolean(bRawData);
                if (bRawData == true) {
                    sCtrlId = EntryMainUI.getBodyControlId(iFieldId);
                    objData = OPTIONCONTROL.convertRawDataIntoObject(sCtrlId, arrData);
                    cell.setCellData(objData);
                }
                else {
                    cell.setCellData(arrData);

                    objData = DataType.arrayObjectToSingleObject(arrData);
                }

                EntryMainMemoryObject.updateExtraInfo(iFieldId, objData, cell.iRow);

                iMasterId = DataType.getObjectFirstValue(arrData[0]);
                iMasterId = DataType.toInt(iMasterId);
                cell.setCellText(DataType.getObjectFirstValue(arrData[1]), iMasterId);

                if (bRawData == true) {
                    EntryMainMemoryObject.update(iFieldId, iMasterId, cell.iRow, cell.MetaData);
                }

                EntryMainUI.updateMemoryMasterDependentData(iFieldId, cell, cell.iRow);

                return (iMasterId);
