    calculateSummaryBarData: function (bFromMemory) {
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let iTotalRows = 0;
        let iRow = 0;
        let iTotal = 0;
        let iId = 0;
        let iFactor = 0;
        let dValue = 0;
        let dExchangeRate = 0;
        let bDisplayInBaseCurrency = false;
        let arrFooterFields = undefined;
        let arrScreenFields = undefined;
        let objMetaData = null;
        let result = null;
        let cell = null;
        let obj = null;
        let objTemp = null;

        try {
            obj = {};
            obj.dTotalNet = 0;
            obj.dTotalGross = 0;
            obj.arrTotalScreenOutputValue = [];
            obj.arrFooterOutputData = [];

            arrScreenFields = transEntryFieldInfo.getScreenFields();
            for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                obj.arrTotalScreenOutputValue.push(0);
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter++) {
                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                objMetaData = arrFooterFields[iIndex];

                objTemp = {};
                objTemp.iMetaDataIndex = iIndex;
                objTemp.iFieldId = objMetaData.iFieldId;
                objTemp.dOutputValue = 0;

                obj.arrFooterOutputData.push(objTemp);
            }

            iFactor = transEntryInfo.isItTransfer == true ? 2 : 1;

            bFromMemory = DataType.toBoolean(bFromMemory);
            if (bFromMemory == true) {
                obj.dTotalNet = transEntryGlobal.EntryModel.Data.dNetAmount;

                for (iRow = 0; iRow < transEntryGlobal.EntryModel.Data.Body.length; iRow++) {

                    // Calculate gross total
                    if (transEntryFieldInfo.Gross.ColumnIndex > -1) {
                        sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYGROSS);
                        result = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Body[iRow]);
                        if (result.lValue > 0) {
                            obj.dTotalGross = FNumberOperation.add(obj.dTotalGross, result.data.Value);
                        }
                    }

                    dExchangeRate = 0;
                    result = EntryMainCommon.findKeyValue(eTranEntryBodyDataConstKey.ExchangeRate, transEntryGlobal.EntryModel.Data.Body[iRow]);
                    if (result.lValue > 0) {
                        dExchangeRate = result.data.Value;
                    }


                    // Calculate screen fields total
                    for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                        objMetaData = arrScreenFields[iCounter].MetaData;

                        sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        result = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Body[iRow]);
                        if (result.lValue > 0) {
                            result = DataType.stringToObject(result.data.Value);
                            if (result.lValue > 0) {
                                result = result.data;

                                if (objMetaData.bDisplayInBaseCurrency == true) {
                                    //obj.arrTotalScreenOutputValue[iCounter] += (dExchangeRate * result.Value / iFactor);
                                    obj.arrTotalScreenOutputValue[iCounter] = FNumberOperation.calculate([dExchangeRate, result.Value, iFactor, obj.arrTotalScreenOutputValue[iCounter]], ['*', '/', '+']);
                                }
                                else {
                                    obj.arrTotalScreenOutputValue[iCounter] = FNumberOperation.add(obj.arrTotalScreenOutputValue[iCounter], result.Value);
                                }
                            }
                        }
                    }
                }

                if (transEntryGlobal.EntryModel.Data.Body.length > 0 && iRow < transEntryGlobal.EntryModel.Data.Body.length) {
                    dExchangeRate = 0;
                    result = EntryMainCommon.findKeyValue(eTranEntryBodyDataConstKey.ExchangeRate, transEntryGlobal.EntryModel.Data.Body[iRow]);
                    if (result.lValue > 0) {
                        dExchangeRate = result.data.Value;
                    }
                }

                if (dExchangeRate == 0) {
                    dExchangeRate = 1;
                }

                // Calculate footer fields
                iTotal = DataType.arrayLength(transEntryGlobal.EntryModel.Data.Footer);
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    sId = transEntryGlobal.EntryModel.Data.Footer[iCounter].Key;
                    iId = DataType.toInt(sId.substr(EntryMainUI.getFooterControlIdPrefix().length));
                    for (iIndex = 0; iIndex < obj.arrFooterOutputData.length; iIndex++) {
                        objTemp = obj.arrFooterOutputData[iIndex];
                        if (objTemp.iFieldId == iId) {
                            result = DataType.stringToObject(transEntryGlobal.EntryModel.Data.Footer[iCounter].Value);
                            if (result.lValue > 0) {
                                result = result.data;

                                objMetaData = null;
                                dValue = DataType.arrayFilterData(arrFooterFields, "iFieldId", iId, "==");
                                if (dValue.length > 0) {
                                    objMetaData = dValue[0];
                                }

                                bDisplayInBaseCurrency = false;
                                if (objMetaData == null || objMetaData.bDisplayInBaseCurrency == false) {
                                    dValue = DataType.formatToDecimalPlaces(result.Value, arrFooterFields[objTemp.iMetaDataIndex].iNoDecimal);
                                }
                                else { // Display in base currency
                                    //dValue = FNumberOperation.calculate([dExchangeRate, result.Value, iFactor], ['*', '/']);
                                    dValue = DataType.mul(result.Value, dExchangeRate);
                                    bDisplayInBaseCurrency = true;
                                }

                                objTemp.dOutputValue = DataType.formatToDecimalPlaces(dValue, objMetaData.iNoDecimal);

                                if (bDisplayInBaseCurrency == true) {
                                    dValue = DataType.formatToDecimalPlaces(dValue, objMetaData.iNoDecimal);
                                }

                                objTemp.dOutputValue = dValue;
                                obj.arrFooterOutputData[iIndex] = objTemp;
                                break;
                            }
                            else {
                                dValue = DataType.formatToDecimalPlaces(0, arrFooterFields[objTemp.iMetaDataIndex].iNoDecimal);
                                objTemp.dOutputValue = dValue;
                                obj.arrFooterOutputValue[iIndex] = dValue;
                            }
                        }
                    }
                }
            }
            else {
                iTotalRows = transEntryGrid.getTotalRows();
                for (iRow = 1; iRow <= iTotalRows; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        break;
                    }

                    obj.dTotalGross = FNumberOperation.add(obj.dTotalGross, EntryMainMemoryObject.getGrossValue(iRow));

                    dExchangeRate = EntryMainMemoryObject.getExchangeRate(iRow);
                    
                    for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                        objMetaData = arrScreenFields[iCounter].MetaData;

                        cell = transEntryGrid.getCellElement(iRow, arrScreenFields[iCounter].ColumnIndex, true);

                        if (objMetaData.bDisplayInBaseCurrency == true) {
                            dValue = cell.getAttribute(CELL_RAWOUTPUT);
                            obj.arrTotalScreenOutputValue[iCounter] = FNumberOperation.calculate([dExchangeRate, dValue, iFactor, obj.arrTotalScreenOutputValue[iCounter]], 
                                                                            ['*', '/', '+']);
                        }
                        else {
                            dValue = cell.getAttribute(CELL_OUTPUT);
                            dValue = FNumberOperation.convert(dValue);
                            obj.arrTotalScreenOutputValue[iCounter] = FNumberOperation.add(obj.arrTotalScreenOutputValue[iCounter], dValue);
                        }
                    }
                }

                dExchangeRate = EntryMainMemoryObject.getExchangeRate(1);

                for (iIndex = 0; iIndex < obj.arrFooterOutputData.length; iIndex++) {
                    objTemp = obj.arrFooterOutputData[iIndex];

                    objMetaData = arrFooterFields[objTemp.iMetaDataIndex];

                    dValue = transEntryFooter.getOutputValue(objMetaData.iFieldId);

                    if (objMetaData.bDisplayInBaseCurrency == true) {
                        dValue = FNumberOperation.calculate([dExchangeRate, dValue, iFactor], ['*', '/']);
                    }

                    objTemp.dOutputValue = DataType.formatToDecimalPlaces(dValue, objMetaData.iNoDecimal);

                    obj.arrFooterOutputData[iIndex] = objTemp;
                }
            }

            if (transEntryFieldInfo.Gross.ColumnIndex > -1) {
                obj.dTotalGross = EntryMain.formatFractionNumber(eVTFIELDID.FDF_BODYGROSS, obj.dTotalGross, 0, 0);
            }

            for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                objMetaData = arrScreenFields[iCounter].MetaData;
                obj.arrTotalScreenOutputValue[iCounter] = EntryMain.formatFractionNumber(objMetaData.iFieldId, obj.arrTotalScreenOutputValue[iCounter], objMetaData.iNoDecimal, 0);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.calculateSummaryBarData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (obj);
    },

