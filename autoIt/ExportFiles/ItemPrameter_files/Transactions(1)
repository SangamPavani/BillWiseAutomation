const EntryMainBudget = {
    isCheckRequired: function () {
        let iMaskedVoucherType = 0;
        let objFlags = null;

        try {
            if (transEntryInfo.CompanyFeatures.bBudget == false) {
                return (false);
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if ((transEntryInfo.Settings.Misc.UpdateFA || (transEntryInfo.Settings.Misc.MiscFlag & 0x700000) > 0)
                && ((transEntryInfo.isItSales == true && transEntryInfo.isInwardVoucher == true) 
                || iMaskedVoucherType == eVTTYPE.JOURN
                || iMaskedVoucherType == eVTTYPE.NJOURN
                || iMaskedVoucherType == eVTTYPE.CASHP
                || iMaskedVoucherType == eVTTYPE.CRDNT
                || iMaskedVoucherType == eVTTYPE.DEBNT
                || iMaskedVoucherType == eVTTYPE.PETIC)
                && (transEntryInfo.BudgetPref.iBudgetGroup > 0 && transEntryInfo.BudgetPref.bCheckBudget == true)) {

                if((transEntryInfo.Settings.Misc.MiscFlag & 0x500000) == 0x500000) { // 'Do Not Check' selected
                    return (false);
                }

                if (EntryMain.isEditMode() == false) {
                    return (true);
                }

                objFlags = transEntryInfo.getHeaderFlags();
                if (DataType.isValidObject(objFlags) == false) {
                    return (false);
                }

                if (!objFlags.Suspended && !objFlags.Cancelled && objFlags.CheckNegativeBudget) {
                    return (true);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBudget.isCheckRequired} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(false);
    },

    checkBudget: function (iFieldId, cellobj, dLastValue) {
        let iCounter = 0;
        let value = 0;
        let bDisableNetworkLog = false;
        let bServerCall = false;
        let result = null;
        let obj = null;
        let objWatch = null;

        try {
            objWatch = new FStopWatch();
            objWatch.start();

            if (iFieldId == eVTFIELDID.FDF_BODYJRNDEBIT || iFieldId == eVTFIELDID.FDF_BODYJRNCREDIT || iFieldId == eVTFIELDID.FDF_BODYAMOUNT || iFieldId == eVTFIELDID.FDF_BODYRATE || iFieldId == eVTFIELDID.FDF_BODYGROSS) {
                value = DataType.toDecimal(cellobj.getCellData());
                if (value != 0 && EntryMainBudget.isCheckRequired() == true && value != dLastValue) {                    
                    obj = {};
                    obj.objData = transEntryData.getFocusFormatData(true);

                    obj.objData = DataType.toString(obj.objData);
                    obj.iVoucherType = transEntryInfo.VoucherType;
                    obj.iViewId = transEntryInfo.ViewId;
                    obj.lMiscFlag = transEntryInfo.Settings.Misc.MiscFlag;
                    obj.byBudgetGroup = transEntryInfo.BudgetPref.iBudgetGroup;
                    obj.byCheckBudgetInDataEntryGroup = transEntryInfo.BudgetPref.iCheckBudgetInDataEntryGroup;
                    obj.iBudgetPlanning = transEntryInfo.BudgetPref.iBudgetPlanning;
                    obj.iTag2 = transEntryInfo.BudgetPref.iTag2;
                    obj.iTag3 = transEntryInfo.BudgetPref.iTag3;
                    obj.bDontUseAdvanceBudget = transEntryInfo.BudgetPref.bDontUseAdvBudget;
                    obj.iFATag = transEntryInfo.TagsPref.iAccounting;
                    obj.iInvTag = transEntryInfo.TagsPref.iInventory;
                    obj.iCheckBudgetOn = transEntryInfo.BudgetPref.iCheckBudgetOn;

                    bServerCall = true;

                    bDisableNetworkLog = NETWORK.enableLog(false, true);
                    result = transEntryServer.execute(eTransServerRequest.CheckBudget, obj);
                    NETWORK.enableLog(bDisableNetworkLog, false);

                    if (result.lValue > 0) {
                        result = result.data;
                    }

                    if (result.lValue <= 0 && DataType.isNullOrEmpty(result.sValue, true) == false) {
                        transEntryGlobal.showAlert(result.sValue, "Error");
                    }
                    else if (result.lValue > 0) {
                        if (result.data.Result == 2) {
                            transEntryGlobal.showAlert("Budget not defined.", "Error");
                        }
                        else if (result.data.Result == 1) {
                            if (transEntryInfo.BudgetPref.iBudgetExceededAction == 0) {
                                transEntryGlobal.showAlert("This row is making budget negative.", "Warning");
                            }
                            else {
                                transEntryGlobal.showAlert("This row is making budget negative.", "Error");
                            }                            
                        }

                        if (result.data.Row > 0 && transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                            switch (transEntryInfo.BaseVoucherType) {
                                case eVTTYPE.PORDR: // Purchases order
                                case eVTTYPE.PURCH: // Purchases Voucher
                                case eVTTYPE.MATRN: // Material Receipts Note
                                    transEntryGrid.showRowSymbol(result.data.Row, true);
                                    break;
                            }
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBudget.checkBudget} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        objWatch.stop();

        if (bServerCall == true) {
            transEntryGlobal.writeInfoLog("ServerCall::{CheckBudget} [Time=" + objWatch.getDifferenceString() + "]", 2, "royalblue");
        }
    }
};
