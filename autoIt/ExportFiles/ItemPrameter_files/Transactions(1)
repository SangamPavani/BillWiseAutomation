    onBodyOthers_Leave: function (cellobj, objMetaData) {
        let iLastValue = 0;
        let iCurrentValue = 0;
        let arrFound = null;
        let data = null;

        try {
            iLastValue = DataType.toInt(cellobj.getCellData());

            if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                if (objMetaData.iFieldId == transEntryFieldInfo.FATag.FieldId) {
                    EntryMainMaster.onFATag_Leave(cellobj, objMetaData.iFieldId);
                }
                else if (objMetaData.iFieldId == transEntryGlobal.FieldHelper.iInvTagFieldId) {
                    EntryMainMaster.onInvTag_Leave(cellobj, objMetaData.iFieldId);
                }
                else if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Body
                    && transEntryFieldInfo.SubLedger.FieldId == objMetaData.iFieldId) {
                    EntryMainMaster.onSubLedger_Leave(cellobj, objMetaData.iFieldId);
                }
                else { // Tags
                    EntryMainMaster.onBodyTags_Leave(cellobj, objMetaData.iFieldId);
                }
            }
            else {
                data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
                iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, objMetaData.iFieldId, false);

                EntryMainMemoryObject.update(objMetaData.iFieldId, iCurrentValue, cellobj.iRow, objMetaData);

                if (objMetaData.iFieldId == eVTFIELDID.FDF_SKID && iCurrentValue > 0) {
                    arrFound = DataType.arrayFilterDataIndex(EntryMain.m_arrSkidIds, "ID", iCurrentValue, "==");
                    if (arrFound.length > 0) {
                        EntryMain.m_arrSkidIds.splice(arrFound[0], 1);
                    }
                }

                if (objMetaData.iFieldId == transEntryFieldInfo.TaxCode.FieldId
                    && iCurrentValue != iLastValue) {

                    transEntryVat.resetVATColumn(cellobj.iRow, iCurrentValue);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onBodyOthers_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

