    processQtyDataBeforeDisplay: function(arrBodyData, bPendingLinks, iBaseVoucherType) {
        let sId = "";
        let iRowCounter = 0;
        let bHeaderIssue = false;
        let bQtyNegative = false;
        let result = null;

        try {
            if (transEntryInfo.isItTransfer == false) {
                return(false);
            }

            bHeaderIssue = true;
            sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYQUANTITY);
            result = EntryMainCommon.findKeyValue(sId, arrBodyData[0]);
            if (result.lValue <= 0) {
                return(true);
            }

            if (DataType.lte(result.data.Value, 0) == true) { // Header WH is Receipts
                bQtyNegative = true;
                bHeaderIssue = false;
                for (iRowCounter = 0; iRowCounter < arrBodyData.length; iRowCounter++) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYQUANTITY);
                    result = EntryMainCommon.findKeyValue(sId, arrBodyData[iRowCounter]);
                    if (result.lValue > 0) {
                        if (DataType.isZero(result.data.Value) == false) {
                            result.data.Value = FNumberOperation.mul(result.data.Value, -1);
                        }

                        arrBodyData[iRowCounter][result.lValue - 1] = result.data;
                    }

                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYALTQUANTITY);
                    result = EntryMainCommon.findKeyValue(sId, arrBodyData[iRowCounter]);
                    if (result.lValue > 0) {
                        if (DataType.isZero(result.data.Value) == false) {
                            result.data.Value = FNumberOperation.mul(result.data.Value, -1);
                        }

                        arrBodyData[iRowCounter][result.lValue - 1] = result.data;
                    }
                }
            }

            if(bPendingLinks == true /*&& FConvert.isItTransfer(iBaseVoucherType) == false*/) {
                bHeaderIssue = false;
                if(bQtyNegative == true) {
                    bHeaderIssue = true;
                }            
            }

        }
        catch(err) {
            transEntryGlobal.writeErrorLog("{EntryMainUI.processQtyDataBeforeDisplay} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(bHeaderIssue);
    },

    // Called when transaction data is loaded from server
    processDataBeforeDisplay: function (bPendingLinks) {
        let sId = "";
        let bHeaderIssue = false;
        let arrBodyData = null;
        let result = null;
        let obj = null;

        try {
            EntryMainUI.initLoadedDataObjectArray();

            if (transEntryInfo.isItTransfer == false) {
                return;
            }

            arrBodyData = transEntryGlobal.EntryModel.Data.Body;

            bHeaderIssue = EntryMainUI.processQtyDataBeforeDisplay(arrBodyData, bPendingLinks, transEntryGlobal.EntryModel.Data.iBaseVoucherType);
            if (transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Body) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_RCTISSUESELECTION);

                obj = {};
                obj.Key = sId;
                obj.Value = 0;

                if (bHeaderIssue == true) {
                    obj.Value = 0;
                }
                else {
                    obj.Value = 1;
                }

                transEntryGlobal.EntryModel.Data.Header.push(obj);
            }
            else {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BODYINVTAG);
                result = EntryMainCommon.findKeyValue(sId, transEntryData.getHeader());
                if (result.lValue > 0) {
                    if (result.data.Value > 0) {
                        return;
                    }
                }
  
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BODYINVTAG);
                result = EntryMainCommon.findKeyValue(sId, arrBodyData[0]);
                if(result.lValue > 0) {
                    obj = {};
                    obj.Key = sId;
                    obj.Value = result.data.Value;

                    result = EntryMainCommon.findKeyValue(sId, transEntryData.getHeader());
                    if (result.lValue > 0) {
                        transEntryGlobal.EntryModel.Data.Header[result.lValue - 1] = obj;
                    }
                }
            }
        }
        catch (err) { 
            transEntryGlobal.showAlert("{EntryMainUI.processDataBeforeDisplay} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    // Called from getBodyData for stock transfer type vouchers
    prepareBodyDataForStockTransferSaving: function (arrBodyData) {
        let sId = "";
        let sHInvTagProp = "";
        let sBInvTagProp = "";
        let iHInvTagArea = 0;
        let iBInvTagArea = 0;
        let iRow = 0;
        let iCounter = 0;
        let iBinCounter = 0;
        let iIndex = 0;
        let dQuantity = 0;
        //let iStartNext = 0;
        let bIssueDataReceived = false;
        let bFlag = false;
        let arrNewBodyData = [];
        let objBodyData = null;
        let objNewBodyData = null;
        let objBodyInvTag = null;
        let objBin = null;
        let arrBins = [];
        let arrBins2 = [];
        let arrIssueBins = [];
        let arrReceivingBins = [];
        let result = null;

        try {
            bIssueDataReceived = false;

            iHInvTagArea = transEntryFieldInfo.HeaderInvTag.Area;
            iBInvTagArea = transEntryFieldInfo.BodyInvTag.Area;

            if (iHInvTagArea == iBInvTagArea || transEntryFieldInfo.IssueInvTag.Area == eTranEntryFieldArea.Header) {
                bIssueDataReceived = true;
            }

            sHInvTagProp = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_HEADERINVTAG);
            sBInvTagProp = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYINVTAG);

            //iStartNext = arrBodyData.length;
            for (iRow = 0; iRow < arrBodyData.length; iRow++) {

                objBodyData = arrBodyData[iRow];

                if (iHInvTagArea == eTranEntryFieldArea.Body) {
                    delete objBodyData[sBInvTagProp];
                }

                result = DataType.stringToObject(objBodyData.Flags);
                if (result.lValue > 0) {
                    objBodyData.Flags = result.data;
                }


                if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BINS);
                    arrBins.push(objBodyData[sId]);
                    objBodyData[sId] = "";
                }

                if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BINS2)
                    arrBins2.push(objBodyData[sId]);
                    objBodyData[sId] = "";
                }

                objBodyData.Flags.InternalIIDST = false;
                objBodyData.Flags = DataType.toString(objBodyData.Flags);
                arrBodyData[iRow] = objBodyData;

                objNewBodyData = DataType.createDuplicateObject(objBodyData);

                if (transEntryFieldInfo.Reservation.ColumnIndex > -1) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_RESERVEQUANTITY);
                    objNewBodyData[sId] = null;
                }


                objNewBodyData.BillwiseData = null;

                objNewBodyData.BodyId = 0;
                objNewBodyData.TransactionId = 0;


                arrNewBodyData.push(objNewBodyData);
            }

            if (transEntryFieldInfo.Bins.ColumnIndex > -1 && arrBins.length > 0 && arrBins2.length > 0) {
                // Copy some of issue bins data to receiving bins data

                for(iRow = 0; iRow < arrBins.length && iRow < arrBins2.length; iRow++) {
                    arrIssueBins = [];
                    arrReceivingBins = [];
                    if(bIssueDataReceived == true) {
                        objBin = DataType.stringToObject(arrBins[iRow]);
                        if (objBin.lValue > 0) {
                            arrIssueBins = objBin.data;
                        }

                        objBin = DataType.stringToObject(arrBins2[iRow]);
                        if (objBin.lValue > 0) {
                            arrReceivingBins = objBin.data;
                        }
                    }
                    else {
                        objBin = DataType.stringToObject(arrBins[iRow]);
                        if (objBin.lValue > 0) {
                            arrReceivingBins = objBin.data;
                        }

                        objBin = DataType.stringToObject(arrBins2[iRow]);
                        if (objBin.lValue > 0) {
                            arrIssueBins = objBin.data;
                        }
                    }

                    bFlag = false;
                    for(iIndex = 0; iIndex < arrIssueBins.length && iIndex < arrReceivingBins.length; iIndex++) {
                        if(DataType.isValidObject(arrIssueBins[iIndex].AllocTag) == true && DataType.isValidObject(arrReceivingBins[iIndex].AllocTag) == true) {
                            if(DataType.neq(arrReceivingBins[iIndex].AllocTag, arrIssueBins[iIndex].AllocTag) == true) {
                                transEntryGlobal.showAlert("Allocation tag mismatch for row " + (iIndex + 1) + " issue is " + arrIssueBins[iIndex].AllocTag + " receiving is " + arrReceivingBins[iIndex].AllocTag, "", true);
                            }
                        }

                        if(DataType.isValidObject(arrIssueBins[iIndex].LotNo) == true && DataType.isValidObject(arrReceivingBins[iIndex].LotNo) == true) {
                            if(DataType.neq(arrReceivingBins[iIndex].LotNo, arrIssueBins[iIndex].LotNo) == true) {
                                transEntryGlobal.showAlert("Lot number mismatch for row " + (iIndex + 1) + " issue is " + arrIssueBins[iIndex].LotNo + " receiving is " + arrReceivingBins[iIndex].LotNo, "", true);
                            }
                        }

                        arrReceivingBins[iIndex].AllocTag = arrIssueBins[iIndex].AllocTag;
                        transEntryBins.copyWMSInfo(arrReceivingBins[iIndex], arrIssueBins[iIndex]);

                        bFlag = true;
                    }

                    if(bFlag == true) {
                        if(bIssueDataReceived == true) {
                            arrBins[iRow] = DataType.toString(arrIssueBins);
                            arrBins2[iRow] = DataType.toString(arrReceivingBins);
                        }
                        else {
                            arrBins[iRow] = DataType.toString(arrReceivingBins);
                            arrBins2[iRow] = DataType.toString(arrIssueBins);
                        }
                    }
                }
            }

            for (iRow = 0; iRow < arrNewBodyData.length; iRow++) {
                objBodyInvTag = EntryMainMemoryObject.getBodyInvTagValue(iRow + 1);
                if (objBodyInvTag != undefined) {
                    arrNewBodyData[iRow][sBInvTagProp] = objBodyInvTag;
                }

                delete arrNewBodyData[iRow][sHInvTagProp];
                arrNewBodyData[iRow].BodyId = 0;
                objNewBodyData.TransactionId = 0;
            }

            arrBodyData = DataType.arrayAddRange(arrBodyData, arrNewBodyData);

            if (bIssueDataReceived == true) {
                iCounter = 0; // Start index of issue data
                iRow = arrBodyData.length / 2; // End index of issue data
            }
            else {
                iCounter = arrBodyData.length / 2; // Start index of issue data
                iRow = arrBodyData.length; // End index of issue data
            }


            iIndex = 0;
            for (; iCounter < iRow; iCounter++) { // Loop for issue rows
                objBodyData = arrBodyData[iCounter]; // Issue row data

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYQUANTITY);
                dQuantity = DataType.mul(objBodyData[sId], -1);
                objBodyData[sId] = dQuantity;

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_QUANTITY_IN_BASE);
                objBodyData[sId] = DataType.mul(objBodyData[sId], -1);

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYALTQUANTITY);
                objBodyData[sId] = DataType.mul(objBodyData[sId], -1);

                if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                    objBin = DataType.stringToObject(arrBins[iIndex]);
                    if (objBin.lValue > 0) {
                        objBin = objBin.data;
                        for (iBinCounter = 0; iBinCounter < objBin.length; iBinCounter++) {
                            objBin[iBinCounter].Quantity = DataType.mul(DataType.abs(objBin[iBinCounter].Quantity), (dQuantity < 0 ? -1 : 1));
                        }
                        arrBins[iIndex] = DataType.toString(objBin);
                    }
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BINS)
                    objBodyData[sId] = arrBins[iIndex];
                    iIndex++;
                }

                arrBodyData[iCounter] = objBodyData;
            }

            if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                if (bIssueDataReceived == true) {
                    iCounter = arrBodyData.length / 2; // Start index of receive row
                    iRow = arrBodyData.length; // End index of receive row

                }
                else {
                    iCounter = 0; // Start index of receive row
                    iRow = arrBodyData.length / 2; // End index of receive row
                }

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BINS2)

                iIndex = 0;
                for (; iCounter < iRow; iCounter++) { // Loop for receive rows
                    objBodyData = arrBodyData[iCounter]; // Issue receive data

                    objBodyData[sId] = arrBins2[iIndex];
                    iIndex++;

                    arrBodyData[iCounter] = objBodyData;
                }
            }



            for (iRow = 0; iRow < arrBodyData.length; iRow++) {
                objBodyData = arrBodyData[iRow];

                //sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYBATCHNO);

                //if (DataType.isValidObject(arrTempBody[iCounter].Sales.BatchNo) == true) {
                //    arrTempBody[iCounter].Sales.BatchNo.Qty = Math.abs(arrTempBody[iCounter].Sales.BatchNo.Qty) * (arrTempBody[iCounter].Sales.Quantity < 0 ? -1 : 1);
                //}


                //if (DataType.isValidObject(arrTempBody[iCounter].Sales.BinsData) == true) {
                //    for (iCount = 0; iCount < arrTempBody[iCounter].Sales.BinsData.length; iCount++) {
                //        arrTempBody[iCounter].Sales.BinsData[iCount].Quantity = Math.abs(arrTempBody[iCounter].Sales.BinsData[iCount].Quantity) * (arrTempBody[iCounter].Sales.Quantity < 0 ? -1 : 1);
                //    }
                //}
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.prepareBodyDataForStockTransferSaving} " + err.message, GlobalPref.getResourceValue("Exception"));
            arrBodyData = [];
        }

        return (arrBodyData);
    },

    prepareBodyDataForProductionProcessSaving: function(arrBodyData) {
        let sId = "";
        let iRow = 0;
        let dQuantity = 0;
        let objBodyData = null;

        try {
            for (iRow = 0; iRow < arrBodyData.length; iRow++) {
                objBodyData = arrBodyData[iRow];

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_RCTISSUESELECTION);
                if (DataType.isValidObject(objBodyData[sId]) == false) {
                    continue;
                }

                if (DataType.toInt(objBodyData[sId]) == 0) { // Issue
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_QUANTITY_IN_BASE);
                    if (DataType.isValidObject(objBodyData[sId]) == true) {
                        dQuantity = DataType.toDecimal(objBodyData[sId]);
                        dQuantity *= -1;
                        objBodyData[sId] = dQuantity;
                    }

                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYALTQUANTITY);
                    if (DataType.isValidObject(objBodyData[sId]) == true) {
                        dQuantity = DataType.toDecimal(objBodyData[sId]);
                        dQuantity *= -1;
                        objBodyData[sId] = dQuantity;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.prepareBodyDataForProductionProcessSaving} " + err.message, GlobalPref.getResourceValue("Exception"));
            arrBodyData = [];
        }

        return(arrBodyData);
    },

