    editScreen_FieldsCustomization_RoundOff: function (bLoad) {

        try {
            var iNoOfDecimals = DocScreenField_Customization.NoOfDecimals;
            var RoundOffTo = document.getElementById("editScreen_FieldsCustomization_RoundOffTo");
            if (iNoOfDecimals > 0) {
                var iRoundOff = "0.";
                for (var i = 0; i < iNoOfDecimals - 1; i++) {
                    iRoundOff += "0";
                }
                iRoundOff += "1";
                if (!bLoad)
                    RoundOffTo.value = iRoundOff;
                else {
                    RoundOffTo.value = RoundOffTo.value.substring(0, iNoOfDecimals + 2);
                    if (RoundOffTo.value.trim() != iRoundOff) {
                        if (confirm("Based on number of decimals specified, the Round-off should be \n" + iRoundOff + ", do you want to change it?")) {
                            RoundOffTo.value = iRoundOff;
                        }
                    }
                }
            }
            else
                RoundOffTo = iNoOfDecimals;
        }
        catch (e) {
            COMMON.prototype.showMessage(e.message, "EXCEPTION");
        }
    },
