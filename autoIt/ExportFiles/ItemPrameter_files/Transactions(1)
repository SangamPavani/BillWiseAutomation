    onOk_Click: function () {
        let sCallback = "";
        let iCounter = 0;
        let iRow = 0;
        let iIndex = 0;
        let iLoop = 0;
        let iHeaderId = 0;
        let iBodyId = 0;
        let bClubSameItem = false;
        let eleBody = null;
        let eleTr = null;
        let arrSelectedRowId = undefined;
        let arrBodyData = undefined;
        let objFieldPos = undefined;
        let objParam = undefined;
        let objRow = null;
        let obj = null;

        try {
            if (DataType.arrayLength(CopyDocUI.m_arrBodyData) > 0) {
                sCallback = FUIElement.getAttribute("id_transaction_copydocpopup", "callback");
                if (DataType.isNullOrEmpty(sCallback) == false) {
                    arrBodyData = [];
                    arrSelectedRowId = [];

                    eleBody = CopyDocUI.getSecondGrid().children[1];
                    for (iRow = 0; iRow < eleBody.children.length; iRow++) {
                        eleTr = eleBody.children[iRow];
                        if (eleTr.children[1].children[0].checked == false) {
                            continue;
                        }

                        iHeaderId = DataType.toInt(eleTr.getAttribute("data-iheaderid"));
                        iBodyId = DataType.toInt(eleTr.getAttribute("data-bodyid"));

                        for (iCounter = 0; iCounter < arrSelectedRowId.length; iCounter++) {
                            if (arrSelectedRowId[iCounter].HeaderId == iHeaderId) {
                                arrSelectedRowId[iCounter].arrBodyId.push(iBodyId);
                                break;
                            }
                        }

                        if (iCounter >= arrSelectedRowId.length) {
                            obj = {};
                            obj.HeaderId = iHeaderId;
                            obj.arrBodyId = [];
                            obj.arrBodyId.push(iBodyId);

                            arrSelectedRowId.push(obj);
                        }
                    }

                    if (arrSelectedRowId.length == 0) {
                        transEntryGlobal.showAlert("No row is selected.", "Error");
                        return;
                    }

                    bClubSameItem = CopyDocUI.getClubSimilarTransaction().checked;
                    if(bClubSameItem == true) {
                        objFieldPos = CopyDocUI.getFieldDataPosition();
                    }

                    for (iCounter = 0; iCounter < arrSelectedRowId.length; iCounter++) {
                        for (iRow = 0; iRow < CopyDocUI.m_arrBodyData.length; iRow++) {
                            if (CopyDocUI.m_arrBodyData[iRow].ID != arrSelectedRowId[iCounter].HeaderId) {
                                continue;
                            }

                            obj = {};
                            obj.ID = arrSelectedRowId[iCounter].HeaderId;
                            obj.Name = "";
                            obj.Tag = [];
                            obj.ExtraInfo = null;

                            for (iIndex = 0; iIndex < arrSelectedRowId[iCounter].arrBodyId.length; iIndex++) {
                                for (iLoop = 0; iLoop < CopyDocUI.m_arrBodyData[iRow].Tag.length; iLoop++) {
                                    if (CopyDocUI.m_arrBodyData[iRow].Tag[iLoop].BodyId != arrSelectedRowId[iCounter].arrBodyId[iIndex]) {
                                        continue;
                                    }

                                    obj.Tag.push(DataType.createDuplicateObject(CopyDocUI.m_arrBodyData[iRow].Tag[iLoop]));

                                    if(bClubSameItem == true && objFieldPos.BodyId >= 0) {
                                        for(iLoop = 0; iLoop < CopyDocUI.m_arrClubRowData.length; iLoop++) {
                                            objRow = CopyDocUI.m_arrClubRowData[iLoop];
                                            if(objRow[objFieldPos.BodyId] != obj.Tag[obj.Tag.length - 1].BodyId) {
                                                continue;
                                            }

                                            if(objFieldPos.Quantity >= 0) {
                                                obj.Tag[obj.Tag.length - 1].Sales.Quantity = objRow[objFieldPos.Quantity];
                                            }

                                            if(objFieldPos.Rate >= 0) {
                                                obj.Tag[obj.Tag.length - 1].Sales.OrigRate = objRow[objFieldPos.Rate];
                                                obj.Tag[obj.Tag.length - 1].Sales.Rate = objRow[objFieldPos.Rate];
                                            }

                                            if(objFieldPos.Gross >= 0) {
                                                obj.Tag[obj.Tag.length - 1].Sales.OrigGross = objRow[objFieldPos.Gross];
                                                obj.Tag[obj.Tag.length - 1].Sales.Gross = objRow[objFieldPos.Gross];
                                            }

                                            break;
                                        }
                                    }

                                    break;
                                }
                            }

                            arrBodyData.push(obj);
                            break;
                        }
                    }

                    objParam = {};
                    objParam.HeaderData = CopyDocUI.m_arrHeaderData[0];
                    objParam.HeaderExtra = CopyDocUI.m_arrHeaderExtra;
                    objParam.HeaderDocs = CopyDocUI.m_arrHeaderDocs[0];
                    objParam.BodyData = arrBodyData;

                    //eval(sCallback)(true, { HeaderData: CopyDocUI.m_arrHeaderData[0], HeaderExtra: CopyDocUI.m_arrHeaderExtra[0], BodyData: CopyDocUI.m_arrBodyData });
                    //eval(sCallback)(true, { HeaderData: CopyDocUI.m_arrHeaderData[0], HeaderExtra: CopyDocUI.m_arrHeaderExtra, BodyData: CopyDocUI.m_arrBodyData });
                    eval(sCallback)(true, objParam);
                }

                CopyDocUI.onClose_click();
            }
            else {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("SelectVoucherNo").value, GlobalPref.getResourceValue("Error"));
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.onOk_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
