    this.onLeaveIncremental = function (cellobj, evt) {
        var iType = 0;
        var iFieldValue = 0;
        var iStartCharPos = 0;
        var iNoOfChars = 0;
        var ele = null;
        var cell = null;

        try {
            if (cellobj.iColumn > 1) {
                iType = DocLayoutField_Customization.getIncrementalRowTypeValue(cellobj.iRow);
                if (iType == "") {
                    cellobj.clear();

                    return(true);
                }
            }

            if (cellobj.iColumn == 1) { // Type
                ele = DocLayoutField_Customization.getIncrementalGridColumnElement(cellobj.iColumn);
                if (FCommon.UI.isValidObject(ele) == false) {
                    return;
                }

                if (ele.selectedIndex == -1) {
                    cellobj.clear();
                }
                else {
                    cellobj.setCellText(ele.selectedOptions[0].text, ele.selectedOptions[0].value);
