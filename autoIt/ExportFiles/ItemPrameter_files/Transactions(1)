        let iTotalRows = 0;
        let iSequence = 0;
        let arrData = [];
        let rowData = null;
        let cell = null;
        let obj = null;
        let ele = null;
        let eleGrid = null;

        try {
            //debugger
            arrData = [];

            ele = document.getElementById("DocumentNumbering");
            if (DataType.isValidObject(ele) == false || ele.innerHTML.trim() == "") {
                return (arrData);
            }

            eleGrid = document.getElementById("docNum_Table");

            FGRIDCONTROL.update(eleGrid, null);
            iTotalRows = FGRIDCONTROL.getTotalRows(eleGrid);
            for (iCounter = 0, iSequence = 0; iCounter < iTotalRows; iCounter++) {
                rowData = FGRIDCONTROL.getRowValue(eleGrid, iCounter + 1);
                if (rowData[0].Value == "") {
                    continue;
                }

                iSequence++;

                obj = {};

                cell = FGRIDCONTROL.getCellObject(eleGrid, iCounter + 1, 1);
                element = CONFIGURETRANS.ElementBasedOnGriValue(parseInt(cell.getCellData()), "docNum_FieldORValueDropDown");
                if (element.nodeName.toLowerCase() == "select") {
                    obj.FieldValue = rowData[1].Value;
                }
                else {
                    obj.FieldValue = rowData[1].Text;
                }

                obj.NumberOfChars = rowData[3].Text;
                obj.StartPosition = rowData[2].Text;
                obj.Type = rowData[0].Value;
                obj.VoucherType = selectedVoucherType.id;
                obj.Sequence = iSequence;

                arrData.push(obj);
            }
        }
        catch (err) {
            arrData = [];
            COMMON.prototype.showMessage("{DocCustomization_Numbering.getData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    }

    this.validateData = function (arrData) {
        let iCounter = 0;
        let arrOldData = null;
        let arrError = null;

        try {
            //debugger
            arrError = [];
            arrOldData = DocCustomization_Numbering.VoucherSeries;
            if (DataType.arrayLength(arrOldData) <= 0) {
                return (arrError);
            }

            if (DocCustomization_Numbering.VoucherCount <= 0) {
                return (arrError);
            }

            if (DataType.arrayLength(arrOldData) != DataType.arrayLength(arrData)) {
                arrError.push("Doc series old rows count =(" + DataType.arrayLength(arrOldData) + ") does not match with new rows count =(" + DataType.arrayLength(arrData) + ").");

                return (arrError);
            }

            for (iCounter = 0; iCounter < DataType.arrayLength(arrOldData); iCounter++) {
                if (DataType.toString(arrOldData[iCounter].FieldValue) != DataType.toString(arrData[iCounter].FieldValue)) {
                    arrError.push("Old fieldvalue of row " + (iCounter + 1) + "does not match with new one.");
                }
                else if (DataType.toString(arrOldData[iCounter].NumberOfChars) != DataType.toString(arrData[iCounter].NumberOfChars)) {
                    arrError.push("Old number of chars of row " + (iCounter + 1) + "does not match with new one.");
                }
                else if (DataType.toString(arrOldData[iCounter].StartPosition) != DataType.toString(arrData[iCounter].StartPosition)) {
                    arrError.push("Old start position of row " + (iCounter + 1) + "does not match with new one.");
                }
                else if (DataType.toString(arrOldData[iCounter].Type) != DataType.toString(arrData[iCounter].Type)) {
                    arrError.push("Old type of row " + (iCounter + 1) + "does not match with new one.");
                }

                //else if (DataType.toString(arrOldData[iCounter].VoucherType) != DataType.toString(arrData[iCounter].VoucherType)) {
                //    arrError.push("Old voucher type of row " + (iCounter + 1) + "does not match with new one.");
                //}
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{DocCustomization_Numbering.validateData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrError);
    }
};

