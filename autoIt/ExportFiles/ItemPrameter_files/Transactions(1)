    transferFractionValue: function (bToPopup, cell, objMetaData) {
        let sText = "";
        let ctrlId = "";
        let value = 0;

        try {
            ctrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

            if (bToPopup == true) {
                value = FConvert.toString(cell.getCellData());
                document.getElementById(ctrlId).value = value;
            }
            else {
                value = document.getElementById(ctrlId).value;
                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                    value = EntryMain.formatFractionNumber(objMetaData.iFieldId, value, objMetaData.iNoDecimal, cell.iRow);
                    cell.setCellText(FConvert.addNumericSeparator(value, transEntryCurrency.getNumericSeparator(cell.iRow)), value);
                }
                else {
                    switch (objMetaData.iFieldId) {
                        case eVTFIELDID.FDF_BODYAMOUNT:
                            transEntryFields.setAmount(value, cell.iRow);
                            break;
                        case eVTFIELDID.FDF_BODYJRNDEBIT:
                            transEntryFields.setDebit(value, cell.iRow);
                            break;
                        case eVTFIELDID.FDF_BODYJRNCREDIT:
                            transEntryFields.setCredit(value, cell.iRow);
                            break;
                        case eVTFIELDID.FDF_BODYRATE:
                            if (transEntryInfo.Settings.Inventory.DoNotRoundOffRate == true) {
                                sText = FConvert.toString(value);
                            }
                            else {
                                sText = FNumberOperation.toFixed(value, transEntrySettings.getDecimalsInAmount(cell.iRow));
                            }
                            cell.setCellText(FConvert.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), value);
                            break;
                        case eVTFIELDID.FDF_BODYQUANTITY:
                            sText = FNumberOperation.toFixed(value, transEntryQuantity.getDecimals(cell.iRow));
                            cell.setCellText(FConvert.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), value);
                            break;
                        default:
                            sText = EntryMain.formatFractionNumber(objMetaData.iFieldId, value, objMetaData.iNoDecimal, cell.iRow);
                            cell.setCellText(FConvert.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), value);
                            break;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryDetailPopup.transferFractionValue} " + err.message);
        }
    },

