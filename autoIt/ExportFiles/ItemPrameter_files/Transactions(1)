    filterModulesOnEvent: function (arrExternalModules, iOnEvent) {
        let iCounter = 0;
        let arrData = [];

        try {
            if (DataType.arrayLength(arrExternalModules) < 1) {
                return (arrData);
            }

            for (iCounter = 0; iCounter < arrExternalModules.length; iCounter++) {
                if (arrExternalModules[iCounter].OnEvent != iOnEvent) {
                    continue;
                }

                if (arrExternalModules[iCounter].ModuleType != 3 && arrExternalModules[iCounter].ModuleType != 4) { // Not 3(URL), 4(Forms)
                    continue;
                }

                arrData.push(arrExternalModules[iCounter]);
            }

            //arrData = DataType.arrayFilterData(arrExternalModules, ["OnEvent", "ModuleType"], [iOnEvent, eExternalModuleType.URL], "==");
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryExternalModule.filterModulesOnEvent} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

    filterUnique: function (arrExternalModules) {
        let iCounter = 0;
        let iIndex = 0;
        let objModule1 = null;
        let objModule2 = null;
        let arrData = null;

        try {
            if (DataType.arrayLength(arrExternalModules) < 2) {
                return (arrExternalModules);
            }

            arrData = DataType.createDuplicateObject(arrExternalModules);
            for (iIndex = 0; iIndex < arrData.length; iIndex++) {
                objModule1 = arrData[iIndex];
                for (iCounter = iIndex + 1; iCounter < arrData.length; iCounter++) {
                    objModule2 = arrData[iCounter];
                    if (objModule1.OnEvent != objModule2.OnEvent) {
                        continue;
                    }

                    if (objModule1.ModuleName != objModule2.ModuleName) {
                        continue;
                    }

                    if (objModule1.ClassName != objModule2.ClassName) {
                        continue;
                    }

                    if (objModule1.FunctionName != objModule2.FunctionName) {
                        continue;
                    }

                    arrData.splice(iCounter, 1);
                    iCounter--;
                }

                for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                    arrData[iCounter].CallingOrder = (iCounter + 1);
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{transEntryExternalModule.filterUnique} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

