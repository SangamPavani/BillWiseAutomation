    getHeaderData: function (bCheckForMandatory) {
        let element = null;
        let sId = "";
        let dExchangeRate = 0;
        let iCounter = 0;
        let objMetaData = null;
        let value = null;
        let data = null;
        let obj = null;
        let result = null;
        let objResult = null;

        try {
            objResult = COMMON.prototype.getEmptyResultObject();
            objResult.lValue = 1;
            objResult.sValue = "";
            objResult.arrErrorMetaDataIndex = [];
            objResult.arrError = [];
            data = {};

            data.Flags = transEntryInfo.HeaderFlags;
            if (DataType.isValidObject(data.Flags) == false) {
                data.Flags = transactionDataStructure.getVoucherFlagsObject();

                data.Flags.Editing = EntryMain.isEditMode();
                data.Flags.UpdateFA = transEntryInfo.Settings.Misc.UpdateFA;
                data.Flags.UpdateInv = transEntryInfo.Settings.Misc.UpdateInventory;
            }

            if (transEntryInfo.isStockRevaluation == true) {
                data.Flags.UpdateFA = true;
                data.Flags.UpdateInv = true;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if (EntryMainMaster.isInfoField(objMetaData.iFieldId, true) == true) {
                    continue;
                }

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        value = document.getElementById(sId).value;

                        if(objMetaData.iFieldId == eVTFIELDID.FDF_DOCUMENTNO && data.Flags.Editing == false) {
                            value = value.trim();
                        }

                        if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(value, true) == true) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result = COMMON.prototype.getEmptyResultObject();
                            result.lValue = 0;
                            result.sValue = "'" + objMetaData.sFieldName + "' field value cannot be empty.";
                            result.data = sId;

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        if (DataType.isNullOrEmpty(value) == false && objMetaData.iMaxSize > 0 && value.length > objMetaData.iMaxSize) {
                            value = DataType.stringLeft(value, objMetaData.iMaxSize);
                        }

                        data[sId] = value;
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                    case eMasterDataType.Fraction:
                        element = document.getElementById(sId);
                        value = DataType.toDecimal(element.value);
                        result = EntryMainValidate.validateNumber(objMetaData, value, 0);
                        if (result.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.data = sId;

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        data[sId] = value; // element.value;
                        break;
                    case eMasterDataType.Boolean:
                        value = document.getElementById(sId).checked;
                        switch (objMetaData.iFieldId) {
                            case eVTFIELDID.FDF_UPDATESTOCKS:
                                data.Flags.UpdateInv = value;
                                break;
                            case eVTFIELDID.FDF_UPDATEFA:
                                data.Flags.UpdateFA = value;
                                break;
                            case eVTFIELDID.FDF_RAISECASHCONTRA:
                                data.Flags.PostCashEntry = value;
                                break;
                            default:
                                data[sId] = value;
                                break;
                        }
                        data[sId] = value;
                        break;
                    case eMasterDataType.Date:
                        value = DATEPICKER.getDate(sId);
                        result = EntryMainValidate.validateDate(objMetaData, value, 0, objMetaData.sCaption);
                        if (result.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.data = sId;

                            if (objMetaData.iFieldId == eVTFIELDID.FDF_DUEDATE) {
                                result.arrErrorMetaDataIndex = [];
                                result.arrError = [];

                                result.arrErrorMetaDataIndex.push(iCounter);
                                result.arrError.push(result);

                                return (result);
                            }

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        data[sId] = value;
                        break;
                    case eMasterDataType.Time:
                        value = FTIMECONTROL.getTime(sId);
                        data[sId] = value;
                        break;
                    case eMasterDataType.StringList:
                        element = document.getElementById(sId);
                        if (element.selectedIndex > -1) {
                            data[sId] = element.options[element.selectedIndex].text;
                        }
                        else {
                            data[sId] = "";
                        }
                        break;
                    case eMasterDataType.NumberList:
                        element = document.getElementById(sId);
                        if (element.selectedIndex > -1) {
                            data[sId] = element.options[element.selectedIndex].value;
                        }
                        else {
                            data[sId] = 0;
                        }
                        break;
                    case eMasterDataType.Picture:
                    case eMasterDataType.DocumentViewer:
                        result = FATTACHMENTCONTROL.getData(sId);
                        if (result.lValue > 0) {
                            data[sId] = DataType.toString({ iFieldId: objMetaData.iFieldId, sFileName: result.data.sFileName, sData: result.data.sData, iDataSource: result.data.iDataSource });
                        }
                        else {
                            data[sId] = "";
                        }
                        break;
                    case eMasterDataType.Master:
                        if(objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH) {
                            value = FNumberOperation.convert(OPTIONCONTROL.getControlValue(sId));
                        }
                        else {
                            value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        }

                        data[sId] = value;

                        result = EntryMainValidate.validateHeaderMaster(objMetaData, value);
                        if (result.lValue < 1) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result.data = sId;

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        break;
                    case eMasterDataType.ExternalTable:
                        value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if (objMetaData.bMandatory == true && value == 0) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result = COMMON.prototype.getEmptyResultObject();
                            result.lValue = 0;
                            result.sValue = "'" + objMetaData.sFieldName + "' field value cannot be empty.";
                            result.data = sId;

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        data[sId] = value;
                        break;
                    case eMasterDataType.HyperLink:
                        value = FHyperLink.getValue(sId);

                        if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(value, true) == true) {
                            if (bCheckForMandatory == false) {
                                break;
                            }

                            result = COMMON.prototype.getEmptyResultObject();
                            result.lValue = 0;
                            result.sValue = "'" + objMetaData.sFieldName + "' field value cannot be empty.";
                            result.data = sId;

                            objResult.arrErrorMetaDataIndex.push(iCounter);
                            objResult.arrError.push(result);
                            break;
                        }

                        data[sId] = value;
                    break;
                }
            }

            if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                if (DataType.toInt(data[sId]) < 1) {
                    data[sId] = transEntryInfo.DefaultCurrencyId;
                    data[EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE)] = 1.0000000000;
                }
                else {
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE);
                    dExchangeRate = DataType.toDecimal(data[sId]);
                    if (dExchangeRate == 0) {
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                        obj = OPTIONCONTROL.getControlData(sId);
                        obj = OPTIONCONTROL.convertRawDataIntoObject(sId, obj);

                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE);
                        data[sId] = obj.fExchangeRate;
                    }
                }
            }
            else if (transEntryFieldInfo.Currency.ColumnIndex <= 0) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                data[sId] = transEntryInfo.DefaultCurrencyId;
                data[EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE)] = 1.0000000000;
            }

            if (transEntryInfo.isStockAdjustment == true) {
                data.Flags.UpdateFA = true;
            }

            objResult.data = data;
            if (objResult.arrError.length > 0) {
                objResult.lValue = 0;
            }
            else {
                objResult.lValue = 1;

                if (transEntryFields.getHeaderNet() != 0) {
                    data["Net"] = transEntryFields.getHeaderNet();
                }
            }
        }
        catch (err) {
            objResult.lValue = -1;
            objResult.sValue = "{EntryMainUI.getHeaderData} " + err.message;
        }

        return (objResult);
    },

    getBodyData: function (bIgnoreAmoutValidation, bCheckForMandatory) {
        let iTotalRows = 0;
        let iRowCounter = 0;
        let iMaskedVoucherType = 0;
        let arrFields = undefined;
        let objHeaderInvTagValue = undefined;
        let objValidateResult = undefined;
        let result = undefined;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = [];

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (transEntryInfo.BodySectionNotRequired == true) {
                if(bCheckForMandatory == true) {
                    if (TRANSACTION_ENTRY.OTHERCHARGES.getAmountValue(1) > 0 && TRANSACTION_ENTRY.OTHERCHARGES.getAccountValue(1) == 0) {
                        result.lValue = 0;
                        result.sValue = "Account1 is mandatory if Amount1 value is given.";
                        result.data = [];

                        return(result);
                    }

                    if (TRANSACTION_ENTRY.OTHERCHARGES.getAmountValue(1) == 0 && TRANSACTION_ENTRY.OTHERCHARGES.getAccountValue(1) > 0) {
                        result.lValue = 0;
                        result.sValue = "Amount1 value is mandatory if Account1 is selected.";
                        result.data = [];

                        return(result);
                    }

                    if (TRANSACTION_ENTRY.OTHERCHARGES.getAmountValue(2) > 0 && TRANSACTION_ENTRY.OTHERCHARGES.getAccountValue(2) == 0) {
                        result.lValue = 0;
                        result.sValue = "Account2 is mandatory if Amount2 value is given.";
                        result.data = [];

                        return(result);
                    }

                    if (TRANSACTION_ENTRY.OTHERCHARGES.getAmountValue(2) == 0 && TRANSACTION_ENTRY.OTHERCHARGES.getAccountValue(2) > 0) {
                        result.lValue = 0;
                        result.sValue = "Amount2 value is mandatory if Account2 is selected.";
                        result.data = [];

                        return(result);
                    }
                }

                bIgnoreAmoutValidation = DataType.toBoolean(bIgnoreAmoutValidation);
                objValidateResult = TRANSACTION_ENTRY.DATA.getBodyDataForBillReferences(1, bIgnoreAmoutValidation);
                if (objValidateResult.lValue < 1) {
                    return (objValidateResult);
                }

                if (objValidateResult.lValue == 1 && DataType.isValidObject(objValidateResult.data) == true) {
                    objValidateResult.data.objTempValues = {};
                    objValidateResult.data.objTempValues.iRow = 1;

                    result.data.push(objValidateResult.data);
                }
            }
            else {
                arrFields = transEntryFieldInfo.getBodyFields();
                objHeaderInvTagValue = transEntryInvTag.getHeaderInvTagValue();

                iTotalRows = transEntryGrid.getTotalRows();
                for (iRowCounter = 1; iRowCounter <= iTotalRows; iRowCounter++) {
                    if (EntryMainBody.isRowEditable(iRowCounter) == false) {
                        break;
                    }

                    objValidateResult = EntryMainUI.getBodyRowData(iRowCounter, iMaskedVoucherType, objHeaderInvTagValue, bCheckForMandatory, arrFields);
                    if (objValidateResult.lValue < 1) {
                        return (objValidateResult);
                    }

                    if (objValidateResult.lValue == 1 && DataType.isValidObject(objValidateResult.data) == false) {
                        break;
                    }

                    result.data.push(objValidateResult.data);
                }

                for (iRowCounter++; iRowCounter <= iTotalRows; iRowCounter++) {
                    if (EntryMainBody.isRowEditable(iRowCounter) == false) {
                        continue;
                    }

                    objValidateResult = EntryMainUI.getBodyRowData(iRowCounter, iMaskedVoucherType, objHeaderInvTagValue, bCheckForMandatory, arrFields);
                    if (objValidateResult.lValue == 1 && DataType.isValidObject(objValidateResult.data) == true) {
                        result.lValue = 0;
                        result.sValue = GlobalPref.getResourceValue("msgProvideMandatoryData");
                        result.data = [];

                        transEntryGrid.markRow(iRowCounter - 1);

                        return (result);
                    }
                }
            }

            if (result.data.length > 0) {
                if (transEntryInfo.isItTransfer == true) {
                    result.data = EntryMainUI.prepareBodyDataForStockTransferSaving(result.data);
                }
                else if (transEntryFieldInfo.RctIssue.ColumnIndex > -1
                    && iMaskedVoucherType == eVTTYPE.WDONE) { // Production process type

                    result.data = EntryMainUI.prepareBodyDataForProductionProcessSaving(result.data);
                }
            }
            result.lValue = result.data.length;

            if (result.lValue == 0 && bCheckForMandatory == true) {
                if (transEntryInfo.BodySectionNotRequired == true) {
                    result.sValue = GlobalPref.getResourceValue("msgProvideMandatoryData") + EntryMainUI.getHeaderControlLabelText(EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYCODE));
                }
                else {
                    result.sValue = GlobalPref.getResourceValue("AtleastOneRow");
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{EntryMainUI.getBodyData} " + err.message;
        }

        return (result);
    },

    getFooterData: function (bCheckForMandatory) {
        let sMainId = "";
        let sId = "";
        let iCounter = 0;
        let iInputIndex = 0;
        let InputValue = "";
        let objMetaData = null;
        let data = null;
        let result = null;
        let validate = null;
        let objFooter = null;
        let arrFooterFields = undefined;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 1;
            result.sValue = "";
            data = {};

            bCheckForMandatory = DataType.toBoolean(bCheckForMandatory);

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            if (DataType.isValidObject(arrFooterFields) == false) {
                return (result);
            }

            for (iCounter = 0; iCounter < arrFooterFields.length;) {
                objMetaData = arrFooterFields[iCounter];

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Fraction:
                        sMainId = EntryMainUI.getFooterControlId(objMetaData.iFieldId);

                        InputValue = DataType.getNumber(document.getElementById(sMainId).value);
                        if (objMetaData.bMandatory == false || InputValue != "") {
                            InputValue = DataType.toDecimal(InputValue);
                        }

                        iInputIndex = iCounter;

                        objFooter = transactionDataStructure.getEmptyFooterDataObject();
                        objFooter.ColMap = objMetaData.iColMap;
                        objFooter.FieldId = objMetaData.iFieldId;
                        objFooter.FieldName = objMetaData.sFieldName;
                        objFooter.Input = InputValue;
                        objFooter.Value = DataType.toDecimal(document.getElementById(sMainId + "_output").value);

                        validate = EntryMainValidate.checkMinMaxRange(DataType.toDecimal(objFooter.Input), DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                        if (validate.bInvalid == true) {
                            result.lValue = 0;
                            result.sValue = objMetaData.sFieldName + validate.sMessage + validate.dValue;
                            result.data = null;

                            return (result);
                        }

                        if (arrFooterFields[iInputIndex].bPostToAccount == true) {
                            if (arrFooterFields[iInputIndex].bAllowDebitAccount == true) {
                                iCounter++;
                                if (iCounter < arrFooterFields.length) {
                                    objMetaData = arrFooterFields[iCounter];
                                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId);
                                    objFooter.Account1 = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                                }
                            }

                            if (arrFooterFields[iInputIndex].bAllowCreditAccount == true) {
                                iCounter++;
                                if (iCounter < arrFooterFields.length) {
                                    objMetaData = arrFooterFields[iCounter];
                                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId);
                                    objFooter.Account2 = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                                }
                            }
                        }

                        data[sMainId] = DataType.toString(objFooter);
                        break;
                }

                iCounter++;
            }
            result.lValue = 1;
            result.data = data;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{EntryMainUI.getFooterData} " + err.message;
        }

        return (result);
    },

