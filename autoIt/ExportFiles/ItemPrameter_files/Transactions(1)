        let obj = null;
        let arrData = null;
        let result = null;
        let value = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = [];

            arrData = transEntryWorkflowInfo.HiddenData;
            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                if (arrData[iCounter].bSelected == false && arrData[iCounter].bRetain == false) {
                    continue;
                }

                value = FNumberOperation.sub(arrData[iCounter].dPendingValue, arrData[iCounter].dUsedValue);
                if(FNumberOperation.isGreaterThan(value, 0) == false) {
                    continue;
                }

                obj = {};
                obj.iRow = iCounter + 1;
                obj.RefId = arrData[iCounter].lRefIds;
                obj.VoucherNo = arrData[iCounter].sVoucherNo;
                obj.VoucherType = DataType.toInt(FUIElement.getAttribute(eleWorkflowGrid, "reportid"));
                obj.LinkValue = value; //arrData[iCounter].dPendingValue;
                obj.LinkId = iLinkId;

                result.data.push(obj);
            }

            result.lValue = result.data.length;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
