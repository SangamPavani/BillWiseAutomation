    updateFromOtherRowsData: function (arrBinDetails, objBinsParam) {
        let iRow = 0;
        let iIndex = 0;
        let iCounter = 0;
        let arrPrevBins = undefined;

        try {
            if (DataType.arrayLength(objBinsParam.OldAllocations) < 1) {
                return (arrBinDetails);
            }

            for (iCounter = 0; iCounter < arrBinDetails.length; iCounter++) {
                //UPDATE PREVIOUS ROW QTY/LOAD/FREESPACE
                for (iRow = 0; iRow < objBinsParam.OldAllocations.length; iRow++) {
                    if (objBinsParam.OldAllocations[iRow] == null) {
                        continue;
                    }

                    arrPrevBins = objBinsParam.OldAllocations[iRow];
                    for (iIndex = 0; iIndex < arrPrevBins.length; iIndex++) {
                        if (DataType.isValidObject(arrPrevBins[iIndex]) == false) {
                            continue;
                        }

                        if (arrBinDetails[iCounter].Id != arrPrevBins[iIndex].BinId) {
                            continue;
                        }

                        if (arrBinDetails[iCounter].SkidId > 0 && arrBinDetails[iCounter].SkidId != arrPrevBins[iIndex].SkidId) {
                            continue;
                        }

                        arrBinDetails[iCounter].Carton = DataType.toString(arrBinDetails[iCounter].Carton);
                        arrPrevBins[iIndex].Carton = DataType.toString(arrPrevBins[iIndex].Carton);
                        if (BinsUI.m_bCartonCheck == true) {
                            if (arrBinDetails[iCounter].Carton != arrPrevBins[iIndex].Carton) {
                                continue;
                            }
                        }

                        //SET PRODUCT ID
                        if (arrBinDetails[iCounter].Products == null ||
                            arrBinDetails[iCounter].Products.length == 0) {

                            arrBinDetails[iCounter].Products = [];
                            arrBinDetails[iCounter].Products.push(1);
                            if (arrPrevBins[iIndex].Item > 0) {
                                arrBinDetails[iCounter].Products[0] = arrPrevBins[iIndex].Item;
                            }
                        }

                        //SET DEFUALT BIN
                        if (objBinsParam.DefaultBinId != null
                            && objBinsParam.DefaultBinId.length > 0
                            && objBinsParam.DefaultBinId[0] > 0
                            && arrBinDetails[iCounter].Id == objBinsParam.DefaultBinId[0]) {

                            BinsUI.m_arrDefaultBinsRow.push(iIndex);
                        }

                        //UPDATE PREVIOUS ROW QTY FOR CURRENT ITEM
                        if (arrBinDetails[iCounter].Products != null
                            && arrBinDetails[iCounter].Products.length > 0
                            && arrPrevBins[iIndex].Item == objBinsParam.ProductId
                            && arrBinDetails[iCounter].BatchId == arrPrevBins[iIndex].BatchId) {
                            ///////////////////
                            if (objBinsParam.InwardBin == false) {
                                arrBinDetails[iCounter].Stock -= Math.abs(arrPrevBins[iIndex].Quantity);
                                arrBinDetails[iCounter].Quantity -= Math.abs(arrPrevBins[iIndex].Quantity);
                            }

                            dValue = FNumberOperation.mul(arrPrevBins[0].ItemCapacity, arrPrevBins[0].Quantity);
                            arrBinDetails[iCounter].TransQuantity = FNumberOperation.sub(arrBinDetails[iCounter].TransQuantity, dValue);

                            if (arrBinDetails[iCounter].BatchId == arrPrevBins[iIndex].BatchId) {
                                arrBinDetails[iCounter].Batch = arrPrevBins[iIndex].Batch;
                            }
                        }

                        /////////////////
                        if (objBinsParam.InwardBin == true && BinsUI.m_bDontCheckCapacity != true) {
                            if (arrPrevBins[iIndex].BodyId == 0) {
                                arrBinDetails[iCounter].Load = DataType.add(arrBinDetails[iCounter].Load, DataType.mul(arrPrevBins[iIndex].Quantity, BinsUI.m_iProdCapacity));
                            }
                        }

                        if (arrBinDetails[iCounter].Load < 0) {
                            arrBinDetails[iCounter].Load = 0;
                        }

                        if (objBinsParam.InwardBin == false || (objBinsParam.InwardBin == true && BinsUI.m_bDontCheckCapacity != true)) {
                            arrBinDetails[iCounter].FreeSpace = DataType.sub(arrBinDetails[iCounter].Capacity, arrBinDetails[iCounter].Load);
                            arrBinDetails[iCounter].FreeQuantity = DataType.div(DataType.sub(arrBinDetails[iCounter].Capacity, arrBinDetails[iCounter].Load), BinsUI.m_iProdCapacity);
                        }

                        //CHECK BINS PREFERENE SETTINGS
                        if (objBinsParam.InwardBin &&
                            //SET FOR DIFF BATCH 
                            ((objBinsParam.DiffBatches && BinsUI.m_sBatch && BinsUI.m_sBatch != arrPrevBins[iIndex].Batch) ||
                                //SET FOR DIFF ITEM 
                            ((objBinsParam.DiffItemSameBin || objBinsParam.DifferentAttribute) && BinsUI.m_objBinsData.BinDetails[iCounter].Products != null &&
                            arrBinDetails[iCounter].Products.length > 0 && arrPrevBins[iIndex].Item != objBinsParam.ProductId)
                            )) {
                            arrBinDetails[iCounter].FreeSpace = 0;
                        }
                    }
                }
            }

            arrBinDetails = BinsUI.removeZeroStockBin(arrBinDetails, [], objBinsParam.Inward);
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.updateFromOtherRowsData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrBinDetails);
    },

    updateBinData: function () {
        let iCounter = 0;
        let iIndex = 0;
        let iRow = 0;
        let iTotalRows = 0;
        let dCurrentLoad = 0;
        let dCurrentBalance = 0;
        let dValue = 0;
        let arrPrevBins = [];
        let lstBindetails = [];
        let arrCurrentBinId = [];        
        let objBinColumn = {};
        let result = null;

        try {
            if (transEntryGrid && DataType.isValidObject(BinsUI.m_InputCustomData) == true) {
                objBinColumn = transEntryGrid.getCellObject(BinsUI.m_InputCustomData.iRow, BinsUI.m_InputCustomData.iColumn);
                result = DataType.stringToObject(objBinColumn.getCellData());

                if (DataType.isValidObject(BinsUI.m_arrCurrentRowBins) == true && result.lValue > 0) {
                    for (iCounter = 0; iCounter < BinsUI.m_arrCurrentRowBins.length; iCounter++) {
                        dCurrentBalance = FNumberOperation.add(dCurrentBalance, BinsUI.m_arrCurrentRowBins[iCounter].Quantity, true);
                    }
                }
            }


            for (iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                dCurrentLoad = BinsUI.m_objBinsData.BinDetails[iCounter].Load;

                //Update current row qty/batch
                iTotalRows = DataType.arrayLength(BinsUI.m_arrCurrentRowBins);                
                for (iRow = 0; iRow < iTotalRows; iRow++) {
                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Id != BinsUI.m_arrCurrentRowBins[iRow].BinId) {
                        continue;
                    }

                    if(BinsUI.m_bCartonCheck == true) {
                        if (BinsUI.m_objBinsData.BinDetails[iCounter].Carton != BinsUI.m_arrCurrentRowBins[iRow].Carton) {
                            continue;
                        }
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].SkidId > 0 
                        && BinsUI.m_objBinsData.BinDetails[iCounter].SkidId != BinsUI.m_arrCurrentRowBins[iRow].SkidId) {
                        continue;
                    }

                    arrCurrentBinId.push(BinsUI.m_objBinsData.BinDetails[iCounter].Id);

                    //if the current row bins are cleared , update the bins values

                    if (result != null && result.lValue > 0) {
                        //Bins column is not empty , u can simply do nothing here
                    }
                    else {
                        //bins column is empty , update current bin by subtracting the objbincolumn details from it

                        //update load , free space , free quantity and Products array (remove m_arrCurrentRowBins.item from it)
                        dCurrentLoad = BinsUI.m_objBinsData.BinDetails[iCounter].Quantity =
                            BinsUI.m_objBinsData.BinDetails[iCounter].TransQuantity =
                        BinsUI.m_objBinsData.BinDetails[iCounter].Load -= BinsUI.m_arrCurrentRowBins[iRow].Quantity;

                        if (BinsUI.m_objBinsData.BinDetails[iCounter].Products && BinsUI.m_BinsParam.ProductId != BinsUI.m_arrCurrentRowBins[iRow].Item) {
                            //if product changed
                            BinsUI.m_objBinsData.BinDetails[iCounter].Products.splice(BinsUI.m_objBinsData.BinDetails[iCounter].Products.indexOf(BinsUI.m_arrCurrentRowBins[iRow].Item), 1);
                        }
                    }

                    if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_arrCurrentRowBins[iRow].BodyId == 0) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].Quantity = FNumberOperation.sub(BinsUI.m_objBinsData.BinDetails[iCounter].Quantity, BinsUI.m_dOriginalQty);

                        dValue = FNumberOperation.mul(BinsUI.m_dOriginalQty, BinsUI.m_iProdCapacity);
                        BinsUI.m_objBinsData.BinDetails[iCounter].Load = FNumberOperation.sub(BinsUI.m_objBinsData.BinDetails[iCounter].Load, dValue);
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Quantity < 0) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].Quantity = 0;
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Load < 0) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].Load = 0;
                    }

                    if (dCurrentLoad < 0) {
                        dCurrentLoad = 0;
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].TransQuantity < 0) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].TransQuantity = 0;
                    }

                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Load > BinsUI.m_objBinsData.BinDetails[iCounter].Capacity 
                        && BinsUI.m_objBinsData.BinDetails[iCounter].Type == eBinsType.Bin) {
                        //////////////////////
                        BinsUI.m_objBinsData.BinDetails[iCounter].Quantity = BinsUI.m_objBinsData.BinDetails[iCounter].Capacity;
                        BinsUI.m_objBinsData.BinDetails[iCounter].Load = BinsUI.m_objBinsData.BinDetails[iCounter].Capacity;
                    }

                    //SET FREE SPACE/FREE QTY
                    if (BinsUI.m_objBinsData.BinDetails[iCounter].Capacity > 0) {
                        /////////////////////
                        if (BinsUI.m_arrCurrentRowBins[iRow].BodyId > 0 && BinsUI.m_BinsParam.Inward) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace += Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity) * BinsUI.m_iProdCapacity;
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeQuantity += Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity);

                            if (dCurrentBalance == BinsUI.m_dQuantity) {
                                dCurrentLoad = BinsUI.m_objBinsData.BinDetails[iCounter].Load;
                            }
                        }
                        else {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace = BinsUI.m_objBinsData.BinDetails[iCounter].Capacity - BinsUI.m_objBinsData.BinDetails[iCounter].Load;
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeQuantity = (BinsUI.m_objBinsData.BinDetails[iCounter].Capacity - BinsUI.m_objBinsData.BinDetails[iCounter].Load) / BinsUI.m_iProdCapacity;
                        }

                        if (BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace > BinsUI.m_objBinsData.BinDetails[iCounter].Capacity) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace = BinsUI.m_objBinsData.BinDetails[iCounter].Capacity;
                        }

                        if (BinsUI.m_objBinsData.BinDetails[iCounter].FreeQuantity > BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace / BinsUI.m_iProdCapacity) {
                            BinsUI.m_objBinsData.BinDetails[iCounter].FreeQuantity = BinsUI.m_objBinsData.BinDetails[iCounter].FreeSpace / BinsUI.m_iProdCapacity;
                        }
                    }

                    //SET TO BE PICK/ALLOCATE QTY
                    if (result != null && result.lValue > 0) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity);
                    }
                    else {
                        if (DataType.isValidObject(BinsUI.m_InputCustomData) == false && Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity) > 0) { //Add on 14-02-2025, the condition added bcoz in MRP Issue to Production not loading data & getting exception 
                            BinsUI.m_objBinsData.BinDetails[iCounter].ToBeAllocated = Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity);
                            dCurrentBalance = Math.abs(BinsUI.m_arrCurrentRowBins[iRow].Quantity);
