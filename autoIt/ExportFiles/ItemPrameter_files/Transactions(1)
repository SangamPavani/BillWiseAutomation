                    break;
                case eMasterDataType.ExternalTable:
                    result.data = { FieldText: objCell.getCellText(), FieldValue: DataType.toInt(objCell.getCellData()) };
                    break;
            }

            result.lValue = 1;
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.getValueFromGrid}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    setValueToGrid: function (iRow, iColumn, objMetaData, value) {
        let sCtrlId = "";
        let sText = "";
        let iDefaultBaseUnit = 0;
        let iItemId = 0;
        let iCounter = 0;
        let iCurrentRow = 0;
        let iCurrentColumn = 0;
        let objCell = null;
        let eleControl = null;
        let data = null;
        let item = null;
        let objExtra = undefined;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 1;
            result.sValue = "";
            result.data = null;

            iCurrentRow = transEntryGrid.getCurrentRow();
            iCurrentColumn = transEntryGrid.getCurrentColumn();            

            transEntryGrid.update();

            objCell = transEntryGrid.getCellObject(iRow, iColumn);
            if (DataType.isValidObject(objCell) == false) {
                result.lValue = 0;
                result.sValue = "Invalid cell object for row =" + iRow + ", column=" + iColumn;

                transEntryGrid.gotoCell(iCurrentRow, iCurrentColumn - transEntryGrid.gridExtraColumn());

                return (result);
            }

            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.Text:
                    switch (objMetaData.iFieldId) {
                        case eVTFIELDID.FDF_BODYBATCHNO:
                            if (transEntryFields.isRequired(objMetaData.iFieldId, iRow) == false) {
                                result = {};
                                result.lValue = 0;
                                result.sValue = "";
                                result.data = null;

                                objCell.clear();
                                EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow);
                                break;
                            }

                            if (transEntryInfo.isInwardVoucher == true) {
                                objCell.setCellText(value, value);
                            }
                            else {
                                objCell.setCellText(value.BatchNo, value);
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow);
                            break;
                        case eVTFIELDID.FDF_BINS:
                        case eVTFIELDID.FDF_BINS2:
                            result = EntryMainBins.isBinsRequiredForRow(iRow);
                            if (result.data == false) {
                                result.lValue = 0;
                                result.data = null;

                                objCell.clear();
                                EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow);
                                break;
                            }

                            if(DataType.isArray(value) == false) {
                                if(DataType.isString(value) == false && DataType.isObject(value) == true) {
                                    value = [value];
                                }
                            }

                            sText = "";
                            for (iCounter = 0; iCounter < value.length; iCounter++) {
                                if (DataType.isNullOrEmpty(sText, true) == false) {
                                    sText += ",";
                                }

                                sText += value[iCounter].BinName;
                            }

                            objCell.setCellText(sText, DataType.toString(value));
                            EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow);
                            break;
                        case eVTFIELDID.FDF_LINK:
                            if (DataType.isValidObject(value.Value) == true) {
                                objCell.setCellText(value.Value, value.Value);
                            }
                            else if (DataType.isValidObject(value.VoucherNo) == true) {
                                objCell.setCellText(value.VoucherNo, value.VoucherNo);
                            }

                            if (DataType.isValidObject(value.LinkId) == true) {
                                objCell.setCellData("linkid", value.LinkId);
                            }

                            if (DataType.isValidObject(value.RefId) == true) {
                                objCell.setCellData("refid", value.RefId);
                                objCell.setCellData("basetransactionid", value.RefId);
                            }

                            if (DataType.isValidObject(value.VoucherType) == true) {
                                objCell.setCellData("vouchertype", value.VoucherType);
                            }

                            if (DataType.isValidObject(value.VoucherNo) == true) {
                                objCell.setCellData("voucherno", value.VoucherNo);
                            }

                            if (DataType.isValidObject(value.UsedValue) == true) {
                                objCell.setCellData("usedvalue", value.UsedValue);
                            }

                            EntryMainMemoryObject.update(eVTFIELDID.FDF_LINK, value, objCell.iRow);
                            break;
                        case eVTFIELDID.FDF_REFERENCE:
                            value = DataType.toString(value);
                            data = DataType.stringToObject(value);
                            if (data.lValue > 0) {
                                data = data.data;
                                transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, DataType.toString(data[0].arrAdjustedBills));
                                objCell.setCellText(data[0].sReference, data[0].sReference);
                                transEntryGrid.setRowData(objCell.iRow, eRowDataName.BillwiseRequired, false);
                            }
                            break;
                        case eVTFIELDID.FDF_RMANO:
                            transEntryFields.setRMA(value, iRow);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, value, iRow);
                            break;
                        case eVTFIELDID.FDF_RESERVEQUANTITY:
                            if (DataType.isValidObject(value) == true) {
                                transEntryReservation.setText(objCell.iRow, "Reserved", DataType.toString(value));
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow);
                            }
                            else {
                                EntryMainUI.clear(transEntryFieldInfo.Reservation, objCell.iRow);
                            }
                            break;
                        default:
                            objCell.setCellText(value, value);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                            break;
                    }
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    EntryMainBody.updateNumberValue(objCell, value, objMetaData.iFieldId);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    break;
                case eMasterDataType.BigNumber:
                    break;
                case eMasterDataType.Fraction:
                    value = EntryMain.formatFractionNumber(objMetaData.iFieldId, value, objMetaData.iNoDecimal, iRow);
                    objCell.setCellText(value, value);

                    if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                        value = FConvert.roundOff(DataType.toDecimal(value), objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        transEntryScreenData.setCellOutputValue(objCell, value, value);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, value);
                    }
                    else {
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    }
                    //EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    break;
                case eMasterDataType.Boolean:
                    if (objCell.hasControl() == true) {
                        objCell.getControl().checked = DataType.toBoolean(value);
                    }
                    else {
                        EntryMainBody.initBooleanColumn(objCell, DataType.toBoolean(value), objMetaData.bReadOnly);
                    }
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    break;
                case eMasterDataType.Date:
                    EntryMainBody.updateDateValue(objCell, DataType.toInt(value), objMetaData.iFieldId);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    break;
                case eMasterDataType.Time:
                    EntryMainBody.updateTimeValue(objCell, DataType.toInt(value), objMetaData.iFieldId, false);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                    break;
                case eMasterDataType.Picture:
                case eMasterDataType.DocumentViewer:
                    objCell.setCellText(value.sFileName, value.sData);
                    break;
                case eMasterDataType.StringList:
                case eMasterDataType.NumberList:
                    sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    eleControl = document.getElementById(sCtrlId);
                    eleControl.value = value;

                    if (eleControl.selectedIndex == -1) {
                        objCell.clear();
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                    }
                    else {
                        objCell.setCellData(eleControl.options[eleControl.selectedIndex].value);
                        objCell.setCellText(eleControl.options[eleControl.selectedIndex].text);

                        if (objMetaData.iDataTypeId == eMasterDataType.StringList) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.options[eleControl.selectedIndex].text, objCell.iRow, objMetaData);
                        }
                        else {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.options[eleControl.selectedIndex].value, objCell.iRow, objMetaData);
                        }
                    }
                    break;
                case eMasterDataType.Master:
                    sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    value = DataType.toInt(value);

                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                        item = EntryMainUI.getElement(transEntryFieldInfo.Item, iRow).Value;
                        if (DataType.isValidObject(item) == false) {
                            result.lValue = 0;
                            result.sValue = "Unit cannot be set if item column not found."
                            objCell.clear();
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                            break;
                        }

                        iItemId = DataType.toInt(item.getCellData());
                        if (iItemId < 1) {
                            result.lValue = 0;
                            result.sValue = "Unit cannot be set if item value not found for row=" + iRow;
                            objCell.clear();
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                            break;
                        }

                        if (value == 0) {
                            if (transEntryInfo.isInwardVoucher == true) {
                                value = DataType.toInt(item.getCellData("idefaultpurchaseunit"));
                            }
                            else {
                                value = DataType.toInt(item.getCellData("idefaultsalesunit"));
                            }

                            if (value == 0) {
                                value = DataType.toInt(item.getCellData("idefaultbaseunit"));
                            }
                        }

                        iDefaultBaseUnit = DataType.toInt(item.getCellData("idefaultbaseunit"));

                        OPTIONCONTROL.clear(sCtrlId);
                        if (iDefaultBaseUnit == 0) {
                            result.lValue = 0;
                            result.sValue = "Unit cannot be set if default base unit value not found for row=" + iRow;
                            objCell.clear();
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                            break;
                        }

                        OPTIONCONTROL.setUnit(sCtrlId, iDefaultBaseUnit, iItemId);

                        objExtra = OPTIONCONTROL.createSetValueExtraObject();
                        objExtra.bIgnoreChangeCallback = true;
                        OPTIONCONTROL.setValue(sCtrlId, value, null, objExtra);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);

                        data = OPTIONCONTROL.getControlData(sCtrlId);
                    }
                    else {
                        objExtra = OPTIONCONTROL.createSetValueExtraObject();
                        objExtra.bIgnoreChangeCallback = true;
                        OPTIONCONTROL.setValue(sCtrlId, value, null, objExtra);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);
                        data = OPTIONCONTROL.getControlData(sCtrlId);
                    }

                    objCell.setCellData(data);
                    if (DataType.arrayLength(data) >= 2) {
                        objCell.setCellData(DataType.toInt(DataType.getObjectFirstValue(data[0])));
                        objCell.setCellText(DataType.getObjectFirstValue(data[1]));

                        EntryMainMemoryObject.update(objMetaData.iFieldId, DataType.toInt(DataType.getObjectFirstValue(data[0])), objCell.iRow, objMetaData);
                        EntryMainUI.updateMemoryMasterDependentData(objMetaData.iFieldId, objCell, objCell.iRow);
                    }
                    else {
                        objCell.clear();
                        objCell.setCellText("");
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                        EntryMainUI.updateMemoryMasterDependentData(objMetaData.iFieldId, objCell, objCell.iRow);
                    }
                    break;
                case eMasterDataType.ExternalTable:
                    sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    value = DataType.toInt(value);

                    objExtra = OPTIONCONTROL.createSetValueExtraObject();
                    objExtra.bIgnoreChangeCallback = true;
                    OPTIONCONTROL.setValue(sCtrlId, value, null, objExtra);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, objCell.iRow, objMetaData);

                    data = OPTIONCONTROL.getControlData(sCtrlId);
                    objCell.setCellData(data);
                    if (DataType.arrayLength(data) >= 2) {
                        objCell.setCellData(DataType.toInt(DataType.getObjectFirstValue(data[0])));
                        EntryMainMemoryObject.update(objMetaData.iFieldId, DataType.toInt(DataType.getObjectFirstValue(data[0])), objCell.iRow, objMetaData);

                        objCell.setCellText(DataType.getObjectFirstValue(data[1]));
                    }
                    else {
                        objCell.clear();
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, objCell.iRow, objMetaData);
                        objCell.setCellText("");
                    }
                    break;
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
            transEntryGlobal.showAlert("{EntryMainAPI.setValueToGrid}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        transEntryGrid.gotoCell(iCurrentRow, iCurrentColumn - transEntryGrid.gridExtraColumn());

        return (result);
    },

