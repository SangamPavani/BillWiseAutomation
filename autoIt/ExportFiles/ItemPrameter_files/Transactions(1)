    createBodyFormulaInput: function (sFormula, iRowIndex, objCurrentValue, iColumnIndex, sFieldName) {
        let obj = undefined;

        obj = {};
        obj.sFormula = sFormula;
        obj.iRowIndex = iRowIndex;
        obj.objCurrentValue = objCurrentValue;
        obj.iColumnIndex = iColumnIndex;
        obj.sFieldName = sFieldName;
        obj.Output = {};
        obj.Output.Value = undefined;
        obj.Output.RawValue = undefined;

        return (obj);
    },

    evaluateBodyFormulaNew: function (objInput) {
        let iCounter = 0;
        let objFormula = null;
        let arrVariables = null;
        let arrIdNamePair = null;
        let objOutput = undefined;

        try {
            objOutput = {};
            objOutput.Value = undefined;
            objOutput.RawValue = undefined;

            if (DataType.isNullOrEmpty(objInput.sFormula, true) == true) {
                if (DataType.isValidObject(objInput.objCurrentValue) == true) {
                    objOutput.Value = objInput.objCurrentValue;

                    return (objOutput);
                }

                objOutput.Value = 0;

                return (objOutput);
            }

            objInput.sFormula = DataType.stringRemoveSpace(objInput.sFormula);
            if (DataType.stringStartsWithRaw(objInput.sFormula, "&") == false) {
                if (DataType.toDecimal(objInput.objCurrentValue) != 0) {
                    objOutput.Value = objInput.objCurrentValue;

                    return (objOutput);
                }
            }
            else {
                objInput.sFormula = objInput.sFormula.substr(1);
            }

            if (DataType.stringStartsWithRaw(objInput.sFormula, "#") == true) {
                objInput.sFormula = objInput.sFormula.substr(1);
            }

            if (objInput.iColumnIndex == undefined) {
                objInput.iColumnIndex = -1;
            }

            arrVariables = EntryMainFormula.getSQLVariables(objInput.sFormula);
            if (arrVariables.length > 1) {
                arrIdNamePair = transEntryServer.getSQLVariablesValue(arrVariables, objInput.iRowIndex);
            }

            objFormula = new FFormula();
            objFormula.m_CalType = transEntryInfo.CalendarType;
            objFormula.setRowIndex(objInput.iRowIndex);
            objFormula.setColumnIndex(objInput.iColumnIndex);
            objFormula.setCustomData(objInput.sFieldName);
            objFormula.fnValueNeeded = "EntryMainFormula.formula_ValueNeeded";

            objFormula.ResetVars();
            if (DataType.arrayLength(arrIdNamePair) > 0) {
                for (iCounter = 0; iCounter < arrIdNamePair.length; iCounter++) {
                    objFormula.AddVar(arrIdNamePair[iCounter].Name, arrIdNamePair[iCounter].Tag);
                }
            }

            objOutput.RawValue = objFormula.Result(objInput.sFormula, true);
            if (objOutput.RawValue == "NaN") {
                objOutput.Value = 0;

                return (objOutput);
            }
        }
        catch (err) {
            //transEntryGlobal.showAlert("{EntryMainFormula.evaluateBodyFormulaNew} " + err.message, GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.showAlert("{EntryMainFormula.evaluateBodyFormulaNew(" + objInput.sFieldName + ")} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        objOutput.Value = FNumberOperation.convert(objOutput.RawValue);

        return (objOutput);
    },

    evaluateBodyFormula: function (sFormula, iRowIndex, objCurrentValue, iColumnIndex, sFieldName) {
        let objInput = undefined;
        let objOutput = undefined;

        objInput = EntryMainFormula.createBodyFormulaInput(sFormula, iRowIndex, objCurrentValue, iColumnIndex, sFieldName);
        objOutput = EntryMainFormula.evaluateBodyFormulaNew(objInput);

        return (objOutput.Value);
    },

    evaluateCellFormula: function (cellobj, objMetaData, bCheckForMandatory, iRow, iColumn, value) {
        let sPreload = "";
        let sDefaultValue = "";
        let sFormula = "";
        let bFromPopup = false;
        let objCurrentValue = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objFormula = undefined;
        let objTemp = undefined;
        let result = undefined;

        try {
            if ((typeof cellobj).toLowerCase() == "string") {
                bFromPopup = true;
            }
            else {
                iRow = cellobj.iRow;
                iColumn = cellobj.iColumn;
            }

            sPreload = objMetaData.sPreload.toString();
            sDefaultValue = objMetaData.sDefaultValue.toString();
            bCheckForMandatory = DataType.toBoolean(bCheckForMandatory);

            if (bFromPopup == true) {
                objCurrentValue = value;
            }
            else {
                objCurrentValue = cellobj.getCellData();
            }

            if (objMetaData.bReadOnly == false
                || EntryMainCalculation.isEvaluationInputExist(sPreload, sDefaultValue) == false
                || objMetaData.iDataTypeId == eMasterDataType.Master
                || objMetaData.iDataTypeId == eMasterDataType.ExternalTable) {

                if (bFromPopup == true) {
                    objCurrentValue = value;
                }
                else {
                    objCurrentValue = cellobj.getCellData();
                }
            }
            else {

                if (objMetaData.bReadOnly == true
                    && EntryMainCalculation.isEvaluationInputExist(sPreload, sDefaultValue) == true
                    //&& EntryMainCommon.hasAutoRefresh(sPreload, sDefaultValue) == true
                    ) {
                    objCurrentValue = null;
                }
                else {
                    if (bFromPopup == true) {
                        objCurrentValue = value;
                    }
                    else {
                        objCurrentValue = cellobj.getCellData();
                    }
                }
            }

            if (DataType.isNullOrEmpty(objCurrentValue) == false
                && objMetaData.iDataTypeId == eMasterDataType.Fraction
                && DataType.toDecimal(objCurrentValue) == 0
                && (DataType.isNullOrEmpty(sPreload) == false || DataType.isNullOrEmpty(sDefaultValue) == false)) {
                objCurrentValue = null;
            }

            if (DataType.isNullOrEmpty(sPreload, true) == false) {
                objFormulaInput = EntryMainFormula.createBodyFormulaInput(sPreload, iRow, objCurrentValue, iColumn - 1, objMetaData.sFieldName);
                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                result = objFormulaOutput.Value;
            }
            else if (DataType.isNullOrEmpty(sDefaultValue, true) == false) {
                objTemp = EntryMainCommon.getFormulaDetail(sDefaultValue);
                if (objTemp.lValue > 0) {
                    if (objTemp.bRefresh == true || DataType.isNullOrEmpty(objCurrentValue, true) == true) {
                        sFormula = objTemp.data;
                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Date:
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iRow, null, iColumn - 1);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                result = DataType.toInt(objFormulaOutput.Value);
                                break;
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iRow, null, iColumn - 1);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                result = DataType.toInt(objFormulaOutput.Value);
                                break;
                            default:
                                objFormula = new FFormula();
                                objFormula.m_CalType = transEntryInfo.CalendarType;
                                if (objFormula.GetVariables(sFormula, true).length == 1
                                    && sFormula.indexOf('(') == -1
                                    && DataType.stringStartsWithRaw(sFormula, "[") == false
                                    && DataType.stringStartsWithRaw(sFormula, "]") == false) {

                                    var objVar = objFormula.getEmptyVariableParObject();
                                    objVar.Var = sFormula;

                                    result = EntryMainPreload.getVariableValue(objVar, cellobj.iRow, { Tag: null, iColumnIndex: iColumn - 1 });
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iRow, null, iColumn - 1);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    result = objFormulaOutput.Value;
                                }
                                break;
                        }
                    }
                    else {
                        result = objCurrentValue;
                    }
                }
                else {
                    switch (objMetaData.iDataTypeId) {
                        case eMasterDataType.Number:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            if (bCheckForMandatory == true && DataType.toString(objCurrentValue) == "" && DataType.toInt(sDefaultValue) == 0) {
                                return("");
                            }

                            if (DataType.toInt(objCurrentValue) == 0) {
                                objCurrentValue = "";
                            }
                            break;
                        case eMasterDataType.Fraction:
                            if (bCheckForMandatory == true && DataType.toString(objCurrentValue) == "" 
                                //&& DataType.toDecimal(sDefaultValue) == 0
                                ) {
                                if(DataType.isNullOrEmpty(sDefaultValue, true) == true) {
                                    return("");
                                }

                                if(DataType.isNumeric(sDefaultValue) == true) {
                                    return (sDefaultValue);
                                }

                                return("");
                            }

                            if (DataType.toDecimal(objCurrentValue) == 0) {
                                objCurrentValue = "";
                            }
                            break;
                        case eMasterDataType.StringList:
                        case eMasterDataType.NumberList:
                            if (DataType.toString(objCurrentValue) == "") {
                                return("");
                            }
                            break;
                    }

                    if (DataType.isNullOrEmpty(objCurrentValue, true) == true) {
                        result = sDefaultValue;
                    }
                    else {
                        result = objCurrentValue;
                    }
                }
            }
            else {
                result = objCurrentValue;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFormula.evaluateCellFormula} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    getBodyRefreshVariables: function (bIgnoreRefresh) {
        let sVariable = "";
        let iCounter = 0;
        let iIndex = 0;
        let iPosition = 0;
        let bFlag = false;
        let bNewVoucher = false;
        let objMetaData = null;
        let objFormula = null;
        let arrFields = undefined;
        let arrVariables = [];
        let arrData = null;
        let arrOutput = [];

        try {
            bNewVoucher = transEntryInfo.HeaderId == 0;
            bNewVoucher = true;

            arrData = [];
            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                    continue;
                }

                sVariable = "";
                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                    if (DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                        bFlag = false;
                        if (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true) {
                            sVariable = objMetaData.sPreload.substr(1);
                            bFlag = true;
                        }
                        else if (bIgnoreRefresh == true) {
                            sVariable = objMetaData.sPreload;
                            bFlag = true;
                        }

                        if (bFlag == true) {
                            if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                                sVariable = sVariable.substr(1);
                            }
                        }
                    }                    
                }

                if (DataType.isNullOrEmpty(sVariable) == true
                    && bNewVoucher == true
                    && DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYQUANTITY || objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE) {
                        bFlag = false;
                        if (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true) {
                            sVariable = objMetaData.sPreload.substr(1);
                            bFlag = true;
                        }
                        else if (bIgnoreRefresh == true) {
                            sVariable = objMetaData.sPreload;
                            bFlag = true;
                        }

                        if (bFlag == true) {
                            if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                                sVariable = sVariable.substr(1);
                            }
                        }
                    }
                }

                if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0 && DataType.isNullOrEmpty(sVariable) == true) {
                    if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                        bFlag = false;
                        if (DataType.stringStartsWithRaw(objMetaData.sDefaultValue, "&") == true) {
                            sVariable = objMetaData.sDefaultValue.substr(1);
                            bFlag = true;
                        }
                        else if (bIgnoreRefresh == true) {
                            sVariable = objMetaData.sDefaultValue;
                            bFlag = true;
                        }

                        if (bFlag == true) {
                            if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                                sVariable = sVariable.substr(1);
                            }
                        }
                    }
                }

                if(DataType.isNullOrEmpty(sVariable) == true 
                    && DataType.isNullOrEmpty(objMetaData.sRestrictFormula, true) == false) {
                    bFlag = false;
                    if (DataType.stringStartsWithRaw(objMetaData.sRestrictFormula, "&") == true) {
                        sVariable = objMetaData.sRestrictFormula.substr(1);
                        bFlag = true;
                    }
                    else if (bIgnoreRefresh == true) {
                        sVariable = objMetaData.sRestrictFormula;
                        bFlag = true;
                    }

                    if (bFlag == true) {
                        if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                            sVariable = sVariable.substr(1);
                        }
                    }                    
                }

                if (DataType.isNullOrEmpty(sVariable, true) == true) {
                    continue;
                }

                bFlag = false;
                switch (sVariable) {
                    case "stkq": // Stock Quantity
                    case "stkqa":  // Stock quantity alternate
                    case "stkv":  // Stock Value
                    case "stkc": // Clear Stock
                    case "rstk": // Reserved qty
                    case "accbal": // FA tagwise code balance
                    case "acc2bal": // FA tagwise book balance
                    case "accbalo": // Overall code balance
                    case "acc2balo": // Overall book balance
                    case "clr": // Credit Limit Remaining
                    case "slt": // Supplier Lead Time
                    case "edep": // Employee Department
                    case "cbud":
                    case "pcbud":
                    case "bud":
                    case "sbud":
                    case "bbud":
                        bFlag = true;
                        break;
                }

                if (bFlag == true) {
                    for (iIndex = 0; iIndex < arrData.length; iIndex++) {
                        if(arrData[iIndex] == sVariable) {
                            break;
                        }
                    }

                    if (iIndex >= arrOutput.length) {
                        arrData.push(sVariable);
                    }

                    continue;
                }

                objFormula = new FFormula();
                objFormula.m_CalType = transEntryInfo.CalendarType;
                arrVariables = objFormula.GetVariables(sVariable, true);
                if (arrVariables.length > 0) {
                    arrOutput = [];

                    EntryMainReevaluate.filterSQLVariables(arrVariables, arrOutput, false);
                    //if (bIgnoreRefresh == true) {
                    //    EntryMainReevaluate.filterSQLVariables(arrVariables, arrOutput, false);
                    //}
                    //else {
                    //    EntryMainReevaluate.filterSQLVariables(arrVariables, arrOutput, true);
                    //}

                    if (arrOutput.length > 0) {
                        for (iIndex = 0; iIndex < arrOutput.length; iIndex++) {
                            arrData.push(arrOutput[iIndex]);
                        }
                    }

                    if (bNewVoucher == true && bIgnoreRefresh != true) {
                        for (iIndex = 0; iIndex < arrVariables.length; iIndex++) {
                            arrOutput = transEntryRate.extractVariableName(arrVariables[iIndex], true);
                            if (arrOutput.length > 0) {
                                while (arrOutput.length > 0) {
                                    for (iPosition = 0; iPosition < arrData.length; iPosition++) {
                                        if (arrData[iPosition] == arrOutput[0].sFormula) {
                                            break;
                                        }
                                    }

                                    if (iPosition >= arrData.length) {
                                        arrData.push(arrOutput[0].sFormula);
                                    }

                                    arrOutput.splice(0, 1);
                                }

                                continue;
                            } // End for rate variables

                            // Need not master varaibles for loaded vouchers as its value is already prefetched on voucher load.
                            if (EntryMainPreload.isMasterVariable(arrVariables[iIndex]).Value == true) {
                                for (iPosition = 0; iPosition < arrData.length; iPosition++) {
                                    if (arrData[iPosition] == arrVariables[iIndex]) {
                                        break;
                                    }
                                }

                                if (iPosition >= arrData.length) {
                                    arrData.push(arrVariables[iIndex]);
                                }

                                continue;
                            } // End for master variables
                        }
                    }
                }                
            }

            if (arrData.length == 1 && EntryMainPreload.isMasterVariable(arrData[0]).Value == true) {
                arrData = [];
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFormula.getBodyRefreshVariables} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    }
};
