                objData = EntryMainWorkflow.getLinkKeyFields(false, objLinkInfo.iBaseVoucher, 0);
                if (objData.arrLinks.length > 0) {
                    if (objData.arrLinks[0].LinkDefn.IsDontSelectPartial == true && objData.bFieldValueStatus == false) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgSelectAllLinkFields"), GlobalPref.getResourceValue("Error"));

