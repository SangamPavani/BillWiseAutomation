            for (iCounter = 0; iCounter < this.m_arrTreeDependency.length; iCounter++) {
                obj = this.m_arrTreeDependency[iCounter];
                if (DataType.toString(obj.iFieldId) !== DataType.toString(iFieldId)) {
                    continue;
                }

                if (obj.iRow == iRow) {
                    this.m_arrTreeDependency.splice(iCounter, 1);
