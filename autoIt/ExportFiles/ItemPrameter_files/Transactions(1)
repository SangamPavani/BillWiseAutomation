    setBodyFieldValue: function (iRow, field, bIsName, value, bToStruct) {
        let sId = "";
        let iFieldId = 0;
        let bProductAlias = false;
        let objMetaData = null;
        let objFieldInfo = undefined;
        let arrFields = undefined;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (((bIsName == true && field == "Reference")
                || (bIsName == false && field == eVTFIELDID.FDF_REFERENCE))
                &&
                (EntryMainBillwise.isSingleBillwiseVoucher() == true
                || transEntryInfo.BodySectionNotRequired == true)) {
                iFieldId = eVTFIELDID.FDF_REFERENCE;
            }

            if (iFieldId == 0) {
                if (bToStruct == true && field == "*") {
                }
                else if (bToStruct == false && field == "*") {
                }
                else {
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        arrFields = [];
                    }
                    else {
                        if (DataType.toBoolean(bIsName) == true) {
                            arrFields = transEntryFieldInfo.getBodyFields({ sFieldName: field, bName: true });
                        }
                        else {
                            arrFields = transEntryFieldInfo.getBodyFields({ iFieldId: field, bName: false });
                        }
                    }

                    if (arrFields.length < 1) {
                        return (result);
                    }

                    objFieldInfo = arrFields[0];
                    objMetaData = objFieldInfo.MetaData;
                    iFieldId = objMetaData.iFieldId;
                    if (iFieldId == 0 && DataType.isValidObject(objMetaData) == true
                        && transEntryFieldInfo.ProductAlias.ColumnIndex > -1
                        && objMetaData.sFieldName == transEntryFieldInfo.ProductAlias.MetaData.sFieldName) {

                        bProductAlias = true;
                    }
                }
            }

            if (iFieldId == eVTFIELDID.FDF_REFERENCE) {
                sId = eTranEntryBodyDataConstKey.BillwiseData;
            }
            else if (iFieldId == 0) {
                if (bProductAlias == false) {
                    sId = "*";
                }
                //sId = "*";
            }
            else {
                sId = EntryMainUI.getBodyControlId(iFieldId);
            }

            if (bToStruct == true) {
                EntryMainAPI.setValueToStruct(sId, value, iRow);
            }
            else if (bToStruct == false && sId == "*") {
                EntryMainAPI.insertNewUIRow(value);
            }
            else {
                if (transEntryInfo.BodySectionNotRequired == true) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                        result.lValue = 0;
                        result.sValue = "";
                        result.data = null;

                        return (result);
                    }

                    result = EntryMainAPI.setValueToControl(sId, objMetaData.iDataTypeId, value);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, 1, objMetaData);
                }
                else {
                    if (iRow > 1 && iRow == (transEntryGrid.getTotalRows() + 1)) {
                        transEntryGrid.insertRows(0, 1, true);
                    }

                    if (iRow < 1 || iRow > transEntryGrid.getTotalRows()) {
                        result.lValue = 0;
                        result.sValue = "Invalid row index.";

                        return (result);
                    }

                    result = EntryMainAPI.setValueToGrid(iRow, objFieldInfo.ColumnIndex, objMetaData, value);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.setBodyFieldValue}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

