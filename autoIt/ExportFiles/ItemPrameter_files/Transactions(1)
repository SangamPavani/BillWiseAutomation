            objTran.HeaderId = 0;
            objTran.Header = null;
            objTran.Body = null;
            objTran.Footer = null;

            if(DataType.isArray(arrIgnoreField) == false) {
                arrIgnoreField = [];
            }

            if (DataType.isValidObject(objTransaction) == true) {
                if (DataType.isValidObject(objTransaction.Header) == true) {
                    objTran.HeaderId = objTransaction.Header.HeaderId;
                }

                objTran.Header = transEntryData.convertHeaderObjectToKeyValueArray(objTransaction, arrIgnoreField, iConvertSource);
                objTran.Body = transEntryData.convertBodyObjectToKeyValueArray(objTransaction.BodyData, iConvertSource, arrIgnoreField, iStartRow);
                objTran.Footer = transEntryData.convertFooterObjectToKeyValueArray(objTransaction.Footer, arrIgnoreField, iConvertSource);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.convertIntoThinClientObject} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objTran);
    },

    convertHeaderObjectToKeyValueArray: function (objTransaction, arrIgnoreField, iConvertSource) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let iTotal = 0;
        let bIgnore = false;
        let header = {};
        let arrData = [];
        let objMetaData = null;
        let objIdNamePair = null;
        let attachment = null;

        try {
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];

                bIgnore = false;
                for(iCounter1 = 0; iCounter1 < arrIgnoreField.length; iCounter1++) {
                    if(arrIgnoreField[iCounter1] == objMetaData.iFieldId) {
                        bIgnore = true;
                        break;
                    }
                }

                if(bIgnore == true) {
                    continue;
                }

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                header = {};

                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_DOCUMENTNO:
                        header.Key = sId;
                        header.Value = OPTIONCONTROL.getControlText(sId);
                        arrData.push(header);
                        break;
                    case eVTFIELDID.FDF_DATE:
                        header.Key = sId;
                        header.Value = objTransaction.Header.Date;
                        arrData.push(header);
                        break;
                    case eVTFIELDID.FDF_TIME:
                        if (DataType.isValidObject(objTransaction.Header.Time) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.Time;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_PMTTERMS:
                        if (DataType.isValidObject(objTransaction.Header.PmtTerm) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.PmtTerm;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_UPDATESTOCKS:
                        if (DataType.isValidObject(objTransaction.Header.UpdateInv) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.Flags.UpdateInv;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_RAISECASHCONTRA:
                        if (DataType.isValidObject(objTransaction.Header.Flags) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.Flags.PostCashEntry;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_UPDATEFA:
                        if (DataType.isValidObject(objTransaction.Header.UpdateFA) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.Flags.UpdateFA;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_LCNUMBER:
                        if (DataType.isValidObject(objTransaction.Header.LC) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.LC;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_MODIFIED_BY:
                        if (DataType.isValidObject(objTransaction.Header.ModifiedBy) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.Header.ModifiedBy;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_CODE:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toInt(objTransaction.BodyData[0].Code);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_BOOKNO:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toInt(objTransaction.BodyData[0].Book);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_DUEDATE:
                        if (objTransaction.BodyData.length > 0 && DataType.isValidObject(objTransaction.BodyData[0].DueDate) == true) {
                            header.Key = sId;
                            header.Value = objTransaction.BodyData[0].DueDate;
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_HEADERCURRENCY:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toInt(objTransaction.BodyData[0].CurrencyId);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_EXCHANGERATE:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toDecimal(objTransaction.BodyData[0].ExchangeRate);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_LOCEXCHANGERATE:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toDecimal(objTransaction.BodyData[0].LocalExchangeRate);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_HEADERINVTAG:
                        if (objTransaction.BodyData.length > 0) {
                            header.Key = sId;
                            header.Value = DataType.toDecimal(objTransaction.BodyData[0].InvTag);
                            arrData.push(header);
                        }
                        break;
                    case eVTFIELDID.FDF_BODYINVTAG:
                        if (objTransaction.BodyData.length > 2) {
                            header.Key = sId;
                            header.Value = 0;
                            for (iCounter1 = objTransaction.BodyData.length - 1; iCounter1 >= 0; iCounter1--) {
                                if (objTransaction.BodyData[iCounter1].RowType == _RowType.Default) {
                                    header.Value = DataType.toInt(objTransaction.BodyData[iCounter1].InvTag);
                                    break;
                                }
                            }

                            arrData.push(header);
                        }
                        break;

                    default:
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0) {
                            if (objTransaction.BodyData.length == 0) {
                                break;
                            }

                            if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                                header.Key = sId;
                                header.Value = DataType.toInt(objTransaction.BodyData[0].FATag);
                                arrData.push(header);
                            }
                            else if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.InvTag) {
                                header.Key = sId;
                                header.Value = DataType.toInt(objTransaction.BodyData[0].InvTag);
                                arrData.push(header);
                            }
                            else if (DataType.isValidObject(objTransaction.BodyData[0].Tags) == true) { // Tags
                                for (iCounter1 = 0; iCounter1 < objTransaction.BodyData[0].Tags.length; iCounter1++) {
                                    objIdNamePair = objTransaction.BodyData[0].Tags[iCounter1];
                                    if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                        header.Key = sId;
                                        header.Value = objIdNamePair.Tag;
                                        arrData.push(header);
                                        break;
                                    }
                                }
                            }
                        }
                        else if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                            switch (objMetaData.iDataTypeId) {
                                case eMasterDataType.Picture:
                                case eMasterDataType.DocumentViewer:
                                    iTotal = DataType.arrayLength(objTransaction.HeaderDocs);
                                    for (iCounter1 = 0; iCounter1 < iTotal; iCounter1++) {
                                        if(iConvertSource == eConvertTransactionObjectSource.CopyDocument) {
                                            attachment = objTransaction.HeaderDocs[iCounter1];
                                            if(DataType.isValidObject(attachment) == false) {
                                                continue;
                                            }

                                            if ((attachment.iFieldId & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                                header.Key = sId;
                                                header.Value = DataType.toString(attachment);
                                                arrData.push(header);
                                                break;
                                            }
                                        }
                                        else {
                                            objIdNamePair = objTransaction.HeaderDocs[iCounter1];
                                            if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                                attachment = {};
                                                attachment.iFieldId = objIdNamePair.ID;
                                                attachment.sFileName = objIdNamePair.Tag.Name;
                                                attachment.sData = "";
                                                attachment.arrData = null;

                                                if (DataType.isString(objIdNamePair.Tag.Tag) == true) {
                                                    attachment.sData = objIdNamePair.Tag.Tag;
                                                }
                                                else if (DataType.isArray(objIdNamePair.Tag.Tag) == true) {
                                                    attachment.sData = LZUTF8.encodeBase64(objIdNamePair.Tag.Tag);
                                                    //attachment.arrData = objIdNamePair.Tag.Tag;
                                                }

                                                header.Key = sId;
                                                header.Value = DataType.toString(attachment);
                                                arrData.push(header);
                                                break;
                                            }
                                        }
                                    }
                                    break;
                                default:
                                    iTotal = DataType.arrayLength(objTransaction.HeaderExtra);
                                    for (iCounter1 = 0; iCounter1 < iTotal; iCounter1++) {
                                        objIdNamePair = objTransaction.HeaderExtra[iCounter1];
                                        if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                            header.Key = sId;
                                            header.Value = objIdNamePair.Tag;
                                            arrData.push(header);
                                            break;
                                        }
                                    }

                                    if (iCounter1 < iTotal) {
                                        break;
                                    }

                                    for (iCounter1 = 0; iCounter1 < iTotal; iCounter1++) {
                                        objIdNamePair = objTransaction.HeaderExtra[iCounter1];
                                        if (objIdNamePair.Name == objMetaData.sFieldName) {
                                            header.Key = sId;
                                            header.Value = objIdNamePair.Tag;
                                            arrData.push(header);
                                            break;
                                        }
                                    }

                                    break;
                            }
                        }
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.convertHeaderObjectToKeyValueArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

    convertBodyObjectToKeyValueArray: function (arrTransBody, iConvertSource, arrIgnoreField, iStartRow) {
        let iRow = 0;
        let objBody = null;
        let arrData = [];
        let arrBodyData = [];

        try {
            iConvertSource = DataType.toInt(iConvertSource);
            if (DataType.isValidObject(arrTransBody) == true) {
                if (DataType.isArray(arrTransBody) == false) {
                    arrTransBody = [arrTransBody];
                }

                for (iRow = 0; iRow < arrTransBody.length; iRow++) {
                    objBody = arrTransBody[iRow];
                    if (objBody.RowType != _RowType.Default) {
                        continue;
                    }

                    objBody.Flags.PDC = false;
                    arrData = transEntryData.convertBodyDataClassToKeyValueArray(objBody, iConvertSource, arrBodyData.length + 1, arrIgnoreField, iStartRow);
                    arrBodyData.push(arrData);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.convertBodyObjectToKeyValueArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrBodyData);
    },

    convertFooterObjectToKeyValueArray: function (arrFooterData, arrIgnoreField, iConvertSource) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let iIndex = 0;
        let footer = {};
        let arrData = [];        
        let objFooterData = {};
        let arrFooterFields = undefined;
        let objMetaData = null;
        let obj = null;

        try {
            iConvertSource = DataType.toInt(iConvertSource);
            if (DataType.isValidObject(arrFooterData) == true) {
                arrFooterFields = transEntryFieldInfo.getFooterFields();

                for (iCounter = 0; iCounter < arrFooterData.length; iCounter++) {
                    objFooterData = arrFooterData[iCounter];
                    for (iCounter1 = 0; iCounter1 < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter1++) {
                        iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter1].arrMetaDataIndex[0];
                        objMetaData = arrFooterFields[iIndex];

                        if(iConvertSource == eConvertTransactionObjectSource.CopyDocument) {
                            if (objFooterData.FieldName != objMetaData.sFieldName) {
                                continue;
                            }
                        }
                        else {
                            if ((objFooterData.FieldId & eVTFIELDFLAG.TOFLDID) != (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                continue;
                            }
                        }

                        obj = {};
                        obj.Input = objFooterData.Input;
                        obj.Value = objFooterData.Value;

                        sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);
                        footer = {};
                        footer.Key = sId;
                        footer.Value = DataType.toString(obj);
                        arrData.push(footer);

                        iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter1].arrMetaDataIndex[1];
                        if (iIndex >= 0) {
                            objMetaData = arrFooterFields[iIndex];
                            sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);

                            footer = {};
                            footer.Key = sId;
                            footer.Value = objFooterData.Account1;
                            arrData.push(footer);
                        }


                        iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter1].arrMetaDataIndex[2];
                        if (iIndex >= 0) {
                            objMetaData = arrFooterFields[iIndex];
                            sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);

                            footer = {};
                            footer.Key = sId;
                            footer.Value = objFooterData.Account2;
                            arrData.push(footer);
                        }

                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.convertFooterObjectToKeyValueArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },


    // Convert server side body data class to key value format
    convertBodyDataClassToKeyValueArray: function (objBody, iConvertSource, iGridRow, arrIgnoreField, iStartRow) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let iOldValue = 0;
        let body = {};
        let arrData = [];
        let arrFields = undefined;
        let objMetaData = null;
        let objScreenData = null;
        let objTemp = null;

        try {
            iConvertSource = DataType.toInt(iConvertSource);
            iGridRow = DataType.toInt(iGridRow);

            arrData = [];

            body = {};
            body.Key = eTranEntryBodyDataConstKey.BodyId;
            body.Value = objBody.BodyId;
            arrData.push(body);


            body = {};
            body.Key = eTranEntryBodyDataConstKey.TransactionId;
            body.Value = objBody.TransactionId;
            arrData.push(body);

            body = {};
            body.Key = eTranEntryBodyDataConstKey.Flags;
            body.Value = objBody.Flags;
            arrData.push(body);

            body = {};
            body.Key = eTranEntryBodyDataConstKey.AuthStatus;
            body.Value = objBody.AuthStatus;
            arrData.push(body);

            body = {};
            body.Key = eTranEntryBodyDataConstKey.ExchangeRate;
            body.Value = objBody.ExchangeRate;
            arrData.push(body);

            if (DataType.isNullOrEmpty(objBody[eTranEntryBodyDataConstKey.SetInfo]) == false) {
                body = {};
                body.Key = eTranEntryBodyDataConstKey.SetInfo;
                body.Value = objBody[eTranEntryBodyDataConstKey.SetInfo];
                arrData.push(body);
            }

