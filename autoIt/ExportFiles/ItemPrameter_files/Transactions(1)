    cellChange: function (cellobj, evt, objArg) {
        let sValue = "";
        let iIndex = 0;
        let LastValue = 0;
        let CurrentValue = 0;
        let bResult = false;
        let arrFormula = undefined;
        let arrMessage = undefined;
        let objMetaData = undefined;
        let objLeaveData = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objOutput = undefined;
        let value = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugBody == true) {
                debugger
            }

            FUIElement.stopKeyProcess(evt);
            if (cellobj.bLeave == true) {
                FUIElement.addClass(cellobj.cell, "FGridColumn-padding");
                transEntryGrid.enableFreezeColumn(cellobj.iColumn, true);
            }
            else {
                FUIElement.removeClass(cellobj.cell, "FGridColumn-padding");
                transEntryGrid.enableFreezeColumn(cellobj.iColumn, false);
            }

            iIndex = DataType.toInt(cellobj.ColumnAttribute.metadataindex);
            objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];

            //console.log("Leave:" + cellobj.bLeave + ", Row:" + cellobj.iRow + ", Column:" + cellobj.iColumn + ", node:" + cellobj.cell.nodeName);
            transEntryGrid.unSelectRow(cellobj.iRow);
            if (transEntryGlobal.EntryModel.bBodyReadOnly == true) {
                return;
            }

            if (cellobj.bLeave == true) {
                LastValue = transEntryGrid.getCellValue(cellobj, objMetaData);

                objLeaveData = null;
                if (DataType.isValidObject(objArg) == true && DataType.isValidObject(objArg.LeaveData) == true) {
                    objLeaveData = objArg.LeaveData;
                }

                bResult = EntryMainBody.onLeave(cellobj, objMetaData, objLeaveData, evt);

                if (DataType.isNullOrEmpty(objMetaData.sRegularExpression) == false) {
                    value = cellobj.getCellData();
                    if (DataType.isNullOrEmpty(value) == false) {
                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                                value = DataType.toInt(value);
                                break;
                            case eMasterDataType.Fraction:
                                value = DataType.toDecimal(value);
                                break;
                        }
                    }
                    if (EntryMainCommon.isMatch(objMetaData.sRegularExpression, value) == false) {
                        cellobj.clear();
                        transEntryGlobal.showAlert(objMetaData.sErrorMessage, GlobalPref.getResourceValue("RegexFailed"));
                        if (DataType.isValidObject(objArg) == true) {
                            objArg.bRegularExpression = true;
                        }
                    }
                }

                if (DataType.isNullOrEmpty(objMetaData.sRestrictFormula) == false && EntryMainUI.isFreeRow(cellobj.iRow) == false) {
                    arrFormula = objMetaData.sRestrictFormula.split(';');
                    arrMessage = objMetaData.sRestrictMessage.split(';');
                    for (iIndex = arrMessage.length; iIndex < arrFormula.length; iIndex++) {
                        arrMessage.push(GlobalPref.getResourceValue("EntryRestrict"));
                    }

                    for (iIndex = 0; iIndex < arrFormula.length; iIndex++) {
                        sValue = arrFormula[iIndex];
                        if (DataType.isNullOrEmpty(sValue, true) == true) {
                            continue;
                        }

                        if (DataType.stringIncludes(sValue, "?") == false) {
                            sValue = sValue + "?1:0";
                        }

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(sValue, cellobj.iRow, null, cellobj.iColumn - 1, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        if (objFormulaOutput.Value > 0) {
                            cellobj.clear();
                            transEntryGlobal.showAlert(arrMessage[iIndex], GlobalPref.getResourceValue("EntryRestrict"));
                            if (DataType.isValidObject(objArg) == true) {
                                objArg.bRestrictFormula = true;
                            }
                        }
                    }

                    CurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                    if (LastValue != CurrentValue) {
                        EntryMainUI.setSummaryInfo(0);
                    }
                }

                if (EntryMainCommon.checkEntryValidation(objMetaData, cellobj.iRow) == true) {
                    cellobj.clear();

                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                }

                if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                    && EntryMain.isDataLoading() == false
                    && DataType.arrayLength(objMetaData.ArrExternalModules) > 0) {

                    CurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                    if (transEntryExternalModule.filterModulesOnEvent(objMetaData.ArrExternalModules, eFieldExternalModuleEvents.OnLeave).length > 0) {
                        transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnLeave, objMetaData.iFieldId, objMetaData.sFieldName, cellobj.iRow);
                    }

                    if (transEntryExternalModule.filterModulesOnEvent(objMetaData.ArrExternalModules, eFieldExternalModuleEvents.OnValueChange).length > 0 && LastValue != CurrentValue) {
                        transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnValueChange, objMetaData.iFieldId, objMetaData.sFieldName, cellobj.iRow);
                    }
                }

                if (objMetaData.iDataTypeId == eMasterDataType.Master) {
                    CurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                    if (LastValue != CurrentValue) {
                        EntryMainMaster.onMasterChanged(LastValue, CurrentValue, objMetaData.iFieldId, cellobj.iRow, cellobj.iColumn);
                    }
                }

                if (objMetaData.iDataTypeId == eMasterDataType.Master && objMetaData.iMasterTypeId > 0) {
                    EntryMainInfoSidebar.loadDashboard(cellobj.iRow,
                        false,
                        {
                            iMasterTypeId: objMetaData.iMasterTypeId,
                            FieldId: objMetaData.iFieldId
                        });
                }

                if (objMetaData.iDataTypeId == eMasterDataType.Master
                    && bResult == true
                    && cellobj.iColumn != transEntryGrid.getTotalColumns()) {

                    EntryMainBody.updateRowPosition(cellobj, objMetaData);
                }
                else {
                    obj = {};
                    if (EntryMainBody.isRowRepositionRequired(cellobj.iRow, cellobj.iColumn, obj) == true) {
                        return (obj);
                    }
                }

                return (bResult);
            }
            else {
                objOutput = {};
                objOutput.bHandleReadOnlyFields = false;
                bResult = EntryMainBody.onEnter(cellobj, objMetaData, evt, objArg, objOutput);

                if (bResult !== false
                    && objOutput.bHandleReadOnlyFields == false
                    && objMetaData.bHidden == true
                    && cellobj.iRow == transEntryGrid.getCurrentRow()
                    && cellobj.iColumn == transEntryGrid.getCurrentColumn()) {

                    obj = EntryMainBody.hasVariable(objMetaData);
                    if (obj.bRefresh == true) {
                        cellobj.processDefault(evt, false, true);
                    }
                    else {
                        obj = EntryMainBody.hasFormula(objMetaData);
                        if (obj.bRefresh == true) {
                            cellobj.processDefault(evt, false, true);
                        }
                    }
                }


                if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                    && EntryMain.isDataLoading() == false
                    && DataType.arrayLength(objMetaData.ArrExternalModules) > 0
                    && transEntryExternalModule.filterModulesOnEvent(objMetaData.ArrExternalModules, eFieldExternalModuleEvents.OnEnter).length > 0) {

                    transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnEnter,
                        objMetaData.iFieldId,
                        objMetaData.sFieldName,
                        cellobj.iRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body cellChange method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.cellChange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave: function (cellobj, objMetaData, objLeaveData, evt) {
        let bValueChanged = false;
        let bBase64Data = false;
        let element = null;
        let data = null;
        let objLastValue = null;
        let objCurrentValue = 0;
        let validate = null;
        let bResult = true;
        let bHandled = false;
        let bValidInput = true;
        let bRuleReadOnly = false;
        let bRuleMandatory = false;
        let obj = null;

        if (transEntryGlobal.debugBodyField == objMetaData.iFieldId) {
            debugger
        }

        if (EntryMainBody.isRowReadOnly(cellobj.iRow, false, objMetaData.iFieldId) == true
            || DataType.arrayContains(EntryMainUI.m_SaudiRestriction, objMetaData.iFieldId) > -1
            || EntryMainUI.isReservationRestrictd(cellobj.iRow, objMetaData.iFieldId) == true
            || EntryMainUI.isLinkRestrictd(cellobj.iRow, objMetaData.iFieldId).Value == true
            || EntryMainUI.isBillStatusRestricted(cellobj.iRow, objMetaData.iFieldId, objMetaData) == true) {
            return (true);
        }

        if (EntryMainUI.isFreeRow(cellobj.iRow) == true) {
            if (objMetaData.iFieldId != transEntryFieldInfo.TaxCode.FieldId) {
                return (true);
            }
        }


        if (objMetaData.bHidden == true) {
            obj = EntryMainBody.hasVariable(objMetaData);
            if (obj.bRefresh == false) {
                obj = EntryMainBody.hasFormula(objMetaData);
                if (obj.bRefresh == false) {
                    EntryMainRules.cellLeaveRule(cellobj, objMetaData);
                    return (true);
                }
            }
        }

        if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true || objMetaData.iFieldId == 0) {
            return (true);
        }


        if (EntryMainSet.isEditableColumn(cellobj) == false) {
            return (true);
        }

        bValidInput = true;
        if (EntryMainBody.isColumnEditable(cellobj.iRow, cellobj.iColumn) == false) {
            if (EntryMainBody.isRowEditable(cellobj.iRow, true) == false) {
                bValidInput = false;
            }
        }

        bRuleReadOnly = EntryMainRules.isRuleReadOnlyColumn(cellobj) == 1;
        bRuleMandatory = EntryMainRules.isRuleMandatoryColumn(cellobj) == 1;
        switch (objMetaData.iDataTypeId) {
            case eMasterDataType.Master:
                if (transEntryGlobal.debugMaster == true) {
                    debugger
                }

                if (EntryMainValidate.isSkidValid(objMetaData.iFieldId, cellobj) == false) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    break;
                }

                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    break;
                }

                objLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);

                bResult = EntryMainBody.onMasterLeave(cellobj, objMetaData);

                objCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);

                if (EntryMain.isDataLoading() == false && objLastValue != objCurrentValue) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.Boolean:
                if (cellobj.hasControl() == true) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, cellobj.getControl().checked == true ? 1 : 0, cellobj.iRow, objMetaData);
                }
                break;
            case eMasterDataType.ExternalTable:
                if (transEntryGlobal.debugMaster == true) {
                    debugger
                }

                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);

                    break;
                }

                if (EntryMainValidate.isSkidValid(objMetaData.iFieldId, cellobj) == false) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    break;
                }

                objLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);

                data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
                EntryMainBody.updateMasterValue(cellobj, data, objMetaData.iFieldId, false);

                objCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                EntryMainMemoryObject.update(objMetaData.iFieldId, objCurrentValue, cellobj.iRow, objMetaData);

                if (EntryMain.isDataLoading() == false && objLastValue != objCurrentValue) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.Date:
                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                objLastValue = DataType.toInt(cellobj.getCellData());
                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                data = DATEPICKER.getDate(element);

                bValueChanged = false;
                if (objLastValue != data) {
                    bValueChanged = true;
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }

                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_MFGDATE:
                        if (transEntryGrid.isBatchInputRequired(cellobj.iRow) == false) {
                            bHandled = true;
                            bResult = true;
                            break;
                        }

                        if (transEntryFields.isRequired(eVTFIELDID.FDF_MFGDATE, cellobj.iRow) == false) {
                            cellobj.clear();
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_MFGDATE, undefined, cellobj.iRow);
                            bHandled = true;
                            bResult = true;
                            break;
                        }

                        break;
                    case eVTFIELDID.FDF_EXPDATE:
                        if (transEntryGrid.isBatchInputRequired(cellobj.iRow) == false) {
                            bHandled = true;
                            bResult = true;
                            break;
                        }

                        if (transEntryFields.isRequired(eVTFIELDID.FDF_EXPDATE, cellobj.iRow, true) == false) {
                            cellobj.clear();
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_EXPDATE, undefined, cellobj.iRow);
                            bHandled = true;
                            bResult = true;
                            break;
                        }

                        if (transEntryInfo.BatchPref.bExpiryDatesOptional == true && data == 0) {
                            cellobj.clear();
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_EXPDATE, undefined, cellobj.iRow);
                            bHandled = true;
                            bResult = true;
                            break;
                        }

                        if (transEntryFieldInfo.MFGDate.ColumnIndex < 0) {
                            break;
                        }

                        if (transEntryInfo.BatchPref.bExpiryDatesOptional == false
                            && data < transEntryFields.getMFGDate(cellobj.iRow)) {

                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgExpDtCantLessMfgDt"), GlobalPref.getResourceValue("Error"));
                            bHandled = true;
                            bResult = false;
                        }                        
                        break;
                    case eVTFIELDID.FDF_BODYDUEDATE:
                        if (bValueChanged == true) {                            
                            transEntryDueDate.onChange(cellobj.iRow);
                        }
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYDUEDATE, data, cellobj.iRow);
                        break;
                }

                if (bHandled == true) {
                    break;
                }

                if (data == 0) {
                    cellobj.setCellText("", data);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                }
                else {
                    switch (objMetaData.iFieldId) {
                        case eVTFIELDID.FDF_MFGDATE:
                            cellobj.setCellText(DATEPICKER.getText(element), data);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, data, cellobj.iRow, objMetaData);
                            EntryMainBatch.calculateAndSetExpiryDateFromItem(cellobj.iRow, objLastValue != data);
                            break;
                        case eVTFIELDID.FDF_EXPDATE:
                            transEntryBatch.setExpDate(cellobj.iRow, data);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, data, cellobj.iRow, objMetaData);
                            break;
                        default:
                            cellobj.setCellText(DATEPICKER.getText(element), data);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, data, cellobj.iRow, objMetaData);
                            break;
                    }

                    if (bValueChanged == true) {
                        EntryMain.setDirty();
                    }
                }
                break;
            case eMasterDataType.Time:
                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                objLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);

                EntryMainBody.updateTimeValue(cellobj, null, objMetaData.iFieldId, true);

                objCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                EntryMainMemoryObject.update(objMetaData.iFieldId, objCurrentValue, cellobj.iRow, objMetaData);
                if (EntryMain.isDataLoading() == false && objLastValue != objCurrentValue) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.HyperLink:
                data = FHyperLink.getValue(cellobj.ColumnAttribute.ctrlid);

                EntryMainMemoryObject.update(objMetaData.iFieldId, data, cellobj.iRow, objMetaData);

                cellobj.setCellText(data, data);
                break;
            case eMasterDataType.Picture:
            case eMasterDataType.DocumentViewer:
                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow);

                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                bBase64Data = FATTACHMENTCONTROL.PRIVATE.isBase64Data(cellobj.ColumnAttribute.ctrlid);
                data = FATTACHMENTCONTROL.getData(cellobj.ColumnAttribute.ctrlid);

                if (data.lValue > 0) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, data.data, cellobj.iRow, objMetaData);
                }
                else {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow);
                }

                obj = {};
                obj.sFileName = data.data.sFileName;

                if (data.data.iDataSource == eWebAttachmentStorage.Disk) {
                    if (bBase64Data == true) {
                        obj.sData = data.data.sData;
                    }
                    else {
                        obj.arrData = data.data.data;
                    }

                    EntryMainBody.updateAttachmentValue(cellobj,
                        obj,
                        objMetaData.iFieldId,
                        false,
                        data.data.iDataSource);
                }
                else {
                    obj.sData = data.data.sData;

                    EntryMainBody.updateAttachmentValue(cellobj,
                        obj,
                        objMetaData.iFieldId,
                        false,
                        data.data.iDataSource);
                }
                break;
            case eMasterDataType.Number:
            case eMasterDataType.SmallNumber:
            case eMasterDataType.TinyNumber:
                objLastValue = DataType.toString(cellobj.getCellData());
                if (objMetaData.bMandatory == false || objLastValue != "") {
                    objLastValue = DataType.toInt(objLastValue);
                }

                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);

                if (objMetaData.bMandatory == false || DataType.toString(element.value) != "") {
                    if (EntryMainValidate.isNumberOverflow(objMetaData.iDataTypeId, element.value) == true) {
                        element.value = 0;
                    }

                    validate = EntryMainValidate.checkMinMaxRange(FConvert.toDecimal(element.value), FConvert.toDecimal(objMetaData.dMinimumValue), FConvert.toDecimal(objMetaData.dMaximumValue));
                    if (validate.bInvalid == true) {
                        element.value = validate.dValue;
                    }

                    cellobj.setCellText(DataType.addNumericSeparator(element.value, transEntryCurrency.getNumericSeparator(cellobj.iRow)), element.value);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, element.value, cellobj.iRow, objMetaData);
                    objCurrentValue = DataType.toInt(cellobj.getCellData());
                }
                else {
                    cellobj.setCellText("", "");
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    objCurrentValue = "";
                }

                EntryMainBody.processDataChange(objLastValue, objCurrentValue, cellobj.iRow, objMetaData.iFieldId);

                if (EntryMain.isDataLoading() == false && objLastValue != objCurrentValue) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.BigNumber:
                objLastValue = DataType.toString(cellobj.getCellData());
                element = document.getElementById(cellobj.ColumnAttribute.ctrlid);

                cellobj.setCellText(element.value, element.value);
                EntryMainMemoryObject.update(objMetaData.iFieldId, element.value, cellobj.iRow, objMetaData);
                objCurrentValue = cellobj.getCellData();
                EntryMainBody.processDataChange(objLastValue, objCurrentValue, cellobj.iRow, objMetaData.iFieldId);
                break;
            case eMasterDataType.Fraction:
                if (objMetaData.iFieldId == eVTFIELDID.FDF_BALANCEQTY) {
                    break;
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_AVGRATE) {
                    break;
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_BALANCESTKVAL) {
                    EntryMainUI.updateFooterSummarySpecialValue(objMetaData.iFieldId);
                    break;
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_NEWAVGRATE) {
                    EntryMainStockRevaluation.onNewAvgRate_Leave(cellobj);
                    break;
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_NEWSTKVAL) {
                    EntryMainStockRevaluation.onNewStockValue_Leave(cellobj);
                    break;
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE
                    || objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE1
                    || objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE2) {

                    if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, cellobj.iRow) == false) {
                        cellobj.clear();
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                        break;
                    }
                }

                objLastValue = DataType.toString(cellobj.getCellData());
                if (objMetaData.bMandatory == false || objLastValue != "") {
                    objLastValue = FConvert.toDecimal(objLastValue);
                }

                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                EntryMainBody.onFractionLeave(cellobj, objMetaData);

                objCurrentValue = DataType.toString(cellobj.getCellData());

                if (EntryMain.isDataLoading() == false && FConvert.toDecimal(objLastValue) != FConvert.toDecimal(objCurrentValue)) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }

                if (objMetaData.bMandatory == false || objCurrentValue != "") {
                    objCurrentValue = FConvert.toDecimal(objCurrentValue);
                }

                EntryMainBody.processDataChange(objLastValue, objCurrentValue, cellobj.iRow, objMetaData.iFieldId);
                break;
            case eMasterDataType.StringList:
                objLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                objCurrentValue = EntryMainBody.updateStringListValue(cellobj, null, objMetaData.iFieldId, true);
                //objCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                EntryMainMemoryObject.update(objMetaData.iFieldId, objCurrentValue, cellobj.iRow, objMetaData);

                if (EntryMain.isDataLoading() == false && FConvert.toDecimal(objLastValue) != FConvert.toDecimal(objCurrentValue)) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.NumberList:
                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                objLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                objCurrentValue = EntryMainBody.updateNumberListValue(cellobj, null, objMetaData.iFieldId, true);
                //objCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);
                EntryMainMemoryObject.update(objMetaData.iFieldId, objCurrentValue, cellobj.iRow, objMetaData);

                if (EntryMain.isDataLoading() == false && FConvert.toDecimal(objLastValue) != FConvert.toDecimal(objCurrentValue)) {
                    EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                }
                break;
            case eMasterDataType.Text:
                if (bValidInput == false) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, cellobj.iRow, objMetaData);

                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);
                    break;
                }

                bResult = EntryMainBody.onTextLeave(cellobj, objMetaData, objLeaveData);
                break;
        }

        if (objMetaData.iDataTypeId == eMasterDataType.Fraction
            && (objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
            transEntryScreenData.notifyBodyScreenInput(cellobj.iRow, cellobj.iColumn, objMetaData);
        }

        if (bRuleReadOnly == true) {
            EntryMainRules.makeCellReadonly(cellobj, true);
        }

        if (bRuleMandatory == true) {
            EntryMainRules.makeCellMandatory(cellobj, true);
        }

        if (transEntryGlobal.m_bCellChangeDueToRule == false) {
            EntryMainRules.cellLeaveRule(cellobj, objMetaData);
        }

        return (bResult);
    },

    onEnter: function (cellobj, objMetaData, evt, objCustomData, objOutput) {
        let PreloadValue = 0;
        let bReadOnly = false;
        let bAutoSelectValue = false;
        let bQtyRestricted = false;
        let element = null;
        let iValue = 0;
        let objTemp = null;
        let autoSelectValue = null;
        let objRuleFilter = null;
        let objUserData = null;

        try {
            if (transEntryGlobal.debugBodyField == objMetaData.iFieldId) {
                debugger
            }

            if (EntryMainBody.isRowReadOnly(cellobj.iRow, false, objMetaData.iFieldId) == true) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }
            else if (EntryMainUI.isFreeRow(cellobj.iRow) == true) {
                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_BODYBATCHNO:
                    case eVTFIELDID.FDF_RMANO:
                    case eVTFIELDID.FDF_BINS:
                    case eVTFIELDID.FDF_BINS2:
                        break;
                    default:
                        if (objMetaData.iFieldId == transEntryFieldInfo.TaxCode.FieldId) {
                            break;
                        }

                        cellobj.processDefault(evt, false, true);
                        return (false);
                }
            }
            else if (DataType.arrayContains(EntryMainUI.m_SaudiRestriction, objMetaData.iFieldId) > -1) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }
            else if (EntryMainUI.isReservationRestrictd(cellobj.iRow, objMetaData.iFieldId) == true) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }
            else if (EntryMainUI.isLinkRestrictd(cellobj.iRow, objMetaData.iFieldId, true).Value == true) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }
            else if (EntryMainUI.isBillStatusRestricted(cellobj.iRow, objMetaData.iFieldId, objMetaData) == true) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }


            if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true || objMetaData.iFieldId == 0) {
                cellobj.processDefault(evt, false, true);
                return (false);
            }

            cellobj.makeCellVisible();

            bReadOnly = objMetaData.bReadOnly;
            if (bReadOnly == false) {
                bReadOnly = EntryMainRules.isRuleReadOnlyColumn(cellobj) == 1;
            }

            //if (EntryMainBody.isRowEditable(cellobj.iRow, true) == true || EntryMainBody.isColumnEditable(cellobj.iRow, cellobj.iColumn) == true) {
            //    if (EntryMainProductionProcess.stopEvaluate(objMetaData, cellobj.iRow) == false) {
            //        PreloadValue = EntryMainFormula.evaluateCellFormula(cellobj, objMetaData, objMetaData.bMandatory);
            //    }
            //    else {
            //        PreloadValue = DataType.toString(cellobj.getCellData());
            //    }
            //}

            if (objMetaData.bHidden == true) {
                objTemp = EntryMainBody.hasVariable(objMetaData);
                if (objTemp.bRefresh == false) {
                    objTemp = EntryMainBody.hasFormula(objMetaData);
                    if (objTemp.bRefresh == false) {
                        EntryMainRules.cellEnterRule(cellobj, objMetaData);
                        cellobj.processDefault(evt, false, true);
                        return;
                    }
                }
            }

            if (EntryMainSet.isEditableColumn(cellobj) == false) {
                cellobj.processDefault(evt, false, true);

                return (false);
            }

            if (transEntryGlobal.m_bCellChangeDueToRule == false) {
                EntryMainRules.cellEnterRule(cellobj, objMetaData);
                transEntryGrid.setCurrentRow(cellobj.iRow);
                transEntryGrid.setCurrentColumn(cellobj.iColumn);
            }

            if (EntryMainBody.isColumnEditable(cellobj.iRow, cellobj.iColumn) == false) {
                if (EntryMainBody.isRowEditable(cellobj.iRow, true) == false && EntryMainBody.isRequiredColumnHidden() == false) {
                    if (objMetaData.iDataTypeId == eMasterDataType.Boolean) {
                        FUIElement.removeChild(cellobj.cell);
                    }

                    cellobj.clear();
                    transEntryGrid.makeCellReadonly(cellobj, objMetaData.bReadOnly);

                    cellobj.processDefault(evt, false, true);
                    return (false);
                }
            }

            if (EntryMainBody.isRowEditable(cellobj.iRow, true) == true || EntryMainBody.isColumnEditable(cellobj.iRow, cellobj.iColumn) == true) {
                if (EntryMainProductionProcess.stopEvaluate(objMetaData, cellobj.iRow) == false) {
                    PreloadValue = EntryMainFormula.evaluateCellFormula(cellobj, objMetaData, objMetaData.bMandatory);
                }
                else {
                    PreloadValue = DataType.toString(cellobj.getCellData());
                }
            }

            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.HyperLink:
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue);
                    break;
                case eMasterDataType.Master:
                    if (transEntryGlobal.debugMaster == true) {
                        debugger
                    }

                    bAutoSelectValue = false;
                    if (bReadOnly == false) {
                        autoSelectValue = EntryMainBody.getAutoSelectMasterValue(cellobj, DataType.toInt(PreloadValue), objMetaData, evt);
                        if (DataType.isValidObject(autoSelectValue) == true) {
                            PreloadValue = autoSelectValue;
                            bAutoSelectValue = true;
                        }
                    }

                    PreloadValue = DataType.toInt(PreloadValue);
                    EntryMainMaster.updateOptionFilter(objMetaData, cellobj.iRow, PreloadValue);

                    if (EntryMainBody.onMasterEnter(cellobj, PreloadValue, objMetaData, bAutoSelectValue, evt) == false) {
                        cellobj.clear();

                        cellobj.processDefault(evt, false, true);

                        return (false);
                    }

                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.ExternalTable:
                    if (transEntryGlobal.debugMaster == true) {
                        debugger
                    }

                    EntryMainMaster.updateOptionFilter(objMetaData, cellobj.iRow, DataType.toInt(PreloadValue));

                    objUserData = {};
                    objUserData.iRow = cellobj.iRow;
                    objUserData.iColumn = cellobj.iColumn;
                    OPTIONCONTROL.setUserData(cellobj.ColumnAttribute.ctrlid, DataType.toString(objUserData));

                    iValue = DataType.toInt(cellobj.getCellData());
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);

                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Date:
                    iValue = DataType.toInt(PreloadValue);
                    switch (objMetaData.iFieldId) {
                        case eVTFIELDID.FDF_MFGDATE:
                            if (transEntryGrid.isBatchInputRequired(cellobj.iRow) == false) {
                                if (EntryMainProductionProcess.isIssueRow(cellobj.iRow) == false) {
                                    cellobj.clear();
                                }
                                else if (iValue > 0) {
                                    DATEPICKER.setDate(cellobj.ColumnAttribute.ctrlid, iValue);
                                }

                                cellobj.processDefault(evt, false, true);
                                return;
                            }

                            if (transEntryFields.isRequired(eVTFIELDID.FDF_MFGDATE, cellobj.iRow) == false) {
                                cellobj.processDefault(evt, false, true);
                                return;
                            }

                            break;
                        case eVTFIELDID.FDF_EXPDATE:
                            if (transEntryGrid.isBatchInputRequired(cellobj.iRow) == false) {
                                if (EntryMainProductionProcess.isIssueRow(cellobj.iRow) == false) {
                                    cellobj.clear();
                                }
                                else if (iValue > 0) {
                                    DATEPICKER.setDate(cellobj.ColumnAttribute.ctrlid, iValue);
                                }

                                cellobj.processDefault(evt, false, true);
                                return;
                            }

                            if (transEntryFields.isRequired(eVTFIELDID.FDF_EXPDATE, cellobj.iRow, true) == false) {
                                cellobj.processDefault(evt, false, true);
                                return;
                            }
                            break;
                        case eVTFIELDID.FDF_BODYDUEDATE:
                            if (iValue == 0) {
                                iValue = transEntryDueDate.calculateDueDate(transEntryDueDate.getStartDate(), EntryMain.m_iDueDateType, EntryMain.m_iDueDateValue);
                            }
                            break;
                    }

                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Time:
                    iValue = DataType.toInt(PreloadValue);
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue);

                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Fraction:
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYQUANTITY && EntryMainUI.isQtyRestricted(cellobj.iRow) == true) {
                        PreloadValue = 1;
                        bQtyRestricted = true;
                    }
                    EntryMainBody.onFractionEnter(cellobj, objMetaData, evt, PreloadValue, bReadOnly, objOutput);

                    if (bQtyRestricted == true) {
                        cellobj.processDefault(evt, false, true);
                        return;
                    }
                    break;
                case eMasterDataType.StringList:
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue, objMetaData.bMandatory);
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.NumberList:
                    objRuleFilter = transEntryGridRuleFilter.getColumnFilterRuleValue(cellobj.iRow, cellobj.iColumn);
                    if (DataType.isValidObject(objRuleFilter.Value) == true) {
                        cellobj.setControl(cellobj.ColumnAttribute.ctrlid, DataType.toInt(objRuleFilter.Value));
                    }
                    else {
                        if (DataType.isNullOrEmpty(PreloadValue) == true) {
                            cellobj.setControl(cellobj.ColumnAttribute.ctrlid, undefined, objMetaData.bMandatory);
                        }
                        else {
                            cellobj.setControl(cellobj.ColumnAttribute.ctrlid, DataType.toInt(PreloadValue));
                        }
                    }
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Text:
                    EntryMainBody.onTextEnter(cellobj, objMetaData, evt, PreloadValue, bReadOnly, objOutput, objCustomData);
                    break;
                case eMasterDataType.Boolean:
                    EntryMainBody.initBooleanColumn(cellobj, DataType.toBoolean(objMetaData.sDefaultValue), bReadOnly);
                    element = cellobj.getControl();
                    FUIElement.setFocus(element);
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                case eMasterDataType.Picture:
                case eMasterDataType.DocumentViewer:
                    PreloadValue = {};
                    PreloadValue.sFileName = cellobj.getCellText();
                    PreloadValue.sData = cellobj.getCellData();
                    PreloadValue.iDataSource = DataType.toInt(cellobj.getCellData("datasource"));

                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue);
                    objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
                    break;
                default:
                    cellobj.processDefault(evt, false, true);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onEnter method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    cellDataSet: function (obj) {
        let iIndex = 0;
        let objMetaData = null;

        try {
            if (EntryMain.isDataLoading() == true) {
                return;
            }

            iIndex = DataType.toInt(obj.Cell.ColumnAttribute.metadataindex);
            objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
            if (DataType.isValidObject(objMetaData) == false) {
                return;
            }

            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                case eMasterDataType.BigNumber:
                    break;
                case eMasterDataType.Fraction:
                    if (DataType.isValidObject(obj.OldValue) == false) {
                        break;
                    }

                    if (FConvert.toDecimal(obj.OldValue, objMetaData.iNoDecimal, true) != FConvert.toDecimal(obj.Value, objMetaData.iNoDecimal, true)) {
                        EntryMainUI.resetCOGSDetail();
                    }
                    break;
                case eMasterDataType.Date:
                case eMasterDataType.Time:
                    if (obj.Key == "data-value" && DataType.toInt(obj.OldValue) != DataType.toInt(obj.Value)) {
                        EntryMainUI.resetCOGSDetail();
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body cellDataSet method.", GlobalPref.getResourceValue("Exception"))
            transEntryGlobal.writeErrorLog("{EntryMainBody.cellDataSet} " + err.message, GlobalPref.getResourceValue("Exception"))
        }
    },

    handleReadOnlyFieldsForEnterCell: function (cellobj, bReadOnly, evt) {
        try {
            if (bReadOnly == true) {
                if (DataType.isValidObject(cellobj.cell) == true
                    && cellobj.cell.children.length > 0
                    && cellobj.cell.children[0].nodeName.toLowerCase() == "textarea"
                    && DataType.isValidObject(evt) == true
                    && DataType.toString(evt.type) == "click"
                    && EntryMainRules.isRuleReadOnlyColumn(cellobj) != 1) {
                    return (false);
                }

