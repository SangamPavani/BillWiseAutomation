                            tbody += "<td>" + (tableLinkBodyData[i].CellData[fieldId] != null ? tableLinkBodyData[i].CellData[fieldId] : tableLinkBodyData[i].CellData[fieldId]) + "</td>";
                            break;
                        case "6":
                            tbody += "<td>" + (tableLinkBodyData[i].CellData[fieldId] ? "Close" : "Open") + "</td>";
