                arrBRDetails[iCount].BatchQty = (newReservationModel[SelectedIndex]).BatchList[iCount].BatchQty;
                arrBRDetails[iCount].DocumentId = (newReservationModel[SelectedIndex]).BatchList[iCount].DocumentId;
                arrBRDetails[iCount].ExpDate = (newReservationModel[SelectedIndex]).BatchList[iCount].ExpDate;
                arrBRDetails[iCount].FullFillTransId = (newReservationModel[SelectedIndex]).BatchList[iCount].FullFillTransId;
                arrBRDetails[iCount].InvTagId = (newReservationModel[SelectedIndex]).BatchList[iCount].InvTagId;
                arrBRDetails[iCount].InvTagName = (newReservationModel[SelectedIndex]).BatchList[iCount].InvTagName;
                arrBRDetails[iCount].IsReserveOrRelease = (newReservationModel[SelectedIndex]).BatchList[iCount].IsReserveOrRelease;
                arrBRDetails[iCount].MfgDate = (newReservationModel[SelectedIndex]).BatchList[iCount].MfgDate;
                arrBRDetails[iCount].ReservedQty = (newReservationModel[SelectedIndex]).BatchList[iCount].ReservedQty;
                arrBRDetails[iCount].ReleasedQty = 0;
                arrBRDetails[iCount].ReserveQty = 0;
                arrBRDetails[iCount].AlreadyReserved = 0;
                arrBRDetails[iCount].AlreadyReleased = 0;
                arrBRDetails[iCount].BalanceQty = 0;
            }
            for (var i = 0; i < newReservationModel.length; i++) {
                if (newReservationModel[i].ReserveType == 3 && newReservationModel[i].ReserveByBatch == true && newReservationModel[i].ReserveByBin == false && newReservationModel[i].ReserveByRMA == false) {
                    for (var j = 0; j < (newReservationModel[i]).BatchList.length; j++) {
                        for (var iSL = 0; iSL < arrBRDetails.length; iSL++) {
                            if (i != SelectedIndex) {
                                if (arrBRDetails[iSL].InvTagId == (newReservationModel[i]).BatchList[j].InvTagId && arrBRDetails[iSL].FullFillTransId == (newReservationModel[i]).BatchList[j].FullFillTransId) {
                                    arrBRDetails[iSL].AlreadyReserved = arrBRDetails[iSL].AlreadyReserved + (newReservationModel[i]).BatchList[j].ReserveQty;
                                    arrBRDetails[iSL].AlreadyReleased = arrBRDetails[iSL].AlreadyReleased + (newReservationModel[i]).BatchList[j].ReleasedQty;
                                }
                                if (arrBRDetails[iSL].InvTagId == (newReservationModel[i]).BatchList[j].InvTagId && arrBRDetails[iSL].FullFillTransId == (newReservationModel[i]).BatchList[j].FullFillTransId && arrBRDetails[iSL].DocumentId == (newReservationModel[i]).BatchList[j].DocumentId) {
                                    // arrBRDetails[iSL].AlreadyReleased = arrBRDetails[iSL].AlreadyReleased + (newReservationModel[i]).BatchList[j].ReleasedQty;
                                }
                            }
                            else {
                                if (arrBRDetails[iSL].InvTagId == (newReservationModel[i]).BatchList[j].InvTagId && arrBRDetails[iSL].FullFillTransId == (newReservationModel[i]).BatchList[j].FullFillTransId && arrBRDetails[iSL].DocumentId == (newReservationModel[i]).BatchList[j].DocumentId) {
                                    arrBRDetails[iSL].ReserveQty = arrBRDetails[iSL].ReserveQty + (newReservationModel[i]).BatchList[j].ReserveQty;
                                    arrBRDetails[iSL].ReleasedQty = arrBRDetails[iSL].ReleasedQty + (newReservationModel[i]).BatchList[j].ReleasedQty;
                                }
                            }
                        }
                    }
                }
            }
            for (var i = 0; i < arrBRDetails.length; i++) {
                if (arrBRDetails[i].BatchQty < 0) {
                    arrBRDetails[i].BatchQty = 0;
                }
                arrBRDetails[i].BalanceQty = arrBRDetails[i].BatchQty + arrBRDetails[i].ReleasedQty + arrBRDetails[i].AlreadyReleased - arrBRDetails[i].ReservedQty - arrBRDetails[i].AlreadyReserved;
            }
            (newReservationModel[SelectedIndex]).BatchList = arrBRDetails;
            RESERVATION.SetDataByBatch(newReservationModel[SelectedIndex].BatchList);
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.AssignBatchReservedValue} " + err.message, "Exception")
        }
