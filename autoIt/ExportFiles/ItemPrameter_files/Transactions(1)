        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.callbackCreateVoucher} " + err.message, "Error");
        }
    },

    deleteVoucher: function () {
        //debugger;
        let iVoucherType = 0;
        let iParentVoucherType = 0;

        try {
            if (FCommon.UI.isValidObject(DocCustomizationProp.SelectedVoucher) == false) {
                COMMON.prototype.showMessage("Please select any base voucher type", "Error");
                return;
            }

            if (DocCustomizationProp.SelectedVoucher.getAttribute('data-vOrder') < 39) {
                return;
            }

            if (confirm("Are you sure that you want to delete this document?") == false) {
                return;
            }

            iVoucherType = FConvert.toInt(DocCustomizationProp.SelectedVoucher.id);
            iParentVoucherType = $('#docCustomizationUL').find('#' + iVoucherType).attr('data-parentID');

            if (DocCustomizationProp.SelectedVoucher.dataset.isParent != "true") {
                NETWORK.executeServerMethod(GLOBAL.getContextPath("DeleteDocVoucher", "ConfigureTrans", "TranSettings"),
