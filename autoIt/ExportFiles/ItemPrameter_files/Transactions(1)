    removeDuplicateItemIfRequired: function () {
        let iRow = 0;
        let iIndex = 0;
        let iProductId = 0;
        let bFound = false;

        try {
            if (transEntryFieldInfo.Item.FieldId == 0) {
                return (false);
            }

            if (transEntrySettings.isRestrictItemFromBeingRepeated == false) {
                return (false);
            }

            for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                iProductId = EntryMainMemoryObject.getProductValue(iRow);
                if (iProductId <= 0) {
                    continue;
                }

                iIndex = EntryMainCalculation.isProductUsed(iProductId, iRow);
                if (iIndex <= 0) {
                    continue;
                }

                transEntryGrid.deleteRows(iIndex, 1);
                EntryMainMemoryObject.deleteRowData(iIndex, 1);

                iRow--;

                bFound = true;
            }

            if (bFound == true) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDuplicateItem") + ". " + GlobalPref.getResourceValue("msgDuplicateItemAsSetting") + ".");
