    getFormulaDetail: function (sValue) {
        let bFormula = false;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;
            result.bRefresh = false;

            if (DataType.isNullOrEmpty(sValue) == false) {
                if (DataType.stringStartsWithRaw(sValue, "&") == true) {
                    bRefresh = true;
                }

                if (DataType.stringIncludesRaw(sValue, "#") == true) {
                    if (DataType.stringStartsWithRaw(sValue, "&") == true) {
                        if (sValue.length > 1 && sValue[1] == "#") {
                            bFormula = true;
                        }
                    }
                    else {
                        if (sValue[0] == "#") {
                            bFormula = true;
                        }
                    }

                    if (bFormula == true) {
                        result.lValue = 1;
                        result.bRefresh = DataType.stringStartsWithRaw(sValue, "&");
                        result.data = sValue.substr(result.bRefresh == true ? 2 : 1);
                    }
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
            transEntryGlobal.showAlert("{EntryMainCommon.getFormulaDetail} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    hasAutoRefresh: function (sPreload, sDefaultValue) {
        let bRefresh = false;
        let result = null;

        try {
            if (DataType.isNullOrEmpty(sPreload, true) == false) {
                bRefresh = DataType.stringStartsWithRaw(sPreload, "&");
            }
            else {
                result = EntryMainCommon.getFormulaDetail(sDefaultValue);
                if (result.lValue > 0 && result.bRefresh == true) {
                    bRefresh = true;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCommon.hasAutoRefresh} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bRefresh);
    },

