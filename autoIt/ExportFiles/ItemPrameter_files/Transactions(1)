    getValue: function (iFieldId, iRow) {
        let sId = "";
        let iCounter = 0;
        let iValue = 0;
        let arrFields = undefined;
        let objMetaData = null;
        let cell = null;

        try {
            iRow = DataType.toInt(iRow);
            if (iRow < 0) { // Footer
                sId = EntryMainUI.getFooterControlId(iFieldId);
                iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
            }
            else if (iRow == 0) { // Header
                if (EntryMainMaster.isInfoField(iFieldId, true) == true) {
                    return (0);
                }

                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                    if (objMetaData.iFieldId != iFieldId) {
                        continue;
                    }

                    if (objMetaData.iDataTypeId != eMasterDataType.Master) {
                        break;
                    }

                    sId = EntryMainUI.getHeaderControlId(iFieldId);
                    iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                }
            }
            else { // Body
                if (EntryMainMaster.isInfoField(iFieldId, false) == true) {
                    return (0);
                }

                arrFields = transEntryFieldInfo.getBodyFields();
                if (transEntryInfo.BodySectionNotRequired == true) {
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.iFieldId != iFieldId) {
                            continue;
                        }

                        if (objMetaData.iDataTypeId != eMasterDataType.Master) {
                            break;
                        }

                        sId = EntryMainUI.getBodyControlId(iFieldId);
                        iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        break;
                    }
                }
                else {
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.iFieldId != iFieldId) {
                            continue;
                        }

                        if (objMetaData.iDataTypeId != eMasterDataType.Master) {
                            break;
                        }

                        cell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                        if (DataType.isValidObject(cell) == true) {
                            iValue = DataType.toInt(cell.getCellData());
                        }

                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainMaster.getValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (iValue);
    },

