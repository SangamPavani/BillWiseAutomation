    callbackCreateVoucher: function (bSuccess, html, tag) {
        try {
            if (bSuccess == false) {
                return;
            }

            if (Array.isArray(html)) {
                COMMON.prototype.showMessage(html[0].Name, "Error");
                return;
            }
            $(document.getElementById("docCustomizationUL")).html(html);
            if (document.getElementById("doc_Searchbox").value != "" && tag == true) {
                DocCustomization.searchVoucher(document.getElementById("doc_Searchbox"));
            }

            if (tag == false) {
                DocCustomizationProp.SelectedVoucher = null;
            }
            else {
                GLOBAL.RefreshMenu(true);
