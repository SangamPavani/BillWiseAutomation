                case eTranEntryFormulaBehaviourBody.PercentageOnNet: // 2 (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                    dTempGross = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross;
                    for (iCounter1 = 0; iCounter1 < iScreenColIndex; iCounter1++) {
                        objMetaDataPrev = transEntryScreenData.getBodyMetaDataFromIndex(iCounter1);
                        cellTemp = transEntryGrid.getCellElement(iRow, transEntryGlobal.FieldHelper.Column.Screen[iCounter1], true);
