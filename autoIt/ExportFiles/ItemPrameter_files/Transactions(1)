    checkAndEvaluateHeaderFormula: function (objMetaData, bOnlyAmp, sCallback) {
        let sId = "";
        let iAccountTypeId = 0;
        let result = undefined;

        try {
            result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);
            if (result.lValue < 1) {
                return (false);
            }

            if (bOnlyAmp == true && result.bRefresh == false) {
                return (false);
            }

            if (result.bRefresh == true) {
                result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);

                if (objMetaData.iDataTypeId == eMasterDataType.Fraction && objMetaData.iNoDecimal > 0) {
                    result.data = FNumberOperation.convert(result.data, objMetaData.iNoDecimal);
                }

                EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                EntryMainMemoryObject.update(objMetaData.iFieldId, result.data, 0, objMetaData);
                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_CODE:
                    case eVTFIELDID.FDF_BODYCODE:
                        sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                        iAccountTypeId = OPTIONCONTROL.getControlValue(sId, "iAccountTypeId");
                        EntryMainMemoryObject.updateCodeAccountType(iAccountTypeId, 0);
                        break;
                    case eVTFIELDID.FDF_BOOKNO:
                    case eVTFIELDID.FDF_BODYBOOKNO:
                        sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                        iAccountTypeId = OPTIONCONTROL.getControlValue(sId, "iAccountTypeId");
                        EntryMainMemoryObject.updateBookAccountType(iAccountTypeId, 0);
                        break;
                }

                return (true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.checkAndEvaluateHeaderFormula} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    checkAndSetCurrencyExtraFilter: function () {
        let sId = "";
        let iCurrencyId = 0;
        let iLastCurrencyId = 0;
        let bCurrencyChanged = false;
        let objExtra = undefined;

        try {
            if (transEntryFieldInfo.FATag.Area != eTranEntryFieldArea.Header) {
                return;
            }

            if (EntryMainUI.isCurrencyChangeRequired(0, undefined, undefined) == false) {
                iCurrencyId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, 0, "iDefaultCurrency", eMasterDataType.Number);
            }
            else {
                iCurrencyId = transEntryFields.getMandatoryValue(transEntryFieldInfo.FATag, 0, "iCurrencyId", eMasterDataType.Number);
            }

            //iCurrencyId = transEntryFields.getMandatoryValue(transEntryFieldInfo.FATag, 0, "iCurrencyId", eMasterDataType.Number);
            if (transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header) {
                iLastCurrencyId = transEntryFields.getCurrency(0);
                bCurrencyChanged = DataType.neq(iCurrencyId, iLastCurrencyId);

                if (transEntryInfo.MiscellaneousPref.iFilterCurrencyBasedOnFATag > 0) {
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERCURRENCY);
                    if (iCurrencyId > 0) {
                        OPTIONCONTROL.setExtraFilter(sId, "iCurrencyId in (" + transEntryInfo.DefaultCurrencyId + "," + iCurrencyId + ")");
                        objExtra = OPTIONCONTROL.createSetValueExtraObject();
                        objExtra.bIgnoreChangeCallback = true;
                        OPTIONCONTROL.setValue(sId, iCurrencyId, null, objExtra);
                    }
                    else {
                        OPTIONCONTROL.setExtraFilter(sId, "");
                    }
                }

                if (transEntryInfo.MiscellaneousPref.iEnableLocalCurrency > 0) {
                    if (iCurrencyId > 0
                        && transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Header
                        && bCurrencyChanged == true) {
                        OPTIONCONTROL.setValue(EntryMainUI.getElement(transEntryFieldInfo.Currency, 0).Value, iCurrencyId);
                    }
                }

                if(iCurrencyId > 0 && bCurrencyChanged == true) {
                    transEntryExchangeRate.update();
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.checkAndSetCurrencyExtraFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onSelectFile: function (id, file, evt) {
        let sExt = "";
        let iFieldId = 0;
        let bValid = false;
        let objFieldInfo = undefined;

        try {
            iFieldId = EntryMainUI.extractHeaderFieldId(id.id);
            if (iFieldId == 0) {
                return (false);
            }

            objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId);
            if (objFieldInfo.Area != eTranEntryFieldArea.Header) {
                return (false);
            }

            bValid = true;
            if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Picture) {
                sExt = FCommon.Files.getExtensionFromName(file.name);
                sExt = sExt.toLowerCase();
                if (DataType.isNullOrEmpty(sExt) == true) {
                    bValid = false;
                }
                else if (sExt != "gif" && sExt != "bmp" && sExt != "png" && sExt != "jpg" && sExt != "jpeg" && sExt != "ico") {
                    bValid = false;
                }

                if (bValid == false) {
                    transEntryGlobal.showAlert("Only (.gif, .bmp, .png, .jpg, .jpeg, .ico) extension type files allowed.", GlobalPref.getResourceValue("Error"));
                }
            }

            EntryMain.setDirty();
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onSelectFile} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bValid);
    },

