            iMaskedVoucherType = transEntryInfo.BaseVoucherType;

            if (iMaskedVoucherType == eVTTYPE.CASHP
                || iMaskedVoucherType == eVTTYPE.CASHR
                || iMaskedVoucherType == eVTTYPE.MEMOR
                || iMaskedVoucherType == eVTTYPE.MEMOP
                || iMaskedVoucherType == eVTTYPE.JOURN
                || iMaskedVoucherType == eVTTYPE.NJOURN
                || iMaskedVoucherType == eVTTYPE.DEBNT
                || iMaskedVoucherType == eVTTYPE.CRDNT
                || iMaskedVoucherType == eVTTYPE.PETIC) {

                if (DataType.arrayLength(arrTaxRates) < 1) {
                    return (0);
                }

                arrRate = DataType.arrayFilterData(arrTaxRates,
                    ["Jurisdiction", "Place"],
                    [iJurisdictionId, iPlaceOfSupplyId], "==");
                if (arrRate.length == 0) {
                    return (0);
                }

                if (iMaskedVoucherType == eVTTYPE.DEBNT || iMaskedVoucherType == eVTTYPE.CRDNT) {
                    if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                        temp = transEntryVat.getReverseCharge(0);
                        if (DataType.isValidObject(temp) == false) {
                            return (0);
                        }

                        if (DataType.isNullOrEmpty(temp) == false && DataType.toInt(temp) == 0) {
                            temp = transEntryVat.getTRN(0);
                            if (DataType.isValidObject(temp) == false) {
                                return (0);
                            }
                        }
                    }
                }

                return (arrRate[0].Prec);
            }

            iTaxCategory = eTaxCategory.Taxable;

            if (transEntryFieldInfo.Item.FieldId > 0) {
                temp = EntryMainMaster.getItemTaxCategory(iRow);
                if (DataType.isValidObject(temp) == false || DataType.isNullOrEmpty(temp) == true) {
                    return (0);
                }

                iTaxCategory = DataType.toInt(temp);

                // 17 (RCM Sales)
                // 18 (Standard Rated Purchase - Recoverable)
                // 31 (SR-RADJ)
                if ((iTaxCode == 17 || iTaxCode == 18 || iTaxCode == 31) && iTaxCategory == eTaxCategory.Taxable) {
                    if (DataType.arrayLength(arrRate) > 0) {
                        for (iCounter = 0; iCounter < arrRate.length; iCounter++) {
                            if (arrRate[iCounter].TaxCat == iTaxCategory) {
                                return (arrRate[iCounter].Perc);
                            }
                        }
                    }

                    return (dVatPer);
                }
            }
            else {
                return (0);
            }

            bPur = false;
            if (transEntryInfo.isItSales == true
                && ((transEntryInfo.isInwardVoucher == true && iMaskedVoucherType != eVTTYPE.SARET)
                    || iMaskedVoucherType == eVTTYPE.PURET)) {
                if (iTaxCode == 19) { // Standard Rated Purchase - Non-Recoverable
                    return (dVatPer);
                }

                bPur = true;
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    temp = transEntryVat.getReverseCharge(0);
                    if (DataType.isValidObject(temp) == false) {
                        return (0);
                    }

                    if (DataType.toInt(temp) == 1) {
                        if (transEntryFieldInfo.PermitNo.Area == eTranEntryFieldArea.Header) {
                            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.PermitNo.FieldId);
                            if (DataType.isNullOrEmpty(document.getElementById(sId).value) == false) {
                                if (iTaxCategory == eTaxCategory.Taxable) {
                                    return (dVatPer); // IC
                                }
                                else {
                                    return (0);
                                }
                            }
                        }

                        if (iTaxCategory == eTaxCategory.Zero) { // Zero Rated Product
                            return (0);
                        }
                        else if (iTaxCategory == eTaxCategory.Exempted) { // Exempted
                            return (0);
                        }
                    }
                }
            }

            if (DataType.arrayLength(arrTaxRates) < 1) {
                return (0);
            }

            iTaxCode = transEntryFields.getTaxCode(iRow);

            arrRate = DataType.arrayFilterData(arrTaxRates,
                ["Jurisdiction", "Place", "TaxCat", "TaxCode", "Type"],
                [iJurisdictionId, iPlaceOfSupplyId, iTaxCategory, iTaxCode, eVatTaxCodeVoucherType.All],
                "=="); // First check for all types
            if (arrRate.length == 0) {
                if (bPur == true && iTaxCode == 18) // Standard Rated Purchase - Recoverable
                    arrRate = DataType.arrayFilterData(arrTaxRates,
                        ["Jurisdiction", "Place", "TaxCat", "TaxCode", "Type"],
                        [iJurisdictionId, iPlaceOfSupplyId, iTaxCategory, 1, eVatTaxCodeVoucherType.All],
                        "=="); // 1 Std Rate

                if (arrRate.length > 0)
                    return (arrRate[0].Perc);

                if (bPur == true) {
                    Type = eVatTaxCodeVoucherType.Purchase;
                }
                else {
                    Type = eVatTaxCodeVoucherType.Sales;
                }

                arrRate = DataType.arrayFilterData(arrTaxRates,
                    ["Jurisdiction", "Place", "TaxCat", "TaxCode", "Type"],
                    [iJurisdictionId, iPlaceOfSupplyId, iTaxCategory, iTaxCode, Type], "==");

                if (arrRate.length == 0) {
                    if (bPur == true && iTaxCode == 18) // Standard Rated Purchase - Recoverable
                        arrRate = DataType.arrayFilterData(arrTaxRates,
                            ["Jurisdiction", "Place", "TaxCat", "TaxCode", "Type"],
                            [iJurisdictionId, iPlaceOfSupplyId, iTaxCategory, 1, Type], "=="); // 1 Std Rate
                }
                if (arrRate.length == 0) {
                    return (0);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.getVatRate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrRate[0].Perc);
