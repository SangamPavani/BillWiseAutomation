    onDownload: function (bSuccess, data) {

        try {
            if (objEmailOption != null)
                objEmailOption.MailAttachments = [];
            arrAttachment = [];
            if (data != null) {
                if (data.Tag != null && data.Tag.length > 0) {

                    var multiDoc = true;
                    if (FCommon.UI.isValidObject(m_arrHeaderIds) == true) {
                        multiDoc = m_arrHeaderIds.length == 1;
                    }
                    if (FCommon.isFirefox() == true) {
                        multiDoc = false;
                    }

                    if (data.Name != null && data.Name == "pdf") {
                        var binaryString = window.atob(data.Tag);
                        var binaryLen = binaryString.length;
                        var bytes = new Uint8Array(binaryLen);
                        for (var i = 0; i < binaryLen; i++) {
                            var ascii = binaryString.charCodeAt(i);
                            bytes[i] = ascii;
                        }
                        var blob = new Blob([bytes], { type: "application/pdf" });
                        var link = window.URL.createObjectURL(blob);
                        //var iWidth = window.screen.availWidth;
                        //var iHeight = window.screen.availHeight;
                        if (multiDoc) {
                            let eleContainer = FWrapper.getExternalModuleContainer(true);
                            eleContainer.src = link + "#zoom=100&scrollbar=0&toolbar=0&navpanes=0";
                            eleContainer.style.display = "block";
                            eleContainer.onload = function (event) {
                                this.style.height = "80%";
                                if (eleContainer.style.display == "none") {
                                    return;
                                }
                                this.contentWindow.MyFunc = function () {
                                    FWrapper.closePopup();
                                };

                                $(this.contentDocument.body).on("contextmenu", function () {
                                    return false;
                                });

