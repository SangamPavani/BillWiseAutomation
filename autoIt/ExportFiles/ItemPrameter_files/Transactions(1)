    processLayoutVariables: function (objVar, iFactor, iRowIndex) {
        let value = "";
        let iTotalRows = 0;
        let iRow = 0;
        let cell = null;
        let objLayout = undefined;
        let result = null;
        let obj = null;

        try {
            result = {};
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            obj = EntryMainPreload.isLayoutVarible(objVar.Var);
            if (obj.bBody == true)  { // Layout Body Field
                result.lValue = 1;
                result.data = 0;

                objLayout = transEntryFieldInfo.getFromFieldOrder(obj.iFieldOrder, true);
                if (objLayout.FieldId > 0) {
                    cell = transEntryGrid.getCellObject(iRowIndex, objLayout.ColumnIndex);
                    switch (objLayout.MetaData.iDataTypeId) {
                        case eMasterDataType.Number:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                        case eMasterDataType.NumberList:
                            result.data = DataType.toInt(cell.getCellData()) * iFactor;
                            break;
                        case eMasterDataType.Fraction:
                            result.data = DataType.toDecimal(cell.getCellData()) * iFactor;
                            break;
                        case eMasterDataType.Text:
                        case eMasterDataType.StringList:
                            result.data = cell.getCellData();
                            break;
                        case eMasterDataType.Boolean:
                            result.data = DataType.toBoolean(cell.getCellData());
                            break;
                        case eMasterDataType.Date:
                        case eMasterDataType.Time:
                        case eMasterDataType.DateTime:
                            result.data = DataType.toInt(cell.getCellData()) * iFactor;
                            break;
                        case eMasterDataType.Master:
                        case eMasterDataType.ExternalTable:
                            result.data = DataType.toInt(cell.getCellData());
                            break;
                        default:
                            result.data = cell.getCellData();
                            break;
                    }
                }

                return (result);
            }


            if (obj.bBodyTotal == true) { // Layout Body Field
                result.lValue = 1;
                result.data = 0;

                objLayout = transEntryFieldInfo.getFromFieldOrder(obj.iFieldOrder, true);
                if (objLayout.FieldId > 0) {
                    iTotalRows = transEntryGrid.getTotalRows();
                    for (iRow = 1; iRow <= iTotalRows; iRow++) {
                        cell = transEntryGrid.getCellObject(iRow, objLayout.ColumnIndex);
                        if (DataType.isValidObject(cell) == false) {
                            continue;
                        }

                        switch (cell.MetaData.iDataTypeId) {
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                            case eMasterDataType.NumberList:
                            case eMasterDataType.Fraction:
                                value = cell.getCellData();
                                if (DataType.isNullOrEmpty(value, true) == false) {
                                    result.data = FNumberOperation.add(result.data, value);
                                }
                                break;
                        }
                    }

                    if (result.data != 0) {
                        result.data *= iFactor;
                    }
                }

                return (result);
            }

            if (obj.bHeader == true) { // Layout Header Field
                result.lValue = 1;
                result.data = 0;

                objLayout = transEntryFieldInfo.getFromFieldOrder(obj.iFieldOrder, false);
                if (objLayout.FieldId > 0) {
                    result = FCommon.UI.getElementValueBasedOnDataTypeId(EntryMainUI.getHeaderControlId(objLayout.FieldId), objLayout.MetaData.iDataTypeId);
                    if (result.lValue <= 0) {
                        result.lValue = 1;
                        result.data = 0;
                    }
                    else {
                        switch (objLayout.MetaData.iDataTypeId) {
                            case eMasterDataType.Number:
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                            case eMasterDataType.Fraction:
                            case eMasterDataType.NumberList:
                            case eMasterDataType.Date:
                                result.data *= iFactor;
                                break;
                            case eMasterDataType.Boolean:
                                result.data = result.data == true ? 1 : 0;
                                break;
                        }
                    }
                }

                return (result);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainPreload.processLayoutVariables} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    isMasterVariable: function (sVar) {
        let arrVar = undefined;
        let objResult = undefined;
        let obj = undefined;

        try {
            objResult = {};
            objResult.Value = false;
            objResult.Error = "";
            objResult.bBook = false;
            objResult.iMasterType = 0;
            objResult.bInv2 = false;
            objResult.sVariable = "";
            objResult.Layout = "";
            objResult.bBody = false;
            objResult.iFieldOrder = -1;

            objResult.bBook = true;
            if (DataType.stringStartsWithRaw(sVar, "acc.") == true) {
                objResult.iMasterType = eMasterTypeId.Account;
                objResult.sVariable = sVar.substr(4);
                objResult.bBook = false;
            }
            else if (DataType.stringStartsWithRaw(sVar, "acc2.") == true) {
                objResult.iMasterType = eMasterTypeId.Account;
                objResult.sVariable = sVar.substr(5);
            }
            else if (DataType.stringStartsWithRaw(sVar, "wh1.") == true) {
                objResult.bInv2 = false;
                objResult.sVariable = sVar.substr(4);
                objResult.iMasterType = FConvert.getMasterTypeIdFromVariable(objResult.sVariable);
            }
            else if (DataType.stringStartsWithRaw(sVar, "wh2.") == true) {
                objResult.bInv2 = true;
                objResult.sVariable = sVar.substr(4);
                objResult.iMasterType = FConvert.getMasterTypeIdFromVariable(objResult.sVariable);
            }
            else {
                arrVar = sVar.split('.');
                if (DataType.arrayLength(arrVar) == 2
                    && DataType.isNullOrEmpty(arrVar[0], true) == false
                    && DataType.isNullOrEmpty(arrVar[1], true) == false) {

                    obj = EntryMainPreload.isLayoutVarible(arrVar[0]);
                    if (obj.Value == true && obj.bBodyTotal == false) {
                        objResult.Layout = arrVar[0];
                        objResult.bBody = obj.bBody;
                        objResult.iFieldOrder = obj.iFieldOrder;

                        sVar = arrVar[1];
                    }
                }
                objResult.iMasterType = FConvert.getMasterTypeIdFromVariable(sVar);
                objResult.sVariable = sVar;
            }

            if (objResult.iMasterType > 0) {
                objResult.Value = true;
            }
        }
        catch(err) {
            objResult.Value = false;
            objResult.Error = err.message;

            transEntryGlobal.writeErrorLog("{EntryMainPreload.isMasterVariable} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(objResult);
    },

