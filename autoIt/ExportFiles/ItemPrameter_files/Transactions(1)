    this.getIncrementalSuggestionText = function (iType, iFieldValue, iStartingChar, iNoOfChar) {
        var sValue = "";
        var objGlobal = null;
        var date = null;
        var arrMonthName = null;

        try {
            iType = FConvert.toInt(iType);
            iFieldValue = FConvert.toInt(iFieldValue);
            iStartingChar = FConvert.toInt(iStartingChar);
            iNoOfChar = FConvert.toInt(iNoOfChar);

            if (iType == 0) { // Login (max 2 char)
                if(iStartingChar < 0 || iStartingChar > 1) {
                    iStartingChar = 0;
                }

                if(iNoOfChar <= 0) {
                    iNoOfChar = 1;
                }
                else if (iNoOfChar > (2 - iStartingChar)) {
                    iNoOfChar = (2 - iStartingChar);
                }

                objGlobal = GLOBAL.getGlobalValue();
                switch (iFieldValue)
                {
                    case 0: // Login Name
                        sValue = objGlobal.UserName.substr(iStartingChar, iNoOfChar);
                        break;
                    case 1: // Login Abbriviation
                        sValue = objGlobal.LoginAbbr.substr(iStartingChar, iNoOfChar);
                        break;
                }
            }
            else if (iType == 1) { // Character Input (max 1 char)
                switch(iFieldValue)
                {
                    case 0: // /
                        sValue = "/";
                        break;
                    case 1: // -
                        sValue = "-";
                        break;
                    case 2: // *
                        sValue = "*";
                        break;
                    case 3: // _
                        sValue = "_";
                        break;
                    case 4: // Space
                        sValue = " ";
                        break;
                }
            }
            else if (iType == 2) { // Date
                objGlobal = GLOBAL.getGlobalValue();
                date = FDate.getTodayArray(objGlobal.CalendarType);

                switch(iFieldValue)
                {
                    case 0: // Day (max 2 char)
                        if (iStartingChar > 1) {
                            iStartingChar = 1;
                        }

                        if (iNoOfChar <= 0) {
                            iNoOfChar = 1;
                        }
                        else if (iNoOfChar > (2 - iStartingChar)) {
                            iNoOfChar = (2 - iStartingChar);
                        }

                        if (date[0] < 10) {
                            sValue = ("0" + FConvert.toString(date[0])).substr(iStartingChar, iNoOfChar);
                        }
                        else {
                            sValue = FConvert.toString(date[0]).substr(iStartingChar, iNoOfChar);
                        }
                        break;
                    case 1: // Month Name (max 3 char)
                        if (iStartingChar > 1) {
                            iStartingChar = 1;
                        }

                        if (iNoOfChar <= 0) {
                            iNoOfChar = 1;
                        }
                        else if (iNoOfChar > (3 - iStartingChar)) {
                            iNoOfChar = (3 - iStartingChar);
                        }

                        arrMonthName = FDate.getMonthNames(objGlobal.CalendarType, objGlobal.LanguageId);

                        sValue = arrMonthName[date[1] - 1].substr(iStartingChar, iNoOfChar);
                        break;
                    case 2: // Year (max 4 char)
                        if (iStartingChar > 3) {
                            iStartingChar = 3;
                        }

                        if (iNoOfChar <= 0) {
                            iNoOfChar = 1;
                        }
                        else if (iNoOfChar > (4 - iStartingChar)) {
                            iNoOfChar = (4 - iStartingChar);
                        }

                        sValue = FConvert.toString(date[2]).substr(iStartingChar, iNoOfChar);
                        break;
                    case 3: // Fiscal
                        break;
                }
            }
            else if (iType == 3) { // Increment
                if (iNoOfChar == 0) {
                    iNoOfChar = 1;
                }

                sValue = "000000000000000000000" + FConvert.toString(iFieldValue);
                sValue = DataType.stringRight(sValue, iNoOfChar);
            }
            else if (iType == 4) { // Decrement
                if (iNoOfChar == 0) {
                    iNoOfChar = 1;
                }

                sValue = "000000000000000000000" + FConvert.toString(iFieldValue);
                sValue = DataType.stringRight(sValue, iNoOfChar);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocLayoutField_Customization.getIncrementalSuggestionText} " + err.message, "Exception");
        }

        return (sValue);
    }
};

