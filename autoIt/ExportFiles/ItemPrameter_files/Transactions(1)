                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
