    getTreeDependencyData: function (iRow, iFieldId) {
        let iCounter = 0;
        let iIndex = -1;
        let arrData = null;
        let obj = null;

        try {
            arrData = [];
            for (iCounter = 0; iCounter < this.m_arrTreeDependency.length; iCounter++) {
                obj = this.m_arrTreeDependency[iCounter];
                if (DataType.toString(obj.iFieldId) === DataType.toString(iFieldId)) {
                    if (obj.iRow === iRow) {
                        arrData.push({ iIndex: iCounter, sFilter: obj.sFilter });
                        break;
                    }

                    if (obj.iRow === -1 && iIndex == -1) {
                        iIndex = iCounter;
                    }
                }
            }

            if (arrData.length == 0 && iIndex >= 0) {
                obj = this.m_arrTreeDependency[iIndex];
                arrData.push({ iIndex: iIndex, sFilter: obj.sFilter });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.getTreeDependencyData}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

