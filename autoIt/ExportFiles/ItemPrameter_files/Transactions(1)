                        objLinkData = transEntryLinks.getColumnValue(iRow, iColumn);
                        EntryMainUI.openLinkBaseVoucherEntryScreen(objLinkData);
                    }
                }
                else if (evt.ctrlKey == true && evt.shiftKey == true && evt.keyCode == eKeyCode.B) { // Ctrl + Shift + Key.B (Batch Bin AutoAllocate)
                    EntryMainToolbar.onAutoAllocate_Click();
                }
                else if (evt.ctrlKey == true && evt.altKey == true && evt.keyCode == eKeyCode.N) { // Ctrl + Alt + Key.N (Document No Sequence)
                    if (DataType.isValidObject(document.getElementById(transEntryToolbarId.New)) == false) {
                        return;
                    }

                    if (EntryMain.checkPermission(SecurityActions.Add) == false) {
                        return;
                    }

                    EntryMainUI.updateNextVoucherNoInSeries();
                }
                else if (evt.ctrlKey == true && evt.altKey == true && evt.keyCode == eKeyCode.R) { // Ctrl + Alt + Key.R (Raise Cheque Return)
                    EntryMainToolbar.onRaiseChequeReturn_Click();
                }
                else if (evt.ctrlKey == true && evt.altKey == true && evt.keyCode == eKeyCode.G) { // Ctrl + Alt + Key.G (Copy Column Value In All Rows)
                    iRow = transEntryGrid.getCurrentRow();
                    iColumn = transEntryGrid.getCurrentColumn();
                    if (iRow != -1 && iColumn != -1) {
                        EntryMainBody.copyColumnValueInAllRows(iRow, iColumn);
                    }
                }

                return;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.onKeyUp} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onFieldHover: function (obj, evt) {
        let iCounter = 0;
        let sTitle = "";
        let sContent = "";
        let sPlacement = "";
        let arrData = null;
        let arrIndex = null;
        let arrFooterFields = undefined;
        let objMetaData = null;

        try {
            arrFooterFields = transEntryFieldInfo.getFooterFields();
            if (obj.bFooter == true) {
                arrIndex = DataType.arrayFilterDataIndex(arrFooterFields, "iFieldId", obj.iFieldId, "===")
            }
            else {
                arrIndex = DataType.arrayFilterDataIndex(transEntryGlobal.EntryModel.MetaData.Header, "iFieldId", obj.iFieldId, "===")
            }

            if (DataType.arrayLength(arrIndex) < 1) {
                return;
            }

            if (obj.bFooter == true) {
                objMetaData = arrFooterFields[arrIndex[0]];
            }
            else {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[arrIndex[0]];
            }

            if (obj.bEnter == true && evt.ctrlKey == true) {
                arrData = EntryMainUI.getMetaDataInfo(objMetaData);
                if (DataType.arrayLength(arrData) < 1) {
                    arrData = transEntryData.getHeaderMasterInfo(objMetaData);
                    if (DataType.arrayLength(arrData) < 1) {
                        return;
                    }

                    sTitle = "[" + objMetaData.sFieldName + "] Field Data Info";
