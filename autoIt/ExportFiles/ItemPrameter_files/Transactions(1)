    CalculateInstallments: function () {
        debugger
        var _ObjAdj = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails;
        if (!_ObjAdj.bMaintainInInvoiceCurrency) {
            _ObjAdj.m_objBillFilter.dRate = 1;
        }
        //if (document.getElementById("cmbRecFrequency").selectedIndex == 0) {
        //    //let x = document.getElementById("cmbRecFrequency").selectedIndex;
        //    document.getElementById("cmbRecFrequency").value = 2;
        //}
        if (document.getElementById("txtNoOfInstallment").textContent == "" || document.getElementById("txtNoOfInstallment").textContent == "0") {
            if (_ObjAdj.MinInstallments > 0) {
                document.getElementById("txtNoOfInstallment").value = _ObjAdj.MinInstallments;
            }
            else {
                document.getElementById("txtNoOfInstallment").textContent = "1";
            }
        }
        if (FConvert.toInt(document.getElementById("txtNoOfInstallment").value) < _ObjAdj.MinInstallments) {
            document.getElementById("txtNoOfInstallment").value = _ObjAdj.MinInstallments.ToString();
        }
        else {
            _ObjAdj.MinInstallments = FConvert.toInt(document.getElementById("txtNoOfInstallment").value);
        }
        objInstallments = {};
        var dTotalAmt = 0;
        var dTotalTranAmt = 0;
        var dInstallmentAmt = 0;
        var dBalanceInstallmentAmount = 0;
        lstInstallments = [];

        dTotalAmt = DataType.toDecimal(_ObjAdj.m_NewRefTransCurr == "" ? "0" : _ObjAdj.m_NewRefTransCurr);
        dBalanceInstallmentAmount = dTotalAmt;
        if (FConvert.toDecimal(document.getElementById("txtNoOfInstallment").Tag) == FConvert.toInt(document.getElementById("txtNoOfInstallment").value) && iPreviousFrequency == document.getElementById("cmbRecFrequency").selectedIndex) {

            if (_ObjAdj.m_arrAdjustedReferences != null) {
                for (i = 0; i < _ObjAdj.m_arrAdjustedReferences.length; i++) {
                    if (_ObjAdj.m_arrAdjustedReferences[i].iRefType == 0) {
                        lstInstallments.Add(_ObjAdj.m_arrAdjustedReferences[i]);
                    }
                }
            }
            _ObjAdj.m_arrInstallments = lstInstallments.ToArray();
            AdjustBills_ScreenNew.fillInstallment(AdjustBills_Screen.UI.getInstallmentGridElement());
            //fgInstallment.DataSource = m_arrInstallments;
            //fgInstallment.DataBind();
            let TmBATDBillCurrency = 0;
            for (j = 0; j < _ObjAdj.m_arrInstallments.length; j++) {
                TmBATDBillCurrency = TmBATDBillCurrency + _ObjAdj.m_arrInstallments[j].mBATDBillCurrency;
            }
            document.getElementById("lblBalanceInstallments").textContent = (_ObjAdj.m_NewRefTransCurr - TmBATDBillCurrency).ToString();
            return;
        }
        iPreviousFrequency = document.getElementById("cmbRecFrequency").selectedIndex;
        let iInstallmentsLength = 0;
        var l_arrinst = [];
        if (_ObjAdj.m_arrAdjustedReferences != null) {
            l_arrinst = DataType.arrayFilterData(_ObjAdj.m_arrAdjustedReferences, "iRefType", 0, "==");
            iInstallmentsLength = l_arrinst.length;
        }
        //Common.DataStructs.Date DueDate = new Date(dtDueDate.Date, GlobalPref.CalType);
        var iDueDate = _ObjAdj.m_arrBreakupByTag[0].dDueDate;

        for (i = 0; i < _ObjAdj.MinInstallments; i++) {
            objInstallments = {};
            if (iInstallmentsLength > i) {
                objInstallments = l_arrinst[i];
                dInstallmentAmt = AdjustBills_ScreenNew.GetInstallmentAmount(dTotalAmt, _ObjAdj.m_arrAdjustedReferences[i].dPreviousAdjustedAmount, _ObjAdj.MinInstallments, dBalanceInstallmentAmount, i == _ObjAdj.MinInstallments - 1);
            }
            else {
                dInstallmentAmt = AdjustBills_ScreenNew.GetInstallmentAmount(dTotalAmt, 0, _ObjAdj.MinInstallments, dBalanceInstallmentAmount, i == _ObjAdj.MinInstallments - 1);
            }
            dBalanceInstallmentAmount = dBalanceInstallmentAmount - dInstallmentAmt;
            objInstallments.mBATDBaseCurrency = DataType.toDecimal(dInstallmentAmt * DataType.toDecimal(_ObjAdj.m_objBillFilter.dRate));
            objInstallments.mBATDBillCurrency = DataType.toDecimal(FConvert.roundOff(dInstallmentAmt, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
            objInstallments.dDueDate = iDueDate;
            objInstallments.iTag = _ObjAdj.m_arrBreakupByTag[0].iTag;
            objInstallments.iAccount = _ObjAdj.m_arrBreakupByTag[0].iAccount;
            objInstallments.iProduct = _ObjAdj.m_arrBreakupByTag[0].iProduct;
            objInstallments.iCode = _ObjAdj.m_arrBreakupByTag[0].iCode;
            objInstallments.mBATDConversionRate = _ObjAdj.bMaintainInInvoiceCurrency == true ? DataType.toDecimal(_ObjAdj.m_objBillFilter.dRate) : 1;
            objInstallments.iLocalCurrencyId = _ObjAdj.m_LocalCurrency.CurrencyId;
            objInstallments.mBATDLocalConversionRate = DataType.toDecimal(_ObjAdj.m_objBillFilter.dLocalRate);
            objInstallments.mBATDLocalCurrency = DataType.toDecimal(FConvert.roundOff(objInstallments.mBATDBillCurrency * _ObjAdj.m_LocalCurrency.ExchangeRate, _ObjAdj.m_LocalCurrency.GeneralRoundOff, _ObjAdj.m_LocalCurrency.iRoundingType), _ObjAdj.m_LocalCurrency.iNoOfDecimals);
            objInstallments.mNativeCurrency = DataType.toDecimal(FConvert.roundOff(objInstallments.mBATDBillCurrency, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
            objInstallments.sNarration = "";
            lstInstallments.push(objInstallments);
            iDueDate = AdjustBills_ScreenNew.GetDueDateForInstallments(iDueDate);
            if (FNumberOperation.isEqualTo(dBalanceInstallmentAmount, 0))
                break;
        }
        _ObjAdj.m_arrInstallments = lstInstallments;
        AdjustBills_ScreenNew.fillInstallment(AdjustBills_Screen.UI.getInstallmentGridElement());
        //fgInstallment.DataSource = m_arrInstallments;
        //fgInstallment.DataBind();
        let TmBATDBillCurrency = 0;
        for (j = 0; j < _ObjAdj.m_arrInstallments.length; j++) {
            TmBATDBillCurrency = FNumberOperation.add(DataType.toDecimal(TmBATDBillCurrency), DataType.toDecimal(_ObjAdj.m_arrInstallments[j].mBATDBillCurrency));
        }
        document.getElementById("lblBalanceInstallments").textContent = FNumberOperation.sub(_ObjAdj.m_NewRefTransCurr, TmBATDBillCurrency);
    },

    GetInstallmentAmount: function (dTotalAmount, dPreviousAdjustedAmountTC, iNoOfInstallments, dBalanceInstallmentAmount, bLastRow) {
        var dInstallmentAmount = 0;
        var _ObjAdj = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails;
        if (FNumberOperation.isGreaterThanOrEqualTo(DataType.toDecimal(FConvert.roundOff(FNumberOperation.div(dTotalAmount, iNoOfInstallments), _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals), DataType.toDecimal(FConvert.roundOff(dPreviousAdjustedAmountTC, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals))) {
            if (bLastRow) {
                dInstallmentAmount = DataType.toDecimal(FConvert.roundOff(dBalanceInstallmentAmount, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
            }
            else {
                if (FNumberOperation.isGreaterThan(DataType.toDecimal(FConvert.roundOff(dBalanceInstallmentAmount, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals), DataType.toDecimal(FConvert.roundOff(FNumberOperation.div(dTotalAmount, iNoOfInstallments), _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals))) {
                    dInstallmentAmount = DataType.toDecimal(FConvert.roundOff(FNumberOperation.div(dTotalAmount, iNoOfInstallments), _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
                }
                else {
                    dInstallmentAmount = DataType.toDecimal(FConvert.roundOff(dBalanceInstallmentAmount, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
                }
            }
        }
        else {
            dInstallmentAmount = DataType.toDecimal(FConvert.roundOff(dPreviousAdjustedAmountTC, _ObjAdj.m_TransactionCurrency.GeneralRoundOff, _ObjAdj.m_TransactionCurrency.RoundingType), _ObjAdj.m_TransactionCurrency.NoofDecimals);
        }
        return dInstallmentAmount;
    },

    GetDueDateForInstallments: function (DueDate) {
        if (document.getElementById("cmbRecFrequency").selectedIndex == 0) {
            iDueDate = FDate.addDays(DueDate, 7)
        }
        else if (document.getElementById("cmbRecFrequency").selectedIndex == 1) {
            iDueDate = FDate.addDays(DueDate, 15)
        }
        else if (document.getElementById("cmbRecFrequency").selectedIndex == 2) {
            iDueDate = FDate.addMonths(DueDate, 1)
        }
        else if (document.getElementById("cmbRecFrequency").selectedIndex == 3) {
            iDueDate = FDate.addMonths(DueDate, 3)
        }
        else if (document.getElementById("cmbRecFrequency").selectedIndex == 4) {
            iDueDate = FDate.addMonths(DueDate, 6)
        }
        else if (document.getElementById("cmbRecFrequency").selectedIndex == 5) {
            iDueDate = FDate.addMonths(DueDate, 12)
        }
        else {
            iDueDate = FDate.addMonths(DueDate, 1)
        }
        return iDueDate;
    },

