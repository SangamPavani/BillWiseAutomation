            var TotalRows = billWiseInfo.TotalRows;// FGRIDCONTROL.getTotalRows(AdjustBills_Screen.UI.getAdjustmentGridElement());
            var AdjustedAmt = 0;
            var NativeAmt = 0;
            for (i = 1; i <= TotalRows; i++) {
                if (_objAdj.bMaintainInInvoiceCurrency == false) {
                    if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                        AdjustedAmt = FNumberOperation.add(AdjustedAmt, _objAdj.m_lstPendingBills[i - 1].mAAIDBaseCurrency);
                    }
                    else {
                        AdjustedAmt = FNumberOperation.add(AdjustedAmt, _objAdj.m_lstPendingBills[i - 1].mAAdIDBaseCurrency);
                    }
                }
                else {
                    if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                        AdjustedAmt = FNumberOperation.add(AdjustedAmt, _objAdj.m_lstPendingBills[i - 1].mAAIDInvoiceCurrency);
                    }
                    else {
                        AdjustedAmt = FNumberOperation.add(AdjustedAmt, _objAdj.m_lstPendingBills[i - 1].mAAdIDInvoiceCurrency);
                    }
                }
                NativeAmt = FNumberOperation.add(FNumberOperation.add(NativeAmt, AdjustedAmt), _objAdj.m_lstPendingBills[i - 1].mNativeCurrency);
            }
            AdjustedAmt = FNumberOperation.toFixed(AdjustedAmt, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals);
            NativeAmt = FNumberOperation.toFixed(NativeAmt, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals);

            if (_objAdj.bMaintainInInvoiceCurrency) {
                if (FCommon.UI.isValidObject(_objAdj.m_objBillFilter) == false) {
                    _objAdj.m_OnAccount = 0;
                }
                else {
                    _objAdj.m_OnAccount = FNumberOperation.mul(AdjustBills_Screen.UI.GetOnAccountAmt(), _objAdj.m_objBillFilter.dRate);
                }
                _objAdj.m_OnAccountTransCurr = AdjustBills_Screen.UI.GetOnAccountAmt();
            }
            else {
                _objAdj.m_OnAccount = AdjustBills_Screen.UI.GetOnAccountAmt();
                if (FCommon.UI.isValidObject(_objAdj.m_objBillFilter) == false) {
                    _objAdj.m_OnAccountTransCurr = 0;
                }
                else {
                    _objAdj.m_OnAccountTransCurr = FNumberOperation.div(AdjustBills_Screen.UI.GetOnAccountAmt(), _objAdj.m_objBillFilter.dRate);
                }
            }
            if (_objAdj.bMaintainInInvoiceCurrency == false) {
                if (FNumberOperation.isNotEqualTo(_objAdj.dAmtToBeAdjInBaseCurr, 0)) {
                    if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                        if (FNumberOperation.isLessThan(FNumberOperation.toFixed(_objAdj.dAmtToBeAdjInBaseCurr, FNumberOperation.add(FNumberOperation.add(AdjustedAmt, _objAdj.m_OnAccount), _objAdj.m_NewRef)), 0)) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_ScreenNew.PickOnAccount();
                        }
                    }
                    else {
                        if (FNumberOperation.isLessThan(FNumberOperation.sub(_objAdj.dAmtToBeAdjInBaseCurr, FNumberOperation.add(_objAdj.m_OnAccount, _objAdj.m_NewRef)), 0)) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_ScreenNew.PickOnAccount();
                        }
                    }
                }
            }
            else {
                if (FNumberOperation.isNotEqualTo(_objAdj.m_dTransactionCurrencyAmount, 0)) {
                    if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                        if (FNumberOperation.isLessThan(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, FNumberOperation.add(FNumberOperation.add(NativeAmt, _objAdj.m_OnAccountTransCurr), _objAdj.m_NewRefTransCurr)), 0)) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            AdjustBills_Screen.UI.SetOnAccountAmt(DataType.toDecimal(0, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals));
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_ScreenNew.PickOnAccount();
                        }
                    }
                    else {
                        if (FNumberOperation.isLessThan(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, FNumberOperation.add(_objAdj.m_OnAccountTransCurr, _objAdj.m_NewRefTransCurr)), 0)) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            AdjustBills_Screen.UI.SetOnAccountAmt(FNumberOperation.toFixed(0, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals));
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_ScreenNew.PickOnAccount();
                        }
                    }
                }
            }
            AdjustBills_Screen.AssignAdjustmentValues();
            if (g_Adjustment.BeforeAmount == true) {
                var col = TRANSACTION_ENTRY.BODYCOLUMN.getAmountColumn();
                col.setText(FNumberOperation.add(NativeAmt, FNumberOperation.mul(AdjustBills_Screen.UI.GetOnAccountAmt(), g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].mBAIDConversionRate)));
            }
            return true;
        }
        catch (Ex) {
            alert("Exception: ValidateOnAccountInput " + Ex.toString());
            return false;
        }
    },

    PickNewRef: function () {
