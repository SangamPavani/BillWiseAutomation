                }
            }
            else {
                if (FNumberOperation.isGreaterThanOrEqualTo(FNumberOperation.sub(_objAdj.dAmtToBeAdjInBaseCurr, FNumberOperation.add(FNumberOperation.add(AdjustedAmt, AdjustBills_Screen.UI.GetOnAccountAmt()), _objAdj.m_dMisAdjAmount)), 0)) {
                    _objAdj.m_NewRef = FNumberOperation.sub(_objAdj.dAmtToBeAdjInBaseCurr, FNumberOperation.add(FNumberOperation.add(AdjustedAmt, AdjustBills_Screen.UI.GetOnAccountAmt()), _objAdj.m_dMisAdjAmount));
