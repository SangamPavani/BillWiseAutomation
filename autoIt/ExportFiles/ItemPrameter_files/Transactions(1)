    getBodyMasterColumnIndex: function (iMasterTypeId) { // Returns body master column index
        let iCounter = 0;
        let arrFields = undefined;
        let objInvInfo = undefined;
        let objMetaData = undefined;
        let obj = undefined;

        try {
            obj = {};
            obj.iIndex = -1;
            obj.iColumn = -1;
            obj.MetaData = null;

            objInvInfo = transEntryFields.getInfo(eTransEntryField.InvTag, true);

            if (iMasterTypeId == eMasterTypeId.Product && transEntryInfo.isItSales == true
                && transEntryFieldInfo.Item.FieldId > 0) { // Product
                obj.iIndex = transEntryFieldInfo.Item.MetaDataIndex;
                obj.iColumn = transEntryFieldInfo.Item.ColumnIndex;
                obj.MetaData = transEntryFieldInfo.Item.MetaData;
            }
            else if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Body
                && transEntryInfo.FATag == iMasterTypeId) {

                obj.iIndex = transEntryFieldInfo.FATag.MetaDataIndex;
                obj.iColumn = transEntryFieldInfo.FATag.ColumnIndex;
                obj.MetaData = transEntryFieldInfo.FATag.MetaData;
            }
            else if (objInvInfo.Area == eTranEntryFieldArea.Body
                && transEntryInfo.InvTag == iMasterTypeId) {

                obj.iIndex = objInvInfo.MetaDataIndex;
                obj.iColumn = transEntryFieldInfo.InvTag.ColumnIndex;
                obj.MetaData = objInvInfo.MetaData;
            }
            else {
                arrFields = transEntryFieldInfo.getTags(true);
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;
                    if (objMetaData.iMasterTypeId == iMasterTypeId) {
                        obj.iIndex = arrFields[iCounter].MetaDataIndex;
                        obj.iColumn = arrFields[iCounter].ColumnIndex;
                        obj.MetaData = objMetaData;
                        break;
                    }
                }

                if (obj.iIndex == -1) {
                    arrFields = transEntryFieldInfo.getBodyFields();
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.iDataTypeId != eMasterDataType.Master) {
                            continue;
                        }

                        if (objMetaData.iMasterTypeId == iMasterTypeId) {
                            obj.iIndex = iCounter;
                            obj.iColumn = iCounter;
                            obj.MetaData = objMetaData;
                            break;
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.getBodyMasterColumnIndex} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (obj);
    },

    getMasterValue: function (iRow, iMasterTypeId, bBook, bInv2) {
        let iCounter = 0;
        let iIndex = 0;
        let iValue = 0;
        let sId = "";
        let cell = null;
        let obj = null;
        let arrHeader = null;
        let arrFields = undefined;
        let objMetaData = null;

        try {
            if (DataType.isValidObject(bBook) == false || bBook == true) {
                bBook = true;
            }
            else {
                bBook = false;
            }

            if (iMasterTypeId == eMasterTypeId.Account) { // Account
                if (bBook == false) {
                    if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.None) {
                        return (0);
                    }

                    if (iRow > 0) {
                        iRow--;
                    }
                    return (EntryMain.m_objTrans.BodyData[iRow].Code);
                }

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    return (EntryMain.m_objTrans.BodyData[0].Book)
                }

                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                    return (EntryMain.m_objTrans.BodyData[0].Code);
                }

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                    if (iRow > 0) {
                        iValue = EntryMain.m_objTrans.BodyData[iRow - 1].Book;
                    }
                    else {
                        iValue = EntryMain.m_objTrans.BodyData[iRow].Book;
                    }

                    if (iValue > 0) {
                        return (iValue);
                    }
                }

                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    if (iRow > 0) {
                        iRow--;
                    }

                    return (EntryMain.m_objTrans.BodyData[iRow].Code);
                }
            }

            if (iMasterTypeId == eMasterTypeId.Product
                && transEntryInfo.isItSales == true
                && transEntryFieldInfo.Item.ColumnIndex >= 0) { // Product

                if (iRow > 0) {
                    iRow--;
                }

                return (EntryMain.m_objTrans.BodyData[iRow].Sales.Product);
            }

            if (iMasterTypeId == eMasterTypeId.Units
                && transEntryInfo.isItSales == true) { // Unit

                if (transEntryFieldInfo.Unit.ColumnIndex > -1) {
                    if (iRow > 0) {
                        iRow--;
                    }

                    return (EntryMain.m_objTrans.BodyData[iRow].Sales.Unit);
                }

                iValue = 0;
                arrFields = transEntryFieldInfo.getLayoutFields(true);
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;
                    if (objMetaData.iMasterTypeId != iMasterTypeId) {
                        continue;
