    getLCFilter: function (iBookValue, iDocumentDate) {
        let sFilter = "";

        if (transEntryInfo.isItSales == true) {
            if (transEntryInfo.isItOrder == true) {
                sFilter = "iStatusID = 4 AND iAccountId = " + iBookValue;
                sFilter += " AND iTransactionType = ";
                sFilter += transEntryInfo.isInwardVoucher == true ? 1 : 0;
                sFilter += " AND " + iDocumentDate + " BETWEEN iDateOfIssue AND iExpiryDate ";
            }
            else {
                sFilter = "iStatusID NOT IN (2,5) AND iAccountId = " + iBookValue;
                sFilter += " AND iTransactionType = ";
                sFilter += transEntryInfo.isInwardVoucher == true ? "1" : "0";
                sFilter += " AND " + iDocumentDate + " BETWEEN iDateOfIssue AND iExpiryDate ";
            }
        }
