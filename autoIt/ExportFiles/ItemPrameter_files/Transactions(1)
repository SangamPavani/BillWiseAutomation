    getNextChequeNoSeries: function (bSuccess, data, tag) {
        let sId = "";
        let sSelected = "";
        let iCounter = 0;
        let iTotal = 0;
        let iIndex = -1;
        let arrChequeNo = undefined;
        let arrIdNamePair = undefined;
        let obj = undefined;

        try {
            if (bSuccess == false) {
                return;
            }

            if (data.lValue < 1) {
                transEntryGlobal.showAlert(data.sValue, GlobalPref.getResourceValue("Exception"));
            }
            else {
                if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header) {
                    if (tag.iBookNo > 0) {
                        if (transEntryFieldInfo.Book.FieldId > 0
                            && EntryMain.m_objTrans.BodyData[0].Book != tag.iBookNo) {
                            return;
                        }
                    }

                    arrChequeNo = data.data.Tag;

                    if (data.data.ID == -1
                        && DataType.isNullOrEmpty(data.data.Name, true) == false) {

                        transEntryGlobal.writeErrorLog("GetNextChequeNoSeries: " + data.data.Name);
                        transEntryGlobal.showAlert(data.data.Name, GlobalPref.getResourceValue("Error"));
                    }

                    sSelected = transEntryFields.getChequeNo(0);

                    arrIdNamePair = [];

                    if (DataType.isNullOrEmpty(tag.sLoadedChequeNo, true) == false) {
                        obj = FocusDataStructs.getIdNamePairObject();
                        obj.ID = 0;
                        obj.Name = tag.sLoadedChequeNo;
                        arrIdNamePair.push(obj);

                        iIndex = 0;
                    }

                    iTotal = DataType.arrayLength(arrChequeNo);
                    for (iCounter = 0; iCounter < iTotal; iCounter++) {
                        obj = FocusDataStructs.getIdNamePairObject();
                        obj.ID = 0;
                        obj.Name = arrChequeNo[iCounter];
                        arrIdNamePair.push(obj);

                        if (iIndex == -1 && arrChequeNo[iCounter] == sSelected) {
                            iIndex = arrIdNamePair.length - 1;
                        }
                    }

                    sId = transEntryChequeNo.getControlId();
                    OPTIONCONTROL_DATA.storeDataArrayInMemory(sId, arrIdNamePair);

                    if (iTotal > 0) {
                        if (tag.bVoucherLoading == true) {
                            if (DataType.isNullOrEmpty(tag.sLoadedChequeNo, true) == false) {
                                OPTIONCONTROL.setControlText(sId, tag.sLoadedChequeNo);
                            }
                        }
                        else if (iIndex != -1) {
                            OPTIONCONTROL.setControlText(sId, arrIdNamePair[iIndex].Name);
                        }
                        else {
                            OPTIONCONTROL.setControlText(sId, arrIdNamePair[0].Name);
                        }
                        //OPTIONCONTROL.setControlText(sId, arrIdNamePair[0].Name);
                    }
                    else if (DataType.isNullOrEmpty(tag.sLoadedChequeNo, true) == false) {
                        OPTIONCONTROL.setControlText(sId, arrIdNamePair[0].Name);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.getNextChequeNoSeries} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

