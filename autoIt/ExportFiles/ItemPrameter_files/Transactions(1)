    loadInvoiceNoData: function (objTransaction) {
        let sInvoiceNo = "";
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let ele = null;
        let objMetaData = null;
        let objFindResult = null;
        let obj = null;

        try {
            transEntryGrid.update();

            transEntryGlobal.EntryModel.Data = transEntryData.convertIntoThinClientObject(objTransaction, eConvertTransactionObjectSource.LoadInvoiceNoData);

            sId = EntryMainUI.getElement(transEntryFieldInfo.Date, 0).Value;
            objFindResult = EntryMainCommon.findKeyValue(sId, transEntryData.getHeader());
            if (objFindResult.lValue > 0) {
                transEntryGlobal.EntryModel.Data.Header.splice(objFindResult.lValue - 1, 1);
            }

            transEntryGlobal.EntryModel.Data.Flags = objTransaction.Header.Flags;
            transEntryGlobal.EntryModel.Data.iVoucherMode = eVoucherMode.None;

            obj = {};
            obj.bLoadingFromVersion = false;
            obj.bNew = false;
            obj.bResetFocus = false;
            obj.bVoucherLoading = false;
            obj.bFromPendingView = false;
            obj.iLoadedDataSource = eLoadedDataSource.LoadInvoiceNoData;
            EntryMainUI.setLoadedData(obj);

            sInvoiceNo = objTransaction.Header.DocNo;
            if (DataType.stringIncludes(sInvoiceNo, ":") == false) {
                return;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if (objMetaData.sFieldName.toLowerCase() != "invoiceno") {
                    continue;
                }

                ele = document.getElementById(EntryMainUI.getHeaderControlId(objMetaData.iFieldId));
                if (DataType.isValidObject(ele) == true) {
                    iIndex = sInvoiceNo.indexOf(":");
                    if (iIndex > -1) {
                        iIndex = sInvoiceNo.substr(0, iIndex).lastIndexOf("-");
                        sInvoiceNo = sInvoiceNo.substr(iIndex + 2);
                    }

                    ele.value = sInvoiceNo;
                    ele.setAttribute("data-lastvalue", sInvoiceNo);
                }

                break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body loadInvoiceNoData method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.loadInvoiceNoData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    processCtrlR: function (evt) { // For proportionate
        let sValue = "";
        let iRow = 0;
        let iColumn = 0;
        let iIndex = 0;
        let iLastRow = 0;
        let dGross = 0;
        let dValue = 0;
        let dSum = 0;
        let dTemp = 0;
        let dDiff = 0;
        let cell = null;
        let objMetaData = null;

        try {
            if (transEntryFieldInfo.Gross.ColumnIndex < 0) {
                return (false);
            }

            if (evt.ctrlKey == false || evt.keyCode != eKeyCode.R) {
                return (false);
            }

            iRow = transEntryGrid.getCurrentRow();
            iColumn = transEntryGrid.getCurrentColumn();

            cell = transEntryGrid.getCellObject(iRow, iColumn, true);
            if (DataType.isValidObject(cell) == false) {
