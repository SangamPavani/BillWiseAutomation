    views_saveCurrentView: function () {
        var objView = null;


        objView = {};
        objView.iViewId = CONFIGURETRANS.VIEWS.getSelectedViewId();
        objView.sViewName = CONFIGURETRANS.getSelectedViewName();
        objView.iOption = 0;
        objView.iLoadDocFrom = 0;
        objView.bAllowEntryManually = false;
        objView.ArrUsers = [];
        objView.ArrRoles = [];
        objView.bNew = false;

        if (FCommon.String.isNullOrEmpty(objView.sViewName, true) == true) {
            COMMON.prototype.showMessage("Please enter view name", "Error");
            return;
        }

        if (objView.iViewId == 0) {
            objView.bNew = true;
        }


        if (document.getElementById("views_chkauthorizeOnly").checked) {
            objView.iOption |= 1 << 0;
        }

        if (document.getElementById("views_chkbodyReadOnly").checked) {
            objView.iOption |= 1 << 1;
        }

        if (document.getElementById("views_chkHideNetFromSummary").checked) {
            objView.iOption |= 1 << 2;
        }

        if (document.getElementById("views_rdoNone").checked)
            objView.iLoadDocFrom = 0;
        if (document.getElementById("views_rdoLinks").checked)
            objView.iLoadDocFrom = 1;
        if (document.getElementById("views_rdoPendingbills").checked)
            objView.iLoadDocFrom = 2;


        objView.bAllowEntryManually = document.getElementById("views_chkAllowExtraEntriesManually").checked;

        var lstUsers = DocCustomization.Views.getUsersListElement().children; // document.getElementById("views_lstUsers").children;
        for (var count = 0; count < lstUsers.length; count++) {
            if (lstUsers[count].children[0].children[0].children[0].checked == true) {
                objView.ArrUsers.push(lstUsers[count].children[0].children[0].children[0].dataset.value);
            }
        }

        var lstRoles = DocCustomization.Views.getRolesListElement().children; // document.getElementById("views_lstRoles").children;
        for (var count = 0; count < lstRoles.length; count++) {
            if (lstRoles[count].children[0].children[0].children[0].checked == true) {
                objView.ArrRoles.push(lstRoles[count].children[0].children[0].children[0].dataset.value);
            }
        }

        if (objView.ArrUsers != null && objView.ArrRoles != null) {
            if (objView.ArrUsers.length == 0 && objView.ArrRoles.length == 0) {
                COMMON.prototype.showMessage("Select at least one user from logins.", "Error");
                return;
            }
        }


        NETWORK.executeServerMethod(
            GLOBAL.getContextPath("saveViewField", "ConfigureTrans", "TranSettings"),
            true,
            {
                objView: objView,
                iMenuId: CONFIGURETRANS.getMenuId(),
                sArrFields: FConvert.toString(arrFields)
            },
            "",
            true,
            "CONFIGURETRANS.views_saveCurrentViewSuccess",
            "GLOBAL.LoadingStart",
            "GLOBAL.LoadingEnd"
        );
    },

