    update: function (iFieldId, value, iRow, extra) {
        let iCounter = 0;
        let objBody = undefined;
        let oldValue = undefined;

        try {
            iRow = DataType.toInt(iRow);

            switch (iFieldId) {
                case eVTFIELDID.FDF_DOCUMENTNO:
                    EntryMain.m_objTrans.Header.DocNo = value;
                    break;
                case eVTFIELDID.FDF_DATE:
                    EntryMain.m_objTrans.Header.Date = value;

                    if (transEntryFieldInfo.DueDate.Area == eTranEntryFieldArea.None) {
                        for (iCounter = 0; iCounter < EntryMain.m_objTrans.BodyData.length; iCounter++) {
                            EntryMain.m_objTrans.BodyData[iCounter].DueDate = value;
                        }
                    }
                    break;
                case eVTFIELDID.FDF_CODE:
                case eVTFIELDID.FDF_BODYCODE:
                    EntryMainMemoryObject.updateCode(value, iRow);
                    break;
                case eVTFIELDID.FDF_BOOKNO:
                case eVTFIELDID.FDF_BODYBOOKNO:
                    EntryMainMemoryObject.updateBook(value, iRow);
                    break;
                case eVTFIELDID.FDF_FATAG:
                    EntryMainMemoryObject.updateFATag(value, iRow);
                    break;
                case eVTFIELDID.FDF_INVTAG:
                case eVTFIELDID.FDF_HEADERINVTAG:
                    EntryMainMemoryObject.updateInvTag(value, iRow);
                    if (iFieldId == eVTFIELDID.FDF_HEADERINVTAG) {
                        EntryMainMemoryObject.updateHeaderInvTag(value, iRow);
                    }
                    break;
                case eVTFIELDID.FDF_BODYINVTAG:
                    EntryMainMemoryObject.updateBodyInvTag(value, iRow);
                    break;
                case eVTFIELDID.FDF_LCNUMBER:
                    EntryMain.m_objTrans.Header.LC = DataType.toInt(value);
                    break;
                case eVTFIELDID.FDF_BOMSIZE:
                    EntryMain.m_objTrans.Header.ProductionSize = FNumberOperation.convert(value);
                    break;
                case eVTFIELDID.FDF_PROD_PROCESS:
                    EntryMain.m_objTrans.Header.ProcessId = DataType.toInt(value);
                    break;
                case eVTFIELDID.FDF_PMTTERMS:
                    EntryMain.m_objTrans.Header.PmtTerm = DataType.toInt(value);
                    break;
                case eVTFIELDID.FDF_UPDATEFA:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.Header
                        && EntryMain.m_objTrans.Header.Flags) {

                        EntryMain.m_objTrans.Header.Flags.UpdateFA = value;
                    }
                    break;
                case eVTFIELDID.FDF_UPDATESTOCKS:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.Header
                        && EntryMain.m_objTrans.Header.Flags) {

                        EntryMain.m_objTrans.Header.Flags.UpdateInv = value;
                    }
                    break;
                case eVTFIELDID.FDF_RAISECASHCONTRA:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.Header
                        && EntryMain.m_objTrans.Header.Flags) {

                        EntryMain.m_objTrans.Header.Flags.PostCashEntry = value;
                    }
                    break;
                case eVTFIELDID.FDF_HEADERCURRENCY:
                case eVTFIELDID.FDF_BODYCURRENCY:
                    EntryMainMemoryObject.updateCurrency(value, iRow);
                    break;
                case eVTFIELDID.FDF_EXCHANGERATE:
                case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    oldValue = EntryMainMemoryObject.updateExchangeRate(value, iRow);
                    break;
                case eVTFIELDID.FDF_LOCEXCHANGERATE:
                    EntryMainMemoryObject.updateLocalExchangeRate(value, iRow);
                    break;
                case eVTFIELDID.FDF_DUEDATE:
                case eVTFIELDID.FDF_BODYDUEDATE:
                    EntryMainMemoryObject.updateDueDate(value, iRow);
                    break;
                case eVTFIELDID.FDF_BODYPRODUCT:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        value = DataType.toInt(value);
                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Product = value;

                        if (value == 0) {
                            EntryMainMemoryObject.updateProductInfo(undefined, iRow);
                        }
                    }
                    break;
                case eVTFIELDID.FDF_BODYUNITS:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        //value = DataType.toInt(value);
                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Unit = value;

                        if (value == 0 || value == undefined || value == null) {
                            EntryMainMemoryObject.updateUnitInfo(undefined, iRow);
                        }

                        EntryMainMemoryObject.calcualteAndUpdateBaseQuantity(undefined, iRow);
                    }
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Quantity = value;

                        EntryMainMemoryObject.calcualteAndUpdateBaseQuantity(value, iRow);
                    }
                    break;
                case eVTFIELDID.FDF_QUANTITY_IN_BASE:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.BaseQuantity = value;
                    }
                    break;
                case eVTFIELDID.FDF_BODYALTQUANTITY:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.AlternateQuantity = value;
                    }
                    break;
                case eVTFIELDID.FDF_BODYRATE:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigRate = value;

                        if (transEntryInfo.VoucherType != 0x3fe) { // Not Stock Revaluation
                            objBody = EntryMain.m_objTrans.BodyData[iRow - 1];
                            if (FNumberOperation.isNotEqualTo(objBody.Sales.OrigRate, 0) == true
                                && FNumberOperation.isNotEqualTo(objBody.ExchangeRate, 0) == true) {
                                objBody.Sales.Rate = FNumberOperation.mul(objBody.Sales.OrigRate, objBody.ExchangeRate);
                            }
                        }
                    }
                    break;
                case eVTFIELDID.FDF_BODYGROSS:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross = value;
                        objBody = EntryMain.m_objTrans.BodyData[iRow - 1];
                        if (FNumberOperation.isNotEqualTo(objBody.Sales.OrigGross, 0) == true
                            && FNumberOperation.isNotEqualTo(objBody.ExchangeRate, 0) == true) {
                            objBody.Sales.Gross = FNumberOperation.mul(objBody.Sales.OrigGross, objBody.ExchangeRate);
                        }
                    }
                    break;
                case eVTFIELDID.FDF_MAXQTYRELEASE:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.StockToRelease = value;
                    }
                    break;
                case eVTFIELDID.FDF_BALANCEQTY: // For Stock Revaluation Voucher
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.BalanceQty = value;
                    }
                    break;
                case eVTFIELDID.FDF_AVGRATE: // For Stock Revaluation Voucher
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.AvgRate = value;
                    }
                    break;
                case eVTFIELDID.FDF_BALANCESTKVAL: // For Stock Revaluation Voucher
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.BalanceStockValue = value;
                    }
                    break;
                case eVTFIELDID.FDF_NEWAVGRATE: // For Stock Revaluation Voucher
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Rate = value;
                    }
                    break;
                case eVTFIELDID.FDF_NEWSTKVAL: // For Stock Revaluation Voucher
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]
                        && EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].Sales.NewStockValue = value;
                    }
                    break;
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                    EntryMainMemoryObject.updateReservation(value, iRow);
                    break;
                case eVTFIELDID.FDF_BODYAMOUNT:
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRow - 1]) {

                        EntryMain.m_objTrans.BodyData[iRow - 1].OrigAmount = value;
                    }
                    break;
                case eVTFIELDID.FDF_LINK:
                    EntryMainMemoryObject.updateLink(value, iRow);
                    break;
                case eVTFIELDID.FDF_RMANO:
                    EntryMainMemoryObject.updateRMA(value, iRow);
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    EntryMainMemoryObject.updateBatchNo(value, iRow);
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    EntryMainMemoryObject.updateMfgDate(value, iRow);
                    break;
                case eVTFIELDID.FDF_EXPDATE:
                    EntryMainMemoryObject.updateExpDate(value, iRow);
                    break;
                case eVTFIELDID.FDF_BATCH_QUANTITY:
                    break;
                case eVTFIELDID.FDF_BATCHRATE:
                    EntryMainMemoryObject.updateBatchRate(value, iRow);
                    break;
                case eVTFIELDID.FDF_BATCHRATE1:
                    EntryMainMemoryObject.updateBatchRate1(value, iRow);
                    break;
                case eVTFIELDID.FDF_BATCHRATE2:
                    EntryMainMemoryObject.updateBatchRate2(value, iRow);
                    break;
                case eVTFIELDID.FDF_DEPTAPPROP:
                    EntryMainMemoryObject.updateDeptAppropriation(value, iRow);
                    break;
                case eVTFIELDID.FDF_RCTISSUESELECTION:
                    EntryMainMemoryObject.updateIssueReceipt(value, iRow);
                    break;
                default:
                    if ((iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0 || (iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                        EntryMainMemoryObject.updateMaster(iFieldId, value, iRow);
                    }
                    else if ((iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                        if (DataType.isObject(extra) == true) {
                            extra = undefined;
                        }

