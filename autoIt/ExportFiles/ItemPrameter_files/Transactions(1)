            switch (iFieldId) {
                case eVTFIELDID.FDF_CODE:
                case eVTFIELDID.FDF_BODYCODE:
                    EntryMainMemoryObject.updateCodeAccountType(0, cell.iRow);
                    break;
                case eVTFIELDID.FDF_BOOKNO:
                case eVTFIELDID.FDF_BODYBOOKNO:
                    EntryMainMemoryObject.updateBookAccountType(0, cell.iRow);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body updateMasterValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.updateMasterValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (iMasterId);
