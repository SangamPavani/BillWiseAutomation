    /// Returns Data...
    GetReservationData: function () { 
        try {
        var sDataGridId;
        dTotalQtyReserved = 0;
        var cell = FGRIDCONTROL.getCellObject("Id_Reservation_FGrid", RESERVATION.iSelectedProductType, 1);
        if (cell != null && cell != undefined) {
            sDataGridId = cell.CellData.product_datagrid_id;
            var mReservedData;
            var dataCounter = 0;
            if (sDataGridId == "Id_StockReservation_FGrid") {
                mReservedData = RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].StockList;
                if (mReservedData != null && mReservedData != undefined) {
                    dataCounter = 0;
                    for (var i = 0; i < mReservedData.length; i++) {
                        if (mReservedData[i].ActualAvailableQty > 0) {
                            dataCounter++;
                            var cell = FGRIDCONTROL.getCellObject("Id_StockReservation_FGrid", dataCounter, 4);
                            if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                mReservedData[i].ReserveQty = cell.CellData.value;
                                dTotalQtyReserved = parseFloat(dTotalQtyReserved) + parseFloat(mReservedData[i].ReserveQty);
                                if (parseFloat(cell.CellData.value) > 0) {
                                    RESERVATION.isReserved = true;
                                }
                            }
                        }
                    }
                    RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].StockList = mReservedData;
                }
            }
            else if (sDataGridId == "Id_BatchReservation_FGrid") {
                mReservedData = RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BatchList;
                //if (tempBatcharr == undefined || tempBatcharr == null) {
                //    mReservedData = mReservedData;
                //} else {
                //    mReservedData[0] = tempBatcharr;
                //}

                if (mReservedData != null && mReservedData != undefined) {
                    dataCounter = 0;
                    for (var i = 0; i < mReservedData.length; i++) {
                        if (mReservedData[i].ActualAvailableQty > 0) {
                            dataCounter++;
                            //var cell = FGRIDCONTROL.getCellObject("Id_BatchReservation_FGrid", dataCounter, 2);
                            var iTotalRows = FGRIDCONTROL.getTotalRows("Id_BatchReservation_FGrid");
                            for (var j = 0; j < iTotalRows; j++) {
                                var RowData = FGRIDCONTROL.getRowValue("Id_BatchReservation_FGrid", j + 1);
                                var cell = FGRIDCONTROL.getCellObject("Id_BatchReservation_FGrid", j + 1, 2);
                                if (RowData[2].Value == "" || RowData[2].Value == null) {
                                    break;
                                }
                                else if (FConvert.toInt(RowData[2].Value) == mReservedData[i].FullFillTransId) {
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        if (cell.CellData.value == "") {
                                            cell.CellData.value = 0;
                                        }
                                        mReservedData[i].ReserveQty = cell.CellData.value;
                                        dTotalQtyReserved = parseFloat(dTotalQtyReserved) + parseFloat(mReservedData[i].ReserveQty);
                                        if (parseFloat(cell.CellData.value) > 0) {
                                            RESERVATION.isReserved = true;
                                        }
                                    }
                                    var cell = FGRIDCONTROL.getCellObject("Id_BatchReservation_FGrid", j + 1, 10);
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        mReservedData[i].BatchQty = cell.CellData.value;
                                    }
                                }
                            }
                        }
                    }
                    RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BatchList = mReservedData;
                }
            }
            else if (sDataGridId == "Id_BatchBinReservation_FGrid") {
                mReservedData = RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BatchList;
                if (mReservedData != null && mReservedData != undefined) {
                    dataCounter = 0;
                    for (var i = 0; i < mReservedData.length; i++) {
                        if (mReservedData[i].ActualAvailableQty > 0) {
                            dataCounter++;
                            //var cell = FGRIDCONTROL.getCellObject("Id_BatchBinReservation_FGrid", dataCounter, 2);
                            var iTotalRows = FGRIDCONTROL.getTotalRows("Id_BatchBinReservation_FGrid")
                            var iCellNo = RESERVATION.GridWiseCell(sDataGridId);
                            for (var j = 0; j < iTotalRows; j++) {
                                var RowData = FGRIDCONTROL.getRowValue("Id_BatchBinReservation_FGrid", j + 1);
                                var cell = FGRIDCONTROL.getCellObject("Id_BatchBinReservation_FGrid", j + 1, iCellNo);
                                if (RowData[3].Value == "" || RowData[3].Value == null) {
                                    break;
                                }
                                else if (FConvert.toInt(RowData[3].Value) == mReservedData[i].FullFillTransId && RowData[4].Text == mReservedData[i].Bins) {
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        if (RESERVATION.bMaintainInvByUnit == true) {
                                            mReservedData[i].TReserveQty = parseFloat(cell.CellData.value);
                                        } 
                                        var Bcell = FGRIDCONTROL.getCellObject("Id_BatchBinReservation_FGrid", j + 1, 3);
                                        if (Bcell.CellData.value != null && Bcell.CellData.value != undefined) {
                                            mReservedData[i].ReserveQty = parseFloat(Bcell.CellData.value);  
                                        }
                                        var rQty= RESERVATION.bMaintainInvByUnit == false ? parseFloat(mReservedData[i].ReserveQty) : parseFloat(mReservedData[i].TReserveQty)
                                        dTotalQtyReserved = parseFloat(dTotalQtyReserved) + rQty;
                                        if (parseFloat(cell.CellData.value) > 0) {
                                            RESERVATION.isReserved = true;
                                        }
                                    }
                                    var cell = FGRIDCONTROL.getCellObject("Id_BatchBinReservation_FGrid", j + 1, 11);
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        mReservedData[i].BatchQty = parseFloat(cell.CellData.value);
                                    }
                                    var cell = FGRIDCONTROL.getCellObject("Id_BatchBinReservation_FGrid", j + 1, 12);
                                    if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                        mReservedData[i].TBatchQty = parseFloat(cell.CellData.value);
                                    }
                                }
                            }
                        }
                    }
                    RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BatchList = mReservedData;
                }
            }
            else if (sDataGridId == "Id_BinReservation_FGrid") {
                mReservedData = RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BinList;
                if (mReservedData != null && mReservedData != undefined) {
                    dataCounter = 0;
                    var iCellNo = RESERVATION.GridWiseCell(sDataGridId);
                    for (var i = 0; i < mReservedData.length; i++) {
                        if (mReservedData[i].ActualAvailableQty > 0) {
                            dataCounter++;
                            var cell = FGRIDCONTROL.getCellObject("Id_BinReservation_FGrid", dataCounter, iCellNo);
                            if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                if (RESERVATION.bMaintainInvByUnit == true) { 
                                    mReservedData[i].TReserveQty = cell.CellData.value;
                                }
                                var Bcell = FGRIDCONTROL.getCellObject("Id_BinReservation_FGrid", dataCounter, 4);
                                if (Bcell.CellData.value != null && Bcell.CellData.value != undefined) {
                                    mReservedData[i].ReserveQty = parseFloat(Bcell.CellData.value);
                                }
                                var rQty = RESERVATION.bMaintainInvByUnit == false ? parseFloat(mReservedData[i].ReserveQty) : parseFloat(mReservedData[i].TReserveQty)
                                dTotalQtyReserved = parseFloat(dTotalQtyReserved) + parseFloat(rQty);
                                if (parseFloat(cell.CellData.value) > 0) {
                                    RESERVATION.isReserved = true;
                                }
                            }
                        }
                    }
                    RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].BinList = mReservedData;
                }
            }
            else if (sDataGridId == "Id_RMAReservation_FGrid") {
                mReservedData = RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].RMAList;
                if (mReservedData != null && mReservedData != undefined) {
                    dataCounter = 0;
                    for (var i = 0; i < mReservedData.length; i++) {
                        dataCounter++;
                        //if (FGRIDCONTROL.getCellObject("Id_RMAReservation_FGrid", dataCounter, 4).cell.id == '')
                        //    break;
                        if (mReservedData[i].AlreadySelected == false) {//&& mReservedData[i].Selected == false
                            var cell = FGRIDCONTROL.getCellObject("Id_RMAReservation_FGrid", dataCounter, 5);
                            if (cell.cell.children[0].checked == true) {
                                cell.CellData.value = true;
                            }
                            if (cell.CellData.value != null && cell.CellData.value != undefined) {
                                if (cell.CellData.value && cell.CellData.valuerma) {
                                    mReservedData[i].Selected = cell.CellData.value;
                                    RESERVATION.isReserved = true;
                                    dTotalQtyReserved = parseFloat(dTotalQtyReserved) + 1;
                                } else {
                                    mReservedData[i].Selected = false;
                                }

                                //if (cell.CellData.value && cell.CellData.valuerma) {
                                //    RESERVATION.isReserved = true;

                                //}
                            }
                        }
                    }
                    RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1].RMAList = mReservedData;
                }
            }
        }
            RESERVATION.ReturnReservationData(false, false);
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.GetReservationData} " + err.message, "Exception")
        }
    },
    ReturnReservationData: function (bClose, bCanceled) {
        try { 
        var Resdata = [];
        Resdata.push(RESERVATION.m_arrReservations[RESERVATION.iSelectedProductType - 1]);
        $(RESERVATION.getPopupElement()).modal("hide");
        FCommon.UI.removeChildren(EntryMainUI.getOthersContainer());
        if ((typeof RESERVATION.fnCallBack_Name).toLowerCase() == "string" && FCommon.String.isNullOrEmpty(RESERVATION.fnCallBack_Name) == false) {
            if (FCommon.UI.isValidObject(Resdata) == true && Resdata.length > 0) {
                if (bClose && !bCanceled) {
                    //alert(dTotalQtyReserved);
                    eval(RESERVATION.fnCallBack_Name)(false, null, RESERVATION.sTags, dTotalQtyReserved);
                }
                else if (!bClose && bCanceled) {
                    //alert(dTotalQtyReserved);
                    //eval(RESERVATION.fnCallBack_Name)(true, null, RESERVATION.sTags);
                    result = NETWORK.executeServerMethod(GLOBAL.getContextPath("CancelReservation", "VoucherPopup", "Transactions"),
                        true,
                        { ReqTransactionId: Resdata[0].ReqTransactionId },
                        "",
                        true,
                        "RESERVATION.CancelReservationsSuccess");
                }

                else {
                    if (RESERVATION.isReserved == true) {
                        RESERVATION.isReserved = false;
                        //alert(dTotalQtyReserved);
                        eval(RESERVATION.fnCallBack_Name)(true, Resdata, RESERVATION.sTags, dTotalQtyReserved);
                    }
                    else {
                        //alert(dTotalQtyReserved);
                        eval(RESERVATION.fnCallBack_Name)(true, null, RESERVATION.sTags, dTotalQtyReserved);
                    }
                }
            }
        }
        $(".modal-backdrop").css("display", "none");
            FCommon.UI.removeChildren(EntryMainUI.getOthersContainer());
        } catch (err) {
            COMMON.prototype.showMessage("Exception: {RESERVATION.ReturnReservationData} " + err.message, "Exception")
        }
    },
