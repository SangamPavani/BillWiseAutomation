    getMandatoryValue: function (objFieldInfo, iRow, sDataField, eDataType) {
        let objControl = undefined;
        let value = undefined;

        try {
            if (objFieldInfo.MetaData == null || objFieldInfo.MetaData == undefined) {
                if (eDataType != undefined && eDataType != null) {
                    switch (eDataType) {
                        case eMasterDataType.Number:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            value = DataType.toInt(value);
                            break;
                        case eMasterDataType.BigNumber:
                            value = DataType.toInt64(value);
                            break;
                        case eMasterDataType.Fraction:
                            value = DataType.toDecimal(value);
                            break;
                        case eMasterDataType.Text:
                            value = DataType.toString(value);
                            break;
                        case eMasterDataType.Boolean:
                            value = DataType.toBoolean(value);
                    }
                }

                return (value);
            }

            iRow = DataType.toInt(iRow);
            objControl = EntryMainUI.getElement(objFieldInfo, iRow, true);
            if (objControl.Value) {
                sDataField = DataType.stringGetValidDataAttribute(sDataField);
                switch (objFieldInfo.MetaData.iDataTypeId) {
                    case eMasterDataType.Master:
                        if ((typeof objControl.Value).toLowerCase() == "string") {
                            value = OPTIONCONTROL.getControlValue(objControl.Value, sDataField);
                        }
                        else {
                            value = objControl.Value.getAttribute(sDataField);
                        }
                        break;
                    default:
                        value = objControl.Value.getAttribute(sDataField);
                        break;
                }
            }

            if (eDataType != undefined && eDataType != null) {
                switch (eDataType) {
                    case eMasterDataType.Number:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        value = DataType.toInt(value);
                        break;
                    case eMasterDataType.BigNumber:
                        value = DataType.toInt64(value);
                        break;
                    case eMasterDataType.Fraction:
                        value = DataType.toDecimal(value);
                        break;
                    case eMasterDataType.Text:
                        value = DataType.toString(value);
                        break;
                    case eMasterDataType.Boolean:
                        value = DataType.toBoolean(value);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryFields.getMandatoryValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    isRequired: function (eField, iRow, extra) {
        let bBins2 = false;
        let value = false;
        let invtag = undefined;

        try {
            switch (eField) {
                case eVTFIELDID.FDF_REFERENCE:
                    if (transEntrySettings.isAdjustBillInLine == false) {
                        value = false;
                        break;
                    }

                    value = transEntryReference.isDataCanExist();
                    if (value == false) {
                        break;
                    }
                    else {
                        value = false;
                    }

                    iRow = DataType.toInt(iRow);
                    if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                        iAccountTypeId = EntryMainMemoryObject.getCodeTypeId(iRow);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            value = true;
                            break;
                        }
                    }

                    if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                        iAccountTypeId = EntryMainMemoryObject.getBookTypeId(iRow);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            value = true;
                            break;
                        }
                    }
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    if (transEntryGrid.isValidRow(iRow) == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) {
                        value = false;
                        break;
                    }

                    // Commented as per Javed suggestion for checked in pick list voucher
                    //if (extra !== true) { // extra means bIgnoreUpdateStock
                    //    if (transEntryFields.getUpdateStockValue() == false
                    //        && transEntrySettings.isInputBatchEvenIfStockNotUpdated == false) {

                    //        value = false;
                    //        break;
                    //    }
                    //}

                    if (transEntryFieldInfo.Item.FieldId == 0) {
                        value = false;
                        break;
                    }

                    if (EntryMainMemoryObject.getProductValue(iRow) < 1) {
                        value = false;
                        break;
                    }

                    if (transEntryInfo.isStockRevaluation == true) {
                        if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iValuationMethod", eMasterDataType.Number) == eValuationMethod.BatchRate) {
                            value = true;
                            break;
                        }

                        value = false;
                        break;
                    }

                    if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bDontMaintainStockbyBatch", eMasterDataType.Boolean) == true) {
                        value = false;
                        break;
                    }

                    value = true;
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, iRow) == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bIgnoreMfgDateforthisItem", eMasterDataType.Boolean) == true) { // Ignore mfg for this item
                        value = false;
                        break;
                    }

                    value = true;
                    break;
                case eVTFIELDID.FDF_EXPDATE:
                    // extra means bIgnoreOptional
                    if (DataType.toBoolean(extra) == false && transEntryInfo.BatchPref.bExpiryDatesOptional == true) {
                        value = false;
                        break;
                    }

                    if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, iRow) == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bIgnoreExpiryforthisItem", eMasterDataType.Boolean) == true) { // Ignore mfg for this item
                        value = false;
                        break;
                    }

                    value = true;
                    break;
                case eVTFIELDID.FDF_BINS:
                case eVTFIELDID.FDF_BINS2:
                    if (transEntryGrid.isValidRow(iRow) == false) {
                        value = false;
                        break;
                    }

                    if (eField == eVTFIELDID.FDF_BINS && transEntryFieldInfo.Bins.ColumnIndex < 0) {
                        value = false; // Bins column not found
                        break;
                    }

                    if (eField == eVTFIELDID.FDF_BINS2 && transEntryFieldInfo.Bins2.ColumnIndex < 0) {
                        value = false; // Bins column not found
                        break;
                    }

                    bBins2 = false;
                    if (eField == eVTFIELDID.FDF_BINS2) {
                        bBins2 = true;
                    }

                    invtag = transEntryInvTag.getElementForBins(iRow, bBins2);
                    if (DataType.isValidObject(invtag) == true) {
                        if ((typeof invtag).toLowerCase() == "string") {
                            if (DataType.toInt(OPTIONCONTROL.getControlValue(invtag)) > 0 && DataType.toBoolean(OPTIONCONTROL.getControlValue(invtag, "bDontMaintainBin")) == true) {
                                value = false; // Selected warehouse does not support bin
                                break;
                            }
                        }
                        else {
                            if (DataType.toInt(invtag.getCellData()) > 0 && DataType.toBoolean(invtag.getCellData("bDontMaintainBin")) == true) {
                                value = false; // Selected warehouse does not support bin
                                break;
                            }
                        }
                    }

                    if (transEntryFields.getUpdateStockValue() == false && transEntrySettings.isInputBinLocation == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFieldInfo.Item.FieldId == 0) {
                        value = false; // Item column not found
                        break;
                    }
                    if (EntryMainMemoryObject.getProductValue(iRow) < 1) {
                        value = false; // No item selected
                        break;
                    }

                    if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bDoNotInputBin", eMasterDataType.Boolean) == true) {
                        value = false; // Selected item does not support bin
                        break;
                    }

                    value = true;
                    break;
                case eVTFIELDID.FDF_RMANO:
                    if (transEntryGrid.isValidRow(iRow) == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFields.getUpdateStockValue() == false) {
                        value = false;
                        break;
                    }

                    if (transEntryFieldInfo.RMA.ColumnIndex < 0) {
                        value = false;
                        break;
                    }

                    if (transEntryFieldInfo.Item.FieldId == 0) {
                        value = false;
                        break;
                    }

                    if (EntryMainMemoryObject.getProductValue(iRow) < 1) {
                        value = false;
                        break;
                    }

                    if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "bDontMaintainStocksByRMA", eMasterDataType.Boolean) == true) {
                        value = false;
                        break;
                    }

                    value = true;
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryFields.isRequired} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

    getInfo: function (eField, bMetaData, bElement, iRow) {
        let bElementInfo = false;
        let objMetaData = undefined;
        let objFieldInfo = undefined;

        objFieldInfo = {};
        objFieldInfo.Exist = false;
        objFieldInfo.Area = eTranEntryFieldArea.None;
        objFieldInfo.MetaDataIndex = -1;
        objFieldInfo.ColumnIndex = -1;
        objFieldInfo.iFieldId = 0;

        if (bMetaData == true) {
            objFieldInfo.MetaData = undefined;
        }

        if (DataType.isValidObject(bElement) == true || DataType.isValidObject(iRow) == true) {
            bElementInfo = true;
            objFieldInfo.Element = undefined;
        }

        if (transEntryGlobal.FieldHelper) {
            if (transEntryGlobal.debugField == eField) {
                debugger
            }

            switch (eField) {
                case eTransEntryField.InvTag:
                    objFieldInfo.Area = transEntryGlobal.FieldHelper.Area.InvTag;
                    objFieldInfo.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.InvTag;
                    objFieldInfo.ColumnIndex = transEntryGlobal.FieldHelper.Column.InvTag;

                    if (objFieldInfo.Area != eTranEntryFieldArea.None) {
                        objFieldInfo.Exist = true;
                    }
                    break;
            }

            if (objFieldInfo.MetaDataIndex > -1) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Header[objFieldInfo.MetaDataIndex];
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[objFieldInfo.MetaDataIndex];
                }
            }

            if (bMetaData == true) {
                objFieldInfo.MetaData = objMetaData;
            }

            if (objMetaData) {
                objFieldInfo.iFieldId = objMetaData.iFieldId;
            }

            if (bElementInfo == true) {
                switch (eField) {
                    case eTransEntryField.InvTag:
                        if (transEntryInfo.isItTransfer == false) {
                            if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                                objFieldInfo.Element = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            }
                            else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                                if (objFieldInfo.ColumnIndex > -1) {
                                    iRow = DataType.toInt(iRow);
                                    if (transEntryGrid.isValidRow(iRow) == false) {
                                        break;
                                    }

                                    if (transEntryDetailPopup.isVisible() == true && transEntryDetailPopup.getRow() == iRow) {
                                        objFieldInfo.Element = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                                    }
                                    else {
                                        if (bElement == true) {
                                            objFieldInfo.Element = transEntryGrid.getCellElement(iRow, objFieldInfo.ColumnIndex);
                                        }
                                        else {
                                            objFieldInfo.Element = transEntryGrid.getCellObject(iRow, objFieldInfo.ColumnIndex);
                                        }
                                    }
                                }
                                else { // In header in special case
                                    objFieldInfo.Element = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                                }
                            }
                        }
                        break;
                }
            }
        }

        return (objFieldInfo);
    },

