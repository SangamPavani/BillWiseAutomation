    onGrid2_check: function (ele, bHeader, evt) {
        let iCounter = 0;
        let eleBody = undefined;
        let eleTr = undefined;
        let eleCheckAll = undefined;

        eleBody = document.getElementById("id_copydoc_grid2_tbody");
        if (eleBody) {
            if (bHeader == true) {
                for (iCounter = 0; iCounter < eleBody.children.length; iCounter++) {
                    eleTr = eleBody.children[iCounter];
                    if (eleTr) {
                        eleTr.children[1].children[0].checked = ele.checked;
                    }
                }
            }
            else {
                eleCheckAll = document.getElementById("id_copydoc_grid2_checkbox");
                if (eleCheckAll) {
                    if (ele.checked == true) {
                        eleCheckAll.checked = true;
                        for (iCounter = 0; iCounter < eleBody.children.length; iCounter++) {
                            eleTr = eleBody.children[iCounter];
                            if (eleTr) {
                                if (eleTr.children[1].children[0].checked == false) {
                                    eleCheckAll.checked = false;
                                    return;
                                }
                            }
                        }
                    }
                    else {
                        eleCheckAll.checked = false;
                    }
                }
            }
        }
