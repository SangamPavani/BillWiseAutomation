        }

        return(true);
    },

    adjustBill: function (objTransactionData, objTran, iSaveSource, iRow) {
        let iCounter = 0;
        let iStructIndex = -1;
        let bCheckCreditLimit = false;
        let objInput = {};
        let objParam = undefined;
        let objCustomData = null;
        let objIdNamePair = null;
        let objMetaData = null;
        let arrHeaderDocs = undefined;
        let arrFields = undefined;

        try {
            iRow = DataType.toInt(iRow);

            objInput.bARTagPresent = false;
            objInput.bARTagLinewise = false;
            objInput.bAPTagPresent = false;
            objInput.bAPTagLinewise = false;
            objInput.bHeaderBookParty = false;
            objInput.bBookParty = false;
            objInput.bCodeParty = false;
            objInput.objActType = null;
            objInput.arrBillAdjustment = [];
            objInput.Error = {};
            objInput.Error.iRow = 0;
            objInput.Error.sError = "";
            objInput.arrAdjustBillsRows = [];
            objInput.iRow = -1;
            objInput.iStructIndex = -1;

            if (DataType.isValidObject(iSaveSource) == true) {
                objInput.iSaveSource = iSaveSource;
            }

            if (iRow > 0) {
                iStructIndex = EntryMainBillwise.getStructIndex(iRow);
                objInput.iRow = iRow;
                objInput.iStructIndex = iStructIndex;
            }
            else {
                iStructIndex = 0;
            }

            if (transEntryInfo.ARAPPref.iARTagId == transEntryInfo.InvTag && transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].InvTag > 0) {
                objInput.bARTagPresent = true;

                if (transEntryFields.getArea(eTransEntryField.InvTag) == eTranEntryFieldArea.Body) {
                    objInput.bARTagLinewise = true;
                }
            }
            else if (transEntryInfo.ARAPPref.iARTagId == transEntryInfo.FATag && transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].FATag > 0) {
                objInput.bARTagPresent = true;

                if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Body) {
                    objInput.bARTagLinewise = true;
                }
            }
            else {
                if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags) == true) {
                    for (iCounter = 0; iCounter < transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags.length; iCounter++) {
                        objIdNamePair = transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags[iCounter];
                        if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iARTagId & eVTFIELDFLAG.TOFLDID)) {
                            objInput.bARTagPresent = true;
                            break;
                        }
                    }
                }

                if (objInput.bARTagPresent == true) {
                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iARTagId & eVTFIELDFLAG.TOFLDID)) {
                            objInput.bARTagLinewise = true;
                            break;
                        }
                    }
                }
                //arrTemp = DataType.arrayFilterData(transEntryGlobal.IntermediateData.objTransaction.BodyData[0].Tags, "ID", transEntryInfo.ARAPPref.iARTagId, "==");
                //objInput.bARTagPresent = arrTemp.length > 0;
            }

            if (transEntryInfo.ARAPPref.iAPTagId == transEntryInfo.InvTag && transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].InvTag > 0) {
                objInput.bAPTagPresent = true;
                if (transEntryFields.getArea(eTransEntryField.InvTag) == eTranEntryFieldArea.Body) {
                    objInput.bAPTagLinewise = true;
                }
            }
            else if (transEntryInfo.ARAPPref.iAPTagId == transEntryInfo.FATag && transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].FATag > 0) {
                objInput.bAPTagPresent = true;
                if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Body) {
                    objInput.bAPTagLinewise = true;
                }
            }
            else {
                if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags) == true) {
                    for (iCounter = 0; iCounter < transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags.length; iCounter++) {
                        objIdNamePair = transEntryGlobal.IntermediateData.objTransaction.BodyData[iStructIndex].Tags[iCounter];
                        if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iAPTagId & eVTFIELDFLAG.TOFLDID)) {
                            objInput.bAPTagPresent = true;
                            break;
                        }
                    }
                }

                if (objInput.bAPTagPresent == true) {
                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iAPTagId & eVTFIELDFLAG.TOFLDID)) {
                            objInput.bAPTagLinewise = true;
                            break;
                        }
                    }
                }
                //arrTemp = DataType.arrayFilterData(transEntryGlobal.IntermediateData.objTransaction.BodyData[0].Tags, "ID", transEntryInfo.ARAPPref.iAPTagId, "==");
                //objInput.bAPTagPresent = arrTemp.length > 0;
            }

            objInput = EntryMainBillwise.prepareCustomerwiseData(objInput, iSaveSource);
            if (objInput.Error.iRow != 0) {
                if (objInput.Error.iRow < 0) {
                    transEntryGlobal.showAlert(objInput.Error.sError, GlobalPref.getResourceValue("Exception"));
                }
                else {
                    transEntryGlobal.showAlert(objInput.Error.sError, GlobalPref.getResourceValue("Error"));
                }

                return (false);
            }

            if (objInput.arrAdjustBills.length == 0) {

                return (true);
            }


            ////if (m_arrBillAdjusted != null)
            ////    for (int i = 0; i < m_arrBillAdjusted.Length; i++)
            ////m_arrBillAdjusted[i].CurrentRow = true;

            bCheckCreditLimit = true;
            if (transEntryInfo.UserId != GlobalPref.SUPER_USER
                && EntryMain.checkPermissionInternal(SecurityActions.EnterDocsthatExceedLimit) == true) {
                bCheckCreditLimit = false;
            }

            if (bCheckCreditLimit == true
                && transEntryInfo.Settings.Misc.DontCheckCreditLimit == false
                && transEntryInfo.ARAPPref.bEnableCreditLimit == true
                && transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.SALES
                || transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.DLVCH
                || (transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.SORDR && transEntryInfo.ARAPPref.bCheckCreditLimitInOrders == true)) {

                objCustomData = {};
                objCustomData.objInput = objInput;
                objCustomData.objTransactionData = objTransactionData;
                objCustomData.bFromAdjustBill = true;



                // Remove layout fields of due to attachment field data cause error in compression
                for (iCounter = 0; iCounter < objTran.BodyData.length; iCounter++) {
                    if (DataType.arrayLength(objTran.BodyData[iCounter].BodyExtra) > 0) {
                        objTran.BodyData[iCounter].BodyExtra = null;
                    }
                }

                arrHeaderDocs = objTran.HeaderDocs;
                objTran.HeaderDocs = [];

                objParam = {};
                objParam.objTransaction = DataType.toString(objTran);

                objTran.HeaderDocs = arrHeaderDocs;

                transEntryServer.execute(eTransServerRequest.CheckCreditLimit,
                                            objParam,
                                            true,
                                            "EntryMainCallback.checkCreditLimit",
                                            objCustomData);
            }
            else {
                EntryMainBillwise.adjustBillFinal(objInput, objTransactionData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.adjustBill} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    // Sets billwise data returned from billwise screen in main data
    setBillwiseData: function (obj, objTransactionData, iRowNo) {
        let sId = "";
        let sText = "";
        let iCounter = 0;
        let iBillCounter = 0;
        let iStartRow = 0;
        let iTotal = 0;
        let dExchangeRateDiff = 0;
        let dLocalExchangeRateDiff = 0;
        let iPayAccountId = 0;
        let dRctDiscount = 0;
        let objMetaData = null;
        let bRctDiscount = false;
        let iMaskedVoucherType = 0;
        let bUpdateObject = false;
        let cell = null;
        let result = null;

        try {
            if (transEntryGlobal.debugBillwise == true) {
                debugger
            }

            if (DataType.isValidObject(obj) == true) {
                if (EntryMainUI.createExchangeRateFields() == true) {
                    return (null);
                }

                bRctDiscount = false;
                iMaskedVoucherType = transEntryInfo.BaseVoucherType;
                if ((iMaskedVoucherType == eVTTYPE.CASHR || iMaskedVoucherType == eVTTYPE.CASHP)
                    && transEntryFieldInfo.RctDiscount.Area != eTranEntryFieldArea.None) {

                    bRctDiscount = true;
                }

                for (iCounter = 0; iCounter < obj.length; iCounter++) {
                    if (DataType.isValidObject(objTransactionData) == true) {
                        result = EntryMainUI.getCustomerRow(obj[iCounter].CustomerId, iStartRow, objTransactionData);
                        if (result.lValue <= 0) {
                            continue;
                        }

                        iStartRow = result.data;
                        objTransactionData.Body[iStartRow].BillwiseData = DataType.toString(obj[iCounter].arrAdjustedBills);

                        bUpdateObject = true;
                    }
                    else {
                        iStartRow = iRowNo;

                        bUpdateObject = false;
                    }

                    if (transEntryInfo.Settings.Misc.PostExchangeRate == true) {
                        dExchangeRateDiff = 0;
                        dLocalExchangeRateDiff = 0;

                        iTotal = DataType.arrayLength(obj[iCounter].arrAdjustedBills);
                        for (iBillCounter = 0; iBillCounter < iTotal; iBillCounter++) {
                            dExchangeRateDiff = FNumberOperation.add(dExchangeRateDiff, obj[iCounter].arrAdjustedBills[iBillCounter].mExchangeDifference);
                            dLocalExchangeRateDiff = FNumberOperation.add(dLocalExchangeRateDiff, obj[iCounter].arrAdjustedBills[iBillCounter].mLocalExchangeDiff);
                        }

                        if (transEntryFieldInfo.ExchangeRateDiff.Area == eTranEntryFieldArea.Header) {
                            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.ExchangeRateDiff.FieldId);

                            if (bUpdateObject == true) {
                                objTransactionData.Header[sId] = dExchangeRateDiff;
                            }
                            else {
                                document.getElementById(sId).value = dExchangeRateDiff;
                            }                            
                        }
                        else if (transEntryFieldInfo.ExchangeRateDiff.Area == eTranEntryFieldArea.Body) {                            
                            if (bUpdateObject == true) {
                                sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.ExchangeRateDiff.FieldId);
                                objTransactionData.Body[iStartRow][sId] = dExchangeRateDiff;
                            }
                            else {
                                cell = transEntryGrid.getCellObject(iRowNo, transEntryFieldInfo.ExchangeRateDiff.ColumnIndex);
                                if (DataType.isValidObject(cell) == true) {
                                    objMetaData = transEntryFieldInfo.ExchangeRateDiff.MetaData;

                                    sText = FNumberOperation.toFixed(dExchangeRateDiff, objMetaData.iNoDecimal);
                                    cell.setCellText(DataType.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), dExchangeRateDiff);
                                }
                            }
                        }

                        if (transEntryFieldInfo.LocalExchangeRateDiff.Area == eTranEntryFieldArea.Header) {
                            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.LocalExchangeRateDiff.FieldId);

                            if (bUpdateObject == true) {
                                objTransactionData.Header[sId] = dLocalExchangeRateDiff;
                            }
                            else {
                                document.getElementById(sId) = dLocalExchangeRateDiff;
                            }
                        }
                        else if (transEntryFieldInfo.LocalExchangeRateDiff.Area == eTranEntryFieldArea.Body) {                            

                            if (bUpdateObject == true) {
                                sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.LocalExchangeRateDiff.FieldId);
                                objTransactionData.Body[iStartRow][sId] = dLocalExchangeRateDiff;
                            }
                            else {
                                cell = transEntryGrid.getCellObject(iRowNo, transEntryFieldInfo.LocalExchangeRateDiff.ColumnIndex);
                                if (DataType.isValidObject(cell) == true) {
                                    objMetaData = transEntryFieldInfo.LocalExchangeRateDiff.MetaData;

                                    sText = FNumberOperation.toFixed(dLocalExchangeRateDiff, objMetaData.iNoDecimal);
                                    cell.setCellText(DataType.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), dLocalExchangeRateDiff);
                                }
                            }
                        }
                    }

                    if (bRctDiscount == true && transEntryFieldInfo.RctDiscount.Area == eTranEntryFieldArea.Body) {
                        objMetaData = transEntryFieldInfo.RctDiscount.MetaData;
                        sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                        dRctDiscount = 0;
                        iPayAccountId = 0;

                        iTotal = DataType.arrayLength(obj[iCounter].arrAdjustedBills);
                        for (iBillCounter = 0; iBillCounter < iTotal; iBillCounter++) {
                            if (bRctDiscount == true && obj[iCounter].arrAdjustedBills[iBillCounter].iFlag == AdjustmentFlag.get("PaymentTermsAdjustments")) {
                                dRctDiscount += obj[iCounter].arrAdjustedBills[iBillCounter].mNativeCurrency;
                            }

                            if (bRctDiscount == true && obj[iCounter].arrAdjustedBills[iBillCounter].iFlag == AdjustmentFlag.get("NONE")) {
                                //dRctDiscount += obj[iCounter].arrAdjustedBills[iBillCounter].dDiscountAmountTC;
                                if (obj[iCounter].arrAdjustedBills[iBillCounter].iPayAccountId > 0) {
                                    iPayAccountId = obj[iCounter].arrAdjustedBills[iBillCounter].iPayAccountId;
                                }
                            }
                        }

                        if (bUpdateObject == true) {
                            objTransactionData.Body[iStartRow][sId] = DataType.toString({ ID: objMetaData.iFieldId, Name: iPayAccountId, Tag: dRctDiscount });
                        }
                        else {
                            cell = transEntryGrid.getCellObject(iRowNo, transEntryFieldInfo.RctDiscount.ColumnIndex);
                            if (DataType.isValidObject(cell) == true) {
                                sText = FNumberOperation.toFixed(dRctDiscount, objMetaData.iNoDecimal);
                                cell.setCellText(DataType.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), dRctDiscount);
                                cell.setCellData({ ID: objMetaData.iFieldId, Name: iPayAccountId, Tag: dRctDiscount, value: dRctDiscount });
                            }
                        }                        
                    }

                    if (bUpdateObject == true && result.Area == eTranEntryFieldArea.Body) {
                        iStartRow++;
                    }
                }

                if (obj.length == 0 && DataType.isValidObject(objTransactionData) == true) {
                    objTransactionData.Body[0].BillwiseData = "";
                }

                return (objTransactionData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.setBillwiseData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (null);
    },

    saveData: function (obj, objTempTransactionData) {
        let sCallback = "";
        let iSaveSource = 0;

        try {
            iSaveSource = DataType.toInt(FUIElement.getAttribute(EntryMainUI.getOthersContainer(), "savesource"));

            if (DataType.isValidObject(obj) == true) {
                transEntryGlobal.TempTransactionData = EntryMainBillwise.setBillwiseData(obj, objTempTransactionData);
                transEntryGlobal.TempRowNo = -1;
                transEntryGlobal.AdjustBillsCount = 0;

                if (DataType.isValidObject(transEntryGlobal.TempTransactionData) == true) {
                    sCallback = FUIElement.getAttribute(EntryMainUI.getOthersContainer(), "callback");

                    if (iSaveSource == eTranEntrySaveSource.Version && transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgConfirmRevision")) == false) {
                        if (transEntryGlobal.WriteLog == true) {
                            transEntryGlobal.writeConsoleLog("Exit: {EntryMainBillwise.saveData}[Message='msgConfirmRevision']");
                        }

                        EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                        return;
                    }

                    EntryMainUI.postVoucher(transEntryGlobal.TempTransactionData, false, sCallback, iSaveSource);
                }
                else {
                    EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                }
            }
            else {
                EntryMainUI.resetOthersContainer();
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.saveData} " + err.message, GlobalPref.getResourceValue("Exception"));
            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
        }
    },

    checkBillwise: function () {
        let bOnSaveBillwise = false;

        try {
            if (transEntryInfo.isStockAdjustment == true || transEntryInfo.isStockRevaluation == true) {
                return (false);
            }

            if(transEntryInfo.isItTransfer == true && transEntryInfo.AccountPref.iDontBalanceStockTransfer == 0) { // Do not balance stock transfers when posting to FA
                return (false);
            }

            if (transEntryInfo.Settings.Misc.UpdateFA == true
                || transEntryInfo.BaseVoucherType == eVTTYPE.MEMOP
                || transEntryInfo.BaseVoucherType == eVTTYPE.MEMOR) {

                bOnSaveBillwise = true;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.checkBillwise} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bOnSaveBillwise);
    },

    moveBillwiseRowData: function (iOldRow, iNewRow) {
        let iRow = 0;
        //let eleRow = undefined;
        let data = undefined;

        try {
            if (transEntryGlobal.debugBillwise == true) {
                debugger
            }

            if (transEntryInfo.HeaderId <= 0) {
                return;
            }

            if (EntryMainBillwise.isSingleBillwiseVoucher() == false) {
                return;
            }

            if (iNewRow == undefined || iNewRow == null) {
                if (DataType.arrayLength(transEntryGlobal.arrLoadedData) > 0
                    && DataType.arrayLength(transEntryGlobal.arrLoadedData[0].BillwiseData) > 0) {

                    for (iRow = transEntryGrid.getTotalRows(); iRow > 0; iRow--) {
                        data = transEntryFields.getBillwise(iRow);
                        if (DataType.isValidObject(data) == true) {
                            if (iRow > 1) {
                                data[0].iBodyId = transEntryFields.getBodyId(1);
                                transEntryGrid.setRowData(1, eRowDataName.BillwiseData, data);
                                transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, "");
                            }
                            else if (data[0].iBodyId != transEntryFields.getBodyId(1)) {
                                data[0].iBodyId = transEntryFields.getBodyId(1);
                                transEntryGrid.setRowData(1, eRowDataName.BillwiseData, data);
                                transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, "");
                            }

                            transEntryGlobal.arrLoadedData[0].BillwiseData[0].iBodyId = data[0].iBodyId;
                            break;
                        }
                    }
                }
            }
            else {
                data = transEntryFields.getBillwise(iOldRow);
                if (data && data.length > 0) {
                    data[0].iBodyId = transEntryFields.getBodyId(iNewRow);
                }
                data = DataType.toString(data);
                transEntryGrid.setRowData(iNewRow, eRowDataName.BillwiseData, data);
                transEntryGrid.setRowData(iOldRow, eRowDataName.BillwiseData, "");

                //    eleRow = transEntryGrid.getRowElement(iOldRow);
                //    if (eleRow) {
                //        data = FGRIDCONTROL.getRowData(eleRow, eRowDataName.BillwiseData);
                //        transEntryGrid.setRowData(iNewRow, eRowDataName.BillwiseData, data);
                //        transEntryGrid.setRowData(iOldRow, eRowDataName.BillwiseData, "");
                //    }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.moveBillwiseRowData} " + err.message, GlobalPref.getResourceValue("Exception"));
            throw err;
        }
    },

    isSingleBillwiseVoucher: function () {
        let bResult = false;

        bResult = transEntryInfo.Settings.Misc.UpdateFA == true
            && (transEntryInfo.isItSales
                || transEntryInfo.BaseVoucherType == eVTTYPE.DEBNT
                || transEntryInfo.BaseVoucherType == eVTTYPE.CRDNT);

        return (bResult);
    },

    getStructIndex: function(iRowIndex) {
        let iCounter = 0;
        let iGridRow = 0;

        try {
            if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction) == false) {
                return(-1);
            }

            if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.BodyData) == false) {
                return(-1);
            }

            iGridRow = 0;
            for(iCounter = 0; iCounter < transEntryGlobal.IntermediateData.objTransaction.BodyData.length; iCounter++) {
                if (transEntryGlobal.IntermediateData.objTransaction.BodyData[iCounter].RowType != _RowType.Default) {
                    continue;
                }

                iGridRow++;
                if (iGridRow == iRowIndex) {
                    return(iCounter);
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.getStructIndex} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(-1);
    },

    adjustBillFinal: function (objInput, objTransactionData) {
        let iCounter = 0;
        let objRefType = null;

        try {
            if (transEntryInfo.Settings.Misc.NarrationFieldId > 0 && transEntryFieldInfo.Narration.FieldId > 0) {
                for (iCounter = 0; iCounter < objInput.arrAdjustBills.length && iCounter < objInput.arrAdjustBillsRows.length; iCounter++) {
                    objInput.arrAdjustBills[iCounter].Narration = EntryMainUI.getValue(transEntryFieldInfo.Narration, objInput.arrAdjustBillsRows[iCounter]);
                }
            }

            objRefType = transEntryFields.getRaiseReceiptValue();
            if(objRefType == true) {
                objRefType = CallingType.get("ALWAYSNEWREF");
            }
            else if(objRefType == false) {
                objRefType = transEntryInfo.Settings.Misc.ARAPBillAdj;
            }
            else {
                objRefType = transEntryInfo.Settings.Misc.ARAPBillAdj;
            }

            transEntryGlobal.TempTransactionData = objTransactionData;
            transEntryGlobal.TempRowNo = objInput.iRow;
            transEntryGlobal.BreakupByTagCount = 0;
            transEntryGlobal.AdjustBillsCount = objInput.arrAdjustBills.length;

            if (objInput.arrAdjustBills.length > 0) {
                transEntryGlobal.BreakupByTagCount = objInput.arrAdjustBills[0].arrBreakupByTag.length;
            }

            if (transEntryGlobal.debugSave == true || transEntryGlobal.debugBillwise == true) {
                debugger
            }

            if (EntryMainBillwise.isSingleBillwiseVoucher() == true) {
                if (objInput.arrAdjustBills[0] &&
                    objInput.arrAdjustBills[0].arrAdjustedReferences &&
                    objInput.arrAdjustBills[0].arrAdjustedReferences.length == 0) {

                    for (iCounter = 0; iCounter < transEntryGlobal.arrLoadedData.length; iCounter++) {
                        if (DataType.isValidObject(transEntryGlobal.arrLoadedData[iCounter].BillwiseData) == true) {
                            objInput.arrAdjustBills[0].arrAdjustedReferences = transEntryGlobal.arrLoadedData[iCounter].BillwiseData;
                            break;
                        }
                    }

                    if (objInput.arrAdjustBills[0] &&
                        objInput.arrAdjustBills[0].arrAdjustedReferences &&
                        objInput.arrAdjustBills[0].arrAdjustedReferences.length > 0) {

                        for (iCounter = 0; iCounter < objInput.arrAdjustBills[0].arrAdjustedReferences.length; iCounter++) {
                            objInput.arrAdjustBills[0].arrAdjustedReferences[iCounter].iBodyId = transEntryFields.getBodyId(1);
                        }
                    }
                }
            }

            AdjustBills_Screen.AdjustBills(objInput.arrAdjustBills, // AdjustBills
                objRefType,
                transEntryInfo.Settings.Misc.ARAPOptions, // ReferenceType
                EntryMain.m_objTrans.Header.Date, // iInvoiceDate
                0, // iInvoiceTime
                transEntryInfo.isItSales, // bInventoryType
                transEntryInfo.HeaderId,
                transEntrySettings.isHirePurchaseBehaviour, // bHirePurchase
                transEntryGlobal.EntryModel.Rights.AllowOnAccount, // bAllowOnAccount
                EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true), // sInvoiceNo
                transEntryGlobal.IntermediateData.objTransaction.BodyData[0].FATag, // iFATagId
                transEntryInfo.BaseVoucherType, // iVTType
                objInput.objActType, // iAccountType
                transEntrySettings.isSelectBillsBeforeAmount, // transEntryInfo.BodySectionNotRequired, // bBeforeAmount
                true, // bHideSave
                transEntryInfo.Settings.Documents.Name,
                EntryMain.m_arrBillwiseDirtyRow,
                transEntrySettings.isAdjustBillInLine
                );
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.adjustBillFinal} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getData: function (iRow) {
        let objBillwise = null;

        if (this.isSingleBillwiseVoucher() == true) {
            for (; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    continue;
                }

                objBillwise = transEntryFields.getBillwise(iRow);
                if (DataType.isValidObject(objBillwise) == true) {
                    break;
                }
            }
        }
        else {
            objBillwise = transEntryFields.getBillwise(iRow);
        }

        return (objBillwise);
    },

    prepareCustomerwiseData: function (objInput, iSaveSource) {
        let iRow = 0;
        let iGridRow = 0;
        let iCounter = 0;
        let iTotal = 0;
        let iIndex = 0;
        let iAccount = 0;
        let dNet = 0;
        let dTransNet = 0;
        let objBillAdjustment = null;
        let arrAdjustBills = [];
        let objAdjustBills = null;
        let objIdNamePair = null;
        let result = null;
        let bAdjustBills = false;
        let bPositive = false;
        let iMaskedVoucherType = 0;
        let objBodyData = null;
        let bCheckZeroRow = false;
        let bRowIndexChanged = false;
        let bMatch = false;
        let arrLoaded = null;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objTemp = null;

        try {
            if (transEntryGlobal.debugBillwise == true) {
                debugger
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            objInput.objActType = eAccountTypes.Customer;
            //objAdjustBills = FocusDataStructs.getAdjustBillsObject();

            bCheckZeroRow = false;
            if (FConvert.isItSales(iMaskedVoucherType) == true || iMaskedVoucherType == eVTTYPE.DEBNT || iMaskedVoucherType == eVTTYPE.CRDNT) {
                bCheckZeroRow = true;
            }

            iTotal = transEntryGlobal.IntermediateData.objTransaction.BodyData.length;
            if (transEntryInfo.isItTransfer == true) {
                iTotal /= 2;
            }

            iGridRow = -1;
            for (iRow = 0; iRow < iTotal; iRow++) {
                objBodyData = transEntryGlobal.IntermediateData.objTransaction.BodyData[iRow];
                if (objBodyData.Flags.SuspendFA) {
                    result = EntryMainUI.getBodyDataFromLoadedBodyId(objBodyData.BodyId);
                    if (result.lValue > 0) {
                        if (result.data.AuthStatus == _eAuthStatus.Authorized) {
                            continue;
                        }
                    }
                }

                if (objBodyData.RowType != _RowType.Default) {
                    //continue;
                    bRowIndexChanged = false;
                }
                else {
                    iGridRow++;
                    bRowIndexChanged = true;
                }

                if(objInput.iStructIndex > -1 
                && !((iRow == objInput.iStructIndex && objBodyData.RowType == _RowType.Default) || (objBodyData.RowType == _RowType.AccountToPost && objBodyData.MainBodyId == (objInput.iRow - 1)))) {
                    continue;
                }

                if (EntryMainBody.isRowReadOnly(iGridRow + 1, true, eVTFIELDID.FDF_REFERENCE) == true) {
                    continue;
                }

                objInput.bBookParty = EntryMainCommon.isPartyType(transEntryGlobal.IntermediateData.arrBookTypes[iRow]);
                if (iRow == 0) {
                    objInput.bHeaderBookParty = objInput.bBookParty;
                }

                objInput.bCodeParty = EntryMainCommon.isPartyType(transEntryGlobal.IntermediateData.arrCodeTypes[iRow]);
                if (iRow == 0) {
                    if (objInput.bBookParty == true) {
                        objInput.objActType = transEntryGlobal.IntermediateData.arrBookTypes[iRow];
                    }
                    else if (objInput.bCodeParty == true) {
                        objInput.objActType = transEntryGlobal.IntermediateData.arrCodeTypes[iRow];
                    }
                }

                if (objInput.bBookParty == false && objInput.bCodeParty == false) {
                    continue;
                }

                if (objInput.bBookParty == true && objInput.bCodeParty == true) {
                    if ((iSaveSource == eTranEntrySaveSource.Save && EntryMainBillwise.isSingleBillwiseVoucher() == true)
                        || (iMaskedVoucherType == eVTTYPE.SORDR && transEntryInfo.ARAPPref.bCheckCreditLimitInOrders == true)) {

                        objInput.Error = {};
                        objInput.Error.iRow = iRow + 1;
                        objInput.Error.sError = "Both the accounts cannot be of party type.";

                        return (objInput);
                    }
                }


                bMatch = false;
                if (bCheckZeroRow == true) {
                    if ((objInput.bBookParty == true && objBodyData.Book == transEntryGlobal.IntermediateData.objTransaction.BodyData[0].Book)
                    || (objInput.bCodeParty == true && objBodyData.Code == transEntryGlobal.IntermediateData.objTransaction.BodyData[0].Code)) {
                        bMatch = true;
                    }
                }
                else {
                    if (objInput.bBookParty == true || objInput.bCodeParty == true) {
                        bMatch = true;
                    }
                }

                bAdjustBills = false;
                if (bMatch == true) {                    
                    if(bRowIndexChanged == true) {
                        if(DataType.isValidObject(objAdjustBills) == false || EntryMainBillwise.isSingleBillwiseVoucher() == false) {
                            objAdjustBills = FocusDataStructs.getAdjustBillsObject();
                            bAdjustBills = true;
                        }
                    }

                    objBillAdjustment = FocusDataStructs.getBillAdjustmentObject();
                    objBillAdjustment.dDueDate = objBodyData.DueDate;

                    if (objInput.bCodeParty == true) {
                        objBillAdjustment.iAccount = objBodyData.Book;
                    }
                    else {
                        objBillAdjustment.iAccount = objBodyData.Code;
                    }

                    objBillAdjustment.iCurrencyId = objBodyData.CurrencyId;
                    objBillAdjustment.iNoOfDecimals = transEntrySettings.getDecimalsInAmount(iRow + 1);
                    objBillAdjustment.mBAIDInvoiceCurrency = objBodyData.OriginalAmounts[objInput.bCodeParty == true ? 0 : 1];
                    //objBillAdjustment.mBAIDInvoiceCurrency = transEntry.rectifyAmountValue(objBillAdjustment.mBAIDInvoiceCurrency);

                    objBillAdjustment.mBATDBillCurrency = objBillAdjustment.mBAIDInvoiceCurrency;
                    objBillAdjustment.mBATDBaseCurrency = objBodyData.Amounts[objInput.bCodeParty == true ? 0 : 1];
                    //objBillAdjustment.mBATDBaseCurrency = transEntry.rectifyAmountValue(objBillAdjustment.mBATDBaseCurrency);

                    objBillAdjustment.mBAIDConversionRate = DataType.toDecimal(objBodyData.ExchangeRate);
                    objBillAdjustment.mBATDConversionRate = objBillAdjustment.mBAIDConversionRate;

                    objBillAdjustment.mBAIDLocalConversionRate = DataType.toDecimal(objBodyData.LocalExchangeRate);
                    objBillAdjustment.mBATDLocalConversionRate = objBillAdjustment.mBAIDLocalConversionRate;


                    if (transEntryInfo.isItSales == true && DataType.isValidObject(objBodyData.Sales) == true) {
                        objBillAdjustment.iProduct = objBodyData.Sales.Product;
                    }

                    if (objInput.bARTagPresent == true) {
                        if (transEntryInfo.ARAPPref.iARTagId == transEntryInfo.FATag) {
                            objBillAdjustment.iARTag = objBodyData.FATag;
                        }
                        else if (transEntryInfo.ARAPPref.iARTagId == transEntryInfo.InvTag) {
                            objBillAdjustment.iARTag = objBodyData.InvTag;
                        }
                        else {
                            if (DataType.isValidObject(objBodyData.Tags) == true) {
                                for (iCounter = 0; iCounter < objBodyData.Tags.length; iCounter++) {
                                    objIdNamePair = objBodyData.Tags[iCounter];
                                    if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iARTagId & eVTFIELDFLAG.TOFLDID)) {
                                        objBillAdjustment.iARTag = objIdNamePair.Tag;
                                        break;
                                    }
                                }
                            }
                        }
                    }

                    if (objInput.bAPTagPresent == true) {
                        if (transEntryInfo.ARAPPref.iAPTagId == transEntryInfo.FATag) {
                            objBillAdjustment.iAPTag = objBodyData.FATag;
                        }
                        else if (transEntryInfo.ARAPPref.iAPTagId == transEntryInfo.InvTag) {
                            objBillAdjustment.iAPTag = objBodyData.InvTag;
                        }
                        else {
                            if (DataType.isValidObject(objBodyData.Tags) == true) {
                                for (iCounter = 0; iCounter < objBodyData.Tags.length; iCounter++) {
                                    objIdNamePair = objBodyData.Tags[iCounter];
                                    if ((objIdNamePair.ID & eVTFIELDFLAG.TOFLDID) == (transEntryInfo.ARAPPref.iAPTagId & eVTFIELDFLAG.TOFLDID)) {
                                        objBillAdjustment.iAPTag = objIdNamePair.Tag;
                                        break;
                                    }
                                }
                            }
                        }
                    }

                    objBillAdjustment.iBodyId = objBodyData.BodyId;

                    if (objInput.bBookParty == true) {
                        objBillAdjustment.iCode = objBodyData.Book;

                        if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                            objBillAdjustment.iCode = transEntryData.getTagValue(objBodyData, transEntryFieldInfo.SubLedger.FieldId);
                        }
                    }
                    else {
                        objBillAdjustment.iCode = objBodyData.Code;

                        if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                            objBillAdjustment.iCode = transEntryData.getTagValue(objBodyData, transEntryFieldInfo.SubLedger.FieldId);
                        }
                    }

                    objBillAdjustment.PaymentTerm = transEntryFields.getPmtTerms();

                    bPositive = objBillAdjustment.mBAIDInvoiceCurrency > 0;
                    if (iMaskedVoucherType == eVTTYPE.JOURN || iMaskedVoucherType == eVTTYPE.OPBAL) {
                        objAdjustBills.PositiveAmount = bPositive;
                    }
                    else if (objInput.bCodeParty == true) {
                        objAdjustBills.PositiveAmount = !transEntryInfo.isItNegative;
                    }
                    else {
                        objAdjustBills.PositiveAmount = transEntryInfo.isItNegative;
                    }

                    if (objInput.bBookParty == true) {
                        objAdjustBills.AccountType = transEntryGlobal.IntermediateData.arrBookTypes[iRow];
                    }
                    else if (objInput.bCodeParty == true) {
                        objAdjustBills.AccountType = transEntryGlobal.IntermediateData.arrCodeTypes[iRow];
                    }

                    objAdjustBills.FATagId = objBodyData.FATag;


                    if (objAdjustBills.CustomerId == 0 || bAdjustBills == true || EntryMainBillwise.isSingleBillwiseVoucher() == true) {
                        objAdjustBills.CustomerId = objBillAdjustment.iCode;
                    }

                    //objAdjustBills.CustomerId = objBillAdjustment.iCode;


                    objAdjustBills.arrBreakupByTag.push(objBillAdjustment);

                    if (objBillAdjustment.iBodyId > 0)
                    {
                        if (EntryMainBillwise.isSingleBillwiseVoucher() == true)
                        {
                            for (iCounter = 0; iCounter < transEntryGlobal.arrLoadedData.length; iCounter++)
                            {
                                if (DataType.isValidObject(transEntryGlobal.arrLoadedData[iCounter].BillwiseData) == true) {
                                    objAdjustBills.arrAdjustedReferences = transEntryGlobal.arrLoadedData[iCounter].BillwiseData;
                                    break;
                                }
                            }
                        }
                        else
                        {
                            if(objInput.iRow < 1 && objInput.iStructIndex < 0) {
                                arrLoaded = DataType.arrayFilterData(transEntryGlobal.arrLoadedData, eTranEntryBodyDataConstKey.BodyId, objBillAdjustment.iBodyId, "===");
                                if (arrLoaded.length > 0) {
                                    for (iCounter = 0; iCounter < DataType.arrayLength(arrLoaded[0].BillwiseData); iCounter++) {
                                        arrLoaded[0].BillwiseData[iCounter].CurrentRow = false;
                                    }

                                    objAdjustBills.arrAdjustedReferences = arrLoaded[0].BillwiseData;
                                }
                            }
                            else if(objInput.iRow > 0 && objInput.iStructIndex > -1) {
                                objTemp = transEntryFields.getBillwise(objInput.iRow);
                                if (DataType.arrayLength(objTemp) < 1) {
                                    arrLoaded = DataType.arrayFilterData(transEntryGlobal.arrLoadedData, eTranEntryBodyDataConstKey.BodyId, objBillAdjustment.iBodyId, "===");
                                    if (arrLoaded.length > 0) {
                                        for (iCounter = 0; iCounter < DataType.arrayLength(arrLoaded[0].BillwiseData); iCounter++) {
                                            arrLoaded[0].BillwiseData[iCounter].CurrentRow = true;
                                        }

                                        objAdjustBills.arrAdjustedReferences = DataType.arrayAddRange(objAdjustBills.arrAdjustedReferences, arrLoaded[0].BillwiseData);
                                    }
                                }
                            }
                        }
                    }
                    else {
                        if (objInput.iRow == 0) { // Not Linewise bill adjustment
                            objTemp = transEntryFields.getBillwise(iGridRow + 1);
                            if (DataType.isValidObject(objTemp) == true) {
                                objAdjustBills.arrAdjustedReferences = objTemp;
                            }
                        }
                    }

                    if (EntryMainBillwise.isSingleBillwiseVoucher() == true) {
                        if (arrAdjustBills.length == 0) {
                            arrAdjustBills.push(objAdjustBills);
                            objInput.arrAdjustBillsRows.push(iGridRow + 1);
                        }
                    }
                    else {
                        if (objInput.iRow > 0 && objInput.iStructIndex > -1) { // Linewise bill adjustment
                            objTemp = transEntryFields.getBillwise(objInput.iRow);
                            if (DataType.arrayLength(objTemp) > 0) {
                                for (iCounter = 0; iCounter < objTemp.length; iCounter++) {
                                    objTemp[iCounter].CurrentRow = true;
                                }

                                if(bRowIndexChanged == true) {
                                    objAdjustBills.arrAdjustedReferences = DataType.arrayAddRange(objAdjustBills.arrAdjustedReferences, objTemp);
                                }
                                //objAdjustBills.arrAdjustedReferences = DataType.arrayAddRange(objAdjustBills.arrAdjustedReferences, objTemp);
                            }

                            for (iIndex = 1; iIndex <= transEntryGrid.getTotalRows() ; iIndex++) {
                                if (iIndex == objInput.iRow) {
                                    continue;
                                }

                                objTemp = transEntryFields.getBillwise(iIndex);
                                if (DataType.arrayLength(objTemp) < 1) {
                                    continue;
                                }


                                if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                                    objBillAdjustment.iCode = transEntryData.getTagValue(objBodyData, transEntryFieldInfo.SubLedger.FieldId);
                                }

                                iAccount = 0;
                                if(objInput.bBookParty == true) {
                                    iAccount = transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex].Book;

                                    if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                                        iAccount = transEntryData.getTagValue(transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex], transEntryFieldInfo.SubLedger.FieldId);
                                    }
                                }
                                else {
                                    iAccount = transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex].Code;

                                    if (transEntryFieldInfo.SubLedger.FieldId > 0) {
                                        iAccount = transEntryData.getTagValue(transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex], transEntryFieldInfo.SubLedger.FieldId);
                                    }
                                }

                                //if (objTemp[0].iCode == (objInput.bBookParty ? transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex].Book : transEntryGlobal.IntermediateData.objTransaction.BodyData[objInput.iStructIndex].Code)) {
                                  if(objTemp[0].iCode == iAccount) {
                                    for (iCounter = 0; iCounter < objTemp.length; iCounter++) {
                                        if (iIndex == objInput.iRow) {
                                            objTemp[iCounter].CurrentRow = true;
                                        }
                                        else {
                                            objTemp[iCounter].CurrentRow = false;
                                        }
                                    }

                                    objAdjustBills.arrAdjustedReferences = DataType.arrayAddRange(objAdjustBills.arrAdjustedReferences, objTemp);
                                }                                    
                            }                            
                        }

                        if(bRowIndexChanged == true) {
                            arrAdjustBills.push(objAdjustBills);
                        }

                        //arrAdjustBills.push(objAdjustBills);
                        objInput.arrAdjustBillsRows.push(iGridRow + 1);

                        //objAdjustBills = FocusDataStructs.getAdjustBillsObject();
                    }
                }
            }

            if (arrAdjustBills.length > 0) {
                if (transEntryFields.getPmtTerms() > 0) {
                    if (DataType.isNullOrEmpty(transEntryInfo.Settings.Misc.PmtTermsFormula, true) == false) {
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(transEntryInfo.Settings.Misc.PmtTermsFormula, 0, null, 0);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);

                        arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmtTC = DataType.toDecimal(objFormulaOutput.Value);
                        arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmt = arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmtTC * transEntryFields.getExchangeRate(1);
                        arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmt = EntryMain.roundOff(arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmt, GlobalPref.DefaultCurrency.GeneralRoundOff, GlobalPref.DefaultCurrency.RoundingType);
                    }
                    else {
                        dNet = 0;
                        dTransNet = 0;

                        for (iCounter = 0; iCounter < arrAdjustBills[0].arrBreakupByTag.length; iCounter++) {
                            dNet = FNumberOperation.add(dNet, arrAdjustBills[0].arrBreakupByTag[iCounter].mBATDBaseCurrency);
                            dTransNet = FNumberOperation.add(dTransNet, arrAdjustBills[0].arrBreakupByTag[iCounter].mBAIDInvoiceCurrency);
                        }

                        arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmt = FNumberOperation.abs(dNet);
                        arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmtTC = FNumberOperation.abs(dTransNet);
                    }
                }
                else {
                    arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmt = 0;
                    arrAdjustBills[0].arrBreakupByTag[0].mApplyPTOnAmtTC = 0;
                }
            }

            objInput.arrAdjustBills = arrAdjustBills;
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainBillwise.prepareCustomerwiseData} " + err.message, GlobalPref.getResourceValue("Exception"));

            objInput.Error = {};
            objInput.Error.iRow = -1;
            objInput.Error.sError = err.message;
        }

        return (objInput);
    },

    makeRowDirty: function(iRow) {
        let iAccountTypeId = 0;
        let iStartRow = 0;
        let iEndRow = 0;
        let bFound = false;

        try {
            if (transEntryFieldInfo.Billwise.FieldId == 0) {
                return;
            }

            if (transEntryFieldInfo.Code.Area != eTranEntryFieldArea.Body
                && transEntryFieldInfo.Book.Area != eTranEntryFieldArea.Body) {
                return;
            }

            iRow = DataType.toInt(iRow);

            if (iRow < 1) {
                if (EntryMainBody.getFirstEditableRow() < 1) {
                    return;
                }

                iStartRow = 1;
                iEndRow = transEntryGrid.getTotalRows();
            }
            else {
                iStartRow = iRow;
                iEndRow = iRow;
            }

            for (; iStartRow <= iEndRow; iStartRow++) {
                if (EntryMainBody.isRowEditable(iStartRow) == false) {
                    continue;
                }

                bFound = false;
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    if (EntryMainMemoryObject.getCodeValue(iStartRow) > 0) {
                        iAccountTypeId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Code, iStartRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            bFound = true;
                        }
                    }
                }

                if (bFound == false && transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                    if (EntryMainMemoryObject.getBookValue(iStartRow) > 0) {
                        iAccountTypeId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, iStartRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            bFound = true;
                        }
                    }
                }

                if (bFound == false && iRow < 1 && transEntryInfo.BodySectionNotRequired == true) {
                    bFound = true;
                }

                if (bFound == true) {
                    transEntryGrid.setRowData(iStartRow, eRowDataName.BillwiseRequired, true);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.makeRowDirty} " + err.message, GlobalPref.getResourceValue("Exception"))
        }
    },

    updateDirtyRowFlag: function (iRow, iFieldId, bIgnoreHeaderIdCheck) {
        let iAccountTypeId = 0;
        let iStartRow = 0;
        let iEndRow = 0;
        let iCurrentRow = 0;
        let iIndex = 0;
        let bFound = false;
        let objCodeInfo = undefined;
        let objBookInfo = undefined;
        let obj = null;

        try {
            if (transEntryInfo.HeaderId < 1 && bIgnoreHeaderIdCheck != true) {
                return;
            }

            objCodeInfo = transEntryFieldInfo.Code;
            objBookInfo = transEntryFieldInfo.Book;

            if (objCodeInfo.Area != eTranEntryFieldArea.Body
                && objBookInfo.Area != eTranEntryFieldArea.Body) {
                return;
            }

            iRow = DataType.toInt(iRow);

            if (iRow < 1) {
                if (EntryMainBody.getFirstEditableRow() < 1) {
                    return;
                }

                iStartRow = 1;
                iEndRow = transEntryGrid.getTotalRows();
            }
            else {
                iStartRow = iRow;
                iEndRow = iRow;
            }

            for (; iStartRow <= iEndRow; iStartRow++) {
                if (EntryMainBody.isRowEditable(iStartRow) == false) {
                    continue;
                }

                bFound = false;
                if (objCodeInfo.Area == eTranEntryFieldArea.Body) {
                    if (EntryMainMemoryObject.getCodeValue(iStartRow) > 0) {
                        iAccountTypeId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Code, iStartRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            bFound = true;
                        }
                    }
                }

                if (bFound == false && objBookInfo.Area == eTranEntryFieldArea.Body) {
                    if (EntryMainMemoryObject.getBookValue(iStartRow) > 0) {
                        iAccountTypeId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, iStartRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                            bFound = true;
                        }
                    }
                }

                if (bFound == false && iRow < 1 && transEntryInfo.BodySectionNotRequired == true) {
                    bFound = true;
                }

                if (bFound == true) {

                    if (iRow < 1) {
                        iCurrentRow = 0;
                        if (EntryMainBillwise.isSingleBillwiseVoucher() == false) {
                            transEntryReference.updateRequiredFlag(iStartRow);
                        }
                    }
                    else {
                        iCurrentRow = iStartRow;
                    }

                    iIndex = DataType.arrayContains(EntryMain.m_arrBillwiseDirtyRow, iCurrentRow, "iRow");
                    if (iIndex == -1) {
                        obj = {};
                        obj.iRow = iCurrentRow;
                        obj.arrFieldIds = [];
                        obj.arrFieldIds.push(iFieldId);
                        EntryMain.m_arrBillwiseDirtyRow.push(obj);
                    }
                    else {
                        obj = EntryMain.m_arrBillwiseDirtyRow[iIndex];
                        if (DataType.arrayContains(obj.arrFieldIds, iFieldId) == -1) {
                            obj.arrFieldIds.push(iFieldId);
                            EntryMain.m_arrBillwiseDirtyRow[iIndex] = obj;
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.updateDirtyRowFlag} " + err.message, GlobalPref.getResourceValue("Exception"))
        }
    },

    checkExchangeValidity: function(obj) {
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;

        try {
            if (transEntryInfo.Settings.Misc.PostExchangeRate == true) {
                return (true);
            }

            for(iIndex = 0; iIndex < obj.length; iIndex++) {
                iTotal = DataType.arrayLength(obj[iIndex].arrAdjustedBills);
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    if (DataType.isZero(obj[iIndex].arrAdjustedBills[iCounter].mExchangeDifference) == false
                        && transEntryFieldInfo.ExchangeRateDiff.MetaDataIndex < 0) {

                        transEntryGlobal.showAlert("Create field for exchange rate difference.", "Error");
                        return (false);
                    }

                    if (DataType.isZero(obj[iIndex].arrAdjustedBills[iCounter].mLocalExchangeDiff) == false
                        && transEntryFieldInfo.LocalExchangeRateDiff.MetaDataIndex < 0) {

                        transEntryGlobal.showAlert("Create field for local exchange rate difference.", "Error");
                        return (false);
                    }
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.checkExchangeValidity} " + err.message, GlobalPref.getResourceValue("Exception"))
        }

        return (true);
    },


    // Returns true if fDiscount field required based on billwise data
    isPaymentTermsDiscountFieldCreationRequired: function (obj) {
        let iCounter = 0;
        let iTotal = 0;
        let iBillCounter = 0;
        let arrAdjustedBills = null;

        try {
            if (DataType.isValidObject(obj) == true) {
                if (transEntryInfo.BaseVoucherType == eVTTYPE.CASHR || transEntryInfo.BaseVoucherType == eVTTYPE.CASHP) {
                    for (iCounter = 0; iCounter < obj.length; iCounter++) {
                        arrAdjustedBills = obj[iCounter].arrAdjustedBills;
                        iTotal = DataType.arrayLength(arrAdjustedBills);
                        for (iBillCounter = 0; iBillCounter < iTotal; iBillCounter++) {
                            if (transEntryGlobal.FieldHelper.Area.RctDiscount == eTranEntryFieldArea.None && arrAdjustedBills[iBillCounter].dDiscountAmountTC != 0) {
                                return (true);
                            }
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBillwise.isPaymentTermsDiscountFieldCreationRequired} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    }
};
