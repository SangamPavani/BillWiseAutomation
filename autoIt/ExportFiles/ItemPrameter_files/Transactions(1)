    prepareDataForSaving: function (bSuspend, sCallback, iSaveSource) {
        let sValue = "";
        let iRow = 0;
        let objBillwise = null;
        let objResult = null;
        let objWatch = null;
        let arrRows = null;

        try {
            bSuspend = DataType.toBoolean(bSuspend);
            sCallback = DataType.toString(sCallback);
            iSaveSource = DataType.toInt(iSaveSource);

            EntryMainHeader.checkAllHeaderFieldsForFormula();

            transEntryGlobal.intStartSaving(true);
            objWatch = new FStopWatch();
            objWatch.start();

            objResult = EntryMainUI.getTransactionData(bSuspend, true);

            objWatch.stop();
            transEntryGlobal.intStartSaving(false);
            transEntryGlobal.writeInfoLog("Prepare transaction object for data saving(" + objWatch.getDifferenceString() + ").");

            if (objResult.lValue < 1) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);

                return (objResult.data);
            }

            if (transEntryInfo.UserId != GlobalPref.SUPER_USER && bSuspend == false) {
                bSuspend = EntryMain.checkPermission(SecurityActions.AlwaysSuspendOnSaving);
            }

            if(transEntryReference.isDataCanExist() == true) {
                arrRows = [];
                for(iRow = 1; iRow <= objResult.TransactionData.Body.length; iRow++) {
                    if(DataType.toBoolean(transEntryGrid.getRowData(iRow, eRowDataName.BillwiseRequired)) == true) {
                        arrRows.push(iRow);
                    }
                    else if (transEntryFields.isRequired(eVTFIELDID.FDF_REFERENCE, iRow) == true) {
                        objBillwise = EntryMainBillwise.getData(iRow);
                        if(DataType.isValidObject(objBillwise) == true) {
                            objResult.TransactionData.Body[iRow - 1].BillwiseData = DataType.toString(objBillwise);
                        }
                        else {
                            if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Body) {
                                if (EntryMainUI.getBodyFlags(iRow).PDC == false) {
                                    arrRows.push(iRow);
                                }
                            }
                            else {
                                arrRows.push(iRow);
                            }
                            //arrRows.push(iRow);
                        }
                    }
                }

                if (bSuspend == false && arrRows.length > 0) {
                    for(iRow = 0; iRow < arrRows.length; iRow++) {
                        transEntryGrid.showRowSymbol(arrRows[iRow], true);
                    }

                    sValue = GlobalPref.getResourceValue("msgAdjustBillsError");
                    transEntryGlobal.showAlert(sValue, "Error");

                    EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                    return;
                }
            }

            EntryMain.m_FinalData = objResult.TransactionData;
            EntryMainUI.saveDataInternal(objResult.TransactionData,
                                                    objResult.objTran,
                                                    bSuspend,
                                                    sCallback,
                                                    iSaveSource);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.prepareDataForSaving} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    saveDataInternal: function (objTransactionData, objTran, bSuspend, sCallback, iSaveSource) {
        let iCounter = 0;
        let result = null;
        let objParam = undefined;
        let objBillwiseData = null;
        let objCustomData = null;
        let arrHeaderDocs = undefined;

        try {
            bSuspend = DataType.toBoolean(bSuspend);
            iSaveSource = DataType.toInt(iSaveSource);

            sCallback = DataType.toString(sCallback);
            if (bSuspend == true) {
                EntryMainUI.postVoucher(objTransactionData, true, sCallback, iSaveSource);

                return(true);
            }

            if(transEntryReference.isDataCanExist() == true) {
                EntryMainUI.postVoucher(objTransactionData, false, sCallback, iSaveSource);

                return(true);
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (EntryMainBillwise.checkBillwise() == true && transEntryGlobal.EntryModel.bARAPInInf == true) {
                if (transEntryInfo.BodySectionNotRequired == true) { // Special receipt/payment with no body

                    transEntryGlobal.TempTransactionData = objTransactionData;
                    transEntryGlobal.TempRowNo = -1;

                    objBillwiseData = AdjustBills_Screen.GetBillWiseData();
                    if (DataType.isValidObject(objBillwiseData) == true) {
                        objTransactionData = EntryMainBillwise.setBillwiseData(objBillwiseData, objTransactionData);
                        if (DataType.isValidObject(objTransactionData) == true) {
                            objTransactionData = TRANSACTION_ENTRY.OTHERCHARGES.getData(objTransactionData);
                            EntryMainUI.postVoucher(objTransactionData, false, sCallback, iSaveSource);
                        }
                    }
                    else {
                        EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                    }
                }
                else {
                    FUIElement.setAttribute(EntryMainUI.getOthersContainer(), "callback", sCallback);
                    FUIElement.setAttribute(EntryMainUI.getOthersContainer(), "savesource", iSaveSource);

                    result = EntryMainBillwise.adjustBill(objTransactionData, objTran, iSaveSource);
                    if (DataType.isValidObject(result) == true) {
                        if (DataType.toBoolean(result) == true) {
                            if (iSaveSource == eTranEntrySaveSource.Version && transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgConfirmRevision")) == false) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                                return;
                            }

                            EntryMainUI.postVoucher(objTransactionData, false, sCallback, iSaveSource);
                        }
                        else {
                            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                        }
                    }
                }
            }
            else if (transEntryInfo.Settings.Misc.DontCheckCreditLimit == false
                && transEntryInfo.ARAPPref.bEnableCreditLimit == true
                && transEntryGlobal.IntermediateData.iMaskedVoucherType == eVTTYPE.SORDR
                && transEntryInfo.ARAPPref.bCheckCreditLimitInOrders == true) {

                objCustomData = {};
                objCustomData.objInput = {};
                objCustomData.objInput.sCallback = sCallback;
                objCustomData.objInput.iSaveSource = iSaveSource;
                objCustomData.objTransactionData = objTransactionData;
                objCustomData.bFromAdjustBill = false;

                // Remove layout fields of due to attachment field data cause error in compression
                for (iCounter = 0; iCounter < objTran.BodyData.length; iCounter++) {
                    if (DataType.arrayLength(objTran.BodyData[iCounter].BodyExtra) > 0) {
                        objTran.BodyData[iCounter].BodyExtra = null;
                    }

                    if (DataType.isValidObject(objTran.BodyData[iCounter].Sales) == true
                        && DataType.isString(objTran.BodyData[iCounter].Sales.Reservation) == true
                        && objTran.BodyData[iCounter].Sales.Reservation.length == 0) {

                            objTran.BodyData[iCounter].Sales.Reservation = undefined;
                        }
                }

                arrHeaderDocs = objTran.HeaderDocs;
                objTran.HeaderDocs = [];

                objParam = {};
                objParam.objTransaction = DataType.toString(objTran);

                objTran.HeaderDocs = arrHeaderDocs;


                transEntryServer.execute(eTransServerRequest.CheckCreditLimit,
                                            objParam,
                                            true,
                                            "EntryMainCallback.checkCreditLimit",
                                            objCustomData);
            }
            else {
                EntryMainUI.postVoucher(objTransactionData, false, sCallback, iSaveSource);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.saveDataInternal} " + err.message, GlobalPref.getResourceValue("Exception"));
            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
        }

        return (true);
    },

