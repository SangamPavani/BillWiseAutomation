                EntryMainUI.clear(transEntryFieldInfo.VATLayout, iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.resetVATColumn} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateVATBeforeSave: function (objTransactionData) {
        let iRowIndex = 0;
        let iMaskedVoucherType = 0;
        let objBillwiseData = undefined;

        try {
            if (DataType.isValidObject(objTransactionData) == false
                || DataType.isValidObject(objTransactionData.Body) == false
                || DataType.arrayLength(objTransactionData.Body) < 1) {
                return (objTransactionData);
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (iMaskedVoucherType != eVTTYPE.CASHR
                && iMaskedVoucherType != eVTTYPE.CASHP
                && iMaskedVoucherType != eVTTYPE.MEMOR
                && iMaskedVoucherType != eVTTYPE.MEMOP
                && iMaskedVoucherType != eVTTYPE.JOURN
                && iMaskedVoucherType != eVTTYPE.NJOURN
                && iMaskedVoucherType != eVTTYPE.PETIC) {
                return (objTransactionData);
            }

            for (iRowIndex = 0; iRowIndex < objTransactionData.Body.length; iRowIndex++) {
                objBillwiseData = objTransactionData.Body[iRowIndex].BillwiseData;
                if (DataType.isNullOrEmpty(objBillwiseData) == true) {
                    continue;
                }

                objBillwiseData = DataType.stringToObject(objBillwiseData);
                if (objBillwiseData.lValue < 1 || DataType.isValidObject(objBillwiseData.data) == false) {
                    continue;
                }

                objBillwiseData = objBillwiseData.data;

                iRowIndex = transEntryVat.updateFromBillwiseData(objBillwiseData, iRowIndex, objTransactionData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.updateVATBeforeSave} " + err.message, GlobalPref.getResourceValue("Exception"));
            return;
        }

        return (objTransactionData);
    }
