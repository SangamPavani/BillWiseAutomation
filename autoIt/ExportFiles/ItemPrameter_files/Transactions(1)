    updateExchangeRate: function (value, iRow) {
        let iCounter = 0;
        let objBody = undefined;
        let oldValue = undefined;

        if (EntryMain.m_objTrans && EntryMain.m_objTrans.BodyData) {
            if (DataType.isZero(value) == true) {
                value = 1;
            }

            value = DataType.formatToDecimalPlaces(value, transEntryExchangeRate.getDecimals());

            if (iRow < 1) {
                for (iCounter = 0; iCounter < EntryMain.m_objTrans.BodyData.length; iCounter++) {
                    if (oldValue == undefined) {
                        oldValue = EntryMain.m_objTrans.BodyData[iCounter].ExchangeRate;
                    }

                    EntryMain.m_objTrans.BodyData[iCounter].ExchangeRate = value;
                    if (transEntryInfo.VoucherType != 0x3fe) { // Not Stock Revaluation
                        objBody = EntryMain.m_objTrans.BodyData[iCounter];
                        if (objBody.Sales
                            && FNumberOperation.isNotEqualTo(objBody.Sales.OrigRate, 0) == true) {
                            objBody.Sales.Rate = FNumberOperation.mul(objBody.Sales.OrigRate, objBody.ExchangeRate);
                        }
                    }
                }
            }
            else if (EntryMain.m_objTrans.BodyData.length >= iRow) {
                oldValue = EntryMain.m_objTrans.BodyData[iRow - 1].ExchangeRate;

                EntryMain.m_objTrans.BodyData[iRow - 1].ExchangeRate = value;
                if (transEntryInfo.VoucherType != 0x3fe) { // Not Stock Revaluation
                    objBody = EntryMain.m_objTrans.BodyData[iRow - 1];
                    if (objBody.Sales
                        && FNumberOperation.isNotEqualTo(objBody.Sales.OrigRate, 0) == true) {
                        objBody.Sales.Rate = FNumberOperation.mul(objBody.Sales.OrigRate, objBody.ExchangeRate);
                    }
                }
            }
            else {
                transEntryGlobal.writeErrorLog("{EntryMainMemoryObject.updateExchangeRate} Invalid row index(" + iRow + ").", GlobalPref.getResourceValue("Exception"));
            }

            return (oldValue);
        }
    },

