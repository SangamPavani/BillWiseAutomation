Click_Customization: function () {
    try {
        var url = GLOBAL.getContextPath("GetBatchCustomizations", "MRPBatch", "MRP");
        var selectMastersResult = NETWORK.executeServerMethod(url, true, {}, "JSON", false);
        if (selectMastersResult.data != null && selectMastersResult.data != undefined) {
            //debugger
            var sGrid = "BatchtCustomization_FGrid";
            var objData = selectMastersResult.data;
            //MRP_BATCH.arrCustomization = selectMastersResult.data.objGridData;
            FGRIDCONTROL.deleteRows(sGrid, 1, FGRIDCONTROL.getTotalRows(sGrid));
            FGRIDCONTROL.insertRows(sGrid, 1, objData.m_VoucherFields.length);
            var tag = 0, Id = 0; MRP_BATCH.arrCustomization = [];
            for (var RowCount = 0; RowCount < objData.m_VoucherFields.length; RowCount++) {
                tag = 0; Id = 0;
                for (var colCount = 0; colCount < FGRIDCONTROL.getTotalColumns(sGrid) ; colCount++) {
                    cellobj = FGRIDCONTROL.getCellObject(sGrid, RowCount + 1, colCount + 1);
                    switch (cellobj.iColumn) {
                        case 1://Checkbox
                            Id = objData.m_VoucherFields[RowCount].iFieldId;
                            for (var i = 0; i < objData.objGridData.length; i++) {
                                if (Id == objData.objGridData[i].ID) {
                                    tag = objData.objGridData[i].Name;
                                    cellobj.cell.children[0].checked = true;
                                    MRP_BATCH.arrCustomization.push(objData.objGridData[i]);
                                    break;
                                }
                            }
                            break;
                        case 2://Name
                            cellobj.setCellText(objData.m_VoucherFields[RowCount].sFieldName, objData.m_VoucherFields[RowCount].sFieldName);
                            break;
                        case 3://ID
                            cellobj.setCellText(objData.m_VoucherFields[RowCount].iFieldId, objData.m_VoucherFields[RowCount].iFieldId);
                            break;
                        case 4://Tag
                            cellobj.setCellText(tag, tag);
                            break;
                        case 5://Type
                            cellobj.setCellText(objData.m_VoucherFields[RowCount].iDataTypeId, objData.m_VoucherFields[RowCount].iDataTypeId);
                            break;
                    }
                }
            }

            $("#divCustomization").modal("show");
        }
    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.Click_Customization} " + e.message, "Error Message");
    }
