    // Returns value of given control based on datatype and key
    getControlValue: function (eleCtrl, iDataTypeId, sKey) {
        let objValue = null;

        try {
            eleCtrl = FUIElement.getValidElement(eleCtrl);
            if (DataType.isValidObject(eleCtrl) == false) {
                return (false);
            }

            switch (iDataTypeId) {
                case eMasterDataType.Text:
                case eMasterDataType.Number:
                case eMasterDataType.Fraction:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.value;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.Boolean:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.checked;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.DateTime:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.value;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.Date:
                    objValue = DATEPICKER.getDate(eleCtrl);
                    break;
                case eMasterDataType.Time:
                    objValue = FTIMECONTROL.getTime(eleCtrl);
                    break;
                case eMasterDataType.Picture:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.value;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.StringList:
                    if (eleCtrl.selectedIndex >= 0) {
                        if (DataType.isNullOrEmpty(sKey, true) == true) {
                            objValue = eleCtrl.options[eleCtrl.selectedIndex].text;
                        }
                        else {
                            objValue = FUIElement.getAttribute(eleCtrl.options[eleCtrl.selectedIndex], sKey);
                        }
                    }
                    break;
                case eMasterDataType.NumberList:
                    if (eleCtrl.selectedIndex >= 0) {
                        if (DataType.isNullOrEmpty(sKey, true) == true) {
                            objValue = DataType.toInt(eleCtrl.options[eleCtrl.selectedIndex].value);
                        }
                        else {
                            objValue = FUIElement.getAttribute(eleCtrl.options[eleCtrl.selectedIndex], sKey);
                        }
                    }
                    break;
                case eMasterDataType.DocumentViewer:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.value;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.UpdatedTime:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = eleCtrl.value;
                    }
                    else {
                        objValue = FUIElement.getAttribute(eleCtrl, sKey);
                    }
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    if (DataType.isNullOrEmpty(sKey, true) == true) {
                        objValue = OPTIONCONTROL.getControlValue(eleCtrl);
                    }
                    else {
                        objValue = OPTIONCONTROL.getControlValue(eleCtrl, sKey);
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getControlValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objValue);
    },

