    markLinkedToFooterBodyColumns: function () {
        let iCounter = 0;
        let iIndex = 0;
        let bMatch = false;
        let objMetaData = null;
        let objFormula = null;
        let arrVariables = null;

        try {
            objFormula = new FFormula();
            objFormula.m_CalType = transEntryInfo.CalendarType;

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Body.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iCounter];
                objMetaData.iLinkedToFooter = -1;

                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0 && DataType.isNullOrEmpty(objMetaData.sFormula) == false) {
                    arrVariables = objFormula.GetVariables(objMetaData.sFormula, false);
                    if (DataType.arrayLength(arrVariables) == 3) {
                        bMatch = EntryMainCommon.isMatch("sfo\\d+/tgr", objMetaData.sFormula.toLowerCase());
                        if (bMatch == false) {
                            bMatch = EntryMainCommon.isMatch("sfo\\d+/tsb", objMetaData.sFormula.toLowerCase());
                        }

                        if (bMatch == true) {
                            for (iIndex = 0; iIndex < arrVariables.length; iIndex++) {
                                if (DataType.stringIncludes(arrVariables[iIndex], "sfo") == true) {
                                    objMetaData.iLinkedToFooter = DataType.toInt(arrVariables[iIndex].substr(3));
                                    break;
                                }
                            }
                        }
                    }
                }

                transEntryGlobal.setBodyMetaDataObject(iCounter, objMetaData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntry.markLinkedToFooterBodyColumns} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

