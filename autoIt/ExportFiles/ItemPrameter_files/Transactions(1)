    updateUIData: function (iRow) {
        let iCounter = 0;
        let iIndex = 0;
        let iPosition = 0;
        let iSequence = 0;
        let iAmtDiscFld = 0;
        let iPerDiscFld = 0;
        let iBillAmtDiscFld = 0;
        let iBillPerDiscFld = 0;
        let dTotalGross = 0;
        let dValue = 0;
        let arrFooterFields = undefined;
        let arrFields = undefined;
        let objMetaData = null;
        let eleControl = null;
        let cell = null;

        try {
            //if (iOldCount == iNewCount) {
            //    transEntryData.displayFocusTransactionData(EntryMainScheme.m_objTrans);
            //}
            //else {
            //    transEntryData.displayFocusTransactionData(EntryMainScheme.m_objTrans);
            //}

            transEntryData.displayFocusTransactionData(EntryMainScheme.m_objTrans);
            if (DataType.arrayLength(ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts) < 1) {
                iAmtDiscFld = transEntryInfo.Settings.VoucherScheme.iAmountDiscountField;
                iPerDiscFld = transEntryInfo.Settings.VoucherScheme.iDiscountField;
                iBillAmtDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountAmount;
                iBillPerDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountPer;

                if (iRow > 0) {
                    if (EntryMainScheme.m_objTrans.BodyData.length >= iRow) {
                        cell = transEntryScreenData.getCellObjectFromFieldId(iRow, iAmtDiscFld);
                        if (DataType.isValidObject(cell) == true) {
                            cell.clear();
                        }

                        cell = transEntryScreenData.getCellObjectFromFieldId(iRow, iPerDiscFld);
                        if (DataType.isValidObject(cell) == true) {
                            cell.clear();
                        }
                    }
                }
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            if (DataType.arrayLength(ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts) > 0) {
                EntryMainScheme.m_arrTemp = [];

                for (iCounter = 0; iCounter < ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.length; iCounter++) {
                    EntryMainScheme.m_arrTemp.push(ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts[iCounter]);
                }

                if (EntryMainScheme.m_arrTemp.length > 0) {
                    iAmtDiscFld = transEntryInfo.Settings.VoucherScheme.iAmountDiscountField;
                    iPerDiscFld = transEntryInfo.Settings.VoucherScheme.iDiscountField;
                    iBillAmtDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountAmount;
                    iBillPerDiscFld = transEntryInfo.Settings.VoucherScheme.iBillDiscountPer;

                    for (iCounter = 0; iCounter < EntryMainScheme.m_arrTemp.length; iCounter++) {
                        switch (EntryMainScheme.m_arrTemp[iCounter].SchemeImplType) {
                            case SchemeImplementedType.get("LINEWISE"):
                                dTotalGross = 0;
                                for (iIndex = 0; iIndex < EntryMainScheme.m_objTrans.BodyData.length; iIndex++) {
                                    if (DataType.isValidObject(EntryMainScheme.m_objTrans.BodyData[iIndex].Sales) == true
                                        && EntryMainScheme.m_objTrans.BodyData[iIndex].Sales.Product == EntryMainScheme.m_arrTemp[iCounter].ProductId
                                        && EntryMainScheme.m_objTrans.BodyData[iIndex].Flags.FreeQty == false) {

                                        dTotalGross = FNumberOperation.add(dTotalGross, EntryMainScheme.m_objTrans.BodyData[iIndex].Sales.OrigGross);
                                    }
                                }

                                for (iRow = 0; iRow < EntryMainScheme.m_objTrans.BodyData.length; iRow++) {
                                    if (EntryMainMemoryObject.getProductValue(iRow + 1) == EntryMainScheme.m_arrTemp[iCounter].ProductId
                                        && EntryMainScheme.m_arrTemp[iCounter].Amount != 0
                                        && EntryMainScheme.m_arrTemp[iCounter].DiscType == DiscountType.Amount
                                        && iAmtDiscFld > 0) {
                                        for (iPosition = 0; iPosition < EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData.length; iPosition++) {
                                            if ((EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData[iPosition].FieldId & eVTFIELDFLAG.TOFLDID) == iAmtDiscFld) {

                                                arrFields = transEntryFieldInfo.getScreenFields();
                                                for (iSequence = 0; iSequence < arrFields.length; iSequence++) {
                                                    objMetaData = arrFields[iSequence].MetaData;

                                                    if (objMetaData.iColMap == EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData[iPosition].ColMap)
                                                    {
                                                        dValue = (DataType.toDecimal(EntryMainScheme.m_arrTemp[iCounter].Amount) * EntryMainMemoryObject.getGrossValue(iRow + 1)) / dTotalGross;
                                                        if (isNaN(dValue) == true) //NaN is showing in UI.
                                                            dValue = 0;

                                                        cell = transEntryGrid.getCellObject(iRow + 1, arrFields[iSequence].ColumnIndex);
                                                        if (DataType.isValidObject(cell) == true) {
                                                            cell.setCellText(dValue, dValue);
                                                            EntryMainMemoryObject.update(objMetaData.iFieldId, dValue, cell.iRow);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    else if (EntryMainMemoryObject.getProductValue(iRow + 1) == EntryMainScheme.m_arrTemp[iCounter].ProductId
                                        && EntryMainScheme.m_arrTemp[iCounter].DiscountInput > 0
                                        && EntryMainScheme.m_arrTemp[iCounter].DiscType == DiscountType.Percentage
                                        && iPerDiscFld > 0) {
                                        for (iPosition = 0; iPosition < EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData.length; iPosition++) {
                                            if ((EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData[iPosition].FieldId & eVTFIELDFLAG.TOFLDID) == iPerDiscFld) {

                                                arrFields = transEntryFieldInfo.getScreenFields();
                                                for (iSequence = 0; iSequence < arrFields.length; iSequence++) {
                                                    objMetaData = arrFields[iSequence].MetaData;

                                                    if (objMetaData.iColMap == EntryMainScheme.m_objTrans.BodyData[iRow].Sales.ScreenData[iPosition].ColMap) {
                                                        cell = transEntryGrid.getCellObject(iRow + 1, arrFields[iSequence].ColumnIndex);
                                                        if (DataType.isValidObject(cell) == true) {

                                                            EntryMainScheme.m_arrTemp[iCounter].DiscountInput = EntryMain.formatFractionNumber(objMetaData.iFieldId, EntryMainScheme.m_arrTemp[iCounter].DiscountInput, objMetaData.iNoDecimal, iRow + 1);

                                                            cell.setCellText(DataType.addNumericSeparator(EntryMainScheme.m_arrTemp[iCounter].DiscountInput, transEntryCurrency.getNumericSeparator(cell.iRow)), EntryMainScheme.m_arrTemp[iCounter].DiscountInput);
                                                            EntryMainMemoryObject.update(objMetaData.iFieldId, EntryMainScheme.m_arrTemp[iCounter].DiscountInput, cell.iRow);
                                                        }
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                break;
                            case SchemeImplementedType.get("ONBILL"):
                                if (EntryMainScheme.m_arrTemp[iCounter].Amount > 0
                                    && EntryMainScheme.m_arrTemp[iCounter].DiscType == DiscountType.Amount
                                    && iBillAmtDiscFld > 0) {

                                    for (iPosition = 0; iPosition < EntryMainScheme.m_objTrans.Footer.length; iPosition++) {
                                        if ((EntryMainScheme.m_objTrans.Footer[iPosition].FieldId & eVTFIELDFLAG.TOFLDID) == iBillAmtDiscFld) {
                                            for (iSequence = 0; iSequence < arrFooterFields.length; iSequence++) {
                                                objMetaData = arrFooterFields[iSequence];

                                                if (objMetaData.iColMap == EntryMainScheme.m_objTrans.Footer[iPosition].ColMap) {

                                                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);
                                                    eleControl = document.getElementById(sId);

                                                    eleControl.value = EntryMainScheme.m_arrTemp[iCounter].Amount;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                }
                                else if (EntryMainScheme.m_arrTemp[iCounter].DiscountInput > 0
                                    && EntryMainScheme.m_arrTemp[iCounter].DiscType == DiscountType.Percentage
                                    && iBillPerDiscFld > 0) {

                                    for (iPosition = 0; iPosition < EntryMainScheme.m_objTrans.Footer.length; iPosition++) {
                                        if ((EntryMainScheme.m_objTrans.Footer[iPosition].FieldId & eVTFIELDFLAG.TOFLDID) == iBillPerDiscFld) {
                                            for (iSequence = 0; iSequence < arrFooterFields.length; iSequence++) {
                                                objMetaData = arrFooterFields[iSequence];

                                                if (objMetaData.iColMap == EntryMainScheme.m_objTrans.Footer[iPosition].ColMap) {

                                                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);
                                                    eleControl = document.getElementById(sId);

                                                    eleControl.value = EntryMainScheme.m_arrTemp[iCounter].Amount;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                }
                                break;
                        }
                    }

                    EntryMainUI.setSummaryInfo(-1);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainScheme.updateUIData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

