    initRulesDataTypeIdInternal: function (arrRules) {
        let iCounterRules = 0;
        let iCounterTwo = 0;
        let iCounterThree = 0;
        let iTotal = 0;
        let arrBodyConditionIndex = null;
        let arrBodyNoConditionIndex = null;
        let objRules = null;
        let objRuleBody = null;
        let objRuleCondition = null;
        let objFieldInfo = null;

        try {
            iTotal = DataType.arrayLength(arrRules);
            for (iCounterRules = 0; iCounterRules < iTotal; iCounterRules++) {
                sResult = "";

                objRules = arrRules[iCounterRules];
                if (objRules.IsRuleActive == false) {
                    continue;
                }

                arrBodyConditionIndex = [];
                arrBodyNoConditionIndex = [];
                for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody.length; iCounterTwo++) {
                    objRuleBody = objRules.RuleBody[iCounterTwo];

                    if(objRuleBody.RuleCondition.length == 0) {
                        arrBodyNoConditionIndex.push(iCounterTwo);
                    }
                    else {
                        arrBodyConditionIndex.push(iCounterTwo);
                    }

                    for (iCounterThree = 0; iCounterThree < objRuleBody.RuleCondition.length; iCounterThree++) {
                        objRuleCondition = objRuleBody.RuleCondition[iCounterThree];

                        objFieldInfo = transEntryFieldInfo.getInfo(objRuleCondition.FieldId, false).FieldInfo;
                        if(DataType.isValidObject(objFieldInfo) == true) {
                            objRuleCondition.DataTypeId = objFieldInfo.iDataTypeId;
                            objRuleBody.RuleCondition[iCounterThree] = objRuleCondition;
                        }
                    }
                }

                if(arrBodyConditionIndex.length > 0)  {
                    if(arrBodyNoConditionIndex.length > 1) {
                        transEntryGlobal.showAlert("More than 1 no rule condition found in '" + objRules.RuleName + "' rule.", "", true);
                    }
                    else if(arrBodyNoConditionIndex.length == 1) {
                        if(objRules.RuleBody.length > 1 && arrBodyNoConditionIndex[0] < (objRules.RuleBody.length - 1)) {
                            iCounterTwo = arrBodyNoConditionIndex[0];
                            objRuleBody = objRules.RuleBody[iCounterTwo];
                            objRules.RuleBody.splice(iCounterTwo, 1); // Remove no condition from middle
                            objRules.RuleBody.push(objRuleBody); // Insert not condition at last
                        }
                    }
                }
            }
        }
        catch (err) {
        }
    },

