        let objLinkColumn = null;
        let iSelectedWorkflowIndex = -1;

        try {
            if (DataType.isValidObject(arrData) == false) { // Cancel is clicked
                return (TRANSACTION_ENTRY.WORKFLOW.onPopupCancel_Click(iRow, iColumn));
            }

            if (iRow == 0 && iColumn == 0) { // Called from header
                iSelectedWorkflowIndex = EntryMainWorkflow.getSelectedWorkflowIndex();
                if (iSelectedWorkflowIndex < 0 || iSelectedWorkflowIndex >= transEntryGlobal.FieldHelper.Column.Links.length) {
                    return;
