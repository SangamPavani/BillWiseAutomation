DocCustomization.Documents = {
    getTagsTableData: function () {
        let sDependencyVal = "";
        let iRow = 0;
        let iTotal = 0;
        let iCounter = 0;
        let arrData = null;
        let cell = null;
        let obj = null;
        //debugger
        try {
            arrData = [];

            FGRIDCONTROL.update(DocCustomization_Documents.TagsGridElement, null);

            iTotal = FGRIDCONTROL.getTotalRows(DocCustomization_Documents.TagsGridElement);
            for (iRow = 1; iRow <= iTotal; iRow++) {
                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 1);

                obj = {};
                obj.MasterType = FConvert.toInt(cell.getCellData()); // Masters
                if (obj.MasterType <= 0) {
                    continue;
                }

                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 2); // Position
                obj.Position = FConvert.toInt(cell.getCellData());

                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 3); // Show Dependency
                obj.ArrDependentMaster = [];

                sDependencyVal = FConvert.toString(cell.getCellData());
                if (FCommon.String.isNullOrEmpty(sDependencyVal, true) == false) {
                    sDependencyVal = JSON.parse(sDependencyVal);
                    for (iCounter = 0; iCounter < sDependencyVal.length; iCounter++) {
                        obj.ArrDependentMaster.push({ ID: sDependencyVal[iCounter].ID, Name: sDependencyVal[iCounter].Name, Tag: obj.MasterType });
                    }
                }

                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 4); // Group
                obj.Group = cell.getCellText();

                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 5); // Filter
                obj.DependentMaster = FConvert.toInt(cell.getCellData());
                obj.FieldName = FConvert.toString(cell.getCellText());
                if (FCommon.String.isNullOrEmpty(obj.FieldName, true) == true) {
                    obj.DependentMaster = 0;
                }

                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, iRow, 6); // Mandatory
                obj.IsMandatorySelection = FConvert.toBoolean(cell.getCellData());

                obj.VoucherType = selectedVoucherType.id;

                arrData.push(obj);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Documents.getTagsTableData} " + err.message, "Exception");
        }

        return (arrData);
    },

    TAGS_CELLENTER: {
        onPosition: function(cellobj) {
            var iCounter = 0;
            var iModulesImplemented = 0;
            var iMasterTypeId = 0;
            var iVoucherType = 0;
            var eleSelect = null;
            var cell = null;

            try {
                if (cellobj.iColumn != 2) {
                    return;
                }

                eleSelect = DocCustomization_Documents.TagsPositionElement;
                if (COMMON.prototype.isValidObject(eleSelect) == false) {
                    if (cellobj.processDefault) {
                        cellobj.processDefault(event);
                    }

                    return;
                }

                iModulesImplemented = GLOBAL.getModulesImplemented();
                if ((iModulesImplemented & eModulesImplemented.SubLedger) > 0) {
                    for (iCounter = 0; iCounter < eleSelect.children.length; iCounter++) {
                        eleSelect.children[iCounter].disabled = false;
                    }

                    iMasterTypeId = FConvert.toInt(FGRIDCONTROL.getCellObject(cellobj.Grid, cellobj.iRow, 1).getCellData());
                    if (iMasterTypeId == 50) {
                        iVoucherType = CONFIGURETRANS.getSelectedVoucherType();
                        if(FConvert.isItSales(iVoucherType) == true) {
                            eleSelect.children[1].disabled = true; // Disable Body
                        }
                        else {
                            eleSelect.children[0].disabled = true; // Disable Header
                        }
                    }
                }

                cellobj.setControl(eleSelect, cellobj.getCellText());
                eleSelect.value = cellobj.getCellData("value");
            }
            catch (err) {
                COMMON.prototype.showMessage("Exception: {DocCustomization.Documents.TAGS_CELLENTER.onPosition} " + err.message, "Exception");
            }
        }
    },

    onTagsTable_Leave: function (cellobj) {
        let sText = "";
        let value = null;
        let ele = null;
        //debugger
        try {
            switch (cellobj.iColumn) {
                case 1: // Master
                    DocCustomization.Documents.onTagsTable_MasterLeave(cellobj);
                    break;
                case 2: // Position
                    DocCustomization.Documents.onTagsTable_PositionLeave(cellobj);
                    break;
                case 3: // Show Dependency
                    sText = LISTCHECKBOX.getControlText("doc_TagsDepedencyDropDown");
                    value = LISTCHECKBOX.getControlData("doc_TagsDepedencyDropDown");
                    if(value != null && value.length > 0) {
                        value = JSON.stringify(value);
                    }
                    else {
                        value = "";
                    }

                    cellobj.setCellText(sText, value);
                    cellobj.cell.style.overflow = "hidden";
                    cellobj.cell.style.wordWrap = "normal";
                    break;
                case 4: // Group
                    ele = DocCustomization_Documents.TagsGroupElement;
                    if (COMMON.prototype.isValidObject(ele) == true) {
                        cellobj.setCellText(ele.value, ele.value);
                    }
                    break;
                case 5: // Filter
                    cellobj.clear();

                    ele = DocCustomization_Documents.TagsFilterElement;
                    if (COMMON.prototype.isValidObject(ele) == true && ele.selectedIndex >= 0) {
                        cellobj.setCellText(ele.options[ele.selectedIndex].text, ele.options[ele.selectedIndex].value);
                    }
                    break;
                case 6: // Mandatory
                    cellobj.clear();

                    ele = DocCustomization_Documents.TagsMandatoryElement;
                    if (COMMON.prototype.isValidObject(ele) == true && ele.selectedIndex >= 0) {
                        cellobj.setCellText(ele.options[ele.selectedIndex].text, ele.options[ele.selectedIndex].value);
                    }
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Documents.onTagsTable_Leave} " + err.message, "Exception");
        }
    },

    onTagsTable_MasterLeave: function (cellobj) {
        let sMasterName = "";
        let iMasterTypeId = 0;
        let iRow = 0;
        let iModulesImplemented = 0;
        let iVoucherType = 0;
        let eleSelect = null;

        try {
            eleSelect = DocCustomization_Documents.TagsMasterElement;
            if (FCommon.UI.isValidObject(eleSelect) == false) {
                return;
            }

            if (eleSelect.selectedIndex < 0) {
                return;
            }

            sMasterName = FConvert.toString(eleSelect.options[eleSelect.selectedIndex].text);
            iMasterTypeId = FConvert.toInt(eleSelect.options[eleSelect.selectedIndex].value);

            for (iRow = 1; iRow <= FGRIDCONTROL.getTotalRows(cellobj.Grid) ; iRow++) {
                if (iRow == cellobj.iRow) { // Skip current row
                    continue;
                }

                if (FConvert.toInt(FGRIDCONTROL.getCellObject(cellobj.Grid, iRow, cellobj.iColumn).getCellData()) != iMasterTypeId) {
                    continue;
                }

                COMMON.prototype.showMessage("Master already selected at row no: " + iRow, "");
                sMasterName = "";
                iMasterTypeId = -1;
            }

            cellobj.setCellText(sMasterName, iMasterTypeId);

            iModulesImplemented = GLOBAL.getModulesImplemented();
            if (iMasterTypeId != 50 || (iModulesImplemented & eModulesImplemented.SubLedger) == 0) {
                return;
            }

            iVoucherType = CONFIGURETRANS.getSelectedVoucherType();
            if (FConvert.isItSales(iVoucherType) == true) {
                FGRIDCONTROL.getCellObject(cellobj.Grid, cellobj.iRow, 2).setCellText("Header", 0);
            }
            else {
                FGRIDCONTROL.getCellObject(cellobj.Grid, cellobj.iRow, 2).setCellText("Body", 1);
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Documents.onTagsTable_MasterLeave} " + err.message, "Exception");
        }
    },

    onTagsTable_PositionLeave: function (cellobj) {
        let iMasterTypeId = 0;
        let eleSelect = null;
        let cell = null;

        try {
            eleSelect = DocCustomization_Documents.TagsPositionElement;
            if (COMMON.prototype.isValidObject(eleSelect) == false || eleSelect.selectedIndex < 0) {
                cellobj.clear();

                return;
            }

            if (iLocalCurrency > 0) {
                cell = FGRIDCONTROL.getCellObject(DocCustomization_Documents.TagsGridElement, cellobj.iRow, 1);
                iMasterTypeId = FConvert.toInt(cell.getCellData());

                NETWORK.executeServerMethod(GLOBAL.getContextPath("RestrictFATag", "ConfigureTrans", "TranSettings"),
                                            true,
                                            {
                                                iAccountTag: iMasterTypeId,
                                                iPosition: eleSelect.selectedOptions[0].value,
                                                iRowIndex: cellobj.iRow,
                                                iVoucherType: selectedVoucherType.id
                                            },
                                            "",
                                            true,
                                            "CONFIGURETRANS.RestrictFATagSuccess");                
            }

            cellobj.setCellText(eleSelect.selectedOptions[0].text, eleSelect.selectedOptions[0].value);
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Documents.onTagsTable_PositionLeave} " + err.message, "Exception");
        }
    }
};

