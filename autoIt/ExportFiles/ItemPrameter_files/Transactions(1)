    selectRowByBatchId: function (lBatchId, dNewAvgRate, dNewStockValue) {
        let iRow = 0;
        let iTotal = 0;
        let eleGrid = null;
        let cell = null;
        let id = null;

        try {
            eleGrid = StockRevaluationBatch.getGridElement();
            iTotal = FGRIDCONTROL.getTotalRows(eleGrid);

            lBatchId = DataType.toString(lBatchId);
            for (iRow = 1; iRow <= iTotal; iRow++) {
                cell = StockRevaluationBatch.getBatchIdCell(iRow);
                id = DataType.toString(cell.getCellData());

                if (id == lBatchId) {
                    cell = StockRevaluationBatch.getCheckBoxCell(iRow);
                    cell.setCheckboxState(true);

                    cell = StockRevaluationBatch.getNewAvgRateCell(iRow);
                    cell.setCellText(DataType.toDecimal(dNewAvgRate, StockRevaluationBatch.DecimalsInAmts), dNewAvgRate);

                    cell = StockRevaluationBatch.getNewStockValueCell(iRow);
                    cell.setCellText(DataType.toDecimal(dNewStockValue, StockRevaluationBatch.DecimalsInQty), dNewStockValue);
                    break;
                }
            }
        }
        catch (err) {
