var FormulaHelper = {
    breakConditionalEquation : function(sInfix) {
        let sCharAt = "";
        let iCounter = 0;
        let obj = undefined;

        try {
            obj = {};
            obj.temp1 = "";
            obj.temp2 = "";
            obj.temp3 = "";

            for (iCounter = 0; iCounter < sInfix.length; iCounter++) {
                sCharAt = sInfix.charAt(iCounter);
                // manish $ added for string begin with
                if (sCharAt == '>' || sCharAt == '<' || sCharAt == '!' || sCharAt == '=' || sCharAt == '$' || sCharAt == '-' || sCharAt == '^' || sCharAt == '`')//chk these operators
                {
                    if (sInfix[iCounter] == '-') {
                        if (iCounter == (sInfix.length - 1)) {
                            obj.temp2 += sInfix[iCounter];
                            continue;
                        }

                        if (sInfix.charAt(iCounter + 1) != ')') {
                            obj.temp2 += sInfix[iCounter];
                            continue;
                        }
                    }


                    obj.temp3 = sInfix[iCounter];
                    if (sInfix.charAt(iCounter + 1) == '=') {
                        obj.temp3 += sInfix[iCounter + 1];
                        iCounter++;
                    }
                    else if (sInfix[iCounter] == '!') {
                        if (iCounter < (sInfix.length - 1) && sInfix.charAt(iCounter + 1) == '$') {
                            obj.temp3 += sInfix[iCounter + 1]; // Does Not Begin With
                            iCounter++;
                        }
                        else if (iCounter < (sInfix.length - 1) && sInfix.charAt(iCounter + 1) == '-') {
                            obj.temp3 += sInfix[iCounter + 1]; // Is Not Blank
                            iCounter++;
                        }
                        else if (iCounter < (sInfix.length - 1) && sInfix.charAt(iCounter + 1) == '^') {
                            obj.temp3 += sInfix[iCounter + 1]; // Is Not Present
                            iCounter++;
                        }
                        else if (iCounter < (sInfix.length - 1) && sInfix.charAt(iCounter + 1) == '`') {
                            obj.temp3 += sInfix[iCounter + 1]; // Does Not Match Pattern
                            iCounter++;
                        }
                    }
                    obj.temp1 = obj.temp2;
                    obj.temp2 = "";
                }
                else {
                    obj.temp2 += sInfix[iCounter];
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FormulaHelper.breakConditionalEquation} " + err.message);

            obj.bError = true;
            obj.Exception = err.message;
        }

        return (obj);
    },

    // Ternary string exp evalution
    StringTernaryEval: function (sInfix) {
        let strTemp = "";
        let TempRes = "";
        let i = 0;
        let j = 0;

        //sInfix = sInfix.replace(" ", "");
        sInfix = sInfix.replace(/\s+/g, '');

        for (i = 0; i < sInfix.length; i++) {
            switch (sInfix.charAt(i)) {
                case '(':
                    TempRes = "";
                    for (j = i; sInfix.charAt(j) != ')'; j++)//find out coreesponding ')'
                    {
                        TempRes += sInfix[j];
                        i++;
                    }
                    TempRes += sInfix[i];

                    if (DataType.stringIncludes(TempRes, "?"))//is a ternary eqn
                    {
                        if (DataType.stringIncludes(TempRes, ":"))//should contain :
                        {
                            strTemp += FormulaHelper.TempStringTernaryEval(TempRes);
                        }
                        else {
                            return ("NaN");
                        }
                    }
                    else if (DataType.stringIncludes(TempRes, ">") || DataType.stringIncludes(TempRes, "<")
                        || DataType.stringIncludes(TempRes, "&&") || DataType.stringIncludes(TempRes, "||")
                        || DataType.stringIncludes(TempRes, "!=") || DataType.stringIncludes(TempRes, "=="))//logical
                    {
                        strTemp += TempRes;
                    }
                    else {
                        TempRes = FormulaHelper.NormString(TempRes);
                        strTemp += TempRes;
                    }
                    break;

                default:
                    strTemp += sInfix[i];
                    break;
            }
        }

        strTemp = FormulaHelper.NormString(strTemp);

        if (DataType.stringIncludes(strTemp, "?")) {
            if (DataType.stringIncludes(strTemp, ":")) {
                strTemp = FormulaHelper.TempStringTernaryEval(strTemp);
            }
            else {
                return ("NaN");
            }
        }
        else {
            strTemp = strTemp.trim();

        }

        return (strTemp);
    },

    // Ternary string Eval,Used in StringTernaryEval Method
    TempStringTernaryEval: function (sInfix) {
        let strTemp = "";
        let str1 = "";
        let res1 = "";
        let res2 = "";
        let stkTemp = [];//Temp stack
        let i = 0;

        //sInfix = sInfix.replace(" ", "");
        sInfix = sInfix.replace(/\s+/g, '');
        for (i = 0; i < sInfix.length; i++) {
            switch (sInfix.charAt(i)) {
                case '?':
                case ':':
                    strTemp = FormulaHelper.NormString(strTemp);
                    stkTemp.push(strTemp);
                    strTemp = "";//make empty
                    break;

                default:
                    strTemp += sInfix[i];//add to temp
                    break;
            }
        }

        stkTemp.push(FormulaHelper.NormString(strTemp));//push the result

        while (stkTemp.length != 1)//check stack vals
        {
            str1 = "";
            res1 = "";
            res2 = "";

            res2 = stkTemp[stkTemp.length - 1]; // Second result
            stkTemp.splice(stkTemp.length - 1, 1);


            res1 = stkTemp[stkTemp.length - 1];  // First result
            stkTemp.splice(stkTemp.length - 1, 1);

            str1 = stkTemp[stkTemp.length - 1]; // Exp
            stkTemp.splice(stkTemp.length - 1, 1);

            str1 = FormulaHelper.TrimbyParanthesis(str1);
            res1 = FormulaHelper.TrimbyParanthesis(res1);
            res2 = FormulaHelper.TrimbyParanthesis(res2);

            stkTemp.push(DataType.stringIncludes(str1, "1") == true ? res1 : res2);
        }

        strTemp = stkTemp[stkTemp.length - 1];
        stkTemp.splice(stkTemp.length - 1, 1);

        return (strTemp);
    },

    // normalizing eqn means adding '(' or this ')' to make valid eqn
    NormString: function (sTemp) {
        let iCounter = 0;
        let iOpCount = 0;
        let iClCount = 0;
        let iDifference = 0;

        for (iCounter = 0; iCounter < sTemp.length; iCounter++) {
            switch (sTemp.charAt(iCounter)) {
                case '(':
                    iOpCount++;//no of '('
                    break;
                case ')':
                    iClCount++;//no of ')'
                    break;
                default:
                    break;
            }
        }
        iDifference = iOpCount - iClCount;
        if (iDifference > 0) {
            for (iCounter = 0; iCounter < iDifference; iCounter++) {
                sTemp += ")";//add that many )
            }
        }
        else if (iDifference < 0) {
            iDifference *= -1;
            for (iCounter = 0; iCounter < iDifference; iCounter++) {
                sTemp = "(" + sTemp;//add that many (
            }
        }

        return (sTemp);
    },

