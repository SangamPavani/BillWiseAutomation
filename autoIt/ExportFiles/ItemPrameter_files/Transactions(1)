    getLPTemplate: function (iRow) {
        let iLPGenerationType = 0; // None
        let iLPTemplate = -1;

        if (transEntryFields.getItem(iRow) <= 0) {
            return (iLPTemplate);
        }

        if (EntryMain.isModuleImplemented(eModulesImplemented.WMS) == false
            && EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL) == false) {

            return (iLPTemplate);
        }

        // Get Item LPGenerationType
        iLPGenerationType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item,
                                                                iRow,
                                                                "iLPGenerationType",
                                                                eMasterDataType.Number);

        if (iLPGenerationType == 0) { // None is selected in Item
            if (EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL) == true) {
                if (transEntryFieldInfo.AllocationTag.FieldId > 0) {
                    // Get Storer LPGenerationType
                    iLPGenerationType = transEntryFields.getMandatoryValue(transEntryFieldInfo.AllocationTag,
                                                                            iRow,
                                                                            "iLPGenerationType",
                                                                            eMasterDataType.Number);

                    if (iLPGenerationType == 0) { // None is selected in Storer
                        iLPTemplate = EntryMainUI.getPreferenceLPTemplateId(true);
                    }
                    else if (iLPGenerationType == 3) { // (Generate LP On Receiving)
                        // Get Storer iLPTemplate
                        iLPTemplate = transEntryFields.getMandatoryValue(transEntryFieldInfo.AllocationTag,
                                                                            iRow,
                                                                            "iLPTemplate",
                                                                            eMasterDataType.Number);

                        if (iLPTemplate == 0) {
                            iLPTemplate = EntryMainUI.getPreferenceLPTemplateId(false);
                        }
                    }
                }
                else {  // Storer not found, Pick from preference
                    iLPTemplate = EntryMainUI.getPreferenceLPTemplateId(true);
                }
            }
            else { // 3PL not enabled, Pick from preference
                iLPTemplate = EntryMainUI.getPreferenceLPTemplateId(true);
            }
        }
        else if (iLPGenerationType == 3) { // (Generate LP On Receiving) selected in item
            if (EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL) == true
                && transEntryFieldInfo.AllocationTag.FieldId > 0) {

                // Get Storer iLPTemplate
                iLPTemplate = transEntryFields.getMandatoryValue(transEntryFieldInfo.AllocationTag,
                                                                iRow,
                                                                "iLPTemplate",
                                                                eMasterDataType.Number);
            }

            if (iLPTemplate == 0) {
                iLPTemplate = EntryMainUI.getPreferenceLPTemplateId(false);
            }
        }

        return (iLPTemplate);
    },

    getDefaultLPType: function (iRow) {
        let iLPGenerationType = 0;
        let iLPType = 0;
        let result = undefined;

        result = EntryMainUI.getLPGenerationTypeInternal(iRow);
        if (result.Value > 0) { // Not None
            if (result.Source == transEntryFieldInfo.Item.FieldId) {
                // Get Item LPType
                iLPType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item,
                                                                iRow,
                                                                "iLPType",
                                                                eMasterDataType.Number);

                if (iLPType > 0) {
                    return (iLPType);
                }
            }

            if (result.Source != 0 // Not Global
                && EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL) == true
                && transEntryFieldInfo.AllocationTag.FieldId > 0) {

                if (result.Source == transEntryFieldInfo.Item.FieldId) {
                    // Get Storer LPGenerationType
                    iLPGenerationType = transEntryFields.getMandatoryValue(transEntryFieldInfo.AllocationTag,
                                                                            iRow,
                                                                            "iLPGenerationType",
                                                                            eMasterDataType.Number);

                    if (iLPGenerationType != result.Value) { // Allocation tag and item generation type not match, pick from global
                        switch (result.Value) {
                            case 1: // (Default LP Generation)
                                iLPType = transEntryInfo.WMSPref.iLPIdDefault;
                                break;
                            case 2: // (Warehouse Wise LP Generation)
                                iLPType = transEntryInfo.WMSPref.iLPIdWarehouse;
                                break;
                            case 3: // (Generate LP On Receiving)
                                iLPType = transEntryInfo.WMSPref.iLPIdReceiving;
                                break;
                            case 4: // (Manually Generate LP)
                                iLPType = transEntryInfo.WMSPref.iLPIdManually;
                                break;
                        }

                        return (iLPType);
                    }
                }

                // Get Storer LPType
                iLPType = transEntryFields.getMandatoryValue(transEntryFieldInfo.AllocationTag,
                                                                iRow,
                                                                "iLPType",
                                                                eMasterDataType.Number);

                if (iLPType > 0) {
                    return (iLPType);
                }
            }

            // Pick from global
            switch (result.Value) {
                case 1: // (Default LP Generation)
                    iLPType = transEntryInfo.WMSPref.iLPIdDefault;
                    break;
                case 2: // (Warehouse Wise LP Generation)
                    iLPType = transEntryInfo.WMSPref.iLPIdWarehouse;
                    break;
                case 3: // (Generate LP On Receiving)
                    iLPType = transEntryInfo.WMSPref.iLPIdReceiving;
                    break;
                case 4: // (Manually Generate LP)
                    iLPType = transEntryInfo.WMSPref.iLPIdManually;
                    break;
            }
        }

        return (iLPType);
    },

    getPreferenceLPTemplateId: function (bValidate) {
        let iLPGenerationType = 0;
