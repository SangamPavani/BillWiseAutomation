    onGross_Leave: function (element, iRow) {
        let dQuantity = 0;
        let dRate = 0;
        let dGross = 0;
        let bCalcGross = false;

        try {
            dGross = transEntryGross.setValue(FConvert.toDecimal(element.value), iRow, true);

            if (transEntryFieldInfo.Rate.ColumnIndex > -1
                && transEntryFieldInfo.Qty.ColumnIndex > -1
                && transEntryFieldInfo.Rate.MetaData.bHidden == false
                && transEntryFieldInfo.Qty.MetaData.bHidden == false) {

                dQuantity = transEntryFields.getQty(iRow);

                if (dQuantity == 0) {
                    dRate = 0;
                }
                else {
                    dRate = FNumberOperation.div(dGross, dQuantity); // Gross/Quantity
                    dRate = FNumberOperation.abs(dRate);
                }

                dRate = transEntryRate.update(dRate, iRow, true);

                if (dQuantity == 0) {
                    element.value = "";
                }
                else if (FNumberOperation.isNotEqualTo(dRate, 0) == true && FNumberOperation.isLessThan(dGross, 0) == true) {
                    dQuantity = FNumberOperation.abs(dQuantity);
                    dQuantity = FNumberOperation.negated(dQuantity);
                    transEntryQuantity.setValue(dQuantity, iRow);
                }

                transEntryRate.checkMinRate(iRow);
            }
            else {
                bCalcGross = false;
            }

            if (bCalcGross == true) {
                EntryMainProductionProcess.updateRate(iRow);
                transEntryGross.calculateAndUpdate({ iRow: iRow });
                EntryMainProductionProcess.calculateReceivedRate(iRow);
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryDetailPopup.onGross_Leave} " + err.message);
        }
    },

    onFocus: function (id, event) {
        let obj = null;
        let iRow = 0;
        let iColumn = 0;
        let value = "";
        let PreloadValue = null;

        try {
            if (transEntryDetailPopup.isVisible() == false) {
