                else {
                    dExistingRate = DataType.toDecimal(cellobj.getCellData());
                }

                if (DataType.lt(dExistingRate, dRate) == true) {
                    sValue = DataType.toDecimal(dRate, transEntrySettings.getDecimalsInAmount());
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgRateCantFallBelow").replace("{0}", sValue), GlobalPref.getResourceValue("Error"));

