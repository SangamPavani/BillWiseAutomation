                            else if (billWiseInfo.EntryColNo = 11)
                                TAmount = FNumberOperation.add(TAmount, g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_arrAdjustedReferences[i].mAAIDBaseCurrency);
