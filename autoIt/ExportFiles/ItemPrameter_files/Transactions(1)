    isStopRuleConditionFound: function () {
        let iCounter = 0;
        let iRow = 0;
        let iTotal = 0;
        let bResult = false;
        let arrRows = [];
        let arrFields = undefined;
        let objMetaData = undefined;

        try {
            if (transEntryInfo.BodySectionNotRequired == true) {
                iTotal = 0;
            }
            else {
                iTotal = transEntryGrid.getTotalRows();
            }

            for (iRow = 0; iRow <= iTotal; iRow++) {
                if (iRow > 0) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        continue;
                    }

                    arrRows.push(iRow);
                }

                bResult = EntryMainRules.checkForStopRule(transEntryInfo.Settings.ArrVoucherRules, iRow);
                if (bResult == true) {
                    return (true);
                }
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                bResult = EntryMainRules.checkForStopRule(objMetaData.ArrRules, 0);
                if (bResult == true) {
                    return (true);
                }
            }

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; arrRows.length > 0 && iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;

                if (DataType.arrayLength(objMetaData.ArrRules) < 1) {
                    continue;
                }

                for (iRow = 0; iRow < arrRows.length; iRow++) {
                    bResult = EntryMainRules.checkForStopRule(objMetaData.ArrRules, arrRows[iRow]);
                    if (bResult == true) {
                        return (true);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.isStopRuleConditionFound} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    checkForStopRule: function (arrRules, iRow) {
        let sMessage = "";
        let iCounterRules = 0;
        let iCounterTwo = 0;
        let iTotal = 0;
        let sResult = "";
        let bProcess = false;
        let objRules = null;
        let objRuleBody = null;
        let bEdit = false;
        let bNoCondition = false;
        let NoFormula = undefined;
        let result = null;

        try {
            bEdit = transEntryInfo.HeaderId > 0;
            iTotal = DataType.arrayLength(arrRules);
            for (iCounterRules = 0; iCounterRules < iTotal; iCounterRules++) {
                objRules = arrRules[iCounterRules];
                if (objRules.IsRuleActive == false) {
                    continue;
                }

                if (bEdit == true) {
                    if (objRules.Edit == false) {
                        continue;
                    }
                }
                else {
                    if (objRules.NewRecord == false) {
                        continue;
                    }
                }


                bProcess = true;
                if (objRules.onEnter == true) {
                    bProcess = true;
                }
                else if (objRules.onLeave == true) {
                    bProcess = true;
                }
                else if (objRules.NewRecord == true) {
                    bProcess = true;
                }
                else if (objRules.Edit == true) {
                    bProcess = true;
                }

                if (bProcess == false) {
                    continue;
                }

                sResult = "";
                bNoCondition = false;

                for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody.length; iCounterTwo++) {
                    NoFormula = undefined;
                    objRuleBody = objRules.RuleBody[iCounterTwo];

                    // Last index of RuleBody is for else
                    if (iCounterTwo == objRules.RuleBody.length - 1) {
                        if (iCounterTwo == 0 && iRow == 0) {
                            bNoCondition = true;
                        }

                        sResult = "1";
                    }
                    else {
                        result = EntryMainRules.evaluateRuleCondition(objRuleBody.RuleCondition,
                                        iRow,
                                        undefined,
                                        "",
                                        undefined,
                                        0);

                        if (DataType.isNullOrEmpty(result.sFormula) == true) {
                            sResult = "1";
                            NoFormula = true;
                        }
                        else {
                            sResult = result.sResult;
                            NoFormula = false;
                        }
                    }

                    if (sResult == "1") {
                        break;
                    }
                }

                if (objRuleBody.MessageType == 2 && NoFormula === false) { // Warn And Stop
                    sMessage = objRuleBody.GeneralMessage;
                    if (DataType.isNullOrEmpty(sMessage) == true) {
                        sMessage = "No rule Message is defined for warn and stop.";
                    }

                    transEntryGlobal.showAlert(sMessage, GlobalPref.getResourceValue("Error"));

                    return (true);
                }

                if (objRuleBody.MessageType == 1 && bNoCondition == true) {
                    sMessage = objRuleBody.GeneralMessage;
                    if (DataType.isNullOrEmpty(sMessage) == true) {
                        sMessage = "No rule Message is defined for warn and confirm. Are you sure you want to stop?";
                    }

                    if (transEntryGlobal.confirmMessage(sMessage) == false) {
                        return (true);
                    }
                }
                else if (objRuleBody.MessageType == 0 && bNoCondition == true) {
                    sMessage = objRuleBody.GeneralMessage;

                    if (DataType.isNullOrEmpty(sMessage, true) == false) {
                        transEntryGlobal.showAlert(sMessage, GlobalPref.getResourceValue("Alert"));
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.checkForStopRule} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

