    changeBookH: function (tag) {
        let iCounter = 0;
        let sId = "";
        let iAccountTypeId = 0;
        let iDefaultBankCurrency = 0;
        let iMaskedVoucherType = 0;
        let iValue = 0;
        let iTotalRows = 0;
        let iPmtTerm = 0;
        let iCode = 0;
        let bFlag = false;
        let bLoadLink = false;
        let objMetaData = undefined;
        let objBookData = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let result = undefined;

        try {
            if (DataType.isValidObject(tag.CustomData) == true
                && (tag.CustomData.CallingSource == eDisplayBodyDataSource.LoadLink
                    || tag.CustomData.CallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage)) {

                bLoadLink = true;
            }

            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(tag.Control));
            if (iValue > 0) {
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                    //iCode = EntryMain.m_objTrans.BodyData[0].Code;
                    sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.Code.FieldId);
                    iCode = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
