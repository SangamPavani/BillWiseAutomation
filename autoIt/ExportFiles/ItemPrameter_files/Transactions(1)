    // Called from batch popup
    batchResult: function (bFlag, arrBatchList, sCustomData, evt) {
        let iCounter = 0;
        let iTotal = 0;
        let bResult = false;
        let arrTransactionIds = undefined;
        let arrBatchBody = undefined;
        let arrBatchRows = undefined;
        let obj = undefined;
        let result = undefined;
        let state = undefined;
        let objLog = undefined;

        try {
            objLog = GetLogObject();
            objLog.add("Method-batchResult() Start");

            if (transEntryGlobal.debugBatch == true || transEntryGlobal.debugCallback == true) {
                debugger
            }

            obj = DataType.stringToObject(sCustomData);
            if (obj.lValue > 0) {
                obj = obj.data;
            }
            else {
                obj = null;
            }

            if (bFlag == false || DataType.isValidObject(obj) == false) {
                transEntryGrid.moveToNextCell();

                return;
            }

            if (EntryMainUI.isFreeRow(obj.iRow) == true && arrBatchList.length > 1) {
                transEntryGlobal.showAlert("Free row cannot be adjusted among multiple batch.", "Error");

                transEntryGrid.moveToNextCell();

                return;
            }

            arrTransactionIds = [];

            iTotal = DataType.arrayLength(arrBatchList);
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                arrBatchList[iCounter].BatchId = DataType.toInt(arrBatchList[iCounter].BatchId);
                arrBatchList[iCounter].Qty = DataType.toDecimal(arrBatchList[iCounter].Qty);
                arrBatchList[iCounter].BatchRate = DataType.toDecimal(arrBatchList[iCounter].BatchRate);

                if((typeof arrBatchList[iCounter].MfgDate).toLowerCase() == "object" && DataType.isValidObject(arrBatchList[iCounter].MfgDate) == true) {
                    arrBatchList[iCounter].MfgDate = arrBatchList[iCounter].MfgDate.Value;
                }

                if ((typeof arrBatchList[iCounter].ExpDate).toLowerCase() == "object" && DataType.isValidObject(arrBatchList[iCounter].ExpDate) == true) {
                    arrBatchList[iCounter].ExpDate = arrBatchList[iCounter].ExpDate.Value;
                }

                if (DataType.isValidObject(arrBatchList[iCounter].QtyAdjusted) == true) {
                    arrBatchList[iCounter].QtyAdjusted = DataType.toDecimal(arrBatchList[iCounter].QtyAdjusted);
                }
                else {
                    arrBatchList[iCounter].QtyAdjusted = arrBatchList[iCounter].Qty;
                }

                arrTransactionIds.push(arrBatchList[iCounter].BatchId);
            }


            objLog.add("Method-batchResult::Server::GetBodyDataByBatchId() Start");
            result = transEntryServer.getBodyDataByBatchId(arrTransactionIds, false);
            objLog.add("Method-batchResult::Server::GetBodyDataByBatchId() End");

            if (result.lValue > 0 && result.data.lValue > 0) {
                arrBatchBody = result.data.data;
            }
            else {
                arrBatchBody = [];
            }

            state = transEntryGrid.getStateObject();

            objLog.add("Method-batchResult::processBatchData() Start");
            arrBatchRows = EntryMainBatch.processBatchData(obj.iRow, arrBatchList, arrBatchBody, evt, true, objLog);
            objLog.add("Method-batchResult::processBatchData() End");

            //state = transEntryGrid.getStateObject();

            if (transEntryFieldInfo.Reservation.ColumnIndex > -1) {
                if (transEntryFieldInfo.Bins.ColumnIndex > -1
                    && transEntryFieldInfo.Bins.ColumnIndex < transEntryFieldInfo.Reservation.ColumnIndex) {
                    // do nothing
                }
                else if (transEntryFieldInfo.Bins2.ColumnIndex > -1
                    && transEntryFieldInfo.Bins2.ColumnIndex < transEntryFieldInfo.Reservation.ColumnIndex) {
                    // do nothing
                }
                else {
                    objLog.add("Method-batchResult::autoAllocateReservation() Start");
                    bResult = EntryMainAutoAllocate.reservation(arrBatchRows);
                    objLog.add("Method-batchResult::autoAllocateReservation() End");
                }
            }

            state.pick();

            //EntryMainUI.resetOthersContainer();

            objLog.add("Method-batchResult::getNetAmount() Start");
            if (DataType.arrayLength(arrBatchRows) == 1) {
                EntryMainCalculation.getNetAmount(arrBatchRows[0]);
            }
            else {
                EntryMainCalculation.getNetAmount(0);
            }
            objLog.add("Method-batchResult::getNetAmount() End");

            // EntryMainCalculation.getNetAmount(0);

            objLog.add("Method-batchResult::calculateReceivedRate() Start");
            EntryMainProductionProcess.calculateReceivedRate(obj.iRow, objLog);
            objLog.add("Method-batchResult::calculateReceivedRate() End");

            if (state.isChanged() == true) {
                transEntryGrid.gotoCell(state.iRow, state.iColumn);
