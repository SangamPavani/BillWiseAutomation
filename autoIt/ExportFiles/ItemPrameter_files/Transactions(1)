            if (DataType.arrayLength(arrMappings) < 1) {
                return;
            }

            if (transEntryLinks.isFieldExistInMappingList(eVTFIELDID.FDF_HEADERINVTAG, arrMappings) == false) {
                if (transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header) {
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_HEADERINVTAG)
                    objFindResult = EntryMainCommon.findKeyValue(sId, objData.Header);
                    if (objFindResult.lValue > 0 && objFindResult.data.Value > 0) {
                        objData.Header[objFindResult.lValue - 1].Value = 0;
                    }
                }
                else if (transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Body) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_HEADERINVTAG);
                    for (iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                        objFindResult = EntryMainCommon.findKeyValue(sId, objData.Body[iCounter]);
                        if (objFindResult.lValue > 0 && objFindResult.data.Value > 0) {
                            objData.Body[iCounter][objFindResult.lValue - 1].Value = 0;
                        }
                    }
                }
            }

            if (transEntryLinks.isFieldExistInMappingList(eVTFIELDID.FDF_BODYINVTAG, arrMappings) == false) {
                if (transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header) {
                    sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BODYINVTAG)
                    objFindResult = EntryMainCommon.findKeyValue(sId, objData.Header);
                    if (objFindResult.lValue > 0 && objFindResult.data.Value > 0) {
                        objData.Header[objFindResult.lValue - 1].Value = 0;
                    }
                }
                else if (transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Body) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYINVTAG);
                    for (iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                        objFindResult = EntryMainCommon.findKeyValue(sId, objData.Body[iCounter]);
                        if (objFindResult.lValue > 0 && objFindResult.data.Value > 0) {
                            objData.Body[iCounter][objFindResult.lValue - 1].Value = 0;
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryLinks.UpdateLoadedLinkInvTag} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    setStatus: function(iLinkStatus) {
