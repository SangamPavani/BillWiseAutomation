var transEntryCollapse = {
    toggle: function (id, sCallback) {
        try {
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                transEntryCollapse.PRIVATE.bind(id, sCallback);

                $(id).collapse('toggle');
            }
        }
        catch (err) { }
    },

    show: function (id, sCallback) {
        try {
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                transEntryCollapse.PRIVATE.bind(id, sCallback);

                $(id).collapse('show');
            }
        }
        catch (err) { }
    },

    hide: function (id, sCallback) {
        try {
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                transEntryCollapse.PRIVATE.bind(id, sCallback);

                $(id).collapse('hide');
            }
        }
        catch (err) { }
    },

    dispose: function (id, sCallback) {
        try {
            id = FUIElement.getValidElement(id);
            if (DataType.isValidObject(id) == true) {
                transEntryCollapse.PRIVATE.bind(id, sCallback);

                $(id).collapse('dispose');
            }
        }
        catch (err) { }
    },

    PRIVATE: {
        shown: function (evt) {
            try {
                eval(evt.data.Callback)(evt.data.Id, true);
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("Exception: {transEntryCollapse.shown} " + err.message);
            }
        },

        hidden: function (evt) {
            try {
                eval(evt.data.Callback)(evt.data.Id, false);
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("Exception: {transEntryCollapse.hidden} " + err.message);
            }
        },

        bind: function (id, sCallback) {
            // show.bs.collapse - This event fires immediately when the show instance method is called.
            // shown.bs.collapse - This event is fired when a collapse element has been made visible to the user (will wait for CSS transitions to complete).
            // hide.bs.collapse - This event is fired immediately when the hide method has been called.
            // hidden.bs.collapse - This event is fired when a collapse element has been hidden from the user (will wait for CSS transitions to complete).
            try {
                if (DataType.isNullOrEmpty(sCallback, true) == true) {
                    return;
                }

                id = FUIElement.getValidElement(id);
                if (DataType.isValidObject(id) == false) {
                    return;
                }

                $(id).off("shown.bs.collapse", transEntryCollapse.PRIVATE.shown);
                $(id).on("shown.bs.collapse", { Id: id, Callback: sCallback }, transEntryCollapse.PRIVATE.shown);

                $(id).off("hidden.bs.collapse", transEntryCollapse.PRIVATE.hidden);
                $(id).on("hidden.bs.collapse", { Id: id, Callback: sCallback }, transEntryCollapse.PRIVATE.hidden);
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("Exception: {transEntryCollapse.bind} " + err.message);
            }
        }
    }
};

