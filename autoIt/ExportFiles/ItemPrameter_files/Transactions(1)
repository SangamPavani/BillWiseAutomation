                    objControl = EntryMainUI.getElement(objFieldInfo, iRow);
                    if (objControl.Value) {
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, 0, iRow);

                        if ((typeof objControl.Value).toLowerCase() == "string") {
                            OPTIONCONTROL.clear(objControl.Value);
                        }
                        else {
                            objControl.Value.clear();
                        }

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                case eVTFIELDID.FDF_BODYRATE:
                    iRow = DataType.toInt(iRow);
                    objControl = EntryMainUI.getElement(objFieldInfo, iRow);
                    if (objControl.Value) {
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, 0, iRow);

                        if ((typeof objControl.Value).toLowerCase() == "string") {
                            document.getElementById(objControl.Value).value = "";
                        }
                        else {
                            objControl.Value.clear();
                        }

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BODYGROSS:
                case eVTFIELDID.FDF_LOCEXCHANGERATE:
                    iRow = DataType.toInt(iRow);
                    objControl = EntryMainUI.getElement(objFieldInfo, iRow);
                    if (objControl.Value) {
                        if ((typeof objControl.Value).toLowerCase() == "string") {
                            document.getElementById(objControl.Value).value = "";
                        }
                        else {
                            objControl.Value.clear();
                        }

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    if ((typeof iRow).toLowerCase() == "object") {
                        objControl = {};
                        objControl.Value = iRow;
                        iRow = objControl.Value.iRow;

                        objControl.Value.clear();
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);

                        bFlag = true;
                    }
                    else {
                        if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                            debugger
                        }

                        if (objFieldInfo.ColumnIndex > -1) {
                            iRow = DataType.toInt(iRow);

                            transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                            EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);

                            bFlag = true;
                        }
                    }
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                        EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BINS:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);
                        if (iRow > 0) {
                            EntryMainMemoryObject.update(objFieldInfo.FieldId, undefined, iRow);
                        }

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_BINS2:
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        transEntryGrid.clear(iRow, objFieldInfo.ColumnIndex);

                        bFlag = true;
                    }
                    break;
                case eVTFIELDID.FDF_RMANO: /* Called when inv tag is changed */
                    if (transEntryGlobal.debugField == objFieldInfo.FieldId) {
                        debugger
                    }

                    if (objFieldInfo.ColumnIndex > -1) {
                        iRow = DataType.toInt(iRow);
                        if (transEntryDetailPopup.isVisible() == true && transEntryDetailPopup.getRow() == iRow) {
                            objControl = {};
                            objControl.Value = EntryMainUI.getBodyControlId(objFieldInfo.FieldId);
