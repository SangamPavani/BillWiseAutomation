    getMinRateInput: function (iRow) {
        let iCounter = 0;
        let iLength = 0;
        let iInvTagArea = eTranEntryFieldArea.None;
        let bBatchExist = false;
        let arrLoaded = undefined;
        let objBody = undefined;
        let objMethod = undefined;
        let objMinRateInput = undefined;

        try {
            bBatchExist = transEntryFieldInfo.BatchNo.ColumnIndex > -1;

            if (transEntryInfo.isItTransfer == false) {
                iInvTagArea = transEntryInvTag.getArea()
            }

            objMinRateInput = {};
            objMinRateInput.bLoadStockData = false;
            objMinRateInput.iDate = EntryMain.m_objTrans.Header.Date;
            objMinRateInput.bRateOnly = false;
            objMinRateInput.bRoundOff = true;
            objMinRateInput.arrDepartmentId = [];
            objMinRateInput.arrWarehouseId = [];
            objMinRateInput.arrExchangeRate = [];
            objMinRateInput.arrTransactionId = [];
            objMinRateInput.arrProductId = [];
            objMinRateInput.arrBatchId = [];
            objMinRateInput.arrUnitConversion = [];
            objMinRateInput.arrPrevQty = [];
            objMinRateInput.arrQty = [];
            objMinRateInput.arrOrigRate = [];
            objMinRateInput.bUnitExist = transEntryFieldInfo.Unit.ColumnIndex > -1;

            if (transEntryFieldInfo.FATag.Area != eTranEntryFieldArea.Body) {
                objMinRateInput.arrDepartmentId.push(EntryMainMemoryObject.getFAValue(1));
            }

            if (iInvTagArea != eTranEntryFieldArea.Body) {
                objMinRateInput.arrWarehouseId.push(EntryMainMemoryObject.getInvValue(1));
            }

            if (transEntryFieldInfo.ExchangeRate.Area != eTranEntryFieldArea.Body) {
                objMinRateInput.arrExchangeRate.push(EntryMainMemoryObject.getExchangeRate(1));
            }

            if (iRow > 0) {
                iCounter = iRow - 1;
                iLength = iRow;

            }
            else {
                iCounter = 0;
                iLength = EntryMain.m_objTrans.BodyData.length;
            }

            for (; iCounter < iLength; iCounter++) {
                objBody = EntryMain.m_objTrans.BodyData[iCounter];
                if (objBody.Sales && objBody.Sales.Product > 0) {
                    if (iInvTagArea == eTranEntryFieldArea.Body) {
                        objMinRateInput.arrWarehouseId.push(EntryMainMemoryObject.getInvValue(iCounter + 1));
                    }

                    if (transEntryFieldInfo.FATag.Area == eTranEntryFieldArea.Body) {
                        objMinRateInput.arrDepartmentId.push(EntryMainMemoryObject.getFAValue(iCounter + 1));
                    }

                    if (transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Body) {
                        objMinRateInput.arrExchangeRate.push(objBody.ExchangeRate);
                    }

                    objMinRateInput.arrTransactionId.push(objBody.TransactionId);
                    objMinRateInput.arrProductId.push(objBody.Sales.Product);
                    objMinRateInput.arrOrigRate.push(objBody.Sales.OrigRate);

                    if (bBatchExist == true) {
                        objMinRateInput.arrBatchId.push(transEntryBatch.getBatchId(iCounter + 1));
                    }

                    if (objMinRateInput.bUnitExist == true) {
                        objMinRateInput.arrUnitConversion.push(transEntryUnit.getConversionValue(iCounter + 1));
                    }

                    arrLoaded = DataType.arrayFilterData(transEntryGlobal.arrLoadedData, eTranEntryBodyDataConstKey.BodyId, objBody.BodyId, "===");
                    if (arrLoaded.length > 0) {
                        objMinRateInput.arrPrevQty.push(arrLoaded[0].BaseQuantity);
                    }
                    else {
                        objMinRateInput.arrPrevQty.push(0);
                    }

                    objMethod = EntryMainMemoryObject.getProductDataValue("iValuationMethod", iCounter + 1);
                    if (objMethod == undefined || objMethod == null) {
                        objMinRateInput.arrQty.push(0);
                    }
                    else {
                        objMethod = DataType.toInt(objMethod);
                        if (objMethod == eValuationMethod.FIFO || objMethod == eValuationMethod.FIFOTransactionTime || objMethod == eValuationMethod.LIFO) {
                            objMinRateInput.arrQty.push(objBody.Sales.BaseQuantity);
                        }
                        else {
                            objMinRateInput.arrQty.push(0);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.getMinRateInput} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objMinRateInput);
    },

