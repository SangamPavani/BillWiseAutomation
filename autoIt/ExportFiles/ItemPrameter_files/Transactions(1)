    getColumnRuleFilterObject: function (iRow) {
        let result = null;

        result = DataType.arrayFilterData(transEntryGlobal.arrColumnRuleFilter, "iRow", iRow, "==");

        return (result);
    },

    addColumnRuleFilter: function (obj) {
        transEntryGlobal.arrColumnRuleFilter.push(obj);
    },

    deleteColumnRuleFilter: function (iRow, iColumn) {
        let iCounter = 0;
        let iIndex = 0;
        let objRow = null;

        try {
            for (iIndex = 0; iIndex < transEntryGlobal.arrColumnRuleFilter.length; iIndex++) {
                if (transEntryGlobal.arrColumnRuleFilter[iIndex].iRow != iRow) {
                    continue;
                }

                for (iCounter = 0; iCounter < transEntryGlobal.arrColumnRuleFilter[iIndex].arrColumnFilter.length; iCounter++) {
                    if (transEntryGlobal.arrColumnRuleFilter[iIndex].arrColumnFilter[iCounter].iColumn != iColumn) {
                        continue;
                    }

                    transEntryGlobal.arrColumnRuleFilter[iIndex].arrColumnFilter.splice(iCounter, 1);
                    iCounter--;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGridRuleFilter.deleteColumnRuleFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateColumnRuleFilter: function (objRow, iColumn, value, bLeaf) {
        let iCounter1 = 0;
        let objColumn = null;

        try {
            iCounter1 = 0;
            while (iCounter1 < objRow.arrColumnFilter.length) {
                objColumn = objRow.arrColumnFilter[iCounter1];
                if (objColumn.iColumn == iColumn) {
                    objColumn.Value = value;
                    objColumn.bGroup = DataType.toBoolean(bLeaf) == false;
                    objRow.arrColumnFilter.splice(iCounter1, 1, objColumn);
                    break;
                }

                iCounter1++;
            }

            if (DataType.isValidObject(value) == true && iCounter1 >= objRow.arrColumnFilter.length) // If column not found
            {
                objColumn = transEntryGridRuleFilter.getEmptyColumnFilterObject();
                objColumn.iColumn = iColumn;
                objColumn.Value = value;
                objColumn.bGroup = DataType.toBoolean(bLeaf) == false;
                objRow.arrColumnFilter.push(objColumn);
            }

            if (DataType.isValidObject(value) == true || iCounter1 < objRow.arrColumnFilter.length) {
                for (iCounter1 = 0; iCounter1 < transEntryGlobal.arrColumnGroupFilter.length; iCounter1) {
                    if (transEntryGlobal.arrColumnGroupFilter[iCounter1].iRow == objRow.iRow) {
                        transEntryGlobal.arrColumnGroupFilter.splice(iCounter1, 1, objRow);
                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGridRuleFilter.updateColumnRuleFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getColumnFilterRuleValue: function (iRow, iColumn) {
        let arrTemp = null;
        let obj = null;

        try {
            obj = {};
            obj.iGroupId = 0;
            obj.iRow = 0;
            obj.bGroup = true;
            obj.Value = null;

            arrTemp = transEntryGridRuleFilter.getColumnRuleFilterObject(iRow);
            if (arrTemp.length > 0) {
                arrTemp = DataType.arrayFilterData(arrTemp[0].arrColumnFilter, "iColumn", iColumn, "==");
