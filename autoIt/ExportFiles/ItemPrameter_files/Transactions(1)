    updateSecondGridBody: function (eleGrid, arrRowData, iNoOfDecimals, bIsFromClub) {
        let sText = "";
        let iCounter = 0;
        let iRowCounter = 0;
        let iColCounter = 0;
        let iTotal = 0;
        let dValue = 0;
        let bBodyCreated = false;
        let eleBody = null;
        let eleTr = null;
        let eleTd = null;
        let eleCheck = null;
        let RowData = null;
        let objFieldInfo = null;
        let value = null;
        let data = null;

        try {
            bBodyCreated = false;
            eleBody = document.getElementById("id_copydoc_grid2_tbody");
            if (DataType.isValidObject(eleBody) == false) {
                eleBody = document.createElement("tbody");
                eleBody.id = "id_copydoc_grid2_tbody";

                bBodyCreated = true;
            }

            if (bIsFromClub == true) {
                //clear all Trs from tbody
                FUIElement.removeChild(eleBody);
            }

            iTotal = DataType.arrayLength(arrRowData);
            for (iRowCounter = 0; iRowCounter < iTotal; iRowCounter++) {
                RowData = arrRowData[iRowCounter];
                if (DataType.arrayLength(RowData) < 1) {
                    continue;
                }

                for (iCounter = 0; iCounter < eleBody.children.length; iCounter++) {
                    eleTr = eleBody.children[iCounter];
                    if (eleTr.getAttribute("data-bodyid") == RowData[0]) {
                        break;
                    }
                }

                if (iCounter < eleBody.children.length) { // Row already exist.
                    continue;
                }


                eleTr = document.createElement("tr");
                eleTr.style.height = "20px";

                if (CopyDocUI.m_iCurrentVoucherRowNo != 0) {
                    eleTr.setAttribute("data-ivoucherrowno", CopyDocUI.m_iCurrentVoucherRowNo);
                }
                else {
                    eleTr.setAttribute("data-ivoucherrowno", CopyDocUI.m_arrVoucherRowNo[iRowCounter]);
                }

                eleTd = document.createElement("td");                
                eleTd.style.textAlign = "center";
                eleTd.style.minWidth = "30px";
                eleTd.style.maxWidth = "50px";
                eleTd.style.paddingTop = "0px";
                eleTd.style.paddingBottom = "0px";

                //eleTd.style.width = "30px";
                FUIElement.setText(eleTd, eleBody.children.length + 1);
                eleTr.appendChild(eleTd);


                eleTd = document.createElement("td");
                eleTd.style.textAlign = "center";
                eleTd.style.minWidth = "30px";
                eleTd.style.maxWidth = "30px";
                eleTd.style.paddingTop = "0px";
                eleTd.style.paddingBottom = "0px";

                //eleTd.style.width = "30px";
                eleCheck = document.createElement("input");
                eleCheck.type = "checkbox";
                eleCheck.checked = true;
                eleCheck.setAttribute("onclick", "CopyDocUI.onGrid2_check(this, false, event);");
                eleTd.appendChild(eleCheck);
                eleTr.appendChild(eleTd);

                for (iColCounter = 0; iColCounter < RowData.length && iColCounter < CopyDocUI.m_arrFieldInfo.length; iColCounter++) {
                    objFieldInfo = CopyDocUI.m_arrFieldInfo[iColCounter];
                    if (objFieldInfo === eTranEntryBodyDataConstKey.BodyId) {
                        eleTr.setAttribute("data-bodyid", RowData[iColCounter]);
                        continue;
                    }
                    else if (objFieldInfo === eTranEntryBodyDataConstKey.TransactionId) {
                        eleTr.setAttribute("data-transactionid", RowData[iColCounter]);
                        continue;
                    }
                    else if (objFieldInfo === "HeaderId") {
                        eleTr.setAttribute("data-iheaderid", RowData[iColCounter]);
                        continue;
                    }

                    if(objFieldInfo.bHidden == true) { // Hidden field heading is not created, so data will also not be set.
                        continue;
                    }

                    eleTd = null;
                    if(objFieldInfo.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";

                        value = DataType.stringToObject(value);
                        if (value.lValue > 0) {
                            FUIElement.setText(eleTd, value.data.BatchNo);
                        }
                    }
                    else if (objFieldInfo.iFieldId == eVTFIELDID.FDF_BINS || objFieldInfo.iFieldId == eVTFIELDID.FDF_BINS2) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";

                        value = DataType.stringToObject(value);
                        if (value.lValue > 0 && value.data.length > 0) {
                            FUIElement.setText(eleTd, value.data[0].BinName);
                        }
                    }
                    else if (objFieldInfo.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";
                        FUIElement.setText(eleTd, value);
                    }
                    else if (objFieldInfo.iFieldId == eVTFIELDID.FDF_LINK) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";

                        value = DataType.stringToObject(value);
                        if (value.lValue > 0 && value.data.length > 0) {
                            FUIElement.setText(eleTd, value.data[0].VoucherNo);
                        }
                    }
                    else if (objFieldInfo.iFieldId == eVTFIELDID.FDF_MAXQTYRELEASE) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";

                        value = DataType.stringToObject(value);
                        if (value.lValue > 0) {
                            FUIElement.setText(eleTd, value.data.Quantity);
                        }
                    }
                    else if (objFieldInfo.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                        value = RowData[iColCounter];
                        eleTd = document.createElement("td");
                        eleTd.style.paddingTop = "0px";
                        eleTd.style.paddingBottom = "0px";

                        value = DataType.stringToObject(value);
                        if (value.lValue > 0) {
                            FUIElement.setText(eleTd, value.data.Quantity);
                        }
                    }
                    else {
                        switch (objFieldInfo.iDataTypeId) {
                            case eMasterDataType.Text:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value);
                                break;
                            case eMasterDataType.Number:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value);
                                break;
                            case eMasterDataType.Boolean:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value == 0 ? "False" : "True");
                                break;
                            case eMasterDataType.Date:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                if (value != 0) {
                                    sText = FDate.getDayFromInt(value) + "-";
                                    sText += FDate.getMonthFromInt(value) + "-";
                                    sText += FDate.getYearFromInt(value);
                                    FUIElement.setText(eleTd, sText);
                                }
                                break;
                            case eMasterDataType.Time:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                if (value != 0) {
                                    sText = FTime.getHourFromFocusTime(value) + ":";
                                    sText += FTime.getMinuteFromFocusTime(value) + ":";
                                    sText += FTime.getSecondFromFocusTime(value);
                                    FUIElement.setText(eleTd, sText);
                                }
                                break;
                            case eMasterDataType.Fraction:
                                data = RowData[iColCounter];

                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                if ((objFieldInfo.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                                    value = DataType.stringToObject(data).data;
                                    if (DataType.isValidObject(value) == true) {
                                        dValue = FNumberOperation.toFixed(value.Input, objFieldInfo.iNoDecimal, true);
                                        dValue = DataType.addNumericSeparator(dValue);
                                        FUIElement.setText(eleTd, dValue);
                                    }
                                }
                                else {
                                    dValue = data;
                                    if ((objFieldInfo.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                                        dValue = FNumberOperation.toFixed(dValue, objFieldInfo.iNoDecimal, true);
                                    }
                                    dValue = FNumberOperation.toFixed(dValue, transEntrySettings.getDecimalsInAmount());
                                    dValue = DataType.addNumericSeparator(dValue);
                                    FUIElement.setText(eleTd, dValue);
                                }
                                break;
                            case eMasterDataType.StringList:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value);
                                break;
                            case eMasterDataType.NumberList:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, FCommon.UI.getNumberListText(objFieldInfo.sDefaultValue, value));
                                break;
                            case eMasterDataType.Master:
                                value = RowData[iColCounter];

                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value.Name);
                                break;
                            case eMasterDataType.BigNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.TinyNumber:
                                value = RowData[iColCounter];
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";

                                FUIElement.setText(eleTd, value);
                                break;
                            default:
                                eleTd = document.createElement("td");
                                eleTd.style.paddingTop = "0px";
                                eleTd.style.paddingBottom = "0px";
                                break;
                        }
                    }

                    if (eleTd != null) {
                        eleTr.appendChild(eleTd);
                    }
                }

                eleBody.appendChild(eleTr);
            }

            if (bBodyCreated == true) {
                eleGrid.appendChild(eleBody);
                document.getElementById("id_copydoc_grid2_container").appendChild(eleGrid);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.updateSecondGridBody} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    removeSecondGridRow: function (iHeaderId) {
        let iRow = 0;
