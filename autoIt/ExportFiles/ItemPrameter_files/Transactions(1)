    openPopup: function (arrData) {
        let iCounter = 0;
        let iIndex = 0;
        let dAmount = 0;
        let arrAccounts = [];
        let arrPostingDetails = [];
        let arrIds = [];
        let objIdNamePair = null;
        let obj = null;

        try {
            if (DataType.arrayLength(arrData) < 1) {
                return;
            }

            arrAccounts = [];
            arrIds = [];

            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                if (arrData[iCounter].Amounts[0] != 0) {
                    objIdNamePair = FocusDataStructs.getIdNamePairObject();
                    objIdNamePair.ID = arrData[iCounter].Code;
                    objIdNamePair.Tag = arrData[iCounter].Amounts[0];
                    arrAccounts.push(objIdNamePair);

                    if (DataType.arrayContains(arrIds, arrData[iCounter].Code) == -1) {
                        arrIds.push(arrData[iCounter].Code);
                    }
                }

                if (arrData[iCounter].Amounts[1] != 0) {
                    objIdNamePair = FocusDataStructs.getIdNamePairObject();
                    objIdNamePair.ID = arrData[iCounter].Book;
                    objIdNamePair.Tag = arrData[iCounter].Amounts[1];
                    arrAccounts.push(objIdNamePair);

                    if (DataType.arrayContains(arrIds, arrData[iCounter].Book) == -1) {
                        arrIds.push(arrData[iCounter].Book);
                    }
                }
            }

            arrPostingDetails = [];
            for (iCounter = 0; iCounter < arrIds.length; iCounter++) {
                dAmount = 0;
                for (iIndex = 0; iIndex < arrAccounts.length; iIndex++) {
                    if (arrIds[iCounter] == arrAccounts[iIndex].ID) {
                        dAmount = DataType.add(dAmount, arrAccounts[iIndex].Tag);
                    }
                }

                if (dAmount == 0) {
                    continue;
                }

                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = arrIds[iCounter];
                objIdNamePair.Tag = dAmount;
                arrPostingDetails.push(objIdNamePair);
            }

            obj = {};
            obj.arrPostDetails = arrPostingDetails;

            if (GlobalPref.Version == eVersion.Version10) {
                obj.bNumericSeparator = transEntryInfo.MiscellaneousPref.bNumericSeparator;
                obj.iNoofDecimals = GlobalPref.DefaultCurrency.NoofDecimals;
            }

            transEntryServer.execute(eTransServerRequest.GetPostingDetailsData, 
                                        obj, 
                                        true, 
                                        "EntryMainCallback.postingDetails");
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPostingDetails.openPopup} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
