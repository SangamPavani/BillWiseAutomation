                    if (iIndex == objDataInfo.arrIgnoreFields.length) {
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_QUANTITY_IN_BASE, objData.Value, iRowCounter);
                    }
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.Product) {
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.SetId) {
                    transEntryGrid.setRowData(iRowCounter, eRowDataName.SetId, objData.Value);
                    EntryMainMemoryObject.updateSetId(objData.Value, iRowCounter);
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.SetInfo) {
