    evaluateFormulaValue: function (sFormula, iRow, iColumn) {
        let iMasterType = 0;
        let arrVariables = [];
        let objFormula = null;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objVar = undefined;
        let value = undefined;

        try {
            value = COMMON.prototype.getEmptyResultObject();
            value.lValue = 0;
            value.sValue = "";
            value.data = "";

            objFormula = new FFormula();
            objFormula.m_CalType = transEntryInfo.CalendarType;

            iMasterType = FConvert.getMasterTypeIdFromVariable(sFormula);

            arrVariables = objFormula.GetVariables(sFormula, false);
            if (iMasterType > 0 || (DataType.arrayLength(arrVariables) == 1 && DataType.stringStartsWithRaw(arrVariables[0], "[") == false && DataType.stringStartsWithRaw(arrVariables[0], "]") == false)) {
                //sFormula = sFormula.replaceAll('(', '');
                //sFormula = sFormula.replaceAll(')', '');

                objVar = objFormula.getEmptyVariableParObject();
                objVar.Var = sFormula;

