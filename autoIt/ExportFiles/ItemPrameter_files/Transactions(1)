    keyPreview: function (obj, evt) {
        let sId = "";
        let iRow = 0;
        let iColumn = 0;
        let iNewColumn = 0;
        let iKeyCode = 0;
        let eleDiv = null;
        let objMetaData = null;

        try {
            iKeyCode = (evt.which || evt.keyCode);
            if (transEntryGlobal.debugKeyPreview == true
                && (evt.shiftKey == true || evt.altKey == true || evt.ctrlKey == true)
                && iKeyCode != 0 && iKeyCode != 16 && iKeyCode != 17 && iKeyCode != 18) {
                debugger
            }


            if (evt.ctrlKey == true && evt.keyCode == eKeyCode.D) {
                EntryMainBody.onDeleteRow(obj.iRow, evt);
                if (obj.iRow <= transEntryGrid.getTotalRows()) {
                    transEntryGrid.gotoCell(obj.iRow, 0);
                }
            }
            if (evt.ctrlKey == true && evt.keyCode == eKeyCode.I) {
                if (transEntryInfo.isStockAdjustment == false) {
                    iRow = EntryMainBody.onInsertRow(obj.iRow, evt);
                    transEntryGrid.gotoCell(iRow, 0);
                }
            }
            if (evt.ctrlKey == true && evt.keyCode == eKeyCode.Q) {
                objMetaData = EntryMainUI.getColumnFieldInfo(obj.iColumn).MetaData;
                if (obj.iRow > 0 && DataType.isValidObject(objMetaData) == true && objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT && EntryMainMemoryObject.getProductValue(obj.iRow) > 0) {
                    // Open Product Query Report
                    GLOBAL.openScreenInNewTab(GLOBAL.getContextPath("ProductQuery", "RD", "RD"),
                        {
                            iItemId: EntryMainMemoryObject.getProductValue(obj.iRow)
                        },
                        null,
                        false);
                }
            }
            else if (evt.ctrlKey == true && evt.keyCode == eKeyCode.R) { // Ctrl + Key.R
                EntryMainBody.processCtrlR(evt);
            }
            else if (evt.keyCode == eKeyCode.F4) { // Key.F4
                EntryMainBody.processAlternateItems(evt);
            }
            else if (evt.ctrlKey == true && evt.keyCode == eKeyCode.Up) { // Ctrl + Key.Up
                iRow = transEntryGrid.getCurrentRow();
                iColumn = transEntryGrid.getCurrentColumn();
                if (iRow > 1 && iColumn != -1) {
                    transEntryGrid.gotoCell(iRow - 1, iColumn - 1);
                }
            }
            else if (evt.ctrlKey == true && evt.keyCode == eKeyCode.Down) { // Ctrl + Key.Down
                iRow = transEntryGrid.getCurrentRow();
                iColumn = transEntryGrid.getCurrentColumn();
                if (iRow >= 1 && iColumn != -1
                    && (iRow + 1) <= transEntryGrid.getTotalRows()
                    && (EntryMainBody.isRowEditable(iRow + 1, true) == true || EntryMainBody.isColumnEditable(iRow + 1, iColumn) == true)) {
                    transEntryGrid.gotoCell(iRow + 1, iColumn - 1);
                }
            }
            else if (evt.ctrlKey == true && evt.keyCode == eKeyCode.Home) {
                iRow = transEntryGrid.getCurrentRow();
                iColumn = transEntryGrid.getCurrentColumn();
                iNewColumn = EntryMainBody.getFirstEditableColumn();
                if (iRow >= 1 && iColumn != -1 && iNewColumn > -1 && iNewColumn < iColumn) {
                    transEntryGrid.gotoCell(iRow, iNewColumn);
                }
            }
            else if (evt.ctrlKey == true && evt.keyCode == eKeyCode.End) {
                iRow = transEntryGrid.getCurrentRow();
                iColumn = transEntryGrid.getCurrentColumn();
                iNewColumn = EntryMainBody.getLastEditableColumn();
                if (iRow >= 1 && iColumn != -1 && iNewColumn > -1 && iNewColumn > iColumn) {
                    transEntryGrid.gotoCell(iRow, iNewColumn);
                }
            }

            if (EntryMainProductionProcess.keyPreview(obj, evt) == true) {
                return (true);
            }

            if (evt.keyCode != eKeyCode.CR && evt.keyCode != eKeyCode.Tab) {
                return (false);
            }

            // If tab is pressed and popup is opened.
            if (evt.keyCode == eKeyCode.Tab && (EntryMainUI.getOthersContainer().children.length > 0 || GLOBAL.isLoadingContinue() == true)) {
                return (true);
            }

            if (transEntryGlobal.Version == eVersion.Version10) {
            }
            else {
                eleDiv = document.getElementById("id_focus_msgbox_detail");
                if (DataType.isValidObject(eleDiv) == true) {
                    return (true);
                }
            }

            if (evt.keyCode == eKeyCode.CR && DataType.isValidObject(evt.target) == true && DataType.toString(evt.target.nodeName).toLowerCase() == "textarea") {
                if (FUIElement.isTextSelected(evt.target) == true) {
                    FUIElement.stopKeyProcess(evt);                   
                }

                return (true);
            }

            if (evt.keyCode == eKeyCode.CR && obj.iRow > 0 && obj.iColumn > 0) {
                objMetaData = EntryMainUI.getColumnFieldInfo(obj.iColumn).MetaData;
                if (DataType.isValidObject(objMetaData) == true && objMetaData.iDataTypeId == eMasterDataType.Master) {
                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    if (DataType.isValidObject(OPTIONCONTROL_SEARCH.PRIVATE.getPopupElement(sId)) == true) {
                        return (true);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body keyPreview method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.keyPreview} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

