    getFilter: function(objTrans, iRow, iFilter1, iFilter2) {
        let arrFilter = null;
        let objFilter = null;

        try {
            arrFilter = [];

            if(DataType.isValidObject(objTrans) == false) {
                return(arrFilter);
            }

            if (iFilter1 > 0 && DataType.arrayLength(objTrans.BodyData) > 0) {
                objFilter = FocusDataStructs.getReportFilterObject();
                objFilter.CompareWith = eCompareWith.Value;
                objFilter.Conjuction = eConjuction.Where
                objFilter.Operator = eOperator.EqualTo;
                objFilter.DataType = eMasterDataType.Master;
                objFilter.SubParentId = eVTFIELDFLAG.MASTER_HDR | iFilter1;
                //objFilter.FieldId = transEntryServer.getMasterNameFieldId(iFilter1); // Called on server
                objFilter.FieldId = iFilter1;

                if (iFilter1 != eMasterTypeId.Account) {
                    if(iFilter1 == transEntryInfo.FATag) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].FATag.toString();
                    }
                    else if (iFilter1 == transEntryInfo.InvTag) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].InvTag.toString();
                    }
                    else if (iFilter1 == eMasterTypeId.Product) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].Sales.Product.toString();
                    }
                    else {
                        objFilter.CompareValue = DataType.toString(EntryMainReport.getTagValue(objTrans.BodyData[iRow - 1].Tags, iFilter1));
                    }

                    arrFilter.push(objFilter);
                }
                else {
                    objFilter.CompareValue = objTrans.BodyData[iRow - 1].Book.toString();
                    objFilter.SubParentId = eVTFIELDID.FDF_BOOKNO;

                    arrFilter.push(objFilter);
                }
            }

            if (iFilter2 > 0 && iFilter2 != iFilter1 && DataType.arrayLength(objTrans.BodyData) > 0) {
                objFilter = FocusDataStructs.getReportFilterObject();
                objFilter.CompareWith = eCompareWith.Value;
                objFilter.Conjuction = arrFilter.length == 0 ? eConjuction.Where : eConjuction.And;
                objFilter.Operator = eOperator.EqualTo;
                objFilter.DataType = eMasterDataType.Master;
                objFilter.SubParentId = eVTFIELDFLAG.MASTER_HDR | iFilter2;
                //objFilter.FieldId = transEntryServer.getMasterNameFieldId(iFilter2); // Called on server
                objFilter.FieldId = iFilter2;

                if (iFilter2 != eMasterTypeId.Account) {
                    if(iFilter2 == transEntryInfo.FATag) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].FATag.toString();
                    }
                    else if (iFilter2 == transEntryInfo.InvTag) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].InvTag.toString();
                    }
                    else if (iFilter2 == eMasterTypeId.Product) {
                        objFilter.CompareValue = objTrans.BodyData[iRow - 1].Sales.Product.toString();
                    }
                    else {
                        objFilter.CompareValue = DataType.toString(EntryMainReport.getTagValue(objTrans.BodyData[iRow - 1].Tags, iFilter2));
                    }

                    arrFilter.push(objFilter);
                }
                else {
                    objFilter.CompareValue = objTrans.BodyData[iRow - 1].Book.toString();
                    objFilter.SubParentId = eVTFIELDID.FDF_BOOKNO;

                    arrFilter.push(objFilter);
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainReport.getFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrFilter);
    },

