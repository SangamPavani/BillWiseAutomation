    isRowEditable: function (iRow, bFromGrid) {
        let iCounter = 0;
        let arrFields = undefined;
        let objMetaData = null;
        let cell = null;

        try {
            if (transEntryInfo.isItSales == true) {
                if (transEntryFieldInfo.Item.FieldId > 0) {
                    if (EntryMainMemoryObject.getProductValue(iRow) <= 0) {
                        return (false);
                    }
                }
                else {
                    if (DataType.toBoolean(bFromGrid) == true) {
                        return (true);
                    }

                    arrFields = transEntryFieldInfo.getBodyFields();
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.bHidden == true || objMetaData.bReadOnly == true) {
                            continue;
                        }

                        if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                            continue;
                        }

                        cell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                        if (DataType.isValidObject(cell) == false) {
                            continue;
                        }

                        switch (objMetaData.iDataTypeId) {
                            case eMasterDataType.Text:
                                if (objMetaData.iBehaviour == 2) {
                                    if (DataType.toInt(cell.getCellData()) != 0) {
                                        return (true);
                                    }
                                }
                                else {
                                    if (DataType.isNullOrEmpty(cell.getCellText(), true) == false) {
                                        return (true);
                                    }
                                }
                                break;
                            case eMasterDataType.Number:
                            case eMasterDataType.TinyNumber:
                            case eMasterDataType.SmallNumber:
                            case eMasterDataType.BigNumber:
                                if (DataType.toInt(cell.getCellData()) != 0) {
                                    return (true);
                                }
                                break;
                            case eMasterDataType.Fraction:
                                if (DataType.toDecimal(cell.getCellData()) != 0) {
                                    return (true);
                                }
                                break;
                            case eMasterDataType.Master:
                            case eMasterDataType.ExternalTable:
                                if (DataType.toInt(cell.getCellData()) != 0) {
                                    return (true);
                                }
                                break;
                            case eMasterDataType.Date:
                            case eMasterDataType.Time:
                                if (DataType.toInt(cell.getCellData()) != 0) {
                                    return (true);
                                }
                                break;
                            case eMasterDataType.StringList:
                            case eMasterDataType.NumberList:
                                if (DataType.isNullOrEmpty(cell.getCellText(), true) == false) {
                                    return (true);
                                }
                                break;
                        }
                    }

                    return (false);
                }
            }
            else {
                if (transEntryFieldInfo.Code.FieldId == 0 || EntryMainMemoryObject.getCodeValue(iRow) <= 0) {
                    if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                        if (EntryMainMemoryObject.getBookValue(iRow) <= 0) {
                            return (false);
                        }
                    }
                    else {
                        return (false);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body isRowEditable method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.isRowEditable}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

