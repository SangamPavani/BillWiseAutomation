    FilterRefresh_Click: function () {
        var filtercontainer = document.getElementById("id_copydoc_filter_container");
        var filterbuttonsdiv = document.getElementById("id_copydoc_filter_buttonsrow");
        var grid1container = document.getElementById("id_copydocvoucher_grid_container");
        var grid1buttons = document.getElementById("id_copydoc_grid1_buttonsrow");
        var togglebutton = document.getElementById("id_transaction_entry_copydocument_filter_togglebutton");
        var result = null;
        COPYDOCUMENT.m_arrFilterColumnIndex = [];
        var iCounter = 0; var iCounter1 = 0;
        var arrAdvanceFilterQuery = [];//create array of object of type AdvanceFilterQuery
        var objAdvanceFilterQuery = {};
        var filterValues = null, currentRow = null;
        var filteredrows = [], arrTrs = [], arrFilteredHeaderIds = [];

        try {
            filterValues = FILTER.getFilterValue(CopyDocUI.m_iVoucherType, CopyDocUI.m_iMenuId);

            if (filterValues != null && filterValues.length > 0) {
                this.m_arrFilteredColumn = [];

                //step 1: getting the filtered index
                for (iCounter = 0; iCounter < filterValues.length; iCounter++) {
                    result = $.grep(COPYDOCUMENT.m_objReportMatrixData.Columns, function (x) {
                        return (x.ID == filterValues[iCounter].FieldId);
                    });
                    if (result != null && result.length > 0) {
                        COPYDOCUMENT.m_arrFilterColumnIndex.push(COPYDOCUMENT.m_objReportMatrixData.Columns.indexOf(result[0]));
                    }
                }
                //step 2: search the filtered value at filterd index column cells
                for (var rowcounter = 0; rowcounter < COPYDOCUMENT.m_objReportMatrixData.ColumnData.length; rowcounter++) {
                    currentRow = COPYDOCUMENT.m_objReportMatrixData.ColumnData[rowcounter];
                    for (iCounter = 0, iCounter1 = 0; iCounter < COPYDOCUMENT.m_arrFilterColumnIndex.length, iCounter1 < filterValues.length; iCounter++, iCounter1++) {
                        //here - apply operator 
                        switch (filterValues[iCounter1].Operator) {
                            case 0: //EqualTo
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] == filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break
                            case 1: //NotEqualTo 
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 2: //LessThan 
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] < filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 3: //GreaterThan  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] > filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 4: //LessThanOrEqualTo  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] <= filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 5: //GreaterThanOrEqualTo  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] >= filterValues[iCounter1].CompareValue) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 6: //IsBlank 
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] == "") {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 7: //IsNotBlank  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != "") {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                            case 8: //BeginWith  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != null && currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]].startsWith(filterValues[iCounter1].CompareValue) == true) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 9: //DoesNotBeginWith  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != null && currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]].startsWith(filterValues[iCounter1].CompareValue) == false) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 10: //Containing  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != null && currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]].includes(filterValues[iCounter1].CompareValue) == true) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 11: //NotContaining  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != null && currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]].includes(filterValues[iCounter1].CompareValue) == false) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                            case 12: //EndWith  
                                if (currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]] != null && currentRow.CellData[COPYDOCUMENT.m_arrFilterColumnIndex[iCounter]].endsWith(filterValues[iCounter1].CompareValue) == true) {
                                    arrFilteredHeaderIds.push(currentRow.CellData[0].Id);
                                }
                                break;
                        }
                    }
                }

                arrTrs = document.getElementById("copydoc_tblBodyTransRender").children;
                //step 3: get filtered rows
                for (var j = 0; j < arrFilteredHeaderIds.length; j++) {
                    filteredrows.push($.grep(arrTrs, function (x) {
                        return (x.getAttribute("data-dataid") == arrFilteredHeaderIds[j]);
                    })[0]);
                }
                //step 4:make display:none to all rows and display:"" to filtered rows
                $("#copydoc_tblBodyTransRender").children().css("display", "none");

                for (iCounter = 0; iCounter < filteredrows.length; iCounter++) {
                    filteredrows[iCounter].style.display = "";
                }
            }
            else {
                //show all rows 
                $("#copydoc_tblBodyTransRender").children().css("display", "");
            }
            //step 5: hide filter container , and show vouchers container
            //hide filter div and display grid 1 and toggle filter button
            filtercontainer.style.display = "none";
            filterbuttonsdiv.style.display = "none";

            grid1container.style.display = "block";
            grid1buttons.style.display = "block";

            togglebutton.setAttribute("data-isfiltershow", "false");
            $(togglebutton).addClass("icon-down-arrow").removeClass("icon-up-arrow");
        }
        catch (err) {
            transEntryGlobal.showAlert("{COPYDOCUMENT.FilterRefresh_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

