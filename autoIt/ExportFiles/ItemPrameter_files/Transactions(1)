    splitRowForBins: function (iRow, iColumn, arrBin, bBins2) {
        let sValue = "";
        let iCounter = 0;
        let iIndex = 0;
        let fConversion = 1;
        let dValue = 0;
        let dOrgBaseQuantity = 0;
        let dBaseQuantity = 0;
        let dRawOutput = 0;
        let arrRows = null;
        let arrFields = undefined;
        let objBinData = null;
        let arrOtherBinData = null;
        let objMetaData = null;
        let arrRecalculateScreenColumns = null;
        let objCell = null;

        try {
            arrRows = [];
            bBins2 = DataType.toBoolean(bBins2);

            if (bBins2 == true) {
                if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                    objBinData = null;
                    objCell = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.Bins.ColumnIndex);
                    result = DataType.stringToObject(objCell.getCellData());
                    if (result.lValue > 0) {
                        objBinData = result.data;
                    }

                    arrOtherBinData = null;
                    if (DataType.isValidObject(objBinData) == true) {
                        if (DataType.arrayLength(objBinData) < 1) { // Object
                            arrOtherBinData = [objBinData];
                        }
                        else { // Array
                            arrOtherBinData = objBinData;
                        }
                    }
                }
            }
            else {
                if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                    objBinData = null;
                    objCell = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.Bins2.ColumnIndex);
                    result = DataType.stringToObject(objCell.getCellData());
                    if (result.lValue > 0) {
                        objBinData = result.data;
                    }

                    arrOtherBinData = null;
                    if (DataType.isValidObject(objBinData) == true) {
                        if (DataType.arrayLength(objBinData) < 1) { // Object
                            arrOtherBinData = [objBinData];
                        }
                        else { // Array
                            arrOtherBinData = objBinData;
                        }
                    }
                }
            }

            arrRecalculateScreenColumns = [];
            if (arrBin.length > 1) {
                arrFields = transEntryFieldInfo.getScreenFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;

                    if (objMetaData.FormulaBehaviour == eTranEntryFormulaBehaviourBody.Value) {
                        objCell = transEntryGrid.getCellObject(iRow, arrFields[iCounter].ColumnIndex);
                        if (DataType.isValidObject(objCell) == true && DataType.toDecimal(objCell.getCellData()) != 0) {
                            arrRecalculateScreenColumns.push({
                                ScreenIndex: iCounter,
                                MetaDataIndex: arrFields[iCounter].MetaDataIndex,
                                ColumnIndex: arrFields[iCounter].ColumnIndex,
                                OrgValue: DataType.toDecimal(objCell.getCellData())
                            });
                        }
                    }
                }
            }

            dOrgBaseQuantity = 0;
            if (arrRecalculateScreenColumns.length > 0) {
                dOrgBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(iRow);
            }

            EntryMainUI.clear(transEntryFieldInfo.Reservation, iRow);
            for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                if (iCounter > 0) {
                    EntryMainBody.onDuplicateRow(iRow + (iCounter - 1), [eVTFIELDID.FDF_LINK, eVTFIELDID.FDF_BODYBATCHNO, eVTFIELDID.FDF_RESERVEQUANTITY]);
                }

                arrRows.push(iRow + iCounter);

                transEntryBins.setValue(iRow + iCounter, [arrBin[iCounter]], bBins2);
                EntryMain.m_bBinModified = true;

                if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                    dBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(iRow + iCounter, true);
                    if(DataType.neq(dBaseQuantity, arrBin[iCounter].Quantity) == true) {
                        fConversion = transEntryUnit.getConversionValue(iRow + iCounter);

                        dValue = FNumberOperation.div(arrBin[iCounter].Quantity, fConversion);
                        transEntryQuantity.setValue(dValue, iRow + iCounter, { bUpdateMemoryObject: true });
                    }
                }

                transEntryGross.calculateAndUpdate({ iRow: iRow + iCounter});

                if (bBins2 == true) {
                    if (transEntryFieldInfo.Bins.ColumnIndex > -1) {
                        if (DataType.arrayLength(arrOtherBinData) < 1) {
                            EntryMainUI.clear(transEntryFieldInfo.Bins, iRow + iCounter);
                        }
                        else if(iCounter < arrOtherBinData.length) {
                            arrOtherBinData[iCounter].Quantity = arrBin[iCounter].Quantity;
                            arrOtherBinData[iCounter].AllocTag = arrBin[iCounter].AllocTag;
                            transEntryBins.copyWMSInfo(arrOtherBinData[iCounter], arrBin[iCounter]);

                            transEntryBins.setValue(iRow + iCounter, [arrOtherBinData[iCounter]], false, true);
                            EntryMain.m_bBinModified = true;
                        }
                        else {
                            arrOtherBinData[arrOtherBinData.length - 1].Quantity = arrBin[iCounter].Quantity;
                            arrOtherBinData[arrOtherBinData.length - 1].AllocTag = arrBin[iCounter].AllocTag;
                            transEntryBins.copyWMSInfo(arrOtherBinData[arrOtherBinData.length - 1], arrBin[iCounter]);
                            transEntryBins.setValue(iRow + iCounter, [arrOtherBinData[arrOtherBinData.length - 1]], false, true);
                            EntryMain.m_bBinModified = true;
                        }
                    }
                }
                else {
                    if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                        if (DataType.arrayLength(arrOtherBinData) < 1) {
                            EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow + iCounter);
                        }
                        else if(iCounter < arrOtherBinData.length) {
                            arrOtherBinData[iCounter].Quantity = arrBin[iCounter].Quantity;
                            arrOtherBinData[iCounter].AllocTag = arrBin[iCounter].AllocTag;
                            transEntryBins.copyWMSInfo(arrOtherBinData[iCounter], arrBin[iCounter]);

                            transEntryBins.setValue(iRow + iCounter, [arrOtherBinData[iCounter]], true, true);
                            EntryMain.m_bBinModified = true;
                        }
                        else {
                            EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow + iCounter);
                        }
                    }
                }


                if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) {
                    transEntryBatch.updateQuantity(iRow + iCounter, arrBin[iCounter].Quantity, arrBin[iCounter].Quantity);
                }


                for (iIndex = 0; iIndex < transEntryGlobal.FieldHelper.Column.Links.length; iIndex++) {
                    objCell = transEntryGrid.getCellObject(iRow + iCounter, transEntryGlobal.FieldHelper.Column.Links[iIndex]);
                    if (DataType.isValidObject(objCell) == true && DataType.toInt(objCell.getCellData("linkfield")) == eTranEntryLinkValue.Quantity) {
                        objCell.setCellData("usedvalue", arrBin[iCounter].Quantity);
                    }
                }

                if (dOrgBaseQuantity > 0) {
                    for (iIndex = 0; iIndex < arrRecalculateScreenColumns.length; iIndex++) {
                        dBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(iRow + iCounter);
                        if (dBaseQuantity != 0) {
                            dValue = (arrRecalculateScreenColumns[iIndex].OrgValue * dBaseQuantity) / dOrgBaseQuantity;

                            objMetaData = transEntryGlobal.getBodyMetaDataObject(arrRecalculateScreenColumns[iIndex].MetaDataIndex);
                            dValue = FConvert.toDecimal(dValue, objMetaData.iNoDecimal, true);
                            sValue = FNumberOperation.toFixed(dValue, objMetaData.iNoDecimal);

                            objCell = transEntryGrid.getCellObject(iRow + iCounter, arrRecalculateScreenColumns[iIndex].ColumnIndex);
                            if (DataType.isValidObject(objCell) == true) {
                                objCell.setCellText(sValue, dValue);

                                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                                dRawOutput = dValue;
                                dValue = FConvert.toDecimal(dValue, objMetaData.iNoDecimal, true);
                                transEntryScreenData.setCellOutputValue(objCell, dValue, dRawOutput);
                            }
                        }
                    }
                }


                if (bBins2 == false) {
                    EntryMainBins.loadLotNoData(iRow + iCounter, arrBin[iCounter].LotNo);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.splitRowForBins} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrRows);
    },

