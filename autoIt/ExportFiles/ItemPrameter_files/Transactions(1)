                            // Reduce -ve
                            if (DataType.gt(dOrig1, 0) == true)
                            {
                                objTransaction.BodyData[0].OriginalAmounts[0] = DataType.add(objTransaction.BodyData[0].OriginalAmounts[0], dDiff);
