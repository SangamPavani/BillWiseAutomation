    updateUI: function () {
        try {
            var element = null;
            element = AdjustBills_Screen.UI.getAdjustmentGridElement();
            if (FCommon.UI.isValidObject(element)) {
                var grR = parseInt(AdjustBills_Screen.UI.getAdjustmentGridElement().getBoundingClientRect().right);
                var grL = parseInt(AdjustBills_Screen.UI.getAdjustmentGridElement().getBoundingClientRect().left);
                var grWidth = grR - grL;
                // alert(grWidth.toString());
                var iCounter = 0;
                var iVColumns = 0;
                for (iCounter = 2; iCounter < FGRIDCONTROL.getTotalColumns(AdjustBills_Screen.UI.getAdjustmentGridElement()) ; iCounter++) {
                    var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), 0, iCounter);
                    if (cell.bHidden == false) {
                        iVColumns++;
                    }
                }
                var ColWidth = grWidth / iVColumns;
                var arrColWidth = [];
                arrColWidth[0] = 50;
                arrColWidth[1] = 50;
                for (iCounter = 2; iCounter < FGRIDCONTROL.getTotalColumns(AdjustBills_Screen.UI.getAdjustmentGridElement()) ; iCounter++) {
                    var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), 0, iCounter);
                    if (cell.bHidden == true) {
                        arrColWidth[iCounter] = -1;
                    }
                    else {
                        arrColWidth[iCounter] = ColWidth;
                    }
                }
                FGRIDCONTROL.adjustColumnWidth(AdjustBills_Screen.UI.getAdjustmentGridElement(), arrColWidth);
            }
        }
        catch (Ex) {
            alert("Exception: updateUI " + Ex.message);
        }
    },

