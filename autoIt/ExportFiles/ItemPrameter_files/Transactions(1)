    getKeyValueFromMasterObject(objData, iFieldId) {
        let iCounter = 0;
        let bStorer = false;
        let arrData = [];
        let obj = undefined;

        if (objData != undefined && objData != null) {
            if (iFieldId == transEntryFieldInfo.AllocationTag.FieldId) {
                bStorer = true;
            }

            objData = DataType.arrayFromObject(objData);
            for (iCounter = 0; iCounter < objData.property.length; iCounter++) {
                if (objData.property[iCounter] == "Text") {
                    continue;
                }

                obj = {};
                obj.Key = objData.property[iCounter];
                obj.Value = objData.value[iCounter];

                if (bStorer == true && obj.Key == "iLPGenerationType") {
                    obj.Value = EntryMainUI.getLPGenerationText(obj.Value);
                }

                if (obj.Key != "Value") {
                    obj.Key = obj.Key.substr(1);
                }
                else if (iFieldId != undefined && iFieldId != null && iFieldId != 0) {
                    switch (iFieldId) {
                        case eVTFIELDID.FDF_CODE:
                        case eVTFIELDID.FDF_BODYCODE:
                        case eVTFIELDID.FDF_BOOKNO:
                        case eVTFIELDID.FDF_BODYBOOKNO:
                        case eVTFIELDID.FDF_HEADERINVTAG:
                        case eVTFIELDID.FDF_BODYINVTAG:
                            obj.Key = "MasterId";
                            break;
                        case eVTFIELDID.FDF_HEADERCURRENCY:
                        case eVTFIELDID.FDF_BODYCURRENCY:
                            obj.Key = "CurrencyId";
                            break;
                        default:
                            if (iFieldId == transEntryFieldInfo.FATag.FieldId) {
                                obj.Key = "MasterId";
                            }
                            else if (iFieldId == transEntryFieldInfo.InvTag.FieldId) {
                                obj.Key = "MasterId";
                            }
                            else if (iFieldId == transEntryFieldInfo.AllocationTag.FieldId) {
                                obj.Key = "MasterId";
                            }
                            break;
                    }
                }

                arrData.push(obj);
            }
        }

        return (arrData);
    }
