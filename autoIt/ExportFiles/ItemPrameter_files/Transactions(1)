    onMasterEnter: function (cellobj, iValue, objMetaData, bAutoSelectValue, evt) {
        let sId = "";
        let sExtraFilter = "";
        let sFilter = "";
        let iTagVal = 0;
        let iLPGenerationType = 0;
        let iLPMasterId = 0;
        let iLPTemplate = 0;
        let iLastParam = 0;
        let iTagType = 0;
        let iWarehouseId = 0;
        let bSetExtraFilter = false;
        let objGroup = undefined;
        let objPreload = undefined;
        let objUserData = undefined;
        let arrMasters = undefined;
        let arrFilter = undefined;
        let arrLPNSeries = undefined;
        let cell = undefined;
        let obj = undefined;

        try {
            if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                arrMasters = DataType.arrayFilterData(transEntryInfo.Settings.Documents.VoucherMasters, "MasterType", objMetaData.iMasterTypeId, "==");
                if (arrMasters.length > 0 && arrMasters[0].DependentMaster > 0) {
                    iTagVal = transEntryGrid.getMasterValue(cellobj.iRow, arrMasters[0].DependentMaster);
                    if (iTagVal > 0) {
                        EntryMainMaster.setExtraFilter(objMetaData.iMasterTypeId, iTagVal, arrMasters[0].FieldName, cellobj.ColumnAttribute.ctrlid);
                        bSetExtraFilter = true;
                    }
                    else {
                        OPTIONCONTROL.setExtraFilter(cellobj.ColumnAttribute.ctrlid, "");
                    }
                }
            }

            if (objMetaData.iFieldId != eVTFIELDID.FDF_LINK && objMetaData.iMasterTypeId > 0) {
                objGroup = transEntryGrid.getColumnFilterGroupId(cellobj.iRow, cellobj.iColumn);

                if (objGroup.bGroup == true) {
                    OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, objGroup.iGroupId);
                }
                else {
                    OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, 0);
                }
            }

            objPreload = EntryMainBody.checkDefaultAndPreloadForMasters(cellobj, objMetaData);

            objUserData = {};
            objUserData.iRow = cellobj.iRow;
            objUserData.iColumn = cellobj.iColumn;
            objUserData.iDate = EntryMain.m_objTrans.Header.Date;
            objUserData.iWarehouseId = EntryMainMemoryObject.getInvValue(cellobj.iRow);
            objUserData.iDepartmentId = EntryMainMemoryObject.getFAValue(cellobj.iRow);
            objUserData.iVoucherType = transEntryInfo.VoucherType;
            OPTIONCONTROL.setUserData(cellobj.ColumnAttribute.ctrlid, DataType.toString(objUserData));

            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                iLastParam = OPTIONCONTROL.getParam(cellobj.ColumnAttribute.ctrlid);
                iTagVal = transEntryInvTag.getValue(cellobj.iRow);
                OPTIONCONTROL.setParam(cellobj.ColumnAttribute.ctrlid, iTagVal);
                if (DataType.neq(iLastParam, iTagVal) == true) {
                    OPTIONCONTROL.clear(cellobj.ColumnAttribute.ctrlid);
                }

                iTagVal = EntryMain.m_objTrans.Header.Date;
                OPTIONCONTROL.setDate(cellobj.ColumnAttribute.ctrlid, iTagVal);

                if (transEntryInfo.ItemPreload > 0) {
                    OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, transEntryInfo.ItemPreload);
                    if (OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid) != transEntryInfo.ItemPreload) {
                        OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, transEntryInfo.ItemPreload);
                    }
                }
                else if (DataType.isNullOrEmpty(transEntryInfo.Settings.Documents.ProductFilterField) == false) {
                    iTagType = transEntryInfo.Settings.Documents.ProductFilterMaster;

                    if (DataType.stringEndsWith(transEntryInfo.Settings.Documents.ProductFilterField, "__") == true) {
                        iTagVal = transEntryGrid.getMasterValue(cellobj.iRow, iTagType);
                        EntryMainMaster.setExtraFilter(eMasterTypeId.Product, iTagVal, transEntryInfo.Settings.Documents.ProductFilterField, cellobj.ColumnAttribute.ctrlid);
                        bSetExtraFilter = true;
                    }
                }
                else if (transEntryInfo.ItemPreload != -2) {
                    OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, 0);
                    if (objGroup.iGroupId != 0 && objGroup.bGroup == true) {
                        OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, objGroup.iGroupId);
                    }
                }
            }
            else if (objMetaData.iFieldId == transEntryFieldInfo.LPMaster.FieldId) {
                if (transEntryGlobal.debugLPMaster == true) {
                    debugger
                }

                iLPGenerationType = EntryMainUI.getLPGenerationType(cellobj.iRow);
                sExtraFilter = " iLPGenerationType = " + iLPGenerationType;
                if (iLPGenerationType == 2 && transEntryFieldInfo.InvTag.FieldId > 0) { // Warehouse Wise LP Generation
                    iWarehouseId = 0;
                    if (transEntryFieldInfo.InvTag.FieldId > 0) {
                        iWarehouseId = EntryMainUI.getValue(transEntryFieldInfo.InvTag, cellobj.iRow);
                    }

                    sExtraFilter += " AND iWarehouse = " + iWarehouseId;
                }

                OPTIONCONTROL.setExtraFilter(cellobj.ColumnAttribute.ctrlid, sExtraFilter);
                bSetExtraFilter = true;

                iLPMasterId = transEntryGrid.getCellValue(cellobj, objMetaData);
                if (iLPMasterId > 0) {
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iLPMasterId);
                    iLPMasterId = transEntryGrid.getCellValue(cellobj, objMetaData);
                }

                //iLPMasterId = OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid);
                if (DataType.isBlankOrZero(iLPMasterId) == true && iValue == 0) {
                    iValue = EntryMainUI.getDefaultLPType(cellobj.iRow);
                }
            }

            if (EntryMainMaster.applyAccountOrItemFilter(objMetaData.iFieldId, cellobj.iRow) == true) {
                bSetExtraFilter = true;
            }

            arrFilter = EntryMainDependency.getTreeDependencyData(cellobj.iRow, objMetaData.iFieldId);
            if (arrFilter.length == 0) {
                arrFilter = EntryMainDependency.getTreeDependencyData(-1, objMetaData.iFieldId);
            }
            if (arrFilter.length > 0) {
                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                if (DataType.isNullOrEmpty(arrFilter[0].sFilter) == true) {
                    OPTIONCONTROL.setExtraFilter(sId, "");
                }
                else {
                    if (transEntryGlobal.m_bUseDependencyAsFilter == true || DataType.isInteger(arrFilter[0].sFilter) == false) {
                        OPTIONCONTROL.setExtraFilter(sId, "a.iMasterId in (" + arrFilter[0].sFilter + ")", false, true);
                        bSetExtraFilter = true;
                    }
                    else if (bAutoSelectValue == true || iValue == 0) {
                        iValue = DataType.toInt(arrFilter[0].sFilter);
                    }
                }
            }

            if (bSetExtraFilter == false) {
                OPTIONCONTROL.setExtraFilter(cellobj.ColumnAttribute.ctrlid, "");
            }

            if (iValue == 0 && objPreload.bGroup == false && objPreload.iPreloadValue > 0) {
                iValue = objPreload.iPreloadValue;
            }
            else if (iValue == 0 && objPreload.bGroup == false && objPreload.iPreloadValue == 0 && DataType.isValidObject(objGroup) == true && objGroup.bGroup == false && objGroup.iGroupId > 0) {
                iValue = objGroup.iGroupId;
            }

            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_BODYUNITS:
                    EntryMainMaster.onUnit_Enter(cellobj, objPreload.iPreloadValue, objMetaData, evt);
                    break;
                case eVTFIELDID.FDF_BODYCURRENCY:
                    if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == true && iValue == 0) {
                        iValue = transEntryInfo.DefaultCurrencyId;
                    }
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
                    break;
                case eVTFIELDID.FDF_SKID:
                    if (transEntryGlobal.debugLPN == true) {
                        debugger
                    }

                    iLPMasterId = 0;
                    if (transEntryFieldInfo.LPMaster.FieldId > 0) {
                        iLPMasterId = EntryMainUI.getValue(transEntryFieldInfo.LPMaster, cellobj.iRow);
                    }

                    if (iLPMasterId == 0) {
                        transEntryGlobal.showAlert("First select LP master.", GlobalPref.getResourceValue("Error"));

                        return (false);
                    }

                    iLPGenerationType = EntryMainUI.getLPGenerationType(cellobj.iRow);
                    if (iLPGenerationType == 4) { // (Manually Generate LP)
                        OPTIONCONTROL.setExactMatch(cellobj.ColumnAttribute.ctrlid, 0);
                    }
                    else {
                        OPTIONCONTROL.setExactMatch(cellobj.ColumnAttribute.ctrlid, 1);
                    }

                    sFilter = "iRefMasterId = " + iLPMasterId;
                    if (iLPGenerationType == 2) { // (Warehouse Wise LP Generation)
                        iWarehouseId = 0;
                        if (transEntryFieldInfo.InvTag.FieldId > 0) {
                            iWarehouseId = EntryMainUI.getValue(transEntryFieldInfo.InvTag, cellobj.iRow);
                        }

                        sFilter += " AND iWhId = " + iWarehouseId;
                    }


                    if (transEntryFields.getBodyId(cellobj.iRow) <= 0) {
                        sFilter += " AND bUsed = 0";
                        OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, sFilter);
                    }
                    else {
                        //OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "bUsed=0 OR iId = " + iValue);
                        OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, sFilter);
                    }

                    if (iValue == 0) {                        
                        if (iLPGenerationType == 3) { // (Generate LP On Receiving)
                            iLPTemplate = EntryMainUI.getLPTemplate(cellobj.iRow);
                            if (iLPTemplate > 0) {
                                arrLPNSeries = transEntryServer.getLPNSeries(iLPTemplate);
                                if (DataType.arrayLength(arrLPNSeries) == 0) {
                                    transEntryGlobal.showAlert("Error in loading LPN series.", GlobalPref.getResourceValue("Error"));
                                    return (false);
                                }

                                obj = transEntrySkid.generateFromSeries(cellobj.iRow, arrLPNSeries);
                                if (obj.ID <= 0) {
                                    if (DataType.isNullOrEmpty(obj.Name, true) == false) {
                                        transEntryGlobal.showAlert(obj.Name, GlobalPref.getResourceValue("Error"));
                                    }
                                    else {
                                        transEntryGlobal.showAlert("Some issue to generate LPN.", GlobalPref.getResourceValue("Error"));
                                    }

                                    return (false);
                                }

                                iValue = obj.ID;
                            }
                            else {
                                transEntryGlobal.showAlert("No template found to generate LPN.", GlobalPref.getResourceValue("Error"));
                                return (false);
                            }
                        }
                        else if (iLPGenerationType == 1 || iLPGenerationType == 4) { // (Default LP Generation) or (Manually Generate LP)
                            iValue = transEntrySkid.getSuggestedValue(cellobj.iRow, iLPMasterId);
                        }
                        //iValue = transEntrySkid.getSuggestedValue(cellobj.iRow);
                    }

                    OPTIONCONTROL.setExtraFilter(cellobj.ColumnAttribute.ctrlid, transEntrySkid.getFilter(cellobj.iRow));

                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
                    if (transEntryFields.getBodyId(cellobj.iRow) > 0) {
                        OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "bUsed = 0  AND iRefMasterId = " + iLPMasterId, true);
                    }
                    break;
                default:
                    if (iValue == 0 && objPreload.bGroup == false && objPreload.iPreloadValue > 0) {
                        cellobj.setControl(cellobj.ColumnAttribute.ctrlid, objPreload.iPreloadValue);
                    }
                    else {
                        if (iValue == 0
                            && transEntryInfo.isStockRevaluation == true
                            && cellobj.iRow > 1
                            && objMetaData.iFieldId == eVTFIELDID.FDF_BODYBOOKNO) {
                            cell = transEntryGrid.getCellObject(cellobj.iRow - 1, cellobj.iColumn, true);
                            if (DataType.isValidObject(cell) == true) {
                                iValue = DataType.toInt(cell.getCellData());
                            }
                        }

                        if (bSetExtraFilter == true) {
                            OPTIONCONTROL.clear(cellobj.ColumnAttribute.ctrlid);
                        }

                        cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
                    }

                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT && transEntrySettings.isInputProductByAttribute == true) {
                        obj = {};
                        obj.iRow = cellobj.iRow;
                        obj.iColumn = cellobj.iColumn;
                        obj.sControlId = cellobj.ColumnAttribute.ctrlid;
                        obj.iProductId = DataType.toInt(cellobj.getCellData());
                        obj.iDate = EntryMain.m_objTrans.Header.Date;
                        obj.iWarehouse = transEntryInvTag.getValue(cellobj.iRow);
                        obj.lTransactionId = transEntryFields.getTransactionId(cellobj.iRow);
                        obj.lBatchId = transEntryBatch.getBatchId(cellobj.iRow);


                        FAttributeEntry.getControl(iValue, DataType.toString(obj), OPTIONCONTROL.getFilter(cellobj.ColumnAttribute.ctrlid));
                    }
                    break;
            }

        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onMasterEnter method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onMasterEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onMasterLeave: function (cellobj, objMetaData) {
        let iLastValue = 0;
        let iCurrentValue = 0;
        let bResult = true;

        try {
            iLastValue = transEntryGrid.getCellValue(cellobj, objMetaData);

            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_BODYPRODUCT:
                    EntryMainMaster.onProduct_Leave(cellobj, objMetaData.iFieldId);
