    updateImage: function (iProductId) {
        let iLastId = 0;
        let iCounter = 0;
        let arrImgDashlet = null;
        let eleImg = null;
        let result = null;

        try {
            if (transEntryGlobal.Version != eVersion.Version10) {
                return;
            }

            arrImgDashlet = transEntryInfoSideBar.getImageDashlet();
            if (arrImgDashlet.length == 0) {
                return;
            }

            if (iProductId <= 0) {
                for (iCounter = 0; iCounter < arrImgDashlet.length; iCounter++) {
                    eleImg = arrImgDashlet[iCounter].children[0].children[0]; // eleImg has img tag.

                    eleImg.src = "";
                    FUIElement.setAttribute(eleImg, "productid", 0);
                }

                return;
            }

            eleImg = arrImgDashlet[0].children[0].children[0]; // eleImg has img tag.
            iLastId = DataType.toInt(FUIElement.getAttribute(eleImg, "productid"));
            if (iLastId == iProductId) {
                return;
            }

            result = transEntryServer.execute(eTransServerRequest.GetProductImage, { iProductId: iProductId });
            for (iCounter = 0; iCounter < arrImgDashlet.length; iCounter++) {
                eleImg = arrImgDashlet[iCounter].children[0].children[0]; // eleImg has img tag.

                eleImg.src = "";
                FUIElement.setAttribute(eleImg, "productid", iProductId);

                if (result.lValue > 0) {
                    result = result.data;
                    if (result.lValue > 0) {
                        eleImg.src = "data:image/png;base64," + result.data;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainUI.updateImage} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getCustomerRow: function (iCustomerId, iStartRow, objTempTransactionData) {
        let iRow = 0;
        let iMasterId = 0;
        let result = null;
        let objFlags = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = 0;
            result.Area = eTranEntryFieldArea.None;

            iStartRow = DataType.toInt(iStartRow);

            if (iStartRow < objTempTransactionData.Body.length) {
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                    switch (transEntryFieldInfo.SubLedger.Area)
                    {
                    case eTranEntryFieldArea.None:
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_CODE);
                        break;
                    case eTranEntryFieldArea.Header:
                        sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.SubLedger.FieldId);
                        break;
                    default:
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_CODE);
                        break;
                    }

                    iMasterId = DataType.toInt(objTempTransactionData.Header[sId]);
                    if (iMasterId == iCustomerId) {
                        result.lValue = 1;
                        result.data = 0;
                        result.Area = eTranEntryFieldArea.Header;

                        return (result);
                    }
                }

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    switch (transEntryFieldInfo.SubLedger.Area)
                    {
                    case eTranEntryFieldArea.None:
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BOOKNO);
                        break;
                    case eTranEntryFieldArea.Header:
                        sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.SubLedger.FieldId);
                        break;
                    default:
                        sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BOOKNO);
                        break;
                    }

                    iMasterId = DataType.toInt(objTempTransactionData.Header[sId]);
                    if (iMasterId == iCustomerId) {
                        result.lValue = 1;
                        result.data = 0;
                        result.Area = eTranEntryFieldArea.Header;

                        return (result);
                    }
                }
            }

            for (iRow = iStartRow; iRow < objTempTransactionData.Body.length; iRow++) {
                objFlags = DataType.stringToObject(objTempTransactionData.Body[iRow].Flags);
                if (objFlags.lValue > 0) {
                    objFlags = objFlags.data;
                }
                else {
                    objFlags = transactionDataStructure.getBodyFlagsObject();
                }
                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                    if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Body) {
                        sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.SubLedger.FieldId);
                    }
                    else {
                        sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYCODE);
                    }

                    iMasterId = DataType.toInt(objTempTransactionData.Body[iRow][sId]);
                    if (iMasterId == iCustomerId && (objTempTransactionData.Body[iRow].BodyId == 0 || (objTempTransactionData.Body[iRow].BodyId > 0 && objFlags.PDC == false))) {
                        result.lValue = 1;
                        result.data = iRow;
                        result.Area = eTranEntryFieldArea.Body;

                        break;
                    }
                }

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                    if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Body) {
                        sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.SubLedger.FieldId);
                    }
                    else {
                        sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYBOOKNO);
                    }

                    iMasterId = DataType.toInt(objTempTransactionData.Body[iRow][sId]);
                    if (iMasterId == iCustomerId && (objTempTransactionData.Body[iRow].BodyId == 0 || (objTempTransactionData.Body[iRow].BodyId > 0 && objFlags.PDC == false))) {
                        result.lValue = 1;
                        result.data = iRow;
                        result.Area = eTranEntryFieldArea.Body;

                        break;
                    }
                }
            }
        }
