    setEmaildata: function () {
        ////debugger
        if (document.getElementById("id_To").value == "") {
            COMMON.prototype.showMessage("Please Provide To EmailId", "");
            return;
        }
        objEmailOption = {};
        objEmailOption.To = document.getElementById("id_To").value;
        objEmailOption.Cc = document.getElementById("id_Cc").value.split(";");
        objEmailOption.Bcc = document.getElementById("id_Bcc").value.split(";");
        if (objEmailOption.Bcc != "") {
            var strbcc = [];
            for (var i = 0; i < objEmailOption.Bcc.length; i++) {
                strbcc.push(objEmailOption.Bcc[i].trim());
            }
            objEmailOption.Bcc = strbcc;
        }
        objEmailOption.Subject = document.getElementById("id_Subject").value;
        if (document.getElementById("spnFilePath").value != "") {
            objEmailOption.Body = document.getElementById("spnFilePath").value;
        }
        var t = document.getElementById("idSelect");
        var selectedText = "";
        if (t.children.length > 0) {
            selectedText = t.options[t.selectedIndex].text;
            objEmailOption.password = t.options[t.selectedIndex].value;
        }

        objEmailOption.from = selectedText;

        if (objEmailOption.To != "")
            document.getElementById("id_EmailTo").value = objEmailOption.To;
        if (objEmailOption.Cc != "")
            document.getElementById("id_EmailCC").value = objEmailOption.Cc;
        document.getElementById("id_EmailSubject").value = objEmailOption.Subject;
        if (window.FormData !== undefined) {
            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < m_arrATtachedfiles.length; i++) {
                fileData.append(m_arrATtachedfiles[i].name, m_arrATtachedfiles[i]);
            }

            // Adding one more key to FormData object
            fileData.append('username', 'postvoucher');
        }
        GLOBAL.LoadingStart();
        var Url = GLOBAL.getContextPath("GetFullPath", "TransHome", "Transactions");
        $.ajax({
            url: Url,
            type: "POST",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: fileData,
            success: function (result) {
                ;
                if (result.length > 0) {
                    arrAttachment = [];
                    for (var i = 0; i < result.length; i++) {
                        arrAttachment.push({ Attachment: "", AttachmentName: result[i] });
                    }
                    objEmailOption.MailAttachments = arrAttachment;
                }
                $("#id_transaction_Emailprint").modal('hide');
                GLOBAL.LoadingEnd();
            },
            error: function (err) {
                // alert(err.statusText);
            }
        });
        m_arrATtachedfiles = [];

    },
