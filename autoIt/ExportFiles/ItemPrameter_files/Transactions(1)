Click_PICKFIFO:  function (evt) {
    try {
        GLOBAL.LoadingStart();
        //debugger
        var GridTotalRows = FGRIDCONTROL.getTotalRows(MRP_BATCH.GetBatchGridName());
        if (GridTotalRows!= MRP_BATCH.arrIssuingList.length) {
            //if (parseFloat(document.getElementById('lblAdjustQty').innerText.replace(',','')) > 0) {
            MRP_BATCH.UnselectFromGrid();
            MRP_BATCH.DataCheckingOnFifoWithSearch();
        } else {
            MRP_BATCH.UnselectFromGrid();
            FGRIDCONTROL.update(MRP_BATCH.GetBatchGridName(), evt);
            //document.getElementById('lblAdjustQty').innerText = 0;
            var TotalAmt = FConvert.toDecimal(document.getElementById('lblTotalQty').innerText, MRP_BATCH.iNoofDecimalQty);
            document.getElementById('lblBalnceQty').innerText = TotalAmt;
            var AdjustedAmt = parseFloat(0);
            var BalanceAmt = parseFloat(TotalAmt);
            var bToBreak = false;
            
            for (var irow = 0; irow < GridTotalRows; irow++) {
                var i = irow;
                //for (var i = 0; i < MRP_BATCH.OBJLIST.length; i++) {

                var CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iBatchIdCol + 1);
                var iBatch = CellObj.getCellData()
                if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] != iBatch) {
                    continue;
                }

                CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, 2);
                if (CellObj.sText.trim() == "") {
                    COMMON.prototype.showMessage("No Batch Data To Pick ", "BATCHES");
                    break;
                }

                //if(irow == 0 || (irow % 50) == 0) {
                //    await MRP_BATCH.sleep(1);
                //}

                    
                CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.iAdjustedColumn + 1);
                var dValue = 0;
                if (parseFloat(MRP_BATCH.OBJLIST[i][1]) < BalanceAmt) {
                    dValue = parseFloat(MRP_BATCH.OBJLIST[i][1]).toFixed(MRP_BATCH.iNoofDecimalQty);
                } else if (parseFloat(MRP_BATCH.OBJLIST[i][1]) >= BalanceAmt) {
                    dValue = BalanceAmt.toFixed(MRP_BATCH.iNoofDecimalQty);
                    bToBreak = true;
                }
                CellObj.setCellData("value", dValue);
                CellObj.setCellText(FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty));
                MRP_BATCH.arrIssuingList[i] = parseFloat(dValue).toFixed(MRP_BATCH.iNoofDecimalQty);
                MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iAdjustedCol] = dValue;
                BalanceAmt = BalanceAmt - dValue;
                BalanceAmt = parseFloat(FConvert.toDecimal(BalanceAmt, MRP_BATCH.iNoofDecimalQty));
                document.getElementById('lblBalnceQty').innerText = BalanceAmt.toFixed(MRP_BATCH.iNoofDecimalQty);
                document.getElementById('lblAdjustQty').innerText = (TotalAmt - BalanceAmt).toFixed(MRP_BATCH.iNoofDecimalQty);
                document.getElementById('lblAdjSum').innerText = (TotalAmt - BalanceAmt).toFixed(MRP_BATCH.iNoofDecimalQty);
                if (bToBreak)
                    break;
                //}
                //if (bToBreak)
                //    break;
            }
        }
    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.Click_PICKFIFO} " + e.message, "Error Message");
    }

    GLOBAL.LoadingEnd();
},
