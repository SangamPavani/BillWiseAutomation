    AssignAdjustmentValues: function () {
        // //debugger
        var iCounter = 0;
        var mAAIDBaseCurrency = 0;
        var mNativeCurrency = 0;
        var _objAdj = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails;
        try {
            for (iCounter = 0; iCounter < _objAdj.m_lstPendingBills.length; iCounter++) {
                mAAIDBaseCurrency = FNumberOperation.add(mAAIDBaseCurrency, _objAdj.m_lstPendingBills[iCounter].mAAIDBaseCurrency);
                mNativeCurrency = FNumberOperation.add(mNativeCurrency, _objAdj.m_lstPendingBills[iCounter].mNativeCurrency);
            }

            AdjustBills_Screen.Footer.SetAdjustedAmt(FNumberOperation.toFixed(FNumberOperation.add(FNumberOperation.add(FNumberOperation.add(mAAIDBaseCurrency, _objAdj.m_NewRef), _objAdj.m_OnAccount), _objAdj.m_dMisAdjAmount), _objAdj.m_DefaultCurrency.NoofDecimals));
            _objAdj.dFooterAmtAdjustedInBaseCurr = AdjustBills_Screen.Footer.GetAdjustedAmt();
            AdjustBills_Screen.Footer.SetAmtTobeAdjust(FNumberOperation.toFixed(FNumberOperation.sub(_objAdj.dAmtToBeAdjInBaseCurr, AdjustBills_Screen.Footer.GetAdjustedAmt()), _objAdj.m_DefaultCurrency.NoofDecimals));
            _objAdj.dFooterAmtToBeAdjInBaseCurr = FNumberOperation.sub(_objAdj.dAmtToBeAdjInBaseCurr, _objAdj.dFooterAmtAdjustedInBaseCurr);

            if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                if (_objAdj.bMaintainInInvoiceCurrency) {
                    _objAdj.dFooterAmtAdjustedInTransCurr = FNumberOperation.toFixed(FConvert.roundOff(FNumberOperation.add(FNumberOperation.add(FNumberOperation.add(mNativeCurrency, _objAdj.m_NewRefTransCurr), _objAdj.m_OnAccountTransCurr), _objAdj.m_dMisAdjAmountTranCurr), _objAdj.m_TransactionCurrency.GeneralRoundOff, _objAdj.m_TransactionCurrency.RoundingType), _objAdj.m_TransactionCurrency.NoofDecimals);
                    AdjustBills_Screen.Footer.SetAdjustedAmt(FNumberOperation.toFixed(_objAdj.dFooterAmtAdjustedInTransCurr, _objAdj.m_TransactionCurrency.NoofDecimals));
                    _objAdj.dFooterAmtToBeAdjInTransCurr = FNumberOperation.toFixed(FConvert.roundOff(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, _objAdj.dFooterAmtAdjustedInTransCurr), _objAdj.m_TransactionCurrency.GeneralRoundOff, _objAdj.m_TransactionCurrency.RoundingType), _objAdj.m_TransactionCurrency.NoofDecimals);
                    AdjustBills_Screen.Footer.SetAmtTobeAdjust(FNumberOperation.toFixed(_objAdj.dFooterAmtToBeAdjInTransCurr, _objAdj.m_TransactionCurrency.NoofDecimals));
                    _objAdj.dFooterAmtAdjustedInBaseCurr = FNumberOperation.add(FNumberOperation.add(FNumberOperation.add(mAAIDBaseCurrency, _objAdj.m_NewRef), _objAdj.m_OnAccount), _objAdj.m_dMisAdjAmount);
                }
                else {
                    if (FCommon.UI.isValidObject(_objAdj.m_objBillFilter) == false) {
                        _objAdj.dFooterAmtAdjustedInTransCurr = FNumberOperation.toFixed(FConvert.roundOff(FNumberOperation.add(FNumberOperation.add(mAAIDBaseCurrency, _objAdj.m_NewRef), _objAdj.m_OnAccount), _objAdj.m_TransactionCurrency.GeneralRoundOff, _objAdj.m_TransactionCurrency.RoundingType), _objAdj.m_TransactionCurrency.NoofDecimals);
                    }
                    else {
                        _objAdj.dFooterAmtAdjustedInTransCurr = FNumberOperation.toFixed(FConvert.roundOff(FNumberOperation.add(mAAIDBaseCurrency, FNumberOperation.add(_objAdj.m_NewRef, FNumberOperation.add(_objAdj.m_OnAccount, FNumberOperation.div(_objAdj.m_dMisAdjAmount, _objAdj.m_objBillFilter.dRate)))), _objAdj.m_TransactionCurrency.GeneralRoundOff, _objAdj.m_TransactionCurrency.RoundingType), _objAdj.m_TransactionCurrency.NoofDecimals);
                    }
                    _objAdj.dFooterAmtAdjustedInBaseCurr = FNumberOperation.add(FNumberOperation.add(FNumberOperation.add(mAAIDBaseCurrency, _objAdj.m_NewRef), _objAdj.m_OnAccount), _objAdj.m_dMisAdjAmount);
                    AdjustBills_Screen.Footer.SetAdjustedAmt(FNumberOperation.toFixed(_objAdj.dFooterAmtAdjustedInBaseCurr, _objAdj.m_DefaultCurrency.NoofDecimals));
                }
            }
            else {
                if (_objAdj.bMaintainInInvoiceCurrency) {
