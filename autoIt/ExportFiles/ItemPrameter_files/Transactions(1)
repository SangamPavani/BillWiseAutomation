    onDocumentDate_Change: function (id, date, bVoucherLoading, bReloadAllRateCalled) {
        let sId = "";
        let iNewDate = 0;
        let iMaskedVoucher = 0;
        let iLinkDate = 0;
        let iBookNo = 0;
        let objFlags = undefined;

        try {
            bVoucherLoading = DataType.toBoolean(bVoucherLoading);

            iLinkDate = transEntryLinks.getDate();
            if (iLinkDate > 0 && date < iLinkDate) {
                DATEPICKER.setDate(id, iLinkDate);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, iLinkDate);

                EntryMainUI.valueChanged(transEntryFieldInfo.Date.MetaData, 0, 0);

                if (transEntryInfo.Settings.Misc.PostVAT == true) {
                    transEntryVat.getVATPercent(0);
                }

                return;
            }

            iMaskedVoucher = transEntryInfo.BaseVoucherType;
            if (iMaskedVoucher == eVTTYPE.IOPBA || iMaskedVoucher == eVTTYPE.OPBAL) {
                if (date >= EntryMain.m_iAccountingDate) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgOpDate"), GlobalPref.getResourceValue("Warning"));

                    iNewDate = transEntryDate.getNewDate();
                    DATEPICKER.setDate(id, iNewDate);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, iNewDate);
                }
            }
            else if (date < EntryMain.m_iAccountingDate
                && EntryMainValidate.canDocumentDateBeLessThanAccountingDate(iMaskedVoucher) == false) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDateLessAccDate"), GlobalPref.getResourceValue("Warning"));
                DATEPICKER.setDate(id, EntryMain.m_iAccountingDate);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, EntryMain.m_iAccountingDate);

                if (transEntryInfo.Settings.Misc.PostVAT == true) {
                    transEntryVat.getVATPercent(0);
                }

                EntryMainUI.resetCurrencyFilter();
                EntryMainUI.resetLCFilter();
                EntryMainInfoSidebar.loadDashboard(0);

                return (false);
            }
            else {
                EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, date, 0);
                if (bVoucherLoading == false
                    && transEntryInfo.HeaderId > 0
                    && transEntryInfo.isItSales == true) {

                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.CheckNegativeStock = true;
                    transEntryInfo.HeaderFlags = objFlags;
                }
            }

            if (bVoucherLoading == false) {
                EntryMainUI.valueChanged(transEntryFieldInfo.Date.MetaData, 0, 0);
            }

            if (transEntryInfo.Settings.Misc.PostVAT == true) {
                transEntryVat.getVATPercent(0);
            }

            if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_BOOKNO);
                iBookNo = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                if (EntryMainCalculation.checkOverDue(iBookNo, EntryMain.m_objTrans.BodyData[0].FATag) == false) {
                    OPTIONCONTROL.setValue(sId, 0);
                }
            }

            if (bVoucherLoading == false) {
                EntryMainUI.resetCurrencyFilter();
            }
            else {
                EntryMainUI.resetCurrencyFilter(true);
            }

            if (transEntryInfo.isItSales == true
                && transEntryFieldInfo.Currency.Area != eTranEntryFieldArea.Header
                && DataType.toBoolean(bReloadAllRateCalled) == false) {

                EntryMainBody.confrimAndReloadAllRowsRate(0, 0);
            }

            EntryMainUI.resetLCFilter();
            transEntryDueDate.calculateAndUpdate(EntryMain.m_iDueDateType, EntryMain.m_iDueDateValue);

            if(DataType.arrayFilterDataIndex(transEntryInfo.Settings.VoucherSeries, "Type", eVTFIELDID.FDF_DATE, "==").length > 0) {
                EntryMainHeader.setNewVoucherNo(true, 0);
            }

            EntryMainBatch.onDocumentDate_Change();

            if(bVoucherLoading == false) {
                EntryMain.setDirty();
            }
            else {
                DATEPICKER.setFocusValue(id, date);
            }

            if (transEntryInfo.BodySectionNotRequired == true) {
                TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
            }

            EntryMainInfoSidebar.loadDashboard(0, bVoucherLoading);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onDocumentDate_Change} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onDocumentDate_KillFocus: function (ele, evt) {
        EntryMainBatch.validateBatchExpiryDate();
    },

    onDate_Change: function (id, date, obj) {
        let iFieldId = 0;
        let bDateChange = false;
        let bReloadAllRateCalled = false;
        let bResult = false;
        let objResult = undefined;

        try {
            if (transEntryGlobal.Version != eVersion.Version10) {
                TRANSACTION_ENTRY.WORKFLOW.updateWorkflowPanel(false);
            }

            bDateChange = false;
            if (DataType.isValidObject(obj) == true && obj.iLastDate != obj.iDate) {
                bDateChange = true;
            }


            iFieldId = EntryMainUI.extractHeaderFieldId(id.id);
            if (iFieldId == eVTFIELDID.FDF_DATE) {
                objResult = EntryMainUI.isLinkRestrictd(0, iFieldId, true, obj.iDate);
                if (objResult.Value == true) {
                    DATEPICKER.setDate(id, obj.iLastDate);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, obj.iLastDate);

                    if (objResult.Message != "") {
                        transEntryGlobal.showAlert(objResult.Message, GlobalPref.getResourceValue("Warning"));
                    }
                    else {
                        transEntryGlobal.showAlert("This document is already used in link voucher. Due to this date cannot be changed.", GlobalPref.getResourceValue("Warning"));
                    }                    

                    return (false);
                }

                // Check for links
                if (bDateChange == true && EntryMainWorkflow.checkForDateChange(obj.iDate) == false) {
                    DATEPICKER.setDate(id, obj.iLastDate);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, obj.iLastDate);

                    return (false);
                }

                if (transEntryInfo.isStockRevaluation == true && bDateChange == true) {
                    if (EntryMainBody.getEditableRowsIndex(true).length > 0 && transEntryGlobal.confirmMessage("Change value will cause reset value of some body columns. Are you sure you want to continue?") == false) {
                        DATEPICKER.setDate(id, obj.iLastDate);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, obj.iLastDate);

                        return (false);
                    }

                    EntryMainUI.resetBodyColumns(-1, [transEntryFieldInfo.BatchNo.ColumnIndex, transEntryFieldInfo.BalanceQty.ColumnIndex, transEntryFieldInfo.AvgRate.ColumnIndex, transEntryFieldInfo.BalanceStockValue.ColumnIndex, transEntryFieldInfo.NewAvgRate.ColumnIndex, transEntryFieldInfo.NewStockValue.ColumnIndex]);
                }

                if (DataType.isValidObject(obj) == false || obj.iLastDate != obj.iDate) {
                    if (transEntryInfo.isItSales == true && bDateChange == true) {
                        bResult = EntryMainBody.confrimAndReloadAllRowsRate(iFieldId, obj.iLastDate, eMasterDataType.Date);
                        if (bResult == false) {
                            return (false);
                        }

                        bReloadAllRateCalled = true;
                    }

                    EntryMainHeader.onDocumentDate_Change(id, date, false, bReloadAllRateCalled);
                    EntryMainScheme.removeScheme();
                    EntryMainScheme.applyScheme(0);

                    if (transEntryFieldInfo.Billwise.FieldId > 0) {
                        EntryMainBillwise.makeRowDirty(0);
                    }
                }
            }
            else if (iFieldId == eVTFIELDID.FDF_DUEDATE) {
                if (bDateChange == true) {
                    transEntryDueDate.onChange(0);

                    EntryMainMemoryObject.update(eVTFIELDID.FDF_DUEDATE, obj.iDate, 0);
                }
            }
            else if (transEntryFieldInfo.LRDate.Area == eTranEntryFieldArea.Header
                && transEntryFieldInfo.LRDate.FieldId == iFieldId) {
                transEntryDueDate.calculateAndUpdate(EntryMain.m_iDueDateType, EntryMain.m_iDueDateValue);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onDate_Change} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(true);
    },

    // Sets header field default value using header metadata
    setHeaderFieldsDefaultValue: function (bLoadVoucher, bDoNotSetDefaultValue, bFromLinkDataResult) {
        let sId = "";
        let sFilter = "";
        let sGroups = "";
        let sDefaultValue = "";
        let iCounter = 0;
        let iIndex = 0;
        let value = 0;
        let iBookTypeId = 0;
        let iMaskedVoucherType = 0;
        let iDefaultCurrency = 0;
        let bDefaultBook = false;
        let bIgnoreChangeCallback = false;
        let bSetDefaultTagValue = false;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let eleControl = null;
        let objMetaData = null;
        let objTemp = undefined;
        let objTag = undefined;
        let arrTemp = null;
        let objWatch = null;

        try {
            bLoadVoucher = DataType.toBoolean(bLoadVoucher);
            bDoNotSetDefaultValue = DataType.toBoolean(bDoNotSetDefaultValue);
            bFromLinkDataResult = DataType.toBoolean(bFromLinkDataResult);

            objWatch = new FStopWatch();
            objWatch.start();

            NETWORK.enableLog(false);
            OPTIONCONTROL.enableLog(false);
            
            if (transEntryGlobal.m_bDoNotSetDefault == false) {
                bDoNotSetDefaultValue = false;
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if (EntryMainMaster.isInfoField(objMetaData.iFieldId, true) == true) {
                    continue;
                }

                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                eleControl = document.getElementById(sId);
                if (DataType.isValidObject(eleControl) == false) {
                    continue;
                }

                if (EntryMainDependency.isHeaderToHeaderDependencyField(objMetaData.iFieldId) == true) {
                    continue;
                }

                value = 0;
                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Boolean:
                        eleControl.checked = DataType.toBoolean(objMetaData.sDefaultValue);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.checked, 0, objMetaData);
                        break;
                    case eMasterDataType.Date:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            DATEPICKER.clear(sId);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            break;
                        }

                        if (EntryMainCommon.isFormula(objMetaData.sDefaultValue) == true) {
                            if (bLoadVoucher == false) {
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(EntryMainCommon.extractFormula(objMetaData.sDefaultValue), 0, 0, 0, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                value = DataType.toInt(objFormulaOutput.Value);
                            }
                        }
                        else {
                            if (DATEPICKER.isDoNotSelectDefaultDate(sId) == false) {
                                value = transEntryDate.getNewDate();
                            }
                        }
                        DATEPICKER.setDate(sId, value);
                        value = DATEPICKER.getDate(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                        break;
                    case eMasterDataType.Time:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            FTIMECONTROL.clear(eleControl, true);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            break;
                        }

                        if (EntryMainCommon.isFormula(objMetaData.sDefaultValue) == true) {
                            if (bLoadVoucher == false) {
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(EntryMainCommon.extractFormula(objMetaData.sDefaultValue), 0, 0, 0, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                value = DataType.toInt(objFormulaOutput.Value);
                                FTIMECONTROL.setTime(eleControl, value);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                            }
                        }
                        else {
                            FTIMECONTROL.clear(eleControl, true);
                        }
                        break;
                    case eMasterDataType.NumberList:
                        eleControl.selectedIndex = 0;
                        if (EntryMain.isDataLoading() == false
                            && (iMaskedVoucherType == eVTTYPE.WMSRTS || iMaskedVoucherType == eVTTYPE.WMSASN)) {
                            if (objMetaData.sFieldName.toLowerCase() == "receipttype") {
                                eleControl.selectedIndex = transEntryInfo.WMSPref.iDefaultReceiptMethod;
                            }
                        }

                        if (bLoadVoucher == false && DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, 0, 0, 0, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            value = DataType.toInt(objFormulaOutput.Value);
                            eleControl.selectedIndex = value;
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.value, 0, objMetaData);
                        break;
                    case eMasterDataType.StringList:                        
                        eleControl.selectedIndex = 0;
                        if (bLoadVoucher == false && DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, 0, 0, 0, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            value = DataType.toInt(objFormulaOutput.Value);
                            eleControl.selectedIndex = value;
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.options[eleControl.selectedIndex].text, 0, objMetaData);
                        break;
                    case eMasterDataType.Master:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            OPTIONCONTROL.clear(sId);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            break;
                        }

                        sDefaultValue = objMetaData.sDefaultValue;
                        bSetDefaultTagValue = false;

                        // For Dependency evaluation
                        for (iIndex = 0; iIndex < transEntryGlobal.FieldHelper.arrDependentMaster.length; iIndex++) {
                            if (transEntryGlobal.FieldHelper.arrDependentMaster[iIndex].SourceFieldId != objMetaData.iFieldId) {
                                continue;
                            }

                            if (DataType.isNullOrEmpty(sDefaultValue, true) == false) {
                                bSetDefaultTagValue = true;
                            }
                            break;
                        }

                        if (transEntryGlobal.EntryModel.iDefaultFATagValue > 0 && transEntryFieldInfo.FATag.FieldId == objMetaData.iFieldId) {
                            if (DataType.isNullOrEmpty(sDefaultValue, true) == true) {
                                sDefaultValue = "#" + transEntryGlobal.EntryModel.iDefaultFATagValue;
                                bSetDefaultTagValue = true;
                            }
                        }


                        if (objMetaData.iFieldId == eVTFIELDID.FDF_CODE) {
                            if (transEntryGlobal.EntryModel.bView == true && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                                if (EntryMainCommon.isMatch("^[0-9]+(,[0-9]+)+$", objMetaData.sDefaultValue) == true) {
                                    sFilter = OPTIONCONTROL.getFilter(sId);
                                    if (DataType.isNullOrEmpty(sFilter, true) == false) {
                                        sFilter += " and ";
                                    }
                                    OPTIONCONTROL.setFilter(sId, sFilter + " a.iMasterId in (" + objMetaData.sDefaultValue + ")");
                                }
                                else if (DataType.stringStartsWith(objMetaData.sDefaultValue.toLowerCase(), "grp(") == true) {
                                    sGroups = objMetaData.sDefaultValue.substr(4, objMetaData.sDefaultValue.length - 5);
                                    OPTIONCONTROL.setGroups(sId, sGroups);
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDefaultValue, 0, 0, 0, objMetaData.sFieldName);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toInt(objFormulaOutput.Value);

                                    objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                    objTemp.bLoadAll = true;
                                    OPTIONCONTROL.setValue(sId, value, null, objTemp);
                                    if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                        OPTIONCONTROL.setGroupId(sId, value);
                                    }
                                    else {
                                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                    }
                                }
                            }
                            else if (transEntryInfo.Settings.Misc.DefaultAccount1 > 0) {
                                objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                objTemp.bLoadAll = true;
                                OPTIONCONTROL.setValue(sId, transEntryInfo.Settings.Misc.DefaultAccount1, null, objTemp);
                                if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != transEntryInfo.Settings.Misc.DefaultAccount1) {
                                    OPTIONCONTROL.setGroupId(sId, transEntryInfo.Settings.Misc.DefaultAccount1);
                                }
                                else {
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, transEntryInfo.Settings.Misc.DefaultAccount1, 0, objMetaData);
                                }
                            }
                            else {
                                OPTIONCONTROL.clear(sId);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            }
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_BOOKNO) {
                            if (transEntryGlobal.EntryModel.bView == true && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                                if (EntryMainCommon.isMatch("^[0-9]+(,[0-9]+)+$", objMetaData.sDefaultValue) == true) {
                                    sFilter = OPTIONCONTROL.getFilter(sId);
                                    if (DataType.isNullOrEmpty(sFilter, true) == false) {
                                        sFilter += " and ";
                                    }
                                    OPTIONCONTROL.setFilter(sId, sFilter + " a.iMasterId in (" + objMetaData.sDefaultValue + ")");
                                }
                                else if(DataType.stringStartsWith(objMetaData.sDefaultValue.toLowerCase(), "grp(") == true) {
                                    sGroups = objMetaData.sDefaultValue.substr(4, objMetaData.sDefaultValue.length - 5);
                                    OPTIONCONTROL.setGroups(sId, sGroups);
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDefaultValue, 0, 0, 0, objMetaData.sFieldName);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toInt(objFormulaOutput.Value);

                                    objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                    objTemp.bLoadAll = true;
                                    OPTIONCONTROL.setValue(sId, value, null, objTemp);
                                    if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                        OPTIONCONTROL.setGroupId(sId, value);
                                    }
                                    else {
                                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);

                                        objTemp = OPTIONCONTROL.getControlDataObject(sId);
                                        EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objTemp, 0);
                                        iBookTypeId = EntryMainMemoryObject.getBookTypeId();
                                        //if (EntryMainCommon.isPartyType(iBookTypeId) == true) {
                                        if (iBookTypeId == eAccountTypes.Bank || EntryMainCommon.isPartyType(iBookTypeId) == true || iBookTypeId == eAccountTypes.Cash) {
                                            iDefaultCurrency = EntryMainMemoryObject.getBookDataValue("iDefaultCurrency", 0);
                                            iDefaultCurrency = DataType.toInt(iDefaultCurrency);
                                        }
                                    }
                                }
                            }
                            else if (transEntryInfo.Settings.Misc.DefaultAccount2 > 0) {
                                objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                objTemp.bLoadAll = true;
                                OPTIONCONTROL.setValue(sId, 
                                                        transEntryInfo.Settings.Misc.DefaultAccount2, 
                                                        { 
                                                            bFromSetHeaderFieldsDefaultValue: true 
                                                        }, 
                                                        objTemp);
                                if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != transEntryInfo.Settings.Misc.DefaultAccount2) {
                                    OPTIONCONTROL.setGroupId(sId, transEntryInfo.Settings.Misc.DefaultAccount2);
                                }
                                else {
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, transEntryInfo.Settings.Misc.DefaultAccount2, 0, objMetaData);

                                    objTemp = OPTIONCONTROL.getControlDataObject(sId);
                                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objTemp, 0);
                                    iBookTypeId = EntryMainMemoryObject.getBookTypeId();
                                    if (EntryMainCommon.isPartyType(iBookTypeId) == true) {
                                        iDefaultCurrency = EntryMainMemoryObject.getBookDataValue("iDefaultCurrency", 0);
                                        iDefaultCurrency = DataType.toInt(iDefaultCurrency);
                                    }

                                    EntryMainHeader.setDefaultChequeNo();
                                }
                                bDefaultBook = true;
                            }
                            else {
                                OPTIONCONTROL.clear(sId);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            }
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_LCNUMBER) {
                            OPTIONCONTROL.setValue(sId, transEntryInfo.Settings.Misc.DefaultAccount2);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, transEntryInfo.Settings.Misc.DefaultAccount2, 0, objMetaData);
                        }
                        else if (!(bDefaultBook && objMetaData.iFieldId == eVTFIELDID.FDF_PMTTERMS)) {
                            if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                                OPTIONCONTROL.setExtraFilter(sId, "");
                            }

                            if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERCURRENCY && DataType.isNullOrEmpty(sDefaultValue) == true) {
                                if (bLoadVoucher == true) {
                                    continue;
                                }

                                if (iDefaultCurrency > 0) {
                                    // Already set in book change
                                    continue;
                                }
                                OPTIONCONTROL.setValue(sId, transEntryInfo.DefaultCurrencyId);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, transEntryInfo.DefaultCurrencyId, 0, objMetaData);
                                if (transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Header) {
                                    transEntryExchangeRate.onLeaveH(EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_EXCHANGERATE));
                                }
                            }
                            else if (objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH && DataType.isNullOrEmpty(sDefaultValue) == true) {
                                if (transEntryInfo.VoucherType == eVTTYPE.PRDRT) {
                                    OPTIONCONTROL.setFilter(sId, "iOrderStatus BETWEEN 3 AND 4");
                                }
                                else if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS
                                    || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS
                                    || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE
                                    || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC
                                    || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC
                                ) {
                                    OPTIONCONTROL.setFilter(sId, "iOrderStatus BETWEEN 2 AND 3");
                                }
                                else {
                                    OPTIONCONTROL.setFilter(sId, "");
                                }
                                OPTIONCONTROL.clear(sId);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                            }
                            else if (objMetaData.iFieldId == eVTFIELDID.FDF_PROD_PROCESS) {
                                OPTIONCONTROL.setFilter(sId, "iProdOrderId=0");
                                OPTIONCONTROL.clear(sId);
                            }
                            else if (EntryMainCommon.isFormula(sDefaultValue) == true) {
                                objTag = null;

                                if (bLoadVoucher == true) {
                                    bIgnoreChangeCallback = true;
                                }
                                else {
                                    bIgnoreChangeCallback = false;
                                }

                               // bIgnoreChangeCallback = true;
                                if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERCURRENCY
                                    && transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Header) {
                                    bIgnoreChangeCallback = false;
                                }
                                else if (bSetDefaultTagValue == true) {
                                    bIgnoreChangeCallback = false;
                                    objTag = {};
                                    objTag.bIgnoreDataLoading = true;
                                }
                                else if (bIgnoreChangeCallback == false) {
                                    bIgnoreChangeCallback = false;
                                    objTag = {};
                                    objTag.bIgnoreDataLoading = true;
                                }

                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(EntryMainCommon.extractFormula(sDefaultValue), 0, 0, 0, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                value = DataType.toInt(objFormulaOutput.Value);

                                objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                objTemp.bIgnoreChangeCallback = bIgnoreChangeCallback;
                                OPTIONCONTROL.setValue(sId, value, objTag, objTemp);
                                if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                    OPTIONCONTROL.setGroupId(sId, value);
                                }
                                else {
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                }
                            }
                            else {
                                if (EntryMainCommon.isMatch("^[0-9]+(,[0-9]+)+$", sDefaultValue) == true) {
                                    sFilter = OPTIONCONTROL.getFilter(sId);
                                    if (DataType.isNullOrEmpty(sFilter, true) == false) {
                                        sFilter += " and ";
                                    }
                                    OPTIONCONTROL.setFilter(sId, sFilter + " a.iMasterId in (" + sDefaultValue + ")");
                                }
                                else if(DataType.stringStartsWith(sDefaultValue.toLowerCase(), "grp(") == true) {
                                    sGroups = sDefaultValue.substr(4, sDefaultValue.length - 5);
                                    OPTIONCONTROL.setGroups(sId, sGroups);
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(sDefaultValue, 0, 0, 0, objMetaData.sFieldName);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toInt(objFormulaOutput.Value);
                                    bIgnoreChangeCallback = (EntryMainDependency.getOtherDependentMaster(objMetaData.iMasterTypeId).length == 0);
                                    objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                    objTemp.bIgnoreChangeCallback = bIgnoreChangeCallback;
                                    OPTIONCONTROL.setValue(sId, 
                                                            value, 
                                                            null, 
                                                            objTemp);
                                    
                                    if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                        OPTIONCONTROL.setGroupId(sId, value);
                                    }
                                    else {
                                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                    }
                                }
                            }
                        }
                        else {
                            if (DataType.isNullOrEmpty(sDefaultValue) == false) {
                                if (EntryMainCommon.isFormula(sDefaultValue) == true) {
                                    if (bLoadVoucher == false) {
                                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(EntryMainCommon.extractFormula(sDefaultValue), 0, 0, 0, objMetaData.sFieldName);
                                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                        value = DataType.toInt(objFormulaOutput.Value);
                                        bIgnoreChangeCallback = true;
                                        objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                        objTemp.bIgnoreChangeCallback = bIgnoreChangeCallback;
                                        OPTIONCONTROL.setValue(sId, value, null, objTemp);
                                        if (objMetaData.iMasterTypeId > 0) {
                                            if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                                OPTIONCONTROL.setGroupId(sId, value);
                                            }
                                            else {
                                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                            }
                                        }
                                    }
                                }
                                else {
                                    if (EntryMainCommon.isMatch("^[0-9]+(,[0-9]+)+$", sDefaultValue) == true) {
                                        sFilter = OPTIONCONTROL.getFilter(sId);
                                        if (DataType.isNullOrEmpty(sFilter, true) == false) {
                                            sFilter += " and ";
                                        }

                                        OPTIONCONTROL.setFilter(sId, sFilter + " a.iMasterId in (" + sDefaultValue + ")");
                                    }
                                    else if(DataType.stringStartsWith(sDefaultValue.toLowerCase(), "grp(") == true) {
                                        sGroups = sDefaultValue.substr(4, sDefaultValue.length - 5);
                                        OPTIONCONTROL.setGroups(sId, sGroups);
                                    }
                                    else {
                                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(sDefaultValue, 0, 0, 0, objMetaData.sFieldName);
                                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                        value = DataType.toInt(objFormulaOutput.Value);
                                        bIgnoreChangeCallback = true;
                                        objTemp = OPTIONCONTROL.createSetValueExtraObject();
                                        objTemp.bIgnoreChangeCallback = bIgnoreChangeCallback;
                                        OPTIONCONTROL.setValue(sId, value, null, objTemp);
                                        if (objMetaData.iMasterTypeId > 0) {
                                            if (DataType.toInt(OPTIONCONTROL.getControlValue(sId)) != value) {
                                                OPTIONCONTROL.setGroupId(sId, value);
                                            }
                                            else {
                                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if (transEntryInfo.UserId != GlobalPref.SUPER_USER
                            && objMetaData.iMasterTypeId > 0
                            && DataType.toInt(OPTIONCONTROL.getControlValue(sId)) <= 0
                            && DataType.arrayLength(transEntryGlobal.EntryModel.Extras.MasterRestriction) > 0) {

                            arrTemp = DataType.arrayFilterData(transEntryGlobal.EntryModel.Extras.MasterRestriction, "MasterType", objMetaData.iMasterTypeId, "==");
                            if (arrTemp.length > 0 && DataType.arrayLength(arrTemp[0].Masters) == 1) {
                                OPTIONCONTROL.setValue(sId, arrTemp[0].Masters[0].MasterId);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, arrTemp[0].Masters[0].MasterId, 0, objMetaData);

                                if (arrTemp[0].MasterType == transEntryInfo.FATag) {
                                    EntryMainHeader.checkAndSetCurrencyExtraFilter();
                                }
                            }
                        }

                        break;
                    case eMasterDataType.ExternalTable:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            OPTIONCONTROL.clear(sId);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                            break;
                        }

                        EntryMainMaster.updateOptionFilter(objMetaData);
                        if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                            if (EntryMainCommon.isFormula(objMetaData.sDefaultValue) == true) {
                                if (bLoadVoucher == false) {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(EntryMainCommon.extractFormula(objMetaData.sDefaultValue), 0, 0, 0, objMetaData.sFieldName);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toInt(objFormulaOutput.Value);
                                    OPTIONCONTROL.setValue(sId, value);
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                                }
                            }
                            else {
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDefaultValue, 0, 0, 0, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                value = DataType.toInt(objFormulaOutput.Value);
                                OPTIONCONTROL.setValue(sId, value);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                            }
                        }
                        break;
                    case eMasterDataType.Number:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            eleControl.value = "";
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                            break;
                        }

                        if (DataType.stringStartsWith(objMetaData.sDefaultValue, "#") == false
                            && DataType.stringStartsWith(objMetaData.sDefaultValue, "&#") == false) {

                            if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(objMetaData.sDefaultValue, true) == true) {
                                eleControl.value = "";
                            }
                            else {
                                eleControl.value = DataType.toInt(objMetaData.sDefaultValue);                                
                            }
                        }
                        else {
                            eleControl.value = "";
                        }
                        EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.value, 0, objMetaData);
                        break;
                    case eMasterDataType.Fraction:
                        if(bLoadVoucher == false && bDoNotSetDefaultValue == true) {
                            eleControl.value = "";
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                            break;
                        }

                        if (objMetaData.iFieldId == eVTFIELDID.FDF_EXCHANGERATE) {
                            break;
                        }

                        if (DataType.stringStartsWith(objMetaData.sDefaultValue, "#") == false
                            && DataType.stringStartsWith(objMetaData.sDefaultValue, "&#") == false) {
                            switch (objMetaData.iFieldId) {
                                case eVTFIELDID.FDF_LOCEXCHANGERATE:
                                    // Do not need to set because it is already set by currency change
                                    if (EntryMain.m_objTrans.BodyData[0].FATag == 0) {
                                        transEntryFields.setLocalExchangeRate(DataType.toDecimal(objMetaData.sDefaultValue), 0);
                                    }
                                    break;
                                case eVTFIELDID.FDF_EXCHANGERATE:
                                    if (objMetaData.bMandatory == true && DataType.toDecimal(objMetaData.sDefaultValue) == 0) {
                                        transEntryFields.setExchangeRate(0, 0);
                                    }
                                    else {
                                        transEntryFields.setExchangeRate(objMetaData.sDefaultValue, 0);
                                    }
                                    break;
                                default:
                                    if (objMetaData.bMandatory == true && DataType.toDecimal(objMetaData.sDefaultValue) == 0) {
                                        eleControl.value = "";
                                    }
                                    else {
                                        eleControl.value = DataType.toDecimal(objMetaData.sDefaultValue, objMetaData.iNoDecimal);
                                    }
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, eleControl.value, 0, objMetaData);
                                    break;
                            }
                        }
                        else {
                            eleControl.value = "";
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                        }
                        break;
                    case eMasterDataType.HyperLink:
                        FHyperLink.setValue(sId, objMetaData.sDefaultValue);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objMetaData.sDefaultValue, 0, objMetaData);
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.setHeaderFieldsDefaultValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        OPTIONCONTROL.enableLog(true);
        NETWORK.enableLog(true);

        objWatch.stop();
        transEntryGlobal.writeInfoLog("EntryMainHeader.setHeaderFieldsDefaultValue(" + objWatch.getDifferenceString() + ").");
    },

