        iSign = FNumberOperation.isLessThan(dAmt, 0) ? -1 : 1;
        dAmt = FConvert.roundOff(FNumberOperation.abs(dAmt), dGeneralRoundOff, iRoundingType);
        dAmt = FNumberOperation.mul(dAmt, iSign);

        return(dAmt);
    },

    generateNumberFromSeries: function(arrIncrementalSeries) {
        let sTemp = "";
        let iCounter = 0;
        let arrSeriesData = [];
        let objIdNamePair = null;
        let objSeries = null;

        try {
            sTemp = "";
            arrSeriesData =[];
            if (DataType.arrayLength(arrIncrementalSeries) < 1) {
                return([]);
            }

            for (iCounter = 0; iCounter < arrIncrementalSeries.length; iCounter++) {
                objSeries = arrIncrementalSeries[iCounter];
                sTemp = "";
                switch (objSeries.Type) {
                    case 0: // Login
                        if (DataType.toInt(objSeries.FieldValue) == 0) {
                            sTemp = GlobalPref.UserName;
                        }
                        else {
                            sTemp = GlobalPref.LoginAbbr;
                        }
                        break;
                    case 1: // Char Input
                        switch (DataType.toInt(objSeries.FieldValue)) {
                            case 0:
                                sTemp = "/";
                                break;
                            case 1:
                                sTemp = "-";
                                break;
                            case 2:
                                sTemp = "*";
                                break;
                            case 3:
                                sTemp = "_";
                                break;
                            default:
                                sTemp = " ";
                                break;
                        }
                        break;
                    case 2: // Date
                        switch (DataType.toInt(objSeries.FieldValue)) {
                            case 0: // Day
                                sTemp = DataType.toString(transEntryDate.getDay());
                                if (sTemp.length == 1) {
                                    sTemp = "0" + sTemp;
                                }
                                break;
                            case 1: // Month Name
                                sTemp = transEntryDate.getMonthName();
                                break;
                            case 2: // Year
                                sTemp = DataType.toString(transEntryDate.getYear());
                                break;
                            case 3: // Month
                                sTemp = DataType.toString(transEntryDate.getMonth());
                                if (sTemp.length == 1) {
                                    sTemp = "0" + sTemp;
                                }
                                break;
                        }
                        break;
                    case 3: // Increment
                        break;
                    case 4: // Decrement
                        break;
                }

                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = objSeries.Type;
                objIdNamePair.Name = sTemp;
                objIdNamePair.Tag = objSeries.FieldValue;
                arrSeriesData.push(objIdNamePair);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMain.generateNumberFromSeries} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrSeriesData);
    },

