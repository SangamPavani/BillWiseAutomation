    isLinkValueChanges: function (iFieldId, iRow) {
        let iCounter = 0;
        let iIndex = 0;
        let bFound = false;
        let arrFields = undefined;
        let objData = undefined;
        let obj = undefined;

        try {
            objData = {};
            objData.bClearAllRows = false;
            objData.arrIndex = [];

            if (EntryMain.isDataLoading() == true) {
                return (objData);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.arrMetaDataBodyIndex) == false) {
                return (objData);
            }

            iRow = DataType.toInt(iRow);
            if (iRow > 0 && iRow <= transEntryGrid.getTotalRows()) {
                objData.bClearAllRows = false;
            }
            else {
                objData.bClearAllRows = true;
            }

            // Get array of body column index of link column
            arrFields = transEntryFieldInfo.getLinkFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                obj = arrFields[iCounter];
                if (DataType.isValidObject(obj.MetaData.ArrFilterCriteria) == false) {
                    continue;
                }

                bFound = false;
                for (iIndex = 0; iIndex < obj.MetaData.ArrFilterCriteria.length; iIndex++) {
                    if (obj.MetaData.ArrFilterCriteria[iIndex].FilterFieldID == iFieldId) {
                        bFound = true;
                        break;
                    }
                }

                if (bFound == false) {
                    continue;
                }

                objData.arrIndex.push(iCounter);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.isLinkValueChanges} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objData);
    },

    checkForLinkValueChanges: function (iFieldId, iRow, iLinkField) {
        let iCounter = 0;
        let iIndex = 0;
        let iColumnIndex = 0;
        let iMetaDataIndex = 0;
        let bClearAllRows = false;
        let objFieldInfo = undefined;
        let objMetaData = null;
        let arrData = null;

        try {
            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            obj = EntryMainWorkflow.isLinkValueChanges(iFieldId, iRow);
            if (obj.arrIndex.length == 0) {
                return;
            }


            iRow = DataType.toInt(iRow);

            // Get array of body column index of link column
            for (iCounter = 0; iCounter < obj.arrIndex.length; iCounter++) {
                iIndex = obj.arrIndex[iCounter];
                iColumnIndex = transEntryGlobal.FieldHelper.Column.Links[iIndex]; // Get body link column index
                iMetaDataIndex = transEntryGlobal.FieldHelper.MetaData.Links[iIndex]; // Get meta data index 
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iMetaDataIndex];


                if (DataType.isValidObject(objMetaData.Tag) == true && objMetaData.Tag.LinkId > 0) {
                    objFieldInfo = EntryMainUI.getBodyFieldInfo(eVTFIELDID.FDF_LINK, false, objMetaData.Tag.LinkId);
                }
                else {
                    objFieldInfo = EntryMainUI.getBodyFieldInfo(eVTFIELDID.FDF_LINK, false, iColumnIndex);
                }

                if (bClearAllRows == true) {
                    arrData = EntryMainUI.clear(objFieldInfo, 0);

                    if (DataType.arrayLength(arrData) > 0) {
                        EntryMainUI.valueChanged(objMetaData, 0, iColumnIndex);
                    }

                    EntryMainUI.clear(transEntryFieldInfo.MaxQtyRelease, 0);
                }
                else {
                    EntryMainUI.clear(objFieldInfo, iRow);

                    EntryMainUI.clear(transEntryFieldInfo.MaxQtyRelease, iRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.checkForLinkValueChanges} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    checkForDateChange: function (iDate) {
        let sVoucherNo = "";
        let iCounter = 0;
        let iIndex = 0;
        let iRow = 0;
        let lRefId = 0;
        let bClear = false;
        let objMetaData = null;
        let objLinkColumn = null;
        let arrVoucherNo = null;
        let objFieldInfo = undefined;
        let arrRefId = null;
        let arrRowInfo = null;
        let obj = null;
        let result = null;

        try {
            arrVoucherNo = [];
            arrRefId = [];
            arrRowInfo = [];
            for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.Column.Links.length; iCounter++) {
                iIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
                if (DataType.isValidObject(objMetaData.Tag) == false) {
                    continue;
                }

                if (objMetaData.Tag.IsAllowBackDatedLinking == true) {
                    continue;
                }

                for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                    objLinkColumn = transEntryGrid.getCellObject(iRow, transEntryGlobal.FieldHelper.Column.Links[iCounter]);
                    if (DataType.isValidObject(objLinkColumn) == false) {
                        continue;
                    }

                    sVoucherNo = objLinkColumn.getCellData("voucherno");
                    if (DataType.isNullOrEmpty(sVoucherNo, true) == true) {
                        continue;
                    }


                    lRefId = FNumberOperation.convert(objLinkColumn.getCellData("refid"));
                    if (DataType.isZero(lRefId) == true) {
                        continue;
                    }

                    for (iIndex = 0; iIndex < arrVoucherNo.length; iIndex++) {
                        if (arrVoucherNo[iIndex] == sVoucherNo) {
                            arrRowInfo[iIndex].arrRows.push(iRow);
                            break;
                        }
                    }

                    if (iIndex >= arrVoucherNo.length) {
                        arrVoucherNo.push(sVoucherNo);
                        arrRefId.push(lRefId);

                        obj = {};
                        obj.arrRows = [iRow];
                        obj.Column = transEntryGlobal.FieldHelper.Column.Links[iCounter];
                        obj.LinkId = objMetaData.Tag.LinkId;
                        arrRowInfo.push(obj);
                    }
                }
            }

            if (arrRefId.length > 0) {
                bClear = false;
                result = transEntryServer.execute(eTransServerRequest.GetVoucherDates,
                                                    { arrTransactionIds: arrRefId },
                                                    false);

                if (result.lValue > 0 && result.data.lValue > 0) {
                    iDocDate = EntryMain.m_objTrans.Header.Date;

                    result = result.data.data;
                    for (iCounter = 0; iCounter < result.length; iCounter++) {
                        if (iDate < result[iCounter]) {
                            if (transEntryGlobal.confirmMessage("Some base document date is less than document date. Are you want to clear those link data?") == true) {
                                bClear = true;
                                break;
                            }
                            else {
                                return (false);
                            }
                        }
                    }

                    if (bClear == true) {
                        for (iCounter = 0; iCounter < result.length; iCounter++) {
                            if (iDate < result[iCounter]) {
                                for (iIndex = 0; iIndex < arrRowInfo[iCounter].arrRows.length; iIndex++) {
                                    if (arrRowInfo[iCounter].LinkId > 0) {
                                        objFieldInfo = EntryMainUI.getBodyFieldInfo(eVTFIELDID.FDF_LINK, false, arrRowInfo[iCounter].LinkId);
                                    }
                                    else {
                                        objFieldInfo = EntryMainUI.getBodyFieldInfo(eVTFIELDID.FDF_LINK, false, arrRowInfo[iCounter].Column);
                                    }

                                    EntryMainUI.clear(objFieldInfo, arrRowInfo[iCounter].arrRows[iIndex]);
                                }
                            }
                        }

                        transEntryLinks.resetDate();
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.checkForDateChange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

