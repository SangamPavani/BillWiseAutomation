                    }
                }

                if (transEntryGlobal.FieldHelper.Column.Links.length > 0) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_LINK);
                    sAllLinkData = body[sId];
                    for (iCounter1 = 0; iCounter1 < transEntryGlobal.FieldHelper.Column.Links.length; iCounter1++) {
                        iIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter1];
                        objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
                        if (objMetaData.bMandatory == false) {
                            continue;
