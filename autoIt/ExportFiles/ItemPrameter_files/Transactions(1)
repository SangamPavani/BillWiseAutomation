        sortOnNumber: function (iColumn, bAscending) {
            var iCounter = 0;
            var iIndex = 0;
            var iTotal = 0;
            var bChangeRequired = false;
            var objOuterValue = null;
            var objInnerValue = null;

            try {
                iTotal = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills.length;
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                        if (iColumn == 4) {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].dDocDate;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].dDocDate;
                        }
                        else if (iColumn == 5) {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].dDueDate;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].dDueDate;
                        }
                        else if (iColumn == 23) {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].dPreviousAdjustedAmount;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].dPreviousAdjustedAmount;
                        }
                        else if (iColumn == 24) {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].dPreviousAdjustedAmountTC;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].dPreviousAdjustedAmountTC;
                        }
                        var bChangeRequired = false;

                        if (bAscending == true && objOuterValue > objInnerValue) {
                            bChangeRequired = true;
                        }
                        else if (bAscending == false && objOuterValue < objInnerValue) {
                            bChangeRequired = true;
                        }

                        if (bChangeRequired == true) {
                            AdjustBills_Screen.SORT.changePosition(iCounter, iIndex);
                        }
                    }
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{AdjustBills_Screen.SORT.sortOnNumber} " + err.message, "Exception");
            }
        },

        sortOnText: function (bAscending, iStartIndex, iCount) {
            var iCounter = 0;
            var iIndex = 0;
            var iTotal = 0;
            var iCompareValue = 0;
            var bChangeRequired = false;
            var objOuterValue = null;
            var objInnerValue = null;

            try {
                iTotal = iStartIndex + iCount;
                for (iCounter = iStartIndex; iCounter < iTotal; iCounter++) {
                    for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                        //if (iColumn == 8)
                        {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].sReference;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].sReference;
                        }

                        bChangeRequired = false;

                        iCompareValue = objOuterValue.localeCompare(objInnerValue);
                        if (bAscending == true && iCompareValue > 0) {
                            bChangeRequired = true;
                        }
                        else if (bAscending == false && iCompareValue < 0) {
                            bChangeRequired = true;
                        }

                        if (bChangeRequired == true) {
                            AdjustBills_Screen.SORT.changePosition(iCounter, iIndex);
                        }
                    }
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{AdjustBills_Screen.SORT.sortOnText} " + err.message, "Exception");
            }
        },

        sortOnVoucherNo: function (eleWorkflowGrid, iColumn, bAscending) {
            var iCounter = 0;
            var arrDataIndex = null;
            var objCellData = null;

            try {
                AdjustBills_Screen.SORT.sortOnLength(eleWorkflowGrid, iColumn, bAscending);

                arrDataIndex = [];
                for (iCounter = 0; iCounter < g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills.length; iCounter++) {
                    objCellData = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter];
                    if (iCounter == 0) {
                        arrDataIndex.push({ Index: iCounter, Length: objCellData.sReference.length, Count: 1 });
                    }
                    else if (objCellData.sReference.length != arrDataIndex[arrDataIndex.length - 1].Length) {
                        arrDataIndex.push({
                            Index: iCounter, Length: objCellData.sReference.length, Count: 1
                        });
                    }
                    else {
                        arrDataIndex[arrDataIndex.length - 1].Count++;
                    }
                }

                for (iCounter = 0; iCounter < arrDataIndex.length; iCounter++) {
                    AdjustBills_Screen.SORT.sortOnText(eleWorkflowGrid, iColumn, bAscending, arrDataIndex[iCounter].Index, arrDataIndex[iCounter].Count);
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{AdjustBills_Screen.SORT.sortOnVoucherNo} " + err.message, "Exception");
            }
        },

        sortOnLength: function (iColumn, bAscending) {
            var iCounter = 0;
            var iIndex = 0;
            var iTotal = 0;
            var bChangeRequired = false;
            var objOuterValue = null;
            var objInnerValue = null;

            try {
                iTotal = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills.length;
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    for (iIndex = iCounter + 1; iIndex < iTotal; iIndex++) {
                        if (iColumn == 2) {
                            objOuterValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iCounter].sReference;
                            objInnerValue = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[iIndex].sReference;
                        }

                        bChangeRequired = false;

                        if (bAscending == true && objOuterValue.length > objInnerValue.length) {
                            bChangeRequired = true;
                        }
                        else if (bAscending == false && objOuterValue.length < objInnerValue.length) {
