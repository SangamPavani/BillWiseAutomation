    onProdBatch_Change: function (tag) {
        debugger
        let sId = "";
        let iCounter = 0;
        let iProdOrder = 0;
        let iDueDate = 0;
        let iDate = 0;
        let iVoucherType = 0;
        let bIssue = false;
        let bRetIssue = false;
        let dProdOrderQty = 0;
        let dTotal = 0;
        let objGlobal = null;
        let objMetaData = null;
        let lstBody = null;
        let lstRctIssue = null;
        let arrBodyData = null;
        let objProductionHeader = null;
        let result = null;
        let obj = null;
        let lstPreferenceOptions = [];
        let objIdNamePair = null;
        let objMRPPref = null;
        let bPhantom = false;

        try {
            iVoucherType = transEntryInfo.VoucherType;
            iProdOrder = OPTIONCONTROL.getControlValueLong(tag.Control);
            iDueDate = OPTIONCONTROL.getControlValueLong(tag.Control, "iduedate");
            bPhantom = OPTIONCONTROL.getControlValueLong(tag.Control, "bPhantom");
            iDate = OPTIONCONTROL.getControlValueLong(tag.Control, "iDate");
            objMRPPref = transEntryInfo.MRPPref;

            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE)
                && EntryMain.m_objTrans.Header.Date > iDueDate && iDueDate > 0) {
                transEntryGlobal.showAlert("Raw materials cannot be issues after due date.");
                OPTIONCONTROL.setValue(tag.Control, 0);

                return;
            }
            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS)) {
                if (iDate > 0 && EntryMain.m_objTrans.Header.Date < iDate) {
                    transEntryGlobal.showAlert("This production order cannot be issued, Issue date cannot be less than Production Date");
                    OPTIONCONTROL.setValue(tag.Control, 0);
                    return;
                }

                if (bPhantom == "true" || bPhantom == "True" || bPhantom == true) {
                    transEntryGlobal.showAlert("This production order cannot be issued, Attached BOM is phantom");
                    OPTIONCONTROL.setValue(tag.Control, 0);
                    return;
                }

            }
            //debugger
            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE) || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC) {

                var ProdOrderdatafileds = OPTIONCONTROL.getControlDataObject(tag.Control);
                var ele = null;
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                    if (objMetaData.sFieldName == "sRefBatchNo") {
                        ele = document.getElementById(EntryMainUI.getHeaderControlId(objMetaData.iFieldId));
                        ele.value = ProdOrderdatafileds.sBatchNo;
                    } else if (objMetaData.sFieldName == "sRemarks") {
                        ele = document.getElementById(EntryMainUI.getHeaderControlId(objMetaData.iFieldId));
                        ele.value = ProdOrderdatafileds.sRemarks;
                    } else if (objMetaData.sFieldName == "SpecialInstruction") {
                        ele = document.getElementById(EntryMainUI.getHeaderControlId(objMetaData.iFieldId));
                        ele.value = ProdOrderdatafileds.sSpecialInstruction;
                    } else if (objMetaData.sFieldName == "sRefOrderNo") {
                        ele = document.getElementById(EntryMainUI.getHeaderControlId(objMetaData.iFieldId));
                        ele.value = ProdOrderdatafileds.sRefOrderNo;
                    }
                }
            }

            objGlobal = GLOBAL.getGlobalValue();
            if (objGlobal.ModulesImplemented & eModulesImplemented.MRP1 > 0) {
                result = EntryMainProductionProcess.checkIfProcurementIsDoneForPO(iProdOrder);
                if (result.lValue > 0 && result.data == false) {
                    transEntryGlobal.showAlert("Purchase order for this Production Order are Pending, you cannot continue with this transaction", GlobalPref.getResourceValue("Error"));
                    if (transEntryInfo.HeaderFlags.Editing == false) {
                        EntryMainUI.resetScreen(false);
                    }
                    else {
                        obj = {};
                        obj.sOldDocumentNo = ""
                        obj.sNewDocumentNo = EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true);
                        obj.iVoucherType = transEntryInfo.VoucherType;
                        obj.iViewId = transEntryInfo.ViewId;
                        obj.bNext = true;
                        obj.bEdit = false;

                        result = transEntryServer.loadVoucher(obj,
                            false,
                            null,
                            true,
                            "EntryMainCallback.loadVoucher");
                    }

                    return;
                }
            }
            //Check if Receipt is prior to Issues and Check if Issue is not Done
            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC) || ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC)) {
                if (!bPhantom || bPhantom == false || bPhantom == "False" || bPhantom == "false") {
                    debugger;
                    result = null;
                    result = EntryMainProductionProcess.ValidateProdOrdOnReceipt(iProdOrder);
                    let bPass = true
                    if (result.data != null && result.data.length > 0) {
                        if (result.data[0] == false) {
                            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC)) {

                                transEntryGlobal.showAlert("Issue to production for the Selected Production order is not done");
                            }
                            else if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC)) {
                                transEntryGlobal.showAlert("Job Work Issue for the Selected Production order is not done");
                            }
                            bPass = false;
                        }
                        if (result.data[1] == false) {
                            if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC)) {
                                transEntryGlobal.showAlert("Receipt From production date cannot be prior to Issue date");
                            }
                            else if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC)) {
                                transEntryGlobal.showAlert("Job Work Receipts date cannot be prior to Issue date");
                            }
                            bPass = false;
                        }

                        if (bPass == false) {
                            if (transEntryInfo.HeaderFlags.Editing == false) {
                                EntryMainUI.resetScreen(false);
                            }
                            else {
                                obj = {};
                                obj.sOldDocumentNo = ""
                                obj.sNewDocumentNo = EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true);
                                obj.iVoucherType = transEntryInfo.VoucherType;
                                obj.iViewId = transEntryInfo.ViewId;
                                obj.bNext = true;
                                obj.bEdit = false;

                                result = transEntryServer.loadVoucher(obj,
                                    false,
                                    null,
                                    true,
                                    "EntryMainCallback.loadVoucher");
                            }
                            return;
                        }
                    }
                }
            }

            if (objMRPPref.bAllowUserToIssuesAndReceiptProcessWise == false) {
                if (transEntryFieldInfo.BomSize.FieldId == 0) {
                    return;
                }

                bIssue = false;
                if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS
                    || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWISS
                    || iVoucherType == 0x420) {
                    bIssue = true;
                }
                let bIssueToPO = false;
                if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRDIS) {
                    bIssueToPO = true;
                }

                bRetIssue = false;
                if (iVoucherType == eVTTYPE.PRDRT
                    || iVoucherType == (eVTTYPE.PRDRT + 1)
                    || iVoucherType == (eVTTYPE.PRDRT + 2)
                    || iVoucherType == (eVTTYPE.PRDRT + 3)) {
                    bRetIssue = true;
                }

                dProdOrderQty = DataType.toDecimal(OPTIONCONTROL.getControlValue(tag.Control, "fquantity"));
                var iVendorId = 0;
                if (OPTIONCONTROL.getControlData('id_header_4').length != 0 && bIssueToPO == false) {
                    iVendorId = OPTIONCONTROL.getControlData('id_header_4')[0].iMasterId;
                }
                result = EntryMainProductionProcess.getRemainingProdQty(iProdOrder, iVendorId, 0);
                if (result.lValue > 0) {
                    if ((bIssue == true && iVoucherType != 0x420)
                        || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE) {
                        EntryMain.m_dMaxIssueRct = dProdOrderQty - DataType.toDecimal(result.data);
                    }
                    else {
                        EntryMain.m_dMaxIssueRct = DataType.toDecimal(result.data);
                    }
                }
                var dMaxQtyToIssue = EntryMainProductionProcess.CheckMaxQtyToIssue(iProdOrder, 0, EntryMain.m_dMaxIssueRct, 0);
                if (parseFloat(dMaxQtyToIssue.data) < parseFloat(EntryMain.m_dMaxIssueRct)) {
                    transEntryGlobal.showAlert("The maximum issue Quantity available for this production based on stock available is " + DataType.toString(dMaxQtyToIssue.data));
                    EntryMain.m_dMaxIssueRct = DataType.toDecimal(dMaxQtyToIssue.data);
                }

                if (EntryMain.isDataLoading() == true) {
                    EntryMain.m_dMaxIssueRct += transEntryGlobal.EntryModel.Data.ProductionSize;
                    return;
                }

                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = Focus_TranSettings_DataStructs_MRP.get("AllowtoissuepartialquantityinIssuestoproduction");
                objIdNamePair.Name = "AllowtoissuepartialquantityinIssuestoproduction";
                objIdNamePair.Tag = objMRPPref.bAllowtoissuepartialquantityinIssuestoproduction;
                lstPreferenceOptions.push(objIdNamePair);


                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = Focus_TranSettings_DataStructs_MRP.get("DontAllowToIssueMoreThanPlannedQuantity");
                objIdNamePair.Name = "DontAllowToIssueMoreThanPlannedQuantity";
                objIdNamePair.Tag = objMRPPref.DontAllowToIssueMoreThanPlannedQuantity;
                lstPreferenceOptions.push(objIdNamePair);
                // if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC) || ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC)) {
                if (!bPhantom || bPhantom == false || bPhantom == "False" || bPhantom == "false") {
                    if (DataType.toDecimal(EntryMain.m_dMaxIssueRct) <= 0 && ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC)) {
                        transEntryGlobal.showAlert("Identified incomplete issues against selected orders or chosen filters");
                        return;
                    }
                }
                //}
                else {
                    if (EntryMain.m_dMaxIssueRct == 0) {
                        EntryMain.m_dMaxIssueRct = dProdOrderQty;
                    }
                }

                sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.BomSize.FieldId);
                document.getElementById(sId).value = DataType.toDecimal(EntryMain.m_dMaxIssueRct, GlobalPref.DecimalsInQty);

                dTotal = 0;
                lstBody = [];
                if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE) { // Production Process
                    result = EntryMainProductionProcess.getProductionOrderDataForIssue(iProdOrder, EntryMain.m_dMaxIssueRct, lstPreferenceOptions, bRetIssue, 0);
                    for (iCounter = 0; iCounter < result.lValue; iCounter++) {
                        result.data.arrTransBody[iCounter].Sales.Quantity *= -1;
                        dTotal = FNumberOperation.add(dTotal, result.data.arrTransBody[iCounter].Sales.OrigGross);
                        //dTotal += result.data.arrTransBody[iCounter].Sales.OrigGross;Bom

                        lstBody.push(result.data.arrTransBody[iCounter]);
                    }
                }

                if (bIssue == true) {
                    result = EntryMainProductionProcess.getProductionOrderDataForIssue(iProdOrder, EntryMain.m_dMaxIssueRct, lstPreferenceOptions, bRetIssue, 0);
                }
                else {
                    result = EntryMainProductionProcess.getProductionOrderDataForReciept(iProdOrder, EntryMain.m_dMaxIssueRct);
                }

                EntryMain.m_objProductionHeader = null;
                if (result.lValue < 1) {
                    return;
                }

                if (bIssue == true) {
                    for (iCounter = 0; iCounter < result.lValue; iCounter++) {
                        lstBody.push(result.data.arrTransBody[iCounter]);
                    }

                    for (iCounter = 0; iCounter < lstBody.length; iCounter++) {
                        lstBody[iCounter].Sales.OrigRate = FConvert.roundOff(lstBody[iCounter].Sales.OrigRate, transEntryCurrency.getGeneralRoundOff(iCounter + 1), transEntryCurrency.getRoundingType(iCounter + 1));
                        lstBody[iCounter].Sales.Quantity = FConvert.round(lstBody[iCounter].Sales.Quantity, transEntryQuantity.getDecimals());
                        lstBody[iCounter].Sales.OrigGross = lstBody[iCounter].Sales.OrigRate * lstBody[iCounter].Sales.Quantity;
                    }
                }
                else {
                    for (iCounter = 0; iCounter < result.data[0].length; iCounter++) {
                        lstBody.push(result.data[0][iCounter]);
                    }

                    EntryMain.m_objProductionHeader = result.data[1];
                }

                if (dTotal != 0) {
                    lstBody[lstBody.length - 1].Sales.OrigRate = dTotal / lstBody[lstBody.length - 1].Sales.Quantity;
                    lstBody[lstBody.length - 1].Sales.OrigGross = lstBody[lstBody.length - 1].Sales.OrigRate * lstBody[lstBody.length - 1].Sales.Quantity;
                }

                if (lstBody.length > 0) {
                    lstRctIssue = [];
                    for (iCounter = 0; iCounter < lstBody.length; iCounter++) {
                        if (transEntryInfo.isItSales == true) {
                            if (DataType.isValidObject(lstBody[iCounter].Sales) == false) {
                                lstRctIssue.push(-1);
                            }
                            else {
                                if ((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE) { // Production Process
                                    if (lstBody[iCounter].Sales.Quantity < 0) {
                                        lstBody[iCounter].Sales.Quantity *= -1;
                                        lstBody[iCounter].Sales.AlternateQuantity *= -1;
                                        lstRctIssue.push(0);
                                    }
                                    else {
                                        lstRctIssue.push(1);
                                    }
                                }

                                //if (transEntryInfo.isInwardVoucher == false) {
                                //    lstBody[iCounter].Sales.Quantity *= -1;
                                //    lstBody[iCounter].Sales.AlternateQuantity *= -1;
                                //    lstBody[iCounter].Sales.BaseQuantity *= -1;
                                //}
                            }
                        }
                    }

                    EntryMainUI.resetBody();
                    arrBodyData = transEntryData.convertBodyObjectToKeyValueArray(lstBody, eConvertTransactionObjectSource.None);
                    if (arrBodyData.length > 0) {
                        sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_RCTISSUESELECTION);
                        for (iCounter = 0; iCounter < lstRctIssue.length; iCounter++) {
                            arrBodyData[iCounter].push({ Key: sId, Value: lstRctIssue[iCounter] });
                        }

                        EntryMain.m_bDataLoading = true;
                        EntryMainUI.displayBodyData(arrBodyData,
                            0,
                            EntryMainBody.getDisplayBodyInput([], false, 0, false, [], eDisplayBodyDataSource.ProdBatchChange));

                        for (iCounter = 0; iCounter < arrBodyData.length; iCounter++) {
                            transEntryGross.calculateAndUpdate({ iRow: iCounter + 1 });
                        }

                        EntryMainUI.setSummaryInfo(0);
                        EntryMain.m_bDataLoading = false;
                        EntryMain.setDirty();

                        EntryMain.m_dRatePreload = lstBody[0].Sales.OrigRate;
                        EntryMain.m_iOutputiItem = lstBody[0].Sales.Product;
                        if (bIssue == false) {
                            EntryMain.m_arrReceiptGross = [];

                            for (iCounter = 0; iCounter < arrBodyData.length; iCounter++) {
                                EntryMain.m_arrReceiptGross.push(EntryMainMemoryObject.getGrossValue(iCounter + 1));
                            }

                            //TRANSACTION_ENTRY.m_dReceiptGross = EntryMainMemoryObject.getGrossValue(1);
                        }

                        //EntryMainCalculation.getNetAmount(0);
                    }
                    this.calculateReceivedRate(1,null);
                }
            }
            else if (transEntryFieldInfo.ProdProcess.FieldId > 0) {
                sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.ProdProcess.FieldId);
                if (transEntryInfo.isEditing == true) {
                    OPTIONCONTROL.setFilter(sId, " iProdOrderId = " + iProdOrder);
                }
                else {
                    //debugger;
                    if (((iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PRREC) || (iVoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.JWREC) {
                        if (bPhantom == "true" || bPhantom == "True" || bPhantom == true) {
                            OPTIONCONTROL.setFilter(sId, " iProdOrderId = " + iProdOrder
                                + " And iProcessId Not In (Select iProcessId From ( " +
                                " Select H2.iProdOrderId, iProcessId, Sum(fProdSize)PSize From tCore_Header_2_" + GlobalPref.YearId + " H2 " +
                                " Join tCore_Header_" + GlobalPref.YearId + " H on H.iHeaderId = H2.iHeaderId " +
                                " Join vMrp_ProdOrder_" + GlobalPref.YearId + " P on P.iProdOrderId = H2.iProdOrderId " +
                                " where H2.iProdOrderId = " + iProdOrder + " and iVoucherClass in (1024, 1536, 2816) " +
                                " Group by iProcessId, H2.iProdOrderId  Having Sum(fProdSize) >= max(p.fQuantity)) as ProdProcessRist )"
                            );
                        }
                        else {
                            OPTIONCONTROL.setFilter(sId, " iProdOrderId = " + iProdOrder
                                + " And iProcessId Not In (Select iProcessId From ( " +
                                " Select H2.iProdOrderId, iProcessId, Sum(fProdSize)PSize From tCore_Header_2_" + GlobalPref.YearId + " H2 " +
                                " Join tCore_Header_" + GlobalPref.YearId + " H on H.iHeaderId = H2.iHeaderId " +
                                " Join vMrp_ProdOrder_" + GlobalPref.YearId + " P on P.iProdOrderId = H2.iProdOrderId " +
                                " where H2.iProdOrderId = " + iProdOrder + " and iVoucherClass in (1024, 1536, 2816) " +
                                " Group by iProcessId, H2.iProdOrderId  Having Sum(fProdSize) >= max(p.fQuantity)) as ProdProcessRist )" +
                                " And iProcessId In (Select iProcessId From (" +
                                " Select H2.iProdOrderId, iProcessId, Sum(fProdSize)PSize From tCore_Header_" + GlobalPref.YearId + " H " +
                                " inner join tCore_Header_2_" + GlobalPref.YearId + " H2 on H.iHeaderId = H2.iHeaderId and H.iVoucherClass in (6656,6912) and h2.iProdOrderId= " + iProdOrder + " group by iProdOrderId,iProcessId) as Issues)"
                            );
                        }
                    }
                    else {
                        OPTIONCONTROL.setFilter(sId, " iProdOrderId = " + iProdOrder
                            + " And iProcessId Not In (Select iProcessId From ( " +
                            " Select H2.iProdOrderId, iProcessId, Sum(fProdSize)PSize From tCore_Header_2_" + GlobalPref.YearId + " H2 " +
                            " Join tCore_Header_" + GlobalPref.YearId + " H on H.iHeaderId = H2.iHeaderId " +
                            " Join vMrp_ProdOrder_" + GlobalPref.YearId + " P on P.iProdOrderId = H2.iProdOrderId " +
                            " where H2.iProdOrderId = " + iProdOrder + " and iVoucherClass in (1024, 1536, 2816) " +
                            " Group by iProcessId, H2.iProdOrderId  Having Sum(fProdSize) >= max(p.fQuantity)) as ProdProcessRist )");

                    }

                    //Var bbb = "(Select iProcessId From ( " +
                    //    " Select H2.iProdOrderId, iProcessId, Sum(fProdSize)PSize From tCore_Header_2_" + GlobalPref.YearId + " H2 " +
                    //    " Join tCore_Header_" + GlobalPref.YearId + " H on H.iHeaderId = H2.iHeaderId " +
                    //    " Join vMrp_ProdOrder_" + GlobalPref.YearId + " P on P.iProdOrderId = H2.iProdOrderId " +
                    //    " where H2.iProdOrderId = 2037 and iVoucherClass in (1024, 1536, 2816) " +
                    //    " Group by iProcessId, H2.iProdOrderId  Having Sum(fProdSize) > Sum(p.fQuantity)) as ProdProcessRist )";
                }

            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainProductionProcess.onProdBatch_Change}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

