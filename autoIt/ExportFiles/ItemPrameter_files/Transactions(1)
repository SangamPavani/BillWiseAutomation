    onRate_Leave: function (element, iRow, objMetaData) {
        let sValue = "";
        let dLastValue = 0;
        let dCurrentValue = 0;

        try {
            sValue = FConvert.toString(element.getAttribute("data-focusvalue"));
            if (objMetaData.bMandatory == true) {
                if (FCommon.String.isNullOrEmpty(sValue) == true) {
                    dLastValue = "";
                }
                else {
                    dLastValue = FConvert.toDecimal(sValue);
                }
            }
            else {
