    getSortedArray: function (arrIds, arrData) {
        let iCounter = 0;
        let iIndex = 0;
        let arrUniqueIds = null;
        let arrValue = [];

        try {
            arrUniqueIds = [];
            for (iIndex = 0; iIndex < arrIds.length; iIndex++) {
                for (iCounter = 0; iCounter < arrUniqueIds.length; iCounter++) {
                    if (arrIds[iIndex] == arrUniqueIds[iCounter]) {
                        break;
                    }
                }

                if (iCounter >= arrUniqueIds.length) {
                    arrUniqueIds.push(arrIds[iIndex]);
                }
            }

            for(iIndex = 0; iIndex < arrUniqueIds.length; iIndex++) {
                for(iCounter = 0; iCounter < arrData.length; iCounter++) {
                    if(arrUniqueIds[iIndex] == arrData[iCounter].Id) {
                        arrValue.push(arrData[iCounter]);
                        break;
                    }
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.getSortedArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrValue);
