                return (false);
            }

            iIndex = DataType.toInt(cell.ColumnAttribute.metadataindex);
            objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
            if (objMetaData.bHidden == true || objMetaData.bReadOnly == true) {
                return (false);
            }

            if (objMetaData.iDataTypeId != eMasterDataType.Number
                && objMetaData.iDataTypeId != eMasterDataType.Fraction
                && objMetaData.iDataTypeId != eMasterDataType.BigNumber
                && objMetaData.iDataTypeId != eMasterDataType.SmallNumber
                    && objMetaData.iDataTypeId != eMasterDataType.TinyNumber) {
                    return (false);
                }


            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE
                || objMetaData.iFieldId == eVTFIELDID.FDF_BODYQUANTITY
                || objMetaData.iFieldId == eVTFIELDID.FDF_BODYGROSS) {
                return (false);
            }

            transEntryGrid.update();

            dValue = DataType.toDecimal(cell.getCellData());

            dGross = DataType.toDecimal(EntryMainPreload.getTotalGrossValue(1));
            if (DataType.gt(dValue, 0)  == true && DataType.gt(dGross, 0) == true) {
                for (iIndex = 1; iIndex <= transEntryGrid.getTotalRows() ; iIndex++) {
                    if (EntryMainBody.isRowEditable(iIndex) == false) {
                        continue;
                    }

                    iLastRow = iIndex;

                    dTemp = DataType.div(dValue, dGross);
                    dTemp = DataType.mul(dTemp, EntryMainMemoryObject.getGrossValue(iIndex));

                    sValue = EntryMain.formatFractionNumber(objMetaData.iFieldId, dTemp, objMetaData.iNoDecimal, iIndex);
                    dTemp = DataType.toDecimal(sValue);
                    transEntryGrid.setCellText(iIndex, iColumn, sValue, dTemp, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, sValue, iIndex, undefined);

                    dSum = DataType.add(dSum, dTemp);
                }

                dSum = DataType.toDecimal(dSum, objMetaData.iNoDecimal);
                dValue = DataType.toDecimal(dValue, objMetaData.iNoDecimal);
            }

            if(DataType.neq(dSum, dValue) == true && iLastRow > 0) {
                dDiff = DataType.sub(dValue, dSum);

                dSum = transEntryGrid.getCellText(iLastRow, iColumn, true, true).value;
                dTemp = DataType.add(dSum, dDiff);
                sValue = EntryMain.formatFractionNumber(objMetaData.iFieldId, dTemp, objMetaData.iNoDecimal, iLastRow);
                dTemp = DataType.toDecimal(sValue);
                transEntryGrid.setCellText(iLastRow, iColumn, sValue, dTemp, true);
                EntryMainMemoryObject.update(objMetaData.iFieldId, sValue, iLastRow, undefined);
            }

            EntryMainUI.setSummaryInfo(0);
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body processCtrlR method.", GlobalPref.getResourceValue("Exception"))
            transEntryGlobal.writeErrorLog("{EntryMainBody.processCtrlR} " + err.message, GlobalPref.getResourceValue("Exception"))
        }

        return (true);
    },

