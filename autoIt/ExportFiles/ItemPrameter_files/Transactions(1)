    // Called from copy document popup
    copyDocumentResult: function (bFlag, Data) {
        let iCounter = 0;
        let iIndex = 0;
        let iBodyId = 0;
        //let bIgnoreBatch = false;
        let bIgnoreRMA = false;
        let bCopiedFromDiffDocs = false
        let bShowHeader = false;
        let bSourceOutward = false;
        let bTargetInward = false;
        let arrBodyData = undefined;
        let arrNewBodyData = undefined;
        let arrNewRowIndex = undefined;
        let arrIgnoreFields = undefined;
        let arrFooterFields = undefined;
        let objData = undefined;
        let objTran = undefined;
        let objFlags = undefined;
        let objFooterData = undefined;

        try {
            if (transEntryGlobal.debugCopyDocument == true || transEntryGlobal.debugCallback == true) {
                debugger
            }

            if (bFlag == false) {
                transEntryGlobal.updateAuditLog(0, null, null, null, true);
                return;
            }

            if (DataType.arrayLength(Data.BodyData) < 1) {
                transEntryGlobal.updateAuditLog(0, null, null, null, true);
                return;
            }

            transEntryGlobal.updateAuditLog(0, null, null, null, true);

            arrBodyData = [];
            for (iIndex = 0; iIndex < Data.BodyData.length; iIndex++) {
                for (iCounter = 0; iCounter < Data.BodyData[iIndex].Tag.length; iCounter++) {
                    arrBodyData.push(Data.BodyData[iIndex].Tag[iCounter]);
                }
            }

            if (arrBodyData.length < 1) {
                return;
            }

            arrIgnoreFields = [];
            arrIgnoreFields.push(eVTFIELDID.FDF_LINK);
            arrIgnoreFields.push(eVTFIELDID.FDF_BATCHRATE);
            arrIgnoreFields.push(eVTFIELDID.FDF_BATCHRATE1);
            arrIgnoreFields.push(eVTFIELDID.FDF_BATCHRATE2);
            arrIgnoreFields.push(eVTFIELDID.FDF_BATCH_QUANTITY);
            arrIgnoreFields.push(eVTFIELDID.FDF_PRODBATCH);            
            arrIgnoreFields.push(eVTFIELDID.FDF_BINS);
            arrIgnoreFields.push(eVTFIELDID.FDF_BINS2);
            arrIgnoreFields.push(eVTFIELDID.FDF_RESERVEQUANTITY);
            arrIgnoreFields.push(eVTFIELDID.FDF_MAXQTYRELEASE);
            arrIgnoreFields.push(eVTFIELDID.FDF_REFERENCE);

            bSourceOutward = FConvert.isItInwardVoucher(Data.HeaderData.VoucherType) == false;
            bTargetInward = FConvert.isItInwardVoucher(transEntryInfo.VoucherType);

            iBodyId = arrBodyData[0].BodyId;
            arrNewBodyData = [];
            for (iCounter = 0; iCounter < arrBodyData.length; iCounter++) {
                arrBodyData[iCounter].BodyId = 0;
                arrBodyData[iCounter].TransactionId = 0;
                arrBodyData[iCounter].BillwiseData = null;
                arrBodyData[iCounter].AuthStatus = _eAuthStatus.Authorized;
                arrBodyData[iCounter].Flags = transactionDataStructure.getBodyFlagsObject();
                if (DataType.isValidObject(arrBodyData[iCounter].Sales) == true) {
                    if (bSourceOutward == true && bTargetInward == true) {
                        //bIgnoreBatch = true;
                        bIgnoreRMA = true;
                    }
                    else {
                        //arrBodyData[iCounter].Sales.BatchNo = null;
                        arrBodyData[iCounter].Sales.RMANos = null;
                    }
                    
                    arrBodyData[iCounter].Sales.Reservation = null;
                    arrBodyData[iCounter].Sales.BinsData = null;
                }

                objData = transEntryData.convertBodyDataClassToKeyValueArray(arrBodyData[iCounter], eConvertTransactionObjectSource.CopyDocument);
                if (DataType.isValidObject(objData) == true) {
                    arrNewBodyData.push(objData);
                }
            }

            //if (bIgnoreBatch == false) {
            //    arrIgnoreFields.push(eVTFIELDID.FDF_BODYBATCHNO);
            //}

            if (bIgnoreRMA == false) {
                arrIgnoreFields.push(eVTFIELDID.FDF_RMANO);
            }

            transEntryGrid.update();

            EntryMain.m_bDataLoading = true;
            arrNewRowIndex = EntryMainUI.displayBodyData(arrNewBodyData,
                                                        EntryMainBody.getNewDataRowIndex() - 1,
                                                        EntryMainBody.getDisplayBodyInput(arrIgnoreFields, 
                                                                                            false, 
                                                                                            0, 
                                                                                            false, 
                                                                                            [], 
                                                                                            eDisplayBodyDataSource.CopyDocument),
                                                                                            []);


            if (arrNewRowIndex.length > 0) {                
                if (transEntryInfo.HeaderId > 0) {
                    objFlags = transEntryInfo.HeaderFlags;

                    objFlags.NoLinkCheck = false;
                    if (transEntryInfo.isItSales == true) {
                        objFlags.NoBatchCheck = false;
                        objFlags.NoBinCheck = false;
                        objFlags.CheckNegativeStock = true;

                        EntryMain.m_bQtyModified = true;
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                }
            }

            EntryMain.m_bDataLoading = false;

            bShowHeader = true;

            bCopiedFromDiffDocs = Data.BodyData.length > 1;
            if (bCopiedFromDiffDocs == true) {
                if (transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgCopyDocFromMultiple")) == false) {
                    bShowHeader = false;
                }
            }

            if (bShowHeader == true) {
                objTran = transactionDataStructure.getTransactionObject();
                objTran.Header = Data.HeaderData;
                objTran.HeaderExtra = Data.HeaderExtra;
                objTran.HeaderDocs = Data.HeaderDocs;
                objTran.BodyData = arrBodyData;

                objTran = transEntryData.convertIntoThinClientObject(objTran, eConvertTransactionObjectSource.CopyDocument);

                EntryMain.m_bBypassRateChangeMessage = true;

                arrIgnoreFields = [];
                arrIgnoreFields.push(eVTFIELDID.FDF_DOCUMENTNO);
                arrIgnoreFields.push(eVTFIELDID.FDF_DATE);
                if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header) {
                    arrIgnoreFields.push(transEntryFieldInfo.ChequeNo.FieldId);
                }

                EntryMainUI.displayHeader(objTran.Header,
                                            0,
                                            false,
                                            false,
                                            arrIgnoreFields,
                                            false,
                                            [], 
                                            eDisplayBodyDataSource.CopyDocument);

                if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header) {
                    EntryMainHeader.validateChequeNo(transEntryFieldInfo.ChequeNo.FieldId);

                    if (DataType.isNullOrEmpty(transEntryFields.getChequeNo(0), true) == true) {
                        EntryMainHeader.setDefaultChequeNo();
                    }
                }

                objFooterData = transEntryServer.execute(eTransServerRequest.LoadFooterData, { iBodyId: iBodyId });
                if (objFooterData.lValue > 0 && objFooterData.data.lValue > 0) {
                    objFooterData = objFooterData.data.data;
                    objFooterData = transEntryData.convertFooterObjectToKeyValueArray(objFooterData, [], eConvertTransactionObjectSource.CopyDocument);

                    arrFooterFields = transEntryFieldInfo.getFooterFields();
                    EntryMainFooter.setFooterData(arrFooterFields, objFooterData);
                }
            }

            EntryMainUI.setSummaryInfo(0);

            EntryMain.setDirty();

            if(transEntryInfo.isAutoSave == true && EntryMain.isDirty() == true) {
                EntryMainUI.autoSave(DataType.arrayToCSV(arrNewRowIndex));
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in copy document result callback." + err.message, GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCallback.copyDocumentResult} " + err.message);
        }

        EntryMain.m_bBypassRateChangeMessage = false;
    },

