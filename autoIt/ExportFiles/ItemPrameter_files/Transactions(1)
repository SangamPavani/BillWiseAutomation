            if(bInitFragment == true) {
                transEntryGridFragment.initFragment(false);
                transEntryGlobal.m_bDisableVariableLog = false;
            }

            if (DataType.isValidObject(objFillDataInput.Output.objOutputTrans) == true && DataType.isValidObject(objFillDataInput.Output.objOutputTrans.BodyData) == true) {
                objFillFinalInput = EntryMainCalculation.getFillFinalInput(true, objFillDataInput.Output.objOutputTrans, objFillDataInput.Output.arrCodeTypes, objFillDataInput.Output.arrBookTypes);
                EntryMainCalculation.fillFinal(objFillFinalInput);
                transEntryGlobal.updateIntermediateData(objFillFinalInput.objTrans, objFillFinalInput.arrCodeTypes, objFillFinalInput.arrBookTypes);

                if (transEntryInfo.BaseVoucherType == eVTTYPE.WDONE
                    && transEntryFieldInfo.BomSize.FieldId > 0
                    && transEntryFields.getBomSize() == 0) {

                    bSpecialCase = true;
                }

                iOrgRow = 0;
                for (iRow = 0; iRow < objFillFinalInput.objTrans.BodyData.length; iRow++) {
                    objBodyData = objFillFinalInput.objTrans.BodyData[iRow];
                    if (objBodyData.Flags.SuspendFA && objBodyData.AuthStatus == _eAuthStatus.Authorized) {
                        continue;
                    }

                    if (objBodyData.Book == objFillFinalInput.objTrans.BodyData[0].Book
                        && objBodyData.RowType != _RowType.RaiseReceipt) {
                        if (bSpecialCase == true) {
                            if (objBodyData.RowType != _RowType.Default) {
                                continue;
                            }

                            if (transEntryInfo.BaseVoucherType == eVTTYPE.WDONE
                                && EntryMainMemoryObject.getRctIssueValue(iOrgRow + 1) == 0) { // Issue Row

                                dTotalNet = FNumberOperation.add(dTotalNet, objBodyData.OriginalAmounts[1]);
                            }
                            else {
                                dTotalNet = FNumberOperation.add(dTotalNet, objBodyData.OriginalAmounts[0]);
                            }

                            iOrgRow++;
                        }
                        else {
                            dTotalNet = FNumberOperation.add(dTotalNet, objBodyData.OriginalAmounts[1]);
                        }
                    }
                }

                if (transEntryInfo.isItTransfer == true) {
                    dTotalNet = FNumberOperation.div(dTotalNet, 2);
                }

                if (transEntryInfo.isItNegative == false) {
                    dTotalNet = FNumberOperation.negated (dTotalNet);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in getNetAmount method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.getNetAmount} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        transEntryGlobal.updateExecutingMethod(eTransMethodExecuting.GetNetAmount, iRowIndex, false);

        return (dTotalNet);
    },

    calculateFooterFields: function () {
        let iCounter = 0;
        let iIndex = 0;
        let dValue = 0;
        let dFormulaValue = 0;
        let objMetaData = undefined;
        objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iRow, null, 0, objMetaData.sFieldName);
        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
        let eleCtrl = undefined;

        try {
            if (DataType.arrayLength(transEntryGlobal.EntryModel.arrMetaDataFooterIndex) < 1) {
                return;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter++) {
                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iIndex];

                if (EntryMain.isDataLoading() == true) {
                    continue;
                }

                if (DataType.isNullOrEmpty(objMetaData.sPreload, true) == true
                    || DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == false) {
                    continue;
                }

                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload.substr(1), 0, null, 0, objMetaData.sFieldName);
                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                dValue = FNumberOperation.toFixed(dFormulaValue, objMetaData.iNoDecimal);
                dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                if (EntryMain.m_bSupportBigNumber == false) {
                    dValue = transEntry.rectifyScreenOutputValue(dValue);
                }

                sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId);
                eleCtrl = document.getElementById(sId);
                if (DataType.isValidObject(eleCtrl) == true) {
                    transEntryFooter.setInputValue(eleCtrl, FNumberOperation.toFixed(dValue, objMetaData.iNoDecimal));
                    bChanged = true;
                }

                switch (objMetaData.FormulaBehaviour) {
                    case eTranEntryFormulaBehaviourFooter.Value:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGross:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, null, 0);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dFormulaValue).multipliedBy(dValue).dividedBy(100).valueOf();
                        }
                        else {
                            dValue = dFormulaValue * dValue / 100;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnNet:  // (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dTotalNetSigned).multipliedBy(dValue).dividedBy(100).valueOf();
                        }
                        else {
                            dValue = dTotalNetSigned * DataType.toDecimal(dValue) / 100;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.Formula:
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sFormula, 0, 0, 0, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dValue = FNumberOperation.convert(objFormulaOutput.Value);

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.NegativeValue:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                        dValue = FNumberOperation.negated(dValue);
                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGrossMinus:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, null, 0);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dFormulaValue = objFormulaOutput.Value;

                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dFormulaValue).multipliedBy(dValue).dividedBy(100).multipliedBy(-1).valueOf();
                        }
                        else {
                            dValue = (DataType.toDecimal(dFormulaValue) * dValue / 100) * -1;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnNetMinus:
                        dValue = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dTotalNet).multipliedBy(dValue).dividedBy(100).multipliedBy(-1).valueOf();
                        }
                        else {
                            dValue = (dTotalNet * DataType.toDecimal(dValue) / 100) * -1;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, EntryMain.m_objTrans.BodyData[0].ExchangeRate);
                        }
                        else if (EntryMain.m_bRoundOff == true) { // Roundoff At Each Stage
                            dValue = FConvert.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);
                        }

                        transEntryFooter.setOutputValue(null, dValue, objMetaData);
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in calculateFooterFields method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.calculateFooterFields} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

