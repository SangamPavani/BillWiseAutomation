                    result.lValue = iCounter + 1;
                    result.data = obj;
                    break;
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;

            transEntryGlobal.writeErrorLog("{EntryMainCommon.findKeyValue} " + err.message, GlobalPref.getResourceValue("Exception"));
