                    if (FNumberOperation.isGreaterThanOrEqualTo(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, FNumberOperation.add(FNumberOperation.add(AdjustedAmt, AdjustBills_Screen.UI.GetOnAccountAmt()), _objAdj.m_dMisAdjAmountTranCurr)), 0)) {
                        if (_objAdj.AdvanceOrAgainstRefAdj == true) {
                            AdjustedAmt = 0;
                        }
                        _objAdj.m_NewRefTransCurr = FNumberOperation.toFixed(FConvert.roundOff(FNumberOperation.sub(_objAdj.m_dTransactionCurrencyAmount, FNumberOperation.add(FNumberOperation.add(AdjustedAmt, AdjustBills_Screen.UI.GetOnAccountAmt()), _objAdj.m_dMisAdjAmountTranCurr)), _objAdj.m_TransactionCurrency.GeneralRoundOff, _objAdj.m_TransactionCurrency.RoundingType), _objAdj.m_TransactionCurrency.NoofDecimals);
                        if (FCommon.UI.isValidObject(_objAdj.m_objBillFilter) == false) {
