                objRuleInput = EntryMainRules.getRuleInputObject(arrTemp, "", false, 0, 0, eRuleEvaluateOn.Save);
                EntryMainRules.applyRule(objRuleInput);
                if(objRuleInput.bDisableSaving == true) {
                    return;
                }
            }
        }

        if (transEntryInfo.Settings.Misc.AskReasonOnEdit == true && transEntryInfo.HeaderId > 0) {
            sValue = await FEntryRemark.show("Save Remarks");
            if (DataType.isNullOrEmpty(sValue, true) == true) {
                return;
