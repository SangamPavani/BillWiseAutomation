                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatch6) + ") Calculate body layout value.");
                }

                if (iDiffWatch7 > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatch7) + ") Calculate body tags and layout value.");
                }

                if (iDiffWatchQty > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatchQty) + ") Calculate quantity value.");
                }

                if (iDiffWatchAltQty > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatchAltQty) + ") Calculate alternate quantity value.");
                }

                if (iDiffWatchRate > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatchRate) + ") Calculate rate value.");
                }

                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString(iDiffWatch) + ") Calculate Body value.");
                }

                objWatch = new FStopWatch();
                objWatch.start();
            }

            EntryMainCalculation.updateLinkedToFooterValue(objInput.iRowIndex);

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Update linked to footer value.");
                }

                objWatch = new FStopWatch();
                objWatch.start();
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];

                if (objMetaData.iDataTypeId == eMasterDataType.Fraction
                && EntryMain.isInSetLoadedData() == false
                && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false
                && DataType.stringIncludesRaw(objMetaData.sDefaultValue.toLowerCase(), "sqlf") == true) {
                    EntryMainHeader.checkAndEvaluateHeaderFormula(objMetaData, false);
                }
            }

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Recalculate header formula fields value.");
                }

                objWatch = new FStopWatch();
                objWatch.start();
            }

            EntryMainCalculation.updateBinsInfo();

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Update bins info value.");
                }

                objWatch = new FStopWatch();
                objWatch.start();
            }

            EntryMainCalculation.fillData_StockTransfer(objInput.Output.objOutputTrans, objInput.Output.arrCodeTypes, objInput.Output.arrBookTypes);

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Create stock transfer rows.");
                }

                for (iCounter = 0; iCounter < arrScreenFieldTime.length; iCounter++) {
                    if (arrScreenFieldTime[iCounter] > 0) {
                        iIndex = arrScreenFieldIndex[iCounter];
                        objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];
                        sValue = "FillData::(" + objWatch.getDifferenceString(arrScreenFieldTime[iCounter]) + ") ";
                        sValue += "Scrren FieldId-" + arrScreenFieldId[iCounter] + "::Name-'" + objMetaData.sFieldName + "'";
                        if (DataType.isNullOrEmpty(objMetaData.sPreload, true) == false) {
                            sValue += "::Preload-(" + objMetaData.sPreload + ")";
                        }

                        if (DataType.isNullOrEmpty(objMetaData.sFormula, true) == false) {
                            sValue += "::Formula-(" + objMetaData.sFormula + ")";
                        }

                        arrTimeLog.push(sValue + " Evaluate total time.");
                    }
                }

                for (iCounter = 0; iCounter < arrTimeLog.length; iCounter++) {
                    transEntryGlobal.writeInfoLog(arrTimeLog[iCounter]);
                }

                debugger
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in fillData method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.fillData} " + err.message, GlobalPref.getResourceValue("Exception"));

            return (false);
        }

        return (true);
    },

