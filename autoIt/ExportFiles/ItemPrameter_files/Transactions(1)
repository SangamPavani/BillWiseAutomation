                        //dvEditScreenData.innerHTML += "<div id='' class='Fcheckbox col-xs-12'><label class='Flabel' style='cursor:pointer;'><input type='checkbox' class='Fchkbox' id='' onclick='SETTINGWIZARD.SetCurrentFormula(this)' data-iFieldId='" + data.Fields[i].ID + "' data-tag='" + JSON.stringify(data.Fields[i].Tag) + "' " + (bChecked ? "checked" : "") + "/>" + data.Fields[i].Name + "</label></div>";
