GetAutoAllocateBATCH: function (arrObjBatch, Id, sCallback, sData) {
    var iCounter = 0;
    var arrBatchParameters = null;
    var selectMastersResult = null;
    var objBatch = null;
    //debugger
    try {
        arrBatchParameters = [];
        for (iCounter = 0; iCounter < arrObjBatch.length; iCounter++) {
            objBatch = arrObjBatch[iCounter];

            if (objBatch.iTagId == undefined) {
                objBatch.iTagId = objBatch.iInvTagValue;
            }

            if (objBatch.bOpenPopup == undefined || objBatch.bOpenPopup == null) {
                objBatch.bOpenPopup = true;
            }

            arrBatchParameters.push(objBatch)
        }

        selectMastersResult = NETWORK.executeServerMethod(GLOBAL.getContextPath("LoadAutoAllocateBatchData", "MRPBatch", "MRP"),
                                                            true,
                                                            { arrobjBatchParams: arrBatchParameters },
                                                            "JSON",
                                                            false);

        if (FCommon.UI.isValidObject(selectMastersResult.data) == true) {
            if (selectMastersResult.data.length > 0) {
                //debugger
                for (var i = 0; i < selectMastersResult.data.length; i++) {
                    selectMastersResult.data[i].MfgDate = selectMastersResult.data[i].MfgDate.Value;
                    selectMastersResult.data[i].ExpDate = selectMastersResult.data[i].ExpDate.Value;
                }
                eval(sCallback)(true, selectMastersResult.data, sData, "");

                return (true);
            }
            else {
                eval(sCallback)(false, null, sData, "");

                return (false);
            }
        }
    }
    catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.GetAutoAllocateBATCH} " + e.message, "Error Message");
    }
},

OnKeyPressEvent: function (txt, evt, iIndex) {
    try {
        ////debugger
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode == 46) {
            //Check if the text already contains the . character
            if (txt.value.indexOf('.') === -1) {
                return true;
            } else {
                return false;
            }

        } else {
            if (charCode > 31
                 && (charCode < 48 || charCode > 57))
                if (charCode <= 96 && charCode >= 105)
                    if (charCode != 110)
                        return false;
        }
        //var ele = document.getElementById(txt.id)
        //MRP_BATCH.arrIssuingList[parseInt(ele.getAttribute("data-irowno")) - 1] = parseFloat(ele.value);
        return true;
    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.OnKeyPressEvent} " + e.message, "Error Message");
    }
},
