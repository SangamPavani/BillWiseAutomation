                        sValue = transEntryGrid.getColumnHeading(transEntryFieldInfo.Code.ColumnIndex);
                        if (DataType.isNullOrEmpty(sValue) == false) {
                            arrColumnNames.push(sValue);

                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                        }
                    }
                }


                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                    sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.Book.FieldId);
