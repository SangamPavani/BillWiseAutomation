            objLinkColumn = transEntryGrid.getCellObject(iRow, iColumn);
            if (DataType.isValidObject(objLinkColumn) == false) {
                return (false);
            }

            for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.Column.Links.length; iCounter++) {
                if (transEntryGlobal.FieldHelper.Column.Links[iCounter] == iColumn) {
                    iSelectedWorkflowIndex = iCounter;
                    break;
