        try {
            var iRow = Id.attributes[10].value;
            var cellObj = FGRIDCONTROL.getCellObject(sGridId, iRow, 0);
            if (FCommon.UI.isValidObject(cellObj) == true) {
                var textbox = document.getElementById("RM_RMANO");
                var m_bIsInword = document.getElementById("m_bIsInword").value;
                if (m_bIsInword == "False" || m_bIsInword == "false") {
                    let bResult = RMA_MainScreen.CheckForValidRMAForPaste(textbox.value, false);
                    if (!bResult) {
                        document.getElementById("RM_RMANO").value = "";
                        return;
                    }
                }
                cellObj.setCellText(textbox.value, textbox.value);
            }

            //var iRow = Id.attributes[10].value;
            let bShow = true;
            if (m_PreviousRowsRMANo != null) {
                if (m_PreviousRowsRMANo.length > 0) {
                    for (var a = 0; a < m_PreviousRowsRMANo.length; a++) {
                        var m_Previous = m_PreviousRowsRMANo[a].Tag;
                        for (var k = 0; k < m_Previous.length; k++) {
                            if (Id.value == m_Previous[k]) {
                                bShow = false;
                                break;
                            }
                        }
                        if (!bShow)
                            break;
                    }
                }
            }
            if (!bShow) {
                FUIElement.showAlert("RMA Number should be unique", "RMA");
                return;
            }
            if (Id.value.length > 0) {
                for (var i = 0; i < ExistingRMA.length; i++) {
                    if (i == iRow - 1)
                        continue;
                    if (ExistingRMA[i] == Id.value) {
                        FUIElement.showAlert("RMA Number should be unique", "RMA");
                        Id.value = '';
                        return;
                    }
                }
            }

            if (ExistingRMA.length >= iRow) {
                if (Id.value.length > 0)
                    ExistingRMA[iRow - 1] = Id.value;
            } else {
                if (Id.value.length > 0)
                    ExistingRMA.push(Id.value);
            }
        } catch (e) {
            FUIElement.showAlert("Exception: RMA_POPUP.Text_onblur " + e.message);
        }
    },
