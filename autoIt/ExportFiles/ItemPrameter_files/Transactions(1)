            else {
                arrData = transEntryGlobal.EntryModel.Data.lstLoadedAccountDetail;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPostingDetails.prepareDataFromExisting} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
