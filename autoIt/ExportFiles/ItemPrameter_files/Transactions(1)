                            for (iCounter = 0; iCounter < EntryMainScheme.m_arrFreeRows.length; iCounter++) {
                                if (EntryMainScheme.m_arrFreeRows[iCounter].ID == lstBody.length - 1) {
                                    EntryMainScheme.m_arrFreeRows.splice(iCounter, 1);
                                    iCounter--;
                                }
                            }


                            objIdNamePair = FocusDataStructs.getIdNamePairObject();
                            objIdNamePair.ID = lstBody.length - 1;
                            objIdNamePair.Name = DataType.toString(EntryMainScheme.m_arrTemp2[0].SchemeId);
                            objIdNamePair.Tag = [];
                            objIdNamePair.Tag.push(EntryMainScheme.m_arrTemp2[0].FromScreen);
                            objIdNamePair.Tag.push(EntryMainScheme.m_arrTemp2[0].BodyId);
                            EntryMainScheme.m_arrFreeRows.push(objIdNamePair);
                            EntryMainScheme.m_objTrans.BodyData = lstBody;

                            if (transEntryFieldInfo.Scheme.ColumnIndex > -1) {
                                objMetaData = transEntryFieldInfo.Scheme.MetaData;

                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = EntryMainScheme.m_arrTemp2[0].SchemeName;

                                EntryMainScheme.m_objTrans.BodyData[EntryMainScheme.m_objTrans.BodyData.length - 1].BodyExtra = [];
                                EntryMainScheme.m_objTrans.BodyData[EntryMainScheme.m_objTrans.BodyData.length - 1].BodyExtra.push(objIdNamePair);

                                cell = transEntryGrid.getCellObject(lstBody.length, transEntryFieldInfo.Scheme.ColumnIndex);
                                cell.setCellText(EntryMainScheme.m_arrTemp2[0].SchemeName, EntryMainScheme.m_arrTemp2[0].SchemeName);
                            }
                        }
                        else {
                            EntryMainScheme.m_arrItems = [];
                            for (iCounter = 0; iCounter < EntryMainScheme.m_arrTemp2.length; iCounter++) {
                                EntryMainScheme.m_arrItems.push(EntryMainScheme.m_arrTemp2[iCounter].ProductName);
                            }

                            EntryMainScheme.openFreeItemPopup(iRow);
                            bCallUpdate = false;

                            //    wndFreeItem objFree = new wndFreeItem(lstItems, Convert.ToDecimal(lstTemp2[0].FreeQty), lstTemp2[0].FreeItemType);
                            //    bool? bRet = objFree.ShowDialog();
                            //    if (bRet == true)
                            //    {
                            //        TRANSACTION_ENTRY.SCHEME.onFreeItems(objFree.Qty, iRow);
                            //        }
                        }
                    } while (EntryMainScheme.m_arrTemp.length > 0);
                }
            }
            else if (DataType.arrayLength(ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts) > 0) {
                //debugger;
                let productExistInSchemes = null;
                for (iCounter = 0; iCounter < EntryMainScheme.m_objTrans.BodyData.length; iCounter++) {
                    if (EntryMainScheme.m_objTrans.BodyData[iCounter].Flags.FreeQty == false) {
                        productExistInSchemes = ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.filter((p) => p.ProductId == EntryMainScheme.m_objTrans.BodyData[iCounter].Sales.Product);
                        if (productExistInSchemes != null && productExistInSchemes != undefined && productExistInSchemes.length > 0) {
                            productExistInSchemes = productExistInSchemes[0];
                            EntryMainScheme.m_objTrans.BodyData[iCounter].Sales.SchemeId = productExistInSchemes.SchemeId;
                            EntryMainScheme.m_objTrans.BodyData[iCounter].Sales.SchemeBodyId = productExistInSchemes.SchemeBodyId;
                        }
                    }
                }

                if (transEntryFieldInfo.Scheme.ColumnIndex > -1) {
                    objMetaData = transEntryFieldInfo.Scheme.MetaData;
                    for (iCounter = 0; iCounter < EntryMainScheme.m_objTrans.BodyData.length; iCounter++) {
                        if (ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts.length > iCounter) {
                            if (DataType.isValidObject(EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra) == true) {
                                for (iIndex = 0; iIndex < EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra.length; iIndex++) {
                                    if (EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra[iIndex].ID == objMetaData.iFieldId) {
                                        EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra[iIndex].Tag = ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts[iCounter].SchemeName;
                                        break;
                                    }
                                }
                            }
                            else {
                                EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra = [];

                                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                                objIdNamePair.ID = objMetaData.iFieldId;
                                objIdNamePair.Name = objMetaData.sFieldName;
                                objIdNamePair.Tag = ERPSCHEMEIMPLEMENTATION.VARIABLES.LinePrompts[iCounter].SchemeName;

                                EntryMainScheme.m_objTrans.BodyData[iCounter].BodyExtra.push(objIdNamePair);
                            }
                        }
                    }
                }
            }

            if (bCallUpdate == true) {
                EntryMainScheme.updateUIData(iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainScheme.applyScheme} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

