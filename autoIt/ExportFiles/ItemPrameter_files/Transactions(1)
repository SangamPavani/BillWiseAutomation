            sLogMessage = "Evaluate: {getVariableValue}[Variable='" + objVar.Var + "'][Row=" + iRowIndex + "][Column=" + objExtra.iColumnIndex + "]";
            if(DataType.isNullOrEmpty(objExtra.CustomData) == false) {
                sLogMessage += "[FieldName='" + objExtra.CustomData + "']";
            }

            if (DataType.isNullOrEmpty(objVar.Var, true) == true) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=0]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (0);
            }

            if (DataType.isNumeric(objVar.Var) == true || (typeof objVar.Var).toLowerCase() == "number") {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + objVar.Var + "]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (DataType.toDecimal(objVar.Var));
            }

            objVar.Var = objVar.Var.toLowerCase();

            iFactor = objVar.Var.indexOf('-') == 0 ? -1 : 1;

            if (iFactor == -1) {
                objVar.Var = objVar.Var.substr(1);
            }

            if (iRowIndex < 1) {
                iRowIndex = 1;
            }

            // {Block Start} Master Variable
            result = EntryMainMaster.processVariable(objVar, iFactor, iRowIndex);
            if (result.lValue > 0) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + result.data + "]" + result.TimeDiff;
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (result.data);
            }
            // {Block End} Master Variable

            result = EntryMainPreload.processScreenBodyVariables(objVar, iFactor, iRowIndex);
            if (result.lValue > 0) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + result.data + "]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (result.data);
            }


            result = EntryMainPreload.processScreenFooterVariables(objVar, iFactor, iRowIndex);
            if (result.lValue > 0) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + result.data + "]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (result.data);
            }

            result = EntryMainPreload.processLayoutVariables(objVar, iFactor, iRowIndex);
            if (result.lValue > 0) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + result.data + "]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (result.data);
            }

            result = EntryMainPreload.processCellVariables(objVar, iRowIndex);
            if (result.lValue > 0) {
                if (transEntryGlobal.m_bDisableVariableLog == false) {
                    sLogMessage += "[Output=" + result.data + "]";
                    transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
                }

                return (result.data);
            }

            iFnNo = 0;
            if (EntryMainCommon.isMatch("^sqlf[\\d]+$", objVar.Var) == true) {
                iFnNo = DataType.toInt(objVar.Var.substr(4));
                objVar.Var = "sqlf";

                bSingleRow = true;
            }

            if (EntryMainCommon.isMatch("^sqlfa[\\d]+$", objVar.Var) == true) {
                iFnNo = DataType.toInt(objVar.Var.substr(5));
                objVar.Var = "sqlfa";
            }

            if (EntryMainCommon.isMatch("^sqlsf[\\d]+$", objVar.Var) == true) {
                iFnNo = DataType.toInt(objVar.Var.substr(5));
                objVar.Var = "sqlsf";
            }

            if (EntryMainCommon.isMatch("^pv[\\d]+$", objVar.Var) == true) {
                iFnNo = DataType.toInt(objVar.Var.substr(2));
                objVar.Var = "pv";
            }


            iRateIndex = 0;
            if (objVar.Var.length > 5 && objVar.Var.indexOf("purrt") != -1 && objVar.Var != "purrtlst" && objVar.Var != "purrtgrp") {
                if(objVar.Var.indexOf("purrtgrp") != -1) {
                    iRateIndex = DataType.toInt(objVar.Var.substr(8, objVar.Var.length - 8));
                    objVar.Var = objVar.Var.substr(0, 8);
                }
                else {
                    iRateIndex = DataType.toInt(objVar.Var.substr(5, objVar.Var.length - 5));
                    objVar.Var = objVar.Var.substr(0, 5);
                }

                if (objVar.arrParams == null) {
                    objVar.arrParams = [];
                }

                if (objVar.arrParams.length == 0) {
                    objVar.arrParams.push(iRateIndex);
                }
            }

            if (objVar.Var.length > 5 && objVar.Var.indexOf("salrt") != -1 && objVar.Var != "salrtlst" && objVar.Var != "salrtgrp") {
                if(objVar.Var.indexOf("salrtgrp") != -1) {
                    iRateIndex = DataType.toInt(objVar.Var.substr(8, objVar.Var.length - 8));
                    objVar.Var = objVar.Var.substr(0, 8);
                }
                else {
                    iRateIndex = DataType.toInt(objVar.Var.substr(5, objVar.Var.length - 5));
                    objVar.Var = objVar.Var.substr(0, 5);
                }

                if (objVar.arrParams == null) {
                    objVar.arrParams = [];
                }

                if (objVar.arrParams.length == 0) {
                    objVar.arrParams.push(iRateIndex);
                }
            }

            if (DataType.stringStartsWithRaw(objVar.Var, "srt") && objVar.arrParams.length == 1) {
                sAbbr = objVar.Var.substr(3);
                objVar.Var = "salrt";
            }
            else if (DataType.stringStartsWithRaw(objVar.Var, "prt") && objVar.arrParams.length == 1) {
                sAbbr = objVar.Var.substr(3);
                objVar.Var = "purrt";
            }

            switch (objVar.Var) {
                case "dt": // Document Date
                    outputValue = EntryMain.m_objTrans.Header.Date;
                    break;
                case "ddt": // Due Date
                    if (iRowIndex > 0) {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].DueDate;
                    }
                    else {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex].DueDate;
                    }
                    break;
                case "td":  // Today
                    outputValue = transEntryInfo.Today;
                    break;
                case "qty": // Quantity
                    outputValue = EntryMainPreload.getQuantityValue(iRowIndex, iFactor);
                    break;
                case "tqty": // Total Quantity
                    if(transEntryGlobal.m_bSavingStart == true) {
                        if(transEntryCache.m_dTotalQty == null) {
                            transEntryCache.m_dTotalQty = EntryMainPreload.getTotalQuantityValue(iFactor);
                        }

                        outputValue = transEntryCache.m_dTotalQty;
                    }
                    else {
                        outputValue = EntryMainPreload.getTotalQuantityValue(iFactor);
                    }
                    break;
                case "qtya":  // Alternate Qty
                    outputValue = EntryMainPreload.getAlternateQuantityValue(iRowIndex, iFactor);
                    break;
                case "tqtya": // Total Alternate Quantity
                    outputValue = EntryMainPreload.getTotalAlternateQuantityValue(iFactor);
                    break;
                case "prodqty": // Production Quantity
                    outputValue = transEntryFields.getBomSize();
                    break;
                case "rt": // Rate
                    //outputValue = EntryMainMemoryObject.getRateValue(iRowIndex);
                    outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].Sales.OrigRate;
                    break;
                case "gr":  // Gross
                    outputValue = EntryMainPreload.getGrossValue(iRowIndex, iFactor);
                    break;
                case "tgr":  // Total Gross
                    if(transEntryGlobal.m_bSavingStart == true) {
                        if(transEntryCache.m_dTotalGross == null) {
                            transEntryCache.m_dTotalGross = EntryMainPreload.getTotalGrossValue(iFactor);
                        }

                        outputValue = transEntryCache.m_dTotalGross;
                    }
                    else {
                        outputValue = EntryMainPreload.getTotalGrossValue(iFactor);
                    }
                    break;
                case "stkv":  // Stock Value
                    obj = EntryMainPreload.getStockRateValue(iRowIndex, false);
                    if (DataType.isValidObject(obj) == false) {
                        outputValue = 0;
                    }
                    else {
                        outputValue = obj.Value;
                    }
                    break;
                case "stkq":  // Stock Quantity
                    if (DataType.arrayLength(objVar.arrParams) == 1) {
                        value = DataType.toInt(objVar.arrParams[0]);
                    }
                    else {
                        value = transEntryFields.getInvTag(iRowIndex);
                    }

                    obj = EntryMainPreload.getStockQuantityValue(iRowIndex, value);
                    if (DataType.isValidObject(obj) == false || obj.lValue < 1) {
                        outputValue = 0;
                    }
                    else {
                        outputValue = obj.data;
                    }
                    break;
                case "stkqa":  // Stock quantity alternate
                    if (DataType.arrayLength(objVar.arrParams) == 1) {
                        value = DataType.toInt(objVar.arrParams[0]);
                    }
                    else {
                        value = transEntryFields.getInvTag(iRowIndex);
                    }

                    obj = EntryMainPreload.getAlternateStockQuantityValue(iRowIndex, value);
                    if (DataType.isValidObject(obj) == false || obj.lValue < 1) {
                        outputValue = 0;
                    }
                    else {
                        outputValue = obj.data;
                    }
                    break;
                case "stkc": // Clear Stock
                    outputValue = EntryMainPreload.getClearStock(iRowIndex);
                    break;
                case "rstk": // Reserved qty
                    if (objVar.arrParams.length == 1) {
                        value = DataType.toInt(objVar.arrParams[0]);
                    }
                    else {
                        value = transEntryFields.getInvTag(iRowIndex);
                    }
                    outputValue = EntryMainPreload.getReservedQuantity(iRowIndex, value);
                    break;
                case "accbal": // FA tagwise code balance
                    outputValue = EntryMainPreload.getAccountBalance(iRowIndex, false);
                    break;
                case "acc2bal": // FA tagwise book balance
                    outputValue = EntryMainPreload.getAccount2Balance(iRowIndex, false);
                    break;
                case "accbalo": // Overall code balance
                    outputValue = EntryMainPreload.getAccountBalance(iRowIndex, true);
                    break;
                case "acc2balo": // Overall book balance
                     outputValue = EntryMainPreload.getAccount2Balance(iRowIndex, true);
                     break;
                case "prod": // Product
                    outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].Sales.Product;
                    break;
                case "clr": // Credit Limit Remaining
                    if (objVar.arrParams.length == 1) {
                        value = DataType.toInt(objVar.arrParams[0]);
                    }
                    else {
                        if (iRowIndex > 0) {
                            value = EntryMain.m_objTrans.BodyData[iRowIndex - 1].FATag;
                        }
                        else {
                            value = EntryMain.m_objTrans.BodyData[iRowIndex].FATag;
                        }
                    }
                    outputValue = EntryMainPreload.getCreditLimitRemaining(iRowIndex, value);
                    break;
                case "odd":
                    outputValue = 0;

                    obj = {};
                    obj.iBookNo = EntryMainMemoryObject.getBookValue(iRowIndex);
                    obj.iVoucherDate = EntryMain.m_objTrans.Header.Date;
                    obj.iFATagValue = EntryMainMemoryObject.getFAValue(iRowIndex);
                    obj.lRefId = 0;

                    result = transEntryServer.execute(eTransServerRequest.CheckOverdueBills, obj);
                    if (result.lValue > 0) {
                        result = result.data;
                        if (result.lValue < 1) {
                            transEntryGlobal.writeErrorLog("Error: {EntryMainCalculation.checkOverDue:Server} " + result.sValue);
                            transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"));                            
                        }

                        if (DataType.arrayLength(result.data) > 0) {
                            outputValue = DataType.toInt(result.data[0].Tag);
                        }
                    }
                    break;
                case "acc":   // Account (Code)
                case "acc2":  // Account2 (Book)
                    outputValue = EntryMainPreload.getCodeOrBookNoValue(iRowIndex, objVar.Var);
                    break;
                case "grpa":  // Account group Id (MasterId and Level are parameters)
                    outputValue = 0;
                    break;
                case "grpp":  // Product group Id (MasterId and Level are parameters)
                    outputValue = 0;
                    break;
                case "exrt":  // Exchange rate
                    if (iRowIndex > 0) {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].ExchangeRate;
                    }
                    else {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex].ExchangeRate;
                    }

                    if (outputValue <= 0) {
                        outputValue = 1;
                    }
                    break;
                case "lexrt": // Local Exchange Rate
                    if (iRowIndex > 0) {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].LocalExchangeRate;
                    }
                    else {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex].LocalExchangeRate;
                    }
                    break;
                case "trt":  // Today's rate
                    outputValue = 0;
                    break;
                case "bnum":
                    outputValue = transEntryBatch.getBatchNo(iRowIndex);
                    break;
                case "btexp": // Batch Expiry Date
                    outputValue = transEntryFields.getEXPDate(iRowIndex);
                    break;
                case "btrt": // Batch Rate
                    outputValue = transEntryBatch.getRate(iRowIndex);
                    break;
                case "btval1":
                    outputValue = transEntryBatch.getRate1(iRowIndex);
                    break;
                case "btval2":
                    outputValue = transEntryBatch.getRate2(iRowIndex);
                    break;
                case "btmfg": // Batch Manufacturing Date
                    outputValue = transEntryFields.getMFGDate(iRowIndex);
                    break;
                case "uncrt": // Unit conversion rate
                    if (objVar.arrParams.length == 1) {
                        outputValue = EntryMainPreload.getUnitConversion(iRowIndex, DataType.toInt(objVar.arrParams[0]));
                    }
                    else {
                        outputValue = transEntryUnit.getConversionValue(iRowIndex, true);
                    }
                    outputValue = FNumberOperation.abs(outputValue);
                    break;
                case "qtyb":  // Qty in base unit
                    outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].Sales.BaseQuantity;
                    outputValue = FNumberOperation.abs(outputValue);
                    break;
                case "crn":  // Currency Id
                    if (iRowIndex > 0) {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex - 1].CurrencyId;
                    }
                    else {
                        outputValue = EntryMain.m_objTrans.BodyData[iRowIndex].CurrencyId;
                    }
                    break;
                case "invtag":
                    outputValue = transEntryInfo.InvTag;
                    break;
                case "fatag":
                    outputValue = transEntryInfo.FATag;
                    break;
                case "tgval": // Tag Value
                    if (objVar.arrParams.length != 1) {
                        outputValue = 0;
                    }
                    else {
                        outputValue = transEntryGrid.getMasterValue(iRowIndex, DataType.toInt(objVar.arrParams[0]));
                    }
                    break;
                case "net":  // Net
                    outputValue = transEntryGrid.getAmount1(iRowIndex);
                    outputValue = FNumberOperation.abs(outputValue);
                    break;
                case "tnet":
                    objWatch = new FStopWatch();
                    objWatch.start();

                    outputValue = EntryMainPreload.getTotalNetValue(false);

                    objWatch.stop();
                    sTimeDiff = "[Time=" + objWatch.getDifferenceString() + "]";
                    break;
                case "neto": // Net in original currency
                    outputValue = transEntryGrid.getOriginalAmount1(iRowIndex);
                    outputValue = FNumberOperation.abs(outputValue);
                    break;
                case "tneto":
                    objWatch = new FStopWatch();
                    objWatch.start();

                    outputValue = EntryMainPreload.getTotalNetValue(true);

                    objWatch.stop();
                    sTimeDiff = "[Time=" + objWatch.getDifferenceString() + "]";
                    break;
                case "amt":
                    value = 0;
                    if (transEntryFieldInfo.Amount.FieldId > 0) {
                        value = EntryMainMemoryObject.getAmountValue(iRowIndex);
                    }
                    else if (transEntryFieldInfo.Debit.FieldId > 0) {
                        value = transEntryFields.getDebit(iRowIndex);
                    }

                    if (value == 0 && transEntryFieldInfo.Credit.FieldId > 0) {
                        value = transEntryFields.getCredit(iRowIndex);
                    }

                    outputValue = value;
                    break;
                case "salrt":  // Selling rate (Price book)
                case "purrt":  // Buying rate (Price book)
                case "salrtgrp":
                case "purrtgrp":
                    if (DataType.arrayLength(objVar.arrParams) == 1) {
                        sLogMessage += "[Index='" + objVar.arrParams[0] + "']";
                    }
                    else if (DataType.arrayLength(objVar.arrParams) == 5) {
                        sLogMessage += "[Index='" + objVar.arrParams[4] + "']";
                    }

                    objResult = EntryMainPreload.getPriceBookRateValue(objVar, sAbbr, iRowIndex);
                    outputValue = objResult.Value;
                    sTimeDiff = objResult.TimeDiff;
                    break;
                case "salrtlst":  // Selling rate Last (Price book)
                case "purrtlst":  // Buying rate Last (Price book)
                    objResult = EntryMainPreload.getPriceBookLastRateValue(objVar, iRowIndex);
                    outputValue = objResult.Value;
                    sTimeDiff = objResult.TimeDiff;
                    break;
                case "rtstk":
                case "rtstklst":  // Stock rate on invtag
                case "rtstknr":
                    obj = EntryMainPreload.getStockRate(iRowIndex, objVar.arrParams);
                    if (DataType.isValidObject(obj) == false) {
                        outputValue = 0;
                    }
                    else {
                        outputValue = FNumberOperation.mul(obj.Internal, iFactor);
                        if (objVar.Var != "rtstknr" && transEntryInfo.Settings.Inventory.DoNotRoundOffRate == false) {
                            outputValue = FConvert.roundOff(outputValue, transEntryCurrency.getGeneralRoundOff(iRowIndex), transEntryCurrency.getRoundingType(iRowIndex));
                        }
                    }
                    break;
                case "prl": // Product reorder level
                    outputValue = EntryMainPreload.getProductReorderLevelValue(iRowIndex);
                    break;
                case "uv0":
                    outputValue = transEntryGlobal.EntryModel.Extras.dUserVals[0] * iFactor;
                    break;
                case "uv1":
                    outputValue = transEntryGlobal.EntryModel.Extras.dUserVals[1] * iFactor;
                    break;
                case "uv2":
                    outputValue = transEntryGlobal.EntryModel.Extras.dUserVals[2] * iFactor;
                    break;
                case "uv3":
                    outputValue = transEntryGlobal.EntryModel.Extras.dUserVals[3] * iFactor;
                    break;
                case "uv4":
                    outputValue = transEntryGlobal.EntryModel.Extras.dUserVals[4] * iFactor;
                    break;
                case "ordrt": // Order rate
                    outputValue = EntryMainPreload.getOrderRateValue(iRowIndex, iFactor);
                    break;
                case "sqlf": // fCore_Var
                case "sqlsf": // fCore_SVar1  
                case "sqlfa":
                    objWatch = new FStopWatch();
                    objWatch.start();

                    iRowIndex--;

                    if (bSingleRow == true) {
                        //objTrans = transEntryData.getFocusFormatData(false, false, iRowIndex + 1);
                        objTrans = transEntryData.getFocusFormatData(true, false, iRowIndex + 1);
                    }
                    else {
                        //objTrans = transEntryData.getFocusFormatData(false, false);
                        objTrans = transEntryData.getFocusFormatData(true, false);
                    }

                    if (objTrans.BodyData.length == 0) {
                        objTrans.BodyData.push(transEntryData.getFocusFormatFirstRowBodyData(false, false));
                    }

                    result = EntryMainPreload.getSQLFunctionValue(objTrans, iFnNo, (bSingleRow == true ? 0 : iRowIndex), objVar.Var);
                    if (DataType.isNullOrEmpty(result.sValue, true) == false) {
                        transEntryGlobal.writeErrorLog("Error: " + objVar.Var + iFnNo + " row no(" + (iRowIndex + 1) + ") - " + result.sValue);
                    }

                    objWatch.stop();
                    sTimeDiff = "[Time=" + objWatch.getDifferenceString() + "]";

                    if (objVar.Var == "sqlsf") {
                        outputValue = result.data;
                    }
                    else if (result.lValue > 0) {
                        outputValue = DataType.toDecimal(result.data);
                    }
                    else {
                        outputValue = 0;
                    }
                    break;
                case "vnum":
                    outputValue = EntryMainPreload.getVoucherNumberValue();
                    break;
                case "brt":
                    outputValue = EntryMainPreload.getBaseVoucherRate(iRowIndex);
                    break;
                case "ln":
                    outputValue = 0;
                    break;
                case "taxcode":
                    outputValue = transEntryVat.getTaxCodeValue(iRowIndex);
                    break;
                case "tce":
                    outputValue = EntryMainMemoryObject.getTaxCodeValue(iRowIndex);
                    if (outputValue == 8 || outputValue == 18 || outputValue == 25) {
                        outputValue = 1;
                    }
                    else {
                        outputValue = 0;
                    }
                    break;
                case "vatdt":
                    if (GlobalPref.Country == "OMN") {
                        if(transEntryVat.isVatApplicable(iRowIndex) == true) {
                            outputValue = 1;
                        }
                        else {
                            outputValue = 0;
                        }

                        break;
                    }

                    outputValue = transEntryDate.getYear() > 2017 ? 1 : 0;
                    break;
                case "vatrt":
                    outputValue = transEntryVat.getVatRate(iRowIndex);
                    break;
                case "slt": // Supplier Lead Time
                    outputValue = EntryMainPreload.getStandardLeadTimeValue(iRowIndex);
                    break;
                case "cbud":
                case "pcbud":
                case "bud":
                case "sbud":
                case "bbud":
                    outputValue = EntryMainPreload.getBudgetValue(iRowIndex, objVar.Var);
                    break;
                case "edep": // Employee Department
                    objResult = EntryMainPreload.getUserDepartment();
                    if (objResult.lValue > 0) {
                        outputValue = objResult.data;
                    }
                    else {
                        outputValue = 0;
                    }
                    break;
                case "skidno":
                    outputValue = EntryMainPreload.getSkidNo(iRowIndex);
                    break;
                case "link":
                    arrLinks = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRowIndex);
                    outputValue = DataType.arrayLength(arrLinks);
                    break;
                case "pv":
                    arrLinks = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRowIndex);
                    if (DataType.arrayLength(arrLinks) > iFnNo) {
                        objResult = EntryMainPreload.getPendingLinkValue(arrLinks[iFnNo].RefId, EntryMain.m_objTrans.BodyData[iRowIndex - 1].TransactionId, arrLinks[iFnNo].LinkId);
                        if (objResult.lValue > 0) {
                            outputValue = objResult.data;
                        }
                    }
                    break;
                case "balstkval": // Balance Stock value
                    outputValue = EntryMainStockRevaluation.getBalanceStockValue(iRowIndex);
                    break;
                case "newstkval": // New Stock Value
                    outputValue = EntryMainStockRevaluation.getNewStockValue(iRowIndex);
                    break;
                case "isissue":
                    outputValue = 0;
                    if (transEntryInfo.BaseVoucherType == eVTTYPE.WDONE
                        && EntryMainMemoryObject.getRctIssueValue(iRowIndex) == 0) { // Issue Row

                        outputValue = 1;
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPreload.getVariableValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        if (transEntryGlobal.m_bDisableVariableLog == false) {
            sLogMessage += "[Output=" + outputValue + "]" + sTimeDiff;
            transEntryGlobal.writeConsoleLog(sLogMessage, "royalblue");
        }

        return(outputValue);
    },

    getStockRate: function (iRow, arrParams) {
        let iProductId = 0;
        let iDate = 0;
        let iWarehouseId = 0;
        let iDepartmentId = 0;
        let lTransactionId = 0;
        let lBatchId = 0;
        let objStock = null;
        let result = null;

        iProductId = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Product;
        iDate = EntryMain.m_objTrans.Header.Date;

        if (DataType.arrayLength(arrParams) > 0) {
            iWarehouseId = DataType.toInt(arrParams[0]);
        }
        else {
            iWarehouseId = transEntryFields.getInvTag(iRow);
        }

        iDepartmentId = EntryMain.m_objTrans.BodyData[iRow - 1].FATag;
        lTransactionId = EntryMain.m_objTrans.BodyData[iRow - 1].TransactionId;

        lBatchId = transEntryBatch.getBatchId(iRow);

        result = transEntryServer.getStockRate(iRow,
                                                iProductId,
                                                iDate,
                                                iWarehouseId,
                                                iDepartmentId,
                                                lTransactionId,
                                                lBatchId,
                                                true,
                                                false,
                                                null,
                                                false,
                                                "");

        if (result.lValue > 0 && result.data.lValue > 0) {
            objStock = result.data.data;
        }

        return (objStock);
    },

    getStockRateValue: function (iRow, bRateOnly) {
        let iProductId = 0;
        let iDate = 0;
        let iWarehouseId = 0;
        let iDepartmentId = 0;
        let lTransactionId = 0;
        let lBatchId = 0;
        let objStock = null;
        let result = null;

        iProductId = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Product;
        iDate = EntryMain.m_objTrans.Header.Date;

        iWarehouseId = transEntryFields.getInvTag(iRow);
