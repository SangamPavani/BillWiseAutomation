                && bExpiryDatesOptional == false
                && iEXPDate < transEntryFields.getMFGDate(iRowCounter)) {

                result.lValue = 0;
                result.sValue = GlobalPref.getResourceValue("msgExpDtCantLessMfgDt");
                result.iRowNo = iRowCounter;

                return (result);
            }

            result.lValue = 1;
        }
