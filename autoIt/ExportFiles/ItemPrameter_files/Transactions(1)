                return (result);
            }

            bExpiryDatesOptional = transEntryInfo.BatchPref.bExpiryDatesOptional;
            if (bExpiryDatesOptional == false) {
                if (transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRowCounter, "bIgnoreExpiryforthisItem", eMasterDataType.Boolean) == true) {
                    bExpiryDatesOptional = true;
                }
            }

