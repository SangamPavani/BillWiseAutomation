    AdjustBills: function (AdjustBills, iCallingType, iReferenceType, iInvoiceDate, iInvoiceTime, bInventoryType, iHeaderId, bHirePurchase, bAllowOnAccount, sInvoiceNo, iFATagId, iVTType, iAccountType, bBeforeAmount, bHideSave, strDocumentName, arrVModified, bAllowLineWise) {
        try {
            debugger

            if (FConvert.isItSales(iVTType & eVTTYPE.VOUCHERMASK) == true || (iVTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.DEBNT || (iVTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.CRDNT) {
                bBeforeAmount = false;
                bAllowLineWise = false;
            }
            var iCounter = 0;
            var iLoop = 0;
            g_Header = strDocumentName;
            iCounter = 0;
            if (bAllowLineWise == false) {
                for (iCounter; iCounter < AdjustBills.length; iCounter++) {
                    if (AdjustBills[iCounter].arrAdjustedReferences != null) {
                        if (AdjustBills[iCounter].arrAdjustedReferences.length > 0) {
                            iLoop = 0;
                            for (iLoop; iLoop < AdjustBills[iCounter].arrAdjustedReferences.length; iLoop++) {
                                AdjustBills[iCounter].arrAdjustedReferences[iLoop].CurrentRow = true;
                            }
                        }
                    }
                }
            }

            g_Index = 0;
            g_iCallingType = iCallingType;
            g_iReferenceType = iReferenceType;
            g_iInvoiceDate = iInvoiceDate;
            g_iInvoiceTime = iInvoiceTime;
            g_bInventoryType = bInventoryType;
            g_iHeaderId = iHeaderId;
            g_bHirePurchase = bHirePurchase;
            g_bAllowOnAccount = bAllowOnAccount;
            g_sInvoiceNo = sInvoiceNo;
            g_iFATagId = iFATagId;
            g_iVTType = iVTType;
            g_iAccountType = iAccountType;
            g_bBeforeAmount = bBeforeAmount;
            g_bHideSave = bHideSave;
            g_bAllowLineWise = bAllowLineWise;
            if (arrVModified.length > 0) {
                g_IsModified = FConvert.toBoolean(true);
            }
            else {
                g_IsModified = FConvert.toBoolean(false);
            }
            if (FConvert.toBoolean(g_IsModified) && (AdjustBills.length > 1) && (iCallingType == CallingType.get("Manual")))
                COMMON.prototype.showMessage(" Modification done after adjustment , click on customer/vendor grid to adjust again. ");

            var objAdjustment = {
            };
            objAdjustment.arrAdjustBills = AdjustBills;
            objAdjustment.CallingType = iCallingType;
            objAdjustment.ReferenceType = iReferenceType;
            objAdjustment.InvoiceDate = iInvoiceDate;
            objAdjustment.InvoiceTime = iInvoiceTime;
            objAdjustment.InventoryType = bInventoryType;
            objAdjustment.HeaderId = iHeaderId;
            objAdjustment.HirePurchase = bHirePurchase;
            objAdjustment.AllowOnAccount = bAllowOnAccount;
            objAdjustment.InvoiceNo = sInvoiceNo;
            objAdjustment.FATagId = iFATagId;
            objAdjustment.VTType = iVTType;
            objAdjustment.AccountType = iAccountType;
            objAdjustment.BeforeAmount = bBeforeAmount;
            objAdjustment.HideSave = bHideSave;
            objAdjustment.Index = g_Index;
            objAdjustment.arrVModified = arrVModified;
            objAdjustment.AllowLineWise = bAllowLineWise;
            objAdjustment = FConvert.toString(objAdjustment);
            // objAdjustment = LZString.compressToBase64(objAdjustment);
            objAdjustment = LZString.compressToUTF16(objAdjustment);
            if (iCallingType == CallingType.get("ALWAYSNEWREF") || iCallingType == CallingType.get("ALWAYSONACCOUNT") || iCallingType == CallingType.get("FIFO")) {
                var pathloc = GLOBAL.getContextPath("AutoBillAdjusment", "TransHome", "Transactions");
                //var result = NETWORK.executeServerMethod(pathloc, true, objAdjustment, "json", true, "AdjustBills_Screen.GetAdjustedBills", null, null, true);
                var result = NETWORK.executeServerMethod(pathloc, true, { objAdjustment1: objAdjustment }, "json", true, "AdjustBills_Screen.GetAdjustedBills", "", "", true);
            }
            else if (((objAdjustment.VTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.CASHR || (objAdjustment.VTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.MEMOR) && transEntryInfo.BodySectionNotRequired == true && objAdjustment.BeforeAmount == true) {
                var pathloc = GLOBAL.getContextPath("AdjustReceiptBills", "TransHome", "Transactions");
                //var result = NETWORK.executeServerMethod(pathloc, true, objAdjustment, "html", true, "AdjustBills_Screen.GetReceiptAdjustedBills", null, null, false);
                var result = NETWORK.executeServerMethod(pathloc, true, { objAdjustment1: objAdjustment }, "html", true, "AdjustBills_Screen.GetReceiptAdjustedBills", null, null, false);

            }
            else if (((objAdjustment.VTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.CASHP || (objAdjustment.VTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.MEMOP) && transEntryInfo.BodySectionNotRequired == true && objAdjustment.BeforeAmount == true) {
                var pathloc = GLOBAL.getContextPath("AdjustReceiptBills", "TransHome", "Transactions");
                //var result = NETWORK.executeServerMethod(pathloc, true, objAdjustment, "html", true, "AdjustBills_Screen.GetReceiptAdjustedBills", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", false);
                var result = NETWORK.executeServerMethod(pathloc, true, { objAdjustment1: objAdjustment }, "html", true, "AdjustBills_Screen.GetReceiptAdjustedBills", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", false);
            }
            else {
                var pathloc = GLOBAL.getContextPath("AdjustmentBills", "TransHome", "Transactions");
                // var result = NETWORK.executeServerMethod(pathloc, true, objAdjustment, "html", true, "AdjustBills_Screen.GetAdjustedBills", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", false);
                var result = NETWORK.executeServerMethod(pathloc, true, { objAdjustment1: objAdjustment }, "html", true, "AdjustBills_Screen.GetAdjustedBills", "GLOBAL.LoadingStart", "GLOBAL.LoadingEnd", false);
            }
        }
        catch (Ex) {
            alert("Exception: AdjustBills " + Ex.message);
        }
