                            value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.RaiseReceipt;

                            if (value.MetaDataIndex > -1) {
                                value.Area = transEntryGlobal.FieldHelper.Area.RaiseReceipt;
                                value.MetaData = transEntryGlobal.EntryModel.MetaData.Header[value.MetaDataIndex];
                                value.FieldId = value.MetaData.iFieldId;
