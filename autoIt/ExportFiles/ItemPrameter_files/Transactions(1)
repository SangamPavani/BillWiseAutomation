TRANSACTION_ENTRY.DATA = {
    // Called for receipt body data when 'Select Bills before Amount' is checked
    getBodyDataForBillReferences: function (iCurrentRow, bIgnoreAmoutValidation) {
        let sId = "";
        let iCounter = 0;
        let result = null;
        let data = null;
        let value = null;
        let objValidateResult = null;
        let objValue = null;
        let objMetaData = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            data = {};
            data.BodyId = transEntryFields.getBodyId(iCurrentRow);
            data.TransactionId = transEntryFields.getTransactionId(iCurrentRow);
            data.Flags = DataType.toString(EntryMainUI.getBodyFlags(iCurrentRow));
            data.AuthStatus = transEntryFields.getAuthStatus(iCurrentRow);

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Body.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iCounter];
                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);


                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        objValue = document.getElementById(sId).value;
                        data[sId] = objValue;
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        objValue = DataType.toInt(document.getElementById(sId).value);
                        objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, 0);
                        if (objValidateResult.lValue < 1) {
                            result.lValue = 0;
                            result.sValue = objValidateResult.sValue;
                            result.data = null;

                            return (result);
                        }

                        data[sId] = objValue;
                        break;
                    case eMasterDataType.Fraction:
                        objValue = DataType.toDecimal(document.getElementById(sId).value);

                        if (objMetaData.iFieldId != eVTFIELDID.FDF_BODYAMOUNT
                            || (objMetaData.iFieldId == eVTFIELDID.FDF_BODYAMOUNT && bIgnoreAmoutValidation == false)) {
                            objValidateResult = EntryMainValidate.validateNumber(objMetaData, objValue, 0);
                            if (objValidateResult.lValue < 1) {
                                result.lValue = 0;
                                result.sValue = objValidateResult.sValue;
                                result.data = null;

                                return (result);
                            }
                        }

                        data[sId] = objValue;
                        break;
                    case eMasterDataType.Boolean:
                        data[sId] = document.getElementById(sId).checked == true ? 1 : 0;
                        break;
                    case eMasterDataType.DateTime:
                        data[sId] = document.getElementById(sId).value;
                        break;
                    case eMasterDataType.Date:
                        value = DATEPICKER.getDate(sId);
                        data[sId] = value;
                        break;
                    case eMasterDataType.Time:
                        value = FTIMECONTROL.getTime(sId);
                        data[sId] = value;
                        break;
                    case eMasterDataType.Picture:
                        data[sId] = document.getElementById(sId).value;
                        break;
                    case eMasterDataType.StringList:
                        element = document.getElementById(sId);
                        if (element.selectedIndex > -1) {
                            data[sId] = element.options[element.selectedIndex].text;
                        }
                        else {
                            data[sId] = "";
                        }
                        break;
                    case eMasterDataType.NumberList:
                        element = document.getElementById(sId);
                        if (element.selectedIndex > -1) {
                            data[sId] = element.options[element.selectedIndex].value;
                        }
                        else {
                            data[sId] = 0;
                        }
                        break;
                    case eMasterDataType.DocumentViewer:
                        data[sId] = document.getElementById(sId).value;
                        break;
                    case eMasterDataType.Master:
                        objValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if (objValue < 1) {
                            switch (objMetaData.iFieldId) {
                                case eVTFIELDID.FDF_BODYCODE:
                                    data = null;
                                    break;
                            }
                        }
                        else {
                            data[sId] = objValue;
                        }

                        break;
                    case eMasterDataType.ExternalTable:
                        value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        data[sId] = value;
                        break;
                }

                if (DataType.isValidObject(data) == false) {
                    break;
                }
            }

            if (DataType.isValidObject(data) == false) {
                result.lValue = 1;
                result.sValue = "";
                result.data = null;

                return (result);
            }

            result.lValue = 1;
            result.data = data;
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = "{TRANSACTION_ENTRY.DATA.getBodyDataForBillReferences} " + err.message;
        }

        return (result);
    }
};

