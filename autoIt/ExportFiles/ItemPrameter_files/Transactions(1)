    isQtyRestricted: function (iRow) {
        try {
            return (false);

            if (transEntryInfo.isInwardVoucher == true) {
                return (false);
            }

            if (transEntryFieldInfo.Bins.FieldId <= 0) {
                return (false);
            }

            if (transEntryFieldInfo.RMA.FieldId <= 0) {
                return (false);
            }

            if (EntryMainMemoryObject.getProductValue(iRow) <= 0) {
                return (false);
            }

            if (transEntryFields.isRequired(transEntryFieldInfo.Bins.FieldId, iRow) == false) {
                return (false);
            }

            if (transEntryFields.isRequired(transEntryFieldInfo.RMA.FieldId, iRow) == false) {
                return (false);
            }

            transEntryGlobal.writeConsoleLog("Quantity restriction found for row:" + iRows, "royalblue", true, "16px");

            return (true);
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.isQtyRestricted} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    isCurrencyChangeRequired: function (iRow, iDefaultCurrency, iAccountTypeId) {
        let objElement = undefined;

        try {
            if (transEntryInfo.ARAPPref.bDependsOnMaintainBillwiseForARAP == false) {
                return (true);
            }

            if (transEntryInfo.ARAPPref.bMaintainARTransactionCurrencies == false
                && transEntryInfo.ARAPPref.bMaintainAPTransactionCurrencies == false) {

                return (true);
            }

            if ((iDefaultCurrency == undefined || iDefaultCurrency == 0)
                && (iAccountTypeId == undefined || iAccountTypeId == 0)) {

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.None) {
                    return (true);
                }

                objElement = EntryMainUI.getElement(transEntryFieldInfo.Book, iRow, true).Value;
                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iDefaultCurrency = DataType.toInt(OPTIONCONTROL.getControlValue(objElement, "iDefaultCurrency"));
                    iAccountTypeId = DataType.toInt(OPTIONCONTROL.getControlValue(objElement, "iAccountTypeId"));
                }
                else if (objElement) {
                    iDefaultCurrency = DataType.toInt(objElement.getAttribute(DataType.stringGetValidDataAttribute("iDefaultCurrency")));
                    iAccountTypeId = DataType.toInt(objElement.getAttribute(DataType.stringGetValidDataAttribute("iAccountTypeId")));
                }
            }

            if (iDefaultCurrency > 0 && EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                return (false);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.isCurrencyChangeRequired} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    applyUIRestriction: function (eUIRestriction, bGridReadOnly) {
        let sCtrlId = "";
        let iCounter = 0;
        let iTotalRows = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let objMetaData = undefined;
        let objExchangeRateInfo = undefined;
        let objLocalExchangeRateInfo = undefined;
        let objChequeNoInfo = undefined;
        let eleCtrl = undefined;
        let obj = undefined;

        try {
            transEntryGlobal.arrHeaderReadOnly = [];
            transEntryGlobal.arrBodyReadOnly = [];
            transEntryGlobal.m_iUIRestriction = eUIRestriction;

            objExchangeRateInfo = transEntryFieldInfo.ExchangeRate;
            objLocalExchangeRateInfo = transEntryFieldInfo.LocalExchangeRate;
            objChequeNoInfo = transEntryFieldInfo.ChequeNo;

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                if (objMetaData.iDataTypeId == eMasterDataType.Master && objMetaData.iMasterTypeId > 0) {
                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PickConfirmation:
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            OPTIONCONTROL.disableControl(sCtrlId, true);
                            break;
                        case eTranEntryUIRestriction.PDCHeader:
                            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE) {
                                transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                                sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                                OPTIONCONTROL.disableControl(sCtrlId, true);
                            }
                            else if (objMetaData.iFieldId == eVTFIELDID.FDF_BOOKNO) {
                                transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                                sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                                OPTIONCONTROL.disableControl(sCtrlId, true);
                            }

                            break;
                    }
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_DATE) {
                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PickConfirmation:
                        case eTranEntryUIRestriction.ChequeReturn:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            DATEPICKER.disableControl(sCtrlId, true);
                            break;
                        case eTranEntryUIRestriction.PDCBody:
                            if (objMetaData.iFieldId == eVTFIELDID.FDF_DUEDATE) { // Maturity Date
                                transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                                sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                                DATEPICKER.disableControl(sCtrlId, true);
                            }
                            break;
                    }
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PickConfirmation:
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCHeader:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            OPTIONCONTROL.disableControl(sCtrlId, true);
                            break;
                    }
                }
                else if (objExchangeRateInfo.Area == eTranEntryFieldArea.Header
                    && iCounter == objExchangeRateInfo.MetaDataIndex) {
                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PickConfirmation:
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCHeader:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            eleCtrl.readOnly = true;
                            transEntryControl.setBackgroundColor(eleCtrl, "rgb(235, 235, 228)");
                            break;
                    }
                }
                else if (objLocalExchangeRateInfo.Area == eTranEntryFieldArea.Header
                    && iCounter == objLocalExchangeRateInfo.MetaDataIndex) {

                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PickConfirmation:
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCHeader:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            eleCtrl.readOnly = true;
                            transEntryControl.setBackgroundColor(eleCtrl, "rgb(235, 235, 228)");
                            break;
                    }
                }
                else if (objChequeNoInfo.Area == eTranEntryFieldArea.Header
                    && iCounter == objChequeNoInfo.MetaDataIndex) {

                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCHeader:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            transEntryChequeNo.disableControl(true);
                            break;
                    }
                }
                else if (transEntryFieldInfo.PDCNo.Area == eTranEntryFieldArea.Header
                    && iCounter == transEntryFieldInfo.PDCNo.MetaDataIndex) {

                    if (objMetaData.bReadOnly == true) {
                        continue;
                    }

                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.ChequeReturn:
                        case eTranEntryUIRestriction.PDCHeader:
                        case eTranEntryUIRestriction.PDCBody:
                            transEntryGlobal.arrHeaderReadOnly.push(iCounter);
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            eleCtrl.readOnly = true;
                            transEntryControl.setBackgroundColor(eleCtrl, "rgb(235, 235, 228)");
                            break;
                    }
                }
            }

            if (bGridReadOnly == true) {
                iTotalRows = transEntryGrid.getTotalRows();
                for (iCounter = 1; iCounter <= iTotalRows; iCounter++) {
                    transEntryGrid.markRowReadOnly(iCounter, true);
                }
            }

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                obj = arrFields[iCounter];
                objMetaData = obj.MetaData;
                if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                    continue;
                }

                if (objMetaData.bReadOnly == true) {
                    continue;
                }

                if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYCURRENCY) {
                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PDCHeader:
                            transEntryGlobal.arrBodyReadOnly.push(obj.MetaDataIndex);
