    onControlLeave: function (ele, evt) {
        let iFieldId = 0;
        let iCounter = 0;
        let iIndex = 0;
        let iColumnIndex = 0;
        let iMetaDataIndex = 0;
        let iDataTypeId = 0;
        let iDecimalPlaces = 0;
        let objFieldMetaData = null;
        let objMetaData = null;
        let objLinkDef = null;
        let objFieldInfo = undefined;
        let lastvalue = null;
        let bChanged = false;
        let FieldArea = null;
        let obj = null;

        try {
            if (transEntryGlobal.debugHeader == true) {
                debugger
            }

            iFieldId = DataType.toInt(FUIElement.getAttribute(ele, "ifieldid"));
            if (iFieldId == 0) {
                iFieldId = EntryMainUI.extractHeaderFieldId(ele.id);
            }

            FieldArea = eTranEntryFieldArea.None;
            objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId, eTranEntryFieldArea.Header);
            iIndex = objFieldInfo.MetaDataIndex;
            if (objFieldInfo.FieldId > 0) {
                objFieldMetaData = objFieldInfo.MetaData;
                FieldArea = objFieldInfo.Area;

                if(objFieldMetaData.iFieldId != eVTFIELDID.FDF_DATE) {
                    EntryMain.m_DocDate = EntryMain.m_objTrans.Header.Date;
                }
            }
            else if (transEntryInfo.BodySectionNotRequired == true) {
                objFieldInfo = EntryMainUI.getBodyFieldInfo(iFieldId);

                iIndex = objFieldInfo.MetaDataIndex;
                objFieldMetaData = objFieldInfo.MetaData;
                if (iIndex >= 0) {                    
                    FieldArea = eTranEntryFieldArea.Body;
                }
            }

            iDataTypeId = FUIElement.getAttribute(ele, "datatypeid");
            if (DataType.isValidObject(iDataTypeId) == true) {
                iDataTypeId = DataType.toInt(iDataTypeId);
                switch (iDataTypeId) {
                    case eMasterDataType.Text:
                    case eMasterDataType.Number:
                    case eMasterDataType.Fraction:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        if (iDataTypeId == eMasterDataType.Fraction) {
                            if (DataType.isValidObject(objFieldMetaData) == true && objFieldMetaData.bMandatory == true && DataType.toString(ele.value) == "") {
                                ele.value = "";
                            }
                            else if (FUIElement.hasDataAttribute(ele, "data-decimalplaces", true) == true) {
                                iDecimalPlaces = DataType.toInt(ele.getAttribute("data-decimalplaces"));
                                ele.value = DataType.toDecimal(ele.value, iDecimalPlaces);
                            }
                        }
                        lastvalue = ele.getAttribute("data-lastvalue");
                        if(iDataTypeId == eMasterDataType.Text) {
                            if (lastvalue != null && DataType.toString(lastvalue) != DataType.toString(ele.value)) {
                                bChanged = true;
                            }
                        }
                        else {
                            if (lastvalue != null && DataType.neq(lastvalue, ele.value) == true) {
                                bChanged = true;
                            }
                        }

                        break;
                    case eMasterDataType.NumberList:
                        lastvalue = ele.getAttribute("data-lastvalue");
                        if (ele.selectedIndex > -1 && lastvalue != ele.options[ele.selectedIndex].value) {
                            bChanged = true;
                        }
                        break;
                }
            }

            if (FieldArea == eTranEntryFieldArea.Header) {
                if(objFieldMetaData.iFieldId == eVTFIELDID.FDF_DATE) {
                    obj = {};
                    obj.iLastDate = EntryMain.m_DocDate;
                    obj.iDate = DATEPICKER.getDate(ele);

                    if(DataType.isZero(obj.iLastDate) == true) {
                        obj.iLastDate = DATEPICKER.getFocusValue(ele);
                    }

                    if (EntryMainUI.isReservationRestrictd() == true && obj.iDate != obj.iLastDate) {
                        transEntryGlobal.showAlert("This document is already used in link voucher. Due to reservation date cannot be changed.", GlobalPref.getResourceValue("Warning"));

                        DATEPICKER.setDate(ele, obj.iLastDate);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, obj.iLastDate);

                        return;
                    }

                    if (obj.iDate < EntryMain.m_iAccountingDate
                        && EntryMainValidate.canDocumentDateBeLessThanAccountingDate(transEntryInfo.VoucherType) == false) {

                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDateLessAccDate"), GlobalPref.getResourceValue("Warning"));

                        if (obj.iLastDate < EntryMain.m_iAccountingDate) {
                            obj.iLastDate = EntryMain.m_iAccountingDate;
                        }
                        DATEPICKER.setDate(ele, obj.iLastDate);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_DATE, obj.iLastDate);

                        return;
                    }

                    if(EntryMainHeader.onDate_Change(ele, obj.iDate, obj) == false) {
                        return;
                    }
                }

                if(objFieldMetaData.iFieldId == eVTFIELDID.FDF_DUEDATE) {
                    obj = {};
                    obj.iLastDate = DATEPICKER.getFocusValue(ele);
                    obj.iDate = DATEPICKER.getDate(ele);

                    if (DataType.neq(obj.iLastDate, obj.iDate) == true) {                        
                        transEntryDueDate.onChange(0);
                    }

                    EntryMainMemoryObject.update(eVTFIELDID.FDF_DUEDATE, obj.iDate, 0);
                }

                if (bChanged == true && objFieldMetaData.iFieldId == eVTFIELDID.FDF_EXCHANGERATE) {
                    if (EntryMainUI.isBillStatusRestricted(0, objFieldMetaData.iFieldId, objFieldMetaData) == true) {
                        iDecimalPlaces = DataType.toInt(ele.getAttribute("data-decimalplaces"));
                        ele.value = DataType.toDecimal(lastvalue, iDecimalPlaces);

                        transEntryGlobal.showAlert("This document is already adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "' . Due to this field '" + objFieldMetaData.sFieldName + "' cannot be changed.", GlobalPref.getResourceValue("Warning"));

                        return;
                    }

                    if (EntryMainUI.isLinkRestrictd(0, objFieldMetaData.iFieldId, true).Value == true) {
                        iDecimalPlaces = DataType.toInt(ele.getAttribute("data-decimalplaces"));
                        ele.value = DataType.toDecimal(lastvalue, iDecimalPlaces);

                        transEntryGlobal.showAlert("This document is already used in link voucher. Due to this field '" + objFieldMetaData.sFieldName + "' cannot be changed.", GlobalPref.getResourceValue("Warning"));

                        return;
                    }
                }

                if (objFieldMetaData.iFieldId == eVTFIELDID.FDF_BOMSIZE && bChanged == true) {
                    lastvalue = ele.getAttribute("data-lastvalue");
                    EntryMainProductionProcess.onBomSize_Leave(ele,0,lastvalue);
                }

                if (EntryMainValidate.isNumberOverflow(objFieldMetaData.iDataTypeId, ele.value) == true) {
                    ele.value = 0;
                }

                switch (objFieldMetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, ele.value, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.Fraction:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, ele.value, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Picture:
                    case eMasterDataType.DocumentViewer:
                        obj = FATTACHMENTCONTROL.getData(ele);
                        if (obj.lValue > 0) {
                            obj = obj.data;
                        }
                        else {
                            obj = undefined;
                        }
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Boolean:
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, ele.checked, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Master:
                    case eMasterDataType.ExternalTable:
                        obj = DataType.toInt(OPTIONCONTROL.getControlValue(ele));
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Date:
                        obj = DATEPICKER.getDate(ele);
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.Time:
                        obj = FTIMECONTROL.getTime(ele);
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.HyperLink:
                        obj = FHyperLink.getValue(ele);
                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                    case eMasterDataType.StringList:
                    case eMasterDataType.NumberList:
                        if (ele.selectedIndex < 0) {
                            obj = undefined;
                        }
                        else {
                            obj = ele.value;
                        }

                        EntryMainMemoryObject.update(objFieldMetaData.iFieldId, obj, 0, objFieldMetaData);
                        break;
                }
            }
            else if (FieldArea == eTranEntryFieldArea.Body) {
                if (EntryMainValidate.isNumberOverflow(objFieldMetaData.iDataTypeId, ele.value) == true) {
                    ele.value = 0;
                }
            }

            if (iFieldId == eVTFIELDID.FDF_EXCHANGERATE
                && transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Header) {
                transEntryExchangeRate.onLeaveH(ele, evt);
                if (bChanged == true && EntryMain.isDataLoading() == false) {
                    EntryMainUI.updateFlag(iFieldId);
                    if (transEntryFieldInfo.Billwise.FieldId > 0) {
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
                        }
                        else {
                            EntryMainBillwise.updateDirtyRowFlag(0, iFieldId);
                        }
                    }

                    EntryMainUI.valueChanged(objFieldMetaData, 0, 0);
                }
            }
            else if (iFieldId == eVTFIELDID.FDF_LOCEXCHANGERATE
                && transEntryFieldInfo.LocalExchangeRate.Area == eTranEntryFieldArea.Header) {

                ele.value = DataType.toDecimal(ele.value, transEntryExchangeRate.getDecimals());
                if (bChanged == true && EntryMain.isDataLoading() == false
                    && transEntryFieldInfo.Billwise.FieldId > 0) {

                    if (transEntryInfo.BodySectionNotRequired == true) {
                        TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
                    }
                    else {
                        EntryMainBillwise.updateDirtyRowFlag(0, iFieldId);
                    }
                }
            }
            else if (iFieldId == eVTFIELDID.FDF_BODYAMOUNT) {  // For 'Select Bills before Amount' Receipt
                if (bChanged == true && EntryMain.isDataLoading() == false
                    && transEntryFieldInfo.Billwise.FieldId > 0) {

                    // EntryMainBillwise.updateDirtyRowFlag(0);
                }
            }
            else if (transEntryFieldInfo.AppropriateOn.Area == eTranEntryFieldArea.Header
                && iFieldId == transEntryFieldInfo.AppropriateOn.FieldId) {

                if (bChanged == true && EntryMain.isDataLoading() == false) {
                    EntryMainCalculation.calculateAndUpdateAddValue();
                }
            }
            else if (transEntryFieldInfo.AdditionalValue.Area == eTranEntryFieldArea.Header
                && iFieldId == transEntryFieldInfo.AdditionalValue.FieldId) {

                if (bChanged == true && EntryMain.isDataLoading() == false) {
                    EntryMainCalculation.calculateAndUpdateAddValue();
                }
            }
            else if (iFieldId == eVTFIELDID.FDF_DATE) {
                EntryMainHeader.onDocumentDate_KillFocus(ele, evt);
            }

            if (EntryMainCommon.checkRegularExpression(objFieldMetaData, transEntryControl.getControlValue(ele, objFieldMetaData)) == false) {
                transEntryControl.clearControlValue(ele, objFieldMetaData);
            }

            if (bChanged == true) {
                EntryMainHeader.processIfInvoiceNo(objFieldMetaData, ele, evt);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.arrMetaDataBodyIndex) == true) {
                // Get array of body column index of link column
                for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.Column.Links.length; iCounter++) {
                    iColumnIndex = transEntryGlobal.FieldHelper.Column.Links[iCounter]; // Get body link column index
                    iMetaDataIndex = transEntryGlobal.FieldHelper.MetaData.Links[iCounter]; // Get meta data index 
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iMetaDataIndex];

                    objLinkDef = objMetaData.Tag;
                    if (DataType.isValidObject(objLinkDef) == true && objLinkDef.LoadField == iFieldId && objLinkDef.LoadPendingDoc == 1) {
                        EntryMainUI.loadLinkOnFieldLeave(ele.value, objMetaData, iColumnIndex);
                    }
                }
            }

            EntryMainCommon.checkEntryValidation(objFieldMetaData, 0);

            EntryMainHeader.processIfLastField(ele, evt);

            EntryMainHeader.applyRuleOnLostFocus(iFieldId);

            if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                && DataType.isValidObject(objFieldMetaData) == true
                && DataType.arrayLength(objFieldMetaData.ArrExternalModules) > 0) {
                transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnLeave, objFieldMetaData.iFieldId, objFieldMetaData.sFieldName, 0);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onControlLeave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

