                        objValue = EntryMain.formatFractionNumber(objMetaData.iFieldId, value, objMetaData.iNoDecimal, cell.iRow);
                        cell.setCellText(DataType.addNumericSeparator(objValue, transEntryCurrency.getNumericSeparator(cell.iRow)), objValue);
                        cell.setCellData(objValue);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objValue, cell.iRow, objMetaData);
                        if (objMetaData) {
                            switch (objMetaData.iFieldId) {
                                case eVTFIELDID.FDF_BODYGROSS:
                                    if (DataType.neq(LastValue, objValue) == false) {
                                        break;
                                    }

                                    if (transEntryFieldInfo.Rate.ColumnIndex > -1
                                        && transEntryFieldInfo.Qty.ColumnIndex > -1
                                        && transEntryFieldInfo.Rate.MetaData.bHidden == false
                                        && transEntryFieldInfo.Qty.MetaData.bHidden == false) {

                                        transEntryGross.recalculateQtyAndRate(LastValue, objValue, cell);

                                        EntryMainProductionProcess.updateRate(cell.iRow);
                                        transEntryGross.calculateAndUpdate({ iRow: cell.iRow });
                                        EntryMainProductionProcess.calculateReceivedRate(cell.iRow);
                                    }
                                    break;
                            }
                        }
                    }
                    break;
                case eMasterDataType.BigNumber:
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        eleControl = document.getElementById(sCtrlId);
                        if (DataType.isValidObject(eleControl) == true) {
                            eleControl.value = value;
                        }
                    }
                    else {
                        cell.setCellText(value, value);
                    }
                    break;
                case eMasterDataType.Boolean:
                    if (transEntryInfo.BodySectionNotRequired == true) {
                    }
                    else {
                        value = DataType.toInt(value);
                        EntryMainBody.initBooleanColumn(cell, value == 1 ? true : false, objMetaData.bReadOnly);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, cell.iRow, objMetaData);
                    }
                    break;
                case eMasterDataType.Text:
                    value = DataType.toString(value);
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        eleControl = document.getElementById(sCtrlId);
                        if (DataType.isValidObject(eleControl) == true) {
                            eleControl.value = value;
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 1, objMetaData);
                    }
                    else {
                        cell.autoHeight(false);
                        cell.setCellText(value, value);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, cell.iRow, objMetaData);
                    }
                    break;
                case eMasterDataType.Date:
                    value = DataType.toInt(value);
                    sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        DATEPICKER.setDate(sCtrlId, value);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 1, objMetaData);
                    }
                    else {
                        cell.setCellText(DATEPICKER.convertDateIntoString(sCtrlId, value), value);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, cell.iRow, objMetaData);
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body updateCellValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.updateCellValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
