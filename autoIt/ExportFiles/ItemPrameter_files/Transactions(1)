        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.changeSubLedgerH} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    changeInvTag: function (iRow, iFieldId) {
        let iLPGenerationType = 0;
        let iIssueInvTagFieldId = 0;

        try {
            if (transEntryInfo.isItTransfer == true) {
                iIssueInvTagFieldId = transEntryFieldInfo.IssueInvTag.FieldId;
                if (iIssueInvTagFieldId == 0) {
                    return;
                }

                if (iFieldId == iIssueInvTagFieldId) {
                    EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                    EntryMainUI.clear(transEntryFieldInfo.Bins, iRow);
                    EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow);
                    EntryMainUI.clear(transEntryFieldInfo.RMA, iRow);
                    EntryMainUI.clear(transEntryFieldInfo.Reservation, iRow);
                }
                else {
                    EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow);
                }

                return;
            }

            if (transEntryInfo.isInwardVoucher == false || transEntryInfo.BaseVoucherType == eVTTYPE.SARET) {
                EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                EntryMainUI.clear(transEntryFieldInfo.RMA, iRow);
            }
            else if (transEntryInfo.BaseVoucherType == eVTTYPE.WDONE) { // Production Process
                if (transEntryInvTag.getArea() == eTranEntryFieldArea.Header) {
                    EntryMainUI.clear(transEntryFieldInfo.BatchNo, 0);
                    EntryMainUI.clear(transEntryFieldInfo.RMA, 0);
                }
                else if (transEntryInvTag.getArea() == eTranEntryFieldArea.Body
                    && EntryMainMemoryObject.getRctIssueValue(iRow) == 0) { // Issue row

                    EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                    EntryMainUI.clear(transEntryFieldInfo.RMA, iRow);
                }
            }

            EntryMainUI.clear(transEntryFieldInfo.Bins, iRow);
            EntryMainUI.clear(transEntryFieldInfo.Bins2, iRow);
            EntryMainUI.clear(transEntryFieldInfo.Reservation, iRow);
            EntryMainUI.clear(transEntryFieldInfo.MaxQtyRelease, iRow);

            if (transEntryFieldInfo.Skid.FieldId > 0 && transEntryFieldInfo.LPMaster.FieldId > 0) {
                if (iRow > 0) {
                    iLPGenerationType = EntryMainUI.getLPGenerationType(iRow);
                    if (iLPGenerationType == 2) { // (Warehouse Wise LP Generation)
                        EntryMainUI.clear(transEntryFieldInfo.LPMaster, iRow);
                        EntryMainUI.clear(transEntryFieldInfo.Skid, iRow);
                    }
                }
                else {
                    for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                        iLPGenerationType = EntryMainUI.getLPGenerationType(iRow);
                        if (iLPGenerationType == 2) { // (Warehouse Wise LP Generation)
                            EntryMainUI.clear(transEntryFieldInfo.LPMaster, iRow);
                            EntryMainUI.clear(transEntryFieldInfo.Skid, iRow);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.changeInvTag} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onUnit_Enter: function (cellobj, iPreloadValue, objMetaData, evt) {
        let iValue = 0;

        try {
            iValue = DataType.toInt(cellobj.getCellData());
            if (iValue == 0) {
                iValue = iPreloadValue;
            }

            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                iValue = transEntryUnit.initControl(cellobj.iRow, iValue);
            }
            else if (objMetaData.iDataTypeId == eMasterDataType.Master && objMetaData.iMasterTypeId == eMasterTypeId.Units) {
                iValue = transEntryUnit.initControl(cellobj.iRow, iValue, objMetaData.iFieldId);
            }
            else {
                iValue = -1;
            }

            if (iValue < 0) {
                cellobj.processDefault(evt, false, true);
                return;
            }

            cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iValue);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onUnit_Enter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onUnit_Leave: function (cellobj, iFieldId) {
        let iLastValue = 0;
        let iCurrentValue = 0;
        let dValue = 0;
        let dAvailableQty = 0;
        let bMasterChanged = false;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objMetaData = undefined;
        let objFlags = undefined;
        let data = undefined;

        try {
            iLastValue = DataType.toInt(cellobj.getCellData());

            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
            iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);

            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYUNITS, iCurrentValue, cellobj.iRow);
            bMasterChanged = iCurrentValue != iLastValue;

            OPTIONCONTROL.setUnit(cellobj.ColumnAttribute.ctrlid, 0, 0);

            if (EntryMainMemoryObject.getProductValue(cellobj.iRow) == 0 || transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, cellobj.iRow, "iDefaultBaseUnit", eMasterDataType.Number) == 0) {
                cellobj.clear();
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYUNITS, 0, cellobj.iRow);
            }

            if (bMasterChanged == true) {
                if (EntryMain.m_dRatePreload == 0) {
                    if (transEntryInfo.Settings.Inventory.DontRefreshRate == false) {
                        if (transEntryRate.hasFormula() == true) {
                            objMetaData = transEntryFieldInfo.Rate.MetaData;
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, cellobj.iRow, null, transEntryFieldInfo.Rate.ColumnIndex, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            dValue = DataType.toDecimal(objFormulaOutput.Value);
                            transEntryRate.update(dValue, cellobj.iRow);
                            transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow });
                        }
                        else {
                            EntryMainUI.clear(transEntryFieldInfo.Rate, cellobj.iRow);
                        }
                    }
                }

                if (transEntryFieldInfo.BatchNo.ColumnIndex > -1
                    // Only production process issue row is exception for inward voucher
                    && (transEntryInfo.isInwardVoucher == false || EntryMainProductionProcess.isIssueRow(cellobj.iRow) == true)) {
                    dAvailableQty = transEntryBatch.getAvailableQty(cellobj.iRow);

                    if (transEntryFields.getTransactionId(cellobj.iRow) != 0
                        || transEntryQuantity.getBaseValue(cellobj.iRow) > dAvailableQty) {

                        EntryMainUI.clear(transEntryFieldInfo.BatchNo, cellobj.iRow);
                    }
                }

                EntryMainUI.clear(transEntryFieldInfo.MaxQtyRelease, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Reservation, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Bins, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Bins2, cellobj.iRow);

                data = EntryMainWorkflow.isLinkValueChanges(eVTFIELDID.FDF_BODYUNITS, cellobj.iRow);
                //if (data.arrIndex.length > 0 && transEntryInfo.HeaderId > 0) {
                if (transEntryInfo.HeaderId > 0) {
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoLinkCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onUnit_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onCode_Leave: function (cellobj, iFieldId) {
        let iCodeAccountType = 0;
        let iBookAccountType = 0;
        let iDefaultCurrency = 0;
        let iLastValue = 0;
        let iCurrentValue = 0;
        let bMasterChanged = false;
        let data = null;
        let value = 0;
        let iBookNo = 0;
        let bIsLastPartyType = false;

        try {
            iLastValue = DataType.toInt(cellobj.getCellData());
            bIsLastPartyType = EntryMainBody.isLastValueOfCustomerVendorType(cellobj);

            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);

            value = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);
            if (value > 0) {
                iCodeAccountType = DataType.toInt(cellobj.getCellData("iAccountTypeId"));
                if ((transEntryInfo.BaseVoucherType == eVTTYPE.DEBNT || transEntryInfo.BaseVoucherType == eVTTYPE.CRDNT || transEntryInfo.isItSales == true)
                    && EntryMainCommon.isPartyType(iCodeAccountType) == true) {

                    transEntryGlobal.showAlert("Body cannot has party type account for this type voucher.", GlobalPref.getResourceValue("Error"));
                    cellobj.clear();

                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, 0, cellobj.iRow);

                    return (false);
                }


                if (EntryMainValidate.checkBothAccountIsPartyType(cellobj, true, cellobj.iRow) == 0) {
                    transEntryGlobal.showAlert("Header already has party type account", GlobalPref.getResourceValue("Error"));
                    cellobj.clear();

                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, 0, cellobj.iRow);
                }

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iBookNo = EntryMain.m_objTrans.BodyData[0].Book;
                    if (iBookNo > 0 && iBookNo == value) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));
                        cellobj.clear();
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, 0, cellobj.iRow);

                        if (bIsLastPartyType == true) {
                            EntryMainUI.clear(transEntryFieldInfo.Billwise, cellobj.iRow);
                        }

                        return (false);
                    }
                }
                else if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                    iCodeAccountType = DataType.toInt(cellobj.getCellData("iAccountTypeId"));
                    iBookAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, cellobj.iRow, "iAccountTypeId", eMasterDataType.Number);

                    if (EntryMainCommon.isPartyType(iBookAccountType) == true && EntryMainCommon.isPartyType(iCodeAccountType) == true) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgPartyAcSameType"), GlobalPref.getResourceValue("Error"));
                        cellobj.clear();
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, 0, cellobj.iRow);

                        if (bIsLastPartyType == true) {
                            EntryMainUI.clear(transEntryFieldInfo.Billwise, cellobj.iRow);
                        }

                        return (false);
                    }
                    else {
                        data = EntryMainMemoryObject.getBookValue(cellobj.iRow);
                        if (data > 0 && data == DataType.toInt(cellobj.getCellData())) {
                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));
                            cellobj.clear();
                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, 0, cellobj.iRow);
                        }
                    }
                }
            }

            iCurrentValue = DataType.toInt(cellobj.getCellData());
            bMasterChanged = iCurrentValue != iLastValue;
            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCODE, iCurrentValue, cellobj.iRow);

            if (bMasterChanged == true
                && transEntryFieldInfo.Currency.Area == eTranEntryFieldArea.Body
                && transEntryFieldInfo.SubLedger.FieldId == 0) {
                iDefaultCurrency = DataType.toInt(cellobj.getCellData("iDefaultCurrency"));
                if (iDefaultCurrency > 0) {
                    transEntryFields.setCurrency(iDefaultCurrency, cellobj.iRow);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCURRENCY, iDefaultCurrency, cellobj.iRow);

                    transEntryCurrency.processChange(cellobj.iRow);
                }
            }

            if (bIsLastPartyType == true) {
                iCodeAccountType = DataType.toInt(cellobj.getCellData("iAccountTypeId"));

                if (EntryMainCommon.isPartyType(iCodeAccountType) == false
                    //|| bMasterChanged == true
                ) {
                    EntryMainUI.clear(transEntryFieldInfo.Billwise, cellobj.iRow);
                }
            }


            if (bMasterChanged == true) {
                if (EntryMain.isDataLoading() == false
                    && transEntryFieldInfo.Billwise.ColumnIndex > -1) {
                    if (transEntryInfo.BodySectionNotRequired == true) {
                        EntryMainBillwise.updateDirtyRowFlag(0, eVTFIELDID.FDF_BODYCODE);
                        TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
                    }
                    else {
                        EntryMainBillwise.updateDirtyRowFlag(cellobj.iRow, eVTFIELDID.FDF_BODYCODE);
                    }
                }

                EntryMainDependency.processBodyAccountDependency(cellobj.iRow, cellobj.iColumn, transEntryFieldInfo.Code.FieldId);

                transEntryReference.updateRequiredFlag(cellobj.iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onCode_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    onBook_Leave: function (cellobj, iFieldId) {
        let iCodeAccountType = 0;
        let iBookAccountType = 0;
        let iCodeIndex = 0;
        let iBookIndex = 0;
        let iCodeValue = 0;
        let iLastValue = 0;
        let iCurrentValue = 0;
        let iPrevRowValue = 0;
        let bMasterChanged = false;
        let bIsLastPartyType = false;
        let data = null;

        try {
            bIsLastPartyType = EntryMainBody.isLastValueOfCustomerVendorType(cellobj);
            iLastValue = DataType.toInt(cellobj.getCellData());

            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
            iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);
            if (iCurrentValue > 0) {
                if (EntryMainValidate.checkBothAccountIsPartyType(cellobj, false, cellobj.iRow) > -1) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgPartyAcSameType"), GlobalPref.getResourceValue("Error"));
                    cellobj.clear();
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBOOKNO, 0, cellobj.iRow);
                }
                else {
                    data = EntryMainMemoryObject.getCodeValue(cellobj.iRow);
                    if (data > 0 && data == DataType.toInt(cellobj.getCellData())) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDrCrCantBeSame"), GlobalPref.getResourceValue("Error"));
                        cellobj.clear();
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBOOKNO, 0, cellobj.iRow);
                    }
                }
            }

            iCurrentValue = DataType.toInt(cellobj.getCellData());
            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBOOKNO, iCurrentValue, cellobj.iRow);

            iCodeIndex = transEntryFieldInfo.Code.ColumnIndex;
            iBookIndex = transEntryFieldInfo.Book.ColumnIndex;

            bMasterChanged = iCurrentValue != iLastValue;

            if (transEntryInfo.BaseVoucherType == eVTTYPE.NJOURN && cellobj.iRow > 1) {
                if (iCurrentValue <= 0) {
                    iPrevRowValue = EntryMainMemoryObject.getBookValue(cellobj.iRow - 1);
                    iCodeValue = EntryMainMemoryObject.getCodeValue(cellobj.iRow);
                    if (iCodeIndex < iBookIndex && iCodeValue > 0 && iPrevRowValue > 0 && iCodeValue != iPrevRowValue) {

                        iBookAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, cellobj.iRow - 1, "iAccountTypeId", eMasterDataType.Number);
                        iCodeAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Code, cellobj.iRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iBookAccountType) == false || EntryMainCommon.isPartyType(iCodeAccountType) == false) {

                            transEntryGrid.copyColumnData(cellobj.iRow - 1, iBookIndex, cellobj.iRow, iBookIndex);
                        }
                    }
                }
                else {
                    iPrevRowValue = EntryMainMemoryObject.getCodeValue(cellobj.iRow - 1);
                    if (iCodeIndex < iBookIndex && EntryMainMemoryObject.getCodeValue(cellobj.iRow) <= 0 && iPrevRowValue > 0) {
                        iCodeAccountType = EntryMainMemoryObject.getCodeTypeId(cellobj.iRow - 1);
                        iBookAccountType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, cellobj.iRow, "iAccountTypeId", eMasterDataType.Number);
                        if (EntryMainCommon.isPartyType(iBookAccountType) == false || EntryMainCommon.isPartyType(iCodeAccountType) == false) {
                            transEntryGrid.copyColumnData(cellobj.iRow - 1, iCodeIndex, cellobj.iRow, iCodeIndex);
                        }
                    }
                }

                iCodeAccountType = EntryMainMemoryObject.getCodeTypeId(cellobj.iRow);
                iBookAccountType = EntryMainMemoryObject.getBookTypeId(cellobj.iRow);
                if (EntryMainCommon.isPartyType(iCodeAccountType) == true && EntryMainCommon.isPartyType(iBookAccountType) == true) {
                    EntryMainUI.clear(transEntryFieldInfo.Code, cellobj.iRow);
                }
                else {
                    iCodeValue = EntryMainMemoryObject.getCodeValue(cellobj.iRow);
                    if (iCodeValue > 0 && iCodeValue == EntryMainMemoryObject.getBookValue(cellobj.iRow)) {
                        EntryMainUI.clear(transEntryFieldInfo.Code, cellobj.iRow);
                    }
                }
            }

            if (bIsLastPartyType == true) {
                iBookAccountType = DataType.toInt(cellobj.getCellData("iAccountTypeId"));

                if (EntryMainCommon.isPartyType(iBookAccountType) == false
                    || iLastValue != DataType.toInt(cellobj.getCellData())) {
                    EntryMainUI.clear(transEntryFieldInfo.Billwise, cellobj.iRow);
                }
            }

            if (bMasterChanged == true) {
                transEntryReference.updateRequiredFlag(cellobj.iRow);

                if (transEntryInfo.BaseVoucherType == eVTTYPE.NJOURN) {
                    EntryMainDependency.processBodyAccountDependency(cellobj.iRow, cellobj.iColumn, transEntryFieldInfo.Book.FieldId);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onBook_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onCurrency_Leave: function (cellobj, iFieldId) {
        let sSymbol = "";
        let iRow = 0;
        let iLastValue = 0;
        let iCurrentValue = 0;
        let iNoOfDecimals = 0;
        let fGeneralRoundOff = 0;
        let bMasterChanged = false;
        let bFromHeader = false;
        let bSameCurrency = true;
        let data = null;

        try {
            if (iFieldId === eVTFIELDID.FDF_HEADERCURRENCY) { // Called from header
                bFromHeader = true;
                iCurrentValue = DataType.toInt(OPTIONCONTROL.getControlValue(cellobj));
                EntryMainMemoryObject.update(eVTFIELDID.FDF_HEADERCURRENCY, iCurrentValue, 0);
            }
            else { // eVTFIELDID.FDF_BODYCURRENCY
                iLastValue = DataType.toInt(cellobj.getCellData());

                data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
                iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYCURRENCY, iCurrentValue, cellobj.iRow);

                bMasterChanged = iCurrentValue != iLastValue;

                if (bMasterChanged == true) {
                    transEntryCurrency.processChange(cellobj.iRow);
                }
            }

            if (iCurrentValue > 0) {
                bSameCurrency = true;

                if (bFromHeader == true) {
                    iNoOfDecimals = DataType.toInt(OPTIONCONTROL.getControlValue(cellobj, "iNoOfDecimals"));
                    fGeneralRoundOff = DataType.toDecimal(OPTIONCONTROL.getControlValue(cellobj, "fGeneralRoundOff"));
                }
                else {
                    iNoOfDecimals = transEntryFields.getMandatoryValue(transEntryFieldInfo.Currency, cellobj.iRow, "iNoOfDecimals", eMasterDataType.Number);
                    fGeneralRoundOff = transEntryFields.getMandatoryValue(transEntryFieldInfo.Currency, cellobj.iRow, "fGeneralRoundOff", eMasterDataType.Fraction);

                    for (iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                        if (iRow == cellobj.iRow) {
                            continue;
                        }

                        iLastValue = transEntryFields.getCurrency(iRow);
                        if (iLastValue != 0 && iLastValue != iCurrentValue) {
                            bSameCurrency = false;
                            break;
                        }
                    }
                }

                if (DataType.gt(iNoOfDecimals, 0) == true && DataType.eq(fGeneralRoundOff, 0) == true) {
                    transEntryGlobal.showAlert("Round off is 0 for selected currency.", "Warning");
                }

                if (bSameCurrency == true) {
                    sSymbol = transEntryFields.getMandatoryValue(transEntryFieldInfo.Currency, cellobj.iRow, "sSymbol", eMasterDataType.Text);
                }

                EntryMainUI.showNetSymbol(sSymbol);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onCurrency_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onProduct_Leave: function (cellobj, iFieldId) {
        let iLastValue = 0;
        let iCurrentValue = 0;
        let iScanResultInfo = 0;
        let iUnitId = 0;
        let dValue = 0;
        let bMasterChanged = false;
        let bRatePreload = false;
        let iProductMake = 0;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objMetaData = undefined;
        let cell = undefined;
        let data = undefined;
        let result = undefined;

        try {
            iScanResultInfo = EntryMain.m_ProductScanResultInfo;
            EntryMain.m_ProductScanResultInfo = eProductScanResultInfo.None;

            iLastValue = DataType.toInt(cellobj.getCellData());

            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
            iCurrentValue = EntryMainBody.updateMasterValue(cellobj, data, iFieldId, false);

            bMasterChanged = iCurrentValue != iLastValue;

            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, iCurrentValue, cellobj.iRow);

            if (bMasterChanged == true) {
                transEntryGrid.showRowSymbol(cellobj.iRow, false);

                result = EntryMainValidate.isRowItemValidForStockTransferWarehouse(cellobj.iRow);
                if (result.lValue <= 0) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, 0, cellobj.iRow);
                    transEntryGlobal.showAlert(result.sValue, GlobalPref.getResourceValue("Error"));

                    return;
                }

                if (transEntryInfo.isInwardVoucher == true) {
                    if (transEntryFieldInfo.Skid.ColumnIndex > -1
                        && transEntryGlobal.EntryModel.Preference.Bins.iTwoDifferentItemsCannotbePlacedinSameskid > 0) {

                        if (EntryMainWMS.checkForTwoDifferentItemsCannotbePlacedinSameskid(transEntryFields.getSkid(cellobj.iRow), iCurrentValue, cellobj.iRow) == false) {
                            cellobj.clear();

                            EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, 0, cellobj.iRow);

                            return;
                        }
                    }
                }

                if (transEntryFieldInfo.Unit.ColumnIndex > -1
                    && (iScanResultInfo & eProductScanResultInfo.Unit) == 0) {

                    EntryMainUI.clear(transEntryFieldInfo.Unit, cellobj.iRow);

                    if (DataType.isZero(iLastValue) == false) {
                        iUnitId = transEntryUnit.getDefaultUnit(cellobj.iRow);
                        if (iUnitId != 0) {
                            transEntryFields.setUnit(iUnitId, cellobj.iRow);
                        }
                    }
                }

                if ((iScanResultInfo & eProductScanResultInfo.Batch) == 0) {
                    EntryMainBatch.clear(cellobj.iRow);
                }

                if (transEntryFieldInfo.Rate.ColumnIndex > -1
                    && EntryMain.m_dRatePreload == 0
                    && (iScanResultInfo & eProductScanResultInfo.Rate) == 0) {

                    if (transEntryInfo.Settings.Inventory.DontRefreshRate == false) {
                        EntryMainUI.clear(transEntryFieldInfo.Rate, cellobj.iRow);
                        EntryMainUI.clear(transEntryFieldInfo.Gross, cellobj.iRow);
                    }
                }


                if ((iScanResultInfo & eProductScanResultInfo.RMA) == 0) {
                    EntryMainUI.clear(transEntryFieldInfo.RMA, cellobj.iRow);
                }

                EntryMainUI.clear(transEntryFieldInfo.Bins, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Bins2, cellobj.iRow);

                EntryMainUI.clear(transEntryFieldInfo.MaxQtyRelease, cellobj.iRow);
                EntryMainUI.clear(transEntryFieldInfo.Reservation, cellobj.iRow);

                EntryMainWorkflow.checkForLinkValueChanges(eVTFIELDID.FDF_BODYPRODUCT, cellobj.iRow, 0);
            }

            if (iCurrentValue <= 0) {
                if (bMasterChanged == true) {
                    EntryMainDependency.processBodyProductDependency(cellobj.iRow, cellobj.iColumn);
                }

                return;
            }

            EntryMainBody.setAliasValue(cellobj.iRow, cellobj, true);

            iProductMake = DataType.toInt(cellobj.getCellData("iproductmake"));
            if (iProductMake == eProductMake.Set) // Set
            {
                EntryMainSet.processSetSelection(iCurrentValue, cellobj);
            }
            else {
                EntryMainUI.clear(transEntryFieldInfo.SetName, cellobj.iRow);
            }

            if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body && bMasterChanged == true) {
                EntryMainMaster.processForProductChange(iCurrentValue, cellobj.iRow);
            }

            if (transEntrySettings.isRestrictItemFromBeingRepeated == true) {
                if (EntryMainCalculation.isProductUsed(iCurrentValue, cellobj.iRow) > 0) {
                    cellobj.clear();
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, 0, cellobj.iRow);
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDuplicateItem") + ". " + GlobalPref.getResourceValue("msgDuplicateItemAsSetting") + ".", GlobalPref.getResourceValue("Error"));
                    bMasterChanged = false;
                    iCurrentValue = 0;
                }
            }

            objMetaData = transEntryFieldInfo.Item.MetaData;
            if (bMasterChanged == true || objMetaData.bReadOnly == false) {
                if (bMasterChanged == false
                    && transEntryInfo.MiscellaneousPref.iDontRefreshDescriptionWithAccountOrProductInDocument != 0) {

                }
                else {
                    EntryMainBody.setDefaultDescription(cellobj.iRow);
                }
            }

            if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) { }

            if (transEntryFieldInfo.Bins.ColumnIndex > 0) { }

            if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                objMetaData = transEntryFieldInfo.Qty.MetaData;
                if (objMetaData.bHidden == true && DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                    cell = EntryMainUI.getElement(transEntryFieldInfo.Qty, cellobj.iRow).Value;
                    if (DataType.toDecimal(cell.getCellData()) == 0) {
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, cellobj.iRow, null, cellobj.iColumn - 1, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dValue = DataType.toDecimal(objFormulaOutput.Value);
                        transEntryQuantity.setValue(dValue, cellobj.iRow, { bUpdateMemoryObject: true });
                    }
                }
            }

            bRatePreload = false;
            if (transEntryFieldInfo.Rate.ColumnIndex > -1) {
                objMetaData = transEntryFieldInfo.Rate.MetaData;
                if (objMetaData.bHidden == true || objMetaData.bReadOnly == true) {
                    if (DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                        dValue = EntryMainMemoryObject.getRateValue(cellobj.iRow);
                        if (bMasterChanged == true || dValue == 0) {
                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, cellobj.iRow, null, cellobj.iColumn - 1, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            dValue = DataType.toDecimal(objFormulaOutput.Value);
                            dValue = transEntryRate.update(dValue, cellobj.iRow);
                            bRatePreload = true;
                        }
                    }
                }
                else if (bMasterChanged == true && iProductMake != eProductMake.Set
                    && transEntryInfo.BaseVoucherType != eVTTYPE.PRREC) {
                    if (EntryMain.m_dRatePreload == 0 && (iScanResultInfo & eProductScanResultInfo.Rate) == 0) {
                        if (transEntryInfo.Settings.Inventory.DontRefreshRate == false) {
                            if (objMetaData.bMandatory == true) { // Rate is mandatory
                                EntryMainUI.clear(transEntryFieldInfo.Rate, cellobj.iRow);
                            }
                            else {
                                dValue = transEntryRate.update(0, cellobj.iRow);
                            }

                            transEntryGross.setValue(0, cellobj.iRow, true);
                        }
                    }
                }
            }

            if ((transEntryFieldInfo.Gross.ColumnIndex > -1 && bRatePreload == true)
                || iProductMake == eProductMake.Set
                || ((iScanResultInfo & eProductScanResultInfo.Quantity) != 0 && (iScanResultInfo & eProductScanResultInfo.Rate) != 0)) {
                transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow });
            }


            if (bMasterChanged == true) {
                transEntryScreenData.setBodyDefaultValue(cellobj.iRow);
                EntryMainDependency.processBodyProductDependency(cellobj.iRow, cellobj.iColumn);
            }

            if (DataType.isValidObject(transEntryInfo.Settings.VoucherScheme) == true
                && transEntryInfo.Settings.VoucherScheme.bEnableScheme == true
                && cellobj.iRow == 1
                && EntryMain.isDataLoading() == false) {

                iSchemeTagId = transEntryGrid.getMasterValue(0, transEntryInfo.TagsPref.iSchemes);

                if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                    iCustomerId = EntryMain.m_objTrans.BodyData[0].Book;
                }

                if (EntryMainScheme.isSchemeClassExist() == true) {
                    EntryMainScheme.getValidSchemesData(iSchemeTagId, iCustomerId, EntryMain.m_objTrans.Header.Date);
                }
            }

            EntryMainUI.updateImage(DataType.toInt(cellobj.getCellData()));

            if (EntryMain.isDataLoading() == false) {
                if (bMasterChanged == true) {
                    EntryMainUI.setSummaryInfo(cellobj.iRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.onProduct_Leave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

