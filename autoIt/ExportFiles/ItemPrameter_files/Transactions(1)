    isMethodExecuting: function (iMethodExecuting, value) {
        let iCounter = 0;
        let obj = null;

        try {
            for (iCounter = 0; iCounter < transEntryGlobal.m_arrMethodExecuting.length; iCounter++) {
                obj = transEntryGlobal.m_arrMethodExecuting[iCounter];
                if (obj.iMethodExecuting != iMethodExecuting) {
                    continue;
                }

                if (iMethodExecuting == eTransMethodExecuting.GetNetAmount) {
                    if (obj.Value == value) {
                        return (iCounter);
                    }
                }
                else if (iMethodExecuting == eTransMethodExecuting.SetSummaryInfo) {
                    if (obj.Value == value) {
                        return (iCounter);
                    }
                }
                else if (iMethodExecuting == eTransMethodExecuting.SetOptionControlValue) {
                    if (obj.Row == value.Row && obj.FieldId == value.FieldId && obj.Value == value.Value) {
                        return (iCounter);
                    }
                }

            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryGlobal.isMethodExecuting} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (-1);
    },

