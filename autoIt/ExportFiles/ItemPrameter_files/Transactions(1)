                                        objTemp.ColMap = objMetaData.iColMap;
                                        objTemp.FieldId = objMetaData.iFieldId;
                                        objTemp.FieldName = objMetaData.sFieldName;
                                        objTemp.Input = objScreenData.Input;
                                        objTemp.Value = objScreenData.Value;

                                        body.Value = DataType.toString(objTemp);
                                        arrData.push(body);
                                        break;
                                    }
                                }
                                else {
                                    if ((objScreenData.FieldId & eVTFIELDFLAG.TOFLDID) == (objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID)) {
                                        body = {};
                                        body.Key = sId;

                                        objTemp = {};
                                        objTemp.ColMap = objMetaData.iColMap;
                                        objTemp.FieldId = objMetaData.iFieldId;
                                        objTemp.FieldName = objMetaData.sFieldName;
                                        objTemp.Input = objScreenData.Input;
