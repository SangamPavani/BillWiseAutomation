                    if (BinsUI.m_objBinsData.BinDetails[iCounter].BatchId == BinsUI.m_arrCurrentRowBins[iRow].BatchId) {
                        BinsUI.m_objBinsData.BinDetails[iCounter].Batch = BinsUI.m_arrCurrentRowBins[iRow].Batch;
                    }
                }

                //UPDATE PREVIOUS ROW QTY/LOAD/FREESPACE
                iTotalRows = DataType.arrayLength(BinsUI.m_arrOtherRowBins); 
                for (iRow = 0; iRow < iTotalRows; iRow++) {
                    if (BinsUI.m_arrOtherRowBins[iRow] == null) {
