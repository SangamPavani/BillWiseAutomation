    setValue: function (field, bIsName, row, value, bStruct) {
        let iCounter = 0;
        let iIndex = 0;
        let bMulDimensionField = false;
        let bMulDimensionData = false;
        let arrRows = null;
        let arrField = null;
        let arrValue = null;
        let Fields = null;
        let Values = null;
        let objResult = null;
        let result = null;

        try {
            if (transEntryGlobal.debugExternalModule == true) {
                debugger
            }

            if (DataType.isArray(field) == true) {
                arrField = field;
                arrValue = value;

                if (DataType.isArray(row) == true) {
                    if (DataType.isArray(arrField[0]) == true) {
                        bMulDimensionField = true;
                    }

                    if (DataType.isArray(arrValue[0]) == true) {
                        bMulDimensionData = true;
                    }
                }
            }
            else {
                arrField = [];
                arrField.push(field);

                arrValue = [];
                arrValue.push(value);
            }

            if (DataType.isArray(row) == true) {
                arrRows = row;
            }
            else {
                arrRows = [];
                arrRows.push(row);
            }

            objResult = {};
            objResult.lValue = [];
            objResult.sValue = [];
            objResult.data = [];

            GLOBAL.LoadingStart();

            for (iIndex = 0; iIndex < arrRows.length; iIndex++) {
                if (bMulDimensionField == true) {
                    Fields = arrField[iIndex];
                }
                else {
                    Fields = arrField;
                }

                if (bMulDimensionData == true) {
                    Values = arrValue[iIndex];
                }
                else {
                    Values = arrValue;
                }

                for (iCounter = 0; iCounter < Fields.length; iCounter++) {
                    if (DataType.toInt(arrRows[iIndex]) == 0) {
                        result = EntryMainAPI.setHeaderFieldValue(Fields[iCounter], bIsName, Values[iCounter], bStruct);
                        if (result.lValue > 0) {
                            objResult.lValue.push(result.lValue);
                            objResult.sValue.push(result.sValue);
                            objResult.data.push(result.data);

                            continue;
                        }

                        result = EntryMainAPI.setFooterFieldValue(Fields[iCounter], bIsName, Values[iCounter], bStruct);
                        objResult.lValue.push(result.lValue);
                        objResult.sValue.push(result.sValue);
                        objResult.data.push(result.data);
                    }
                    else {
                        result = EntryMainAPI.setBodyFieldValue(arrRows[iIndex], Fields[iCounter], bIsName, Values[iCounter], bStruct);
                        objResult.lValue.push(result.lValue);
                        objResult.sValue.push(result.sValue);
                        objResult.data.push(result.data);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.setValue}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        GLOBAL.LoadingEnd();

        return (objResult);
    },

    getHeaderFieldValue: function (field, bIsName, bFromStruct) {
        let sId = "";
        let result = null;
        let objInfo = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (DataType.toBoolean(bIsName) == true) {
                objInfo = transEntryFieldInfo.getFromFieldName(field, eTranEntryFieldArea.Header);
            }
            else {
                objInfo = transEntryFieldInfo.getFromFieldId(field, eTranEntryFieldArea.Header);
            }

            if (objInfo.Area == eTranEntryFieldArea.None) {
                result.lValue = 0;
                result.sValue = "Invalid field";
                result.data = null;

                return (result);
            }

            sId = EntryMainUI.getHeaderControlId(objInfo.FieldId);

            if (bFromStruct == true) {
                result = EntryMainAPI.getValueFromStructure(sId, 0);
            }
            else {
                result = EntryMainAPI.getValueFromControl(sId, objInfo.MetaData.iDataTypeId, objInfo.FieldId);
            }

            if (DataType.isValidObject(result.data) == true) {
                result.data.iFieldId = objInfo.FieldId;
                result.data.sFieldName = objInfo.MetaData.sFieldName;
                result.data.iPosition = 0;
                result.data.iDataTypeId = objInfo.MetaData.iDataTypeId;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.getHeaderFieldValue}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    setHeaderFieldValue: function (field, bIsName, value, bToStruct) {
        let sId = "";
        let result = null;
        let objInfo = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (DataType.toBoolean(bIsName) == true) {
                objInfo = transEntryFieldInfo.getFromFieldName(field, eTranEntryFieldArea.Header);
            }
            else {
                objInfo = transEntryFieldInfo.getFromFieldId(field, eTranEntryFieldArea.Header);
            }

            if (objInfo.Area != eTranEntryFieldArea.Header) {
                return (result);
            }

            sId = EntryMainUI.getHeaderControlId(objInfo.FieldId);

            if (bToStruct == true) {
                result = EntryMainAPI.setValueToStruct(sId, value, 0);
            }
            else {
                result = EntryMainAPI.setValueToControl(sId, objInfo.MetaData.iDataTypeId, value);
                EntryMainMemoryObject.update(objInfo.FieldId, value, 0, objInfo.MetaData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainAPI.setHeaderFieldValue}" + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    getBodyFieldValue: function (iRow, field, bIsName, bFromStruct) {
        let sId = "";
        let sFieldName = "";
        let iFieldId = 0;
        let iDataTypeId = 0;
        let iCurrentRow = 0;
        let iCurrentColumn = 0;
        let bProductAlias = false;
        let objMetaData = null;
        let objBillwise = null;
        let objFieldInfo = undefined;
        let arrFields = undefined;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            if (((bIsName == true && field == "Reference")
                || (bIsName == false && field == eVTFIELDID.FDF_REFERENCE))
                &&
                (EntryMainBillwise.isSingleBillwiseVoucher() == true
                || transEntryInfo.BodySectionNotRequired == true)) {
                iFieldId = eVTFIELDID.FDF_REFERENCE;
                sFieldName = "Reference";
                iDataTypeId = eMasterDataType.Text;
            }

            if (iFieldId == 0) {
                if (transEntryInfo.BodySectionNotRequired == true) {
                    arrFields = [];
                }
                else {
                    if (DataType.toBoolean(bIsName) == true) {
                        arrFields = transEntryFieldInfo.getBodyFields({ sFieldName: field, bName: true });
                    }
                    else {
                        arrFields = transEntryFieldInfo.getBodyFields({ iFieldId: field, bName: false });
                    }
                }

                if (arrFields.length < 1) {
                    result.lValue = 0;
                    result.sValue = "Invalid field";
                    result.data = null;

                    return (result);
                }
                objFieldInfo = arrFields[0];

                objMetaData = objFieldInfo.MetaData;
                iFieldId = objMetaData.iFieldId;
                sFieldName = objMetaData.sFieldName;
                iDataTypeId = objMetaData.iDataTypeId;

                if (transEntryFieldInfo.ProductAlias.ColumnIndex > -1
                    && sFieldName == transEntryFieldInfo.ProductAlias.MetaData.sFieldName) {

                    bProductAlias = true;
                }
            }

            if (iFieldId == eVTFIELDID.FDF_REFERENCE) {
                sId = eTranEntryBodyDataConstKey.BillwiseData;
            }
            else {
                if (bProductAlias == false) {
                    sId = EntryMainUI.getBodyControlId(iFieldId);
                }

                //sId = EntryMainUI.getBodyControlId(iFieldId);
            }


            if (bFromStruct == true) {
                result = EntryMainAPI.getValueFromStructure(sId, iRow);
            }
            else {
                if (iFieldId == eVTFIELDID.FDF_REFERENCE) {
                    result = COMMON.prototype.getEmptyResultObject();
                    result.lValue = 0;
                    result.sValue = "";
                    result.data = null;

                    objBillwise = EntryMainBillwise.getData(iRow);
                    if (DataType.isValidObject(objBillwise) == true) {
                        result.data = {};
                        result.data.FieldText = DataType.toString(objBillwise);
