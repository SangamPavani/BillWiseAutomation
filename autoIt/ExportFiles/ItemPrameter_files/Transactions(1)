    // Called from billwise screen
    adjustBillCallback: function (obj) {
        let sText = "";
        let iSaveSource = 0;
        let iSign = 0;
        let iCounter = 0;
        let iFlag = 0;
        let dAmount = 0;
        let dExchange = 1;

        try {
            if (transEntryGlobal.debugCallback == true || transEntryGlobal.debugBillwise == true) {
                debugger
            }

            iSaveSource = DataType.toInt(FUIElement.getAttribute(EntryMainUI.getOthersContainer(), "savesource"));
            if (EntryMainUI.createDiscountField(obj) == true) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                return;
            }

            if (transEntryGlobal.TempRowNo > 0) {
                if (DataType.isValidObject(obj) == true && DataType.arrayLength(obj) > 0) {
                    EntryMain.setDirty();

                    transEntryFields.setBillwise(obj[0].arrAdjustedBills, transEntryGlobal.TempRowNo);
                    EntryMainMemoryObject.updateBillwiseData(obj[0].arrAdjustedBills, transEntryGlobal.TempRowNo);

                    sText = transEntryReference.createString(obj[0].arrAdjustedBills);
                    transEntryFields.setBillwise(sText, transEntryGlobal.TempRowNo, true);

                    transEntryGrid.setRowData(transEntryGlobal.TempRowNo, eRowDataName.BillwiseRequired, false);

                    iFlag = 0;
                    for(iCounter = 0; iCounter < obj[0].arrAdjustedBills.length; iCounter++) {
                        if(obj[0].arrAdjustedBills[iCounter].iRefType == 2) {
                            iFlag++;
                        }
                    }

                    dExchange = EntryMainMemoryObject.getExchangeRate(transEntryGlobal.TempRowNo);
                    if (iFlag > 0 || transEntryFieldInfo.Billwise.ColumnIndex < transEntryFieldInfo.Amount.ColumnIndex) {
                        dAmount = obj[0].Amount;
                        if(obj[0].arrAdjustedBills[0].MaintainInInviceCurrency == true) {
                            dExchange = 1;
                        }
                        else {
                            dAmount /= dExchange;
                        }
                    }
                    else {
                        if (transEntryFieldInfo.Amount.FieldId > 0) {
                            dAmount = EntryMainMemoryObject.getAmountValue(transEntryGlobal.TempRowNo);
                        }
                        else if (transEntryFieldInfo.Debit.FieldId > 0
                            && transEntryFields.getDebit(transEntryGlobal.TempRowNo) > 0) {

                            dAmount = transEntryFields.getDebit(transEntryGlobal.TempRowNo);
                        }
                        else {
                            dAmount = transEntryFields.getCredit(transEntryGlobal.TempRowNo);
                        }
                    }


                    iSign = 0;
                    if (transEntryFieldInfo.Amount.FieldId > 0) {
                        iSign = Math.sign(EntryMainMemoryObject.getAmountValue(transEntryGlobal.TempRowNo));
                    }

                    if (iSign == 0) {
                        iSign = 1;
                    }

                    //dAmount = obj[0].Amount;
                    if (transEntryGlobal.BreakupByTagCount == 1 && transEntryFieldInfo.Amount.FieldId > 0) {
                        dAmount = FNumberOperation.mul(FNumberOperation.abs(dAmount), iSign);
                    }

                    transEntryFields.setAmount(dAmount, transEntryGlobal.TempRowNo);

                    EntryMainBillwise.setBillwiseData(obj, null, transEntryGlobal.TempRowNo);

                    transEntryVat.updateFromBillwiseData(obj[0].arrAdjustedBills, transEntryGlobal.TempRowNo, null, transEntryGlobal.AdjustBillsCount);

                    EntryMainUI.setSummaryInfo(transEntryGlobal.TempRowNo);
                }

                EntryMainUI.resetOthersContainer();
                transEntryGrid.gotoCell(transEntryGlobal.TempRowNo, transEntryFieldInfo.Billwise.ColumnIndex + 1);

                return;
            }

            EntryMainBillwise.saveData(obj, transEntryGlobal.TempTransactionData);
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in adjust bill callback.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCallback.adjustBillCallback} " + err.message);
            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
        }
    },

