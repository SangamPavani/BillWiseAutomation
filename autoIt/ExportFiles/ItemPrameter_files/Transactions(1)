    onLeave: function (cellobj, objMetaData) {
        let iCounter = 0;
        let iItemId = 0;
        let dBaseQty = 0;
        let data = null;
        let obj = null;
        let objBinsQuantity = null;
        let arrBinData = null;
        let arrOldAllocations = null;
        let arrPrevBins = null;

        try {
            data = OPTIONCONTROL.getControlData(cellobj.ColumnAttribute.ctrlid);
            obj = DataType.arrayObjectToSingleObject(data);
            if (DataType.isValidObject(obj) == false) {
                cellobj.clear();

                return;
            }

            if (DataType.toInt(obj.Id) == 0) {
                cellobj.clear();

                return;
            }

            if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS) {
                if (transEntryInfo.isInwardVoucher == false) {
                    dBaseQty = EntryMainMemoryObject.getBaseQuantityValue(cellobj.iRow);
                    if (DataType.lt(obj.Stock, dBaseQty) == true) {
                        transEntryGlobal.showAlert("Insufficient bins stock quantity.", GlobalPref.getResourceValue("Error"));
                        cellobj.clear();

                        return;
                    }
                    else {
                        arrOldAllocations = EntryMainBins.getUsedBinsList(cellobj.iRow, false);
                        if (DataType.arrayLength(arrOldAllocations) > 0) {
                            iItemId = EntryMainMemoryObject.getProductValue(cellobj.iRow);
                            if (iItemId > 0) {
                                iCounter = 0;
                                while (iCounter < arrOldAllocations.length) {
                                    if (DataType.isValidObject(arrOldAllocations[iCounter]) == false) {
                                        iCounter++;
                                    }
                                    else {
                                        arrPrevBins = arrOldAllocations[iCounter];
                                        if (arrPrevBins[0].Item != iItemId) {
                                            arrOldAllocations.splice(iCounter, 1);
                                        }
                                        else {
                                            iCounter++;
                                        }
                                    }
                                }
                            }
                        }

                        if (DataType.arrayLength(arrOldAllocations) > 0) {
                            for (iCounter = 0; iCounter < arrOldAllocations.length; iCounter++) {
                                if (DataType.isValidObject(arrOldAllocations[iCounter]) == false) {
                                    continue;
                                }

                                arrPrevBins = arrOldAllocations[iCounter];

                                if (DataType.neq(obj.Id, arrPrevBins[0].BinId) == true) {
                                    continue;
                                }

                                if (obj.SkidId > 0 && DataType.neq(obj.SkidId, arrPrevBins[0].SkidId) == true) {
                                    continue;
                                }

                                if (transEntryInfo.WMSPref.bReceivedbyCarton == true) {
                                    obj.Carton = DataType.toString(obj.Carton);
                                    arrPrevBins[0].Carton = DataType.toString(arrPrevBins[0].Carton);
                                    if (obj.Carton != arrPrevBins[0].Carton) {
                                        continue;
                                    }
                                }

                                if (DataType.eq(obj.BatchId, arrPrevBins[0].BatchId) == true) {
                                    arrPrevBins[0].Quantity = Math.abs(arrPrevBins[0].Quantity);

                                    obj.Stock = DataType.sub(obj.Stock, arrPrevBins[0].Quantity);
                                    obj.Quantity = DataType.sub(obj.Quantity, arrPrevBins[0].Quantity);
                                }
                            }

                            if (DataType.lt(obj.Stock, dBaseQty) == true) {
                                transEntryGlobal.showAlert("Insufficient bins stock quantity as some quantity is already adjusted in some other rows.", GlobalPref.getResourceValue("Error"));
                                cellobj.clear();

                                return;
                            }
                        }
                    }
                }

                arrBinData = transEntryFields.getBins2(cellobj.iRow);
            }
            else {
                arrBinData = transEntryFields.getBins(cellobj.iRow);
            }

            objBinsQuantity = {};
            objBinsQuantity.Batch = transEntryBatch.getBatchNo(cellobj.iRow);
            objBinsQuantity.BatchId = obj.BatchId;
            objBinsQuantity.BinId = obj.Id;
            objBinsQuantity.BinName = obj.Name;
            objBinsQuantity.BodyId = 0;
            objBinsQuantity.Distance = 0;
            objBinsQuantity.ExpDate = 0;
            objBinsQuantity.Item = EntryMainMemoryObject.getProductValue(cellobj.iRow);
            objBinsQuantity.ItemCapacity = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, cellobj.iRow, "iBinCapacity", eMasterDataType.Text);
            objBinsQuantity.Level = 0;
            objBinsQuantity.MfgDate = 0;
            objBinsQuantity.Quantity = EntryMainMemoryObject.getBaseQuantityValue(cellobj.iRow);
            objBinsQuantity.UnitId = EntryMainMemoryObject.getUnitValue(cellobj.iRow);
            objBinsQuantity.AllocTag = transEntryFields.getAllocationTag(cellobj.iRow);
            transEntryBins.copyWMSInfo(objBinsQuantity, obj);


            if (DataType.arrayLength(arrBinData) > 0) {
                if(objBinsQuantity.LotNo == 0) {
                    objBinsQuantity.LotNo = arrBinData[0].LotNo;
                }

                if(objBinsQuantity.SkidId == 0) {
                    objBinsQuantity.SkidId = arrBinData[0].SkidId;
                }

                if(objBinsQuantity.Flag == 0) {
                    objBinsQuantity.Flag = arrBinData[0].Flag;
                }

                if(DataType.isNullOrEmpty(objBinsQuantity.Carton, true) == true) {
                    objBinsQuantity.Carton = arrBinData[0].Carton;
                }
            }

            cellobj.setCellText(objBinsQuantity.BinName, DataType.toString([objBinsQuantity]));
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryBins.onLeave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

