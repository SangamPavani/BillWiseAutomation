                    {
                        if (DataType.stringIncludes(sTempRes, ":"))//check for double colon (is a valid terneqn)
                        {
                            sTemp += this.TernaryTempResult(sTempRes);//calculate the tern eqn
                        }
                        else {
                            return ("NaN");
                        }
                    }
                    else if (DataType.stringIncludes(sTempRes, ">") || DataType.stringIncludes(sTempRes, "<")
                        || DataType.stringIncludes(sTempRes, "&&") || DataType.stringIncludes(sTempRes, "||")
