    getUsedLinkDataRows: function (iLinkColumnIndex) {
        let iRow = 0;
        let dExchangeRate = 1;
        let result = null;
        let objLinkColumn = null;
        let obj = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = [];

            if (iLinkColumnIndex < 0) {
                return (result);
            }

            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    break;
                }

                objLinkColumn = transEntryGrid.getCellObject(iRow, iLinkColumnIndex);
                if (DataType.isValidObject(objLinkColumn) == false) {
                    break;
                }

                obj = {};
                obj.iRow = iRow;
                obj.iColumn = iLinkColumnIndex;
                obj.lTransactionId = DataType.toInt64(transEntryGrid.getRowData(iRow, eRowDataName.TransactionId));
                obj.iBodyId = DataType.toInt(transEntryGrid.getRowData(iRow, eRowDataName.BodyId));

                obj.RefId = DataType.toInt64(objLinkColumn.getCellData("refid"));
                obj.VoucherNo = objLinkColumn.getCellData("voucherno");
                obj.LinkId = DataType.toInt(objLinkColumn.getCellData("linkid"));
                obj.iLinkField = DataType.toInt(objLinkColumn.getCellData("linkfield"));
                obj.UsedLinkValue = 0;

                dExchangeRate = EntryMainMemoryObject.getExchangeRate(iRow);

                switch (obj.iLinkField) {
                    case eTranEntryLinkValue.Amount:
                        obj.UsedLinkValue = EntryMainMemoryObject.getAmountValue(iRow);
                        if (obj.UsedLinkValue != 0) {
                            obj.UsedLinkValue *= dExchangeRate;
                        }
                        break;
                    case eTranEntryLinkValue.Gross:
                        obj.UsedLinkValue = EntryMainMemoryObject.getGrossValue(iRow);
                        obj.UsedLinkValue = FNumberOperation.abs(FNumberOperation.mul(obj.UsedLinkValue, dExchangeRate));
                        break;
                    case eTranEntryLinkValue.Net:
                        obj.UsedLinkValue = FNumberOperation.abs(transEntryNet.getValue(iRow));
                        break;
                    case eTranEntryLinkValue.Quantity:
                        obj.UsedLinkValue = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                        break;
                    case eTranEntryLinkValue.TransactionQuantity:
                        obj.UsedLinkValue = transEntryFields.getQty(iRow);
                        break;
                    case eTranEntryLinkValue.TransactionAmount:
                        obj.UsedLinkValue = EntryMainMemoryObject.getAmountValue(iRow);
                        break;
                    case eTranEntryLinkValue.TransactionGross:
                        obj.UsedLinkValue = FNumberOperation.abs(EntryMainMemoryObject.getGrossValue(iRow));
                        break;
                    case eTranEntryLinkValue.AlternateQuantity:
                        obj.UsedLinkValue = FNumberOperation.abs(EntryMainMemoryObject.getAltQuantityValue(iRow));
                        break;
                }

                obj.LinkValue = DataType.toDecimal(objLinkColumn.getCellData("linkvalue"));
                obj.BaseTransactionId = DataType.toInt64(objLinkColumn.getCellData("basetransactionid"));
                obj.VoucherType = DataType.toInt(objLinkColumn.getCellData("vouchertype"));

                obj.iBaseVoucherType = obj.VoucherType;
                obj.objLoadedData = null;

                if (obj.RefId > 0) {
                    result.data.push(obj);
                }
            }

            result.lValue = result.data.length;
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.getUsedLinkDataRows} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

