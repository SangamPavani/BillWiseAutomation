                                            && iGridRow > 0
                                            && DataType.toInt(objBody.Tags[iCounter1].Tag) == 0
                                            && EntryMainDependency.isMasterExistInDependency(objMetaData.iMasterTypeId) == false) {

                                            if (iStartRow > 0) {
                                                iOldValue = EntryMainMaster.getValue(objMetaData.iFieldId, (iStartRow + iGridRow) - 1);
                                            }

