    prefetchStockQty: function () {
        let sVariable = "";
        let iCounter = 0;
        let bFound = false;
        let arrFields = undefined;
        let objMetaData = null;
        let result = null;
        let arrInput = null;
        let obj = null;

        try {
            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                sVariable = DataType.toString(objMetaData.sPreload).toLowerCase();
                sVariable = DataType.stringRemoveSpace(sVariable);

                if (DataType.stringStartsWith(sVariable, "&") == false) {
                    continue;
                }

                sVariable = sVariable.substr(1);

                if (DataType.stringStartsWith(sVariable, "stkq") == false || sVariable != "stkq") {
                    continue;
                }

                bFound = true;
                break;
            }

            if (bFound == false) {
                return;
            }

            arrInput = [];
            for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows() ; iCounter++) {
                if (EntryMainBody.isRowEditable(iCounter) == false) {
                    break;
                }

                obj = {};
                obj.iProductId = EntryMainMemoryObject.getProductValue(iCounter);
                obj.iDate = EntryMain.m_objTrans.Header.Date;
                obj.iWarehouseId = transEntryFields.getInvTag(iCounter);

                obj.lTransactionId = transEntryFields.getTransactionId(iCounter);
                obj.lBatchId = transEntryBatch.getBatchId(iCounter);

                arrInput.push(obj);
            }

            result = transEntryServer.execute(eTransServerRequest.PrefetchStockQty, { arrInput: arrInput });
            if (result.lValue > 0 && DataType.arrayLength(result.data) > 0) {
                result = result.data;
                for (iCounter = 0; iCounter < result.length; iCounter++) {
                    if (DataType.isNullOrEmpty(result[iCounter].sError) == true) {
                        transEntryCache.STOCKQTY.setValue(result[iCounter].iProductId,
                                                            result[iCounter].iDate,
                                                            result[iCounter].iWarehouseId,
                                                            result[iCounter].lTransactionId,
                                                            result[iCounter].lBatchId,
                                                            result[iCounter].dValue);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryGlobal.prefetchStockQty} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
