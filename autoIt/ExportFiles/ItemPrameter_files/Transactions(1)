    this.onMasterToLink_Change = function (id, data, tag) {
        // CONFIGURETRANS.editLayout_FieldsCustomization_getMastertoLinkVal
        let iCounter = 0;
        let iIndex = 0;
        let iDataTypeId = -1;
        let value = null;
        let params = null;
        let result = null;
        let arrExternalFields = null;
        let arrMandatoryFields = null;
        let eleMandatory = null;
        let eleOption = null;
        //debugger
        try {
            if (FCommon.UI.isValidObject(tag) == true) {
                iDataTypeId = -1;
                if (DocCustomization.Layout.m_CustomizeField.iFieldId != 0) {
                    iDataTypeId = DocCustomization.Layout.m_CustomizeField.iDataTypeId;
                }                    
                else {
                    iDataTypeId = FConvert.toInt(document.getElementById("EditLayout_FieldsCustomization_FieldDetails_DataType").value);
                }
                    
                value = OPTIONCONTROL.convertRawDataIntoObject(id, tag.Data);

                if (eMasterDataType.Master == iDataTypeId) {
                    params = {};
                    params.sMasterName = value.sCaption;
                    params.sModuleName = "vm" + value.sModule + "_";
                }
                else {
                    params = {};
                    params.sMasterName = value.sCaption;
                }
            }
            else {
                params = {};
                params.sMasterName = id.value;
            }

            result = NETWORK.executeServerMethod(GLOBAL.getContextPath("EditLayout_getExterFields", "ConfigureTrans", "TranSettings"),
                                  true,
                                  params,
                                  "",
                                  false,
                                  "",
                                  "GLOBAL.LoadingStart",
                                  "GLOBAL.LoadingEnd");

            arrExternalFields = result.data;

            arrMandatoryFields = [];
            if (FCommon.String.isNullOrEmpty(DocCustomization.Layout.m_CustomizeField.sMandatoryFields) == false) {
                arrMandatoryFields = DocCustomization.Layout.m_CustomizeField.sMandatoryFields.split(',');
            }

            if (iDataTypeId == eMasterDataType.Master) {
                eleMandatory = DocLayoutField_Customization.MasterMandatoryFieldsElement;
                eleMandatory.innerHTML = "";
                for (iCounter = 0; iCounter < arrExternalFields.length; iCounter++) {
