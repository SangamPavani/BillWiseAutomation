    prepareObjectForStockTransfer: function (objTrans) {
        let iCounter = 0;
        let iRow = 0;
        let iSign = 0;
        let dTempQty = 0;
        let bIssueInHeader = false;
        let arrBodyData = null;
        let objBody = null;
        let objBins = null;
        let objBins2 = null;

        try {
            if (transEntryInfo.isItTransfer == false) {
                return (objTrans);
            }

            if (transEntryFieldInfo.IssueInvTag.Area == eTranEntryFieldArea.Header
                || transEntryInvTag.isBothWarehouseInBody() == true) {

                bIssueInHeader = true;
            }

            // If both warehouse in header, first half bodydata array has issue rows
            // else first half bodydata has that rows what is selected in (Issue/Receipts) dropdown

            arrBodyData = [];
            for (iCounter = 0; iCounter < objTrans.BodyData.length; iCounter++) {
                objBody = DataType.createDuplicateObject(objTrans.BodyData[iCounter]);
                objBody.BodyId = 0;
                objBody.TransactionId = 0;
                objBody.Sales.Reservation = null;
                objBody.BillwiseData = null;
                objBody.Sales.BinsData = null;
                
                objTrans.BodyData[iCounter].Flags.InternalIIDST = false;

                objBins = null;
                objBins2 = null;
                if (DataType.arrayLength(objTrans.BodyData[iCounter].Sales.BinsData) > 0) {
                    if (objTrans.BodyData[iCounter].Sales.BinsData.length > 0) {
                        objBins = objTrans.BodyData[iCounter].Sales.BinsData[0];
                    }

                    if (objTrans.BodyData[iCounter].Sales.BinsData.length > 1) {
                        objBins2 = objTrans.BodyData[iCounter].Sales.BinsData[1];
                    }
                }
                objTrans.BodyData[iCounter].Sales.BinsData = null;

                if (bIssueInHeader == true) { // Issue in header
                    objTrans.BodyData[iCounter].InvTag = EntryMainUI.getValue(transEntryFieldInfo.IssueInvTag, iCounter + 1); // Issue Warehouse
                    objBody.InvTag = EntryMainUI.getValue(transEntryFieldInfo.ReceiptInvTag, iCounter + 1); // Receipt Warehouse

                    objTrans.BodyData[iCounter].Sales.Quantity = FNumberOperation.mul(objTrans.BodyData[iCounter].Sales.Quantity, -1);
                    objTrans.BodyData[iCounter].Sales.BaseQuantity = FNumberOperation.mul(objTrans.BodyData[iCounter].Sales.BaseQuantity, -1);
                    objTrans.BodyData[iCounter].Sales.AlternateQuantity = FNumberOperation.mul(objTrans.BodyData[iCounter].Sales.AlternateQuantity, -1);


                    if (DataType.isValidObject(objBins) == true) {                        
                        for (iRow = 0; iRow < objBins.length; iRow++) {
                            dTempQty = FNumberOperation.abs(objBins[iRow].Quantity);
                            if (FNumberOperation.isLessThan(objTrans.BodyData[iCounter].Sales.Quantity, 0) == true) {
                                iSign = -1;
                            }
                            else {
                                iSign = 1;
                            }

                            objBins[iRow].Quantity = FNumberOperation.mul(dTempQty, iSign);
                        }

                        objTrans.BodyData[iCounter].Sales.BinsData = [];
                        objTrans.BodyData[iCounter].Sales.BinsData.push(objBins); // Issue Bin
                    }

                    if (DataType.isValidObject(objBins2) == true) {
                        objBody.Sales.BinsData = [];
                        objBody.Sales.BinsData.push(objBins2); // Receipt Bin
                    }

                    if (DataType.isValidObject(objTrans.BodyData[iCounter].Sales.BatchNo) == true) {
                        dTempQty = FNumberOperation.abs(objTrans.BodyData[iCounter].Sales.BatchNo.Qty);
                        if (FNumberOperation.isLessThan(objTrans.BodyData[iCounter].Sales.Quantity, 0) == true) {
                            iSign = -1;
                        }
                        else {
                            iSign = 1;
                        }

                        objTrans.BodyData[iCounter].Sales.BatchNo.Qty = FNumberOperation.mul(dTempQty, iSign);
                    }
                }
                else { // Receipt in header
                    objTrans.BodyData[iCounter].InvTag = EntryMainUI.getValue(transEntryFieldInfo.ReceiptInvTag, iCounter + 1); // Receipt Warehouse
                    objBody.InvTag = EntryMainUI.getValue(transEntryFieldInfo.IssueInvTag, iCounter + 1); // Issue Warehouse

                    objBody.Sales.Quantity = FNumberOperation.mul(objBody.Sales.Quantity, -1);
                    objBody.Sales.BaseQuantity = FNumberOperation.mul(objBody.Sales.BaseQuantity, -1);
                    objBody.Sales.AlternateQuantity = FNumberOperation.mul(objBody.Sales.AlternateQuantity, -1);

                    if (DataType.isValidObject(objBins) == true) {
                        for (iRow = 0; iRow < objBins.length; iRow++) {
                            dTempQty = FNumberOperation.abs(objBins[iRow].Quantity);
                            if (FNumberOperation.isLessThan(objBody.Sales.Quantity, 0) == true) {
                                iSign = -1;
                            }
                            else {
                                iSign = 1;
                            }

                            objBins[iRow].Quantity = FNumberOperation.mul(dTempQty, iSign);
                        }

                        objBody.Sales.BinsData = [];
                        objBody.Sales.BinsData.push(objBins); // Issue Bin
                    }

                    if (DataType.isValidObject(objBins2) == true) {
                        objTrans.BodyData[iCounter].Sales.BinsData.push(objBins2); // Receipt Bin
                    }

                    if (DataType.isValidObject(objBody.Sales.BatchNo) == true) {
                        dTempQty = FNumberOperation.abs(objBody.Sales.BatchNo.Qty);
                        if (FNumberOperation.isLessThan(objBody.Sales.Quantity, 0) == true) {
                            iSign = -1;
                        }
                        else {
                            iSign = 1;
                        }

                        objBody.Sales.BatchNo.Qty = FNumberOperation.mul(dTempQty, iSign);
                    }
                }

                objBody.BodyId = transEntryFields.getMainBodyId(iCounter + 1);

                arrBodyData.push(objBody);
            }

            objTrans.BodyData = DataType.arrayAddRange(objTrans.BodyData, arrBodyData);

        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.prepareObjectForStockTransfer} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objTrans);
    },

