    getMasterData: function(iFieldId, value, arrMasterData) {
        let iCounter = 0;
        let iIndex = 0;
        let arrColumnMetaData = null;
        let arrAllData = null;
        let obj = null;
        let objResult = null;

        try {
            objResult = {};
            objResult.iIndex = -1;
            objResult.arrData = null;
            objResult.OrgData = null;

            for (iCounter = 0; iCounter < arrMasterData.length; iCounter++) {
                if (arrMasterData[iCounter].iFieldId == iFieldId && DataType.isNullOrEmpty(arrMasterData[iCounter].sError, true) == true) {

                    objResult.iIndex = iCounter;
                    objResult.OrgData = arrMasterData[iCounter].objOptionData;
                    break;
                }
            }

            if (iCounter >= arrMasterData.length || DataType.isValidObject(value) == false || DataType.isValidObject(arrMasterData[iCounter].objOptionData) == false) {
                return(objResult);
            }

            arrColumnMetaData = arrMasterData[iCounter].objOptionData.ColumnMetaData;
            arrAllData = arrMasterData[iCounter].objOptionData.ColumnValue;
            if (DataType.arrayLength(arrAllData) < 1) {
                return(objResult);
            }

            value = DataType.toInt(value);
            for (iCounter = 0; iCounter < arrAllData.length; iCounter++) {
                if (iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                    if(iCounter == value){ // For units value is row index start from 0
                        break;
                    }
                }
                else {
                    if (DataType.toInt(arrAllData[iCounter][0].sValue) === value) {
                        break;
                    }
                }
            }

            if (iCounter < arrAllData.length && arrColumnMetaData.length == arrAllData[iCounter].length) {
                objResult.arrData = [];
                if (iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                    for (iIndex = 0; iIndex < arrAllData[iCounter].length; iIndex++) {
                        obj = {};
                        obj[arrColumnMetaData[iIndex].Name] = arrAllData[iCounter][iIndex].sValue;
                        objResult.arrData.push(obj);
                    }
                }
                else {
                    for (iIndex = 0; iIndex < arrAllData[iCounter].length; iIndex++) {
                        obj = {};
                        obj[arrColumnMetaData[iIndex].Name] = arrAllData[iCounter][iIndex].sValue;
                        objResult.arrData.push(obj);
                    }
                }

                return(objResult);
            }
            else {
                objResult = {};
                objResult.iIndex = -1;
                objResult.arrData = null;
                objResult.OrgData = null;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body getMasterData method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.getMasterData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(objResult);
    },

    confrimAndReloadAllRowsRate: function (iFieldId, iLastValue, iDataTypeId) {
        let sId = "";
        let iCounter = 0;
        let bValue = false;
        let iActiveFieldId = 0;
        let arrRows = null;
        let arrVariables = null;
        let arrRateVariables = null;
        let arrInput = null;
        let objMetaData = null;
        let objFormula = null;
        let obj = null;

        try {
            if (EntryMain.isDataLoading() == true
                || transEntryFieldInfo.Rate.ColumnIndex < 0
                || transEntryFieldInfo.Item.FieldId == 0) {
                return (true);
            }

            if ((DataType.isNullOrEmpty(transEntryInfo.Settings.RateFormula) == false && DataType.stringStartsWithRaw(transEntryInfo.Settings.RateFormula, "&") == true)
                || transEntryRate.hasFormula() == true) {

                iCounter = EntryMainBody.getFirstEditableRow();
                if (iCounter < 1) {
                    return (true);
                }

                if (EntryMain.m_bReloadAllRates == false && EntryMain.m_bBypassRateChangeMessage == false) {
                    iActiveFieldId = EntryMainCommon.getActiveElementFieldId(); // To avoid when dependent masters also cause to rate refresh
                    if ((iActiveFieldId == 0 || iActiveFieldId == iFieldId) && transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgChangingPricebookTag")) == false) {
                        if (iFieldId > 0) {
                            sId = EntryMainUI.getHeaderControlId(iFieldId);

                            iDataTypeId = DataType.toInt(iDataTypeId);
                            if (iDataTypeId == eMasterDataType.Date) {
                                DATEPICKER.setDate(sId, iLastValue);
                            }
                            else if (iDataTypeId == eMasterDataType.Master) {
                                obj = OPTIONCONTROL.createSetValueExtraObject();
                                obj.bIgnoreChangeCallback = true;
                                OPTIONCONTROL.setValue(sId, iLastValue, null, obj);
                            }                            
                        }
                        return (false);
                    }
                }

                if (EntryMain.isDataLoading() == true
                    || transEntryFieldInfo.Rate.ColumnIndex < 0
                    || transEntryFieldInfo.Item.FieldId == 0) {
                    return (true);
                }

                if (transEntryRate.hasFormula() == false) {
                    return (true);
                }

                arrRows = [];
                for (; iCounter <= transEntryGrid.getTotalRows() ; iCounter++) {
                    if (EntryMainBody.isRowEditable(iCounter) == false) {
                        continue;
                    }

                    arrRows.push(iCounter);
                }

                if (arrRows.length < 1) {
                    return (true);
                }

                if (arrRows.length > 2) {
                    objMetaData = transEntryFieldInfo.Rate.MetaData;

                    objFormula = new FFormula();
                    objFormula.m_CalType = EntryMain.m_CalendarType;

                    arrVariables = objFormula.GetVariables(objMetaData.sPreload, true);
                    if (DataType.arrayLength(arrVariables) < 1) {
                        return;
                    }

                    for (iCounter = 0; iCounter < arrVariables.length; iCounter++) {
                        if (arrVariables[iCounter].toLowerCase() == "brt") {
                            transEntryCacheLoadedData.reloadBaseVoucherRateValue(arrRows, false);
                        }
                    }

                    arrRateVariables = [];
                    arrVariables = transEntryRate.extractVariableName(objMetaData.sPreload, false);
                    while (arrVariables.length > 0) {
                        obj = {};
                        obj.bRefresh = arrVariables[0].bRefresh;
                        obj.bPurchase = arrVariables[0].bPurchase;
                        obj.iIndex = arrVariables[0].iIndex;
                        obj.iColumn = transEntryFieldInfo.Rate.ColumnIndex;

                        arrRateVariables.push(obj);

                        arrVariables.splice(0, 1);
                    }

                    if (arrRateVariables.length > 0) {
                        arrInput = transEntryCacheLoadedData.prepareBodyRateVariablesInput(arrRows, arrRateVariables, true);

                        if (arrInput.length > 0) {
                            transEntryCache.fetchRateVariablesValue(arrInput, false);
                        }                    
                    }
                }


                EntryMain.m_bReloadAllRates = true;
                GLOBAL.LoadingStart();

                for (iCounter = 0; iCounter < arrRows.length; iCounter++) {
                    bValue = EntryMainBody.reloadRate(arrRows[iCounter]);
                }

                GLOBAL.LoadingEnd();
                if (bValue == true) {
                    EntryMainUI.setSummaryInfo(0);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body confrimAndReloadAllRowsRate method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.confrimAndReloadAllRowsRate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    reloadRate: function (iRow) {
        let dValue = 0;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objMetaData = undefined;

        try {
            if (EntryMain.isDataLoading() == true
                || transEntryFieldInfo.Rate.ColumnIndex < 0
                || transEntryFieldInfo.Item.FieldId == 0) {
                return (false);
            }

            if (EntryMainMemoryObject.getProductValue(iRow) < 1) {
                return (false);
            }

            if (transEntryRate.hasFormula() == false) {
                return (false);
            }

            objMetaData = transEntryFieldInfo.Rate.MetaData;
            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, iRow, null, transEntryFieldInfo.Rate.ColumnIndex, objMetaData.sFieldName);
            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
            dValue = FConvert.toDecimal(objFormulaOutput.Value);
            dValue = transEntryRate.update(dValue, iRow);
            transEntryGross.calculateAndUpdate({ iRow: iRow, dRate: dValue });
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body reloadRate method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.reloadRate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

