        setFilterCriteria: function (arrFilterCriteria) {
            var iRowCounter = 0;
            var iColCounter = 0;
            var eleGrid = null;
            var cellObj = null;
            var MasterDropDown = null;

            try {
                if (FCommon.Array.getLength(arrFilterCriteria) <= 0) {
                    return;
                }

                eleGrid = CONFIGURETRANS.EDITLAYOUT.getFilterCriteriaGrid();
                for (iRowCounter = 0; iRowCounter < arrFilterCriteria.length; iRowCounter++) {
                    for (iColCounter = 0; iColCounter < 6; iColCounter++) {
                        cellObj = FGRIDCONTROL.getCellObject(eleGrid, iRowCounter + 1, iColCounter + 1);
                        if (COMMON.prototype.isValidObject(cellObj) == false) {
                            continue;
                        }

                        switch (iColCounter) {
                            case 0: // Filter On Column
                                cellObj.setCellText(arrFilterCriteria[iRowCounter].FilterOnColumn, arrFilterCriteria[iRowCounter].FilterOnColumnValue);
                                //MasterDropDown = CONFIGURETRANS.EDITLAYOUT.getFilterOnColumnElement();
                                //MasterDropDown.value = arrFilterCriteria[iRowCounter].FilterOnColumnValue;
                                //cellObj.setCellText(MasterDropDown.value != "" ? MasterDropDown.selectedOptions[0].textContent : "");
                                //cellObj.setCellData("value", MasterDropDown.value);
                                break;
                            case 1: // Operator
                                MasterDropDown = CONFIGURETRANS.EDITLAYOUT.getFilterOperatorElement();
                                MasterDropDown.value = arrFilterCriteria[iRowCounter].OperatorID;
                                cellObj.setCellText(MasterDropDown.value != "" ? MasterDropDown.selectedOptions[0].textContent : "");
                                cellObj.setCellData("value", MasterDropDown.value);
                                break;
                            case 2: // Compare With
                                MasterDropDown = CONFIGURETRANS.EDITLAYOUT.getCompareWithElement();
                                MasterDropDown.value = arrFilterCriteria[iRowCounter].CompareWith;
                                cellObj.setCellText(MasterDropDown.value != "" ? MasterDropDown.selectedOptions[0].textContent : "");
                                cellObj.setCellData("value", MasterDropDown.value);
                                break;
                            case 3: // Filter Value/Field
                                var compareWith = arrFilterCriteria[iRowCounter].CompareWith;

                                if (FConvert.toInt(arrFilterCriteria[iRowCounter].CompareWith) == 0) { // Value
                                    cellObj.setCellText(arrFilterCriteria[iRowCounter].FilterField, arrFilterCriteria[iRowCounter].FilterField);
                                }
                                else { // Field
                                    MasterDropDown = CONFIGURETRANS.editLayout_FieldsCustomization_FieldDetails_FilterCriteriaOprChange(compareWith);
                                    MasterDropDown.value = arrFilterCriteria[iRowCounter].FilterFieldID;
                                    cellObj.setCellText(compareWith == 1 ? MasterDropDown.value != "" ? MasterDropDown.selectedOptions[0].textContent : "" : MasterDropDown.value);
                                    cellObj.setCellData("value", MasterDropDown.value);
                                }

                                break;
                            case 4: // Link Field
                                MasterDropDown = document.getElementById("editLayout_FieldsCustomization_FieldDetails_linkFldTxtbx");
                                MasterDropDown.value = arrFilterCriteria[iRowCounter].LinkField;
                                cellObj.setCellText(MasterDropDown.value);
                                cellObj.setCellData("value", MasterDropDown.value);
