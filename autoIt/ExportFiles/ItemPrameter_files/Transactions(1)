    initBodyRateVariablesPosition: function () {
        let iCounter = 0;
        let objMetaData = null;
        let arrFields = undefined;
        let arrVariable = null;
        let obj = null;

        try {
            this.arrRateVariables = [];

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;

                arrVariable = transEntryRate.extractVariableName(objMetaData.sPreload, true);
                if (arrVariable.length == 0) {
                    arrVariable = transEntryRate.extractVariableName(objMetaData.sPreload, false);
                }
                while (arrVariable.length > 0) {
                    if (arrVariable[0].bRefresh == true) {
                        obj = {};
                        obj.bRefresh = arrVariable[0].bRefresh;
                        obj.bPurchase = arrVariable[0].bPurchase;
                        obj.sAbbr = arrVariable[0].sAbbr;
                        obj.Index = arrVariable[0].iIndex;
                        obj.iIndex = arrVariable[0].iIndex;
                        obj.iColumn = iCounter;                        
                        this.arrRateVariables.push(obj);
                    }

                    arrVariable.splice(0, 1);
                }

                if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                    arrVariable = transEntryRate.extractVariableName(objMetaData.sDefaultValue, true);
                    if (arrVariable.length == 0) {
                        arrVariable = transEntryRate.extractVariableName(objMetaData.sDefaultValue, false);
                    }

                    while (arrVariable.length > 0) {
                        if (arrVariable[0].bRefresh == true) {
                            obj = {};
                            obj.bRefresh = arrVariable[0].bRefresh;
                            obj.bPurchase = arrVariable[0].bPurchase;
                            obj.sAbbr = arrVariable[0].sAbbr;
                            obj.Index = arrVariable[0].iIndex;
                            obj.iIndex = arrVariable[0].iIndex;
                            obj.iColumn = iCounter;
                            this.arrRateVariables.push(obj);
                        }

                        arrVariable.splice(0, 1);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("Exception: {transEntryCacheLoadedData.initBodyRateVariablesPosition} " + err.message);
        }
    },

    setMasterVariableName: function (arrMasterVariables, objData, iColumn) {
        let iCounter = 0;
        let obj = null;

        try {
            for (iCounter = 0; iCounter < arrMasterVariables.length; iCounter++) {
                if (arrMasterVariables[iCounter].sVariableName == objData.sVariableName) {
                    if (arrMasterVariables[iCounter].bRefresh == true) {
                        return;
                    }

                    if (objData.bRefresh == true) {
                        arrMasterVariables[iCounter].bRefresh = true;
                        arrMasterVariables[iCounter].iColumn = iColumn;

                        return;
                    }

                    if (arrMasterVariables[iCounter].iColumn < 0 && objData.bSingle == true) {
                        arrMasterVariables[iCounter].iColumn = iCounter;
                        return;
                    }
                    break;
                }
            }

            if (iCounter >= arrMasterVariables.length) {
                obj = {};
                obj.sVariableName = objData.sVariableName;
                obj.iMasterTypeId = objData.iMasterTypeId;
                obj.bRefresh = objData.bRefresh;

                if (objData.bSingle == true) {
                    obj.iColumn = iColumn;
                }
                else {
                    obj.iColumn = -1;
                }

                arrMasterVariables.push(obj);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("Exception: {transEntryCacheLoadedData.setMasterVariableName} " + err.message);
        }
    },

