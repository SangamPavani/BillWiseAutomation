    convertObjectToKeyValueArray: function (objData) {
        let iCounter = 0;
        let arrData = null;
        let result = null;
        let obj = null;

        try {
            arrData = [];
            result = DataType.arrayFromObject(objData, true);
            for (iCounter = 0; iCounter < result.property.length; iCounter++) {
                obj = {};
                obj.Key = result.property[iCounter];
                obj.Value = result.value[iCounter];

                arrData.push(obj);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{EntryMainCommon.convertObjectToKeyValueArray} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
    },

    convertKeyValueArrayToObject: function (arrKeyValue) {
        let iCounter = 0;
        let iIndex = 0;
        let iLength = 0;
        let sKey = "";
        let value = null;
        let arrData = null;
        let result = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = {};

            iLength = DataType.arrayLength(arrKeyValue);
            if(iLength <= 0) {
                if(DataType.isValidObject(arrKeyValue) == false) {
                    return (result);
                }

                arrData = EntryMainCommon.convertObjectToKeyValueArray(arrKeyValue);
                if(arrData.length < 1) {
                    return (result);
                }

                for(iIndex = 0; iIndex < arrData.length; iIndex++) {
                    sKey = arrData[iIndex].Key;
                    result.data[sKey] = arrData[iIndex].Value;
                    result.lValue++;
                }

                return (result);
            }

            for (iCounter = 0; iCounter < iLength; iCounter++) {
                sKey = arrKeyValue[iCounter].Key;

                if(sKey == undefined) {
                    arrData = EntryMainCommon.convertObjectToKeyValueArray(arrKeyValue[iCounter]);
                    if(arrData.length < 1) {
                        continue;
                    }

                    for(iIndex = 0; iIndex < arrData.length; iIndex++) {
                        sKey = arrData[iIndex].Key;
                        result.data[sKey] = arrData[iIndex].Value;
                        result.lValue++;
                    }

                    continue;                    
                }

                value = result.data[sKey];                
                if (DataType.isValidObject(value) == true) {
                    if (Array.isArray(value) == true) {
                        value.push(arrKeyValue[iCounter].Value);
                        result.data[sKey] = value;
                    }
                    else {
                        result.data[sKey] = [];
                        result.data[sKey].push(value);
                        result.data[sKey].push(arrKeyValue[iCounter].Value);
                    }
                }
                else {
                    result.data[sKey] = arrKeyValue[iCounter].Value;
                    result.lValue++;
                }
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;

            transEntryGlobal.writeErrorLog("{EntryMainCommon.convertKeyValueArrayToObject} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

