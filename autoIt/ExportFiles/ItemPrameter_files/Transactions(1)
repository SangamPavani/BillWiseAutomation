        }
        else if (sOpt == "||") {
            result = (b1 || b2);
        }

        return (result);
    },

    TempResultForDouble: function (dValue1, dValue2, sOperator) {
        let bResult = false;

        if (sOperator == ">") {
            bResult = FNumberOperation.isGreaterThan(dValue1, dValue2);
            //bResult = dValue1 > dValue2;
        }
        else if (sOperator == "<") {
            bResult = FNumberOperation.isLessThan(dValue1, dValue2);
            //bResult = dValue1 < dValue2;
        }
        else if (sOperator == "==") {
            bResult = FNumberOperation.isEqualTo(dValue1, dValue2);
            //bResult = (dValue1 == dValue2);
        }
        else if (sOperator == "!=") {
            bResult = FNumberOperation.isNotEqualTo(dValue1, dValue2);
            //bResult = (dValue1 != dValue2);
        }
        else if (sOperator == "<=") {
            bResult = FNumberOperation.isLessThanOrEqualTo(dValue1, dValue2);
            //bResult = (dValue1 <= dValue2);
        }
        else if (sOperator == ">=") {
            bResult = FNumberOperation.isGreaterThanOrEqualTo(dValue1, dValue2);
            //bResult = (dValue1 >= dValue2);
        }

        return (bResult);
    },

    isFunction: function (strVar, bMatchWhole) {
        strVar = strVar.toLowerCase();
        if (bMatchWhole == true) {

            if (strVar.localeCompare("cond") == 0
                || strVar.localeCompare("min") == 0
                || strVar.localeCompare("max") == 0
                || strVar.localeCompare("dateadd") == 0
                || strVar.localeCompare("datediff") == 0) {

                return true;
            }
            else {
                return false;
            }
        }
        else {
            if (strVar.startsWith("cond(")
                || strVar.startsWith("min(")
                || strVar.startsWith("max(")
                || strVar.startsWith("dateadd(")
                || strVar.startsWith("datediff(")) {

                return true;
            }
            else {
                return false;
            }
        }
    },

    isStringType: function (sInfix) {
        let iCounter = 0;

        try {
            while (sInfix.length > 0) {
                if (sInfix.charAt(0) == '(') {
                    sInfix = sInfix.substr(1);
                }
                else {
                    break;
                }
            }

            while (sInfix.length > 0) {
                if (sInfix.charAt(sInfix.length - 1) == ')') {
                    sInfix = sInfix.substr(0, sInfix.length - 1);
                }
                else {
                    break;
                }
            }

            if (sInfix.length > 1 && sInfix.charAt(0) == '\'') {
                for (iCounter = 1; iCounter < sInfix.length; iCounter++) {
                    if (sInfix.charAt(iCounter) == '\'') {
                        if (iCounter == (sInfix.length - 1)) {
                            return (true);
                        }

                        break;
                    }
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FFormula.isStringType} " + err.message);
        }

        return (false);
    },

    isStringTypeValue: function (value) {
        if (DataType.isString(value) == true && DataType.stringStartsWith(value, "'") == true && DataType.stringEndsWith(value, "'") == true) {
            return (true);
        }

        return (false);
    },

    isNumericValue: function (value) {
        if (FormulaHelper.isStringTypeValue(value) == true) {
            value = FormulaHelper.convertStringTypeValueToNumeric(value);
            if (DataType.isNumeric(value) == true) {
                return (true);
            }

            return (false);
        }
        else if (DataType.isNumeric(value) == true) {
            return (true);
        }

        return (false);
    },

    convertStringTypeValueToNumeric: function (value) {
        try {
            value = value.substr(0, value.length - 1);
            value = value.substr(1);
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {FormulaHelper.convertStringTypeValueToNumeric} " + err.message);
        }

        return (value);
    }
};
