        let iCounter = 0;
        let iIndex = 0;

        try {
            for (iCounter = 0; iCounter < arrVariables.length; iCounter++) {
                sVariable = arrVariables[iCounter].toLowerCase();
                if (DataType.stringStartsWithRaw(sVariable, "sqlf") == false && DataType.stringStartsWithRaw(sVariable, "sqlsf") == false) {
                    continue;
                }

                if (bAllRowsOnly == true && DataType.stringStartsWithRaw(sVariable, "sqlfa") == false) {
                    continue;
                }

                for (iIndex = 0; iIndex < arrOutput.length; iIndex++) {
                    if (arrOutput[iIndex] == arrVariables[iCounter]) {
                        break;
                    }
                }

                if (iIndex >= arrOutput.length) {
                    arrOutput.push(arrVariables[iCounter]);
                }
