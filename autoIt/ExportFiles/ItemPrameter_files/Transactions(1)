    isVariable: function (sValue) {
        let iFactor = 0;
        let obj = null;

        try {
            obj = {};
            obj.bResult = false;
            obj.bRefresh = false;
            obj.sVariable = "";

            if (DataType.isNullOrEmpty(sValue, true) == true) {
                return (obj);
            }

            sValue = sValue.trim();
            sValue = sValue.toLowerCase();

            iFactor = sValue.indexOf('-') == 0 ? -1 : 1;
            if (iFactor == -1) {
                sValue = sValue.substr(1);
            }


            obj.bRefresh = DataType.stringStartsWithRaw(sValue, "&");
            if (obj.bRefresh == true) {
                sValue = sValue.substr(1);
            }

            if (DataType.stringStartsWithRaw(sValue, "srt")) {
                obj.bResult = true;
                obj.sVariable = "salrt";
            }
            else if (DataType.stringStartsWithRaw(sValue, "prt")) {
                obj.bResult = true;
                obj.sVariable = "purrt";
            }
            else {
                if (EntryMainPreload.isMasterVariable(sValue).Value == true) {
                    obj.bResult = true;
                    obj.sVariable = sValue;

                    return (obj);
                }


                if (EntryMainPreload.isScreenBodyVariable(sValue).Value == true) {
                    obj.bResult = true;
                    obj.sVariable = sValue;

                    return (obj);
                }

                if (EntryMainPreload.isScreenFooterVariable(sValue).Value == true)
                {
                    obj.bResult = true;
                    obj.sVariable = sValue;

                    return (obj);
                }

                if (EntryMainPreload.isLayoutVarible(sValue).Value == true) {
                    obj.bResult = true;
                    obj.sVariable = sValue;

                    return (obj);
                }

                if (EntryMainCommon.isMatch("^sqlf[\\d]+$", sValue) == true) {
                    obj.bResult = true;
                    obj.sVariable = "sqlf";

                    return (obj);
                }

                if (EntryMainCommon.isMatch("^sqlsf[\\d]+$", sValue) == true) {
                    obj.bResult = true;
                    obj.sVariable = "sqlsf";

                    return (obj);
                }

                switch (sValue) {
                    case "dt": // Document Date
                    case "ddt": // Due Date
                    case "td":  // Today
                    case "qty": // Quantity
                    case "tqty": // Total Quantity
                    case "qtya":  // Alternate Qty
                    case "tqtya": // Total Alternate Quantity
                    case "rt": // Rate
                    case "gr":  // Gross
                    case "tgr":  // Total Gross                    
                    case "stkv":  // Stock Value
                    case "stkq":  // Stock Quantity
                    case "stkqa":  // Stock quantity alternate
                    case "stkc": // Clear Stock
                    case "rstk": // Reserved qty
                    case "accbal": // FA tagwise code balance
                    case "acc2bal": // FA tagwise book balance
                    case "accbalo": // Overall code balance
                    case "acc2balo": // Overall book balance
                    case "prod": // Product
                    case "clr": // Credit Limit Remaining
                    case "odd":
                    case "acc":   // Account (Code)
                    case "acc2":  // Account2 (Book)
                    case "grpa":  // Account group Id (MasterId and Level are parameters)
                    case "grpp":  // Product group Id (MasterId and Level are parameters)
                    case "exrt":  // Exchange rate
                    case "lexrt": // Local Exchange Rate
                    case "trt":  // Today's rate
