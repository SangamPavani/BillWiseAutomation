    deleteTreeDependencyRow: function (iRow) {
        let iCounter = 0;

        try {
            for (iCounter = 0; iCounter < this.m_arrTreeDependency.length; iCounter++) {
                if (this.m_arrTreeDependency[iCounter].iRow === iRow) {
                    this.m_arrTreeDependency.splice(iCounter, 1);
                    iCounter--;
                }
            }

            for (iCounter = 0; iCounter < this.m_arrTreeDependency.length; iCounter++) {
                if (this.m_arrTreeDependency[iCounter].iRow > iRow) {
                    this.m_arrTreeDependency[iCounter].iRow--;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.deleteTreeDependencyRow} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateTreeDependencyRow: function (iRow) {
        let iCounter = 0;
        let arrData = null;
        let obj = null;

        try {
            arrData = [];
            for (iCounter = 0; iCounter < this.m_arrTreeDependency.length; iCounter++) {
                obj = this.m_arrTreeDependency[iCounter];
                if (obj.iRow == iRow) {
                    obj = DataType.createDuplicateObject(obj);
                    obj.iRow++;
                    arrData.push(obj);
                    continue;
                }

                if (obj.iRow >= iRow) {
                    this.m_arrTreeDependency[iCounter].iRow++;
                }
            }

            while (arrData.length > 0) {
                this.m_arrTreeDependency.push(arrData[0]);
                arrData.splice(0, 1);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.updateTreeDependencyRow}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    deleteTreeDependencyRowData: function (iRow, iFieldId) {
