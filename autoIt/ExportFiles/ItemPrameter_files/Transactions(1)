    checkForSellBelowCostRestriction: function () {
        let iCounter = 0;
        let iNoOfDecimals = 0;
        let dRate = 0;
        let dExchangeRate = 0;
        let bValidRow = true;
        let arrRowIndex = [];
        let objMinRateInput = undefined;

        try {
            if (transEntryGlobal.bCheckRateForSellBelowCostBeforeSave == false) {
                return (true);
            }

            if (transEntryFieldInfo.Item.FieldId == 0) {
                return (true);
            }

            if (transEntryInfo.isInwardVoucher == true) {
                return (true);
            }

            if (transEntryInfo.Settings.Inventory.ProductRate != 0) {
                return (true);
            }

            if (GlobalPref.LoginId == GlobalPref.SUPER_USER || EntryMain.checkPermission(SecurityActions.AllowToSellBelowCost) == false) {
                bUnitExist = transEntryFieldInfo.Unit.ColumnIndex > -1;
                bBatchExist = transEntryFieldInfo.BatchNo.ColumnIndex > -1;

                if (transEntryInfo.isItTransfer == false) {
                    iInvTagArea = transEntryInvTag.getArea()
                }

                objMinRateInput = EntryMainUI.getMinRateInput(0);
                if (objMinRateInput.arrProductId.length > 0) {
                    result = transEntryServer.execute(eTransServerRequest.GetMinRate, objMinRateInput, false);
                    if (result.lValue > 0) {
                        result = result.data;
                        if (result.lValue > 0) {
                            result = result.data;

                            iNoOfDecimals = transEntrySettings.getDecimalsInAmount();
                            for (iCounter = 0; iCounter < objMinRateInput.arrProductId.length; iCounter++) {
                                dRate = result[iCounter];

                                if (transEntryFieldInfo.ExchangeRate.Area == eTranEntryFieldArea.Body) {
                                    dExchangeRate = objMinRateInput.arrExchangeRate[iCounter];                                    
                                }
                                else {
                                    dExchangeRate = objMinRateInput.arrExchangeRate[0];
                                }

                                dRate = DataType.div(dRate, dExchangeRate);

                                if (DataType.neq(dRate, 0) == true && objMinRateInput.bUnitExist == true) {
                                    fConversion = objMinRateInput.arrUnitConversion[iCounter];
                                    dRate = DataType.mul(dRate, fConversion);
                                }

                                dRate = DataType.toDecimal(dRate, iNoOfDecimals, true);
                                if (DataType.lt(objMinRateInput.arrOrigRate[iCounter], dRate) == true) {
                                    arrRowIndex.push({ Index: iCounter, bInvalid: true });
                                    bValidRow = false;
                                }
                                else {
                                    arrRowIndex.push({ Index: iCounter, bInvalid: false });
                                }
                            }
                        }
                    }
                }
            }

            if (arrRowIndex.length > 0) {
                for (iCounter = 0; iCounter < arrRowIndex.length; iCounter++) {
                    if (arrRowIndex[iCounter].bInvalid == true) {
                        transEntryGrid.showRowSymbol(arrRowIndex[iCounter].Index + 1, true);
                    }
                    else {
                        transEntryGrid.showRowSymbol(arrRowIndex[iCounter].Index + 1, false);
                    }
                }

                if (bValidRow == false) {
                    transEntryGlobal.showAlert("Marked row rate cannot be below cost.", GlobalPref.getResourceValue("Error"));
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.checkForSellBelowCostRestriction} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bValidRow);
    },

    saveData: function (bSuspend, sCallback, iSaveSource) {
        let iCount = 0;
        let obj = null;

        try {
            if (transEntryGlobal.debugSave == true) {
                debugger
            }

            bSuspend = DataType.toBoolean(bSuspend);
            sCallback = DataType.toString(sCallback);

            if (EntryMainUI.isSavingTimeRestrictd() == true) {
                transEntryGlobal.showAlert("Cannot save data due to user time restriction.", GlobalPref.getResourceValue("Error"));
                return;
            }

            if (EntryMainBatch.validateForDuplicateBatch() == false) {
                return;
            }

            if(EntryMainProductionProcess.beforeSave(bSuspend) == false) {
                return;
            }

            transEntryGlobal.ExtraInfo = {};
            transEntryGlobal.ExtraInfo.bSuspend = bSuspend;
            transEntryGlobal.ExtraInfo.iSaveSource = DataType.toInt(iSaveSource);
            transEntryGlobal.ExtraInfo.dNetAmount = EntryMainUI.getNetAmount();

            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, false);
