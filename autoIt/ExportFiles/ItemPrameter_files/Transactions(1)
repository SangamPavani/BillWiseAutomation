    this.getIncrementalGridValue = function () {
        var iRow = 0;
        var sGridId = "";
        var arrIncrementalSeries = null;
        var cell = null;
        var value = null;
        var obj = {};

        try {
            sGridId = this.getIncrementalGridId();
            arrIncrementalSeries = [];

            FGRIDCONTROL.update(sGridId);

            iTotal = FGRIDCONTROL.getTotalRows(sGridId);
            for (iRow = 1; iRow <= iTotal; iRow++) {
                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 1); // Type
                value = FConvert.toString(cell.getCellData());
                if (value == "") {
                    continue;
                }

                obj = {};
                obj.Type = FConvert.toInt(value);

                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 2); // Field/Value
                obj.FieldValue = FConvert.toInt(cell.getCellData());

                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 3); // Starting Character
                obj.StartPosition = FConvert.toInt(cell.getCellData());

                cell = FGRIDCONTROL.getCellObject(sGridId, iRow, 4); // No of Characters
                obj.NumberOfChars = FConvert.toInt(cell.getCellData());

                obj.VoucherType = selectedVoucherType.id;

                arrIncrementalSeries.push(obj);
            }

            if (arrIncrementalSeries.length > 0) {
                for (iRow = 0; iRow < arrIncrementalSeries.length; iRow++) {
                    if (arrIncrementalSeries[iRow].Type > 2) { // Increment
                        break;
                    }
                }

                if (iRow >= arrIncrementalSeries.length) {
                    COMMON.prototype.showMessage("Increment type is mandatory.", "Error");

                    return;
                }
                else if (iRow < (arrIncrementalSeries.length - 1)) {
                    COMMON.prototype.showMessage("Increment type must be selected in last row.", "Error");

                    return;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocLayoutField_Customization.getIncrementalGridValue} " + err.message, "Exception");
        }

        return (arrIncrementalSeries);
    }

    this.setIncrementalGridValue = function (arrIncrementalSeries) {
        var iRow = 0;
        var iColumn = 0;
        var iTotal = 0;
        var ele = null;
        var cell = null;

        try {
            if (FCommon.Array.getLength(arrIncrementalSeries) == 0) {
                return;
            }

            iTotal = FGRIDCONTROL.getTotalRows(this.getIncrementalGridId());

            FGRIDCONTROL.deleteRows(this.getIncrementalGridId(), 1, iTotal);
            FGRIDCONTROL.insertRows(this.getIncrementalGridId(), 0, (arrIncrementalSeries.length + 1));

            for (iRow = 0; iRow < arrIncrementalSeries.length; iRow++) {
                for (iColumn = 0; iColumn < 4; iColumn++) {
                    cell = FGRIDCONTROL.getCellObject(this.getIncrementalGridId(), iRow + 1, iColumn + 1);
                    if (FCommon.UI.isValidObject(cell) == false) {
                        continue;
                    }

                    switch(iColumn)
                    {
                        case 0: // Type
                            //ele = document.getElementById("docNum_TypeDropDown");
                            ele = DocLayoutField_Customization.getIncrementalGridColumnElement(iColumn + 1);
                            ele.value = arrIncrementalSeries[iRow].Type;
                            if (ele.selectedOptions.length > 0) {
                                cell.setCellText(ele.selectedOptions[0].textContent, ele.value);
                            }
                            break;
                        case 1: // FieldValue
                            ele = DocLayoutField_Customization.getIncrementalGridColumnElement(iColumn + 1, FConvert.toInt(arrIncrementalSeries[iRow].Type));
                            //ele = CONFIGURETRANS.ElementBasedOnGriValue(FConvert.toInt(arrIncrementalSeries[iRow].Type), "editLayout_FieldsCustomization_IncCondFieldTxtbox");
                            ele.value = arrIncrementalSeries[iRow].FieldValue;
                            if (ele.nodeName.toLowerCase() == "select") {
                                cell.setCellText(ele.selectedOptions[0].textContent, arrIncrementalSeries[iRow].FieldValue);
                            }
                            else {
                                cell.setCellText(ele.value, ele.value);
                            }
                            break;
                        case 2: // Starting Character
                            cell.setCellText(arrIncrementalSeries[iRow].StartPosition, arrIncrementalSeries[iRow].StartPosition);
                            break;
                        case 3: // No of Characters
                            cell.setCellText(arrIncrementalSeries[iRow].NumberOfChars, arrIncrementalSeries[iRow].NumberOfChars);
                            break;
                    }
                }
            }

            CONFIGURETRANS.DocumentNumGridrowChange(this.getIncrementalGridId());
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocLayoutField_Customization.setIncrementalGridValue} " + err.message, "Exception");
        }
    }

