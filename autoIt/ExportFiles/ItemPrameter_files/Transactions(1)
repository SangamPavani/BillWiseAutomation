                    }

                    bConsolidateOnDoc = objData.arrLinks[0].LinkDefn.bConsolidateOnDoc;
                    bDonotRestrictTagsWhileLoading = objData.arrLinks[0].LinkDefn.DonotRestrictTagsWhileLoading;
                }

                iLinkColumnIndex = EntryMainWorkflow.getDropdownSelectedLinkColumnIndex();
                arrUsedLinks = EntryMainWorkflow.getUsedLinkDataRows(iLinkColumnIndex).data;
                arrLoadedLinks = EntryMainWorkflow.getLoadedLinkData(iLinkColumnIndex).data;

                arrFields = DataType.arrayFilterData(objData.arrFields, "Tag", null, "ISNOTNULL");
                transEntryServer.loadWorkflowDetailScreen(iLinkId,
                                                            iBaseVoucher,
                                                            iLinkVoucher,
                                                            iLinkField,
                                                            iTransactionDate,
                                                            arrFields,
                                                            null,
                                                            false,
                                                            0,
                                                            transEntrySettings.isNotRestrictOnLoginTag,
                                                            bConsolidateOnDoc,
                                                            bDonotRestrictTagsWhileLoading,
                                                            arrUsedLinks,
                                                            arrLoadedLinks);
            }

            bResult = true;
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.onWorkflow_Selchange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bResult);
    },

