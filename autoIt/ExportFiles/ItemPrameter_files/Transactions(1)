    arrayToTree: function (arrObjects) {
        //take an array and gives a tree
        let map = [];
        let roots = [];
        let node = {};
        let currentNode = {};
        let currentParent = {};
        let totalnodes = 1;
        let currentdepth = 1;
        let isSameRoot = false;
        let NodeRoot = null;
        let tempParent = null;
        let depthcount = 0;

        try{
            for (var i = 0; i < arrObjects.length; i += 1) {
                node = arrObjects[i];
                node.children = [];
                map[node.Id] = i; // use map to look-up the parents
                if (node.Parent !== 0) {
                    if (arrObjects[map[node.Parent]] != undefined) {
                        arrObjects[map[node.Parent]].children.push(node);
                        // arrObjects[map[node.Parent]].treedepth = depth + 1;
                        if (node.Parent == currentParent.Id) { // node is children of same parent
                            currentdepth++;
                            // totalnodes++;
                        }

                        if (node.Parent == currentParent.Id) {
                            isSameRoot = true;
                        }//direct child of parent
                        else if (map[currentParent.Parent]) {
                            if( arrObjects[map[currentParent.Parent]].Id === node.Parent || //grand childs of parent
                            arrObjects[map[node.Parent]].Id === currentParent.Parent){
                                isSameRoot = true;
                            }
                        }
                        else {
                            isSameRoot = false;
                        }

                        if (isSameRoot) {
                            totalnodes = totalnodes + 1;
                        }
                        if (node.Group == true) { //&&
                            currentParent = node;
                            isSameRoot = false;// resetting for new parent
                        }
                        else if(!isSameRoot){ // if leaf node and not of current root
                            // totalnodes++;
                            //find its root node and increment totalnodes there
                            tempParent = arrObjects[map[node.Parent]];
                            depthcount = 0;
                            while (tempParent.Parent !== 0 && map[tempParent.Parent] != undefined && depthcount < currentdepth) {
                                // if (depthcount < currentdepth ) {
                                tempParent = arrObjects[map[tempParent.Parent]];
                                // }
                                depthcount++;
                            }

                            NodeRoot = tempParent;
                            NodeRoot.totalnodes += 1;
                        }
                    }
                    else {
                        currentNode = node;
                        currentParent = node;
                        roots.push(currentNode);
                        totalnodes = currentdepth = 1; //resetting values for new root node
                    }
                    currentNode.totalnodes = totalnodes;
                    currentNode.nodesdepth = currentdepth;
                    //  depth = currentNode.treedepth;
                } else {
                    roots.push(node);
                    node.totalnodes = 1;
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.arrayToTree}" + err.message, "EXCEPTION");
        }

        return roots;
    },

    getTreeIndexAndTotalNodes: function (arrTree,istartindex) {
        let totalnodes = 0;
        let treeindex = 0;
        let result = {};

        try {
            if (!istartindex) {
                istartindex = 0;
            }

            for (var iCounter = istartindex; iCounter < arrTree.length; iCounter++) {
                totalnodes++; // increment 1 for each tree record 
                totalnodes += arrTree[iCounter].totalnodes;
                if (totalnodes > 500) {
                    treeindex = iCounter - 1;
                    totalnodes -= arrTree[iCounter].totalnodes;
                    break;
                }
                //for last set of rows and index
                if (iCounter == arrTree.length - 1 && totalnodes > 1) {
                    treeindex = iCounter;
                }
            }
            //in case if none index is selected
            if (treeindex == istartindex - 1 && totalnodes <= 1) {
                //take next index element , irrespective of its size,
                treeindex += 1;
                totalnodes = arrTree[treeindex].totalnodes;
            }
            result.treeindex = treeindex;
            result.totalnodes = totalnodes;
            return result;
        }
        catch (err) {
            COMMON.prototype.showMessage("{INVOICEDESIGN.getTreeIndex}" + err.message, "EXCEPTION");
        }
    },

    getTreePages_CountAndRecords: function (arrTree) {
        let totalpages = 1;
        let totalnodes = 0;
        let pagerecordsmap = [0]; // maps page numbers to no of records in it
        let pageindicesmap = [0]; //maps page numbers to index of arrTree covered in it
        let arrIndices = [];
        let ipointer = 0;
        let result = {};

        try {
            for (var iCounter = 0; iCounter < arrTree.length; iCounter++) {
                totalnodes++; // increment 1 for each tree record 
                if(ipointer < arrTree.length)
                    iCounter = ipointer;
                totalnodes += arrTree[iCounter].totalnodes;
                arrIndices.push(ipointer);
                ipointer++;
                if (totalnodes > 500) {
                    totalpages++;
                    totalnodes -= arrTree[iCounter].totalnodes;
                    if (totalnodes <= 1) { // then keep it
                        totalnodes += arrTree[iCounter].totalnodes;
                    }
                    else {
                        arrIndices.pop();
                        ipointer--;
                    }
                    pagerecordsmap.push(totalnodes);
                    pageindicesmap.push(arrIndices);
                    arrIndices = []; // resets
                    totalnodes = 0; // resets
                }
            }
            if (totalnodes > 1) { // for last set of records,set in last page
               // totalpages++;
                pagerecordsmap.push(totalnodes);
                pageindicesmap.push(arrIndices);
            }
            result.totalpages = totalpages;
            result.pagerecordsmap = pagerecordsmap;
            result.pageindicesmap = pageindicesmap;
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.getTreeTotalPages}" + err.message, "EXCEPTION");
        }
        return result;
    },

    fillTreeRecursive: function(arrTreeData,rowno,leftpad,currentLevel) {        
        let result = null;

        try {
            leftpad += 15; currentLevel++;
            for (var i = 0; i < arrTreeData.length; i++) {
                rowno = rowno + 1;
                if (BinsUI.m_isPaging) {
                    if (BinsUI.m_MultiSelectedBins && BinsUI.m_MultiSelectedBins.length > 0) {
                        result = ($.grep(BinsUI.m_MultiSelectedBins, function (e) {
                            return e.Id == arrTreeData[i];
                        }));
                        if (result != null && result.length > 0) {
                            arrTreeData[i].ToBeAllocated = result[0].ToBeAllocated;
                        }
                    }
                }
                rowEle = BinsUI.setRowData(arrTreeData[i], rowno, leftpad, currentLevel);
                if (rowEle) {
                    if (rowEle.style.display == "none") {
                        rowEle.style.display = "";
                    }
                }
                if (arrTreeData[i].Group == true) {
                    rowno = this.fillTreeRecursive(arrTreeData[i].children, rowno, leftpad, currentLevel);
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.fillTreeRecursive}" + err.message, "EXCEPTION");
        }
        return rowno;
    },

