                        else
                        {
                            // Reduce +ve, incr -ve
                            if (DataType.gt(dOrig1, 0) == true)
                            {
                                objTransaction.BodyData[0].OriginalAmounts[0] = DataType.sub(objTransaction.BodyData[0].OriginalAmounts[0], dDiff);
                            }
                            else
                            {
                                objTransaction.BodyData[0].OriginalAmounts[0] = DataType.sub(objTransaction.BodyData[0].OriginalAmounts[0], dDiff);
                            }
