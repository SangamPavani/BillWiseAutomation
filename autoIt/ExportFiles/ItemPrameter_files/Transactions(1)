    validateChequeNo: function (iFieldId) {
        let sId = "";
        let sOldValue = "";
        let sValue = "";
        let iBookNo = 0;
        let obj = undefined;

        try {
            if (transEntryInfo.BaseVoucherType != eVTTYPE.CASHP && transEntryInfo.BaseVoucherType != eVTTYPE.MEMOP) {
                return (false);
            }

            if (transEntryInfo.Settings.Misc.MaintainChequeSeries == false) {
                return (false);
            }

            if (transEntryFieldInfo.ChequeNo.Area != eTranEntryFieldArea.Header) {
                return (false);
            }

            if (transEntryFieldInfo.ChequeNo.FieldId != iFieldId) {
                return (false);
            }

            iBookNo = EntryMain.m_objTrans.BodyData[0].Book;
            if (iBookNo < 1) {
                return (false);
            }

            sId = EntryMainUI.getHeaderControlId(transEntryFieldInfo.ChequeNo.FieldId);
            sOldValue = DataType.toString(FUIElement.getAttribute(sId, "olddata"));
            sValue = FUIElement.getText(sId);
            if (sValue != sOldValue) {
                obj = {};
                obj.iHeaderId = transEntryInfo.HeaderId;
                obj.sChequeNo = sValue;
                obj.iBookNo = iBookNo;
                transEntryServer.execute(eTransServerRequest.IsChequeValid, 
                                            obj, 
                                            true, 
                                            "EntryMainCallback.isChequeValid",
                                            sId);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.validateChequeNo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    setNewVoucherNo: function (bDateChanged, iMasterTypeId) {
        let iCounter = 0;
        let result = null;
        let objVWVoucherSeries = null;
        let bChange = false;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = false;

            if (transEntryInfo.HeaderId > 0) {
                result.lValue = 0;
                result.sValue = "Cannot change in editing mode.";
                result.data = false;

                return (result);
            }

            if (DataType.arrayLength(transEntryInfo.Settings.VoucherSeries) == 0) {
                result.lValue = 0;
                result.sValue = "Voucher series not defined.";
                result.data = false;

                return (result);
            }

            bChange = false;
            if (bDateChanged == true) {
                bChange = true;
            }
            else if (iMasterTypeId > 0) {
                for (iCounter = 0; iCounter < transEntryInfo.Settings.VoucherSeries.length; iCounter++) {
                    objVWVoucherSeries = transEntryInfo.Settings.VoucherSeries[iCounter];
                    if (objVWVoucherSeries.Type == -1) { // Account
                        bChange = true;
                        break;
                    }

                    if (objVWVoucherSeries.Type > 4 && (objVWVoucherSeries.Type - 2) == iMasterTypeId) {
                        bChange = true;
                        break;
                    }
                }
            }

            if (bChange == true) {
                EntryMainUI.getNewVoucherNo();

                result.lValue = 1;
                result.sValue = "";
                result.data = true;
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
            result.data = false;
        }

        return (result);
    },

