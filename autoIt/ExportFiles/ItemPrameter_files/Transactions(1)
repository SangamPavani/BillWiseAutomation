    getValue: function (objFieldInfo, iRow, text) {
        let iCounter = 0;
        let arrFields = undefined;
        let objLinkDef = undefined;
        let objControl = undefined;
        let arrValue = undefined;
        let value = undefined;
        let obj = undefined;

        try {
            if (objFieldInfo.FieldId <= 0) {
                objFieldInfo.Error = eTransGetValueResult.WrongFieldId;

                return;
            }

            if (objFieldInfo.FieldId == eVTFIELDID.FDF_LINK && DataType.isValidObject(objFieldInfo.MetaData) == false) {
                arrFields = transEntryFieldInfo.getLinkFields();
                if (arrFields.length > 0) {
                    arrValue = [];
                }
                
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    obj = arrFields[iCounter];
                    objLinkDef = obj.MetaData.Tag;
                    if (objLinkDef == undefined || objLinkDef == null) {
                        continue;
                    }

                    objFieldInfo = {};
                    objFieldInfo.MetaDataIndex = obj.MetaDataIndex;
                    objFieldInfo.ColumnIndex = obj.ColumnIndex;
                    objFieldInfo.Area = eTranEntryFieldArea.Body;
                    objFieldInfo.MetaData = obj.MetaData;
                    objFieldInfo.FieldId = objFieldInfo.MetaData.iFieldId;

                    objControl = EntryMainUI.getElement(objFieldInfo, iRow, true);
                    if (objControl.Value) {
                        value = transEntryLinks.getObjectFromCell(objControl.Value, objFieldInfo.MetaData, iRow, true);
                        if (value != undefined && value != null && DataType.isBlankOrZero(value.LinkId) == true) {
                            value = undefined;
                        }

                        if (value) {
                            arrValue.push(value);
                        }
                    }
                }

                return (arrValue);
            }

            objControl = EntryMainUI.getElement(objFieldInfo, iRow, true);
            objFieldInfo.Error = objControl.Error;

            if (objControl.Value == undefined || objControl.Value == null) {
                switch (objFieldInfo.MetaData.iDataTypeId) {
                    case eMasterDataType.Master:
                    case eMasterDataType.Date:
                    case eMasterDataType.Time:
                        if (text == true) {
                            value = "";
                        }
                        else {
                            value = 0;
                        }
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                    case eMasterDataType.Fraction:
                        value = 0;
                        break;
                    default:
                        if ((objFieldInfo.FieldId & eVTFIELDFLAG.MASTER_HDR) > 0 || (objFieldInfo.FieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                            value = "";
                        }
                        break;
                }

                return (value);
            }

            switch (objFieldInfo.FieldId) {
                case eVTFIELDID.FDF_BINS:
                    if (objControl.Value.nodeName.toLowerCase() == "input") {
                        value = objControl.Value.getAttribute("data-data");
                    }
                    else {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }

                    if (value != undefined && value != null) {
                        value = DataType.stringToObject(value).data;
                    }
                    return (value);
                case eVTFIELDID.FDF_BINS2:
                case eVTFIELDID.FDF_RMANO:
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                case eVTFIELDID.FDF_DEPTAPPROP:
                    value = objControl.Value.getAttribute(CELL_VALUE);
                    if (value != undefined && value != null) {
                        value = DataType.stringToObject(value).data;
                    }
                    return (value);
                case eVTFIELDID.FDF_BODYBATCHNO:
                    value = transEntryFields.getBatchInfo(iRow, text);
                    return (value);
                case eVTFIELDID.FDF_LINK:
                    value = transEntryLinks.getObjectFromCell(objControl.Value, objFieldInfo.MetaData, iRow, true);
                    if (value != undefined && value != null && DataType.isBlankOrZero(value.LinkId) == true) {
                        value = undefined;
                    }
                    return (value);
            }

            if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Master
                || objFieldInfo.MetaData.iDataTypeId == eMasterDataType.ExternalTable
                || objFieldInfo.FieldId == eVTFIELDID.FDF_DOCUMENTNO) {

                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    if (text == true) {
                        value = OPTIONCONTROL.getControlText(objControl.Value);
                    }
                    else {
                        value = OPTIONCONTROL.getControlValue(objControl.Value, objFieldInfo.sMandatoryField);
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    if (text == true) {
                        value = $(objControl.Value).text();
                    }
                    else if (text == false) {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }
                    else if (text != undefined && text != null) {
                        text = DataType.stringGetValidDataAttribute(text);
                        value = objControl.Value.getAttribute(text);
                    }
                    else {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }
                }

                if (text == true) {
                    value = DataType.toString(value);
                }
                else if(text == undefined || text == null) {
                    value = DataType.toInt64(value);
                }
            }
            else if ((objFieldInfo.FieldId & eVTFIELDFLAG.MASTER_HDR) > 0 || (objFieldInfo.FieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                // iDataTypeId != MasterDataType.Master (Info Field/Column)
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    value = objControl.Value.value;
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    value = objControl.Value.getAttribute(CELL_VALUE);
                }

                value = DataType.toString(value);
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Boolean) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    value = objControl.Value.checked;
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    value = objControl.Value.getAttribute(CELL_VALUE);
                }

                value = DataType.toBoolean(value);
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Date) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    if (text == true) {
                        value = DATEPICKER.getText(objControl.Value);
                    }
                    else {
                        value = DATEPICKER.getDate(objControl.Value);
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    if (text == true) {
                        value = $(objControl.Value).text();
                    }
                    else {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }
                }

                if (text == true) {
                    value = DataType.toString(value);
                }
                else {
                    value = DataType.toInt64(value);
                }
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.Time) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    if (text == true) {
                        value = FTIMECONTROL.getText(objControl.Value);
                    }
                    else {
                        value = FTIMECONTROL.getTime(objControl.Value);
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    if (text == true) {
                        value = $(objControl.Value).text();
                    }
                    else {
                        value = objControl.Value.getAttribute(CELL_VALUE);
                    }
                }

                if (text == true) {
                    value = DataType.toString(value);
                }
                else {
                    value = DataType.toInt64(value);
                }
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.StringList) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    if (objControl.Value.selectedIndex >= 0) {
                        value = objControl.Value.options[objControl.Value.selectedIndex].text;
                    }
                    else {
                        objFieldInfo.Error = eTransGetValueResult.NothingSelected;
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    value = objControl.Value.getAttribute(CELL_VALUE);
                    if (value == undefined || value == null) {
                        if (FUIElement.hasDataAttribute(objControl.Value, CELL_VALUE, false) == false) {
                            objFieldInfo.Error = eTransGetValueResult.NothingSelected;
                        }
                    }
                }
            }
            else if (objFieldInfo.MetaData.iDataTypeId == eMasterDataType.NumberList) {
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    if (objControl.Value.selectedIndex >= 0) {
                        if (text == true) {
                            value = objControl.Value.options[objControl.Value.selectedIndex].text;
                        }
