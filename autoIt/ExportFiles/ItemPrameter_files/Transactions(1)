const EntryMainValidate = {
    checkForHeaderWrongInputData: function () {
        let sId = "";
        let iCounter = 0;
        let objMetaData = null;
        let objResult = null;

        try {
            objResult = COMMON.prototype.getEmptyResultObject();
            objResult.lValue = 1;
            objResult.sValue = "";

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Master:
                        value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if (objMetaData.bMandatory == true && value != 0) {
                            if (transEntryInfo.isItTransfer == true
                                && objMetaData.iFieldId == eVTFIELDID.FDF_HEADERINVTAG
                                && transEntryFieldInfo.HeaderInvTag.Area == eTranEntryFieldArea.Header) {

                                objResult = EntryMainValidate.isDuplicateStockTransferInvTag(objMetaData.iFieldId, value);
                                if (objResult.lValue != 0) {
                                    objResult.lValue = objResult.lValue < 0 ? -1 : 0;

                                    return (objResult);
                                }
                                else {
                                    objResult.lValue = 1;
                                    objResult.sValue = "";
                                }
                            }
                            else if (transEntryInfo.isItTransfer == true
                                && objMetaData.iFieldId == eVTFIELDID.FDF_BODYINVTAG
                                && transEntryFieldInfo.BodyInvTag.Area == eTranEntryFieldArea.Header) {

                                objResult = EntryMainValidate.isDuplicateStockTransferInvTag(objMetaData.iFieldId, value);
                                if (objResult.lValue != 0) {
                                    objResult.lValue = objResult.lValue < 0 ? -1 : 0;

                                    return (objResult);
                                }
                                else {
                                    objResult.lValue = 1;
                                    objResult.sValue = "";
                                }
                            }
                        }
                        break;
                }
            }
        }
        catch (err) {
            objResult.lValue = -1;
            objResult.sValue = "{EntryMainValidate.checkForHeaderWrongInputData} " + err.message;
        }

        return (objResult);
    },

    validateData: function (objData) {
        let sMessage = "";
        let sFormula = "";
        let sAllLinkData = "";
        let sValue = "";
        let sId = "";
        let dValue = 0;
        let dMax = 0;
        let dDr = 0;
        let dCr = 0;
        let dQty = 0;
        let dExchangeRate = 0;
        let dAllowedPerc = 0;
        let dPrefValue = 0;
        let dDiffAbsValue = 0;
        let dDiffValue = 0;
        let iMaskedVoucherType = 0;
        let iDocumentDate = 0;
        let iToday = 0;
        let iCounter = 0;
        let iCounter1 = 0;
        let iIndex = 0;
        let iHalf = 0;
        let iTotal = 0;
        let bResult = true;
        let arrFormula = undefined;
        let arrMessage = undefined;
        let objMetaData = undefined;
        let objSettings = undefined;
        let arrColumnNames = undefined;
        let arrFooterFields = undefined;
        let arrFields = undefined;
        let objLinkDef = undefined;
        let objLinkData = undefined;
        let objFlags = undefined;
        let arrData = undefined;
        let validate = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let body = undefined;
        let obj = undefined;

        try {
            objSettings = transEntryInfo.Settings;

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;

            iDocumentDate = EntryMain.m_objTrans.Header.Date;
            if (iDocumentDate < EntryMain.m_iAccountingDate
                && EntryMainValidate.canDocumentDateBeLessThanAccountingDate(iMaskedVoucherType) == false) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDateLessAccDate"), GlobalPref.getResourceValue("Error"));

                return (false);
            }

            if (transEntryInfo.ClosingDate > 0 && iDocumentDate > transEntryInfo.ClosingDate) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDateBeyondFiscal"), GlobalPref.getResourceValue("Error"));

                return (false);
            }


            if (transEntryInfo.UserId != GlobalPref.SUPER_USER) { // Not SU
                iToday = transEntryInfo.Today;
                if (transEntryGlobal.EntryModel.Rights.CantAddFutureTransactions == true && iDocumentDate > iToday) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgNoRightsFutureDate"), GlobalPref.getResourceValue("Error"));

                    return (false);
                }

                // Cannot Add previous months' entries after nth day of month
                if (transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries > 0 && iDocumentDate < iToday) {
                    if ((FDate.getMonthFromInt(iDocumentDate) < FDate.getMonthFromInt(iToday)
                        || FDate.getYearFromInt(iDocumentDate) < FDate.getYearFromInt(iToday))
                        //&& FDate.getDayFromInt(iDocumentDate) > transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries) {
                        && FDate.getDayFromInt(iToday) > transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries) {

                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgNoRightsBackDate"), GlobalPref.getResourceValue("Error"));

                        return (false);
                    }
                }

                // Cannot Add Transaction that are more than n days old
                if (transEntryInfo.isEditing == false
                    && transEntryGlobal.EntryModel.Rights.CantAddAfter > 0
                    && iDocumentDate < iToday
                    && (FDate.getDateDiffInDays(iDocumentDate, iToday) > transEntryGlobal.EntryModel.Rights.CantAddAfter)) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgNoRightsBackDate"), GlobalPref.getResourceValue("Error"));

                    return (false);
                }
            }


            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];

                if (DataType.isNullOrEmpty(objMetaData.sEntryValidation, true) == false) {
                    sFormula = objMetaData.sEntryValidation.trim();
                    if (DataType.stringIncludes(sFormula, "?") == false) {
                        sFormula = sFormula + "?1:0";
                    }

                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, 0, null, 0, objMetaData.sFieldName);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                    if (objFormulaOutput.Value > 0) {
                        transEntryGlobal.showAlert(objMetaData.sValidationMessage, GlobalPref.getResourceValue("EntryRestrict"));

                        return (false);
                    }
                }

                if (objMetaData.iDataTypeId == eMasterDataType.BigNumber
                    || objMetaData.iDataTypeId == eMasterDataType.Fraction
                    || objMetaData.iDataTypeId == eMasterDataType.Number
                    || objMetaData.iDataTypeId == eMasterDataType.SmallNumber) {

                    sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                    validate = EntryMainValidate.checkMinMaxRange(objData.Header[sId], DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                    if (validate.bInvalid == true) {
                        transEntryGlobal.showAlert(objMetaData.sFieldName + validate.sMessage + validate.dValue, GlobalPref.getResourceValue("Error"));

                        return (false);
                    }

                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BOMSIZE && FConvert.isItProduction(iMaskedVoucherType) == true && transEntryInfo.VoucherType != eVTTYPE.PRDRT) { // Production Quantity
                        if (DataType.toDecimal(objData.Header[sId]) == 0 && EntryMain.m_dMaxIssueRct > 0) {
                            transEntryGlobal.showAlert("Production size cannot be zero.", GlobalPref.getResourceValue("Error"));
                            return (false);
                        }
                    }
                }
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < arrFooterFields.length; iCounter++) {
                objMetaData = arrFooterFields[iCounter];
                if (objMetaData.iDataTypeId != eMasterDataType.Master && objMetaData.bMandatory) {
                    sId = EntryMainUI.getFooterControlIdPrefix() + objMetaData.iFieldId;

                    obj = DataType.stringToObject(objData.Footer[sId]);
                    if (obj.lValue > 0) {
                        obj = obj.data;
                        if (objMetaData.bMandatory == true && DataType.toString(obj.Input) == "") {
                            transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgProvideMandatoryFooter") + " : " + objMetaData.sFieldName, GlobalPref.getResourceValue("Error"));

                            return (false);
                        }

                        validate = EntryMainValidate.checkMinMaxRange(DataType.toDecimal(obj.Input), DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                        if (validate.bInvalid == true) {
                            transEntryGlobal.showAlert(objMetaData.sFieldName + validate.sMessage + validate.dValue, GlobalPref.getResourceValue("Error"));

                            return (false);
                        }
                    }
                    else {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgProvideMandatoryFooter") + " : " + objMetaData.sFieldName, GlobalPref.getResourceValue("Error"));

                        return (false);
                    }
                }

                if (DataType.isNullOrEmpty(objMetaData.sRestrictFormula) == false) {
                    arrFormula = objMetaData.sRestrictFormula.split(';');
                    arrMessage = objMetaData.sRestrictMessage.split(';');
                    for (iIndex = arrMessage.length; iIndex < arrFormula.length; iIndex++) {
                        arrMessage.push(GlobalPref.getResourceValue("EntryRestrict"));
                    }

                    for (iIndex = 0; iIndex < arrFormula.length; iIndex++) {
                        sFormula = arrFormula[iIndex];
                        if (DataType.isNullOrEmpty(sFormula, true) == true) {
                            continue;
                        }

                        if (DataType.stringIncludes(sFormula, "?") == false) {
                            sFormula = sFormula + "?1:0";
                        }

                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, 0, null, 0, objMetaData.sFieldName);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        if (objFormulaOutput.Value > 0) {
                            if(DataType.isNullOrEmpty(arrMessage[iIndex], true) == true) {
                                transEntryGlobal.writeErrorLog("No entry restrict message found for footer field " + objMetaData.sFieldName);
                            }

                            transEntryGlobal.showAlert(arrMessage[iIndex], GlobalPref.getResourceValue("EntryRestrict"));

                            return (false);
                        }
                    }
                }
            }

            if (DataType.isValidObject(objData.Body) == false
                || objData.Body.length == 0) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("ProvideData"), GlobalPref.getResourceValue("Error"));
                return (false);
            }

            if (transEntryFieldInfo.DueDate.Area == eTranEntryFieldArea.Header) {
                if (EntryMainBody.isBRSRow(0) == false && EntryMain.m_objTrans.BodyData[0].DueDate < EntryMain.m_objTrans.Header.Date) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDueDtCantLessDocDt"), GlobalPref.getResourceValue("Error"));

                    return (false);
                }
            }

            iTotal = objData.Body.length;
            if (transEntryInfo.isItTransfer == true) {
                iHalf = objData.Body.length / 2;
                iTotal = iHalf;
            }

            transEntryInvalidRows.clear();
            arrColumnNames = [];

            sOldASNLPN = undefined;
            objASNLPNInfo = transEntryFieldInfo.ASNLPN;
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                body = objData.Body[iCounter];

                objFlags = DataType.stringToObject(body.Flags);

                if (transEntryFieldInfo.DueDate.Area == eTranEntryFieldArea.Body) {
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYDUEDATE);
                    if (EntryMainBody.isBRSRow(iCounter + 1) == false && DataType.toInt(body[sId]) < EntryMain.m_objTrans.Header.Date) {
                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDueDtCantLessDocDt"), GlobalPref.getResourceValue("Error"));

                        return (false);
                    }
                }

                if (objASNLPNInfo.FieldId > 0) {
                    sValue = body[EntryMainUI.getBodyControlId(objASNLPNInfo.FieldId)];
                    sValue = DataType.toString(sValue).trim();
                    if (sOldASNLPN == undefined) {
                        sOldASNLPN = sValue;
                    }
                    else {
                        if ((sOldASNLPN.length > 0 && sValue.length == 0)
                            || (sOldASNLPN.length == 0 && sValue.length > 0)) {

                            sValue = transEntryGrid.getColumnHeading(objASNLPNInfo.ColumnIndex);
                            if (arrColumnNames.indexOf(sValue) == -1) {
                                arrColumnNames.push(sValue);
                            }

                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                        }
                    }
                }

                if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                    dValue = DataType.toDecimal(body[EntryMainUI.getBodyControlId(transEntryFieldInfo.Qty.FieldId)]);
                    if (DataType.isZero(dValue) == true 
                        && objSettings.Inventory.AllowZeroQty == false 
                        && (transEntryFieldInfo.Qty.MetaData.bMandatory == true || transEntryFieldInfo.Qty.MetaData.bHidden == false)) {

                        sValue = transEntryGrid.getColumnHeading(transEntryFieldInfo.Qty.ColumnIndex);
                        if (DataType.isNullOrEmpty(sValue) == false) {
                            arrColumnNames.push(sValue);

                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                        }
                    }
                }

                if (transEntryFieldInfo.Rate.ColumnIndex > -1
                    && transEntryInfo.Settings.Inventory.ProductRate == 3) {

                    dValue = DataType.toDecimal(body[EntryMainUI.getBodyControlId(transEntryFieldInfo.Rate.FieldId)]);
                    if (DataType.isZero(dValue) == true) {
                        sValue = transEntryGrid.getColumnHeading(transEntryFieldInfo.Rate.ColumnIndex);
                        if (DataType.isNullOrEmpty(sValue) == false) {
                            arrColumnNames.push(sValue);

                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                        }
                    }
                }


                if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
