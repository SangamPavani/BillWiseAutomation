    createRequiredBodyRows: function (iDataRows) {
        transEntryGlobal.writeConsoleLog("Enter: {EntryMainUI.createRequiredBodyRows}[DataRows='" + iDataRows + "']", "royalblue", true);

        let iExistingRows = 0;
        let iMaxEmptyRows = 0;

        try {
            iExistingRows = transEntryGrid.getTotalRows();
            iMaxEmptyRows = EntryMainUI.getMaxEmptyRows();

            if (iDataRows < iExistingRows) {
            }
            else if (iDataRows == iExistingRows) {
                if (iDataRows < iMaxEmptyRows) {
                    transEntryGrid.insertRows(0, (iMaxEmptyRows - iDataRows));
                }
                else {
                    transEntryGrid.insertRows(0, 1);
                }
            }
            else {
                transEntryGrid.insertRows(0, (iDataRows - iExistingRows) + 1);
            }

            iExistingRows = transEntryGrid.getTotalRows();
            if (iExistingRows > EntryMain.m_objTrans.BodyData.length) {
                EntryMainMemoryObject.createRow(0, (iExistingRows - EntryMain.m_objTrans.BodyData.length));
            }
            else if (iExistingRows < EntryMain.m_objTrans.BodyData.length) {
                EntryMainMemoryObject.deleteRowData(iExistingRows + 1, (EntryMain.m_objTrans.BodyData.length - iExistingRows));
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.createRequiredBodyRows} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        transEntryGlobal.writeConsoleLog("Exit: {EntryMainUI.createRequiredBodyRows}", "royalblue", true);
