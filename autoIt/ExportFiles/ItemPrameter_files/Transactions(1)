                    }
                    else if (DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false) {
                        if (DataType.stringIncludes(objMetaData.sDefaultValue, "#") == true) {
                            bRefresh = DataType.stringStartsWith(objMetaData.sDefaultValue, "&");
                            sFormula = objMetaData.sDefaultValue.substr(bRefresh == true ? 2 : 1);

                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, -1, null, -1, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            value = objFormulaOutput.Value;
                        }
                        else {
                            value = objMetaData.sDefaultValue;
                        }

                        transEntryFooter.setInputValue(ele, value, objMetaData);
                    }
                    else {
                        transEntryFooter.setInputValue(ele, 0, objMetaData);
                    }
                }


                iDebitAccountId = objMetaData.iDebitAccount;
                iCreditAccountId = objMetaData.iCreditAccount;

                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[1];
                if (iIndex >= 0) {
                    objAcMetaData = arrFooterFields[iIndex];

                    bAcDefaultValue = false;
                    if (DataType.isNullOrEmpty(objAcMetaData.sDefaultValue, true) == false) {
                        iDebitAccountId = DataType.toInt(objAcMetaData.sDefaultValue);
                        bAcDefaultValue = true;
                    }

                    sId = EntryMainUI.getFooterControlId(objAcMetaData.iFieldId, false);
                    OPTIONCONTROL.setValue(sId, iDebitAccountId);
                    if (OPTIONCONTROL.getControlValue(sId) != iDebitAccountId) {
                        OPTIONCONTROL.setGroupId(sId, iDebitAccountId);
                        if (bAcDefaultValue == true && objMetaData.iDebitAccount > 0) {
                            OPTIONCONTROL.setValue(sId, objMetaData.iDebitAccount);
                        }
                    }
                }

                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[2];
                if (iIndex >= 0) {
                    objAcMetaData = arrFooterFields[iIndex];

                    bAcDefaultValue = false;
                    if (DataType.isNullOrEmpty(objAcMetaData.sDefaultValue, true) == false) {
                        iCreditAccountId = DataType.toInt(objAcMetaData.sDefaultValue);
                        bAcDefaultValue = true;
                    }

                    sId = EntryMainUI.getFooterControlId(objAcMetaData.iFieldId, false);
                    OPTIONCONTROL.setValue(sId, iCreditAccountId);
                    if (OPTIONCONTROL.getControlValue(sId) != iCreditAccountId) {
                        OPTIONCONTROL.setGroupId(sId, iCreditAccountId);
                        if (bAcDefaultValue == true && objMetaData.iCreditAccount > 0) {
                            OPTIONCONTROL.setValue(sId, objMetaData.iCreditAccount);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFooter.setFooterFieldsDefaultValue}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
};
