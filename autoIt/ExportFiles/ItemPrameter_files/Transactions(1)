                //    _ObjAdj.dFooterAmtToBeAdjInTransCurr = AdjustBills_Screen.UI.GetAmountToAdjustInTransCurrency() - _ObjAdj.dFooterAmtAdjustedInTransCurr;
                //    AdjustBills_Screen.Footer.SetAmtTobeAdjust(_ObjAdj.dFooterAmtToBeAdjInTransCurr);
                //}

            }
            else {
                AdjustBills_Screen.Footer.SetAmtTobeAdjust(AdjustBills_Screen.UI.GetAmountToAdjustInBaseCurrency());
                //if (_ObjAdj.tbNewRefAmountAdjValue > 0)
                //{
                //    AdjustBills_Screen.UI.SetNewRefAmt(_ObjAdj.tbNewRefAmountAdjValue);
                //    _ObjAdj.m_NewRefTransCurr = _ObjAdj.tbNewRefAmountAdjValue;
