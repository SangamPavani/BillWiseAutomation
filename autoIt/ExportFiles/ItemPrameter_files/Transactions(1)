OnLeaveGrid: function (cellobj, event) {
    try {
        if (cellobj.ColumnAttribute.ctrlatt.trim() == "AdjBatchQty") {
            //debugger
            let Element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
            if (Element == null) {
                return;
            }
            if (Element.value.trim() == "")
                Element.value = 0;
            let dControlValue = Element.value;
            let dOrgQty = parseFloat(MRP_BATCH.dGlobelQty);
            let dBalQty = DataType.getNumber(document.getElementById('lblBalnceQty').innerText);
            let CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), cellobj.iRow, MRP_BATCH.m_iBatchIdCol + 1);
            let iBatch = CellObj.getCellData()
            let bAlloNegitiveBatchQty = document.getElementById('MBatch_Content').getAttribute('data-bAlloNegitiveBatchQty');
            //lblBalnceQty
            let dGlobelQty = DataType.getNumber(document.getElementById('lblTotalQty').innerText);//parseFloat(MRP_BATCH.arrBatchList[cellobj.iRow - 1]);
            let dAdjustedQty = 0
            if (bAlloNegitiveBatchQty != "True") {
                for (let i = 0; i < MRP_BATCH.OBJLIST.length; i++) {
                    if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] == iBatch) {
                        if (parseFloat(MRP_BATCH.OBJLIST[i][1]) < parseFloat(dControlValue)) {
                            COMMON.prototype.showMessage("Quantity entered is greater than available quantity ", "Batch PopUp");
                            cellobj.setCellData("value", parseFloat(MRP_BATCH.OBJLIST[i][1]));
                            cellobj.setCellText(FConvert.addNumericSeparator(FConvert.toDecimal(MRP_BATCH.OBJLIST[i][1], MRP_BATCH.iNoofDecimalQty)));
                            MRP_BATCH.arrIssuingList[i] = parseFloat(MRP_BATCH.OBJLIST[i][1]);
                            return false;
                        }
                        else { break; }
                    }
                }
            }
            if (parseFloat(dControlValue) >  (parseFloat(dBalQty) + parseFloat(dOrgQty))) {
                if (!MRP_BATCH.bBeforeQuantity) {
                    Element.value = parseFloat(dOrgQty).toFixed(MRP_BATCH.iNoofDecimalQty);
                    dControlValue = parseFloat(dOrgQty).toFixed(MRP_BATCH.iNoofDecimalQty);;
                    COMMON.prototype.showMessage("Quantity entered is greater than total  quantity", "Batch PopUp");
                }
            }
            document.getElementById('lblAdjustQty').innerText = 0
            document.getElementById('lblBalnceQty').innerText = dGlobelQty;
            document.getElementById('lblBalnceQty').innerText = FConvert.toDecimal(parseFloat(dGlobelQty), MRP_BATCH.iNoofDecimalQty);
            document.getElementById('lblAdjSum').innerText = 0;
            dControlValue = FConvert.toDecimal(parseFloat(dControlValue), MRP_BATCH.iNoofDecimalQty);
            cellobj.setCellData("value", dControlValue);
            cellobj.setCellText(dControlValue);
            for (let i = 0; i < MRP_BATCH.OBJLIST.length; i++) {
                if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] != iBatch) {
                    continue;
                }
                MRP_BATCH.OBJLIST[i][MRP_BATCH.iAdjustedColumn] = dControlValue;
                MRP_BATCH.arrIssuingList[i] = dControlValue;

            }
            let fgGridRows = FGRIDCONTROL.getTotalRows(MRP_BATCH.GetBatchGridName());
            for(let i = 0; i < parseInt(fgGridRows); i++ )
            {
                let CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), i+1, MRP_BATCH.m_iAdjustedCol + 1);
                let dValue = parseFloat(CellObj.getCellData());
                dAdjustedQty = parseFloat(dAdjustedQty) + parseFloat(dValue);
            }
            document.getElementById('lblAdjustQty').innerText = FConvert.toDecimal(parseFloat(dAdjustedQty), MRP_BATCH.iNoofDecimalQty);
            document.getElementById('lblAdjSum').innerText = FConvert.toDecimal(parseFloat(dAdjustedQty), MRP_BATCH.iNoofDecimalQty);
            document.getElementById('lblBalnceQty').innerText = FConvert.toDecimal((parseFloat(dGlobelQty) - parseFloat(dAdjustedQty)), MRP_BATCH.iNoofDecimalQty);
            return true;
        } else {
            cellobj.processDefault(event);
        }
    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.OnLeaveGrid} " + e.message, "Error Message");
    }
    return true;
},

