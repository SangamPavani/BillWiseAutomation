                    obj.Value = arrTemp[0].Value;
                    obj.iRow = iRow;
                    obj.bGroup = arrTemp[0].bGroup;

                    return (obj);
                }
            }


            arrTemp = transEntryGridRuleFilter.getColumnRuleFilterObject(-1);
            if (arrTemp.length > 0) {
                arrTemp = DataType.arrayFilterData(arrTemp[0].arrColumnFilter, "iColumn", iColumn, "==");
                if (arrTemp.length > 0) {
                    obj.Value = arrTemp[0].Value;
                    obj.iRow = iRow;
