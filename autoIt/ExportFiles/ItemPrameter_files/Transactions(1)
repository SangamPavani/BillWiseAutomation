const EntryMainAutoAllocate = {
    reservation: function (arrRows) {
        let iCounter = 0;
        let iColIndex = 0;
        let bResult = false;

        try {
            if (transEntryInfo.Settings.Inventory.ReserveFlags != 2) { // Not autoallocate
                return(false);
