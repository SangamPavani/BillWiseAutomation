                                }
                                else
                                {
                                    if (iComma == 0)
                                        temp += sInfix[i];
                                    else if (iComma == 1)
                                        ds1 += sInfix[i];
                                    else
                                        ds2 += sInfix[i];
                                }
                                break;
                            case ',':
                                iComma++;
                                ds2 = "";
                                break;
                            default:
                                {
                                    if (iComma == 0)
                                        temp += sInfix[i];
                                    else if (iComma == 1)
                                        ds1 += sInfix[i];
                                    else
                                        ds2 += sInfix[i];
                                }

                                break;
                        }

