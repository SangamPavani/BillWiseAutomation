                                LISTCHECKBOX.updateOptions("doc_TagsDepedencyDropDown", doc_Dependentmasters[count].Value)
                            break;
                        }
                    }
                }
                element = document.getElementById("doc_TagsDepedencyDropDownContent");
                var value = cellobj.getCellData("value");
                LISTCHECKBOX.setControlData("doc_TagsDepedencyDropDown", value != null && value != "" ? JSON.parse(value) : "");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element);
                    $('#txtbox_doc_TagsDepedencyDropDown').focus();
                }
                else {
                    if (cellobj.processDefault) {
                        cellobj.processDefault(event);
                    }
                }
                break;
            case 4:
                element = document.getElementById("doc_TagsGroupTxtbox");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                }
                else {
                    if (cellobj.processDefault) {
                        cellobj.processDefault(event);
                    }
                }
                break;
            case 5:
                cellobj.cell.style.overflow = "visible";
                //eleSelect.innerHTML = "";
                var masterType = FGRIDCONTROL.getCellObject("doc_TagsTable", cellobj.iRow, cellobj.iColumn - 4).getCellData("value");
                if (doc_Dependentmasters != null && doc_Dependentmasters != undefined) {
                    for (var count = 0; count < doc_Dependentmasters.length; count++) {
                        if (doc_Dependentmasters[count].ID == parseInt(masterType)) {
                            if (doc_Dependentmasters[count].Value != null && doc_Dependentmasters[count].Value.length > 0)
                                for (var i = 0; i < doc_Dependentmasters[count].Value.length; i++) {
                                    option = document.createElement("option");
                                    option.innerHTML = doc_Dependentmasters[count].Value[i].Name;
                                    option.setAttribute("value", doc_Dependentmasters[count].Value[i].ID);
                                    eleSelect.appendChild(option);

                                }
                            cellobj.setControl(eleSelect, "");
                            eleSelect.value = cellobj.getCellData("value");
                            break;
                        }
                        else {
                            cellobj.setControl(eleSelect, "");
                            eleSelect.value = cellobj.getCellData("value");
                        }
                    }
                }
                else {
                    cellobj.setControl(eleSelect, "");
                    eleSelect.value = cellobj.getCellData("value");
                }

                break;
            case 6:
                element = document.getElementById("doc_MandatoryDropDown");
                if (COMMON.prototype.isValidObject(element) == true) {
                    cellobj.setControl(element, cellobj.getCellText());
                    element.value = cellobj.getCellData("value");
                }
                else {
                    if (cellobj.processDefault) {
                        cellobj.processDefault(event);
                    }
                }
                break;
            default:
                if (cellobj.processDefault) {
                    cellobj.processDefault(event);
                }

                break;
        }
    },
