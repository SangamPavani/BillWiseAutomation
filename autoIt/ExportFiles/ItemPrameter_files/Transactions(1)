const EntryMainBody = {
    rowChange: function (obj, evt) {
        transEntryCache.SBINPUTTOTAL.reset();
        //console.log("RowChange: OldRow:" + obj.iOldRow + ", NewRow:" + obj.iNewRow);

        if (transEntryInfo.isAutoSave == true
            && EntryMain.isDirty() == true
