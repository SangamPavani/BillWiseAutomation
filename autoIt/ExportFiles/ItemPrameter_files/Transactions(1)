            }

            if (DataType.stringStartsWithRaw(sVar, "#") == true) {
                sVar = sVar.substr(1);
            }

            sVar = sVar.toLowerCase();
            if(EntryMainCommon.isMatch("^sqlf[\\d]+$", sVar) == true) {
