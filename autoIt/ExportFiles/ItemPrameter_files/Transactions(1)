                        }
                        AdjustBills_Screen.UI.SetOnAccountAmt(DataType.toDecimal(_objAdj.m_OnAccountTransCurr, _objAdj.m_arrBreakupByTag[0].iNoOfDecimals));
                        if (_objAdj.m_objReferenceType == 2) {
                            AdjustBills_ScreenNew.CalculateInstallments();
                        }
                    }
                }
            }
        }
        AdjustBills_Screen.AssignAdjustmentValues();
    },

