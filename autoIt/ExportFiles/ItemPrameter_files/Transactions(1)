                for (iCounter = 0; iCounter < iLength; iCounter++) {
                    obj = transEntryGlobal.EntryModel.Data.lstLoadedAccountDetail[iCounter];
                    if (obj.RowType == _RowType.COGS && obj.Flags.SuspendFA == false) {
                        arrCOGSDetail.push(transEntryGlobal.EntryModel.Data.lstLoadedAccountDetail[iCounter]);
                    }
                }
            }

            arrData = [];
            if (transEntryInfo.HeaderFlags.UpdateFA == false) {
                arrData = arrCOGSDetail;
