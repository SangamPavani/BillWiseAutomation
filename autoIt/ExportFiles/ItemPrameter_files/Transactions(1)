    isNumber: function (event) {
        ////debugger
        var txtValue = document.getElementById("txtAddToPost").value;
        document.getElementById("chkApplyToChange").checked = false;
        if (event.charCode == 46 && txtValue.includes(".")) {
            return false;
        }
        var key = window.event ? event.keyCode : event.which;
        if (event.ctrlKey == true && (key == 65 || key == 97)) {
            return true;
        }
        return (event.keyCode == 8 || event.keyCode == 9 || event.keyCode == 46 || event.keyCode == 37 || event.keyCode == 39 || event.charCode == 46 || event.keyCode == 36 || event.keyCode == 35) ? true : (key < 48 || key > 57) ? false : true;
