const EntryMainPostingDetails = {
    open: function () {
        let iCounter = 0;
        let arrData = null;
        let arrTemp = null;

        try {
            if (EntryMain.checkPermission(SecurityActions.PostingDetails) == false) {
                return;
            }

            transEntryGlobal.createAuditLog(eLogActions.PostingDetails);

            if (transEntryInfo.isStockRevaluation == true) {
                if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == true) {
                    transEntryGlobal.EntryModel.Data.lstLoadedAccountDetail = [];
                }                
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == true && DataType.arrayLength(transEntryGlobal.EntryModel.Data.lstLoadedAccountDetail) > 0) {
                arrData = EntryMainPostingDetails.prepareDataFromExisting();
            }
            else {
                arrData = EntryMainPostingDetails.prepareDataFromNew();
            }

            if (transEntryInfo.isItTransfer == true && arrData.length > 0) {
                arrTemp = [];
                for (iCounter = 0; iCounter < (arrData.length / 2) ; iCounter++) {
                    arrTemp.push(arrData[iCounter]);
                }

                arrData = arrTemp;
            }

            EntryMainPostingDetails.openPopup(arrData);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPostingDetails.open} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    prepareDataFromNew: function () {
        let iCounter = 0;
        let iGridRow = 0;
        let iMaskedVoucherType = 0;
        var objTrans = null;
        var result = null;
        let dBalanceStockValue = 0;
        let dNewStockValue = 0;
        let objFillDataInput = undefined;
        let objFillFinalInput = undefined;
        let cell = null;
        let arrCOGSDetail = [];

        try {
            transEntryGrid.update();

            objFillDataInput = EntryMainCalculation.getFillDataInput(true, false, 0, undefined);
            EntryMainCalculation.fillData(objFillDataInput);

            objFillFinalInput = EntryMainCalculation.getFillFinalInput(false, objFillDataInput.Output.objOutputTrans, objFillDataInput.Output.arrCodeTypes, objFillDataInput.Output.arrBookTypes);
            EntryMainCalculation.fillFinal(objFillFinalInput);
            transEntryGlobal.updateIntermediateData(objFillFinalInput.objTrans, objFillFinalInput.arrCodeTypes, objFillFinalInput.arrBookTypes);

            objTrans = transEntryGlobal.IntermediateData.objTransaction;
            if (DataType.isValidObject(objTrans) == false || DataType.arrayLength(objTrans.BodyData) < 1) {
                return (null);
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (transEntryInfo.Settings.Misc.DontPostCogs == false
                && transEntryInfo.InventoryPref.iIntegrateInventoryWithAccounts == 1
                && transEntryInfo.isItSales == true
                && (transEntryInfo.isInwardVoucher == false || iMaskedVoucherType == eVTTYPE.SARET || iMaskedVoucherType == eVTTYPE.IEXCE)) {

                if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == true && DataType.arrayLength(transEntryGlobal.EntryModel.Data.arrCOGSDetail) > 0) {
                    arrCOGSDetail = transEntryGlobal.EntryModel.Data.arrCOGSDetail;
                }
                else {
                    result = transEntryServer.getCOGSDetails(DataType.toString(objTrans),
                                                            transEntryInfo.Settings.Inventory.CostOfIssueAccount,
                                                            transEntryInfo.Settings.Inventory.SalesPurchaseAccount,
                                                            false,
                                                            "");
                    if (result.lValue > 0) {
                        arrCOGSDetail = result.data.data;
                    }
                }
            }

            if (objTrans.Header.Flags.UpdateFA == false) {
                objTrans.BodyData = arrCOGSDetail;
            }
            else if (DataType.arrayLength(arrCOGSDetail) > 0) {
                for (iCounter = 0; iCounter < arrCOGSDetail.length; iCounter++) {
                    objTrans.BodyData.push(arrCOGSDetail[iCounter]);
                }
            }

            if (transEntryInfo.isStockRevaluation == true) {
                iGridRow = 0;
                for (iCounter = 0; iCounter < objTrans.BodyData.length; iCounter++) {
                    if (objTrans.BodyData[iCounter].RowType != _RowType.Default) {
                        continue;
                    }

                    iGridRow++;

                    cell = EntryMainUI.getElement(transEntryFieldInfo.BalanceStockValue, iGridRow).Value;
                    if (DataType.isValidObject(cell) == false) {
                        continue;
                    }
                    dBalanceStockValue = DataType.toDecimal(cell.getCellData());


                    cell = EntryMainUI.getElement(transEntryFieldInfo.NewStockValue, iGridRow).Value;
                    if (DataType.isValidObject(cell) == false) {
                        continue;
                    }
                    dNewStockValue = DataType.toDecimal(cell.getCellData());

                    if (DataType.gt(dNewStockValue, dBalanceStockValue) == true) {
                        objTrans.BodyData[iCounter].Amounts[0]
                        objTrans.BodyData[iCounter].Amounts[0] = DataType.negated(DataType.sub(dNewStockValue, dBalanceStockValue));
                        objTrans.BodyData[iCounter].Amounts[1] = DataType.sub(dNewStockValue, dBalanceStockValue);
                    }
                    else {
                        objTrans.BodyData[iCounter].Amounts[0] = DataType.abs(DataType.sub(dNewStockValue, dBalanceStockValue));
                        objTrans.BodyData[iCounter].Amounts[1] = DataType.sub(dNewStockValue, dBalanceStockValue);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainPostingDetails.prepareDataFromNew} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objTrans.BodyData);
    },

