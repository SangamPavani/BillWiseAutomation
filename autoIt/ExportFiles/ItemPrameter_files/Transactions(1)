                    return (DataType.toInt(cell.getCellData()));
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.getMasterValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (iValue);
