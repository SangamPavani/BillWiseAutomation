    processHeaderDependency: function (obj, iFieldId, iSelectedValue, ctrl) {
        let sId = "";
        let iIndex = 0;
        let iValue = 0;
        let arrMasters = null;
        let objMetaData = null;
        let objColumn = null;
        let objRow = null;
        let objResult = null;
        let objExtra = undefined;
        let arrTemp2 = null;

        try {
            objResult = EntryMainDependency.getDependentValue(obj, iSelectedValue, ctrl, false);
            if (DataType.isValidObject(objResult) == false) {
                return;
            }

            if (obj.ID == eMasterTypeId.Product && objResult.bTree == false) {
                transEntryInfo.ItemPreload = objResult.iMasterId;
            }
            else {
                arrMasters = DataType.arrayFilterData(transEntryGlobal.EntryModel.MetaData.Header, "iMasterTypeId", obj.ID, "==");
                if (arrMasters.length > 0) { // Header to header dependency
                    for (iIndex = 0; iIndex < arrMasters.length; iIndex++) {
                        if (EntryMainMaster.isInfoField(arrMasters[iIndex].iFieldId, true) == false) {
                            break;
                        }
                    }

                    if (iIndex < arrMasters.length) {
                        if (arrMasters[iIndex].iFieldId == iFieldId) {
                            return;
                        }

                        EntryMainDependency.setHeaderDependencyData(arrMasters[iIndex].iFieldId);
                        sId = EntryMainUI.getHeaderControlId(arrMasters[iIndex].iFieldId);
                        if (objResult.bTree == true) {
                            iValue = OPTIONCONTROL.getControlValue(sId);
                            if (DataType.isNullOrEmpty(objResult.sFilter) == true) {
                                OPTIONCONTROL.setExtraFilter(sId, "");
                            }
                            else {
                                OPTIONCONTROL.setExtraFilter(sId, "a.iMasterId in (" + objResult.sFilter + ")");
                            }
                            OPTIONCONTROL.clear(sId);

                            objExtra = OPTIONCONTROL.createSetValueExtraObject();
                            objExtra.bLoadAll = true;
                            OPTIONCONTROL.setValue(sId, iValue, {}, objExtra);
                        }
                        else {
                            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                            if (iValue != 0 && iValue == objResult.iMasterId) {
                                return;
                            }

                            OPTIONCONTROL.setFilter(sId, "");
                            OPTIONCONTROL.setExtraFilter(sId, "");

                            objExtra = OPTIONCONTROL.createSetValueExtraObject();
                            objExtra.bLoadAll = true;
                            OPTIONCONTROL.setValue(sId, objResult.iMasterId, {}, objExtra);
                            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                            EntryMainMemoryObject.update(arrMasters[iIndex].iFieldId, iValue, 0);

                            if (iValue == 0) {
                                OPTIONCONTROL.setGroupId(sId, objResult.iMasterId);

                                if (arrMasters[iIndex].iFieldId == transEntryFieldInfo.SubLedger.FieldId) {
                                    OPTIONCONTROL.setExtraFilter(sId, "");
                                }
                                else {
                                    if (transEntryGlobal.m_bUseDependencyAsFilter == true) {
                                        OPTIONCONTROL.setExtraFilter(sId, "");
                                    }
                                }                                
                            }
                            else {
                                OPTIONCONTROL.setGroupId(sId, 0);

                                if (arrMasters[iIndex].iFieldId == transEntryFieldInfo.SubLedger.FieldId) {
                                    OPTIONCONTROL.setExtraFilter(sId, "a.iMasterId in (" + iValue + ")");
                                }
                                else {
                                    if (transEntryGlobal.m_bUseDependencyAsFilter == true) {
                                        OPTIONCONTROL.setExtraFilter(sId, "a.iMasterId in (" + iValue + ")");
                                    }
                                }
                            }
                        }
                    }
                }
                else { // Header to body dependency
                    iIndex = transEntryGrid.getBodyMasterColumnIndex(obj.ID).iIndex;
                    if (iIndex >= 0) {
                        objMetaData = transEntryGrid.getHeadingDataObject(iIndex);
                        if (objResult.bTree == true) {
                            EntryMainDependency.setTreeDependencyData(-1, objMetaData.ifieldid, objResult.sFilter);
                        }
                        else {
                            OPTIONCONTROL.setFilter(sId, "");

                            objExtra = OPTIONCONTROL.createSetValueExtraObject();
                            objExtra.bLoadAll = true;
                            OPTIONCONTROL.setValue(objMetaData.ctrlid, objResult.iMasterId, {}, objExtra);
                            iValue = DataType.toInt(OPTIONCONTROL.getControlValue(objMetaData.ctrlid));
                            if (iValue != objResult.iMasterId) {
                                OPTIONCONTROL.clear(objMetaData.ctrlid);
                                OPTIONCONTROL.setGroupId(objMetaData.ctrlid, objResult.iMasterId);

                                if (OPTIONCONTROL.getGroupId(objMetaData.ctrlid) == objResult.iMasterId) {
                                    iIndex = transEntryGrid.getGridColumnIndexFromMetaDataIndex(iIndex);
                                    arrTemp2 = transEntryGrid.getColumnGroupFilterObject(-1);
                                    if (arrTemp2.length > 0) {
                                        transEntryGrid.updateColumnGroupFilter(arrTemp2[0], iIndex, objResult.iMasterId, false);
                                    }
                                    else {
                                        objColumn = transEntryGrid.getEmptyColumnFilterObject();
                                        objColumn.iColumn = iIndex;
                                        objColumn.iGroupId = objResult.iMasterId;
                                        objColumn.bGroup = true;
                                        objRow = transEntryGrid.getEmptyColumnGroupFilterObject();
                                        objRow.iRow = -1;
                                        objRow.arrColumnFilter.push(objColumn);

                                        transEntryGrid.addColumnGroupFilter(objRow);
                                    }
                                }
                            }
                            else {
                                if (objResult.iMasterId > 0) {
                                    EntryMainDependency.setTreeDependencyData(-1, objMetaData.ifieldid, DataType.toString(objResult.iMasterId));
                                }
                                else {
                                    EntryMainDependency.deleteTreeDependencyRowData(-1, objMetaData.ifieldid);
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.processHeaderDependency} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    processBodyDependency: function (obj, objCell, tag) {
        let iIndex = 0;
        let iValue = 0;
        let iLastValue = 0;
        let bResetGroup = false;
        let objColumn = null;
        let objRow = null;
        let cell = null;
        let arrTemp = null;
        let objTemp = null;
        let objExtra = undefined;
        let objResult = null;
        let objColumnIndexInfo = null;
        let objOldValue = undefined;

        try {
            objResult = EntryMainDependency.getDependentValue(obj, 0, objCell, true);
            if (DataType.isValidObject(objResult) == false) {
                return;
            }

            if (objResult.bTree == true) {
                iIndex = transEntryGrid.getBodyMasterColumnIndex(obj.ID).iIndex;
                objTemp = transEntryGrid.getHeadingDataObject(iIndex);
                if (iIndex >= 0) {
                    EntryMainDependency.setTreeDependencyData(objCell.iRow, objTemp.ifieldid, objResult.sFilter);
                }
            }
            else if (objResult.iMasterId > 0) {
                objColumnIndexInfo = transEntryGrid.getBodyMasterColumnIndex(obj.ID);
                if (objColumnIndexInfo.iIndex == -1) // Check body to body dependency
                {
                    return;
                }

                objTemp = {};
                objTemp.bDependency = true;
                objTemp.iRow = objCell.iRow;
                objTemp.iColumn = objColumnIndexInfo.iIndex;

                cell = transEntryGrid.getCellObject(objCell.iRow, objColumnIndexInfo.iIndex); // Get dependent cell object
                iLastValue = DataType.toInt(cell.getCellData());
                OPTIONCONTROL.clear(cell.ColumnAttribute.ctrlid);
                OPTIONCONTROL.setExtraFilter(cell.ColumnAttribute.ctrlid, "");

                bResetGroup = false;
                if (objColumnIndexInfo.MetaData.iFieldId == transEntryFieldInfo.SubLedger.FieldId) {
                    bResetGroup = true;
                }
                else if (DataType.isValidObject(tag) == true) {
                    if (tag.CallingSource == eDisplayBodyDataSource.LoadVoucher) {
                        bResetGroup = true;

                        objOldValue = EntryMainUI.getValueFromFieldId(objColumnIndexInfo.MetaData.iFieldId,
                                                                        cell.iRow,
                                                                        false,
                                                                        objColumnIndexInfo.MetaData.iDataTypeId);
                    }
                    else if (tag.LoadedDataSource == eLoadedDataSource.PasteFromClipboard) {
                        bResetGroup = true;
                    }                    
                }

                if (bResetGroup == true) {
                    OPTIONCONTROL.setGroupId(cell.ColumnAttribute.ctrlid, 0);
                }

                objExtra = OPTIONCONTROL.createSetValueExtraObject();
                objExtra.bLoadAll = true;
                OPTIONCONTROL.setValue(cell.ColumnAttribute.ctrlid, objResult.iMasterId, objTemp, objExtra); // Set dependent master value
                iValue = DataType.toInt(OPTIONCONTROL.getControlValue(cell.ColumnAttribute.ctrlid));
                if (iValue != objResult.iMasterId) // If dependent master value is not set, it means dependent master value is group
                {
                    EntryMainMemoryObject.update(objColumnIndexInfo.MetaData.iFieldId, 0, cell.iRow);
                    OPTIONCONTROL.setGroupId(cell.ColumnAttribute.ctrlid, objResult.iMasterId);
                    if (iLastValue != 0 && objColumnIndexInfo.MetaData.iFieldId !== transEntryFieldInfo.SubLedger.FieldId) {
                        transEntryGrid.setMasterValue(cell, iLastValue, cell.ColumnAttribute.ctrlid);
                        EntryMainMemoryObject.update(objColumnIndexInfo.MetaData.iFieldId, iLastValue, cell.iRow);
                    }

                    if (objColumnIndexInfo.MetaData.iFieldId == transEntryFieldInfo.SubLedger.FieldId) {
                        EntryMainDependency.deleteTreeDependencyRowData(cell.iRow, objColumnIndexInfo.MetaData.iFieldId);
                    }
                }
                else {
                    if (objOldValue != undefined && objOldValue.Error == 0 && objOldValue.Value != 0 && objOldValue.Value != iValue) {
                        iValue = objOldValue.Value;
                        OPTIONCONTROL.setValue(cell.ColumnAttribute.ctrlid, iValue, objTemp, objExtra); // Set old value
                    }

                    EntryMainMemoryObject.update(objColumnIndexInfo.MetaData.iFieldId, iValue, cell.iRow);
                    arrTemp = transEntryGrid.getColumnGroupFilterObject(cell.iRow);
                    if (arrTemp.length > 0) {
                        iIndex = transEntryGrid.getGridColumnIndexFromMetaDataIndex(iIndex);
                        transEntryGrid.removeColumnGroupFilter(arrTemp[0], iIndex);
                    }

                    EntryMainDependency.setTreeDependencyData(cell.iRow, objColumnIndexInfo.MetaData.iFieldId, iValue);

                    EntryMainDependency.processBodyOtherDependency(cell);
                }

                iIndex = objColumnIndexInfo.iIndex;
                if (OPTIONCONTROL.getGroupId(cell.ColumnAttribute.ctrlid) == objResult.iMasterId) {
                    iIndex = transEntryGrid.getGridColumnIndexFromMetaDataIndex(iIndex);
                    arrTemp = transEntryGrid.getColumnGroupFilterObject(objCell.iRow);
                    if (arrTemp.length > 0) {
                        transEntryGrid.updateColumnGroupFilter(arrTemp[0], iIndex, objResult.iMasterId, false);
                    }
                    else {
                        objColumn = transEntryGrid.getEmptyColumnFilterObject();
                        objColumn.iColumn = iIndex;
                        objColumn.iGroupId = objResult.iMasterId;
                        objColumn.bGroup = true;
                        objRow = transEntryGrid.getEmptyColumnGroupFilterObject();
                        objRow.iRow = objCell.iRow;
                        objRow.arrColumnFilter.push(objColumn);

                        transEntryGrid.addColumnGroupFilter(objRow);
                    }
                }
            }
            else {
                cell = transEntryGrid.getCellObject(objCell.iRow, objCell.iColumn, true);
                OPTIONCONTROL.setGroupId(cell.ColumnAttribute.ctrlid, 0);
                iIndex = transEntryGrid.getBodyMasterColumnIndex(obj.ID).iIndex;
                if (iIndex == -1) // Check body to body dependency
                {
                    return;
                }

                objMetaData = transEntryGlobal.getBodyMetaDataObject(iIndex);
                if (objResult.bTree == true) {
                    EntryMainDependency.setTreeDependencyData(iRow, objMetaData.iFieldId, objResult.sFilter);
                }
                else {
                    iIndex = transEntryGrid.getGridColumnIndexFromMetaDataIndex(iIndex);
                    arrTemp = transEntryGrid.getColumnGroupFilterObject(objCell.iRow);
                    if (arrTemp.length > 0) {
                        transEntryGrid.updateColumnGroupFilter(arrTemp[0], iIndex, 0, false);
                    }

                    EntryMainDependency.setTreeDependencyData(objCell.iRow, objMetaData.iFieldId, objResult.sFilter);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.processBodyDependency} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getDependentValue: function (obj, iSelectedValue, ctrl, bCell) {
        let result = null;
        let objResult = null;

        try {
            if (bCell == true) {
                iSelectedValue = DataType.toInt(ctrl.getCellData());
            }

            if (DataType.stringEndsWith(obj.Name, "__") == true) {
                if (iSelectedValue > 0) {
                    result = transEntryServer.execute(eTransServerRequest.GetMasterTreeValue,
                                                        {
                                                            iMasterTypeId: obj.Tag,
                                                            iMasterId: iSelectedValue,
                                                            sTabName: obj.Name,
                                                            bForFilter: false
                                                        });

                    if (result.lValue > 0) {
                        result = result.data;
                    }

                    if (result.lValue < 1) {
                        return;
                    }

                    objResult = {};
                    objResult.bTree = true;
                    objResult.sFilter = result.data;
                    objResult.iMasterId = 0;
                }
                else {
                    objResult = {};
                    objResult.bTree = true;
                    objResult.sFilter = "";
                    objResult.iMasterId = 0;
                }
            }
            else {
                objResult = {};
                objResult.bTree = false;
                objResult.sFilter = "";
                objResult.iMasterId = 0;

                if (bCell == true) {
                    objResult.iMasterId = DataType.toInt(ctrl.getCellData(obj.Name.toLowerCase())); // Get value of dependent master
                }
                else {
                    objResult.iMasterId = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl, obj.Name.toLowerCase()));
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.getDependentValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

    isMasterExistInDependency: function (iMasterTypeId) {
        let iCounter = 0;
        let objSettings = undefined;

        try {
            objSettings = transEntryInfo.Settings;
            if (objSettings
                && objSettings.Documents) {

                if (objSettings.Documents.AccountDepandencyMaster
                    && objSettings.Documents.AccountDepandencyMaster.length > 0) {

                    for (iCounter = 0; iCounter < objSettings.Documents.AccountDepandencyMaster.length; iCounter++) {
                        if (objSettings.Documents.AccountDepandencyMaster[iCounter].ID == iMasterTypeId) {
                            return (true);
                        }
                    }
                }

                if (objSettings.Documents.ProductDepandencyMaster
                    && objSettings.Documents.ProductDepandencyMaster.length > 0) {

                    for (iCounter = 0; iCounter < objSettings.Documents.ProductDepandencyMaster.length; iCounter++) {
                        if (objSettings.Documents.ProductDepandencyMaster[iCounter].ID == iMasterTypeId) {
                            return (true);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.isMasterExistInDependency} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

