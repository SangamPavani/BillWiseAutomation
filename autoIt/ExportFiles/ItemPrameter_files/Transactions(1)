    AutoPick:function(iRowIndex, iBinId,iSkidId){
        let i = 0;
        let objColumn = null;
        let cellobj = null;
        let totalRows = 0;
        let txtBalance = document.getElementById("id_bins_balance");

        totalRows = transBinsPopup.getTotalRows();
        if (iRowIndex >= 0){
            cellobj = BinsUI.getAutoAllocateCellObject(iRowIndex);
            if (BinsUI.m_objBinsData.BinDetails != null && iRowIndex <= BinsUI.m_objBinsData.BinDetails.length) {
                for (i = 0; i < BinsUI.m_objBinsData.BinDetails.length; i++) {
                    if (iBinId == BinsUI.m_objBinsData.BinDetails[i].Id && iSkidId == BinsUI.m_objBinsData.BinDetails[i].SkidId) {
                        objColumn = BinsUI.m_objBinsData.BinDetails[i];
                        break;
                    }
                }
            }
            if (objColumn == null)
                return;

            if (objColumn.Group){
                BinsUI.disableOK(true); //disable
                cellobj.setCellText(BinsUI.AddDecimalInColumn(0));
                return cellobj;
            }
            else{
                if (BinsUI.m_BinsParam.Inward == false || objColumn.Type == eBinsType.Bin)//type 0 :bin
                {
                    cellobj = BINS.PickRow(iRowIndex, iBinId , iSkidId);
                    return cellobj;
                }
                else if (objColumn.Type == eBinsType.Floor || objColumn.Type == eBinsType.Stage)// Inward and type Floor/Stage
                {
