    CalculateAmountToBeAdjust: function (obj, index) {
        try {
            //debugger
            var bResult = true;
            var AdjustedAmt = 0;
            var _objAdj = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails;

            if (_objAdj.m_lstPendingBills.length > (index)) {

                if (obj.iColumn == AdjCol.get("mAAIDBaseCurrency")) {
                    if (FNumberOperation.isEqualTo(m_dCurrCellValue, _objAdj.m_lstPendingBills[index].mAAIDBaseCurrency)) {
                        AdjustBills_Screen.AssignAdjustmentValues();
                        return;
                    }
                }
                else if (obj.iColumn == AdjCol.get("mAAIDInvoiceCurrency")) {
                    if (FNumberOperation.isEqualTo(m_dCurrCellValue, _objAdj.m_lstPendingBills[index].mAAIDInvoiceCurrency)) {
                        AdjustBills_Screen.AssignAdjustmentValues();
                        return;
