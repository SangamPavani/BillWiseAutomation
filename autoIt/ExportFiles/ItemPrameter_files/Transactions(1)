                }

                sPlacement = "top";

                sContent = "<small>";
                for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                    if (iCounter > 0) {
                        sContent += "<br/>";
                    }
                    sContent += "<strong>" + arrData[iCounter].Key + "</strong> : ";
                    sContent += arrData[iCounter].Value;
                }
                sContent += "</small>";

                transEntryGlobal.showPopover(obj.Element, sTitle, sContent, sPlacement);
            }
            else if (obj.bEnter == false) {
                transEntryGlobal.hidePopover(obj.Element);
