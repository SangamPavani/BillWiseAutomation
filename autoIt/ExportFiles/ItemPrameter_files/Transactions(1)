LoadGridData: function (ObjBody) {
    try {
        //debugger
        var sGrid = MRP_BATCH.GetBatchGridName("");
        var ObjCell = null; var TotalQty = 0;
        var Element = document.getElementById("MBatch_Content").dataset;
        var DecimalPoint = parseInt(Element.decimal);
        document.getElementById("lblAdjustQty").innerText = parseFloat("0").toFixed(MRP_BATCH.iNoofDecimalQty);
        document.getElementById("lblAdjSum").innerText = parseFloat("0").toFixed(MRP_BATCH.iNoofDecimalQty);

        document.getElementById("lblBalnceQty").innerText = FConvert.toDecimal(document.getElementById('lblTotalQty').innerText, MRP_BATCH.iNoofDecimalQty);
        //parseFloat(document.getElementById("lblTotalQty").innerText.replace(',', '')).toFixed(MRP_BATCH.iNoofDecimalQty);
        FGRIDCONTROL.deleteRows(sGrid, 1, FGRIDCONTROL.getTotalRows(sGrid));
        FGRIDCONTROL.insertRows(sGrid, 1, ObjBody.length);
        for (var i = 0; i < ObjBody.length; i++) {
            //3,4,12
            for (var j = 0; j < ObjBody[i].length; j++) {
                ObjCell = {};
                ObjCell = FGRIDCONTROL.getCellObject(sGrid, i + 1, j + 1);
                switch (ObjCell.iColumn) {
                    case 2:
                        TotalQty = parseFloat(TotalQty) + parseFloat(ObjBody[i][j])
                        ObjCell.setCellText(FConvert.toDecimal(ObjBody[i][j], MRP_BATCH.iNoofDecimalQty));
                        ObjCell.setCellData("value", ObjBody[i][j]);
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        //rgb(235, 235, 235)
                        break;
                    case 3:
                        //if (parseInt(MRP_BATCH.OBJParam.dConversion) == 0)
                        // MRP_BATCH.OBJParam.dConversion = 1;
                        //ObjBody[i][j] = parseFloat(ObjBody[i][1] / MRP_BATCH.OBJParam.dConversion).toFixed(DecimalPoint)
                        ObjCell.setCellText(FConvert.toDecimal(ObjBody[i][j], MRP_BATCH.iNoofDecimalQty));
                        ObjCell.setCellData("value", ObjBody[i][j]);
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                    case 4:
                        if (parseInt(MRP_BATCH.OBJParam.dConversion) == 0 || MRP_BATCH.OBJParam.dConversion == null)
                            MRP_BATCH.OBJParam.dConversion = 1;
                        ObjBody[i][j] = parseFloat(ObjBody[i][1] / MRP_BATCH.OBJParam.dConversion).toFixed(DecimalPoint)
                        ObjCell.setCellText(FConvert.toDecimal(ObjBody[i][j], MRP_BATCH.iNoofDecimalQty));
                        ObjCell.setCellData("value", ObjBody[i][j]);
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                    case 5:
                    case 6:
                    case 14:
                        var startDate = parseFloat(ObjBody[i][j]);
                        vardate = "";
                        if (startDate != 0) {
                            if (MRP_BATCH.bIgnoreDayInExp && ObjCell.iColumn == 5)
                                date = ObjBody[i][j];
                            else
                                date = COMMON.prototype.zeroPadLeft(DATE.prototype.getDayFromFocusDate(startDate), 2) + "/" + COMMON.prototype.zeroPadLeft(DATE.prototype.getMonthFromFocusDate(startDate), 2) + "/" + DATE.prototype.getYearFromFocusDate(startDate);
                            ObjCell.setCellText(date);
                            ObjCell.setCellData("value", startDate);
                        }
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                        //decimal
                    case 7:
                        ObjCell.setCellText(FConvert.toDecimal(ObjBody[i][j], MRP_BATCH.iNoofDecimalQty));
                        ObjCell.setCellData("value", ObjBody[i][j]);
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                    case 8:
                        //ObjCell.setCellText(ObjBody[i][j]);
                        //ObjCell.setCellData("value", ObjBody[i][j]);
                        //ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                    default:
                        ObjCell.setCellText(ObjBody[i][j]);
                        ObjCell.setCellData("value", ObjBody[i][j]);
                        ObjCell.cell.style.backgroundColor = "rgb(235, 235, 235)";
                        break;
                }
            }
        }
        document.getElementById("lblSum").innerText = TotalQty.toFixed(MRP_BATCH.iNoofDecimalQty);
    } catch (e) {
        COMMON.prototype.showMessage("Exception: {MRP_BATCH.LoadGridData} " + e.message, "Error Message");
