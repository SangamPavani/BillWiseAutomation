                obj.iNewDocFieldId = iNewDocFieldId;
                obj.iTriggerId = CONFIGURETRANS.TRIGGERS.getSelectedTriggerId();
                obj.MapType = 1; // Map
                obj.sValue = "";

                if (FCommon.String.isNullOrEmpty(sFormula) == false) {
                    obj.MapType = 2; // Formula
                    obj.sValue = sFormula;
                    obj.iCurrDocFieldId = 0;
