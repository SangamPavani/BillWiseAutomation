    getStockRate: function (iRow, iProductId, iDate, iWarehouseId, iDepartmentId, lTransactionId, lBatchId, bRateOnly, bRoundOff, cellobj, bAsync, sCallback) {
        let iBodyId = 0;
        let obj = null;
        let objMethod = null;
        let value = null;
        let arrLoaded = null;
        let result = null;

        try {
            if (iProductId < 1) {
                result = COMMON.prototype.getEmptyResultObject();
                result.lValue = 0;
                result.sValue = "";
                result.data = null;

                return (result);
            }

            if (DataType.isValidObject(lBatchId) == false) {
                lBatchId = 0;
            }
            else if ((typeof lBatchId).toLowerCase() == "string" && DataType.isNullOrEmpty(lBatchId) == true) {
                lBatchId = 0;
            }

            bAsync = DataType.toBoolean(bAsync);

            obj = {};
            obj.iProductId = iProductId;
            obj.iDate = iDate;
            obj.iWarehouseId = iWarehouseId;
            obj.iDepartmentId = iDepartmentId;
            obj.lTransactionId = lTransactionId;
            obj.lBatchId = lBatchId;
            obj.bRateOnly = bRateOnly;
            obj.bRoundOff = bRoundOff;
            obj.dPrevQty = 0;
            obj.dQty = 0;

            //value = transEntryCache.STOCKRATE.getValue(iProductId, iDate, iWarehouseId, iDepartmentId, lTransactionId, lBatchId, bRateOnly, bRoundOff);
            //if (value != undefined) {
            //    if (bAsync == true) {
            //        result = {};
            //        result.lValue = 1;
            //        result.sValue = "";
            //        result.data = value;

            //        eval(sCallback)(true, result, { obj: obj, cell: cellobj});

            //        return;
            //    }
            //    else {
            //        result = {};
            //        result.lValue = 1;
            //        result.data = {};
            //        result.data.lValue = 1;
            //        result.data.data = value;

            //        return(result);
            //    }
            //}

            iBodyId = transEntryFields.getBodyId(iRow);
            arrLoaded = DataType.arrayFilterData(transEntryGlobal.arrLoadedData, eTranEntryBodyDataConstKey.BodyId, iBodyId, "===");
            if (arrLoaded.length > 0) {
                obj.dPrevQty = arrLoaded[0].BaseQuantity;
            }

            objMethod = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iValuationMethod", eMasterDataType.Number);
            if (objMethod == eValuationMethod.FIFO || objMethod == eValuationMethod.FIFOTransactionTime || objMethod == eValuationMethod.LIFO) {
                obj.dQty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
            }

            result = transEntryServer.execute(eTransServerRequest.GetStockRate, obj, bAsync, sCallback, { obj: obj, cell: cellobj });

            if (bAsync == false) {
                if (result.lValue > 0 && result.data.lValue > 0) {
                    value = result.data.data;
                    transEntryCache.STOCKRATE.setValue(iProductId, iDate, iWarehouseId, iDepartmentId, lTransactionId, lBatchId, bRateOnly, bRoundOff, value);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryServer.getStockRate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    saveTransaction: function (objTransactionData, sCallback, bSuspended, iSaveSource, arrCreatedFAMasters) {
        let sId = "";
        let sId1 = "";
        let sInvId = "";
        let iRow = 0;
        let iCounter = 0;
        let bBodyIdFound = false;
        let bSaveInBackground = false;
        let obj = null;
        let objTemp = null;
        let objData = null;
        let arrData = null;
        let objFlags = null;
        let objInvFieldInfo = undefined;
        let objCallbackInput = undefined;
        let objFindResultOld = undefined;

        try {
            if (transEntryGlobal.debugSave == true) {
                debugger
            }

            if (EntryMainBillwise.isSingleBillwiseVoucher() == true || transEntrySettings.isAdjustBillInLine == false) {
                objTransactionData = transEntryVat.updateVATBeforeSave(objTransactionData);
            }

            if (DataType.isValidObject(objTransactionData) == false) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                return;
            }

            if (bSuspended == false && transEntryFieldInfo.Billwise.ColumnIndex > -1
                && EntryMainValidate.validateBillwiseData(objTransactionData) == false) {

                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgAdjustBills"), GlobalPref.getResourceValue("Error"));
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
                return;
            }

            objFlags = DataType.stringToObject(objTransactionData.Header.Flags).data;

            if (transEntryInfo.HeaderId > 0
                && transEntryGlobal
                && transEntryGlobal.EntryModel
                && transEntryGlobal.EntryModel.Data
                && DataType.arrayLength(transEntryGlobal.EntryModel.Data.Header) > 0) {

                sId = EntryMainUI.getHeaderControlId(eVTFIELDID.FDF_UPDATESTOCKS);
                objFindResultOld = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Header);
                if (objFindResultOld.lValue > 0) {
                    if (objFindResultOld.data.Value == false && objTransactionData.Header[sId] == true) {
                        objFlags.CheckNegativeStock = true;
                    }
                }

                if (DataType.arrayLength(transEntryGlobal.arrLoadedData) > 0
                    && EntryMainBillwise.isSingleBillwiseVoucher() == true
                    && transEntryGlobal.arrLoadedData[0].BodyId > 0) {
                    for (iCounter = 0; iCounter < objTransactionData.Body.length; iCounter++) {
                        if (DataType.gt(objTransactionData.Body[iCounter].BodyId, 0) == true) {
                            bBodyIdFound = true;
                            break;
                        }
                    }

                    if (bBodyIdFound == false) {
                        objTransactionData.Body[0].BodyId = transEntryGlobal.arrLoadedData[0].BodyId;
                        objTransactionData.Body[0].TransactionId = transEntryGlobal.arrLoadedData[0].TransactionId;
                    }
                }
            }
            else if (transEntryInfo.HeaderId == 0) {
                for (iCounter = 0; iCounter < objTransactionData.Body.length; iCounter++) {
                    objTransactionData.Body[iCounter].AuthStatus = _eAuthStatus.Authorized;
                }
            }

            if (transEntryInfo.isItSales == true
                && EntryMain.m_bPrevSuspended == true
                && objFlags.Suspended == false) {

                objFlags.CheckNegativeStock = true;
                objFlags.NoLinkCheck = false;
                objFlags.NoBinCheck = false;

                if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) {
                    objFlags.NoBatchCheck = false;
                }
            }

            if (transEntryInfo.isExternalCall == false && transEntryExternalModule.getEventCount(eVoucherExternalModuleEvents.AfterSave) == 0
                && transEntryInfo.MiscellaneousPref.bDontSaveInBackground == false && iSaveSource == eTranEntrySaveSource.Save) {
                objFlags.SaveInThread = true;

                bSaveInBackground = true;
            }

            objTransactionData.Header.Flags = DataType.toString(objFlags);
            objTransactionData.arrCreatedFAIds = arrCreatedFAMasters;
            objTransactionData.EditReason = transEntryInfo.SaveRemark;

            obj = {};
            obj.objData = objTransactionData;
            obj.iVoucherType = transEntryInfo.VoucherType;
            obj.iViewId = transEntryInfo.ViewId;
            obj.SchemeApplied = "";

            if (EntryMainScheme.isSchemeClassExist() == true) {
                obj.SchemeApplied = DataType.toString(ERPSCHEMEIMPLEMENTATION.GetTransSchemesApplied(0));
            }

            EntryMainUI.moveAttachmentDataBeforeSave(obj);

            // Clear billwise data for suspended voucher.
            //if(bSuspended == true && transEntryFieldInfo.Billwise.ColumnIndex > 0) {
            //    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_REFERENCE);
            //    for(iCounter = 0; iCounter < obj.objData.Body.length; iCounter++) {
            //        obj.objData.Body[iCounter][sId] = "";
            //        obj.objData.Body[iCounter][eTranEntryBodyDataConstKey.BillwiseData] = "";
            //    }
            //}

            // Auto set max to release data before save.
            if (bSuspended == false && transEntryFieldInfo.MaxQtyRelease.ColumnIndex > -1) {
                arrData = [];

                if (transEntryInfo.isItTransfer == false) {
                    objInvFieldInfo = transEntryFields.getInfo(eTransEntryField.InvTag);
                    switch (objInvFieldInfo.Area) {
                        case eTranEntryFieldArea.Header:
                            sInvId = EntryMainUI.getHeaderControlId(objInvFieldInfo.iFieldId);
                            break;
                        case eTranEntryFieldArea.Body:
                            sInvId = EntryMainUI.getBodyControlId(objInvFieldInfo.iFieldId);
                            break;
                    }
                }

                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_MAXQTYRELEASE);
                sId1 = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_LINK);
                for (iRow = 0; iRow < obj.objData.Body.length; iRow++) {
                    objTemp = DataType.stringToObject(obj.objData.Body[iRow][sId]);
                    if (objTemp.lValue > 0) {
                        objTemp = objTemp.data;
                        if (DataType.gte(objTemp.BaseTransactionId, 1) == true) {
                            continue;
                        }
                    }

                    objTemp = DataType.stringToObject(obj.objData.Body[iRow][sId1]);
                    if (objTemp.lValue < 1) {
                        continue;
                    }
                    objTemp = objTemp.data;
                    for (iCounter = 0; iCounter < objTemp.length; iCounter++) {
                        if (DataType.lt(objTemp[iCounter].BaseTransactionId, 1) == true) {
                            continue;
                        }

                        objData = {};
                        objData.iRow = iRow;
                        objData.lTransactionId = objTemp[iCounter].BaseTransactionId;
                        objData.iLinkId = objTemp[iCounter].LinkId;
                        objData.iVoucherType = objTemp[iCounter].VoucherType;
                        objData.iInvTagValue = 0;

                        if (objInvFieldInfo != null) {
                            switch (objInvFieldInfo.Area) {
                                case eTranEntryFieldArea.Header:
                                    objData.iInvTagValue = DataType.toInt(obj.objData.Header[sInvId]);
                                    break;
                                case eTranEntryFieldArea.Body:
                                    objData.iInvTagValue = DataType.toInt(obj.objData.Body[iRow][sInvId]);
                                    break;
                            }
                        }

                        arrData.push(objData);
                    }
                }

                if (arrData.length > 0) {
                    objTemp = transEntryServer.execute(eTransServerRequest.GetReservedQtysRemaining, { arrInput: arrData });
                    if (objTemp.lValue > 0) {
                        objTemp = objTemp.data;
                        if (objTemp.lValue > 0) {
                            for (iCounter = 0; iCounter < objTemp.data.length; iCounter++) {
                                objData = {};
                                objData.Quantity = objTemp.data[iCounter].Quantity;
                                objData.BaseTransactionId = objTemp.data[iCounter].BaseTransactionId;

                                iRow = objTemp.data[iCounter].RowId;
                                obj.objData.Body[iRow][sId] = DataType.toString(objData);
                            }
                        }
                    }
                }
            }

            obj.bVersion = iSaveSource == eTranEntrySaveSource.Version;

            //if (obj.bVersion == false
            //    && iSaveSource != eTranEntrySaveSource.Save
            //    && DataType.isValidObject(document.getElementById("id_transactionentry_save")) == false) {
            //    if (transEntrySettings.isEnableVersion == true && EntryMain.checkPermission(SecurityActions.AlwaysVersion) == true) {
            //        obj.bVersion = true;
            //    }
            //}

            obj.bAmend = iSaveSource == eTranEntrySaveSource.Amend;

            if (transEntryGlobal.EntryModel.bSmsConfirm == true) {
                obj.bSendSms = false;
                if (EntryMain.isEditMode() == true) {
                    if (transEntryGlobal.EntryModel.bSmsOnEdit == true && transEntryGlobal.confirmMessage("Do you want to send SMS/Email?") == true) {
                        obj.bSendSms = true;
                    }
                }
                else if (transEntryGlobal.confirmMessage("Do you want to send SMS/Email?") == true) {
                    obj.bSendSms = true;
                }
            }

            if (transEntryGlobal.disableSave == true) {
                debugger
                obj = null;
                EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
            }

            objCallbackInput = {};
            objCallbackInput.sCallback = sCallback;
            objCallbackInput.bSuspended = bSuspended;
            objCallbackInput.TransactionData = objTransactionData;
            objCallbackInput.iSaveSource = DataType.toInt(iSaveSource);
            objCallbackInput.arrCreatedFAMasters = arrCreatedFAMasters;
            objCallbackInput.bSaveInBackground = bSaveInBackground;
            objCallbackInput.iBodyRowsCount = obj.objData.Body.length;

            if (transEntryInfo.HeaderId == 0 || transEntryGlobal.EntryModel.iCompanySecurityLevel != 2) {
                transEntryServer.saveVoucher(obj, objCallbackInput);
            }
            else {
                TransLogin.open(undefined, { objData: obj, objCallbackInput: objCallbackInput, Source: eTransLoginSource.Save });
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryServer.saveTransaction} " + err.message, GlobalPref.getResourceValue("Exception"));
            EntryMainToolbar.enableButtonBasedOnSaveSource(iSaveSource, true);
        }
    },

