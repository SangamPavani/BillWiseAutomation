    processCellEnter: function (Preload, cellobj, evt) {
        let iValue = 0;
        let bIssue = false;
        let objTemp = null;
        let data = null;
        let sBatch = null;
        let element = null;

        try {
            if (transEntryInfo.isStockRevaluation == true) {
                return(EntryMainStockRevaluation.onBatch_Enter(cellobj, evt));
            }

            if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, cellobj.iRow) == false) {
                EntryMainUI.clear(transEntryFieldInfo.BatchNo, cellobj.iRow);
                cellobj.processDefault(evt, false, true);

                return (false);
            }

            if (transEntryInfo.BaseVoucherType == eVTTYPE.WDONE
                && EntryMainMemoryObject.getRctIssueValue(cellobj.iRow) == 0) { // Issue Row

                bIssue = true;
            }

            if (transEntryInfo.isInwardVoucher == true && bIssue == false) {
                if (transEntryBatch.isSuggestionRequired(cellobj.iRow) == true
                    && DataType.isNullOrEmpty(Preload, true) == true
                    && DataType.isNullOrEmpty(cellobj.getCellText(), true) == true) {
                    iValue = transEntryGrid.getMasterValue(cellobj.iRow, transEntryInfo.InvTag);

                    if (transEntryGlobal.EntryModel.arrBatchSeries != null && transEntryGlobal.EntryModel.arrBatchSeries.length > 0) {
                        EntryMainBatch.generateBatchFromSeries(cellobj);
                    }
                    else {
                        if (transEntryInfo.BatchPref.bDontAcceptDuplicatebatchInInwardDocuments == true) {
                            iValue = 0;
                        }

                        objTemp = transEntryGrid.getAllUsedBatches(iValue);
                        if (objTemp.length == 0) {
                            objTemp = {};
                            objTemp.ctrlid = cellobj.ColumnAttribute.ctrlid;
                            objTemp.iInvTag = iValue;

                            data = {};
                            data.iVoucherType = transEntryInfo.VoucherType;
                            data.iInvTag = iValue;

                            transEntryServer.execute(eTransServerRequest.GetLastBatchUsed, 
                                                        data, 
                                                        true, 
                                                        "EntryMainCallback.getLastUsedBatch",
                                                        objTemp);
                        }
                        else {
                            sBatch = objTemp[objTemp.length - 1];
                            do {
                                sBatch = FConvert.getNextNo(sBatch);
                                if (DataType.arrayContains(objTemp, sBatch, null, true) == -1) {
                                    break;
                                }
                            } while (true);

                            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
                            if (DataType.isValidObject(element) == true) {
                                cellobj.setCellText(sBatch);
                            }
                        }
                    }
                }
            }
            else {
                // Open batch popup when no batch is selected or batch column is clicked
                if (DataType.isNullOrEmpty(cellobj.getCellText(), true) == true || (DataType.isValidObject(evt) == true && DataType.toString(evt.type) == "click")) {                        
                    EntryMainBatch.initRowBatchControl(cellobj.iRow,
                                                                cellobj.iColumn, 
                                                                cellobj.ColumnAttribute.ctrlid, 
                                                                false, 
                                                                null,
                                                                EntryMainUI.getOthersContainer());
                }
                else {
                    cellobj.processDefault(evt, false, true);
                }

                return (false);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.processCellEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

