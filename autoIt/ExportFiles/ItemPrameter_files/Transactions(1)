    loadLotNoData: function (iRow, lLotNo) {
        let iCounter = 0;
        let iVoucherType = 0;
        let result = undefined;
        let objIdNamePair = undefined;

        try {
            iVoucherType = transEntryInfo.VoucherType;
            if (transEntryInfo.isItSales == false || FConvert.isItInwardVoucher(iVoucherType) == true) {
                return;
            }

            if (transEntryFieldInfo.BOE.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.BOL.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.BOEDate.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.ContainerNo.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.HarmonizedCode.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.CountryOfOrigin.Area == eTranEntryFieldArea.None
                && transEntryFieldInfo.SerialNo.Area == eTranEntryFieldArea.None)
            {
                return;
            }

            result = transEntryServer.execute(eTransServerRequest.LotDetail, { lLotNo: lLotNo });
            if (result.lValue > 0) {
                result = result.data;
            }

            if (result.lValue < 1) {
                return;
            }

            result = result.data;
            for (iCounter = 0; iCounter < result.length; iCounter++) {
                objIdNamePair = result[iCounter];
                if (objIdNamePair.Name.toLowerCase() == "sboe") {
                    transEntry.setUIValue(transEntryFieldInfo.BOE.Area,
                                            transEntryFieldInfo.BOE.MetaDataIndex,
                                            transEntryFieldInfo.BOE.ColumnIndex,
                                            objIdNamePair.Tag,
                                            iRow);
                }
                else if (objIdNamePair.Name.toLowerCase() == "sbol") {
                    transEntry.setUIValue(transEntryFieldInfo.BOL.Area,
                                            transEntryFieldInfo.BOL.MetaDataIndex,
                                            transEntryFieldInfo.BOL.ColumnIndex,
                                            objIdNamePair.Tag,
                                            iRow);
                }
                else if (objIdNamePair.Name.toLowerCase() == "iboedate") {
                    transEntry.setUIValue(transEntryFieldInfo.BOEDate.Area,
                                            transEntryFieldInfo.BOEDate.MetaDataIndex,
                                            transEntryFieldInfo.BOEDate.ColumnIndex,
                                            objIdNamePair.Tag,
                                            iRow);
                }
                else if (objIdNamePair.Name.toLowerCase() == "scontainerno") {
