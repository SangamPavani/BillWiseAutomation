                        && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false
                        && DataType.stringStartsWith(objMetaData.sDefaultValue, "#") == true) {
                        for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows(); iCounter++) {
