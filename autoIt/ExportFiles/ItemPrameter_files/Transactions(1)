    checkDefaultAndPreloadForMasters: function (cellobj, objMetaData) {
        let sFilter = "";
        let sGroups = "";
        let iId = 0;
        let iIndex = 0;
        let iOldVal = 0;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let obj = undefined;

        try {
            obj = {};
            obj.iPreloadValue = 0;
            obj.bGroup = false;
            if (objMetaData.iDataTypeId != eMasterDataType.Master && objMetaData.iDataTypeId != eMasterDataType.ExternalTable) {
                return(obj);
            }

            if (DataType.isNullOrEmpty(objMetaData.sPreload) == true && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == true) {
                if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE && transEntryInfo.Settings.Misc.DefaultAccount1 > 0) {
                    obj.iPreloadValue = transEntryInfo.Settings.Misc.DefaultAccount1;
                    OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, obj.iPreloadValue);
                    if (DataType.toInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid)) == 0) {
                        obj.bGroup = true;
                        OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, obj.iPreloadValue);
                    }
                }
                else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBOOKNO && transEntryInfo.Settings.Misc.DefaultAccount2 > 0) {
                    // Journal Entry Case
                    obj.iPreloadValue = transEntryInfo.Settings.Misc.DefaultAccount2;
                    OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, obj.iPreloadValue);
                    if (DataType.toInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid)) == 0) {
                        obj.bGroup = true;
                        OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, obj.iPreloadValue);
                    }
                }

                return(obj);
            }

            if (DataType.stringIncludes(objMetaData.sDefaultValue, "#") == true)
            {
                iIndex = 1;
                if (DataType.stringStartsWithRaw(objMetaData.sDefaultValue, "&") == true) {
                    iIndex = 2;
                }

                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDefaultValue.substr(iIndex), cellobj.iRow, null, cellobj.iColumn - 1, objMetaData.sFieldName);
                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);                    
                iId = DataType.toInt(objFormulaOutput.Value);
                if (iId > 0) {
                    iIndex = 2;
                }
            }
            else if (DataType.isNumeric(objMetaData.sDefaultValue)) {
                iId = DataType.toInt(objMetaData.sDefaultValue);
            }

            iOldVal = DataType.toInt(cellobj.getCellData());
            if (iIndex == 2 || iOldVal <= 0) {
                if(iId > 0) {
                    cellobj.setControl(cellobj.ColumnAttribute.ctrlid, iId);
                    obj.iPreloadValue = iId;
                }
                else if (EntryMainCommon.isMatch("^[0-9]+(,[0-9]+)+$", objMetaData.sDefaultValue) == true) {
                    sFilter = OPTIONCONTROL.getFilter(cellobj.ColumnAttribute.ctrlid);
                    if (DataType.isNullOrEmpty(sFilter) == true) {
                        OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, " a.iMasterId in (" + objMetaData.sDefaultValue + ")");
                    }
                    else {
                        OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, sFilter + " and a.iMasterId in (" + objMetaData.sDefaultValue + ")");
                    }
                }
                else if (DataType.stringStartsWithRaw(objMetaData.sDefaultValue.toLowerCase(), "grp(") == true) {
                    sGroups = objMetaData.sDefaultValue.substr(4, objMetaData.sDefaultValue.length - 5);
                    OPTIONCONTROL.setGroups(cellobj.ColumnAttribute.ctrlid, sGroups);
                }


                if (DataType.toInt(OPTIONCONTROL.getControlValue(cellobj.ColumnAttribute.ctrlid)) == 0) {
                    obj.bGroup = true;
                    OPTIONCONTROL.setGroupId(cellobj.ColumnAttribute.ctrlid, iId);
                    if (iOldVal > 0) {
                        OPTIONCONTROL.setValue(cellobj.ColumnAttribute.ctrlid, iOldVal);
                    }
                }
            }

            if (transEntryInfo.ItemPreload <= 0 && iId > 0) {
                transEntryInfo.ItemPreload = -2;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body checkDefaultAndPreloadForMasters method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.checkDefaultAndPreloadForMasters} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (obj);
    },

