            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.isSavingTimeRestrictd} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    isBillStatusRestricted: function (iRow, iFieldId, objMetaData) {
        let objArea = eTranEntryFieldArea.None;

        try {
            if (transEntryInfo.HeaderId <= 0) {
                return (false);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == false) {
                return (false);
            }

            if (transEntryGlobal.EntryModel.Data.iBillStatus == eBillStatus.None && DataType.isNullOrEmpty(transEntryGlobal.EntryModel.Data.sBillStatusDocNo, true) == false) {
            }
            else if (transEntryGlobal.EntryModel.Data.iBillStatus != eBillStatus.Paid && transEntryGlobal.EntryModel.Data.iBillStatus != eBillStatus.Partial) {
                return (false);
            }

            if (transEntryGlobal.debugRestrictd == true) {
                debugger
            }

            objArea = eTranEntryFieldArea.None;
            if ((iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0) {
                objArea = eTranEntryFieldArea.Header;
            }
            else if ((iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                objArea = eTranEntryFieldArea.Body;
            }

            if (objArea != eTranEntryFieldArea.None) {
                if (transEntryInfo.ARAPPref.iARTagId != 0 && objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iARTagId) {
                    if (objArea == eTranEntryFieldArea.Body && DataType.gt(iRow, 0) == true && transEntryFields.getBodyId(iRow) == 0) {
                        return (false);
                    }

                    transEntryGlobal.writeConsoleLog("Bill status restricted for ARTag field id " + iFieldId + " for row " + iRow + ". It is adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "'", "royalblue", true, "16px");
                    return (true);
                }

                if (transEntryInfo.ARAPPref.iAPTagId != 0 && objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iAPTagId) {
                    if (objArea == eTranEntryFieldArea.Body && DataType.gt(iRow, 0) == true && transEntryFields.getBodyId(iRow) == 0) {
                        return (false);
                    }

                    transEntryGlobal.writeConsoleLog("Bill status restricted for APTag field id " + iFieldId + " for row " + iRow + ". It is adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "'", "royalblue", true, "16px");
                    return (true);
                }
            }

            objArea = eTranEntryFieldArea.None;
            if (iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                objArea = eTranEntryFieldArea.Header;
            }
            else if (iFieldId == eVTFIELDID.FDF_BODYCURRENCY) {
                objArea = eTranEntryFieldArea.Body;
            }

            if (objArea != eTranEntryFieldArea.None) {
                if (objArea == eTranEntryFieldArea.Body && DataType.gt(iRow, 0) == true && transEntryFields.getBodyId(iRow) == 0) {
                    return (false);
                }

                transEntryGlobal.writeConsoleLog("Bill status restricted for currency field id " + iFieldId + " for row " + iRow + ". It is adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "'", "royalblue", true, "16px");
                return (true);
            }

            objArea = eTranEntryFieldArea.None;
            if (iFieldId == eVTFIELDID.FDF_EXCHANGERATE) {
                objArea = eTranEntryFieldArea.Header;
            }
            else if (iFieldId == eVTFIELDID.FDF_BODYEXCHANGERATE) {
                objArea = eTranEntryFieldArea.Body;
            }

            if (objArea != eTranEntryFieldArea.None) {
                if (objArea == eTranEntryFieldArea.Body && DataType.gt(iRow, 0) == true && transEntryFields.getBodyId(iRow) == 0) {
                    return (false);
                }

                transEntryGlobal.writeConsoleLog("Bill status restricted for exchange rate field id " + iFieldId + " for row " + iRow + ". It is adjusted in '" + transEntryGlobal.EntryModel.Data.sBillStatusDocNo + "'", "royalblue", true, "16px");
                return (true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.isBillStatusRestricted} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    isLinkRestrictd: function (iRow, iFieldId, bLog, value) {
        let lTransIds = 0;
        let iIndex = 0;
        let iCounter = 0;
        let iFieldCounter = 0;
        let iDocDate = 0;
        //let bFlag = false;
        let arrFoundIndex = null;
        let arrLinkFound = null;
        let arrLinkId = null;
        let objLinkInfo = null;
        let objTagMetaData = null;
        let objData = null;
        let objResult = undefined;

        try {
            objResult = {};
            objResult.Message = "";
            objResult.Value = false;

            if (transEntryInfo.HeaderId <= 0) {
                objResult.Value = false;
                return (objResult);
            }

            if (DataType.isValidObject(transEntryGlobal.EntryModel) == false
                || DataType.isValidObject(transEntryGlobal.EntryModel.Data) == false
                || DataType.arrayLength(transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue) < 1) {

                objResult.Value = false;
                return (objResult);
            }

            if (transEntryGlobal.debugRestrictd == true) {
                debugger
            }

            if (DataType.gt(iRow, 0) == true) { // Called from body
                lTransIds = transEntryFields.getTransactionId(iRow);
                if (DataType.isZero(lTransIds) == true) {

                    objResult.Value = false;
                    return (objResult);
                }

                //arrFoundIndex = DataType.arrayFilterDataIndex(transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue, "lTransId", lTransIds, "==");
                arrFoundIndex = DataType.arrayFilterDataIndex(transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue, ["lTransId", "bSuspended"], [lTransIds, false], "==");
                if (arrFoundIndex.length < 1) {

                    objResult.Value = false;
                    return (objResult);
                }

                bFlag = false;

                for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                    iIndex = arrFoundIndex[iCounter];
                    objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];
                    if (DataType.eq(objData.dBase, objData.dBalance) == false || objData.bSuspended == true) {
                        bFlag = true;
                    }
                }

                if (bFlag == false) {

                    objResult.Value = false;
                    return (objResult);
                }

                if (DataType.isValidObject(iFieldId) == false && bFlag == true) {

                    objResult.Value = true;
                    return (objResult);
                }

                if (DataType.arrayLength(transEntryInfo.NextLinkDef) > 0) {
                    for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                        iIndex = arrFoundIndex[iCounter];
                        objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                        objLinkInfo = null;
                        arrLinkFound = DataType.arrayFilterDataIndex(transEntryInfo.NextLinkDef, "iLinkId", objData.iLinkId, "==");
                        if (arrLinkFound.length > 0) {
                            iIndex = arrLinkFound[0];
                            objLinkInfo = transEntryInfo.NextLinkDef[iIndex];
                            iIndex = arrFoundIndex[iCounter];
                        }

                        if (DataType.isValidObject(objLinkInfo) == true
                            && DataType.isValidObject(objLinkInfo.objLinkDef) == true) {
                            if (objLinkInfo.objLinkDef.UseLinkForLoading == true) {
                                continue;
                            }

                            for (iFieldCounter = 0; iFieldCounter < DataType.arrayLength(objLinkInfo.arrFilterCriteria); iFieldCounter++) {
                                if (objLinkInfo.arrFilterCriteria[iFieldCounter].FilterFieldID == iFieldId) {
                                    objResult.Message = "Link restricted for key field id " + iFieldId + " for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                    }
                }

                switch (iFieldId) {
                    case eVTFIELDID.FDF_BODYPRODUCT:
                    case eVTFIELDID.FDF_BODYCURRENCY:
                    case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    case eVTFIELDID.FDF_BODYUNITS:
                    //case eVTFIELDID.FDF_BODYCODE:
                        objResult.Message = "Link restricted for field id " + iFieldId + " for row " + iRow;
                        objResult.Value = true;

                        if (bLog == true) {
                            transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        }

                        return (objResult);
                    case eVTFIELDID.FDF_BODYQUANTITY:
                        for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                            if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Quantity
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Gross
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionGross) {

                                continue;
                            }

                            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                                iIndex = arrFoundIndex[iCounter];
                                objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                                if (DataType.isZero(objData.dBalance) == true) {
                                    objResult.Message = "Link value fully consumed for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYALTQUANTITY:
                        for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                            if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.AlternateQuantity
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Gross
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionGross) {

                                continue;
                            }

                            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                                iIndex = arrFoundIndex[iCounter];
                                objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                                if (DataType.isZero(objData.dBalance) == true) {
                                    objResult.Message = "Link value fully consumed for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYRATE:
                        for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                            if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Gross
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionGross) {
                                continue;
                            }

                            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                                iIndex = arrFoundIndex[iCounter];
                                objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                                if (DataType.isZero(objData.dBalance) == true) {
                                    objResult.Message = "Link value fully consumed for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYGROSS:
                        for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                            if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Gross
                                && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionGross) {
                                continue;
                            }

                            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                                iIndex = arrFoundIndex[iCounter];
                                objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                                if (DataType.isZero(objData.dBalance) == true) {
                                    objResult.Message = "Link value fully consumed for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYAMOUNT:
                        for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                            if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Amount) {
                                continue;
                            }

                            for (iCounter = 0; iCounter < arrFoundIndex.length; iCounter++) {
                                iIndex = arrFoundIndex[iCounter];
                                objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iIndex];

                                if (DataType.isZero(objData.dBalance) == true) {
                                    objResult.Message = "Link value fully consumed for row " + iRow;
                                    objResult.Value = true;

                                    if (bLog == true) {
                                        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                    }

                                    return (objResult);
                                }
                            }
                        }
                        break;
                    default:
                        objTagMetaData = transEntryInvTag.getMetaData();
                        if (DataType.isValidObject(objTagMetaData) == true && objTagMetaData.iFieldId == iFieldId) {
                            objResult.Message = "Link restricted for inv field id " + iFieldId + " for row " + iRow;
                            objResult.Value = true;

                            if (bLog == true) {
                                transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                            }

                            return (objResult);
                        }

                        if (transEntryFieldInfo.FATag.FieldId == iFieldId) {
                            objResult.Message = "Link restricted for fa field id " + iFieldId + " for row " + iRow;
                            objResult.Value = true;

                            if (bLog == true) {
                                transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                            }

                            return (objResult);
                        }
                        break;
                }
            }
            else { // Called from header
                arrLinkId = [];
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue.length; iCounter++) {
                    objData = transEntryGlobal.EntryModel.Data.arrTransLinkUsedValue[iCounter];
                    if (objData.bSuspended == true) {
                        continue;
                    }

                    if (DataType.eq(objData.dBase, objData.dBalance) == false || objData.bSuspended == true) {
                        arrLinkId.push(objData.iLinkId);
                    }
                }

                if (arrLinkId.length > 0) {
                    iDocDate = transEntryLinks.getMaxDocumentDate();
                    for (iIndex = 0; iIndex < arrLinkId.length; iIndex++) {
                        arrLinkFound = DataType.arrayFilterDataIndex(transEntryInfo.NextLinkDef, "iLinkId", arrLinkId[iIndex], "==");
                        if (arrLinkFound.length < 1) {
                            continue;
                        }

                        objLinkInfo = transEntryInfo.NextLinkDef[arrLinkFound[0]];
                        if (DataType.isValidObject(objLinkInfo) == false) {
                            continue;
                        }

                        if (DataType.isValidObject(objLinkInfo.objLinkDef) == false) {
                            continue;
                        }

                        if (objLinkInfo.objLinkDef.UseLinkForLoading == true) {
                            continue;
                        }

                        if (iFieldId == eVTFIELDID.FDF_DATE) {
                            if (iDocDate != undefined && objLinkInfo.objLinkDef.BaseDocCannotEdited == false) {
                                if (value <= iDocDate) {
                                    continue;
                                }

                                objResult.Message = "This document is already used in link voucher. Due to this date cannot be greater than linked voucher date " + FDate.intToString(iDocDate);
                                objResult.Value = true;

                                if (bLog == true) {
                                    transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                }

                                return (objResult);
                            }

                            if (objLinkInfo.objLinkDef.IsAllowBackDatedLinking == false) {
                                objResult.Message = "Cannot change date as it is already used in link voucher.";
                                objResult.Value = true;

                                if (bLog == true) {
                                    transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                }

                                return (objResult);
                            }
                        }

                        for (iFieldCounter = 0; iFieldCounter < DataType.arrayLength(objLinkInfo.arrFilterCriteria); iFieldCounter++) {
                            if (objLinkInfo.arrFilterCriteria[iFieldCounter].FilterFieldID == iFieldId) {
                                objResult.Message = "Link restricted for key field id " + iFieldId;
                                objResult.Value = true;

                                if (bLog == true) {
                                    transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                                }

                                return (objResult);
                            }
                        }
                    }

                    if (iFieldId == eVTFIELDID.FDF_HEADERCURRENCY) {
                        objResult.Message = "Link restricted for key field id " + iFieldId;
                        objResult.Value = true;

                        if (bLog == true) {
                            transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        }

                        return (objResult);
                    }

                    if (iFieldId == eVTFIELDID.FDF_EXCHANGERATE) {
                        //for (iFieldCounter = 0; iFieldCounter < transEntryInfo.NextLinkDef.length; iFieldCounter++) {
                        //    if (transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Gross
                        //        && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionGross
                        //        && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Amount
                        //        && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.Net
                        //        && transEntryInfo.NextLinkDef[iFieldCounter].iLinkValue != eTranEntryLinkValue.TransactionAmount) {
                        //        continue;
                        //    }

                        //    objResult.Message = "Link restricted for key field id " + iFieldId;
                        //    objResult.Value = true;

                        //    if (bLog == true) {
                        //        transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        //    }

                        //    return (objResult);
                        //}

                        objResult.Message = "Link restricted for key field id " + iFieldId;
                        objResult.Value = true;

                        if (bLog == true) {
                            transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        }

                        return (objResult);
                    }

                    objTagMetaData = transEntryInvTag.getMetaData();
                    if (DataType.isValidObject(objTagMetaData) == true && objTagMetaData.iFieldId == iFieldId) {
                        objResult.Message = "Link restricted for inv field id " + iFieldId;
                        objResult.Value = true;

                        if (bLog == true) {
                            transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        }

                        return (objResult);
                    }

                    if (transEntryFieldInfo.FATag.FieldId == iFieldId) {
                        objResult.Message = "Link restricted for fa field id " + iFieldId;
                        objResult.Value = true;

                        if (bLog == true) {
                            transEntryGlobal.writeConsoleLog(objResult.Message, "royalblue", true, "16px");
                        }

                        return (objResult);
                    }
                }
            }

            objResult.Message = "";
            objResult.Value = false;
        }
        catch (err) {
            transEntryGlobal.showAlert("EntryMainUI.isLinkRestrictd} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

