const EntryMainReevaluate = {
    fetchMasterVariablesValue: function (bOnlyRefresh) {
        let sVariableName = "";
        let iBodyVariableStartIndex = 0;
        let iMasterId = 0;
        let iBookNo = 0;
        let iCounter = 0;
        let iRow = 0;
        let arrMasterVariables = null;
        let arrInput = [];       

        try {
            arrMasterVariables = [];
            if (transEntryGlobal.isIgnoreServerCall() == true) {
                return;
            }

            bOnlyRefresh = DataType.toBoolean(bOnlyRefresh);

            arrInput = [];
            arrMasterVariables = [];
            EntryMainReevaluate.getHeaderMasterVariables(arrMasterVariables, bOnlyRefresh);
            for (iCounter = 0; iCounter < arrMasterVariables.length; iCounter++) {
                iMasterId = transEntryGrid.getMasterValue(0, arrMasterVariables[iCounter].iMasterTypeId);

                if (arrMasterVariables[iCounter].sVariableName != null) {
                    sVariableName = arrMasterVariables[iCounter].sVariableName.toLowerCase();
                    iBookNo = 0;
                    if (DataType.stringStartsWithRaw(sVariableName, "mpb6c") == true
                        || DataType.stringStartsWithRaw(sVariableName, "mpb5c") == true) {
                        iBookNo = EntryMain.m_objTrans.BodyData[0].Book;
                    }

                    arrInput.push({ sVariableName: sVariableName, iMasterId: iMasterId, iBodyId: iBookNo });
                }
            }

            iBodyVariableStartIndex = arrMasterVariables.length;
            EntryMainReevaluate.getBodyMasterVariables(arrMasterVariables, bOnlyRefresh);

            if (arrMasterVariables.length > iBodyVariableStartIndex) {
                for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        continue;
                    }

                    for (iCounter = iBodyVariableStartIndex; iCounter < arrMasterVariables.length; iCounter++) {
                        iMasterId = transEntryGrid.getMasterValue(iRow, arrMasterVariables[iCounter].iMasterTypeId);

                        if (arrMasterVariables[iCounter].sVariableName != null) {
                            sVariableName = arrMasterVariables[iCounter].sVariableName.toLowerCase();
                            iBookNo = 0;
                            if (DataType.stringStartsWithRaw(sVariableName, "mpb6c") == true
                                || DataType.stringStartsWithRaw(sVariableName, "mpb5c") == true) {
                                iBookNo = EntryMainMemoryObject.getBookValue(iRow);
                            }

                            arrInput.push({ sVariableName: sVariableName, iMasterId: iMasterId, iBodyId: iBookNo });
                        }
                    }
                }
            }

            transEntryCache.fetchMasterVariablesValue(arrInput, false);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainReevaluate.fetchMasterVariablesValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    fetchRatesValue: function () {
        let iRow = 0;
        let iCounter = 0;
        let arrRateVariables = null;
        let arrInput = null;
        let obj = null;

        try {
            if (transEntryGlobal.isIgnoreServerCall() == true) {
                return;
            }

            arrRateVariables = EntryMainReevaluate.getBodyRateVariables();
            if (arrRateVariables.length <= 0) {
                return;
            }

            arrInput = [];
            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    continue;
                }

                for (iCounter = 0; iCounter < arrRateVariables.length; iCounter++) {
                    obj = {};
                    obj.iProduct = EntryMainMemoryObject.getProductValue(iRow);
                    obj.iCustomer = EntryMainMemoryObject.getBookValue(iRow);
                    obj.iTag = transEntryGrid.getMasterValue(iRow, transEntryInfo.PricebookTag);
                    obj.iCurrencyId = EntryMainMemoryObject.getCurrencyId(iRow);
                    obj.iUnit = EntryMainMemoryObject.getUnitValue(iRow);
                    obj.dQuantity = transEntryFields.getQty(iRow);
                    obj.bPurchase = arrRateVariables[iCounter].bPurchase;
                    obj.bChkInGroup = false;
                    obj.iIndex = arrRateVariables[iCounter].iIndex;

                    arrInput.push(obj);
                }
            }

            transEntryCache.fetchRateVariablesValue(arrInput, false);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainReevaluate.fetchRatesValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onHeaderEvaluate: function () {
        let iCounter = 0;
        let objMetaData = null;

        try {
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                EntryMainReevaluate.evaluateHeaderFormula(objMetaData);
                EntryMainHeader.applyRuleOnLostFocus(objMetaData.iFieldId);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainReevaluate.onHeaderEvaluate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    evaluateHeaderFormula: function (objMetaData) {
        let sCtrlId = "";
        let eleCtrl = null;
        let result = null;
        let value = null;

        try {
            result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);
            if (result.lValue < 1) {
                if (DataType.isNullOrEmpty(objMetaData.sPreload) == true) {
                    return;
                }

                result.data = objMetaData.sPreload;
                if (DataType.stringStartsWithRaw(objMetaData.sPreload, "&") == true) {
                    result.bRefresh = true;
                    result.data = objMetaData.sPreload.substr(1);
                }
            }

            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
            switch(objMetaData.iDataTypeId)
            {
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    if (result.bRefresh == true) {
                        result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                        EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                    }
                    else {
                        value = DataType.toInt(OPTIONCONTROL.getControlValue(sCtrlId));
                        if (value == 0) {
                            result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                            EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                        }
                    }
                    break;
                case eMasterDataType.Text:
                    if (result.bRefresh == true) {
                        result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                        EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                    }
                    else {
                        eleCtrl = document.getElementById(sCtrlId);
                        value = eleCtrl.value;
                        if (DataType.isNullOrEmpty(value) == true) {
                            result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                            EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                        }
                    }
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.Fraction:
                case eMasterDataType.BigNumber:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    if (result.bRefresh == true) {
                        result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                        EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                    }
                    else {
                        eleCtrl = document.getElementById(sCtrlId);
                        value = eleCtrl.value;
                        if (DataType.isNullOrEmpty(value) == true) {
                            result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                            EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                        }
                    }
                    break;
                case eMasterDataType.StringList:
                case eMasterDataType.NumberList:
                    if (result.bRefresh == true) {
                        result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                        EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                    }
                    else {
                        eleCtrl = document.getElementById(sCtrlId);
                        if (eleCtrl.selectedIndex < 0) {
                            result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                            EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                        }
                    }
                    break;
                default:
                    if (result.bRefresh == true) {
                        result = EntryMainFormula.evaluateFormulaValue(result.data, 0, 0);
                        EntryMainUI.setHeaderFieldValue(objMetaData, result.data);
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainReevaluate.evaluateHeaderFormula} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
