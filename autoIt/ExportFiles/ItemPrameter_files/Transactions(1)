    validateForDuplicateBatch: function () {
        let iRow = 0;
        let iIndex = 0;
        let arrBatch = undefined;

        try {
            if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) {
                return(true);
            }

            if (transEntryInfo.isInwardVoucher == false) {
                return(true);
            }

            if (transEntryInfo.BatchPref.bDontAcceptDuplicatebatchInInwardDocuments == false) {
                return (true);
            }

            arrBatch = transEntryBatch.getUsedBatchList();
            for (iRow = 0; iRow < arrBatch.length; iRow++) {
                iIndex = transEntryBatch.checkDuplicateBatchNo(arrBatch, arrBatch[iRow].BatchNo, arrBatch[iRow].iRow);
                if (iIndex >= 0 && (EntryMainProductionProcess.isIssueRow(arrBatch[iRow].iRow) == false)) {
                    transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDuplicateBatch"), GlobalPref.getResourceValue("Error"));
                    transEntryGrid.markRow(arrBatch[iRow].iRow);

                    return(false);

                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.validateForDuplicateBatch} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    validateBatchExpiryDate: function () {
        let iDocDate = 0;
        let iExpDate = 0;
        let iValue = 0;
        let iRow = 0;
        let objData = null;

        try {
            if (transEntryFieldInfo.BatchNo.ColumnIndex > -1
                && transEntryInfo.isInwardVoucher == false
                && transEntryInfo.BatchPref.bExpiryDatesForBatches == true) {
                iDocDate = EntryMain.m_objTrans.Header.Date;

                for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        continue;
                    }

                    objData = transEntryBatch.getBatchInfo(iRow);
                    if (DataType.isValidObject(objData) == false) {
                        continue;
                    }

                    if (transEntryFields.isRequired(eVTFIELDID.FDF_EXPDATE, iRow) == true) {
                        iExpDate = DataType.toInt(objData.ExpDate.Value);
                        if (iExpDate == 0) {
                            continue;
                        }

                        if (transEntrySettings.isAllowExpiredBatchesToBeSelected == true) {
                            continue;
                        }

                        iValue = DataType.toInt(transEntryInfo.BatchPref.sCantSellBatchesExpireInNextNo);
                        if (transEntryInfo.BatchPref.bCantSellBatchesExpireInNext == true && iValue > 0) {
                            switch (transEntryInfo.BatchPref.iCantSellBatchesExpireInNextMonth) {
                                case 0: // Day
                                    break;
                                case 1: // Week
                                    iValue *= 7;
                                    break;
                                case 2: // Month
                                    iValue *= 30;
                                    break;

                            }

                            iExpDate = FDate.subtractDays(iExpDate, iValue, transEntryInfo.CalendarType);
                        }

                        if (iExpDate < iDocDate) {
                            EntryMainUI.clear(transEntryFieldInfo.BatchNo, iRow);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.validateBatchExpiryDate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
