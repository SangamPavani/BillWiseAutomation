            if (DataType.isNullOrEmpty(objServerData.sMessage) == false) {
                transEntryGlobal.showAlert(objServerData.sMessage);
            }

            if (transEntrySettings.isApplyRuleOnLink == true) {
                EntryMainRules.applyEdit(false);
            }

            if (DataType.isValidObject(objOldData) == true) {
                transEntryGlobal.EntryModel.Data = objOldData;
            }

            if (tag.bFromWorkflow == false) {
                transEntryGrid.gotoCell(tag.iRow, tag.iColumn);
