    getVatRate: function (iRow) {
        let iCounter = 0;
        let iTaxCode = 0;
        let iTaxCategory = 0;
        let iJurisdictionId = 0;
        let iMaskedVoucherType = 0;
        let Type = 0;
        let dVatPer = 0;
        let arrTaxRates = null;
        let objFieldInfo = undefined;
        let arrRate = null;
        let bPur = false;
        let temp = null;

        try {
            if (transEntryGlobal.debugVAT == true) {
                debugger
            }

            iTaxCode = EntryMainMemoryObject.getTaxCodeValue(iRow);
            switch (iTaxCode) {
                case 24: // Std rate 5%
                case 25: // SR-REC5
                case 26: // Import 5%
                case 27: // RCM 5
                    return (5);
                case 28: // SREC-FA
                    return (transEntryGlobal.m_dVATPercent);
            }

            dVatPer = transEntryGlobal.m_dVATPercent;

            arrTaxRates = transEntryGlobal.m_arrTaxRates;
