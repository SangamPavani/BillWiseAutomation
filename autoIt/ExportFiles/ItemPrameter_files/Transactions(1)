    GetData: function (arrElements, pageTag) {
        debugger
        var PreferenceData = {};
        var IdValArray = [];
        var IdTextArray = [];
        var k = 0;
        if (pageTag == "12") {
            var url = document.getElementById("SMSURL");
            var servername = document.getElementById("FTPServer");
            if (CONFIGURETRANS.ValidateURL(url) == false) {
                flag = 1;
            }
            if (CONFIGURETRANS.Validateservername(servername) == false) {
                flag = 1;
            }
        }
        else if (pageTag == "39") {
            CONFIGURETRANS.ClearWatappelement();
        }
        else if (pageTag == "13") {
            var iSmtpType = document.getElementById("SMTPSettings").value;
            if (iSmtpType == 4) {
                var sEmailid = document.getElementById("EmailId").value;
                var sTenantid = document.getElementById("txtTenantid").value;
                var sclientsecret = document.getElementById("txtclientsecret").value;
                var sApplicationId = document.getElementById("txtApplicationId").value;
                if (sEmailid.length == 0) {
                    alert("Enter Email Id");
                    flag = 1;
                }
                else if (sTenantid.length == 0) {
                    alert("Enter Tenant Id");
                    flag = 1;
                }
                else if (sclientsecret.length == 0) {
                    alert("Enter client secret");
                    flag = 1;
                }
                else if (sApplicationId.length == 0) {
                    alert("Enter Application Id");
                    flag = 1;
                }
            }
        }
        for (var i = 0; i < arrElements.length; i++) {

            switch (document.getElementById(arrElements[i].Id).dataset.type) {


                case "Radio":

                    var rdbEle = document.getElementById(arrElements[i].Id)
                    var bExit = false;
                    for (var j = 0; j < rdbEle.children.length; j++) {
                        var name = rdbEle.dataset.fieldname;
                        if (document.getElementById(name + "_" + j).checked) {
                            IdValArray.push({ FieldId: arrElements[i].Tag, Value: j });
                            bExit = true;
                            break;
                        }
                    }
                    if (!bExit)
                        IdValArray.push({ FieldId: arrElements[i].Tag, Value: 0 });
                    break;
                case "TextBox":
                    {
                        IdTextArray.push({ FieldId: arrElements[i].Tag, Text: document.getElementById(arrElements[i].Id).value });
                    }
                    break;
                case "ListCheckBox":
                    {
                        var chklist = document.getElementById(arrElements[i].Id).children[0].children[0].children[0];
                        IdTextArray.push({ FieldId: arrElements[i].Tag, Text: chklist.value });
                    }
                    break;
                case "Number":
                    IdValArray.push({ FieldId: arrElements[i].Tag, Value: document.getElementById(arrElements[i].Id).value });
                    break;
                case "CheckBox":
                    if (document.getElementById(arrElements[i].Id).checked) {
                        IdValArray.push({ FieldId: arrElements[i].Tag, Value: 1 });
                    }
                    else {
                        IdValArray.push({ FieldId: arrElements[i].Tag, Value: 0 });
                    }
                    break;
                case "Combobox":
                case "TextValue":
                    if (document.getElementById(arrElements[i].Id).value > 0) {
                        atleastOneTag = document.getElementById(arrElements[i].Id).value;
                        IdValArray.push({ FieldId: arrElements[i].Tag, Value: document.getElementById(arrElements[i].Id).value });
                    }
                    else {

                        IdValArray.push({ FieldId: arrElements[i].Tag, Value: 0 });

                        if (selectedPreference == "Budgets") {
                            var bcombo = document.getElementById(arrElements[i].Id).disabled;
                            if (arrElements[i].Id == "cmbBudgetPlanning") {
                                if (bcombo == false) {
                                    atleastOneTag = document.getElementById(arrElements[i].Id).value;
                                    if (document.getElementById(arrElements[i].Id).value == '' || atleastOneTag == -1) {
                                        alert("At least one tag is compulsory!");
                                        return;
                                    }
                                }
                            }
                        }
                    }
                    break;
                case "OptionControl":
                    IdValArray.push({ FieldId: arrElements[i].Tag, Value: OPTIONCONTROL.getControlValue(document.getElementById(arrElements[i].Id).dataset.optid) });
                    break;
                case "DatePicker":
                    IdValArray.push({ FieldId: arrElements[i].Tag, Value: DATEPICKER.getDate(document.getElementById(arrElements[i].Id).dataset.dateid) });
                    break;
                case "Masters":

                    var grdId = document.getElementById(arrElements[i].Id).getAttribute('data-target');
                    FGRIDCONTROL.update(grdId, null);
                    var iRows = FGRIDCONTROL.getTotalRows(grdId);
                    var iCols = FGRIDCONTROL.getTotalColumns(grdId);
                    for (var j = 0; j < (iRows * iCols); j++) {
                        fldtxt = {};
                        fldtxt.FieldId = IdTextArray.length == 0 ? 7 + j : IdTextArray[IdTextArray.length - 1].FieldId + 1;
                        var cell = FGRIDCONTROL.getCellObject(grdId, parseInt((j / 2) + 1), (j % 2) + 1);
                        if (cell.cell.style.backgroundColor != "")
                            continue;
                        var obj = cell.getCellText(cell);
                        fldtxt.Text = obj == undefined ? "" : obj.toString();
                        IdTextArray.push(fldtxt);
                    }

                    break;
                case "TimePicker":
                    IdValArray.push({ FieldId: arrElements[i].Tag, Value: FTIMECONTROL.getTime(document.getElementById(arrElements[i].Id).dataset.timeid) });
                    break;
            }
        }
        PreferenceData.TagId = pageTag;
        PreferenceData.IdValArray = IdValArray;
        PreferenceData.IdTextArray = IdTextArray;
        return PreferenceData;

    },

