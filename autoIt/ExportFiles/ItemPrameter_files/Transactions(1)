                for (var i = 0; i < MRP_BATCH.OBJLIST.length; i++) {
                    var CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iBatchIdCol + 1);
                    var iBatch = CellObj.getCellData()
                    if (MRP_BATCH.OBJLIST[i][MRP_BATCH.m_iBatchIdCol] != iBatch) {
                        continue;
                    }
                    if (parseFloat(MRP_BATCH.arrIssuingList[i]) == 0) {
                        lstCount = i + 1;
                        break;
                    }
                    CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.iAdjustedColumn + 1);
                    if (parseFloat(CellObj.CellData.value) == 0) {
                        continue;
                    }
                    var dValue = parseFloat(MRP_BATCH.arrIssuingList[i]).toFixed(MRP_BATCH.iNoofDecimalQty);
                   
                    var QtyCell = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, 2);
                    var bAlloNegitiveBatchQty = document.getElementById('MBatch_Content').getAttribute('data-bAlloNegitiveBatchQty');
                    if (bAlloNegitiveBatchQty != "True") {
                        if (parseFloat(QtyCell.getCellData()) < dValue) {
                            COMMON.prototype.showMessage("Quantity entered is greater than Batch quantity.", "Batches");
                            GLOBAL.LoadingEnd();
                            return false;
                        }
                    }
                    if (dValue > 0) {
                        icount++;
                        dTotal = parseFloat(dTotal) + parseFloat(dValue);
                        dTotal = FConvert.toDecimal(dTotal, MRP_BATCH.iNoofDecimalQty);
                        MRP_BATCH.OBJLIST[i][MRP_BATCH.iAdjustedColumn] = dValue;
                        CellObj.setCellData("value", FConvert.addNumericSeparator(FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty)));
                        CellObj.setCellText(FConvert.toDecimal(dValue, MRP_BATCH.iNoofDecimalQty));
                    }
                    //Note
                    //if(irow == 0 || (irow % 50) == 0) {
                    //    await MRP_BATCH.sleep(1);
                    //}
                    MRP_BATCH.GetSelectedBATCHDataRowwise(irow, i);
                    //break
                }
            }


        } else {
            GridTotalRows = FGRIDCONTROL.getTotalRows(MRP_BATCH.GetBatchGridName());
            var lstCount = 0;
            for (var irow = 0; irow < GridTotalRows; irow++) {
                var i = irow;
                //for (var i = lstCount; i < MRP_BATCH.OBJLIST.length; i++) {
                var CellObj = FGRIDCONTROL.getCellObject(MRP_BATCH.GetBatchGridName(), irow + 1, MRP_BATCH.m_iBatchIdCol + 1);
