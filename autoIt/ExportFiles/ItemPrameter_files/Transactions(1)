            try {
                if (FCommon.UI.isValidObject(document.getElementById("processing")) == true) {
                    document.getElementById("processing").style.display = 'none';
                }
                $("#dvCustomizeEditScreenField").remove();
                $("#editScreen_addFieldsPopupDiv").html(html);
                $("#dvCustomizeEditScreenField").modal('show');
                if (FCommon.UI.isValidObject(document.getElementById("IsFromTransEntry")) == true) {
                    if (FConvert.toBoolean(document.getElementById("IsFromTransEntry").value))
