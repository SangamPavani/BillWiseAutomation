                        dOrig2 = DataType.negated(dOrig2);
                    }

                    //if (m_objTrans.BodyData[0].CurrencyId == m_objPref.objDefCurrency.CurrencyId || !m_objTrans.Header.Flags.UpdateFA)
                    {
                        if (DataType.gt(DataType.negated(Dr), Cr) == true)
