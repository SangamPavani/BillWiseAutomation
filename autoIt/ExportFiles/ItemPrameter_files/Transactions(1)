                cellAdj.setCellData(FConvert.toDecimal(0));
                cellNative.setCellText(FConvert.toDecimal(0));
                cellNative.setCellData(FConvert.toDecimal(0));
                cellSelect.setCheckboxState(false);
                AdjustBills_Screen.IP.SetIPExchangeGainOrLoss(0);

                AdjustBills_Screen.AssignAdjustmentValues();
            }

            for (i = 1; i <= TotalRows; i++) {
                if (AdjustBills_Screen.Footer.GetAmtTobeAdjust() == 0 && g_Adjustment.BeforeAmount == false)
                    break;
                m_AdjustRow = i;
                var cellAdj;
                if (_ObjAdj.bMaintainInInvoiceCurrency) {
                    if ((_ObjAdj.dFooterAmtAdjustedInTransCurr < AdjustBills_Screen.UI.GetAmountToAdjustInTransCurrency()) || g_Adjustment.BeforeAmount == true) {
                        AdjustBills_Screen.PickAdjustments(i - 1);
                        cellAdj = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, EntryColNo);
                        _ObjAdj.dFooterAmtAdjustedInTransCurr = _ObjAdj.dFooterAmtAdjustedInTransCurr + FConvert.toDecimal(cellAdj.getCellData());
                    }
                    else {
                        break;
                    }
                }
                else {
                    if ((_ObjAdj.dFooterAmtAdjustedInBaseCurr < AdjustBills_Screen.UI.GetAmountToAdjustInBaseCurrency()) || g_Adjustment.BeforeAmount == true) {
                        AdjustBills_Screen.PickAdjustments(i - 1);
                        cellAdj = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, EntryColNo);
                        _ObjAdj.dFooterAmtAdjustedInBaseCurr = _ObjAdj.dFooterAmtAdjustedInBaseCurr + FConvert.toDecimal(cellAdj.getCellData());
                        _ObjAdj.dFooterAmtToBeAdjInBaseCurr = _ObjAdj.dAmtToBeAdjInBaseCurr - _ObjAdj.dFooterAmtAdjustedInBaseCurr;
                    }
                    else {
                        break;
                    }
                }
                AdjustBills_Screen.AssignAdjustmentValues();
            }
            if (_ObjAdj.bMaintainInInvoiceCurrency == false) {
                if (_ObjAdj.AllowNewReferenceEnabled == true) {
                    AdjustBills_ScreenNew.PickNewRef();
                }
                else {
                    AdjustBills_Screen.PickOnAccount();
                }
            }
            else {
                if (_ObjAdj.AllowNewReferenceEnabled == true) {
                    AdjustBills_ScreenNew.PickNewRef();
                }
                else {
                    AdjustBills_Screen.PickOnAccount();
                }

            }
            return;
        }
        catch (Ex) {
            alert("Exception: AdjustInFIFO " + Ex.message);
        }
    },

