            objFieldInfo = transEntryFieldInfo.Billwise;
            if (objFieldInfo.FieldId > 0) {
                objControl = EntryMainUI.getElement(objFieldInfo, iRow, false);
                if (objControl.Value) {
                    bFlag = true;
                    if ((typeof objControl.Value).toLowerCase() == "string") {
                        objControl.Value = document.getElementById(objControl.Value);
                        if (DataType.isValidObject(objControl.Value) == true) {
                            objControl.Value.value = value;
                        }
                    }
                    else {
                        objControl.Value.autoHeight(false);
                        objControl.Value.setCellText(value, value);
                    }
                }
            }
        }
        else {
            if (transEntryGlobal.debugField == eVTFIELDID.FDF_REFERENCE) {
                debugger
            }

            if (DataType.isString(value) == true && DataType.isNullOrEmpty(value, true) == false) {
                transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, value);

                bFlag = true;
            }
            else if (DataType.arrayLength(value) > 0) {
                transEntryGrid.setRowData(iRow, eRowDataName.BillwiseData, DataType.toString(value));

                bFlag = true;
            }
        }

        return (bFlag);
    },

