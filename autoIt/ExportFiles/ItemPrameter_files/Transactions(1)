    saveVoucher: function (bSuccess, data, obj) {
        let sMessage = "";
        let iCount = 0;
        let iTotal = 0;
        let iRow = 0;
        let iGridDataRowsCount = 0;
        let objBodyData = undefined;
        let objTemp = undefined;
        let objSaveInput = undefined;
        let objServiceChargeInput = undefined;

        try {
            if (transEntryGlobal.debugCallback == true || transEntryGlobal.debugSave == true) {
                debugger
            }

            transEntryGlobal.stopWatch();

            if (bSuccess == false) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(obj.iSaveSource, true);

                EntryMainFixedAssets.deleteMasters(obj.arrCreatedFAMasters);

                return;
            }

            if (data.lValue < 1) {
                if (DataType.isNullOrEmpty(data.sValue) == true) {
                    data.sValue = "There are some issues in data saving.";
                }
                else {
                    transEntryGlobal.writeErrorLog(EntryMainUI.getErrorTitle(data.lValue) + ": {EntryMainCallback.saveVoucher} " + data.sValue);
                }
                transEntryGlobal.showAlert(data.sValue, EntryMainUI.getErrorTitle(data.lValue));
                FUIElement.removeChild(EntryMainUI.getOthersContainer());

                EntryMainToolbar.enableButtonBasedOnSaveSource(obj.iSaveSource, true);

                if (DataType.isValidObject(data.data) == true) {
                    iGridDataRowsCount = obj.iBodyRowsCount;
                    if(transEntryInfo.isItTransfer == true) {
                        iGridDataRowsCount /= 2;
                    }

                    iTotal = DataType.arrayLength(data.data.BodyIds);
                    for (iCount = 0; iCount < iTotal; iCount++) {
                        iRow = data.data.BodyIds[iCount];

                        if(transEntryInfo.isItTransfer == true && iRow >= iGridDataRowsCount) {
                            iRow = iRow - iGridDataRowsCount; // For get actual row index because stock type transfer post double row for each row.
                        }
                        transEntryGrid.showRowSymbol(iRow + 1, true);
                    }
                }

                EntryMainFixedAssets.deleteMasters(obj.arrCreatedFAMasters);
            }
            else {
                if(DataType.isValidObject(obj.TransactionData) == true && DataType.isValidObject(obj.TransactionData.BodyData) == true) {
                    obj.TransactionData.Body = DataType.stringToObject(DataType.decompress(obj.TransactionData.BodyData)).data
                }

                if(DataType.arrayLength(data.data.DefTransIds) > 0) {
                    for(iCount = 0; iCount < data.data.DefTransIds.length; iCount++) {
                        transEntryGrid.setRowData(iCount + 1, eRowDataName.TransactionId, data.data.DefTransIds[iCount]);
                    }
                }

                if(obj.bSaveInBackground == false && DataType.isValidObject(window.EntryMainBankingIntegration) == true) {
                    EntryMainBankingIntegration.execute(data.data);
                }

                objServiceChargeInput = EntryMainUI.getServiceChargeScreenInput(data.data.SavedHeaderId);

                if (DataType.isNullOrEmpty(data.sValue) == false) {
                    transEntryGlobal.showAlert(data.sValue, "Warning");
                }

                if(DataType.isNullOrEmpty(data.data.sTriggerMessage, true) == false) {
                    transEntryGlobal.showAlert(data.data.sTriggerMessage, "Error in trigger");
                }

                if(obj.bSaveInBackground == true) {
                    transEntryGlobal.showAlert("Saving in background.", "");
                }
                else {
                    sMessage = GlobalPref.getResourceValue("VoucherSavedSucessfully") + "(" + transEntryGlobal.getWatchValue() + ") : <strong>" + data.data.SavedVoucherNo + "</strong>";
                    transEntryGlobal.showAlert(sMessage, "Message");
                }

                // Billwise data is set to grid because it can be used in external module.
                if (DataType.isValidObject(obj.TransactionData) == true && DataType.isValidObject(obj.TransactionData.Body) == true) {
                    for (iCount = 0; iCount < obj.TransactionData.Body.length; iCount++) {
                        objBodyData = obj.TransactionData.Body[iCount];
                        if (DataType.isValidObject(objBodyData[eTranEntryBodyDataConstKey.BillwiseData]) == true) {
                            transEntryGrid.setRowData(objBodyData.objTempValues.iRow, eTranEntryBodyDataConstKey.BillwiseData, objBodyData[eTranEntryBodyDataConstKey.BillwiseData], true);
                        }
                    }
                }

                EntryMain.setEditMode(false);

                if (DataType.isValidObject(transEntryGlobal.ExtraInfo) == false) {
                    transEntryGlobal.ExtraInfo = {};
                }

                transEntryGlobal.ExtraInfo.sVoucherNo = EntryMainUI.getValue(transEntryFieldInfo.DocNo, 0, true);
                transEntryGlobal.ExtraInfo.sSavedVoucherNo = data.data.SavedVoucherNo;
                transEntryGlobal.ExtraInfo.sNewVoucherNo = data.data.VoucherNo;
                transEntryGlobal.ExtraInfo.iHeaderId = data.data.SavedHeaderId;
                transEntryGlobal.ExtraInfo.dNetAmount = EntryMainUI.getNetAmount();


                objSaveInput = {};
                objSaveInput.iSaveSource = obj.iSaveSource;
                objSaveInput.sVoucherNo = data.data.VoucherNo; // New VoucherNo
                objSaveInput.iSavedHeaderId = data.data.SavedHeaderId;
                objSaveInput.ServiceChargeInput = objServiceChargeInput;

                transEntryInfo.HeaderId = data.data.SavedHeaderId;
                transEntryDocumentNo.setText(data.data.SavedVoucherNo);

                iCount = transEntryExternalModule.callExternalModule(eVoucherExternalModuleEvents.AfterSave,
                                                                        0,
                                                                        "",
                                                                        0,
                                                                        0,
                                                                        "EntryMainCallback.externalModuleAfterSave",
                                                                        objSaveInput);

                if (obj.iSaveSource == eTranEntrySaveSource.Amend) {
                    EntryMainCallback.amendSaved();
                    EntryMainToolbar.enableButtonBasedOnSaveSource(obj.iSaveSource, true);

                    EntryMain.updateRefreshHomePageFlag(true);
                    if (iCount == 0) {
                        EntryMainUI.openServiceChargeScreen(objServiceChargeInput);
                    }

                    return;
                }
                else if (obj.iSaveSource == eTranEntrySaveSource.ReverseJV) {
                    objTemp = {};
                    objTemp.sNewDocumentNo = data.data.SavedVoucherNo;
                    objTemp.iVoucherType = transEntryInfo.VoucherType;
                    objTemp.iViewId = transEntryInfo.ViewId;
                    objTemp.bNext = true;
                    objTemp.bEdit = true;

                    result = transEntryServer.loadVoucher(objTemp,
                        eTranEntryLoadSource.None,
                        null,
                        true,
                        "EntryMainCallback.loadVoucher");

                    if (iCount == 0) {
                        EntryMainUI.openServiceChargeScreen(objServiceChargeInput);
                    }

                    return;
                }

                EntryMain.updateRefreshHomePageFlag(true);
                if (iCount == 0) { // If no external module found
                    EntryMainCallback.externalModuleAfterSave([], objSaveInput);                    
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in save voucher callback.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCallback.saveVoucher} " + err.message);
            EntryMainToolbar.enableButtonBasedOnSaveSource(obj.iSaveSource, true);
        }
    },

