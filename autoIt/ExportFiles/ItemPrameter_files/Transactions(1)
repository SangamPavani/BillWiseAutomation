                cell = StockRevaluationBatch.getBalanceQtyCell(iRow);
                obj.BalanceQty = DataType.toDecimal(cell.getCellData());

                cell = StockRevaluationBatch.getBatchRateCell(iRow);
                obj.BatchRate = DataType.toDecimal(cell.getCellData());

                cell = StockRevaluationBatch.getBalanceStockValueCell(iRow);
                obj.BalanceStockValue = DataType.toDecimal(cell.getCellData());

                cell = StockRevaluationBatch.getNewAvgRateCell(iRow);
                obj.NewAvgRate = DataType.toDecimal(cell.getCellData());

                cell = StockRevaluationBatch.getNewStockValueCell(iRow);
                obj.NewStockValue = DataType.toDecimal(cell.getCellData());

                arrData.push(obj);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{StockRevaluationBatch.getSelectedData} ", err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrData);
