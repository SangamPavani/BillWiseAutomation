        let bStockTransfer = false;
        let cell = undefined;
        let objMetaData = undefined;
        let objFAInfo = undefined;
        let objInvInfo = undefined;
        let objCodeInfo = undefined;
        let objBookInfo = undefined;
        let objQtyInfo = undefined;
        let objAltQtyInfo = undefined;
        let objRateInfo = undefined;
        let objGrossInfo = undefined;
        let objBatchRateInfo = undefined;
        let objBatchRate1Info = undefined;
        let objBatchRate2Info = undefined;
        let element = undefined;
        let result = undefined;
        let value = undefined;
        let objFormula = undefined;
        let objVar = undefined;
        let arrVariables = undefined        
        let arrErrorMetaDataIndex = undefined;
        let arrFields = undefined;
        let arrScreenFields = undefined;
        let arrLayoutFields = undefined;
        let objScreenData = undefined;
        let objLayoutData = undefined;
        let arrTimeLog = undefined;
        let objWatch = undefined;
        let objWatch1 = undefined;
        let objWatch2 = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let arrScreenFieldIndex = undefined; 
        let arrScreenFieldId = undefined;
        let arrScreenFieldTime = undefined;

        try {
            if (transEntryGlobal.disableFillDataLog == false) {
                arrTimeLog = [];

                objWatch = new FStopWatch();
                objWatch.start();
            }

            objInput.Output.objOutputTrans = transEntry.getTransactionDataObject(true);

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Get transaction data object.");
                }
            }

            objInput.Output.arrCodeTypes = transEntryGlobal.IntermediateData.arrCodeTypes;
            objInput.Output.arrBookTypes = transEntryGlobal.IntermediateData.arrBookTypes;

            transEntryGlobal.updateIntermediateData(undefined, undefined, undefined);

            objInput.Output.objOutputTrans.Header.Flags.Editing = EntryMain.isEditMode();
            objInput.Output.objOutputTrans.Header.Flags.UpdateFA = EntryMain.m_Settings.Misc.UpdateFA;
            objInput.Output.objOutputTrans.Header.Flags.UpdateInv = EntryMain.m_Settings.Misc.UpdateInventory;
            objInput.Output.objOutputTrans.Header.Flags.NoBinCheck = false;
            objInput.Output.objOutputTrans.Header.LC = 0;

            if (objInput.Output.objOutputTrans.Header.Flags.Editing == true
                && EntryMain.m_bBinModified == true) {
                objInput.Output.objOutputTrans.Header.Flags.NoBinCheck = false;
            }
            else {
                objInput.Output.objOutputTrans.Header.Flags.NoBinCheck = true;
                if(EntryMain.m_bQtyModified == true) {
                    objInput.Output.objOutputTrans.Header.Flags.NoBinCheck = false;
                }                
            }

            if (transEntryGlobal.disableFillDataLog == false) {
                objWatch = new FStopWatch();
                objWatch.start();
            }

            arrErrorMetaDataIndex = [];
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.DocumentViewer:
                    case eMasterDataType.Picture:
                        if (objMetaData.bMandatory == true) {
                            result = FATTACHMENTCONTROL.getData(sId);
                            if (result.lValue < 1) {
                                arrErrorMetaDataIndex.push(iCounter);
                            }
                        }
                        break;
                    case eMasterDataType.Boolean:
                        element = document.getElementById(sId);

                        if (objMetaData.iFieldId == eVTFIELDID.FDF_UPDATESTOCKS) {
                            if (EntryMain.m_Settings.Misc.UpdateInvCanBeChanged == false) {
                                if (EntryMain.m_Settings.Misc.UpdateInventory == true && element.checked == false) {
                                    element.checked = true;
                                    objInput.Output.objOutputTrans.Header.Flags.UpdateInv = true;
                                }
                                else if (EntryMain.m_Settings.Misc.UpdateInventory == false && element.checked == true) {
                                    element.checked = false;
                                    objInput.Output.objOutputTrans.Header.Flags.UpdateInv = false;
                                }
                            }
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_RAISECASHCONTRA) {
                            objInput.Output.objOutputTrans.Header.Flags.PostCashEntry = element.checked;
                        }
                        break;
                    case eMasterDataType.Date:
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                            value = DataType.toInt(DATEPICKER.getDate(sId));
                            if (value == 0 && objMetaData.bMandatory == true) {
                                arrErrorMetaDataIndex.push(iCounter);
                            }
                        }
                        break;
                    case eMasterDataType.Time:
                        break;
                    case eMasterDataType.DateTime:
                        break;
                    case eMasterDataType.ExternalTable:
                        break;
                    case eMasterDataType.Master:
                        value = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        if (objMetaData.bMandatory == true && value <= 0) {
                            arrErrorMetaDataIndex.push(iCounter);
                        }

                        if (objMetaData.iFieldId == eVTFIELDID.FDF_PMTTERMS) {
                            objInput.Output.objOutputTrans.Header.PmtTerm = value;
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_LCNUMBER) {
                            objInput.Output.objOutputTrans.Header.LC = value;
                        }
                        break;
                    case eMasterDataType.NumberList:
                        element = document.getElementById(sId);
                        if (objMetaData.bMandatory == true) {
                            if (DataType.isValidObject(element) == false || element.selectedIndex < 0) {
                                arrErrorMetaDataIndex.push(iCounter);
                                break;
                            }
                        }
                        break;
                    case eMasterDataType.StringList:
                        element = document.getElementById(sId);
                        if (objMetaData.bMandatory == true) {
                            if (DataType.isValidObject(element) == false || element.selectedIndex < 0) {
                                arrErrorMetaDataIndex.push(iCounter);
                                break;
                            }
                        }
                        break;
                    default:
                        if (EntryMain.isInSetLoadedData() == false
                        && DataType.isNullOrEmpty(objMetaData.sDefaultValue) == false
                        && DataType.stringIncludesRaw(objMetaData.sDefaultValue.toLowerCase(), "sqlf") == true) {
                            EntryMainHeader.checkAndEvaluateHeaderFormula(objMetaData, false);
                        }

                        if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                            switch (objMetaData.iFieldBehaviour) {
                                case 1: // pwd
                                    element = document.getElementById(sId);
                                    if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(element.value, true) == true) {
                                        arrErrorMetaDataIndex.push(iCounter);
                                    }
                                    break;
                                case 2: // Narration
                                    if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(OPTIONCONTROL.getControlText(sId), true) == true) {
                                        arrErrorMetaDataIndex.push(iCounter);
                                    }
                                    break;
                                default:
                                    element = document.getElementById(sId);
                                    if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(element.value, true) == true) {
                                        arrErrorMetaDataIndex.push(iCounter);
                                    }
                                    break;
                            }
                        }
                        break;
                }
            }

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Check header mandatory fields.");
                }
            }

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;

            if (objInput.bCheckForMandatory == true && arrErrorMetaDataIndex.length > 0) {
                iIndex = arrErrorMetaDataIndex[0];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iIndex];

                if(objMetaData.bHidden == true && objMetaData.iFieldId == eVTFIELDID.FDF_PRODBATCH && iMaskedVoucherType == eVTTYPE.WDONE) {
                    // Do Nothing SI-43467(83722)
                }
                else if (objMetaData.bHidden == true && objMetaData.iFieldId == eVTFIELDID.FDF_PROD_PROCESS && iMaskedVoucherType == eVTTYPE.WDONE) {
                    // Do Nothing SI-55806(108907)
                }
                else {
                    sValue = EntryMainUI.getFormattedHeaderError(arrErrorMetaDataIndex);
                    transEntryGlobal.showAlert(sValue, GlobalPref.getResourceValue("MandatoryFld"));

                    TRANSACTION_ENTRY.HEADER.selectTabUsingMetaData(iIndex);
                    sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                    FUIElement.setFocus(sId);

                    return (false);
                }
            }

            objFAInfo = transEntryFieldInfo.FATag;
            objInvInfo = transEntryFields.getInfo(eTransEntryField.InvTag, true);
            objCodeInfo = transEntryFieldInfo.Code;
            objBookInfo = transEntryFieldInfo.Book;
            objQtyInfo = transEntryFieldInfo.Qty;
            objAltQtyInfo = transEntryFieldInfo.AltQty;
            objRateInfo = transEntryFieldInfo.Rate;
            objGrossInfo = transEntryFieldInfo.Gross;
            objBatchRateInfo = transEntryFieldInfo.BatchRate;
            objBatchRate1Info = transEntryFieldInfo.BatchRate1;
            objBatchRate2Info = transEntryFieldInfo.BatchRate2;
            
            bStockTransfer = transEntryInfo.isItTransfer;

            if (objInput.iRowIndex < 1 || bStockTransfer == true) {
                if (objQtyInfo.ColumnIndex > -1 && objQtyInfo.MetaData.bHidden == false
                    && objRateInfo.ColumnIndex > -1 && objRateInfo.MetaData.bHidden == false
                    && objGrossInfo.ColumnIndex > -1) {

                    if (transEntryGlobal.disableFillDataLog == false) {
                        objWatch = new FStopWatch();
                        objWatch.start();
                    }

                    transEntryGross.recalculateGross();

                    if (transEntryGlobal.disableFillDataLog == false) {
                        iDiffWatch = objWatch.stop();
                        if (iDiffWatch > 0) {
                            arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Recalculate gross value.");
                        }
                    }
                }
            }

            iTotalRows = transEntryGrid.getTotalRows();
            if (objInput.bCheckForMandatory == true) {
                for (iRow = 1; iRow <= iTotalRows; iRow++) {
                    if (EntryMainBody.isRowEditable(iRow) == false) {
                        break;
                    }

                    if (objFAInfo.Area == eTranEntryFieldArea.Body
                        && EntryMainMemoryObject.getFAValue(iRow) == 0) {

                        sValue = "Value missing in column - " + transEntryGrid.getColumnHeading(objFAInfo.ColumnIndex);
                        transEntryGlobal.showAlert(sValue, GlobalPref.getResourceValue("MandatoryFld"));

                        return (false);
                    }

                    if (objInvInfo.Area == eTranEntryFieldArea.Body
                        && EntryMainMemoryObject.getInvValue(iRow) == 0) {

                        sValue = "Value missing in column - " + transEntryGrid.getColumnHeading(objInvInfo.ColumnIndex);
                        transEntryGlobal.showAlert(sValue, GlobalPref.getResourceValue("MandatoryFld"));

                        return (false);
                    }

                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.bMandatory == false) {
                            continue;
                        }

                        if (EntryMainMemoryObject.getTagValue(objMetaData.iFieldId, iRow).Value == 0) {
                            sValue = "Value missing in column - " + transEntryGrid.getColumnHeading(arrFields[iCounter].ColumnIndex);
                            transEntryGlobal.showAlert(sValue, GlobalPref.getResourceValue("MandatoryFld"));

                            return (false);
                        }
                    }
                }
            }

            dExchangeRate = EntryMain.m_objTrans.BodyData[0].ExchangeRate;

            if (transEntryGlobal.disableFillDataLog == false) {
                objWatch = new FStopWatch();
                objWatch.start();
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter++) {
                iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Footer[iIndex];


                dInput = transEntryControl.getControlDecimalValue(transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId);
                switch (objMetaData.FormulaBehaviour) {
                    case eTranEntryFormulaBehaviourFooter.Value:
                        dValue = dInput;
                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, dExchangeRate);
                        }

                        transEntryFooter.setOutputValue(null, FNumberOperation.convert(dValue), objMetaData);
                        objInput.Output.objOutputTrans.Footer[iCounter].Value = dValue;
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGross:
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, 0, 0);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dFormulaValue).multipliedBy(dInput).dividedBy(100).valueOf();
                        }
                        else {
                            dValue = dFormulaValue * dInput / 100;
                        }

                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, dExchangeRate);
                        }

                        transEntryFooter.setOutputValue(null, FNumberOperation.convert(dValue), objMetaData);
                        objInput.Output.objOutputTrans.Footer[iCounter].Value = dValue;
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnNet:
                        break;
                    case eTranEntryFormulaBehaviourFooter.NegativeValue:
                        dValue = FNumberOperation.negated(dInput);
                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, dExchangeRate);
                        }

                        transEntryFooter.setOutputValue(null, FNumberOperation.convert(dValue), objMetaData);
                        objInput.Output.objOutputTrans.Footer[iCounter].Value = dValue;
                        break;
                    case eTranEntryFormulaBehaviourFooter.PercentageOnGrossMinus:
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput("tgr", 0, 0, 0);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                        dFormulaValue = FNumberOperation.convert(objFormulaOutput.Value);

                        if (EntryMain.m_bSupportBigNumber == true) {
                            dValue = BigNumber(dFormulaValue).multipliedBy(dInput).dividedBy(100).multipliedBy(-1).valueOf();
                        }
                        else {
                            dValue = (dFormulaValue * dInput / 100) * -1;
                        }


                        if (objMetaData.bValueInBaseCurrency == true) {
                            dValue = FNumberOperation.div(dValue, dExchangeRate);
                        }

                        transEntryFooter.setOutputValue(null, FNumberOperation.convert(dValue), objMetaData);
                        objInput.Output.objOutputTrans.Footer[iCounter].Value = dValue;
                        break;
                }
            }

            if (transEntryGlobal.disableFillDataLog == false) {
                iDiffWatch = objWatch.stop();
                if (iDiffWatch > 0) {
                    arrTimeLog.push("FillData::(" + objWatch.getDifferenceString() + ") Recalculate footer value.");
                }
            }

            if (transEntryGlobal.disableFillDataLog == false) {
                arrScreenFieldIndex = [];
                arrScreenFieldId = [];
                arrScreenFieldTime = [];

                objWatch = new FStopWatch();
                objWatch.start();
            }

            arrScreenFields = transEntryFieldInfo.getScreenFields();
            arrLayoutFields = transEntryFieldInfo.getLayoutFields(true);
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    break;
                }

                if (objInput.iRowIndex < 1 || bStockTransfer == true) {
                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount0, 0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount1, 0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount0, 0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount1, 0, false, objInput.Output.objOutputTrans);
                }

                iTagsFormulaRow = -1;
                if (objInput.iRowIndex < 1 || objInput.iRowIndex == iRow || bStockTransfer == true) {
                    if (transEntryGlobal.disableFillDataLog == false) {
                        objWatch1 = new FStopWatch();
                        objWatch1.start();
                    }

                    EntryMainCalculation.recalculateBodyTagsForFormula(iRow);

                    iTagsFormulaRow = iRow;

                    for (iCounter = 0; iCounter < arrLayoutFields.length; iCounter++) {
                        objMetaData = arrLayoutFields[iCounter].MetaData;

                        if (objMetaData.iDataTypeId == eMasterDataType.Time) {
                        }
                        else if (objMetaData.iDataTypeId == eMasterDataType.Boolean) {
                            result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);
                            if (result.lValue == 1 && result.bRefresh == true) {

                                objLayoutData = transEntryBodyLayout.findInObject(objMetaData.iFieldId, iRow, objInput.objTrans);
                                if (objLayoutData != null) {
                                    value = objLayoutData.Tag;
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(result.data, iRow, null, arrLayoutFields[iCounter].ColumnIndex);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toBoolean(objFormulaOutput.Value);
                                }

                                EntryMainBody.updateColumnValue(iRow, arrLayoutFields[iCounter].ColumnIndex, objMetaData, value);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, iRow, objMetaData);
                                //value = value.data;
                            }
                        }
                        else if (objMetaData.sFieldName == "fDiscount") {
                        }
                        else if (objMetaData.iDataTypeId == eMasterDataType.Master || objMetaData.iDataTypeId == eMasterDataType.ExternalTable) {
                            cell = transEntryGrid.getCellObject(iRow, arrLayoutFields[iCounter].ColumnIndex);
                            if (DataType.isValidObject(cell) == false) {
                                continue;
                            }

                            value = DataType.toInt(cell.getCellData());
                            result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);
                            if (result.lValue > 0 && (DataType.stringStartsWithRaw(objMetaData.sDefaultValue, "&") == true || (EntryMain.m_bAutoLoad == true && value == 0))) {

                                objLayoutData = transEntryBodyLayout.findInObject(objMetaData.iFieldId, iRow, objInput.objTrans);
                                if (objLayoutData != null) {
                                    value = objLayoutData.Tag;
                                }
                                else {
                                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(result.data, iRow, null, arrLayoutFields[iCounter].ColumnIndex);
                                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                    value = DataType.toInt(objFormulaOutput.Value);
                                }

                                EntryMainBody.updateColumnValue(iRow, arrLayoutFields[iCounter].ColumnIndex, objMetaData, value);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, iRow, objMetaData);
                            }
                        }
                        else if (objMetaData.iFieldBehaviour == 2) {
                        }
                        else {
                        }
                    }

                    if (transEntryGlobal.disableFillDataLog == false) {
                        iDiffWatch7 += objWatch1.stop();
                    }
                }


                dExchangeRate = EntryMain.m_objTrans.BodyData[iRow - 1].ExchangeRate;

                // These vouchers have debit and credit columns
                if (iMaskedVoucherType == eVTTYPE.FRXJV || iMaskedVoucherType == eVTTYPE.JOURN || iMaskedVoucherType == eVTTYPE.OPBAL) {
                    dTempDr = 0;
                    dTempCr = 0;

                    dTempDr = transEntryFields.getDebit(iRow);
                    dTempCr = transEntryFields.getCredit(iRow);

                    dOriginalAmount0 = FNumberOperation.isGreaterThan(dTempDr, 0) ? FNumberOperation.negated(dTempDr) : dTempCr;
                    dOriginalAmount1 = transEntryGrid.getAmount0(iRow);


                    //Backend
                    dAmount0 = FNumberOperation.mul(dOriginalAmount0, dExchangeRate);
                    dAmount1 = FNumberOperation.mul(dOriginalAmount1, dExchangeRate);

                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount0, dOriginalAmount0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount1, dOriginalAmount1, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount0, dAmount0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount1, dAmount1, false, objInput.Output.objOutputTrans);
                }

                // Pmt, rct, petty cash
                if (iMaskedVoucherType == eVTTYPE.CASHP || iMaskedVoucherType == eVTTYPE.CASHR
                    || iMaskedVoucherType == eVTTYPE.PETIC || iMaskedVoucherType == eVTTYPE.MEMOP
                    || iMaskedVoucherType == eVTTYPE.MEMOR || iMaskedVoucherType == eVTTYPE.NJOURN
                    || iMaskedVoucherType == eVTTYPE.DEBNT || iMaskedVoucherType == eVTTYPE.CRDNT) {
                    dValue = EntryMain.m_objTrans.BodyData[iRow - 1].OrigAmount;

                    dOriginalAmount0 = transEntryInfo.isItNegative == true ? FNumberOperation.negated(dValue) : dValue;
                    dOriginalAmount1 = FNumberOperation.negated(dOriginalAmount0);

                    dAmount0 = FNumberOperation.mul(dOriginalAmount0, dExchangeRate);
                    dAmount1 = FNumberOperation.mul(dOriginalAmount1, dExchangeRate);

                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount0, dOriginalAmount0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.OriginalAmount1, dOriginalAmount1, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount0, dAmount0, false, objInput.Output.objOutputTrans);
                    transEntryGrid.setRowData(iRow, eRowDataName.Amount1, dAmount1, false, objInput.Output.objOutputTrans);
                }


                // REGION Sales Type Start
                if (transEntryInfo.isItSales == true || iMaskedVoucherType == eVTTYPE.WDONE) {

                    if (objInput.iRowIndex < 1 || objInput.iRowIndex == iRow || bStockTransfer == true) {
                        if (iTagsFormulaRow != iRow) {
                            EntryMainCalculation.recalculateBodyTagsForFormula(iRow);
                            iTagsFormulaRow = iRow;
                        }

                        if (transEntryGlobal.disableFillDataLog == false) {
                            objWatch1 = new FStopWatch();
                            objWatch1.start();
                        }

                        for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                            objMetaData = arrScreenFields[iCounter].MetaData;


                            // 0: Before Quantity, 1: Between Quantity & Rate, 2: Between Rate & Gross, 3: After Gross
                            if (objMetaData.iPosition != 0) {
                                continue;
                            }

                            objScreenData = transEntryScreenData.findInObject(objMetaData.iFieldId, iRow, objInput.objTrans);

                            if (transEntryGlobal.disableFillDataLog == false) {
                                objWatch2 = new FStopWatch();
                                objWatch2.start();

                                iIndex = arrScreenFieldId.indexOf(objMetaData.iFieldId);
                                if (iIndex == -1) {
                                    iIndex = arrScreenFieldId.length;

                                    arrScreenFieldIndex.push(arrScreenFields[iCounter].ColumnIndex);
                                    arrScreenFieldId.push(objMetaData.iFieldId);
                                    arrScreenFieldTime.push(0);
                                }
                            }
                            
                            transEntryScreenData.evaluateNonFormulaScreenFields(objMetaData,
                                                                                iRow,
                                                                                iCounter,
                                                                                objInput.iRowIndex,
                                                                                dExchangeRate,
                                                                                objScreenData,
                                                                                objInput.Output.objOutputTrans);

                            if (transEntryGlobal.disableFillDataLog == false) {
                                iDiffWatch = objWatch2.stop();
                                arrScreenFieldTime[iIndex] += iDiffWatch;
                            }
                        }

                        if (transEntryGlobal.disableFillDataLog == false) {
                            iDiffWatch1 += objWatch1.stop();

                            objWatch1 = new FStopWatch();
                            objWatch1.start();
                        }

                        for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                            objMetaData = arrScreenFields[iCounter].MetaData;


                            if (objMetaData.FormulaBehaviour != eTranEntryFormulaBehaviourBody.Formula) {
                                continue;
                            }

                            // 0: Before Quantity, 1: Between Quantity & Rate, 2: Between Rate & Gross, 3: After Gross
                            if (objMetaData.iPosition != 0) {
                                continue;
                            }

                            objScreenData = transEntryScreenData.findInObject(objMetaData.iFieldId, iRow, objInput.objTrans);

                            if (transEntryGlobal.disableFillDataLog == false) {
                                objWatch2 = new FStopWatch();
                                objWatch2.start();

                                iIndex = arrScreenFieldId.indexOf(objMetaData.iFieldId);
                                if (iIndex == -1) {
                                    iIndex = arrScreenFieldId.length;

                                    arrScreenFieldIndex.push(arrScreenFields[iCounter].ColumnIndex);
                                    arrScreenFieldId.push(objMetaData.iFieldId);
                                    arrScreenFieldTime.push(0);
                                }
                            }
                            
                            transEntryScreenData.evaluateFormulaScreenFields(objMetaData,
                                                                                iRow,
                                                                                iCounter,
                                                                                objInput.iRowIndex,
                                                                                dExchangeRate,
                                                                                objScreenData,
                                                                                objInput.Output.objOutputTrans);

                            if (transEntryGlobal.disableFillDataLog == false) {
                                iDiffWatch = objWatch2.stop();
                                arrScreenFieldTime[iIndex] += iDiffWatch;
                            }
                        }

                        if (transEntryGlobal.disableFillDataLog == false) {
                            iDiffWatch2 += objWatch1.stop();
                        }


                        dQuantity = 0;
                        dRate = 0;
                        dGross = 0;

                        if (objQtyInfo.ColumnIndex > -1) {
