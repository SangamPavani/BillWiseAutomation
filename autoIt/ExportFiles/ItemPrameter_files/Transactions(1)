    getValueByArea: function (field, bName, iRow, iArea) {
        let sId = "";
        let iCounter = 0;
        let value = null;
        let objMetaData = null;
        let objResult = null;
        let arrFields = undefined;
        let cell = null;
        let ele = null;
        let objInfo = null;

        try {
            objResult = {};
            objResult.lValue = 0;
            objResult.sValue = "";
            objResult.data = null;
            objResult.Area = eTranEntryFieldArea.None;
            objResult.MetaDataIndex = -1;
            objResult.ColumnIndex = -1;

            bName = DataType.toBoolean(bName);
            iRow = DataType.toInt(iRow);
            iArea = DataType.toInt(iArea);

            if (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Header) {
                if (bName == true) {
                    objInfo = transEntryFieldInfo.getFromFieldName(field, eTranEntryFieldArea.Header);
                }
                else {
                    objInfo = transEntryFieldInfo.getFromFieldId(field, eTranEntryFieldArea.Header);
                }

                if (objInfo.Area == eTranEntryFieldArea.Header) {
                    objResult.Area = objInfo.Area;
                    objResult.MetaDataIndex = objInfo.MetaDataIndex;

                    sId = EntryMainUI.getHeaderControlId(objInfo.FieldId);
                    switch (objInfo.MetaData.iDataTypeId) {
                        case eMasterDataType.Text:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = ele.value;
                            }
                            break;
                        case eMasterDataType.Number:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = DataType.toInt(ele.value);
                            }
                            break;
                        case eMasterDataType.Boolean:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = ele.checked == true ? 1 : 0;
                            }
                            break;
                        case eMasterDataType.Date:
                            objResult.data = DataType.toInt(DATEPICKER.getDate(sId));
                            break;
                        case eMasterDataType.Time:
                            objResult.data = DataType.toInt(FTIMECONTROL.getTime(sId));
                            break;
                        case eMasterDataType.Fraction:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = DataType.toDecimal(ele.value);
                            }
                            break;
                        case eMasterDataType.Picture:
                            value = FATTACHMENTCONTROL.getData(sId);
                            if (value.lValue > 0) {
                                objResult.data = value.data;
                            }
                            break;
                        case eMasterDataType.StringList:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true && ele.selectedIndex > -1) {
                                objResult.data = ele.options[ele.selectedIndex].text;
                            }
                            break;
                        case eMasterDataType.NumberList:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true && ele.selectedIndex > -1) {
                                objResult.data = ele.options[ele.selectedIndex].value;
                            }
                            break;
                        case eMasterDataType.DocumentViewer:
                            value = FATTACHMENTCONTROL.getData(sId);
                            if (value.lValue > 0) {
                                objResult.data = value.data;
                            }
                            break;
                        case eMasterDataType.Master:
                            objResult.data = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                            break;
                        case eMasterDataType.BigNumber:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                if (DataType.isNullOrEmpty(ele.value) == true) {
                                    objResult.data = 0;
                                }
                                else {
                                    objResult.data = ele.value;
                                }
                            }
                            break;
                        case eMasterDataType.ExternalTable:
                            objResult.data = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                            break;
                        case eMasterDataType.SmallNumber:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = DataType.toInt(ele.value);
                            }
                            break;
                        case eMasterDataType.TinyNumber:
                            ele = document.getElementById(sId);
                            if (DataType.isValidObject(ele) == true) {
                                objResult.data = DataType.toInt(ele.value);
                            }
                            break;
                        case eMasterDataType.HyperLink:
                            objResult.data = FHyperLink.getValue(sId);
                            break;
                    }

                    objResult.lValue = 1;
                }

                if (objResult.Area != eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Header) {
                    return (objResult);
                }
            }

            if (iArea == eTranEntryFieldArea.Body) {
                iRow = Math.abs(iRow);
            }

            if (iRow == 0) {
                iRow = 1;
            }

            if (iRow >= 0 && (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Body)) {
                if (transEntryInfo.BodySectionNotRequired == true) {
                }
                else {
                    objInfo = EntryMainUI.getBodyFieldInfo(field, bName);
                    if (objInfo.Area == eTranEntryFieldArea.Body) {
                        objResult.Area = eTranEntryFieldArea.Body;
                        objResult.MetaDataIndex = objInfo.MetaDataIndex;
                        objResult.ColumnIndex = objInfo.ColumnIndex;

                        cell = transEntryGrid.getCellObject(iRow, objResult.ColumnIndex);
                        if (DataType.isValidObject(cell) == true) {
                            objMetaData = objInfo.MetaData;
                            switch (objMetaData.iDataTypeId) {
                                case eMasterDataType.Text:
                                    if (objMetaData.iFieldId == eVTFIELDID.FDF_LINK) {
                                        objResult.data = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRow);
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                                        objResult.data = transEntryBatch.getBatchNo(iRow);
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_RMANO) {
                                        objResult.data = transEntryRMA.getValue(iRow);
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS) {
                                        objResult.data = transEntryFields.getBins(iRow);
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS2) {
                                        objResult.data = transEntryFields.getBins2(iRow);
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                                        objResult.data = cell.getCellData();
                                    }
                                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_DEPTAPPROP) {
                                        objResult.data = cell.getCellData();
                                    }
                                    else {
                                        objResult.data = cell.getCellText();
                                    }
                                    break;
                                case eMasterDataType.Number:
                                case eMasterDataType.SmallNumber:
                                case eMasterDataType.TinyNumber:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.BigNumber:
                                    if (DataType.isNullOrEmpty(cell.getCellData()) == true) {
                                        objResult.data = 0;
                                    }
                                    else {
                                        objResult.data = cell.getCellData();
                                    }
                                    break;
                                case eMasterDataType.Fraction:
                                    objResult.data = DataType.toDecimal(cell.getCellData());
                                case eMasterDataType.Date:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.Time:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.StringList:
                                    objResult.data = cell.getCellText();
                                    break;
                                case eMasterDataType.NumberList:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.Picture:
                                case eMasterDataType.DocumentViewer:
                                    objResult.data = {};
                                    objResult.data.iFieldId = objMetaData.iFieldId;
                                    objResult.data.sFileName = cell.getCellText();
                                    objResult.data.sData = cell.getCellData();
                                    break;
                                case eMasterDataType.Master:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.ExternalTable:
                                    objResult.data = DataType.toInt(cell.getCellData());
                                    break;
                                case eMasterDataType.Boolean:
                                    if (cell.hasControl() == true) {
                                        objResult.data = cell.getControl().checked == true ? 1 : 0;
                                    }
                                    break;
                            }

                            objResult.lValue = 1;
                        }
                    }
                }

                if (objResult.Area != eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Body) {
                    return (objResult);
                }
            }

            if (iArea == eTranEntryFieldArea.None || iArea == eTranEntryFieldArea.Footer) {
                arrFields = transEntryFieldInfo.getFooterFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter];
                    if (bName == true) {
                        if (objMetaData.sFieldName != field) {
                            continue;
                        }
                    }
                    else {
                        if (objMetaData.iFieldId != field) {
                            continue;
                        }
                    }

                    objResult.Area = eTranEntryFieldArea.Footer;
                    objResult.MetaDataIndex = iCounter;

                    sId = EntryMainUI.getFooterControlId(objMetaData.iFieldId, false);
                    if (objMetaData.iDataTypeId == eMasterDataType.Fraction) {
                        ele = document.getElementById(sId);
                        if (DataType.isValidObject(ele) == true) {
                            objResult.data = DataType.toDecimal(DataType.getNumber(ele.value));
                        }
