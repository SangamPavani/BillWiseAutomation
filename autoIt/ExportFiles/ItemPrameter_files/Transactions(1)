    AdjustInFIFO: function (obj) {
        try {
            var _ObjAdj = g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails;
            if (_ObjAdj.m_lstPendingBills.length == 0)
                return;

            var EntryColNo = 0;
            EntryColNo = billWiseInfo.EntryColNo;
            var TotalRows = billWiseInfo.TotalRows;
            if (_ObjAdj.bMaintainInInvoiceCurrency) {
                AdjustBills_Screen.Footer.SetAmtTobeAdjust(AdjustBills_Screen.UI.GetAmountToAdjustInTransCurrency());
            }
            else {
                AdjustBills_Screen.Footer.SetAmtTobeAdjust(AdjustBills_Screen.UI.GetAmountToAdjustInBaseCurrency());
            }
            let objPageInfo = null;
            if (AdjustBills_Screen.m_BillWise.arrPageInfo.length < 1) {
                return;
            }
            iPageNo = AdjustBills_Screen.getCurrentPage();


            if (iPageNo < 1) {
                iPageNo = 1;
            }

            if (iPageNo > AdjustBills_Screen.m_BillWise.arrPageInfo.length) {
                return;
            }
            objPageInfo = AdjustBills_Screen.m_BillWise.arrPageInfo[iPageNo - 1];
            var x = document.getElementById("cbmSearchOnField").selectedIndex;
            var Index = document.getElementById("cbmSearchOnField").options[x].value;
            if (Index == 14) {
                if (DataType.toInt(OPTIONCONTROL.getControlValue("optFATag")) > 0) {
                    objPageInfo = DataType.createDuplicateObject(objPageInfo);
                    objPageInfo.EndIndex = billWiseInfo.FilterRows - 1;
                }
            }
            else {
                if (FConvert.toString(document.getElementById("Searchtxt").value).trim() != "") {
                    objPageInfo = DataType.createDuplicateObject(objPageInfo);
                    objPageInfo.EndIndex = billWiseInfo.FilterRows - 1;
                }
            }
            for (i = 1; i <= (objPageInfo.EndIndex - objPageInfo.StartIndex) + 1; i++) {
                var cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, AdjCol.get("OriginalAmount"));
                var cellAdj = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, EntryColNo);
                var cellSelect = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, 1);
                var cellNative = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, AdjCol.get("mNativeCurrency"));
                cellAdj.setCellText(DataType.toDecimal(0));
                cellAdj.setCellData(DataType.toDecimal(0));
                cellNative.setCellText(DataType.toDecimal(0));
                cellNative.setCellData(DataType.toDecimal(0));
                cellSelect.setCheckboxState(false);
            }
            for (i = 1; i <= TotalRows; i++) {

                if (_ObjAdj.AdvanceOrAgainstRefAdj == false) {
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDBaseCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDInvoiceCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAIDLocalCurrency = 0;
                }
                else {
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDBaseCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDInvoiceCurrency = 0;
                    _ObjAdj.m_lstPendingBills[i - 1].mAAdIDLocalCurrency = 0;
                }
                _ObjAdj.m_lstPendingBills[i - 1].mNativeCurrency = 0;
                _ObjAdj.m_lstPendingBills[i - 1].dDiscountAmount = 0;
                _ObjAdj.m_lstPendingBills[i - 1].dDiscountAmountTC = 0;
                _ObjAdj.m_lstPendingBills[i - 1].mLocalExchangeDiff = 0;
                _ObjAdj.m_lstPendingBills[i - 1].mExchangeDifference = 0;

                AdjustBills_Screen.IP.SetIPExchangeGainOrLoss(0);

                AdjustBills_Screen.AssignAdjustmentValues();
            }
            let l_Index = 0;
            if (Index == 14) {
                if (DataType.toInt(OPTIONCONTROL.getControlValue("optFATag")) > 0) {
                    TotalRows = billWiseInfo.FilterRows;
                }
            }
            else {
                if (FConvert.toString(document.getElementById("Searchtxt").value).trim() != "")
                    TotalRows = billWiseInfo.FilterRows;
            }
