    cellLeaveNewDocGrid: function (cellobj, evt) {
        let iCurrDocFieldId = 0;
        let iNewDocFieldId = 0;
        let iDataTypeId = 0;
        let data = 0;
        let ele = null;
        let cell = null;

        try {
            switch (cellobj.iColumn) {
                case 1: // Field
                    ele = document.getElementById("triggers_docTableFieldDropDown");
                    if (FCommon.UI.isValidObject(ele) == false) {
                        break;
                    }

                    if (ele.selectedOptions[0] != undefined) {
                        cellobj.setCellText(ele.selectedOptions[0].text, ele.selectedOptions[0].value);
                    }
                    break;
                case 2: // Map Field
                    ele = DocCustomization.Triggers.getMapDropDownElement();
                    if (FCommon.UI.isValidObject(ele) == false) {
                        break;
                    }

                    if (ele.selectedOptions[0] != undefined) {
                        cellobj.setCellText(ele.selectedOptions[0].text, ele.selectedOptions[0].value);
                        cellobj.setCellData("type", ele.selectedOptions[0].getAttribute('data-type'));
                        cellobj.setCellData("mastertype", ele.selectedOptions[0].getAttribute('data-mastertype'));
                    }
                    break;
                case 3: // Formula
                    if (DocCustomization.Triggers.getCurrentDocFieldId(cellobj.iRow) != 0) {
                        break;
                    }

                    if (DocCustomization.Triggers.getNewDocFieldId(cellobj.iRow) == 0) {
                        break;
                    }

                    ele = document.getElementById("triggers_docTableFormulaTxtbox");
                    if (FCommon.UI.isValidObject(ele) == true) {
                        cellobj.setCellText(ele.value);
                    }
                    break;
                case 4: // Value
                    if (DocCustomization.Triggers.getCurrentDocFieldId(cellobj.iRow) != 0) {
                        cellobj.clear();
                        break;
                    }

                    if (DocCustomization.Triggers.getNewDocFieldId(cellobj.iRow) == 0) {
                        cellobj.clear();
                        break;
                    }

                    if (DocCustomization.Triggers.getNewDocFormulaValue(cellobj.iRow) != "") {
                        cellobj.clear();
                        break;
                    }

                    cell = FGRIDCONTROL.getCellObject(DocCustomization.Triggers.getNewDocGridId(), cellobj.iRow, 2);
                    if (FCommon.UI.isValidObject(cell) == true) {
                        iDataTypeId = FConvert.toInt(cell.getCellData("data-type"));
                    }

                    switch (iDataTypeId) {
                        case eMasterDataType.Master:
                            data = FConvert.toInt(OPTIONCONTROL.getControlValue(DocCustomization.Triggers.getNewDocTableOptionCtrl()));
                            if (data == 0) {
                                cellobj.clear();
                            }
                            else {
                                cellobj.setCellText(OPTIONCONTROL.getControlText(DocCustomization.Triggers.getNewDocTableOptionCtrl()), data);
                            }
                            break;
                        case eMasterDataType.Date:
                            data = DATEPICKER.getDate(DocCustomization.Triggers.getNewDocTableDateCtrl());
                            if (data == 0) {
                                cellobj.clear();
                            }
                            else {
                                cellobj.setCellText(DATEPICKER.getText(DocCustomization.Triggers.getNewDocTableDateCtrl()), data);
                            }
                            break;
                        default:
                            ele = document.getElementById(DocCustomization.Triggers.getNewDocTableTextCtrl());
                            cellobj.setCellText(ele.value, ele.value);
                            break;
                    }
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Triggers.cellLeaveNewDocGrid} " + err.message, "Exception");
        }
    },

    cellEnterNewDocGrid: function (cellobj, evt) {
        let iCurrDocFieldId = 0;
        let iNewDocFieldId = 0;
        let iDataTypeId = 0;
        let iMasterTypeId = 0;
        let ele = null;

        try {
            iCurrDocFieldId = DocCustomization.Triggers.getCurrentDocFieldId(cellobj.iRow);
            iNewDocFieldId = DocCustomization.Triggers.getNewDocFieldId(cellobj.iRow);

            switch (cellobj.iColumn) {
                case 1: // Field
                    ele = document.getElementById("triggers_docTableFieldDropDown");
                    if (FCommon.UI.isValidObject(ele) == true) {
                        cellobj.setControl(ele, cellobj.getCellText());
                        ele.value = cellobj.getCellData();
                    }
                    else {
                        cellobj.processDefault(evt);
                    }
                    break;
                case 2: // Map Field
                    ele = DocCustomization.Triggers.getMapDropDownElement();
                    if (FCommon.UI.isValidObject(ele)) {
                        cellobj.setControl(ele, cellobj.getCellText());
                        ele.value = cellobj.getCellData();
                    }
                    break;
                case 3: // Formula
                    ele = document.getElementById("triggers_docTableFormulaTxtbox");
                    if (FCommon.UI.isValidObject(ele) && iCurrDocFieldId == 0 && iNewDocFieldId != 0) {
                        cellobj.setControl(ele, cellobj.getCellText());
                    }
                    else {
                        cellobj.processDefault(ele);
                    }
                    break;
                case 4: // Value
                    if (iCurrDocFieldId != 0 || iNewDocFieldId == 0) {
                        cellobj.processDefault(evt);
                        break;
                    }

                    cell = FGRIDCONTROL.getCellObject(DocCustomization.Triggers.getNewDocGridId(), cellobj.iRow, 2);
                    if (FCommon.UI.isValidObject(cell) == false) {
                        cellobj.processDefault(evt);
                        break;
                    }

                    iDataTypeId = FConvert.toInt(cell.getCellData("data-type"));
                    iMasterTypeId = FConvert.toInt(cell.getCellData("data-mastertype"));
                    switch(iDataTypeId)
                    {
                        case eMasterDataType.Master:
                            OPTIONCONTROL.setMasterTypeId(DocCustomization.Triggers.getNewDocTableOptionCtrl(), iMasterTypeId);
                            cellobj.setControl(DocCustomization.Triggers.getNewDocTableOptionCtrl(), cellobj.getCellData());
                            break;
                        case eMasterDataType.Date:
                            cellobj.setControl(DocCustomization.Triggers.getNewDocTableDateCtrl(), cellobj.getCellData());
                            break;
                        default:
                            cellobj.setControl(DocCustomization.Triggers.getNewDocTableTextCtrl(), cellobj.getCellData());
                            break;
                    }

                    break;
                default:
                    cellobj.processDefault(evt);
                    break;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocCustomization.Triggers.cellEnterNewDocGrid} " + err.message, "Exception");
        }
    },
