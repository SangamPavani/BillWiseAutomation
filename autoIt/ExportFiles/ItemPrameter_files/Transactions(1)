                    }
                    else if (DataType.stringIncludes(sTempRes, "$") || DataType.stringIncludes(sTempRes, "!$")
                            || DataType.stringIncludes(sTempRes, "!-") || DataType.stringIncludes(sTempRes, "-)")
                            || DataType.stringIncludes(sTempRes, "^") || DataType.stringIncludes(sTempRes, "!^")
                            || DataType.stringIncludes(sTempRes, "`") || DataType.stringIncludes(sTempRes, "!`")) {
                        // added by manish
                        sTemp += sTempRes;
                    }
                    else//is a unary eqn
                    {
                        sTempRes = this.UnaryResult(FormulaHelper.NormString(sTempRes)).toString();//unary result
                        if (sTempRes == "" || sTempRes == "NaN") {
                            return ("NaN");
