                    if (bTransData == true) {
                        sId = EntryMainUI.getBodyControlId(objVATMetaData.iFieldId);
                        objTransactionData.Body[iRowIndex][sId] = 0;
                    }
                    else {
                        cell = EntryMainUI.getElement(transEntryFieldInfo.VATLayout, iRowIndex).Value;
                        if (DataType.isValidObject(cell) == false) {
                            return;
                        }

                        cell.clear();
                        EntryMainMemoryObject.update(objVATMetaData.iFieldId, undefined, cell.iRow, objVATMetaData);
                    }
                }

                iBillIndex = -1;
                iTotalNewRows = 0;

                if (transEntryFieldInfo.Debit.FieldId > 0) {
                    bDr = transEntryFields.getDebit(iRowIndex + (bTransData == true ? 1 : 0)) != 0;
                }

                cell = EntryMainUI.getElement(transEntryFieldInfo.TaxCode, iRowIndex + (bTransData == true ? 1 : 0)).Value;
                if (DataType.isValidObject(cell) == false) {
                    return (iRowIndex);
                }

                // 2 (Zero Rate)
                // 3 (Exempted)
                // 7 (NA)
                // 16 (Out of scope - Sales)
                // 20 (Zero rated purchases)
                // 21 (Exempted purchases)
                iTaxCode = DataType.toInt(cell.getCellData());
                if (iTaxCode != 2 && iTaxCode != 3 && iTaxCode != 7 && iTaxCode != 16 && iTaxCode != 20 && iTaxCode != 21) {
                    dExchange = EntryMainMemoryObject.getExchangeRate(iRowIndex + (bTransData == true ? 1 : 0));

                    if (AdjustBills_Screen.IsMaintainInInvCurrency() == true) {
                        dExchange = 1;
                    }

                    if (arrAdjustedBills[0].iRefType < 2 && arrAdjustedBills[0].mNativeCurrency != 0) {
                        // 1 (Std Rate)
                        // 18 (Standard Rated Purchase - Recoverable)
                        // 19 (Standard Rated Purchase - Non-Recoverable)
                        // 24 (Std rate 5 %)
                        // 25 (SR-REC5)
                        // 26 (Import 5 %)
                        // 27 (RCM 5)
                        // 30 (SR-ADJ)
                        // 31 (SR-RADJ)
                        if ((iTaxCode == 1 || iTaxCode == 30 || iTaxCode == 18 || iTaxCode == 31 || iTaxCode == 19 || iTaxCode == 24 || iTaxCode == 25 || iTaxCode == 26 || iTaxCode == 27) && DataType.isValidObject(objVATMetaData) == true) {
                            dValue = transEntryVat.calculateVATAmount(arrAdjustedBills[0].mNativeCurrency, dExchange, objVATMetaData.iNoDecimal, iTaxCode, iRowIndex + (bTransData == true ? 1 : 0));

                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(objVATMetaData.iFieldId);
                                objTransactionData.Body[iRowIndex][sId] = dValue;
                            }
                            else {
                                transEntryFields.setVATLayout(dValue, iRowIndex);
                            }
                        }

                        if (transEntryFieldInfo.Amount.ColumnIndex > -1) {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYAMOUNT);
                                dOldAmount = objTransactionData.Body[iRowIndex][sId];
                                objTransactionData.Body[iRowIndex][sId] = arrAdjustedBills[0].mNativeCurrency / dExchange;
                            }
                            else {
                                transEntryFields.setAmount((arrAdjustedBills[0].mNativeCurrency / dExchange), iRowIndex);
                            }
                        }
                        else {
                            if (bDr == true) {
                                if (bTransData == true) {
                                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNDEBIT);
                                    objTransactionData.Body[iRowIndex][sId] = arrAdjustedBills[0].mNativeCurrency / dExchange;
                                }
                                else {
                                    transEntryFields.setDebit((arrAdjustedBills[0].mNativeCurrency / dExchange), iRowIndex);
                                }
                            }
                            else {
                                if (bTransData == true) {
                                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNCREDIT);
                                    objTransactionData.Body[iRowIndex][sId] = arrAdjustedBills[0].mNativeCurrency / dExchange;
                                }
                                else {
                                    transEntryFields.setCredit((arrAdjustedBills[0].mNativeCurrency / dExchange), iRowIndex);
                                }
                            }
                        }

                        iBillIndex = 0;
                        dAdjAmt = arrAdjustedBills[0].mNativeCurrency / dExchange;
                    }

                    if (iLength > 1 && arrAdjustedBills[1].iRefType < 2) {
                        if (dAdjAmt != 0) {
                            if (bTransData == true) {
                                objTranBody = DataType.createDuplicateObject(objTransactionData.Body[iRowIndex]);
                                objTranBody[eTranEntryBodyDataConstKey.BodyId] = 0;
                                objTranBody[eTranEntryBodyDataConstKey.TransactionId] = 0;
                                objTranBody[eTranEntryBodyDataConstKey.BillwiseData] = "";
                                objTransactionData.Body.splice(iRowIndex, 0, objTranBody);
                            }
                            else {
                                EntryMainBody.onDuplicateRow(iRowIndex, [eVTFIELDID.FDF_LINK, eVTFIELDID.FDF_REFERENCE]);

                                transEntryGrid.setRowData(iRowIndex + 1, eRowDataName.BodyId, 0);
                                transEntryGrid.setRowData(iRowIndex + 1, eRowDataName.TransactionId, 0);
                                transEntryGrid.setRowData(iRowIndex + 1, eRowDataName.BillwiseData, "");
                            }

                            iTotalNewRows++;
                        }

                        cell = EntryMainUI.getElement(transEntryFieldInfo.TaxCode, iRowIndex + (bTransData == true ? 1 : 0)).Value;
                        if (DataType.isValidObject(cell) == false) {
                            return (iRowIndex + iTotalNewRows);
                        }

                        iTempRow = iRowIndex;
                        if (dAdjAmt != 0) {
                            iTempRow += 1;
                        }

                        iTaxCode = DataType.toInt(cell.getCellData());
                        // 1 (Std Rate)
                        // 24 (Std rate 5%)
                        // 30 (SR-ADJ)
                        if ((iTaxCode == 1 || iTaxCode == 30 || iTaxCode == 24) && DataType.isValidObject(objVATMetaData) == true) { // 1 means Std Rate
                            dValue = transEntryVat.calculateVATAmount(arrAdjustedBills[1].mNativeCurrency, dExchange, objVATMetaData.iNoDecimal, iTaxCode, iRowIndex + (bTransData == true ? 1 : 0));

                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(objVATMetaData.iFieldId);
                                objTransactionData.Body[iTempRow][sId] = dValue;
                            }
                            else {
                                transEntryFields.setVATLayout(dValue, iTempRow);
                            }
                        }


                        iTempRow = iRowIndex;
                        if (dAdjAmt != 0) {
                            iTempRow += 1;
                        }

                        if (transEntryFieldInfo.Amount.ColumnIndex > -1) {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYAMOUNT);
                                objTransactionData.Body[iTempRow][sId] = arrAdjustedBills[1].mNativeCurrency / dExchange;
                            }
                            else {
                                transEntryFields.setAmount((arrAdjustedBills[1].mNativeCurrency / dExchange), iTempRow);
                            }
                        }
                        else if (bDr == true) {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNDEBIT);
                                objTransactionData.Body[iTempRow][sId] = arrAdjustedBills[1].mNativeCurrency / dExchange;
                            }
                            else {
                                transEntryFields.setDebit((arrAdjustedBills[1].mNativeCurrency / dExchange), iTempRow);
                            }
                        }
                        else {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNCREDIT);
                                objTransactionData.Body[iTempRow][sId] = arrAdjustedBills[1].mNativeCurrency / dExchange;
                            }
                            else {
                                transEntryFields.setCredit((arrAdjustedBills[1].mNativeCurrency / dExchange), iTempRow);
                            }
                        }

                        iBillIndex = 1;
                        if (dAdjAmt == 0) {
                            dAdjAmt = arrAdjustedBills[1].mNativeCurrency / dExchange;
                        }

                        bSplit = true;

                        if (bTransData == true) {
                            if (objTransactionData.Body.length > (iRowIndex + 1)) {
                                objTransactionData.Body[iRowIndex][eTranEntryBodyDataConstKey.BillwiseData] = DataType.toString([arrAdjustedBills[0]]);
                                objTransactionData.Body[iRowIndex + 1][eTranEntryBodyDataConstKey.BillwiseData] = DataType.toString([arrAdjustedBills[1]]);
                            }
                            else {
                                objTransactionData.Body[iRowIndex][eTranEntryBodyDataConstKey.BillwiseData] = DataType.toString([arrAdjustedBills[1]]);
                            }
                        }
                        else {
                            if (transEntryGrid.getTotalValidRows() > (iRowIndex + 1)) {
                                transEntryFields.setBillwise([arrAdjustedBills[0]], iRowIndex);
                                EntryMainMemoryObject.updateBillwiseData([arrAdjustedBills[0]], iRowIndex);

                                sText = transEntryReference.createString([arrAdjustedBills[0]]);
                                transEntryFields.setBillwise(sText, iRowIndex, true);

                                transEntryFields.setBillwise([arrAdjustedBills[1]], iRowIndex + 1);
                                EntryMainMemoryObject.updateBillwiseData([arrAdjustedBills[1]], iRowIndex + 1);

                                sText = transEntryReference.createString([arrAdjustedBills[1]]);
                                transEntryFields.setBillwise(sText, iRowIndex + 1, true);
                            }
                            else {
                                transEntryFields.setBillwise([arrAdjustedBills[1]], iRowIndex);
                                EntryMainMemoryObject.updateBillwiseData([arrAdjustedBills[1]], iRowIndex);

                                sText = transEntryReference.createString([arrAdjustedBills[1]]);
                                transEntryFields.setBillwise(sText, iRowIndex, true);
                            }
                        }
                    }

                    if (dAdjAmt != 0 && iBillIndex >= 0 && iLength > (iBillIndex + 1)) {
                        bSplit = true;
                        lstBills = [];
                        dAmt = 0;

                        for (iRow = iBillIndex + 1; iRow < iLength; iRow++) {
                            lstBills.push(arrAdjustedBills[iRow]);
                            dAmt += arrAdjustedBills[iRow].mNativeCurrency / dExchange;
                        }

                        if (bTransData == true) {
                            objTranBody = DataType.createDuplicateObject(objTransactionData.Body[iRowIndex + iBillIndex]);
                            objTranBody[eTranEntryBodyDataConstKey.BodyId] = 0;
                            objTranBody[eTranEntryBodyDataConstKey.TransactionId] = 0;
                            objTranBody[eTranEntryBodyDataConstKey.BillwiseData] = "";
                            objTransactionData.Body.splice(iRowIndex + iBillIndex, 0, objTranBody);
                        }
                        else {
                            EntryMainBody.onDuplicateRow(iRowIndex + iBillIndex, [eVTFIELDID.FDF_LINK, eVTFIELDID.FDF_REFERENCE]);

                            transEntryGrid.setRowData(iRowIndex + iBillIndex, eRowDataName.BodyId, 0);
                            transEntryGrid.setRowData(iRowIndex + iBillIndex, eRowDataName.TransactionId, 0);
                            transEntryGrid.setRowData(iRowIndex + iBillIndex, eRowDataName.BillwiseData, "");
                        }

                        iTotalNewRows++;

                        if (transEntryFieldInfo.ExchangeRateDiff.Area == eTranEntryFieldArea.Body
                            && transEntryFieldInfo.ExchangeRateDiff.ColumnIndex > -1) {

                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(transEntryFieldInfo.ExchangeRateDiff.FieldId);
                                objTransactionData.Body[iRowIndex][sId] = 0;
                                if (iBillIndex == 1) {
                                    objTransactionData.Body[iRowIndex + 1][sId] = 0;
                                }
                            }
                            else {
                                cell = transEntryGrid.getCellObject(iRowIndex, transEntryFieldInfo.ExchangeRateDiff.ColumnIndex);
                                cell.clear();
                                EntryMainMemoryObject.update(transEntryFieldInfo.ExchangeRateDiff.FieldId,
                                                                undefined,
                                                                cell.iRow,
                                                                transEntryFieldInfo.ExchangeRateDiff.MetaData);

                                if (iBillIndex == 1) {
                                    cell = transEntryGrid.getCellObject(iRowIndex + 1, transEntryFieldInfo.ExchangeRateDiff.ColumnIndex);
                                    cell.clear();
                                    EntryMainMemoryObject.update(transEntryFieldInfo.ExchangeRateDiff.FieldId,
                                                                    undefined,
                                                                    cell.iRow,
                                                                    transEntryFieldInfo.ExchangeRateDiff.MetaData);
                                }
                            }

                            objLocalExchangeRateDiffInfo = transEntryFieldInfo.LocalExchangeRateDiff;
                            if (objLocalExchangeRateDiffInfo.Area == eTranEntryFieldArea.Body
                                && objLocalExchangeRateDiffInfo.ColumnIndex > -1) {

                                if (bTransData == true) {
                                    sId = EntryMainUI.getBodyControlId(objLocalExchangeRateDiffInfo.FieldId);
                                    objTransactionData.Body[iRowIndex][sId] = 0;
                                    if (iBillIndex == 1) {
                                        objTransactionData.Body[iRowIndex + 1][sId] = 0;
                                    }
                                }
                                else {
                                    cell = transEntryGrid.getCellObject(iRowIndex, objLocalExchangeRateDiffInfo.ColumnIndex);
                                    cell.clear();

                                    EntryMainMemoryObject.update(objLocalExchangeRateDiffInfo.FieldId,
                                                                    undefined,
                                                                    cell.iRow,
                                                                    objLocalExchangeRateDiffInfo.MetaData);

                                    if (iBillIndex == 1) {
                                        cell = transEntryGrid.getCellObject(iRowIndex + 1, objLocalExchangeRateDiffInfo.ColumnIndex);
                                        cell.clear();

                                        EntryMainMemoryObject.update(objLocalExchangeRateDiffInfo.FieldId,
                                                                        undefined,
                                                                        cell.iRow,
                                                                        objLocalExchangeRateDiffInfo.MetaData);
                                    }
                                }
                            }
                        }

                        if (transEntryFieldInfo.VATLayout.ColumnIndex >= 0) {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(objVATMetaData.iFieldId);
                                objTransactionData.Body[iRowIndex + iBillIndex + 1][sId] = 0;
                            }
                            else {
                                cell = EntryMainUI.getElement(transEntryFieldInfo.VATLayout, iRowIndex + iBillIndex + 1).Value;
                                if (DataType.isValidObject(cell) == true) {
                                    cell.clear();
                                    EntryMainMemoryObject.update(objVATMetaData.iFieldId, undefined, cell.iRow, objVATMetaData);
                                }
                            }
                        }

                        if (transEntryFieldInfo.Amount.ColumnIndex > -1) {
                            if (bTransData == true) {
                                sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYAMOUNT);
                                objTransactionData.Body[iRowIndex + iBillIndex + 1][sId] = dAmt;
                            }
                            else {
                                transEntryFields.setAmount(dAmt, iRowIndex + iBillIndex + 1);
                            }
                        }
                        else {
                            if (bDr == true) {
                                if (bTransData == true) {
                                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNDEBIT);
                                    objTransactionData.Body[iRowIndex + iBillIndex + 1][sId] = dAmt;
                                }
                                else {
                                    transEntryFields.setDebit(dAmt, iRowIndex + iBillIndex + 1);
                                }
                            }
                            else {
                                if (bTransData == true) {
                                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNCREDIT);
                                    objTransactionData.Body[iRowIndex + iBillIndex + 1][sId] = dAmt;
                                }
                                else {
                                    transEntryFields.setCredit(dAmt, iRowIndex + iBillIndex + 1);
                                }
                            }
                        }

                        if (iBillIndex == 0) {
                            if (bTransData == true) {
                                objTransactionData.Body[iRowIndex][eTranEntryBodyDataConstKey.BillwiseData] = DataType.toString([arrAdjustedBills[0]]);
                            }
                            else {
                                transEntryFields.setBillwise([arrAdjustedBills[0]], iRowIndex);
                                EntryMainMemoryObject.updateBillwiseData([arrAdjustedBills[0]], iRowIndex);

                                sText = transEntryReference.createString([arrAdjustedBills[0]]);
                                transEntryFields.setBillwise(sText, iRowIndex, true);
                            }
                        }

                        if (bTransData == true) {
                            objTransactionData.Body[iRowIndex + iBillIndex + 1][eTranEntryBodyDataConstKey.BillwiseData] = DataType.toString(lstBills);
                        }
                        else {
                            transEntryFields.setBillwise(lstBills, iRowIndex + iBillIndex + 1);
                            EntryMainMemoryObject.updateBillwiseData(lstBills, iRowIndex + iBillIndex + 1);

                            sText = transEntryReference.createString(lstBills);
                            transEntryFields.setBillwise(sText, iRowIndex + iBillIndex + 1, true);
                        }
                    }
                }
            }

            iAdjustBillCount = DataType.toInt(iAdjustBillCount);
            if (bSplit == false && transEntryFieldInfo.Amount.ColumnIndex > -1) {
                if (bTransData == true) {
                    transEntryGrid.setCellText(iRowIndex + 1, transEntryFieldInfo.Amount.ColumnIndex, dOldAmount, dOldAmount);

                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYAMOUNT);
                    objTransactionData.Body[iRowIndex][sId] = dOldAmount;
                }
                else if (iAdjustBillCount == 1) {
                    transEntryFields.setAmount(dOldAmount, iRowIndex);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.updateFromBillwiseData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    calculateVATAmount: function (dValue, dExchange, iNoDecimal, iTaxCode, iRow, dPercent) {
        try {
            if (transEntryVat.isVatApplicable(iRow) == true) {
                if (DataType.isValidObject(dPercent) == false) {
                    // 24 (Std rate 5%)
                    // 25 (SR-REC5)
                    // 26 (Import 5%)
                    // 27 (RCM 5)
                    if (iTaxCode >= 24 && iTaxCode <= 27) {
                        dPercent = 5;
                    }
                    else {
                        dPercent = transEntryGlobal.m_dVATPercent;
                    }
                }

                dValue = ((dValue / dExchange * dPercent) / (100 + dPercent));
                dValue = DataType.toDecimal(dValue, iNoDecimal, true);
            }
            else {
                dValue = 0;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.calculateVATAmount} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (dValue);
    },

    calculateAndUpdateVATLayoutColumn: function (iRow, dCurrentValue) {
        let dValue = 0;
        let iTaxCode = 0;
        let iCodeType = 0;
        let iBookType = 0;
        let dPercent = 0;
        let bCalc = false;
        let cell = undefined;
        let objVATMetaData = undefined;

        try {
            if (transEntryGlobal.debugVAT == true) {
                debugger
            }

            if (transEntryInfo.Settings.Misc.PostVAT == false
                || EntryMain.isDataLoading() == true) {
                return (false);
            }

            cell = EntryMainUI.getElement(transEntryFieldInfo.TaxCode, iRow).Value;
            if (DataType.isValidObject(cell) == false) {
                return (false);
            }

            objVATMetaData = transEntryFieldInfo.VATLayout.MetaData;

            bCalc = true;
            iCodeType = eAccountTypes.None;
            iBookType = eAccountTypes.None;

            if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Body) {
                iCodeType = EntryMainMemoryObject.getCodeTypeId(iRow);
            }

            if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Body) {
                iBookType = EntryMainMemoryObject.getBookTypeId(iRow);
            }

            if (iCodeType != eAccountTypes.None) {
                if (EntryMainCommon.isPartyType(iCodeType) == true) {
                    bCalc = false;
                }
            }

            if (iBookType != eAccountTypes.None) {
                if (EntryMainCommon.isPartyType(iBookType) == true) {
                    bCalc = false;
                }
            }

            iTaxCode = DataType.toInt(cell.getCellData());
            if (bCalc == true) { // 1 means Std Rate
                dPercent = 0;
                if (transEntryVat.isVatApplicable(iRow) == true) {
                    switch (iTaxCode) {
                        case 24: // Std rate 5%
                        case 25: // SR-REC5
                        case 26: // Import 5%
                        case 27: // RCM 5
                            dPercent = 5;
                            break;
                        case 1: // Std Rate
                        case 8: // Reverse charge
                        case 18: // Standard Rated Purchase - Recoverable
                        case 19: // Standard Rated Purchase - Non-Recoverable
                        case 30: // SR-ADJ
                        case 31: // SR-RADJ
                        default:
                            dPercent = transEntryGlobal.m_dVATPercent;
                            break;
                    }
                }

                // 1 SR
                // 18 SR-REC
                // 19 SR-NON
                // 24 (Std rate 5%)
                // 25 (SR-REC5)
                // 26 (Import 5%)
                // 27 (RCM 5)
                // 30 (SR-ADJ)
                // 31 (SR-RADJ)
                if (iTaxCode == 1 || iTaxCode == 18 || iTaxCode == 19 || iTaxCode == 24 || iTaxCode == 25 || iTaxCode == 26 || iTaxCode == 27 || iTaxCode == 30 || iTaxCode == 31) {
                    dValue = transEntryVat.calculateVATAmount(dCurrentValue, 1, objVATMetaData.iNoDecimal, iTaxCode, iRow, dPercent);

                    cell = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.VATLayout.ColumnIndex);
                    if (DataType.isValidObject(cell) == false) {
                        return (false);
                    }
                    cell.setCellText(dValue, dValue);
                }
                else if (iTaxCode == 8) { // Reverse charge
                    dValue = DataType.mul(dCurrentValue, dPercent);
                    dValue = DataType.div(dValue, 100);
                    dValue = DataType.toDecimal(dValue, objVATMetaData.iNoDecimal, true);

                    cell = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.VATLayout.ColumnIndex);
                    if (DataType.isValidObject(cell) == false) {
                        return (false);
                    }

                    cell.setCellText(dValue, dValue);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.calculateAndUpdateVATLayoutColumn} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    calculateAndUpdateVATForAmountColumn: function (iFieldId, cellobj, dLastValue) {
        let dCurrentValue = 0;
        let objControl = undefined;

        try {
            if (transEntryGlobal.debugVAT == true) {
                debugger
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                case eVTFIELDID.FDF_BODYAMOUNT:
                    break;
                default:
                    return (false);
            }

            dCurrentValue = DataType.toDecimal(cellobj.getCellData());
            if (dCurrentValue == dLastValue) {
                if (transEntryFieldInfo.VATLayout.ColumnIndex < 0) {
                    return(false);
                }

                objControl = EntryMainUI.getElement(transEntryFieldInfo.VATLayout, cellobj.iRow);
                if (objControl.Value) {
                    if (DataType.isNullOrEmpty(objControl.Value.getCellText()) == false) {
                        return (false);
                    }
                }
                else {
                    return (false);
                }
            }

            transEntryVat.calculateAndUpdateVATLayoutColumn(cellobj.iRow, dCurrentValue);
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryVat.calculateAndUpdateVATForAmountColumn} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (true);
    },

    resetVATColumn: function (iRow, iTaxCode) {
        let dValue = 0;

        try {
            if (transEntryInfo.isItSales == true) {

            }
            else {
                if (transEntryFieldInfo.VATLayout.ColumnIndex < 0) {
                    return;
                }

                if (iTaxCode == 1) { // Std Rate
                    if (transEntryFieldInfo.Amount.FieldId > 0) {
