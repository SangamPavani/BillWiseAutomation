                else if (sKey == eRowDataName.BillwiseRequired) {
                    if (DataType.toBoolean(sValue) == false) {
                        transEntryGrid.showRowSymbol(iRow, false);
                    }
                }
                else if (sKey == eRowDataName.Marked) {
                }
            }
        }
        catch (err) {
            //transEntryGlobal.showAlert("{transEntryGrid.setRowData} " + err.message, GlobalPref.getResourceValue("Exception"));
            FUIElement.showAlert("{transEntryGrid.setRowData} " + err.message);
