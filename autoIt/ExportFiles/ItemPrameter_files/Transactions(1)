                }
                else if (sKey == eRowDataName.OriginalAmount1) {
                    eleRow = document.getElementById("id_transactionentry_value_originalamount1");
                    eleRow.value = sValue;
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && DataType.isValidObject(objTrans.BodyData[0].OriginalAmounts) == true) {
                        objTrans.BodyData[0].OriginalAmounts[1] = FNumberOperation.convert(sValue);
                    }

                    EntryMain.m_objTrans.BodyData[0].OriginalAmounts[1] = FNumberOperation.convert(sValue);
                }
                else if (sKey == eRowDataName.Amount0) {
                    eleRow = document.getElementById("id_transactionentry_value_amount0");
                    eleRow.value = sValue;
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && DataType.isValidObject(objTrans.BodyData[0].Amounts) == true) {
                        objTrans.BodyData[0].Amounts[0] = FNumberOperation.convert(sValue);
                    }

                    EntryMain.m_objTrans.BodyData[0].Amounts[0] = FNumberOperation.convert(sValue);
                }
                else if (sKey == eRowDataName.Amount1) {
                    eleRow = document.getElementById("id_transactionentry_value_amount1");
                    eleRow.value = sValue;
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && DataType.isValidObject(objTrans.BodyData[0].Amounts) == true) {
                        objTrans.BodyData[0].Amounts[1] = FNumberOperation.convert(sValue);
                    }

                    EntryMain.m_objTrans.BodyData[0].Amounts[1] = FNumberOperation.convert(sValue);
                }
                else if (sKey == eRowDataName.BillwiseData) {
                    eleRow = document.getElementById("id_transactionentry_value_billwisedata");
                    eleRow.value = sValue;
                    objTemp = DataType.stringToObject(sValue);
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.arrayLength(objTrans.BodyData) > 0) {                        
                        objTrans.BodyData[0].BillwiseData = objTemp.data;
                    }

                    EntryMainMemoryObject.updateBillwiseData(objTemp.data, 1);
                }
            }
            else {
                if (transEntryGlobal.debugBillwise == true && sKey == eRowDataName.BillwiseData) {
                    debugger
                }

                eleRow = transEntryGrid.getRowElement(iRow);

                olddata = FGRIDCONTROL.setRowData(eleRow, sKey, sValue);
                if (DataType.toBoolean(bDoNotUpdateTransactionObject) == true) {
                    if (transEntryInfo.isItTransfer == false) {
                        if (sKey == eRowDataName.OriginalAmount0) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].OriginalAmounts[0] = FNumberOperation.convert(sValue);
                        }
                        else if (sKey == eRowDataName.OriginalAmount1) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].OriginalAmounts[1] = FNumberOperation.convert(sValue);
                        }
                        else if (sKey == eRowDataName.Amount0) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].Amounts[0] = FNumberOperation.convert(sValue);
                        }
                        else if (sKey == eRowDataName.Amount1) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].Amounts[1] = FNumberOperation.convert(sValue);
                        }
                    }
                    return (olddata);
                }

                if (sKey == eRowDataName.OriginalAmount0) {
                    sValue = FNumberOperation.convert(sValue);
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && iRow <= objTrans.BodyData.length
                        && DataType.isValidObject(objTrans.BodyData[iRow - 1].OriginalAmounts) == true) {
                        objTrans.BodyData[iRow - 1].OriginalAmounts[0] = sValue;

                        //transEntryGrid.notifyOrgAmtChange(iRow - 1, 0, sValue);
                    }

                    EntryMain.m_objTrans.BodyData[iRow - 1].OriginalAmounts[0] = sValue;
                }
                else if (sKey == eRowDataName.OriginalAmount1) {
                    sValue = FNumberOperation.convert(sValue);
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && iRow <= objTrans.BodyData.length
                        && DataType.isValidObject(objTrans.BodyData[iRow - 1].OriginalAmounts) == true) {
                        objTrans.BodyData[iRow - 1].OriginalAmounts[1] = sValue;
                        //transEntryGrid.notifyOrgAmtChange(iRow - 1, 1, sValue);
                    }

                    EntryMain.m_objTrans.BodyData[iRow - 1].OriginalAmounts[1] = sValue;
                }
                else if (sKey == eRowDataName.Amount0) {
                    sValue = FNumberOperation.convert(sValue);
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && iRow <= objTrans.BodyData.length
                        && DataType.isValidObject(objTrans.BodyData[iRow - 1].Amounts) == true) {
                        objTrans.BodyData[iRow - 1].Amounts[0] = sValue;
                    }

                    EntryMain.m_objTrans.BodyData[iRow - 1].Amounts[0] = sValue;
                }
                else if (sKey == eRowDataName.Amount1) {
                    sValue = FNumberOperation.convert(sValue);
                    if (DataType.isValidObject(objTrans) == true
                        && DataType.isValidObject(objTrans.BodyData) == true
                        && iRow <= objTrans.BodyData.length
                        && DataType.isValidObject(objTrans.BodyData[iRow - 1].Amounts) == true) {
                        objTrans.BodyData[iRow - 1].Amounts[1] = sValue;
