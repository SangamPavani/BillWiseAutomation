    // Returns array of batch info for all rows except passed row
    getUsedBinsList: function (iRow, bBins2, bInclusiveRow) {
        let iCounter = 0;
        let arrBinsInfo = [];
        let result = undefined;

        try {
            bBins2 = DataType.toBoolean(bBins2);
            bInclusiveRow = DataType.toBoolean(bInclusiveRow);
            for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows() ; iCounter++) {
                if (EntryMainBody.isRowEditable(iCounter) == false) {
                    break;
                }

                if (bInclusiveRow == true) {
                    if (iCounter != iRow) {
                        continue;
                    }
                }
                else {
                    if (iCounter == iRow) {
                        continue;
                    }
                }

                if (bBins2 == true) {
                    result = transEntryFields.getBins2(iCounter);
                }
                else {
                    result = transEntryFields.getBins(iCounter);
                }

                if (DataType.isValidObject(result) == true) {
                    arrBinsInfo.push(result);
                }

                if (bInclusiveRow == true) {
                    break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.getUsedBinsList} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrBinsInfo);
    },

