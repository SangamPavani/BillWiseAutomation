    this.TernaryTempResult = function (sInfix) {
        let sOrgFormula = "";
        let sTemp = "";
        let str1 = "";
        let res1 = "";
        let res2 = "";
        let sCharAt = "";
        let iConditionCount = 0;
        let iNonConditionCount = 0;
        let stkTemp = [];
        let iCounter = 0;
        let obj = undefined;

        sOrgFormula = sInfix;
        sInfix = sInfix.replace(/\s+/g, '');
        for (iCounter = 0; iCounter < sInfix.length; iCounter++) {
            sCharAt = sInfix.charAt(iCounter);
            switch (sCharAt) {
                case '?':
                case ':':
                    sTemp = FormulaHelper.NormString(sTemp);//normalizing the string & push into stack

                    obj = {};

                    if (sCharAt == '?') {
                        obj.bCondition = true;
                        iConditionCount++;
                    }
                    else {
                        obj.bCondition = false;
                        iNonConditionCount++;
                    }

                    obj.Value = sTemp;
                    stkTemp.push(obj);

                    sTemp = "";
                    break;
                case "'": // If string
                    sTemp += sInfix[iCounter];
                    for (iCounter++; iCounter < sInfix.length; iCounter++) {
                        sTemp += sInfix[iCounter];
                        if (sInfix.charAt(iCounter) == "'") {
                            break;
                        }
                    }
                    break;
                default:
                    sTemp += sInfix[iCounter];
                    break;
            }
        }

        sTemp = FormulaHelper.NormString(sTemp);//normalizing the string & push into stack

        obj = {};
        obj.bCondition = false;
        iNonConditionCount++;
        obj.Value = sTemp;
        stkTemp.push(obj);

        if (iConditionCount > 0) {
            if (iConditionCount == iNonConditionCount) {
                FUIElement.showAlert("Error: Issue in evaluating formula '" + sOrgFormula + "'.");

                return "";
            }
            else if (iNonConditionCount > (iConditionCount + 1)) {
                FUIElement.showAlert("Error: Issue in evaluating formula '" + sOrgFormula + "'.");

                return "";
            }
        }

        while (stkTemp.length != 1)//check stack upto its count becomes 1
        {
            str1 = "";
            res1 = "";
            res2 = "";

            for (iCounter = stkTemp.length - 1; iCounter >= 0; iCounter--) {
                if (stkTemp[iCounter].bCondition == true) {
                    res2 = stkTemp[iCounter + 2].Value; // 2nd result
                    stkTemp.splice(iCounter + 2, 1);

                    res1 = stkTemp[iCounter + 1].Value; // first result
                    stkTemp.splice(iCounter + 1, 1);

                    str1 = stkTemp[iCounter].Value; // eqn
                    stkTemp.splice(iCounter, 1);

                    str1 = this.TernaryResult(str1, res1, res2);//get result
                    stkTemp.splice(iCounter, 0, { bCondition: false, Value: str1 });//push the result  back to stock

                    break;
                }
            }
        }

        sTemp = stkTemp[stkTemp.length - 1].Value; // final result

        return (sTemp);
    },

    this.TernaryPostfix = function (sInfix) {
        let sPostfix = "";
        let Sct = "";
        let cData = undefined;
        let iCounter = 0;

        this.clearStackOpt();
        sInfix = "(" + sInfix + ")";

        //this.Tstrarr = sInfix.Split(new Char[] { '|', '&' });//split the string
        //this.Tstrarr = sInfix.split(/\||&/);
        this.Tstrarr = DataType.stringSplit(sInfix, "|&");
        //sInfix = sInfix.replace(" ", "");
        sInfix = sInfix.replace(/\s+/g, '');

        if (sInfix.charAt(1) == '*' || sInfix.charAt(1) == '/') {
            return ("");
        }

        for (iCounter = 0; iCounter < sInfix.length; iCounter++) {
            cData = sInfix.charAt(iCounter);
            if (cData == '&' || cData == '|')//check char
            {
                var Temp = "";
                Sct = "";

                if (this.getStackOptCount() == 0)//check stock
                {
                    Sct += sInfix[iCounter];
                    Sct += sInfix[iCounter + 1];
                    this.pushStackOptValue(Sct);//push to stock
                }
                else {
                    while (this.getStackOptCount() >= 1)//check stock count
                    {
                        try {
                            Sct = this.peekStackOptValue(); //temporarily popping the value from stack
                        }
                        catch (err) {
                            this.m_sError = err.message;
                            return ("");
                        }

                        Temp = sInfix[iCounter];//temp string
                        Temp += sInfix[iCounter + 1];

                        try {
                            Sct = this.popStackOptValue();
                        }
                        catch (err) {
                            this.m_sError = err.message;
                            return ("");
                        }
                        sPostfix += Sct;
                    }

                    this.pushStackOptValue(Temp); // push to stock
                }
                iCounter++;
            }
            else {
                if (cData != ' ') {
                    sPostfix += sInfix[iCounter];
                    if (cData == "'") { // If string
                        for (iCounter++; iCounter < sInfix.length; iCounter++) {
                            sPostfix += sInfix[iCounter];
                            if (sInfix.charAt(iCounter) == "'") {
                                break;
                            }
                        }
                    }
                        
                    // sPostfix += sInfix[iCounter];
                }
            }
        }

        try {
            if (this.getStackOptCount() > 0) {
                Sct = this.popStackOptValue(); //pop the last value from stack
                sPostfix += Sct;
            }
        }
        catch (err) {
            this.m_sError = err.message;
        }

        if (this.getStackOptCount() != 0) {
            return ("");
        }

        return (sPostfix);
    },

