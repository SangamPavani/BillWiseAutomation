                            iColumn = transEntryGrid.getGridColumnIndexFromMetaDataIndex(arrFields[iIndex].MetaDataIndex);
                            arrTemp = transEntryGrid.getColumnGroupFilterObject(cellobj.iRow);
                            if (arrTemp.length > 0) {
                                transEntryGrid.updateColumnGroupFilter(arrTemp[0], iColumn, iMasterId, false);
                            }
                            else {
                                objColumn = transEntryGrid.getEmptyColumnFilterObject();
                                objColumn.iColumn = iColumn;
                                objColumn.iGroupId = iMasterId;
                                objColumn.bGroup = true;
                                objRow = transEntryGrid.getEmptyColumnGroupFilterObject();
                                objRow.iRow = cellobj.iRow;
                                objRow.arrColumnFilter.push(objColumn);

                                transEntryGrid.addColumnGroupFilter(objRow);
                            }
                        }

                        break;
                    }
                }
                else {
                    sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    OPTIONCONTROL.setGroupId(sCtrlId, 0);

                    for (iIndex = 0; iIndex < arrFields.length; iIndex++) {
                        objTempMetaData = arrFields[iIndex].MetaData;
                        if (objTempMetaData.iMasterTypeId != objSettings.Documents.VoucherMasters[0].ArrDependentMaster[iCounter].ID) {
                            continue;
                        }

                        iColumn = transEntryGrid.getGridColumnIndexFromMetaDataIndex(arrFields[iIndex].MetaDataIndex);
                        arrTemp = transEntryGrid.getColumnGroupFilterObject(cellobj.iRow);
                        if (arrTemp.length > 0) {
                            transEntryGrid.updateColumnGroupFilter(arrTemp[0], iColumn, iMasterId, false);
                        }

                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainDependency.setBodyDependencyFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

