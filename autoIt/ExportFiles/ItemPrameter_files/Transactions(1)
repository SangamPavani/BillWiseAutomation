                            dTempGross = FNumberOperation.add(dTempGross, cellTemp.getAttribute(CELL_OUTPUT));
                        }
                        else if (objMetaDataPrev.iAddToNet == 1) { // Deduct
                            dTempGross = FNumberOperation.sub(dTempGross, cellTemp.getAttribute(CELL_OUTPUT));
                        }
                    }

                    if (EntryMain.m_bSupportBigNumber) {
                        dValue = new BigNumber(dTempGross).multipliedBy(dInput).dividedBy(100).valueOf();
                    }
                    else {
                        dValue = dTempGross * dInput / 100;
                    }

                    if (objMetaData.bValueInBaseCurrency == true) {
                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
                    break;
                case eTranEntryFormulaBehaviourBody.IncludedInGross: // 4
                    dTempGross = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross;

                    if (EntryMain.m_bSupportBigNumber) {
                        //dValue = new BigNumber(dTempGross).multipliedBy(dInput).dividedBy(100 + dInput).valueOf();
                        dValue1 = DataType.mul(dTempGross, dInput)
                        dValue2 = DataType.add(100, dInput);
                        dValue = DataType.div(dValue1, dValue2);
                    }
                    else {
                        dValue = (dTempGross * dInput) / (100 + dInput);
                    }

                    if (objMetaData.bValueInBaseCurrency == true) {
                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
                    break;
                case eTranEntryFormulaBehaviourBody.NegativeValue: // 5
                    dValue = -dInput;

                    if (objMetaData.bValueInBaseCurrency == true) {
                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
                    break;
                case eTranEntryFormulaBehaviourBody.PercentageOnGrossMinus: // 6
                    dTempGross = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross;

                    if (EntryMain.m_bSupportBigNumber) {
                        dValue = new BigNumber(dTempGross).multipliedBy(dInput).dividedBy(100).multipliedBy(-1).valueOf();
                    }
                    else {
                        dValue = (dTempGross * dInput / 100) * -1;
                    }

                    if (objMetaData.bValueInBaseCurrency == true) {
                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
                    break;
                case eTranEntryFormulaBehaviourBody.PercentageOnNetMinus: // 7 (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                    dInput = FNumberOperation.convert(cell.getAttribute(CELL_VALUE));
                    dTempGross = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross;
                    for (iCounter1 = 0; iCounter1 < iScreenColIndex; iCounter1++) {
                        objMetaDataPrev = transEntryScreenData.getBodyMetaDataFromIndex(iCounter1);
                        cellTemp = transEntryGrid.getCellElement(iRow, transEntryGlobal.FieldHelper.Column.Screen[iCounter1], true);
                        if (objMetaDataPrev.iAddToNet == 0) { // Add
                            dTempGross = FNumberOperation.add(dTempGross, cellTemp.getAttribute(CELL_OUTPUT));
                        }
                        else if (objMetaDataPrev.iAddToNet == 1) { // Deduct
                            dTempGross = FNumberOperation.sub(dTempGross, cellTemp.getAttribute(CELL_OUTPUT));
                        }
                    }

                    if (EntryMain.m_bSupportBigNumber) {
                        dValue = new BigNumber(dTempGross).multipliedBy(dInput).dividedBy(100).multipliedBy(-1).valueOf();
                    }
                    else {
                        dValue = (dTempGross * dInput / 100) * -1;
                    }

                    if (objMetaData.bValueInBaseCurrency == true) {
                        dValue = FNumberOperation.div(dValue, dExchangeRate);
                    }

                    if (EntryMain.m_bSupportBigNumber == false) {
                        dValue = transEntry.rectifyScreenOutputValue(dValue);
                    }
                    dRawOutput = dValue;

                    transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                    transEntryScreenData.setCellOutputValue(cell, dValue, dRawOutput, true);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
                    break;
            }

            if (objMetaData.bValueInBaseCurrency == false) {
                dValue = EntryMain.roundOff(dValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                if (EntryMain.m_bSupportBigNumber == false) {
                    dValue = transEntry.rectifyScreenOutputValue(dValue);
                }

                dRawOutput = dValue;
                cell.setAttribute(CELL_RAWOUTPUT, dRawOutput);
                transEntryGrid.updateRowScreenDataOutput(iRow, iScreenColIndex, dRawOutput, objTrans);
                EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dRawOutput);
            }

            cell.setAttribute(CELL_OUTPUT, dValue);
            EntryMainMemoryObject.update(objMetaData.iFieldId, null, iRow, dValue);
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryScreenData.evaluateNonFormulaScreenFields} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
