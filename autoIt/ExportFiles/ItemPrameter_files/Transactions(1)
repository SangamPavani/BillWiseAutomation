    GetARAPNewRefTagValue: function (iCounter, iARTag, iAPTag) {
        try {
            if (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iAccountTypes == 7) {
                if ((g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_dAmount > 0 && FConvert.isItSales(g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType)) || (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_dAmount < 0 && !FConvert.isItSales(g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType))) // Vendor Behaviour
                {
                    if ((g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType == eVTTYPE.DEBNT) || ((g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.SARET)) {
                        return iARTag;
                    }
                    else {
                        return iAPTag;
                    }
                }
                else if ((g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_dAmount < 0 && FConvert.isItSales(g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType)) || (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_dAmount > 0 && !FConvert.isItSales(g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType))) // Customer Behaviour
                {
                    if (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType == eVTTYPE.CRDNT || ((g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType & eVTTYPE.VOUCHERMASK) == eVTTYPE.PURET)) {
                        return iAPTag;
                    }
                    else {
                        return iARTag;
                    }
                }
            }
            else if (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iAccountTypes == 5 || g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType & eVTTYPE.VOUCHERMASK == eVTTYPE.SARET) {
                return iARTag;

            }
            else if (g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iAccountTypes == 6 || g_Adjustment.arrAdjustBills[iCounter].objAdjustmentDetails.m_iVTType & eVTTYPE.VOUCHERMASK == eVTTYPE.PURET) {
                return iAPTag;

            }
        }
        catch (Ex) {
            alert("Exception: GetARAPNewRefTagValue " + Ex.message);
        }
    },

