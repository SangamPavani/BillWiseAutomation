    editLayout_FieldsCustomization_EnableFont: function (element) {

        var getP = document.getElementById("chkEnableFont_editLayout_FieldsCustomization_FontCtrl");
        var getp2 = getP.parentElement.parentElement;
        if (element.checked == true) {
            getp2.style.display = "none"
            document.getElementById("editLayout_FieldsCustomization_FontDiv").style.display = "block";
        }
        else {
            getp2.style.display = "none"
            document.getElementById("editLayout_FieldsCustomization_FontDiv").style.display = "none";
        }
    },

    editLayout_FieldsCustomization_changePostToAccount: function (element) {

        if (!element.checked) {
            OPTIONCONTROL.setControlValue('editLayout_FieldsCustomization_FieldDetails_defaultAcc1', 0);
            OPTIONCONTROL.setControlValue('editLayout_FieldsCustomization_FieldDetails_defaultAcc2', 0);
            OPTIONCONTROL.disableControl("editLayout_FieldsCustomization_FieldDetails_defaultAcc1", true);
            OPTIONCONTROL.disableControl("editLayout_FieldsCustomization_FieldDetails_defaultAcc2", true);
        }
        else {
            OPTIONCONTROL.disableControl("editLayout_FieldsCustomization_FieldDetails_defaultAcc1", false);
            OPTIONCONTROL.disableControl("editLayout_FieldsCustomization_FieldDetails_defaultAcc2", false);
        }
    },

