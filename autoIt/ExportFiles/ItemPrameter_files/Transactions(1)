                    }
                    AdjustBills_Screen.UI.SetNewRefAmt(FNumberOperation.toFixed(_objAdj.m_NewRef, _objAdj.m_DefaultCurrency.NoofDecimals));
                    if (_objAdj.m_objReferenceType == 2) {
                        AdjustBills_ScreenNew.CalculateInstallments();
                    }
                }
            }
        }
        else {
