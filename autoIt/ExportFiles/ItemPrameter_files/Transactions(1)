    EditScreen_ToggleColumn: function (element) {

        var column = document.getElementById(EditScreenHiddenColumnId + element.id.substring(24));
        if (element.className == "") {
            column.style.display = "";
            element.className = "selected";
            if (EditScreenHiddenColumnId == "editScreen_bodycolumn_") {
                editScreen_bodyHdnDisCol.push(element.id.substring(24));
                for (var count = 1; count <= column.parentNode.parentNode.nextElementSibling.children.length; count++) {
                    document.getElementById("editScreen_bodyrow_" + count + " _" + element.id.substring(24)).style.display = "";
                }
            }
            else {
                editScreen_footerHdnDisCol.push(element.id.substring(24));
                for (var count = 1; count <= column.parentNode.parentNode.nextElementSibling.children.length; count++) {
                    document.getElementById("editScreen_footerrow_" + count + " _" + element.id.substring(24)).style.display = "";
                }
            }
        }
        else {
            column.style.display = "none";
            element.className = "";
            if (EditScreenHiddenColumnId == "editScreen_bodycolumn_") {
                for (var count = 0; count < editScreen_bodyHdnDisCol.length; count++) {
                    if (editScreen_bodyHdnDisCol[count] == element.id.substring(24)) {
                        editScreen_bodyHdnDisCol.splice(count, 1);
                    }
                }
                for (var count = 1; count <= column.parentNode.parentNode.nextElementSibling.children.length; count++) {
                    document.getElementById("editScreen_bodyrow_" + count + " _" + element.id.substring(24)).style.display = "none";
                }
            }
            else {
                for (var count = 0; count < editScreen_footerHdnDisCol.length; count++) {
                    if (editScreen_footerHdnDisCol[count] == element.id.substring(24)) {
                        editScreen_footerHdnDisCol.splice(count, 1);
                    }
                }
                for (var count = 1; count <= column.parentNode.parentNode.nextElementSibling.children.length; count++) {
