    setCellValueBasedOnDataType: function (cell, value, objExtra) {
        try {
            if (DataType.isValidObject(cell) == false) {
                return;
            }

            switch (objExtra.MetaData.iDataTypeId) {
                case eMasterDataType.Text:
                    if (objExtra.bAppend === true) {
                        value = DataType.toString(cell.getCellText()) + value;
                    }

                    if (DataType.isNullOrEmpty(value) == false
                        && DataType.isValidObject(objExtra) == true
                        && DataType.isValidObject(objExtra.MetaData) == true
                        && objExtra.MetaData.iMaxSize > 0 && value.length > objExtra.MetaData.iMaxSize) {
                        value = DataType.stringLeft(value, objExtra.MetaData.iMaxSize);
                    }

                    cell.setCellText(value, value);

                    if (objExtra.MetaData) {
                        EntryMainMemoryObject.update(objExtra.MetaData.iFieldId, value, cell.iRow, objExtra.MetaData);
                    }
                    break;
                case eMasterDataType.BigNumber:
                case eMasterDataType.Fraction:
                    value = DataType.getNumber(value);

                    if (objExtra.MetaData) {
                        if (objExtra.MetaData.iFieldId == eVTFIELDID.FDF_BODYALTQUANTITY) {
                            if (EntryMainUI.isQuantityValid(value, cell.iRow) == false) {
                                break;
                            }
                        }
                        else if (objExtra.MetaData.iFieldId == eVTFIELDID.FDF_BODYRATE) {
                            if (EntryMainUI.isRateValid(value, cell.iRow) == false) {
                                break;
                            }
                        }
                        else if (objExtra.MetaData.iFieldId == eVTFIELDID.FDF_BODYGROSS) {
                            if (EntryMainUI.isGrossValid(value, cell.iRow) == false) {
                                break;
                            }
                        }

                        if (EntryMainUI.isReservationRestrictd(cell.iRow, objExtra.MetaData.iFieldId) == true
                            || EntryMainUI.isLinkRestrictd(cell.iRow, objExtra.MetaData.iFieldId).Value == true
                            || EntryMainUI.isBillStatusRestricted(cell.iRow, objExtra.MetaData.iFieldId, objExtra.MetaData) == true) {
                            break;
                        }
                    }

                    EntryMainBody.updateCellValue(cell, value, objExtra.MetaData);
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    if (objExtra.bFromPaste == true) {
                        if (EntryMainUI.isReservationRestrictd(cell.iRow, objExtra.MetaData.iFieldId) == true) {
                            break;
                        }

                        if (EntryMainUI.isLinkRestrictd(cell.iRow, objExtra.MetaData.iFieldId, true).Value == true) {
                            break;
                        }

                        if (EntryMainUI.isBillStatusRestricted(cell.iRow, objExtra.MetaData.iFieldId, objExtra.MetaData) == true) {
                            break;
                        }

                        EntryMainBody.updateMasterValueFromText(cell, value, objExtra.MetaData);
                    }
                    else if (DataType.isValidObject(objExtra.Data) == true) {
                        EntryMainBody.updateMasterValue(cell, objExtra.Data, objExtra.MetaData.iFieldId, true);
                    }
                    else {
                        if (DataType.isNumeric(value) == true) {
                            EntryMainBody.updateMasterValueFromId(cell.ColumnAttribute.ctrlid, cell.iRow, value, objExtra.MetaData);
                        }
                        else {
                            value = DataType.toString(value);
                            cell.setCellText(value, value);
                        }
                    }
                    break;
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    value = DataType.getNumber(value);
                    EntryMainBody.updateNumberValue(cell, value, objExtra.MetaData.iFieldId);
                    break;
                case eMasterDataType.Date:
                    EntryMainBody.updateDateValue(cell, value, objExtra.MetaData.iFieldId);
                    break;
                case eMasterDataType.Time:
                    EntryMainBody.updateTimeValue(cell, value, objExtra.MetaData.iFieldId, false);
                    break;
                case eMasterDataType.StringList:
                    EntryMainBody.updateStringListValue(cell, value, objExtra.MetaData.iFieldId, false);
                    break;
                case eMasterDataType.NumberList:
                    EntryMainBody.updateNumberListValue(cell, value, objExtra.MetaData.iFieldId, false);
                    break;
                case eMasterDataType.Boolean:
                    EntryMainBody.updateCellValue(cell, value, objExtra.MetaData);
                    break;
                case eMasterDataType.DateTime:
                    break;
                case eMasterDataType.Picture:
                    break;
                case eMasterDataType.DocumentViewer:
                    if (DataType.isValidObject(value) == true && DataType.isNullOrEmpty(value.FileName) == false) {
                        if (objExtra.bFromBatch == true) {
                            if (DataType.isValidObject(value) == true && DataType.isNullOrEmpty(value.FileName, true) == false) {
                                value.sFileName = value.FileName;
                                value.sData = value.FileData;
                                EntryMainBody.updateAttachmentValue(cell, value, objExtra.MetaData.iFieldId, false);
                            }
                            else {
                                cell.setCellText(value.FileName, DataType.arrayToCSV(value.FileData));
                            }
                        }
                        else {
                            cell.setCellText(value.FileName, DataType.arrayToCSV(value.FileData));
                        }                        
                    }
                    else if (DataType.isValidObject(value) == true && DataType.isNullOrEmpty(value.sFileName) == false) {
                        cell.setCellText(value.sFileName, DataType.arrayToCSV(value.arrData));
                    }
                    else {
                        cell.clear();
                    }
                    break;
                case eMasterDataType.HyperLink:
                    if (FHyperLink.isValidValue(value) == true) {
                        cell.setCellText(value, value);
                    }
                    else {
                        cell.clear();
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.setCellValueBasedOnDataType} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getCellValueBasedOnDataType: function (cell, objMetaData) {
        let obj = null;

        try {
            obj = COMMON.prototype.getEmptyResultObject();
            obj.lValue = 0;
            obj.sValue = "";
            obj.data = undefined;

            switch (objMetaData.iDataTypeId) {
                case eMasterDataType.Text:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
                case eMasterDataType.BigNumber:
                case eMasterDataType.Number:
                case eMasterDataType.SmallNumber:
                case eMasterDataType.TinyNumber:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
                case eMasterDataType.Fraction:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
                case eMasterDataType.Date:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    if (DataType.isValidObject(obj.data) == true) {
                        obj.data = DataType.toInt(obj.data);
                    }
                    break;
                case eMasterDataType.Time:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    if (DataType.isValidObject(obj.data) == true) {
                        obj.data = DataType.toInt(obj.data);
                    }
                    break;
                case eMasterDataType.StringList:
                case eMasterDataType.NumberList:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
                case eMasterDataType.DocumentViewer:
                case eMasterDataType.Picture:
                    if (DataType.isNullOrEmpty(cell.getCellText(), true) == false) {
                        obj.data = {};
                        obj.data.iFieldId = objMetaData.iFieldId;
                        obj.data.sFileName = cell.getCellText();
                        obj.data.sData = cell.getCellData();
                    }
                    obj.lValue = 1;
                    break;
                case eMasterDataType.Boolean:
                    if (cell.hasControl() == true) {
                        obj.data = cell.getControl().checked == true ? 1 : 0;
                    }
                    obj.lValue = 1;
                    break;
                case eMasterDataType.Master:
                case eMasterDataType.ExternalTable:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
                default:
                    obj.data = cell.getCellRawData();
                    obj.lValue = 1;
                    break;
            }
        }
        catch (err) {
            obj.lValue = -1;
            obj.sValue = err.message;
        }

        return (obj);
