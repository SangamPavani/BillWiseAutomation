    onRaiseChequeReturn_Click: function () {
        let sChequeNo = "";
        let sId = "";
        let result = null;
        let objFlags = null;
        let iMaskedVoucherType = 0;
        let bPmt = false;
        let bCanReturn = false;
        let objResult = null;
        let objInput = null;
        let obj = null;

        try {
            if (DataType.isValidObject(document.getElementById("id_transactionentry_raisechequereturn")) == false) {
                return;
            }

            if (EntryMain.checkPermission(SecurityActions.RaiseChequeReturn) == false) {
                return;
            }

            objFlags = transEntryInfo.HeaderFlags;
            if (DataType.isValidObject(objFlags) == false || objFlags.Editing == false || objFlags.Suspended == true) {
                return;
            }

            if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.None) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgChequeNoNotFound"), GlobalPref.getResourceValue("Error"));

                return;
            }

            if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header) {
                sId = transEntryChequeNo.getControlId();
                sChequeNo = EntryMainCommon.findKeyValue(sId, transEntryGlobal.EntryModel.Data.Header, true);
            }
            else {
                result = EntryMainUI.getElement(transEntryFieldInfo.ChequeNo, 1, false).Value;
                sChequeNo = EntryMainCommon.findKeyValue(result.ColumnAttribute.ctrlid, transEntryGlobal.EntryModel.Data.Body[0], true);
            }

            if (DataType.isNullOrEmpty(sChequeNo, true) == true) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgBlankChkNoReturn"), GlobalPref.getResourceValue("Error"));

                return;
            }

            if (EntryMain.isDirty() == true) {
                transEntryGlobal.showAlert("Document is modified. Save before doing cheque return.");

                return;
            }

            bPmt = false;
            iMaskedVoucherType = transEntryInfo.BaseVoucherType;
            if (iMaskedVoucherType == eVTTYPE.CASHP || iMaskedVoucherType == eVTTYPE.MEMOP) {
                bPmt = true;
            }

            bCanReturn = true;
            if (bPmt == true) {
                obj = {};
                obj.iBank = EntryMain.m_objTrans.BodyData[0].Book;
                obj.sCheque = sChequeNo;
                obj.bCallFromPmt = bPmt;

                result = transEntryServer.execute(eTransServerRequest.CanReturnCheque, obj);
                if (result.lValue < 1) {
                    return;
                }

                result = result.data;
                if (result.lValue < 1) {
                    if (DataType.isNullOrEmpty(result.sValue) == false) {
                        transEntryGlobal.showAlert("{CanReturnCheque} " + result.sValue, EntryMainUI.getErrorTitle(result.lValue));
                    }

                    return;
                }

                bCanReturn = DataType.toBoolean(result.data);
            }

            
            if (bCanReturn == true) {
                objResult = EntryMainUI.getTransactionData(false, true);

                objFlags = DataType.stringToObject(objResult.TransactionData.Header.Flags).data;
                if (DataType.isValidObject(objFlags) == true && objFlags.Approved == false) {
                    transEntryGlobal.showAlert("Voucher is not authorize.");

                    return;
                }

                objInput = {};
                objInput.objTransactionData = objResult.TransactionData;
                objInput.iSourceVoucherType = transEntryInfo.VoucherType;
                objInput.iViewId = transEntryInfo.ViewId;
                objInput.iDocDate = EntryMain.m_objTrans.Header.Date;

                EntryMainRaiseChequeReturn.openPopup(bPmt, "EntryMainCallback.raiseChequeReturnPopupResult", objInput);
            }
            else {
                transEntryGlobal.showAlert("A return has already been raised for this document or target document does not has cheque number field.");
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainToolbar.onRaiseChequeReturn_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

