        let result = null;

        try {
            if (bMaintainIntermediateData == true) {
                transEntry.initIntermediateDataObject();
            }

            iTotalRows = transEntryGrid.getTotalRows();
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    break;
                }

                result = transEntryData.getRowTransBodyObject(iRow);
                if (result.lValue > 0) {
                    if (bMaintainIntermediateData == true) {
                        transEntryGlobal.IntermediateData.arrBookTypes.push(result.BookType);
                        transEntryGlobal.IntermediateData.arrCodeTypes.push(result.CodeType);
                    }

                    if (DataType.isValidObject(result.data.DueDate) == false) {
                        result.data.DueDate = EntryMain.m_objTrans.BodyData[iRow - 1].DueDate;
                    }

                    arrData.push(result.data);
