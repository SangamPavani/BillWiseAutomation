                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_Screen.PickOnAccount();
                        }
                    }
                    else {
                        if ((_objAdj.dAmtToBeAdjInBaseCurr - (_objAdj.m_OnAccount + _objAdj.m_NewRef)) < 0) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_Screen.PickOnAccount();
                        }
                    }
                }
            }
            else {
                if (_objAdj.m_dTransactionCurrencyAmount != 0) {
                    if (_objAdj.AdvanceOrAgainstRefAdj == false) {
                        if ((_objAdj.m_dTransactionCurrencyAmount - (NativeAmt + _objAdj.m_OnAccountTransCurr + _objAdj.m_NewRefTransCurr)) < 0) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            AdjustBills_Screen.UI.SetOnAccountAmt(FConvert.toDecimal(0, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals));
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_Screen.PickOnAccount();
                        }
                    }
                    else {
                        if ((_objAdj.m_dTransactionCurrencyAmount - (_objAdj.m_OnAccountTransCurr + _objAdj.m_NewRefTransCurr)) < 0) {
                            COMMON.prototype.showMessage("Total Adjustment Amount cannot be more than Available Adjustment Amount");
                            AdjustBills_Screen.UI.SetOnAccountAmt(FConvert.toDecimal(0, g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].iNoOfDecimals));
                            _objAdj.m_OnAccount = 0;
                            _objAdj.m_OnAccountTransCurr = 0;
                            AdjustBills_Screen.PickOnAccount();
                        }
                    }
                }
            }
            AdjustBills_Screen.AssignAdjustmentValues();
            if (g_Adjustment.BeforeAmount == true) {
                var col = TRANSACTION_ENTRY.BODYCOLUMN.getAmountColumn();
                col.setText(NativeAmt + AdjustBills_Screen.UI.GetOnAccountAmt() * g_Adjustment.arrAdjustBills[g_Index].arrBreakupByTag[0].mBAIDConversionRate)
            }
            return true;
        }
        catch (Ex) {
            alert("Exception: ValidateOnAccountInput " + Ex.toString());
            return false;
        }
