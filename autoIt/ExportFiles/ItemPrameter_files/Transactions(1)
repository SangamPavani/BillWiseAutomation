                            EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra[iIndex].Tag = value;
                        }
                        break;
                    case eMasterDataType.Master:
                    case eMasterDataType.ExternalTable:
                        if (iIndex >= 0 && iIndex < EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra.length) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra[iIndex].Tag = value;
                        }
                        break;
                    case eMasterDataType.Date:
                    case eMasterDataType.Time:
                        if (iIndex >= 0 && iIndex < EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra.length) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra[iIndex].Tag = value;
                        }
                        break;
                    case eMasterDataType.StringList:
                    case eMasterDataType.NumberList:
                        if (value != undefined && value != null) {
                            sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                            ele = document.getElementById(sId);
                            if (ele) {
                                if (objMetaData.iDataTypeId == eMasterDataType.StringList) {
                                    ele.text = value;
                                }
                                else {
                                    ele.value = value;
                                }

                                if (ele.selectedIndex == -1) {
                                    value = undefined;
                                }
                            }
                        }

                        if (iIndex >= 0 && iIndex < EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra.length) {
                            EntryMain.m_objTrans.BodyData[iRow - 1].BodyExtra[iIndex].Tag = value;
                        }
                        break;
