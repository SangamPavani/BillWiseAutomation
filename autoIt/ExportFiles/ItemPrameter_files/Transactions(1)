    getSelectedData: function () {
        let iTotalRows = 0;
        let iRow = 0;
        let eleGrid = null;
        let eleRow = null;
        let cell = null;
        let obj = null;

        try {
            obj = {};
            obj.iAuditId = 0;
            obj.iHeaderId = 0;

            eleGrid = DOCUMENTHISTORY.PRIVATE.getPopupGridElement();
            iTotalRows = FGRIDCONTROL.getTotalRows(eleGrid);
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 1);
                if (cell.cell.children[0].checked == false) {
                    continue;
                }

                eleRow = FGRIDCONTROL.getRowElement(eleGrid, iRow);
                if (DataType.isNullOrEmpty(eleRow.style.display) == false) {
                    // Do not select hidden rows.
                    continue;
                }

                cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 2);
                obj.iAuditId = DataType.toInt(cell.getCellData());

                cell = FGRIDCONTROL.getCellObject(eleGrid, iRow, 7);
                obj.iHeaderId = DataType.toInt(cell.getCellData());
                break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{DOCUMENTHISTORY.getSelectedData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (obj);
    },

