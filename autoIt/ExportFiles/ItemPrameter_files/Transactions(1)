            bFromBatch = DataType.toBoolean(bFromBatch);
            bIgnoreSetSummaryInfo = DataType.toBoolean(bIgnoreSetSummaryInfo);

            if ((bFromBatch == true && transEntryInfo.BatchPref.bLoadScreenDetailsRelatedToBatchInIssues == true) || bFromBatch == false) {
                // Updating screen fields
                arrFields = transEntryFieldInfo.getScreenFields();
                iTotal = DataType.arrayLength(objBodyData.Sales.ScreenData);
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    objData = objBodyData.Sales.ScreenData[iCounter];

                    for (iColumn = 0; iColumn < arrFields.length; iColumn++) {
                        objMetaData = arrFields[iColumn].MetaData;
                        if (objData.FieldName != objMetaData.sFieldName) {
                            continue;
                        }

                        objCell = transEntryGrid.getCellObject(iRow, arrFields[iColumn].ColumnIndex);
                        if (DataType.isValidObject(objCell) == true) {
                            sValue = DataType.toDecimal(objData.Input, objMetaData.iNoDecimal);
                            objCell.setCellText(sValue, objData.Input);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Input, iRow, objData.Value);
                        }
                        break;
                    }
                }
            }

            if ((bFromBatch == true && transEntryInfo.BatchPref.bLoadLayoutDetailsRelatedToBatchInIssues == true) || bFromBatch == false) {
                // Updating layout fields
                arrFields = transEntryFieldInfo.getLayoutFields(true);
                iTotal = DataType.arrayLength(objBodyData.BodyExtra);
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    objData = objBodyData.BodyExtra[iCounter];

                    for (iColumn = 0; iColumn < arrFields.length; iColumn++) {
                        objMetaData = arrFields[iColumn].MetaData;
                        if (objData.Name != objMetaData.sFieldName) {
                            continue;
                        }

                        objCell = transEntryGrid.getCellObject(iRow, arrFields[iColumn].ColumnIndex);
                        if (DataType.isValidObject(objCell) == true) {
                            if (bFromBatch == true && transEntryInfo.BatchPref.bLoadLayoutDetailsRelatedToBatchInIssues == true && transEntryInfo.BatchPref.bDoNotOverwriteLayoutField == true) {
                                lastValue = transEntryGrid.getCellValueBasedOnDataType(objCell, objMetaData);
                                if (lastValue.lValue > 0) {
                                    if (objMetaData.iDataTypeId == eMasterDataType.Master || objMetaData.iDataTypeId == eMasterDataType.ExternalTable) {
                                        if (DataType.toInt(lastValue.data) > 0) {
                                            break;
                                        }
                                    }
                                    else if(objMetaData.iDataTypeId == eMasterDataType.Text) {
                                        if (DataType.isNullOrEmpty(lastValue.data) == false) {
                                            break;
                                        }
                                    }
                                    else if (DataType.isValidObject(lastValue.data) == true) {
                                        break;
                                    }
                                }
                            }

                            transEntryGrid.setRowValueBasedOnDataType(iRow,
                                                                        objData.Tag,
                                                                        {
                                                                            MetaData: objMetaData,
                                                                            Data: objData.Data,
                                                                            bFromBatch: bFromBatch
                                                                        });
                        }
                        break;
                    }
                }
            }

            if (bIgnoreSetSummaryInfo == false) {
                EntryMainUI.setSummaryInfo(iRow);
            }

            bResult = true;
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.updateBodyRowLayoutAndScreenData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bResult);
    },

    updateBodyRowTags: function(objBodyData, iRow, bFromBatch) {
        let iCounter = 0;
        let iTotal = 0;
        let iColumn = 0;
        let iValue = 0;
        let arrFields = undefined;
        let objMetaData = null;
        let objCell = null;

        try {
            if (DataType.isValidObject(objBodyData) == false) {
                return (false);
            }

            iRow = DataType.toInt(iRow);
            if (iRow < 1 || iRow > transEntryGrid.getTotalRows()) {
                return (false);
            }

            if(bFromBatch == true && transEntryInfo.BatchPref.bLoadLayoutDetailsRelatedToBatchInIssues == true && transEntryInfo.BatchPref.bLoadTagsIntoIssues == true) {
                iTotal = DataType.arrayLength(objBodyData.Tags);
                for (iCounter = 0; iCounter < iTotal; iCounter++) {
                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iColumn = 0; iColumn < arrFields.length; iColumn++) {
                        objMetaData = arrFields[iColumn].MetaData;
                        if (objBodyData.Tags[iCounter].ID != objMetaData.iMasterTypeId) {
                            continue;
                        }

                        objCell = transEntryGrid.getCellObject(iRow, arrFields[iColumn].ColumnIndex);
                        if (DataType.isValidObject(objCell) == true) {
                            if(transEntryInfo.BatchPref.bDoNotOverwriteLayoutField == true && DataType.toInt(objCell.getCellData()) > 0) {
                                continue;
                            }

                            iValue = DataType.toInt(objBodyData.Tags[iCounter].Tag);
                            objCell.setMasterValue(iValue, objCell.ColumnAttribute.ctrlid);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, iValue, iRow);
                        }
                        break;
                    }
                }
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainUI.updateBodyRowTags} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

