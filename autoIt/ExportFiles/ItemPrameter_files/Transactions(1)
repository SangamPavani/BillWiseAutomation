            }
            else {
                transEntryGrid.insertRows(iRow, 1, true);
                iValue = iRow;
            }

            if (iRow == 1 && transEntryInfo.HeaderId > 0 && EntryMainBillwise.isSingleBillwiseVoucher() == true) {
                EntryMainBillwise.moveBillwiseRowData(2, 1);
            }

            transEntryGrid.markReadonlyColumns();
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onInsertRow method.", GlobalPref.getResourceValue("Exception"))
            transEntryGlobal.writeErrorLog("{EntryMainBody.onInsertRow} " + err.message, GlobalPref.getResourceValue("Exception"))
        }

        return(iValue);
    },

    onDuplicateRow: function (iRow, arrIgnorePopupField, evt, bIgnoreSetSummaryInfo) {
        let iCounter = 0;
        let iExtraColumn = 0;
        let bRowAdded = false;
        let arrFields = undefined;
        let arrColumns = null;
        let objMetaData = null;
        let objFlags = null;
        let objWatch = null;
        let objSetInfo = null;

        try {
            if(DataType.isValidObject(evt) == true) {
                FUIElement.stopKeyProcess(evt);
            }

            if (EntryMainUI.isSaudiRestrictionApplied(true) == true) {
                transEntryGlobal.showAlert("Duplicate row cannot be created due to saudi restriction.");
                return;
            }

            objWatch = new FStopWatch();
            objWatch.start();

            transEntryGrid.update();

            if (transEntrySettings.isRestrictItemFromBeingRepeated == true && EntryMainMemoryObject.getProductValue(iRow) > 0) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgDuplicateItem") + ". " + GlobalPref.getResourceValue("msgDuplicateItemAsSetting") + ".", GlobalPref.getResourceValue("Error"));
                return;
            }

            objSetInfo = EntryMainSet.getRowInfo(iRow);
            transEntryGrid.insertRows(iRow + 1, 1, true);
            EntryMainDependency.updateTreeDependencyRow(iRow);
            transEntryGrid.addDuplicateColumnGroupFilter(iRow);
            transEntryGrid.markReadonlyColumns();

            if(DataType.isValidObject(objSetInfo) == true && objSetInfo.iSetId > 0) {
                EntryMainSet.setRowInfo(iRow + 1, objSetInfo.iSetId, objSetInfo.iTotalRows + 1, false);
                EntryMainSet.updateSetTotalRows(objSetInfo.iTotalRows + 1, objSetInfo.iStartRow, objSetInfo.iEndRow + 1);
            }

            iExtraColumn = transEntryGrid.gridExtraColumn();
            arrFields = transEntryFieldInfo.getBodyFields();
            arrColumns = [];
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (transEntryFields.isPopupTypeField(objMetaData.iFieldId) == false) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO
                        && transEntryInfo.isInwardVoucher == false
                        && DataType.arrayContains(arrIgnorePopupField, eVTFIELDID.FDF_BODYBATCHNO) == -1) {
                        continue;
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                        transEntryGrid.setRowData(iRow + 1, eTranEntryBodyDataConstKey.BillwiseData, "", true);

                        continue;
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_SKID && transEntrySkid.isUniqueRequired() == true) {
                        continue;
                    }

                    arrColumns.push(arrFields[iCounter].ColumnIndex + iExtraColumn);
                }
                else if (DataType.arrayContains(arrIgnorePopupField, eVTFIELDID.FDF_LINK) > -1) {
                    arrColumns.push(arrFields[iCounter].ColumnIndex + iExtraColumn);
                }
            }

            if(DataType.arrayLength(arrColumns) > 0) {
                bRowAdded = true;
                FGRIDCONTROL.copyColumnsData(transEntryGrid.getGridId(), iRow, arrColumns, iRow + 1, arrColumns);
                EntryMainMemoryObject.copyRowData(iRow, iRow + 1);
            }

            if(bRowAdded == true) {
                EntryMain.setDirty();

                if(transEntryInvTag.getArea() == eTranEntryFieldArea.Body && transEntryInvTag.getValue(iRow + 1) > 0) {
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                }

                if (transEntryFieldInfo.Item.FieldId > 0
                    && EntryMainMemoryObject.getProductValue(iRow + 1) > 0) {
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {

                        objFlags.NoBarcodeCheck = false;
                        objFlags.CheckNegativeStock = true;

                        if (transEntryLinks.isDefinedOnQty() == true) {
                            objFlags.NoLinkCheck = false;
                        }
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                }

                if (transEntryFieldInfo.Unit.ColumnIndex > -1
                    && EntryMainMemoryObject.getUnitValue(iRow + 1) > 0) {

                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBatchCheck = false;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                        objFlags.NoBarcodeCheck = false;

                        if (transEntryLinks.isDefinedOnQty() == true) {
                            objFlags.NoLinkCheck = false;
                        }
                    }

                    transEntryInfo.HeaderFlags = objFlags;
                }

                if (transEntryFieldInfo.Qty.ColumnIndex > -1
                    && transEntryFields.getQty(iRow + 1) > 0) {

                    objFlags = transEntryInfo.HeaderFlags;

                    if (transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                        objFlags.NoLinkCheck = false;
                    }

                    objFlags.NoBatchCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                }
            }

            if (bIgnoreSetSummaryInfo !== true) {
                EntryMainUI.setSummaryInfo(iRow + 1);
            }

            if (bRowAdded == true
                && transEntryInfo.isAutoSave == true
                && EntryMainBody.isRowReadOnly(iRow + 1) == false
                && EntryMainBody.isRowEditable(iRow + 1) == true) {

                EntryMainUI.autoSave(iRow + 1);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onDuplicateRow method.", GlobalPref.getResourceValue("Exception"))
            transEntryGlobal.writeErrorLog("{EntryMainBody.onDuplicateRow} " + err.message, GlobalPref.getResourceValue("Exception"))
        }

        objWatch.stop();
        transEntryGlobal.writeInfoLog("EntryMainBody.onDuplicateRow(" + objWatch.getDifferenceString() + ").");
        objWatch = null;
    },

    onDeleteRow: function (iRow, evt) {
        let iNewBillwiseRows = -1;
        let bRowDeleted = false;
        let objSetRowInfo = undefined;
        let objFlags = undefined;

        try {
            FUIElement.stopKeyProcess(evt);

            if (EntryMainBody.isRowReadOnly(iRow) == true && EntryMainUI.isPickConfirmationRestrictionApplied() == false) {
                return;
            }

            if (EntryMainUI.isSaudiRestrictionApplied(true) == true) {
                transEntryGlobal.showAlert("This row cannot be deleted due to saudi restriction.");

                return;
            }

            if (iRow == 1
                && transEntryInfo.HeaderId > 0
                && EntryMainBillwise.isSingleBillwiseVoucher() == true
                && DataType.arrayLength(transEntryGlobal.arrLoadedData) > 0
                && DataType.arrayLength(transEntryGlobal.arrLoadedData[0].BillwiseData) > 0) {

                iNewBillwiseRows = -1;
                objSetRowInfo = EntryMainSet.getRowInfo(iRow);
                if (objSetRowInfo.iSetId > 0) {
                    if (EntryMainBody.isRowEditable(objSetRowInfo.iEndRow + 1) == true) {
                        iNewBillwiseRows = objSetRowInfo.iEndRow + 1;
                    }
                }
                else if (EntryMainBody.isRowEditable(iRow + 1) == true) {
                    iNewBillwiseRows = iRow + 1;
                }

                if (iNewBillwiseRows > -1) {
                    EntryMainBillwise.moveBillwiseRowData(iRow, iNewBillwiseRows);
                }
                else {
                    transEntryGlobal.showAlert("Cannot delete row of first postion in editing for single billwise type voucher.");
                    return;
                }
            }


            EntryMain.m_bBinModified = true;

            if (transEntryGrid.getTotalRows() == 1) {
                EntryMainUI.resetCOGSDetail();
                FGRIDCONTROL.clearData(transEntryGrid.getGridId());

                return;
            }

            transEntryGrid.update();

            if (EntryMainBody.isRowEditable(iRow) == true) {
                EntryMain.setDirty();

                if(transEntryInfo.HeaderId > 0 && transEntryInfo.isItSales == true) {
                    objFlags = transEntryInfo.HeaderFlags;
                    objFlags.NoBarcodeCheck = false;
                    objFlags.NoBatchCheck = false;
                    objFlags.NoLinkCheck = false;
                    transEntryInfo.HeaderFlags = objFlags;
                }

                bRowDeleted = true;
            }

            objSetRowInfo = EntryMainSet.getRowInfo(iRow);
            if (objSetRowInfo.iSetId > 0) {
                while (objSetRowInfo.iEndRow >= objSetRowInfo.iStartRow) {
                    transEntryGrid.deleteRows(objSetRowInfo.iEndRow, 1);
                    EntryMainMemoryObject.deleteRowData(objSetRowInfo.iEndRow, 1);

                    objSetRowInfo.iEndRow--;
                }

                if (bRowDeleted == true
                    && transEntryInfo.isAutoSave == true) {

                    EntryMainUI.autoSave(iRow, true);
                }
            }
            else {
                if (GlobalPref.Version == eVersion.Version9 && EntryMainScheme.isSchemeRow(iRow) == true) {
                    transEntryQuantity.setValue(0, iRow, { bUpdateMemoryObject: true });

                    transEntryRate.setValue(0, iRow);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, 0, iRow);
                    EntryMainScheme.applyScheme(iRow, true);
                }
                else {
                    transEntryGrid.deleteRows(iRow, 1);
                    EntryMainMemoryObject.deleteRowData(iRow, 1);
                    EntryMainDependency.deleteTreeDependencyRow(iRow);
                    transEntryGrid.removeRowGroupFilter(iRow);

                    if (bRowDeleted == true
                        && transEntryInfo.isAutoSave == true
                        && EntryMainBody.isRowReadOnly(iRow) == false) {

                        EntryMainUI.autoSave(iRow, true);
                    }
                }                
            }

            if (GlobalPref.Version == eVersion.Version9 && transEntryGlobal.EntryModel.bHasWorkflow == true) {
                TRANSACTION_ENTRY.WORKFLOW.updateWorkflowPanel(false);
            }

            EntryMainUI.setSummaryInfo(0);
            EntryMainUI.resetCOGSDetail();

            if(iRow > 0) {
                transEntryGrid.makeRowVisible(iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onDeleteRow method.", GlobalPref.getResourceValue("Exception"))
            transEntryGlobal.writeErrorLog("{EntryMainBody.onDeleteRow} " + err.message, GlobalPref.getResourceValue("Exception"))
        }
    },

    getBaseUnitDecimals: function (iRow) {
        let iProductBaseUnit = 0;
        let iDecimals = undefined;
        let result = undefined;
        let value = undefined;

        try {
            iProductBaseUnit = EntryMainMemoryObject.getProductDataValue("iDefaultBaseUnit", iRow);
            if (iProductBaseUnit != undefined && DataType.gt(iProductBaseUnit, 0) == true) {
                iProductBaseUnit = DataType.toInt(iProductBaseUnit);
                iDecimals = transEntryCache.BASEUNITDECIMALS.getValue(iProductBaseUnit);
                if (iDecimals == undefined || iDecimals == null) {
                    result = transEntryServer.execute(eTransServerRequest.GetUnitDecimals, { iUnitId: iProductBaseUnit }, false);
                    if (result.lValue > 0) {
                        result = result.data;
                        if (result.lValue > 0) {
                            value = result.data;

                            if (value == -1) {
                                value = GlobalPref.DecimalsInQty;
                            }
                            else {
                                transEntryCache.BASEUNITDECIMALS.setValue(iProductBaseUnit, value);
                            }
                        }
                        else if (DataType.isNullOrEmpty(result.sValue, true) == false) {
                            transEntryGlobal.showAlert(result.sValue, EntryMainUI.getErrorTitle(result.lValue));
                        }
                    }
                    else if (DataType.isNullOrEmpty(result.sValue, true) == false) {
                        transEntryGlobal.showAlert(result.sValue, EntryMainUI.getErrorTitle(result.lValue));
                    }
                }
                else {
                    value = GlobalPref.DecimalsInQty;
                }
            }
            else {
                value = GlobalPref.DecimalsInQty;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body getBaseUnitDecimals method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.getBaseUnitDecimals} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },

