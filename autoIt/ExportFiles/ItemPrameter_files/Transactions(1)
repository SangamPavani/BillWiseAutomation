    resultBatch: function (bCancel, arrData, evt) {
        let iCounter = 0;
        let iSourceRow = 0;
        let iRow = 0;
        let value = undefined;
        let cell = null;

        try {
            if (bCancel == true) {
                transEntryGrid.moveToNextCell(evt);
                return;
            }

            iSourceRow = transEntryGrid.getCurrentRow();
            iRow = iSourceRow;
            transEntryGrid.update();
            for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                if (iCounter > 0) {
                    transEntryGrid.insertRows(iRow + 1, 1, true);

                    transEntryGrid.copyColumnData(iRow, transEntryFieldInfo.Item.ColumnIndex, iRow + 1, transEntryFieldInfo.Item.ColumnIndex);
                    //value = EntryMainMemoryObject.getProductValue(iRow);
                    //EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYPRODUCT, value, iRow + 1);

                    transEntryGrid.markReadonlyColumns();
                    iRow++;
                }
                cell = EntryMainUI.getElement(transEntryFieldInfo.BatchNo, iRow).Value;
                cell.clear();

                cell.setCellText(arrData[iCounter].BatchNo, arrData[iCounter].BatchNo);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, arrData[iCounter].BatchNo, cell.iRow);

                cell.setCellData("batchid", arrData[iCounter].BatchId);
                cell.setCellData("batchno", arrData[iCounter].BatchNo);
                if (EntryMain.m_objTrans
                    && EntryMain.m_objTrans.BodyData
                    && EntryMain.m_objTrans.BodyData[cell.iRow - 1]
                    && EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales
                    && EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales.BatchNo) {

                    EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales.BatchNo.BatchId = arrData[iCounter].BatchId;
                    EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales.BatchNo.BatchNo = arrData[iCounter].BatchNo;
                }

                EntryMainStockRevaluation.setBalanceQty(iRow, arrData[iCounter].BalanceQty);
                EntryMainStockRevaluation.setAvgRate(iRow, arrData[iCounter].BatchRate);
                EntryMainStockRevaluation.setBalanceStockValue(iRow, arrData[iCounter].BalanceStockValue);
                EntryMainStockRevaluation.setNewAvgRate(iRow, arrData[iCounter].NewAvgRate);
                EntryMainStockRevaluation.setNewStockValue(iRow, arrData[iCounter].NewStockValue);
            }

            transEntryGrid.gotoCell(iSourceRow, transEntryFieldInfo.Code.ColumnIndex);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainStockRevaluation.resultBatch} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

