    getRowTransBodyObject: function (iRow) {
        let iCounter = 0;
        let iIndex = 0;
        let iAccountTypeId = 0;
        let objData = null;
        let obj = null;
        let cell = null;
        let result = null;
        let arrFields = undefined;
        let objMetaData = null;
        let objResult = null;

        try {
            objResult = COMMON.prototype.getEmptyResultObject();
            objResult.lValue = 0;
            objResult.sValue = "";
            objResult.data = null;
            objResult.BookType = 0;
            objResult.CodeType = 0;

            // Hasnain sir suggested to create duplicate instead of copy data.
            objData = DataType.createDuplicateObject(EntryMain.m_objTrans.BodyData[iRow - 1]);

            if (transEntryInfo.BaseVoucherType == eVTTYPE.JOURN) {
                objResult.BookType = eAccountTypes.Assets;
            }
            else if (transEntryInfo.BaseVoucherType == eVTTYPE.OPBAL) {
                objResult.BookType = eAccountTypes.Assets;
            }
            else {
                if (transEntryFieldInfo.Book.FieldId > 0) {
                    iAccountTypeId = EntryMainMemoryObject.getBookTypeId(iRow);
                    objResult.BookType = iAccountTypeId;
                }
                else {
                    iAccountTypeId = eAccountTypes.None;
                    objResult.BookType = iAccountTypeId;
                }
            }

            if (transEntryFieldInfo.Code.FieldId > 0) {
                iAccountTypeId = EntryMainMemoryObject.getCodeTypeId(iRow);
                objResult.CodeType = iAccountTypeId;
            }
            else {
                iAccountTypeId = eAccountTypes.None;
                objResult.CodeType = iAccountTypeId;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.MetaData.BodyAttachment.length; iCounter++) {
                iIndex = transEntryGlobal.FieldHelper.MetaData.BodyAttachment[iCounter];
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];

                for (iIndex = 0; iIndex < objData.BodyExtra.length; iIndex++) {
                    if (objData.BodyExtra[iIndex].ID == objMetaData.iFieldId) {
                        if (DataType.isValidObject(objData.BodyExtra[iIndex].Tag) == true) {
                            obj = {};
                            obj.iFieldId = objMetaData.iFieldId;
                            obj.sFileName = objData.BodyExtra[iIndex].Tag.sFileName;
                            obj.sData = objData.BodyExtra[iIndex].Tag.sData;

                            objData.BodyExtra[iIndex].Tag = DataType.toString(obj);
                        }

                        break;
                    }
                }
            }

            objData.LocalExchangeRate = EntryMainMemoryObject.getLocalExchangeRate(iRow, true);


            if (transEntryInfo.isItSales == true) {
                objData.Sales.BatchNo = transEntryFields.getBatchInfo(iRow);

                objData.Sales.RMANos = transEntryRMA.getStringArray(objData.Sales.RMANos);

                objData.Sales.Rate = FNumberOperation.mul(objData.Sales.OrigRate, objData.ExchangeRate);

                if (objData.Sales.Unit > 0) {
                    objData.Sales.BaseQuantity = FNumberOperation.mul(transEntryUnit.getConversionValue(iRow), objData.Sales.Quantity);
                }

                objData.Sales.ScreenData = [];

                arrFields = transEntryFieldInfo.getScreenFields();
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    objMetaData = arrFields[iCounter].MetaData;

                    cell = transEntryGrid.getCellElement(iRow, arrFields[iCounter].ColumnIndex, true);
                    obj = transEntryScreenData.getBodyObject(cell, objMetaData, true);

                    objData.Sales.ScreenData.push(obj);
                }
            }

            if (transEntryLinks.isColumnExist() == true) {
                objData.Links = undefined;
                result = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRow);
                if (DataType.arrayLength(result) > 0) {
                    objData.Links = result;
                }
            }

            if (transEntryFieldInfo.Billwise.ColumnIndex > -1) {
                objData.BillwiseData = undefined;
                result = transEntryFields.getBillwise(iRow);
                if (DataType.isValidObject(result) == true) {
                    objData.BillwiseData = DataType.toString(result);
                }
            }

            objResult.data = objData;
            objResult.lValue = 1;

        }
        catch (err) {
            objResult.lValue = -1;
            objResult.sValue = err.message;
        }

        return (objResult);
    },

    getFocusFormatFirstRowBodyData: function (bIgnoreAttachmentData, bIgnoreBillwiseData) {
        let iCounter = 0;
        let iIndex = 0;
        let iRow = 1;
        let arrFields = undefined;
        let objMetaData = null;
        let objBody = null;
        let cell = null;
        let obj = null;

        try {
            objBody = DataType.createDuplicateObject(EntryMain.m_objTrans.BodyData[iRow - 1]);
            objBody.BillwiseData = null;

            if (bIgnoreBillwiseData == false) {
                objBody.BillwiseData = EntryMainBillwise.getData(iRow);
            }

            if (EntryMain.m_objTrans.BodyData[iRow - 1].Sales) {
                if (objBody.Sales.RMANos) {
                    objBody.Sales.RMANos = transEntryRMA.getStringArray(objBody.Sales.RMANos);
                }
            }

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;

                if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                    if (objMetaData.iDataTypeId == eMasterDataType.Picture || objMetaData.iDataTypeId == eMasterDataType.DocumentViewer) {
                        for (iIndex = 0; iIndex < objBody.BodyExtra.length; iIndex++) {
                            if (objBody.BodyExtra[iIndex].ID == objMetaData.iFieldId) {
                                if (bIgnoreAttachmentData == true) {
                                    objBody.BodyExtra[iIndex].Tag = null;
                                }
                                else if (DataType.isValidObject(objBody.BodyExtra[iIndex].Tag) == true) {
                                    obj = {};
                                    obj.FileName = objData.BodyExtra[iIndex].Tag.sFileName;
                                    obj.FileData = objData.BodyExtra[iIndex].Tag.sData;
                                    objBody.BodyExtra[iIndex].Tag = obj;
                                }
                                break;
                            }
                        }
                    }

                    continue;
                }

                cell = transEntryGrid.getCellObject(iRow, iCounter);
                if (DataType.isValidObject(cell) == false) {
                    continue;
                }

                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_CREDITDAYSBASEDDISCOUNT:
                    case eVTFIELDID.FDF_BODYJRNDEBIT:
                        if (objBody.OriginalAmounts[0] == 0) {
                            objBody.OriginalAmounts[0] = FNumberOperation.negated(FNumberOperation.convert(cell.getCellData()));
                            objBody.OriginalAmounts[1] = FNumberOperation.negated(objBody.OriginalAmounts[0]);
                        }
                        break;
                    case eVTFIELDID.FDF_BODYJRNCREDIT:
                        if (objBody.OriginalAmounts[0] == 0) {
                            objBody.OriginalAmounts[0] = FNumberOperation.convert(cell.getCellData());

                            objBody.OriginalAmounts[1] = FNumberOperation.negated(objBody.OriginalAmounts[0]);
                        }
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.getFocusFormatFirstRowBodyData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objBody);
    },

