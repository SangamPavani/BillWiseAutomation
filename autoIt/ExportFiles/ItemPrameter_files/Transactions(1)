        this.getColumnValue = function(field, bName) {
            let iRow = 0;
            let dInput = 0;
            let dOutput = 0;
            let bScreenField = false;
            let arrData = null;
            let objInfo = null;
            let objMetaData = null;
            let objTemp = null;
            let cell = null;
            let obj = null;

            try {
                objInfo = EntryMainUI.getBodyFieldInfo(field, bName);
                if(objInfo.Area != eTranEntryFieldArea.Body) {
                    return;
                }

                arrData = [];
                objMetaData = objInfo.MetaData;
                if (objInfo.ColumnIndex >= 0) {
                    if((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                        bScreenField = true;
                    }

                    for(iRow = 1; iRow < transEntryGrid.getTotalRows(); iRow++) {
                        if (EntryMainBody.isRowEditable(iRow) == false) {
                            continue;
                        }

                        cell = transEntryGrid.getCellObject(iRow, objInfo.ColumnIndex);
                        if(bScreenField == true) {
                            objTemp = transEntryScreenData.getBodyObject(cell, objMetaData);
                            objTemp.Row = iRow;
                            arrData.push(objTemp);
                        }
                        else {
                            switch(objMetaData.iDataTypeId)
                            {
                            case eMasterDataType.Text:
                                if (objMetaData.iFieldId == eVTFIELDID.FDF_LINK) {
                                }
                                else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                                }
                                else if (objMetaData.iFieldId == eVTFIELDID.FDF_RMANO) {
                                    objTemp = cell.getCellText();
                                    if(DataType.isNullOrEmpty(objTemp, true) == false) {
                                        obj = {};
                                        obj.iRow = iRow;
                                        obj.Data = objTemp;
                                        arrData.push(obj);
                                    }
                                }
                                else if (objMetaData.iFieldId == eVTFIELDID.FDF_BINS || objMetaData.iFieldId == eVTFIELDID.FDF_BINS2) {
                                    objTemp = cell.getCellData();
                                    if(DataType.isNullOrEmpty(objTemp, true) == false) {
                                        objTemp = DataType.stringToObject(objTemp);
                                        if(objTemp.lValue < 1) {
                                            break;
                                        }

                                        obj = {};
                                        obj.iRow = iRow;
                                        obj.iFieldId = objMetaData.iFieldId;
                                        obj.sFieldName = objMetaData.sFieldName;
                                        obj.Data = objTemp.data;
                                        arrData.push(obj);
                                    }
                                }
                                else if (objMetaData.iFieldId == eVTFIELDID.FDF_RESERVEQUANTITY) {
                                }
                                else if (objMetaData.iFieldId == eVTFIELDID.FDF_DEPTAPPROP) {
                                    obj = {};
                                    obj.iRow = iRow;
                                    obj.Data = cell.getCellData();
                                    arrData.push(obj);
                                }
                                else {
                                    obj = {};
                                    obj.iRow = iRow;
                                    obj.Data = cell.getCellText();
                                    arrData.push(obj);
                                }
                                break;
                            }
                        }
                    }

                    if(arrData.length > 0 && bScreenField == true) {
                        dInput = 0;
                        dOutput = 0;

                        for (iRow = 0; iRow < arrData.length; iRow++) {
                            dInput = DataType.add(dInput, arrData[iRow].Input);
                            dOutput = DataType.add(dOutput, arrData[iRow].Value);
                        }

                        arrData.push({ "TotalInput": dInput, "TotalOutput": dOutput });
                    }
                }
            }
            catch(err) {
                transEntryGlobal.writeErrorLog("{transEntryValue.getColumnValue} " + err.message, GlobalPref.getResourceValue("Exception"));
            }

            return(arrData);
        }
    };
}

