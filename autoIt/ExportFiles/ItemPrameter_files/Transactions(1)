    displayBodyData: function (arrData, iCurrentRow, objDataInfo, arrMasterData) {
        transEntryGlobal.writeConsoleLog("Enter: {EntryMainUI.displayBodyData}[CurrentRow='" + iCurrentRow + "'][PendingLinks='" + objDataInfo.bPendingLinks + "'][CallingSource='" + objDataInfo.iCallingSource + "']", "royalblue", true);

        let iRowCounter = 0;
        let iRequiredRows = 0;
        let iCounter = 0;
        let iIndex = 0;
        let iTotal = 0;
        let sGridCtrlId = "";
        let iUnitMasterValueIndex = -1;
        let iUnitMetaDataIndex = -1;
        let bDescriptionMappingExist = false;
        let bInitFragment = false;
        let arrColData = null;
        let objMetaData = null;
        let arrMasterValueIndex = [];
        let arrMasterMetaDataIndex = [];
        let arrDeleteRow = [];
        let arrSetInfo = [];
        let arrAuthStatus = [];
        let temp = null;
        let bInvalidRow = false;
        let arrNewRowIndex = [];
        let arrFields = undefined;
        let arrUnits = [];
        let arrMappings = [];
        let arrUnitMasterValueIndex = [];
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objWatch = undefined;

        try {
            if (transEntryGlobal.debugBodyDisplay == true) {
                debugger
            }

            objWatch = new FStopWatch();
            objWatch.start();

            if (DataType.isValidObject(arrMasterData) == false || DataType.arrayLength(arrMasterData) < 1) {
                arrMasterData = [];
            }

            sGridCtrlId = transEntryGrid.getGridId();

            if (DataType.isValidObject(iCurrentRow) == true) {
                bInvalidRow = false;
            }
            else {
                bInvalidRow = true;
            }

            iCurrentRow = DataType.toInt(iCurrentRow);


            bDescriptionMappingExist = false;

            if (DataType.toBoolean(objDataInfo.bPendingLinks) == true
                && transEntryFieldInfo.Item.FieldId > 0
                && transEntryFieldInfo.Description.FieldId > 0) {
                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Body.length; iCounter++) {
                    objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iCounter];
                    if (objMetaData.iFieldId != eVTFIELDID.FDF_LINK) {
                        continue;
                    }

                    if (transEntryLinks.getBaseVoucherType(objMetaData.iMasterLink) != objDataInfo.iBaseVoucher) {
                        continue;
                    }

                    arrMappings = objMetaData.Tag.Mappings;
                    if (transEntryLinks.isFieldExistInMappingList(transEntryFieldInfo.Description.FieldId, arrMappings) == true) {
                        bDescriptionMappingExist = true;
                    }
                    else {
                        objDataInfo.arrIgnoreFields.push(transEntryFieldInfo.Description.FieldId); // Description is automatically loaded, so ignored for link loading
                    }

                    break;
                }
            }

            if (iCurrentRow < 0) {
                iCurrentRow = EntryMainBody.getNewDataRowIndex() - 1;
            }


            if ((iCurrentRow + 1 + arrData.length) > transEntryGrid.getTotalRows()) {
                iRequiredRows = (iCurrentRow + 1 + arrData.length) - transEntryGrid.getTotalRows();
                transEntryGrid.insertRows(0, iRequiredRows, true);
            }

            bInitFragment = false;
            //if (transEntryInfo.BodySectionNotRequired == false) {
            //    transEntryGridFragment.initFragment(true);
            //    bInitFragment = true;
            //}

            EntryMainBody.setMastersData(arrMasterData);

            for (iRowCounter = 0, iTotal = arrData.length; iRowCounter !== iTotal; iRowCounter++) {
                arrColData = arrData[iRowCounter];

                if (transEntryInfo.BodySectionNotRequired == false) {
                    arrNewRowIndex.push(iRowCounter + iCurrentRow + 1);
                }
                else {
                    if (TRANSACTION_ENTRY.OTHERCHARGES.setLoadedData(arrColData) == true) {
                        continue;
                    }
                }

                temp = EntryMainUI.setBodyRowData(iRowCounter + iCurrentRow + 1,
                                bInvalidRow,
                                arrColData,
                                arrSetInfo,
                                arrMasterMetaDataIndex,
                                arrMasterValueIndex, 
                                arrUnits,
                                arrMasterData,
                                arrDeleteRow,
                                objDataInfo,
                                bDescriptionMappingExist, 
                                iRowCounter);

                arrUnitMasterValueIndex.push(temp.iUnitMasterValueIndex);
                iUnitMasterValueIndex = temp.iUnitMasterValueIndex;
                iUnitMetaDataIndex = temp.iUnitMetaDataIndex;

                if (transEntryInfo.BodySectionNotRequired == false) {
                    transEntryGrid.setRowData(iRowCounter + iCurrentRow + 1, eRowDataName.Amount0, temp.dAmount0);
                    transEntryGrid.setRowData(iRowCounter + iCurrentRow + 1, eRowDataName.Amount1, temp.dAmount1);

                    transEntryGrid.setRowData(iRowCounter + iCurrentRow + 1, eRowDataName.OriginalAmount0, temp.dOriginalAmount0);
                    transEntryGrid.setRowData(iRowCounter + iCurrentRow + 1, eRowDataName.OriginalAmount1, temp.dOriginalAmount1);
                }

                if (temp.AuthStatus) {
                    arrAuthStatus.push(temp.AuthStatus);
                }
            }

            if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                transEntryQuantity.updateTotal();
            }

            EntryMain.m_arrLoadedLinkData = transEntryLinks.getLoadedLinkData();
            if (bInitFragment == true) {
                transEntryGridFragment.initFragment(false);

                for (iCounter = 0; iCounter < arrAuthStatus.length; iCounter++) {
                    transEntryGrid.markRowByAuthStatus(arrAuthStatus[iCounter].Row, arrAuthStatus[iCounter].AuthValue);
                }
            }

            // Update set rows value
            EntryMainSet.updateLoadedRowsData(iCurrentRow + 1, iRowCounter + iCurrentRow, arrSetInfo);

            if (transEntryInfo.BodySectionNotRequired == true) {
                objWatch.stop();

                return (arrNewRowIndex);
            }


            for (iCounter = 0; iCounter < arrMasterData.length; iCounter++) {
                if (DataType.isNullOrEmpty(arrMasterData[iCounter].sError, true) == false) {
                    transEntryGlobal.showAlert(arrMasterData[iCounter].sError, GlobalPref.getResourceValue("Error"));
                }
            }

            iIndex = -1;
            if (arrNewRowIndex.length > 0) {
                iIndex = arrNewRowIndex[0];
            }

            while (arrDeleteRow.length > 0) {
                iRowCounter = arrDeleteRow[arrDeleteRow.length - 1];

                transEntryGrid.deleteRows(iRowCounter, 1);

                arrData.splice(iRowCounter - 1, 1);

                arrDeleteRow.splice(arrDeleteRow.length - 1, 1);

                for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                    if (arrNewRowIndex[iCounter] == iRowCounter) {
                        arrNewRowIndex.splice(iCounter, 1);
                        break;
                    }
                }
            }

            for (iCounter = 0; iCounter < arrNewRowIndex.length; iCounter++) {
                arrNewRowIndex[iCounter] = iIndex + iCounter;
            }

            // Fill Body Masters
            temp = {};
            temp.iCurrentRow = iCurrentRow;
            temp.sGridCtrlId = sGridCtrlId;
            temp.bPendingLinks = objDataInfo.bPendingLinks;
            temp.iCallingSource = objDataInfo.iCallingSource;
            temp.iLoadedDataSource = objDataInfo.iLoadedDataSource;
            temp.iUnitMetaDataIndex = iUnitMetaDataIndex;
            temp.iUnitMasterValueIndex = iUnitMasterValueIndex;
            temp.arrUnitMasterValueIndex = arrUnitMasterValueIndex;
            temp.bDescriptionMappingExist = bDescriptionMappingExist;
            EntryMainBody.fillBodyMasters(arrData, arrMasterMetaDataIndex, arrMasterValueIndex, arrUnits, temp);

            if (DataType.isValidObject(transEntryGlobal.EntryModel.Data) == true && DataType.toBoolean(transEntryGlobal.EntryModel.Data.bPendingLinks) == true) {
                var result = null;
                var value = null;

                arrFields = transEntryFieldInfo.getLayoutFields(true);
                if (arrNewRowIndex.length > 0 && arrFields.length > 0) {
                    EntryMainReevaluate.fetchMasterVariablesValue();
                    EntryMainReevaluate.fetchRatesValue();
                }

                for (iRowCounter = 0; iRowCounter < arrNewRowIndex.length; iRowCounter++) {
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;

                        result = EntryMainCommon.getFormulaDetail(objMetaData.sDefaultValue);

                        // For link loading sql variables are already evaluated on sever in preparedata
                        if (result.lValue == 1 && result.bRefresh == true 
                            && transEntryGlobal.isIgnoreServerCall() == false 
                            && EntryMainPreload.isSQLVariable(result.data) == false) {


                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(result.data, arrNewRowIndex[iRowCounter], null, arrFields[iCounter].ColumnIndex);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            value = objFormulaOutput.RawValue;
                            switch (objMetaData.iDataTypeId) {
                                case eMasterDataType.Number:
                                case eMasterDataType.BigNumber:
                                case eMasterDataType.SmallNumber:
                                case eMasterDataType.TinyNumber:
                                case eMasterDataType.Fraction:
                                case eMasterDataType.NumberList:
                                    value = objFormulaOutput.Value;
                                    break;
                            }

                            //value = EntryMainFormula.evaluateBodyFormula(result.data, arrNewRowIndex[iRowCounter], null, transEntryGlobal.FieldHelper.Column.Layout[iCounter]);
                            EntryMainBody.updateColumnValue(arrNewRowIndex[iRowCounter], arrFields[iCounter].ColumnIndex, objMetaData, value);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.displayBodyData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        objWatch.stop();
        transEntryGlobal.writeConsoleLog("Exit: {EntryMainUI.displayBodyData}[Time=" + objWatch.getDifferenceString() + "]", "royalblue", true);

        return (arrNewRowIndex);
    },

