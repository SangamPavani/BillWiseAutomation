    InwardAutoAllocation:function(arrBinDetails,lstRestrict){
        let i = 0;
        let rowNo = 0;
        let arrBinsQuantity = [];
        let objBinsQuantity = {};
        let dAllocatedQty = 0.0;
        let dRemQty = 0.0;
        let dOrigQty = BinsUI.m_dQuantity;
        let dTotalWeight = 0;
        let dAvailWeight = 0;
        let dRemWt = 0;
        let isConsiderWeight = false;
        let result = null;
        let Bingrid = transBinsPopup.getGridElement();

        try {
            arrBinDetails = BinsUI.getBinOrderBySetting(arrBinDetails, BinsUI.m_Preference.Bins.iPalceItemInward, true);  //Sorting Bins rows according to Pref condtion                          
            FGRIDCONTROL.update(transBinsPopup.getGridElement());
            for (i = 0; i < arrBinDetails.length; i++) {
                if (Bingrid) {
                    result = $.grep($(Bingrid).children("tbody").children(), function (x) {
                        if (x.getAttribute("data-ibinid") == arrBinDetails[i].Id) {
                            return x;
                        }
                    });
                    if (result && result.length > 0) {
                        rowNo = result[0].getAttribute("data-irow");
                    }
                }
                isConsiderWeight = BinsUI.isConsiderWeight(rowNo);
                if (arrBinDetails[i].Group != true){
                    if (arrBinDetails[i].Type == eBinsType.Bin){ // For Bin
                        if(lstRestrict != null){
                            if (lstRestrict.includes(arrBinDetails[i].Id))
                                continue;
                        }
                        if (arrBinDetails[i].Load > 0){// Check if data assigned any bin, then check with load otherwise check with ToBeAllocated
                            if (arrBinDetails[i].FreeSpace <= 0) {
                                continue;
                            }
                            if (BinsUI.m_BinsParam.ProductId > 0) {
                                if (BinsUI.m_iProdCapacity > 0) {// If Product Capacity exits
                                    dRemQty = parseFloat(arrBinDetails[i].FreeQuantity - arrBinDetails[i].ToBeAllocated);
                                }
                                else {
                                    dRemQty = parseFloat(arrBinDetails[i].FreeSpace - arrBinDetails[i].ToBeAllocated);
                                }
                            }
                        }
                        else{
                            if (BinsUI.m_iProdCapacity > 0)// If Product Category exits
                                dRemQty = parseFloat(arrBinDetails[i].FreeQuantity - arrBinDetails[i].ToBeAllocated);
                            else
                                dRemQty = parseFloat(arrBinDetails[i].FreeSpace - arrBinDetails[i].ToBeAllocated);
                        }
                        objBinsQuantity = {};
                        objBinsQuantity.SkidId = 0;
                        objBinsQuantity.Category = 0;
                        objBinsQuantity.Batch = null;
                       
                        //validate weight
                        if (isConsiderWeight) {
                            dTotalWeight = BinsUI.m_dProductWeight * BinsUI.m_dQuantity;
                            dAvailWeight = arrBinDetails[i].WeightAvailable;
                            if (dTotalWeight > dAvailWeight) {
                                dRemWt = dTotalWeight - dAvailWeight;
                                dAllocatedQty = (dAvailWeight * BinsUI.m_dQuantity) / dTotalWeight;
                                dRemQty = BinsUI.m_dQuantity - dAllocatedQty;
                            }
                            else {
                                dAllocatedQty = BinsUI.m_dQuantity;
                                dRemQty = 0;
                            }
                            objBinsQuantity.BinId = arrBinDetails[i].Id;
                            objBinsQuantity.SkidId = arrBinDetails[i].SkidId;
                            objBinsQuantity.Category = arrBinDetails[i].Category;
                            objBinsQuantity.Batch = arrBinDetails[i].Batch;
                            objBinsQuantity.Quantity = dAllocatedQty;
                            arrBinsQuantity.push(objBinsQuantity);
                            BinsUI.m_dQuantity = dRemQty;
                        }
                        else {
                            objBinsQuantity.BinId = arrBinDetails[i].Id;
                            objBinsQuantity.SkidId = arrBinDetails[i].SkidId;
                            objBinsQuantity.Category = arrBinDetails[i].Category;
                            objBinsQuantity.Batch = arrBinDetails[i].Batch;

                            if (dRemQty < BinsUI.m_dQuantity) {
                                objBinsQuantity.Quantity = dRemQty;
                                dAllocatedQty += dRemQty;
                            }
                            else{
                                if (BinsUI.m_dQuantity < 0) {
                                    objBinsQuantity.Quantity = 0;
                                }
                                else {
                                    objBinsQuantity.Quantity = BinsUI.m_dQuantity;
                                }
                            }

                            BinsUI.m_dQuantity -= dRemQty;
                            arrBinsQuantity.push(objBinsQuantity);
                            if (BinsUI.m_dQuantity <= 0)
                                break;
                        }
                    }
                    else { // For Floor 
                        if (BinsUI.m_dQuantity > 0) {
                            objBinsQuantity = {};
                            //free space and quantity are not checked here 
                            //validate weight
                            if (isConsiderWeight) {
                                dTotalWeight = BinsUI.m_dProductWeight * BinsUI.m_dQuantity;
                                dAvailWeight = arrBinDetails[i].WeightAvailable;
                                if (dTotalWeight > dAvailWeight) {
                                    dRemWt = dTotalWeight - dAvailWeight;
                                    dAllocatedQty = (dAvailWeight * dOrigQty) / dTotalWeight;
                                    dRemQty = dOrigQty - dAllocatedQty;
                                }
                                else {
                                    dAllocatedQty = BinsUI.m_dQuantity;
                                    dRemQty = 0;
                                    //dRemQty = BinsUI.m_dQuantity;
                                } 
                            }
                            else {
                                dAllocatedQty = BinsUI.m_dQuantity;
                                dRemQty = 0;
                            }
                            objBinsQuantity.BinId = arrBinDetails[i].Id;
                            objBinsQuantity.SkidId = arrBinDetails[i].SkidId;
                            objBinsQuantity.Category = arrBinDetails[i].Category;
                            objBinsQuantity.Batch = arrBinDetails[i].Batch;
                            objBinsQuantity.Quantity = dAllocatedQty;
                            arrBinsQuantity.push(objBinsQuantity);
                            BinsUI.m_dQuantity = dRemQty;
                            if (BinsUI.m_dQuantity <= 0)
                                break;
                        }
                    }
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("BINS.InwardAutoAllocation" + err.message, "Exception");
        }

        return arrBinsQuantity;
    },

