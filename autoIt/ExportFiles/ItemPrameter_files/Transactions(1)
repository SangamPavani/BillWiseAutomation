    adjustColumnWidth: function (eleGrid) {
        let iCounter = 0;
        let iColumn = 0;
        let iWidth = 0;
        let iFixedWidth = 0;
        let iExtraWidth = 0;
        let iScreenWidth = 0;
        let arrCols = null;
        let arrWidth = null;

        try {
            arrCols = [];

            eleGrid = FUIElement.getValidElement(eleGrid);
            if (eleGrid.getBoundingClientRect().width == 0) {
                return;
            }


            arrWidth = FGRIDCONTROL.getColumnWidthArray(eleGrid);
            for (iCounter = 6; iCounter < arrWidth.length; iCounter++) {
                if (arrWidth[iCounter] > 0) {
                    iWidth += arrWidth[iCounter];
                    arrCols.push(iCounter);
                }
            }

            if (arrCols.length < 1) {
                return;
            }

            if (arrWidth.length > 0) {
                iFixedWidth = arrWidth[0]; // Serial No
            }

            if (arrWidth.length > 1) {
                iFixedWidth += arrWidth[1]; // Check box
            }

            FGRIDCONTROL.autoAdjustColumnWidthNew(eleGrid, arrCols);

            arrWidth = FGRIDCONTROL.getColumnWidthArray(eleGrid);
            for (iCounter = 6, iWidth = 0; iCounter < arrWidth.length; iCounter++) {
                if (arrWidth[iCounter] > 0) {
                    iWidth += arrWidth[iCounter];
                }
            }

            iScreenWidth = eleGrid.parentElement.getBoundingClientRect().width - 5;
            if ((iFixedWidth + iWidth + arrCols.length) < (iScreenWidth - 5)) {
                iExtraWidth = ((iScreenWidth - 5) - (iFixedWidth + iWidth)) / arrCols.length;

                for (iCounter = 0; iCounter < arrCols.length; iCounter++) {
                    iColumn = arrCols[iCounter];
                    FGRIDCONTROL.changeColumnWidth(eleGrid, iColumn, arrWidth[iColumn] + iExtraWidth);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.adjustColumnWidth} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    m_Workflow: null, // Stores All data of Workfow. Used in workflow searching.

    Search: {
        onSearch: function (sSearchText, iSearchType, eleGrid, iSearchOn, bFromPopup) {
            let sText = "";
            let iRow = 0;
            let iCounter = 0;
            let iIndex = 0;
            let iFound = 0;
            let iPageNo = 0;
            let arrDisplayColumnIndex = null;
            let arrColumn = null;
            let arrData = null;
            let eleSearchOn = null;
            let arrIndex = null;
            let obj = null;

            try {
                arrColumn = transEntryWorkflowInfo.Columns;
                if (arrColumn.length == 0) {
                    return;
                }

                arrData = transEntryWorkflowInfo.RawData;
                if (DataType.arrayLength(arrData) < 1) {
                    return;
                }

                eleGrid = FUIElement.getValidElement(eleGrid);
                eleSearchOn = WORKFLOW.getSearchOnElement(bFromPopup);

                arrDisplayColumnIndex = [];
                for (iCounter = 0; iCounter < arrColumn.length; iCounter++) {
                    obj = {};
                    obj.Index = iCounter + transEntryWorkflowInfo.DisplayStartColIndex;
                    obj.Name = arrColumn[iCounter].Name;
                    obj.DataTypeId = arrColumn[iCounter].Tag.DataTypeId;
                    obj.FieldId = arrColumn[iCounter].Tag.FieldId;

                    arrDisplayColumnIndex.push(obj);
                }

                if (eleSearchOn.selectedIndex > 0) {
                    arrDisplayColumnIndex = [arrDisplayColumnIndex[eleSearchOn.selectedIndex - 1]];
                }

                if (arrDisplayColumnIndex.length == 0) {
                    return;
                }

                iFound = 0;
                arrIndex = [];
                sSearchText = sSearchText.toLowerCase();
                for (iRow = 0; iRow < arrData.length; iRow++) {
                    if (DataType.isNullOrEmpty(sSearchText) == true) {
                        transEntryWorkflowInfo.HiddenData[iRow].bSelected = false;
                        continue;
                    }

                    for (iCounter = 0; iCounter < arrDisplayColumnIndex.length; iCounter++) {
                        iIndex = arrDisplayColumnIndex[iCounter].Index;

                        sText = "";
                        switch (arrDisplayColumnIndex[iCounter].DataTypeId) {
                            case eMasterDataType.Text:
                                sText = arrData[iRow].CellData[iIndex].toLowerCase();
                                break;
                            case eMasterDataType.Fraction:
                                sText = DataType.toString(arrData[iRow].CellData[iIndex]);
                                break;
                            case eMasterDataType.Date:
                                if (DataType.isInteger(arrData[iRow].CellData[iIndex]) == true) {
                                    sText = FDate.intToString(arrData[iRow].CellData[iIndex],
                                                                EntryMain.m_DateFormat,
                                                                eCalendarType.None,
                                                                LANGUAGE.get("ENGLISH"));
                                }
                                else {
                                    sText = arrData[iRow].CellData[iIndex];
                                }
                                break;
                            default:
                                sText = DataType.toString(arrData[iRow].CellData[iIndex]);
                                break;
                        }

                        if (iSearchType == 0) { // Containing
                            if (DataType.stringIncludes(sText, sSearchText, true) == true) {
                                break;
                            }
                        }
                        else if (iSearchType == 1) { // Beginning
                            if (DataType.stringStartsWith(sText, sSearchText, true) == true) {
                                break;
                            }
                        }
                        else if (iSearchType == 2) { // Ending
                            if (DataType.stringEndsWith(sText, sSearchText, true) == true) {
                                break;
                            }
                        }
                        else if (iSearchType == 3) { // Equal
                            if (sText.toLowerCase() === sSearchText.toLowerCase()) {
                                break;
                            }
                        }
                    }

                    if (iCounter == arrDisplayColumnIndex.length) { // Not found
                        transEntryWorkflowInfo.HiddenData[iRow].bSelected = false;
                    }
                    else { // found
                        transEntryWorkflowInfo.HiddenData[iRow].bSelected = true;
                        iFound++;

                        arrIndex.push(iRow);
                    }
                }

                if (transEntryWorkflowInfo.HideUnmatchedRow == true) {
                    if (DataType.isNullOrEmpty(sSearchText) == true) {
                        transEntryWorkflow.fillData(eleGrid, 1, false, true);
                        transEntryWorkflow.hideDataNavSection(eleGrid, false);
                    }
                    else {
                        transEntryWorkflow.fillDataFromIndex(eleGrid, arrIndex);
                        transEntryWorkflow.hideDataNavSection(eleGrid, true);
                    }
                }
                else {
                    if (arrIndex.length > 0) {
                        iPageNo = transEntryWorkflow.Data.findPageNoFromDataIndex(arrIndex[0]);
                        if (iPageNo > 0) {
                            transEntryWorkflow.fillData(eleGrid, iPageNo, false, true);
                            transEntryWorkflow.makeSelectedRowVisibile(eleGrid);
                        }
                    }
                }
            }
            catch (err) {
                transEntryGlobal.writeErrorLog("{transEntryWorkflow.Search.onSearch} " + err.message, GlobalPref.getResourceValue("Exception"));
            }
        }
    }
};

transEntryWorkflow.Data = {
    consolidateData: function () {
        let sVoucherNo = "";
        let iCounter = 0;
        let iIndex = 0;
        //let arrData = null;
        let arrFixedValue = null;
        let objRowInfo = null;

        try {
            transEntryWorkflow.m_Workflow.arrConsolidatedData = [];

