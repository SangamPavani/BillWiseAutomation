                        objLinkDef = objMetaData.Tag;
                        objLinkData = transEntryLinks.getDataFromString(sAllLinkData, objLinkDef.LinkId);

                        if (DataType.isValidObject(objLinkData) == false) {
                            if (transEntryGlobal.FieldHelper.Column.Links.length == 1) {
                                sValue = transEntryGrid.getColumnHeading(transEntryGlobal.FieldHelper.Column.Links[iCounter1]);
                                if (DataType.isNullOrEmpty(sValue) == false) {
                                    arrColumnNames.push(sValue);

                                    transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                                }
                            }
                            else {
                                if (objLinkDef.IsLinkOptional) {
                                    for (iIndex = 0; iIndex < transEntryGlobal.FieldHelper.Column.Links.length; iIndex++) {
                                        if (iIndex == iCounter1) {
                                            continue;
                                        }

                                        objMetaData = transEntryGlobal.getBodyMetaDataObject(transEntryGlobal.FieldHelper.MetaData.Links[iIndex]);
                                        objLinkDef = objMetaData.Tag;
                                        objLinkData = transEntryLinks.getDataFromString(sAllLinkData, objLinkDef.LinkId);
                                        if (DataType.isValidObject(objLinkData) == true) {
                                            break;
                                        }
                                    }

                                    if (iIndex >= transEntryGlobal.FieldHelper.Column.Links.length) {
                                        sValue = transEntryGrid.getColumnHeading(transEntryGlobal.FieldHelper.Column.Links[iCounter1]);
                                        if (DataType.isNullOrEmpty(sValue) == false) {
                                            arrColumnNames.push(sValue);

                                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                                        }
                                    }
                                }
                                else {
                                    sValue = transEntryGrid.getColumnHeading(transEntryGlobal.FieldHelper.Column.Links[iCounter1]);
                                    if (DataType.isNullOrEmpty(sValue) == false) {
                                        arrColumnNames.push(sValue);

                                        transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                                    }
                                }
                            }
                        }
                    }
                }

                arrFields = transEntryFieldInfo.getScreenFields();
                for (iCounter1 = 0; iCounter1 < arrFields.length; iCounter1++) {
                    if(objFlags.lValue > 0 && objFlags.data.FreeQty == true) {
                        break;
                    }

                    dValue = 0;

                    objMetaData = arrFields[iCounter1].MetaData;

                    //var temp = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                    obj = DataType.stringToObject(body[EntryMainUI.getBodyControlId(objMetaData.iFieldId)]);

                    if (obj.lValue < 1 && objMetaData.bMandatory == true) {
                        sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                        if (DataType.isNullOrEmpty(sValue) == false) {
                            arrColumnNames.push(sValue);

                            transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                        }
                    }
                    else {
                        obj = obj.data;
                        dValue = DataType.toDecimal(obj.Input);
                        if (objMetaData.bMandatory == true && DataType.toString(obj.Input) == "") {
                            sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                            if (DataType.isNullOrEmpty(sValue) == false) {
                                arrColumnNames.push(sValue);

                                transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                            }
                        }
                    }

                    validate = EntryMainValidate.checkMinMaxRange(dValue, DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                    if (validate.bInvalid == true) {
                        sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                        transEntryGlobal.showAlert(sValue + validate.sMessage + validate.dValue);

                        return (false);
                    }

                    if (DataType.isNullOrEmpty(objMetaData.sRestrictFormula) == false) {
                        arrFormula = objMetaData.sRestrictFormula.split(';');
                        arrMessage = objMetaData.sRestrictMessage.split(';');
                        
                        for (iIndex = arrMessage.length; iIndex < arrFormula.length; iIndex++) {
                            arrMessage.push(GlobalPref.getResourceValue("EntryRestrict") + " for '" + objMetaData.sFieldName + "'.");
                        }

                        for (iIndex = 0; iIndex < arrMessage.length; iIndex++) {
                            if (DataType.isNullOrEmpty(arrMessage[iIndex], true) == true) {
                                arrMessage[iIndex] = GlobalPref.getResourceValue("EntryRestrict") + " for '" + objMetaData.sFieldName + "'.";
                            }
                        }

                        for (iIndex = 0; iIndex < arrFormula.length; iIndex++) {
                            sFormula = arrFormula[iIndex];
                            if (DataType.isNullOrEmpty(sFormula, true) == true) {
                                continue;
                            }

                            if (DataType.stringIncludes(sFormula, "?") == false) {
                                sFormula = sFormula + "?1:0";
                            }

                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iCounter + 1, null, arrFields[iCounter1].ColumnIndex, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            if (objFormulaOutput.Value > 0) {
                                transEntryInvalidRows.add(iCounter + 1, arrFields[iCounter1].ColumnIndex, arrMessage[iIndex], GlobalPref.getResourceValue("EntryRestrict"));
                            }
                        }
                    }
                }

                arrFields = transEntryFieldInfo.getLayoutFields(true);
                for (iCounter1 = 0; iCounter1 < arrFields.length; iCounter1++) {
                    objMetaData = arrFields[iCounter1].MetaData;

                    sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                    switch (objMetaData.iDataTypeId) {
                        case eMasterDataType.Text:
                            sValue = body[sId];
                            if (objMetaData.bMandatory == true && DataType.isNullOrEmpty(sValue, true) == true) {
                                sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                                if (DataType.isNullOrEmpty(sValue) == false) {
                                    arrColumnNames.push(sValue);

                                    transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                                }
                            }
                            break;
                        case eMasterDataType.Date:
                        case eMasterDataType.Time:
                            dValue = DataType.toInt(body[sId]);
                            if (objMetaData.bMandatory == true && dValue <= 0) {
                                sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                                if (DataType.isNullOrEmpty(sValue) == false) {
                                    arrColumnNames.push(sValue);

                                    transEntryGlobal.writeErrorLog("'" + sValue + "' column value missing in row " + (iCounter + 1));
                                }
                            }
                            break;
                        case eMasterDataType.Number:
                        case eMasterDataType.Fraction:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            dValue = DataType.toDecimal(body[sId]);
                            validate = EntryMainValidate.checkMinMaxRange(dValue, DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                            if (validate.bInvalid == true) {
                                sValue = transEntryGrid.getColumnHeading(arrFields[iCounter1].ColumnIndex);
                                transEntryGlobal.showAlert(sValue + validate.sMessage + validate.dValue);

                                return (false);
                            }
                            break;
                    }
                }
            }

            if (arrColumnNames.length > 0) {
                transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgProvideMandatoryData") + " " + DataType.arrayToCSV(arrColumnNames), GlobalPref.getResourceValue("Error"));

                return (false);
            }

            if (transEntryInvalidRows.display() > 0) {
                return (false);
            }

            if (iMaskedVoucherType == eVTTYPE.FRXJV || iMaskedVoucherType == eVTTYPE.JOURN) {
                dDr = 0;
                dCr = 0;
                for (iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                    body = objData.Body[iCounter];
                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNDEBIT);
                    dValue = DataType.toDecimal(body[sId]);

                    if (dValue != 0) {
                        if (transEntryFieldInfo.Currency.ColumnIndex > -1) {
                            sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYEXCHANGERATE);
                            dExchangeRate = DataType.toDecimal(body[sId]);
                            if (dExchangeRate != 0) {
                                dValue = DataType.mul(dValue, dExchangeRate);
                                //dValue = DataType.toDecimal(dValue, transEntryCurrency.getDecimals(0, true), true);
                            }
                        }

                        dDr = DataType.add(dDr, dValue);
                    }

                    sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYJRNCREDIT);
                    dValue = DataType.toDecimal(body[sId]);

                    if (dValue != 0) {
                        if (transEntryFieldInfo.Currency.ColumnIndex > -1) {
                            sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYEXCHANGERATE);
                            dExchangeRate = DataType.toDecimal(body[sId]);
                            if (dExchangeRate != 0) {
                                dValue = DataType.mul(dValue, dExchangeRate);
                                //dValue = DataType.toDecimal(dValue, transEntryCurrency.getDecimals(0, true), true);
                            }
                        }

                        dCr = DataType.add(dCr, dValue);
                    }
                }

                dDr = DataType.toDecimal(dDr, transEntryCurrency.getDecimals(0, true), true);
                dCr = DataType.toDecimal(dCr, transEntryCurrency.getDecimals(0, true), true);

                dDr = FNumberOperation.toFixed(dDr, 6);
                dDr = FNumberOperation.convert(dDr);

                dCr = FNumberOperation.toFixed(dCr, 6);
                dCr = FNumberOperation.convert(dCr);

                if (FNumberOperation.isNotEqualTo(dDr, dCr) == true) {
                    dAllowedPerc = 7;
                    dPrefValue = transEntryInfo.MiscellaneousPref.iAllowDifferenceForexJV;

                    if (dPrefValue > 0) {
                        dAllowedPerc = dPrefValue;
                    }

                    //dAllowedPerc /= 100;
                    dAllowedPerc = FNumberOperation.div(dAllowedPerc, 100);

                    dDiffValue = FNumberOperation.sub(dDr, dCr);
                    dDiffAbsValue = FNumberOperation.abs(dDiffValue);
                    dMax = FNumberOperation.max([dDr, dCr]);
                    dAllowedPerc = FNumberOperation.mul(dMax, dAllowedPerc);

                    //if (iMaskedVoucherType != eVTTYPE.FRXJV || Math.abs(dDr - dCr) > (Math.max(dDr, dCr) * dAllowedPerc)) {
                    if (iMaskedVoucherType != eVTTYPE.FRXJV || FNumberOperation.isGreaterThan(dDiffAbsValue, dAllowedPerc) == true) {
                        sMessage = GlobalPref.getResourceValue("DrCrNotEqual");
                        sMessage += ". Dr - " + dDr + " Cr - " + dCr + ". Add " + dDiffAbsValue + " to ";
                        if (dDr > dCr) {
                            sMessage += "Cr";
                        }
                        else {
                            sMessage += "Dr";
                        }

                        transEntryGlobal.showAlert(sMessage, GlobalPref.getResourceValue("Error"));

                        return (false);
                    }


                    //if (iMaskedVoucherType != eVTTYPE.FRXJV || Math.abs(dDr - dCr) > (Math.max(dDr, dCr) * 0.05))
                    //{
                    //    sMessage = GlobalPref.getResourceValue("DrCrNotEqual");
                    //    sMessage += ". Dr - " + dDr + " Cr - " + dCr + ". Add " + Math.abs(dDr - dCr) + " to ";
                    //    if(dDr > dCr) {
                    //        sMessage += "Cr";
                    //    }
                    //    else {
                    //        sMessage += "Dr";
                    //    }

                    //    transEntryGlobal.showAlert(sMessage, GlobalPref.getResourceValue("Error"));

                    //    return(false);
                    //}
                }
            }

            if (bResult == true && DataType.isNullOrEmpty(transEntryInfo.Settings.RestrictFormula, true) == false) {
                transEntryInvalidRows.clear();

                sFormula = "(" + transEntryInfo.Settings.RestrictFormula + "?1:0)";
                for (iCounter = 0; iCounter < objData.Body.length; iCounter++) {
                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, iCounter + 1);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                    if (objFormulaOutput.Value > 0) {
                        if (DataType.isNullOrEmpty(transEntryInfo.Settings.RestrictFormulaMessage, true) == false) {
                            sMessage = transEntryInfo.Settings.RestrictFormulaMessage;
                        }
                        else {
                            sMessage = GlobalPref.getResourceValue("msgRestrictionCantSaveDoc");
                        }

                        transEntryGrid.showRowSymbol(iCounter + 1, true);

                        if (transEntryInfo.Settings.WarnAndStop == 0) {
                            transEntryGlobal.showAlert(sMessage, "Row No: " + (iCounter + 1));
                            return (false);
                        }
                        else {
                            FUIElement.showAlert(sMessage);
                        }

                        bResult = transEntryInfo.Settings.WarnAndStop == 0 ? false : true;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainValidate.validateData} " + err.message, GlobalPref.getResourceValue("Exception"));
            bResult = false;
        }

        return (bResult);
    },

