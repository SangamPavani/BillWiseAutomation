    DocumentUpdateMasterGridData: function (arrVoucherMasters) {
        let gridId = "";
        let iTotal = 0;

        gridId = CONFIGURETRANS.DOCUMENTS.getTagsGridId();
        for (var rowCount = 0; rowCount < arrVoucherMasters.length; rowCount++) {
            iTotal = CONFIGURETRANS.DOCUMENTS.getTotalTagsRow();
            if ((rowCount + 1) >= iTotal) {
                FGRIDCONTROL.insertRows(gridId, 0, 1);
            }

            for (var colCount = 0; colCount < 6; colCount++) {
                var cellObj = FGRIDCONTROL.getCellObject(gridId, rowCount + 1, colCount + 1);
                if (COMMON.prototype.isValidObject(cellObj) == true) {
                    switch (colCount) {
                        case 0:
                            var MasterDropDown = document.getElementById("doc_TagsTableMasterDropDown");
                            MasterDropDown.value = arrVoucherMasters[rowCount].MasterType;
                            if (MasterDropDown.selectedOptions.length > 0) {
                                cellObj.setCellText(MasterDropDown.selectedOptions[0].textContent);
                                cellObj.setCellData("value", MasterDropDown.value);
                            }
                            break;
                        case 1:
                            var Mapdropdown = document.getElementById("doc_TagsPositionDropDown");
                            Mapdropdown.value = arrVoucherMasters[rowCount].Position;
                            if (Mapdropdown.selectedOptions.length > 0) {
                                cellObj.setCellText(Mapdropdown.selectedOptions[0].textContent);
                                cellObj.setCellData("value", Mapdropdown.value);
                            }
                            break;
                        case 2:
                            var sDepText = "";
                            var arrDependentMaster = arrVoucherMasters[rowCount].ArrDependentMaster;
                            if (arrDependentMaster != null && arrDependentMaster.length > 0) {
                                for (var i = 0; i < arrDependentMaster.length; i++) {
                                    if (arrDependentMaster.length - 1 != i)
                                        sDepText += arrDependentMaster[i].Name + ",";
                                    else
                                        sDepText += arrDependentMaster[i].Name;
                                }
                                cellObj.setCellText(sDepText, JSON.stringify(arrVoucherMasters[rowCount].ArrDependentMaster));
                            }
                            break;
                        case 3:
                            cellObj.setCellText(arrVoucherMasters[rowCount].Group == null ? "" : arrVoucherMasters[rowCount].Group);
                            break;
                        case 4:
                            //var MasterDropDown = document.getElementById("docFilter");
                            //MasterDropDown.value = arrVoucherMasters[rowCount].MasterType;
                            //cellObj.setCellText(MasterDropDown.selectedOptions[0].textContent);
                            //cellObj.setCellData("value", MasterDropDown.value);

                            //var text = FGRIDCONTROL.getCellObject("doc_TagsTable", cellObj.iRow, cellObj.iColumn - 4).getCellText();
                            //var valofcell = FGRIDCONTROL.getCellObject("doc_TagsTable", cellObj.iRow, cellObj.iColumn - 4).getCellData("value");
                            if (arrVoucherMasters[rowCount].DependentMaster > 0) {
                                cellObj.setCellText(arrVoucherMasters[rowCount].FieldName);
                            }
                            cellObj.setCellData("value", arrVoucherMasters[rowCount].DependentMaster);
                            break;
                        case 5:
                            var MDropDown = document.getElementById("doc_MandatoryDropDown");
                            if (arrVoucherMasters[rowCount].IsMandatorySelection == true) {
                                MDropDown.value = 1;
                            }
                            else {
                                MDropDown.value = 0;
                            }
                            if (MDropDown.selectedOptions.length > 0) {
                                cellObj.setCellText(MDropDown.selectedOptions[0].textContent);
                                cellObj.setCellData("value", MDropDown.value);
                            }
                            break;
                    }
                }
            }

        }
    },

