        try {
            if (transEntryGlobal.debugFooterInput == true) {
                debugger
            }

            dOldValue = DataType.getNumber(eleFooter.value);
            dOldValue = FNumberOperation.convert(dOldValue);
            if (EntryMain.isDataLoading() == false) {
                EntryMainUI.setOldValue(eleFooter, DataType.toString(dOldValue));
            }

            arrFooterFields = transEntryFieldInfo.getFooterFields();
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrMetaDataFooterIndex.length; iCounter++) {
                if (transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].sInputCtrlId == eleFooter.id) {
                    iIndex = transEntryGlobal.EntryModel.arrMetaDataFooterIndex[iCounter].arrMetaDataIndex[0];
                    objMetaData = arrFooterFields[iIndex];
                    break;
                }
            }

            if (DataType.isValidObject(objMetaData) == true) {
                if (objMetaData.bMandatory == true && DataType.toString(eleFooter.value) == "") {
                    eleFooter.value = "";
                }
                else {
                    eleFooter.value = DataType.formatToDecimalPlaces(dOldValue, objMetaData.iNoDecimal);
                }

                if (DataType.isNullOrEmpty(objMetaData.sPreload) == false) {
                    objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sPreload, 0, dOldValue, -1, objMetaData.sFieldName);
                    objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                    dFormulaValue = objFormulaOutput.Value;
                    dValue = FConvert.roundOff(dFormulaValue, objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                    dValue = FNumberOperation.toFixed(dValue, objMetaData.iNoDecimal);

                    if (GlobalPref.isSupportBigNumber == false) {
