    fillData_StockTransfer: function (objTrans, arrCodeTypes, arrBookTypes) {
        let sId = "";
        let iCount = 0;
        let iStartNext = 0;
        let iCounter = 0;
        let iSign = 0;
        let dTempQty = 0;
        let arrTempBody = undefined;
        let objFieldInfo = undefined;
        let cell = undefined;

        try {
            if (transEntryInfo.isItTransfer == true) {
                arrTempBody = objTrans.BodyData;
                iCount = arrTempBody.length;
                iStartNext = iCount;

                objFieldInfo = transEntryFieldInfo.BodyInvTag;
                for (iCounter = 0; iCounter < iCount; iCounter++) {
                    arrTempBody[iCounter].Flags.InternalIIDST = false;
                    arrTempBody.push(DataType.createDuplicateObject(arrTempBody[iCounter]));
                    arrTempBody[arrTempBody.length - 1].Sales.Reservation = null;
                    arrTempBody[iCounter].Flags.InternalIIDST = true;

                    if (iStartNext < transEntryGlobal.arrLoadedData.length) {
                        arrTempBody[arrTempBody.length - 1].BodyId = transEntryGlobal.arrLoadedData[iStartNext].BodyId;
                        arrTempBody[arrTempBody.length - 1].TransactionId = transEntryGlobal.arrLoadedData[iStartNext].TransactionId;
                    }

                    if (DataType.isValidObject(arrTempBody[iCounter].Sales) == true && DataType.isValidObject(arrTempBody[iCounter].Sales.BatchNo) == true) {
                        arrTempBody[arrTempBody.length - 1].Sales.BatchNo = DataType.createDuplicateObject(arrTempBody[iCounter].Sales.BatchNo);
                    }

                    if (DataType.isValidObject(arrTempBody[iCounter].Sales) == true && DataType.isValidObject(arrTempBody[iCounter].Sales.RMANos) == true) {
                        arrTempBody[arrTempBody.length - 1].Sales.RMANos = DataType.createDuplicateObject(arrTempBody[iCounter].Sales.RMANos);
                    }

                    arrBookTypes.push(arrBookTypes[iCounter]);
                    arrCodeTypes.push(arrCodeTypes[iCounter]);
                }

                iCount = 0;
                for (iCounter = (arrTempBody.length / 2) ; iCounter < arrTempBody.length; iCounter++, iCount++) {
                    if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                        cell = transEntryGrid.getCellObject(iCount + 1, objFieldInfo.ColumnIndex);
                        arrTempBody[iCounter].InvTag = DataType.toInt(cell.getCellData());
                    }
                    else if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                        sId = EntryMainUI.getHeaderControlId(objFieldInfo.FieldId);
                        arrTempBody[iCounter].InvTag = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                    }

                    arrTempBody[iCounter].BodyId = 0;
                }

                if (transEntryFieldInfo.IssueInvTag.Area == eTranEntryFieldArea.Header
                    || transEntryInvTag.isBothWarehouseInBody() == true) {
                    iCounter = 0;
                    iCount = arrTempBody.length / 2;
                }
                else {
                    iCounter = arrTempBody.length / 2;
                    iCount = arrTempBody.length;
                }

                for (; iCounter < iCount; iCounter++) {
                    arrTempBody[iCounter].Sales.Quantity = FNumberOperation.mul(arrTempBody[iCounter].Sales.Quantity, -1);
                    arrTempBody[iCounter].Sales.BaseQuantity = FNumberOperation.mul(arrTempBody[iCounter].Sales.BaseQuantity, -1);
                    arrTempBody[iCounter].Sales.AlternateQuantity = FNumberOperation.mul(arrTempBody[iCounter].Sales.AlternateQuantity, -1);
                }

                for (iCounter = 0; iCounter < arrTempBody.length; iCounter++) {
                    if (DataType.isValidObject(arrTempBody[iCounter].Sales.BatchNo) == true) {
                        dTempQty = FNumberOperation.abs(arrTempBody[iCounter].Sales.BatchNo.Qty);
                        if (FNumberOperation.isLessThan(arrTempBody[iCounter].Sales.Quantity, 0) == true) {
                            iSign = -1;
                        }
                        else {
                            iSign = 1;
                        }

                        arrTempBody[iCounter].Sales.BatchNo.Qty = FNumberOperation.mul(dTempQty, iSign);
                    }


                    if (DataType.isValidObject(arrTempBody[iCounter].Sales.BinsData) == true) {
                        for (iCount = 0; iCount < arrTempBody[iCounter].Sales.BinsData.length; iCount++) {
                            dTempQty = FNumberOperation.abs(arrTempBody[iCounter].Sales.BinsData[iCount].Quantity);
                            if (FNumberOperation.isLessThan(arrTempBody[iCounter].Sales.Quantity, 0) == true) {
                                iSign = -1;
                            }
                            else {
                                iSign = 1;
                            }

                            arrTempBody[iCounter].Sales.BinsData[iCount].Quantity = FNumberOperation.mul(dTempQty, iSign);
                        }
                    }
                }

                objTrans.BodyData = arrTempBody;
            }

        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in fillData_StockTransfer method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.fillData_StockTransfer} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    fillLinks: function (objTransaction, iRow) {
        let iCounter = 0;
        let arrFields = undefined;
        let objCell = null;
        let objLink = null;
        let objLinkDef = null;
        let obj = undefined;

        try {
            arrFields = transEntryFieldInfo.getLinkFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                obj = arrFields[iCounter];
                objLinkDef = obj.MetaData.Tag;
                if (DataType.isValidObject(objLinkDef) == false) {
                    continue;
                }

                objCell = transEntryGrid.getCellElement(iRow, obj.ColumnIndex, true);
                if (DataType.isValidObject(objCell) == false) {
                    continue;
                }

                if (DataType.arrayLength(objTransaction.BodyData[iRow - 1].Links) < 1) {
                    objTransaction.BodyData[iRow - 1].Links = [];
                }

                objLink = transEntryLinks.getObjectFromCell(objCell, obj.MetaData, iRow, true);
                if (objLink.LinkId > 0) {
                    objTransaction.BodyData[iRow - 1].Links.push(objLink);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in fillLinks method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainCalculation.fillLinks} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    fillFinal: function (objInput) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let iCounter2 = 0;
        let iRow = 0;
        let iGridRow = 0;
        let iIndex = 0;
        let iDefaultBook = 0;
        let iRowGeneralRoundOff = 0;
        let iRowRoundingType = 0;
        let iMaskedVoucherType = 0;
        let dValue = 0        
        let dAmt1 = 0;
        let dAmt2 = 0;        
        let bSameCode = false;
        let bSameBook = false;
        let eleCtrl = null;
        let objMetaData = null;
        let objBody = null;
        let arrTempBody = [];
        let arrTempBodyCodeTypes = [];
        let arrTempBodyBookTypes = [];
        let lstIndexDone = [];
        let objTransaction = null;
        let dTotalNet = 0;
        let bOldVal = false;
        let iVATColumn = -1;
        let iOrigAcc1 = 0;
        let iOrigAcc2 = 0;
        let iAddToNet = 0;
        let iTaxCodeCol = -1;
        let iTaxCode = 0;
        let iTaxCat = 0;
        let iExpAcc = 0;
        let iRet = 0;
        let dOrgAmount = 0;
        let dScreenValue = 0;
        let bReverseCharge = false;
        let temp = null;
        let objCodeType = eAccountTypes.None;
        let objBookType = eAccountTypes.None;
        let arrScreenFields = undefined;
        let arrLayoutFields = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;

        try {
            objTransaction = objInput.objTrans;

            iMaskedVoucherType = transEntryInfo.BaseVoucherType;

            arrScreenFields = transEntryFieldInfo.getScreenFields();
            arrLayoutFields = transEntryFieldInfo.getLayoutFields(true);
            if (EntryMain.m_Settings.Misc.PostVAT == true) {                
                for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                    objMetaData = arrScreenFields[iCounter].MetaData;

                    if (objMetaData.sFieldName == "VAT") {
                        iVATColumn = iCounter;
                        iOrigAcc1 = objMetaData.iDebitAccount;
                        iOrigAcc2 = objMetaData.iCreditAccount;
                        iAddToNet = objMetaData.iAddToNet;
                        break;
                    }
                }
                
                for (iCounter = 0; iCounter < arrLayoutFields.length; iCounter++) {
                    objMetaData = arrLayoutFields[iCounter].MetaData;
                    if (objMetaData.sFieldName.toLowerCase() == "taxcode") {
                        iTaxCodeCol = iCounter;
                        if (transEntryInfo.isItSales == true) {
                            break;
                        }
                    }

                    if (transEntryInfo.isItSales == false) {
                        if (objMetaData.sFieldName == "VAT") {
                            iVATColumn = iCounter;
                            iOrigAcc1 = objMetaData.iDebitAccount;
                            iOrigAcc2 = objMetaData.iCreditAccount;
                        }
                    }
                }
            }

            if (EntryMain.m_Settings.Misc.DetailedPosting == true) {
                for (iRow = 0, iGridRow = 0; iRow < objTransaction.BodyData.length; iRow++) {
                    if (objTransaction.BodyData[iRow].RowType == _RowType.AccountToPost) {
                        continue;
                    }

                    iGridRow++;

                    arrTempBody = [];
                    arrTempBodyCodeTypes = [];
                    arrTempBodyBookTypes = [];

                    if (transEntryInfo.isItSales == true) { // Sale Type voucher: check screen columns
                        for (iCounter = 0; iCounter < arrScreenFields.length; iCounter++) {
                            if (DataType.isZero(objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value) == true) {
                                continue;
                            }

                            objMetaData = arrScreenFields[iCounter].MetaData;

                            if (DataType.isNullOrEmpty(objMetaData.sDrAccVariable) == false) {
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDrAccVariable, iGridRow, null, arrScreenFields[iCounter].ColumnIndex, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                objMetaData.iDebitAccount = DataType.toInt(objFormulaOutput.Value);
                            }

                            if (DataType.isNullOrEmpty(objMetaData.sCrAccVariable) == false) {
                                objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sCrAccVariable, iGridRow, null, arrScreenFields[iCounter].ColumnIndex, objMetaData.sFieldName);
                                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                                objMetaData.iCreditAccount = DataType.toInt(objFormulaOutput.Value);
                            }

                            bSameCode = false;
                            bSameBook = false;
                            bOldVal = objMetaData.bValueInBaseCurrency;

                            if (iCounter == iVATColumn) {
                                objMetaData.iDebitAccount = iOrigAcc1;
                                objMetaData.iCreditAccount = iOrigAcc2;
                                objMetaData.iAddToNet = iAddToNet;

                                iTaxCode = 0;
                                if (iTaxCodeCol != -1 && DataType.arrayLength(objTransaction.BodyData[iRow].BodyExtra) > iTaxCodeCol) {
                                    iTaxCode = DataType.toInt(objTransaction.BodyData[iRow].BodyExtra[iTaxCodeCol].Tag);
                                }

                                if (iTaxCode == 16 || iTaxCode == 7) {
                                    objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Input = 0;
                                    objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value = 0;
                                }

                                if ((iMaskedVoucherType == eVTTYPE.SALES || iMaskedVoucherType == eVTTYPE.DLVCH || iMaskedVoucherType == eVTTYPE.SARET)) {
                                    if (DataType.arrayLength(objTransaction.BodyData[iRow].BodyExtra) > iTaxCodeCol) {
                                        if (iTaxCode == 17 || iTaxCode == 27) // RCMS
                                        {
                                            objMetaData.iDebitAccount = transEntryGlobal.EntryModel.Preference.VAT.iVATOutput;
                                            objMetaData.iCreditAccount = transEntryGlobal.EntryModel.Preference.VAT.iVATAccount;
                                            objMetaData.iAddToNet = 0;
                                        }
                                    }
                                }
                                else if ((iMaskedVoucherType == eVTTYPE.PURCH || iMaskedVoucherType == eVTTYPE.PURET || iMaskedVoucherType == eVTTYPE.MATRN || iMaskedVoucherType == eVTTYPE.PORDR || iMaskedVoucherType == eVTTYPE.PQUOT)) {
                                    if (objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value != 0 && iTaxCodeCol != -1) {
                                        if (DataType.arrayLength(objTransaction.BodyData[iRow].BodyExtra) > iTaxCodeCol) {
                                            bReverseCharge = iTaxCode == 8 || iTaxCode == 13;
                                            iTaxCat = 0;
                                            if (transEntryGlobal.FieldHelper.Column.Item > -1) {
                                                temp = EntryMainMaster.getItemTaxCategory(iGridRow);
                                                if (DataType.isValidObject(temp) == true) {
                                                    iTaxCat = DataType.toInt(temp);
                                                }
                                            }

                                            if (bReverseCharge == true) {
                                                objMetaData.iCreditAccount = transEntryGlobal.EntryModel.Preference.VAT.iVATOutput;
                                                objMetaData.iAddToNet = 0;
                                            }

                                            if (iTaxCode == 29)
                                            {
                                                objMetaData.iDebitAccount = transEntryGlobal.EntryModel.Preference.VAT.iVATAccount;
                                                objMetaData.iCreditAccount = transEntryGlobal.EntryModel.Preference.VAT.iVATPaidAtCustomsAC;
                                                objMetaData.AddToNet = 0;
                                            }

                                            if (iTaxCat == 2) { // Exempted
                                                iExpAcc = 0;
                                                temp = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iGridRow, "VATExpenseAccount");
                                                if (DataType.isNullOrEmpty(temp) == false) {
                                                    iExpAcc = DataType.toInt(temp);
                                                }

                                                objMetaData.iDebitAccount = iExpAcc;
                                            }

                                            if (iTaxCode == 19) {
                                                objMetaData.iDebitAccount = 0;
                                                objMetaData.iCreditAccount = 0;
                                            }

                                        }
                                    }
                                }
                            }


                            switch (objMetaData.iAddToNet) {
                                case 0: // Add
                                    if (objMetaData.iDebitAccount <= 0 || objMetaData.iDebitAccount == objTransaction.BodyData[iRow].Code) {
                                        if (DataType.arrayLength(objTransaction.BodyData[iRow].Sales.ScreenData) > iCounter) {
                                            dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[0];
                                            dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                            if (objMetaData.bValueInBaseCurrency == true && EntryMain.m_bRoundOff == true) {
                                                // Roundoff At Each Stage
                                                dScreenValue = FConvert.roundOff(dScreenValue, EntryMain.m_dGeneralRoundOff, eRoundingType.Nearest);
                                            }

                                            dValue = FNumberOperation.add(dOrgAmount, dScreenValue);
                                            objTransaction.BodyData[iRow].OriginalAmounts[0] = dValue;
                                            transEntryGrid.notifyOrgAmtChange(iRow, 0, dValue);
                                        }

                                        bSameCode = true;
                                    }

                                    if (objMetaData.iCreditAccount <= 0 || objMetaData.iCreditAccount == objTransaction.BodyData[iRow].Book) {
                                        if (DataType.arrayLength(objTransaction.BodyData[iRow].Sales.ScreenData) > iCounter) {
                                            dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[1];
                                            dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                            if (objMetaData.bValueInBaseCurrency == true && EntryMain.m_bRoundOff == true) {
                                                // Roundoff At Each Stage
                                                dScreenValue = FConvert.roundOff(dScreenValue, EntryMain.m_dGeneralRoundOff, eRoundingType.Nearest);
                                            }

                                            dValue = FNumberOperation.add(dOrgAmount, dScreenValue);
                                            objTransaction.BodyData[iRow].OriginalAmounts[1] = dValue;
                                            transEntryGrid.notifyOrgAmtChange(iRow, 1, dValue);
                                        }

                                        bSameBook = true;
                                    }
                                    break;
                                case 1: // Deduct
                                    if (objMetaData.iDebitAccount <= 0 || objMetaData.iDebitAccount == objTransaction.BodyData[iRow].Code) {
                                        if (DataType.arrayLength(objTransaction.BodyData[iRow].Sales.ScreenData) > iCounter) {
                                            dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[0];
                                            dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                            if (objMetaData.bValueInBaseCurrency == true && EntryMain.m_bRoundOff == true) {
                                                // Roundoff At Each Stage
                                                dScreenValue = FConvert.roundOff(dScreenValue, EntryMain.m_dGeneralRoundOff, eRoundingType.Nearest);
                                            }

                                            dValue = FNumberOperation.sub(dOrgAmount, dScreenValue);
                                            objTransaction.BodyData[iRow].OriginalAmounts[0] = dValue;
                                            transEntryGrid.notifyOrgAmtChange(iRow, 0, dValue);
                                        }

                                        bSameCode = true;
                                    }

                                    if (objMetaData.iCreditAccount <= 0 || objMetaData.iCreditAccount == objTransaction.BodyData[iRow].Book) {
                                        if (DataType.arrayLength(objTransaction.BodyData[iRow].Sales.ScreenData) > iCounter) {
                                            dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[1];
                                            dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                            if (objMetaData.bValueInBaseCurrency == true && EntryMain.m_bRoundOff == true) {
                                                // Roundoff At Each Stage
                                                dScreenValue = FConvert.roundOff(objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value, EntryMain.m_dGeneralRoundOff, eRoundingType.Nearest);
                                            }

                                            dValue = FNumberOperation.sub(dOrgAmount, dScreenValue);
                                            objTransaction.BodyData[iRow].OriginalAmounts[1] = dValue;
                                            transEntryGrid.notifyOrgAmtChange(iRow, 1, dValue);
                                        }

                                        bSameBook = true;
                                    }
                                    break;
                                case 2: // Not applicable
                                    if (objMetaData.iDebitAccount > 0) {
                                        dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[0];
                                        dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                        dValue = FNumberOperation.sub(dOrgAmount, dScreenValue);
                                        objTransaction.BodyData[iRow].OriginalAmounts[0] = dValue;
                                        transEntryGrid.notifyOrgAmtChange(iRow, 0, dValue);
                                        bSameCode = false;
                                    }
                                    else {
                                        bSameCode = true;
                                    }

                                    if (objMetaData.iCreditAccount > 0) {
                                        dOrgAmount = objTransaction.BodyData[iRow].OriginalAmounts[1];
                                        dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;

                                        dValue = FNumberOperation.sub(dOrgAmount, dScreenValue);
                                        objTransaction.BodyData[iRow].OriginalAmounts[1] = dValue;
                                        transEntryGrid.notifyOrgAmtChange(iRow, 1, dValue);
                                        bSameBook = false;
                                    }
                                    else {
                                        bSameBook = true;
                                    }

                                    break;
                            }

                            if (bSameCode == false || bSameBook == false) // If anyone is false, a new row needs to be inserted
                            {
                                objBody = transactionDataStructure.getEmptyTransBodyObject();
                                objBody.RowType = _RowType.AccountToPost;
                                if (bSameCode == false) {
                                    objBody.Code = objMetaData.iDebitAccount;

                                    dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;
                                    dValue = FNumberOperation.mul(dScreenValue, objMetaData.iAddToNet == 1 ? -1 : 1);
                                    objBody.OriginalAmounts[0] = dValue;
                                    transEntryGrid.notifyOrgAmtChange(-1, 0, dValue);

                                    if (objMetaData.bValueInBaseCurrency) {
                                        objBody.Amounts[0] = dScreenValue;
                                    }

                                    if (bOldVal == true) {
                                        objTransaction.BodyData[iRow].Flags.ScreenValueInBase = true;
                                    }
                                    
                                    arrTempBodyCodeTypes.push(objMetaData.iDebitAccountType);
                                }

                                if (bSameBook == false) {
                                    objBody.Book = objMetaData.iCreditAccount;
                                    dScreenValue = objTransaction.BodyData[iRow].Sales.ScreenData[iCounter].Value;
                                    dValue = FNumberOperation.mul(dScreenValue, objMetaData.iAddToNet == 1 ? -1 : 1);
                                    objBody.OriginalAmounts[1] = dValue;

                                    if (objMetaData.bValueInBaseCurrency) {
                                        objBody.Amounts[1] = dScreenValue;
