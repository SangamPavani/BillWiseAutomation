    fillBodyMasters: function(arrData, arrMasterMetaDataIndex, arrMasterValueIndex, arrUnits, objParam) {
        let sId = "";
        let sFilter = "";
        let sExtraFilter = "";
        let iRowCounter = 0;
        let iColCounter = 0;
        let iValue = 0;
        let iUnitValueIndex = 0;
        let bLoadBalance = undefined;
        let arrUniqueMasterIds = undefined;
        let arrColData = undefined;
        let objData = undefined;
        let objIdNamePair = undefined;
        let objUnitInfo = undefined;
        let result = undefined;

        try {
            transEntryUnit.prefetchUnits(objParam.iCurrentRow, arrUnits);

            objUnitInfo = transEntryFieldInfo.Unit;
            for (iColCounter = 0; iColCounter < arrMasterValueIndex.length; iColCounter++) {
                // Loop for master columns
                objData = {};

                objData.ValueIndex = arrMasterValueIndex[iColCounter]; // Stores value index in arr data
                objData.ColIndex = arrMasterMetaDataIndex[iColCounter]; // Grid column index
                objData.iCurrentRow = objParam.iCurrentRow;
                objData.GridCtrlId = objParam.sGridCtrlId;
                objData.MetaData = transEntryGlobal.EntryModel.MetaData.Body[objData.ColIndex];
                objData.bPendingLinks = DataType.toBoolean(objParam.bPendingLinks);
                objData.iCallingSource = DataType.toInt(objParam.iCallingSource);
                objData.iLoadedDataSource = DataType.toInt(objParam.iLoadedDataSource);

                objParam.iUnitMasterValueIndex = -1;
                if (objUnitInfo.MetaDataIndex >= 0) {
                    sId = EntryMainUI.getBodyControlId(objUnitInfo.FieldId);
                    result = EntryMainCommon.findKeyValue(sId, arrColData);
                    if (result.lValue > 0) {
                        objParam.iUnitMasterValueIndex = result.lValue - 1;
                    }
                }

                if (objUnitInfo.MetaDataIndex >= 0 && objData.MetaData.iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                    continue;
                }

                //if (arrMasterValueIndex[iColCounter] == objParam.iUnitMasterValueIndex) {
                //    continue;
                //}

                if (objData.MetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT
                    && objUnitInfo.ColumnIndex > -1
                    && objParam.iUnitMasterValueIndex > -1) {
                    objData.arrUnitIds = [];
                    objData.UnitMetaData = objUnitInfo.MetaData;
                    objData.UnitColIndex = objParam.iUnitMetaDataIndex;
                }

                if (objData.MetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                    objData.bDescriptionMappingExist = objParam.bDescriptionMappingExist;
                }

                objData.arrMasterIds = [];
                arrUnits = [];
                arrUniqueMasterIds = [];

                for (iRowCounter = 0; iRowCounter < arrData.length; iRowCounter++) {
                    arrColData = arrData[iRowCounter];

                    sId = EntryMainUI.getBodyControlId(objData.MetaData.iFieldId);

                    iValue = 0;
                    if (objData.ValueIndex >= arrColData.length) {
                        result = EntryMainCommon.findKeyValue(sId, arrColData);
                        if (result.lValue > 0) {
                            iValue = DataType.toInt(result.data.Value);
                            arrColData[result.lValue - 1].Value = iValue;
                        }
                        else {
                            iValue = 0;
                        }
                    }
                    else {
                        if(arrColData[objData.ValueIndex].Key == sId) {
                            iValue = DataType.toInt(arrColData[objData.ValueIndex].Value);
                            arrColData[objData.ValueIndex].Value = iValue;
                        }
                        else {
                            result = EntryMainCommon.findKeyValue(sId, arrColData);
                            if (result.lValue > 0) {
                                iValue = DataType.toInt(result.data.Value);
                                arrColData[result.lValue - 1].Value = iValue;
                            }
                            else {
                                iValue = 0;
                            }
                        }
                    }

                    objData.arrMasterIds.push(iValue);

                    if (arrUniqueMasterIds.indexOf(iValue) == -1) {
                        arrUniqueMasterIds.push(iValue);
                    }

                    if (DataType.isValidObject(objData.arrUnitIds) == true) {
                        iUnitValueIndex = objParam.arrUnitMasterValueIndex[iRowCounter];

                        arrColData = arrData[iRowCounter];
                        objIdNamePair = FocusDataStructs.getIdNamePairObject();
                        objIdNamePair.ID = 0;
                        if (iUnitValueIndex > -1) {
                            objIdNamePair.ID = arrColData[iUnitValueIndex].Value; // UnitId
                        }

                        objIdNamePair.Tag = iValue; // ItemId
                        arrUnits.push(objIdNamePair);
                    }
                }

                if (DataType.isValidObject(objData.arrUnitIds) == true) {
                    delete objData.arrUnitIds;
                }

                if (objData.arrMasterIds.length > 0) {
                    sId = EntryMainUI.getBodyControlId(objData.MetaData.iFieldId);

                    OPTIONCONTROL.clear(sId);

                    if (objData.MetaData.iFieldId == eVTFIELDID.FDF_SKID) {
                        sFilter = OPTIONCONTROL.getFilter(sId);
                        OPTIONCONTROL.setFilter(sId, "");
                    }

                    sExtraFilter = OPTIONCONTROL.getExtraFilter(sId);
                    OPTIONCONTROL.setExtraFilter(sId, "");

                    if (objData.MetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                        bLoadBalance = false;
                    }

                    result = OPTIONCONTROL.createSetValueExtraObject(true);
                    result.bLoadBalance = bLoadBalance;

                    if (DataType.isNullOrEmpty(OPTIONCONTROL.getGroups(sId), true) == false) {
                        result.bLoadAll = false;
                    }

                    OPTIONCONTROL.setValue(sId, arrUniqueMasterIds, objData, result); // EntryMainBody.onOptionDataLoaded

                    OPTIONCONTROL.setExtraFilter(sId, sExtraFilter);

                    if (objData.MetaData.iFieldId == eVTFIELDID.FDF_SKID) {
                        OPTIONCONTROL.setFilter(sId, sFilter);
                    }
                }

                transEntryUnit.prefetchUnits(objParam.iCurrentRow, arrUnits);
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("Some error in body fillBodyMasters method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.fillBodyMasters} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

