    setTreeData: function (arrTree, fillRows) {
        let currentParentPadding = 0;
        let currentLevel = 1;
        let remainingRows = 0;
        let additionalRows = 0;
        let result = null;
        let rowno = 0;
        let totalRows = 0;
      
        try {
            totalRows = transBinsPopup.getTotalRows();
            //2 cases
            if (fillRows < totalRows) {
                //enter fillRows, delete RemainingRows
                remainingRows = totalRows - fillRows;
                transBinsPopup.deleteRows(fillRows + 1, remainingRows);
            }
            else if (fillRows > totalRows) {
                //add aditionalRows ,enter fillRows
                additionalRows = fillRows - totalRows;
                transBinsPopup.insertRows(totalRows, additionalRows);
            }
            
            for (var i = 0; i < arrTree.length; i++) {
                rowno = rowno + 1;
                currentParentPadding = 0; currentLevel = 1;
                //check if the row is allocate a value in multiple pages 
                if (BinsUI.m_isPaging) {
                    if (BinsUI.m_MultiSelectedBins && BinsUI.m_MultiSelectedBins.length > 0) {
                        result = ($.grep(BinsUI.m_MultiSelectedBins, function (e) {
                            return e.Id == arrTree[i].Id;
                        }));
                        if (result != null && result.length > 0) {
                            arrTree[i].ToBeAllocated = result[0].ToBeAllocated;
                        }
                    }
                }
                rowEle = BinsUI.setRowData(arrTree[i], rowno, currentParentPadding, currentLevel);
                if (rowEle) {
                    if (rowEle.style.display == "none") {
                        rowEle.style.display = "";
                    }
                }
                if (arrTree[i].Group == true) {
                    rowno = BINS.fillTreeRecursive(arrTree[i].children, rowno, currentParentPadding, currentLevel);
                }
            }
           
            BinsUI.updateBalance();
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.setTreeData}" + err.message, "EXCEPTION");
        }
    },

