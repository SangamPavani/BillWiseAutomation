    prefetchUnits: function (bSuccess, arrUnitData, tag) {
        let iRow = 0;
        let iCounter = 0;
        let iUnitColIndex = 0;
        let fConversion = 0;
        let fRoundOff = 0;
        let iNoOfDecimals = 0;
        let dValue = 0;
        let objUnitData = undefined;
        let cell = undefined;

        try {
            if (bSuccess == false) {
                return;
            }

            if (arrUnitData.lValue < 0) {
                transEntryGlobal.showAlert("{EntryMainCallback.prefetchUnits} " + arrUnitData.sValue, GlobalPref.getResourceValue("Error"));

                return;
            }

            arrUnitData = arrUnitData.data;
            if (DataType.stringStartsWith(arrUnitData[0], "~") == true) {
                transEntryGlobal.showAlert(arrUnitData[0].substr(1), GlobalPref.getResourceValue("Error"));

                return;
            }

            iRow = tag.iCurrentRow + 1;
            iUnitColIndex = tag.ColIndex;
            for (iCounter = 0; iCounter < arrUnitData.length; iCounter++, iRow++) {
                objUnitData = arrUnitData[iCounter].split("\t");

                fConversion = 0;
                fRoundOff = 0;
                iNoOfDecimals = 0;

                if (objUnitData.length >= 5) {
                    iNoOfDecimals = DataType.toInt(objUnitData[objUnitData.length - 1]);
                    fRoundOff = objUnitData[objUnitData.length - 2];
                    fConversion = objUnitData[objUnitData.length - 3];
                }

                cell = transEntryGrid.getCellObject(iRow, iUnitColIndex);
                EntryMainBody.setUnitDataInCell(cell,
                                                DataType.toInt(objUnitData[0]), // UnitId
                                                objUnitData[1], // Name
                                                fConversion,
                                                fRoundOff,
                                                iNoOfDecimals);

                if (DataType.gt(fConversion, 0) == true
                    && DataType.isZero(EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales.Quantity) == false) {

                    dValue = FNumberOperation.mul(EntryMain.m_objTrans.BodyData[cell.iRow - 1].Sales.Quantity, fConversion);
                    EntryMainMemoryObject.update(eVTFIELDID.FDF_QUANTITY_IN_BASE, dValue, cell.iRow);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.prefetchUnits} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

