    getFilter: function () {
        let sFilter = "";
        let iDate = 0;
        let datetime = 0;

        try {
            if (transEntryInfo.BaseVoucherType == eVTTYPE.IOPBA
                || transEntryInfo.BaseVoucherType == eVTTYPE.OPBAL) {
                iDate = EntryMain.m_iAccountingDate;
            }
            else {
                iDate = EntryMain.m_objTrans.Header.Date;
            }

            datetime = DATE.prototype.convertIntoFocusDateTime(FDate.getYearFromInt(iDate),
                                                                FDate.getMonthFromInt(iDate),
                                                                FDate.getDayFromInt(iDate),
                                                                0,
                                                                0,
                                                                0);

            sFilter = "vCore_CurrencyExchange a ";
            sFilter += " join ( ";
            sFilter += " select iBaseCurrencyId, iCurrencyId iCurrId, MAX(iEffectiveDate) iDate from vCore_CurrencyExchange ";
            sFilter += " where iBaseCurrencyId = " + transEntryInfo.DefaultCurrencyId + " and iEffectiveDate <= " + datetime;
            sFilter += " group by iBaseCurrencyId, iCurrencyId";
            sFilter += " ) curr ";
            sFilter += " on a.iBaseCurrencyId = curr.iBaseCurrencyId and a.iCurrencyId = curr.iCurrId and a.iEffectiveDate = curr.iDate";
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryCurrency.getFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (sFilter);
    },

    processChange: function (iRow) {
        let sValue = "";
        let fExchangeRate = 0;
        let cellCurrency = null;
        let cellExRate = null;
        let obj = null;

        try {
            cellCurrency = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.Currency.ColumnIndex);
            if (DataType.isValidObject(cellCurrency) == false) {
                return;
            }

            cellExRate = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.ExchangeRate.ColumnIndex);
            if (DataType.isValidObject(cellExRate) == true) {
                cellExRate.clear();
                fExchangeRate = transEntryFields.getMandatoryValue(transEntryFieldInfo.Currency, iRow, "fExchangeRate", eMasterDataType.Fraction);

                sValue = DataType.formatToDecimalPlaces(fExchangeRate, transEntryExchangeRate.getDecimals());
                cellExRate.setCellText(sValue, sValue);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYEXCHANGERATE, sValue, iRow)
            }

            if (EntryMain.isDataLoading() == false
                && transEntryFieldInfo.Billwise.FieldId > 0) {

                if (transEntryInfo.BodySectionNotRequired == true) {
                    EntryMainBillwise.updateDirtyRowFlag(0, eVTFIELDID.FDF_BODYCURRENCY);
                    TRANSACTION_ENTRY.BILLWISE.updateBillReferencesData();
                }
                else {
                    EntryMainBillwise.updateDirtyRowFlag(iRow, eVTFIELDID.FDF_BODYCURRENCY);
                    transEntryReference.updateRequiredFlag(iRow);
                }
            }

            obj = {};
            obj.iTransactionCurrencyId = EntryMainMemoryObject.getCurrencyId(iRow);
            obj.iDepartmentId = EntryMainMemoryObject.getFAValue(iRow);
            EntryMainBody.getLocalExchangeRate(obj, iRow);
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryCurrency.processChange} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
};
