    checkCreditLimit: function (bSuccess, data, objCustomData) {
        let sMsg = "";
        let arrMsg = [];
        let iCounter = 0;
        let objFlags = undefined;
        let result = undefined;

        try {
            if (bSuccess == false) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                return;
            }

            if (data.lValue < 1 && DataType.isNullOrEmpty(data.sValue, true) == false) {
                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                transEntryGlobal.writeErrorLog("CheckCreditLimit: " + data.sValue);

                transEntryGlobal.showAlert("Error in CheckCreditLimit.", GlobalPref.getResourceValue("Error"));

                return;
            }

            if (data.lValue > 0) {
                arrMsg = data.data;
            }


            for (iCounter = 0; iCounter < arrMsg.length; iCounter++) {
                switch (arrMsg[iCounter].ID) {
                    case eMessagesToUI.CreditLimitExceededApproval:
                        if (transEntryInfo.Settings.Misc.DontCheckCreditLimit == false) {
                            result = DataType.stringToObject(objCustomData.objTransactionData.Header.Flags);
                            if (result.lValue <= 0) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                                return;
                            }
                            objFlags = result.data;

                            sMsg = GlobalPref.getResourceValue("msgCreditLimitExceededWarn");
                            sMsg += " Credit Limit is " + DataType.toDecimal(arrMsg[iCounter].Name, 2);
                            sMsg += " whereas this transaction will make the balance as " + DataType.toDecimal(arrMsg[iCounter].Tag, 2);
                            sMsg += ". Do you want to request for additional credit limit?";
                            if (transEntryGlobal.confirmMessage(sMsg) == false) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                                return;
                            }

                            objFlags.RequestCrLimit = true;
                            objFlags.Suspended = true;

                            objCustomData.objTransactionData.Header.Flags = DataType.toString(objFlags);
                        }
                        break;
                    case eMessagesToUI.CreditLimitExceededWarn:
                        if (transEntryInfo.Settings.Misc.DontCheckCreditLimit == false) {
                            result = DataType.stringToObject(objCustomData.objTransactionData.Header.Flags);
                            if (result.lValue <= 0) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                                return;
                            }
                            objFlags = result.data;

                            sMsg = GlobalPref.getResourceValue("msgCreditLimitExceededWarn");
                            sMsg += " Credit Limit is " + DataType.toDecimal(arrMsg[iCounter].Name, 2);
                            sMsg += " whereas this transaction will make the balance as " + DataType.toDecimal(arrMsg[iCounter].Tag, 2);

                            transEntryGlobal.showAlert(sMsg, GlobalPref.getResourceValue("Warning"));

                            objFlags.CheckCreditLimit = false;
                            objCustomData.objTransactionData.Header.Flags = DataType.toString(objFlags);
                        }
                        break;
                    case eMessagesToUI.CreditLimitExceededStop:
                        if (transEntryInfo.Settings.Misc.DontCheckCreditLimit == false) {
                            sMsg = GlobalPref.getResourceValue("msgCreditLimitExceededStop");
                            sMsg += " Credit Limit is " + DataType.toDecimal(arrMsg[iCounter].Name, 2);
                            sMsg += " whereas this transaction will make the balance as " + DataType.toDecimal(arrMsg[iCounter].Tag, 2);
                            transEntryGlobal.showAlert(sMsg, GlobalPref.getResourceValue("msgSavingFailed"));

                            EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                            return;
                        }
                        break;
                    case eMessagesToUI.OverDueBillsApproval:
                        if (transEntryInfo.BaseVoucherType != eVTTYPE.SORDR && transEntryInfo.Settings.Misc.DontCheckCreditDays == false) {
                            result = DataType.stringToObject(objCustomData.objTransactionData.Header.Flags);
                            if (result.lValue <= 0) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                                return;
                            }

                            objFlags = result.data;

                            if (transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgOverDueBillsApproval")) == false) {
                                EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                                return;
                            }

                            objFlags.RequestCrDays = true;
                            objFlags.Suspended = true;
                            objFlags.CheckOverdueBills = false;
                            objCustomData.objTransactionData.Header.Flags = DataType.toString(objFlags);
                        }
                        break;
                    case eMessagesToUI.OverDueBillsWarn:
                        if(transEntryInfo.Settings.Misc.DontCheckCreditDays == false) {
                            sMsg = GlobalPref.getResourceValue("msgOverDueBillsWarn");
                            sMsg += ". A bill is pending for " + DataType.toInt(arrMsg[iCounter].Tag) + " days.";
                            transEntryGlobal.showAlert(sMsg, GlobalPref.getResourceValue("Warning"));
                        }
                        break;
                    case eMessagesToUI.OverDueBillsStop:
                        if(transEntryInfo.Settings.Misc.DontCheckCreditDays == false) {
                            sMsg = GlobalPref.getResourceValue("msgOverDueBillsStop");
                            strMsg += ". A bill is pending for " + DataType.toInt(arrMsg[iCounter].Tag) + " days.";

                            transEntryGlobal.showAlert(sMsg, GlobalPref.getResourceValue("msgSavingFailed"));

                            EntryMainToolbar.enableButtonBasedOnSaveSource(objCustomData.objInput.iSaveSource, true);

                            return;
                        }
                        break;
                }
            }

            if (objCustomData.bFromAdjustBill == false) {
                EntryMainUI.postVoucher(objCustomData.objTransactionData,
                                            false,
                                            objCustomData.objInput.sCallback,
                                            objCustomData.objInput.iSaveSource);

                return;
            }

            EntryMainBillwise.adjustBillFinal(objCustomData.objInput, objCustomData.objTransactionData);

        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainCallback.checkCreditLimit} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

