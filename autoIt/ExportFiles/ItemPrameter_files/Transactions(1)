                            if (transEntryInfo.BodySectionNotRequired == true) {
                            }
                            else {
                                transEntryFields.setRMA(objData.Value, cell.iRow, DataType.toString(arrRMA));
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, arrRMA, iRowCounter);
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                            if (transEntryInfo.BodySectionNotRequired == true) {
                                transEntryFields.setBillwise(objData.Value, 0, true);
                            }
                            else {
                                transEntryFields.setBillwise(objData.Value, cell.iRow, true);
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter);
                        }
                        else {
                            if (objData.Value === null) {
                                objData.Value = "";
                            }

                            if(DataType.isNullOrEmpty(objData.Value) == true && objDataInfo.isSetValueRequired(objMetaData.iFieldId) == false) {
                                break;
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);

                            if (transEntryInfo.BodySectionNotRequired == true) {
                                eleControl = document.getElementById(sId);
                                if (DataType.isValidObject(eleControl) == true) {
                                    eleControl.value = objData.Value;
                                }
                            }
                            else {
                                cell.autoHeight(false);
                                cell.setCellText(objData.Value, objData.Value);
                            }
                        }
                        break;
                    case eMasterDataType.HyperLink:
                        cell.setCellText(objData.Value, objData.Value);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.Fraction:
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            eleControl = document.getElementById(sId);
                            if (DataType.isValidObject(eleControl) == false) {
                                break;
                            }

                            if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                                temp = DataType.stringToObject(objData.Value).data;
                                if (DataType.isValidObject(temp) == false) {
                                    break;
                                }

                                eleControl.value = temp.Input;
                            }
                            else {
                                eleControl.value = objData.Value;
                            }
                        }
                        else {
                            if (objMetaData.iFieldId == eVTFIELDID.FDF_MAXQTYRELEASE) {
                                if (DataType.isNullOrEmpty(objData.Value) == true) {
                                    break;
                                }

                                objStockToRelease = DataType.stringToObject(objData.Value).data;

                                EntryMainMemoryObject.update(objMetaData.iFieldId, objStockToRelease, iRowCounter);
                                if (DataType.isValidObject(objStockToRelease) == false) {
                                    break;
                                }

                                transEntryMaxQtyRelease.setReservingId(cell.iRow, objStockToRelease.BaseTransactionId);
                                transEntryMaxQtyRelease.setMaxRelease(cell.iRow, objStockToRelease.Quantity);

                                objValue = objStockToRelease.Quantity;
                                dBaseQuantity = objResult.dBaseQuantity;
                                if (dBaseQuantity == 0) {
                                    dBaseQuantity = EntryMainMemoryObject.getBaseQuantityValue(cell.iRow);
                                }
                                if (dBaseQuantity < objValue) {
                                    objValue = EntryMainMemoryObject.getBaseQuantityValue(cell.iRow);
                                }

                                cell.setCellText(DataType.toDecimal(objValue, transEntryQuantity.getDecimals()), objValue);

                                transEntryGlobal.arrLoadedReleaseData.push({ iRow: cell.iRow, lReservingId: objStockToRelease.BaseTransactionId, lRefId: 0, dMaxReleaseValue: objStockToRelease.Quantity });                               
                            }
                            else {
                                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                                    temp = DataType.stringToObject(objData.Value).data;
                                    if (DataType.isValidObject(temp) == false) {
                                        break;
                                    }

                                    objValue = EntryMain.formatFractionNumber(objMetaData.iFieldId, temp.Input, objMetaData.iNoDecimal, iRowCounter);
                                    cell.setCellText(DataType.addNumericSeparator(objValue, transEntryCurrency.getNumericSeparator(cell.iRow)), objValue);
                                    transEntryScreenData.setCellOutputValue(cell, temp.Value, temp.Value);
                                    EntryMainMemoryObject.update(objMetaData.iFieldId, temp.Input, iRowCounter, temp.Value);
                                }
                                else {
                                    switch(objMetaData.iFieldId)
                                    {
                                        case eVTFIELDID.FDF_BODYAMOUNT:
                                            if (objCurrencyInfo.Area == eTranEntryFieldArea.Body
                                                && transEntryFieldInfo.Amount.ColumnIndex < objCurrencyInfo.ColumnIndex) {
                                                EntryMainUI.setBodyMastersData(objCurrencyInfo.FieldId, 
                                                                                iRowCounter, 
                                                                                arrColData, 
                                                                                arrMasterData);
                                            }

                                            transEntryFields.setAmount(objData.Value, iRowCounter, cell);
                                            break;
                                        case eVTFIELDID.FDF_BODYJRNDEBIT:
                                            transEntryFields.setDebit(objData.Value, iRowCounter, cell);
                                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter);
                                            break;
                                        case eVTFIELDID.FDF_BODYJRNCREDIT:
                                            transEntryFields.setCredit(objData.Value, iRowCounter, cell);
                                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter);
                                            break;
                                        case eVTFIELDID.FDF_BODYRATE:                                            
                                            objValue = objData.Value;
                                            if (transEntryInfo.Settings.Inventory.DoNotRoundOffRate == true) {
                                                sText = DataType.toString(objValue);
                                            }
                                            else {
                                                sText = FNumberOperation.toFixed(objData.Value, transEntrySettings.getDecimalsInAmount(iRowCounter));
                                            }
                                            cell.setCellText(DataType.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), objValue);
                                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, cell.iRow);
                                            break;
                                        case eVTFIELDID.FDF_BODYQUANTITY:
                                            if (objDataInfo.iCallingSource == eDisplayBodyDataSource.BomInput) {
                                                transEntryQuantity.setValue(objData.Value, cell.iRow, { ctrl: cell, bIgnoreUpdateTotal: true, bIgnoreDecimal: true, bUpdateMemoryObject: true });
                                            }
                                            else {
                                                transEntryQuantity.setValue(objData.Value, cell.iRow, { ctrl: cell, bIgnoreUpdateTotal: true, bUpdateMemoryObject: true });
                                            }
                                            break;
                                        case eVTFIELDID.FDF_BODYEXCHANGERATE:
                                            transEntryFields.setExchangeRate(objData.Value, cell.iRow, cell);
                                            break;
                                        default:
                                            sText = EntryMain.formatFractionNumber(objMetaData.iFieldId, objData.Value, objMetaData.iNoDecimal, iRowCounter);
                                            objValue = objData.Value;
                                            cell.setCellText(DataType.addNumericSeparator(sText, transEntryCurrency.getNumericSeparator(cell.iRow)), objValue);
                                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, cell.iRow, objMetaData);
                                            break;
                                    }
                                }
                            }
                        }

                        break;
                    case eMasterDataType.BigNumber:
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            eleControl = document.getElementById(sId);
                            if (DataType.isValidObject(eleControl) == true) {
                                eleControl.value = objData.Value;
                            }
                        }
                        else {
                            cell.setCellText(objData.Value);
                            cell.setCellData(objData.Value);
                        }
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, cell.iRow, objMetaData);
                        break;
                    case eMasterDataType.Master:
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                            OPTIONCONTROL.setValue(sId, objData.Value);
                            break;
                        }

                        if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);

                            objMasterData = EntryMainBody.getMasterData(objMetaData.iFieldId, objData.Value, arrMasterData);
                            if (DataType.isValidObject(objMasterData.arrData) == true) {
                                iItemId = EntryMainBody.setProductDataInCell(cell, objMasterData.arrData, objDataInfo.bPendingLinks, bDescriptionMappingExist, false, objDataInfo.iCallingSource);

                                // Fill View Info Fields 
                                EntryMainBody.updateViewInfoFields(objMetaData.iFieldId, cell);

                                // Update dependency
                                bLoadDependency = EntryMainDependency.isLoadDependencyBasedOnCallingSource(objDataInfo.iCallingSource);
                                if (bLoadDependency == true) {
                                    EntryMainDependency.processBodyProductDependency(cell.iRow,
                                                                                    cell.iColumn,
                                                                                    {
                                                                                        MasterTypeId: eMasterTypeId.Product,
                                                                                        CallingSource: objDataInfo.iCallingSource,
                                                                                        LoadedDataSource: objDataInfo.iLoadedDataSource
                                                                                    });
                                }
                                break;
                            }

                            iItemId = DataType.toInt(objData.Value);
                            if ((objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink
                                || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage
                                || objDataInfo.iCallingSource == eDisplayBodyDataSource.DisplayPendingData) 
                                && transEntrySettings.isShowCustomerAssignedProducts == true) {
                                arrDeleteRow.push(cell.iRow);
                            }

                            if (objMasterData.iIndex > -1) {
                                break;
                            }
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYUNITS) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);

                            objMasterData = EntryMainBody.getMasterData(objMetaData.iFieldId, iDataIndex, arrMasterData);
                            if (DataType.isValidObject(objMasterData.arrData) == true) {
                                EntryMainBody.updateMasterValue(cell, objMasterData.arrData, eVTFIELDID.FDF_BODYUNITS, false);

                                // Fill View Info Fields 
                                EntryMainBody.updateViewInfoFields(objMetaData.iFieldId, cell);
                                break;
                            }
                            else {
                                cell.clear();
                            }

                            if (objMasterData.iIndex > -1) {
                                break;
                            }

                            objResult.iUnitMasterValueIndex = iColCounter;
                            objResult.iUnitMetaDataIndex = iIndex;

                            objIdNamePair = FocusDataStructs.getIdNamePairObject();
                            objIdNamePair.ID = DataType.toInt(objData.Value); // UnitId
                            objIdNamePair.Tag = iItemId; // ItemId
                            arrUnits.push(objIdNamePair);
                        }
                        else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE) {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);

                            objMasterData = EntryMainBody.getMasterData(objMetaData.iFieldId, objData.Value, arrMasterData);
                            if (DataType.isValidObject(objMasterData.arrData) == true) {
                                EntryMainBody.setCodeDataInCell(cell, objMasterData.arrData, false);

                                // Fill View Info Fields 
                                EntryMainBody.updateViewInfoFields(objMetaData.iFieldId, cell);

                                // Update dependency
                                bLoadDependency = EntryMainDependency.isLoadDependencyBasedOnCallingSource(objDataInfo.iCallingSource);
                                if (bLoadDependency == true) {
                                    EntryMainDependency.processBodyAccountDependency(cell.iRow, cell.iColumn, objMetaData.iFieldId);
                                }
                                break;
                            }
                            else {
                                cell.clear();
                            }

                            if (objMasterData.iIndex > -1) {
                                break;
                            }
                        }
                        else {
                            bLoadDependency = EntryMainDependency.isLoadDependencyBasedOnCallingSource(objDataInfo.iCallingSource);

                            objMasterData = EntryMainBody.getMasterData(objMetaData.iFieldId, objData.Value, arrMasterData);
                            if (bLoadDependency == true) {
                                for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.arrDependentProductColumn.length; iCounter++) {
                                    if (transEntryGlobal.FieldHelper.arrDependentProductColumn[iCounter].FieldId == objMetaData.iFieldId) {
                                        if (transEntryGlobal.FieldHelper.arrDependentProductColumn[iCounter].ColumnIndex > transEntryFieldInfo.Item.ColumnIndex) {
                                            break;
                                        }
                                    }
                                }

                                if (iCounter < transEntryGlobal.FieldHelper.arrDependentProductColumn.length) {
                                    temp = DataType.getIdFromOptionData(objMasterData.arrData, false);
                                    if ((objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink
                                        || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage
                                        || objDataInfo.iCallingSource == eDisplayBodyDataSource.DisplayPendingData)
                                        && temp == undefined || temp == null || (temp != undefined && temp == 0)) {
                                        break;
                                    }
                                }
                                else {
                                    for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.arrDependentMasterColumn.length; iCounter++) {
                                        if (transEntryGlobal.FieldHelper.arrDependentMasterColumn[iCounter].FieldId == objMetaData.iFieldId) {
                                            if (transEntryGlobal.FieldHelper.arrDependentMasterColumn[iCounter].ColumnIndex > transEntryFieldInfo.Item.ColumnIndex) {
                                                break;
                                            }
                                            else if (transEntryGlobal.FieldHelper.arrDependentMasterColumn[iCounter].ColumnIndex < cell.iColumn) {
                                                break;
                                            }
                                        }
                                    }

                                    if (iCounter < transEntryGlobal.FieldHelper.arrDependentMasterColumn.length) {
                                        temp = DataType.getIdFromOptionData(objMasterData.arrData, false);
                                        if ((objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink
                                            || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage
                                            || objDataInfo.iCallingSource == eDisplayBodyDataSource.DisplayPendingData)
                                            && temp == undefined || temp == null || (temp != undefined && temp == 0)) {
                                            break;
                                        }
                                    }
                                }
                            }

                            EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                            if (DataType.isValidObject(objMasterData.arrData) == true) {
                                EntryMainBody.updateMasterValue(cell, objMasterData.arrData, objMetaData.iFieldId, false);

                                // Fill View Info Fields 
                                EntryMainBody.updateViewInfoFields(objMetaData.iFieldId, cell);

                                // Update dependency
                                if (bLoadDependency == true) {
                                    EntryMainDependency.processBodyOtherDependency(cell);
                                }
                                break;
                            }
                            else {
                                cell.clear();
                            }

                            if (objMasterData.iIndex > -1) {
                                break;
                            }
                        }

                        for (iCounter = 0; iCounter < arrMasterMetaDataIndex.length; iCounter++) {
                            if (arrMasterMetaDataIndex[iCounter] == iIndex) {
                                break;
                            }
                        }

                        if (iCounter >= arrMasterMetaDataIndex.length) {
                            arrMasterValueIndex.push(iColCounter);
                            arrMasterMetaDataIndex.push(iIndex);
                        }
                        break;
                    case eMasterDataType.ExternalTable:
                        if(DataType.toInt(objData.Value) == 0 && objDataInfo.isSetValueRequired(objMetaData.iFieldId) == false) {
                            break;
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        if (transEntryInfo.BodySectionNotRequired == true) {
                            OPTIONCONTROL.setValue(sId, objData.Value);
                            break;
                        }

                        for (iCounter = 0; iCounter < arrMasterMetaDataIndex.length; iCounter++) {
                            if (arrMasterMetaDataIndex[iCounter] == iIndex) {
                                break;
                            }
                        }

                        if (iCounter >= arrMasterMetaDataIndex.length) {
                            arrMasterValueIndex.push(iColCounter);
                            arrMasterMetaDataIndex.push(iIndex);
                        }
                        break;
                    case eMasterDataType.Boolean:                        
                        if (transEntryInfo.BodySectionNotRequired == true) {
                        }
                        else {
                            EntryMainBody.initBooleanColumn(cell, objData.Value == 1 ? true : false, objMetaData.bReadOnly);
                        }
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.Picture:
                    case eMasterDataType.DocumentViewer:
                        EntryMainBody.updateAttachmentValue(cell, objData.Value, objMetaData.iFieldId, true);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        EntryMainBody.updateNumberValue(cell, objData.Value, objMetaData.iFieldId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.Date:
                        if(DataType.toInt(objData.Value) == 0 && objDataInfo.isSetValueRequired(objMetaData.iFieldId) == false) {
                            break;
                        }

                        EntryMainBody.updateDateValue(cell, objData.Value, objMetaData.iFieldId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.Time:
                        if(DataType.toInt(objData.Value) == 0 && objDataInfo.isSetValueRequired(objMetaData.iFieldId) == false) {
                            break;
                        }

                        EntryMainBody.updateTimeValue(cell, objData.Value, objMetaData.iFieldId, false);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.StringList:
                        if ((objData.Value == undefined || objData.Value == null)
                            && objMetaData.bMandatory == false
                            && (objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage || objDataInfo.iCallingSource == eDisplayBodyDataSource.DisplayPendingData)) {

                            eleControl = document.getElementById(sId);
                            if (DataType.isValidObject(eleControl) == true && eleControl.options.length > 0) {
                                objData.Value = eleControl.options[0].text;
                            }
                        }

                        EntryMainBody.updateStringListValue(cell, objData.Value, objMetaData.iFieldId, false);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                    case eMasterDataType.NumberList:
                        if ((objData.Value == undefined || objData.Value == null)
                            && objMetaData.bMandatory == false
                            && (objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage || objDataInfo.iCallingSource == eDisplayBodyDataSource.DisplayPendingData)) {

                            eleControl = document.getElementById(sId);
                            if (DataType.isValidObject(eleControl) == true && eleControl.options.length > 0) {
                                objData.Value = eleControl.options[0].value;
                            }
                        }

                        EntryMainBody.updateNumberListValue(cell, objData.Value, objMetaData.iFieldId, false);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, objData.Value, iRowCounter, objMetaData);
                        break;
                }
            }

            transEntryGrid.markRowReadOnly(iRowCounter, bRowReadOnly);

        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.setBodyRowData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objResult);
    },

    getBodyRowData: function (iCurrentRow, iMaskedVoucherType, objHeaderInvTagValue, bCheckForMandatory, arrFields) {
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let iVoucherType = 0;
        let iDecimals = 0;
        let iAccountTypeId = 0;
        let iProductType = 0;
        let dExchangeRate = 0;
        let dValue = 0;
        let dOrgBaseValue = 0;
        let bFound = false;
        let bLayout = false;
        let cell = null;
        let result = null;
        let data = null;
        let objTemp = null;
        let objLink = null;
        let objDocument = null;
        let arrLink = null;
        let objValidateResult = null;
        let objSetRowInfo = null;
        let bUpdateStock = null;
        let objValue = null;
        let objMetaData = null;
        let objBillwise = null;
        let objIdNamePair = undefined;
        let objCell = null;

        try {
            result = COMMON.prototype.getEmptyResultObject();
            result.lValue = 0;
            result.sValue = "";
            result.data = null;

            data = {};
            data.BodyId = transEntryFields.getBodyId(iCurrentRow);
            data.TransactionId = transEntryFields.getTransactionId(iCurrentRow);
            data.MainBodyId = transEntryFields.getMainBodyId(iCurrentRow);
            data.SchemeId = transEntryFields.getSchemeId(iCurrentRow);
            data.SchemeSource = transEntryFields.getSchemeSource(iCurrentRow);
            data.SchemeBodyId = transEntryFields.getSchemeBodyId(iCurrentRow);

            data.Flags = EntryMainUI.getBodyFlags(iCurrentRow);
            data.Flags = DataType.toString(data.Flags);
            data.AuthStatus = transEntryFields.getAuthStatus(iCurrentRow);

            data.objTempValues = {};
            data.objTempValues.iRow = iCurrentRow;

            if (transEntryFieldInfo.SetQty.ColumnIndex > -1) {
                data.SetId = EntryMainSet.getId(iCurrentRow);
                if (data.SetId > 0) {
                    objSetRowInfo = EntryMainSet.getRowInfo(iCurrentRow);
                }
            }

            bUpdateStock = transEntryFields.getUpdateStockValue();

            iVoucherType = transEntryInfo.BaseVoucherType;
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                if (EntryMainMaster.isInfoField(arrFields[iCounter].FieldId, false) == true) {
                    continue;
                }

                objMetaData = arrFields[iCounter].MetaData;
                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                bLayout = false;
                bFound = false;
                if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                    bLayout = true;                    
                    objValue = undefined;

                    if (EntryMain.m_objTrans.BodyData[iCurrentRow - 1].BodyExtra) {                        
                        for (iIndex = 0; iIndex < EntryMain.m_objTrans.BodyData[iCurrentRow - 1].BodyExtra.length; iIndex++) {
                            objIdNamePair = EntryMain.m_objTrans.BodyData[iCurrentRow - 1].BodyExtra[iIndex];
                            if (objIdNamePair.ID == objMetaData.iFieldId) {
                                objValue = objIdNamePair.Tag;
                                bFound = true;
                                break;
                            }
                        }
                    }
                }


                if (objMetaData.iDataTypeId == eMasterDataType.Text) {
                    if (bFound == true) {
                        if (DataType.isNullOrEmpty(objValue) == true && bCheckForMandatory == true) {
                            if (objMetaData.bMandatory == true) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                result.data = null;

                                return (result);
                            }
                            else {
                                objCell = transEntryGrid.getCellElement(iCurrentRow, iCounter);
                                if (EntryMainRules.isRuleMandatoryColumn(objCell, true) == 1) {
                                    result.lValue = 0;
                                    result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                    result.data = null;

                                    return (result);
                                }
                            }
                        }

                        if (DataType.isNullOrEmpty(objValue) == false) {
                            if (typeof (objValue) != "string") {
                                objValue = DataType.toString(objValue);
                            }

                            objValue = objValue.replace("\r\n", "\n");
                            objValue = objValue.replace("\n", "\r\n");

                            if (objMetaData.iMaxSize > 0 && objValue.length > objMetaData.iMaxSize) {
                                objValue = DataType.stringLeft(objValue, objMetaData.iMaxSize);
                            }
                        }

                        data[sId] = objValue;
                        continue;
                    }
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.HyperLink) {
                    if (bFound == true) {
                        if (DataType.isNullOrEmpty(objValue) == true) {
                            if (bCheckForMandatory == true && objMetaData.bMandatory == true) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                result.data = null;

                                return (result);
                            }
                        }
                        data[sId] = objValue;
                        continue;
                    }

                    //continue;
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.ExternalTable) {
                    if (bFound == true) {
                        if (DataType.isInteger(objValue) == false) {
                            objValue = '0';
                        }

                        if (bCheckForMandatory == true && FNumberOperation.isLessThan(objValue, 1) == true) {
                            if (objMetaData.bMandatory == true) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                result.data = null;

                                return (result);
                            }
                            else {
                                objCell = transEntryGrid.getCellElement(iCurrentRow, iCounter);
                                if (EntryMainRules.isRuleMandatoryColumn(objCell, true) == 1) {
                                    result.lValue = 0;
                                    result.sValue = GlobalPref.getResourceValue("msgColumnValueMissing") + transEntryGlobal.getHeading(objMetaData.iFieldId);
                                    result.data = null;

                                    return (result);
                                }
                            }
                        }

                        data[sId] = DataType.toInt(objValue);
                        continue;
                    }
                }
                else if (objMetaData.iDataTypeId == eMasterDataType.Master) {
                    if (bLayout == false) {
