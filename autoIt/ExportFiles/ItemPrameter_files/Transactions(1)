    CheckNumericCharLength: function (strSeries) {
        var strNumber = "";
        var strAlpha = "";
        try {
            var iLen = strSeries.length;

            //loop from end of the text till alpha value found and
            //set value to number part
            while (iLen > 0) {
                var ch = strSeries[iLen - 1];
                var charCode = strSeries.charCodeAt(iLen - 1);
                if (charCode >= 48 && charCode <= 57) {
                    strNumber += ch;
                }
                else {
                    break;
                }
                iLen--;
            }

            //seperate alpha and number value from text 
            strAlpha = strSeries.substring(0, iLen);
            iLen = strNumber.length;
            strSeries = "";

            //reverse number part 
            while (iLen > 0) {
                strSeries += strNumber[iLen - 1];
                iLen--;
            }
            return strSeries.length;
        }
        catch (err) {
            return -1;
        }
