    prepareFilter: function (arrFilterCriteria, iRow) {
        let sFilterCondition = "";
        let iCounter = 0;
        let value = undefined;

        try {
            if (DataType.arrayLength(arrFilterCriteria) < 1) {
                return ("");
            }

            for (iCounter = 0; iCounter < arrFilterCriteria.length; iCounter++) {
                if (iCounter == 0) {
                    sFilterCondition = "(";
                }

                if (DataType.isNullOrEmpty(arrFilterCriteria[iCounter].FilterOnColumn, true) == true) {
                    return ("");
                }

                sFilterCondition += " " + arrFilterCriteria[iCounter].FilterOnColumn;

                switch(arrFilterCriteria[iCounter].OperatorID)
                {
                    case 0: // =
                        sFilterCondition += " = ";
                        break;
                    case 1: // !=
                        sFilterCondition += " != ";
                        break;
                    case 2: // >
                        sFilterCondition += " > ";
                        break;
                    case 3: // >=
                        sFilterCondition += " >= ";
                        break;
                    case 4: // <
                        sFilterCondition += " < ";
                        break;
                    case 5: // <=
                        sFilterCondition += " <= ";
                        break;
                }

                if (arrFilterCriteria[iCounter].CompareWith == 0) { // Value
                    if (DataType.isValidObject(arrFilterCriteria[iCounter].FilterField) == true) {
                        sFilterCondition += " N'" + arrFilterCriteria[iCounter].FilterField + "' ";
                    }
                    else {
                        sFilterCondition += " N'' ";
                    }
                }
                else { // Field
                    value = transEntryFields.getValueByArea(arrFilterCriteria[iCounter].FilterFieldID, false, iRow);
                    if (value.lValue > 0) {
                        sFilterCondition += " N'" + value.data + "' ";
                    }
                    else {
                        sFilterCondition += " N'' ";
                    }
                }

                if (arrFilterCriteria[iCounter].Conjunction == 1) {
                    sFilterCondition += " AND ";
                }
                else if (arrFilterCriteria[iCounter].Conjunction == 2) {
                    sFilterCondition += " OR ";
                }
                else {
                    sFilterCondition += " ) ";
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.prepareFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (sFilterCondition);
    },

