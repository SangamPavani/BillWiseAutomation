TRANSACTION_ENTRY.SCREENSIZE = {
    getInitialColumnWidth: function () {
        let sWidth = "";
        let sGridCtrlId = "";
        let iCounter = 0;
        let eleColumnWidth = null;
        let arrWidth = [];

        try {
            eleColumnWidth = document.getElementById("id_transaction_entry_body_columnwidth");
            if (DataType.isValidObject(eleColumnWidth) == false) {
                return (arrWidth);
            }
            sWidth = eleColumnWidth.value;

            if (DataType.isNullOrEmpty(sWidth) == true) {
                sGridCtrlId = transEntryGrid.getGridId();
                arrWidth = FGRIDCONTROL.getColumnWidthArray(sGridCtrlId);

                eleColumnWidth.value = DataType.arrayToCSV(arrWidth);
            }
            else {
                arrWidth = DataType.arrayFromCSV(sWidth);
                for (iCounter = 0; iCounter < arrWidth.length; iCounter++) {
                    arrWidth[iCounter] = DataType.toInt(arrWidth[iCounter]);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{TRANSACTION_ENTRY.SCREENSIZE.getInitialColumnWidth}" + err.message, "Exception");
        }

        return (arrWidth);
    },

    adjustGridColumns: function () {
        let iTotalWidth = 0;
        let iCurrentWidth = 0;
        let iSNOWidth = 0;
        let arrWidth = [];
        let iTotalVisibleColumns = 0;
        let iLastVisibleIndex = 0;
        let iDifference = 0;
        let iCounter = 0;
        let iExtraWidth = 0;
        let bAdjust = false;
        let bAdd = false;
        let eleBody = null;

        try {
            iTotalWidth = document.getElementById("id_transactionentry_body_section").getBoundingClientRect().width - 10;

            eleBody = transEntryGrid.getBodyElement();
            objScrollInfo = FUIElement.hasScrollBar(eleBody);
            if (objScrollInfo.vertical == true) {
                iTotalWidth -= objScrollInfo.scrollbarwidth;
            }


            arrWidth = TRANSACTION_ENTRY.SCREENSIZE.getInitialColumnWidth();

            iSNOWidth = arrWidth[0];
            arrWidth[0] = -1;
            iTotalVisibleColumns = 0;
            iLastVisibleIndex = -1;
            iCurrentWidth = 0;
            for (iCounter = 0; iCounter < arrWidth.length; iCounter++) {
                if (arrWidth[iCounter] < 0) {
                    continue;
                }

                iCurrentWidth += arrWidth[iCounter];
                iTotalVisibleColumns++;
                iLastVisibleIndex = iCounter;
            }

            iCurrentWidth += iSNOWidth;



            iTotalWidth = Math.floor(iTotalWidth);
            iDifference = (iTotalWidth - iCurrentWidth);
            if (iCurrentWidth < iTotalWidth && iDifference >= iTotalVisibleColumns) {

                transEntryGlobal.bAdjustedBodyWidth = true;
                iExtraWidth = Math.floor(iDifference / iTotalVisibleColumns);

                bAdjust = true;
                bAdd = true;
            }
            else if (transEntryGlobal.bAdjustedBodyWidth == true) {
                if (iDifference < 0) {
                    iDifference = Math.abs(iDifference);
                    if (iDifference >= iTotalVisibleColumns) {
                        iExtraWidth = Math.floor(iDifference / iTotalVisibleColumns);
                    }
                    else {
                        iExtraWidth = 1;
                    }

                    bAdjust = true;
                    bAdd = false;
                }
            }

            if (bAdjust == true) {
                for (iCounter = 0; iCounter < arrWidth.length; iCounter++) {
                    if (arrWidth[iCounter] < 0) {
                        continue;
                    }


                    if (iCounter == iLastVisibleIndex) {
                        iExtraWidth -= 1;
                    }

                    if (bAdd == true) {
                        arrWidth[iCounter] += iExtraWidth;
                    }
                    else {
                        arrWidth[iCounter] -= iExtraWidth;
                    }
                }

                transEntryGrid.adjustColumnWidth(arrWidth);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{TRANSACTION_ENTRY.SCREENSIZE.adjustGridColumns}" + err.message, "Exception");
        }
    }
};

