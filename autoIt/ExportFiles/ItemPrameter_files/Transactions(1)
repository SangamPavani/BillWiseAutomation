    onKeyUp: function (evt) {
        let iRow = 0;
        let iColumn = 0;
        let iKeyCode = 0;
        let obj = null;
        let objField = null;
        let arrData = null;
        let objLinkData = null;

        try {
            if (DataType.isValidObject(evt.currentTarget) == true) {
                if (evt.currentTarget.id == EntryMainUI.getBodyEntryContainer().id) {
                    iRow = transEntryGrid.getCurrentRow();
                    iColumn = transEntryGrid.getCurrentColumn();
                }
            }

            iKeyCode = (evt.which || evt.keyCode);
            if (transEntryGlobal.debugKeyPreview == true
                && (evt.shiftKey == true || evt.altKey == true || evt.ctrlKey == true)
                && iKeyCode != 0 && iKeyCode != 16 && iKeyCode != 17 && iKeyCode != 18) {
                debugger
            }

            obj = transEntryExternalModule.getExternalModuleFunctionKeyEvent(evt);
            if (obj.iKeyEvent > 0) {
                arrData = transEntryExternalModule.filterModulesOnEvent(transEntryInfo.Settings.ArrExternalModules, obj.iKeyEvent);
                if (arrData.length > 0) {
                    transEntryExternalModule.callExternalModule(obj.iKeyEvent, 0, "", iRow, iColumn);

                    return;
                }

                if (DataType.isNullOrEmpty(obj.sSourceId, true) == true) {
                    return;
                }

                objField = EntryMainUI.getFieldIdFromControlId(obj.sSourceId);
                if (objField.iFieldId > 0) {
                    transEntryExternalModule.callExternalModuleOnField(obj.iKeyEvent, objField.iFieldId, "", objField.bBody == true ? transEntryGrid.getCurrentRow() : 0);
                }

                return;
            }
            else {
                if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == true && iKeyCode == eKeyCode.C) { // Alt + Ctrl + Key.C
                    EntryMainToolbar.onCopyToClipboard_Click();
                    transEntryGlobal.showAlert("Data copied.");
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == true && iKeyCode == eKeyCode.V) { // Alt + Ctrl + Key.V
                    EntryMainToolbar.onPasteFromClipboard_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == true && iKeyCode == eKeyCode.D) { // Alt + Ctrl + Key.D
                    EntryMainToolbar.onCopyDocument_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == false && evt.ctrlKey == true && iKeyCode == eKeyCode.L) { // Ctrl + Key.L
                    if (transEntryGlobal.EntryModel.bHasWorkflow == true && transEntryGlobal.EntryModel.Extras.bBodySectionNotRequired == false) {
                        if (GlobalPref.Version == eVersion.Version9) {
                            TRANSACTION_ENTRY.WORKFLOW.updateWorkflowPanel(true);
                        }
                        else {
                            transEntryGrid.update();
                            TRANSACTION_ENTRY.WORKFLOW.openPopup(0);
                        }
                    }
                }
                else if (evt.shiftKey == false && evt.altKey == false && evt.ctrlKey == true && iKeyCode == eKeyCode.S) { // Ctrl + Key.S
                    FUIElement.stopKeyProcess(evt);

                    obj = FUIElement.getActiveElementDetail();
                    if (obj.bHeader == true || obj.bFooter == true) {
                        obj.Element.blur();

                        setTimeout(function () {
                            EntryMainToolbar.onSave_Click();
                        }, 0);
                    }
                    else {
                        EntryMainToolbar.onSave_Click();
                    }

                    //FUIElement.stopKeyProcess(evt);
                    //EntryMainToolbar.onSave_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == false && iKeyCode == eKeyCode.R) { // Alt + Key.R
                    EntryMainToolbar.onPrevious_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == false && iKeyCode == eKeyCode.E) { // Alt + Key.E
                    EntryMainToolbar.onNext_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == false && iKeyCode == eKeyCode.N) { // Alt + Key.N
                    EntryMainToolbar.onNew_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == false && iKeyCode == eKeyCode.P) { // Alt + Key.P
                    EntryMainToolbar.onPrint_Click();
                }
                else if (evt.shiftKey == false && evt.altKey == true && evt.ctrlKey == false && iKeyCode == eKeyCode.X) { // Alt + Key.X
                    EntryMainToolbar.onExportToXML_Click();
                }
                else if (evt.altKey == true && evt.ctrlKey == true && evt.keyCode == eKeyCode.B) { // Alt + Ctrl + Key.B (Print Barcode)
                    EntryMainToolbar.onPrintBarcode_Click();
                }
                else if (evt.altKey == true && evt.ctrlKey == true && evt.keyCode == eKeyCode.I) { // Alt + Ctrl + Key.I (Duplicate Row)
                    iRow = transEntryGrid.getCurrentRow();
                    iColumn = transEntryGrid.getCurrentColumn();
                    if (iRow != -1 && iColumn != -1) {
                        EntryMainBody.onDuplicateRow(iRow, [eVTFIELDID.FDF_LINK, eVTFIELDID.FDF_REFERENCE], evt);
                        transEntryGrid.gotoCell(iRow, iColumn - 1);
                    }
                }
