    getRequiredRows: function (iPageNo) {
        let iTotalRecords = 0;
        let iDataPerPage = 0;

        try {
            iTotalRecords = transEntryWorkflowInfo.TotalRows;
            iDataPerPage = transEntryWorkflowInfo.RowsPerPage;

            if (iPageNo < 2) {
                if (iDataPerPage >= iTotalRecords) {
                    return (iTotalRecords);
                }
                else {
                    return (iDataPerPage);
                }
            }
            else {
                iPageNo--;
                iPageNo *= iDataPerPage;
                if ((iPageNo + iDataPerPage) >= iTotalRecords) {
                    return (iTotalRecords - iPageNo);
                }
                else {
                    return (iDataPerPage);
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.getRequiredRows} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (0);
