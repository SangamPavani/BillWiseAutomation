                    EntryMainMaster.onBook_Leave(cellobj, objMetaData.iFieldId);
                    break;
                case eVTFIELDID.FDF_BODYCURRENCY:
                    EntryMainMaster.onCurrency_Leave(cellobj, objMetaData.iFieldId);
                    break;
                case eVTFIELDID.FDF_BODYUNITS:
                    EntryMainMaster.onUnit_Leave(cellobj, objMetaData.iFieldId);
                    break;
                case eVTFIELDID.FDF_HEADERINVTAG:
                case eVTFIELDID.FDF_BODYINVTAG:
                    EntryMainMaster.onInvTag_Leave(cellobj, objMetaData.iFieldId);
                    break;
                default:
                    EntryMainMaster.onBodyOthers_Leave(cellobj, objMetaData);
                    break;
            }

            if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYPRODUCT) {

            }

            if (EntryMain.isDataLoading() == false
                && DataType.isValidObject(transEntryInfo.Settings.VoucherScheme) == true
                && transEntryInfo.Settings.VoucherScheme.bEnableScheme == true
                && objMetaData.iMasterTypeId > 0 && objMetaData.iMasterTypeId == transEntryInfo.TagsPref.iSchemes) {

                EntryMainScheme.removeScheme();
                EntryMainScheme.applyScheme(0);
            }

            iCurrentValue = transEntryGrid.getCellValue(cellobj, objMetaData);

            if (EntryMain.isDataLoading() == false && iLastValue != iCurrentValue) {
                EntryMainUI.resetCOGSDetail();

                EntryMainDependency.setBodyDependencyFilter(cellobj, objMetaData);
            }

            if (EntryMain.isDataLoading() == false
                && iLastValue != iCurrentValue
                && transEntryFieldInfo.Billwise.ColumnIndex > -1
                && objMetaData.iMasterTypeId > 0) {

                if (objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iARTagId) {
                    EntryMainBillwise.updateDirtyRowFlag(cellobj.iRow, objMetaData.iFieldId);
                }

                if (objMetaData.iMasterTypeId == transEntryInfo.ARAPPref.iAPTagId) {
                    EntryMainBillwise.updateDirtyRowFlag(cellobj.iRow, objMetaData.iFieldId);
                }
            }

            if (objMetaData.iMasterTypeId > 0
                && objMetaData.iMasterTypeId == transEntryInfo.PricebookTag
                && iLastValue != iCurrentValue) {
                if (EntryMainBody.reloadRate(cellobj.iRow) == true) {
                    EntryMainUI.setSummaryInfo(0);
                }
            }

            EntryMainBody.processDataChange(iLastValue, iCurrentValue, cellobj.iRow, objMetaData.iFieldId);

            EntryMainBody.updateViewInfoFields(objMetaData.iFieldId, cellobj);
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onMasterLeave method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onMasterLeave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bResult);
    },

    onTextEnter: function (cellobj, objMetaData, evt, PreloadValue, bReadOnly, objOutput, objCustomData) {
        let sText = "";
        let objFormula = undefined;
        let element = null;

        try {
            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_REFERENCE:
                    if (transEntryReference.processCellEnter(cellobj, evt) == true) {
                        return;
                    }
                    break;
                case eVTFIELDID.FDF_BODYBATCHNO:
                    if (transEntryGlobal.debugBatch == true) {
                        debugger
                    }

                    if (EntryMainBatch.processCellEnter(PreloadValue, cellobj, evt) == false) {
                        return;
                    }

                    sText = cellobj.getCellText();
                    if (DataType.isNullOrEmpty(sText) == false) {
                        objFormula = EntryMainBody.hasFormula(objMetaData);
                        if (objFormula.bResult == false || objFormula.bRefresh == false) {
                            PreloadValue = cellobj.getCellText();
                        }

                        //PreloadValue = cellobj.getCellText();
                    }

                    break;
                case eVTFIELDID.FDF_RMANO:
                    EntryMainRMA.processCellEnter(cellobj, evt);
                    return;
                case eVTFIELDID.FDF_LINK:
                    if (transEntryGlobal.debugLink == true) {
                        debugger
                    }

                    if (transEntryInfo.isStockAdjustment == true) {
                        cellobj.processDefault(evt, false, true);
                    }
                    else {
                        EntryMainWorkflow.processCellEnter(cellobj, evt);
                    }
                    return;
                case eVTFIELDID.FDF_BINS:
                    EntryMainBins.onEnter(cellobj, evt, objCustomData, false);
                    return;
                case eVTFIELDID.FDF_BINS2:
                    EntryMainBins.onEnter(cellobj, evt, objCustomData, true);
                    return;
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                    EntryMainReservation.processCellEnter(cellobj, evt);
                    return;
                case eVTFIELDID.FDF_DEPTAPPROP:
                    transEntryDeptApprop.onEnter(cellobj, evt);
                    return;
            }

            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
            if (DataType.isValidObject(element) == true) {
                cellobj.setControl(element, PreloadValue);

                objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
            }
            else {
                cellobj.processDefault(evt, false, true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onTextEnter method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onTextEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onTextLeave: function (cellobj, objMetaData, objLeaveData) {
        let objLastValue = 0;
        let objCurrentValue = 0;
        let bHandled = false;
        let bResult = true;
        let element = null;

        try {
            objLastValue = DataType.toString(cellobj.getCellData());
            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_BODYBATCHNO:
                    if (transEntryGlobal.debugBatch == true) {
                        debugger
                    }

                    EntryMainBatch.onBatchNoColumn_Leave(cellobj);

                    objCurrentValue = DataType.toString(cellobj.getCellData());
                    if (transEntryGrid.isBatchInputRequired(cellobj.iRow) == true) {
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, objCurrentValue, cellobj.iRow);
                    }
                    else if (transEntryGrid.isBatchPopupRequired(cellobj.iRow) == false) {
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYBATCHNO, undefined, cellobj.iRow);
                    }

                    if (transEntryInfo.isInwardVoucher == true && objLastValue != objCurrentValue) {
                        EntryMainUI.valueChanged(objMetaData, cellobj.iRow, cellobj.iColumn);
                    }

                    EntryMainBody.processDataChange(objLastValue, objCurrentValue, cellobj.iRow, objMetaData.iFieldId);
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_BINS:
                    EntryMainBins.onLeave(cellobj, objMetaData, objLeaveData, objLastValue, false);
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_BINS2:
                    EntryMainBins.onLeave(cellobj, objMetaData, objLeaveData, objLastValue, true);
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_RESERVEQUANTITY:
                    if (DataType.isNullOrEmpty(objLastValue) == false) {
                        transEntryReservation.setText(cellobj.iRow, "Reserved");
                    }
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_DEPTAPPROP:
                    transEntryDeptApprop.onLeave(cellobj, objMetaData);
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_LINK:
                    if (transEntryGlobal.debugLink == true) {
                        debugger
                    }

                    if (transEntryInfo.isStockAdjustment == true) {
                        bHandled = true;
                        bResult = true;
                    }
                    break;
                case eVTFIELDID.FDF_RMANO:
                    EntryMainRMA.processCellLeave(cellobj);
                    bHandled = true;
                    bResult = true;
                    break;
                case eVTFIELDID.FDF_RFID:
                    EntryMainBody.onRFID_Leave(cellobj);
                    break;
            }

            if (bHandled == true) {
                return (bResult);
            }

            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
            if (DataType.isValidObject(element) == true) {
                cellobj.setCellText(element.value, element.value);
                objCurrentValue = DataType.toString(cellobj.getCellData());
                EntryMainBody.processDataChange(objLastValue, objCurrentValue, cellobj.iRow, objMetaData.iFieldId);

                if (objMetaData.iFieldId != eVTFIELDID.FDF_LINK) {
                    EntryMainMemoryObject.update(objMetaData.iFieldId, objCurrentValue, cellobj.iRow, objMetaData);
                }

                element.value = "";
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onTextLeave method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onTextLeave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bResult);
    },

    onFractionEnter: function (cellobj, objMetaData, evt, PreloadValue, bReadOnly, objOutput) {
        let sText = "";
        let iPrecision = 0;
        let iRowIndex = 0;
        let bDoNotUsePrecision = false;
        let objFillDataInput = undefined;
        let objFillFinalInput = undefined;
        let objTemp = null;

        try {
            if (bReadOnly == true) {
                objTemp = DataType.toDecimal(cellobj.getCellData());
                cellobj.setCellData("focusvalue", objTemp.toString());
            }
            else {
                cellobj.resetCellData("focusvalue");
            }

            bDoNotUsePrecision = false;
            if (objMetaData.iFieldId == eVTFIELDID.FDF_BALANCEQTY) {
                EntryMainStockRevaluation.processBalanceQty(cellobj, evt);
                return;
            }
            else if (objMetaData.iFieldId == eVTFIELDID.FDF_AVGRATE) {
                EntryMainStockRevaluation.processAvgRate(cellobj, evt);
                return;
            }
            else if (objMetaData.iFieldId == eVTFIELDID.FDF_BALANCESTKVAL) {
                EntryMainStockRevaluation.processBalanceStockValue(cellobj, evt);
                return;
            }
            else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE && transEntryInfo.Settings.Inventory.DoNotRoundOffRate == true) {
                bDoNotUsePrecision = true;
            }
            else if (objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE
                || objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE1
                || objMetaData.iFieldId == eVTFIELDID.FDF_BATCHRATE2) {

                if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, cellobj.iRow) == false) {
                    cellobj.clear();
                    cellobj.processDefault(evt, false, true);

                    return;
                }
            }


            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_NEWAVGRATE:
                    iPrecision = transEntryCurrency.getDecimals(cellobj.iRow);
                    break;
                case eVTFIELDID.FDF_NEWSTKVAL:
                    iPrecision = transEntryCurrency.getDecimals(cellobj.iRow);
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    iPrecision = transEntryQuantity.getDecimals(cellobj.iRow);
                    break;
                default:
                    iPrecision = DataType.toInt(cellobj.ColumnAttribute.iprecision);
                    break;
            }

            if (bDoNotUsePrecision == false && iPrecision == 0) {
                objTemp = EntryMainUI.getRequiredDecimalPlaces(objMetaData.iFieldId, cellobj.iRow);
                if (objTemp.lValue > 0) {
                    iPrecision = objTemp.data;
                }
            }

            if (PreloadValue != "" || objMetaData.bMandatory == false) {
                if (bDoNotUsePrecision == true) {
                    if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE) {
                        PreloadValue = transEntry.rectifyRateValue(DataType.toDecimal(PreloadValue));
                    }
                    else {
                        PreloadValue = transEntry.rectifyAmountValue(DataType.toDecimal(PreloadValue));
                    }
                }
                else {
                    if (iPrecision > 0) {
                        PreloadValue = DataType.formatToDecimalPlaces(PreloadValue, iPrecision);
                    }
                    else {
                        objTemp = EntryMainUI.getRequiredDecimalPlaces(objMetaData.iFieldId, cellobj.iRow);
                        if (objTemp.lValue > 0) {
                            iPrecision = objTemp.data;
                        }

                        PreloadValue = DataType.toDecimal(PreloadValue, iPrecision);
                    }
                }
            }

            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_BATCHRATE:
                    if (DataType.toDecimal(PreloadValue) == 0) {
                        if (transEntryInfo.BatchPref.iIncludeOtherValuesInBatches > 0) {
                            objFillDataInput = EntryMainCalculation.getFillDataInput(true, false, cellobj.iRow, undefined);
                            EntryMainCalculation.fillData(objFillDataInput);

                            objFillFinalInput = EntryMainCalculation.getFillFinalInput(false, objFillDataInput.Output.objOutputTrans, objFillDataInput.Output.arrCodeTypes, objFillDataInput.Output.arrBookTypes);
                            EntryMainCalculation.fillFinal(objFillFinalInput);
                            transEntryGlobal.updateIntermediateData(objFillFinalInput.objTrans, objFillFinalInput.arrCodeTypes, objFillFinalInput.arrBookTypes);

                            if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction) == false) {
                                break;
                            }

                            if (DataType.isValidObject(transEntryGlobal.IntermediateData.objTransaction.BodyData) == false) {
                                break;
                            }

                            if (transEntryGlobal.IntermediateData.objTransaction.BodyData.length < cellobj.iRow) {
                                break;
                            }

                            iRowIndex = transEntryGrid.getTransactionDataRowIndex(transEntryGlobal.IntermediateData.objTransaction, cellobj.iRow);
                            if (iRowIndex > -1) {
                                PreloadValue = DataType.toDecimal(transEntryGlobal.IntermediateData.objTransaction.BodyData[iRowIndex].Amounts[1] / transEntryGlobal.IntermediateData.objTransaction.BodyData[iRowIndex].Sales.BaseQuantity, transEntrySettings.getDecimalsInAmount(cellobj.iRow));
                            }
                        }
                        else if (transEntryFieldInfo.Rate.ColumnIndex > -1) {
                            PreloadValue = EntryMainMemoryObject.getRateValue(cellobj.iRow, true);
                        }
                    }
                    break;
                case eVTFIELDID.FDF_BODYRATE:
                    if (bReadOnly == true
                        && DataType.isNullOrEmpty(objMetaData.sPreload, true) == false
                        && transEntryFieldInfo.Gross.ColumnIndex > -1) {

                        transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow, dRate: DataType.toDecimal(PreloadValue) });
                    }
                    break;
            }

            if (bDoNotUsePrecision == false) {
                FNUMERICCONTROL.setDecimalPlaces(cellobj.ColumnAttribute.ctrlid, iPrecision);
            }

            sText = cellobj.setControl(cellobj.ColumnAttribute.ctrlid, PreloadValue);
            if (DataType.isValidObject(sText) == true) {
                cellobj.setCellData("focustext", sText);
            }
            else {
                cellobj.resetCellData("focustext");
            }


            if (bReadOnly == true) {
                FUIElement.unselectText(cellobj.ColumnAttribute.ctrlid);
                cellobj.setCellData(DataType.toDecimal(PreloadValue));
            }

            objOutput.bHandleReadOnlyFields = EntryMainBody.handleReadOnlyFieldsForEnterCell(cellobj, bReadOnly, evt);
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onFractionEnter method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onFractionEnter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onFractionLeave: function (cellobj, objMetaData) {
        let iCounter = 0;
        let dLastValue = 0;
        let dCurrentValue = 0;
        let dRawOutput = 0;
        let dRate = 0;
        let dGross = 0;
        let dValue = 0;
        let bCalcGross = false;
        let bValidate = false;
        let element = null;
        let data = null;        
        let bValueChanged = null;
        let validate = null;

        try {
            if(cellobj.hasDataAttribute("focusvalue") == true) { // Attribute for readonly cell
                dLastValue = DataType.toDecimal(cellobj.getCellData("focusvalue"));
                cellobj.resetCellData("focusvalue");
            }
            else {
                dLastValue = EntryMainBody.getLastValue(cellobj, objMetaData);
            }

            if (transEntryFieldInfo.Qty.ColumnIndex > -1
                && transEntryFieldInfo.Rate.ColumnIndex > -1
                && transEntryFieldInfo.Gross.ColumnIndex > -1) {
                bCalcGross = true;
            }

            element = document.getElementById(cellobj.ColumnAttribute.ctrlid);
            if (DataType.isNullOrEmpty(element.value) == false) {
                element.value = element.value.replace(/,/g, "");
            }

            if (EntryMainValidate.isNumberOverflow(objMetaData.iDataTypeId, element.value) == true) {
                element.value = 0;
            }

            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_BODYRATE:
                    if (EntryMainUI.isRateValid(element.value, cellobj.iRow) == false) {
                        element.value = dLastValue;
                    }

                    if (DataType.neq(dLastValue, element.value) == false) {
                        element.value = transEntryRate.setValue(element.value, cellobj.iRow);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, element.value, cellobj.iRow);

                        transEntryRate.checkBlankRate(element.value);
                        break;
                    }

                    transEntryRate.onLeave(cellobj, objMetaData);

                    if (bCalcGross == true) {
                        EntryMainProductionProcess.updateRate(cellobj.iRow);
                        EntryMainProductionProcess.calculateReceivedRate(cellobj.iRow);
                    }

                    bValueChanged = false;
                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        bValueChanged = true;
                        EntryMainUI.setSummaryInfo(cellobj.iRow);
                    }
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    bValidate = false;
                    validate = EntryMainUI.getLinkMinQuantity(cellobj.iRow, eTranEntryLinkValue.Quantity);
                    if (validate.lValue > 0) {
                        bValidate = true;
                        dValue = transEntryQuantity.convertIntoBase(element.value, cellobj.iRow);
                        if (DataType.lt(dValue, validate.data.Value) == true) {
                            validate.data.Value = transEntryQuantity.convertFromBase(validate.data.Value, cellobj.iRow, true);
                            transEntryGlobal.showAlert("Quantity cannot be less than " + validate.data.Value + " as it is consumed in link voucher.");
                            element.value = validate.data.Value;
                        }
                    }

                    if (bValidate == false) {
                        dGross = transEntryFields.getGross(cellobj.iRow);
                        if (DataType.gt(dGross, 0) == true) {
                            dRate = transEntryFields.getRate(cellobj.iRow);

                            dGross = transEntryGross.calculate(element.value, dRate, cellobj.iRow);
                            if (DataType.gt(dGross, 0) == true) {
                                validate = EntryMainUI.getLinkMinGross(cellobj.iRow);
                                if (validate.lValue > 0) {
                                    if (validate.data.LinkValue == eTranEntryLinkValue.TransactionGross) {
                                        if (DataType.lt(dGross, validate.data.Value) == true) {
                                            transEntryGlobal.showAlert("It will change gross less than consumed in link voucher.");
                                            element.value = dLastValue;
                                        }
                                    }
                                    else { // eTranEntryLinkValue.Gross
                                        dValue = transEntryAmount.convertIntoBase(element.value, cellobj.iRow);
                                        if (DataType.lt(dGross, validate.data.Value) == true) {
                                            transEntryGlobal.showAlert("It will change gross less than consumed in link voucher.");
                                            element.value = dLastValue;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (DataType.neq(dLastValue, element.value) == false) {
                        transEntryQuantity.setValue(element.value, cellobj.iRow, { bValueInBase: false, bIgnoreUpdateTotal: true, bUpdateMemoryObject: true });
                        break;
                    }

                    transEntryQuantity.onLeave(cellobj);
                    EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BODYQUANTITY);

                    if (bCalcGross == true) {
                        EntryMainProductionProcess.updateRate(cellobj.iRow);
                        EntryMainProductionProcess.calculateReceivedRate(cellobj.iRow);
                    }

                    bValueChanged = false;
                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        bValueChanged = true;
                    }

                    break;
                case eVTFIELDID.FDF_BODYALTQUANTITY:
                    validate = EntryMainUI.getLinkMinQuantity(cellobj.iRow, eTranEntryLinkValue.AlternateQuantity);
                    if (validate.lValue > 0) {
                        bValidate = true;
                        dValue = DataType.toDecimal(element.value);
                        if (DataType.lt(dValue, validate.data.Value) == true) {
                            transEntryGlobal.showAlert("Alternate quantity cannot be less than " + validate.data.Value + " as it is consumed in link voucher.");
                            element.value = validate.data.Value;
                        }
                    }

                    if (DataType.neq(dLastValue, element.value) == false) {
                        transEntryFields.setAltQty(element.value, cellobj.iRow);
                        break;
                    }

                    EntryMainBody.onAltQuantity_Leave(cellobj);
                    break;
                case eVTFIELDID.FDF_BODYGROSS:
                    if (EntryMainUI.isGrossValid(element.value, cellobj.iRow) == false) {
                        element.value = dLastValue;
                    }

                    if (DataType.neq(dLastValue, element.value) == false) {
                        transEntryGross.setValue(element.value, cellobj.iRow, true);
                        break;
                    }

                    dGross = transEntryGross.setValue(DataType.toDecimal(element.value), cellobj.iRow, true);

                    if (transEntryFieldInfo.Rate.ColumnIndex > -1
                        && transEntryFieldInfo.Qty.ColumnIndex > -1
                        && transEntryFieldInfo.Rate.MetaData.bHidden == false
                        && transEntryFieldInfo.Qty.MetaData.bHidden == false) {

                        transEntryGross.recalculateQtyAndRate(dLastValue, dGross, cellobj);
                    }
                    else {
                        bCalcGross = false;
                    }

                    if (bCalcGross == true) {
                        EntryMainProductionProcess.updateRate(cellobj.iRow);
                        transEntryGross.calculateAndUpdate({ iRow: cellobj.iRow });
                        EntryMainProductionProcess.calculateReceivedRate(cellobj.iRow);
                    }

                    bValueChanged = false;
                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        bValueChanged = true;
                        EntryMainUI.setSummaryInfo(cellobj.iRow);
                    }
                    break;
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                    if (DataType.toDecimal(element.value) == 0) {
                        cellobj.setCellText("", 0);
                    }
                    else {
                        element.value = FNumberOperation.convert(element.value);
                        if (FNumberOperation.isLessThan(element.value, 0) == true) {
                            element.value = FNumberOperation.abs(element.value);
                        }

                        data = EntryMain.formatFractionNumber(objMetaData.iFieldId, element.value, objMetaData.iNoDecimal, cellobj.iRow);
                        cellobj.setCellData(data);
                        cellobj.setCellText(DataType.addNumericSeparator(data, transEntryCurrency.getNumericSeparator(cellobj.iRow)));
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYJRNDEBIT) {
                            EntryMainUI.clear(transEntryFieldInfo.Credit, cellobj.iRow);
                        }
                        else {
                            EntryMainUI.clear(transEntryFieldInfo.Debit, cellobj.iRow);
                        }
                    }
                    transEntryVat.calculateAndUpdateVATForAmountColumn(objMetaData.iFieldId, cellobj, dLastValue);

                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        EntryMainUI.setSummaryInfo(cellobj.iRow);

                        transEntryReference.updateRequiredFlag(cellobj.iRow);
                    }
                    break;
                case eVTFIELDID.FDF_MAXQTYRELEASE:
                    transEntryMaxQtyRelease.onLeave(cellobj);
                    EntryMainUI.setSummaryInfo(cellobj.iRow);
                    break;
                case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    if (DataType.neq(dLastValue, element.value) == false) {
                        transEntryFields.setExchangeRate(element.value, cellobj.iRow);
                        break;
                    }

                    transEntryExchangeRate.onLeave(cellobj);
                    EntryMainUI.setSummaryInfo(cellobj.iRow);
                    break;
                case eVTFIELDID.FDF_BODYAMOUNT:
                    validate = EntryMainUI.getLinkMinAmount(cellobj.iRow);
                    if (validate.lValue > 0) {
                        dValue = transEntryAmount.convertIntoBase(element.value, cellobj.iRow);
                        if (DataType.lt(dValue, validate.data.Value) == true) {
                            validate.data.Value = transEntryAmount.convertFromBase(validate.data.Value, cellobj.iRow, true);
                            transEntryGlobal.showAlert("Amount cannot be less than " + validate.data.Value + " as it is consumed in link voucher.");
                            element.value = validate.data.Value;
                        }
                    }

                    if (DataType.neq(dLastValue, element.value) == false) {
                        transEntryFields.setAmount(element.value, cellobj.iRow);
                        break;
                    }

                    transEntryAmount.onLeave(cellobj);
                    transEntryVat.calculateAndUpdateVATForAmountColumn(objMetaData.iFieldId, cellobj, dLastValue);

                    bValueChanged = false;
                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        bValueChanged = true;
                        EntryMainUI.setSummaryInfo(cellobj.iRow);

                        transEntryReference.updateRequiredFlag(cellobj.iRow);
                    }
                    break;
                default:
                    data = DataType.toString(element.value);
                    if (objMetaData.bMandatory == false || data != "") {
                        validate = EntryMainValidate.checkMinMaxRange(DataType.toDecimal(element.value), DataType.toDecimal(objMetaData.dMinimumValue), DataType.toDecimal(objMetaData.dMaximumValue));
                        if (validate.bInvalid == true) {
                            element.value = validate.dValue;
                        }
                    }

                    data = DataType.toString(element.value);
                    if (objMetaData.bMandatory == false || data != "") {
                        data = EntryMain.formatFractionNumber(objMetaData.iFieldId, data, objMetaData.iNoDecimal, cellobj.iRow);
                        cellobj.setCellData(data);
                        cellobj.setCellText(DataType.addNumericSeparator(data, transEntryCurrency.getNumericSeparator(cellobj.iRow)));

                        EntryMainMemoryObject.update(objMetaData.iFieldId,
                                                        element.value,
                                                        cellobj.iRow,
                                                        (objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0 ? undefined : objMetaData);
                    }
                    else {
                        data = "";
                        cellobj.setCellText("", "");

                        EntryMainMemoryObject.update(objMetaData.iFieldId,
                                                        0,
                                                        cellobj.iRow,
                                                        (objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0 ? undefined : objMetaData);
                    }

                    if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                        if (data != "") {
                            data = FConvert.roundOff(DataType.toDecimal(data), objMetaData.fRoundOffTo, objMetaData.iRoundOff + 1);

                            dRawOutput = data;
                            data = FConvert.toDecimal(data, objMetaData.iNoDecimal, true);
                        }
                        else {
                            dRawOutput = data;
                        }


                        dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                        if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == false
                            && objMetaData.FormulaBehaviour != eTranEntryFormulaBehaviourBody.Value) {

                            for (iCounter = 0; iCounter < transEntryGlobal.FieldHelper.arrBodyScreenField.length; iCounter++) {
                                if (transEntryGlobal.FieldHelper.arrBodyScreenField[iCounter].iFieldOrder == objMetaData.iFieldOrder) {
                                    dRawOutput = EntryMain.m_objTrans.BodyData[cellobj.iRow - 1].Sales.ScreenData[iCounter].Value;
                                    break;
                                }
                            }
                        }

                        EntryMainMemoryObject.update(objMetaData.iFieldId, data, cellobj.iRow, dRawOutput);
                        dCurrentValue = DataType.toDecimal(cellobj.getCellData());
                        if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                            transEntryScreenData.setCellOutputValue(cellobj, data, dRawOutput);
                        }
                    }

                    dCurrentValue = DataType.toDecimal(cellobj.getCellData());

                    if (FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                        EntryMainUI.setSummaryInfo(cellobj.iRow);
                    }
                    else if (transEntryFieldInfo.isScreenField(objMetaData.iFieldId) == true && objMetaData.FormulaBehaviour != eTranEntryFormulaBehaviourBody.Value) {
                        //EntryMainUI.setSummaryInfo(cellobj.iRow);
                    }
                    break;
            }

            if (bCalcGross == true) {
                if (DataType.isValidObject(transEntryInfo.Settings.VoucherScheme) == true
                    && transEntryInfo.Settings.VoucherScheme.bEnableScheme == true
                    && (objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE || objMetaData.iFieldId == eVTFIELDID.FDF_BODYQUANTITY)
                    && (bValueChanged == null || bValueChanged == true)) {

                    EntryMainScheme.applyScheme(cellobj.iRow);
                }
            }

            dCurrentValue = DataType.toDecimal(cellobj.getCellData())
            if (EntryMain.isDataLoading() == false && FNumberOperation.isNotEqualTo(dLastValue, dCurrentValue) == true) {
                EntryMainUI.resetCOGSDetail();
            }

            EntryMainBudget.checkBudget(objMetaData.iFieldId, cellobj, dLastValue);
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body onFractionLeave method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.onFractionLeave} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

