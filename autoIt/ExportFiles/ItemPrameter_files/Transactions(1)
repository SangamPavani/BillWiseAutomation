                            obj = {};
                            obj.Key = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYINVTAG);
                            obj.Value = arrBodyInvTag[iCounter];
                            result = EntryMainCommon.findKeyValue(obj.Key, objConvertedTrans.Body[iCounter]);
