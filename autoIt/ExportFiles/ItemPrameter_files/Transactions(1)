                && transEntryInfo.VoucherType != eVTTYPE.WMSPICKCONF
                && transEntryInfo.VoucherType != eVTTYPE.WMSMOVECONF) {
                return;
            }

            if (transEntryInfo.UserId != GlobalPref.SUPER_USER) {
                if (transEntrySettings.isEnableVersion == true && EntryMain.checkPermission(SecurityActions.AlwaysVersion) == true) {
                    transEntryGlobal.writeErrorLog("Always save version is enabled.");
                    return;
                }

                if (transEntryInfo.HeaderFlags.Suspended == true) {
                    if (EntryMain.checkPermission(SecurityActions.Edit) == false
                        && EntryMain.checkPermission(SecurityActions.EditSuspendedDocs) == false) {

                        return;
                    }
                }
                else if (EntryMain.checkPermission(SecurityActions.Edit) == false) {
                    return;
                }
            }
        }

        if (EntryMain.checkPermission(SecurityActions.Add) == false) {
            return;
        }

        if (transEntryInfo.UserId != GlobalPref.SUPER_USER) {
            bSuspend = EntryMain.checkPermission(SecurityActions.AlwaysSuspendOnSaving);
        }

        if (transEntryInfo.isEditing == false && DataType.arrayLength(transEntryInfo.Settings.ArrVoucherRules) > 0) {
            arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["NewRecord", "IsRuleActive"], [true, true], "===");
