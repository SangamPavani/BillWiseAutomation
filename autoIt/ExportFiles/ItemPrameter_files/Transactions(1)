                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.BodyId, objData.Value);
                        EntryMainMemoryObject.updateBodyId(objData.Value, iRowCounter);
                    }

                    continue
                }
                else if (sId == eTranEntryBodyDataConstKey.MainBodyId) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.MainBodyId, objData.Value);
                    }

                    continue
                }
                else if (sId == eTranEntryBodyDataConstKey.StockTransferBodyId) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.StockTransferBodyId, objData.Value);
                    }

                    continue
                }
                else if (sId == eTranEntryBodyDataConstKey.TransactionId) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.TransactionId, objData.Value);
                        EntryMainMemoryObject.updateTransactionId(objData.Value, iRowCounter);
                    }

                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.SchemeId) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.SchemeId, objData.Value);
                        EntryMainMemoryObject.updateSchemeId(objData.Value, iRowCounter);
                    }

                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.SchemeSource) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.SchemeSource, objData.Value);
                        EntryMainMemoryObject.updateSchemeSource(objData.Value, iRowCounter);
                    }

                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.SchemeBodyId) {
                    if (bInvalidRow == true) {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.SchemeBodyId, objData.Value);
                        EntryMainMemoryObject.updateSchemeBodyId(objData.Value, iRowCounter);
                    }

                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.Flags) {
                    EntryMainUI.setBodyFlags(iRowCounter, objData.Value);
                    EntryMainMemoryObject.updateBodyFlags(objData.Value, iRowCounter);

                    bRowReadOnly = objData.Value.PDC;

                    if(bRowReadOnly == false 
                        && objData.Value.WMSAllocated == true 
                        && transEntryInfo.HeaderFlags.WMSAllocated == true 
                        && transEntryInfo.BaseVoucherType == eVTTYPE.WMSASN) {

                        bRowReadOnly = true;
                    }
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.AuthStatus) {
                    if (EntryMain.m_objTrans
                        && EntryMain.m_objTrans.BodyData
                        && EntryMain.m_objTrans.BodyData[iRowCounter - 1]
                        && EntryMain.m_objTrans.BodyData[iRowCounter - 1].BodyId > 0
                        && (objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLink
                        || objDataInfo.iCallingSource == eDisplayBodyDataSource.LoadLinkFromHomePage)) {
                        // Do Nothing
                    }
                    else {
                        transEntryGrid.setRowData(iRowCounter, eRowDataName.AuthStatus, objData.Value);
                        EntryMainMemoryObject.updateBodyAuthStatus(objData.Value, iRowCounter);

                        if (objData.Value == _eAuthStatus.Stopped) {
                            bRowReadOnly = true;
                        }
                    }

                    if (objData.Value == _eAuthStatus.Rejected || objData.Value == _eAuthStatus.Stopped) {
                        objResult.AuthStatus = {};
                        objResult.AuthStatus.AuthValue = objData.Value;
                        objResult.AuthStatus.Row = iRowCounter;
                    }

                    transEntryGrid.markRowByAuthStatus(iRowCounter, objData.Value);
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.BillwiseData) {
                    if (objData.Value == "null") {
                        objData.Value = undefined;
                    }
                    transEntryFields.setBillwise(objData.Value, iRowCounter);
                    EntryMainMemoryObject.updateBillwiseData(objData.Value, iRowCounter);
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.LocalCurrencyData) {
                    continue;
                }
                else if (sId == eTranEntryBodyDataConstKey.BaseQuantity) {
                    objResult.dBaseQuantity = objData.Value;

                    for (iIndex = 0; iIndex < objDataInfo.arrIgnoreFields.length; iIndex++) {
                        if (objDataInfo.arrIgnoreFields[iIndex] == eVTFIELDID.FDF_BODYQUANTITY) {
                            break;
                        }
