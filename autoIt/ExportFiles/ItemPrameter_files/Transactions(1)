                            value.MetaDataIndex = transEntryGlobal.FieldHelper.MetaData.RctIssue;
                            value.ColumnIndex = transEntryGlobal.FieldHelper.Column.RctIssue;

                            if (value.Area == eTranEntryFieldArea.Header) {
                                value.MetaData = transEntryGlobal.EntryModel.MetaData.Header[value.MetaDataIndex];
