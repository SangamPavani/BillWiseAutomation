                body = {};
                body.Key = eTranEntryBodyDataConstKey.BaseQuantity;
                body.Value = objBody.Sales.BaseQuantity;
                arrData.push(body);

                body = {};
                body.Key = eTranEntryBodyDataConstKey.SchemeId;
                body.Value = objBody.Sales.SchemeId;
                arrData.push(body);

                body = {};
                body.Key = eTranEntryBodyDataConstKey.SchemeSource;
                body.Value = objBody.Sales.SchemeSource;
                arrData.push(body);

                body = {};
                body.Key = eTranEntryBodyDataConstKey.SchemeBodyId;
                body.Value = objBody.Sales.SchemeBodyId;
                arrData.push(body);

                if (objBody.Sales.SetId > 0) {
                    body = {};
                    body.Key = eTranEntryBodyDataConstKey.SetId;
                    body.Value = objBody.Sales.SetId;
                    arrData.push(body);
                }
            }

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;

                sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_BODYCODE:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.Code;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYBOOKNO:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.Book;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYDUEDATE:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.DueDate;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYCURRENCY:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.CurrencyId;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYEXCHANGERATE:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.ExchangeRate;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_LOCEXCHANGERATE:
                        body = {};
                        body.Key = sId;
                        body.Value = objBody.LocalExchangeRate;
                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYAMOUNT:
                        body = {};
                        body.Key = sId;

                        if (iConvertSource == eConvertTransactionObjectSource.LoadLinkData) {
                            if (transEntryInfo.isItNegative == true) {
                                body.Value = -objBody.OriginalAmounts[0];
                            }
                            else {
                                body.Value = objBody.OriginalAmounts[0];
                            }
                        }
                        else {
                            body.Value = objBody.OrigAmount;
                        }

                        arrData.push(body);
                        break;
                    case eVTFIELDID.FDF_BODYJRNDEBIT:
                        if (objBody.OriginalAmounts[0] < 0) {
                            body = {};
                            body.Key = sId;
                            body.Value = objBody.OriginalAmounts[0] * -1;
                            arrData.push(body);
                        }
                        break;
                    case eVTFIELDID.FDF_BODYJRNCREDIT:
                        if (objBody.OriginalAmounts[0] > 0) {
                            body = {};
                            body.Key = sId;
                            body.Value = objBody.OriginalAmounts[0];
                            arrData.push(body);
                        }
