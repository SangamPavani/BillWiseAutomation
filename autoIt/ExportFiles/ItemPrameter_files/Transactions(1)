    loadBaseDocumentDetails: function (iRow, iColumn, arrData, iSelectedWorkflowIndex, dInputQuantity, sCallback, bFromWorkflow) {
        let iIndex = 0;
        let iInvTagValue = 0;
        let dQty = 0;
        let arrTransactionIds = null;
        let arrVoucherNo = null;
        let arrRefId = null;
        let arrPendingValues = null;        
        let arrFields = [];
        let objFieldInfo = undefined;
        let objData = null;
        let objTemp = null;
        let cell = null;

        try {
            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            //iIndex = transEntryGlobal.EntryModel.arrMetaDataBodyIndex[objTemp.iColumn];
            //objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];

            objFieldInfo = EntryMainUI.getBodyFieldInfo(eVTFIELDID.FDF_LINK, false, iSelectedWorkflowIndex, true);

            objTemp = {};
            objTemp.iWorkflowIndex = iSelectedWorkflowIndex;
            objTemp.iColumn = iColumn;
            objTemp.iRow = iRow;
            objTemp.iBodyId = 0;
            objTemp.lTransactionId = 0;
            objTemp.objLastValue = null;
            objTemp.objMetaData = objFieldInfo.MetaData;
            objTemp.objLinkDefinition = objFieldInfo.MetaData.Tag;
            objTemp.iBaseVoucher = transEntryLinks.getBaseVoucherType(objFieldInfo.MetaData.iMasterLink);
            objTemp.iLinkField = transEntryLinks.getLinkField(objFieldInfo.MetaData.iMasterLink);
            objTemp.dInputQuantity = DataType.toDecimal(dInputQuantity);
            objTemp.bFromWorkflow = DataType.toBoolean(bFromWorkflow);
            if (objTemp.bFromWorkflow == false) {
                objTemp.iBodyId = transEntryFields.getBodyId(iRow);
                objTemp.lTransactionId = transEntryFields.getTransactionId(iRow);

                cell = transEntryGrid.getCellObject(iRow, iColumn);
                if (DataType.isValidObject(cell) == true
                    && DataType.isValidObject(cell.CellData) == true
                    && DataType.isNullOrEmpty(cell.CellData.voucherno, true) == false) {

                    objTemp.objLastValue = {};

                    objTemp.objLastValue.LinkId = DataType.toInt(cell.CellData.linkid);
                    objTemp.objLastValue.RefId = DataType.toInt(cell.CellData.refid);
                    objTemp.objLastValue.BaseTransactionId = objTemp.objLastValue.RefId;
                    objTemp.objLastValue.VoucherType = cell.CellData.vouchertype;
                    objTemp.objLastValue.VoucherNo = cell.CellData.voucherno;
                }

                for (iIndex = 0; iIndex < arrData.length; iIndex++) {
                    switch (objTemp.iLinkField) {
                        case eTranEntryLinkValue.Quantity:
                            dQty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                            if (DataType.gt(arrData[iIndex].LinkValue, dQty) == true) {
                                arrData[iIndex].LinkValue = dQty;
                            }
                            break;
                        case eTranEntryLinkValue.TransactionQuantity:
                            dQty = transEntryFields.getQty(iRow);
                            if (DataType.gt(arrData[iIndex].LinkValue, dQty) == true) {
                                arrData[iIndex].LinkValue = dQty;
                            }
                            break;
                        case eTranEntryLinkValue.AlternateQuantity:
                            dQty = transEntryFields.getAltQty(iRow);
                            if (DataType.gt(arrData[iIndex].LinkValue, dQty) == true) {
                                arrData[iIndex].LinkValue = dQty;
                            }
                            break;
                    }
                }
            }


            arrTransactionIds = [];
            arrVoucherNo = [];
            arrRefId = [];
            arrPendingValues = [];
            for (iIndex = 0; iIndex < arrData.length; iIndex++) {
                arrTransactionIds.push(arrData[iIndex].RefId);
                arrVoucherNo.push(arrData[iIndex].VoucherNo);
                arrRefId.push(arrData[iIndex].RefId);

                arrPendingValues.push(arrData[iIndex].LinkValue);
            }

            objTemp.arrData = arrData; // Selected workflow data array            


            objTemp.arrUsedLinks = EntryMainWorkflow.getUsedLinkDataRows(objTemp.iColumn).data;
            objTemp.arrLoadedLinks = EntryMainWorkflow.getLoadedLinkData(objTemp.iColumn).data;

            if (arrTransactionIds.length > 0) {
                arrFields = EntryMainWorkflow.getHeaderLinkKeyFieldIds(objFieldInfo.MetaData);
                objData = EntryMainWorkflow.getLinkDefinitionObject(iSelectedWorkflowIndex);
                iInvTagValue = transEntryGrid.getMasterValue(iRow, transEntryInfo.InvTag);

                transEntryServer.loadLinkTransactionDocumentData(objData,
                                                                    objTemp.iBaseVoucher,
                                                                    objTemp.iLinkField,
                                                                    transEntryInfo.VoucherType,
                                                                    iInvTagValue,
                                                                    arrTransactionIds,
                                                                    arrVoucherNo,
                                                                    arrRefId,
                                                                    arrPendingValues,
                                                                    arrFields,
                                                                    objTemp,
                                                                    bFromWorkflow,
                                                                    true,
                                                                    sCallback);
                
                if (transEntryGlobal.Version == eVersion.Version9) {
                    TRANSACTION_ENTRY.WORKFLOW.updateWorkflowPanel(false);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.loadBaseDocumentDetails} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    displayPendingData: function (arrBodyData, arrVoucherNos, arrPendingVals, arrRefIds, arrTolerance, iRow, iColumn, objMetaData, bLoadDetail, iDocumentDate, arrMappings, arrUnitDecimals) {
        let iKeyField = 0;
        let iBaseVoucher = 0;
        let iCounter = 0;
        let iCounter1 = 0;
        let iCurrentRow = 0;
        let iNoOfDecimals = 0;
        let iTotal = 0;
        let dRatio = 0;
        let dRate = 0;
        let dQty = 0;
        let dValue = 0
        let dInputValue = 0;
        let dUsedLinkValue = 0;
        let fConversion = 1;
        let bQtyReduced = false;
        let bFlag = false;
        let objLinkDef = null;
        let objStock = null;
        let result = null;
        let iCurrentColumn = 0;
        let objLinkColumn = null;
        let objData = null;
        let arrMasterIds = [];
        let arrData = [];
        let arrRows = null;
        let arrRemovedRows = null;
        let arrNewRowIndex = undefined;
        let objInput = null;

        try {
            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            bLoadDetail = DataType.toBoolean(bLoadDetail);
            FUIElement.removeChild(EntryMainUI.getBodyOthersContainer());

            iCurrentColumn = FGRIDCONTROL.getCurrentColumn(transEntryGrid.getGridId());
            if (iCurrentColumn < 1 || (iColumn + 1) == iCurrentColumn) {
                transEntryGrid.moveToNextCell();
            }

            objLinkDef = objMetaData.Tag;
            iBaseVoucher = transEntryLinks.getBaseVoucherType(objMetaData.iMasterLink);
            iKeyField = transEntryLinks.getLinkField(objMetaData.iMasterLink);

            if (DataType.isValidObject(arrBodyData) == false) {
                arrBodyData = [];
            }

            if (transEntryInfo.isInwardVoucher == false && objLinkDef.IsCheckStock == true
                && (iKeyField == eTranEntryLinkValue.Quantity || iKeyField == eTranEntryLinkValue.TransactionQuantity)) {
                for (iCounter = 0; iCounter < arrBodyData.length; iCounter++) {
                    if (DataType.isValidObject(arrBodyData[iCounter].Sales) == true) {
                        arrMasterIds.push(arrBodyData[iCounter].Sales.Product);
                    }
                }

                if (arrMasterIds.length > 0) {
                    result = transEntryServer.execute(eTransServerRequest.GetProductTypeValue, { arrMasterIds: arrMasterIds });
                    if (result.lValue > 0) {
                        result = result.data;
                        arrData = result.data;
                    }

                    if(DataType.isNullOrEmpty(result.sValue, true) == false) {
                        transEntryGlobal.writeErrorLog("{eTransServerRequest.GetProductTypeValue} " + result.sValue, GlobalPref.getResourceValue("Exception"));
                    }
                }
            }

            if (arrBodyData.length > 0) {
                arrRemovedRows = [];
                for (iCounter = 0; iCounter < arrBodyData.length; iCounter++) {
                    bQtyReduced = false;

                    switch (iKeyField) {
                        case eTranEntryLinkValue.Amount:
                            if (GlobalPref.isSupportBigNumber == true) {
                                arrBodyData[iCounter].OriginalAmounts[0] = BigNumber(arrPendingVals[iCounter]).dividedBy(arrBodyData[iCounter].ExchangeRate).multipliedBy(DataType.sign(arrBodyData[iCounter].OriginalAmounts[0])).valueOf();
                                arrBodyData[iCounter].OriginalAmounts[1] = BigNumber(arrPendingVals[iCounter]).dividedBy(arrBodyData[iCounter].ExchangeRate).multipliedBy(DataType.sign(arrBodyData[iCounter].OriginalAmounts[1])).valueOf();
                            }
                            else {
                                arrBodyData[iCounter].OriginalAmounts[0] = arrPendingVals[iCounter] / arrBodyData[iCounter].ExchangeRate * DataType.sign(arrBodyData[iCounter].OriginalAmounts[0]);
                                arrBodyData[iCounter].OriginalAmounts[1] = arrPendingVals[iCounter] / arrBodyData[iCounter].ExchangeRate * DataType.sign(arrBodyData[iCounter].OriginalAmounts[1]);
                            }

                            transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[0]);
                            transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[1]);

                            if (transEntryFieldInfo.Amount.FieldId > 0) {
                                if ((transEntryInfo.isItNegative == true && FNumberOperation.isGreaterThan(arrBodyData[iCounter].OriginalAmounts[0], 0) == true)
                                    ||
                                    (transEntryInfo.isItNegative == false && FNumberOperation.isLessThan(arrBodyData[iCounter].OriginalAmounts[0], 0) == true)) {
                                    arrBodyData[iCounter].OriginalAmounts[0] = FNumberOperation.mul(arrBodyData[iCounter].OriginalAmounts[0], -1);
                                    arrBodyData[iCounter].OriginalAmounts[1] = FNumberOperation.mul(arrBodyData[iCounter].OriginalAmounts[1], -1);

                                    transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[0]);
                                    transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[1]);
                                }
                            }

                            fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCounter);
                            dUsedLinkValue = FNumberOperation.mul(EntryMainMemoryObject.getAmountValue(iRow + iCounter), fConversion);
                            break;
                        case eTranEntryLinkValue.Gross:
                            if (arrBodyData[iCounter].Sales != null) {
                                arrBodyData[iCounter].Sales.OrigGross = arrPendingVals[iCounter];

                                if (GlobalPref.isSupportBigNumber == true) {
                                    arrBodyData[iCounter].Sales.Quantity = BigNumber(DataType.sign(arrBodyData[iCounter].Sales.Quantity)).multipliedBy(arrBodyData[iCounter].Sales.OrigGross).dividedBy(arrBodyData[iCounter].Sales.OrigRate == 0 ? 1 : arrBodyData[iCounter].Sales.OrigRate).dividedBy(arrBodyData[iCounter].ExchangeRate).valueOf();
                                }
                                else {
                                    arrBodyData[iCounter].Sales.Quantity = DataType.sign(arrBodyData[iCounter].Sales.Quantity) * arrBodyData[iCounter].Sales.OrigGross / (arrBodyData[iCounter].Sales.OrigRate == 0 ? 1 : arrBodyData[iCounter].Sales.OrigRate) / arrBodyData[iCounter].ExchangeRate;
                                }
                            }

                            fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCounter);
                            dUsedLinkValue = FNumberOperation.abs(FNumberOperation.mul(EntryMainMemoryObject.getGrossValue(iRow + iCounter), fConversion));
                            break;
                        case eTranEntryLinkValue.Net:
                            fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCounter);
                            dUsedLinkValue = FNumberOperation.abs(FNumberOperation.mul(transEntryNet.getValue(iRow + iCounter), fConversion));
                            break;
                        case eTranEntryLinkValue.Quantity:
                        case eTranEntryLinkValue.TransactionQuantity:
                            if (DataType.isValidObject(arrBodyData[iCounter].Sales) == true) {
                                // dRatio means unit fConversion
                                dRatio = FNumberOperation.div(arrBodyData[iCounter].Sales.BaseQuantity, arrBodyData[iCounter].Sales.Quantity);
                                if (transEntryInfo.isInwardVoucher == false && objLinkDef.IsCheckStock == true) {
                                    objStock = null;

                                    bFlag = false;
                                    iTotal = DataType.arrayLength(arrData);
                                    for (iCounter1 = 0; iCounter1 < iTotal; iCounter1++) {
                                        if (arrData[iCounter1].ID == arrBodyData[iCounter].Sales.Product) {
                                            bFlag = true;
                                            break;
                                        }
                                    }

                                    if (bFlag == false || arrData[iCounter1].Tag != eProductType.Service) {
                                        objInput = {};
                                        objInput.iProductId = arrBodyData[iCounter].Sales.Product;
                                        objInput.iDate = iDocumentDate;
                                        objInput.iWarehouseId = arrBodyData[iCounter].InvTag;
                                        objInput.lTransactionId = 0;
                                        objInput.lBatchId = 0;

                                        result = transEntryServer.execute(eTransServerRequest.GetStockQty, objInput);
                                        if (result.lValue > 0) {
                                            objStock = result.data.data;
                                        }

                                        if (DataType.isValidObject(objStock) == true) {
                                            if (arrPendingVals[iCounter] > objStock) {
                                                arrPendingVals[iCounter] = objStock > 0 ? objStock : 0;

                                                if (arrPendingVals[iCounter] == 0) {
                                                    bQtyReduced = true;
                                                }
                                            }
                                        }
                                    }
                                }

                                dInputValue = arrBodyData[iCounter].Sales.Quantity;
                                arrBodyData[iCounter].Sales.Quantity = FNumberOperation.div(arrPendingVals[iCounter], FNumberOperation.abs(dRatio));

                                if ((FNumberOperation.isNotEqualTo(arrBodyData[iCounter].Sales.OrigGross, 0) == true && FNumberOperation.isNotEqualTo(FNumberOperation.abs(dRatio), 1) == true)
                                    || FNumberOperation.isNotEqualTo(FNumberOperation.abs(dInputValue), FNumberOperation.abs(arrBodyData[iCounter].Sales.Quantity)) == true) {
                                    arrBodyData[iCounter].Sales.OrigGross = FNumberOperation.mul(arrBodyData[iCounter].Sales.Quantity, arrBodyData[iCounter].Sales.OrigRate);
                                }

                                if (FConvert.isItInwardVoucher(iBaseVoucher) == false) { // If sales (outward) and base is also outward
                                    arrBodyData[iCounter].Sales.Quantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.Quantity, -1);
                                    arrBodyData[iCounter].Sales.AlternateQuantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.AlternateQuantity, -1);
                                }

                                dQty = transEntryFields.getQty(iRow + iCounter);
                                fConversion = 1;
                                if (transEntryFieldInfo.Unit.ColumnIndex > -1) {
                                    fConversion = transEntryUnit.getConversionValue(iRow + iCounter);
                                    dQty = FNumberOperation.mul(dQty, fConversion); // Convert into base quantity value.
                                }

                                dUsedLinkValue = dQty;
                                if (objLinkDef.LinkCannotExceedBaseValue == true) {
                                    if (FNumberOperation.isGreaterThan(dQty, FNumberOperation.add(arrPendingVals[iCounter], arrTolerance[iCounter])) == true) {
                                        dUsedLinkValue = arrPendingVals[iCounter];

                                        dValue = FNumberOperation.div(arrPendingVals[iCounter], fConversion);
                                        transEntryQuantity.setValue(dValue, iRow + iCounter, { bUpdateMemoryObject: true });

                                        transEntryGlobal.showAlert(GlobalPref.getResourceValue("msgQtyCannotExceedBase"));
                                    }
                                }
                            }
                            break;
                        case eTranEntryLinkValue.TransactionAmount:
                            if (GlobalPref.isSupportBigNumber == true) {
                                arrBodyData[iCounter].OriginalAmounts[0] = BigNumber(arrPendingVals[iCounter]).multipliedBy(DataType.sign(arrBodyData[iCounter].OriginalAmounts[0])).valueOf();
                                arrBodyData[iCounter].OriginalAmounts[1] = BigNumber(arrPendingVals[iCounter]).multipliedBy(DataType.sign(arrBodyData[iCounter].OriginalAmounts[1])).valueOf();
                            }
                            else {
                                arrBodyData[iCounter].OriginalAmounts[0] = arrPendingVals[iCounter] * DataType.sign(arrBodyData[iCounter].OriginalAmounts[0]);
                                arrBodyData[iCounter].OriginalAmounts[1] = arrPendingVals[iCounter] * DataType.sign(arrBodyData[iCounter].OriginalAmounts[1]);
                            }

                            transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[0]);
                            transEntryGrid.notifyOrgAmtChange(iCounter, 0, arrBodyData[iCounter].OriginalAmounts[1]);

                            fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCounter);
                            dUsedLinkValue = FNumberOperation.mul(EntryMainMemoryObject.getAmountValue(iRow + iCounter), fConversion);
                            break;
                        case eTranEntryLinkValue.TransactionGross:
                            if (arrBodyData[iCounter].Sales != null) {
                                arrBodyData[iCounter].Sales.OrigGross = arrPendingVals[iCounter];

                                if (transEntryLinks.isFieldExistInMappingList(eVTFIELDID.FDF_BODYRATE, arrMappings) == false) {
                                    dQty = DataType.abs(arrBodyData[iCounter].Sales.Quantity);

                                    iNoOfDecimals = 0;
                                    if (arrBodyData[iCounter].Sales.Unit > 0
                                        && arrUnitDecimals
                                        && arrUnitDecimals.length > 0) {

                                        for (iCounter1 = 0; iCounter1 < arrUnitDecimals.length; iCounter1++) {
                                            if (arrUnitDecimals[iCounter1].ID == arrBodyData[iCounter].Sales.Unit) {
                                                iNoOfDecimals = arrUnitDecimals[iCounter1].Value;
                                                break;
                                            }
                                        }
                                    }
                                    else {
                                        iNoOfDecimals = EntryMain.m_DecimalsInQty;
                                    }

                                    dQty = FNumberOperation.toFixed(dQty, iNoOfDecimals);
                                    arrBodyData[iCounter].Sales.OrigRate = DataType.div(arrPendingVals[iCounter], dQty); 
                                }

                                dRate = arrBodyData[iCounter].Sales.OrigRate;
                                if (dRate == 0) {
                                    dRate = 1;
                                    if (arrBodyData[iCounter].Sales.Rate != 0) {
                                        dRate = arrBodyData[iCounter].Sales.Rate;
                                    }
                                }

                                if (GlobalPref.isSupportBigNumber == true) {
                                    //arrBodyData[iCounter].Sales.Quantity = BigNumber(DataType.sign(arrBodyData[iCounter].Sales.Quantity)).multipliedBy(arrBodyData[iCounter].Sales.OrigGross).dividedBy(arrBodyData[iCounter].Sales.OrigRate == 0 ? 1 : arrBodyData[iCounter].Sales.OrigRate).dividedBy(arrBodyData[iCounter].ExchangeRate).valueOf();
                                    arrBodyData[iCounter].Sales.Quantity = BigNumber(DataType.sign(arrBodyData[iCounter].Sales.Quantity)).multipliedBy(arrBodyData[iCounter].Sales.OrigGross).dividedBy(dRate).valueOf();
                                }
                                else {
                                    arrBodyData[iCounter].Sales.Quantity = DataType.sign(arrBodyData[iCounter].Sales.Quantity) * arrBodyData[iCounter].Sales.OrigGross / dRate; // / arrBodyData[iCounter].ExchangeRate;
                                }
                            }

                            dUsedLinkValue = FNumberOperation.abs(EntryMainMemoryObject.getGrossValue(iRow + iCounter));
                            break;
                        case eTranEntryLinkValue.AlternateQuantity:
                            if (arrBodyData[iCounter].Sales != undefined && arrBodyData[iCounter].Sales != null) {
                                arrBodyData[iCounter].Sales.AlternateQuantity = arrPendingVals[iCounter];
                                if (FConvert.isItInwardVoucher(iBaseVoucher) == false) // If sales (outward) and base is also outward
                                {
                                    arrBodyData[iCounter].Sales.AlternateQuantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.AlternateQuantity, -1);
                                }
                            }
                            break;
                    }

                    iCurrentRow = iRow + iCounter;
                    if (objLinkDef.UseLinkForLoading == false && bQtyReduced == false) {
                        objLinkColumn = transEntryGrid.getCellObject(iCurrentRow, iColumn);
                        if (DataType.isValidObject(objLinkColumn) == false) {
                            continue;
                        }

                        if (DataType.isValidObject(arrBodyData[iCounter].Sales) == true
                            && (iKeyField == eTranEntryLinkValue.Quantity || iKeyField == eTranEntryLinkValue.TransactionQuantity)
                            && arrPendingVals[iCounter] == 0) {
                            transEntryGlobal.showAlert("Items having no stock have been removed from list.");
                            objLinkColumn.clear();
                        }
                        else {
                            if (bLoadDetail == true) { // Called from header control leave 
                                arrRows = EntryMainWorkflow.getUsedLinkRows(arrRefIds[iCounter], iCurrentRow, iColumn);
                                if (arrRows.length > 0) {
                                    for (iCounter1 = (arrRows.length - 1) ; iCounter1 > 0; iCounter1--) {
                                        transEntryGrid.deleteRows(arrRows[iCounter1], 1);
                                    }

                                    iCurrentRow = arrRows[0];
                                    objLinkColumn = transEntryGrid.getCellObject(iCurrentRow, iColumn);
                                }
                            }


                            objData = {};
                            objData.LinkId = objLinkDef.LinkId;
                            objData.LinkValue = arrPendingVals[iCounter];
                            objData.RefId = arrRefIds[iCounter];
                            objData.VoucherNo = arrVoucherNos[iCounter];
                            objData.iRow = iCurrentRow;

                            objLinkColumn.setCellData(objData);
                            objLinkColumn.setCellText(objData.VoucherNo, objData.RefId);

                            objLinkColumn.setCellData("vouchertype", iBaseVoucher);
                            objLinkColumn.setCellData("usedvalue", dUsedLinkValue);
                            objLinkColumn.setCellData("linkfield", iKeyField);

                            EntryMainUI.valueChanged(objMetaData, iCurrentRow, iColumn);
                        }

                        if (objLinkDef.LoadBaseDocDtlsAtLinking == true || bLoadDetail == true) {
                            if (transEntryInfo.isItSales == true && DataType.isValidObject(arrBodyData[iCounter]) == true) {
                                if(FConvert.isItInwardVoucher(iBaseVoucher) == false) {
                                    arrBodyData[iCounter].Sales.Quantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.Quantity, -1);
                                    arrBodyData[iCounter].Sales.AlternateQuantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.AlternateQuantity, -1);
                                    arrBodyData[iCounter].Sales.BaseQuantity = FNumberOperation.mul(arrBodyData[iCounter].Sales.BaseQuantity, -1);
                                }
                            }

                            objData = transEntryData.convertBodyDataClassToKeyValueArray(arrBodyData[iCounter]);
                            if (DataType.isValidObject(objData) == true) {
                                arrNewRowIndex = EntryMainUI.displayBodyData([objData],
                                                            iCurrentRow - 1, 
                                                            EntryMainBody.getDisplayBodyInput([], false, 0, false, [], eDisplayBodyDataSource.DisplayPendingData),
                                                            []);

                                if ((iKeyField == eTranEntryLinkValue.Quantity || iKeyField == eTranEntryLinkValue.TransactionQuantity)
                                    && bLoadDetail == false) {
                                    dUsedLinkValue = FNumberOperation.div(dUsedLinkValue, fConversion);

                                    transEntryQuantity.setValue(dUsedLinkValue, iCurrentRow, { bUpdateMemoryObject: true });

                                    transEntryGross.calculateAndUpdate({ iRow: iCurrentRow });
                                }

                                if (arrNewRowIndex.length > 0) {
                                    EntryMainBody.updateProductDependentValue(arrNewRowIndex);
                                }
                            }
                        }
                    }
                    else if (bQtyReduced == true) {
                        if (DataType.isValidObject(arrBodyData[iCounter].Sales) == true
                            && (iKeyField == eTranEntryLinkValue.Quantity || iKeyField == eTranEntryLinkValue.TransactionQuantity)
                            && arrPendingVals[iCounter] == 0) {
                            transEntryGlobal.showAlert("Items having no stock have been removed from list.");

                            arrRemovedRows.push(iCurrentRow);
                        }
                    }
                }

                while (arrRemovedRows.length > 0) {
                    iRow = arrRemovedRows[arrRemovedRows.length - 1];
                    arrRemovedRows.splice(arrRemovedRows.length - 1, 1);
                    transEntryGrid.deleteRows(iRow, 1);
                    EntryMainMemoryObject.deleteRowData(iRow, 1);
                }

                EntryMainUI.setSummaryInfo(0);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainWorkflow.displayPendingData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

