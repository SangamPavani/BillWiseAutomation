                                continue;
                            }

                            objFormulaInput = EntryMainFormula.createBodyFormulaInput(objMetaData.sDefaultValue.substr(1), iCounter, null, -1, objMetaData.sFieldName);
                            objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                            iValue = DataType.toInt(objFormulaOutput.Value);
                            transEntryGrid.setRowValueBasedOnDataType(iCounter,
                                iValue,
                                {
                                    MetaData: objMetaData,
                                    Data: null,
                                    bFromBatch: false
                                });
                        }
                    }
                }
            }

            if (EntryMain.isDataLoading() == false || bLoadLink == true) {
                if (transEntryFieldInfo.PmtTerms.Area != eTranEntryFieldArea.None
                    && iValue > 0
                    && transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.None) {

