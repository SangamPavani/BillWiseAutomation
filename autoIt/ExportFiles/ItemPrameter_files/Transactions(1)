                            body = {};
                            body.Key = sId;
                            body.Value = objBody.Sales.OrigGross;
                            arrData.push(body);
                        }
                        break;
                    case eVTFIELDID.FDF_RMANO:
                        if (DataType.isValidObject(objBody.Sales) == true) {
                            body = {};
                            body.Key = sId;

                            if (objBody.Sales != null && DataType.arrayLength(objBody.Sales.RMANos) > 0) {
                                body.Value = DataType.arrayToCSV(objBody.Sales.RMANos);
