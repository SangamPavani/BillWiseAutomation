    copyColumnData: function (iSourceRow, iSourceColumn, iTargetRow, iTargetColumn) {
        let iCounter = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let objMetaData = undefined;
        let objInfo = undefined;

        FGRIDCONTROL.copyColumnData(transEntryGrid.getGridId(), iSourceRow, iSourceColumn + transEntryGrid.ExtraColumn, iTargetRow, iTargetColumn + transEntryGrid.ExtraColumn);

        if (iSourceColumn != iTargetColumn) {
            return;
        }

        arrFields = transEntryFieldInfo.getBodyFields();
        for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
            if (iCounter != iSourceColumn) {
                continue;
            }

            objMetaData = arrFields[iCounter].MetaData;

            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_CODE:
                case eVTFIELDID.FDF_BODYCODE:
                    iIndex = EntryMainMemoryObject.getCodeValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);

                    objInfo = EntryMainMemoryObject.getCodeInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);

                    iIndex = EntryMainMemoryObject.getCodeTypeId(iSourceRow);
                    EntryMainMemoryObject.updateCodeAccountType(iIndex, iTargetRow);
                    break;
                case eVTFIELDID.FDF_BOOKNO:
                case eVTFIELDID.FDF_BODYBOOKNO:
                    iIndex = EntryMainMemoryObject.getBookValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);

                    objInfo = EntryMainMemoryObject.getBookInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);

                    iIndex = EntryMainMemoryObject.getBookTypeId(iSourceRow);
                    EntryMainMemoryObject.updateBookAccountType(iIndex, iTargetRow);
                    break;
                case eVTFIELDID.FDF_HEADERINVTAG:
                    objInfo = EntryMainMemoryObject.getHeaderInvTagInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);

                    iIndex = EntryMainMemoryObject.getHeaderInvTagValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);
                    break;
                case eVTFIELDID.FDF_BODYINVTAG:
                    objInfo = EntryMainMemoryObject.getBodyInvTagInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);

                    iIndex = EntryMainMemoryObject.getBodyInvTagValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);
                    break;
                case eVTFIELDID.FDF_BODYPRODUCT:
                    iIndex = EntryMainMemoryObject.getProductValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);

                    objInfo = EntryMainMemoryObject.getProductInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);
                    break;
                case eVTFIELDID.FDF_BODYUNITS:
                    iIndex = EntryMainMemoryObject.getUnitValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);

                    objInfo = EntryMainMemoryObject.getUnitInfo(iSourceRow);
                    EntryMainMemoryObject.updateExtraInfo(objMetaData.iFieldId, objInfo, iTargetRow);
                    break;
                case eVTFIELDID.FDF_BODYQUANTITY:
                    iIndex = EntryMainMemoryObject.getQuantityValue(iSourceRow);
                    EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);
                    break;
                default:
                    if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {
                        if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                            break;
                        }

                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                            iIndex = EntryMainMemoryObject.getFAValue(iSourceRow);
                            EntryMainMemoryObject.update(objMetaData.iFieldId, iIndex, iTargetRow);
