    VWHideLeftPanel: function (element) {

        var divPref = '';
        var minwdth = 0;
        if (element.getAttribute("data-isVoucherMenuDiv") == "true") {
            divPref = document.getElementById("divPref");
            maxwidth = divPref.offsetWidth;
            minwdth = element.offsetWidth + 16;
            $("#divPref").animate({
                width: minwdth
            }, function () {
                document.getElementById("divPref").style.display = "none";
                document.getElementById("rightPanelMain").style.width = "100%";
                if (document.getElementById("preferences") != null)
                    document.getElementById("preferences").style.display = "none";

                element.setAttribute("data-isVoucherMenuDiv", false)
                if (document.getElementById("VWTabs") != null) {
                    element.setAttribute("onclick", "CONFIGURETRANS.VWHideLeftPanel(this)")
                }
                else {
                    element.setAttribute("onclick", "CONFIGURETRANS.VWShowLeftPanel(this)")
                }
            });
        }
        else {
            $("#VWTabs").animate({
            }, function () {
                document.getElementById("VWTabs").style.display = "none";
                document.getElementById("dvVWTabArea").style.width = "100%";
                if (bFromTransaction) {
                    document.getElementById("lblShowLeftPanel").style.display = "block";
                } else {
                    element.setAttribute("onclick", "CONFIGURETRANS.VWShowLeftPanel(this)")
