const transEntryReference = {
    createString: function (arrBillAdjustment) {
        let iCounter = 0;
        let sValue = "";
        let bNewRefAdded = false;

        try {
            if (DataType.arrayLength(arrBillAdjustment) < 1) {
                return ("");
            }

            for (iCounter = 0; iCounter < arrBillAdjustment.length; iCounter++) {
                if (arrBillAdjustment[iCounter].iFlag == eAdjustmentFlag.PaymentTermsAdjustments) { // (F8-35248)
                    continue;
                }

                if (DataType.isNullOrEmpty(arrBillAdjustment[iCounter].sReference) == true) {
                    if (arrBillAdjustment[iCounter].iRefType == 1) {
                        sValue += "On Account";
                    }
                    else if (arrBillAdjustment[iCounter].iRefType == 0 && !bNewRefAdded) {
                        sValue += "New Reference";
                        bNewRefAdded = true;
                    }
                    else {
                        continue;
                    }
                }
                else {
                    sValue += arrBillAdjustment[iCounter].sReference;
                    if (DataType.isNullOrEmpty(arrBillAdjustment[iCounter].sBillNo, true) == false) {
                        sValue += " " + arrBillAdjustment[iCounter].sBillNo;
                    }
                }

                if (iCounter != arrBillAdjustment.length - 1) {
                    sValue += ";";
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryReference.createString} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (sValue);
    },

    isDataCanExist: function () {
        let iBaseVoucherType = 0;
        let bFlag = false;

        try {
            if (transEntryFieldInfo.Billwise.ColumnIndex < 0) {
                return (false);
            }

            if (transEntryInfo.isStockAdjustment == true || transEntryInfo.isStockRevaluation == true) {
                return (false);
            }

            if (transEntryInfo.isItTransfer == true && transEntryInfo.AccountPref.iDontBalanceStockTransfer == 0) {
                return (false);
            }

            if (transEntryGlobal.EntryModel.bARAPInInf == false) {
                return (false);
            }

            if (transEntryInfo.BodySectionNotRequired == true) {
                return (false);
            }

            if (transEntrySettings.isAdjustBillInLine == false) {
                return (false);
            }

            iBaseVoucherType = transEntryInfo.BaseVoucherType;
            if (transEntryInfo.Settings.Misc.UpdateFA == true && (transEntryInfo.isItSales || iBaseVoucherType == eVTTYPE.DEBNT || iBaseVoucherType == eVTTYPE.CRDNT)) {
                // Single billwise voucher
                return (false);
            }

            if (transEntryInfo.Settings.Misc.UpdateFA == true || iBaseVoucherType == eVTTYPE.MEMOP || iBaseVoucherType == eVTTYPE.MEMOR) {
                bFlag = true;
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryReference.isDataCanExist} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bFlag);
    },

