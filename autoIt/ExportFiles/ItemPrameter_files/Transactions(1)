const transEntryGross = {
    setValue: function (dValue, iRow, bUpdateMemoryObject) {
        let sValue = "";
        let iNoOfDecimals = 0;
        let cell = null;

        try {
            cell = EntryMainUI.getElement(transEntryFieldInfo.Gross, iRow).Value;
            if (DataType.isValidObject(cell) == false) {
                return (null);
            }

            iNoOfDecimals = transEntrySettings.getDecimalsInAmount(iRow);

            dValue = FNumberOperation.toFixed(dValue, iNoOfDecimals);

            sValue = DataType.addNumericSeparator(dValue, transEntryCurrency.getNumericSeparator(cell.iRow));

            if ((typeof cell).toLowerCase() == "string") {
                document.getElementById(cell).value = dValue;
            }
            else {
                cell.setCellText(sValue, dValue);
            }

            if (bUpdateMemoryObject == true) {
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYGROSS, dValue, iRow);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGross.setValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (dValue);
    },

    calculateAndUpdate: function (obj) {
        let dQuantity = 0;
        let dRate = 0;
        let dGross = 0;

        if (DataType.isValidObject(obj.dQuantity) == true) {
            dQuantity = obj.dQuantity;
        }
        else {
            if (EntryMainSet.isValidSetQuantityRow(obj.iRow) == true) {
                dQuantity = EntryMainSet.getSetQty(obj.iRow);
            }
            else {
                dQuantity = transEntryFields.getQty(obj.iRow);
            }
        }

        if (DataType.isValidObject(obj.dRate) == true) {
            dRate = obj.dRate;
        }
        else {
            dRate = EntryMainMemoryObject.getRateValue(obj.iRow);
        }

        dGross = transEntryGross.calculate(dQuantity, dRate, obj.iRow, obj.bIgnoreGeneralRoundOffCheck);

        this.setValue(dGross, obj.iRow, true);

        EntryMainProductionProcess.updateGross(obj.iRow, dGross);

        return (true);
    },

    calculate: function (dQuantity, dRate, iRow, bIgnoreGeneralRoundOffCheck) {
        let dTemp = 0;
        let dGross = 0;
        let dOrgGross = 0;
        let dTempGross = 0;
        let dGeneralRoundOff = 0;

        if (FNumberOperation.isNotEqualTo(dQuantity, 0) == true && FNumberOperation.isNotEqualTo(dRate, 0) == true) {
            dTempGross = FNumberOperation.mul(dQuantity, dRate);

            dGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(iRow);
            dTempGross = FConvert.roundOff(dTempGross, dGeneralRoundOff, transEntryCurrency.getRoundingType(iRow));

            dOrgGross = transEntryFields.getGross(iRow);
            if (FNumberOperation.isGreaterThan(dOrgGross, 0) == true) {
                if (DataType.toBoolean(bIgnoreGeneralRoundOffCheck) == true) {
                    dGross = dTempGross;
                }
                else {
                    dTemp = FNumberOperation.sub(dTempGross, dOrgGross);
                    dTemp = FNumberOperation.div(FNumberOperation.abs(dTemp), FNumberOperation.abs(dQuantity));

                    if (FNumberOperation.isGreaterThanOrEqualTo(dTemp, dGeneralRoundOff) == true) {
                        dGross = dTempGross;
                    }
                    else {
                        dGross = dOrgGross;
                    }
                }
            }
            else {
                dGross = dTempGross;
            }
        }

        return (dGross);
    },

    recalculateGross: function () {
        let iTotalRows = 0;
        let iRow = 0;
        let dQuantity = 0;
        let dRate = 0;
        let dTempGross = 0;
        let dGeneralRoundOff = 0;

        try {
            if (transEntryInfo.isItSales == false) {
                return;
            }

            if (transEntryFieldInfo.Qty.ColumnIndex < 0
                || transEntryFieldInfo.Rate.ColumnIndex < 0
                || transEntryFieldInfo.Gross.ColumnIndex < 0) {

                return;
            }


            iTotalRows = transEntryGrid.getTotalRows();
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    continue;
                }

                dQuantity = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.Quantity;
                dRate = EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigRate;

                dTempGross = FNumberOperation.mul(dQuantity, dRate);

                dGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(iRow);
                dTempGross = EntryMain.roundOff(dTempGross, dGeneralRoundOff, transEntryCurrency.getRoundingType(iRow));

                if (dQuantity == 0) {
                    transEntryGross.setValue(dTempGross, iRow, true);
                }
                else {
                    if (EntryMain.m_bSupportBigNumber) {
                        if (BigNumber(dTempGross).minus(EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross).abs().dividedBy(BigNumber(dQuantity).abs()).isGreaterThanOrEqualTo(dGeneralRoundOff) == true) {
                            transEntryGross.setValue(dTempGross, iRow, true);
                        }
                    }
                    else {
                        if (Math.abs(dTempGross - DataType.toDecimal(EntryMain.m_objTrans.BodyData[iRow - 1].Sales.OrigGross)) / Math.abs(dQuantity) >= dGeneralRoundOff) {
                            transEntryGross.setValue(dTempGross, iRow, true);
                        }
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGross.recalculateGross} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    recalculateQtyAndRate: function (dLastValue, dGross, cellobj) {
        let dQuantity = 0;
        let dRate = 0;
        let dGeneralRoundOff = 0;
        let iRoundingType = 0;

        try {
            if (EntryMainSet.isValidSetQuantityRow(cellobj.iRow) == true) {
                dQuantity = EntryMainSet.getSetQty(cellobj.iRow);
            }
            else {
                dQuantity = transEntryFields.getQty(cellobj.iRow);
            }
            if (dQuantity == 0) {
                dRate = 0;
            }
            else {
                //dRate = FNumberOperation.div(cellobj.getCellData(), dQuantity); // Gross/Quantity
                dRate = FNumberOperation.div(dGross, dQuantity); // Gross/Quantity
                dRate = FNumberOperation.abs(dRate);

                dGeneralRoundOff = transEntryCurrency.getGeneralRoundOff(cellobj.iRow);
                iRoundingType = transEntryCurrency.getRoundingType(cellobj.iRow)
                if (transEntryInfo.Settings.Inventory.DoNotRoundOffRate == true) {
                    dRate = FConvert.roundOff(dRate, DataType.div(dGeneralRoundOff, 10000), iRoundingType);
                }
                else {
                    dRate = FConvert.roundOff(dRate, dGeneralRoundOff, iRoundingType);
                }
            }

            dRate = transEntryRate.update(dRate, cellobj.iRow, true);

            if (dQuantity == 0) {
                cellobj.setCellText("", 0);
            }
            else if (FNumberOperation.isNotEqualTo(dRate, 0) == true && FNumberOperation.isLessThan(dGross, 0) == true) {
                dQuantity = FNumberOperation.abs(dQuantity);
                dQuantity = FNumberOperation.negated(dQuantity);
                transEntryQuantity.setValue(dQuantity, cellobj.iRow, { bUpdateMemoryObject: true });
            }

            if (FNumberOperation.isNotEqualTo(dLastValue, dGross) == true) {
                transEntryRate.checkMinRate(cellobj.iRow);
                transEntryRate.checkBlankRate(dRate);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGross.recalculateQtyAndRate} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
};
