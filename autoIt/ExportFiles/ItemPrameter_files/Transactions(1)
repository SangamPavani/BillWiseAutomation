    report_setData: function (lstMaster, reportData) {
        var cell = null;
        lstMaster.splice(0, 1);
        for (var count = 0; count < lstMaster.length; count++) {
            cell = FGRIDCONTROL.getCellObject("reports_grid", count + 1, 1);
            cell.setCellText(lstMaster[count].Name, lstMaster[count]);
        }
        if (reportData != null && reportData != undefined) {
            for (var count = 0; count < reportData.length; count++) {
                var rowIndex = count;
                for (var i = 0; i < lstMaster.length; i++) {
                    if (reportData[count].iMasterId == 1 || reportData[count].iMasterId == 2) {//account and product check with fieldid
