        this.writeFieldInfo = function (objMetaData, sPrefix) {
            let arrKey = undefined;
            let arrValue = undefined;

            try {
                arrKey = [];
                arrValue = [];
                if ((objMetaData.iFieldId & eVTFIELDFLAG.LAY_HDR) > 0
                    || (objMetaData.iFieldId & eVTFIELDFLAG.LAY_BODY) > 0
                    || (objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {

                    arrKey.push("Order");
                    arrValue.push(objMetaData.iFieldOrder);
                }

                arrKey.push("Id");
                arrValue.push(objMetaData.iFieldId);

                arrKey.push("Name");
                arrValue.push(objMetaData.sFieldName);

                if (objMetaData.bHidden == true) {
                    arrKey.push("Hidden");
                    arrValue.push(undefined);
                }

                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                    switch (objMetaData.FormulaBehaviour) {
                        case eTranEntryFormulaBehaviourBody.Value: // 0
                            break;
                        case eTranEntryFormulaBehaviourBody.PercentageOnGross: // 1
                            arrKey.push("PercentageOnGross");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.PercentageOnNet: // 2 (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                            arrKey.push("PercentageOnNet");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.Formula:
                            break;
                        case eTranEntryFormulaBehaviourBody.IncludedInGross: // 4
                            arrKey.push("IncludedInGross");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.NegativeValue: // 5
                            arrKey.push("NegativeValue");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.PercentageOnGrossMinus: // 6
                            arrKey.push("PercentageOnGrossMinus");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.PercentageOnNetMinus: // 7 (Consider all Previous screen columns having AddToNet set either to Add or deduct)
                            arrKey.push("PercentageOnNetMinus");
                            arrValue.push(undefined);
                            break;
                    }
                }
                else if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0) {
                    switch (objMetaData.FormulaBehaviour) {
                        case eTranEntryFormulaBehaviourFooter.Value:
                            break;
                        case eTranEntryFormulaBehaviourFooter.PercentageOnGross:
                            arrKey.push("PercentageOnGross");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourFooter.PercentageOnNet:
                            arrKey.push("PercentageOnNet");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourBody.Formula:
                            break;
                        case eTranEntryFormulaBehaviourFooter.NegativeValue:
                            arrKey.push("NegativeValue");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourFooter.PercentageOnGrossMinus:
                            arrKey.push("PercentageOnGrossMinus");
                            arrValue.push(undefined);
                            break;
                        case eTranEntryFormulaBehaviourFooter.PercentageOnNetMinus:
                            arrKey.push("PercentageOnNetMinus");
                            arrValue.push(undefined);
                            break;
                    }
                }

                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0
                    || (objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0) {
                    switch (objMetaData.iAddToNet) {
                        case 0: // Add To Net
                            arrKey.push("AddToNet");
                            arrValue.push(undefined);
                            break;
                        case 1: // Deduct From Net
                            arrKey.push("DeductFromNet");
                            arrValue.push(undefined);
                            break;
                    }

                    switch (objMetaData.iAddToStock) {
                        case 0: // Add To Stock
                            arrKey.push("AddToStock");
                            arrValue.push(undefined);
                            break;
                        case 1: // Deduct From Stock
                            arrKey.push("DeductFromStock");
                            arrValue.push(undefined);
                            break;
                    }
                }

                if (objMetaData.iDataTypeId == eMasterDataType.Master) {
                    if ((objMetaData.iFieldId & eVTFIELDFLAG.MASTER_HDR) > 0
                        || (objMetaData.iFieldId & eVTFIELDFLAG.MASTER_BODY) > 0) {

                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.FATag) {
                            arrKey.push("FATag");
                            arrValue.push(undefined);
                        }

                        if ((objMetaData.iFieldId & eVTFIELDFLAG.TOFLDID) == transEntryInfo.InvTag) {
                            arrKey.push("InvTag");
                            arrValue.push(undefined);
                        }
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_CODE
                        || objMetaData.iFieldId == eVTFIELDID.FDF_BODYCODE) {
                        arrKey.push("Code");
                        arrValue.push(undefined);
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BOOKNO
                        || objMetaData.iFieldId == eVTFIELDID.FDF_BODYBOOKNO) {
                        arrKey.push("Book");
                        arrValue.push(undefined);
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_HEADERINVTAG) {
                        arrKey.push("HeaderInvTag");
                        arrValue.push(undefined);
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYINVTAG) {
                        arrKey.push("BodyInvTag");
                        arrValue.push(undefined);
                    }
                }


                if (DataType.isNullOrEmpty(objMetaData.sDefaultValue, true) == false) {
                    if (objMetaData.iDataTypeId == eMasterDataType.StringList
                        || objMetaData.iDataTypeId == eMasterDataType.NumberList) {
                    }
                    else if (((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0
                        || (objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0)
                        && DataType.isBlankOrZero(objMetaData.sDefaultValue) == true) {
                    }
                    else {
                        arrKey.push("Default");
                        arrValue.push(objMetaData.sDefaultValue);
                    }
                }

                if (DataType.isNullOrEmpty(objMetaData.sPreload, true) == false) {
                    arrKey.push("Preload");
                    arrValue.push(objMetaData.sPreload);
                }

                arrKey.push("DataType");
                arrValue.push(DataType.typeToString(objMetaData.iDataTypeId));

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Fraction:
                        if (objMetaData.bPostToAccount == true) {
                            if (objMetaData.iDebitAccount > 0) {
                                arrKey.push("DebitAc");
                                arrValue.push(objMetaData.iDebitAccount);
                            }

                            if (objMetaData.iCreditAccount > 0) {
                                arrKey.push("CreditAc");
                                arrValue.push(objMetaData.iCreditAccount);
                            }

                            if (DataType.isNullOrEmpty(objMetaData.sDrAccVariable, true) == false) {
                                arrKey.push("DebitVar");
                                arrValue.push(objMetaData.sDrAccVariable);
                            }

                            if (DataType.isNullOrEmpty(objMetaData.sCrAccVariable, true) == false) {
                                arrKey.push("CreditVar");
                                arrValue.push(objMetaData.sCrAccVariable);
                            }
                        }
                        break;
                    case eMasterDataType.Master:
                        if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0) {
                            arrKey.push("MasterTypeId");
                            arrValue.push(1);
                        }
                        else {
                            arrKey.push("MasterTypeId");
                            arrValue.push(objMetaData.iMasterTypeId);
                        }

                        break;
                    case eMasterDataType.ExternalTable:
                        arrKey.push("TableName");
                        arrValue.push(objMetaData.sExternalTableName);

                        arrKey.push("DisplayField");
                        arrValue.push(objMetaData.sExternalDisplayMember);

                        arrKey.push("ValueField");
                        arrValue.push(objMetaData.sExternalValueMember);
                        break;
                }

                if ((objMetaData.iFieldId & eVTFIELDFLAG.SCR_BODY) > 0
                    || (objMetaData.iFieldId & eVTFIELDFLAG.SCR_FTR) > 0) {
                    if (objMetaData.FormulaBehaviour == eTranEntryFormulaBehaviourBody.Formula) {
                        arrKey.push("Formula");
                        arrValue.push(objMetaData.sFormula);
                    }

                    if (objMetaData.bValueInBaseCurrency == true) {
                        arrKey.push("ValueInBase");
                        arrValue.push(undefined);
                    }
                }

                arrKey.push("MetaData");
                arrValue.push(objMetaData);

                FUIElement.writeKeyValueLog(arrKey, arrValue, sPrefix);
            }
            catch (err) {

            }
        }
    };
}

