                                {
                                    if (iComma == 0)//till now no comma found,make 1st expression
                                        temp += sInfix[i];
                                    else if (iComma == 1)//1 comma found,make 1st operand
                                        ds1 += sInfix[i];
                                    else
                                        ds2 += sInfix[i];//2 commas found ,make 2nd operand    
                                }
                                j++;
                                break;
                            case ')':
                                k++;
                                if (j == k)//no of (=no of )
