        getFilterCriteria: function (iDataTypeId) {
            var iCounter = 0;
            var arrFilterCriteria = [];
            var objGridRowData = null;
            var eleGrid = null;

            try {
                eleGrid = CONFIGURETRANS.EDITLAYOUT.getFilterCriteriaGrid();
                FGRIDCONTROL.update(eleGrid);
                for (iCounter = 0; iCounter < FGRIDCONTROL.getTotalRows(eleGrid); iCounter++) {
                    objGridRowData = FGRIDCONTROL.getRowValue(eleGrid, iCounter + 1);
                    if (FCommon.String.isNullOrEmpty(objGridRowData[0].Value) == true) {
                        continue;
                    }

                    objFilterCriteria = {};

                    if (iDataTypeId == eMasterDataType.Master) {
                        if (objGridRowData[0].Text == "iMasterId" || objGridRowData[0].Text == "sName") {
                            objFilterCriteria.FilterOnColumn = "a." + objGridRowData[0].Text;
                        }
                        else {
                            objFilterCriteria.FilterOnColumn = objGridRowData[0].Text;
                        }
                    }
                    else {
                        objFilterCriteria.FilterOnColumn = objGridRowData[0].Text;
                    }

                    //objFilterCriteria.FilterOnColumn = objGridRowData[0].Text;
                    objFilterCriteria.FilterOnColumnValue = objGridRowData[0].Value;
                    objFilterCriteria.Operator = objGridRowData[1].Text;
                    objFilterCriteria.OperatorID = objGridRowData[1].Value;
                    objFilterCriteria.CompareWith = objGridRowData[2].Value;
                    objFilterCriteria.FilterField = objGridRowData[3].Text;

                    if (FConvert.toInt(objFilterCriteria.CompareWith) == 0) { // Value
                        objFilterCriteria.FilterFieldID = 0;
                    }
                    else { // Field
                        objFilterCriteria.FilterFieldID = objGridRowData[3].Value;
                    }

                    objFilterCriteria.LinkField = objGridRowData[4].Text;
                    objFilterCriteria.Conjunction = objGridRowData[5].Value;

                    arrFilterCriteria.push(objFilterCriteria);
                }
            }
            catch (err) {
                COMMON.prototype.showMessage("{CONFIGURETRANS.EDITLAYOUT.getFilterCriteria} " + err.message, "Exception");
            }

            return (arrFilterCriteria);
        },

