    getBodyFlags: function (row, bEdit) {
        let eleRow = null;
        let objFlags = null;
        let result = null;

        try {
            if (bEdit != true) {
                objFlags = transactionDataStructure.getBodyFlagsObject();
            }

            if (row instanceof HTMLElement) {
                eleRow = row;
