    getFocusFormatBodyRowData: function (iRow, bIgnoreAttachmentData, bIgnoreBillwiseData, arrBodyIndex) {
        let iCounter = 0;
        let iIndex = 0;
        let objMetaData = null;
        let objBody = null;
        let objLink = null;
        let value = null;
        let cell = null;
        let obj = null;

        try {
            objBody = DataType.createDuplicateObject(EntryMain.m_objTrans.BodyData[iRow - 1]);
            objBody.BillwiseData = null;
            objBody.Links = null;

            if (objBody.Sales
                && DataType.isNullOrEmpty(objBody.Sales.Reservation, true) == true) {

                objBody.Sales.Reservation = undefined;
            }

            if (bIgnoreBillwiseData == false) {
                objBody.BillwiseData = EntryMainBillwise.getData(iRow);
            }

            for (iCounter = 0; iCounter < arrBodyIndex.length; iCounter++) {
                iIndex = arrBodyIndex[iCounter].Index;
                objMetaData = transEntryGlobal.EntryModel.MetaData.Body[iIndex];

                switch (objMetaData.iFieldId) {
                    case eVTFIELDID.FDF_BODYRATE:
                        if (FNumberOperation.isNotEqualTo(objBody.Sales.OrigRate, 0) == true && FNumberOperation.isNotEqualTo(objBody.ExchangeRate, 0) == true) {
                            objBody.Sales.Rate = FNumberOperation.mul(objBody.Sales.OrigRate, objBody.ExchangeRate);
                        }
                        break;
                    case eVTFIELDID.FDF_RMANO:
                        objBody.Sales.RMANos = transEntryRMA.getStringArray(objBody.Sales.RMANos);
                        break;
                    case eVTFIELDID.FDF_BODYINVTAG:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            objBody.InvTag = DataType.toInt(cell.getCellData());
                        }
                        break;
                    case eVTFIELDID.FDF_CREDITDAYSBASEDDISCOUNT:
                    case eVTFIELDID.FDF_BODYJRNDEBIT:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            if (objBody.OriginalAmounts[0] == 0) {
                                objBody.OriginalAmounts[0] = FNumberOperation.negated(FNumberOperation.convert(cell.getCellData()));
                                objBody.OriginalAmounts[1] = FNumberOperation.negated(objBody.OriginalAmounts[0]);
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYJRNCREDIT:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            if (objBody.OriginalAmounts[0] == 0) {
                                objBody.OriginalAmounts[0] = FNumberOperation.convert(cell.getCellData());

                                objBody.OriginalAmounts[1] = FNumberOperation.negated(objBody.OriginalAmounts[0]);
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_LINK:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            if (DataType.isValidObject(objBody.Links) == false) {
                                objBody.Links = [];
                            }

                            objLink = null;
                            value = cell.getCellText();
                            if (DataType.isNullOrEmpty(value) == false) {
                                objLink = transEntryLinks.getObjectFromCell(cell, objMetaData, iRow);
                            }

                            if (DataType.isValidObject(objLink) == true && objLink.LinkId > 0) {
                                objBody.Links.push(objLink);
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BODYBATCHNO:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            objBody.Sales.BatchNo = transEntryFields.getBatchInfo(iRow);
                        }
                        break;
                    case eVTFIELDID.FDF_MAXQTYRELEASE:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            objBody.Sales.StockToRelease = FocusDataStructs.getStockToReleaseObject(transEntryMaxQtyRelease.getReservingId(iRow), transEntryFields.getMaxQtyRelease(iRow));
                            if (FNumberOperation.isEqualTo(objBody.Sales.StockToRelease.BaseTransactionId, 0) == true) {
                                objBody.Sales.StockToRelease = null;
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BINS:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            objBody.Sales.BinsData = [];
                            value = transEntryFields.getBins(iRow);
                            if (DataType.isValidObject(value) == true) {
                                objBody.Sales.BinsData.push(value[0]);
                            }
                        }
                        break;
                    case eVTFIELDID.FDF_BINS2:
                        cell = transEntryGrid.getCellObject(iRow, arrBodyIndex[iCounter].Column);
                        if (DataType.isValidObject(cell) == true) {
                            if (DataType.arrayLength(objBody.Sales.BinsData) < 1) {
                                objBody.Sales.BinsData = [];
                            }

                            value = transEntryFields.getBins2(iRow);
                            if (DataType.isValidObject(value) == true) {
                                if (objBody.Sales.BinsData.length == 0) {
                                    objBody.Sales.BinsData.push();
                                    objBody.Sales.BinsData.push(value[0]);
                                }
                                else if (objBody.Sales.BinsData.length == 1) {
                                    objBody.Sales.BinsData.push(value[0]);
                                }
                                else {
                                    objBody.Sales.BinsData[1] = value[0];
                                }
                            }
                        }
                        break;
                    default:
                        // Only for document and picture type layout field
                        for (iIndex = 0; iIndex < objBody.BodyExtra.length; iIndex++) {
                            if (objBody.BodyExtra[iIndex].ID == objMetaData.iFieldId) {
                                if (bIgnoreAttachmentData == true) {
                                    objBody.BodyExtra[iIndex].Tag = null;
                                }
                                else if (DataType.isValidObject(objBody.BodyExtra[iIndex].Tag) == true) {
                                    obj = {};
                                    obj.FileName = objBody.BodyExtra[iIndex].Tag.sFileName;
                                    obj.FileData = objBody.BodyExtra[iIndex].Tag.sData;
                                    objBody.BodyExtra[iIndex].Tag = obj;
                                }
                                break;
                            }
                        }
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryData.getFocusFormatBodyRowData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objBody);
    },

