    },

    validateUnitBin: function(iBinId) {
        let iCounter = 0;
        let iIndex = 0;
        let arrBins = null;

        try {
            if (DataType.arrayLength(BinsUI.m_arrOtherRowBins) > 0) {            
                for (iCounter = 0; iCounter < BinsUI.m_arrOtherRowBins.length; iCounter++) {
                    arrBins = BinsUI.m_arrOtherRowBins[iCounter];
                    if(DataType.isValidObject(arrBins) == false) {
                        continue;
                    }

                    for (iIndex = 0; iIndex < arrBins.length; iIndex++) {
                        if (arrBins[iIndex].BinId != iBinId) {
                            continue;
                        }

                        if (arrBins[iIndex].UnitId <= 0) {
                            continue;
                        }

                        if (arrBins[iIndex].UnitId != (BinsUI.m_BinsParam.UnitId)) {
                            return(false);
                        }
                    }
                }
            }
        }
        catch(err) {
            COMMON.prototype.showMessage("{BinsUI.validateUnitBin} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(true);
    },

    removeZeroStockBin: function(arrBinDetails, arrCurrentBinId, bInward) {
        let iCounter = 0;
        let iTotal = 0;
        let iCurrentBinIdTotal = 0;
        let iRow = 0;
        let lstIndex = [];

        try {
            iTotal = DataType.arrayLength(arrBinDetails);
            iCurrentBinIdTotal = DataType.arrayLength(arrCurrentBinId);

            // REMOVE BIN WITH ZERO STOCK FROM LIST
            for (iCounter = 0; iCounter < iTotal; iCounter++) {
                if (arrBinDetails[iCounter].Group) {
                    continue;
                }

                if ((bInward == true
                    && arrBinDetails[iCounter].Type == eBinsType.Bin
                    && arrBinDetails[iCounter].FreeSpace <= 0)) {

                    for (iRow = 0; iRow < iCurrentBinIdTotal; iRow++) {
                        if (arrCurrentBinId[iRow] == arrBinDetails[iCounter].Id) {
                            break;
                        }
                    }

                    if (iRow >= iCurrentBinIdTotal) {
                        lstIndex.push(iCounter);
                    }
                }

                if (bInward == false && arrBinDetails[iCounter].Stock <= 0) {
                    lstIndex.push(iCounter);
                }
            }

            lstIndex = lstIndex.reverse();

            for (iCounter = 0; iCounter < lstIndex.length; iCounter++) {
                arrBinDetails.splice(lstIndex[iCounter], 1);
            }
        }
        catch(err) {
            COMMON.prototype.showMessage("{BinsUI.removeZeroStockBin} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrBinDetails);
    },

    outwardAutoAllocation: function(arrBinDetails) {
        let iCounter = 0;
        let dAvailQty = 0;
        let arrBinsQuantity = null;
        let objBinsQuantity = null;

        try{
            arrBindDetails = BinsUI.removeZeroStockBin(arrBinDetails, [], BinsUI.m_BinsParam.Inward);

            // Sorting Bins rows according to Pref condtion       
            arrBinDetails = BinsUI.getBinOrderBySetting(arrBinDetails, BinsUI.m_Preference.Bins.iPalceItemOutward, false); 

            arrBinsQuantity = [];
            for (iCounter = 0; iCounter < arrBinDetails.length; iCounter++) {
                if (arrBinDetails[iCounter].Group != true) {
                    dAvailQty = arrBinDetails[iCounter].Stock;

                    objBinsQuantity = {};
                    objBinsQuantity.BinId = arrBinDetails[iCounter].Id;
                    objBinsQuantity.SkidId = arrBinDetails[iCounter].SkidId;

                    if (DataType.lt(dAvailQty, BinsUI.m_dQuantity) == true){
                        objBinsQuantity.Quantity = dAvailQty;
                    }
                    else {
                        if (DataType.lt(BinsUI.m_dQuantity, 0) == true){
                            objBinsQuantity.Quantity = 0;
                        }
                        else {
                            objBinsQuantity.Quantity = BinsUI.m_dQuantity;
                        }
                    }

                    BinsUI.m_dQuantity = DataType.sub(BinsUI.m_dQuantity, dAvailQty);
                    arrBinsQuantity.push(objBinsQuantity);
                    if (DataType.lte(BinsUI.m_dQuantity, 0) == true) {
                        break;
                    }
                }
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.outwardAutoAllocation} " + err.message, GlobalPref.getResourceValue("Exception"))
        }

        return(arrBinsQuantity);
    },

