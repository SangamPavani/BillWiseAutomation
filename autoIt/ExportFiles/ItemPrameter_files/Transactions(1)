    SetCurrentFormula: function () {

        var vFormula = "";
        try {
            var VATPreload = document.getElementById("dvEditScreenData").getAttribute('data-VATPreload');

            var dvEle = document.getElementById("dvEditScreenData").getElementsByTagName('input');
            if (objVATFields != undefined) {
                objVATFields.SelectedFields = [];
                for (var i = 0; i < dvEle.length; i++) {
                    if (dvEle[i].type == "checkbox") {
                        if (dvEle[i].checked) {
                            objVATFields.SelectedFields.push(dvEle[i].getAttribute('data-iFieldId'));
                            var Tag = JSON.parse(dvEle[i].getAttribute('data-tag'));
                            if (!Array.isArray(Tag)) {
                                var arr = [Tag, 0];
                                Tag = arr;
                            }
                            if (vFormula[0] != '(')
                                vFormula = "(";
                            else
                                vFormula += Tag[1] == "0" ? "+" : "-";
                            vFormula += Tag[0];
                        }
                    }
                }
                if (vFormula[0] == '(') {
                    vFormula += ") *";
                }
                vFormula += VATPreload;
                if (document.getElementById("chkVATInclusive").checked) {
                    vFormula += "/(100+" + VATPreload + ")";
                    objVATFields.VATInclusive = true;
                }
                else {
                    vFormula += "/100";
                    objVATFields.VATInclusive = false;
                }
                objVATFields.Formula = vFormula;
                document.getElementById("txtVATFormula").value = vFormula;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage(err.message, "EXCEPTION");
        }
    },
