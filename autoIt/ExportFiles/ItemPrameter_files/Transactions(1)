    validateBins: function (arrBins) { // arrBins is of type BinsDetails[]
        let iCounter = 0;
        let iIndex = 0;
        let arrFilterBins = null;

        try{
            arrFilterBins = [];
            if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.bCannotBePlacedInSameBin == 1) {  // If Same bin and Inward 
                if (BinsUI.m_BinsParam.ProductId > 0) {
                    for (iCounter = 0; iCounter < arrBins.length; iCounter++) {
                        if (arrBins[iCounter].Group == true) {
                            continue;
                        }

                        if (arrBins[iCounter].Products.length > 0 && arrBins[iCounter].Type == eBinsType.Bin) {
                            for (iIndex = 0; iIndex < arrBins[iCounter].Products.length; iIndex++) {
                                if (arrBins[iCounter].Products[iIndex] != (BinsUI.m_BinsParam.ProductId)) {
                                    continue;
                                }
                                else {
                                    if (BinsUI.m_bUnitCheck){
                                        if (BinsUI.validateUnitBin(arrBins[iCounter].Id)) {
                                            arrFilterBins.push(arrBins[iCounter]);
                                        }
                                    }
                                    else {
                                        arrFilterBins.push(arrBins[iCounter]);
                                    }
                                }
                            }
                        }
                        else {
                            arrFilterBins.push(arrBins[iCounter]);
                        }
                    }
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.iBinsAllocationRestriction == 1) {  // Item based on their category, Inward 
                for (iCounter = 0; iCounter < arrBins.length; iCounter++) {
                    if (arrBins[iCounter].Group == true) {
                        continue;
                    }

                    if (arrBins[iCounter].Type == eBinsType.Bin && arrBins[iCounter].Category != BinsUI.m_objBinsData.ProductData.Category){
                        continue;
                    }
                    else {
                        arrFilterBins.push(arrBins[iCounter]);
                    }
                }
            }
            else if (BinsUI.m_BinsParam.Inward == true && BinsUI.m_Preference.Bins.bTwoDifferentBatchesCannotbePlacedinSameBin == true){
                for (iCounter = 0; iCounter < arrBins.length; iCounter++) {
                    arrFilterBins.push(arrBins[iCounter]);
                }
            }
            else{
                for (iCounter = 0; iCounter < arrBins.length; iCounter++) {
                    arrFilterBins.push(arrBins[iCounter]);
                }
            }

            arrBins = arrFilterBins;
        }
        catch (err) {
            COMMON.prototype.showMessage("{BinsUI.validateBins} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrBins);
    },

    validateBinsManual: function(iBinId) {
        let iCounter = 0;
        let iIndex = 0;
        let bExist = false;

        try {
            for (iCounter = 0; iCounter < BinsUI.m_objBinsData.BinDetails.length; iCounter++) {
                if (BinsUI.m_objBinsData.BinDetails[iCounter].Group == true) {
                    continue;
                }

                if (BinsUI.m_objBinsData.BinDetails[iCounter].Id != iBinId || BinsUI.m_objBinsData.BinDetails[iCounter].Type != 0) {
                    continue;
                }

                if (DataType.arrayLength(BinsUI.m_objBinsData.BinDetails[iCounter].Products) > 0) {
                    for (iIndex = 0; iIndex < BinsUI.m_objBinsData.BinDetails[iCounter].Products.length; iIndex++) {
                        if (BinsUI.m_objBinsData.BinDetails[iCounter].Products[iIndex] != (BinsUI.m_BinsParam.ProductId)) {
                            bExist = true;
                        }
                    }

                    if (bExist) {
                        return(false);
                    }
                }
                else {
                    return(true);
                }
            }
        }
        catch(err) {
            COMMON.prototype.showMessage("{BinsUI.validateBinsManual} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

