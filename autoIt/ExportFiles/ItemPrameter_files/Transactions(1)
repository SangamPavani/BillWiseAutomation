                            arrFoundIndex = DataType.arrayFindDataIndex(arrProductIds, iProductId, "==")
                            if(arrFoundIndex.length > 0) {
                                if(iFoundIndex != -1 && iFoundIndex != arrFoundIndex[0]) {
