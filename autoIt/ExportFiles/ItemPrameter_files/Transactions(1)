    formatFractionNumber: function (iFieldId, value, iNoDecimal, iRow) {
        try {
            if (FNumberOperation.isNaN(value) == true) {
                value = 0;
            }

            //value = Number(value);
            value = FNumberOperation.convert(value);

            if ((iFieldId & eVTFIELDFLAG.LAY_HDR) > 0) {
                //value = value.toFixed(iNoDecimal);
                value = FNumberOperation.toFixed(value, iNoDecimal, true);
            }
            else if ((iFieldId & eVTFIELDFLAG.LAY_BODY) > 0) {
                //value = value.toFixed(iNoDecimal);
                value = FNumberOperation.toFixed(value, iNoDecimal, true);
            }
            else if ((iFieldId & eVTFIELDFLAG.SCR_BODY) > 0) {
                //value = value.toFixed(iNoDecimal);
                value = FNumberOperation.toFixed(value, iNoDecimal, true);
            }
            else {
                switch (iFieldId) {
                    case eVTFIELDID.FDF_BODYQUANTITY:
                    case eVTFIELDID.FDF_BODYALTQUANTITY:
                    case eVTFIELDID.FDF_QUANTITY_IN_BASE:
                    case eVTFIELDID.FDF_BATCH_QUANTITY:
                    case eVTFIELDID.FDF_RESERVEQUANTITY:
                    case eVTFIELDID.FDF_MAXQTYRELEASE:
                        value = FNumberOperation.toFixed(value, transEntryQuantity.getDecimals(iRow), true);
                        break;
                    case eVTFIELDID.FDF_BODYRATE:
                    case eVTFIELDID.FDF_BODYGROSS:
                    case eVTFIELDID.FDF_BODYAMOUNT:
                    case eVTFIELDID.FDF_BATCHRATE:
                    case eVTFIELDID.FDF_BATCHRATE1:
                    case eVTFIELDID.FDF_BATCHRATE2:
                    case eVTFIELDID.FDF_SCREEN_AMOUNT:
                    case eVTFIELDID.FDF_SCREEN_NET_AMOUNT:
                    case eVTFIELDID.FDF_ORIGINAL_AMOUNT:
                    case eVTFIELDID.FDF_ORIGINAL_GROSS:
                    case eVTFIELDID.FDF_ORIGINAL_RATE:
                    case eVTFIELDID.FDF_AMOUNT1:
                    case eVTFIELDID.FDF_BODYNET:
                    case eVTFIELDID.FDF_LOCAL_NETAMOUNT:
                    case eVTFIELDID.FDF_LOCAL_GROSSAMOUNT:
                    case eVTFIELDID.FDF_REFERENCE_AMOUNT:
                    case eVTFIELDID.FDF_REFERENCE_BASE_AMOUNT:
                    case eVTFIELDID.FDF_REFERENCE_LOCAL_AMOUNT:
                    case eVTFIELDID.FDF_CREDITDAYSBASEDDISCOUNT:
                    case eVTFIELDID.FDF_BODYJRNDEBIT:
                    case eVTFIELDID.FDF_BODYJRNCREDIT:
                        iRow = DataType.toInt(iRow);
                        value = FNumberOperation.toFixed(value, transEntrySettings.getDecimalsInAmount(iRow), true);
                        break;
                    case eVTFIELDID.FDF_EXCHANGERATE:
                    case eVTFIELDID.FDF_BODYEXCHANGERATE:
                    case eVTFIELDID.FDF_LOCAL_EXCHANGERATE:
                    case eVTFIELDID.FDF_LOCEXCHANGERATE:
                        value = FNumberOperation.toFixed(value, transEntryExchangeRate.getDecimals());
                        break;
                    case eVTFIELDID.FDF_BOMSIZE:
                        value = FNumberOperation.toFixed(value, iNoDecimal);
                        break;
                    case eVTFIELDID.FDF_BALANCEQTY:
                        value = FNumberOperation.toFixed(value, transEntryQuantity.getDecimals());
                        break;
                    case eVTFIELDID.FDF_BALANCESTKVAL:
                    case eVTFIELDID.FDF_NEWSTKVAL:
                        value = FNumberOperation.toFixed(value, transEntryCurrency.getDecimals(iRow));
                        break;
                    case eVTFIELDID.FDF_AVGRATE:
                    case eVTFIELDID.FDF_NEWAVGRATE:
                        value = FNumberOperation.toFixed(value, transEntryCurrency.getDecimals(iRow));
                        break;
                    default:
                        value = FNumberOperation.toFixed(value, 6);
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMain.formatFractionNumber} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (value);
    },


