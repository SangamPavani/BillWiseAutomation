    addDuplicateColumnGroupFilter: function (iRow) {
        let iCounter = 0;
        let arrData = null;
        let obj = null;

        try {
            arrData = [];
            for (iCounter = 0; iCounter < transEntryGlobal.arrColumnGroupFilter.length; iCounter++) {
                obj = transEntryGlobal.arrColumnGroupFilter[iCounter];
                if (obj.iRow == iRow) {
                    obj = DataType.createDuplicateObject(obj);
                    obj.iRow++;
                    arrData.push(obj);
                    continue;
                }

                if (obj.iRow >= iRow) {
                    transEntryGlobal.arrColumnGroupFilter[iCounter].iRow++;
                }
            }

            while (arrData.length > 0) {
                transEntryGlobal.arrColumnGroupFilter.push(arrData[0]);
                arrData.splice(0, 1);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.addDuplicateColumnGroupFilter}" + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateColumnGroupFilter: function (objRow, iColumn, iGroupId, bLeaf) {
        let iCounter1 = 0;
        let objColumn = null;

        try {
            iCounter1 = 0;
            while (iCounter1 < objRow.arrColumnFilter.length) {
                objColumn = objRow.arrColumnFilter[iCounter1];
                if (objColumn.iColumn == iColumn) {
                    objColumn.iGroupId = iGroupId;
                    objColumn.bGroup = DataType.toBoolean(bLeaf) == false;
                    objRow.arrColumnFilter.splice(iCounter1, 1, objColumn);
                    break;
                }

                iCounter1++;
            }

            if (iGroupId > 0 && iCounter1 >= objRow.arrColumnFilter.length) // If column not found
            {
                objColumn = transEntryGrid.getEmptyColumnFilterObject();
                objColumn.iColumn = iColumn;
                objColumn.iGroupId = iGroupId;
                objColumn.bGroup = DataType.toBoolean(bLeaf) == false;
                objRow.arrColumnFilter.push(objColumn);
            }

            if (iGroupId > 0 || iCounter1 < objRow.arrColumnFilter.length) {
                for (iCounter1 = 0; iCounter1 < transEntryGlobal.arrColumnGroupFilter.length; iCounter1++) {
                    if (transEntryGlobal.arrColumnGroupFilter[iCounter1].iRow == objRow.iRow) {
                        transEntryGlobal.arrColumnGroupFilter.splice(iCounter1, 1, objRow);
                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.updateColumnGroupFilter} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

