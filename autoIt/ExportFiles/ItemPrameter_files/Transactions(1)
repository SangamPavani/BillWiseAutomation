    findGridRowIndex: function(data, iColIndex, eleGrid) {
        let sVoucherNo = "";
        let iRow = 0;
        let iCounter = 0;
        let iTotalRows = 0;
        let arrData = null;
        let cell = null;

        try {
            data = DataType.toString(data);

            if (transEntryWorkflowInfo.isConsolidatedDisplay == true) {
                if(iColIndex == transEntryWorkflowInfo.HiddenVoucherNoColumn) {
                    sVoucherNo = data;
                }
                else {
                    arrData = transEntryWorkflowInfo.HiddenData;
                    for (iCounter = 0; iCounter < arrData.length; iCounter++) {
                        if (iColIndex == transEntryWorkflowInfo.HiddenTransIdColumn) {
                            if (arrData[iCounter].lRefIds == data) {
                                sVoucherNo = arrData[iCounter].sVoucherNo;
                                break;
                            }
                        }
                        else if (iColIndex == transEntryWorkflowInfo.HiddenPendingColumn) {
                            if (arrData[iCounter].dPendingValue == data) {
                                sVoucherNo = arrData[iCounter].sVoucherNo;
                                break;
                            }
                        }
                        else if (iColIndex == transEntryWorkflowInfo.HiddenVoucherNoColumn) {
                            if (arrData[iCounter].sVoucherNo == data) {
                                sVoucherNo = arrData[iCounter].sVoucherNo;
                                break;
                            }
                        }
                        else {
                            break;
                        }
                    }
                }
            }


            iTotalRows = FGRIDCONTROL.getTotalRows(eleGrid);
            for(iRow = 1; iRow <= iTotalRows; iRow++) {
                cell = transEntryWorkflowFragment.getCellObject(iRow, iColIndex, eleGrid);
                if (DataType.isValidObject(cell) == false) {
                    continue;
                }

                if (DataType.toString(cell.getCellData()) === data) {
                    return (iRow);
                }
                else if (DataType.isNullOrEmpty(sVoucherNo) == false && transEntryWorkflow.getRowVoucherNoValue(iRow, eleGrid) == sVoucherNo) {
                    return (iRow);
                }
            }
        }
        catch(err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.findGridRowIndex} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(-1);
    },

    getSelectedWorkflowData: function (eleWorkflowGrid, iLinkId) {
