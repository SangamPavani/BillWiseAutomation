                        dOrig1 = DataType.negated(dOrig1);
                    }
                    else {
                        dOrig2 = DataType.negated(dOrig2);
                    }

                    if (DataType.gt(dOrig1, 0) == true) {
                        Cr = DataType.add(Cr, dOrig1);
                    }

                    if (DataType.gt(dOrig2, 0) == true) {
                        Cr = DataType.add(Cr, dOrig2);
                    }

                    if (DataType.lt(dOrig1, 0) == true) {
                        Dr = DataType.add(Dr, dOrig1);
                    }

                    if (DataType.lt(dOrig2, 0) == true) {
                        Dr = DataType.add(Dr, dOrig2);
                    }
                }

                if (DataType.neq(Dr, Cr) == true && DataType.neq(DataType.abs(DataType.add(Dr, Cr)), 0) == true)
                {
                    let dDiff = DataType.abs(DataType.add(Dr, Cr));
                    dOrig1 = objTransaction.BodyData[0].OriginalAmounts[0];
                    dOrig2 = objTransaction.BodyData[0].OriginalAmounts[1];

                    if (transEntryInfo.isItNegative == true) {
                        dOrig1 = DataType.negated(dOrig1);
                    }
