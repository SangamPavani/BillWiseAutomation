    setLinkValue: function (objData, iCurrentRow, bFromWorkflow, bUpdateQtyToRelease, arrMappingFields) {
        let sValue = "";
        let iRow = 0;
        let dValue = 0;
        let fConversion = 0;
        let dUsedLinkValue = 0;
        let dInputValue = 0;
        let dRate = 0;
        let arrData = undefined;
        let cell = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugLink == true) {
                debugger
            }

            if (objData.iColumn < 0) {
                return (false);
            }

            bUpdateQtyToRelease = DataType.toBoolean(bUpdateQtyToRelease);
            if (bUpdateQtyToRelease == true && transEntryFieldInfo.MaxQtyRelease.ColumnIndex < 0) {
                bUpdateQtyToRelease = false;
            }

            iCurrentRow = DataType.toInt(iCurrentRow);
            for (iRow = 0; iRow < objData.arrData.length; iRow++) {
                obj = objData.arrData[iRow];

                cell = transEntryGrid.getCellObject(iRow + iCurrentRow + 1, objData.iColumn);
                if (cell.getCellData("RefId") != obj.RefId) {
                    continue;
                }

                //cell.setCellText(obj.VoucherNo, obj.RefId);
                cell.setCellText(obj.VoucherNo);
                cell.setCellData(obj);
                cell.setCellData(obj.VoucherNo);

                cell.setCellData("linkfield", objData.iLinkField);

                if (bUpdateQtyToRelease == true) {
                    transEntryMaxQtyRelease.setRefId(iRow + iCurrentRow + 1, obj.RefId);
                    EntryMainReservation.updateRefIdInLoadedReleaseData(iRow + iCurrentRow + 1, obj.RefId);
                }

                switch (objData.iLinkField) {
                    case eTranEntryLinkValue.Amount:
                        //fConversion = transEntryUnit.getConversionValue(iRow + iCurrentRow + 1);
                        fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCurrentRow + 1);

                        if (bFromWorkflow == true) {
                            dValue = DataType.div(obj.LinkValue, fConversion);
                        }
                        else {
                            dUsedLinkValue = EntryMainWorkflow.getUsedLinkValue(obj.RefId, objData.arrUsedLinks, iRow + iCurrentRow + 1);

                            arrData = DataType.arrayFilterData(objData.arrUsedLinks, ["RefId", "iRow"], [obj.RefId, (iCurrentRow + 1)], "==");
                            if (DataType.arrayLength(arrData) > 0) {
                                dValue = DataType.div(arrData[0].UsedLinkValue, fConversion);
                            }
                            else {
                                dValue = (DataType.toDecimal(obj.LinkValue) - dUsedLinkValue) / fConversion;
                            }

                            //dValue = (DataType.toDecimal(obj.LinkValue) - dUsedLinkValue) / fConversion;
                        }

                        sValue = DataType.toDecimal(dValue, transEntrySettings.getDecimalsInAmount(iRow + iCurrentRow + 1));

                        cell = EntryMainUI.getElement(transEntryFieldInfo.Amount, iRow + iCurrentRow + 1).Value;
                        if (DataType.isValidObject(cell) == true) {
                            cell.setCellText(sValue, dValue);
                        }
                        
                        break;
                    case eTranEntryLinkValue.Gross:
                        if (transEntryLinks.isFieldExistInMappings(eVTFIELDID.FDF_BODYGROSS, arrMappingFields) == true) {
                            break;
                        }

                        cell = EntryMainUI.getElement(transEntryFieldInfo.Gross, iRow + iCurrentRow + 1).Value;
                        if (DataType.isValidObject(cell) == false) {
                            continue;
                        }

                        fConversion = EntryMainMemoryObject.getExchangeRate(iRow + iCurrentRow + 1);

                        obj.LinkValue = FNumberOperation.convert(obj.LinkValue);
                        dValue = FNumberOperation.div(obj.LinkValue, fConversion);

                        dRate = EntryMainMemoryObject.getRateValue(iRow + iCurrentRow + 1);
                        if (bFromWorkflow == false) {
                            dInputValue = transEntryFields.getQty(iRow + iCurrentRow + 1);
                            if (FNumberOperation.isNotEqualTo(dInputValue, 0) == true
                                && FNumberOperation.isLessThan(FNumberOperation.mul(dInputValue, dRate), dValue) == true) { // Gross is less than available gross
                                dValue = FNumberOperation.mul(dInputValue, dRate);
                            }
                        }

                        sValue = DataType.toDecimal(dValue, transEntrySettings.getDecimalsInAmount(iRow + iCurrentRow + 1));

                        cell.setCellText(sValue, dValue);

                        dValue = FNumberOperation.div(dValue, dRate);
                        transEntryQuantity.setValue(dValue, iRow + iCurrentRow + 1, { bUpdateMemoryObject: true });

                        break;
                    case eTranEntryLinkValue.Net:
                        break;
                    case eTranEntryLinkValue.Quantity:
                        cell = EntryMainUI.getElement(transEntryFieldInfo.Qty, iRow + iCurrentRow + 1).Value;
                        if (DataType.isValidObject(cell) == false) {
                            continue;
                        }

                        if(objData.objLinkDefinition.IsCheckStock == true 
                            && DataType.lt(EntryMainMemoryObject.getBaseQuantityValue(iRow + iCurrentRow + 1), obj.LinkValue) == true) {
                            continue;
                        }

                        fConversion = transEntryUnit.getConversionValue(iRow + iCurrentRow + 1);

                        obj.LinkValue = DataType.toDecimal(obj.LinkValue);

                        dValue = FNumberOperation.div(obj.LinkValue, fConversion);

                        //if (bFromWorkflow == false)
                        {
                            dInputValue = transEntryFields.getQty(iRow + iCurrentRow + 1);
                            if (DataType.isZero(dInputValue) == false && DataType.lt(dInputValue, dValue) == true) { // Input quantity is less than available quantity
                                dValue = dInputValue;
                            }
                            else if (bFromWorkflow == true && DataType.lt(dInputValue, dValue) == true) {
                                dValue = dInputValue;
                            }
                        }

                        sValue = DataType.toDecimal(dValue, transEntryQuantity.getDecimals());

                        cell.setCellText(sValue, dValue);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYQUANTITY, dValue, iRow + iCurrentRow + 1);

                        transEntryGross.calculateAndUpdate({ iRow: iRow + iCurrentRow + 1 });
                        break;
                    case eTranEntryLinkValue.AlternateQuantity:
                        cell = EntryMainUI.getElement(transEntryFieldInfo.AltQty, iRow + iCurrentRow + 1).Value;
                        if (DataType.isValidObject(cell) == false) {
                            continue;
                        }

                        if (objData.objLinkDefinition.IsCheckStock == true
                            && DataType.lt(EntryMainMemoryObject.getBaseQuantityValue(iRow + iCurrentRow + 1), obj.LinkValue) == true) {
                            continue;
                        }

                        fConversion = 1;

                        obj.LinkValue = DataType.toDecimal(obj.LinkValue);

                        dValue = FNumberOperation.div(obj.LinkValue, fConversion);

                        dInputValue = EntryMainUI.getValue(transEntryFieldInfo.AltQty, iRow + iCurrentRow + 1);
                        if (DataType.isZero(dInputValue) == false && DataType.lt(dInputValue, dValue) == true) { // Input quantity is less than available quantity
                            dValue = dInputValue;
                        }
                        else if (bFromWorkflow == true && DataType.lt(dInputValue, dValue) == true) {
                            dValue = dInputValue;
                        }

                        sValue = DataType.toDecimal(dValue, transEntryQuantity.getDecimals());

                        cell.setCellText(sValue, dValue);
                        EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYALTQUANTITY, dValue, iRow + iCurrentRow + 1);
                        break;
                    case eTranEntryLinkValue.TransactionAmount:
                        break;
                    case eTranEntryLinkValue.TransactionGross:
                        //if (transEntryLinks.isFieldExistInMappingList(eVTFIELDID.FDF_BODYRATE, objData.objLinkDefinition.Mappings) == false) {
                        //    transEntryGross.setValue(obj.LinkValue, iRow + iCurrentRow + 1, true);
                        //    dValue = transEntryFields.getQty(iRow + iCurrentRow + 1);
                        //    dValue = DataType.div(obj.LinkValue, dValue);

                        //    if (transEntryInfo.Settings.Inventory.DoNotRoundOffRate == false) {
                        //        dValue = FNumberOperation.toFixed(dValue, transEntrySettings.getDecimalsInAmount(iRow + iCurrentRow + 1));
                        //    }

                        //    dValue = transEntryRate.setValue(dValue, iRow + iCurrentRow + 1);
                        //    EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, dValue, iRow + iCurrentRow + 1);
                        //}
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("Some error in body setLinkValue method.", GlobalPref.getResourceValue("Exception"));
            transEntryGlobal.writeErrorLog("{EntryMainBody.setLinkValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    // Sets link data of loaded voucher in appropriate column (Called from EntryMainUI.displayBodyData)
    setLinkColumnValue: function (arrLinkData, iRow, dBaseQuantity, dGross, dAmount0, dAmount1) {
        let iCounter = 0;
        let iIndex = 0;
        let iLinkField = 0;
        let arrFields = undefined;
        let objLinkData = null;
        let objLinkDef = null;
        let objLinkColumn = null;
        let obj = undefined;

        try {
            arrFields = transEntryFieldInfo.getLinkFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                obj = arrFields[iCounter];
                objLinkDef = obj.MetaData.Tag;
                if (DataType.isValidObject(objLinkDef) == false) {
                    continue;
                }

                for (iIndex = 0; iIndex < arrLinkData.length; iIndex++) {
                    objLinkData = arrLinkData[iIndex];
                    if (objLinkDef.LinkId != objLinkData.LinkId) {
                        continue;
                    }

                    objLinkColumn = transEntryGrid.getCellObject(iRow, obj.ColumnIndex);
                    if (DataType.isValidObject(objLinkColumn) == false) {
                        continue;
                    }

                    iLinkField = transEntryLinks.getLinkField(obj.MetaData.iMasterLink);

                    if (iLinkField == eTranEntryLinkValue.Quantity && transEntryInfo.isItSales == true && DataType.isValidObject(dBaseQuantity) == true) {
                        objLinkData.UsedValue = dBaseQuantity;
                    }
                    else if (iLinkField == eTranEntryLinkValue.Gross && transEntryInfo.isItSales == true && DataType.isValidObject(dGross) == true) {
                        objLinkData.UsedValue = dGross;
                    }
                    else if (iLinkField == eTranEntryLinkValue.Net && DataType.isValidObject(dAmount1) == true) {
                        objLinkData.UsedValue = dAmount1;
                    }
                    else if (DataType.isValidObject(dAmount0) == true) {
                        objLinkData.UsedValue = dAmount0;
                    }

                    if (objLinkDef.UseLinkForLoading == true) {
                        objLinkData.UsedValue = 0;
                    }

                    arrLinkData[iIndex] = objLinkData;

                    objLinkColumn.setCellText(objLinkData.VoucherNo);
                    objLinkColumn.setCellData(objLinkData);
                    objLinkColumn.setCellData("row", iRow);
                    objLinkColumn.setCellData("linkfield", iLinkField);
                    objLinkColumn.setCellData(objLinkData.VoucherNo);

