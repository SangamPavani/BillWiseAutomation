    // Returns array of batch info for all rows except passed row
    getUsedBatchesList: function (iExcludeRow, bTransQty) {
        let iRow = 0;
        let arrBatchesInfo = [];
        let result = null;

        try {
            for (iRow = 1; iRow <= transEntryGrid.getTotalRows() ; iRow++) {
                if (EntryMainBody.isRowEditable(iRow) == false) {
                    break;
                }

                if (iRow == iExcludeRow) {
                    continue;
                }

                result = transEntryFields.getBatchInfo(iRow, false, bTransQty);
                if (DataType.isValidObject(result) == false || DataType.isNullOrEmpty(result.BatchNo, true) == true) {
                    continue;
                }

                result.BodyId = transEntryFields.getBodyId(iRow);
                result.InvTagId = transEntryFields.getInvTag(iRow);
                result.BaseQty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                if (GlobalPref.DecimalsInQty >= 16)
                    result.BaseQty = FNumberOperation.toFixed(result.BaseQty, GlobalPref.DecimalsInQty);
                result.dAltQty = EntryMainMemoryObject.getAltQuantityValue(iRow);
                result.IReservationId = transEntryMaxQtyRelease.getReservingId(iRow);
                result.sUnitName = EntryMainUI.getValue(transEntryFieldInfo.Unit, iRow, true);
                result.dConversion = transEntryUnit.getConversionValue(iRow);
                result.ArrBinData = transEntryFields.getBins(iRow);


                arrBatchesInfo.push(result);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBatch.getUsedBatchesList} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrBatchesInfo);
    },

