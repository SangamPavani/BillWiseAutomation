    validateDate: function (objMetaData, value, iRowCounter, sHeading) {
        let sOldASNLPN = "";
        let iMaskedVoucher = 0;
        let iDocumentDate = 0;
        let iToday = 0;
        let objASNLPNInfo = undefined;
        let result = null;

        try {
            result = EntryMainValidate.getResultObject();
            result.lValue = 1;

            iMaskedVoucher = transEntryInfo.VoucherType;
            iDocumentDate = EntryMain.m_objTrans.Header.Date;

            iRowCounter = DataType.toInt(iRowCounter);
            switch (objMetaData.iFieldId) {
                case eVTFIELDID.FDF_DUEDATE:
                case eVTFIELDID.FDF_BODYDUEDATE:
                    if (transEntryFieldInfo.DueDate.Area != eTranEntryFieldArea.None) {
                        if (EntryMainBody.isBRSRow(iRowCounter) == false && value < iDocumentDate) {
                            result.lValue = 0;
                            result.sValue = GlobalPref.getResourceValue("msgDueDtCantLessDocDt");
                        }
                    }
                    break;
                case eVTFIELDID.FDF_DATE:
                    if (value < EntryMain.m_iAccountingDate
                        && EntryMainValidate.canDocumentDateBeLessThanAccountingDate(iMaskedVoucher) == false) {
                        result.lValue = 0;
                        result.sValue = GlobalPref.getResourceValue("msgDateLessAccDate");

                        break;
                    }

                    if (transEntryGlobal.EntryModel.iClosingDate > 0 && value > transEntryGlobal.EntryModel.iClosingDate) {
                        result.lValue = 0;
                        result.sValue = GlobalPref.getResourceValue("msgDateBeyondFiscal");
                        break;
                    }

                    if (transEntryInfo.UserId != GlobalPref.SUPER_USER) { // Not SU
                        iToday = transEntryInfo.Today;
                        if (transEntryGlobal.EntryModel.Rights.CantAddFutureTransactions == true && iDocumentDate > iToday) {
                            result.lValue = 0;
                            result.sValue = GlobalPref.getResourceValue("msgNoRightsFutureDate");

                            break;
                        }


                        // Cannot Add previous months' entries after nth day of month
                        if (transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries > 0 && iDocumentDate < iToday) {
                            if ((FDate.getMonthFromInt(iDocumentDate) < FDate.getMonthFromInt(iToday) || FDate.getYearFromInt(iDocumentDate) < FDate.getYearFromInt(iToday))
                                // && FDate.getDayFromInt(iDocumentDate) > transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries) {
                                && FDate.getDayFromInt(iToday) > transEntryGlobal.EntryModel.Rights.CannotAddPrevEntries) {
                                result.lValue = 0;
                                result.sValue = GlobalPref.getResourceValue("msgNoRightsBackDate");

                                break;
                            }
                        }

                        // Cannot Add Transaction that are more than n days old
                        if (transEntryInfo.isEditing == false
                            && transEntryGlobal.EntryModel.Rights.CantAddAfter > 0
                            && iDocumentDate < iToday
                            && FDate.getDateDiffInDays(iDocumentDate, iToday) > transEntryGlobal.EntryModel.Rights.CantAddAfter) {

                            result.lValue = 0;
                            result.sValue = GlobalPref.getResourceValue("msgNoRightsBackDate");

                            break;
                        }

                    }
                    break;
                case eVTFIELDID.FDF_MFGDATE:
                    result = EntryMainValidate.validateRowMFGDate(iRowCounter, value);
                    break;
                case eVTFIELDID.FDF_EXPDATE:
                    result = EntryMainValidate.validateRowEXPDate(iRowCounter, value);
                    break;
                default:
                    if (objMetaData.bMandatory == true && value == 0) {
                        result.lValue = 0;

                        if (iRowCounter > 0) {
                            result.sValue = "'" + sHeading + "' " + GlobalPref.getResourceValue("msgFieldValueCannotBeEmptyForRow") + " " + iRowCounter;
                        }
                        else {
                            result.sValue = "'" + sHeading + "' " + GlobalPref.getResourceValue("msgFieldValueCannotBeEmpty");
                        }
                    }

                    break;
            }
        }
        catch (err) {
            result.lValue = -1;
            result.sValue = err.message;
        }

        return (result);
    },

