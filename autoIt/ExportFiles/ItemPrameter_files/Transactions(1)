    getData: function() {
        let iRow = 0;
        let iDebitAc = 0;
        let iCreditAc = 0;
        let iType = 0;
        let obj = null;
        let objPaymentData = null;

        try {
            objPaymentData = {};
            objPaymentData.IntgType = -1;
            objPaymentData.Data = [];

            if(transEntryInfo.BankingIntegrationPref.ICICI > 0) {
                objPaymentData.IntgType = 0;
            }
            else if(transEntryInfo.BankingIntegrationPref.FluxPay > 0) {
                objPaymentData.IntgType = 1;
            }
            else {
                return(objPaymentData);
            }

            for(iRow = 1; iRow <= transEntryGrid.getTotalRows(); iRow++) {
                iDebitAc = EntryMainMemoryObject.getBookValue(iRow);
                if(DataType.lte(iDebitAc, 0) == true) {
                    continue;
                }

                iType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, iRow, "iAccountTypeId");
                if(DataType.neq(iType, eAccountTypes.Bank) == true) {
                    continue;
                }

                iCreditAc = EntryMainMemoryObject.getCodeValue(iRow);
                if(DataType.lte(iCreditAc, 0) == true) {
                    continue;
                }

                iType = transEntryFields.getMandatoryValue(transEntryFieldInfo.Code, iRow, "iAccountTypeId");
                if(DataType.neq(iType, eAccountTypes.Customer) == true 
                    && DataType.neq(iType, eAccountTypes.Vendor) == true 
                    && DataType.neq(iType, eAccountTypes.CustomerVendor) == true) {
                    continue;
                }

                obj = {};
                obj.DebitAcc = iDebitAc;
                obj.CreditAcc = iCreditAc;
                obj.CurrencyId = EntryMainMemoryObject.getCurrencyId(iRow);
                obj.dAmt = EntryMainMemoryObject.getAmountValue(iRow);
                obj.Date = EntryMain.m_objTrans.Header.Date;
                obj.sDesc = "";
                obj.TransId = transEntryFields.getTransactionId(iRow);

                objPaymentData.Data.push(obj);
            }
        }
        catch(err) {
            transEntryGlobal.showAlert("{EntryMainBankingIntegration.getData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(objPaymentData);
    }
