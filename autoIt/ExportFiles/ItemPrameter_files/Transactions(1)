    printVoucher: function (iHeaderId, bNew, option) {
        let iVoucherType = 0;
        let iExtraHours = 0;
        let iCurrentDate = 0;
        let iCurrentTime = 0;
        let iPermissibleDate = 0;
        let iPermissibleTime = 0;
        let obj = null;

        try {
            iVoucherType = transEntryInfo.VoucherType;

            if (iHeaderId < 1) {
                return;
            }

            if (bNew == false) {
                if (transEntryGlobal.EntryModel.Rights.CantPrintAfterValue > 0 && transEntryData.getPrintCount() == 0) {
                    if (transEntryGlobal.EntryModel.Rights.CantPrintAfterOption == 0) { // Hours
                        iExtraHours = transEntryGlobal.EntryModel.Rights.CantPrintAfterValue;
                    }
                    else if (transEntryGlobal.EntryModel.Rights.CantPrintAfterOption == 1) { // Days
                        iExtraHours = (transEntryGlobal.EntryModel.Rights.CantPrintAfterValue * 24);
                    }
                }
                else if (transEntryGlobal.EntryModel.Rights.CantRePrintAfterValue > 0 && transEntryData.getPrintCount() > 0) {
                    if (transEntryGlobal.EntryModel.Rights.CantRePrintAfterOption == 0) { // Hours
                        iExtraHours = transEntryGlobal.EntryModel.Rights.CantRePrintAfterValue;
                    }
                    else if (transEntryGlobal.EntryModel.Rights.CantRePrintAfterOption == 1) { // Days
                        iExtraHours = (transEntryGlobal.EntryModel.Rights.CantRePrintAfterValue * 24);
                    }
                }
            }

            if (iExtraHours > 0) {
                iCurrentDate = transEntryInfo.Today;
                iCurrentTime = FTime.getCurrentTime();

                iPermissibleDate = transEntryGlobal.EntryModel.Data.iModifiedDate;
                iPermissibleTime = transEntryGlobal.EntryModel.Data.iModifiedTime;

                obj = FTime.addSeconds(iPermissibleTime, iExtraHours * 60);
                if (obj.iDays > 0) {
                    iPermissibleDate = FDate.addDays(iPermissibleDate, obj.iDays, transEntryInfo.CalendarType);
                }
                iPermissibleTime = obj.iTime;

                if ((iCurrentDate > iPermissibleDate) ||
                    (iCurrentDate == iPermissibleDate && iCurrentTime > iPermissibleTime)) {
                    transEntryGlobal.showAlert("Print time ellapsed.", GlobalPref.getResourceValue("Error"));

                    return;
                }
            }

            PRINTVOUCHER.loadPopup(iVoucherType,
                                    [iHeaderId],
                                    Module.get("CORETRANSACTIONS"),
                                    EntryMainUI.getBodyOthersContainer(),
                                    true,
                                    "EntryMainCallback.printResult",
                                    option);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.printVoucher} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

