    getFilterValue: function (iFilterId, iSubFilterId) {

        FILTER.setContrlOrgParent(iFilterId, iSubFilterId);
        var sAdvanceFilterId = FILTER.getAdvanceFilterId(iFilterId, iSubFilterId);
        var sDefaultFilterId = FILTER.getDefaultFilterId(iFilterId, iSubFilterId);
        var iCounter = 0;
        var iCountDefaultValues = 0;
        var iComapareWith = 0;
        var iConjuction = 0;
        var iOperator = 0;
        var iDataType = 0;
        var iFieldId = 0;
        var sFieldName = "";
        var iSubParentId = 0;
        var sCompareText = "";
        var sCompareValue = "";
        var eleAdvance = null;
        var field = null;
        var arrFilter = [];
        var arrDefaultValues = [];

        //document.getElementById(sAdvanceFilterId).dataset.invalid = false;
        eleAdvance = document.getElementById(sAdvanceFilterId);
        var defaulFilter = document.getElementById(FILTER.getDefaultFilterId(iFilterId, iSubFilterId));
        if (COMMON.prototype.isValidObject(eleAdvance) == true) {
            if (COMMON.prototype.isNullOrEmpty(sDefaultFilterId) == false && document.getElementById(sDefaultFilterId) != null) {
                arrDefaultValues = FILTER.getDefaultFilterValues(iFilterId, iSubFilterId);
                FILTER.addAdvanceFilter(arrDefaultValues, iFilterId, iSubFilterId);
            }
            for (iCounter = 0; iCounter < eleAdvance.children.length; iCounter++) {

                bDataChanged = eleAdvance.children[iCounter].children[0].dataset.isdatachanged == "true" ? true : false;
                var ext = eleAdvance.children[iCounter].children[0].children[1].children[0].id.split("_")[3].substring('AdvanceFilter'.length);

                //if (eleAdvance.children[iCounter].className == "form-group col-xs-12") {
                iConjuction = parseInt(document.getElementById("filterConjuction_" + sAdvanceFilterId + '' + ext).value);

                if (arrFilter.length == 0 && iConjuction == -1)
                    iConjuction = 0;
                field = document.getElementById("filterFieldTxtbox_" + sAdvanceFilterId + ext);
                iOperator = parseInt(document.getElementById("filterOperator_" + sAdvanceFilterId + ext).value);
                iComapareWith = parseInt(document.getElementById("filterCompareWith_" + sAdvanceFilterId + ext).value);

                sCompareText = "";
                sCompareValue = "";
                sFieldName = $("#filterFieldTxtbox_" + sAdvanceFilterId + ext).val();
                iDataType = parseInt(field.dataset.fieldtype);
                iFieldId = parseInt(field.dataset.fieldid);
                iSubParentId = parseInt(field.dataset.subparent);

                switch (iComapareWith) {
                    case RD_CompareWith.get('VALUE'):
                        switch (iDataType) {
                            case MasterDataType.get('TEXT'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).value;
                                break;
                            case MasterDataType.get('NUMBER'):
                            case MasterDataType.get('FRACTION'):
                            case MasterDataType.get('BIGNUMBER'):
                            case MasterDataType.get('SMALLNUMBER'):
                            case MasterDataType.get('TINYNUMBER'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).value;
                                break;
                            case MasterDataType.get('BOOLEAN'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).children(0).children(0).checked;
                                break;
                            case MasterDataType.get('DATETIME'):
                            case MasterDataType.get('DATE'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).children[0].dataset.value;//DATEPICKER.getDate("dateValuesField_" + sAdvanceFilterId + iCounter);
                                break;
                            case MasterDataType.get('TIME'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).children[0].dataset.value;
                                break;
                            case MasterDataType.get('NUMBERLIST'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).value;
                                //sCompareText = document.getElementById("filterValue_" + iCounter).text;
                                break;
                            case MasterDataType.get('STRINGLIST'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).value;
                                //sCompareText = document.getElementById("filterValue_" + iCounter).text;
                                break;
                            case MasterDataType.get('MASTER'):
                            case MasterDataType.get('EXTERNALTABLE'):
                                sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).children[0].dataset.value;
                                sCompareText = document.getElementById("filterValue_" + sAdvanceFilterId + ext).children[0].value;
                                if (field.value == "Name") {
                                    iDataType = MasterDataType.get('NUMBER');
                                }
                                break;
                        }

                        break;
                    case RD_CompareWith.get('FORMULA'):
                        sCompareValue = document.getElementById("FilterFormulaContrl_" + sAdvanceFilterId + ext).value;
                        break;
                    case RD_CompareWith.get('FIELD'):
                        sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).value;
                        break;
                    case RD_CompareWith.get('DATERANGE'):
                        sCompareValue = document.getElementById("filterValue_" + sAdvanceFilterId + ext).dataset.id;
                        //sCompareValue = document.getElementById("filterValue_" + iCounter).value;
                        break;
                    default:
                        break;
                }

                if (iComapareWith != -1 && iConjuction != -1 && iOperator != -1 && sCompareValue != undefined && sCompareValue.length != 0 && iFieldId != NaN) {
                    arrFilter.push(
                        {
                            CompareText: sCompareText,
                            CompareValue: sCompareValue,
                            CompareWith: iComapareWith,
                            Conjuction: iConjuction,
                            DataType: iDataType,
                            FieldId: iFieldId,
                            IsGroup: false,
                            Operator: iOperator,
                            SubParentId: iSubParentId,
                            FieldName: sFieldName
                        });
                }
                else if (bDataChanged == true) {
                    document.getElementById(sAdvanceFilterId).dataset.invalid = true;
