            eleRow = transEntryWorkflowFragment.getRowElement(iRow);
            if (DataType.isValidObject(eleRow) == true) {
                FGRIDCONTROL.setSerialNo(eleRow.children[0], iSerialNo);
            }

            bSelected = false;

            objFixValue = transEntryWorkflow.Data.getHiddenData(iDataIndex + 1);
            if (DataType.isValidObject(objFixValue) == true) {
                bSelected = objFixValue.bSelected;
                if (bSelected == false) {
                    bSelected = objFixValue.bRetain;
                }

                cell = transEntryWorkflowFragment.getCellObject(iRow, 1);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCheckboxState(bSelected);
                }

                cell = transEntryWorkflowFragment.getCellObject(iRow, transEntryWorkflowInfo.HiddenTransIdColumn);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(objFixValue.lTransactionId, objFixValue.lTransactionId);
                }

                cell = transEntryWorkflowFragment.getCellObject(iRow, transEntryWorkflowInfo.HiddenPendingColumn);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(objFixValue.dPendingValue, objFixValue.dPendingValue);
                }

                cell = transEntryWorkflowFragment.getCellObject(iRow, transEntryWorkflowInfo.HiddenVoucherNoColumn);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(objFixValue.sVoucherNo, objFixValue.sVoucherNo);
                }

                cell = transEntryWorkflowFragment.getCellObject(iRow, transEntryWorkflowInfo.HiddenToleranceColumn);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(objFixValue.dTolerance, objFixValue.dTolerance);
                }

                if (FNumberOperation.isLessThanOrEqualTo(objFixValue.dPendingValue, 0) == true) {
                    WORKFLOW.deleteRow(transEntryWorkflowFragment.getRowElement(iRow));
                }
            }

            iHiddenValueColumns = 5; // checkbox, transactionid, pendingvalue, voucherno, tolerance

            iColumnValueIndex = transEntryWorkflowInfo.DisplayStartColIndex;
            for (iCounter = 0; iCounter < transEntryWorkflowInfo.Columns.length; iCounter++, iColumnValueIndex++) {
                cell = transEntryWorkflowFragment.getCellObject(iRow, (iHiddenValueColumns + iCounter + 1));
                if (DataType.isValidObject(cell) == false) {
                    continue;
                }

                objData = transEntryWorkflow.Data.getDisplayData(iDataIndex + 1, iColumnValueIndex, iCounter);
                if(DataType.isValidObject(objData) == false) {
                    continue;
                }

                switch (transEntryWorkflowInfo.Columns[iCounter].ID) {
                    case eMasterDataType.Date:
                        if (transEntryWorkflow.m_Workflow.bCustomizeColumns == true) {
                            cell.setCellText(objData, objData);
                        }
                        else {
                            cell.setCellText(FDate.intToString(objData, EntryMain.m_DateFormat, EntryMain.m_CalendarType, EntryMain.m_LanguageId), objData);
                        }
                        break;
                    case eMasterDataType.Fraction:
                        cell.setCellText(objData, objData);
                        break;
                    default:
                        cell.setCellText(objData, objData);
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryWorkflow.setRowData} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (bSelected);
    },

