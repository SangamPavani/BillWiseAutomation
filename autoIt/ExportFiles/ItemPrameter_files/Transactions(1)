    getAllUsedBatches: function (iInvTag) {
        let sBatchNo = "";
        let arrBatch = [];
        let iCounter = 0;
        let iValue = 0;
        let iTotal = 0;

        try {
            if (transEntryFieldInfo.BatchNo.ColumnIndex < 0) {
                return(arrBatch);
            }

            iTotal = transEntryGrid.getTotalRows();
            for (iCounter = 1; iCounter <= iTotal ; iCounter++) {
                if (transEntryGrid.isBatchInputRequired(iCounter) == false) {
                    continue;
                }

                sBatchNo = transEntryBatch.getBatchNo(iCounter);
                if(DataType.isNullOrEmpty(sBatchNo, true) == true) {
                    continue;
                }

                iValue = transEntryGrid.getMasterValue(iCounter, transEntryInfo.InvTag);
                if (transEntryInfo.BatchPref.bDontAcceptDuplicatebatchInInwardDocuments == true) {
                    iValue = 0;
                }

                if (iValue == iInvTag) {
                    arrBatch.push(sBatchNo);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryGrid.getAllUsedBatches} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrBatch);
    },

