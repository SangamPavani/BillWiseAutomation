                var arrdata = sTextData.split(',');
                var iRowCount = RMA_MainScreen.GetEmptyRowinGrid();
                var GridRows = FGRIDCONTROL.getTotalRows(sGridId)
                if (GridRows > 0) {
                    var tbody = document.getElementById(sGridId).children[1]
                    if (tbody.children.length != null) {
                        iGridLength = tbody.children.length
                        for (var iGridRow = 0; iGridRow < iGridLength; iGridRow++) {
                            var td = tbody.children[iGridRow].children;
                            for (var i = 0; i < arrdata.length; i++) {
                                if (td[1].innerText.trim() == arrdata[i]) {
                                    barrResult.splice(i, 1);
                                    arrdata.splice(i, 1);
                                    break;
                                }
                            }
                        }

