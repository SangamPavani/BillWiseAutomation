                let Cr = 0;
                let dOrig1 = 0;
                let dOrig2 = 0;

                for (iRow = 0; iRow < objTransaction.BodyData.length; iRow++)
                {
                    dOrig1 = objTransaction.BodyData[iRow].OriginalAmounts[0];
                    dOrig2 = objTransaction.BodyData[iRow].OriginalAmounts[1];

