    AssignBatchReservedValue: function (newReservationModel, oldReservationModel, SelectedIndex) {
        try {
            for (var iIndex = 0; iIndex < newReservationModel.length; iIndex++) {
                if (newReservationModel[iIndex].ReserveType == 3 && newReservationModel[iIndex].ReserveByBatch == true && newReservationModel[iIndex].ReserveByBin == false && newReservationModel[iIndex].ReserveByRMA == false && newReservationModel[iIndex].ProductId == oldReservationModel[SelectedIndex].ProductId) {
                    for (var j = 0; j < newReservationModel[iIndex].BatchList.length; j++) {
                        //if (oldReservationModel[iIndex].ToString() != "Focus.Transactions.DataStructs.Reservations") {
                        if (oldReservationModel[iIndex].BatchList != null && oldReservationModel[iIndex].BatchList != undefined) {
                            var isTrue = false;
                            var count = 0;
                            for (var ij = 0; ij < oldReservationModel[iIndex].BatchList.length; ij++) {
                                var p = oldReservationModel[iIndex].BatchList[ij];
                                if (p.InvTagId == (newReservationModel[iIndex]).BatchList[j].InvTagId && p.FullFillTransId == (newReservationModel[iIndex]).BatchList[j].FullFillTransId && p.DocumentId == (newReservationModel[iIndex]).BatchList[j].DocumentId) {
                                    isTrue = true;
                                    count++;
                                }
                            }
                            if (isTrue && count > 0) {
                                var bLST = [];
                                for (var ijk = 0; ijk < oldReservationModel[iIndex].BatchList.length; ijk++) {
                                    var p = oldReservationModel[iIndex].BatchList[ijk];
                                    if (p.InvTagId == (newReservationModel[iIndex]).BatchList[j].InvTagId && p.FullFillTransId == (newReservationModel[iIndex]).BatchList[j].FullFillTransId && p.DocumentId == (newReservationModel[iIndex]).BatchList[j].DocumentId) {
                                        bLST.push(p);
                                    }
                                }
                                if (bLST.length > 0) {
                                    (newReservationModel[iIndex]).BatchList[j].ReserveQty = bLST[0].ReserveQty;
                                    (newReservationModel[iIndex]).BatchList[j].ReleasedQty = bLST[0].ReleasedQty;
                                }
                            }
                        }
                        //}
                    }
                }
            }
            var arrBRDetails = new Array((newReservationModel[SelectedIndex]).BatchList.length);
            for (var iCount = 0; iCount < arrBRDetails.length; iCount++) {
                arrBRDetails[iCount] = new Array();
                arrBRDetails[iCount].ActualAvailableQty = (newReservationModel[SelectedIndex]).BatchList[iCount].ActualAvailableQty;
                arrBRDetails[iCount].AvailableForReserveQty = (newReservationModel[SelectedIndex]).BatchList[iCount].AvailableForReserveQty;
