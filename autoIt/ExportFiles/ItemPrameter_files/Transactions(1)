    isFieldInRuleFormatting: function (arrRules, iFieldId, bClubRule) {
        let iCounterRules = 0;
        let iCounterTwo = 0;
        let iCounterThree = 0;
        let iTotal = 0;
        let arrResult = [];
        let obj = undefined;

        try {
            iTotal = DataType.arrayLength(arrRules);
            for (iCounterRules = 0; iCounterRules < iTotal; iCounterRules++) {
                objRules = arrRules[iCounterRules];
                if (objRules.IsRuleActive == false) {
                    continue;
                }

                if (objRules.RuleBody.length == 1 && objRules.RuleBody[0].RuleCondition.length == 0) { // No Condition
                    for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody[0].RuleFormatting.length; iCounterTwo++) {
                        if (objRules.RuleBody[0].RuleFormatting[iCounterTwo].FieldId == iFieldId) {
                            obj = {};
                            obj.RuleIndex = iCounterRules;
                            obj.BodyIndex = 0;
                            obj.FormattingIndex = iCounterTwo;
                            obj.iDataTypeId = objRules.RuleBody[0].RuleFormatting[iCounterTwo].DataTypeId;
                            obj.bEnter = false;
                            obj.bLeave = false;
                            obj.bEdit = objRules.Edit;
                            obj.bNewRecord = objRules.NewRecord;

                            arrResult.push(obj);
                        }
                    }

                    continue;
                }

                for (iCounterTwo = 0; iCounterTwo < objRules.RuleBody.length; iCounterTwo++) {
                    // Last index of RuleBody is for else

                    bFlag = false;
                    objRuleBody = objRules.RuleBody[iCounterTwo];
                    for (iCounterThree = 0; iCounterThree < objRuleBody.RuleFormatting.length; iCounterThree++) {
                        if (objRuleBody.RuleFormatting[iCounterThree].FieldId == iFieldId) {
                            obj = {};
                            obj.RuleIndex = iCounterRules;
                            obj.BodyIndex = iCounterTwo;
                            obj.FormattingIndex = iCounterThree;
                            obj.iDataTypeId = objRuleBody.RuleFormatting[iCounterThree].DataTypeId;
                            obj.bEnter = objRules.onEnter;
                            obj.bLeave = objRules.onLeave;
                            obj.bEdit = objRules.Edit;
                            obj.bNewRecord = objRules.NewRecord;

                            arrResult.push(obj);

                            bFlag = true;
                            if (bClubRule == true) {
                                break;
                            }
                        }
                    }

                    if (bClubRule == true && bFlag == true) {
                        break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.isFieldInRuleFormatting} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrResult);
    },

