    getFieldDataPosition: function() {
        let iCounter = 0;
        let objFieldInfo = null;
        let obj = null;

        try {
            obj = {};
            obj.HeaderId = -1;
            obj.TransactionId = -1;
            obj.BodyId = -1;
            obj.Item = -1;
            obj.Quantity = -1;
            obj.Rate = -1;
            obj.Gross = -1;
            obj.arrMastersIndex = [];

            for (iCounter = 0; iCounter < CopyDocUI.m_objReturnData.arrFieldInfo.length; iCounter++) {
                objFieldInfo = CopyDocUI.m_objReturnData.arrFieldInfo[iCounter];
                if (objFieldInfo === eTranEntryBodyDataConstKey.BodyId) {
                    obj.BodyId = iCounter;
                    continue;
                }
                else if (objFieldInfo === eTranEntryBodyDataConstKey.TransactionId) {
                    obj.TransactionId = iCounter;
                    continue;
                }
                else if (objFieldInfo === "HeaderId") {
                    obj.HeaderId = iCounter;
                    continue;
                }

                if (objFieldInfo.bBody == false) {
                    continue;
                }


                if(objFieldInfo.sFieldName == "Quantity") {
                    obj.Quantity = iCounter;
                }
                else if(objFieldInfo.sFieldName == "Rate") {
                    obj.Rate = iCounter;
                }
                else if(objFieldInfo.sFieldName == "Gross") {
                    obj.Gross = iCounter;
                }

                if (objFieldInfo.bHidden == true) { // Hidden field heading is not created, so data will also not be set.
                    continue;
                }


                switch (objFieldInfo.sFieldName) {
                    case "Product":
                    case "Item":
                        obj.Item = iCounter;
                        obj.arrMastersIndex.push(iCounter);
                        break;
                    case "Quantity":
                    case "Rate":
                    case "Gross":
                        break;
                    default:
                        if (objFieldInfo.iDataTypeId == eMasterDataType.Master) {
                            obj.arrMastersIndex.push(iCounter);
                        }
                        break;
                }
            }
        }
        catch(err) {
            transEntryGlobal.writeErrorLog("Exception: {CopyDocUI.getFieldDataPosition} "  + err.message);
        }

        return (obj);
    },

