                                }
                            }
                            else {
                                ServiceCharges.ServiceFilter(cellobj.iRow);
                                if (isInward) {
                                    OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "a.iProductType = 1 and a.iServicetype = 1 AND a.iMasterId NOT IN(" + DataType.arrayToCSV(ExcludeServiceIds, ",") + ")");
                                } else {
                                    OPTIONCONTROL.setFilter(cellobj.ColumnAttribute.ctrlid, "a.iProductType = 1 and a.iServicetype = 2 AND a.iMasterId NOT IN(" + DataType.arrayToCSV(ExcludeServiceIds, ",") + ")");
                                }
