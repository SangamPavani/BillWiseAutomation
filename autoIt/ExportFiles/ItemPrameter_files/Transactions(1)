    onFreeItem_Ok: function () {
        let iRow = 0;
        let dQty = 0;
        let iType = 0;
        let dSum = 0;
        let arrFreeQty = null;
        let elePopup = null;
        let cell = null;

        try {
            elePopup = EntryMainScheme.getPopupElement();
            dQty = DataType.toDecimal(elePopup.getAttribute("data-qty"));
            iType = DataType.toInt(elePopup.getAttribute("data-type"));

            FGRIDCONTROL.update(EntryMainScheme.getFreeItemGridId());

            if (iType == 2) { // All
                for (iRow = 1; iRow <= FGRIDCONTROL.getTotalRows(EntryMainScheme.getFreeItemGridId()); iRow++) {
                    cell = FGRIDCONTROL.getCellObject(EntryMainScheme.getFreeItemGridId(), iRow, 1);
                    if (DataType.isValidObject(cell)) {
                        if (cell.getCheckboxState() == false) {
                            transEntryGlobal.showAlert("All items from the list must be selected.", "Error");

                            return;
                        }
                        else {
                            cell = FGRIDCONTROL.getCellObject(EntryMainScheme.getFreeItemGridId(), iRow, 3);
                            if (DataType.isValidObject(cell) == true && DataType.toDecimal(cell.getCellData()) <= 0) {
                                transEntryGlobal.showAlert("All items must have quantity.", "Error");

                                return;
                            }
                        }
                    }
                }
            }

            arrFreeQty = [];
            dSum = 0;
            for (iRow = 1; iRow <= FGRIDCONTROL.getTotalRows(EntryMainScheme.getFreeItemGridId()); iRow++) {
                cell = FGRIDCONTROL.getCellObject(EntryMainScheme.getFreeItemGridId(), iRow, 3);
                if (DataType.isValidObject(cell)) {
                    arrFreeQty.push(DataType.toDecimal(cell.getCellData()));
                    dSum = DataType.add(dSum, DataType.toDecimal(cell.getCellData()));
                }
            }

            if (DataType.neq(dSum, dQty) == true) {
                transEntryGlobal.showAlert("Total free items should be " + dQty, "Error");

                return;
            }

            EntryMainScheme.closePopup();

            EntryMainScheme.onFreeItems(arrFreeQty, EntryMainScheme.m_iRow);
            EntryMainScheme.updateUIData(EntryMainScheme.m_iRow);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainScheme.onFreeItem_Ok} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onFreeItems: function (arrFreeQty, iRow) {
        let iCounter = 0;
        let iIndex = 0;
        let iOldCount = 0;
        let lstBody = null;
        let objBody = null;
        let objIdNamePair = null;
        let objMetaData = null;

        try {
            lstBody = DataType.arrayFilterData(EntryMainScheme.m_objTrans.BodyData,
                ["RowType"],
                [_RowType.Default], "===");

            iOldCount = lstBody.length;
            for (iCounter = EntryMainScheme.m_arrItems.length - 1; iCounter >= 0; iCounter--) {
                if (arrFreeQty[iCounter] == 0) {
                    continue;
                }

                objBody = transactionDataStructure.createNewTransBodyObject(EntryMainScheme.m_objTrans.BodyData[iRow - 1]);

                objBody.BodyId = 0;
                objBody.TransactionId = 0;
                objBody.Links = null;
                objBody.Sales.BatchNo = null;
                objBody.Sales.BinsData = null;
                objBody.Sales.RMANos = null;
                objBody.Sales.Product = EntryMainScheme.m_arrTemp2[iCounter].ProductId;
                objBody.Sales.Quantity = DataType.toDecimal(-arrFreeQty[iCounter]);
                objBody.Sales.Unit = EntryMainScheme.m_arrTemp2[0].Unit;
                objBody.Sales.OrigRate = objBody.Sales.Rate = 0;
                objBody.Sales.OrigGross = objBody.Sales.Gross = 0;
                objBody.Sales.SchemeId = EntryMainScheme.m_arrTemp2[iCounter].SchemeId;
                objBody.Sales.SchemeSource = EntryMainScheme.m_arrTemp2[iCounter].FromScreen;
                objBody.Sales.SchemeBodyId = EntryMainScheme.m_arrTemp2[iCounter].BodyId;


                objBody.BodyExtra = null;

                EntryMainScheme.m_arrTemp2[iCounter].FreeQty = DataType.toDecimal(arrFreeQty[iCounter]);
                ERPSCHEMEIMPLEMENTATION.VARIABLES.ExistingFreePrompts.push(EntryMainScheme.m_arrTemp2[iCounter]);
                objBody.Sales.Unit = EntryMainScheme.m_arrTemp2[iCounter].Unit;
                objBody.Flags.FreeQty = true;
                lstBody.push(objBody);

                for (iIndex = 0; iIndex < EntryMainScheme.m_arrFreeRows.length; iIndex++) {
                    if (EntryMainScheme.m_arrFreeRows[iIndex].ID == lstBody.length - 1) {
                        EntryMainScheme.m_arrFreeRows.splice(iIndex, 1);
                        iIndex--;
                    }
                }

                objIdNamePair = FocusDataStructs.getIdNamePairObject();
                objIdNamePair.ID = lstBody.length - 1;
                objIdNamePair.Name = DataType.toString(EntryMainScheme.m_arrTemp2[iCounter].SchemeId);
                objIdNamePair.Tag = [];
                objIdNamePair.Tag.push(EntryMainScheme.m_arrTemp2[iCounter].FromScreen);
                objIdNamePair.Tag.push(EntryMainScheme.m_arrTemp2[iCounter].BodyId);

                EntryMainScheme.m_arrFreeRows.push(objIdNamePair);
            }
            EntryMainScheme.m_objTrans.BodyData = lstBody;

            for (iCounter = EntryMainScheme.m_arrItems.length - 1, iIndex = 0; iCounter >= 0; iCounter--) {
                if (arrFreeQty[iCounter] == 0) {
                    continue;
                }

                if (transEntryFieldInfo.Scheme.ColumnIndex != -1) {
                    objMetaData = transEntryFieldInfo.Scheme.MetaData;

                    objIdNamePair = FocusDataStructs.getIdNamePairObject();
                    objIdNamePair.ID = objMetaData.iFieldId;
                    objIdNamePair.Name = objMetaData.sFieldName;
                    objIdNamePair.Tag = EntryMainScheme.m_arrTemp2[iCounter].SchemeName;

                    EntryMainScheme.m_objTrans.BodyData[iOldCount + iIndex++].BodyExtra = [];
                    EntryMainScheme.m_objTrans.BodyData[iOldCount + iIndex++].BodyExtra.push(objIdNamePair);
                }
