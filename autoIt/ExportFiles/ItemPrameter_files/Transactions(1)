                        g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[index].mAAdIDBaseCurrency = mAmount;
                        cell.setCellText(mAmount, mAmount);
                        break;
                    case "mAAdIDInvoiceCurrency":
                        cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), obj.iRow, obj.iColumn);
                        mAmount = FNumberOperation.toFixed(FConvert.roundOff(mAmount, g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[index].dGeneralRoundOff, g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[index].iRoundingType), g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[index].iNoOfDecimals);
