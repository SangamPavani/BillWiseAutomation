                return (0);
            }

            arrRate = DataType.arrayFilterData(arrTaxRates, ["Jurisdiction", "Place", "Perc"], [iJurisdictionId, iPlaceOfSupplyId, 0], ["===", "===", ">"]);
            if (arrRate.length > 0) {
