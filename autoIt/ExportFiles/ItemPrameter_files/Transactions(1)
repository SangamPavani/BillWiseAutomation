    onDateControl_Focus: function (objMetaData) {
        let sCtrlId = "";
        let sFormula = "";
        let iDate = 0;
        let bRefresh = false;        
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;

        try {
            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

            if (DataType.stringIncludes(objMetaData.sDefaultValue, "#") == true) {
                bRefresh = DataType.stringStartsWith(objMetaData.sDefaultValue, "&");
                sFormula = objMetaData.sDefaultValue.substr(bRefresh == true ? 2 : 1);

                objFormulaInput = EntryMainFormula.createBodyFormulaInput(sFormula, -1, null, -1, objMetaData.sFieldName);
                objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);
                iDate = DataType.toInt(objFormulaOutput.Value);
                DATEPICKER.setDate(sCtrlId, iDate);
            }

            DATEPICKER.setFocusValue(sCtrlId, DATEPICKER.getDate(sCtrlId));
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onDateControl_Focus} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onLeave_DocumentNo: function (id, data, tag) {
        let obj = null;
        let iNewId = 0;
        let sOldText = "";

        try {
            EntryMain.m_DocDate = EntryMain.m_objTrans.Header.Date;

            if (DataType.isValidObject(data) == false || data.length == 0) {
                if(transEntryGlobal.m_bSetDefault == false) {
                    EntryMainHeader.setHeaderFieldsDefaultValue(false, false, false);
                    if (DataType.arrayLength(transEntryInfo.Settings.VoucherSeries) > 0) {
                        EntryMainHeader.setNewVoucherNo(true, 0);
                    }
                }

                return;
            }
            else {
                iNewId = DataType.getObjectFirstValue(data[0]);
                if (DataType.isNullOrEmpty(iNewId) == true || isNaN(iNewId) == true) {
                    iNewId = 0;
                }
                else {
                    iNewId = parseInt(iNewId);
                }

                obj = EntryMainHeader.getLoadedDocumentNo();
                if (DataType.isValidObject(obj) == false  // No previously loaded voucher
                    || iNewId != obj.HeaderId) { // Current headrid not match with last one

                    sOldText = OPTIONCONTROL.getControlText(id);
                    if (iNewId > 0) { // Load Voucher
                        transEntryGlobal.clear(false, false);
                        result = transEntryServer.loadVoucherById(iNewId,
                                                                    eLoadTransactionBy.HeaderId,
                                                                    transEntryInfo.VoucherType,
                                                                    transEntryInfo.ViewId,
                                                                    true, 
                                                                    null, 
                                                                    eTranEntryLoadSource.None);
                    }
                    else {
                        if(sOldText != sOldText.trim()) {
                            sOldText = sOldText.trim();
                            OPTIONCONTROL.setControlText(id, sOldText);
                        }

                        if (OPTIONCONTROL.focusText(id) != sOldText) {
                            EntryMain.setEditMode(false);
                            EntryMainUI.resetScreen(false, true, false, false, false);                            
                            OPTIONCONTROL.setControlText(id, sOldText);
                            EntryMainRules.applyNew();
                        }

                        if(transEntryGlobal.m_bSetDefault == false) {
                            EntryMainHeader.setHeaderFieldsDefaultValue(false, false, false);
                            if (DataType.arrayLength(transEntryInfo.Settings.VoucherSeries) > 0) {
                                EntryMainHeader.setNewVoucherNo(true, 0);
                            }
                        }
                    }
                }
                else if(DataType.isValidObject(obj) == true && iNewId == 0 && iNewId == obj.HeaderId){
                    sOldText = OPTIONCONTROL.getControlText(id);
                    if(sOldText != sOldText.trim()) {
                        sOldText = sOldText.trim();
                        OPTIONCONTROL.setControlText(id, sOldText);
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onLeave_DocumentNo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

