                    bResult = false;
                }
            }
            else {
                if (FConvert.toDecimal(_objAdj.tbNewRefAmountAdjValueTranCurr) > _objAdj.m_NewRefTransCurr) {
                    COMMON.prototype.showMessage("Total adjustment amount cannot be less than already adjustment amount");
                    _objAdj.m_NewRefTransCurr = FConvert.toDecimal(_objAdj.tbNewRefAmountAdjValueTranCurr);
                    _objAdj.m_NewRef = _objAdj.m_NewRefTransCurr * _objAdj.m_objBillFilter.dRate;
                    AdjustBills_Screen.UI.SetNewRefAmt(FConvert.toDecimal(_objAdj.m_NewRefTransCurr, _objAdj.m_arrBreakupByTag[0].iNoOfDecimals));
                    bResult = false;
                }
            }
            var TotalRows = FGRIDCONTROL.getTotalRows(AdjustBills_Screen.UI.getAdjustmentGridElement());
            var AdjustedAmt = 0;
            for (i = 1; i <= TotalRows; i++) {
                AdjustedAmt = AdjustedAmt + g_Adjustment.arrAdjustBills[g_Index].objAdjustmentDetails.m_lstPendingBills[i - 1].mAAIDBaseCurrency;
                //var cell;
                //cell = FGRIDCONTROL.getCellObject(AdjustBills_Screen.UI.getAdjustmentGridElement(), i, AdjCol.get("mAAIDBaseCurrency"));
                //AdjustedAmt = AdjustedAmt + FConvert.toDecimal(cell.getCellData());
            }
            if (_objAdj.dAmtToBeAdjInBaseCurr != 0) {
                if ((_objAdj.dAmtToBeAdjInBaseCurr - (AdjustedAmt + _objAdj.m_OnAccount + _objAdj.m_NewRef)) < 0) {
