    processBatch: function (element, iRow, iColumn) {
        let iValue = 0;
        let bIssue = false;
        let objTemp = null;
        let data = null;
        let sBatch = null;

        try {
            if (transEntryInfo.isStockRevaluation == true) {
                return(false);
            }

            if (transEntryFields.isRequired(eVTFIELDID.FDF_BODYBATCHNO, iRow) == false) {
                element.value = "";

                return (false);
            }

            if ((transEntryInfo.VoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE
                && EntryMainMemoryObject.getRctIssueValue(iRow) == 0) { // Issue Row

                bIssue = true;
            }

            if (transEntryInfo.isInwardVoucher == true && bIssue == false) {
                if (transEntryBatch.isSuggestionRequired(iRow) == true
                    && FCommon.String.isNullOrEmpty(element.value, true) == true) {
                    iValue = transEntryGrid.getMasterValue(iRow, transEntryInfo.InvTag);

                    if (transEntryGlobal.EntryModel.arrBatchSeries != null && transEntryGlobal.EntryModel.arrBatchSeries.length > 0) {
                        //EntryMainBatch.generateBatchFromSeries(cellobj);
                    }
                    else {
                        if (transEntryInfo.BatchPref.bDontAcceptDuplicatebatchInInwardDocuments == true) {
                            iValue = 0;
                        }

                        objTemp = transEntryGrid.getAllUsedBatches(iValue);
                        if (objTemp.length == 0) {
                            objTemp = {};
                            objTemp.ctrlid = element.id;
                            objTemp.iInvTag = iValue;

                            data = {};
                            data.iVoucherType = transEntryInfo.VoucherType;
                            data.iInvTag = iValue;

                            transEntryServer.execute(eTransServerRequest.GetLastBatchUsed,
                                                        data,
                                                        true,
                                                        "EntryMainCallback.getLastUsedBatch",
                                                        objTemp);
                        }
                        else {
                            sBatch = objTemp[objTemp.length - 1];
                            do {
                                sBatch = FConvert.getNextNo(sBatch);
                                if (DataType.arrayContains(objTemp, sBatch, null, true) == -1) {
                                    break;
                                }
                            } while (true);

                            if (DataType.isValidObject(element) == true) {
                                element.value = sBatch;
                            }
                        }
                    }
                }
            }
            else {
                // Open batch popup when no batch is selected or batch column is clicked
                if (FCommon.String.isNullOrEmpty(element.value, true) == true) {
                    TRANSACTION_ENTRY.BATCH.initRowBatchControl(iRow, iColumn, element.id, false);
                    if (TRANSACTION_ENTRY.m_bBatchPopup == false) {
                        element.value = "";
                    }
                }

                return (false);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{transEntryDetailPopup.processBatch}" + err.message, "Exception");
        }

        return (true);
    },

    moveControl: function (bToPopup) {
        let iCounter = 0;
        let arrFields = undefined;
        let objMetaData = null;
        let eleContainer = null;
        let eleGridContainer = null;
        let ele = null;

        try {
            bToPopup = FConvert.toBoolean(bToPopup);

            arrFields = transEntryFieldInfo.getBodyFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;

                eleGridContainer = transEntryGrid.getControlContainer(iCounter + transEntryGrid.gridExtraColumn());
                if (DataType.isValidObject(eleGridContainer) == false) {
                    return;
                }

                eleContainer = document.getElementById("id_transaction_entry_detail_controlcontainer" + iCounter);
                if (DataType.isValidObject(eleContainer) == false) {
                    continue;
                }

                if (bToPopup == true) {
                    FUIElement.removeChild(eleContainer);

                    if (objMetaData.iDataTypeId == eMasterDataType.Boolean) {
                        ele = document.createElement("input");
                        ele.type = "checkbox";
                        ele.setAttribute("onblur", "transEntryDetailPopup.onLeave(this, event);");
                        ele.id = EntryMainUI.getBodyControlId(objMetaData.iFieldId) + "bool";

                        eleContainer.appendChild(ele);
                    }
                    else {
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_REFERENCE) {
                            ele = document.createElement("input");
                            ele.type = "text";
                            ele.readOnly = true;
                            ele.className = "form-control";
                            ele.setAttribute("onfocus", "transEntryDetailPopup.onFocus(this, event);");
                            ele.setAttribute("onblur", "transEntryDetailPopup.onLeave(this, event);");
                            ele.id = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                            eleContainer.appendChild(ele);
                            continue;
                        }

                        if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO && transEntryInfo.isInwardVoucher == false) {
                            ele = document.createElement("input");
                            ele.type = "text";
                            ele.readOnly = true;
                            ele.className = "form-control";
                            ele.setAttribute("onfocus", "transEntryDetailPopup.onFocus(this, event);");
                            ele.setAttribute("onblur", "transEntryDetailPopup.onLeave(this, event);");
                            ele.id = EntryMainUI.getBodyControlId(objMetaData.iFieldId);

                            eleContainer.appendChild(ele);
                            continue;
                        }

                        if (eleGridContainer.children.length == 0) {
                            continue;
                        }

                        if (EntryMainMaster.isInfoField(objMetaData.iFieldId, false) == true) {
                            eleGridContainer.children[0].disabled = true;
                        }

                        this.updateClass(bToPopup, objMetaData.iDataTypeId, objMetaData.iFieldId, iCounter);

                        eleContainer.appendChild(eleGridContainer.children[0]);
                    }
                }
                else {
                    if (objMetaData.iDataTypeId == eMasterDataType.Boolean) {
                        continue;
                    }
                    else if (objMetaData.iFieldId == eVTFIELDID.FDF_BODYBATCHNO && transEntryInfo.isInwardVoucher == false) {
                        continue;
                    }

                    if (eleContainer.children.length == 0) {
                        continue;
                }

                    this.updateClass(bToPopup, objMetaData.iDataTypeId, objMetaData.iFieldId, iCounter);

                    eleGridContainer.appendChild(eleContainer.children[0]);
                }
            }

            if (bToPopup == false) {
                this.m_bVisible = false;
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryDetailPopup.moveControl} " + err.message);
        }
    },

