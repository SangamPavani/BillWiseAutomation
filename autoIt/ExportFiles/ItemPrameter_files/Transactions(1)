const EntryMainBins = {
    optionControlBinsInput: function() {
        let iRow = 0;
        let iColumn = 0;
        let objData = null;
        let objOutput = null;

        try {
            iRow = transEntryGrid.getCurrentRow();
            iColumn = transEntryGrid.getCurrentColumn() - transEntryGrid.gridExtraColumn();

            if (transEntryGrid.isValidRow(iRow) == true) {
                objOutput = {};
                objData = EntryMainBins.getBinsInput(iRow, iColumn, false, objOutput);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.optionControlBinsInput} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (objData);
    },

    optionControlBins2Input: function () {
        let iRow = 0;
        let iColumn = 0;
        let objData = null;

        try {
            iRow = transEntryGrid.getCurrentRow();
            iColumn = transEntryGrid.getCurrentColumn() - transEntryGrid.gridExtraColumn();

            if (transEntryGrid.isValidRow(iRow) == true) {
                objData = EntryMainBins.getBins2Input(iRow, iColumn, false);
            }
        }
        catch (err) {
