    CheckAdjustments: function (obj) {
        try {
            var AdjustedAmt = 0;
            var InstAmt = 0;
            var i = 0;
            for (i = 0; i < obj.m_lstPendingBills.length; i++) {
                if (obj.bMaintainInInvoiceCurrency == false) {
                    AdjustedAmt = DataType.toDecimal(FNumberOperation.add(AdjustedAmt, obj.m_lstPendingBills[i].mAAIDBaseCurrency), obj.m_DefaultCurrency.NoofDecimals);
                }
                else {
                    AdjustedAmt = DataType.toDecimal(FNumberOperation.add(AdjustedAmt, obj.m_lstPendingBills[i].mNativeCurrency), obj.m_TransactionCurrency.NoofDecimals);
                }
            }
            if (obj.m_objReferenceType == 2) {
                if (obj.m_arrInstallments != null) {
                    for (i = 0; i < obj.m_arrInstallments.length; i++) {
                        if (obj.m_arrInstallments[i].dDueDate < g_Adjustment.InvoiceDate) {
                            COMMON.prototype.showMessage("Installment date cannot be less than voucher date");
                            return false;
                        }
                        if (i > 0 && obj.m_arrInstallments[i - 1].dDueDate > obj.m_arrInstallments[i].dDueDate) {
                            COMMON.prototype.showMessage("Installment date should be greater than previous installment date");
                            return false;
                        }
                        if (obj.bMaintainInInvoiceCurrency == false) {
                            InstAmt = DataType.toDecimal(FNumberOperation.add(InstAmt, obj.m_arrInstallments[i].mBATDBaseCurrency), obj.m_DefaultCurrency.NoofDecimals);
                        }
                        else {
                            InstAmt = DataType.toDecimal(FNumberOperation.add(InstAmt, obj.m_arrInstallments[i].mBATDBillCurrency), obj.m_TransactionCurrency.NoofDecimals);
                        }
                    }
                }
            }
            if (obj.bMaintainInInvoiceCurrency == false) {
                if (obj.tbNewRefAmountAdjValue == null) {
                    obj.tbNewRefAmountAdjValue = 0;
                }
                if (FNumberOperation.isGreaterThan(obj.dAmtToBeAdjInBaseCurr, 0)) {
                    if (FNumberOperation.isLessThan(FNumberOperation.sub(obj.dAmtToBeAdjInBaseCurr, (FNumberOperation.sub(FNumberOperation.sub(AdjustedAmt, obj.m_NewRef), obj.m_OnAccount))), 0)) {
                        COMMON.prototype.showMessage("Total Adjustment Amount cannot be greater than Available Adjustment Amount");
                        return false;
                    }
                }
                if (obj.m_objReferenceType == 2) {
                    if (FNumberOperation.isNotEqualTo(DataType.toDecimal(obj.m_NewRef), DataType.toDecimal(InstAmt))) {
                        COMMON.prototype.showMessage("Total Installments Amount cannot be different from New Reference Amount");
                        return false;
                    }
                }
            }
            else {
                if (obj.tbNewRefAmountAdjValueTranCurr == null) {
                    obj.tbNewRefAmountAdjValueTranCurr = 0;
                }
                if (FNumberOperation.isGreaterThan(obj.m_dTransactionCurrencyAmount, 0)) {
                    if (FNumberOperation.isLessThan(FNumberOperation.sub(obj.m_dTransactionCurrencyAmount, FNumberOperation.sub(FNumberOperation.sub(AdjustedAmt, obj.m_NewRefTransCurr), obj.m_OnAccountTransCurr)), 0)) {
