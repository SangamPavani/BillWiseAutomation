    extractVariableName: function (sValue, bDirectMatch) {
        let sVariable = "";
        let sOrigInput = "";
        let iCounter = 0;
        let bRefresh = false;
        let arrRateVariables = null;
        let arrVariables = null;
        let objFormula = null;
        let obj = null;

        try {
            arrRateVariables = [];
            if (DataType.isNullOrEmpty(sValue, true) == true) {
                return (arrRateVariables);
            }

            sOrigInput = sValue;


            if (DataType.toBoolean(bDirectMatch) == true) {
                arrVariables = [];
                arrVariables.push(sValue);
            }
            else {
                sValue = DataType.stringRemoveSpace(sValue);
                if (DataType.stringStartsWithRaw(sValue, "#") == true) {
                    sValue = sValue.substr(1);
                }

                bRefresh = false;
                if (DataType.stringStartsWithRaw(sValue, "&") == true) {
                    bRefresh = true;
                    sValue = sValue.substr(1);
                }


                objFormula = new FFormula();
                objFormula.m_CalType = transEntryInfo.CalendarType;
                arrVariables = objFormula.GetVariables(sValue, true);
            }

            for (iCounter = 0; iCounter < arrVariables.length; iCounter++) {
                sVariable = DataType.stringRemoveSpace(sVariable);
                sVariable = arrVariables[iCounter].toLowerCase();

                if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                    sVariable = sVariable.substr(1);
                }

                obj = {};

                obj.sAbbr = "";
                obj.bRefresh = bRefresh;
                if (DataType.stringStartsWithRaw(sVariable, "&") == true) {
                    obj.bRefresh = true;
                    sVariable = sVariable.substr(1);
                }

                if (DataType.stringStartsWithRaw(sVariable, "#") == true) {
                    sVariable = sVariable.substr(1);
                }


                if (DataType.stringIncludesRaw(sVariable, "purrtgrp") == true) {
                    obj.sPrefix = "purrtgrp";
                    obj.bPurchase = true;
                    sVariable = sVariable.substr(8);
                }
                else if (DataType.stringIncludesRaw(sVariable, "salrtgrp") == true) {
                    obj.sPrefix = "salrtgrp";
                    obj.bPurchase = false;
                    sVariable = sVariable.substr(8);
                }
                else if (DataType.stringIncludesRaw(sVariable, "purrt") == true) {
                    obj.sPrefix = "purrt";
                    obj.bPurchase = true;
                    sVariable = sVariable.substr(5);
                }
                else if (DataType.stringIncludesRaw(sVariable, "salrt") == true) {
                    obj.sPrefix = "salrt";
                    obj.bPurchase = false;
                    sVariable = sVariable.substr(5);
                }
                else if (DataType.stringIncludesRaw(sVariable, "prttot") == true) {
                    obj.sPrefix = "purrt";
                    obj.bPurchase = true;
                    obj.sAbbr = sVariable.substr(3);
                    sVariable = sVariable.substr(6);
                }
                else if (DataType.stringIncludesRaw(sVariable, "srttot") == true) {
                    obj.sPrefix = "salrt";
                    obj.bPurchase = false;
                    obj.sAbbr = sVariable.substr(3);
                    sVariable = sVariable.substr(6);
                }
                else {
                    continue;
                }
                
                if (DataType.isNullOrEmpty(sVariable) == true) {
                    continue;
                }

                obj.iIndex = -1;

                if (sVariable == "0" || sVariable == "(0)") {
                    obj.iIndex = 0;
                }
                else if (sVariable == "1" || sVariable == "(1)") {
                    obj.iIndex = 1;
                }
                else if (sVariable == "2" || sVariable == "(2)") {
                    obj.iIndex = 2;
                }
                else if (sVariable == "3" || sVariable == "(3)") {
                    obj.iIndex = 3;
                }
                else if (sVariable == "4" || sVariable == "(4)") {
                    obj.iIndex = 4;
                }
                else if (sVariable == "5" || sVariable == "(5)") {
                    obj.iIndex = 5;
                }
                else if (sVariable == "6" || sVariable == "(6)") {
                    obj.iIndex = 6;
                }
                else if (sVariable == "7" || sVariable == "(7)") {
                    obj.iIndex = 7;
                }
                else if (sVariable == "8" || sVariable == "(8)") {
                    obj.iIndex = 8;
                }
                else if (sVariable == "9" || sVariable == "(9)") {
                    obj.iIndex = 9;
                }
                else if (sVariable == "10" || sVariable == "(10)") {
                    obj.iIndex = 10;
                }
                else if (sVariable == "11" || sVariable == "(11)") {
                    obj.iIndex = 11;
                }
                else if (sVariable == "12" || sVariable == "(12)") {
                    obj.iIndex = 12;
                }
                else if (sVariable == "13" || sVariable == "(13)") {
                    obj.iIndex = 13;
                }

                if (obj.iIndex < 0) {
                    continue;
                }

                obj.sFormula = sOrigInput;

                arrRateVariables.push(obj);
            }
        }
        catch (err) {
            transEntryGlobal.writeErrorLog("{transEntryRate.extractVariableName} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (arrRateVariables);
    },

