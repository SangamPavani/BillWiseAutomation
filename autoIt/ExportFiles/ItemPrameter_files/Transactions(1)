    getMetaData: function (ctrlId) {
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let arrFields = undefined;
        let obj = undefined;

        try {
            obj = {};
            obj.iColumn = -1;
            obj.MetaData = null;

            arrFields = transEntryFieldInfo.getBodyFields();
            sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_LINK) + "_";
            if (FCommon.String.startsWith(ctrlId, sId) == true) { // Link Column
                iIndex = FConvert.toInt(ctrlId.substr(sId.length)); // index of MetaData.Body
                
                for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                    if (arrFields[iCounter].MetaDataIndex == iIndex) {
                        obj.iColumn = arrFields[iCounter].ColumnIndex;
                        obj.MetaData = arrFields[iCounter].MetaData;

                        return (obj);
                    }
                }
            }

            // Non link column
            sId = ctrlId.substr(EntryMainUI.getBodyControlIdPrefix().length);
            if (DataType.stringEndsWith(sId, "bool") == true) {
                sId = sId.substr(0, sId.length - "bool".length);
            }

            iFieldId = FConvert.toInt(sId);
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                objMetaData = arrFields[iCounter].MetaData;
                if (objMetaData.iFieldId == iFieldId) {
                    obj.iColumn = arrFields[iCounter].ColumnIndex;
                    obj.MetaData = objMetaData;
                    break;
                }
            }
        }
        catch (err) {
            FUIElement.writeErrorLog("Exception: {transEntryDetailPopup.getMetaData} " + err.message);
        }

        return (obj);
    },

