    clearScreen: function (bPasteFromClipboard) {
        let iCounter = 0;
        let sId = "";
        let value = undefined;
        let ele = null;
        let objMetaData = null;

        try {
            bPasteFromClipboard = DataType.toBoolean(bPasteFromClipboard);
            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.Header.length; iCounter++) {
                objMetaData = transEntryGlobal.EntryModel.MetaData.Header[iCounter];
                sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);

                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Text:
                        if (objMetaData.iFieldId == eVTFIELDID.FDF_DOCUMENTNO) {
                            if (bPasteFromClipboard == false) {
                                OPTIONCONTROL.clear(sId);
                            }
                        }
                        else {
                            if (objMetaData.sFieldName == "sChequeNo") {
                                OPTIONCONTROL.clear(sId, false);
                                EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                            }
                            else {
                                ele = document.getElementById(sId);
                                if(DataType.isValidObject(ele) == false) {
                                    break;
                                }

                                if (EntryMainCommon.isFormula(objMetaData.sDefaultValue) == true) {
                                    ele.value = "";
                                }
                                else {
                                    ele.value = objMetaData.sDefaultValue;
                                }

                                EntryMainMemoryObject.update(objMetaData.iFieldId, ele.value, 0, objMetaData);
                            }
                        }
                        break;
                    case eMasterDataType.Number:
                    case eMasterDataType.Fraction:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        ele = document.getElementById(sId);
                        if (DataType.isValidObject(ele) == false) {
                            break;
                        }
                        if (EntryMainCommon.isFormula(objMetaData.sDefaultValue) == true) {
                            ele.value = "";
                        }
                        else {
                            ele.value = objMetaData.sDefaultValue;
                        }
                        EntryMainMemoryObject.update(objMetaData.iFieldId, ele.value, 0, objMetaData);
                        break;
                    case eMasterDataType.Master:
                    case eMasterDataType.ExternalTable:
                        OPTIONCONTROL.clear(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, 0, 0, objMetaData);
                        break;
                    case eMasterDataType.Boolean:
                        ele = document.getElementById(sId);
                        if (DataType.isValidObject(ele) == false) {
                            break;
                        }

                        ele.checked = DataType.toBoolean(objMetaData.sDefaultValue);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, ele.checked, 0, objMetaData);
                        break;
                    case eMasterDataType.Date:
                        DATEPICKER.clear(sId);

                        value = DATEPICKER.getDate(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                        break;
                    case eMasterDataType.Time:
                        FTIMECONTROL.clear(sId);

                        value = FTIMECONTROL.getTime(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                        break;
                    case eMasterDataType.DateTime:
                        document.getElementById(sId).value = "";
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                        break;
                    case eMasterDataType.Picture:
                        FATTACHMENTCONTROL.clear(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                        break;
                    case eMasterDataType.DocumentViewer:
                        FATTACHMENTCONTROL.clear(sId);
                        EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                        break;
                    case eMasterDataType.StringList:
                    case eMasterDataType.NumberList:
                        ele = document.getElementById(sId);
                        if (DataType.isValidObject(ele) == false) {
                            break;
                        }

                        if (EntryMainMaster.isInfoField(objMetaData.iFieldId, true) == true) {
                            FUIElement.removeChild(ele);
                        }

                        if (ele.length > 0) {
                            ele.selectedIndex = 0;
                        }

                        if (ele.selectedIndex > -1) {
                            if (objMetaData.iDataTypeId == eMasterDataType.StringList) {
                                value = ele.options[ele.selectedIndex].text;
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                            }
                            else {
                                value = ele.options[ele.selectedIndex].value;
                                EntryMainMemoryObject.update(objMetaData.iFieldId, value, 0, objMetaData);
                            }
                        }
                        else {
                            EntryMainMemoryObject.update(objMetaData.iFieldId, undefined, 0, objMetaData);
                        }
                        break;
                }
            }

            EntryMainUI.resetLCFilter();
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.clearScreen} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateVendorProductMap: function () {
        let sItemFilter = "";
        let sId = "";
        let iValue = 0;
        let iRow = 0;
        let iMax = 0;
        let iAccountTypeId = 0;
        let objData = undefined;

        try {
            if (transEntryInfo.isItSales == false) {
                return;
            }

            if (transEntryFieldInfo.Item.ColumnIndex < 0) {
                return;
            }

            if (transEntryFieldInfo.Book.Area != eTranEntryFieldArea.Header) {
                return;
            }

            if (transEntrySettings.isShowCustomerAssignedProducts == false) {
                return;
            }

            sItemFilter = transEntryGrid.getItemFilter();
            if (transEntryFieldInfo.SubLedger.Area == eTranEntryFieldArea.Header) {
                iAccountTypeId = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, 0, "iAccountTypeId", eMasterDataType.Number);
                if (EntryMainCommon.isPartyType(iAccountTypeId) == true) {
                    iValue = transEntryFields.getSubLedger(0);
                    iValue = transEntryServer.getSupplierId(iValue);
                    if(iValue != 0) {
                        sItemFilter += " a.iMasterId IN (SELECT iMasterId FROM muCore_Product_OtherDetails_Details WHERE iSupplier = " + iValue + ")";
                    }
                }
            }
            else {
                iValue = EntryMain.m_objTrans.BodyData[0].Book;
                iValue = transEntryServer.getSupplierId(iValue);
                if (iValue != 0) {
                    sItemFilter += " a.iMasterId IN (SELECT iMasterId FROM muCore_Product_OtherDetails_Details WHERE iSupplier = " + iValue + ")";
                }
            }

            sId = EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYPRODUCT);
            OPTIONCONTROL.setFilter(sId, sItemFilter);

            for (iRow = transEntryGrid.getTotalRows() ; iRow > 0; iRow--) {
                if (EntryMainMemoryObject.getProductValue(iRow) > 0) {
                    iMax = iRow;
                    break;
                }
            }

            objData = {};
            objData.arrMasterIds = [];
            objData.ColIndex = transEntryFieldInfo.Item.ColumnIndex;
            objData.MetaData = transEntryFieldInfo.Item.MetaData;
            for (iRow = 1; iRow <= iMax ; iRow++) {
                iValue = EntryMainMemoryObject.getProductValue(iRow);
                objData.arrMasterIds.push(iValue);
                if (iValue > 0) {
                    EntryMainUI.clear(transEntryFieldInfo.Item, iRow);
                }
            }

            if (objData.arrMasterIds.length > 0) {
                OPTIONCONTROL.setValue(EntryMainUI.getBodyControlId(eVTFIELDID.FDF_BODYPRODUCT), objData.arrMasterIds, objData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.updateVendorProductMap} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    updateViewInfoFields: function (iFieldId, Control) {
        let sId = "";
        let iCounter = 0;
        let iCounter1 = 0;
        let value = null;
        let ele = null;
        let eleOption = null;
        let objInfoField = null;
        let objViewLinkedInfoField = null;

        try {
            if (transEntryGlobal.EntryModel.bView == false || DataType.isValidObject(transEntryGlobal.EntryModel.MetaData.ViewInfoFields) == false) {
                return;
            }

            for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.MetaData.ViewInfoFields.length; iCounter++) {
                objInfoField = transEntryGlobal.EntryModel.MetaData.ViewInfoFields[iCounter];
                if (iFieldId != objInfoField.iFieldId) {
                    continue;
                }

                for (iCounter1 = 0; iCounter1 < objInfoField.arrViewLinkedInfoField.length; iCounter1++) {
                    objViewLinkedInfoField = objInfoField.arrViewLinkedInfoField[iCounter1];

                    sId = EntryMainUI.getHeaderControlId(objViewLinkedInfoField.iLinkedFieldId);
                    value = OPTIONCONTROL.getControlValue(Control, objViewLinkedInfoField.sMandatoryField.toLowerCase());
                    switch (objViewLinkedInfoField.iLinkedFieldDataTypeId) {
                        case eMasterDataType.Text:
                        case eMasterDataType.Number:
                        case eMasterDataType.Fraction:
                        case eMasterDataType.BigNumber:
                        case eMasterDataType.SmallNumber:
                        case eMasterDataType.TinyNumber:
                            document.getElementById(sId).value = value;
                            break;
                        case eMasterDataType.Date:
                            break;
                        case eMasterDataType.StringList:
                        case eMasterDataType.NumberList:
                            ele = document.getElementById(sId);
                            FUIElement.removeChild(ele);
                            if (DataType.isNullOrEmpty(value) == false) {
                                eleOption = document.createElement("option");
                                eleOption.text = value;
                                eleOption.value = value;
                                ele.appendChild(eleOption);
                                ele.options.selectedIndex = 0;
                            }
                            break;
                        case eMasterDataType.Boolean:
                            document.getElementById(sId).checked = DataType.toBoolean(value);
                            break;
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.updateViewInfoFields} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    setDefaultChequeNo: function (sChequeNo, iCallingSource) {
        let obj = null;

        try {
            if (transEntryInfo.BaseVoucherType != eVTTYPE.CASHP && transEntryInfo.BaseVoucherType != eVTTYPE.MEMOP) {
                return(false);
            }

            if (transEntryFieldInfo.ChequeNo.Area != eTranEntryFieldArea.Header) {
                return(false);
            }

            if (transEntryInfo.Settings.Misc.MaintainChequeSeries == false) {
                return(false);
            }

            if (EntryMain.m_objTrans.BodyData[0].Book > 0
                && transEntryFieldInfo.Book.FieldId > 0) {

                obj = {};
                obj.iBookNo = EntryMain.m_objTrans.BodyData[0].Book;
                obj.iFATag = EntryMain.m_objTrans.BodyData[0].FATag;

                transEntryServer.execute(eTransServerRequest.GetNextChequeNoSeries, 
                                            obj, 
                                            true, 
                                            "EntryMainCallback.getNextChequeNoSeries",
                                            {
                                                iBookNo: obj.iBookNo,
                                                sLoadedChequeNo: DataType.toString(sChequeNo),
                                                bVoucherLoading: iCallingSource == eDisplayBodyDataSource.LoadVoucher
                                            });

                return(true);
