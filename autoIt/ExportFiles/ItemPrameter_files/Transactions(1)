        let iCodeTypeId = 0;
        let iBookTypeId = 0;
        let objBody = null;
        let objExtraInfo = undefined;

        try {
            iInsertAt = DataType.toInt(iInsertAt);
            iCount = DataType.toInt(iCount);
            if (iCount <= 0) {
                iCount = 1;
            }

            for (iCounter = 0; iCounter < iCount; iCounter++) {
                iCodeTypeId = eAccountTypes.None;
                iBookTypeId = eAccountTypes.None;

                if (EntryMain.m_objTrans.BodyData.length > 0) {
                    if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                        iCodeTypeId = EntryMainMemoryObject.getCodeTypeId(0);
                    }

                    if (transEntryFieldInfo.Book.Area == eTranEntryFieldArea.Header) {
                        iBookTypeId = EntryMainMemoryObject.getBookTypeId(0);
                    }
                }

                objBody = EntryMainMemoryObject.getEmptyBodyObject();
                objExtraInfo = DataType.createDuplicateObject(EntryMainMemoryObject.objExtraInfo, true);

                if (transEntryInfo.BaseVoucherType == eVTTYPE.JOURN) {
                    objBody.Book = 1; // Default JV account
                    iBookTypeId = eAccountTypes.Assets;
                }
                else if (transEntryInfo.BaseVoucherType == eVTTYPE.OPBAL) {
                    objBody.Book = 2; // Default Op bal control account
                    iBookTypeId = eAccountTypes.Assets;
                }

                objExtraInfo.iCodeTypeId = iCodeTypeId;
                objExtraInfo.iBookTypeId = iBookTypeId;

                if (iInsertAt <= 0) {
