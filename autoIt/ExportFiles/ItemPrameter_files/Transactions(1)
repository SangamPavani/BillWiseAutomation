                    || (iMaskedVoucherType == eVTTYPE.MATRN && transEntryInfo.Settings.Misc.UpdateFA == true)
                    || iMaskedVoucherType == eVTTYPE.CPSTK
                    || iMaskedVoucherType == eVTTYPE.CRDNT
                    || iMaskedVoucherType == eVTTYPE.JOURN
                    || iMaskedVoucherType == eVTTYPE.NJOURN)) {
                bCheck = true;

                if (iMaskedVoucherType == eVTTYPE.PURCH
                    || (iMaskedVoucherType == eVTTYPE.MATRN && transEntryInfo.Settings.Misc.UpdateFA == true)
                    || iMaskedVoucherType == eVTTYPE.CPSTK) {

                    if (transEntryFieldInfo.Code.Area == eTranEntryFieldArea.Header) {
                        if (iMaskedVoucherType == eVTTYPE.CPSTK) {
                            if (transEntryGlobal.IntermediateData.arrBookTypes[0] != eAccountTypes.FixedAssets) {
                                bCheck = false;
                            }
                        }
                        else {
                            if (transEntryGlobal.IntermediateData.arrCodeTypes[0] != eAccountTypes.FixedAssets) {
                                bCheck = false;
                            }
                        }
                    }
                }

                if (bCheck == false) {
                    return (false);
                }

                transEntryGlobal.FixedAssets = {};
                transEntryGlobal.FixedAssets.objTransactionData = objTransactionData;
                transEntryGlobal.FixedAssets.bSuspended = bSuspended;
                transEntryGlobal.FixedAssets.sCallback = sCallback;
                transEntryGlobal.FixedAssets.iSaveSource = iSaveSource;
                transEntryGlobal.FixedAssets.iMaskedVoucherType = iMaskedVoucherType;
                transEntryGlobal.FixedAssets.iCounter = 0;
                transEntryGlobal.FixedAssets.iRow = 0;
                transEntryGlobal.FixedAssets.arrCreatedMasters = [];

                this.checkRows();

                return (true);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFixedAssets.check} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (false);
    },

    checkRows: function () {        
        let iCounter = 0;
        let iParentId = 0;
        let dNet = 0;
        let dValue = 0;
        let bFlag = false;
        let ctrl = undefined;
        let objBody = null;
        let result = null;
        let arrIdNamePair = null;
        let objRateInfo = undefined;
        let objCodeInfo = undefined;
        let objAmountInfo = undefined;
        let objDebitInfo = undefined;
        let obj = undefined;

        try {
            if (transEntryGlobal.debugFixedAssets == true) {
                debugger
            }

            objRateInfo = transEntryFieldInfo.Rate;
            objCodeInfo = transEntryFieldInfo.Code;
            objAmountInfo = transEntryFieldInfo.Amount;
            objDebitInfo = transEntryFieldInfo.Debit;

            bFlag = false;
            for (; transEntryGlobal.FixedAssets.iCounter < transEntryGlobal.IntermediateData.objTransaction.BodyData.length; transEntryGlobal.FixedAssets.iCounter++) {
                objBody = transEntryGlobal.IntermediateData.objTransaction.BodyData[transEntryGlobal.FixedAssets.iCounter];
                if (objBody.RowType != _RowType.Default) {
                    continue;
                }

                transEntryGlobal.FixedAssets.iRow++;
                if (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.PURCH 
                    || (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.MATRN && transEntryInfo.Settings.Misc.UpdateFA == true)
                    || transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.CPSTK) {

                    if (objCodeInfo.Area == eTranEntryFieldArea.Header) {
                        if (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.CPSTK) {
                            if (transEntryGlobal.IntermediateData.arrBookTypes[0] != eAccountTypes.FixedAssets) {
                                continue;
                            }
                        }
                        else {
                            if (transEntryGlobal.IntermediateData.arrCodeTypes[0] != eAccountTypes.FixedAssets) {
                                continue;
                            }
                        }
                    }
                    else if (objCodeInfo.Area == eTranEntryFieldArea.Body) {
                        if (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.CPSTK) {
                            if (transEntryGlobal.IntermediateData.arrBookTypes[transEntryGlobal.FixedAssets.iCounter] != eAccountTypes.FixedAssets) {
                                continue;
                            }
                        }
                        else {
                            if (transEntryGlobal.IntermediateData.arrCodeTypes[transEntryGlobal.FixedAssets.iCounter] != eAccountTypes.FixedAssets) {
                                continue;
                            }
                        }
                    }
                    else if (objCodeInfo.Area == eTranEntryFieldArea.None) {
                        continue;
                    }
                }
                else {
                    if (transEntryGlobal.IntermediateData.arrCodeTypes[transEntryGlobal.FixedAssets.iCounter] != eAccountTypes.FixedAssets) {
                        continue;
                    }

                    if (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.JOURN) {
                        if (objDebitInfo.ColumnIndex < 0
                            || transEntryFields.getDebit(transEntryGlobal.FixedAssets.iRow) == 0) {

                            continue;
                        }
                    }
                    else if (transEntryGlobal.FixedAssets.iMaskedVoucherType == eVTTYPE.NJOURN) {
                        if (objAmountInfo.ColumnIndex < 0 || EntryMainMemoryObject.getAmountValue(transEntryGlobal.FixedAssets.iRow) == 0) {
                            continue;
                        }
                    }
                }

                if (transEntryFields.getBodyId(transEntryGlobal.FixedAssets.iRow) > 0) {
                    continue;
                }

                bFlag = true;
                arrIdNamePair = [];

                if (transEntryFieldInfo.Item.FieldId > 0) {
                    arrIdNamePair.push({ Name: "iProduct", Tag: objBody.Sales.Product });
                }

                if (transEntryGlobal.EntryModel.Preference.FixedAssets.iFixedAssetsLocation > 0) {
                    arrIdNamePair.push({ Name: "iTag0", Tag: transEntryGrid.getMasterValue(transEntryGlobal.FixedAssets.iRow, transEntryGlobal.EntryModel.Preference.FixedAssets.iFixedAssetsLocation) });
                }

                if (transEntryGlobal.EntryModel.Preference.FixedAssets.iTag1 > 0) {
                    arrIdNamePair.push({ Name: "iTag1", Tag: transEntryGrid.getMasterValue(transEntryGlobal.FixedAssets.iRow, transEntryGlobal.EntryModel.Preference.FixedAssets.iTag1) });
                }

                if (transEntryGlobal.EntryModel.Preference.FixedAssets.iTag2 > 0) {
                    arrIdNamePair.push({ Name: "iTag2", Tag: transEntryGrid.getMasterValue(transEntryGlobal.FixedAssets.iRow, transEntryGlobal.EntryModel.Preference.FixedAssets.iTag2) });
                }

                if (transEntryFieldInfo.Qty.ColumnIndex > -1) {
                    arrIdNamePair.push({ Name: "iQuantity", Tag: FNumberOperation.abs(objBody.Sales.Quantity) });
                }

                if (transEntryGlobal.FixedAssets.iMaskedVoucherType != eVTTYPE.CPSTK) {
                    arrIdNamePair.push({ Name: "iVendor", Tag: objBody.Book });
                }

                if (transEntryFieldInfo.Item.FieldId > 0) {
                    ctrl = EntryMainUI.getElement(transEntryFieldInfo.Item, transEntryGlobal.FixedAssets.iRow).Value;
                    arrIdNamePair.push({ Name: "sName", Tag: EntryMainMaster.getNameCode(ctrl, true) });
                    arrIdNamePair.push({ Name: "sCode", Tag: EntryMainMaster.getNameCode(ctrl, false) });
                }

                arrIdNamePair.push({ Name: "iPurchaseDate", Tag: transEntryGlobal.IntermediateData.objTransaction.Header.Date });

                if (objRateInfo.ColumnIndex > -1 && objRateInfo.MetaData.bHidden == false) {
                    dValue = transEntryGrid.getOriginalAmount0(transEntryGlobal.FixedAssets.iRow);
                    dNet = Math.abs(dValue);
                    if (dNet == 0) {
                        dValue = transEntryGrid.getCellText(transEntryGlobal.FixedAssets.iRow, objRateInfo.ColumnIndex).value;
                        arrIdNamePair.push({ Name: "fPrice", Tag: dValue });
                    }
                    else {
                        dValue = transEntryFields.getQty(transEntryGlobal.FixedAssets.iRow);
                        dNet = DataType.div(dNet, dValue);

                        dValue = transEntryFields.getExchangeRate(transEntryGlobal.FixedAssets.iRow);
                        dNet = DataType.mul(dNet, dValue);

                        arrIdNamePair.push({ Name: "fPrice", Tag: dNet });
                    }                    
                }
                else if (objRateInfo.ColumnIndex < 0) {
                    if (objAmountInfo.ColumnIndex > -1) {
                        result = transEntryGrid.getCellText(transEntryGlobal.FixedAssets.iRow, objAmountInfo.ColumnIndex);
                    }
                    else {
                        result = transEntryGrid.getCellText(transEntryGlobal.FixedAssets.iRow, objDebitInfo.ColumnIndex);
                    }

                    if (result.lValue > 0) {
                        arrIdNamePair.push({ Name: "fPrice", Tag: result.value });
                    }
                }

                arrIdNamePair.push({ Name: "iAssetACCode", Tag: transEntryFields.getCode(transEntryGlobal.FixedAssets.iRow) });

                if (transEntryFieldInfo.FixedAssetGroup.FieldId > 0) {
                    iParentId = EntryMainUI.getValue(transEntryFieldInfo.FixedAssetGroup, transEntryGlobal.FixedAssets.iRow);
                    arrIdNamePair.push({ Name: "iParentId", Tag: iParentId });
                }

                for (iCounter = 0; iCounter < transEntryGlobal.EntryModel.arrFixedAssetFields.length; iCounter++) {
                    obj = transEntryGlobal.EntryModel.arrFixedAssetFields[iCounter];

                    result = EntryMainUI.getValueFromFieldId(obj.iTransFieldId, transEntryGlobal.FixedAssets.iRow).Value;
                    if (result == undefined || result == null) {
                        continue;
                    }

                    if (obj.iTransFieldId == eVTFIELDID.FDF_BODYBATCHNO) {
                        result = result.BatchNo;
                    }
                    else if (obj.iTransFieldId == eVTFIELDID.FDF_BINS || obj.iTransFieldId == eVTFIELDID.FDF_BINS2) {
                        result = result[0].BinName;
                    }

                    arrIdNamePair.push({ Name: obj.FieldName, Tag: result });
                }

                transEntryGlobal.FixedAssets.iCounter++;
                EntryMainUI.openMasterScreen(eMasterTypeId.FixedAsset,
                                            "EntryMainFixedAssets.createMasters",
                                            "",
                                            eAccountTypes.None,
                                            "",
                                            0,
                                            arrIdNamePair);
                break;
            }

            if (bFlag == false) {
                transEntryServer.saveTransaction(transEntryGlobal.FixedAssets.objTransactionData,
                                    transEntryGlobal.FixedAssets.sCallback,
                                    transEntryGlobal.FixedAssets.bSuspended,
                                    transEntryGlobal.FixedAssets.iSaveSource,
                                    transEntryGlobal.FixedAssets.arrCreatedMasters);

                delete transEntryGlobal.FixedAssets;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFixedAssets.checkRows} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

