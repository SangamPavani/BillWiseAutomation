    setSummaryInfo: function (iRow, bIgnoreLayoutBodyCalculation, bCalculateFromMemory) {
        let sText = "";
        let iCounter = 0;
        let dTotalNet = 0;
        let arrFields = undefined;
        let cell = null;
        let eleFooterPanelStatic = null;
        let result = null;
        let obj = null;
        let objWatch = null;

        try {
            iRow = DataType.toInt(iRow);
            if (transEntryGlobal.isMethodExecuting(eTransMethodExecuting.SetSummaryInfo, iRow) > -1) {
                return;
            }
                
            transEntryGlobal.updateExecutingMethod(eTransMethodExecuting.SetSummaryInfo, iRow, true);

            objWatch = new FStopWatch();
            objWatch.start();

            bCalculateFromMemory = DataType.toBoolean(bCalculateFromMemory);

            if (bCalculateFromMemory == true) {
                obj = EntryMainUI.calculateSummaryBarData(true);
            }
            else {                
                bIgnoreLayoutBodyCalculation = DataType.toBoolean(bIgnoreLayoutBodyCalculation);

                dTotalNet = EntryMainCalculation.getNetAmount(iRow, bIgnoreLayoutBodyCalculation);

                obj = EntryMainUI.calculateSummaryBarData(false);
                obj.dTotalNet = dTotalNet;
            }

            EntryMainUI.showNetAmount(obj.dTotalNet);

            if (transEntryFieldInfo.Gross.ColumnIndex > -1) {
                sText = DataType.addNumericSeparator(obj.dTotalGross, transEntryCurrency.getNumericSeparator(1));
                eleFooterPanelStatic = EntryMainUI.getSummaryValueElementId(eVTFIELDID.FDF_BODYGROSS, true);
                FUIElement.setText(eleFooterPanelStatic, sText, true);
            }

            arrFields = transEntryFieldInfo.getScreenFields();
            for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                cell = transEntryGrid.getCellObject(1, arrFields[iCounter].ColumnIndex);
                if (DataType.isValidObject(cell) == false) {
                    continue;
                }

                eleFooterPanelStatic = EntryMainUI.getSummaryValueElementId(cell.MetaData.iFieldId, true);
                sText = DataType.addNumericSeparator(obj.arrTotalScreenOutputValue[iCounter], transEntryCurrency.getNumericSeparator(1));
                FUIElement.setText(eleFooterPanelStatic, sText, true);
            }

            for (iCounter = 0; iCounter < obj.arrFooterOutputData.length; iCounter++) {
                result = obj.arrFooterOutputData[iCounter];

                eleFooterPanelStatic = EntryMainUI.getSummaryValueElementId(result.iFieldId, true);
                sText = DataType.addNumericSeparator(result.dOutputValue, transEntryCurrency.getNumericSeparator(1));
                FUIElement.setText(eleFooterPanelStatic, sText, true);
            }

            EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BODYQUANTITY);
            EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BODYAMOUNT);
            EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BODYJRNDEBIT);
            EntryMainUI.updateFooterSummarySpecialValue(eVTFIELDID.FDF_BODYJRNCREDIT);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.setSummaryInfo} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        objWatch.stop();
        transEntryGlobal.writeInfoLog("EntryMainUI.setSummaryInfo(" + objWatch.getDifferenceString() + ").");

        transEntryGlobal.updateExecutingMethod(eTransMethodExecuting.SetSummaryInfo, iRow, false);
    },

    updateFooterSummarySpecialValue: function (iFieldId) {
        let iRow = 0;
        let iTotalRows = 0;
        let dTotal = 0;
        let dDrTotal = 0;
        let dCrTotal = 0;
        let eleValue = null;
        let objCell = null;

        try {
            if (iFieldId == eVTFIELDID.FDF_BODYQUANTITY) {
                transEntryQuantity.updateTotal(true);
                return;
            }
            else if (iFieldId == eVTFIELDID.FDF_BODYAMOUNT) {
                transEntryAmount.updateTotal(true);
                return;
            }

            eleValue = EntryMainUI.getSummaryValueElementId(iFieldId, true);
            if (DataType.isValidObject(eleValue) == false) {
                return;
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                    if (transEntryFieldInfo.Debit.FieldId == 0) {
                        return;
                    }
                    break;
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                    if (transEntryFieldInfo.Credit.FieldId == 0) {
                        return;
                    }
                    break;
                case eVTFIELDID.FDF_BALANCESTKVAL:
                    if (transEntryFieldInfo.BalanceStockValue.ColumnIndex < 0) {
                        return;
                    }
                    break;
                case eVTFIELDID.FDF_NEWSTKVAL:
                    if (transEntryFieldInfo.NewStockValue.ColumnIndex < 0) {
                        return;
                    }
                    break;
                case eVTFIELDID.FDF_POINT_BALANCE:
                    if (transEntryFieldInfo.Debit.FieldId == 0
                        || transEntryFieldInfo.Credit.FieldId == 0) {

                        return;
                    }
                    break;
            }

            iTotalRows = transEntryGrid.getTotalRows();
            for (iRow = 1; iRow <= iTotalRows; iRow++) {
                switch (iFieldId) {
                    case eVTFIELDID.FDF_BODYJRNDEBIT:
                        objCell = EntryMainUI.getElement(transEntryFieldInfo.Debit, iRow).Value;
                        break;
                    case eVTFIELDID.FDF_BODYJRNCREDIT:
                        objCell = EntryMainUI.getElement(transEntryFieldInfo.Credit, iRow).Value;
                        break;
                    case eVTFIELDID.FDF_BALANCESTKVAL:
                        objCell = EntryMainUI.getElement(transEntryFieldInfo.BalanceStockValue, iRow).Value;
                        break;
                    case eVTFIELDID.FDF_NEWSTKVAL:
                        objCell = EntryMainUI.getElement(transEntryFieldInfo.NewStockValue, iRow).Value;
                        break;
                    case eVTFIELDID.FDF_POINT_BALANCE:
                        objCell = EntryMainUI.getElement(transEntryFieldInfo.Debit, iRow).Value;
                        if (DataType.isValidObject(objCell) == true) {
                            dDrTotal = FNumberOperation.add(dDrTotal, DataType.getNumber(objCell.getCellText()));
                        }

                        objCell = EntryMainUI.getElement(transEntryFieldInfo.Credit, iRow).Value;
                        if (DataType.isValidObject(objCell) == true) {
                            dCrTotal = FNumberOperation.add(dCrTotal, DataType.getNumber(objCell.getCellText()));
                        }

                        objCell = null;
                        break;
                }

                if (DataType.isValidObject(objCell) == true) {
                    dTotal = FNumberOperation.add(dTotal, DataType.getNumber(objCell.getCellText()));
                }
            }

            switch (iFieldId) {
                case eVTFIELDID.FDF_BODYJRNDEBIT:
                    FUIElement.setText(eleValue, DataType.addNumericSeparator(FNumberOperation.toFixed(dTotal, transEntrySettings.getDecimalsInAmount(0)), transEntryCurrency.getNumericSeparator(1)), true);
                    break;
                case eVTFIELDID.FDF_BODYJRNCREDIT:
                    FUIElement.setText(eleValue, DataType.addNumericSeparator(FNumberOperation.toFixed(dTotal, transEntrySettings.getDecimalsInAmount(0)), transEntryCurrency.getNumericSeparator(1)), true);
                    break;
                case eVTFIELDID.FDF_BALANCESTKVAL:
                    FUIElement.setText(eleValue, DataType.addNumericSeparator(FNumberOperation.toFixed(dTotal, transEntrySettings.getDecimalsInAmount(0)), transEntryCurrency.getNumericSeparator(1)), true);
                    break;
                case eVTFIELDID.FDF_NEWSTKVAL:
                    FUIElement.setText(eleValue, DataType.addNumericSeparator(FNumberOperation.toFixed(dTotal, transEntrySettings.getDecimalsInAmount(0)), transEntryCurrency.getNumericSeparator(1)), true);
                    break;
                case eVTFIELDID.FDF_POINT_BALANCE:
                    dTotal = DataType.sub(dDrTotal, dCrTotal);
                    FUIElement.setText(eleValue, DataType.addNumericSeparator(FNumberOperation.toFixed(dTotal, transEntrySettings.getDecimalsInAmount(0)), transEntryCurrency.getNumericSeparator(1)), true);
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.updateFooterSummarySpecialValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

