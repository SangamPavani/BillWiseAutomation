                if(DataType.neq(arrBinDetails[iCounter].Category, Category) == true) {
                    continue;
                }

                if(DataType.toString(arrBinDetails[iCounter].Batch) !== DataType.toString(Batch)) {
                    continue;
                }

                arrBinDetails[iCounter].ToBeAllocated = dToBeAllocated;
