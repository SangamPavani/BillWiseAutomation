    this.getIncrementalValidStartCharPos = function (iType, iFieldValue, iStartCharPos) {
        var objGlobal = null;

        try {
            objGlobal = GLOBAL.getGlobalValue();

            if (iType == 0) { // Login
                switch (iFieldValue) {
                    case 0: // Login Name
                        if (iStartCharPos >= objGlobal.UserName.length) {
                            iStartCharPos = 0;
                        }
                        break;
                    case 1: // Login Abbreviation
                        if (iStartCharPos >= objGlobal.LoginAbbr.length) {
                            iStartCharPos = 0;
                        }
                        break;
                }
            }
            else if (iType == 1) { // Character Input 
                if (iStartCharPos > 0) {
                    iStartCharPos = 0;

                    COMMON.prototype.showMessage("Starting Character cannot be greater than zero", "Error");
                }
            }
            else if (iType == 2) { // Date
                if (iFieldValue == 0) { // Day
                    if (iStartCharPos >= 2) {
                        iStartCharPos = 1;
                        COMMON.prototype.showMessage("Starting Character cannot be greater than one", "Error");
                    }
                }
                else if (iFieldValue == 1) { // Month Name
                    if (iStartCharPos >= 2) {
                        iStartCharPos = 1;
                        COMMON.prototype.showMessage("Starting Character cannot be greater than one", "Error");
                    }
                }
                else if (iFieldValue == 2) { // Year
                    if (iStartCharPos >= 4) {
                        iStartCharPos = 3;
                        COMMON.prototype.showMessage("Starting Character cannot be greater than three", "Error");
                    }
                }
                else if (iFieldValue == 3) { // Fiscal
                    if (iStartCharPos > 0) {
                        iStartCharPos = 0;
                        COMMON.prototype.showMessage("Starting Character cannot be greater than zero", "Error");
                    }
                }
            }
            else if (iType == 3) { // Increment
                iStartCharPos = 0;
            }
            else if (iType == 4) { // Decrement
                iStartCharPos = 0;
            }
        }
        catch (err) {
            COMMON.prototype.showMessage("Exception: {DocLayoutField_Customization.getIncrementalValidStartCharPos} " + err.message, "Exception");
        }

        return (iStartCharPos);
    }

    this.getIncrementalValidNoOfChars = function (iType, iFieldValue, iStartCharPos, iNoOfChars, iRow) {
        var objGlobal = null;
        var cell = null;
        var iTemp = 0;

        try {
            objGlobal = GLOBAL.getGlobalValue();

            if (iType == 0) { // Login
                switch (iFieldValue) {
                    case 0: // Login Name
                        iTemp = objGlobal.UserName.length - iStartCharPos;
                        if (iNoOfChars >= iTemp) {
                            iNoOfChars = iTemp;
                        }
                        else {
                            cell = FGRIDCONTROL.getCellObject(DocLayoutField_Customization.getIncrementalGridId(), iRow, 3);
                            cell.setCellText(0, 0);
                        }
                        break;
                    case 1: // Login Abbreviation
                        iTemp = objGlobal.LoginAbbr.length - iStartCharPos;
                        if (iNoOfChars >= iTemp) {
                            iNoOfChars = iTemp;
                        }
                        else {
                            cell = FGRIDCONTROL.getCellObject(DocLayoutField_Customization.getIncrementalGridId(), iRow, 3);
                            cell.setCellText(0, 0);
                        }
                        break;
                }
            }
            else if (iType == 1) { // Character Input 
                if (iNoOfChars > 1) {
                    iNoOfChars = 1;

                    COMMON.prototype.showMessage("No. of Characters cannot be greater than one", "Error");
                }
            }
            else if (iType == 2) { // Date
                if (iFieldValue == 0) { // Day
                    if (iNoOfChars > 2) {
                        iNoOfChars = 2;

                        COMMON.prototype.showMessage("No. of Characters cannot be greater than two", "Error");
                    }
                }
                else if (iFieldValue == 1) { // Month Name
                    if (iNoOfChars > (3 - iStartCharPos)) {
                        iNoOfChars = (3 - iStartCharPos);

                        COMMON.prototype.showMessage("No. of Characters cannot be greater than " + (3 - iStartCharPos), "Error");
                    }
                }
                else if (iFieldValue == 2) { // Year
                    if (iNoOfChars > (4 - iStartCharPos)) {
                        iNoOfChars = (4 - iStartCharPos);

                        COMMON.prototype.showMessage("No. of Characters cannot be greater than " + (4 - iStartCharPos), "Error");
                    }
                }
                else if (iFieldValue == 3) { // Fiscal
                    if (iNoOfChars > (2 - iStartCharPos)) {
                        iNoOfChars = (2 - iStartCharPos);

                        COMMON.prototype.showMessage("No. of Characters cannot be greater than " + (2 - iStartCharPos), "Error");
                    }
                }
            }
            else if (iType == 3) { // Increment
                if (iNoOfChars > 5) {
                    iNoOfChars = 5;
                }
                else if (iNoOfChars == 0) {
                    iNoOfChars = 5;
                }
            }
