    checkRule: function (value, objMetaData, bLeave) {
        let iCounter = 0;
        let arrTemp = null;
        let arrRules = null;
        let objRuleInput = null;

        try {
            if (EntryMainRules.isFieldInRule(transEntryInfo.Settings.ArrVoucherRules, objMetaData.iFieldId) == false) {
                return;
            }

            bLeave = DataType.toBoolean(bLeave);

            if (bLeave == true) {
                if (transEntryInfo.HeaderId > 0) {
                    arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["onLeave", "Edit", "IsRuleActive"], [true, true, true], "===");
                }
                else {
                    arrTemp = DataType.arrayFilterData(transEntryInfo.Settings.ArrVoucherRules, ["onLeave", "NewRecord", "IsRuleActive"], [true, true, true], "===");
                }
            }

            if (DataType.arrayLength(arrTemp) > 0) {
                arrRules = [];
                for (iCounter = 0; iCounter < arrTemp.length; iCounter++) {
                    if (EntryMainRules.isFieldInRule([arrTemp[iCounter]], objMetaData.iFieldId) == true) {
                        arrRules.push(arrTemp[iCounter]);
                    }
                }

                if (arrRules.length > 0) {
                    objRuleInput = EntryMainRules.getRuleInputObject(arrRules, value, true, 0, 0, eRuleEvaluateOn.Leave, objMetaData.iFieldId);
                    objRuleInput.FieldArea = eTranEntryFieldArea.Footer;
                    EntryMainRules.applyRule(objRuleInput);
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainFooter.checkRule} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

