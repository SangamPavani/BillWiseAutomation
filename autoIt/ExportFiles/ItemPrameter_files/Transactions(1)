    getBatchInfo: function (iRow, bInfo, bTransQty) {
        let iDecimals = 0;
        let fConversion = 1;
        let bInwardVoucher = false;
        let objControl = undefined;
        let objFieldInfo = undefined;
        let value = undefined;
        let temp = undefined;

        objFieldInfo = transEntryFieldInfo.BatchNo;
        if (objFieldInfo.FieldId > 0) {
            objControl = EntryMainUI.getElement(objFieldInfo, iRow, true);
            if (objControl.Value) {
                value = {};
                value.BatchId = DataType.toInt64(objControl.Value.getAttribute(eTranEntryBatchNoKey.BatchId));

                bInwardVoucher = transEntryInfo.isInwardVoucher;
                if ((transEntryInfo.VoucherType & eVTTYPE.VOUCHERMASK) == eVTTYPE.WDONE) {
                    temp = EntryMainUI.getValueFromFieldId(eVTFIELDID.FDF_RCTISSUESELECTION, iRow);
                    if (temp.Value == "0") { // Issue Row
                        bInwardVoucher = false;
                    }
                }

                // Read Batch No
                if (bInwardVoucher == true) {
                    value.BatchNo = objControl.Value.getAttribute(CELL_VALUE);
                }
                else {
                    value.BatchNo = objControl.Value.getAttribute(eTranEntryBatchNoKey.BatchNo);
                }

                if (DataType.isNullOrEmpty(value.BatchNo, true) == true && DataType.toInt64(value.BatchId) == 0) {
                    value = undefined;
                }

                // If Not Found
                if (value == undefined || value == null) {
                    return;
                }
                else {
                    if (bInfo == true) {
                        return (value);
                    }

                    iDecimals = transEntrySettings.getDecimalsInAmount(iRow);
                }

                // Read MFG Date
                objFieldInfo = transEntryFieldInfo.MFGDate;
                if (objFieldInfo.FieldId > 0) {
                    temp = EntryMainUI.getValue(objFieldInfo, iRow);
                    if (objFieldInfo.Error == eTransGetValueResult.None) {
                        value.MfgDate = {};
                        value.MfgDate.Value = temp;
                    }
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.MfgDate);
                    if (DataType.isValidObject(temp) == true) {
                        value.MfgDate = {};
                        value.MfgDate.Value = DataType.toInt(temp);
                    }
                }

                // Read Expiry Date
                objFieldInfo = transEntryFieldInfo.EXPDate;
                if (objFieldInfo.FieldId > 0) {
                    temp = EntryMainUI.getValue(objFieldInfo, iRow);
                    if (objFieldInfo.Error == eTransGetValueResult.None) {
                        value.ExpDate = {};
                        value.ExpDate.Value = temp;
                    }
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.ExpDate);
                    if (DataType.isValidObject(temp) == true) {
                        value.ExpDate = {};
                        value.ExpDate.Value = DataType.toInt(temp);
                    }
                }                

                // Read Batch Rate
                objFieldInfo = transEntryFieldInfo.BatchRate;
                if (objFieldInfo.FieldId > 0) {
                    temp = EntryMainUI.getValue(objFieldInfo, iRow);
                    if (objFieldInfo.Error == eTransGetValueResult.None) {
                        value.BatchRate = DataType.toDecimal(temp, iDecimals);
                    }
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.BatchRate);
                    if (DataType.isValidObject(temp) == true) {
                        value.BatchRate = DataType.toDecimal(temp, iDecimals);
                    }
                }

                // Read Batch Rate1
                objFieldInfo = transEntryFieldInfo.BatchRate1;
                if (objFieldInfo.FieldId > 0) {
                    temp = EntryMainUI.getValue(objFieldInfo, iRow);
                    if (objFieldInfo.Error == eTransGetValueResult.None) {
                        value.Value1 = DataType.toDecimal(temp, iDecimals);
                    }
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.Value1);
                    if (DataType.isValidObject(temp) == true) {
                        value.Value1 = DataType.toDecimal(temp, iDecimals);
                    }
                }

                // Read Batch Rate2
                objFieldInfo = transEntryFieldInfo.BatchRate2;
                if (objFieldInfo.FieldId > 0) {
                    temp = EntryMainUI.getValue(objFieldInfo, iRow);
                    if (objFieldInfo.Error == eTransGetValueResult.None) {
                        value.Value2 = DataType.toDecimal(temp, iDecimals);
                    }
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.Value2);
                    if (DataType.isValidObject(temp) == true) {
                        value.Value2 = DataType.toDecimal(temp, iDecimals);
                    }
                }

                if (transEntryInfo.isInwardVoucher == true
                    && EntryMainProductionProcess.isIssueRow(iRow) == false) {

                    value.PurchaseDate = {};
                    value.PurchaseDate.Value = 0;

                    if (bTransQty == true) {
                        value.Qty = EntryMainUI.getValue(transEntryFieldInfo.Qty, iRow);
                    }
                    else {
                        value.Qty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                    }

                    //value.Qty = EntryMainMemoryObject.getBaseQuantityValue(iRow);
                    value.dAltQty = EntryMainMemoryObject.getAltQuantityValue(iRow);
                    value.InvTagId = transEntryInvTag.getValue(iRow);
                }
                else {
                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.BodyId);
                    value.BodyId = DataType.toInt(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.InvTagId);
                    value.InvTagId = DataType.toInt(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.Qty);
                    value.Qty = DataType.toDecimal(temp, transEntryQuantity.getDecimals());

                    if (bTransQty == true) {
                        if (transEntryFieldInfo.Unit.FieldId > 0) {
                            fConversion = transEntryUnit.getConversionValue(iRow);
                            if (DataType.neq(fConversion, 1) == true) {
                                value.Qty = EntryMainUI.getValue(transEntryFieldInfo.Qty, iRow);
                            }
                        }
                    }


                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.dAltQty);
                    value.dAltQty = DataType.toDecimal(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.PurchaseDate);
                    value.PurchaseDate = {};
                    value.PurchaseDate.Value = DataType.toInt(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.ResHeaderId);
                    value.ResHeaderId = DataType.toInt(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.AllocationTagId);
                    value.AllocationTagId = DataType.toInt(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.FromReservation);
                    value.FromReservation = DataType.toBoolean(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.ResQuantity);
                    value.ResQuantity = DataType.toDecimal(temp);

                    temp = objControl.Value.getAttribute(eTranEntryBatchNoKey.IReservationId);
                    value.IReservationId = FNumberOperation.convert(temp);
                }
            }
        }

        return (value);
    },

