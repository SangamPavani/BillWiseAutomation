                }

                this.TempResultForArithmeticOperation(dd1, dd2, this.m_sResult[i]);
            }
            else
            {
                if (this.m_sResult.charAt(i) == '@')//eg:-1
                {
                    i++;
                    flag = 1;//- vsl
                    continue;
                }

                if (this.m_sResult.charAt(i) == '$')//eg:+1
                {
