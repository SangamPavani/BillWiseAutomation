    searchInGrid: function (sSearch) {
        let iCounter = 0;
        let iIndex = 0;
        let arrRows = []; //int[]
        let objColumns = null; //object[]
        let sColumnData = "";

        try {
            if(DataType.isValidObject(CopyDocUI.m_GridHeader) == false) {
                return([]);
            }

            for (iCounter = 0; iCounter < CopyDocUI.m_GridHeader.children[1].children.length; iCounter++) {
                objColumns = CopyDocUI.m_GridHeader.children[1].children[iCounter];
                if (CopyDocUI.m_iSearchOn == 0) {
                    for (iIndex = 0; iIndex < objColumns.children.length; iIndex++) {
                        if (iIndex == 0) {
                            continue;
                        }

                        sColumnData = $(objColumns.children[iIndex]).text();
                        if (sColumnData == "") {
                            continue;
                        }

                        if (CopyDocUI.searchOnContent(sColumnData, sSearch) == true) {
                            arrRows.push(objColumns.children[iIndex].parentElement);
                        }
                    }
                }
                else {
                    sColumnData = $(objColumns).children("[data-columnid=" + "'" + CopyDocUI.m_iSearchOn + "']").text();// Search on Voucher Type Column
                    if (sColumnData == "") {
                        continue;
                    }

                    if (CopyDocUI.searchOnContent(sColumnData, sSearch) == true) {
                        arrRows.push($(objColumns).children("[data-columnid=" + "'" + CopyDocUI.m_iSearchOn + "']")[0].parentElement)
                    }
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.searchInGrid} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(arrRows);
    },

    searchOnContent: function (sColumnData, sSearch) {
        let sBegin = "";
        let sEnd = "";

        try {
            switch (CopyDocUI.m_SearchType) {
                case "Content":
                    if (sColumnData.toLowerCase().includes(sSearch.toLowerCase())) {
                        return(true);
                    }
                    break;
                case "Begin":
                    if (sColumnData.length > 0) {
                        if (sColumnData.length >= sSearch.length) {
                            sBegin = sColumnData.substr(0, sSearch.length);
                            if (sBegin.toLowerCase() == sSearch.toLowerCase()) {
                                return(true);
                            }
                        }
                    }
                    break;
                case "End":
                    if (sColumnData.length > 0) {
                        if (sColumnData.length >= sSearch.length) {
                            sEnd = sColumnData.substr(sColumnData.length - sSearch.length, sSearch.length);
                            if (sEnd.toLowerCase() == sSearch.toLowerCase()) {
                                return(true);
                            }
                        }
                    }
                    break;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{CopyDocUI.searchOnContent} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return(false);
    },

