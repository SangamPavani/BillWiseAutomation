    updateDisplayLinkValue: function (eleWorkflowGrid, iRow, dLinkValue, iLinkField) {
        let sArrColumnIndex = "";
        let iCounter = 0;
        let iIndex = 0;
        let iHiddenColumnCount = 0;
        let iNoOfDecimals = 0;
        let arrIndex = null;
        let cell = null;
        let value = null;

        try {
            cell = FGRIDCONTROL.getHeadingDataObject(eleWorkflowGrid, transEntryWorkflowInfo.HiddenPendingColumn);
            if (DataType.isValidObject(cell) == true) {
                sArrColumnIndex = cell.displayindex;
            }

            sArrColumnIndex = DataType.toString(sArrColumnIndex);
            if (DataType.isNullOrEmpty(sArrColumnIndex, true) == true) {
                return;
            }

            if (iLinkField == eTranEntryLinkValue.Quantity) {
                iNoOfDecimals = transEntryQuantity.getDecimals();
            }
            else {
                iNoOfDecimals = transEntrySettings.getDecimalsInAmount(0);
            }

            iHiddenColumnCount = WORKFLOW.getHiddenColumnCount();
            arrIndex = sArrColumnIndex.split(",");
            for (iCounter = 0; iCounter < arrIndex.length; iCounter++) {
                iIndex = DataType.toInt(arrIndex[iCounter]);
                if (iIndex < 1) {
                    continue;
                }

                cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, iIndex + iHiddenColumnCount + 1);
                if (DataType.isValidObject(cell) == true) {
                    cell.setCellText(DataType.formatToDecimalPlaces(dLinkValue, iNoOfDecimals), dLinkValue);
                }
            }

            cell = FGRIDCONTROL.getCellObject(eleWorkflowGrid, iRow, transEntryWorkflowInfo.HiddenPendingColumn);
            if (DataType.isValidObject(cell) == true) {
                dLinkValue = DataType.toDecimal(dLinkValue);
                cell.setCellText(dLinkValue, dLinkValue);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{WORKFLOW.updateDisplayLinkValue} " + err.message, "Exception");
        }
