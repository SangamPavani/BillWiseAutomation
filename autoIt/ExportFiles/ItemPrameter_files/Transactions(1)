    evaluateRuleCondition: function (arrRuleCondition, iRow, bLocal, value, objMasterInfo, iFieldId) {
        let sFormula = "";
        let sValue = "";
        let iCounter = 0;
        let arrIdNamePair = [];
        let objRuleCondition = undefined;
        let objFormulaInput = undefined;
        let objFormulaOutput = undefined;
        let objFormula = undefined;
        let result = undefined;

        try {
            result = {};
            result.sFormula = "";
            result.sResult = "";
            for (iCounter = 0; iCounter < arrRuleCondition.length; iCounter++) {
                objRuleCondition = arrRuleCondition[iCounter];
                if (DataType.toInt(iRow) < 1 && (bLocal == undefined || bLocal == false)) {
                    if (EntryMainUI.getBodyFieldInfo(objRuleCondition.FieldId).Area == eTranEntryFieldArea.Body) {
                        continue;
                    }
                }

                // every row of the rule
                sFormula += objRuleCondition.OpenBrackets;
                arrIdNamePair = [];

                arrIdNamePair.push({ ID: objRuleCondition.FieldId });

                sValue = value;
                if (bLocal == undefined || bLocal == false || (iFieldId > 0 && iFieldId != objRuleCondition.FieldId)) {
                    EntryMainCommon.getFieldValues(arrIdNamePair, true, false, iRow, objRuleCondition.FieldDBName, true);
                    if (arrIdNamePair[0].iDataTypeId != undefined && arrIdNamePair[0].iDataTypeId != null) {
                        objRuleCondition.DataTypeId = arrIdNamePair[0].iDataTypeId;
                        delete arrIdNamePair[0].iDataTypeId;
                    }

                    if (arrIdNamePair[0].Tag == null) {
                        sValue = "";
                    }
                    else {
                        if (objRuleCondition.DataTypeId == eMasterDataType.Master) {
                            sValue = arrIdNamePair[0].Tag;
                        }
                        else if (objRuleCondition.DataTypeId == eMasterDataType.StringList) {
                            sValue = arrIdNamePair[0].Tag;
                        }
                        else {
                            sValue = (DataType.isBoolean(arrIdNamePair[0].Tag) == true ? (arrIdNamePair[0].Tag == true ? "1" : "0") : DataType.toString(arrIdNamePair[0].Tag));
                        }
                    }
                }
                else {
                    if (objRuleCondition.DataTypeId == eMasterDataType.Master && DataType.isValidObject(objMasterInfo) && objMasterInfo.bMaster == true) {
                        if (objRuleCondition.FieldDBName == "sName") {
                            sValue = objMasterInfo.sName;
                        }
                        else if (objRuleCondition.FieldDBName == "sCode") {
                            sValue = objMasterInfo.sCode;
                        }
                        else { // iMasterId
                            sValue = objMasterInfo.iMasterId;
                        }
                    }
                }

                if (objRuleCondition.DataTypeId == eMasterDataType.Text) {
                    sFormula += "'" + sValue + "'";
                }
                else if (objRuleCondition.DataTypeId == eMasterDataType.StringList) {
                    sFormula += "'" + sValue + "'";
                }
                else if (objRuleCondition.DataTypeId == eMasterDataType.Master) {
                    if (objRuleCondition.FieldDBName == "sName") {
                        sValue = DataType.stringReplaceAll(sValue, "@", "\t");
                        sFormula += "'" + sValue + "'";
                    }
                    else if (objRuleCondition.FieldDBName == "sCode") {
                        sValue = DataType.stringReplaceAll(sValue, "@", "\t");
                        sFormula += "'" + sValue + "'";
                    }
                    else { // iMasterId
                        switch (objRuleCondition.OperatorId) {
                            case eRuleOperators.IsBlank:
                            case eRuleOperators.IsNotBlank:
                                if (DataType.toInt(sValue) == 0) {
                                    sFormula += "''";
                                }
                                else {
                                    sFormula += "'" + sValue + "'";
                                }
                                break;
                            default:
                                sFormula += sValue;
                                break;
                        }

                        //sFormula += sValue;
                    }
                }
                else if (objRuleCondition.DataTypeId == eMasterDataType.Boolean) {
                    sFormula += DataType.toBoolean(sValue) == true ? 1 : 0;
                }
                else {
                    sFormula += sValue;
                }

                sFormula += FConvert.getRuleOperator(objRuleCondition.OperatorId);

                switch (objRuleCondition.CompareWith) {
                    case eMasterCompareWith.Value:
                        if (objRuleCondition.DataTypeId == eMasterDataType.Text) {
                            switch (objRuleCondition.OperatorId) {
                                case eRuleOperators.IsBlank:
                                    break;
                                default:
                                    sFormula += "'" + objRuleCondition.Value + "'";
                                    break;
                            }

                            //sFormula += "'" + objRuleCondition.Value + "'";
                        }
                        else if (objRuleCondition.DataTypeId == eMasterDataType.StringList) {
                            sFormula += "'" + objRuleCondition.Value + "'";
                        }
                        else if (objRuleCondition.DataTypeId == eMasterDataType.Master) {
                            if (objRuleCondition.FieldDBName == "sName") {
                                sFormula += "'" + objRuleCondition.Value + "'";
                            }
                            else if (objRuleCondition.FieldDBName == "sCode") {
                                sFormula += "'" + objRuleCondition.Value + "'";
                            }
                            else { // iMasterId
                                sFormula += DataType.toString(objRuleCondition.LinkID);
                            }
                        }
                        else if (objRuleCondition.DataTypeId == eMasterDataType.Boolean) {
                            sFormula += DataType.toBoolean(objRuleCondition.Value) == true ? 1 : 0;
                        }
                        else {
                            sFormula += objRuleCondition.Value;
                        }

                        break;
                    case eMasterCompareWith.Field:
                        arrIdNamePair = [];
                        arrIdNamePair.push({ ID: objRuleCondition.LinkID });
                        EntryMainCommon.getFieldValues(arrIdNamePair, true, false, iRow, null, true);
                        if (arrIdNamePair[0].Tag == null) {
                            sValue = "";
                        }
                        else {
                            sValue = (DataType.isBoolean(arrIdNamePair[0].Tag) == true ? (arrIdNamePair[0].Tag == true ? "1" : "0") : DataType.toString(arrIdNamePair[0].Tag));
                        }

                        if (DataType.isValidObject(arrIdNamePair[0].iDataTypeId) == true) {
                            if (arrIdNamePair[0].iDataTypeId == eMasterDataType.Text) {
                                sValue = DataType.stringReplaceAll(sValue, "@", "\t");
                                sFormula += "'" + sValue + "'";
                            }
                            else if (arrIdNamePair[0].iDataTypeId == eMasterDataType.StringList) {
                                sFormula += "'" + sValue + "'";
                            }
                            else {
                                sFormula += sValue;
                            }

                            delete arrIdNamePair[0].iDataTypeId;
                        }
                        else {
                            sFormula += sValue;
                        }

                        break;
                    case eMasterCompareWith.Formula:
                        objFormulaInput = EntryMainFormula.createBodyFormulaInput(objRuleCondition.Value, iRow, null, -1);
                        objFormulaOutput = EntryMainFormula.evaluateBodyFormulaNew(objFormulaInput);

                        sFormula += objFormulaOutput.Value.toString();
                        break;
                }

                sFormula += objRuleCondition.CloseBrackets;

                if (iCounter != arrRuleCondition.length - 1) {
                    if (objRuleCondition.Conjunction == eConjunctionType.And) {
                        sFormula += "&&";
                    }
                    else {
                        sFormula += "||";
                    }
                }
            }

            objFormula = new FFormula();
            objFormula.m_CalType = transEntryInfo.CalendarType;
            objFormula.setRowIndex(iRow);
            objFormula.fnValueNeeded = "EntryMainFormula.formula_ValueNeeded";

            result.sFormula = sFormula;
            result.sResult = objFormula.Result(sFormula + "?1:0", false);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.evaluateRuleCondition} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

    updateBodyColumnValue: function (iRow, iColumn, value, objMetaData) {
        let sId = "";
        let iCounter = 0;
        let cell = null;
        let ele = null;

        try {
            if(objMetaData.iFieldId == eVTFIELDID.FDF_BODYQUANTITY) {
                transEntryQuantity.setValue(value, iRow, { bUpdateMemoryObject: true });
            }
            else if(objMetaData.iFieldId == eVTFIELDID.FDF_BODYRATE) {
                transEntryRate.setValue(value, iRow);
                EntryMainMemoryObject.update(eVTFIELDID.FDF_BODYRATE, value, iRow);
            }
            else {
                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.StringList:
                        sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        ele = document.getElementById(sId);

                        if (FUIElement.setDropdownValue(ele, value, true, true) != undefined) {
                            transEntryGrid.setCellText(iRow, iColumn, value, value);
                        }

                        //if (DataType.isValidObject(ele) == true) {
                        //    for (iCounter = 0; iCounter < ele.options.length; iCounter++) {
                        //        if (ele.options[iCounter].text == value) {
                        //            transEntryGrid.setCellText(iRow, iColumn, value, value);
                        //            break;
                        //        }
                        //    }
                        //}
                        break;
                    case eMasterDataType.NumberList:
                        sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        ele = document.getElementById(sId);

                        if (DataType.isValidObject(ele) == true) {
                            for (iCounter = 0; iCounter < ele.options.length; iCounter++) {
                                if (DataType.toInt(ele.options[iCounter].value) == DataType.toInt(value)) {
                                    transEntryGrid.setCellText(iRow, iColumn, ele.options[iCounter].text, ele.options[iCounter].value);
                                    break;
                                }
                            }
                        }
                        break;
                    case eMasterDataType.Master:
                    case eMasterDataType.ExternalTable:
                        if (EntryMainUI.isLinkRestrictd(iRow, objMetaData.iFieldId, true).Value == true) {
                            break;
                        }

                        if (EntryMainUI.isBillStatusRestricted(iRow, objMetaData.iFieldId, objMetaData) == true) {
                            break;
                        }

                        sId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        EntryMainBody.updateMasterValueFromId(sId, iRow, value, objMetaData);
                        break;
                    case eMasterDataType.Boolean:
                        cell = transEntryGrid.getCellObject(iRow, iColumn);
                        EntryMainBody.initBooleanColumn(cell, DataType.toBoolean(value), objMetaData.bReadOnly);
                        ele = cell.getControl();
                        if(DataType.isValidObject(ele) == true) {
                            ele.checked = DataType.toBoolean(value);
                        }
                        break;
                    default:
                        if (objMetaData.iDataTypeId == eMasterDataType.Fraction && objMetaData.iNoDecimal > 0) {
                            value = FNumberOperation.convert(value);
                            value = FNumberOperation.toFixed(value, objMetaData.iNoDecimal);
                        }

                        transEntryGrid.setCellText(iRow, iColumn, value, value);
                        break;
                }
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainRules.updateBodyColumnValue} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    }
