            obj = EntryMainPreload.isMasterVariable(objVar.Var);
            if (obj.Value == false) {
                return (result);
            }

            if (DataType.stringStartsWith(obj.sVariable.toLowerCase(), "mpb6c") == true
                || DataType.stringStartsWith(obj.sVariable.toLowerCase(), "mpb5c") == true) {
                iBookNo = EntryMainMemoryObject.getBookValue(iRowIndex);
            }

            if (DataType.isNullOrEmpty(obj.Layout, true) == false) {
                objLayout = transEntryFieldInfo.getFromFieldOrder(obj.iFieldOrder, obj.bBody);
                if (DataType.isValidObject(objLayout.MetaData) == false
                    || objLayout.MetaData.iDataTypeId != eMasterDataType.Master) {

                    result = {};
                    result.lValue = 1;
                    result.TimeDiff = "";
                    result.data = "";

                    return (result);
                }

                if (obj.bBody == true) {
                    ctrl = transEntryGrid.getCellObject(iRowIndex, objLayout.ColumnIndex);
                    iMasterId = DataType.toInt(ctrl.getCellData());
                }
                else {
                    EntryMainUI.getHeaderControlId(objLayout.FieldId);
                    iMasterId = DataType.toInt(OPTIONCONTROL.getControlValue(ctrl));
                }
            }
            else {
                iMasterId = transEntryGrid.getMasterValue(iRowIndex, obj.iMasterType, obj.bBook, obj.bInv2);
            }

            //iMasterId = transEntryGrid.getMasterValue(iRowIndex, obj.iMasterType, obj.bBook, obj.bInv2);

            value = transEntryCache.MASTER.getValue(obj.sVariable, iMasterId, iBookNo);
            if (value != undefined && value !== null) {
                result = {};
                result.lValue = 1;
                result.TimeDiff = "";

                if (iFactor >= 0) {
                    result.data = value;
                }
                else {
                    result.data = DataType.toDecimal(value) * iFactor;
                }

                return (result);
            }

            objWatch = new FStopWatch();
            objWatch.start();

            result = transEntryServer.execute(eTransServerRequest.GetMasterVariableValueForTran, { sVariableName: obj.sVariable, iMasterId: iMasterId, iBodyId: iBookNo });

            objWatch.stop();
            result.TimeDiff = "[Time=" + objWatch.getDifferenceString() + "]";

            transEntryGlobal.writeInfoLog("ServerCall::{GetMasterVariableValueForTran} " + result.TimeDiff, 2, "royalblue");

            if (result.lValue > 0) {
                transEntryCache.MASTER.setValue(obj.sVariable, iMasterId, iBookNo, result.data.data);

                if (iFactor >= 0) {
                    result.data = result.data.data;
                }
                else {
                    result.data = DataType.toDecimal(result.data.data) * iFactor;
                }
            }
            else {
                result.lValue = 1;
                result.data = 0;
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainMaster.processVariable} " + err.message, GlobalPref.getResourceValue("Exception"));
        }

        return (result);
    },

