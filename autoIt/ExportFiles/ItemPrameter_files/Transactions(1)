    processControlFocus: function (ctrl, evt, objCustomData) {
        let sText = "";
        let iRow = 0;
        let iColumn = 0;
        let iFieldId = 0;

        try {
            sText = FPOPUPCONTROL.getControlText(ctrl);
            if (DataType.isNullOrEmpty(sText, true) == false) {
                FUIElement.selectText(ctrl, 0, sText.length);
                return;
            }

            iRow = FPOPUPCONTROL.getCurrentRow(ctrl);
            iColumn = FPOPUPCONTROL.getCurrentColumn(ctrl);

            iFieldId = EntryMainUI.extractBodyFieldId(ctrl.id);

            EntryMainBins.openPopup(iRow,
                                    iColumn - transEntryGrid.gridExtraColumn(),
                                    iFieldId,
                                    objCustomData,
                                    transEntryInfo.Settings.Inventory.BinsPick > 0);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.processControlFocus} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    onControlDropdown_Click: function (ctrl, evt) {
        let iRow = 0;
        let iColumn = 0;

        try {
            iRow = FPOPUPCONTROL.getCurrentRow(ctrl);
            iColumn = FPOPUPCONTROL.getCurrentColumn(ctrl);

            iFieldId = EntryMainUI.extractBodyFieldId(ctrl.id);
            EntryMainBins.openPopup(iRow, iColumn - transEntryGrid.gridExtraColumn(), iFieldId, null, false);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.onControlDropdown_Click} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getBinsInput: function (iRow, iColumn, bAutoAllocate, objOutput) {
        let iVoucherType = 0;
        let iBodyId = 0;
        let iExcludeBins = 0;
        let bDoNotMaintainBins = false;
        let obj = undefined;
        let objData = undefined;
        let result = undefined;
        let objFieldInfo = undefined;
        let arrPreviousQty = undefined;
        let arrLoaded = undefined;
        let arrRMA = undefined;

        try {
            if (transEntryGlobal.debugBins == true) {
                debugger
            }

            bDoNotMaintainBins = DataType.toBoolean(transEntryInvTag.getDataValue(iRow, "bDontMaintainBin"));
            if (bDoNotMaintainBins == true) {
                return;
            }


            iVoucherType = transEntryInfo.VoucherType;

            obj = {};
            obj.VoucherType = 0; // int
            obj.ProductId = 0; // int
            obj.ProductWeight = 0; // decimal
            obj.UnitId = 0; // int            
            obj.sUnitName = "";
            obj.BatchId = 0; // long
            obj.Batch = ""; // string
            obj.Quantity = 0; // decimal Base Quantity
            obj.DecimalsInQty = transEntryQuantity.getDecimals(iRow);
            obj.UnitConv = 1;
            obj.ProductCapacity = 0; // decimal
            obj.WarehouseId = 0; // int Inv Tag
            obj.WMSReqTransId = []; // long
            obj.RefId = []; // long
            obj.HeaderId = 0; // int
            obj.TransactionId = []; // long
            obj.BingroupId = 0; // int
            obj.InwardBin = false; // bool
            obj.DefaultBinId = []; // int[]
            obj.DefaultBinId.push(0);
            obj.SingleSelection = false; // bool
            obj.AllocationTag = 0; // int
            obj.OldAllocations = []; // IdNamePair[]
            obj.ExcludedBins = []; // int[]
            obj.PreviousQuantity = []; // BinsQuantity[]
            obj.WMS = false; // bool
            obj.WMS3PL = false; // bool
            obj.RMA = "";

            obj.ProductId = EntryMainMemoryObject.getProductValue(iRow);
            if (obj.ProductId < 1) {
                return;
            }

            obj.ProductWeight = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "fweight", eMasterDataType.Fraction);

            obj.WarehouseId = transEntryFields.getInvTag(iRow);

            if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) {
                obj.BatchId = transEntryBatch.getBatchId(iRow);
                obj.Batch = transEntryBatch.getBatchNo(iRow);
            }

            result = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRow);
            if (DataType.arrayLength(result) > 0) {
                if (FConvert.isItWMSConfirm(iVoucherType) == true) {
                    obj.WMSReqTransId.push(result[0].RefId);
                }
                else {
                    obj.RefId.push(result[0].RefId);
                }
            }

            arrPreviousQty = transEntryFields.getBins(iRow);

            if (iVoucherType == eVTTYPE.WMSDISPREQ) {
                obj.DefaultBinId[0] = transEntryInfo.WMSPref.iDefaultBinShipping;
            }
            else if (iVoucherType == eVTTYPE.WMSPICKLIST) {
                obj.DefaultBinId[0] = 2; // Filter for non Stage type bins
            }
            else if (iVoucherType == eVTTYPE.WMSRTS) {
                objFieldInfo = transEntryFieldInfo.ReceiptType;
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    result = document.getElementById(EntryMainUI.getHeaderControlId(objFieldInfo.FieldId));

                    if (DataType.isValidObject(result) == true && result.value == "1") {
                        objOutput.iReceivingFloor = 0;
                        if (transEntryInvTag.getArea() == eTranEntryFieldArea.Header) {
                            objOutput.iReceivingFloor = DataType.toInt(transEntryInvTag.getDataValue(0, "iDefaultreceivingFloor"));
                        }

                        obj.DefaultBinId[0] = 3; // Filter for Floor type bins
                    }
                }
            }
            else if (iVoucherType == eVTTYPE.MATRN || iVoucherType == eVTTYPE.PURCH) {
                if (DataType.arrayLength(arrPreviousQty) <= 0) {
                    objOutput.iReceivingFloor = 0;
                    if (transEntryInvTag.getArea() == eTranEntryFieldArea.Header) {
                        objOutput.iReceivingFloor = DataType.toInt(transEntryInvTag.getDataValue(0, "iDefaultreceivingFloor"));
                    }

                    if (objOutput.iReceivingFloor == 0) {
                        objOutput.iReceivingFloor = transEntryInfo.WMSPref.iDefaultBinShipping;
                    }
                }
            }

            if (transEntryFieldInfo.Unit.ColumnIndex > -1) {
                obj.UnitId = EntryMainMemoryObject.getUnitValue(iRow);
                obj.sUnitName = transEntryGrid.getCellText(iRow, transEntryFieldInfo.Unit.ColumnIndex).sText;
            }

            obj.ProductCapacity = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iBinCapacity", eMasterDataType.Text);
            obj.Quantity = FNumberOperation.abs(EntryMainMemoryObject.getBaseQuantityValue(iRow, true));
            obj.UnitConv = transEntryUnit.getConversionValue(iRow);

            obj.HeaderId = transEntryInfo.HeaderId;
            if (obj.HeaderId > 0) {
                iBodyId = transEntryFields.getBodyId(iRow);
                arrLoaded = DataType.arrayFilterData(transEntryGlobal.arrLoadedData, eTranEntryBodyDataConstKey.BodyId, iBodyId, "===");
                if (arrLoaded.length > 0) {
                    obj.TransactionId = [arrLoaded[0].TransactionId];
                    if (obj.PreviousQuantity.length == 0) {
                        obj.PreviousQuantity = arrLoaded[0].BinsData;
                    }
                }
            }

            obj.InwardBin = transEntryInfo.isInwardVoucher;
            obj.VoucherType = eVTTYPE.getBaseVoucherType(iVoucherType);

            if (transEntryFieldInfo.Bins2.ColumnIndex > -1) {
                result = transEntryFields.getBins2(iRow);
                if (DataType.isValidObject(result) == true) {
                    obj.SingleSelection = result.length > 1;
                }
            }

            if (transEntryFieldInfo.Skid.ColumnIndex > -1
                && obj.InwardBin == true
                && transEntryFieldInfo.Bins2.ColumnIndex < 0) {
                obj.SingleSelection = true;
            }

            obj.OldAllocations = EntryMainBins.getUsedBinsList(iRow, false);
            obj.AllocationTag = transEntryFields.getAllocationTag(iRow);

            if (DataType.arrayLength(arrPreviousQty) > 0) {
                obj.PreviousQuantity = arrPreviousQty; // BinsQuantity[] 
            }

            //objBinColumn = transEntryGrid.getCellObject(iRow, iColumn);
            //result = DataType.stringToObject(objBinColumn.getCellData());
            //if (result.lValue > 0) {
            //    obj.PreviousQuantity = result.data; // BinsQuantity[]
            //}

            obj.MaintainByUnit = transEntryInfo.WMSPref.MaintainByUnit;
            obj.WMS = EntryMain.isModuleImplemented(eModulesImplemented.WMS);
            obj.WMS3PL = EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL);
            if (obj.WMS3PL == true) {
                obj.WMS = true;
            }

            if (eVTTYPE.getBaseVoucherType(iVoucherType) == eVTTYPE.WMSPICKLIST 
                && transEntryInfo.Settings.Inventory.DoNotCheckReceivingFloor == true) {

                iExcludeBins = DataType.toInt(transEntryInvTag.getDataValue(iRow, "iDefaultreceivingFloor"));
                if(iExcludeBins > 0) {
                    obj.ExcludedBins.push(iExcludeBins);
                }
            }


            if (EntryMainUI.isQtyRestricted(iRow) == true) {
                arrRMA = EntryMainUI.getValue(transEntryFieldInfo.RMA, iRow);
                if (DataType.arrayLength(arrRMA) > 0) {
                    obj.RMA = arrRMA[0];
                }
            }

            objData = {};
            objData.Input = obj;
            objData.Preference = transEntryGlobal.EntryModel.Preference;
            objData.PopupContainer = EntryMainUI.getOthersContainer();
            objData.sResultCallback = "EntryMainCallback.binsResult";
            objData.sPopupStatusCallback = "EntryMain.popupStatus";
            objData.CustomData = {};
            objData.CustomData.iRow = iRow;
            objData.CustomData.iColumn = iColumn;
            objData.CustomData.iFieldId = eVTFIELDID.FDF_BINS;
            objData.CustomData.iBodyId = transEntryFields.getBodyId(iRow);
            objData.CustomData.iUnitId = obj.UnitId;
            objData.CustomData.iProductId = obj.ProductId;
            objData.CustomData.sBatch = obj.Batch;
            objData.CustomData.BatchId = obj.BatchId;
            objData.CustomData.AllocationTag = obj.AllocationTag;
            objData.CustomData.bFromAutoAllocate = bAutoAllocate;

            return(objData);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.getBinsInput} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    getBins2Input: function (iRow, iColumn, bAutoAllocate1, objCustomData) {
        let sId = "";
        let iVoucherType = 0;
        let iCounter = 0;
        let iDefaultShippingBin = 0;
        let bDoNotMaintainBins = false;
        let bAutoAllocate = false;
        let obj = null;
        let objData = null;
        let result = null;
        let objBinColumn = null;
        let objMetaData = null;        
        let arrBin = [];
        let arrFromBin = [];
        let arrOldBins = [];
        let arrTemp = null;
        let ele = null;
        let arrBinData = null;
        let arrFields = undefined;
        let objFieldInfo = undefined;

        try {
            if (transEntryGlobal.debugBins == true) {
                debugger
            }

            bDoNotMaintainBins = DataType.toBoolean(transEntryInvTag.getValueForBins(iRow, true, "bDontMaintainBin"));
            if (bDoNotMaintainBins == true) {
                return;
            }

            bAutoAllocate = transEntryInfo.WMSPref.bAutoAllctInBinStrtgy;
            iVoucherType = transEntryInfo.VoucherType;

            obj = {};
            obj.VoucherType = 0; // int
            obj.ProductId = 0; // int
            obj.ProductWeight = 0; // decimal
            obj.UnitId = 0; // int
            obj.sUnitName = "";
            obj.BatchId = 0; // long
            obj.Batch = ""; // string
            obj.Quantity = 0; // decimal Base Quantity
            obj.DecimalsInQty = transEntryQuantity.getDecimals(iRow);
            obj.UnitConv = 1;
            obj.ProductCapacity = 0; // decimal
            obj.WarehouseId = 0; // int Inv Tag
            obj.WMSReqTransId = []; // long
            obj.RefId = []; // long
            obj.HeaderId = 0; // int
            obj.TransactionId = []; // long
            obj.BingroupId = 0; // int
            obj.InwardBin = false; // bool
            obj.DefaultBinId = []; // int[]
            obj.DefaultBinId.push(0);
            obj.SingleSelection = false; // bool
            obj.AllocationTag = 0; // int
            obj.OldAllocations = []; // IdNamePair[]
            obj.ExcludedBins = []; // int[]
            obj.PreviousQuantity = []; // BinsQuantity[]
            obj.WMS = false; // bool
            obj.WMS3PL = false; // bool
            obj.RMA = "";

            obj.ProductId = EntryMainMemoryObject.getProductValue(iRow);
            if (obj.ProductId < 1) {
                return;
            }

            obj.ProductWeight = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "fweight", eMasterDataType.Fraction);

            obj.MaintainByUnit = transEntryInfo.WMSPref.MaintainByUnit;
            obj.WMS = EntryMain.isModuleImplemented(eModulesImplemented.WMS);
            obj.WMS3PL = EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL);
            if (obj.WMS3PL == true) {
                obj.WMS = true;
            }


            obj.VoucherType = eVTTYPE.getBaseVoucherType(iVoucherType);
            obj.WarehouseId = transEntryInvTag.getValueForBins(iRow, true);

            objFieldInfo = transEntryFieldInfo.RctIssue;
            if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                sId = EntryMainUI.getHeaderControlId(objFieldInfo.FieldId);
                ele = document.getElementById(sId);
                if (ele.selectedIndex != -1 && DataType.toInt(ele.options[ele.selectedIndex].value)) {
                    arrTemp = DataType.arrayFilterData(transEntryGlobal.EntryModel.MetaData.Header,
                                                        ["iDataTypeId", "iMasterTypeId", "iFieldId", "iFieldId"],
                                                        [eMasterDataType.Master, 0, eVTFIELDID.FDF_CODE, eVTFIELDID.FDF_BOOKNO],
                                                        ["===", ">", "!=", "!="]);

                    for (iCounter = 0; iCounter < DataType.arrayLength(arrTemp); iCounter++) {
                        objMetaData = arrTemp[iCounter];
                        if (objMetaData.iMasterTypeId != transEntryInfo.InvTag) {
                            continue;
                        }

                        sId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                        obj.WarehouseId = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                        break;
                    }
                }
                else {
                    arrFields = transEntryFieldInfo.getTags(true);
                    for (iCounter = 0; iCounter < arrFields.length; iCounter++) {
                        objMetaData = arrFields[iCounter].MetaData;
                        if (objMetaData.iMasterTypeId != transEntryInfo.InvTag) {
                            continue;
                        }

                        arrTemp = transEntryGrid.getCellText(iRow, arrFields[iCounter].ColumnIndex, true);
                        if (arrTemp.lValue > 0) {
                            obj.WarehouseId = DataType.toInt(arrTemp.value);
                        }

                        break;
                    }
                }
            }
            else {
                objFieldInfo = transEntryFieldInfo.BodyInvTag;
                if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                    sId = EntryMainUI.getHeaderControlId(objFieldInfo.FieldId);
                    obj.WarehouseId = DataType.toInt(OPTIONCONTROL.getControlValue(sId));
                    if (EntryMain.isModuleImplemented(eModulesImplemented.WMS) == true || EntryMain.isModuleImplemented(eModulesImplemented.WMS3PL) == true) {
                        iDefaultShippingBin = DataType.toInt(OPTIONCONTROL.getControlValue(sId, "idefaultshippingfloor"));
                    }
                }
                else if (objFieldInfo.Area == eTranEntryFieldArea.Body) {
                    arrTemp = transEntryGrid.getCellText(iRow, objFieldInfo.ColumnIndex, true);
                    if (arrTemp.lValue > 0) {
                        obj.WarehouseId = DataType.toInt(arrTemp.value);
                    }
                }
            }

            if (FConvert.isItWMSConfirm(iVoucherType) == true) {
                arrTemp = EntryMainUI.getValue({ FieldId: eVTFIELDID.FDF_LINK }, iRow);
                if (DataType.arrayLength(arrTemp) > 0) {
                    obj.WMSReqTransId.push(arrTemp[0].RefId);
                }
            }

            if (transEntryFieldInfo.BatchNo.ColumnIndex > -1) {
                obj.BatchId = transEntryBatch.getBatchId(iRow);
                obj.Batch = transEntryBatch.getBatchNo(iRow);
            }

            arrOldBins = EntryMainBins.getUsedBinsList(iRow, true, true);

            obj.Quantity = FNumberOperation.abs(EntryMainMemoryObject.getBaseQuantityValue(iRow, true));
            obj.UnitConv = transEntryUnit.getConversionValue(iRow);

            arrBin = [];
            if (eVTTYPE.getBaseVoucherType(iVoucherType) == eVTTYPE.WMSPICKLIST) {
                if (iDefaultShippingBin > 0) {
                    obj.DefaultBinId[0] = iDefaultShippingBin;
                }
                else {
                    obj.DefaultBinId[0] = transEntryInfo.WMSPref.iDefaultBinShipping;
                    if(obj.DefaultBinId[0] > 0) {
                        result = transEntryServer.execute(eTransServerRequest.IsBinFromWarehouse, { iBinId: obj.DefaultBinId[0], iWarehouseId: obj.WarehouseId });
                        if (result.lValue > 0) {
                            result = result.data;
                            if (result.lValue > 0) {
                                obj.DefaultBinId[0] = result.data == false ? 0 : obj.DefaultBinId[0];
                            }
                            else {
                                obj.DefaultBinId[0] = 0;
                            }
                        }
                        else {
                            obj.DefaultBinId[0] = 0;
                        }
                    }
                }

                if (obj.DefaultBinId[0] > 0 && arrOldBins.length == 0) {
                    arrBin.push(EntryMainBins.getBinsQuantityObject());
                    arrBin[0].BodyId = transEntryFields.getBodyId(iRow);
                    arrBin[0].Item = obj.ProductId;
                    arrBin[0].BinId = obj.DefaultBinId[0];
                    arrBin[0].Quantity = EntryMainMemoryObject.getBaseQuantityValue(iRow, true);

                    if (DataType.isValidObject(objCustomData) == true) {
                        arrBin[0].AllocTag = objCustomData.AllocationTag;
                        transEntryBins.copyWMSInfo(arrBin[0], objCustomData);
                    }
                }
                else {
                    obj.DefaultBinId[0] = 1; // Filter for Floor, and Stage type bins
                    bAutoAllocate = false;
                }
            }
            else if (eVTTYPE.getBaseVoucherType(iVoucherType) == eVTTYPE.WMSPUTAWAY) {
                obj.DefaultBinId[0] = 2; // Filter for non Stage type bins
            }

            if (arrBin.length == 0) {
                obj.OldAllocations = EntryMainBins.getUsedBinsList(iRow, true, false); // arrOldBinsDiffRows

                if (transEntryFieldInfo.Unit.ColumnIndex > -1) {
                    obj.UnitId = EntryMainMemoryObject.getUnitValue(iRow);
                    obj.sUnitName = transEntryGrid.getCellText(iRow, transEntryFieldInfo.Unit.ColumnIndex).sText;
                }

                obj.ProductCapacity = transEntryFields.getMandatoryValue(transEntryFieldInfo.Item, iRow, "iBinCapacity", eMasterDataType.Fraction);

                objBinColumn = transEntryGrid.getCellObject(iRow, transEntryFieldInfo.Bins.ColumnIndex);
                result = DataType.stringToObject(objBinColumn.getCellData());
                if (result.lValue > 0) {
                    arrFromBin = result.data; // BinsQuantity[] 
                }
                else {
                    arrFromBin = []; // BinsQuantity[] 
                }

                obj.ExcludedBins = [];
                if (obj.VoucherType != eVTTYPE.WMSMOVEREQ && obj.VoucherType != eVTTYPE.WMSMOVECONF) {
                    if (arrFromBin.length > 0) {
                        for (iCounter = 0; iCounter < arrFromBin.length; iCounter++) {
                            obj.ExcludedBins.push(arrFromBin[iCounter].BinId);
                        }
                    }
                }

                if (arrFromBin.length > 0) {
                    obj.SingleSelection = true;
                }

                obj.InwardBin = true;
                obj.AllocationTag = transEntryFields.getAllocationTag(iRow);

                objBinColumn = transEntryGrid.getCellObject(iRow, iColumn);
                result = DataType.stringToObject(objBinColumn.getCellData());
                if (result.lValue > 0) {
                    obj.PreviousQuantity = result.data; // BinsQuantity[] 
                }

                arrBinData = transEntryFields.getBins(iRow);

                objData = {};
                objData.Input = obj;
                objData.Preference = transEntryGlobal.EntryModel.Preference;
                objData.PopupContainer = EntryMainUI.getOthersContainer();
                objData.sResultCallback = "EntryMainCallback.binsResult";
                objData.sPopupStatusCallback = "EntryMain.popupStatus";
                objData.CustomData = {};
                objData.CustomData.iRow = iRow;
                objData.CustomData.iColumn = iColumn;
                objData.CustomData.iFieldId = eVTFIELDID.FDF_BINS2;
                objData.CustomData.iBodyId = transEntryFields.getBodyId(iRow);
                objData.CustomData.iUnitId = obj.UnitId;
                objData.CustomData.iProductId = obj.ProductId;
                objData.CustomData.AllocationTag = obj.AllocationTag;
                objData.CustomData.bFromAutoAllocate = bAutoAllocate1;

                transEntryBins.copyWMSInfo(objData.CustomData);

                if(DataType.arrayLength(arrBinData) > 0) {
                    transEntryBins.copyWMSInfo(objData.CustomData, arrBinData[0]);
                }

                return(objData);
            }
            else {
                if (DataType.isNullOrEmpty(arrBin[0].BinName) == true) {
                    result = transEntryServer.execute(eTransServerRequest.GetBinsDisplay, { arrBinsData: arrBin} );
                    if (result.lValue > 0) {
                        result = result.data;
                        if (result.lValue > 0) {
                            arrBin[0].BinName = result.data;
                        }
                    }
                }

                arrBinData = transEntryFields.getBins(iRow);

                if (eVTTYPE.getBaseVoucherType(iVoucherType) == eVTTYPE.WMSPICKLIST) {
                    if (DataType.arrayLength(arrBinData) > 0) {
                        for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                            transEntryBins.copyWMSInfo(arrBin[iCounter], arrBinData[0]);
                            arrBin[iCounter].AllocTag = arrBinData[0].AllocTag;
                        }
                    }
                }

                objData = {};
                objData.LeaveData = {};
                objData.LeaveData.arrData = arrBin;
                objData.LeaveData.bFromPopup = false;
                objData.LeaveData.objCustomData = {};
                objData.LeaveData.objCustomData.iRow = iRow;
                objData.LeaveData.objCustomData.iColumn = iColumn;
                objData.LeaveData.objCustomData.iFieldId = eVTFIELDID.FDF_BINS2;
                objData.LeaveData.objCustomData.bFromAutoAllocate = bAutoAllocate1;

                if(DataType.arrayLength(arrBinData) > 0) {
                    transEntryBins.copyWMSInfo(objData.LeaveData.objCustomData, arrBinData[0]);
                }

                if (transEntryGrid.getCurrentRow() == -1 && transEntryGrid.getCurrentColumn() == -1) {
                    EntryMainCallback.binsResult(true, arrBin, objData.LeaveData.objCustomData);
                }
                else {
                    transEntryGrid.moveToNextCell(event, objData);
                }

                //transEntryGrid.moveToNextCell(event, objData);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.getBins2Input} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

    processBins2Data: function (arrBin, bFromPopup, objCustomData) {
        let iCounter = 0;
        let iVoucherType = 0;
        let bUseAllocTag = false;
        let objBinColumn = null;
        let result = null;
        let arrIsues = null;
        let lstTempBin = null;
        let obj = null;

        try {
            if (DataType.isValidObject(arrBin) == false || DataType.arrayLength(arrBin) < 1) {
                return;
            }

            iVoucherType = transEntryInfo.VoucherType;
            if (transEntryFieldInfo.AllocationTag.Area != eTranEntryFieldArea.None 
                && (FConvert.isItInwardVoucher(iVoucherType) || FConvert.isItTransfer(iVoucherType))) {
                bUseAllocTag = true;
            }

            if (bFromPopup == true) {
                for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                    arrBin[iCounter].BodyId = objCustomData.iBodyId;
                    arrBin[iCounter].UnitId = objCustomData.iUnitId;
                    arrBin[iCounter].Item = objCustomData.iProductId;
                    transEntryBins.copyWMSInfo(arrBin[iCounter], objCustomData);

                    if (bUseAllocTag == true) {
                        arrBin[iCounter].AllocTag = objCustomData.AllocationTag;
                    }
                }
            }

            arrIsues = [];
            objBinColumn = transEntryGrid.getCellObject(objCustomData.iRow, transEntryFieldInfo.Bins.ColumnIndex);
            result = DataType.stringToObject(objBinColumn.getCellData());
            if (result.lValue > 0) {
                arrIsues = result.data; // BinsQuantity[] 
            }

            if (arrIsues.length > 1) {
                for (iCounter = 0; iCounter < arrBin.length; iCounter++) {
                    if (transEntryFieldInfo.ToSkid.ColumnIndex > -1) {
                        result = transEntryGrid.getCellText(objCustomData.iRow, transEntryFieldInfo.ToSkid.ColumnIndex);
                        if (result.lValue > 0) {
                            arrBin[iCounter].SkidId = DataType.toInt(result.value);
                        }
                        else {
                            arrBin[iCounter].SkidId = 0;
                        }
                    }
                    else {
                        arrBin[iCounter].SkidId = arrIsues[0].SkidId;
                    }

                    arrBin[iCounter].AllocTag = arrIsues[0].AllocTag;
                }

                if (arrBin.length == 1) {
                    lstTempBin = DataType.createDuplicateObject(arrBin);
                    lstTempBin[0].Quantity = arrIsues[0].Quantity;

                    for (iCounter = 1; iCounter < arrIsues.length; iCounter++) {
                        obj = DataType.createDuplicateObject(arrIsues[iCounter]);
                        lstTempBin.push(obj);
                        lstTempBin[lstTempBin.length - 1].BinId = lstTempBin[0].BinId;
                    }

                    arrBin = lstTempBin;
                }
            }

            EntryMainBins.splitRowForBins(objCustomData.iRow, objCustomData.iColumn, arrBin, true);
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainBins.processBins2Data} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

