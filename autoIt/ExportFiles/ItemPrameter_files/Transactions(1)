                else if (objExchangeRateInfo.Area == eTranEntryFieldArea.Body
                    && objMetaData.iFieldId == eVTFIELDID.FDF_BODYEXCHANGERATE) {
                    switch (eUIRestriction) {
                        case eTranEntryUIRestriction.PDCHeader:
                            transEntryGlobal.arrBodyReadOnly.push(obj.MetaDataIndex);
                            sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                            eleCtrl = document.getElementById(sCtrlId);
                            if (DataType.isValidObject(eleCtrl) == true) {
                                eleCtrl.readOnly = true;
                            }

