                        }
                    }
                }
            }
            BinsUI.updateBalance();
            BINS.displayFooterSum();
        }
        catch (err) {
            COMMON.prototype.showMessage("{BINS.AutoAllocateBin} " + err.message, "EXCEPTION")
        }
