        let arrProductIds = null;
        let arrFoundIndex = null;

        try {
            if (DataType.arrayLength(arrSetInfo) < 1 || iStartRow > iEndRow) {
                return;
            }

            for (iRow = iStartRow; iRow <= iEndRow; iRow++) {
                iSetId = EntryMainSet.getId(iRow);
                if (iSetId < 1) { // No set found in current row
                    iSetRowCount = 0;
                    EntryMainSet.setSetQty(iRow, "", 0);

                    continue;
                }

                iSetDataIndex = DataType.arrayContains(arrSetInfo, DataType.toInt(iSetId), "iSetId");
                if (iSetDataIndex == -1) { // No set detail info found
                    iSetRowCount = 0;
                    EntryMainSet.setSetQty(iRow, "", 0);

                    continue;
                }

                if (iLastSetId != iSetId) {
                    iSetRowCount = 0;

                    iCount = 0;
                    iFoundIndex = -1;

                    arrProductIds = DataType.arrayFromCSV(arrSetInfo[iSetDataIndex].ProductIds);
                    if(DataType.arrayLength(arrProductIds) > 0) {
                        for (iIndex = iRow; iIndex <= iEndRow; iIndex++) {
