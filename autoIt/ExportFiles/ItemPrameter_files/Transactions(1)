    onControlFocus: function (ele, evt) {
        let sCtrlId = "";
        let iFieldId = 0;
        let iIndex = 0;
        let iDataTypeId = 0;
        let iParty = 0;
        let bBody = false;
        let arrSeriesData = null;
        let objMetaData = null;
        let eleTemp = null;
        let result = null;
        let objFieldInfo = undefined;
        let obj = null;

        try {
            if (transEntryGlobal.debugHeader == true) {
                debugger
            }

            if (transEntryGlobal.Version == eVersion.Version9) {
                TRANSACTION_ENTRY.WORKFLOW.updateWorkflowPanel(false);
            }

            iFieldId = DataType.toInt(FUIElement.getAttribute(ele, "ifieldid"));
            if (iFieldId == 0) {
                iFieldId = EntryMainUI.extractHeaderFieldId(ele.id);
            }

            objFieldInfo = transEntryFieldInfo.getFromFieldId(iFieldId, eTranEntryFieldArea.Header);
            iIndex = objFieldInfo.MetaDataIndex;
            if (objFieldInfo.FieldId > 0) {                                
                objMetaData = objFieldInfo.MetaData;
                if(objMetaData.iFieldId == eVTFIELDID.FDF_DATE && DataType.isZero(EntryMain.m_DocDate) == true) {
                    EntryMain.m_DocDate = EntryMain.m_objTrans.Header.Date;
                }
            }
            else if (transEntryInfo.BodySectionNotRequired == true) {
                objFieldInfo = EntryMainUI.getBodyFieldInfo(iFieldId);

                iIndex = objFieldInfo.MetaDataIndex;
                objMetaData = objFieldInfo.MetaData;
                if (iIndex >= 0) {                    
                    bBody = true;
                }
            }

            if (iIndex >= 0) {
                switch (objMetaData.iDataTypeId) {
                    case eMasterDataType.Date:
                        EntryMainHeader.onDateControl_Focus(objMetaData);
                        break;
                    default:
                        if (bBody == true) {
                            sCtrlId = EntryMainUI.getBodyControlId(objMetaData.iFieldId);
                        }
                        else {
                            sCtrlId = EntryMainUI.getHeaderControlId(objMetaData.iFieldId);
                        }
                        result = FCommon.UI.getElementValueBasedOnDataTypeId(sCtrlId, objMetaData.iDataTypeId);

                        result = EntryMainPreload.evaluateHeaderMasterVariables(objMetaData.sDefaultValue, result.lValue > 0 ? result.data : null);
                        if (result.lValue > 0) {
                            eleTemp = document.getElementById(sCtrlId);

                            switch (objMetaData.iDataTypeId) {
                                case eMasterDataType.Number:                                
                                case eMasterDataType.BigNumber:
                                case eMasterDataType.SmallNumber:
                                case eMasterDataType.TinyNumber:
                                    eleTemp.value = Math.round(result.data, objMetaData.iNoDecimal);
                                    break;
                                case eMasterDataType.Fraction:
                                    if (objMetaData.iNoDecimal == 0) {
                                        eleTemp.value = Math.round(result.data, objMetaData.iNoDecimal);
                                    }
                                    else {
                                        eleTemp.value = DataType.toDecimal(result.data, objMetaData.iNoDecimal);
                                    }
                                    break;
                                default:
                                    eleTemp.value = result.data;
                                    break;
                            }
                        }
                        break;
                }
            }

            iDataTypeId = FUIElement.getAttribute(ele, "datatypeid");
            if (DataType.isValidObject(iDataTypeId) == true) {
                switch (DataType.toInt(iDataTypeId)) {
                    case eMasterDataType.Text:
                    case eMasterDataType.Number:
                    case eMasterDataType.Fraction:
                    case eMasterDataType.BigNumber:
                    case eMasterDataType.SmallNumber:
                    case eMasterDataType.TinyNumber:
                        ele.setAttribute("data-lastvalue", ele.value);
                        break;
                    case eMasterDataType.NumberList:
                        if (ele.selectedIndex > -1) {
                            ele.setAttribute("data-lastvalue", ele.options[ele.selectedIndex].value);
                        }
                        else {
                            ele.setAttribute("data-lastvalue", "");
                        }
                        break;
                }
            }

            if (iFieldId == eVTFIELDID.FDF_BODYAMOUNT) { // For 'Select Bills before Amount' Receipt
                ele.setAttribute("data-olddata", DataType.toDecimal(ele.value));
            }
            else if (transEntryFieldInfo.ChequeNo.MetaDataIndex > -1) {
                if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header
                    && transEntryFieldInfo.ChequeNo.FieldId == iFieldId) {
                    ele.setAttribute("data-olddata", DataType.toString(ele.value));
                }
            }

            EntryMainHeader.applyRuleOnFocus(iFieldId);

            if (EntryMain.isDataLoading() == false && DataType.isValidObject(objMetaData) == true && (objMetaData.iBehaviour == 5 || objMetaData.iBehaviour == 6)) {
                switch(objMetaData.iDataTypeId)
                {
                    case eMasterDataType.Number:
                    case eMasterDataType.Text:
                        if (DataType.isNullOrEmpty(ele.value) == true) {
                            //if(objMetaData.iDataTypeId == eMasterDataType.Text) {
                            //    arrSeriesData = EntryMain.generateNumberFromSeries(objMetaData.IncrementalSeries);

                            //    obj = {};
                            //    obj.arrSeriesDef = objMetaData.IncrementalSeries;
                            //    obj.arrData = arrSeriesData;
                            //    obj.sFieldName = objMetaData.sFieldName;
                            //    obj.iVoucherType = transEntryInfo.VoucherType;


                            //    transEntryServer.execute(eTransServerRequest.GetNextTextIncrementalFromSeries,
                            //                                obj,
                            //                                true, 
                            //                                "EntryMainCallback.getNextTextIncrementalFromSeries",
                            //                                { bHeader: true, objMetaData: objMetaData });
                            //}
                            if (objMetaData.iDataTypeId == eMasterDataType.Text || objMetaData.iDataTypeId == eMasterDataType.Number) {
                                if (objMetaData.iBehaviour == 6) {
                                    iParty = transEntryGrid.getMasterValue(0, 1);
                                }

                                obj = {};
                                obj.iVoucherType = transEntryInfo.VoucherType;
                                obj.iParty = iParty;
                                obj.sFieldName = objMetaData.sFieldName;
                                obj.bHeader = true;

                                transEntryServer.execute(eTransServerRequest.GetNextNumberForField,
                                                            obj, 
                                                            true, 
                                                            "EntryMainCallback.getNextNumberForField",
                                                            { bHeader: true, objMetaData: objMetaData });
                            }
                        }
                        break;
                }

            }

            if (transEntryInfo.CDIDExternalModulesRights == true // CDID.ModulesRights.FARights.ExternalModules
                && DataType.isValidObject(objMetaData) == true
                && DataType.arrayLength(objMetaData.ArrExternalModules) > 0) {
                transEntryExternalModule.callExternalModuleOnField(eFieldExternalModuleEvents.OnEnter, 
                                                                    objMetaData.iFieldId, 
                                                                    objMetaData.sFieldName, 
                                                                    0);
            }
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainHeader.onControlFocus} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

