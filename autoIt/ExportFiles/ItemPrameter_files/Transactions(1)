    onReverseEntry: function (iHeaderId) {
        let iVoucherType = 0;
        let bPmt = false;
        let objInput = null;

        try {
            iVoucherType = transEntryInfo.VoucherType;

            if (transEntryInfo.BaseVoucherType == eVTTYPE.NJOURN || transEntryInfo.BaseVoucherType == eVTTYPE.JOURN) {
                if (transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgReverseJV")) == false) {
                    return;
                }

                transEntryGlobal.createAuditLog(eLogActions.ReverseJV);

                objInput = {};
                objInput.iHeaderId = iHeaderId;
                objInput.iNewVoucherType = iVoucherType;
                objInput.iViewId = transEntryInfo.ViewId;
                objInput.LanguageId = EntryMain.m_LanguageId;
                objInput.CalType = EntryMain.m_CalendarType;
                objInput.InfPresent = GlobalPref.InfPresent;
                transEntryServer.execute(eTransServerRequest.ReverseEntry, 
                                            objInput, 
                                            true, 
                                            "EntryMainCallback.reverseEntryResult",
                                            {
                                                bAuditLog: true 
                                            });
            }
            else if (transEntryInfo.BaseVoucherType == eVTTYPE.CASHR || transEntryInfo.BaseVoucherType == eVTTYPE.CASHP) {
                if (transEntryGlobal.confirmMessage(GlobalPref.getResourceValue("msgReverseJV")) == false) {
