    pasteFromClipboard: function (bFromAmend) {
        let sId = "";
        let iCounter = 0;
        let iIndex = 0;
        let iValue = 0;
        let objTransaction = undefined;
        let objMetaData = undefined;
        let objFieldInfo = undefined;
        let obj = undefined;

        try {
            bFromAmend = DataType.toBoolean(bFromAmend);
            EntryMainUI.resetScreen(true, true, false, true, bFromAmend);

            objTransaction = transEntryClipboard.TransObject;
            objTransaction = DataType.stringToObject(objTransaction);
            if (objTransaction.lValue < 1) {
                return;
            }
            objTransaction = objTransaction.data;

            if (DataType.isValidObject(objTransaction) == false) {
                return;
            }

            if (DataType.arrayLength(objTransaction.BodyData) < 1) {
                return;
            }

            if (bFromAmend == false) {
                for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                    objTransaction.BodyData[iCounter].AuthStatus = _eAuthStatus.Authorized;
                    objTransaction.BodyData[iCounter].Flags.SuspendFA = false;
                    objTransaction.BodyData[iCounter].Flags.SuspendInv = false;
                    objTransaction.BodyData[iCounter].Flags.SuspendBase = false;
                    objTransaction.BodyData[iCounter].Flags.SuspendLink = false;
                }

                if (transEntryFieldInfo.ChequeNo.Area == eTranEntryFieldArea.Header) {
                    objMetaData = transEntryFieldInfo.ChequeNo.MetaData;
                    for(iCounter = 0; iCounter < DataType.arrayLength(objTransaction.HeaderExtra); iCounter++) {
                        if(objTransaction.HeaderExtra[iCounter].Name === objMetaData.sFieldName) {
                            objTransaction.HeaderExtra.splice(iCounter, 1);
                            break;
                        }
                    }
                }
            }

            objTransaction.Header.HeaderId = 0;
            objTransaction.Header.Flags.Editing = false;
            for (iCounter = 0; iCounter < objTransaction.BodyData.length; iCounter++) {
                objTransaction.BodyData[iCounter].BodyId = 0;
                objTransaction.BodyData[iCounter].TransactionId = 0;

                if(bFromAmend !== true) {
                    objTransaction.BodyData[iCounter].BillwiseData = null;
                    objTransaction.BodyData[iCounter].Links = null;

                    if(DataType.isValidObject(objTransaction.BodyData[iCounter].Flags) == true) {
                        objTransaction.BodyData[iCounter].Flags.BRS = false;
                    }
                }

                if (DataType.isValidObject(objTransaction.BodyData[iCounter].Sales) == true) {
                    if(bFromAmend !== true) {
                        objTransaction.BodyData[iCounter].Sales.RMANos = null;

                        if (transEntryInfo.isStockRevaluation == false) {
                            objTransaction.BodyData[iCounter].Sales.BatchNo = null;
                        }

                        objTransaction.BodyData[iCounter].Sales.BinsData = null;
                        objTransaction.BodyData[iCounter].Sales.Reservation = null;
                        objTransaction.BodyData[iCounter].Sales.StockToRelease = null;
                    }

                    if (DataType.isValidObject(objTransaction.BodyData[iCounter].Sales.ScreenData) == true) {
                        for (iIndex = 0; iIndex < objTransaction.BodyData[iCounter].Sales.ScreenData.length; iIndex++) {
                            objTransaction.BodyData[iCounter].Sales.ScreenData[iIndex].FieldId = objTransaction.BodyData[iCounter].Sales.ScreenData[iIndex].FieldId & eVTFIELDFLAG.TOFLDID;
                        }
                    }
                }
            }

            transEntryGlobal.EntryModel.Data = transEntryData.convertIntoThinClientObject(objTransaction,
                                    eConvertTransactionObjectSource.PasteFromClipboard,
                                    bFromAmend == true ? [] : transEntryFieldInfo.Date.MetaData.bReadOnly == true ? [eVTFIELDID.FDF_DATE] : []);
            if(transEntryInfo.isItTransfer == true && DataType.arrayLength(objTransaction.arrInvTag) > 0) {
                transEntryData.updateStockTransferInvTag(transEntryGlobal.EntryModel.Data, objTransaction.arrInvTag);
            }

            transEntryGlobal.EntryModel.Data.HeaderId = 0;
            transEntryGlobal.EntryModel.Data.Flags = transactionDataStructure.getVoucherFlagsObject();

            transEntryInfo.HeaderId = 0;
            transEntryInfo.HeaderFlags = transEntryGlobal.EntryModel.Data.Flags;

            obj = {};
            obj.bLoadingFromVersion = false;
            obj.bNew = true;
            obj.bResetFocus = false;
            obj.bVoucherLoading = false;
            obj.bFromPendingView = false;
            obj.iLoadedDataSource = eLoadedDataSource.PasteFromClipboard;
            EntryMainUI.setLoadedData(obj);

            if (bFromAmend == false && transEntryFieldInfo.PmtTerms.Area != eTranEntryFieldArea.None) {
                iValue = transEntryFields.getMandatoryValue(transEntryFieldInfo.Book, 0, "iPaymentTerms", eMasterDataType.Number);
                if (iValue > 0) {
                    transEntryFields.setPmtTerms(iValue);
                }
            }


            if (transEntryInfo.isItSales == false) {
                for (iCounter = 1; iCounter <= transEntryGrid.getTotalRows() ; iCounter++) {
                    if (transEntryFields.isRequired(eVTFIELDID.FDF_REFERENCE, iCounter) == true) {
                        transEntryGrid.setRowData(iCounter, eRowDataName.BillwiseRequired, true);
                    }                    
                }
            }

            objFieldInfo = transEntryFieldInfo.ChequeNo;
            if (objFieldInfo.Area == eTranEntryFieldArea.Header) {
                EntryMainHeader.validateChequeNo(objFieldInfo.FieldId);

                if (bFromAmend == false
                    && DataType.isNullOrEmpty(transEntryFields.getChequeNo(0), true) == true) {

                    EntryMainHeader.setDefaultChequeNo();
                }
            }

            if (bFromAmend == true) {
                objFieldInfo = transEntryFieldInfo.RefDoc;
                if (objFieldInfo.Area = eTranEntryFieldArea.Header) {
                    sId = EntryMainUI.getHeaderControlId(objFieldInfo.FieldId);
                    transEntryControl.setControlValue(sId, transEntryClipboard.OldDocNo, objFieldInfo.MetaData);
                }
            }

            transEntryGross.recalculateGross();
        }
        catch (err) {
            transEntryGlobal.showAlert("{EntryMainUI.pasteFromClipboard} " + err.message, GlobalPref.getResourceValue("Exception"));
        }
    },

