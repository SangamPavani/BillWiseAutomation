                font-size: 10px;
                font-weight: 500;
                color: #7a8e9e;
                font-style: italic;
            ">${Ue} <sup style="width: 12px; height: 12px; min-width: 12px; border-radius: 50%; flex-shrink: 0;background-color: ${wt};position:absolute;right:1rem"></sup>
                </span>`:tl?`<span style=" display: flex;
