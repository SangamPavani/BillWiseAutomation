var clSummaryBar = new function()
{

    var me=this;

    this.iScrollType_LEFT=1;
    this.iScrollType_RIGHT=2;
    this.iScrollType_UP=3;
    this.iScrollType_DOWN=4;


    var curYPos = 0,
        curXPos = 0,
        curDown = false,
        startX=0,
        endX=0;
    this.pageNo=1;
    this.iFilterField1Id=null;
    this.iFilterField2Id=null;
    this.sFilter1Name=null;
    this.sFilter2Name=null;

    this.iColumnCount=0;

    this.isNewFilter=0;

    var dvSummarybarMain=document.getElementById("dvSummarybarMain");
    var dvSummarybarRows=document.getElementById("dvSummarybarRows");

    dvSummarybarMain.addEventListener('mousemove',mouseMoveHomePart1);
    dvSummarybarMain.addEventListener('mousedown', mouseDownHome);
    dvSummarybarMain.addEventListener('mouseup', mouseUpHome);

    dvSummarybarRows.addEventListener('mousemove',mouseMoveHomePart2);
    dvSummarybarRows.addEventListener('mousedown', mouseDownHome);
    dvSummarybarRows.addEventListener('mouseup', mouseUpHome);


    //document.onkeydown=detectKeysScroll;
    cross.addListener(document.body,cross.EVENT_ONKEYDOWN,detectKeysScroll,false,null,Constants.SCOPE_SCREEN);

    var objScrollId=document.getElementById("scrollId");
    var objRowsTb=document.getElementById("rowsTb");

    function mouseMoveHomePart1(e)
    {
        if(curDown === true)
        {
            var iDrag=startX-endX;
            var iScrollPosition=objScrollId.scrollLeft;
            if(iDrag>0) {
                objScrollId.scrollLeft=(iScrollPosition+20);
                me.scrollRows(iScrollPosition+20);
            }
            else {
                objScrollId.scrollLeft=(iScrollPosition-20);
                me.scrollRows(iScrollPosition-20);
            }
        }
    };

    function mouseMoveHomePart2(e)
    {
        if(curDown === true)
        {
            var iDrag=startX-endX;
            var iScrollPosition=objScrollId.scrollLeft;
            if(iDrag>0) {
                objScrollId.scrollLeft=(iScrollPosition+20);
                //this.scrollRows(iScrollPosition+20);
            }
            else {
                objScrollId.scrollLeft=(iScrollPosition-20);
                // this.scrollRows(iScrollPosition-20);
            }
        }
    };

    function mouseDownHome(e)
    {
        e=cross.getEvent(e);
        startX=e.pageX;
        curDown = true; curYPos = e.pageY; curXPos = e.pageX;
    };

    function mouseUpHome(e)
    {
        e=cross.getEvent(e);
        endX=e.pageX;
        curDown = false;
    };

    this.setDragRow=function(thisObj)
    {
        document.getElementById("dvSummarybarRows").addEventListener('mousemove', function(e){
            if(curDown === true)
            {
                var iDrag=startX-endX;
                var iScrollPosition=thisObj.scrollLeft;
                if(iDrag>0) {
                    thisObj.scrollLeft=iScrollPosition+20;
                    // this.scrollRows(iScrollPosition+20);
                }
                else {
                    thisObj.scrollLeft=iScrollPosition-20;
                    // this.scrollRows(iScrollPosition-20);
                }
            }
        });
    };

    this.onWndscroll=function()
    {
        if(objRowsTb!=null)
        {
            if(objRowsTb.style.display=="block")
            {
                var iTopPosition=document.body.scrollTop;

                var dvSummarybarMain=document.getElementById("dvSummarybarMain");
                if(iTopPosition>220)
                {
                    dvSummarybarMain.style.position="fixed";
                    dvSummarybarMain.style.top=-15;
                }
                else
                {
                    dvSummarybarMain.style.position="relative";
                    dvSummarybarMain.style.top=2;
                }
            }
        }
        home.onWndscroll();
    };

    /*window.onscroll=function ()
    {
        if(objRowsTb!=null)
        {
           if(objRowsTb.style.display=="block")
           {
                var iTopPosition=document.body.scrollTop;

                var dvSummarybarMain=document.getElementById("dvSummarybarMain");
                if(iTopPosition>220)
                {
                    dvSummarybarMain.style.position="fixed";
                    dvSummarybarMain.style.top=-15;
                }
                else
                {
                    dvSummarybarMain.style.position="relative";
                    dvSummarybarMain.style.top=2;
                }
           }
        }
        home.onWndscroll();
    };*/

    this.changeDropDownImage = function()
    {
        var leftAreaId=document.getElementById("leftAreaId");
        var leftAreaId2=document.getElementById("leftAreaId2");

        //Expand
        if(objRowsTb.style.display=="none")
        {
            objRowsTb.style.display="block";

            if(objRowsTb.childNodes.length<=0){
                this.showMoreRows(1,this.iFilterField1Id,this.iFilterField2Id,false);
                //this.showMoreRows();
            }

            util.addClass(leftAreaId,"mscenterareaborder");
            util.addClass(leftAreaId,"mstopareaborder");
            util.addClass(leftAreaId2,"mscenterareaborder");

            //arrow icon
            /* $("#dashletArrows").removeClass("setExpand");
             $("#dashletArrows").addClass("setCollapse");*/

            this.resetScrollToStart();
        }
        else //collapse
        {
            objRowsTb.style.display="none";

            var dvSummarybarMain=document.getElementById("dvSummarybarMain");
            dvSummarybarMain.style.position="relative";
            dvSummarybarMain.style.top=2;
            document.getElementById("rightScrollTd").style.width=30;
            document.getElementById("dvFilter").style.right = 30;

            util.removeClass(leftAreaId,"mscenterareaborder");
            util.removeClass(leftAreaId,"mstopareaborder");
            util.removeClass(leftAreaId2,"mscenterareaborder");
            //arrow icon
            /*$("#dashletArrows").removeClass("setCollapse");
            $("#dashletArrows").addClass("setExpand");*/
        }
    };

    this.detailView= function(iTransId)
    {
        var sUrl=document.getElementById("viewUrlId").value+"&transId="+iTransId;
        if(iTransId!=undefined){
            home.setCenterUI(sUrl);
        }
    };

    this.onAddClick=function(iSelectedValue)
    {
        /* var sModuleUrl=document.getElementById("moduleURL").value; //todo
         var iFieldId=document.getElementById("fieldId").value;
         sModuleUrl+="&fieldId="+iFieldId;
         sModuleUrl+="&fieldValue="+iSelectedValue;
         home.setCenterUI(sModuleUrl);*/
    };

    this.getRandomColor= function()
    {
        var letters = '0123456789ABCDEF'.split('');
        var color = '#';
        for (var i = 0; i < 6; i++ ) {
            color += letters[Math.floor(Math.random() * 16)];
        }

        return color;
    };

    this.scrollChange=function(iScrollType)
    {
        var iCurrenttPosition=objScrollId.scrollLeft;

        var iIncrement=200;
        if(iScrollType==me.iScrollType_LEFT) {
            objScrollId.scrollLeft=(iCurrenttPosition-iIncrement);
            this.scrollRows(iCurrenttPosition-iIncrement);
        }
        else {
            objScrollId.scrollLeft=(iCurrenttPosition+iIncrement);
            this.scrollRows(iCurrenttPosition+iIncrement);
        }
    };


    this.showHideScroller=function(iColumnCount)
    {
        /*var leftScroll=document.getElementById("leftScroll");
        var rightScroll=document.getElementById("rightScroll");

        if(leftScroll.style.display=="none" && this.isScrollRequired(iColumnCount))
        {
            leftScroll.style.display="block";
            rightScroll.style.display="block";
        }
        else
        {
            leftScroll.style.display="none";
            rightScroll.style.display="none";
        }*/
    };

    this.isScrollRequired=function(iColumnCount)
    {
        var leftAreaWidth=document.getElementById("leftAreaId").clientWidth;
        var bStatus=false, iSingleColumnWidth=212;

        if(leftAreaWidth<(iColumnCount*iSingleColumnWidth))
        {
            bStatus=true;
        }

        return bStatus;
    };

    this.showMoreRows=function(pageNo, iFilterField1, iFilterField2,bIgnoreClear)
    {
        var sUrl = con.getStruts2Url("/module","moduleView.do", "getModuleStatusInfo", null, true);
        util.toggleBackground(true);

        if(pageNo==null){
            pageNo=1; //1 for First req
        }

        me.pageNo=pageNo;

        var iModuleId=document.getElementById("iModuleId_1").value;
        sUrl+="?pageNo="+pageNo+"&moduleId="+iModuleId;

        if((iFilterField1!=null && iFilterField2!=null) && (iFilterField1!=-1 && iFilterField2!=-1)){
            sUrl+="&filter="+iFilterField1+","+iFilterField2;
            me.showFilterToolTip();
        }
        else
        {
            if(!bIgnoreClear)
                me.clearFilterCriteria();
        }

        if(pageNo==1 && (iFilterField1!=null && iFilterField2!=null)){
            con.sendPostRequest(sUrl,null,null,this.setRowDataAfterFilter);
        }
        else{
            con.sendPostRequest(sUrl,null,null,this.setRowData);
        }
    };

    this.setRowData=function(sResponse)
    {
        util.toggleBackground(false);
        var oldHtml=objRowsTb.innerHTML;
        objRowsTb.innerHTML=oldHtml+sResponse;
        me.resetScrollToStart();
        me.dragIndexing();

        if (typeof window["initAllCombos"] == "function")
            initAllCombos = null;
        loadResources(objRowsTb, util.onScriptsLoad);

    };

    this.setRowDataAfterFilter=function(sResponse)
    {
        util.toggleBackground(false);
        objRowsTb.innerHTML=sResponse;
        me.resetScrollToStart();
        me.dragIndexing();

        if (typeof window["initAllCombos"] == "function")
            initAllCombos = null;
        loadResources(objRowsTb, util.onScriptsLoad);

        getDialogBox("clHomeFilterDlg").hide();
    };

    this.scrollRows=function(iDistance)
    {
        var iRowsLength=document.querySelectorAll('#rowsTb > ul').length+(me.pageNo*6)+1;

        for(var i=0;i<=iRowsLength;i++)
        {
            if((cross.getChildren(objRowsTb)[i])!=undefined && ((cross.getChildren(objRowsTb)[i]).nodeName.toLowerCase()=="ul") )
            {
                (cross.getChildren(objRowsTb)[i]).scrollLeft=iDistance;
            }
        }
    };

    this.dragIndexing=function()
    {
        var iRowsLength=document.querySelectorAll('#rowsTb > ul').length+(me.pageNo*6)+1;

        for(var i=0;i<=iRowsLength;i++)
        {
            if((cross.getChildren(objRowsTb)[i])!=undefined && (cross.getChildren(objRowsTb)[i]).nodeName.toLowerCase()=="ul" ){
                this.setDragRow((cross.getChildren(objRowsTb)[i]));
            }
        }
    };


    this.ShowMore=function(thisObj, pgNo)
    {
        thisObj.style.display="none";
        this.showMoreRows(pgNo,this.iFilterField1Id,this.iFilterField2Id,false);
    };

    this.resetScrollToStart=function()
    {
        var headerRowScrollPos=objScrollId.scrollLeft;
        var iRowsLength=document.querySelectorAll('#rowsTb > ul').length+(me.pageNo*6)+1;
        for(var i=0;i<=iRowsLength;i++)
        {
            if((cross.getChildren(objRowsTb)[i])!=undefined && ((cross.getChildren(objRowsTb)[i]).nodeName.toLowerCase()=="ul") ){
                (cross.getChildren(objRowsTb)[i]).scrollLeft=headerRowScrollPos;
            }
        }
    };

    this.filterArea=function(thisObj)
    {
        var pos=cross.getPosition(thisObj);
        var btnFilterX=pos[0]-250;
        var btnFilterY=pos[1]+20;

        if(document.getElementById("dvSummarybarMain").style.position!="fixed"){
            btnFilterY=btnFilterY-(document.body.scrollTop);
        }

        this.showFilterDialog(btnFilterX,btnFilterY);
    };

    this.showFilterDialog=function(xPosition, yPosition)
    {
        var arrActions = new Array(),clHomeFilterDlg, sTitle = "&nbsp;Filter";
        var sUrl = con.getStruts2Url("/module","moduleView.do", "getModuleStatusFilter", null, true);
        var iModuleId=document.getElementById("iModuleId_1").value;
        sUrl+="?moduleId="+iModuleId;
        arrActions[0] = "Apply|clSummaryBar.dialogOk";
        arrActions[1] = "Cancel|";
        //arrValues=encodeURIComponent(arrValues);
        if(document.getElementById("msgbox")!=null){
            document.getElementById("msgbox").style.display="none";
        }
        clHomeFilterDlg=getDialogBox("clHomeFilterDlg");
        if(!clHomeFilterDlg || this.isNewFilter==0) {
            clHomeFilterDlg = new DialogBox("clHomeFilterDlg", sTitle, xPosition, yPosition, 250, 160, sUrl, false, null, true, true, arrActions, null, null, null, null, true, null, true, true);
            me.dialogStyles("clHomeFilterDlg","#ffffff");
            this.isNewFilter=1;
        }

        var dlgId=document.getElementById("clHomeFilterDlgSWindow");
        dlgId.style.background="#ffffff";
        dlgId.style.position="absolute";
        dlgId.overflow="visible";

        clHomeFilterDlg.setBounds(xPosition,yPosition,250,140);
        clHomeFilterDlg.show();
    };

    this.dialogStyles=function(sDialogName,backgroundcolor)
    {
        //Simple Dialogbox Styles
        document.getElementById(sDialogName+"titlebar").style.backgroundColor = backgroundcolor;
        document.getElementById(sDialogName+"centerData").style.backgroundColor = backgroundcolor;
        document.getElementById(sDialogName+"centerData").style.overflowY="hidden";
        document.getElementById(sDialogName+"STitlebar").style.color = "#4e4e4e";
        document.getElementById(sDialogName+"frameActions").style.backgroundColor=backgroundcolor;
    };

    this.dialogOk=function()
    {
        var iFilterField1=document.getElementById("filterField1");
        var iFilterField2=document.getElementById("filterField2");


        if( (iFilterField1.value==-1 && iFilterField2.value!=-1) || (iFilterField1.value!=-1 && iFilterField2.value==-1))
        {
            Validation.showMessage("Both fields required", Validation.ERROR_MSG, null, 0, true);

            //changing height of Dialog box
            var dlgId=document.getElementById("clHomeFilterDlgSWindow");

            if(dlgId.clientHeight<170){
                dlgId.style.height=dlgId.clientHeight+30;
                var dlgCenter=document.getElementById("clHomeFilterDlgcenterData");
                dlgCenter.style.height=dlgCenter.clientHeight+30;
            }
        }
        else {
            this.iFilterField1Id=iFilterField1.value;
            this.iFilterField2Id=iFilterField2.value;
            this.sFilter1Name=iFilterField1.options[iFilterField1.selectedIndex].text;
            this.sFilter2Name=iFilterField2.options[iFilterField2.selectedIndex].text;
            this.pageNo=1;
            this.showMoreRows(this.pageNo,iFilterField1.value,iFilterField2.value,false);

            if(objRowsTb.style.display=="none") {
                objRowsTb.style.display="block";
            }
        }
    };

