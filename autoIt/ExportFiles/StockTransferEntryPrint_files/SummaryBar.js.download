    this.onWndLoadsetDimensions=function()
    {
        var iWindowType = clAppBuffer.getWindowType();
        if ((document.getElementById("listCustom") && document.getElementById("listCustom").offsetWidth > 0)
            && iWindowType != Constants.IMODULE_WINDOW.SPLIT_PANE
            && iWindowType != Constants.IMODULE_WINDOW.SPLIT_PANE_WITH_TABBED_PANE)
        {
            document.getElementById("dvSummarybarMain").style.width=document.getElementById("listCustom").offsetWidth;
            document.getElementById("scrollId").style.width=document.getElementById("listCustom").offsetWidth;
        }
        else if (document.getElementById("dvMultipane1"))
        {
            document.getElementById("dvSummarybarMain").style.width=document.getElementById("dvMultipane1").offsetWidth;
            document.getElementById("scrollId").style.width=document.getElementById("dvMultipane1").offsetWidth;
        }
    };

    this.setSummaryBarDimensions=function(iEffectWidth)
    {
        if(document.getElementById("dvSummarybarMain"))
        {
            document.getElementById("dvSummarybarMain").style.width = document.getElementById("dvSummarybarMain").offsetWidth + iEffectWidth;
            document.getElementById("scrollId").style.width = document.getElementById("scrollId").offsetWidth + iEffectWidth;
        }
    };

    this.setColumnCount=function(iColumnCount)
    {
        this.iColumnCount=iColumnCount;
    };

    this.showFilterToolTip=function()
    {
        //document.getElementById("spFilter").innerHTML=this.sFilter1Name+" | "+this.sFilter2Name; //todo

        var objBtnDialog=document.getElementById("filterDialogBtnId");
//         objBtnDialog.style.background="lightgray";
//         objBtnDialog.style.border="1px solid darkgray";
        objBtnDialog.style.border="1px solid lightgray";

        document.getElementById("dvFilter").style.display="block";
    };

    this.hideFilterToolTip=function()
    {
        document.getElementById("dvFilter").style.display="none";
    };

    this.clearFilterCriteria=function()
    {
        this.iFilterField1Id=null;
        this.iFilterField2Id=null;
        this.sFilter1Name=null;
        this.sFilter2Name=null;
        this.pageNo=1;

        this.hideFilterToolTip();
        var objBtnDialog=document.getElementById("filterDialogBtnId");
        objBtnDialog.style.background="#f7f7f7";
        objBtnDialog.style.border="1px solid #f7f7f7";

        this.isNewFilter=0;
        me.showMoreRows(1,-1,-1,true);
    };

    this.setHeadingCount=function(arrHeadCounts)
    {
        var arrHeadCountsE=null;
        var headings=null;

        if(arrHeadCounts.length>0){
            arrHeadCountsE=eval(arrHeadCounts);
        }

        for(var i=0;i<this.iColumnCount;i++)
        {
            headings=document.getElementById("headCount["+i+"]");
            if(arrHeadCountsE!=null && arrHeadCountsE.length>0) {
                headings.innerHTML=arrHeadCountsE[i];
            }
            else{
                headings.innerHTML="0";
            }
        }
    };

    this.setSubHeadingAmount=function(arrHeadAmnts)
    {
        var arrHeadAmntsE=null;
        var amnts=null;

        if(arrHeadAmnts.length>0){
            arrHeadAmntsE=eval(arrHeadAmnts);
        }

        for(var i=0;i<this.iColumnCount;i++)
        {
            amnts=document.getElementById("headAmounts["+i+"]");
            if(arrHeadAmntsE!=null && arrHeadAmntsE.length>0) {
                amnts.innerHTML=arrHeadAmntsE[i];
            }
            else{
                amnts.innerHTML="";
            }
        }
    };

    this.highLightFilter=function()
    {
        document.getElementById("tbFilter").style.opacity=1;
    };

    this.rollbackFilterStyle=function()
    {
        document.getElementById("tbFilter").style.opacity=0.5;
    };

    function detectKeysScroll(e)
    {
        e=cross.getEvent(e);

        if(objRowsTb.style.display=="block")
        {
            //left
            if(e.keyCode==37){
                me.scrollChange(1);
            }
            //right
            else if(e.keyCode==39){
                me.scrollChange(2);
            }
        }
    };

    this.setFilterDefaultSelection=function()
    {
        var objFilterField1=document.getElementById("filterField1");
        var objFilterField2=document.getElementById("filterField2");

        if(objFilterField1.options.length>0){
            objFilterField1.options[1].selected=true;
        }

        if(objFilterField2.options.length>0){
            objFilterField2.options[1].selected=true;
        }

    };

    this.setSelectedItem=function(iTransId,isFromCSS)
    {
        if(iTransId>0)
        {
            var objItem=document.getElementById("column0");
            var i=1;
            while(objItem)
            {
                if(iTransId==parseInt(objItem.getAttribute("iTransId")))
                {
                    var arrPos=cross.getPosition(objItem);
                    var arrPos1=cross.getPosition(objScrollId);
                    if(((arrPos[0]+objItem.offsetWidth)-arrPos1[0])>objScrollId.offsetWidth)
                        objScrollId.scrollLeft=(((arrPos[0]+objItem.offsetWidth)-arrPos1[0])-objScrollId.offsetWidth);

                    me.onClkSummaryItem(objItem,null,isFromCSS);
                    break;
                }

                objItem=document.getElementById("column"+i);

                i++;
            }
        }
    };

    this.gradientColor = function (iSelectedTransId) {
        var i = 0, objItemId = document.getElementById("column0");
        while (objItemId) {
            if(objItemId ) {
                objItemId = document.getElementById("column" + i);
                var sbColor = objItemId.getAttribute("sbColor");
                var gdColor = chroma(sbColor);
                var gradientColors = chroma.scale([gdColor, gdColor.brighten(1), gdColor.brighten(2)]).colors(2);
                if (iSelectedTransId != objItemId.getAttribute("iTransId")) {
                    objItemId.style.background = "linear-gradient(1.57068rad,rgba(45,21,136,0.1),rgba(45,21,136,0.3))";
                    objItemId.style.color =sbColor;
                }
                //alert(objPrevSelectedItem.getAttribute("iTransId")+" =="+objItemId.getAttribute("iTransId"))
                i++;
            }
        }
    };

    this.onLoadGradientColor = function (iSelectedTransId) {
        //   alert("ddd==-"+iSelectedTransId)
        var i = 0,objItemId = document.getElementById("column0");
        while (objItemId) {
            objItemId = document.getElementById("column" + i);
            var sbColor = objItemId.getAttribute("sbColor");
            var gdColor = chroma(sbColor);
            if(iSelectedTransId!=objItemId.getAttribute("iTransId")) {
                objItemId.style.background =this.getGradientColor(gdColor);
                // objItemId.style.background ='linear-gradient(to right,' + gradientColors.join(",") + ')';
                //this.getGradientColor(gdColor);
                //if(sbColor!=null && sbColor.indexOf("#")!=-1)
                //{
                //    sbColor = sbColor.substring(1,sbColor.length);
                //}
                //var arrRgb=  util.getRGBColor2(sbColor);
                //
                //console.debug("summaryBar===============");
                //console.debug(arrRgb);
                //objItemId.style.background='linear-gradient(1.57068rad, rgba('+arrRgb[0]+','+arrRgb[1]+','+arrRgb[2]+', 0.1),rgba('+arrRgb[0]+','+arrRgb[1]+','+arrRgb[2]+', 0.3))';
                objItemId.style.color = "#000"
            }
            i++;
        }
    };

    this.onClkSummaryItem=function(objThis,sFnCallback,isFromCSS)
    {
        var objPrevSelectedItem=document.getElementById("dvSummarybarMain").selectedItem;
        var sbColor = objThis.getAttribute("sbColor");

        if(objPrevSelectedItem===objThis)
            return false;

        if(objPrevSelectedItem)
        {
            if(!isFromCSS) {
                var gdPrevSelectedColor = chroma(objPrevSelectedItem.getAttribute("sbColor"));
                var gradientColors = chroma.scale([gdPrevSelectedColor, gdPrevSelectedColor.brighten(1), gdPrevSelectedColor.brighten(2)]).colors(2);
                //objPrevSelectedItem.style.background = 'linear-gradient(to left,' + gradientColors.join(",") + ')';
                objPrevSelectedItem.style.borderTop = "0";
                objPrevSelectedItem.style.color = "#000";
                objPrevSelectedItem.style.background=this.getGradientColor(gdPrevSelectedColor);

                // var sbPrevColor = objPrevSelectedItem.getAttribute("sbColor");
                //if(sbPrevColor!=null && sbPrevColor.indexOf("#")!=-1)
                //{
                //    sbPrevColor = sbPrevColor.substring(1,sbPrevColor.length);
                //}
                //var arrRgb=  util.getRGBColor2(sbPrevColor);
                //objPrevSelectedItem.style.background='linear-gradient(1.57068rad, rgba('+arrRgb[0]+','+arrRgb[1]+','+arrRgb[2]+', 0.1),rgba('+arrRgb[0]+','+arrRgb[1]+','+arrRgb[2]+', 0.3))';

            }
            util.removeClass(objPrevSelectedItem, "sumbar-item-select");
        }

        if(!isFromCSS) {
            objThis.style.borderTop = "5px solid "+sbColor ;
            objThis.style.color ="#000";
            objThis.style.background ="#000";
        }


        util.addClass(objThis, "sumbar-item-select");
        document.getElementById("dvSummarybarMain").selectedItem=objThis;
        //objThis.style.backgroundColor="transparent";

        if(sFnCallback)eval(sFnCallback);
    };


    this.getGradientColor=function(gdColor) {
        var gradientColors = chroma.scale([gdColor, gdColor.brighten(1), gdColor.brighten(1.3)]).colors(4);
        var gdSelectedColors = 'linear-gradient(to left';
        var colors=[
            {color:gradientColors[2] ,percentage:"60%"},
            {color:util.getLightenColor(gradientColors[1],0.188) ,percentage:"100%"},
            //{color:gradientColors[1] ,percentage:"100%"},
        ];

        colors.forEach(function(e)
        {
            gdSelectedColors += "," +e.color + " " + e.percentage;
        });

        gdSelectedColors += ')';

        return gdSelectedColors
    }


