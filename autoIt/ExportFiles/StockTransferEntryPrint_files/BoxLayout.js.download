var clBoxLayout = new function()
{
    var me = this;
    this.objPrevItem = null;
    this.isMultiSelection  = true;

    this.onClkItem = function(objBoxItem,isVertical,e)
    {
        if(me.objPrevItem != null && me.objPrevItem != objBoxItem)
            util.removeClass(me.objPrevItem,"selecteditem");

        var sParentNodeName;
       /* if(isVertical)
            sParentNodeName="TABLE";
        else*/
            sParentNodeName="UL";

        var objParent=objBoxItem;
        while(objParent.nodeName!=sParentNodeName)
            objParent=objParent.parentNode;
        
        var isMultiSelection=objParent.getAttribute("isMultiSelection")=="true";
        var isAddClass=true;

        if(isMultiSelection)
        {
            var isCtrlPressed = cross.isCtrlPressed(e);
            if(isCtrlPressed)
            {
                 if(util.hasClass(objBoxItem,"selecteditem"))
                     isAddClass=false;
            }
            else
            {
                var objItems = cross.getChildren(objParent);
                for(var i = 0; i< objItems.length; i++)
                {
                    if(util.hasClass(objItems[i],"selecteditem"))
                        util.removeClass(objItems[i],"selecteditem");
                }
            }
        }

        if(isAddClass)
        {
            if(!util.hasClass(objBoxItem,"selecteditem"))
                util.addClass(objBoxItem,"selecteditem");
        }
        else
        {
            if(util.hasClass(objBoxItem,"selecteditem"))
                util.removeClass(objBoxItem,"selecteditem");
        }
        
        me.objPrevItem = objBoxItem;
    };

};