var headerDetails = new function()
{
    app.registerInstance(Constants.SCOPE_SCREEN,headerDetails,this);
    var me = this;
    this.callFollowUp=function(sURL,iTransId,iModuleId,iType)
    {
//      var iTransId=document.getElementById("transId").value;
//      var iModuleId=document.getElementById("moduleId").value;
        me.btFollowupId = iModuleId+"_"+iTransId;
        sURL+="?moduleId="+iModuleId+"&transId="+iTransId;
        var sResponse = (iType == 1)?"headerDetails.arhFollowUpTracker":"headerDetails.responseSetFollowup";
        con.sendPostRequest(sURL, null, null,sResponse, false);
    };
    this.arhFollowUpTracker = function(sResponse)
    {
        me.responseSetFollowup(sResponse);
        clFollowup.resetTrackerDetails(me.btFollowupId);
    };

    this.responseSetFollowup=function(sResponse,statusCode)
    {
        var sclassName,btFollowup = document.getElementById("bFollowup_"+me.btFollowupId);
        sclassName=btFollowup.className;
        
        if(sclassName=='btunfollowup')
            sclassName='btfollowup';
        else
            sclassName='btunfollowup';
        btFollowup.className="";
        btFollowup.className=sclassName;
        btFollowup.value=sResponse;
    };
    this.onClkCustomize = function(sUrl)
    {
        var arrActions = new Array(),clCustDlg,sParams = 0;
        arrActions[0] = MsgHandler.getMsg(MsgConstants.OK)+"|clBusinessCardCust.onClkSave(true)";
        arrActions[1] = MsgHandler.getMsg(MsgConstants.CANCEL)+"|clBusinessCardCust.onClkCloseBCDlg";

        sParams = "?iTypeId="+Constants.BUSINESSCARDCUST+"&iModuleId="+document.getElementById("moduleId").value+"&isNew=true&iBussCard="+Constants.BUSINESSCARDCUST+"&isDlg=true&transId=-1"; /*todo*/
        clCustDlg = new DialogBox("clCustDlg",MsgHandler.getMsg(MsgConstants.CUST_BUSS),140,50,650,400,sUrl+sParams, true, null, true,true,arrActions);
        clCustDlg.setCenter();
        clCustDlg.show();
    };
    this.uploadDone = function(sFileName,sActionUrl,sId)
    {
         if(util.trim(sFileName).length > 0)
        {
            document.getElementById("preview_"+sId).src=sActionUrl ;//clAppBuffer.getContextPath()+"/company/"+filename;
            document.getElementById("uploadFileName_"+sId).value=sFileName;
        }
    };

    this.onUploadDone=function(sFileName,sActionUrl,sId,sDestPath,sHiddenName)
    {
        //alert(sFileName)
        //alert(sFileName+","+sActionUrl+","+sId+","+sDestPath);
        if(!sFileName)
        {
           /* var objRemove=document.getElementById(sId+"_remove");
            if(objRemove && !objRemove.value)
            {
                objRemove.value=document.getElementById("uploadFileName_"+sId).value;
                sFileName=document.getElementById("uploadFileName_"+sId).value;
                document.getElementById(sHiddenName+"_"+sId).value="";
            }
            var removeFile = document.getElementById('removeFile_'+sId);
            if(removeFile && !removeFile.value)
            {
                removeFile.value = document.getElementById('name_'+sId).value;
            }*/
            msg.showConfirm(MsgHandler.getMsg(MsgConstants.DELETE_CONFIRMATION_MSG,0,0,MsgHandler.getMsg(MsgConstants.IMAGE)),
                MsgHandler.getMsg(MsgConstants.DELETE_CONFIRMATION,0,0,MsgHandler.getMsg(MsgConstants.IMAGE)),"headerDetails.callbackDeleteImg");


        }
        else
        {
            document.getElementById("preview_"+sId).src=sActionUrl;
            var sParams = "fileName="+sFileName+"&moduleId="+document.getElementById("moduleId").value;
            sParams+="&transId="+document.getElementById("transId").value;
            //me.saveOrDeleteImage(sParams,"clSearchImage.arhResponseSave");
            var sUrl = con.getStruts2Url("","uploadImg.do","saveModuleImage");
            util.toggleBackground(true);
            con.sendPostRequest(sUrl, sParams, null, "headerDetails.arhResponseSave");

        }
    };
    this.callbackDeleteImg=function(iStatus)
    {
        if(iStatus==Constants.YES)
        {
            util.toggleBackground(true);
            var sParams = "moduleId="+document.getElementById("moduleId").value;
            sParams+="&transId="+document.getElementById("transId").value;
            //me.saveOrDeleteImage(sParams,"clSearchImage.arhResponseSave");
            var sUrl = con.getStruts2Url("","uploadImg.do","deleteModuleImage");
            con.sendPostRequest(sUrl, sParams, null, "headerDetails.arhDeleteResponseSave");
        }
        else
        {
            //alert(111)
            var iModuleId=document.getElementById("dvContImgUpload").getAttribute("moduleId");
            var iTransId=document.getElementById("dvContImgUpload").getAttribute("transId");
            var sFileName=document.getElementById("spnContactLettrIcon").getAttribute("data-letters");
            var sUrl="uploadImage.action?moduleId="+iModuleId+"&transId="+iTransId+"&sourceType="+Constants.IResource.SOURCE_TYPE_DB;
            clHTML5Upload.setAttachment("contactImgImport",sUrl,sFileName,sFileName);
        }
    };

    this.arhResponseSave=function(sResponse)
    {
        //var sStyle="cursor: pointer;position: absolute;left: 38%;top: 38%;font-size: 26px;display: none";
        util.toggleBackground(false);
        me.showHideLetterIcon(false);
        document.getElementById("dvContactIcon").style.display="none";
        //document.getElementById("spnContactLettrIcon").style.display="none";
        //document.getElementById("remove_contactImgImport").setAttribute("style",sStyle);



        //alert(sResponse);
    };
    this.arhDeleteResponseSave=function(sResponse)
    {
        util.toggleBackground(false);
        me.showHideLetterIcon(true);
        document.getElementById("dvContactIcon").style.display="block";
        document.getElementById("spnContactLettrIcon").style.display="none";
    };

    this.showHideLetterIcon = function(isShowLetterIcon)
    {
        var objLetterIcon=document.getElementById("spnContactLettrIcon");
        var objImageDiv=document.getElementById("dvContImgUpload");
        if(objLetterIcon!=null)
        {
            cross.setVisible(objLetterIcon,isShowLetterIcon);
            if(isShowLetterIcon)
            {
                objImageDiv.style.visibility="hidden";
                objImageDiv.style.width="0";
                objImageDiv.style.height="0";
            }
            else{
                objImageDiv.style.visibility="visible";
                objImageDiv.style.width="";
                objImageDiv.style.height="";
            }
            //cross.setVisible(objImageDiv,!isShowLetterIcon)
        }
    };
    this.onClkContactLetterIcon=function(sUploadImgId)
    {
        document.getElementById(sUploadImgId).click();
    };

    this.onMoverLetterIcon= function()
    {
        var obj = document.getElementById("fileName_contactImgImport").childNodes[0];
        var sStyle="cursor: pointer;position: absolute;left: 42%;top: 38%;font-size: 160% !important;display: block;";
        var sStyle2="cursor: pointer;position: absolute;left: 20%;top: 44%;font-size: 120% !important;display: block;";
        if(obj != undefined){
            var sStyle="cursor: pointer;position: absolute;right: 20%;top: 42%;font-size: 140% !important;display: block;";
            obj.setAttribute("style",sStyle2);
            obj.setAttribute("title",MsgHandler.getMsg(MsgConstants.DOWNLOAD));
        }
        document.getElementById("remove_contactImgImport").setAttribute("style",sStyle);
        document.getElementById("remove_contactImgImport").setAttribute("title",MsgHandler.getMsg(MsgConstants.DELETE));
        document.getElementById("dvContImgUpload").style.background="black";
        document.getElementById("dvContImgUpload").style.border="2px solid #ffffff";
    };
    this.onMOutLetterIcon  = function()
    {
        document.getElementById("dvContImgUpload").style.background="none";
        document.getElementById("dvContImgUpload").style.border="2px solid #e2e2e2";
        document.getElementById("remove_contactImgImport").setAttribute("style","");
    }
  
}
