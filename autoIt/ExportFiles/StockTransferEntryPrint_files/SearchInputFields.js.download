var clSearch = new function()
{
   // app.registerInstance("SearchInputFields",this);
    var me=this;
    me.g_iContainerHeight=0;
    var FIELDS_IGNORE=8;
    var RADIOBUTTON_IGNORE_VALUE=-100000000;
    //app.registerInstance("SearchInputFields",this);

    this.init=function()
    {
        setComboCascadeIds();
    };

    this.onWLoadSetMasterType2=function(sComboId,sDefVal)
    {
        getComboInstance(sComboId).setMasterType2(Constants.IStdMasters_GENERALMASTER,0,0,0,0,true,Constants.DATATYPE_STRINGLIST);

        if(sDefVal && util.trim(sDefVal).length >0)
        {
            getComboInstance(sComboId).checkAndAddItem(sDefVal,true,false);
            //getComboInstance(sComboId).setSelectedText(sDefVal);
        }
    };
    this.onWLoadSetRadioGroup=function(sElementId,sDefVal)
    {
        if(sDefVal == -1)
        {
            document.getElementById(sElementId).checked=false;
            document.getElementById(sElementId).click();
        }
    };
    this.onClkRadioGroup=function(objThis,sElementId)
    {
        //alert(objThis.value+" , "+sElementId);
        document.getElementById(sElementId).value=objThis.value;
    };

    this.onClkSearch = function(sHandler)
    {
        //sFormData = con.formData2QueryString(document.forms["frmSearchFlds"],null,clSearch.ignoreInputField);
        //Focus.crm.sdesk.supportcall
        //  alert(sHandler+"----"+eval(sHandler))

        var sFormData=clSearch.getSearchInputData();
        //alert(sFormData);
        cross.callFunction(window,eval(sHandler),[sFormData]);
    };

    this.getSearchInputData=function()
    {
        var sFormData;
        var objForm = document.forms["frmSearchFlds"];
        if (!objForm)
        {
            objForm=document.createElement("FORM");
            var clTable=document.getElementById("tblSearchFlds").cloneNode(true);
            objForm.appendChild(clTable);
        }
        sFormData=con.formData2QueryString(objForm,null,clSearch.ignoreInputField,null,false,true);
        return sFormData;
    };

    this.onClkClearSearchFlds=function(sHandler)
    {
        var objForm=document.forms["frmSearchFlds"];
        if (!objForm)
        {
            var clTable,oldParent;
             objForm=document.createElement("FORM");
             objForm.style.display="none";
             document.body.appendChild(objForm);
             clTable=document.getElementById("tblSearchFlds");
             if(clTable!=null)
             {
             oldParent=clTable.parentNode;
             objForm.appendChild(clTable);

             con.clearControls(objForm, true, false);
             oldParent.appendChild(clTable);
             }
             objForm.parentNode.removeChild(objForm);
             if(sHandler && util.trim(sHandler).length>0)
             cross.callFunction(window,eval(sHandler));
        }
        else
        {
            con.clearControls(objForm, true, false);
            if (sHandler && util.trim(sHandler).length > 0)
                cross.callFunction(window, eval(sHandler));
        }
    };

    this.onKUpInputField = function(evt)
    {
        if(cross.getKeyCode(evt)==13)
        {
         document.getElementById("btnSearchInputFlds").click();
        }
        cross.cancelBubble();
            //cross.fireEvent(document.getElementById("btnSearchInputFlds"),"click");

    };

    this.onChngDateRange=function(objSel, sFieldId1, sFieldId2)
    {
        var iSelectedRange=0;
        iSelectedRange = (objSel.options[objSel.selectedIndex]).value;

        if(iSelectedRange>0)
            document.getElementById(sFieldId1).value=iSelectedRange;
        else
            document.getElementById(sFieldId1).value="";

        /*if(iSelectedRange>0)
            clReportTimeFrame.setDateRange(iSelectedRange,document.getElementById(sFieldId1),document.getElementById(sFieldId2));
        else
        {
            document.getElementById(sFieldId1).value="";
            document.getElementById(sFieldId2).value="";
        }*/
    };

    this.ignoreInputField = function(clElement,index)
    {

        var sIdPrefix, iDataType,iControlType,iInputType,sValue,sValue2,arrVals, iIgnoreHiddenFld=0;
        var sElementId=clElement.id;
        /*if(document.getElementById(sElementId+"_Index"))
            iFldIndex=parseInt(document.getElementById(sElementId+"_Index").getAttribute("iFieldIndex"));
        else if(sElementId.indexOf("F")==0 && sElementId.indexOf("[")!=-1)   // Second input
        {
            iFldIndex=parseInt(document.getElementById(sElementId.substring(0,sElementId.indexOf("["))+"_Index").getAttribute("iFieldIndex"));
        }
        else
            iFldIndex=parseInt(sElementId.substring(sElementId.indexOf("[")+1,sElementId.indexOf("]")));*/

        /*iDataType=parseInt(document.getElementById("hfDataTypeId["+iFldIndex+"]").value);
        iControlType=parseInt(document.getElementById("hfControlType["+iFldIndex+"]").value);
        iInputType=parseInt(document.getElementById("hfInputType["+iFldIndex+"]").value);*/

        if(sElementId.indexOf("_")!=-1)
            sIdPrefix=sElementId.substring(0,sElementId.indexOf("_"));
        else
            sIdPrefix=sElementId;

        sIdPrefix=sIdPrefix+"_";

        iDataType=parseInt(document.getElementById(sIdPrefix+"hfDataTypeId").value);
        iControlType=parseInt(document.getElementById(sIdPrefix+"hfControlType").value);
        iInputType=parseInt(document.getElementById(sIdPrefix+"hfInputType").value);

        //Radiobutton group
        if(iDataType==Constants.DATATYPE_NUMBERLIST && iControlType==Constants.CONTROLTYPE_RADIOBUTTON)
        {
            if(clElement.getAttribute("iItemsLength"))
            {
                var iItemsLength=parseInt(clElement.getAttribute("iItemsLength"));

                iIgnoreHiddenFld=iItemsLength;
                if(clElement.checked && parseInt(clElement.value)==RADIOBUTTON_IGNORE_VALUE)
                {
                    return FIELDS_IGNORE+iIgnoreHiddenFld;
                }

                return iIgnoreHiddenFld;
            }
            else if(clElement.checked)
            {
                return 0;
            }
            //return iIgnoreHiddenFld;
        }
        else if(clElement.type=="checkbox" || clElement.type=="radio")
        {
            if(clElement.checked)
            {
                return 0;
            }
            else
            {

                if(iDataType==Constants.DATATYPE_NUMBERLIST)
                {
                    var iIndex=sElementId.lastIndexOf("_");
                    var sNextOptionId,sNextOptionIndex;

                    sNextOptionId = sElementId;
                    sNextOptionIndex = 0;
                    if(iIndex!=-1)
                    {
                        sNextOptionId = sElementId.substring(0, iIndex);
                        sNextOptionIndex = parseInt(sElementId.substring(iIndex+ 1));
                    }

                    if(document.getElementById(sNextOptionId+"_"+(sNextOptionIndex+1)))
                        return 1;
                    else
                    {
                        var iCount=0;
                        var bOptValChecked=false;
                        var objOptions=document.getElementById(sNextOptionId);

                        while(objOptions)
                        {
                            if(objOptions.checked)
                            {
                                bOptValChecked=true;
                                break;
                            }

                            iCount++;
                            objOptions=document.getElementById(sNextOptionId+"_"+iCount);
                        }

                        if(bOptValChecked)
                            return 0;
                        else
                            return FIELDS_IGNORE;
                    }
                }

                return FIELDS_IGNORE;
            }
        }
        else
        {
            if(clElement.getAttribute("isIgnoreClear")=="true" || clElement.name.indexOf("value2s")!=-1)
                return 0;


            if(clElement.getAttribute("isAllowMultiSelect")=="true")
                arrVals=clMultiCombo.getSelectedIds(sElementId);
            else
                sValue=clElement.value;

            if(clElement.getAttribute("mastertype") != null || clElement.getAttribute("namedDateRange") != null)
            {
                iIgnoreHiddenFld=1;
            }
            else if(iDataType==Constants.DATATYPE_TIME)
            {
                iIgnoreHiddenFld=3;
                if(clElement.id.indexOf("hour")!=-1 || clElement.id.indexOf("minute")!=-1 || clElement.id.indexOf("ampm")!=-1)
                    return 1;
            }
            else if((iDataType==Constants.DATATYPE_DATE && iInputType==Constants.INPUT_TYPE_RANGE)
                || (iDataType==Constants.DATATYPE_DATETIME && iInputType==Constants.INPUT_TYPE_RANGE))
            {
                if(parseInt(sValue)<=0)
                    sValue=null;
                //iIgnoreHiddenFld=3;
            }

            else if(iDataType==Constants.DATATYPE_DATE ||iDataType==Constants.DATATYPE_DATETIME)
            {
                if(clAppBuffer.getFarsiCalendar()=="true")
                    iIgnoreHiddenFld=1;
            }

            sValue2=document.getElementById(sIdPrefix+"value2").value;



            if((sValue && util.trim(sValue).length>0) || (arrVals && arrVals.length>0) || (sValue2 && util.trim(sValue2).length>0))
                return 0;
            else
                return FIELDS_IGNORE+iIgnoreHiddenFld;//  fieldid,tableid,datatype,grpid,value2
        }
    };

    this.setMasterValuesFromParent=function()
    {
        var bApplyFilter=false;
        var sIdPrefix,iIndex=0,objFldIndex;
        objFldIndex=document.getElementById("fieldIndex_0");

        var iArrMasterIds=null;
        var iArrMasterFieldIds=null;
        var iArrInputTypes=null;
        while(objFldIndex)
        {
            sIdPrefix=objFldIndex.getAttribute("feildId")+"_";
            var iDataType=parseInt(document.getElementById(sIdPrefix+"hfDataTypeId").value);

                if(iDataType==Constants.DATATYPE_MASTER)
                {
                    if(!iArrMasterFieldIds)
                    {
                        iArrMasterIds=new Array();
                        iArrMasterFieldIds=new Array();
                        iArrInputTypes=new Array();
                    }
                    var iFieldId = parseInt(document.getElementById(sIdPrefix+"hfFieldId").value);
                    iArrMasterFieldIds.push(iFieldId);
                    var iInputType = parseInt(document.getElementById(sIdPrefix+"hfInputType").value);
                    iArrInputTypes.push(iInputType);

                    var objFld = document.getElementById("O" + iFieldId);
                    var iMasterType= parseInt(objFld.getAttribute("mastertype"));

                    iArrMasterIds.push(iMasterType);

                }
            iIndex++;
            objFldIndex=document.getElementById("fieldIndex_"+iIndex+"");
        }

        if(iArrMasterFieldIds!=null)
        {


            var iArrLinkMasterValues = parent.moduleView.getMasterFieldValues(iArrMasterIds);
            //alert(iArrLinkMasterValues);

            var iArrParentMasterFieldIds=new Array();

            for(var i=0; i < iArrMasterIds.length; i++)
            {
                var iArr=parent.formula.sMasterFldIds[iArrMasterIds[i]];
                 if(iArr)
                    iArrParentMasterFieldIds.push(iArr[0]);
                else
                    iArrParentMasterFieldIds.push(0);
            }


           // alert(iArrMasterIds+"-->"+iArrParentMasterFieldIds);

            var sId,iMasterId,sMasterItem;
            for(var i=0; i < iArrMasterFieldIds.length; i++)
            {
                if(iArrParentMasterFieldIds[i])
                {
                    var objCombo = parent.getComboInstance(iArrParentMasterFieldIds[i]);
                    if (objCombo)
                    {
                        iMasterId = objCombo.getSelectedId();
                        sMasterItem = objCombo.getSelectedItem();
                        sId = "O" + iArrMasterFieldIds[i];

                        //alert(sMasterItem);
                        //sMasterItem=util.encodeURI(sMasterItem);
                        //alert(sMasterItem);

                        if (iArrInputTypes[i] == Constants.INPUT_TYPE_MULTIPLE) {
                            var objFld = document.getElementById("O" + iArrMasterFieldIds[i]);
                            var sHiddenName = objFld.getAttribute("hiddenName");
                            clMultiCombo.addItem(sId, sHiddenName, true, iMasterId, sMasterItem);
                        }
                        else
                        {
                            var clCombo=getComboInstance(sId);
                            clCombo.checkAndAddItem(" |" + iMasterId, true, false);
                            clCombo.setSelectedText(sMasterItem);
                        }
                        //getComboInstance("O" + iArrMasterFieldIds[i]).searchAndAddItem(null, true, null, true, iMasterValue, false, true);

                        if(!bApplyFilter && parseInt(iMasterId)>0)
                        bApplyFilter=true;
                    }
                }
            }
        }

        if(bApplyFilter)
        {
            document.getElementById("btnSearchInputFlds").click();
            return true;
        }
        return false;
    };

    this.getFieldReference=function(iFieldId, iTableId, iSearchGrpId)
    {
        var sIdPrefix,iIndex=0,objFldIndex;
        objFldIndex=document.getElementById("fieldIndex_0");

        while(objFldIndex)
        {
            //sIdPrefix="O"+objFldIndex.getAttribute("feildId")+"_";
            sIdPrefix=objFldIndex.getAttribute("feildId")+"_";


            if(iFieldId==parseInt(document.getElementById(sIdPrefix+"hfFieldId").value)
                && iTableId==parseInt(document.getElementById(sIdPrefix+"hfTableId").value)
                && iSearchGrpId==parseInt(document.getElementById(sIdPrefix+"hfSearchGroupId").value))
            {
                var iDataType=parseInt(document.getElementById(sIdPrefix+"hfDataTypeId").value);

                if(iDataType==Constants.DATATYPE_MASTER)
                    return getComboInstance("O"+iFieldId);
                   // return getComboInstance("fld["+iIndex+"]");
                else
                    return document.getElementById("O"+iFieldId);
                    //return document.getElementById("fld["+iIndex+"]");
            }
            iIndex++;
            objFldIndex=document.getElementById("fieldIndex_"+iIndex+"");
        }
        return null;

    };


    this.toggleContainer=function(objIcon,sContainerId,bIgnoreAnimate)
    {
        var objContainer,isSlideUp=false,sAgt;
        objContainer = document.getElementById(sContainerId);
        sAgt=navigator.userAgent;
        var objSummaryDv=document.getElementById("dvSummaryBar");
        objTableContainer=document.getElementById("containerDiv_1");
        iTableHeight = objTableContainer.offsetHeight;

        //alert(objIcon.isSlideUp);
        //if(!objIcon.isSlideUp)
            isSlideUp = objIcon.isSlideUp;

        if(  (cross.isIE() && sAgt.substring(sAgt.indexOf("MSIE")+5,sAgt.indexOf("MSIE")+7 ) < 10))
        {
            me.showContainer(objContainer,objIcon,!isSlideUp);
        }
        else
        {
            if(me.isQuee)
                return false;
            me.isQuee=true;

            if(isSlideUp)
            {
                if(me.g_iContainerHeight<=0)
                    me.g_iContainerHeight = objContainer.offsetHeight;
                objTableContainer.style.transition='height 1.5s';
                iTableHeight=iTableHeight+me.g_iContainerHeight;
                objTableContainer.style.height=iTableHeight;
            }
            else
            {
                if(me.g_iContainerHeight<=0)
                   objContainer.style.height =0;

                var newDiv=objContainer.cloneNode(true);
                newDiv.style.display="";
                newDiv.style.height="";
                document.body.appendChild(newDiv);
                me.g_iContainerHeight = newDiv.offsetHeight;
                newDiv.parentNode.removeChild(newDiv);
                objTableContainer.style.transition='height 1.5s';
                iTableHeight=iTableHeight-me.g_iContainerHeight;
                objTableContainer.style.height=iTableHeight;
            }

            if(!bIgnoreAnimate)
            {
                me.runAnimate(objIcon,objContainer,me.g_iContainerHeight,isSlideUp, 500);
            }
            else
            {
                objContainer.style.height =0;
                me.showContainer(objContainer,objIcon,!isSlideUp);
            }
        }
    };

    this.runAnimate=function(objIcon,objContainer,iHeight,isSlideUp, iInterval)
    {
        var prop;

        if(isSlideUp)
            prop='-='+iHeight+'px';
        else{
            prop='+='+iHeight+'px';
        }

        if(!isSlideUp)
        {
            cross.setVisible(objContainer,true);
        }

        $(objContainer).animate({height: prop},iInterval,null,
            function(){
                //alert("runAnimate="+isSlideUp);
                me.showContainer(objContainer,objIcon,!isSlideUp);
         });
    };

    this.showContainer=function(objContainer,objIcon,isShow)
    {
        if(isShow)
        {
            objContainer.style.height="";
            objIcon.isSlideUp=true;
            document.getElementById("repOptionsImg").className="fa fa-caret-down";
        }
        else
        {
            objIcon.isSlideUp=false;
            document.getElementById("repOptionsImg").className="fa fa-caret-up";
        }
        //alert("showContainer="+objIcon.isSlideUp);
        cross.setVisible(objContainer,isShow);
        me.isQuee=false;
    };
};