                MSG_COMMUNICATOR.sendMessage(me.VIEW_TYPE_LIST, sTargetFn, [iModuleId]);
            };
        };

        var MSG_COMMUNICATOR = new function ()
        {
            this.sendMessage = function (iViewType, sTargetFn, sArrParams)
            {
                if (!sArrParams)
                    sArrParams = null;
                var arrParams = {};
                arrParams["viewType"] = iViewType;
                arrParams["msgType"] = me.MSG_TYPE_REQUEST;
                arrParams["target"] = sTargetFn;
                arrParams["params"] = sArrParams;
                if(iViewType==centra.crmapi.VIEW_TYPE_SCHEDULER)
                {
                    window.parent.postMessage(arrParams, "*");
                }
                else if (typeof window["clModuleAPI"] == "object")
                    window.postMessage(arrParams, "*");
                else
                    window.parent.postMessage(arrParams, "*");
                //window.parent.postMessage("{'viewType':"+iViewType+",'msgType':"+me.MSG_TYPE_REQUEST+",'target':'"+sTargetFn+"','params':"+sArrParams+"}","*");
            };

            this.onReceiveMessage = function (event)
            {
                //
                console.log('received response:  ', event.data);
                var objReturn = event.data;
                if (objReturn["msgType"] == me.MSG_TYPE_RESPONSE)
                {
                    var objResponse = null, sMessage = null;
                    var iStatus = objReturn["status"];
                    var iViewType = objReturn["viewType"];
                    var sTargetFn = objReturn["target"];
                    var objCallback = me.sArrCallbacks[iViewType + "_" + sTargetFn];
                    if (objCallback)
                    {
                        var sCallbackFn = objCallback["callback"];
                        var objCallBackRes;
                        var iFieldId = objCallback["fieldId"];
                        var iRowIndex = objCallback["rowIndex"];
                        if (iStatus == me.STATUS_SUCCESS)
                            objResponse = objReturn["data"];
                        else
                        {
                            sMessage = objReturn["data"];
                            objResponse = null;
                        }
                        objCallBackRes = {
                            "status": iStatus,
                            "data": objResponse,
                            "fieldId": iFieldId,
                            "message": sMessage,
                            "rowIndex": iRowIndex
                        };
                        if (typeof[sCallbackFn] == "object")
                            sCallbackFn(objCallBackRes);
                        else
                            eval(sCallbackFn)(objCallBackRes);
                    }
                }
            };
        };

        var clSchedulerView = new function ()
        {
            this.getFilterInfo = function (fnCallback)
            {
                var sTargetFn = 'getFilterInfo';
                me.sArrCallbacks[me.VIEW_TYPE_SCHEDULER+ '_' + sTargetFn] = {"callback": fnCallback};
                MSG_COMMUNICATOR.sendMessage(me.VIEW_TYPE_SCHEDULER, sTargetFn);
            };
            this.getSelectedEvent = function (fnCallback)
            {
                var sTargetFn = 'getSelectedEvent';
                me.sArrCallbacks[me.VIEW_TYPE_SCHEDULER + '_' + sTargetFn] = {"callback": fnCallback};
                MSG_COMMUNICATOR.sendMessage(me.VIEW_TYPE_SCHEDULER, sTargetFn);
            };

        };

        window.addEventListener('message', MSG_COMMUNICATOR.onReceiveMessage);
    };

}