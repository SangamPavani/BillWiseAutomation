

var clPaytmMini=new function()
{
   var me=this;
   var COM_PORT_NAME="COM"+4;
   var objAnchorElem=null;
   
   this.invokeUrl=function(sUrl,iTimeout)
   {
	   
	   if(objAnchorElem==null)
	   {
		   objAnchorElem=document.createElement("a");
		   objAnchorElem.style.display="none";
		   document.body.appendChild(objAnchorElem);
	   }
	   
	   objAnchorElem.href=sUrl;

      if(iTimeout>0) {
         setTimeout(
             function () {
                objAnchorElem.click();
             }, iTimeout);

      }
      else
         objAnchorElem.click();

   };
   
   this.displayWelcomeScreen=function(mid)
   {
      var lReqId=new Date().getTime();
	  var sUrl= "PaytmPayments:?requestId="+lReqId+";method=showHomeScreen;mid=TES202001281820506353958;portName="+COM_PORT_NAME +";baudRate=115200;parity=0;dataBits=8;stopBits=1;debugMode=0;posid=POS-1";

      me.invokeUrl(sUrl, 5);

		  
   };


   this.displayQRCode=function(sQRCode,mid,orderId,dAmount,sPaytmQRUrl)
   {
      var lReqId=new Date().getTime();
		 //var sUrl= "PaytmPayments:?requestId=1234;method=displayTxnQr;mid=TES202001281820506353958;portName="+COM_PORT_NAME+";baudRate=115200;parity=0;dataBits=8;stopBits=1;order_id=TES202001281820506353958;order_amount=1;qrcode_id=upi://pay?pa=tsrtcp009@paytm&pn=TSRTC&mc=7221&tr=0CCCC0_1458410143738916&am=1.00&cu=INR&paytmqr="+sQRCode+";currencySign=null;debugMode=1;posid=POS-1";
		 var sUrl= "PaytmPayments:?requestId="+lReqId+";method=displayTxnQr;mid="+mid+";portName="+COM_PORT_NAME+";baudRate=115200;parity=0;dataBits=8;stopBits=1;order_id="+orderId+";order_amount="+dAmount+";qrcode_id="+sPaytmQRUrl+";currencySign=null;debugMode=1;posid=POS-1";

		  
		  me.invokeUrl(sUrl,0);
   };


   this.displaySuccess=function(mid,orderId,dAmount)
   {
      var lReqId=new Date().getTime();
		 var sUrl="PaytmPayments:?requestId="+lReqId+";method=showSuccessScreen;mid="+mid+";portName="+COM_PORT_NAME+";baudRate=115200;parity=0;dataBits=8;stopBits=1;order_id="+orderId+";order_amount="+dAmount+";currencySign=null;debugMode=1;posid=POS-1";
		  
		  me.invokeUrl(sUrl,100);


      /*setTimeout(
          function(){
             me.displayWelcomeScreen(mid);
          },1000);*/
   };


};