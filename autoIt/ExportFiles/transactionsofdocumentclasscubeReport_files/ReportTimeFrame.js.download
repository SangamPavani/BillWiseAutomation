var clReportTimeFrame = new function()
{
    app.registerInstance("ReportTimeFrame",this);
    var me=this;

    this.onWLoadSetDateRange=function(sPrefix,iRangeValue,isShowTime,is24HrFormat)
    {
        /*if(document.getElementById(me.g_sPrefix+"TimeFrameRange"))
        {
            clReportTimeFrame.onChngDateRange(document.getElementById(me.g_sPrefix+"TimeFrameRange"));
        }*/
        me.setDateRange(iRangeValue,document.getElementById(sPrefix+"StartDate"),document.getElementById(sPrefix+"EndDate"),isShowTime,is24HrFormat);
    };

    this.onChngTimeFrameDate=function(sPrefix,objDt)
    {
        if(objDt.getAttribute("oldVal") != objDt.value)
        {
            var objSel=document.getElementById(sPrefix+"TimeFrameRange");
            objSel.selectedIndex=0;
        }
    };

    this.onChngDateRange = function(sPrefix,objSel,isShowTime,is24HrFormat)
    {
        var iSelectedRange=0;
        iSelectedRange = (objSel.options[objSel.selectedIndex]).value;
        me.setDateRange(iSelectedRange,document.getElementById(sPrefix+"StartDate"),document.getElementById(sPrefix+"EndDate"),isShowTime,is24HrFormat);
    };
    
    this.setDateRange = function(iRangeValue,objStartDate,objEndDate,isShowTime,is24HrFormat)
    {
        //var objStartDate=document.getElementById(me.g_sPrefix+"StartDate");
        //var objEndDate=document.getElementById(me.g_sPrefix+"EndDate");
        var objNewStartDate=util.getDateObject();//new Date();

        if(objStartDate)
        {
            switch (parseInt(iRangeValue))
            {
                case Constants.IDATE.DAY_CURRENT: //today
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_NEXT: //tomorrow
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate()+1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getDate()+1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_PREVIOUS: //yesterday
                {
                    if(objNewStartDate.getDate()==1)
                    {
                        objNewStartDate.setDate(objNewStartDate.getDate()-1);
                        me.setDateValue(objStartDate, objNewStartDate.getDate(), (objNewStartDate.getMonth() + 1), objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                        me.setDateValue(objEndDate, objNewStartDate.getDate(), (objNewStartDate.getMonth() + 1), objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    }
                    else {
                        me.setDateValue(objStartDate, objNewStartDate.getDate() - 1, (objNewStartDate.getMonth() + 1), objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                        me.setDateValue(objEndDate, objNewStartDate.getDate() - 1, (objNewStartDate.getMonth() + 1), objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    }
                    break;
                }
                case Constants.IDATE.DAY_NEXT_SEVEN:
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+6);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_NEXT_THIRTY:
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+29);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_NEXT_SIXTY:
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+59);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_NEXT_NINETY:
                {
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+89);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_PREVIOUS_SEVEN:
                {
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()-6);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_PREVIOUS_THIRTY:
                {
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()-29);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_PREVIOUS_SIXTY:
                {
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()-59);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.DAY_PREVIOUS_NINETY:
                {
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()-89);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }

                //////////////////////////   WEEK RELATED //////////////////////
                case Constants.IDATE.WEEK_CURRENT:
                {
                    objNewStartDate.setDate(objNewStartDate.getDate()-objNewStartDate.getDay());
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+6);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.WEEK_NEXT:
                {
                    objNewStartDate.setDate((objNewStartDate.getDate()-objNewStartDate.getDay())+7);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+6);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.WEEK_PREVIOUS:
                {
                    objNewStartDate.setDate((objNewStartDate.getDate()-objNewStartDate.getDay())-7);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+6);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.WEEK_CURRENT_NEXT:
                {
                    objNewStartDate.setDate((objNewStartDate.getDate()-objNewStartDate.getDay()));
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+13);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }

                case Constants.IDATE.WEEK_CURRENT_PREVIOUS:
                {
                    objNewStartDate.setDate((objNewStartDate.getDate()-objNewStartDate.getDay())-7);
                    me.setDateValue(objStartDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setDate(objNewStartDate.getDate()+13);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }

                //////////////////////////// MONTH RELATED ////////////////////////////////////////////

                case Constants.IDATE.MONTH_CURRENT:
                {
                    me.setDateValue(objStartDate,1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getMonthDays(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.MONTH_NEXT:
                {
                    objNewStartDate.setDate(1);
                    objNewStartDate.setMonth(objNewStartDate.getMonth()+1);
                    me.setDateValue(objStartDate,1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getMonthDays(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.MONTH_PREVIOUS:
                {
                    objNewStartDate.setDate(1);
                    objNewStartDate.setMonth(objNewStartDate.getMonth()-1);
                    me.setDateValue(objStartDate,1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getMonthDays(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.MONTH_CURRENT_NEXT:
                {
                    objNewStartDate.setDate(1);
                    objNewStartDate.setMonth(objNewStartDate.getMonth());
                    me.setDateValue(objStartDate,1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setMonth(objNewStartDate.getMonth()+1);
                    me.setDateValue(objEndDate,objNewStartDate.getMonthDays(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.MONTH_CURRENT_PREVIOUS:
                {
                    objNewStartDate.setDate(1);
                    objNewStartDate.setMonth(objNewStartDate.getMonth()-1);
                    me.setDateValue(objStartDate,1,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    objNewStartDate.setMonth(objNewStartDate.getMonth()+1);
                    me.setDateValue(objEndDate,objNewStartDate.getMonthDays(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }

                //////////////////////////// FISCAL YEAR RELATED ////////////////////////////////////
                case Constants.IDATE.FY_CURRENT:
                case Constants.IDATE.FY_NEXT:
                case Constants.IDATE.FY_PREVIOUS:
                case Constants.IDATE.FY_CURRENT_NEXT:
                case Constants.IDATE.FY_CURRENT_PREVIOUS:
                case Constants.IDATE.FY_CURRENT_TILL_DATE:
                case Constants.IDATE.FIRST_FY_TO_DATE:
                {
                    me.setFiscalYear(iRangeValue,objNewStartDate,objStartDate, objEndDate,isShowTime,is24HrFormat);
                    break;
                }
                //////////////////////////// FISCAL QUARTER  RELATED ////////////////////////////////////
                case Constants.IDATE.FQ_CURRENT:
                case Constants.IDATE.FQ_NEXT:
                case Constants.IDATE.FQ_PREVIOUS:
                case Constants.IDATE.FQ_CURRENT_NEXT:
                case Constants.IDATE.FQ_CURRENT_PREVIOUS:
                {
                    me.setFiscalQuarter(iRangeValue,objNewStartDate,objStartDate, objEndDate,isShowTime,is24HrFormat);
                    break;
                }
                ////////////////////////////  TILL TO DATE ////////////////////////////////////
                case Constants.IDATE.YEAR_TO_DATE:
                {
                    me.setDateValue(objStartDate,01,01,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
                case Constants.IDATE.MONTH_TO_DATE:
                {
                    me.setDateValue(objStartDate,01,(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
                    break;
                }
            }
        }
    };

    this.setFiscalYear = function(iYearRange, objNewStartDate, objStartDate, objEndDate,isShowTime,is24HrFormat)
    {
        var sFiscalYear,arrDate;
        //sFiscalYear=document.getElementById("hfFiscalYear").value;
        sFiscalYear = util.getDateValue("hfFiscalYear");
        arrDate = util.parseDate(sFiscalYear,clAppBuffer.getDateFormat());
        objNewStartDate = util.getDateObject();
        objNewStartDate.setDate(parseInt(arrDate[0]));
        objNewStartDate.setMonth(parseInt(arrDate[1]-1));
        objNewStartDate.setYear(parseInt(arrDate[2]));

        if(iYearRange == Constants.IDATE.FY_CURRENT)
        {
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+1));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,1);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iYearRange == Constants.IDATE.FY_NEXT)
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+1));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,1);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+1));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iYearRange == Constants.IDATE.FY_PREVIOUS)
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,-1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()-1));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+1));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,1);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iYearRange == Constants.IDATE.FY_CURRENT_NEXT)
        {
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,2);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+2));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iYearRange == Constants.IDATE.FY_CURRENT_PREVIOUS)// current and previous
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,-1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()-1));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.YEAR,2);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setYear((objNewStartDate.getFullYear()+2));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iYearRange == Constants.IDATE.FY_CURRENT_TILL_DATE)
        {
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            //objNewStartDate=new Date();
            objNewStartDate=util.getDateObject();
            me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else  // first fiscal year to date
        {
            //sFiscalYear=document.getElementById("hfFirstFiscalYear").value;
            sFiscalYear = util.getDateValue("hfFirstFiscalYear");
            arrDate = util.parseDate(sFiscalYear,clAppBuffer.getDateFormat());
            objNewStartDate.setDate(parseInt(arrDate[0]));
            objNewStartDate.setMonth(parseInt(arrDate[1]-1));
            objNewStartDate.setYear(parseInt(arrDate[2]));
             me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);

            //objNewStartDate=new Date();
            objNewStartDate=util.getDateObject();
            me.setDateValue(objEndDate,objNewStartDate.getDate(),(objNewStartDate.getMonth()+1),objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
    };

    this.setFiscalQuarter = function(iFQRange, objNewStartDate, objStartDate, objEndDate,isShowTime,is24HrFormat)
    {
        var sFiscalYear,arrDate;
        //sFiscalYear=document.getElementById("hfFiscalYear").value;
        sFiscalYear = util.getDateValue("hfFiscalYear");
        arrDate = util.parseDate(sFiscalYear,clAppBuffer.getDateFormat());

        var iCalendarCurrentMonth=objNewStartDate.getMonth();

        objNewStartDate.setDate(parseInt(arrDate[0]));
        objNewStartDate.setMonth(parseInt(arrDate[1]-1));
        objNewStartDate.setYear(parseInt(arrDate[2]));

        var iMonthsToAdjust=0;
        var iFiscalStartMonth=objNewStartDate.getMonth();

        iMonthsToAdjust=((iCalendarCurrentMonth>=iFiscalStartMonth)?(iCalendarCurrentMonth-iFiscalStartMonth):( (12-iFiscalStartMonth)+iCalendarCurrentMonth));
        iMonthsToAdjust=Math.floor((iMonthsToAdjust/3));
        iMonthsToAdjust=iMonthsToAdjust*3;

        objNewStartDate.setMonth(objNewStartDate.getMonth()+iMonthsToAdjust);

        if(iFQRange == Constants.IDATE.FQ_CURRENT)
        {
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,3);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+3));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iFQRange == Constants.IDATE.FQ_NEXT)
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,3);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+3));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,3);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+3));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iFQRange == Constants.IDATE.FQ_PREVIOUS)
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,-3);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()-3));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,3);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+3));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else if(iFQRange == Constants.IDATE.FQ_CURRENT_NEXT)
        {
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,6);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+6));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
        else // current and previous
        {
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,-3);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()-3));
            me.setDateValue(objStartDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.MONTH,6);
            objNewStartDate=dateUtils.add(objNewStartDate,dateUtils.dateParts.DAY,-1);
            //objNewStartDate.setMonth((objNewStartDate.getMonth()+6));
            //objNewStartDate.setDate((objNewStartDate.getDate()-1));
            me.setDateValue(objEndDate,objNewStartDate.getDate(),objNewStartDate.getMonth()+1,objNewStartDate.getFullYear(),isShowTime,is24HrFormat);
        }
    };

    this.setDateValue = function(objDate,dd,mm,yyyy,isShowTime,is24HrFormat)
    {
        var iCurrentDateFormat, sDate,sSeparator;
        iCurrentDateFormat = clAppBuffer.getDateFormat();
        /*sSeparator = util.getDateSeparator(parseInt(iCurrentDateFormat));

        if(dd < 10)
            dd="0"+dd;
        if(mm < 10)
            mm="0"+mm;

        switch(parseInt(iCurrentDateFormat))
                {
            case Constants.YYYYMMDD:
            {
                sDate=yyyy+sSeparator+mm+sSeparator+dd;
                break;
            }

            default:
            {
                sDate=dd+sSeparator+mm+sSeparator+yyyy;
            }

        }*/

        sDate=dateUtils.getDateByFormat(iCurrentDateFormat,dd,mm,yyyy);

        if(isShowTime)
        {
            var sDateTime = objDate.value;
            sDateTime=util.trim(sDateTime);
            //var sTime;
            //var bTimeExist=false;
            var sDateDets;

            if (sDateTime != null && sDateTime.length > 0)
            {
                if(iCurrentDateFormat == Constants.DD___MM___YYYY
                    || iCurrentDateFormat == Constants.MM___DD___YYYY
                    || iCurrentDateFormat == Constants.YYYY___MM___DD
                    || iCurrentDateFormat == Constants.DD___MM___YY
                    || iCurrentDateFormat == Constants.MM___DD___YY
                    || iCurrentDateFormat == Constants.YY___MM___DD)
                {
                    sDateDets = sDateTime.split(" ");
                    //bTimeExist=sDateDets.length>1;
                    if(sDateDets.length>1)
                    {
                        if(sDateDets.length==2)// 24hrs
                            sDate = sDate+" "+sDateDets[sDateDets.length-1];
                        else // 12hrs am/pm
                        {
                            sDate = sDate+" "+sDateDets[sDateDets.length-2]+" "+sDateDets[sDateDets.length-1];
                        }

                    }
                }
                else
                {
                    sDateTime = sDateTime.replaceAll("-", "/");
                    sDateTime = sDateTime.replaceAll(" ", "/");
                    sDateDets = sDateTime.split("/");
                    //bTimeExist=sDateDets.length>3;
                    if(sDateDets.length>3)
                    {
                        if(sDateDets.length==4)// 24hrs
                            sDate = sDate+" "+sDateDets[sDateDets.length-1];
                        else // 12hrs am/pm
                        {
                            sDate = sDate+" "+sDateDets[sDateDets.length-2]+" "+sDateDets[sDateDets.length-1];
                        }
                    }

                }
            }


            /*var sTime = objDate.value;
            sTime=util.trim(sTime);
            sTime=sTime.split(" ");
            if(sTime.length>1)
            {
                if(is24HrFormat)
                    sDate = sDate+" "+sTime[sTime.length-1];
                else
                {
                    sDate = sDate+" "+sTime[sTime.length-2]+" "+sTime[sTime.length-1];
                }
            }*/
        }

        objDate.value=sDate;
        objDate.setAttribute("oldVal",sDate);

    };
};

