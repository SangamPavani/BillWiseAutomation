var inputMask = new function()
{
    this.maskDateField = function(fldId,iFormat){


        if(!iFormat)
            iFormat=clAppBuffer.getDateFormat();

        if(iFormat == Constants.DDMMYYYY || iFormat == Constants.MMDDYYYY || iFormat == Constants.YYYYMMDD) {
            var sDateFormat;
            if (iFormat == Constants.DDMMYYYY) {
                sDateFormat = 'dd/mm/yyyy';
            } else if (iFormat == Constants.MMDDYYYY) {
                sDateFormat = 'mm/dd/yyyy';
            } else if (iFormat == Constants.YYYYMMDD) {
                sDateFormat = 'yyyy/mm/dd';
            }
            Inputmask("datetime", {
                inputFormat: sDateFormat
            }).mask(fldId);
        }else{
            Inputmask("9{1,2} a{3} 9{4}",{"placeholder": "dd mon yyyy","greedy":true}).mask(fldId);
            //clearIncomplete": true
        }

    };

    this.maskDateTimeField = function(fldId,iDateFormat,iTimeFormat){


        if(!iDateFormat)
            iDateFormat=clAppBuffer.getDateFormat();

        if(!iTimeFormat)
            iTimeFormat=clAppBuffer.getTimeFormat();

        if(iDateFormat == Constants.DDMMYYYY || iDateFormat == Constants.MMDDYYYY || iDateFormat == Constants.YYYYMMDD) {
            var sDateTimeFormat;
            if (iDateFormat == Constants.DDMMYYYY) {
                if (iTimeFormat == Constants.HHMM)
                    sDateTimeFormat = 'dd/mm/yyyy HH:MM';
                else if (iTimeFormat == Constants.HHMMAMPM)
                    sDateTimeFormat = 'dd/mm/yyyy hh:MM TT';
            } else if (iDateFormat == Constants.MMDDYYYY) {
                if (iTimeFormat == Constants.HHMM)
                    sDateTimeFormat = 'mm/dd/yyyy HH:MM';
                else if (iTimeFormat == Constants.HHMMAMPM)
                    sDateTimeFormat = 'mm/dd/yyyy hh:MM TT';
            }else if (iDateFormat == Constants.YYYYMMDD) {
                if (iTimeFormat == Constants.HHMM)
                    sDateTimeFormat = 'yyyy/mm/dd HH:MM';
                else if (iTimeFormat == Constants.HHMMAMPM)
                    sDateTimeFormat = 'yyyy/mm/dd hh:MM TT';
            }


            Inputmask("datetime", {
                inputFormat: sDateTimeFormat
            }).mask(fldId);
        }else{
            if (iTimeFormat == Constants.HHMM)
                Inputmask("9{1,2} a{3} 9{4} 9{1,2}:9{1,2}",{"placeholder": "dd mon yyyy HH:MM","greedy":true}).mask(fldId);
            else if (iTimeFormat == Constants.HHMMAMPM)
                Inputmask("9{1,2} a{3} 9{4} 9{1,2}:9{1,2} a{2}",{"placeholder": "dd mon yyyy hh:MM TT","greedy":true}).mask(fldId);
        }

    };
};

