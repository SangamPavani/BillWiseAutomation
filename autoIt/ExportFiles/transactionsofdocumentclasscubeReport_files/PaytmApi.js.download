var clPaytmApi = new function()
{
    var me = this;
    me.params = null;
    this.initiatePayment = function(sUrl,sParams)
    {
        me.params = sParams;
        console.log("in initiatePayment");
        con.sendPostRequest(sUrl,null,null,"clPaytmApi.handleInitResponse");
    };

    this.handleInitResponse= function(response)
    {
        //alert(response)
        util.toggleBackground(true);
        var objResponse = JSON.parse(response);
        var sTxtToken = objResponse.txttoken;
        var sOrderId = objResponse.orderid;
        var sMID = objResponse.mid;
        var sHost = objResponse.host;

        var sScriptSrc = sHost+"/merchantpgpui/checkoutjs/merchants/"+sMID+".js";
        var Addscript = document.createElement('script');
        Addscript.setAttribute('type','application/javascript');
        Addscript.setAttribute('src',sScriptSrc);
        Addscript.onload = function(){clPaytmApi.loadPaytmWindow(sOrderId,sTxtToken)};
        document.head.appendChild(Addscript);

    };

    this.loadPaytmWindow = function(sOrderId,sTxtToken)
    {
        //alert("window.Paytm"+window.Paytm)

        console.log("in handleInitResponse");
        console.log("OrderId===="+sOrderId);
        console.log("txn token===="+sTxtToken);

        var config = {
            "root": "",
            "flow": "DEFAULT",
            "data": {
                "orderId": sOrderId, /* update order id */
                "token": sTxtToken, /* update token value */
                "tokenType": "TXN_TOKEN",
                "amount": "1.00" /* update amount */
            },
            merchant:{
                redirect: false
            },
            "handler": {
                "notifyMerchant": function(eventName,data){
                    //alert("notifyMerchant====="+JSON.stringify(data));
                    console.log("notifyMerchant handler function called");
                    console.log("eventName => ",eventName);
                    console.log("data => ",data);
                    me.handleAbNormalEvent(sOrderId,data);
                    util.toggleBackground(false);
                },
                transactionStatus:function(data){
                    console.log("payment status ", data);
                    //alert("transactionStatus==="+JSON.stringify(data));
                    window.Paytm.CheckoutJS.close();
                    me.showPaymentStatusDlg(data);
                }
            }
        };
        if(window.Paytm && window.Paytm.CheckoutJS){
            //alert("in")
            console.log("in CheckoutJS");
            window.Paytm.CheckoutJS.onLoad(function excecuteAfterCompleteLoad() {
                console.log("in onLoad");
                // initialze configuration using init method
                window.Paytm.CheckoutJS.init(config).then(function onSuccess() {
                    console.log("in onSuccess");
                    // after successfully updating configuration, invoke JS Checkout
                    window.Paytm.CheckoutJS.invoke();
                }).catch(function onError(error){
                    console.log("error => ",error);
                });
            });
        }
    };

    this.handleAbNormalEvent = function(sOrderId,data)
    {
        var sUrl = "payment/gateway!doResponse.do?";
        var sParams = "";
        sParams += "s=0&RESPCODE=0&RESPMSG="+data.message;
        sParams += "&pType="+Constants.TYPE_PAYTM;
        sParams += "&ORDERID="+sOrderId;
        sParams += "&isCancel=true";
        con.sendPostRequest(sUrl,sParams);
    };

    //this.showPaymentStatusDlg_ = function(sJSONString)
    //{
    //    var sUrl = "payment/gateway!doResponse.do?";
    //    var sParams = "";
    //
    //    for (var x in sJSONString) {
    //        console.log(x +" => "+ sJSONString[x]);
    //        alert(x +" => "+  sJSONString[x]);
    //        sParams += x+"="+util.encodeURI(sJSONString[x])+"&"
    //    }
    //    sParams+="pType="+Constants.TYPE_PAYTM;
    //    alert("in PaytmApi js==="+sParams)
    //    con.sendPostRequest(sUrl,sParams,null,"clPaytmApi.arhDoResponse");
    //};

    this.showPaymentStatusDlg = function(sJSONString)
    {
        var sUrl = "payment/gateway!getPaymentStatusPage.do?";
        //var sParams = "sParamsJSON="+util.encodeURI(JSON.stringify(sJSONString));

        //for (var x in sJSONString) {
        //    console.log(x +" => "+ sJSONString[x]);
        //    alert(x +" => "+  sJSONString[x]);
        //    sParams += x+"="+util.encodeURI(sJSONString[x])+"&"
        //}
        me.params+="&pType="+Constants.TYPE_PAYTM;
        me.params+="&sParamsJSON="+util.encodeURI(JSON.stringify(sJSONString));
        me.params+="&ORDERID="+sJSONString.ORDERID;
        me.params+="&TXNAMOUNT="+sJSONString.TXNAMOUNT;
        sUrl = sUrl+me.params;
        var clEazetapDlg = new DialogBox("eazetapStatusDlg", "", 100, 50, 450, 500, sUrl, true, null, true, true, null, null, null, true, null, null, false, true, false, true, null, false, null, true, true);
        clEazetapDlg.setCenter();
        clEazetapDlg.show();
    };

};
