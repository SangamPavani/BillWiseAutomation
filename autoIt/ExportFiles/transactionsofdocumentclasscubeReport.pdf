<style type="text/css">
        html[dir="rtl"] .treePanelheading > td[class='setup_cls']           {

            text-align:right;
        }
        #iListHeaderId
        {
            padding-bottom:5px;
        }

        .listContainer
        {
            margin-top:0px;
        }

        /*.dvRecentItems{
            background-color: #f1f1f1;
            border-left: 1px solid #f1f1f1;
        }*/
        /*  .dvRecentMenuPos
          {
              position:fixed;
              *//*position:absolute;*//*
              top:310px;
              right:0;
              z-index:999999;
          }*/
        html[dir="rtl"] #dvRecentMenu {
            /*float: left;*/
            border-top-right-radius: 5px;
            border-bottom-right-radius: 5px;
            /*border-bottom-left-radius: 0px;*/
            /*border-bottom-left-radius: 0px;*/
            border-bottom-left-radius: 1px;
            border-top-left-radius: inherit;
        }
        html[dir="rtl"] .dvRecentMenuPos
        {
            /*position:fixed;*/
            position:absolute;
            top:310px;
            left:0;
            z-index:999999;
            right:inherit;

        }
        html[dir="rtl"] #spRecent
        {
            white-space: nowrap;
            -moz-transform: rotate(91.0deg) translate(-40px,0px);
            -o-transform: rotate(18.0deg) translate(-40px,0px);
            -webkit-transform: rotate(91.0deg) translate(17px,-53px);
            transform: rotate(91.0deg) translate(25px,-18px);
            /*left: -40px;*/
            /*right:98%;*/
            width:15px;
            top: 335px;
            position: absolute;
            /*position: fixed;*/
            _position: absolute;
            color: #ffffff;
            cursor: pointer;
            padding-right: 7px;
            /*padding-left: 7px;*/
            padding-top: 7px;
            padding-bottom: 7px;
            /*padding-right: 12px;*/
            padding-left: 12px;
        }
        html[dir="rtl"] .recentMenuExpand
        {
            left:220px;
            right:85%;
        }
        html[dir="rtl"] .recentMenuMin
        {
            left:20px;
            right:98%;
        }
        html[dir="rtl"] div[style='display: block; float: right;'] {
            float: left !important;
        }
        html[dir="rtl"] .floatRight
        {
            float:left;
        }
        html[dir="rtl"] .centerWidth
        {
            width:97%;
        }

        html[dir="rtl"] .floatLeft
        {
            float:right;
        }
        html[dir="rtl"] .treePanelheading > td
        {
            float:none;
            text-align:center;
        }
        html[dir="rtl"] .nm-half-navContentArea
        {
            margin-right:220px;
            /*margin-right:auto;*/
            margin-left:inherit;
            /*float:right;*/
            display:block;
            /*width:85%;*/
        }
        html[dir="rtl"] .nm-pipe-navContentArea
        {
            width:95%;
            margin-right:auto;
            margin-left:inherit;
            float:none;
            display:block;
        }
        html[dir="rtl"] .nm-half-navDv
        {
            display:block;
            width:220px;
            height:100%;
            float:right;
        }
        .dvRecentItems{
            top: auto; !important;
            margin-top: 0 !important;
        }

